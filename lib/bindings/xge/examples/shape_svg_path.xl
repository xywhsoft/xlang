import xge

auto shape = xge.createShape()
shape.appendSvgPath("M 1.5 2.25 Q 3 4 5.5 6 L 1.5 6 Z")
string path = shape.exportSvgPath()
shape.close()
println(path)

// Embed the independent path data in an SVG document.
auto svg = xge.createSvg()
svg.loadMemory("<svg width='8' height='8'><path d='" + path + "'/></svg>")
auto bounds = svg.getBounds(c_float(0.25))
println("Path height:", bounds.fH)
svg.close()
