// snake.xl — 贪吃蛇（键盘经典游戏）
// 方向键/WASD 移动，ESC 退出，R 重开。
// 限帧图形验证：xl run snake.xl -- 60
import xge
from "./_game.xl" import runGame, loadGameFont, loadGameSound, loadGameTexture, rect, pixels, vertex, keyPressed, keyDown, mouseX, mouseY, mouseLeftDown, mouseRightDown

// --- 游戏参数 ---
int CELL = 24                       // 格子边长（像素精确）
int COLS = 30                       // 列数
int ROWS = 22                       // 行数
int HUD_H = 48                      // 顶部 HUD 高度
float STEP = 0.12                   // 每步间隔（秒）
int MAXLEN = 800                    // 蛇身最大长度

// --- 游戏状态 ---
array<int> bodyX = [10, 9, 8, 7, 6] // 蛇身（头在下标 0）
array<int> bodyY = [11, 11, 11, 11, 11]
int snakeLen = 5
int dirX = 1
int dirY = 0
int pendingX = 1
int pendingY = 0
int foodX = 15
int foodY = 11
int score = 0
bool dead = false
float timer = 0.0
xge.Font? hudFont = null
Random rng = Random(uint64(2026), uint64(7))

// --- 初始化 ---
func reset()
    int i = 0
    while i < 5
        bodyX[i] = 10 - i
        bodyY[i] = 11
        i += 1
    end
    snakeLen = 5
    dirX = 1
    dirY = 0
    pendingX = 1
    pendingY = 0
    score = 0
    dead = false
    timer = 0.0
    spawnFood()
end

func spawnFood()
    bool ok = false
    while not ok
        foodX = int(rng.u32()) % COLS
        foodY = int(rng.u32()) % ROWS
        ok = true
        int i = 0
        while i < snakeLen
            if bodyX[i] == foodX and bodyY[i] == foodY then
                ok = false
            end
            i += 1
        end
    end
end

// --- 逻辑更新 ---
func handleInput()
    if keyPressed(xge.XGE_KEY_UP) or keyPressed(87) then
        if dirY != 1 then
            pendingX = 0
            pendingY = -1
        end
    end
    if keyPressed(xge.XGE_KEY_DOWN) or keyPressed(83) then
        if dirY != -1 then
            pendingX = 0
            pendingY = 1
        end
    end
    if keyPressed(xge.XGE_KEY_LEFT) or keyPressed(65) then
        if dirX != 1 then
            pendingX = -1
            pendingY = 0
        end
    end
    if keyPressed(xge.XGE_KEY_RIGHT) or keyPressed(68) then
        if dirX != -1 then
            pendingX = 1
            pendingY = 0
        end
    end
    if dead and keyPressed(82) then
        reset()
    end
end

func step()
    dirX = pendingX
    dirY = pendingY

    int headX = bodyX[0] + dirX
    int headY = bodyY[0] + dirY

    // 撞墙
    if headX < 0 or headX >= COLS or headY < 0 or headY >= ROWS then
        dead = true
        return
    end

    // 撞自己（尾巴即将移走，检查到 length-1 即可）
    int i = 0
    while i < snakeLen - 1
        if bodyX[i] == headX and bodyY[i] == headY then
            dead = true
            return
        end
        i += 1
    end

    // 吃到食物则生长（尾部保留），否则整体后移
    if headX == foodX and headY == foodY then
        if snakeLen < MAXLEN then
            bodyX.append(bodyX[snakeLen - 1])
            bodyY.append(bodyY[snakeLen - 1])
            snakeLen += 1
        end
        score += 10
        spawnFood()
    end

    // 从尾到头逐节前移
    int j = snakeLen - 1
    while j > 0
        bodyX[j] = bodyX[j - 1]
        bodyY[j] = bodyY[j - 1]
        j -= 1
    end
    bodyX[0] = headX
    bodyY[0] = headY
end

// --- 绘制 ---
func draw()
    c_uint bg = xge.colorRGBA(c_int(13), c_int(17), c_int(22), c_int(255))
    c_uint gridC = xge.colorRGBA(c_int(24), c_int(30), c_int(38), c_int(255))
    c_uint bodyC = xge.colorRGBA(c_int(79), c_int(216), c_int(194), c_int(255))
    c_uint headC = xge.colorRGBA(c_int(255), c_int(255), c_int(255), c_int(255))
    c_uint foodC = xge.colorRGBA(c_int(255), c_int(107), c_int(94), c_int(255))

    // HUD 背景
    xge.shapeRectFillPixels(pixels(0, 0, COLS * CELL, HUD_H), c_uint(xge.colorRGBA(c_int(18), c_int(24), c_int(32), c_int(255))))
    if hudFont != null then
        hudFont.drawText("SCORE " + string(score), c_float(12), c_float(12), c_uint(xge.colorRGBA(c_int(79), c_int(216), c_int(194), c_int(255))))
        hudFont.drawText(dead ? "GAME OVER - press R" : "SNAKE", c_float(COLS * CELL - 200), c_float(12), c_uint(dead ? foodC : gridC))
    end

    // 棋盘
    xge.shapeRectFill(rect(0, float(HUD_H), float(COLS * CELL), float(ROWS * CELL)), c_uint(bg))
    int y = 0
    while y < ROWS
        int x = 0
        while x < COLS
            if (x + y) % 2 == 0 then
                xge.shapeRectFillPixels(pixels(x * CELL, HUD_H + y * CELL, CELL, CELL), c_uint(gridC))
            end
            x += 1
        end
        y += 1
    end

    // 食物（圆形）
    xge.shapeCircleFill(c_float(float(foodX * CELL + CELL / 2)), c_float(float(HUD_H + foodY * CELL + CELL / 2)), c_float(float(CELL / 2 - 2)), c_uint(foodC))

    // 蛇身
    int i = 0
    while i < snakeLen
        c_uint c = i == 0 ? headC : bodyC
        xge.shapeRectFillPixels(pixels(bodyX[i] * CELL + 1, HUD_H + bodyY[i] * CELL + 1, CELL - 2, CELL - 2), c_uint(c))
        i += 1
    end
end

// --- 帧回调 ---
func on_frame()
    handleInput()
    if not dead then
        timer += float(xge.getDelta())
        while timer >= STEP
            timer -= STEP
            step()
        end
    end
    xge.clear(xge.colorRGBA(c_int(13), c_int(17), c_int(22), c_int(255)))
    draw()
end

func initializeGame()
    hudFont = loadGameFont(18.0)

    reset()
end

func cleanupGame()
    hudFont = null
end

func main(...) as int
    // An optional positive frame count provides a bounded graphical smoke run.
    int frameLimit = 0
    if arg.length > 1 then frameLimit = int(arg[1]) end
    return runGame(COLS * CELL, HUD_H + ROWS * CELL, "xlang snake", initializeGame, on_frame, cleanupGame, frameLimit)
end
