import xge

func main(...) as int
    // Reserve room for three 16-bit indices, initially all zero.
    auto indices = xge.createGpuBuffer(xge.XGE_BUFFER_INDEX,xge.XGE_BUFFER_DYNAMIC,c_int(6))
    try
        indices.update(0,Buffer.fromHex("000001000200"))
        println("Index buffer bytes: ",indices.size)
    finally
        indices.close()
    end
    return 0
end
