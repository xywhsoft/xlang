// Run: xl run particle_definition.xl
// Pure CPU: no window, graphics context, texture, or network is required.
import xge

auto emitter=xge.particleEmitterInit()
emitter.fRate=c_float(60)
array<xge.ParticleEmitter> emitters=[emitter]
auto definition=xge.createParticleDefinition(emitters)
auto shared=definition.share()
definition.close()
try
 println("Emitter count: ",shared.count())
 println("Emission rate: ",shared.get(0).fRate)
 auto json=shared.stringify()
 auto restored=xge.parseParticleDefinition(json)
 try
  assert restored.count()==1 and restored.get(0).fRate==c_float(60)
  println("JSON round trip passed")
 finally
  restored.close()
 end
finally
 shared.close()
end
