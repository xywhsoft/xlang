// Groups and playback resources use creator-thread native ownership. A voice
// retains its group backend, so closing the group view does not stop the voice.
export extern "xge_audio_group" class AudioGroup @header("xge3_audio_resources.h") @lifetime("owned") @policy("xl6Xge3AudioGroupPolicy")
 native point handle
 extern "xgeAudioGroupSetVolume" func setVolume(c_float volume)
 extern "xgeAudioGroupGetVolume" func volume() as c_float
 extern "xgeAudioGroupFade" func fade(c_float from,c_float to,c_int milliseconds)
 extern "xl6ForeignViewCloseV1" @no_raise @c_control(0) @c_result("bool_status") func close()
end

// Ordinary methods call the authoritative C function once. Owning factories
// produce stable native records; the native final release also frees the record.
