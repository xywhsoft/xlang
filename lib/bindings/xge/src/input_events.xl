 c_int iType
 uint64 iSequence
 c_int iTextSize
 c_int iCursor
 c_int iSelectStart
 c_int iSelectEnd
 c_int bReplacementRange
 c_int iReplacementStart
 c_int iReplacementEnd
 c_int iAttribute
end

