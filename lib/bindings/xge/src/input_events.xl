// The metadata is an independent value. Text remains in the caller's Buffer.
export extern "xge_input_event_info_t" struct InputEventInfo @header("xge3_runtime.h")
 c_uint iSize
 c_int iType
 c_uint iFlags
 uint64 iSequence
 c_double fTime
 c_int iKey
 c_int iNativeKey
 c_int iScanCode
 c_uint iModifiers
 uint64 iPointerId
 c_int iButton
 c_uint iButtons
 c_float fX
 c_float fY
 c_float fDX
 c_float fDY
 c_uint iCodepoint
 c_int iTextSize
 c_int iCursor
 c_int iSelectStart
 c_int iSelectEnd
 c_int bReplacementRange
 c_int iReplacementStart
 c_int iReplacementEnd
 c_int iAttribute
end

// The IME-only compatibility queue contains native-origin events.
export extern "xge_ime_event_info_t" struct ImeEventInfo @header("xge3_runtime.h")
