// A request owns its private result, callback and worker code until settlement.
// Register callbacks before start(): resource providers can finish immediately.
export extern "xge_async_load_info_t" struct LoadInfo @header("xge3_async_load.h")
 c_uint size
 c_int kind
 c_int status
 c_int result
 c_float progress
 bool hasResult
 bool cancelRequested
 bool threaded
end

