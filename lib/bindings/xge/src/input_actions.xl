end
extern "xgeActionsFree" @header("xge3_input_actions.h") @no_raise func freeActions(Actions value)
export extern "xgeActionsCreate" @header("xge3_input_actions.h") @no_raise @c_result("owned_view") @factory(2,0,freeActions) func createActions(c_uint actionCount,c_uint bindingCapacity) as Actions
