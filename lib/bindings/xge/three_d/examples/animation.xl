import xge3d

auto rig = xge3d.loadModel("assets/animation-rig.gltf")
auto motion = xge3d.loadClip("assets/animation-motion.gltf")
auto scene = xge3d.createScene()
auto root = scene.instantiate(rig)
rig.close()

auto animator = scene.animator(root)
auto playback = xge3d.animationOptions()
playback.loop = 0
animator.playConfigured(0, motion, playback)
motion.close() // 动画层持有剪辑，释放本地引用后仍可播放。

animator.update(c_float(0.5))
auto status, tip = animator.bone("Tip")
assert status == 0
println("动画时间", animator.layerTime(0))
println("Tip 世界坐标 X", scene.worldMatrix(tip).m[12])

animator.close()
scene.close()
