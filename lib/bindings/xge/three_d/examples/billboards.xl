import xge
import xge3d

auto settings = xge3d.threeDParticlesDefault()
settings.position.z = c_float(-2)
settings.size_start = c_float(0.5)
settings.size_end = c_float(0.5)
auto particles = xge3d.createParticles(settings)
particles.emit(c_uint(3))
particles.update(c_float(0.2), c_int(0))
xge.init(480, 320, "3D 粒子")
xge.run(func() as c_int
    assert xge.begin() == 0
    auto scene = xge3d.createScene()
    auto renderer = xge3d.createRenderer()
    auto camera = xge3d.orthographicCamera(c_float(4), c_float(3), c_float(0.1), c_float(10))
    c_float[4] background
    background[3] = c_float(1)
    // 直接提交当前粒子，后续帧可以复用渲染器的缓冲区。
    renderer.setParticleBillboards(particles)
    auto stats = renderer.render(scene, camera, background)
    println("粒子三角形数", stats.triangles)
    renderer.close()
    scene.close()
    assert xge.nativeEnd() == 0
    return c_int(1)
end)
xge.setFrameCallback(null)
particles.close()
xge.unit()
