import xge
import xge3d

func vertex(float x, float y, float u, float v) as xge3d.Xge3dVertex
    auto value = xge3d.Xge3dVertex()
    value.position.x = c_float(x)
    value.position.y = c_float(y)
    value.position.z = c_float(-2)
    value.normal.z = c_float(1)
    value.uv[0] = c_float(u)
    value.uv[1] = c_float(v)
    return value
end

xge.init(480, 320, "3D 贴图材质")
auto params = xge3d.materialDefault()
params.unlit = c_int(1)
auto material = xge3d.createMaterial(params)
auto texture = xge3d.createTexture(2, 2, b"\xFF\0\0\xFF\0\xFF\0\xFF\0\0\xFF\xFF\xFF\xFF\xFF\xFF")
material.setMap(xge.XGE3D_MAP_BASE_COLOR, texture)
texture.close() // 材质持有贴图。

auto scene = xge3d.createScene()
auto node = scene.createNode(xge3d.Xge3dNode())
auto mesh = xge3d.createMesh([vertex(-0.8, -0.8, 0, 1), vertex(0.8, -0.8, 1, 1), vertex(0, 0.8, 0.5, 0)])
scene.setMesh(node, mesh)
scene.setMaterial(node, material)
mesh.close()
material.close() // 场景持有材质和网格。

xge.run(func() as c_int
    assert xge.begin() == 0
    auto renderer = xge3d.createRenderer()
    auto camera = xge3d.orthographicCamera(c_float(3), c_float(2), c_float(0.1), c_float(10))
    c_float[4] clear
    clear[3] = c_float(1)
    auto frame = renderer.render(scene, camera, clear)
    println("绘制带贴图三角形", frame.triangles)
    renderer.close()
    assert xge.nativeEnd() == 0
    return c_int(1)
end)
xge.setFrameCallback(null)
scene.close()
xge.unit()
