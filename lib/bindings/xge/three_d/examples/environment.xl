import xge
import xge3d

// 六个面按 +X、-X、+Y、-Y、+Z、-Z 排列。这里每个面都是蓝色的 1×1 图像。
auto faces = Buffer()
for face in range(6)
    faces.append(b"\0\0\xFF\xFF")
end

xge.init(480, 320, "3D 天空立方体")
auto environment = xge3d.createEnvironment(1, faces)
auto scene = xge3d.createScene()
xge.run(func() as c_int
    assert xge.begin() == 0
    auto renderer = xge3d.createRenderer()
    auto camera = xge3d.orthographicCamera(c_float(3), c_float(2), c_float(0.1), c_float(10))
    auto options = xge3d.frameOptionsDefault()
    options.clear_color[3] = c_float(1)
    auto target = xge3d.createRenderTarget(32, 32)
    renderer.renderFrame(scene, camera, options, target, environment)

    auto pixels = Buffer()
    assert pixels.resize(32 * 32 * 4)
    target.readPixels(pixels)
    println("天空首像素的蓝色通道", pixels.byteAt(2))
    target.close()
    renderer.close()
    assert xge.nativeEnd() == 0
    return c_int(1)
end)
xge.setFrameCallback(null)
scene.close()
environment.close()
xge.unit()
