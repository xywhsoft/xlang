 c_float near_z
 c_float far_z
end

export extern "xge3d_vertex_t" struct Xge3dVertex @header("xge3_runtime.h")
 Xge3dVec3 position
 Xge3dVec3 normal
 c_float uv[2]
 c_float tangent[4]
 c_float uv1[2]
 c_ushort joints[4]
 c_float weights[4]
end

export extern "xge3d_sampler_t" struct Xge3dSampler @header("xge3_runtime.h")
 c_int min_filter
 c_int mag_filter
 c_int wrap_u
 c_int wrap_v
end

export extern "xge3d_ray_t" struct Xge3dRay @header("xge3_runtime.h")
