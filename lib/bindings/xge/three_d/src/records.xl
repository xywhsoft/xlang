// Requires a matching 3D-enabled native SDK; no feature macros are changed by this module.
export extern "xge3d_vec3_t" struct Xge3dVec3 @header("xge3_runtime.h")
 c_float x
 c_float y
 c_float z
end

export extern "xge3d_dvec3_t" struct Xge3dDvec3 @header("xge3_runtime.h")
 c_double x
 c_double y
 c_double z
end

export extern "xge3d_aabb_t" struct Xge3dAabb @header("xge3_runtime.h")
 Xge3dVec3 min
 Xge3dVec3 max
end

export extern "xge3d_sphere_t" struct Xge3dSphere @header("xge3_runtime.h")
 Xge3dVec3 center
 c_float radius
end

export extern "xge3d_quat_t" struct Xge3dQuat @header("xge3_runtime.h")
 c_float x
 c_float y
 c_float z
 c_float w
end

export extern "xge3d_mat4_t" struct Xge3dMat4 @header("xge3_runtime.h")
 c_float m[16]
end

export extern "xge3d_node_t" struct Xge3dNode @header("xge3_runtime.h")
 uint64 slot
 uint64 scene
end

export extern "xge3d_transform_t" struct Xge3dTransform @header("xge3_runtime.h")
 Xge3dVec3 position
 Xge3dQuat rotation
 Xge3dVec3 scale
end

export extern "xge3d_camera_t" struct Xge3dCamera @header("xge3_runtime.h")
 Xge3dMat4 view
