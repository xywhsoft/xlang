 native point handle
 extern "xge3dParticlesSetPosition" @no_raise @c_result("status",0) func setPosition(Xge3dVec3 position)
 extern "xge3dParticlesEmit" @no_raise @c_result("status",0) func emit(c_uint count)
 extern "xge3dParticlesUpdate" @no_raise @c_result("status",0) func update(c_float seconds,c_int emitAutomatically=1)
