 native point handle
 extern "xge3dBillboardBatchGetGeometry" @no_raise @c_const(0) @c_owned_sequence(1,2,0,"size_t",0) @c_retain(retainBillboards,"zero",freeBillboards) func geometry() as NativeSequence<BillboardGeometry>
