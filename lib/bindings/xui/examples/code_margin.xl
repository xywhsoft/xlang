// A standalone margin model computes widths and rectangles without a window.
// Run: xl run code_margin.xl
import xui

func main(...) as int
 auto margins=xui.createCodeMargin()
 margins.add(1,xui.XUI_CODE_MARGIN_LINE_NUMBER,44)
 margins.add(2,xui.XUI_CODE_MARGIN_CUSTOM,16)

 auto viewport=xui.Rect()
 viewport.fW=640
 viewport.fH=480
 auto layout=margins.captureLayout(viewport)
 auto count,text=layout.getState()
 assert count==2 and text.fX==60
 for margin in layout.entries()
  println("Margin ",margin.tState.iId," at ",margin.tRect.fX," px")
 end
 println("Text starts at ",text.fX," px")
 layout.close()
 margins.close()
 return 0
end
