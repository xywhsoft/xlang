// 多行文字编辑，支持选择、撤销和重做。
import xui
from "./_window.xl" import Window

Window.show("Text editor / multiline selection", func(xui.Context ui, xui.Widget root)
 auto editor = ui.textEditNative()
 Window.place(root, editor, 24, 24, 640, 260)
 editor.setText("Multiline text editor\nSelect, edit, undo and redo.\nUTF-8: 你好，世界！")
 editor.setWordWrap(1)
end)
