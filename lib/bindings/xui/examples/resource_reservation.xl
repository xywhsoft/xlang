// Reserve a named surface while using its registry entry.
import xui
from xui import Resource

func main(...) as int
    auto proxy = xui.createProxy()
    auto ui = xui.create(proxy, xui.XUI_SYSTEM_FONT_DISABLED)
    auto surface = proxy.createSurfaceRGBA(1, 1, Buffer.fromHex("2c1207ff"))
    ui.setSurfaceResource("preview", surface)
    auto entry = ui.findResource("preview") as Resource

    auto reference = entry.retain()
    println(entry.name, entry.nativeReferenceCount)
    reference.close()

    entry.withReservation(func() as c_int
        println(entry.name, entry.nativeReferenceCount)
        return 0
    end)

    entry.remove()
    surface.close()
    ui.close()
    proxy.close()
    return 0
end
