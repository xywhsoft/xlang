// 点击行，改变列表的选中项。
import xui
from "./_window.xl" import Window

Window.show("List / selection and scrolling", func(xui.Context ui, xui.Widget root)
 auto listview = ui.listViewNative()
 Window.place(root, listview, 24, 24, 640, 260)
 listview.setItems(["First item", "Second item", "Third item", "Fourth item", "Fifth item"])
 listview.setSelected(1)
end)
