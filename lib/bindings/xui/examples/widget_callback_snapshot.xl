import xui
from xui import Widget, Vec2, CallbackVec2, WidgetCallbackSnapshot

auto proxy = xui.createProxy()
auto ui = xui.create(proxy, xui.XUI_SYSTEM_FONT_DISABLED)
auto source = ui.widget()
auto target = ui.widget()

source.setContentMeasureCallback(func(Widget widget, Vec2 constraint, CallbackVec2 result) as c_int
    result.fX = 48
    result.fY = 24
    return xui.XUI_OK
end)

// The snapshot keeps the callback alive after the source is closed.
auto sizeCallback = source.captureContentMeasureCallback() as WidgetCallbackSnapshot
source.close()
sizeCallback.install(target)
sizeCallback.close()

auto size = target.measureContent(Vec2())
println(int(size.fX), int(size.fY))
ui.close()
proxy.close()
