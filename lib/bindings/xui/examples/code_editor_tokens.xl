import xui
from "./_window.xl" import Window

Window.show("Publish CodeEdit tokens",func(xui.Context ui,xui.Widget root)
 auto editor=ui.codeEditNative()
 Window.place(root,editor,24,24,560,180)
 assert editor.setText("note Remember to publish tokens for the current version.")==xui.XUI_OK

 // Highlight the first four UTF-8 bytes using the keyword style.
 auto keyword=xui.CodeToken()
 keyword.iEndOffset=4
 keyword.iStyle=xui.XUI_CODE_STYLE_KEYWORD
 keyword.iKind=xui.XUI_CODE_TOKEN_KEYWORD
 auto version=editor.documentVersion()
 auto cache=editor.tokenBuffer()
 cache.set([keyword],-1,version)

 auto snapshot=cache.capture(version)
 auto tokens=snapshot.tokens()
 snapshot.close()
 for token in tokens
  println("Keyword ends at byte",token.iEndOffset)
 end
end)
