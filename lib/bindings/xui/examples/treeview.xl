// Tree / expand and select. Run from release/<platform>; Escape or close exits.
import xui
import "./_support.xl" as demo

export class TreeviewExample
 static func build(xui.Context context,xui.Widget root,xui.Proxy proxy)
  demo.Gallery.label(context,root,"Tree / expand and select",24,16)
  auto control=context.treeViewNative()
  demo.Gallery.place(root,control,24,64,640,260)
  assert control.addNode(c_int(1),c_int(-1),"Project")>=0
  assert control.addNode(c_int(2),c_int(1),"Sources")>=0
  assert control.addNode(c_int(3),c_int(2),"main.xl")>=0
  control.setNodeExpanded(c_int(1),c_int(1))
  control.setNodeExpanded(c_int(2),c_int(1))
  assert control.setSelected(c_int(3))==0
 end
end

func main(...) as int
 return demo.Gallery.run("Tree / expand and select",TreeviewExample.build)
end
