// 展开 Project 和 Sources，选择 main.xl。
import xui
from "./_window.xl" import Window

Window.show("Tree / expand and select", func(xui.Context ui, xui.Widget root)
 auto tree = ui.treeViewNative()
 Window.place(root, tree, 24, 24, 640, 260)
 tree.addNode(1, -1, "Project")
 tree.addNode(2, 1, "Sources")
 tree.addNode(3, 2, "main.xl")
 tree.setNodeExpanded(1, 1)
 tree.setNodeExpanded(2, 1)
 tree.setSelected(3)
end)
