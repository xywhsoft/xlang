// 在同一次更新中为文件节点保存显示名称和实际路径。
import xui

func main(...) as int
    auto proxy = xui.createProxy()
    auto ui = xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
    try
        auto tree = ui.treeViewNative()
        xui.TreeNodeState project
        project.iId = 1
        project.iParent = -1
        project.bEnabled = 1
        xui.TreeNodeState source
        source.iId = 2
        source.iParent = 1
        source.bEnabled = 1

        array<string?> names = ["Project","main.xl"]
        array<var> data = [null, {"path": "src/main.xl"}]
        tree.setNodesWithData([project,source],names,values=data)
        assert tree.getVisibleCount() == 1
        assert tree.setNodeExpanded(1,1) == 0
        auto node,name = tree.getVisibleNode(1)
        println(name,"depth",node.iDepth,tree.getNodeData(node.iId)["path"])
    finally
        ui.close()
        proxy.close()
    end
    return 0
end
