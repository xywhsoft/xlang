// QR code / UTF-8 content. Run from release/<platform>; Escape or close exits.
import xui
import "./_support.xl" as demo

export class QrcodeExample
 static func build(xui.Context context,xui.Widget root,xui.Proxy proxy)
  demo.Gallery.label(context,root,"QR code / UTF-8 content",24,16)
  auto control=context.qrCodeNative()
  demo.Gallery.place(root,control,24,64,640,280)
  control.setValue("xlang XUI 3")
  control.setColors(c_uint(0x000000FF),c_uint(0xFFFFFFFF))
  assert (control.getValue() as string)=="xlang XUI 3"
 end
end

func main(...) as int
 return demo.Gallery.run("QR code / UTF-8 content",QrcodeExample.build)
end
