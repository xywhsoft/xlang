// 展开 General，编辑 Name 和 Mode。
import xui
from "./_window.xl" import Window

Window.show("Property grid / editable values", func(xui.Context ui, xui.Widget root)
 auto properties = ui.propertyGridNative()
 properties.setFont(ui.getDefaultFont())
 Window.place(root, properties, 24, 24, 640, 300)
 c_int category = properties.addCategory("general", "General", 1)
 properties.addProperty(category, "name", "Name", description = "Project name", value = "xlang")
 properties.addProperty(category, "mode", "Mode", value = "Release")
end)
