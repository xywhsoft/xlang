// 两条聊天消息对应两个 addNode 调用。
import xui
from "./_window.xl" import Window

Window.show("Message list / structured nodes", func(xui.Context ui, xui.Widget root)
 auto messages = ui.messageListNative()
 Window.place(root, messages, 24, 24, 640, 320)
 messages.addNode("m1", "Hello from xlang", sender = "Alice", time = "12:00")
 messages.addNode("m2", "Native XUI message rendering", sender = "Bob", time = "12:01")
 messages.appendNodeText("m2", " - appended text")
end)
