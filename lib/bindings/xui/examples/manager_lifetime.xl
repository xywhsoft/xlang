// Create and inspect a manager without opening its dialog.
import xui

auto proxy = xui.createProxy()
try
 auto ui = xui.create(proxy)
 try
  auto box = xui.createMsgBox(ui, "Example", "The Context owns this manager")
  println(box.title())
  println(box.message())
  box.close()
 finally
  ui.close()
 end
finally
 proxy.close()
end
