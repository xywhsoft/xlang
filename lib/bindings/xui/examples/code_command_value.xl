import xui
from xui import CallbackWidget, CallbackCodeCommandInput, CallbackInt

auto proxy = xui.createProxy()
auto ui = xui.create(proxy, xui.XUI_SYSTEM_FONT_DISABLED)
auto editor = ui.codeEditNative()
auto providers = editor.providers()
auto command = xui.XUI_CODE_COMMAND_USER_BASE

// The command receives a Value, such as a string, number or object.
providers.setValueCommandProvider(func(CallbackWidget widget,c_int id,CallbackCodeCommandInput input,CallbackInt handled) as c_int
    if id != command then return xui.XUI_ERROR_UNSUPPORTED end
    println(input.value() as string)
    handled.value = 1
    return xui.XUI_OK
end)
assert providers.executeCommandWithValue(editor, command, "打开搜索结果") == 1

ui.close()
proxy.close()
