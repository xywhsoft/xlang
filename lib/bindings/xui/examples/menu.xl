// Menu / command selection
import xui
from "./_window.xl" import Window

Window.show("Menu / command selection", func(xui.Context ui, xui.Widget root)
 auto menu = ui.menuNative()
 // Menu creates and owns its Popup; it is already attached to that client.
 menu.addItem("New", shortcut = "Ctrl+N", value = 1)
 menu.addItem("Open", shortcut = "Ctrl+O", value = 2)
 menu.addSeparator()
 menu.addItem("Save", shortcut = "Ctrl+S", value = 3)
 auto result = ui.labelNative()
 result.setText("选择菜单项后，这里显示命令编号")
 Window.place(root, result, 24, 124, 640, 32)
 auto owner = ui.buttonNative()
 owner.setText("Open menu")
 Window.place(root, owner, 24, 64, 240, 44)
 owner.setClick(func(xui.Widget source)
  menu.openForOwner(source)
 end)
 menu.setSelect(func(xui.Widget source, c_int index, c_int value)
  result.setText("命令编号："+string(int(value)))
 end)
end)
