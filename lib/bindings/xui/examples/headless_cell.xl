// A table cell can store display text, a tooltip and an independent value.
import xui

auto cell = xui.createTableCell()
cell.setText("Answer")
cell.setTooltip("An independent cached cell")
cell.setValue(42)

auto shared = cell.share()
cell.close() // 共享句柄仍持有同一份单元格数据。
println(shared.text())
println(shared.tooltip())
println(shared.value())
shared.close()
