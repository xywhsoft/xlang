// 四个步骤来自一个字符串数组。
import xui
from "./_window.xl" import Window

Window.show("Step bar / workflow stages", func(xui.Context ui, xui.Widget root)
 auto steps = ui.stepBarNative()
 Window.place(root, steps, 24, 24, 640, 92)
 steps.setSteps(["Configure", "Build", "Run", "Finish"])
 steps.setCurrent(1)
end)
