// Commit a paragraph, then read it from an independently owned snapshot.
import xui

auto document = xui.createDocument()
try
 auto edit = document.beginTransaction()
 uint64 textNode = 0
 try
  uint64 paragraph = edit.insertNode(uint64(1), xui.XUI_DOCUMENT_APPEND, c_uint(xui.XUI_DOC_PARAGRAPH))
  textNode = edit.insertNode(paragraph, xui.XUI_DOCUMENT_APPEND, c_uint(xui.XUI_DOC_TEXT), text = "Hello, xlang")
  auto changes = edit.commit()
  changes.close()
 finally
  edit.close()
 end
 auto snapshot = document.snapshot()
 try
  auto text = Buffer()
  uint64 size = snapshot.copyText(textNode, text)
  text.resize(int(size)+1)
  snapshot.copyText(textNode, text)
  println(text.text(int(size)))
 finally
  snapshot.close()
 end
finally
 document.close()
end
