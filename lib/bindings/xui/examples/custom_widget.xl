import xui
from xui import CallbackWidget,CallbackDrawContext
from "./_window.xl" import Window

Window.showWithProxy("自绘控件",func(xui.Context ui,xui.Widget root,xui.Proxy proxy)
    auto paint=func(CallbackWidget widget,CallbackDrawContext draw,c_uint state) as c_int
        // 控件的缓存画布使用本地坐标。
        auto area=widget.rect()
        area.fX=0
        area.fY=0
        auto color=c_uint(widget.getInstanceState() as int)
        proxy.fillRect(draw,area,color)
        return 0
    end

    auto stateFlag=c_uint(xui.XUI_WIDGET_TYPE_MANAGED_STATE)
    auto tile=ui.registerWidgetTypeWithCallbacks("example.tile",flags=stateFlag,render=paint)

    auto blue=ui.createWidget(tile)
    blue.setInstanceState(0x3878B8FF)
    Window.place(root,blue,24,24,200,72)

    auto green=ui.createWidget(tile)
    green.setInstanceState(0x389866FF)
    Window.place(root,green,24,108,200,72)
end)
