// 每个单元格从 rows 读取文字；点击单元格可查看它的内容坐标矩形。
import xui
from "./_window.xl" import Window

Window.show("Tableview / columns and cells", func(xui.Context ui, xui.Widget root)
 auto table = ui.tableViewNative()
 Window.place(root, table, 24, 24, 640, 300)
 table.setColumns(["Name", "Value"], [250, 220])
 array<array<string>> rows = [["Alpha", "10"], ["Beta", "20"], ["Gamma", "30"]]
 table.setAdapter(func(xui.Widget table) as c_int
  return c_int(rows.length)
 end, func(xui.Widget table, c_int row, c_int column, xui.CallbackTableViewCellOutput cell) as c_int
  cell.setText(rows[int(row)][int(column)])
  return 0
 end)
 auto details=ui.labelNative()
 details.setText("Click a cell to inspect its content rectangle.")
 Window.place(root,details,24,336,640,32)
 table.setSelectionMode(xui.XUI_TABLE_VIEW_SELECTION_CELL)
 table.setSelect(func(xui.Widget sender,c_int row,c_int column,c_int selected)
  if selected!=0 and row>=0 and column>=0 then
   auto rectangle=table.getCellContentRect(row,column)
   details.setText("Content: x="+string(int(rectangle.fX))+", y="+string(int(rectangle.fY))+", width="+string(int(rectangle.fW))+", height="+string(int(rectangle.fH)))
  end
 end)
end)
