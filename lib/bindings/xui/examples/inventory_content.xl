import xui

auto proxy = xui.createProxy()
auto ui = xui.create(proxy, xui.XUI_SYSTEM_FONT_DISABLED)
try
    auto inventory = ui.inventoryGridNative()
    inventory.setSlotCount(3)

    auto item = xui.InventorySlotSettings()
    item.iItemId = 101
    item.iCount = 4
    item.iMaxCount = 20
    // Apply the item, hotkey and animation style together.
    item.iFlags = c_uint(xui.XUI_INVENTORY_SLOT_ANIMATION)
    inventory.setSlot(0, item, "Health potion", "1", animationScale=1.15)
    item.iFlags = c_uint(0)

    item.iItemId = 102
    item.iCount = 9
    inventory.setSlotContent(1, item, "Mana potion", "2")

    auto ranked = inventory.querySlots(
        c_uint(xui.XUI_INVENTORY_QUERY_EXCLUDE_EMPTY | xui.XUI_INVENTORY_QUERY_SORT_DESCENDING),
        0, 0, xui.XUI_INVENTORY_SORT_COUNT, "potion")
    for index in ranked.indices()
        auto settings, name, hotkey, _, _, _, _, _, _ = inventory.getSlot(index)
        println(name, " × ", settings.iCount, "  [", hotkey, "]")
    end
finally
    ui.close()
    proxy.close()
end
