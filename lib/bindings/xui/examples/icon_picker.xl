// 界面：选择一个图标；图标数据由 Context 管理，Picker 持有分类。
import xui
from "./_window.xl" import Window

Window.show("图标选择",func(xui.Context ui,xui.Widget root)
 auto category=xui.createIconCategory(ui,"shapes",xui.iconCategoryDescDefault())
 auto box=Window.rect(0,0,16,16)
 auto triangle=category.addSvgPath("三角形","M0 0 L16 0 L8 16 Z",box)
 category.addSvgPath("正方形","M0 0 H16 V16 H0 Z",box)
 category.addSvgPath("菱形","M8 0 L16 8 L8 16 L0 8 Z",box)

 auto picker=xui.createIconPicker(ui)
 picker.setCategory(category)
 picker.setSelectedId(triangle.id)
 Window.place(root,picker,24,24,260,42)
end)
