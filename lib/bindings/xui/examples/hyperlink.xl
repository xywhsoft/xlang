// Hyperlink / local click callback
import xui
from "./_window.xl" import Window

Window.show("Hyperlink / local click callback", func(xui.Context ui, xui.Widget root)
 auto hyperlink = ui.hyperlinkNative()
 Window.place(root, hyperlink, 24, 24, 640, 40)
 hyperlink.setText("点击这里修改文字")
 hyperlink.setClick(func(xui.Widget source)
  hyperlink.setText("链接的点击事件已执行")
 end)
end)
