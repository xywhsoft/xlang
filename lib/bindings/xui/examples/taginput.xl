// 输入文字并回车添加标签；点击标签上的关闭按钮删除。
import xui
from "./_window.xl" import Window

Window.show("Tag input / add and remove tags", func(xui.Context ui, xui.Widget root)
 auto taginput = ui.tagInputNative()
 Window.place(root, taginput, 24, 24, 640, 60)
 taginput.addTag("xlang")
 taginput.addTag("native")
 taginput.addTag("UTF-8")
end)
