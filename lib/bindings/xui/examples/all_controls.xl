func scene_button(xui.Context ui,xui.Widget root,xui.Proxy proxy) as xui.Widget?
 // 1. 创建按钮，设置它显示的文字。
 auto button = ui.buttonNative()
 button.setText("点我")

 // 2. 放到窗口中：左、上、宽、高，单位是像素。
 Window.place(root, button, 24, 24, 220, 44)

 // 3. 点击时修改同一个按钮的文字。
 button.setClick(func(xui.Widget sender)
  button.setText("你点击了按钮")
 end)
 return null
end

func scene_canvas(xui.Context ui,xui.Widget root,xui.Proxy proxy) as xui.Widget?
 auto canvas = ui.canvas()
 Window.place(root, canvas, 24, 24, 640, 360)
 canvas.setCanvasSize(640, 360)
 canvas.clear(c_uint(0x302820FF))
 canvas.drawRectFill(Window.rect(30, 30, 160, 90), c_uint(0xE89632FF))
 canvas.drawCircleFill(320, 100, 55, c_uint(0x50B890FF))
 canvas.setPen(1, 3, c_uint(0xFFFFFFFF))
 return null
end

func scene_carousel(xui.Context ui,xui.Widget root,xui.Proxy proxy) as xui.Widget?
 auto carousel = ui.carouselNative()
 Window.place(root, carousel, 24, 24, 640, 260)
 carousel.setPageCount(3)
 for i in range(0, 3)
  auto page = ui.widget()
  page.setRect(Window.rect(0, 0, 600, 240))
  page.setSizeMode(xui.XUI_SIZE_FILL, xui.XUI_SIZE_FILL)
  auto label = ui.labelNative()
  label.setText("Slide "+string(i+1))
  Window.place(page, label, 40, 80, 400, 28)
  carousel.addPageChild(c_int(i), page)
 end
 carousel.setCurrent(0, 0)
 return null
end

