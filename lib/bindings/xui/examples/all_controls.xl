func scene_menubar(xui.Context ui,xui.Widget root,xui.Proxy proxy) as xui.Widget?
 auto result = ui.labelNative()
 result.setText("请选择文件菜单中的命令")
 Window.place(root, result, 24, 100, 640, 32)

 auto fileMenu = ui.menuNative()
 fileMenu.addItem("新建", value = 1)
 fileMenu.addItem("打开", value = 2)
 fileMenu.addItem("保存", value = 3)

 auto bar = ui.menuBarNative()
 Window.place(root, bar, 24, 24, 640, 44)
 bar.addItem("文件", fileMenu, 0)
 bar.setSelect(func(xui.Widget sender, c_int index, c_int value)
  result.setText("命令编号："+string(int(value)))
 end)
 return null
end

func scene_cascader(xui.Context ui,xui.Widget root,xui.Proxy proxy) as xui.Widget?
 auto categories = ui.cascaderNative()
 Window.place(root, categories, 24, 24, 480, 44)
 categories.setPlaceholder("选择分类")
 array<string> names = ["开发", "设计", "编辑器", "编译器", "图标"]
 array<c_int> values = [10, 20, 11, 12, 21]
 array<c_int> parents = [-1, -1, 0, 0, 1]
 c_uint leaf = c_uint(xui.XUI_CASCADER_ITEM_LEAF)
 array<c_uint> flags = [0, 0, leaf, leaf, leaf]
 categories.setItems(names, values, parents, flags)
 return null
end

func scene_widget(xui.Context ui,xui.Widget root,xui.Proxy proxy) as xui.Widget?
 auto group = ui.widget()
 Window.place(root, group, 24, 24, 400, 160)

 auto button = ui.buttonNative()
 button.setText("我位于 group 内部的 (20, 20)")
 Window.place(group, button, 20, 20, 340, 44)
 return null
end

func scene_label(xui.Context ui,xui.Widget root,xui.Proxy proxy) as xui.Widget?
 auto heading = ui.labelNative()
 heading.setText("你好，xlang！")
 Window.place(root, heading, 24, 24, 500, 32)

 auto detail = ui.labelNative()
 detail.setText("修改 setText 的参数，再运行就能看到变化。")
 Window.place(root, detail, 24, 80, 640, 32)
 return null
end

func scene_documenteditor(xui.Context ui,xui.Widget root,xui.Proxy proxy) as xui.Widget?
 auto document = xui.createDocument()
 try
  auto transaction = document.beginTransaction()
  try
   uint64 paragraph = transaction.insertNode(uint64(1), xui.XUI_DOCUMENT_APPEND, c_uint(xui.XUI_DOC_PARAGRAPH))
   transaction.insertNode(paragraph, xui.XUI_DOCUMENT_APPEND, c_uint(xui.XUI_DOC_TEXT), text = "在这里输入文字，试试选择、撤销和重做。")
   auto changes = transaction.commit()
   changes.close()
  finally
   transaction.close()
  end

  auto editor = xui.createDocumentEditor(ui, document)
  Window.place(root, editor, 24, 24, 680, 360)
 finally
  // 编辑器保留原生文档引用；这里释放创建者自己的引用。
  document.close()
 end
 return null
end

