func scene_tablegrid(xui.Context ui,xui.Widget root,xui.Proxy proxy) as xui.Widget?
 auto table = ui.tableGridNative()
 Window.place(root, table, 24, 24, 640, 300)
 table.setColumns(["Name", "Value"], [250, 220])
 array<array<string>> rows = [["Alpha", "10"], ["Beta", "20"], ["Gamma", "30"]]
 table.setAdapter(func(xui.Widget table) as c_int
  return c_int(rows.length)
 end, func(xui.Widget table, c_int row, c_int column, xui.CallbackTableViewCellOutput cell) as c_int
  cell.setText(rows[int(row)][int(column)])
  return 0
 end, func(xui.Widget table, c_int row, c_int column, xui.CString value, c_int type)
  rows[int(row)][int(column)] = value.copy()
 end)
 return null
end

