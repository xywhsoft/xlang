Window.showWithProxy("Control gallery",func(xui.Context ui,xui.Widget root,xui.Proxy proxy)
 auto selector=ui.comboBoxNative()
 Window.place(root,selector,24,12,640,40)
 selector.setItems(["accordion","basic","breadcrumb","button","canvas","carousel","chart","checkbox","codeedit","colorpicker","combobox","datepicker","dockpanel","hyperlink","image","input","listview","menu","messagelist","numericinput","page","panel","popup","progress","propertygrid","qrcode","radio","rangeslider","richtext","scrollbar","scrollview","separator","slider","splitlayout","statusbar","stepbar","tablegrid","tableview","tabs","taginput","terminal","textedit","timeline","toggle","toolbar","treeview","window","checkcard","radiogroup","virtualjoystick","inventorygrid","scrollframe","menubar","cascader","widget","label","documenteditor"])
 selector.setSelected(0)
 xui.Widget? current=null
 xui.Widget? floating=null
 auto showScene=func(c_int index)
  if floating!=null then
   auto overlay=floating as Widget
   overlay.close()
   floating=null
  end
  if current!=null then
   auto previous=current as Widget
   previous.close()
  end
  auto page=ui.widget()
  current=page
  Window.place(root,page,0,64,760,480)
  floating=populate(index,ui,page,proxy)
  ui.invalidateAll()
 end
 selector.setSelect(func(xui.Widget sender,c_int index,c_int value)
  if index>=0 and int(index)<57 then showScene(index) end
 end)
 showScene(c_int(0))
 // Acceptance slideshow; individual lessons contain no synthetic events.
 if env.get("XUI_EXAMPLE_CYCLE")!=null then
  selector.setSelect(null)
  println("SCENE 0")
  int tick=0
  int scene=0
  root.setUpdateCallback(func(xui.Widget sender,c_float delta) as c_int
   tick+=1
   if tick%3==0 and scene+1<57 then
    scene+=1
    showScene(c_int(scene))
    selector.setSelected(c_int(scene))
    println("SCENE "+string(scene))
   end
   return c_int(0)
  end)
 end
end)
