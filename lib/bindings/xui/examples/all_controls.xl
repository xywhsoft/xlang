// Generated gallery. Start learning with button.xl.
import xui
from xui import Widget
from "./_window.xl" import Window

func scene_accordion(xui.Context ui,xui.Widget root,xui.Proxy proxy) as xui.Widget?
 auto accordion = ui.accordionNative()
 Window.place(root, accordion, 24, 24, 640, 340)
 accordion.addSection("Project", 1, 1)
 auto first = accordion.getClientWidget(0)
 auto button = ui.buttonNative()
 button.setText("Build project")
 Window.place(first as Widget, button, 16, 16, 200, 44)
 accordion.addSection("Settings", 2, 0)
 auto second = accordion.getClientWidget(1)
 auto label = ui.labelNative()
 label.setText("Second section")
 Window.place(second as Widget, label, 16, 16, 300, 28)
 return null
end

func scene_basic(xui.Context ui,xui.Widget root,xui.Proxy proxy) as xui.Widget?
 auto button = ui.buttonNative()
 button.setText("Click to change the label")
 Window.place(root, button, 24, 64, 300, 44)
 auto status = ui.labelNative()
 status.setText("Waiting for a click")
 Window.place(root, status, 24, 124, 480, 32)
 button.setClick(func(xui.Widget source)
  status.setText("The typed callback ran")
 end)
 auto check = ui.checkBoxNative()
 check.setText("Enable feature")
 Window.place(root, check, 24, 180, 300, 44)
 auto toggle = ui.toggleNative()
 toggle.setText("Live preview")
 Window.place(root, toggle, 24, 240, 300, 44)
 return null
end

