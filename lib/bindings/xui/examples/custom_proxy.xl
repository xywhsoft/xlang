// 自定义后端用普通函数接收 XUI 的请求。
import xui

func capabilities(xui.CallbackProxy backend, xui.CallbackProxyCapsOutput output) as c_int
    output.value = xui.ProxyCaps()
    return c_int(0)
end

func scheduleFrame(xui.CallbackProxy backend, c_float delay)
    println("请求下一帧，延迟秒数", delay)
end

func main(...) as int
    auto backend = xui.createCustomProxy(capabilities, requestFrame=scheduleFrame)
    backend.requestFrame(0.25)
    backend.close()
    return 0
end
