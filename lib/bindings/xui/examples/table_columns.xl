// Configure a numeric table column and read its resolved width and title.
import xge
import xui

func main(...) as int
    xge.init(32,32,"Table columns",c_int(xge.XGE_INIT_OFFSCREEN),xge.XGE_RUN_MANUAL)
    auto proxy = xui.createProxy()
    auto ui = xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
    try
        auto table = ui.tableViewNative()
        xui.TableColumnSettings price
        price.iId = 1
        price.iType = xui.XUI_TABLE_CELL_TYPE_INT
        price.iAlign = xui.XUI_TEXT_ALIGN_RIGHT
        price.fWidth = 160
        price.fMinWidth = 64
        price.fMaxWidth = 128
        array<string?> ids = ["price"]
        array<string?> titles = ["Price"]
        table.setColumnsDetailed([price],ids,titles)
        auto settings,id,title,rect = table.getColumn(0)
        println(title,settings.fWidth)
    finally
        ui.close()
        proxy.close()
        xge.unit()
    end
    return 0
end
