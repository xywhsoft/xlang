import xui
from "./_window.xl" import Window

Window.show("CodeEdit document and selection",func(xui.Context ui,xui.Widget root)
 auto editor=ui.codeEditNative()
 Window.place(root,editor,24,24,560,160)

 auto document=editor.document()
 document.setText("你好，xlang！\n")

 // The two selected characters occupy six UTF-8 bytes.
 auto selection=editor.selection()
 selection.setRange(document,0,6)
 auto start,finish=selection.getRange()
 println("Selection bytes ",start,"–",finish)
end)
