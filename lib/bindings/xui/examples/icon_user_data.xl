import xui

// A shortcut and its target can carry independent application data.
func main(...) as int
    auto proxy = xui.createProxy()
    auto ui = xui.create(proxy, xui.XUI_SYSTEM_FONT_DISABLED)
    auto icons = xui.createIconCategory(ui, "actions", xui.iconCategoryDescDefault())

    xui.Rect bounds
    bounds.fW = 16
    bounds.fH = 16
    auto openIcon = icons.addSvgPath("open", "M2 5 H14 V13 H2 Z", bounds)
    auto shortcut = icons.addAlias("sidebar-open", openIcon)
    openIcon.setUserData({"action": "Open"})
    shortcut.setUserData({"location": "Sidebar"})

    println(openIcon.getUserData()["action"], shortcut.getUserData()["location"])
    ui.close()
    proxy.close()
    return 0
end
