export typedef ResourceReservation = func() as c_int

// Holds a registry reservation until closed. Context close expires it.
export extern "xui_resource_reference_t*" class ResourceReference @header("xui3_resource_reference.h") @lifetime("owned") @policy("xl6Xui3ResourceReferencePolicy")
 native point handle
 extern "xuiResourceReferenceIsLive" @no_raise @c_const(0) func isLive() as bool
 extern "xl6ForeignViewCloseV1" @no_raise @c_control(0) @c_result("bool_status") func close()
end

extern "xuiResourceReferenceRelease" @header("xge3_runtime.h") @no_raise @c_result("status",0) func rollbackResourceReference(ResourceReference reference)

// The registry owns entries. Removing or replacing one expires its Resource
// views. A Surface or Font returned by a getter owns an independent reference.
export extern "xui_resource_t*" class Resource @header("xge3_runtime.h") @lifetime("owner") @owner(Context) @policy("xl6Xui3ResourcePolicy") @watch("xui_lifetime_link_t")
 native point handle
 extern "xuiResourceGetName" @no_raise @c_result("cstring") get name() as string
 extern "xuiResourceGetKind" @no_raise get kind() as c_int
 extern "xuiResourceGetGeneration" @no_raise get generation() as c_uint
 extern "xuiResourceGetRefCount" @no_raise get nativeReferenceCount() as c_int
 extern "xuiResourceRetainReference" @no_raise @c_result("owned_view") @factory(1,0,rollbackResourceReference) func retain() as ResourceReference
 extern "xuiResourceWithReservation" @no_raise @c_sync_callback(0,-1,-16) @c_result("status",0) func withReservation(ResourceReservation visitor)
 extern "xuiResourceGetSurface" @no_raise @c_result("retained_view") @c_retain(retainSurface,"zero",rollbackSurface) func surface() as Surface?
 extern "xuiResourceGetFont" @no_raise @c_result("retained_view") @c_retain(retainFont,"zero",rollbackFont) func font() as Font?
 extern "xuiResourceGetDependencyCount" @no_raise func dependencyCount() as c_int
 extern "xuiResourceGetDependency" @no_raise @c_result("owner_view",0) func dependencyAt(c_int index) as Resource?
 extern "xuiResourceAddDependency" @no_raise @c_result("status",0) func addDependency(Resource dependency)
 extern "xuiResourceClearDependencies" @no_raise func clearDependencies()
 extern "xuiResourceTouch" @no_raise @c_result("status",0) func touch()
 extern "xuiResourceRemove" @no_raise @c_result("status",0) func remove()
end
