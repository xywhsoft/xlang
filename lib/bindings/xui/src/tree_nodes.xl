export extern "xui_tree_node_state_t" struct TreeNodeState @header("xge3_runtime.h")
 c_int iId
 c_int iParent
 c_int iDepth
 c_int bExpanded
 c_int bEnabled
 c_int bHasChildren
 c_int bIconReserved
 c_int bCheckReserved
 c_int bChecked
end

export extern "const xui_tree_view_node_t*" class CallbackTreeNode @header("xge3_runtime.h") @lifetime("callback")
 native point handle
 extern "iId" @c_field get id() as c_int
 extern "iParent" @c_field get parentId() as c_int
 extern "iDepth" @c_field get depth() as c_int
 extern "sText" @c_field @c_result("cstring") get text() as string
 extern "bExpanded" @c_field get expanded() as c_int
 extern "bEnabled" @c_field get enabled() as c_int
 extern "bHasChildren" @c_field get hasChildren() as c_int
 extern "bIconReserved" @c_field get iconReserved() as c_int
 extern "bCheckReserved" @c_field get checkReserved() as c_int
 extern "bChecked" @c_field get checked() as c_int
end
