// Explicit C-interop pointer identity; no ownership or dereference methods.
export extern "xui_widget_t*" class NativeWidgetPointer @header("xge3_runtime.h") @lifetime("caller")
 native point handle
end
// Independent native scope. Editors remain owned by their Context; XGE removes
// them on native destruction and detaches them when this scope closes.
