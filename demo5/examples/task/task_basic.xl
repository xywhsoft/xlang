import std.task

async func slow_add() as int
	return 4
end

async func slow_mul() as int
	return 6
end

async func slow_sub() as int
	return 3
end

func main() as int
	const int winner = task.race(task.spawn(slow_add()), task.all(task.spawn(slow_mul()), task.spawn(slow_sub())))
	const int canceled = task.cancel(task.spawn(slow_mul()))
	return winner + canceled
end
