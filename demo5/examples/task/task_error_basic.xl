import std.task

async func fail() as error
	return Error("boom")
end

async func main() as int
	const error winner = await task.race(task.spawn(fail()), task.all(task.spawn(Error("left")), task.spawn(Error("right"))))
	if winner.message == "boom"
		return task.cancel(task.spawn(winner))
	end
	return 0
end
