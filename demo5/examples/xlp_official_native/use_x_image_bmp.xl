import x.image.bmp
import std.fs

func main() as int
	auto dir = "release\\tmp\\x_image_bmp"
	auto path = dir + "\\tiny.bmp"

	if fs.mkdir_all(dir) == false
		return 1
	end
	if x.image.bmp.write_test_bmp(path, 2, 3) == false
		return 2
	end

	if x.image.bmp.is_bmp(path) == false
		return 3
	end
	if x.image.bmp.width(path) != 2
		return 4
	end
	if x.image.bmp.height(path) != 3
		return 5
	end
	if x.image.bmp.is_bmp(path + ".missing")
		return 6
	end
	return x.image.bmp.width(path) * 10 + x.image.bmp.height(path)
end
