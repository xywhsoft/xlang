import x.archive.zip
import std.fs

func main() as int
	auto dir = "release\\tmp\\x_archive_zip"
	auto path = dir + "\\one.zip"

	if fs.mkdir_all(dir) == false
		return 1
	end
	if x.archive.zip.write_test_zip(path, "note.txt", "hello zip") == false
		return 2
	end
	if x.archive.zip.count(path) != 1
		return 3
	end
	if x.archive.zip.first_name(path) != "note.txt"
		return 4
	end
	if x.archive.zip.count(path + ".missing") != 0
		return 5
	end
	return x.archive.zip.count(path) * 40 + x.archive.zip.first_name(path).length
end
