import x.xml

func main() as int
	auto escaped = x.xml.escape_text("a < b & c > d")
	auto doc = x.xml.tag("note", "hello <xml>")

	if escaped != "a &lt; b &amp; c &gt; d"
		return 1
	end
	if x.xml.unescape_text(escaped) != "a < b & c > d"
		return 2
	end
	if doc != "<note>hello &lt;xml&gt;</note>"
		return 3
	end
	if x.xml.text_of(doc, "note") != "hello <xml>"
		return 4
	end
	return x.xml.version + escaped.length
end
