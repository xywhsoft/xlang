import x.ini

func main() as int
	auto conf = "name = xlang\nport=8080\n; skip\nhost = localhost"
	auto values = x.ini.parse(conf)

	if values.length != 3
		return 1
	end
	if values["name"] != "xlang"
		return 2
	end
	if x.ini.get(conf, "host", "") != "localhost"
		return 3
	end
	if x.ini.get(conf, "missing", "fallback") != "fallback"
		return 4
	end
	if x.ini.has_key(conf, "port") == false
		return 5
	end
	return values.length + x.ini.version
end
