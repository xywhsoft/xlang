var int total = 0

class InnerBox extends object
	var value as int

	create(int value)
		self.value = value
	end

	destroy()
		total = total + self.value
	end
end

class OuterBox extends object
	var inner as InnerBox

	create(int value)
		self.inner = InnerBox(value)
	end

	destroy()
	end
end

func main() as int
	auto outer = OuterBox(10)
	outer.inner = InnerBox(30)
	return total + outer.inner.value
end
