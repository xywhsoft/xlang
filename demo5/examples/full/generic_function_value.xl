func call<T>(function<T(T)> op, T value) as T
	return op(value)
end

func inc(int value) as int
	return value + 1
end

func echo(string value) as string
	return value
end

func main() as int
	function<int(int)> plus = inc
	function<string(string)> text = echo
	if call(text, "ok") == "ok" then
		return call(plus, 40) + 1
	end
	return 0
end
