var int total = 0

class GenDefaultBox extends object
	var value as int

	create()
		self.value = 23
		total = total + 1
	end

	destroy()
		total = total + self.value
	end
end

func make_values() as int
	GenDefaultBox box
	yield box.value
	return 0
end

func main() as int
	auto gen = make_values()
	auto ok1, value1 = gen.next()
	auto ok2, value2 = gen.next()
	if (not ok1) or ok2 then
		return -1
	end
	if int(value1) != 23 then
		return -2
	end
	if total != 24 then
		return -3
	end
	return int(value1) + total
end
