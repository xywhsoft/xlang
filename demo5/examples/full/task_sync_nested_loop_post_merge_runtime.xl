import std.task

func choose_nested_post(task left, task mid, task right, int outer_steps, int inner_steps, bool pick_right, bool keep_mid) as task
	task result = left
	int outer = 0
	while outer < outer_steps do
		outer = outer + 1
		int inner = 0
		while inner < inner_steps do
			inner = inner + 1
			if outer == 1 and inner == 1 then
				continue
			end
			result = pick_right ? right : mid
			if outer == outer_steps and inner == inner_steps then
				break
			end
		end
	end
	result = keep_mid ? mid : result
	return result
end

async func main() as int
	return await choose_nested_post(task.delay(1), task.delay(10), task.delay(41), 2, 2, true, false) + 1
end
