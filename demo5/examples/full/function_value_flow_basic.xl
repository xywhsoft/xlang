func add(int a, int b) as int
	return a + b
end

func choose() as function<int(int,int)>
	return add
end

func apply(function<int(int,int)> op, int a, int b) as int
	return op(a, b)
end

func main() as int
	auto picked = choose()
	var dyn = choose()
	return apply(add, 10, 10) + apply(picked, 11, 10) + apply(dyn, 1, 0)
end
