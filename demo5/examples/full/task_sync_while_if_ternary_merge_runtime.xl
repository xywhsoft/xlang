import std.task

func choose_loop_branch(task left, task mid, task right, int steps, bool enabled, bool pick_right) as task
	task result = left
	int i = 0
	while i < steps do
		if enabled
			result = pick_right ? right : mid
		end
		i = i + 1
	end
	return result
end

async func main() as int
	return await choose_loop_branch(task.delay(1), task.delay(10), task.delay(41), 1, true, true) + 1
end
