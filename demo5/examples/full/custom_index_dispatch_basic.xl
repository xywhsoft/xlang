custom Slot
	func op_index(int index) as int
		return index + 2
	end

	func op_index_set(int index, int value) as int
		return index + value
	end
end

func main() as int
	auto slot = Slot()
	auto before = slot.length
	if slot[40] != 42 then
		return 1
	end
	slot[40] = 2
	if slot.length != before then
		return 2
	end
	return 42
end
