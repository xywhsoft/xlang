var int destroys = 0

class UnionItem extends object
	var value as int

	create()
		self.value = 1
	end

	destroy()
		destroys = destroys + 1
	end
end

class UnionHolder extends object
	union Data
		var left as UnionItem
		var right as UnionItem
	end

	destroy()
		destroys = destroys + 10
	end
end

func make_drop() as int
	auto holder = UnionHolder()
	return 0
end

func main() as int
	auto rc = make_drop()
	if rc != 0 then
		return rc
	end
	return destroys
end
