class Vec2
	var x as int
end

class Entity extends object
	var id as int
end

custom Token extends object
	var score as int
end

func main() as int
	if int.kind != "builtin" then
		return 1
	end
	if int.isBuiltin != true or int.isClass != false then
		return 2
	end

	if Vec2.kind != "plain" then
		return 3
	end
	if Vec2.isClass != true or Vec2.isBuiltin != false then
		return 4
	end

	if Entity.kind != "object" then
		return 5
	end
	if Entity.isClass != true or Entity.isBuiltin != false then
		return 6
	end

	if Token.kind != "custom" then
		return 7
	end
	if Token.isClass != true or Token.isBuiltin != false then
		return 8
	end

	var dyn = Entity()
	if Type(dyn).kind != "object" then
		return 9
	end
	if Type(dyn).isClass != true or Type(dyn).isBuiltin != false then
		return 10
	end

	return 42
end
