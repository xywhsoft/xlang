#loadlib "../xlp_native/packages/pkg.probe/bin/pkg_probe.dll"

extern "pkg_clock_artifact_point_sentinel" func sentinel_payload() as point
extern "pkg_clock_artifact_bool_score" func Token.score(Token self) as int

custom Token
	create()
		self.payload = sentinel_payload()
	end
end

func main() as int
	auto token = Token()
	point raw = token.payload

	if raw == point(null) then
		return 1
	end
	if token.score() != 7 then
		return 2
	end

	token.payload = point(null)
	if token.score() != 3 then
		return 3
	end

	return 42
end
