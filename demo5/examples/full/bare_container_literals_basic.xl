func main() as int
	auto text_map = {"b": "hello", "c": " world"}
	auto values = [40, 2]
	auto sparse = [1: 10, 3: 20]
	auto flags = {4, 5}
	auto empty_map = {}
	int total = 0

	if text_map["b"] + text_map["c"] == "hello world" then
		total += 1
	end
	if values[0] == 40 then
		total += 2
	end
	if values[1] == 2 then
		total += 4
	end
	if sparse[1] == 10 then
		total += 8
	end
	if sparse[3] == 20 then
		total += 16
	end
	if sparse.len() == 2 then
		total += 32
	end
	if 4 in flags then
		total += 64
	end
	if empty_map.len() == 0 then
		total += 128
	end

	return total
end
