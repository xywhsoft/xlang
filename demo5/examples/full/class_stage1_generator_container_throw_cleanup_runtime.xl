var int copies = 0
var int destroys = 0

class GenThrowItem extends object
	var value as int

	create(int value)
		self.value = value
	end

	destroy()
		destroys = destroys + 1
	end

	func copy() as GenThrowItem
		copies = copies + 1
		return GenThrowItem(self.value)
	end
end

func make_values() as int
	try
		auto item = GenThrowItem(10)
		auto values = [item]
		yield item.value
		throw Error("generator class cleanup")
	catch e
		if e.message == "generator class cleanup" then
			yield 5
		end
	end
	return 0
end

func main() as int
	int sum = 0

	for value in make_values()
		sum += value
	end

	if sum != 15 then
		return -1
	end
	if copies != 1 then
		return -2
	end
	if destroys != 2 then
		return -3
	end
	return sum + copies * 10 + destroys
end
