import std.object

class Node extends object
end

func make_cycle() as point
	var a = Node()
	var wa = std.object.weak(a)
	var box = [a]
	var hold = func() as int
		return box.length
	end

	a.peer = hold
	return wa
end

func main() as int
	var wa = make_cycle()

	if not std.object.alive(wa)
		return 1
	end
	if std.object.collect() != 1
		return 2
	end
	if std.object.alive(wa)
		return 3
	end

	std.object.release(wa)
	return 42
end
