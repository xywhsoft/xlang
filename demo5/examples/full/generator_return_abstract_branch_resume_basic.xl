func left_values() as int
	auto current = int((yield 1))
	yield current + 1
	return 0
end

func right_values() as int
	auto current = int((yield 2))
	yield current + 2
	return 0
end

func choose(bool flag) as generator
	if flag
		return left_values()
	end
	return right_values()
end

func main() as int
	auto g = choose(true)
	auto ok1, value1 = g.next()
	auto ok2, value2 = g.resume(7)
	if (not ok1) or (not ok2)
		return -1
	end
	return int(value1) + int(value2)
end
