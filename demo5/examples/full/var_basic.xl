func passthrough(var v) as var
	return v
end

func read_int(var v) as int
	int local = v
	return local + 1
end

func read_text(var v) as string
	string text = v
	return text
end

func main() as int
	var value = 40
	value = 41

	int number = passthrough(value)
	var message = passthrough("hello")
	string text = message

	if number == 41 and passthrough(value) == 41 and passthrough("hello") == "hello" and read_int(value) == 42 and read_text("ok") == "ok" then
		return 42
	end
	return 0
end
