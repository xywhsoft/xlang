class Vec2
	var x as int
	var y as int

	func sum() as int
		return self.x + self.y
	end
end

class Entity extends object
	var id as int
end

custom Token extends object
	var score as int
end

func main() as int
	if Vec2.has_field("x") != true then
		return 1
	end
	if Vec2.has_field("z") != false then
		return 2
	end
	if Vec2.has_method("sum") != true then
		return 3
	end

	if Entity.has_field("id") != true then
		return 4
	end
	if Entity.has_method("keys") != true then
		return 5
	end
	if Entity.has_method("clone") != true then
		return 6
	end

	if Token.has_field("score") != true then
		return 7
	end
	if Token.has_method("set") != true then
		return 8
	end

	if string.has_method("split") != true then
		return 9
	end
	if int.has_field("x") != false then
		return 10
	end

	var dyn = Entity()
	if Type(dyn).has_method("keys") != true then
		return 11
	end
	if Type(dyn).has_field("id") != true then
		return 12
	end

	return 42
end
