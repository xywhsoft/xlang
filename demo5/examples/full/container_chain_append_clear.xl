func main() as int
	var array<int> values = []
	var list<int> items = list{}
	set flags = {1, 2}
	dict pairs = {"a": 1}

	values.append(1).append(2).clear().append(30)
	items.append(3).append(4).clear().append(40)
	flags.clear()
	pairs.clear()

	return values.length + items.length + flags.length + pairs.length + values[0] + items[0]
end
