import std.task

func choose_loop_continue(task left, task mid, task right, int steps, bool pick_right) as task
	task result = left
	int i = 0
	while i < steps do
		i = i + 1
		if i == 1 then
			continue
		end
		result = pick_right ? right : mid
	end
	return result
end

async func main() as int
	return await choose_loop_continue(task.delay(1), task.delay(10), task.delay(41), 2, true) + 1
end
