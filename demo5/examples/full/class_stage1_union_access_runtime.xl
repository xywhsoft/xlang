class UnionScalar extends object
	union Data
		var left as int
		var right as int
	end

	create(int value)
		self.left = value
	end

	func get_left() as int
		return self.left
	end

	func get_right() as int
		return self.right
	end
end

func main() as int
	auto item = UnionScalar(7)
	if item.left != 7 then
		return 1
	end
	item.right = 12
	if item.left != 12 then
		return 2
	end
	return item.get_left() + item.get_right()
end
