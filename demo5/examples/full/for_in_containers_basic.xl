func main() as int
	array values = [10, 20]
	list extra = list{3, 4}
	set flags = set{5, 7}
	dict scores = dict{"a": 6, "b": 8}
	int total = 0
	int set_total = 0
	int dict_total = 0

	for index, value in values
		total += index + value
	end

	for value in extra
		total += value
	end

	for index, value in flags
		set_total += index
		set_total += value
	end

	for key, value in scores
		if key == "a" then
			dict_total += value
		end
		if key == "b" then
			dict_total += value
		end
	end

	return total + set_total + dict_total
end
