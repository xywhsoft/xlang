var int total = 0

class Inner extends object
	var value as int

	create(int value)
		self.value = value
	end

	destroy()
		total = total + self.value
	end
end

class Outer extends object
	var inner as Inner

	create(int value)
		self.inner = Inner(value)
	end
end

func main() as int
	auto outer = Outer(40)
	delete outer.inner
	outer.inner = Inner(1)
	return total + outer.inner.value + 1
end
