import std.types as types

func main() as int
	auto desc = types.dynamic("Enemy", object)
	desc = types.add_field(desc, "hp", int)
	desc = types.add_field(desc, "title", string)

	if types.field_type_name(desc, "hp", "") != "int"
		return 1
	end
	if types.field_type_name(desc, "title", "") != "string"
		return 2
	end
	if types.field_type_name(desc, "missing", "fallback") != "fallback"
		return 3
	end

	auto t0 = types.field_type_name_at(desc, 0, "")
	auto t1 = types.field_type_name_at(desc, 1, "")
	auto saw_int = false
	auto saw_string = false
	if t0 == "int" or t1 == "int"
		saw_int = true
	end
	if t0 == "string" or t1 == "string"
		saw_string = true
	end
	if not saw_int or not saw_string
		return 4
	end

	auto obj = types.new_instance(desc)
	if types.instance_field_type_name(obj, "hp", "") != "int"
		return 5
	end
	if types.instance_field_type_name(obj, "title", "") != "string"
		return 6
	end
	if types.instance_field_type_name(obj, "missing", "fallback") != "fallback"
		return 7
	end

	auto it0 = types.instance_field_type_name_at(obj, 0, "")
	auto it1 = types.instance_field_type_name_at(obj, 1, "")
	auto instance_saw_int = false
	auto instance_saw_string = false
	if it0 == "int" or it1 == "int"
		instance_saw_int = true
	end
	if it0 == "string" or it1 == "string"
		instance_saw_string = true
	end
	if not instance_saw_int or not instance_saw_string
		return 8
	end

	return 42
end
