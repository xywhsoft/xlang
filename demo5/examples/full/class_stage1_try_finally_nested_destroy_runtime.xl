var int total = 0

class NestBox extends object
	var value as int

	create(int value)
		self.value = value
	end

	destroy()
		total = total * 10 + self.value
	end
end

func make_nested() as int
	auto outer = NestBox(1)
	try
		auto inner = NestBox(2)
		try
			auto leaf = NestBox(3)
			return 7
		finally
			total = total * 10 + 4
		end
	finally
		total = total * 10 + 5
	end

	return 0
end

func main() as int
	auto rc = make_nested()
	if rc != 7 then
		return rc
	end
	return total
end
