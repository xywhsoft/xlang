class BaseParam extends object
	var baseValue as int

	create(int seed)
		self.baseValue = seed * 2
	end
end

class ChildParam extends BaseParam
	var childValue as int

	create(int seed)
		base(seed)
		self.childValue = seed + 1
	end
end

func main() as int
	auto child = ChildParam(10)
	return child.baseValue + child.childValue
end
