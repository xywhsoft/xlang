func main() as int
	var text = "asd"
	var values = [1, 2]
	var labels = list{"A", "B"}
	var flags = {"x", "y"}
	var pairs = {"k": "v"}

	values.append(3)

	if text.replace("s", ".") != "a.d"
		return 1
	end
	if values.length != 3
		return 2
	end
	if labels.length != 2
		return 3
	end
	if labels.join("|") != "A|B"
		return 4
	end
	if not flags.has("x")
		return 5
	end
	if not pairs.has("k")
		return 6
	end
	return 42
end
