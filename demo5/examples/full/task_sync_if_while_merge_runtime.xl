import std.task

func choose_combo(task left, task mid, task right, bool pick_mid, int steps) as task
	task result = left
	if pick_mid
		result = mid
	end
	int i = 0
	while i < steps do
		result = right
		i = i + 1
	end
	return result
end

async func main() as int
	return await choose_combo(task.delay(1), task.delay(10), task.delay(41), true, 1) + 1
end
