import std.object

class Entity extends object
	var id as int
	var level as int

	func score() as int
		return self.id + self.level
	end
end

func main() as int
	auto e = Entity()
	e.id = 7
	e.level = 9
	e.note = "ok"

	auto names = std.object.field_names(e)
	if std.object.field_count(e) != 3 then
		return 1
	end
	if names.length != 3 then
		return 2
	end
	if std.object.field_name_at(e, 0, "") != "id" then
		return 3
	end
	if std.object.field_name_at(e, 1, "") != "level" then
		return 4
	end
	if std.object.field_name_at(e, 2, "") != "note" then
		return 5
	end
	if std.object.field_name_at(e, 3, "miss") != "miss" then
		return 6
	end
	if names[0] != "id" then
		return 7
	end
	if names[1] != "level" then
		return 8
	end
	if names[2] != "note" then
		return 9
	end
	if std.object.field_count(123) != 0 then
		return 10
	end
	if std.object.field_name_at(123, 0, "none") != "none" then
		return 11
	end

	return 42
end
