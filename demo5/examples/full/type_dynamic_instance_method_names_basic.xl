import std.types as types

func main() as int
	auto desc = types.dynamic("Enemy", object)
	desc = types.add_method(desc, "update")
	desc = types.add_method(desc, "draw")

	auto obj = types.new_instance(desc)
	if types.instance_method_count(obj) != 2
		return 1
	end

	auto names = types.instance_method_names(obj)
	if names.length != 2
		return 2
	end

	auto saw_update = false
	auto saw_draw = false
	auto n0 = types.instance_method_name_at(obj, 0, "")
	auto n1 = types.instance_method_name_at(obj, 1, "")
	if n0 == "update" or n1 == "update"
		saw_update = true
	end
	if n0 == "draw" or n1 == "draw"
		saw_draw = true
	end
	if not saw_update or not saw_draw
		return 3
	end

	if names[0] == "update" or names[1] == "update"
		saw_update = true
	end
	if names[0] == "draw" or names[1] == "draw"
		saw_draw = true
	end
	if not saw_update or not saw_draw
		return 4
	end

	return 42
end
