class Entity extends object
	var id as int
end

func main() as int
	auto e = Entity()
	e.id = 7
	e.name = "neo"

	var b = e
	if Type(b) != Entity then
		return 1
	end
	if b["id"] != 7 then
		return 2
	end
	if b["name"] != "neo" then
		return 3
	end

	e.name = "trinity"
	if b["name"] != "trinity" then
		return 4
	end
	return 42
end
