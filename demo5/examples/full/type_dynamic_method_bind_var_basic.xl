import std.types as types

func payload() as var
	return "ok"
end

func main() as int
	auto desc = types.dynamic("Enemy", object)
	desc = types.add_method(desc, "payload")
	desc = types.bind_method(desc, "payload", payload)

	auto obj = types.new_instance(desc)

	if not types.instance_has_method(obj, "payload")
		return 1
	end

	auto fn = types.instance_method(obj, "payload", null)
	if fn == null
		return 2
	end

	var left = function<var()>(fn)()
	var right = function<var()>(types.method_impl(desc, "payload", null))()
	string left_text = left
	string right_text = right

	if left_text != "ok"
		return 3
	end
	if right_text != "ok"
		return 4
	end

	return 42
end
