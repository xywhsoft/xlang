class PlainVec
	var x as int
	var y as int

	func sum() as int
		return self.x + self.y
	end

	func op_add(int rhs) as int
		return self.sum() + rhs
	end
end

func main() as int
	auto p = PlainVec()
	p.x = 19
	p.y = 21

	var v = p
	if v.x != 19 then
		return 1
	end
	if v.sum() != 40 then
		return 2
	end
	return v + 2
end
