var int total = 0

class Inner extends object
	var value as int

	create(int value)
		self.value = value
	end

	destroy()
		total = total + self.value
	end
end

class Outer extends object
	var inner as Inner
	var value as int

	create(int innerValue, int value)
		self.inner = Inner(innerValue)
		self.value = value
	end

	destroy()
		total = total + self.value
	end
end

func make() as int
	auto outer = Outer(7, 35)
	return 0
end

func main() as int
	make()
	return total
end
