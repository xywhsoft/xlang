import std.types as types

class Entity extends object
	var id as int
end

func main() as int
	auto desc = types.dynamic("Enemy", Entity)
	desc = types.add_field(desc, "hp", int)
	desc = types.add_field(desc, "title", string)
	desc = types.add_method(desc, "update")
	desc = types.add_method(desc, "draw")

	if types.field_count(desc) != 2
		return 1
	end
	if types.method_count(desc) != 2
		return 2
	end

	auto saw_hp = false
	auto saw_title = false
	auto saw_update = false
	auto saw_draw = false

	if types.field_count(desc) != 2
		return 3
	end
	if types.method_count(desc) != 2
		return 4
	end

	auto name0 = types.field_name_at(desc, 0, "")
	auto name1 = types.field_name_at(desc, 1, "")
	if name0 == "hp" or name1 == "hp"
		saw_hp = true
	end
	if name0 == "title" or name1 == "title"
		saw_title = true
	end
	auto method0 = types.method_name_at(desc, 0, "")
	auto method1 = types.method_name_at(desc, 1, "")
	if method0 == "update" or method1 == "update"
		saw_update = true
	end
	if method0 == "draw" or method1 == "draw"
		saw_draw = true
	end

	if not saw_hp or not saw_title or not saw_update or not saw_draw
		return 5
	end

	auto obj = types.new_instance(desc)
	if types.instance_field_count(obj) != 2
		return 6
	end

	auto instance_saw_hp = false
	auto instance_saw_title = false
	auto instance_name0 = types.instance_field_name_at(obj, 0, "")
	auto instance_name1 = types.instance_field_name_at(obj, 1, "")
	if instance_name0 == "hp" or instance_name1 == "hp"
		instance_saw_hp = true
	end
	if instance_name0 == "title" or instance_name1 == "title"
		instance_saw_title = true
	end
	if not instance_saw_hp or not instance_saw_title
		return 7
	end

	return 42
end
