var int copies = 0
var int destroys = 0

class GenCopyBox extends object
	var value as int

	create(int value)
		self.value = value
	end

	destroy()
		destroys = destroys + 1
	end

	func copy() as GenCopyBox
		copies = copies + 1
		return GenCopyBox(self.value)
	end
end

func make_values() as int
	auto source = GenCopyBox(11)
	yield 1
	auto copied = source
	yield copied.value
	return 0
end

func main() as int
	auto gen = make_values()
	auto ok1, value1 = gen.next()
	auto ok2, value2 = gen.next()
	auto ok3, value3 = gen.next()
	if (not ok1) or (not ok2) or ok3 then
		return -1
	end
	if int(value1) != 1 then
		return -2
	end
	if int(value2) != 11 then
		return -3
	end
	if copies != 1 then
		return -4
	end
	if destroys != 2 then
		return -5
	end
	return int(value1) + int(value2) + copies * 10 + destroys
end
