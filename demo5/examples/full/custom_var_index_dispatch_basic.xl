custom Slot
	func op_index(int index) as int
		return index + 2
	end

	func op_index_set(int index, int value) as int
		return index + value
	end
end

func main() as int
	auto slot = Slot()
	var v = slot
	auto before = v.length
	if v[40] != 42 then
		return 1
	end
	v[40] = 2
	if v.length != before then
		return 2
	end
	return 42
end
