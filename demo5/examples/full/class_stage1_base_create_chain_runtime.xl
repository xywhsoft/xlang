class BaseSeed extends object
	var baseValue as int

	create()
		self.baseValue = 17
	end
end

class ChildSeed extends BaseSeed
	var childValue as int

	create(int childValue)
		self.childValue = childValue
	end
end

func main() as int
	auto child = ChildSeed(25)
	return child.baseValue + child.childValue
end
