class Entity extends object
	var id as int
end

func main() as int
	auto e = Entity()
	e.id = 7
	e.name = "neo"

	int total = 0
	int pair_id = 0
	string pair_name = ""

	for k in e
		if k == "id" then
			total += 10
		end
		if k == "name" then
			total += 20
		end
	end

	for k, v in e
		if k == "id" then
			pair_id = v
		end
		if k == "name" then
			pair_name = v
		end
	end

	if pair_name != "neo" then
		return 1
	end
	return total + pair_id + 5
end
