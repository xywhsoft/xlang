import std.time

func main() as int
	const float near_left = 3.5
	const float near_right = 3.5000001
	const time first = time.parse("2024-01-02 03:04:05")
	const time second = time.parse("2024-01-02 03:04:06")
	if (near_left ~= near_right) and ("hello" ~= "h*o") and (first ~= second) then
		return 1
	end
	return 0
end
