func odd_before_break(int stop) as int
	int current = 0

	while current < stop do
		current += 1
		if current == 2 then
			continue
		end
		if current == 5 then
			break
		end
		yield current
	end

	return 0
end

func main() as int
	int sum = 0

	for value in odd_before_break(6)
		sum += value
	end

	return sum
end
