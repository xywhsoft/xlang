func forty() as int
	return 40
end

func two() as int
	return 2
end

class Bag extends object
end

func main() as int
	auto bag = Bag()
	bag.set("left", forty)
	bag.right = two

	var left = bag["left"]
	var right = bag.right

	if left == null
		return 1
	end
	if right == null
		return 2
	end

	return function<int()>(left)() + function<int()>(right)()
end
