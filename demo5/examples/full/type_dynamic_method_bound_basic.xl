import std.types as types

func score() as int
	return 42
end

func main() as int
	auto desc = types.dynamic("Enemy", object)
	desc = types.add_method(desc, "score")
	desc = types.add_method(desc, "draw")

	if types.has_bound_method(desc, "score")
		return 1
	end
	if types.has_bound_method(desc, "ghost")
		return 2
	end

	desc = types.bind_method(desc, "score", score)

	if not types.has_bound_method(desc, "score")
		return 3
	end
	if types.has_bound_method(desc, "draw")
		return 4
	end

	auto obj = types.new_instance(desc)
	if not types.instance_method_bound(obj, "score")
		return 5
	end
	if types.instance_method_bound(obj, "draw")
		return 6
	end
	if types.instance_method_bound(obj, "ghost")
		return 7
	end

	return 42
end
