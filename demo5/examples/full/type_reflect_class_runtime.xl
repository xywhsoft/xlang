class Vec2
	var x as int
end

class Entity extends object
	var id as int
end

custom Token extends object
	var score as int
end

func main() as int
	if Vec2.isPlainClass != true then
		return 1
	end
	if Vec2.isObject != false then
		return 2
	end
	if Vec2.isCustom != false then
		return 3
	end

	if Entity.base != object then
		return 4
	end
	if Entity.isObject != true then
		return 5
	end
	if Entity.isPlainClass != false then
		return 6
	end
	if Entity.isCustom != false then
		return 7
	end

	if Token.base != object then
		return 8
	end
	if Token.isObject != true then
		return 9
	end
	if Token.isCustom != true then
		return 10
	end
	if Token.isPlainClass != false then
		return 11
	end

	var dyn = Entity()
	if Type(dyn).base != object then
		return 12
	end
	if Type(dyn).isObject != true then
		return 13
	end
	if Type(dyn).isCustom != false then
		return 14
	end
	if Type(dyn).isPlainClass != false then
		return 15
	end

	return 42
end
