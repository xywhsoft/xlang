import std.fs
import std.io

func main() as int
	const string dir = "release\\tmp\\fs_basic"
	const string path = "release\\tmp\\fs_basic\\note.txt"
	if fs.mkdir_all(dir) == false
		return 1
	end
	if fs.write_all(path, "alpha") == false
		return 2
	end
	if fs.append_all(path, "\nbeta") == false
		return 3
	end
	if fs.exists(path) == false
		return 4
	end
	const string text = fs.read_all(path)
	io.println(text)
	return 0
end
