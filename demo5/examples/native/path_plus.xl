import std.path
import std.str

func main() as int
	const string full = "C:\\demo\\alpha.beta.txt"
	const string name_ext = path.name_ext(full)
	const string random_path = path.random("release\\tmp\\", ".dat", 6)

	if str.starts_with(name_ext, "alpha.") == false
		return 1
	end
	if str.ends_with(name_ext, ".txt") == false
		return 2
	end
	if str.starts_with(random_path, "release\\tmp\\") == false
		return 3
	end
	if str.ends_with(random_path, ".dat") == false
		return 4
	end
	return 0
end
