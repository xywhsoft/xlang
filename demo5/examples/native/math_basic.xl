import std.math

func main() as int
	if math.abs(-5) != 5
		return 1
	end
	if math.min(10, 3) != 3
		return 2
	end
	if math.max(10, 3) != 10
		return 3
	end
	if math.clamp(20, 0, 9) != 9
		return 4
	end
	if math.floor(3.9) != 3
		return 5
	end
	if math.ceil(3.1) != 4
		return 6
	end
	if math.round(3.6) != 4
		return 7
	end
	if math.sqrt(81) != 9
		return 8
	end
	if math.pow(3, 4) != 81
		return 9
	end
	if math.abs(-2.5) != 2.5
		return 10
	end
	if math.pi < 3.14
		return 11
	end
	if math.e < 2.71
		return 12
	end
	return 0
end
