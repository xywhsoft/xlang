import std.net.tls as tls

func main() as int
	auto versions = tls.versions()
	auto cfg = tls.client_config("example.com", true)
	auto fp = tls.fingerprint_sha256("abc")

	if versions.length != 2
		return 1
	end
	if versions[0] != "tls1.2"
		return 2
	end
	if tls.is_tls_url("https://example.com/a") == false
		return 3
	end
	if tls.is_tls_url("http://example.com/a") == true
		return 4
	end
	if tls.default_port("https") != 443
		return 5
	end
	if tls.default_port("imaps") != 993
		return 6
	end
	if tls.sni_host("https://user@example.com:443/a") != "example.com"
		return 7
	end
	if fp != "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
		return 8
	end
	if cfg["host"] != "example.com" or cfg["verify"] != "true"
		return 9
	end
	if cfg["min_version"] != "tls1.2" or cfg["max_version"] != "tls1.3"
		return 10
	end

	return 72
end
