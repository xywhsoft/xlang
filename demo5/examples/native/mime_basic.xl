import std.net.mime as mime

func main() as int
	auto json_type = mime.by_ext(".json")
	auto html_type = mime.by_path("site\\index.HTML")
	auto parsed = mime.parse("text/html; charset=utf-8; boundary=abc123")
	auto built = mime.build({"type": "multipart/form-data", "boundary": "x-1", "charset": "utf-8"})

	if json_type != "application/json"
		return 1
	end
	if html_type != "text/html"
		return 2
	end
	if mime.is_text("application/json") == false
		return 3
	end
	if mime.is_text("image/png")
		return 4
	end
	if parsed["type"] != "text/html"
		return 5
	end
	if parsed["charset"] != "utf-8"
		return 6
	end
	if parsed["boundary"] != "abc123"
		return 7
	end
	if built.contains("multipart/form-data") == false
		return 8
	end
	if built.contains("boundary=x-1") == false
		return 9
	end
	if built.contains("charset=utf-8") == false
		return 10
	end

	return 65
end
