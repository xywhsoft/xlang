import std.time
import std.str

func main() as int
	auto now = time.now()
	auto fmt = time.format(now, "yyyy-mm-dd")
	auto parsed = time.parse_format("2024-02-29", "yyyy-mm-dd")
	auto parsed_text = time.to_string(parsed)

	time.sleep(1)

	if str.contains(fmt, "-") == false
		return 1
	end
	if time.is_leap_year(2024) == false
		return 2
	end
	if time.is_leap_year(2023)
		return 3
	end
	if str.contains(parsed_text, "2024") == false
		return 4
	end
	return 0
end
