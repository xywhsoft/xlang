#loadlib "../xlp_native/packages/pkg.probe/bin/pkg_probe.dll"

class NativeInner extends object
	var x as int32
	var y as int32

	create(int32 x, int32 y)
		self.x = x
		self.y = y
	end
end

class NativeOuter extends object
	var inner as NativeInner
	var z as int32
	var scale as float64

	create(NativeInner inner, int32 z, float64 scale)
		self.inner = inner
		self.z = z
		self.scale = scale
	end
end

class NativeLarge extends object
	var a as int64
	var b as int64
	var c as int64
	var d as int64
	var weight as float64
	var bias as float64

	create(int64 a, int64 b, int64 c, int64 d, float64 weight, float64 bias)
		self.a = a
		self.b = b
		self.c = c
		self.d = d
		self.weight = weight
		self.bias = bias
	end
end

extern "pkg_clock_artifact_outer_slot" var outer_slot as NativeOuter
extern "pkg_clock_artifact_outer_make" func outer_make(int32 x, int32 y, int32 z, float64 scale) as NativeOuter
extern "pkg_clock_artifact_outer_score" func outer_score(NativeOuter outer) as int
extern "pkg_clock_artifact_outer_add" func outer_add(NativeOuter outer, int32 delta) as NativeOuter
extern "pkg_clock_artifact_outer_slot_score" func outer_slot_score() as int
extern "pkg_clock_artifact_large_make" func large_make(int64 a, int64 b, int64 c, int64 d, float64 weight, float64 bias) as NativeLarge
extern "pkg_clock_artifact_large_score" func large_score(NativeLarge large) as int
extern "pkg_clock_artifact_large_add" func large_add(NativeLarge large, int64 delta) as NativeLarge

func main() as int
	auto saved = outer_slot
	if outer_slot_score() != 42 then
		return 1
	end

	auto a = outer_make(10, 20, 9, 3.5)
	if outer_score(a) != 42 then
		return 2
	end
	if a.inner.x != 10 then
		return 3
	end
	if a.inner.y != 20 then
		return 4
	end

	auto b = outer_add(a, 1)
	if b.inner.x != 11 then
		return 5
	end
	if b.inner.y != 21 then
		return 6
	end
	if b.z != 10 then
		return 7
	end
	if b.scale < 4.4 then
		return 8
	end

	outer_slot = NativeOuter(NativeInner(8, 18), 12, 4.5)
	if outer_slot_score() != 42 then
		outer_slot = saved
		return 9
	end
	auto large = large_make(1, 2, 3, 4, 10.5, 21.5)
	if large_score(large) != 41 then
		outer_slot = saved
		return 10
	end
	auto large2 = large_add(large, 1)
	if large2.a != 2 then
		outer_slot = saved
		return 11
	end
	if large_score(large2) != 47 then
		outer_slot = saved
		return 12
	end
	outer_slot = saved
	return 42
end
