import std.channel as chm

async func main() as int
	auto ch = chm.make(2)
	bool sent0 = chm.send(ch, 10)
	bool sent1 = chm.send(ch, 20)
	bool sent2 = chm.send(ch, 30)
	auto pair0 = await chm.recv(ch)
	bool ok0 = bool(pair0[0])
	auto first = pair0[1]
	bool sent3 = chm.send(ch, 30)
	bool closed = chm.close(ch)
	auto pair1 = await chm.recv(ch)
	bool ok1 = bool(pair1[0])
	auto second = pair1[1]
	auto pair2 = await chm.recv(ch)
	bool ok2 = bool(pair2[0])
	auto third = pair2[1]
	auto pair3 = await chm.recv(ch)
	bool ok3 = bool(pair3[0])
	auto tail = pair3[1]

	if not sent0 or not sent1 or sent2 or not sent3 or not closed
		return 1
	end
	if not ok0 or not ok1 or not ok2 or ok3
		return 2
	end
	if tail != null
		return 3
	end
	return int(first) + int(second) + int(third)
end
