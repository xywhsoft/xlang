#loadlib "../xlp_native/packages/pkg.probe/bin/pkg_probe.dll"
#binding "binding_cond_probe.h"

func main() as int
	if BINDING_COND_ENABLED != 40 then
		return 1
	end
	if BINDING_COND_IFDEF != 1 then
		return 2
	end
	if BINDING_COND_IFNDEF != 1 then
		return 3
	end
	if BINDING_COND_DEFINED != 1 then
		return 4
	end
	if BINDING_COND_NOT_DEFINED != 1 then
		return 5
	end
	if BINDING_COND_EXPR != 1 then
		return 6
	end
	if BINDING_COND_COMPLEX != 1 then
		return 8
	end
	if BINDING_COND_UNDEF_OK != 1 then
		return 9
	end
	if pkg_clock_artifact_add_one(41) != 42 then
		return 7
	end
	return 42
end
