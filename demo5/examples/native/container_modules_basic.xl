import std.array
import std.list
import std.set
import std.dict

func main() as int
	auto a = [1, 2]
	auto b = [0: 3, 1: 4]
	auto s = {"x", "y"}
	auto d = {"a": "1", "b": "2"}

	array.append(a, 5)
	list.append(b, 6)

	if array.len(a) != 3
		return 1
	end
	if list.len(b) != 3
		return 2
	end
	if set.has(s, "x") == false
		return 3
	end
	if dict.has(d, "a") == false
		return 4
	end
	if array.join(["a", "b"], "-") != "a-b"
		return 5
	end
	if list.join([0: "c", 1: "d"], ".") != "c.d"
		return 6
	end
	if array.remove(a, 1) == false
		return 7
	end
	if list.remove(b, 0) == false
		return 8
	end
	if set.remove(s, "y") == false
		return 9
	end
	if dict.remove(d, "b") == false
		return 10
	end

	array.clear(a)
	list.clear(b)
	set.clear(s)
	dict.clear(d)

	if array.len(a) != 0
		return 11
	end
	if list.len(b) != 0
		return 12
	end
	if set.len(s) != 0
		return 13
	end
	if dict.len(d) != 0
		return 14
	end
	return 0
end
