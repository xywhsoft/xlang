import std.str
import std.fmt

func main() as int
	const bool empty_text = str.empty("")
	const int size_text = str.byte_len("abc")
	const string reverse_text = str.reverse("abcd")
	const string left_text = str.pad_left("7", 3, "0")
	const string right_text = str.pad_right("7", 3, ".")
	const string bool_text = fmt.bool_text(true)

	if empty_text == false
		return 1
	end
	if size_text != 3
		return 2
	end
	if reverse_text != "dcba"
		return 3
	end
	if left_text != "007"
		return 4
	end
	if right_text != "7.."
		return 5
	end
	if bool_text != "true"
		return 6
	end
	return 0
end
