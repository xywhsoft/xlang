import std.array
import std.iter

func main() as int
	auto d = {"a": "1", "b": "2"}
	auto s = {"x", "y"}
	auto a = [10, 20, 30]
	auto l = [0: "m", 1: "n"]
	auto ks = iter.keys(d)
	auto vs = iter.values(d)
	auto ss = iter.items(s)
	auto joinedKeys = array.join(ks, ",")
	auto joinedValues = array.join(vs, ",")

	if iter.count(a) != 3
		return 1
	end
	if iter.count(l) != 2
		return 2
	end
	if iter.count(s) != 2
		return 3
	end
	if iter.count(d) != 2
		return 4
	end
	if joinedKeys != "a,b"
		if joinedKeys != "b,a"
			return 5
		end
	end
	if joinedValues != "1,2"
		if joinedValues != "2,1"
			return 6
		end
	end
	if iter.count(ss) != 2
		return 7
	end
	return 0
end
