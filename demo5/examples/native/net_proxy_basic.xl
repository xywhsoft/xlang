import std.net.proxy as proxy

func main() as int
	auto p = proxy.parse("http://user:pass@proxy.local:8080")
	auto s = proxy.parse("socks5://127.0.0.1")
	auto auth = proxy.basic_auth("user", "pass")
	auto connect = proxy.http_connect("example.com", 443, auth)
	auto greet = proxy.socks5_greeting_hex(true)
	auto req = proxy.socks5_connect_hex("example.com", 443)

	if p["scheme"] != "http"
		return 1
	end
	if p["host"] != "proxy.local"
		return 2
	end
	if p["port"] != "8080"
		return 3
	end
	if p["user"] != "user" or p["pass"] != "pass"
		return 4
	end
	if s["scheme"] != "socks5" or s["port"] != "1080"
		return 5
	end
	if auth != "Basic dXNlcjpwYXNz"
		return 6
	end
	if connect.contains("CONNECT example.com:443 HTTP/1.1") == false
		return 7
	end
	if connect.contains("Proxy-Authorization: " + auth) == false
		return 8
	end
	if greet != "05020002"
		return 9
	end
	if req != "050100030b6578616d706c652e636f6d01bb"
		return 10
	end

	return 71
end
