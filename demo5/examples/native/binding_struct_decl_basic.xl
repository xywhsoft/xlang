#loadlib "../xlp_native/packages/pkg.probe/bin/pkg_probe.dll"
#binding "binding_struct_decl_probe.h"

func main() as int
	BindingPlain local
	local.x = 10
	local.y = 20
	BindingMulti multi
	multi.a = 1
	multi.b = 2
	multi.name = "hello"
	multi.label = "world"
	if multi.a + multi.b != 3 then
		return 1
	end
	if multi.name + multi.label != "helloworld" then
		return 2
	end
	BindingAliasTwo aliasTwo
	aliasTwo.a = 19
	aliasTwo.b = 23
	if aliasTwo.a + aliasTwo.b != 42 then
		return 9
	end
	BindingAliasPtr aliasPtr = point(null)
	if string(aliasPtr).length == 0 then
		return 10
	end
	auto pair = pkg_clock_artifact_pair_make(local.x + 2, local.y + 10)
	if pkg_clock_artifact_pair_value_sum(pair) != 42 then
		return 3
	end
	BindingBitfield packed = point(null)
	BindingBitfieldPtr packedPtr = point(null)
	BindingInlineArray inlineArray = point(null)
	if string(packed).length == 0 then
		return 6
	end
	if string(packedPtr).length == 0 then
		return 7
	end
	if string(inlineArray).length == 0 then
		return 8
	end
	BindingEnumFields enumFields
	enumFields.mode = BINDING_FIELD_MODE_A
	enumFields.rawMode = BINDING_FIELD_MODE_B
	enumFields.score = 39
	if pkg_clock_artifact_enum_fields_score(enumFields) != 42 then
		return 11
	end
	BindingLateAlias late
	late.x = 12
	late.y = 30
	auto moved = pkg_clock_artifact_pair_add(late, 1)
	if moved.x + moved.y == 44 then
		BindingOuter outer
		outer.inner.x = 10
		outer.inner.y = 20
		outer.z = 9
		outer.scale = 3.5
		if pkg_clock_artifact_outer_score(outer) == 42 then
			return 42
		end
		return 5
	end
	return 4
end
