import std.sys.lib as sys

func main() as int
	auto lib = sys.loadlib("msvcrt.dll")
	function<int(string)> atoi = function<int(string)>(lib.proc("atoi"))
	auto ok = lib.close()

	if ok == false then
		return 1
	end
	if lib.loaded() then
		return 2
	end
	if atoi("77") != 77 then
		return 3
	end
	return 42
end
