import std.types as types

func main() as int
	type a = types.of(123)
	type b = types.of("hello")

	if types.name(a) != "int"
		return 1
	end
	if types.name(b) != "string"
		return 2
	end
	if not types.same(a, int)
		return 3
	end
	if not types.same(b, string)
		return 4
	end
	if types.same(a, b)
		return 5
	end

	return 61
end
