import std.error as err

func main() as int
	error e = err.make("boom", 7, "payload")
	error t = err.type_error("bad type")

	if err.kind(e) != "Error"
		return 1
	end
	if err.message(e) != "boom"
		return 2
	end
	if err.code(e) != 7
		return 3
	end
	if err.data(e) != "payload"
		return 4
	end
	if err.text(e) != "boom"
		return 5
	end
	if not err.is_type(t, "TypeError")
		return 6
	end
	if err.is_native(t)
		return 7
	end
	if err.is_null(t)
		return 8
	end
	return 73
end
