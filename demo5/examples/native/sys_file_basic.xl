import std.sys.file
import std.sys.env
import std.path

func main() as int
	auto dir = env.temp()
	auto path = path.join(dir, "xlang_sys_file_basic.txt")

	if file.write_all(path, "hello") == false
		return 1
	end
	if file.exists(path) == false
		return 2
	end
	if file.is_file(path) == false
		return 3
	end
	if file.size(path) != 5
		return 4
	end
	if file.append_all(path, " world") == false
		return 5
	end
	if file.read_all(path) != "hello world"
		return 6
	end
	if file.delete(path) == false
		return 7
	end
	return 0
end
