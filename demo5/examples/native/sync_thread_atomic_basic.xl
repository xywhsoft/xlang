import std.atomic
import std.sync
import std.thread

func main() as int
	auto box = atomic.make(10)
	auto before = atomic.load(box)
	auto after_add = atomic.add(box, 5)
	auto swapped = atomic.exchange(box, 3)
	auto observed = atomic.compare_exchange(box, 3, 7)
	auto current = atomic.load(box)
	auto stored = atomic.store(box, 9)
	auto final_value = atomic.load(box)

	auto mutex_value = sync.mutex()
	bool mutex_locked = sync.mutex_lock(mutex_value)
	bool mutex_unlocked = sync.mutex_unlock(mutex_value)

	auto cond_value = sync.cond()
	bool cond_signalled = sync.cond_signal(cond_value)
	bool cond_broadcasted = sync.cond_broadcast(cond_value)

	auto rw_value = sync.rwlock()
	bool read_locked = sync.rwlock_read_lock(rw_value)
	bool upgraded = sync.rwlock_upgrade(rw_value)
	bool downgraded = sync.rwlock_downgrade(rw_value)
	bool read_unlocked = sync.rwlock_read_unlock(rw_value)
	bool write_locked = sync.rwlock_write_lock(rw_value)
	bool write_unlocked = sync.rwlock_write_unlock(rw_value)

	thread.yield_now()
	thread.sleep(0)
	auto tid = thread.current_id()

	bool free_box = atomic.free(box)
	bool free_mutex = sync.mutex_free(mutex_value)
	bool free_cond = sync.cond_free(cond_value)
	bool free_rw = sync.rwlock_free(rw_value)

	if before != 10 or after_add != 15 or swapped != 15 or observed != 3
		return 1
	end
	if current != 7 or stored != 9 or final_value != 9
		return 2
	end
	if not mutex_locked or not mutex_unlocked
		return 3
	end
	if not cond_signalled or not cond_broadcasted
		return 4
	end
	if not read_locked or not upgraded or not downgraded or not read_unlocked
		return 5
	end
	if not write_locked or not write_unlocked
		return 6
	end
	if tid <= 0
		return 7
	end
	if not free_box or not free_mutex or not free_cond or not free_rw
		return 8
	end
	return 79
end
