async func next_value() as int
	return 7
end

async func bonus() as int
	return 5
end

async func main() as int
	int seed = 1
	int value = 1
	int mark = 0

	if seed == 1 then
		mark = mark + 10
		value = await next_value()
		mark = mark + 20
	else
		mark = mark + 2
	end

	return value + mark + await bonus()
end
