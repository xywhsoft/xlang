async func fail() as int
	throw Error("boom")
end

async func bonus() as int
	return 5
end

async func main() as int
	int value = 0
	int mark = 1

	try
		try
			value = await fail()
		catch e
			if e.message == "boom" then
				value = 7
			else
				value = 3
			end
		finally
			mark = mark + 10
		end
		mark = mark + 20
	catch e
		value = 99
	finally
		mark = mark + 2
	end

	return value + mark + await bonus()
end
