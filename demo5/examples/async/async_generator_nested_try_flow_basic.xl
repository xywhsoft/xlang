import std.task

async func stream(int stop) as int
	int current = 0

	while current < stop do
		current += 1
		try
			if current == 2 then
				throw Error("skip")
			end
			yield await task.delay(current)
		catch e
			if e.message == "skip" then
				yield await task.delay(20)
			end
		finally
			if current == stop then
				yield await task.delay(10)
			end
		end
	end

	return 0
end

func main() as int
	int sum = 0

	for value in stream(3)
		sum += value
	end

	return sum
end
