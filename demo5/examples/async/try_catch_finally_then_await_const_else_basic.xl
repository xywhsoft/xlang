async func fail() as int
	throw Error("async boom")
end

async func bonus() as int
	return 5
end

async func main() as int
	int value = 0
	int mark = 0

	if false then
		mark = mark + 400
	else
		mark = mark + 40
		try
			value = await fail()
		catch e
			if e.message == "async boom"
				value = 7
			else
				value = 3
			end
		finally
			mark = 10
		end
		mark = mark + 50
	end

	return value + mark + await bonus()
end
