var int total = 0

class AsyncDefaultBox extends object
	var value as int

	create()
		self.value = 21
		total = total + 1
	end

	destroy()
		total = total + self.value
	end
end

async func tick() as int
	return 0
end

async func use_box() as int
	AsyncDefaultBox box
	await tick()
	return box.value
end

async func main() as int
	auto value = await use_box()
	if value != 21 then
		return -1
	end
	if total != 22 then
		return -2
	end
	return value + total
end
