async func keep_going(int value) as bool
	return value < 3
end

async func next_value() as int
	return 4
end

async func main() as int
	int value = 1
	int sum = 0
	do
		value = value + 1
		if value == 2
			continue
		end
		sum = sum + value
	while await keep_going(value)
	end
	return sum + await next_value()
end
