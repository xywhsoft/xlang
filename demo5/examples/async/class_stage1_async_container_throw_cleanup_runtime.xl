var int copies = 0
var int destroys = 0

class AsyncThrowItem extends object
	var value as int

	create(int value)
		self.value = value
	end

	destroy()
		destroys = destroys + 1
	end

	func copy() as AsyncThrowItem
		copies = copies + 1
		return AsyncThrowItem(self.value)
	end
end

async func fail() as int
	throw Error("async class cleanup")
end

async func main() as int
	int caught = 0

	try
		auto item = AsyncThrowItem(10)
		auto values = [item]
		await fail()
		return -1
	catch e
		if e.message == "async class cleanup" then
			caught = 1
		end
	end

	if caught != 1 then
		return -2
	end
	if copies != 1 then
		return -3
	end
	if destroys != 2 then
		return -4
	end
	return copies * 10 + destroys
end
