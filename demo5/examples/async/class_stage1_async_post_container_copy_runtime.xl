var int copies = 0
var int destroys = 0

class AsyncPostContainerBox extends object
	var value as int

	create(int value)
		self.value = value
	end

	destroy()
		destroys = destroys + 1
	end

	func copy() as AsyncPostContainerBox
		copies = copies + 1
		return AsyncPostContainerBox(self.value)
	end
end

async func tick() as int
	return 0
end

async func use_box() as int
	auto source = AsyncPostContainerBox(12)
	await tick()
	auto values = [source]
	return source.value
end

async func main() as int
	auto value = await use_box()
	if value != 12 then
		return -1
	end
	if copies != 1 then
		return -2
	end
	if destroys != 2 then
		return -3
	end
	return value + copies * 10 + destroys
end
