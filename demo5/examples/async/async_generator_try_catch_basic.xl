import std.task

async func guarded() as int
	try
		yield await task.delay(1)
		throw Error("boom")
	catch e
		yield await task.delay(2)
		if e.message == "boom" then
			yield await task.delay(4)
		end
	end

	return 0
end

func main() as int
	int sum = 0

	for value in guarded()
		sum += value
	end

	return sum
end
