import std.task

async func stream() as int
	auto current = int((yield await task.delay(1)))
	yield current + 1
	return 0
end

func main() as int
	auto gen = stream()
	auto ok1, value1 = gen.next()
	auto ok2, value2 = gen.resume(7)
	if (not ok1) or (not ok2)
		return -1
	end
	return int(value1) + int(value2)
end
