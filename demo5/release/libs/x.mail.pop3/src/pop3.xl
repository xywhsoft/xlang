import std.json
import x.mail.mime as mime

extern "xmail_pop3_capability_json_native" func xmail_pop3_capability_json_native(string config_json) as string
extern "xmail_pop3_status_json_native" func xmail_pop3_status_json_native(string config_json) as string
extern "xmail_pop3_list_json_native" func xmail_pop3_list_json_native(string config_json) as string
extern "xmail_pop3_fetch_json_native" func xmail_pop3_fetch_json_native(string request_json) as string
extern "xmail_pop3_delete_json_native" func xmail_pop3_delete_json_native(string request_json) as string

func result(bool ok, string error, string stage, var data) as var
	return mime.result(ok, error, stage, data)
end

func unsupported(string operation) as var
	return result(false, "x.mail.pop3." + operation + " native binding is not connected", "binding", {})
end

func capability(var config) as var
	return json.decode(xmail_pop3_capability_json_native(json.encode(config)))
end

func status(var config) as var
	return json.decode(xmail_pop3_status_json_native(json.encode(config)))
end

func list(var config) as var
	return json.decode(xmail_pop3_list_json_native(json.encode(config)))
end

func fetch(var request) as var
	return json.decode(xmail_pop3_fetch_json_native(json.encode(request)))
end

func delete_message(var request) as var
	return json.decode(xmail_pop3_delete_json_native(json.encode(request)))
end

func capability_json(string config_json) as string
	return xmail_pop3_capability_json_native(config_json)
end

func status_json(string config_json) as string
	return xmail_pop3_status_json_native(config_json)
end

func list_json(string config_json) as string
	return xmail_pop3_list_json_native(config_json)
end

func fetch_json(string request_json) as string
	return xmail_pop3_fetch_json_native(request_json)
end

func delete_message_json(string request_json) as string
	return xmail_pop3_delete_json_native(request_json)
end

export result
export unsupported
export capability
export status
export list
export fetch
export delete_message
export capability_json
export status_json
export list_json
export fetch_json
export delete_message_json
