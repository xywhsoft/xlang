import x.volc.core as core
import std.fmt as fmt
import std.json as json
import std.str as str
import std.time as time

const string ACEP_HOST = "open.volcengineapi.com"
const string ACEP_SERVICE = "ACEP"
const string DEFAULT_REGION = "cn-north-1"
const string DEFAULT_VERSION = "2023-10-30"
const string RECORDING_VERSION = "2025-05-01"
const string JSON_CONTENT_TYPE = "application/json"

extern "atoi" func atoi(string text) as int

class Response extends object
	var ok_value as bool
	var action_value as string
	var status_value as int
	var request_id_value as string
	var code_value as string
	var code_n_value as int
	var message_value as string
	var result_value as string
	var raw_value as string

	create()
		self.ok_value = false
		self.action_value = ""
		self.status_value = 0
		self.request_id_value = ""
		self.code_value = ""
		self.code_n_value = 0
		self.message_value = ""
		self.result_value = ""
		self.raw_value = ""
	end

	create(bool ok_value, string action_value, int status_value, string request_id_value, string code_value, int code_n_value, string message_value, string result_value, string raw_value)
		self.ok_value = ok_value
		self.action_value = action_value
		self.status_value = status_value
		self.request_id_value = request_id_value
		self.code_value = code_value
		self.code_n_value = code_n_value
		self.message_value = message_value
		self.result_value = result_value
		self.raw_value = raw_value
	end

	func ok() as bool
		return self.ok_value
	end

	func action() as string
		return self.action_value
	end

	func status() as int
		return self.status_value
	end

	func request_id() as string
		return self.request_id_value
	end

	func code() as string
		return self.code_value
	end

	func code_n() as int
		return self.code_n_value
	end

	func message() as string
		return self.message_value
	end

	func result_json() as string
		return self.result_value
	end

	func raw_json() as string
		return self.raw_value
	end

	func to_json() as string
		return json.encode({
			"ok": self.ok_value,
			"status": self.status_value,
			"action": self.action_value,
			"request_id": self.request_id_value,
			"code": self.code_value,
			"code_n": self.code_n_value,
			"message": self.message_value,
			"result": self.result_value,
			"raw": self.raw_value
		})
	end
end

class Client extends object
	var access_key as string
	var secret_key as string
	var session_token as string
	var product_id as string
	var timeout_ms as int

	create()
		self.access_key = ""
		self.secret_key = ""
		self.session_token = ""
		self.product_id = ""
		self.timeout_ms = 30000
	end

	create(string access_key, string secret_key, string product_id)
		self.access_key = access_key
		self.secret_key = secret_key
		self.session_token = ""
		self.product_id = product_id
		self.timeout_ms = 30000
	end

	create(string access_key, string secret_key, string session_token, string product_id)
		self.access_key = access_key
		self.secret_key = secret_key
		self.session_token = session_token
		self.product_id = product_id
		self.timeout_ms = 30000
	end

	func set_timeout(int timeout_ms) as bool
		self.timeout_ms = timeout_ms
		return true
	end

	func set_session_token(string session_token) as bool
		self.session_token = session_token
		return true
	end

	func call(string action, string version, string body) as Response
		auto raw = raw_call(self.access_key, self.secret_key, self.session_token, action, version, body, self.timeout_ms)
		return normalize_response(action, raw)
	end

	func call_default(string action, string body) as Response
		auto raw = raw_call(self.access_key, self.secret_key, self.session_token, action, DEFAULT_VERSION, body, self.timeout_ms)
		return normalize_response(action, raw)
	end

	func list_pods() as Response
		auto spec = "action=ListPod\nversion=" + DEFAULT_VERSION + "\naccess_key=" + self.access_key + "\nsecret_key=" + self.secret_key + "\nsession_token=" + self.session_token + "\nbody=" + product_body(self.product_id) + "\ntimeout_ms=" + fmt.int_text(self.timeout_ms, "")
		return normalize_response("ListPod", core.request_acep_spec(spec))
	end

	func list_hosts() as Response
		auto spec = "action=ListHost\nversion=" + DEFAULT_VERSION + "\naccess_key=" + self.access_key + "\nsecret_key=" + self.secret_key + "\nsession_token=" + self.session_token + "\nbody=" + product_body(self.product_id) + "\ntimeout_ms=" + fmt.int_text(self.timeout_ms, "")
		return normalize_response("ListHost", core.request_acep_spec(spec))
	end

	func list_dcs() as Response
		auto spec = "action=ListDc\nversion=" + DEFAULT_VERSION + "\naccess_key=" + self.access_key + "\nsecret_key=" + self.secret_key + "\nsession_token=" + self.session_token + "\nbody=" + product_body(self.product_id) + "\ntimeout_ms=" + fmt.int_text(self.timeout_ms, "")
		return normalize_response("ListDc", core.request_acep_spec(spec))
	end

	func detail_pod(string pod_id) as Response
		return normalize_response("DetailPod", detail_pod(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, self.timeout_ms))
	end

	func detail_host(string host_id) as Response
		return normalize_response("DetailHost", detail_host(self.access_key, self.secret_key, self.session_token, self.product_id, host_id, self.timeout_ms))
