func recording_download_url(string raw) as string
	auto value = json_string_field(raw, "DownloadUrl")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "DownloadURL")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "DownloadLink")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "DownloadUri")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "DownloadURI")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "RecordUrl")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "RecordURL")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "RecordingUrl")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "RecordingURL")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "VideoUrl")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "VideoURL")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "FileUrl")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "FileURL")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "Url")
	if value != "" then
		return value
	end
	return json_string_field(raw, "URL")
end

func pod_adb_endpoint(string detail_pod_json) as string
	if json_int_field(detail_pod_json, "AdbStatus") != 1 then
		return ""
	end
	return json_string_field(detail_pod_json, "Adb")
end

func pod_run_state(string detail_pod_json) as int
	return json_int_field(detail_pod_json, "Online")
end

func host_remain_text(string detail_host_json) as string
	auto available = json_int_field(detail_host_json, "PodNumAvailable")
	auto on_host = json_int_field(detail_host_json, "PodNumOnHost")
	return fmt.int_text(on_host, "") + "," + fmt.int_text(available - on_host, "")
end

