end

func task_state(string task_info_json) as string
	if str.contains(task_info_json, "\"TaskResult\":100") or str.contains(task_info_json, "\"TaskResult\": 100") then
		return "success"
	end
	if str.contains(task_info_json, "\"TaskResult\":10") or str.contains(task_info_json, "\"TaskResult\": 10") then
		return "running"
	end
	if str.contains(task_info_json, "\"Error\"") then
		return "failed"
	end
	return "unknown"
end

func wait_task(string access_key, string secret_key, string session_token, string product_id, string task_id, int timeout_ms, int poll_interval_ms) as string
	auto elapsed = 0
	auto interval = poll_interval_ms
	if interval <= 0 then
		interval = 3000
	end
	while elapsed <= timeout_ms do
		auto info = get_task_info(access_key, secret_key, session_token, product_id, task_id, interval)
		auto state = task_state(info)
		if state == "success" or state == "failed" then
			return info
		end
		time.sleep(interval)
		elapsed = elapsed + interval
	end
	return get_task_info(access_key, secret_key, session_token, product_id, task_id, interval)
end

