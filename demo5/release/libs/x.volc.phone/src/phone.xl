end

func normalize_response(string action, string raw) as Response
	auto status = core.last_status()
	if raw == "" then
		return Response(false, action, status, "", "transport_error", 0, core.last_error(), "", raw)
	end
	auto request_id = json_string_field(raw, "RequestId")
	auto code_value = json_string_field(raw, "Code")
	auto message_value = json_string_field(raw, "Message")
	auto code_n_value = json_int_field(raw, "CodeN")
	auto ok_value = true
	if str.contains(raw, "\"Error\"") or code_value != "" or status >= 400 then
		ok_value = false
	end
	return Response(ok_value, action, status, request_id, code_value, code_n_value, message_value, json_section(raw, "Result"), raw)
end

func response_json(string action, string raw) as string
	return normalize_response(action, raw).to_json()
end

func json_string_field(string raw, string key) as string
	auto pattern = "\"" + key + "\":\""
	auto start = raw.index_of(pattern)
	if start < 0 then
		pattern = "\"" + key + "\": \""
		start = raw.index_of(pattern)
	end
	if start < 0 then
		return ""
	end
	start = start + pattern.length
	auto rest = raw.slice(start, raw.length - start)
	auto end_pos = rest.index_of("\"")
	if end_pos < 0 then
		return ""
	end
	return rest.slice(0, end_pos)
end

func json_int_field(string raw, string key) as int
	auto pattern = "\"" + key + "\":"
	auto start = raw.index_of(pattern)
	if start < 0 then
		pattern = "\"" + key + "\": "
		start = raw.index_of(pattern)
	end
	if start < 0 then
		return 0
	end
	start = start + pattern.length
	auto rest = raw.slice(start, raw.length - start)
	return atoi(rest)
end

func json_section(string raw, string key) as string
	auto pattern = "\"" + key + "\":"
	auto start = raw.index_of(pattern)
	if start < 0 then
		pattern = "\"" + key + "\": "
		start = raw.index_of(pattern)
	end
	if start < 0 then
		return ""
	end
	start = start + pattern.length
	auto rest = raw.slice(start, raw.length - start)
	return rest
end

