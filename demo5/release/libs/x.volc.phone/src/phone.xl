func last_error() as string
	return core.last_error()
end

func call_spec(string spec) as Response
	return normalize_response("ACEP", core.request_acep_spec(spec))
end

func raw_spec(string spec) as string
	return core.request_acep_spec(spec)
end

func client(string access_key, string secret_key, string product_id) as Client
	return Client(access_key, secret_key, product_id)
end

func client_token(string access_key, string secret_key, string session_token, string product_id) as Client
	return Client(access_key, secret_key, session_token, product_id)
end

func raw_call(string access_key, string secret_key, string session_token, string action, string version, string body, int timeout_ms) as string
	auto spec = "action=" + action + "\nversion=" + version + "\naccess_key=" + access_key + "\nsecret_key=" + secret_key + "\nsession_token=" + session_token + "\nbody=" + body + "\ntimeout_ms=" + fmt.int_text(timeout_ms, "")
	return core.request_acep_spec(spec)
end

func call(string access_key, string secret_key, string session_token, string action, string version, string body, int timeout_ms) as string
	return raw_call(access_key, secret_key, session_token, action, version, body, timeout_ms)
end

func call_default(string access_key, string secret_key, string session_token, string action, string body, int timeout_ms) as string
	return raw_call(access_key, secret_key, session_token, action, DEFAULT_VERSION, body, timeout_ms)
end

func product_body(string product_id) as string
	return "{\"ProductId\":" + core.json_string(product_id) + "}"
end

func pod_body(string product_id, string pod_id) as string
	return "{\"ProductId\":" + core.json_string(product_id) + ",\"PodId\":" + core.json_string(pod_id) + "}"
end

func create_pod_body(string product_id, string dc, string configuration_code, int resource_type, string host_id, string pod_name, string display_layout_id, bool start) as string
	return "{\"ProductId\":" + core.json_string(product_id) + ",\"ResourceType\":" + fmt.int_text(resource_type, "") + ",\"PodName\":" + core.json_string(pod_name) + ",\"HostId\":" + core.json_string(host_id) + ",\"ConfigurationCode\":" + core.json_string(configuration_code) + ",\"Dc\":" + core.json_string(dc) + ",\"DisplayLayoutId\":" + core.json_string(display_layout_id) + ",\"UpBandwidthLimit\":0,\"DownBandwidthLimit\":0,\"Start\":" + fmt.bool_text(start) + "}"
end

func create_pod_batch_body(string product_id, string dc, string configuration_code, int apply_num, int resource_type, string host_id, string pod_name, string display_layout_id, bool start) as string
	auto spec = "{\"ApplyNum\":" + fmt.int_text(apply_num, "") + ",\"Dc\":" + core.json_string(dc) + ",\"ConfigurationCode\":" + core.json_string(configuration_code) + ",\"HostId\":" + core.json_string(host_id) + ",\"PodName\":" + core.json_string(pod_name) + ",\"DisplayLayoutId\":" + core.json_string(display_layout_id) + ",\"UpBandwidthLimit\":0,\"DownBandwidthLimit\":0,\"Start\":" + fmt.bool_text(start) + "}"
	return "{\"ProductId\":" + core.json_string(product_id) + ",\"ResourceType\":" + fmt.int_text(resource_type, "") + ",\"PodSpecList\":[" + spec + "]}"
end

