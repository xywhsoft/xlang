extern "xstbir_version" func xstbir_version() as string
extern "xstbir_last_error" func xstbir_last_error() as string
extern "xstbir_resize_uint8_srgb_native" func xstbir_resize_uint8_srgb_native(point data, int width, int height, int channels, int out_width, int out_height, int input_stride) as point
extern "xstbir_resize_uint8_linear_native" func xstbir_resize_uint8_linear_native(point data, int width, int height, int channels, int out_width, int out_height, int input_stride) as point
extern "xstbir_image_valid" func xstbir_image_valid(point image) as int
extern "xstbir_image_width" func xstbir_image_width(point image) as int
extern "xstbir_image_height" func xstbir_image_height(point image) as int
extern "xstbir_image_channels" func xstbir_image_channels(point image) as int
extern "xstbir_image_data" func xstbir_image_data(point image) as point
extern "xstbir_image_release" func xstbir_image_release(point image) as int

func version() as string
	return xstbir_version()
end

func last_error() as string
	return xstbir_last_error()
end

func resize_uint8(point data, int width, int height, int channels, int out_width, int out_height) as point
	return xstbir_resize_uint8_srgb_native(data, width, height, channels, out_width, out_height, 0)
end

func resize_uint8(point data, int width, int height, int channels, int out_width, int out_height, int input_stride) as point
	return xstbir_resize_uint8_srgb_native(data, width, height, channels, out_width, out_height, input_stride)
end

func resize_uint8_linear(point data, int width, int height, int channels, int out_width, int out_height) as point
	return xstbir_resize_uint8_linear_native(data, width, height, channels, out_width, out_height, 0)
end

func resize_uint8_linear(point data, int width, int height, int channels, int out_width, int out_height, int input_stride) as point
	return xstbir_resize_uint8_linear_native(data, width, height, channels, out_width, out_height, input_stride)
end

func valid(point image) as bool
	return xstbir_image_valid(image) != 0
end

func width(point image) as int
	return xstbir_image_width(image)
end

func height(point image) as int
	return xstbir_image_height(image)
end

func channels(point image) as int
	return xstbir_image_channels(image)
end

func data(point image) as point
	return xstbir_image_data(image)
end

func release(point image) as bool
	return xstbir_image_release(image) != 0
end

export version
export last_error
export resize_uint8
export resize_uint8_linear
export valid
export width
export height
export channels
export data
export release
