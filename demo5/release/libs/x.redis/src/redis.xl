func hget_or(Client client, string key, string field, string fallback) as string
	auto response = command3(client, "HGET", key, field)
	if response_nil(response) then
		return fallback
	end
	if response_type(response) == "error" then
		return fallback
	end
	return response_value(response)
end

func hset(Client client, string key, string field, string value) as int
	return response_int(command4(client, "HSET", key, field, value))
end

func hdel(Client client, string key, string field) as int
	return response_int(command3(client, "HDEL", key, field))
end

func hexists(Client client, string key, string field) as bool
	return response_int(command3(client, "HEXISTS", key, field)) == 1
end

func hlen(Client client, string key) as int
	return response_int(command2(client, "HLEN", key))
end

func hstrlen(Client client, string key, string field) as int
	return response_int(command3(client, "HSTRLEN", key, field))
end

func hgetall_json(Client client, string key) as string
	return command2(client, "HGETALL", key)
end

func lpush(Client client, string key, string value) as int
	return response_int(command3(client, "LPUSH", key, value))
end

func rpush(Client client, string key, string value) as int
	return response_int(command3(client, "RPUSH", key, value))
end

func lpop(Client client, string key) as string
	auto response = command2(client, "LPOP", key)
	if response_nil(response) then
		return ""
	end
	return response_value(response)
end

func lpop_or(Client client, string key, string fallback) as string
	auto response = command2(client, "LPOP", key)
	if response_nil(response) then
		return fallback
	end
	if response_type(response) == "error" then
		return fallback
	end
	return response_value(response)
end

func rpop(Client client, string key) as string
	auto response = command2(client, "RPOP", key)
	if response_nil(response) then
		return ""
	end
	return response_value(response)
end

func rpop_or(Client client, string key, string fallback) as string
	auto response = command2(client, "RPOP", key)
	if response_nil(response) then
		return fallback
	end
	if response_type(response) == "error" then
		return fallback
	end
	return response_value(response)
end

func llen(Client client, string key) as int
	return response_int(command2(client, "LLEN", key))
end

func lrange_json(Client client, string key, int start, int stop) as string
	return command4(client, "LRANGE", key, fmt.int_text(start, ""), fmt.int_text(stop, ""))
end

func sadd(Client client, string key, string member) as int
	return response_int(command3(client, "SADD", key, member))
end

func srem(Client client, string key, string member) as int
	return response_int(command3(client, "SREM", key, member))
end

func sismember(Client client, string key, string member) as bool
	return response_int(command3(client, "SISMEMBER", key, member)) == 1
end

func smembers_json(Client client, string key) as string
	return command2(client, "SMEMBERS", key)
end

