func sentinel_command_master_once_json(Client sentinel, string name, string argv_json, int timeout_ms) as string
	auto master = sentinel_connect_master(sentinel, name, timeout_ms)
	if master.valid() == false then
		sentinel.last_error_text = master.last_error()
		return json_error(sentinel.last_error_text)
	end
	auto out = command_json(master, argv_json)
	if response_type(out) == "error" then
		sentinel.last_error_text = response_value(out)
	else
		sentinel.last_error_text = ""
	end
	close(master)
	return out
end

