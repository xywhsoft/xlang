	return "[" + json_string(a0) + "," + json_string(a1) + "," + json_string(a2) + "," + json_string(a3) + "]"
end

func argv_json_list(string command, array<string> values) as string
	auto out = "[" + json_string(command)
	for value in values
		out = out + "," + json_string(value)
	end
	return out + "]"
end

func pipeline_json_array(array<string> commands) as string
	auto out = "["
	int index = 0
	for command in commands
		if index > 0 then
			out = out + ","
		end
		out = out + command
		index = index + 1
	end
	return out + "]"
end

func pipeline_json1(string command0) as string
	return "[" + command0 + "]"
end

func pipeline_json2(string command0, string command1) as string
