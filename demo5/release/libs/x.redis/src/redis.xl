	return command2(client, "CLUSTER", "SLOTS")
end

func cluster_slots_cache_refresh(ClusterSlotsCache cache, Client seed) as bool
	auto slots = cluster_slots_json(seed)
	if response_type(slots) == "error" then
		seed.last_error_text = response_value(slots)
		return false
	end
	if response_type(slots) != "array" then
		seed.last_error_text = "cluster slots response is not an array"
		return false
	end
	cache.slots_json = slots
	return true
end

func cluster_slots_node_host(string slots_response_json, int slot) as string
	dict root = json.decode(slots_response_json)
	if root.has("items") == false then
		return ""
	end
	var array<var> slots = root["items"]
	int i = 0
	while i < slots.length do
		dict slot_range = slots[i]
		if slot_range.has("items") then
			var array<var> range_items = slot_range["items"]
			if range_items.length >= 3 then
				dict start_item = range_items[0]
				dict end_item = range_items[1]
				int start_slot = start_item["value"]
				int end_slot = end_item["value"]
				if slot >= start_slot and slot <= end_slot then
					dict node_item = range_items[2]
					var array<var> node_items = node_item["items"]
					dict host_item = node_items[0]
					return host_item["value"]
				end
			end
		end
		i = i + 1
	end
	return ""
end

func cluster_slots_node_port(string slots_response_json, int slot) as int
	dict root = json.decode(slots_response_json)
	if root.has("items") == false then
		return -1
	end
	var array<var> slots = root["items"]
	int i = 0
	while i < slots.length do
		dict slot_range = slots[i]
		if slot_range.has("items") then
			var array<var> range_items = slot_range["items"]
			if range_items.length >= 3 then
				dict start_item = range_items[0]
				dict end_item = range_items[1]
				int start_slot = start_item["value"]
				int end_slot = end_item["value"]
				if slot >= start_slot and slot <= end_slot then
					dict node_item = range_items[2]
					var array<var> node_items = node_item["items"]
					dict port_item = node_items[1]
					return port_item["value"]
				end
			end
		end
		i = i + 1
	end
	return -1
end

func cluster_connect_slot(string slots_response_json, int slot) as Client
	return cluster_connect_slot(slots_response_json, slot, DEFAULT_TIMEOUT_MS)
end

func cluster_connect_slot(string slots_response_json, int slot, int timeout_ms) as Client
	auto host = cluster_slots_node_host(slots_response_json, slot)
	auto port = cluster_slots_node_port(slots_response_json, slot)
	if host == "" or port <= 0 then
		return Client(host, port, timeout_ms, "cluster slot node not found")
	end
	return connect(host, port, timeout_ms)
end

func cluster_keyslot(Client client, string key) as int
	return response_int(command3(client, "CLUSTER", "KEYSLOT", key))
end

func cluster_command_slot_once_json(Client seed, string slots_response_json, string key, string argv_json) as string
	return cluster_command_slot_once_json(seed, slots_response_json, key, argv_json, seed.timeout_ms)
end

func cluster_command_slot_once_json(Client seed, string slots_response_json, string key, string argv_json, int timeout_ms) as string
	auto slot = cluster_keyslot(seed, key)
	if slot < 0 then
		seed.last_error_text = "cluster keyslot failed"
		return json_error(seed.last_error_text)
	end
	auto target = cluster_connect_slot(slots_response_json, slot, timeout_ms)
	if target.valid() == false then
		seed.last_error_text = target.last_error()
		return json_error(seed.last_error_text)
	end
	auto out = command_json(target, argv_json)
	if response_type(out) == "error" then
		seed.last_error_text = response_value(out)
	else
		seed.last_error_text = ""
	end
	close(target)
	return out
end

func cluster_command_slot_once_password_json(Client seed, string slots_response_json, string key, string password, string argv_json) as string
	return cluster_command_slot_once_password_json(seed, slots_response_json, key, password, argv_json, seed.timeout_ms)
