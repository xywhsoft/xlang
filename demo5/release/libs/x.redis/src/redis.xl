end

func sentinel_command_master_retry_json(Client sentinel, string name, string argv_json, int max_attempts, int timeout_ms) as string
	if max_attempts <= 0 then
		max_attempts = 1
	end
	int attempt = 0
	auto out = ""
	while attempt < max_attempts do
		out = sentinel_command_master_once_json(sentinel, name, argv_json, timeout_ms)
		if response_type(out) != "error" then
			return out
		end
		attempt = attempt + 1
	end
	return out
end

