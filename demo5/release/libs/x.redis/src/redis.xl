func json_string(string value) as string
	return json.encode(value)
end

func argv_json1(string a0) as string
	return "[" + json_string(a0) + "]"
end

func argv_json2(string a0, string a1) as string
	return "[" + json_string(a0) + "," + json_string(a1) + "]"
end

func argv_json3(string a0, string a1, string a2) as string
	return "[" + json_string(a0) + "," + json_string(a1) + "," + json_string(a2) + "]"
end

