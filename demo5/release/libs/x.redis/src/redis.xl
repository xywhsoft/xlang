	auto args = [command]
	for value in values
		args.append(value)
	end
	return command_array(client, args)
end

func json_simple(string value) as string
	return "{\"type\":\"simple\",\"value\":" + json_string(value) + "}"
end

func json_error(string value) as string
	return "{\"type\":\"error\",\"value\":" + json_string(value) + "}"
end

func json_integer_text(string value) as string
	return "{\"type\":\"integer\",\"value\":" + value + "}"
end

func json_bulk(string value, bool is_nil) as string
	return "{\"type\":\"bulk\",\"value\":" + json_string(value) + ",\"nil\":" + fmt.bool_text(is_nil) + "}"
end

func json_array(string items, bool is_nil) as string
	return "{\"type\":\"array\",\"items\":[" + items + "],\"nil\":" + fmt.bool_text(is_nil) + "}"
end

func json_null() as string
	return "{\"type\":\"null\",\"nil\":true}"
end

func json_bool(bool value) as string
	return "{\"type\":\"bool\",\"value\":" + fmt.bool_text(value) + "}"
end

func json_double_text(string value) as string
	return "{\"type\":\"double\",\"value\":" + json_string(value) + "}"
end

func json_big_number(string value) as string
	return "{\"type\":\"bignumber\",\"value\":" + json_string(value) + "}"
end

func json_blob_error(string value) as string
	return "{\"type\":\"blob_error\",\"value\":" + json_string(value) + "}"
end

func json_verbatim(string value) as string
	return "{\"type\":\"verbatim\",\"value\":" + json_string(value) + "}"
end

func json_map(string pairs, bool is_nil) as string
	return "{\"type\":\"map\",\"pairs\":[" + pairs + "],\"nil\":" + fmt.bool_text(is_nil) + "}"
end

func json_pair(string key, string value) as string
	return "{\"key\":" + key + ",\"value\":" + value + "}"
end

func json_set(string items, bool is_nil) as string
	return "{\"type\":\"set\",\"items\":[" + items + "],\"nil\":" + fmt.bool_text(is_nil) + "}"
end

func reader_reset(string text) as void
	g_resp_buffer = text
	g_resp_pos = 0
	g_resp_error = ""
end

func reader_append(string chunk) as void
	g_resp_buffer = g_resp_buffer + chunk
end

func reader_available() as int
	return g_resp_buffer.length - g_resp_pos
end

func reader_fail(string message) as string
	g_resp_error = message
	return json_error(message)
end

func read_line() as string
	if g_resp_pos > g_resp_buffer.length then
		return ""
	end
	auto rest = g_resp_buffer.slice(g_resp_pos, g_resp_buffer.length - g_resp_pos)
	auto idx = rest.index_of("\r\n")
	if idx < 0 then
		return ""
	end
	auto line = rest.slice(0, idx)
	g_resp_pos = g_resp_pos + idx + 2
	return line
end

func parse_one_json() as string
	auto save = g_resp_pos
	g_resp_error = ""
	auto out = parse_value_json(0)
	if out == "" and g_resp_error == "" then
		g_resp_pos = save
	end
	return out
end

func parse_value_json(int depth) as string
	if depth > MAX_ARRAY_DEPTH then
		return reader_fail("RESP array nesting too deep")
	end
	if reader_available() <= 0 then
		return ""
	end
	auto prefix = g_resp_buffer.slice(g_resp_pos, 1)
	g_resp_pos = g_resp_pos + 1
	if prefix == "+" then
		auto line = read_line()
		if line == "" and g_resp_error == "" then
			return ""
		end
		return json_simple(line)
	end
	if prefix == "-" then
		auto line = read_line()
		if line == "" and g_resp_error == "" then
			return ""
		end
		return json_error(line)
	end
	if prefix == ":" then
		auto line = read_line()
		if line == "" and g_resp_error == "" then
			return ""
		end
		return json_integer_text(line)
	end
	if prefix == "$" then
		return parse_bulk_json()
	end
	if prefix == "*" then
		return parse_array_json(depth)
	end
	if prefix == "_" then
		if reader_available() < 2 then
			return ""
		end
		auto crlf = g_resp_buffer.slice(g_resp_pos, 2)
		if crlf != "\r\n" then
			return reader_fail("invalid RESP3 null")
		end
		g_resp_pos = g_resp_pos + 2
		return json_null()
	end
	if prefix == "#" then
		auto line = read_line()
		if line == "" and g_resp_error == "" then
			return ""
		end
		return json_bool(line == "t")
	end
	if prefix == "," then
		auto line = read_line()
		if line == "" and g_resp_error == "" then
			return ""
		end
		return json_double_text(line)
	end
	if prefix == "(" then
		auto line = read_line()
		if line == "" and g_resp_error == "" then
			return ""
		end
		return json_big_number(line)
	end
	if prefix == "!" then
		return parse_blob_error_json()
	end
	if prefix == "=" then
		return parse_verbatim_json()
	end
	if prefix == "%" then
		return parse_map_json(depth)
	end
	if prefix == "~" then
		return parse_set_json(depth)
	end
	return reader_fail("invalid RESP prefix: " + prefix)
end

func parse_bulk_json() as string
	auto line = read_line()
	if line == "" then
		return ""
	end
	auto len = parse_int(line)
	if len == -1 then
		return json_bulk("", true)
	end
	if len < 0 then
		return reader_fail("invalid bulk length")
	end
	if reader_available() < len + 2 then
		return ""
	end
	auto value = g_resp_buffer.slice(g_resp_pos, len)
	auto crlf = g_resp_buffer.slice(g_resp_pos + len, 2)
	if crlf != "\r\n" then
		return reader_fail("missing CRLF after bulk body")
	end
	g_resp_pos = g_resp_pos + len + 2
	return json_bulk(value, false)
end

func parse_blob_text() as string
	auto line = read_line()
	if line == "" then
		return ""
	end
	auto len = parse_int(line)
	if len < 0 then
		return reader_fail("invalid bulk length")
	end
	if reader_available() < len + 2 then
		return ""
	end
	auto value = g_resp_buffer.slice(g_resp_pos, len)
	auto crlf = g_resp_buffer.slice(g_resp_pos + len, 2)
	if crlf != "\r\n" then
		return reader_fail("missing CRLF after bulk body")
	end
	g_resp_pos = g_resp_pos + len + 2
	return value
end

func parse_blob_error_json() as string
	auto line = read_line()
	if line == "" then
		return ""
	end
	auto len = parse_int(line)
	if len < 0 then
		return reader_fail("invalid bulk length")
	end
	if reader_available() < len + 2 then
		return ""
	end
	auto value = g_resp_buffer.slice(g_resp_pos, len)
	auto crlf = g_resp_buffer.slice(g_resp_pos + len, 2)
	if crlf != "\r\n" then
		return reader_fail("missing CRLF after bulk body")
	end
	g_resp_pos = g_resp_pos + len + 2
	return json_blob_error(value)
end

func parse_verbatim_json() as string
	auto line = read_line()
	if line == "" then
		return ""
	end
	auto len = parse_int(line)
	if len < 0 then
		return reader_fail("invalid bulk length")
	end
	if reader_available() < len + 2 then
		return ""
	end
	auto value = g_resp_buffer.slice(g_resp_pos, len)
	auto crlf = g_resp_buffer.slice(g_resp_pos + len, 2)
	if crlf != "\r\n" then
		return reader_fail("missing CRLF after bulk body")
	end
	g_resp_pos = g_resp_pos + len + 2
	return json_verbatim(value)
end

func parse_array_json(int depth) as string
	auto line = read_line()
	if line == "" then
		return ""
	end
	auto count = parse_int(line)
	if count == -1 then
		return json_array("", true)
	end
	if count < 0 then
		return reader_fail("invalid array length")
	end
	auto items = ""
	int i = 0
	while i < count do
		auto item = parse_value_json(depth + 1)
		if item == "" then
			return ""
		end
		if g_resp_error != "" then
			return item
		end
		if i > 0 then
			items = items + ","
		end
		items = items + item
		i = i + 1
	end
	return json_array(items, false)
end

func parse_map_json(int depth) as string
	auto line = read_line()
	if line == "" then
		return ""
	end
	auto count = parse_int(line)
	if count == -1 then
		return json_map("", true)
	end
	if count < 0 then
		return reader_fail("invalid map length")
	end
	auto pairs = ""
	int i = 0
	while i < count do
		auto key = parse_value_json(depth + 1)
		if key == "" then
			return ""
		end
		if g_resp_error != "" then
			return key
		end
		auto value = parse_value_json(depth + 1)
		if value == "" then
			return ""
		end
		if g_resp_error != "" then
			return value
		end
		if i > 0 then
			pairs = pairs + ","
		end
		pairs = pairs + json_pair(key, value)
		i = i + 1
	end
	return json_map(pairs, false)
end

func parse_set_json(int depth) as string
	auto line = read_line()
	if line == "" then
		return ""
	end
	auto count = parse_int(line)
	if count == -1 then
		return json_set("", true)
	end
	if count < 0 then
		return reader_fail("invalid set length")
	end
	auto items = ""
	int i = 0
	while i < count do
		auto item = parse_value_json(depth + 1)
		if item == "" then
			return ""
		end
		if g_resp_error != "" then
			return item
		end
		if i > 0 then
			items = items + ","
		end
		items = items + item
		i = i + 1
	end
	return json_set(items, false)
end


func connect(string host, int port) as Client
	return connect(host, port, DEFAULT_TIMEOUT_MS)
end

func connect(string host, int port, int timeout_ms) as Client
	point socket = null
	try
		socket = tcp.connect(host, port)
	catch e
		return Client(host, port, timeout_ms, "tcp connect failed: " + host + ":" + fmt.int_text(port, "") + ": " + e.message)
	end
	if socket == null then
		return Client(host, port, timeout_ms, "tcp connect failed: " + host + ":" + fmt.int_text(port, ""))
	end
	return Client(socket, host, port, timeout_ms)
end

func close(Client client) as bool
	return client.close()
end

func last_error(Client client) as string
	return client.last_error()
end

func pool(string host, int port, int max_idle) as Pool
	return Pool(host, port, DEFAULT_TIMEOUT_MS, max_idle)
end

func pool(string host, int port, int timeout_ms, int max_idle) as Pool
	return Pool(host, port, timeout_ms, max_idle)
end

func pool_acquire(Pool pool_value) as Client
	return pool_value.acquire()
end

func pool_release(Pool pool_value, Client client) as bool
	return pool_value.release(move(client))
end

func pool_close(Pool pool_value) as int
	return pool_value.close()
end

func pool_idle_count(Pool pool_value) as int
	return pool_value.idle_size()
end

func command_raw(Client client, string encoded) as string
	if client.valid() == false then
		client.last_error_text = "redis client is closed"
		return json_error(client.last_error_text)
	end
	auto sent = tcp.send(client.socket, encoded)
	if sent != encoded.length then
		client.last_error_text = "tcp send failed"
		return json_error(client.last_error_text)
	end
	reader_reset("")
	while g_resp_buffer.length < MAX_RESPONSE_BYTES do
		auto chunk = tcp.recv(client.socket, RECV_SIZE, client.timeout_ms)
		if chunk == "" then
			client.last_error_text = "redis receive timeout or closed connection"
			return json_error(client.last_error_text)
		end
		reader_append(chunk)
		auto parsed = parse_one_json()
		if parsed != "" then
			if g_resp_error != "" then
				client.last_error_text = g_resp_error
				client.close()
			else
				auto typ = response_type(parsed)
				if typ == "error" then
					client.last_error_text = response_value(parsed)
				else
					client.last_error_text = ""
				end
			end
			return parsed
		end
	end
	client.last_error_text = "redis response exceeds maximum buffer"
	client.close()
	return json_error(client.last_error_text)
end

func command1(Client client, string a0) as string
	return command_raw(client, resp_encode1(a0))
end

func command2(Client client, string a0, string a1) as string
	return command_raw(client, resp_encode2(a0, a1))
end

func command3(Client client, string a0, string a1, string a2) as string
	return command_raw(client, resp_encode3(a0, a1, a2))
end

func command4(Client client, string a0, string a1, string a2, string a3) as string
	return command_raw(client, resp_encode4(a0, a1, a2, a3))
end

func command5(Client client, string a0, string a1, string a2, string a3, string a4) as string
	return command_raw(client, resp_encode5(a0, a1, a2, a3, a4))
end

func command_array(Client client, list<string> args) as string
	return command_raw(client, resp_encode_array(args))
end

func command_array(Client client, array<string> args) as string
	return command_raw(client, resp_encode_array_values(args))
end

func command_json(Client client, string argv_json) as string
	return command_raw(client, resp_encode_json(argv_json))
end

func cluster_command_redirect_once_json(Client client, string argv_json) as string
	return cluster_command_redirect_once_json(client, argv_json, client.timeout_ms)
end

func cluster_command_redirect_once_json(Client client, string argv_json, int timeout_ms) as string
	auto first = command_json(client, argv_json)
	auto redirect_type = cluster_redirect_type(first)
	if redirect_type == "" then
		return first
	end
	auto target = cluster_connect_redirect(first, timeout_ms)
	if target.valid() == false then
		client.last_error_text = target.last_error()
		return json_error(client.last_error_text)
	end
	if redirect_type == "ASK" then
		if cluster_asking(target) == false then
			client.last_error_text = target.last_error()
			auto ask_error = json_error(client.last_error_text)
			close(target)
			return ask_error
		end
	end
	auto out = command_json(target, argv_json)
	if response_type(out) == "error" then
		client.last_error_text = response_value(out)
	else
		client.last_error_text = ""
	end
	close(target)
	return out
end

func cluster_command_redirect_retry_json(Client client, string argv_json, int max_redirects) as string
	return cluster_command_redirect_retry_json(client, argv_json, max_redirects, client.timeout_ms)
end

func cluster_command_redirect_retry_json(Client client, string argv_json, int max_redirects, int timeout_ms) as string
	auto out = command_json(client, argv_json)
	int redirects = 0
	while cluster_redirect_type(out) != "" and redirects < max_redirects do
		auto redirect_type = cluster_redirect_type(out)
		auto target = cluster_connect_redirect(out, timeout_ms)
		if target.valid() == false then
			client.last_error_text = target.last_error()
			return json_error(client.last_error_text)
		end
		if redirect_type == "ASK" then
			if cluster_asking(target) == false then
				client.last_error_text = target.last_error()
				auto ask_error = json_error(client.last_error_text)
				close(target)
				return ask_error
			end
		end
		out = command_json(target, argv_json)
		close(target)
		redirects = redirects + 1
	end
	if response_type(out) == "error" then
		client.last_error_text = response_value(out)
	else
		client.last_error_text = ""
	end
	return out
end

func command_pipeline_json(Client client, string commands_json) as string
	var array<var> commands = json.decode(commands_json)
	auto encoded = ""
	for command in commands
		var array<string> args = command
		encoded = encoded + resp_encode_array_values(args)
	end
	return command_pipeline_raw(client, encoded, commands.length)
end

func command_pipeline_raw(Client client, string encoded, int count) as string
	if count <= 0 then
		return "[]"
	end
	if client.valid() == false then
		client.last_error_text = "redis client is closed"
		return json_error(client.last_error_text)
	end
	auto sent = tcp.send(client.socket, encoded)
	if sent != encoded.length then
		client.last_error_text = "tcp send failed"
		return json_error(client.last_error_text)
	end
	reader_reset("")
	auto items = ""
	int parsed_count = 0
	while g_resp_buffer.length < MAX_RESPONSE_BYTES do
		auto parsed = parse_one_json()
		if parsed != "" then
			if g_resp_error != "" then
				client.last_error_text = g_resp_error
				client.close()
				return json_error(client.last_error_text)
			end
			if response_type(parsed) == "error" then
				client.last_error_text = response_value(parsed)
			end
			if parsed_count > 0 then
				items = items + ","
			end
			items = items + parsed
			parsed_count = parsed_count + 1
			if parsed_count >= count then
				return "[" + items + "]"
			end
		else
			auto chunk = tcp.recv(client.socket, RECV_SIZE, client.timeout_ms)
			if chunk == "" then
				client.last_error_text = "redis receive timeout or closed connection"
				return json_error(client.last_error_text)
			end
			reader_append(chunk)
		end
	end
	client.last_error_text = "redis response exceeds maximum buffer"
	client.close()
	return json_error(client.last_error_text)
end

func read_response_json(Client client) as string
	if client.valid() == false then
		client.last_error_text = "redis client is closed"
		return json_error(client.last_error_text)
	end
	if reader_available() <= 0 then
		reader_reset("")
	end
	while g_resp_buffer.length < MAX_RESPONSE_BYTES do
		auto parsed = parse_one_json()
		if parsed != "" then
			if g_resp_error != "" then
				client.last_error_text = g_resp_error
				client.close()
			else
				auto typ = response_type(parsed)
				if typ == "error" then
					client.last_error_text = response_value(parsed)
				else
					client.last_error_text = ""
				end
			end
			return parsed
		end
		auto chunk = tcp.recv(client.socket, RECV_SIZE, client.timeout_ms)
		if chunk == "" then
			client.last_error_text = "redis receive timeout or closed connection"
			return json_error(client.last_error_text)
		end
		reader_append(chunk)
	end
	client.last_error_text = "redis response exceeds maximum buffer"
	client.close()
	return json_error(client.last_error_text)
end

func response_type(string response_json) as string
	dict value = json.decode(response_json)
	if value.has("type") == false then
		return ""
	end
	return value["type"]
end

func response_value(string response_json) as string
	dict value = json.decode(response_json)
	if value.has("value") == false then
		return ""
	end
	return value["value"]
end

func response_int(string response_json) as int
	dict value = json.decode(response_json)
	if value.has("value") == false then
		return -1
	end
	return value["value"]
end

func response_bool(string response_json) as bool
	dict value = json.decode(response_json)
	if value.has("value") == false then
		return false
	end
	return value["value"]
end

func response_double_text(string response_json) as string
	dict value = json.decode(response_json)
	if value.has("value") == false then
		return ""
	end
	return value["value"]
end

func response_bignumber_text(string response_json) as string
	if response_type(response_json) != "bignumber" then
		return ""
	end
	return response_value(response_json)
end

func response_blob_error_text(string response_json) as string
	if response_type(response_json) != "blob_error" then
		return ""
	end
	return response_value(response_json)
end

func response_verbatim_text(string response_json) as string
	if response_type(response_json) != "verbatim" then
		return ""
	end
	return response_value(response_json)
end

func response_nil(string response_json) as bool
	dict value = json.decode(response_json)
	if value.has("nil") == false then
		return false
	end
	return value["nil"]
end

func response_ok(string response_json) as bool
	return response_type(response_json) == "simple" and response_value(response_json) == "OK"
end

func response_error(string response_json) as bool
	return response_type(response_json) == "error"
end

func response_error_text(string response_json) as string
	if response_error(response_json) == false then
		return ""
	end
	return response_value(response_json)
end

func cluster_slots_cache(string slots_response_json) as ClusterSlotsCache
	return ClusterSlotsCache(slots_response_json)
end

func cluster_slots_cache_json(ClusterSlotsCache cache) as string
	return cache.slots_json
end

func cluster_slots_cache_valid(ClusterSlotsCache cache) as bool
	if cache.slots_json == "" then
		return false
	end
	return response_type(cache.slots_json) == "array"
end

func cluster_redirect_message(string response_json) as string
	if response_type(response_json) != "error" then
		return ""
	end
	auto message = response_value(response_json)
	if message.length >= 5 and message.slice(0, 5) == "MOVED" then
		return message
	end
	if message.length >= 3 and message.slice(0, 3) == "ASK" then
		return message
	end
	return ""
end

func cluster_redirect_type(string response_json) as string
	auto message = cluster_redirect_message(response_json)
	if message.length >= 5 and message.slice(0, 5) == "MOVED" then
		return "MOVED"
	end
	if message.length >= 3 and message.slice(0, 3) == "ASK" then
		return "ASK"
	end
	return ""
end

func cluster_retryable_error(string response_json) as bool
	if response_type(response_json) != "error" then
		return false
	end
	auto message = response_value(response_json)
	if message.length >= 8 and message.slice(0, 8) == "READONLY" then
		return true
	end
	if message.length >= 8 and message.slice(0, 8) == "TRYAGAIN" then
		return true
	end
	if message.length >= 11 and message.slice(0, 11) == "CLUSTERDOWN" then
		return true
	end
	return false
end

func cluster_redirect_slot(string response_json) as int
	auto message = cluster_redirect_message(response_json)
	auto first = message.index_of(" ")
	if first < 0 then
		return -1
	end
	auto rest = message.slice(first + 1, message.length - first - 1)
	auto second = rest.index_of(" ")
	if second < 0 then
		return -1
	end
	return parse_int(rest.slice(0, second))
end

func cluster_redirect_endpoint(string response_json) as string
	auto message = cluster_redirect_message(response_json)
	auto first = message.index_of(" ")
	if first < 0 then
		return ""
	end
	auto rest = message.slice(first + 1, message.length - first - 1)
	auto second = rest.index_of(" ")
	if second < 0 then
		return ""
	end
	return rest.slice(second + 1, rest.length - second - 1)
end

func cluster_redirect_host(string response_json) as string
	auto endpoint = cluster_redirect_endpoint(response_json)
	auto idx = endpoint.index_of(":")
	if idx < 0 then
		return endpoint
	end
	return endpoint.slice(0, idx)
end

func cluster_redirect_port(string response_json) as int
	auto endpoint = cluster_redirect_endpoint(response_json)
	auto idx = endpoint.index_of(":")
	if idx < 0 then
		return -1
	end
	return parse_int(endpoint.slice(idx + 1, endpoint.length - idx - 1))
end

func cluster_connect_redirect(string response_json) as Client
	return cluster_connect_redirect(response_json, DEFAULT_TIMEOUT_MS)
end

func cluster_connect_redirect(string response_json, int timeout_ms) as Client
	auto host = cluster_redirect_host(response_json)
	auto port = cluster_redirect_port(response_json)
	if host == "" or port <= 0 then
		return Client(host, port, timeout_ms, "cluster redirect target not found")
	end
	return connect(host, port, timeout_ms)
end

func response_array_value(string response_json, int index) as string
	dict value = json.decode(response_json)
	if value.has("items") == false then
		return ""
	end
	var array<var> items = value["items"]
	if index < 0 or index >= items.length then
		return ""
	end
	dict item = items[index]
	if item.has("value") == false then
		return ""
	end
	return item["value"]
end

func response_array_length(string response_json) as int
	dict value = json.decode(response_json)
	if value.has("items") == false then
		return 0
	end
	var array<var> items = value["items"]
	return items.length
end

func response_set_value(string response_json, int index) as string
	return response_array_value(response_json, index)
end

func response_set_length(string response_json) as int
	return response_array_length(response_json)
end

func response_map_length(string response_json) as int
	dict value = json.decode(response_json)
	if value.has("pairs") == false then
		return 0
	end
	var array<var> pairs = value["pairs"]
	return pairs.length
end

func response_map_key_value(string response_json, int index) as string
	dict value = json.decode(response_json)
	if value.has("pairs") == false then
		return ""
	end
	var array<var> pairs = value["pairs"]
	if index < 0 or index >= pairs.length then
		return ""
	end
	dict pair = pairs[index]
	if pair.has("key") == false then
		return ""
	end
	dict key = pair["key"]
	if key.has("value") == false then
		return ""
	end
	return key["value"]
end

func response_map_value_value(string response_json, int index) as string
	dict value = json.decode(response_json)
	if value.has("pairs") == false then
		return ""
	end
	var array<var> pairs = value["pairs"]
	if index < 0 or index >= pairs.length then
		return ""
	end
	dict pair = pairs[index]
	if pair.has("value") == false then
		return ""
	end
	dict item = pair["value"]
	if item.has("value") == false then
		return ""
	end
	return item["value"]
end

func response_map_value(string response_json, string key_text) as string
	dict value = json.decode(response_json)
	if value.has("pairs") == false then
		return ""
	end
	var array<var> pairs = value["pairs"]
	for pair_value in pairs
		dict pair = pair_value
		if pair.has("key") and pair.has("value") then
			dict key = pair["key"]
			if key.has("value") and key["value"] == key_text then
				dict item = pair["value"]
				if item.has("value") then
					return item["value"]
				end
				return ""
			end
		end
	end
	return ""
end

func response_map_has_key(string response_json, string key_text) as bool
	dict value = json.decode(response_json)
	if value.has("pairs") == false then
		return false
	end
	var array<var> pairs = value["pairs"]
	for pair_value in pairs
		dict pair = pair_value
		if pair.has("key") then
			dict key = pair["key"]
			if key.has("value") and key["value"] == key_text then
				return true
			end
		end
	end
	return false
end

