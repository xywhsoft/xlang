import std.net.tcp as tcp
import std.fmt as fmt
import std.json as json

extern "atoi" func parse_int(string text) as int

export const int OK = 0
export const int ERR = 1
export const int TIMEOUT = 2
export const int CLOSED = 3
export const int PROTOCOL_ERROR = 4

const int DEFAULT_TIMEOUT_MS = 5000
const int RECV_SIZE = 4096
const int MAX_RESPONSE_BYTES = 16777216
const int MAX_ARRAY_DEPTH = 16

var string g_resp_buffer = ""
var int g_resp_pos = 0
var string g_resp_error = ""

class Client extends object
	nocopy
	var socket as point
	var host as string
	var port as int
	var timeout_ms as int
	var last_error_text as string

	create()
		self.socket = null
		self.host = ""
		self.port = 0
		self.timeout_ms = DEFAULT_TIMEOUT_MS
		self.last_error_text = ""
	end

	create(point socket, string host, int port, int timeout_ms)
		self.socket = socket
		self.host = host
		self.port = port
		self.timeout_ms = timeout_ms
		self.last_error_text = ""
	end

	create(point socket, string host, int port, int timeout_ms, string last_error_text)
		self.socket = socket
		self.host = host
		self.port = port
		self.timeout_ms = timeout_ms
		self.last_error_text = last_error_text
	end

	create(string host, int port, int timeout_ms, string last_error_text)
		self.socket = null
		self.host = host
		self.port = port
		self.timeout_ms = timeout_ms
		self.last_error_text = last_error_text
	end

	destroy()
		if self.socket != null then
			tcp.close(self.socket)
			self.socket = null
		end
	end

	func valid() as bool
		return self.socket != null
	end

	func close() as bool
		if self.socket == null then
			return false
		end
		auto ok = tcp.close(self.socket)
		self.socket = null
		return ok
	end

	func last_error() as string
		return self.last_error_text
	end

	func set_timeout(int timeout_ms) as void
		self.timeout_ms = timeout_ms
	end
end

class Pool extends object
	nocopy
	var host as string
	var port as int
	var timeout_ms as int
	var max_idle as int
	var idle_count as int
	var socket0 as point
	var socket1 as point
	var socket2 as point
	var socket3 as point

	create(string host, int port, int timeout_ms, int max_idle)
		self.host = host
		self.port = port
		self.timeout_ms = timeout_ms
		self.max_idle = max_idle
		self.idle_count = 0
		self.socket0 = null
		self.socket1 = null
		self.socket2 = null
		self.socket3 = null
	end

	destroy()
		self.close()
	end

	func acquire() as Client
		if self.idle_count == 4 then
			self.idle_count = 3
			auto socket = self.socket3
			self.socket3 = null
			return Client(socket, self.host, self.port, self.timeout_ms)
		end
		if self.idle_count == 3 then
			self.idle_count = 2
			auto socket = self.socket2
			self.socket2 = null
			return Client(socket, self.host, self.port, self.timeout_ms)
		end
		if self.idle_count == 2 then
			self.idle_count = 1
			auto socket = self.socket1
			self.socket1 = null
			return Client(socket, self.host, self.port, self.timeout_ms)
		end
		if self.idle_count == 1 then
			self.idle_count = 0
			auto socket = self.socket0
			self.socket0 = null
			return Client(socket, self.host, self.port, self.timeout_ms)
		end
		return connect(self.host, self.port, self.timeout_ms)
	end

	func release(Client client) as bool
		if client.valid() == false then
			return false
		end
		if self.idle_count >= self.max_idle or self.idle_count >= 4 then
			client.close()
			return false
		end
		if self.idle_count == 0 then
			self.socket0 = client.socket
		end
		if self.idle_count == 1 then
			self.socket1 = client.socket
		end
		if self.idle_count == 2 then
			self.socket2 = client.socket
		end
		if self.idle_count == 3 then
			self.socket3 = client.socket
		end
		client.socket = null
		self.idle_count = self.idle_count + 1
		return true
	end

	func close() as int
		int count = 0
		if self.socket0 != null then
			tcp.close(self.socket0)
			self.socket0 = null
			count = count + 1
		end
		if self.socket1 != null then
			tcp.close(self.socket1)
			self.socket1 = null
			count = count + 1
		end
		if self.socket2 != null then
			tcp.close(self.socket2)
			self.socket2 = null
			count = count + 1
		end
		if self.socket3 != null then
			tcp.close(self.socket3)
			self.socket3 = null
			count = count + 1
		end
		self.idle_count = 0
		return count
	end

	func idle_size() as int
		return self.idle_count
	end
end

class ClusterSlotsCache extends object
	var slots_json as string

	create()
		self.slots_json = ""
	end

	create(string slots_json)
		self.slots_json = slots_json
	end
end

func bulk(string value) as string
	return "$" + fmt.int_text(value.length, "") + "\r\n" + value + "\r\n"
end

func resp_encode1(string a0) as string
	return "*1\r\n" + bulk(a0)
end

func resp_encode2(string a0, string a1) as string
	return "*2\r\n" + bulk(a0) + bulk(a1)
end

func resp_encode3(string a0, string a1, string a2) as string
	return "*3\r\n" + bulk(a0) + bulk(a1) + bulk(a2)
end

func resp_encode4(string a0, string a1, string a2, string a3) as string
	return "*4\r\n" + bulk(a0) + bulk(a1) + bulk(a2) + bulk(a3)
end

func resp_encode5(string a0, string a1, string a2, string a3, string a4) as string
	return "*5\r\n" + bulk(a0) + bulk(a1) + bulk(a2) + bulk(a3) + bulk(a4)
end

func resp_encode_array(list<string> args) as string
	auto out = "*" + fmt.int_text(args.length, "") + "\r\n"
	for value in args
		out = out + bulk(value)
	end
	return out
end

func resp_encode_array_values(array<string> args) as string
	auto out = "*" + fmt.int_text(args.length, "") + "\r\n"
	for value in args
		out = out + bulk(value)
	end
	return out
end

func resp_encode_json(string argv_json) as string
	var array<string> args = json.decode(argv_json)
	return resp_encode_array_values(args)
end

func resp_encode_pipeline_json(string commands_json) as string
	var array<var> commands = json.decode(commands_json)
	auto out = ""
	for command in commands
		var array<string> args = command
		out = out + resp_encode_array_values(args)
	end
	return out
end

func parse_response_json(string text) as string
	reader_reset(text)
	return parse_one_json()
end

func parse_response_chunks_json(string first, string second) as string
	reader_reset("")
	reader_append(first)
	auto out = parse_one_json()
	if out != "" then
		return out
	end
	reader_append(second)
	return parse_one_json()
end

