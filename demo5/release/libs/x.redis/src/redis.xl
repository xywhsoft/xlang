func cluster_command_cache_refresh_key_retry_json(Client seed, ClusterSlotsCache cache, string key, string argv_json, int max_redirects, int timeout_ms) as string
	if cluster_slots_cache_valid(cache) == false then
		if cluster_slots_cache_refresh(cache, seed) == false then
			return json_error(seed.last_error_text)
		end
	end
	auto out = cluster_command_cached_key_retry_json(seed, cache, key, argv_json, max_redirects, timeout_ms)
	if cluster_redirect_type(out) != "" then
		if cluster_slots_cache_refresh(cache, seed) then
			out = cluster_command_cached_key_retry_json(seed, cache, key, argv_json, max_redirects, timeout_ms)
		end
	end
	if cluster_retryable_error(out) then
		if cluster_slots_cache_refresh(cache, seed) then
			out = cluster_command_cached_key_retry_json(seed, cache, key, argv_json, max_redirects, timeout_ms)
		end
	end
	return out
end

