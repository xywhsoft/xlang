	return xsqlite3_bind_blob_text_native(stmt.handle, index, value)
end

func sqlite3_bind_null(Stmt stmt, int index) as int
	return xsqlite3_bind_null_native(stmt.handle, index)
end

func sqlite3_bind_parameter_count(Stmt stmt) as int
	return xsqlite3_bind_parameter_count_native(stmt.handle)
end

func sqlite3_column_count(Stmt stmt) as int
	return xsqlite3_column_count_native(stmt.handle)
end

func sqlite3_column_type(Stmt stmt, int column) as int
	return xsqlite3_column_type_native(stmt.handle, column)
end

func sqlite3_column_int(Stmt stmt, int column) as int
	return xsqlite3_column_int_native(stmt.handle, column)
end

func sqlite3_column_double(Stmt stmt, int column) as float
	return xsqlite3_column_double_native(stmt.handle, column)
end

func sqlite3_column_text(Stmt stmt, int column) as string
	return xsqlite3_column_text_native(stmt.handle, column)
end

func sqlite3_column_blob_text(Stmt stmt, int column) as string
	return xsqlite3_column_text_native(stmt.handle, column)
end

func sqlite3_column_bytes(Stmt stmt, int column) as int
