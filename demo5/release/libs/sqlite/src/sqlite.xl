end

func sqlite3_extended_errcode(Db db) as int
	return xsqlite3_extended_errcode_native(db.handle)
end

func sqlite3_changes(Db db) as int
	return xsqlite3_changes_native(db.handle)
end

func sqlite3_total_changes(Db db) as int
