end

func sqlite3_column_name(Stmt stmt, int column) as string
	return xsqlite3_column_name_native(stmt.handle, column)
end

func sqlite3_errmsg(Db db) as string
	return xsqlite3_errmsg_native(db.handle)
end

func sqlite3_errstr(int rc) as string
