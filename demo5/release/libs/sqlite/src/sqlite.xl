export const int SQLITE_OK = 0
export const int SQLITE_ERROR = 1
export const int SQLITE_INTERNAL = 2
export const int SQLITE_PERM = 3
export const int SQLITE_ABORT = 4
export const int SQLITE_BUSY = 5
export const int SQLITE_LOCKED = 6
export const int SQLITE_NOMEM = 7
export const int SQLITE_READONLY = 8
export const int SQLITE_INTERRUPT = 9
export const int SQLITE_IOERR = 10
export const int SQLITE_CORRUPT = 11
export const int SQLITE_NOTFOUND = 12
export const int SQLITE_FULL = 13
export const int SQLITE_CANTOPEN = 14
export const int SQLITE_PROTOCOL = 15
export const int SQLITE_EMPTY = 16
export const int SQLITE_SCHEMA = 17
export const int SQLITE_TOOBIG = 18
export const int SQLITE_CONSTRAINT = 19
export const int SQLITE_MISMATCH = 20
export const int SQLITE_MISUSE = 21
export const int SQLITE_NOLFS = 22
export const int SQLITE_AUTH = 23
export const int SQLITE_FORMAT = 24
export const int SQLITE_RANGE = 25
export const int SQLITE_NOTADB = 26
export const int SQLITE_NOTICE = 27
export const int SQLITE_WARNING = 28
export const int SQLITE_ROW = 100
export const int SQLITE_DONE = 101

export const int SQLITE_INTEGER = 1
export const int SQLITE_FLOAT = 2
export const int SQLITE_TEXT = 3
export const int SQLITE_BLOB = 4
export const int SQLITE_NULL = 5

export const int SQLITE_OPEN_READONLY = 1
export const int SQLITE_OPEN_READWRITE = 2
export const int SQLITE_OPEN_CREATE = 4
export const int SQLITE_OPEN_URI = 64
export const int SQLITE_OPEN_MEMORY = 128
export const int SQLITE_OPEN_NOMUTEX = 32768
export const int SQLITE_OPEN_FULLMUTEX = 65536
export const int SQLITE_OPEN_SHAREDCACHE = 131072
export const int SQLITE_OPEN_PRIVATECACHE = 262144

class Db extends object
	nocopy
	var handle as point

	create(point handle)
		self.handle = handle
	end

	destroy()
		if self.handle != null then
			xsqlite3_close_v2_native(self.handle)
		end
	end

	func valid() as bool
		return self.handle != null
	end

	func error() as string
		return xsqlite3_errmsg_native(self.handle)
	end
end

class Stmt extends object
	nocopy
	var handle as point

	create(point handle)
		self.handle = handle
	end

	destroy()
		if self.handle != null then
			xsqlite3_finalize_native(self.handle)
		end
	end

	func valid() as bool
		return self.handle != null
	end
end

func sqlite3_last_error() as string
	return xsqlite3_last_error()
end

func sqlite3_open(string filename) as Db
	return Db(xsqlite3_open_native(filename))
end

func sqlite3_open_v2(string filename, int flags, string vfs) as Db
	return Db(xsqlite3_open_v2_native(filename, flags, vfs))
end

func sqlite3_close(Db db) as int
	auto rc = xsqlite3_close_native(db.handle)
	if rc == SQLITE_OK then
		db.handle = null
	end
	return rc
end

func sqlite3_close_v2(Db db) as int
	auto rc = xsqlite3_close_v2_native(db.handle)
	if rc == SQLITE_OK then
		db.handle = null
	end
	return rc
end

func sqlite3_exec(Db db, string sql) as int
	return xsqlite3_exec_native(db.handle, sql)
end

func sqlite3_prepare_v2(Db db, string sql) as Stmt
	return Stmt(xsqlite3_prepare_v2_native(db.handle, sql))
end

func sqlite3_step(Stmt stmt) as int
	return xsqlite3_step_native(stmt.handle)
end

func sqlite3_finalize(Stmt stmt) as int
	auto rc = xsqlite3_finalize_native(stmt.handle)
	if rc == SQLITE_OK then
		stmt.handle = null
	end
	return rc
end

func sqlite3_reset(Stmt stmt) as int
	return xsqlite3_reset_native(stmt.handle)
end

func sqlite3_clear_bindings(Stmt stmt) as int
	return xsqlite3_clear_bindings_native(stmt.handle)
end

func sqlite3_bind_int(Stmt stmt, int index, int value) as int
	return xsqlite3_bind_int_native(stmt.handle, index, value)
end

func sqlite3_bind_double(Stmt stmt, int index, float value) as int
	return xsqlite3_bind_double_native(stmt.handle, index, value)
end

func sqlite3_bind_text(Stmt stmt, int index, string value) as int
	return xsqlite3_bind_text_native(stmt.handle, index, value)
end

