export const int ORT_DISABLE_ALL = 0
export const int ORT_ENABLE_BASIC = 1
export const int ORT_ENABLE_EXTENDED = 2
export const int ORT_ENABLE_ALL = 99

export const int ORT_SEQUENTIAL = 0
export const int ORT_PARALLEL = 1

export const int ORT_LOGGING_LEVEL_VERBOSE = 0
export const int ORT_LOGGING_LEVEL_INFO = 1
export const int ORT_LOGGING_LEVEL_WARNING = 2
export const int ORT_LOGGING_LEVEL_ERROR = 3
export const int ORT_LOGGING_LEVEL_FATAL = 4

export const string CPUExecutionProvider = "CPUExecutionProvider"

class SessionOptionsObject extends object
	nocopy
	var handle as point

	create()
		self.handle = ort_session_options_create_native()
	end

	destroy()
		if self.handle != null then
			ort_session_options_release_native(self.handle)
		end
	end

	func valid() as bool
		return self.handle != null
	end

	func ok() as bool
		return self.handle != null
	end

	func error() as string
		return ort_last_error_native()
	end

	func set_intra_op_num_threads(int value) as bool
		return ort_session_options_set_intra_op_num_threads_native(self.handle, value) != 0
	end

	func set_inter_op_num_threads(int value) as bool
		return ort_session_options_set_inter_op_num_threads_native(self.handle, value) != 0
	end

	func set_graph_optimization_level(int value) as bool
		return ort_session_options_set_graph_optimization_level_native(self.handle, value) != 0
	end

	func set_execution_mode(int value) as bool
		return ort_session_options_set_execution_mode_native(self.handle, value) != 0
	end

	func enable_profiling(string prefix) as bool
		return ort_session_options_enable_profiling_native(self.handle, prefix) != 0
	end

	func disable_profiling() as bool
		return ort_session_options_disable_profiling_native(self.handle) != 0
	end

	func enable_cpu_mem_arena() as bool
		return ort_session_options_enable_cpu_mem_arena_native(self.handle) != 0
	end

	func disable_cpu_mem_arena() as bool
		return ort_session_options_disable_cpu_mem_arena_native(self.handle) != 0
	end

	func enable_mem_pattern() as bool
		return ort_session_options_enable_mem_pattern_native(self.handle) != 0
	end

	func disable_mem_pattern() as bool
		return ort_session_options_disable_mem_pattern_native(self.handle) != 0
	end

	func set_log_id(string value) as bool
		return ort_session_options_set_log_id_native(self.handle, value) != 0
	end

	func set_log_verbosity_level(int value) as bool
		return ort_session_options_set_log_verbosity_level_native(self.handle, value) != 0
	end

	func set_log_severity_level(int value) as bool
		return ort_session_options_set_log_severity_level_native(self.handle, value) != 0
	end

	func append_execution_provider(string provider_name) as bool
		return ort_session_options_append_execution_provider_native(self.handle, provider_name) != 0
	end

	func append_execution_provider(string provider_name, string options_json) as bool
		return ort_session_options_append_execution_provider_with_options_native(self.handle, provider_name, options_json) != 0
	end
end

class RunOptionsObject extends object
	nocopy
	var handle as point

	create()
		self.handle = ort_run_options_create_native()
	end

	destroy()
		if self.handle != null then
			ort_run_options_release_native(self.handle)
		end
	end

	func valid() as bool
		return self.handle != null
	end

	func ok() as bool
		return self.handle != null
	end

	func error() as string
		return ort_last_error_native()
	end

	func set_log_verbosity_level(int value) as bool
		return ort_run_options_set_log_verbosity_level_native(self.handle, value) != 0
	end

	func set_log_severity_level(int value) as bool
		return ort_run_options_set_log_severity_level_native(self.handle, value) != 0
	end

	func set_run_tag(string value) as bool
		return ort_run_options_set_run_tag_native(self.handle, value) != 0
	end

	func set_terminate() as bool
		return ort_run_options_set_terminate_native(self.handle) != 0
	end

	func unset_terminate() as bool
		return ort_run_options_unset_terminate_native(self.handle) != 0
	end
end

class RunResult extends object
	nocopy
	var handle as point

	create(point handle)
		self.handle = handle
	end

	destroy()
		if self.handle != null then
			ort_result_release_native(self.handle)
		end
	end

	func ok() as bool
		return self.handle != null
	end

	func valid() as bool
		return self.handle != null
	end

	func error() as string
		return ort_last_error_native()
	end

	func to_json() as string
		return ort_result_json_native(self.handle)
	end

	func float_shape_json() as string
		return ort_result_float_shape_json_native(self.handle)
	end

	func float_count() as int
		return ort_result_float_count_native(self.handle)
	end

	func float_at(int index) as float
		return ort_result_float_at_native(self.handle, index)
	end
end

class TensorObject extends object
	nocopy
	var handle as point

	create(point handle)
		self.handle = handle
	end

	destroy()
		if self.handle != null then
			ort_tensor_release_native(self.handle)
		end
	end

	func valid() as bool
		return self.handle != null
	end

	func ok() as bool
		return self.handle != null
	end

	func error() as string
		return ort_last_error_native()
	end
end

class IoBindingObject extends object
	nocopy
	var handle as point

	create(point session_handle)
		self.handle = ort_iobinding_create_native(session_handle)
	end

	destroy()
		if self.handle != null then
			ort_iobinding_release_native(self.handle)
		end
	end

	func valid() as bool
		return self.handle != null
	end

	func ok() as bool
		return self.handle != null
	end

	func error() as string
		return ort_last_error_native()
	end

	func bind_cpu_input(string name, string tensor_json) as bool
		return ort_iobinding_bind_cpu_input_native(self.handle, name, tensor_json) != 0
	end

	func bind_output(string name) as bool
		return ort_iobinding_bind_output_native(self.handle, name) != 0
	end

	func clear_inputs() as bool
		return ort_iobinding_clear_inputs_native(self.handle) != 0
	end

	func clear_outputs() as bool
		return ort_iobinding_clear_outputs_native(self.handle) != 0
	end

	func synchronize_inputs() as bool
		return ort_iobinding_synchronize_inputs_native(self.handle) != 0
	end

	func synchronize_outputs() as bool
		return ort_iobinding_synchronize_outputs_native(self.handle) != 0
	end

	func to_json() as string
		return ort_iobinding_outputs_native(self.handle)
	end
end

class InferenceSessionObject extends object
	nocopy
	var handle as point

	create(string model_path)
		self.handle = ort_session_create_native(model_path, null)
	end

	create(string model_path, SessionOptionsObject options)
		self.handle = ort_session_create_native(model_path, options.handle)
	end

	destroy()
		if self.handle != null then
			ort_session_release_native(self.handle)
		end
	end

	func valid() as bool
		return self.handle != null
	end

	func ok() as bool
		return self.handle != null
	end

	func error() as string
		return ort_last_error_native()
	end

	func get_providers() as string
		return ort_get_available_providers_json_native()
	end

	func get_inputs() as string
		return ort_session_inputs_native(self.handle)
	end

	func get_outputs() as string
		return ort_session_outputs_native(self.handle)
	end

	func get_modelmeta() as string
		return ort_session_modelmeta_native(self.handle)
	end

	func end_profiling() as string
		return ort_session_end_profiling_native(self.handle)
	end

	func io_binding() as IoBindingObject
		return IoBindingObject(self.handle)
	end

	func run(string output_names_json, string input_feed_json) as RunResult
		return RunResult(ort_session_run_json_native(self.handle, output_names_json, input_feed_json))
	end

	func run(string output_names_json, string input_feed_json, RunOptionsObject run_options) as RunResult
		return RunResult(ort_session_run_json_with_options_native(self.handle, output_names_json, input_feed_json, run_options.handle))
	end

	func run_tensor(string input_name, TensorObject tensor, string output_names_json) as RunResult
		return RunResult(ort_session_run_tensor_native(self.handle, input_name, tensor.handle, output_names_json))
	end

	func run_tensor_fast(string input_name, TensorObject tensor, string output_names_json) as RunResult
		return RunResult(ort_session_run_tensor_fast_native(self.handle, input_name, tensor.handle, output_names_json))
	end

	func run_with_iobinding(IoBindingObject binding) as RunResult
		return RunResult(ort_session_run_with_iobinding_native(self.handle, binding.handle, null))
	end

	func run_with_iobinding(IoBindingObject binding, RunOptionsObject run_options) as RunResult
		return RunResult(ort_session_run_with_iobinding_native(self.handle, binding.handle, run_options.handle))
	end
end

func SessionOptions() as SessionOptionsObject
	return SessionOptionsObject()
end

func RunOptions() as RunOptionsObject
	return RunOptionsObject()
end

func TensorZerosF32(string shape_json) as TensorObject
	return TensorObject(ort_tensor_zeros_f32_native(shape_json))
end

func TensorFromOpenCV(point image, float scale, float mean0, float mean1, float mean2, float std0, float std1, float std2) as TensorObject
	return TensorObject(ort_tensor_from_opencv_native(image, scale, mean0, mean1, mean2, std0, std1, std2))
end

func TensorFromOpenCVResized(point image, int width, int height, float scale, float mean0, float mean1, float mean2, float std0, float std1, float std2) as TensorObject
	return TensorObject(ort_tensor_from_opencv_resized_native(image, width, height, scale, mean0, mean1, mean2, std0, std1, std2))
end

func TensorFromOpenCVBatch(int batch_count, point image0, point image1, point image2, point image3, point image4, point image5, float scale, float mean0, float mean1, float mean2, float std0, float std1, float std2) as TensorObject
	return TensorObject(ort_tensor_from_opencv_batch_native(batch_count, image0, image1, image2, image3, image4, image5, scale, mean0, mean1, mean2, std0, std1, std2))
end

func InferenceSession(string model_path) as InferenceSessionObject
	return InferenceSessionObject(model_path)
end

func InferenceSession(string model_path, SessionOptionsObject options) as InferenceSessionObject
	return InferenceSessionObject(model_path, options)
end

func available() as bool
	return ort_available_native() != 0
end

func backend() as string
	return ort_backend_native()
end

func get_version_string() as string
	return ort_get_version_string_native()
end

func get_available_providers() as string
	return ort_get_available_providers_json_native()
end

func get_providers() as string
	return get_available_providers()
end

func last_error() as string
	return ort_last_error_native()
end

func get_last_error() as string
	return last_error()
end

export SessionOptions
export RunOptions
export TensorZerosF32
export TensorFromOpenCV
export TensorFromOpenCVResized
export TensorFromOpenCVBatch
export InferenceSession
export available
export backend
export get_version_string
export get_available_providers
export get_providers
export last_error
export get_last_error
