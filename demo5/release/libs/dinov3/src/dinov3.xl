import opencv as cv2
import onnxruntime as ort

export const string DEFAULT_MODEL = "E:\\workspace\\llmrunner\\models\\dinov3-vits16plus_fp32.onnx"
export const string DEFAULT_INPUT_NAME = "image"
export const string DEFAULT_OUTPUT_NAMES = "[\"embedding\"]"

extern "dinov3_version_native" func dinov3_version_native() as string
extern "dinov3_last_error_native" func dinov3_last_error_native() as string
extern "dinov3_embedding_json_native" func dinov3_embedding_json_native(point result_handle) as string
extern "dinov3_output_json_native" func dinov3_output_json_native(point result_handle, string source_path) as string
extern "dinov3_l2_norm_native" func dinov3_l2_norm_native(point result_handle) as float
extern "dinov3_cosine_native" func dinov3_cosine_native(point left_handle, point right_handle) as float
extern "ort_last_error_native" func ort_last_error_native() as string
extern "ort_session_run_tensor_fast_native" func ort_session_run_tensor_fast_native(point handle, string input_name, point tensor, string output_names_json) as point
extern "ort_result_release_native" func ort_result_release_native(point handle) as int
extern "ort_result_float_shape_json_native" func ort_result_float_shape_json_native(point handle) as string
extern "ort_result_float_count_native" func ort_result_float_count_native(point handle) as int
extern "ort_result_float_at_native" func ort_result_float_at_native(point handle, int index) as float

func dinov3_resize_width(int width, int height, int short_side) as int
	if width <= 0 or height <= 0 then
		return short_side
	end
	if width < height then
		return short_side
	end
	return (width * short_side + height - 1) / height
end

func dinov3_resize_height(int width, int height, int short_side) as int
	if width <= 0 or height <= 0 then
		return short_side
	end
	if height < width then
		return short_side
	end
	return (height * short_side + width - 1) / width
end

func dinov3_center_crop(Image image, int crop_w, int crop_h) as Image
	if image.empty() then
		return Image(null)
	end
	int x = (image.width() - crop_w) / 2
	int y = (image.height() - crop_h) / 2
	if x < 0 then
		x = 0
	end
	if y < 0 then
		y = 0
	end
	int w = crop_w
	int h = crop_h
	if x + w > image.width() then
		w = image.width() - x
	end
	if y + h > image.height() then
		h = image.height() - y
	end
	return cv2.crop(image, x, y, w, h)
end

class DinoV3Output extends object
	nocopy
	var handle as point
	var source_path as string

	create(point handle, string source_path)
		self.handle = handle
		self.source_path = source_path
	end

	destroy()
		if self.handle != null then
			ort_result_release_native(self.handle)
		end
	end

	func ok() as bool
		return self.handle != null
	end

	func valid() as bool
		return self.handle != null
	end

	func error() as string
		return ort_last_error_native()
	end

	func shape_json() as string
		return ort_result_float_shape_json_native(self.handle)
	end

	func count() as int
		return ort_result_float_count_native(self.handle)
	end

	func at(int index) as float
		return ort_result_float_at_native(self.handle, index)
	end

	func embedding_json() as string
		return dinov3_embedding_json_native(self.handle)
	end

	func to_json() as string
		return dinov3_output_json_native(self.handle, self.source_path)
	end

	func l2_norm() as float
		return dinov3_l2_norm_native(self.handle)
	end
end

class DinoV3Model extends object
	nocopy
	var model_path as string
	var session as InferenceSessionObject
	var input_name as string
	var output_names as string
	var input_width as int
	var input_height as int
	var resize_short as int
	var keep_aspect as bool
	var scale as float
	var mean0 as float
	var mean1 as float
	var mean2 as float
	var std0 as float
	var std1 as float
	var std2 as float

	create()
		self.model_path = DEFAULT_MODEL
		self.session = ort.InferenceSession(self.model_path)
		self.input_name = DEFAULT_INPUT_NAME
		self.output_names = DEFAULT_OUTPUT_NAMES
		self.input_width = 224
		self.input_height = 224
		self.resize_short = 256
		self.keep_aspect = true
		self.scale = 0.0039215689
		self.mean0 = 0.485
		self.mean1 = 0.456
		self.mean2 = 0.406
		self.std0 = 0.229
		self.std1 = 0.224
		self.std2 = 0.225
	end

	create(string model_path)
		self.model_path = model_path
		self.session = ort.InferenceSession(self.model_path)
		self.input_name = DEFAULT_INPUT_NAME
		self.output_names = DEFAULT_OUTPUT_NAMES
		self.input_width = 224
		self.input_height = 224
		self.resize_short = 256
		self.keep_aspect = true
		self.scale = 0.0039215689
		self.mean0 = 0.485
		self.mean1 = 0.456
		self.mean2 = 0.406
		self.std0 = 0.229
		self.std1 = 0.224
		self.std2 = 0.225
	end

	func set_input_shape(int width, int height) as bool
		if width <= 0 or height <= 0 then
			return false
		end
		self.input_width = width
		self.input_height = height
		return true
	end

	func set_input_name(string value) as bool
		if value == "" then
			return false
		end
		self.input_name = value
		return true
	end

	func set_output_names(string value) as bool
		if value == "" then
			return false
		end
		self.output_names = value
		return true
	end

	func set_resize_short(int value) as bool
		if value <= 0 then
			return false
		end
		self.resize_short = value
		return true
	end

	func set_keep_aspect(bool value) as bool
		self.keep_aspect = value
		return true
	end

	func set_direct_resize(bool value) as bool
		self.keep_aspect = value == false
		return true
	end

	func set_normalize(float scale, float mean0, float mean1, float mean2, float std0, float std1, float std2) as bool
		if std0 == 0 or std1 == 0 or std2 == 0 then
			return false
		end
		self.scale = scale
		self.mean0 = mean0
		self.mean1 = mean1
		self.mean2 = mean2
		self.std0 = std0
		self.std1 = std1
		self.std2 = std2
		return true
	end

	func op_call(string image_path) as DinoV3Output
		auto img = cv2.imread(image_path, cv2.IMREAD_COLOR)
		if img.empty() then
			return DinoV3Output(null, image_path)
		end
		auto rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
		if self.keep_aspect then
			int resize_w = dinov3_resize_width(rgb.width(), rgb.height(), self.resize_short)
			int resize_h = dinov3_resize_height(rgb.width(), rgb.height(), self.resize_short)
			auto resized = cv2.resize(rgb, resize_w, resize_h)
			auto cropped = dinov3_center_crop(resized, self.input_width, self.input_height)
			auto tensor = ort.TensorFromOpenCV(cropped.handle, self.scale, self.mean0, self.mean1, self.mean2, self.std0, self.std1, self.std2)
			point result_handle = ort_session_run_tensor_fast_native(self.session.handle, self.input_name, tensor.handle, self.output_names)
			return DinoV3Output(result_handle, image_path)
		end
		auto direct = cv2.resize(rgb, self.input_width, self.input_height)
		auto direct_tensor = ort.TensorFromOpenCV(direct.handle, self.scale, self.mean0, self.mean1, self.mean2, self.std0, self.std1, self.std2)
		point direct_result_handle = ort_session_run_tensor_fast_native(self.session.handle, self.input_name, direct_tensor.handle, self.output_names)
		return DinoV3Output(direct_result_handle, image_path)
	end
end

func DinoV3() as DinoV3Model
	return DinoV3Model()
end

func DinoV3(string model_path) as DinoV3Model
	return DinoV3Model(model_path)
end

func embedding_json(string image_path) as string
	auto model = DinoV3Model()
	auto result = model(image_path)
	return result.embedding_json()
end

func embedding_json(string model_path, string image_path) as string
	auto model = DinoV3Model(model_path)
	auto result = model(image_path)
	return result.embedding_json()
end

func infer_json(string image_path) as string
	auto model = DinoV3Model()
	auto result = model(image_path)
	return result.to_json()
end

func infer_json(string model_path, string image_path) as string
	auto model = DinoV3Model(model_path)
	auto result = model(image_path)
	return result.to_json()
end

func version() as string
	return dinov3_version_native()
end

func last_error() as string
	return dinov3_last_error_native()
end

export DinoV3
export embedding_json
export infer_json
export version
export last_error
