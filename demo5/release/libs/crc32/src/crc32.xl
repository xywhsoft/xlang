extern "xcrc32_version" func xcrc32_version() as string
extern "xcrc32_last_error" func xcrc32_last_error() as string
extern "xcrc32_init" func xcrc32_init() as int
extern "xcrc32_update" func xcrc32_update(int crc, string text) as int
extern "xcrc32_finish" func xcrc32_finish(int crc) as int
extern "xcrc32_string" func xcrc32_string(string text) as int
extern "xcrc32_string_hex" func xcrc32_string_hex(string text) as string
extern "xcrc32_file" func xcrc32_file(string path) as int
extern "xcrc32_file_hex" func xcrc32_file_hex(string path) as string
extern "xcrc32_hex" func xcrc32_hex(int crc) as string

func version() as string
	return xcrc32_version()
end

func last_error() as string
	return xcrc32_last_error()
end

func init() as int
	return xcrc32_init()
end

func update(int crc, string text) as int
	return xcrc32_update(crc, text)
end

func finish(int crc) as int
	return xcrc32_finish(crc)
end

func checksum(string text) as int
	return xcrc32_string(text)
end

func checksum_hex(string text) as string
	return xcrc32_string_hex(text)
end

func file(string path) as int
	return xcrc32_file(path)
end

func file_hex(string path) as string
	return xcrc32_file_hex(path)
end

func hex(int crc) as string
	return xcrc32_hex(crc)
end

export version
export last_error
export init
export update
export finish
export checksum
export checksum_hex
export file
export file_hex
export hex
