extern "x_clipboard_available" func x_clipboard_available() as int
extern "x_clipboard_last_error" func x_clipboard_last_error() as string
extern "x_clipboard_clear" func x_clipboard_clear() as int
extern "x_clipboard_sequence_number" func x_clipboard_sequence_number() as int
extern "x_clipboard_count_formats" func x_clipboard_count_formats() as int
extern "x_clipboard_formats" func x_clipboard_formats() as array<var>
extern "x_clipboard_formats_json" func x_clipboard_formats_json() as string
extern "x_clipboard_format_name" func x_clipboard_format_name(int format_id) as string
extern "x_clipboard_register_format" func x_clipboard_register_format(string name) as int
extern "x_clipboard_is_format_available" func x_clipboard_is_format_available(int format_id) as int
extern "x_clipboard_has_text" func x_clipboard_has_text() as int
extern "x_clipboard_has_image" func x_clipboard_has_image() as int
extern "x_clipboard_has_files" func x_clipboard_has_files() as int
extern "x_clipboard_get_text" func x_clipboard_get_text() as string
extern "x_clipboard_set_text" func x_clipboard_set_text(string text) as int
extern "x_clipboard_get_files" func x_clipboard_get_files() as array<var>
extern "x_clipboard_get_file" func x_clipboard_get_file() as string
extern "x_clipboard_set_files" func x_clipboard_set_files(array<var> paths) as int
extern "x_clipboard_set_file" func x_clipboard_set_file(string path) as int
extern "x_clipboard_save_image" func x_clipboard_save_image(string path) as int
extern "x_clipboard_set_image" func x_clipboard_set_image(string path) as int
extern "x_clipboard_image_info_json" func x_clipboard_image_info_json() as string

export const int CF_TEXT = 1
export const int CF_BITMAP = 2
export const int CF_METAFILEPICT = 3
export const int CF_SYLK = 4
export const int CF_DIF = 5
export const int CF_TIFF = 6
export const int CF_OEMTEXT = 7
export const int CF_DIB = 8
export const int CF_PALETTE = 9
export const int CF_PENDATA = 10
export const int CF_RIFF = 11
export const int CF_WAVE = 12
export const int CF_UNICODETEXT = 13
export const int CF_ENHMETAFILE = 14
export const int CF_HDROP = 15
export const int CF_LOCALE = 16
export const int CF_DIBV5 = 17

func available() as bool
	return x_clipboard_available() != 0
end

func last_error() as string
	return x_clipboard_last_error()
end

func clear() as bool
	return x_clipboard_clear() != 0
end

func sequence_number() as int
	return x_clipboard_sequence_number()
end

func count_formats() as int
	return x_clipboard_count_formats()
end

func formats() as array<var>
	return x_clipboard_formats()
end

func types() as array<var>
	return formats()
end

func formats_json() as string
	return x_clipboard_formats_json()
end

func types_json() as string
	return formats_json()
end

func format_name(int format_id) as string
	return x_clipboard_format_name(format_id)
end

func register_format(string name) as int
	return x_clipboard_register_format(name)
end

func is_format_available(int format_id) as bool
	return x_clipboard_is_format_available(format_id) != 0
end

func has_text() as bool
	return x_clipboard_has_text() != 0
end

func has_image() as bool
	return x_clipboard_has_image() != 0
end

func has_files() as bool
	return x_clipboard_has_files() != 0
end

func get_text() as string
	return x_clipboard_get_text()
end

func read_text() as string
	return get_text()
end

func set_text(string text) as bool
	return x_clipboard_set_text(text) != 0
end

func write_text(string text) as bool
	return set_text(text)
end

func get_files() as array<var>
	return x_clipboard_get_files()
end

func read_files() as array<var>
	return get_files()
end

func get_file() as string
	return x_clipboard_get_file()
end

func set_files(array<var> paths) as bool
	return x_clipboard_set_files(paths) != 0
end

func write_files(array<var> paths) as bool
	return set_files(paths)
end

func set_file(string path) as bool
	return x_clipboard_set_file(path) != 0
end

func save_image(string path) as bool
	return x_clipboard_save_image(path) != 0
end

func read_image(string path) as bool
	return save_image(path)
end

func set_image(string path) as bool
	return x_clipboard_set_image(path) != 0
end

func write_image(string path) as bool
	return set_image(path)
end

func image_info_json() as string
	return x_clipboard_image_info_json()
end

export available
export last_error
export clear
export sequence_number
export count_formats
export formats
export types
export formats_json
export types_json
export format_name
export register_format
export is_format_available
