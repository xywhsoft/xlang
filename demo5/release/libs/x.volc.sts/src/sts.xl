import x.volc.core as core
import std.fmt as fmt
import std.json as json

const string STS_HOST = "sts.volcengineapi.com"
const string STS_SERVICE = "sts"
const string DEFAULT_REGION = "cn-north-1"
const string STS_VERSION = "2018-01-01"
const string FORM_CONTENT_TYPE = "application/x-www-form-urlencoded"

extern "atoi" func atoi(string text) as int

func last_error() as string
	return core.last_error()
end

func assume_role_spec(string spec) as string
	return core.request_sts_spec(spec)
end

func preview_assume_role_spec(string spec) as string
	return core.sign_preview_sts_spec(spec)
end

func assume_role_trn(string access_key, string secret_key, string role_trn, string role_session_name, int duration_seconds, int timeout_ms) as string
	auto spec = "access_key=" + access_key + "\nsecret_key=" + secret_key + "\nrole_trn=" + role_trn + "\nrole_session_name=" + role_session_name + "\nduration_seconds=" + fmt.int_text(duration_seconds, "") + "\ntimeout_ms=" + fmt.int_text(timeout_ms, "")
	return core.request_sts_spec(spec)
end

func assume_role(string access_key, string secret_key, string account_id, string role_name, string role_session_name, int duration_seconds, int timeout_ms) as string
	auto role_trn = "trn:iam::" + account_id + ":role/" + role_name
	return assume_role_trn(access_key, secret_key, role_trn, role_session_name, duration_seconds, timeout_ms)
end

func preview_assume_role(string access_key, string secret_key, string account_id, string role_name, string role_session_name, int duration_seconds, string x_date) as string
	auto role_trn = "trn:iam::" + account_id + ":role/" + role_name
	auto spec = "access_key=" + access_key + "\nsecret_key=" + secret_key + "\nrole_trn=" + role_trn + "\nrole_session_name=" + role_session_name + "\nduration_seconds=" + fmt.int_text(duration_seconds, "") + "\nx_date=" + x_date
	return core.sign_preview_sts_spec(spec)
end

func json_string_field(string raw, string key) as string
	auto pattern = "\"" + key + "\":\""
	auto start = raw.index_of(pattern)
	if start < 0 then
		pattern = "\"" + key + "\": \""
		start = raw.index_of(pattern)
	end
	if start < 0 then
		return ""
	end
	start = start + pattern.length
	auto rest = raw.slice(start, raw.length - start)
	auto end_pos = rest.index_of("\"")
	if end_pos < 0 then
		return ""
	end
	return rest.slice(0, end_pos)
end

func access_key_id(string assume_role_json) as string
	return json_string_field(assume_role_json, "AccessKeyId")
end

func secret_access_key(string assume_role_json) as string
	return json_string_field(assume_role_json, "SecretAccessKey")
end

func session_token(string assume_role_json) as string
	return json_string_field(assume_role_json, "SessionToken")
end

func expired_time(string assume_role_json) as string
	return json_string_field(assume_role_json, "ExpiredTime")
end

func current_time(string assume_role_json) as string
	return json_string_field(assume_role_json, "CurrentTime")
end

func credentials_json(string assume_role_json) as string
	return json.encode({
		"access_key": access_key_id(assume_role_json),
		"secret_key": secret_access_key(assume_role_json),
		"session_token": session_token(assume_role_json),
		"expired_time": expired_time(assume_role_json),
		"current_time": current_time(assume_role_json)
	})
end

func projection_credentials_json(string assume_role_json, string product_id, string pod_id) as string
	return json.encode({
		"access_key": access_key_id(assume_role_json),
		"secret_key": secret_access_key(assume_role_json),
		"session_token": session_token(assume_role_json),
		"expired_time": expired_time(assume_role_json),
		"current_time": current_time(assume_role_json),
		"product_id": product_id,
		"pod_id": pod_id
	})
end

export last_error
export assume_role_spec
export preview_assume_role_spec
export assume_role_trn
export assume_role
export preview_assume_role
export json_string_field
export access_key_id
export secret_access_key
export session_token
export expired_time
export current_time
export credentials_json
export projection_credentials_json
