import std.json

extern "xmail_mime_build_json_native" func xmail_mime_build_json_native(string message_json) as string
extern "xmail_mime_parse_json_native" func xmail_mime_parse_json_native(string raw_message) as string

func result(bool ok, string error, string stage, var data) as var
	return {
		"ok": ok,
		"error": error,
		"stage": stage,
		"status": "",
		"server_code": 0,
		"capabilities": [],
		"last_reply": "",
		"used_tls": false,
		"used_starttls": false,
		"data": data
	}
end

func unsupported(string operation) as var
	return result(false, "x.mail.mime." + operation + " native binding is not connected", "binding", {})
end

func address(string email, string name) as var
	return {"email": email, "name": name}
end

func attachment(string filename, string content_type, var content, string content_id, bool inline) as var
	return {
		"filename": filename,
		"content_type": content_type,
		"content": content,
		"content_id": content_id,
		"inline": inline
	}
end

func message(var fields) as var
	return fields
end

func build(var message_value) as var
	return json.decode(xmail_mime_build_json_native(json.encode(message_value)))
end

func parse(var raw_message) as var
	return json.decode(xmail_mime_parse_json_native(raw_message))
end

func build_json(string message_json) as string
	return xmail_mime_build_json_native(message_json)
end

func parse_json(string raw_message) as string
	return xmail_mime_parse_json_native(raw_message)
end

export result
export unsupported
export address
export attachment
export message
export build
export parse
export build_json
export parse_json
