func result(bool ok, string error, string stage, var data) as var
	return mime.result(ok, error, stage, data)
end

func unsupported(string operation) as var
	return result(false, "x.mail.imap." + operation + " native binding is not connected", "binding", {})
end

func capability(var request) as var
	return json.decode(xmail_imap_capability_json_native(json.encode(request)))
end

func status(var request) as var
	return json.decode(xmail_imap_status_json_native(json.encode(request)))
end

func list(var request) as var
	return json.decode(xmail_imap_list_json_native(json.encode(request)))
end

