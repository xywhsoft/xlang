import std.json
import x.mail.mime as mime

extern "xmail_imap_capability_json_native" func xmail_imap_capability_json_native(string request_json) as string
extern "xmail_imap_status_json_native" func xmail_imap_status_json_native(string request_json) as string
extern "xmail_imap_list_json_native" func xmail_imap_list_json_native(string request_json) as string
extern "xmail_imap_search_json_native" func xmail_imap_search_json_native(string request_json) as string
