end

func assemble_result2(string boxes_json, string rec0_json, string rec1_json) as string
	return rapidocr_assemble_result2_native(boxes_json, rec0_json, rec1_json, 0)
end

func assemble_result2(string boxes_json, string rec0_json, string rec1_json, float elapse) as string
	return rapidocr_assemble_result2_native(boxes_json, rec0_json, rec1_json, elapse)
end

func assemble_result4(string boxes_json, string rec0_json, string rec1_json, string rec2_json, string rec3_json) as string
	return rapidocr_assemble_result4_native(boxes_json, rec0_json, rec1_json, rec2_json, rec3_json, 0)
end

func assemble_result4(string boxes_json, string rec0_json, string rec1_json, string rec2_json, string rec3_json, float elapse) as string
	return rapidocr_assemble_result4_native(boxes_json, rec0_json, rec1_json, rec2_json, rec3_json, elapse)
end

func last_error() as string
	if cv2.available() == false then
		return cv2.last_error()
	end
	if ort.available() == false then
		return ort.last_error()
	end
	if rapidocr_available_native() == 0 then
		return ""
	end
	return rapidocr_last_error_native()
end

