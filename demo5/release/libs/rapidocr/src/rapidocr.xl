export const string EXAMPLE_CLS_MODEL = "release\\examples\\libs\\rapidocr\\models\\ch_ppocr_mobile_v2.0_cls_infer.onnx"
export const string EXAMPLE_REC_MODEL = "release\\examples\\libs\\rapidocr\\models\\ch_PP-OCRv4_rec_infer.onnx"
