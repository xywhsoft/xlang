class RapidOCROutput extends object
	nocopy
	var handle as point
	var json_text as string
	var text_value as string
	var boxes as string
	var txts as string
	var scores as string
	var word_results as string
	var elapse_list as string
	var elapse as float
	var source_path as string

	create(point handle)
		self.handle = handle
		self.json_text = ""
		self.text_value = ""
		self.boxes = rapidocr_output_boxes_native(handle)
		self.txts = rapidocr_output_txts_native(handle)
		self.scores = rapidocr_output_scores_native(handle)
		self.word_results = rapidocr_output_word_results_native(handle)
		self.elapse_list = rapidocr_output_elapse_list_native(handle)
		self.elapse = rapidocr_output_elapse_native(handle)
		self.source_path = ""
	end

	create(string json_text, string text_value, string boxes, string txts, string scores, string word_results, string elapse_list, float elapse)
		self.handle = null
		self.json_text = json_text
		self.text_value = text_value
		self.boxes = boxes
		self.txts = txts
		self.scores = scores
		self.word_results = word_results
		self.elapse_list = elapse_list
		self.elapse = elapse
		self.source_path = ""
	end

	create(string json_text, string text_value, string boxes, string txts, string scores, string word_results, string elapse_list, float elapse, string source_path)
		self.handle = null
		self.json_text = json_text
		self.text_value = text_value
		self.boxes = boxes
		self.txts = txts
		self.scores = scores
		self.word_results = word_results
		self.elapse_list = elapse_list
		self.elapse = elapse
		self.source_path = source_path
	end

	destroy()
		if self.handle != null then
			rapidocr_output_release_native(self.handle)
		end
	end

	func ok() as bool
		if self.handle == null then
			return self.json_text != ""
		end
		return rapidocr_output_ok_native(self.handle) != 0
	end

	func text() as string
		if self.handle == null then
			return self.text_value
		end
		return rapidocr_output_text_native(self.handle)
	end

	func to_json() as string
		if self.handle == null then
			return self.json_text
		end
		return rapidocr_output_json_native(self.handle)
	end

	func vis(string save_path) as bool
		if self.handle == null then
			if self.source_path == "" then
				return false
			end
			return rapidocr_vis_image_native(self.source_path, self.boxes, save_path) != 0
		end
		return rapidocr_output_vis_native(self.handle, save_path) != 0
	end
end

func rapidocr_run_xlang_pipeline(string img_path, bool use_det, bool use_cls, bool use_rec, string det_model_path, string cls_model_path, string rec_model_path, string keys_path, float det_threshold, int cls_img_w, int cls_img_h, int rec_img_w, int rec_img_h) as RapidOCROutput
	auto img = cv2.imread(img_path, cv2.IMREAD_COLOR)
	if img.empty() then
		return RapidOCROutput("", "", "[]", "[]", "[]", "[]", "[]", 0, "")
	end

	string boxes = "[]"
	if use_det then
		auto det_img = cv2.resize(img, 32, 32)
		auto det_tensor = ort.TensorFromOpenCV(det_img.handle, 0.0039215689, 0.485, 0.456, 0.406, 0.229, 0.224, 0.225)
		auto det_sess = ort.InferenceSession(det_model_path)
		auto det_result = det_sess.run_tensor("x", det_tensor, "[]")
		if det_result.ok() then
			boxes = det_boxes_from_output(det_result.to_json(), img.width(), img.height(), det_threshold)
		end
	end

	string cls = "{}"
	if use_cls then
		auto cls_img = cv2.resize(img, cls_img_w, cls_img_h)
		auto cls_tensor = ort.TensorFromOpenCV(cls_img.handle, 0.0039215689, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
		auto cls_sess = ort.InferenceSession(cls_model_path)
		auto cls_result = cls_sess.run_tensor("x", cls_tensor, "[]")
		if cls_result.ok() then
			cls = cls_decode_result(cls_result.handle)
		end
	end

	string rec = "{\"text\":\"\",\"score\":0,\"tokens\":0}"
	string rec2 = ""
	string rec3 = ""
	string rec4 = ""
	string txts = "[\"\"]"
	string scores = "[0]"
	if use_rec then
		int boxes_count = rapidocr_box_count_native(boxes)
		int box_x = rapidocr_first_box_x_native(boxes)
		int box_y = rapidocr_first_box_y_native(boxes)
		int box_w = rapidocr_first_box_width_native(boxes)
		int box_h = rapidocr_first_box_height_native(boxes)
		if box_w > 0 and box_h > 0 then
			auto crop_img = cv2.crop(img, box_x, box_y, box_w, box_h)
			if crop_img.empty() == false then
				if cls.contains("\"label\":\"180\"") then
					auto rotated_img = cv2.rotate180(crop_img)
					auto rec_img = cv2.resize(rotated_img, rec_img_w, rec_img_h)
					auto rec_tensor = ort.TensorFromOpenCV(rec_img.handle, 0.0039215689, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
					auto rec_sess = ort.InferenceSession(rec_model_path)
					auto rec_result = rec_sess.run_tensor("x", rec_tensor, "[]")
					if rec_result.ok() then
						rec = rec_decode_result(rec_result.handle, keys_path)
					end
				else
					auto rec_img = cv2.resize(crop_img, rec_img_w, rec_img_h)
					auto rec_tensor = ort.TensorFromOpenCV(rec_img.handle, 0.0039215689, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
					auto rec_sess = ort.InferenceSession(rec_model_path)
					auto rec_result = rec_sess.run_tensor("x", rec_tensor, "[]")
					if rec_result.ok() then
						rec = rec_decode_result(rec_result.handle, keys_path)
					end
				end
			end
		else
			if cls.contains("\"label\":\"180\"") then
				auto rotated_img = cv2.rotate180(img)
				auto rec_img = cv2.resize(rotated_img, rec_img_w, rec_img_h)
				auto rec_tensor = ort.TensorFromOpenCV(rec_img.handle, 0.0039215689, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
				auto rec_sess = ort.InferenceSession(rec_model_path)
				auto rec_result = rec_sess.run_tensor("x", rec_tensor, "[]")
				if rec_result.ok() then
					rec = rec_decode_result(rec_result.handle, keys_path)
				end
			else
				auto rec_img = cv2.resize(img, rec_img_w, rec_img_h)
				auto rec_tensor = ort.TensorFromOpenCV(rec_img.handle, 0.0039215689, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
				auto rec_sess = ort.InferenceSession(rec_model_path)
				auto rec_result = rec_sess.run_tensor("x", rec_tensor, "[]")
				if rec_result.ok() then
					rec = rec_decode_result(rec_result.handle, keys_path)
				end
			end
		end
		if boxes_count > 1 then
			int box2_x = rapidocr_box_x_native(boxes, 1)
			int box2_y = rapidocr_box_y_native(boxes, 1)
			int box2_w = rapidocr_box_width_native(boxes, 1)
			int box2_h = rapidocr_box_height_native(boxes, 1)
			if box2_w > 0 and box2_h > 0 then
				auto crop2_img = cv2.crop(img, box2_x, box2_y, box2_w, box2_h)
				if crop2_img.empty() == false then
					auto rec2_img = cv2.resize(crop2_img, rec_img_w, rec_img_h)
					auto rec2_tensor = ort.TensorFromOpenCV(rec2_img.handle, 0.0039215689, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
					auto rec2_sess = ort.InferenceSession(rec_model_path)
					auto rec2_result = rec2_sess.run_tensor("x", rec2_tensor, "[]")
					if rec2_result.ok() then
						rec2 = rec_decode_result(rec2_result.handle, keys_path)
					end
				end
			end
		end
		if boxes_count > 2 then
			int box3_x = rapidocr_box_x_native(boxes, 2)
			int box3_y = rapidocr_box_y_native(boxes, 2)
			int box3_w = rapidocr_box_width_native(boxes, 2)
			int box3_h = rapidocr_box_height_native(boxes, 2)
			if box3_w > 0 and box3_h > 0 then
				auto crop3_img = cv2.crop(img, box3_x, box3_y, box3_w, box3_h)
				if crop3_img.empty() == false then
					auto rec3_img = cv2.resize(crop3_img, rec_img_w, rec_img_h)
					auto rec3_tensor = ort.TensorFromOpenCV(rec3_img.handle, 0.0039215689, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
					auto rec3_sess = ort.InferenceSession(rec_model_path)
					auto rec3_result = rec3_sess.run_tensor("x", rec3_tensor, "[]")
					if rec3_result.ok() then
						rec3 = rec_decode_result(rec3_result.handle, keys_path)
					end
				end
			end
		end
		if boxes_count > 3 then
			int box4_x = rapidocr_box_x_native(boxes, 3)
			int box4_y = rapidocr_box_y_native(boxes, 3)
			int box4_w = rapidocr_box_width_native(boxes, 3)
			int box4_h = rapidocr_box_height_native(boxes, 3)
			if box4_w > 0 and box4_h > 0 then
				auto crop4_img = cv2.crop(img, box4_x, box4_y, box4_w, box4_h)
				if crop4_img.empty() == false then
					auto rec4_img = cv2.resize(crop4_img, rec_img_w, rec_img_h)
					auto rec4_tensor = ort.TensorFromOpenCV(rec4_img.handle, 0.0039215689, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
					auto rec4_sess = ort.InferenceSession(rec_model_path)
					auto rec4_result = rec4_sess.run_tensor("x", rec4_tensor, "[]")
					if rec4_result.ok() then
						rec4 = rec_decode_result(rec4_result.handle, keys_path)
					end
				end
			end
		end
	end

	string assembled = ""
	if rec4 != "" then
		assembled = assemble_result4(boxes, rec, rec2, rec3, rec4)
	elseif rec3 != "" then
		assembled = assemble_result4(boxes, rec, rec2, rec3, "")
	elseif rec2 != "" then
		assembled = assemble_result2(boxes, rec, rec2)
	else
		assembled = assemble_result(boxes, rec)
	end
	return RapidOCROutput(assembled, "", boxes, txts, scores, cls, "[]", 0, img_path)
end

class RapidOCREngine extends object
	nocopy
	var handle as point
	var config_path as string
	var det_model_path as string
	var cls_model_path as string
	var rec_model_path as string
	var keys_path as string
	var det_threshold as float
	var cls_img_w as int
	var cls_img_h as int
	var rec_img_w as int
	var rec_img_h as int

	create()
		self.config_path = ""
		self.det_model_path = EXAMPLE_DET_MODEL
		self.cls_model_path = EXAMPLE_CLS_MODEL
		self.rec_model_path = EXAMPLE_REC_MODEL
		self.keys_path = EXAMPLE_KEYS_PATH
		self.det_threshold = 0.3
		self.cls_img_w = 192
		self.cls_img_h = 48
		self.rec_img_w = 32
		self.rec_img_h = 48
		self.handle = rapidocr_create_native("")
	end

	create(string config_path)
		self.config_path = config_path
		self.det_model_path = EXAMPLE_DET_MODEL
		self.cls_model_path = EXAMPLE_CLS_MODEL
		self.rec_model_path = EXAMPLE_REC_MODEL
		self.keys_path = EXAMPLE_KEYS_PATH
		self.det_threshold = 0.3
		self.cls_img_w = 192
		self.cls_img_h = 48
		self.rec_img_w = 32
		self.rec_img_h = 48
		self.handle = rapidocr_create_native(config_path)
	end

	create(string det_model_path, string cls_model_path, string rec_model_path, string keys_path)
		self.config_path = ""
		self.det_model_path = det_model_path
		self.cls_model_path = cls_model_path
		self.rec_model_path = rec_model_path
		self.keys_path = keys_path
		self.det_threshold = 0.3
		self.cls_img_w = 192
		self.cls_img_h = 48
		self.rec_img_w = 32
		self.rec_img_h = 48
		self.handle = rapidocr_create_native("")
	end

	destroy()
		if self.handle != null then
			rapidocr_release_native(self.handle)
		end
	end

	func valid() as bool
		return self.handle != null
	end

	func set_det_threshold(float value) as bool
		if value <= 0 then
			return false
		end
		self.det_threshold = value
		return true
	end

	func set_cls_image_shape(int width, int height) as bool
		if width <= 0 or height <= 0 then
			return false
		end
		self.cls_img_w = width
		self.cls_img_h = height
		return true
	end

	func set_rec_image_shape(int width, int height) as bool
		if width <= 0 or height <= 0 then
			return false
		end
		self.rec_img_w = width
		self.rec_img_h = height
		return true
	end

	func op_call(string img) as RapidOCROutput
		if rapidocr_available_native() == 0 then
			return rapidocr_run_xlang_pipeline(img, true, true, true, self.det_model_path, self.cls_model_path, self.rec_model_path, self.keys_path, self.det_threshold, self.cls_img_w, self.cls_img_h, self.rec_img_w, self.rec_img_h)
		end
		return RapidOCROutput(rapidocr_call_native(self.handle, img, 1, 1, 1, 0))
	end

	func op_call(string img, bool use_det, bool use_cls, bool use_rec) as RapidOCROutput
		int det = 0
		int cls = 0
		int rec = 0
		if use_det then
			det = 1
		end
		if use_cls then
			cls = 1
		end
		if use_rec then
			rec = 1
		end
		if rapidocr_available_native() == 0 then
			return rapidocr_run_xlang_pipeline(img, use_det, use_cls, use_rec, self.det_model_path, self.cls_model_path, self.rec_model_path, self.keys_path, self.det_threshold, self.cls_img_w, self.cls_img_h, self.rec_img_w, self.rec_img_h)
		end
		return RapidOCROutput(rapidocr_call_native(self.handle, img, det, cls, rec, 0))
	end
end

func RapidOCR() as RapidOCREngine
	return RapidOCREngine()
end

func RapidOCR(string config_path) as RapidOCREngine
	return RapidOCREngine(config_path)
end

func RapidOCR(string det_model_path, string cls_model_path, string rec_model_path, string keys_path) as RapidOCREngine
	return RapidOCREngine(det_model_path, cls_model_path, rec_model_path, keys_path)
end

func available() as bool
	return cv2.available() and ort.available()
end

func backend() as string
	if rapidocr_available_native() == 0 then
		return "xlang-pipeline"
	end
	return rapidocr_backend_native()
end

func dependency_status() as string
	return "opencv=" + cv2.backend() + "; onnxruntime=" + ort.backend() + "; rapidocr=" + backend()
end

func default_model_dir() as string
	return DEFAULT_MODEL_DIR
end

func default_config_json() as string
	return "{\"model_dir\":\"models\",\"det_model_path\":\"models\\\\ch_PP-OCRv4_det_infer.onnx\",\"cls_model_path\":\"models\\\\ch_ppocr_mobile_v2.0_cls_infer.onnx\",\"rec_model_path\":\"models\\\\ch_PP-OCRv4_rec_infer.onnx\",\"keys_path\":\"models\\\\ppocr_keys_v1.txt\",\"use_det\":true,\"use_cls\":true,\"use_rec\":true,\"return_word_box\":false,\"det_limit_side_len\":960,\"rec_img_h\":48,\"rec_img_w\":320}"
end

func model_layout_json() as string
	return "{\"models\":[{\"name\":\"det\",\"path\":\"models\\\\ch_PP-OCRv4_det_infer.onnx\"},{\"name\":\"cls\",\"path\":\"models\\\\ch_ppocr_mobile_v2.0_cls_infer.onnx\"},{\"name\":\"rec\",\"path\":\"models\\\\ch_PP-OCRv4_rec_infer.onnx\"},{\"name\":\"keys\",\"path\":\"models\\\\ppocr_keys_v1.txt\"}]}"
end

