end

func box_width(string boxes_json, int index) as int
	return rapidocr_box_width_native(boxes_json, index)
end

func box_height(string boxes_json, int index) as int
	return rapidocr_box_height_native(boxes_json, index)
end

func vis_image(string source_path, string boxes_json, string save_path) as bool
	return rapidocr_vis_image_native(source_path, boxes_json, save_path) != 0
end

func assemble_result(string boxes_json, string rec_json) as string
	return rapidocr_assemble_result_native(boxes_json, rec_json, 0)
end

func assemble_result(string boxes_json, string rec_json, float elapse) as string
