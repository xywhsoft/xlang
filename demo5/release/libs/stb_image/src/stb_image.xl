extern "xstbi_version" func xstbi_version() as string
extern "xstbi_last_error" func xstbi_last_error() as string
extern "xstbi_load" func xstbi_load(string path, int desired_channels) as point
extern "xstbi_loadf" func xstbi_loadf(string path, int desired_channels) as point
extern "xstbi_is_hdr" func xstbi_is_hdr(string path) as int
extern "xstbi_info_json" func xstbi_info_json(string path) as string
extern "xstbi_image_valid" func xstbi_image_valid(point image) as int
extern "xstbi_image_width" func xstbi_image_width(point image) as int
extern "xstbi_image_height" func xstbi_image_height(point image) as int
extern "xstbi_image_channels" func xstbi_image_channels(point image) as int
extern "xstbi_image_data" func xstbi_image_data(point image) as point
extern "xstbi_image_is_float" func xstbi_image_is_float(point image) as int
extern "xstbi_image_release" func xstbi_image_release(point image) as int

func version() as string
	return xstbi_version()
end

func last_error() as string
	return xstbi_last_error()
end

func load(string path) as point
	return xstbi_load(path, 0)
end

func load(string path, int desired_channels) as point
	return xstbi_load(path, desired_channels)
end

func loadf(string path) as point
	return xstbi_loadf(path, 0)
end

func loadf(string path, int desired_channels) as point
	return xstbi_loadf(path, desired_channels)
end

func is_hdr(string path) as bool
	return xstbi_is_hdr(path) != 0
end

func info(string path) as string
	return xstbi_info_json(path)
end

func valid(point image) as bool
	return xstbi_image_valid(image) != 0
end

func width(point image) as int
	return xstbi_image_width(image)
end

func height(point image) as int
	return xstbi_image_height(image)
end

func channels(point image) as int
	return xstbi_image_channels(image)
end

func data(point image) as point
	return xstbi_image_data(image)
end

func is_float(point image) as bool
	return xstbi_image_is_float(image) != 0
end

func release(point image) as bool
	return xstbi_image_release(image) != 0
end

export version
export last_error
export load
export loadf
export is_hdr
export info
export valid
export width
export height
export channels
export data
export is_float
export release
