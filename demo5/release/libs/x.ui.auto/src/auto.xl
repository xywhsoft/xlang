import x.uia
import opencv as cv2

export const int DEFAULT_TIMEOUT_MS = 5000

extern "atoi" func parse_int(string text) as int

class Locator extends object
	var automation_id as string
	var class_name as string
	var name as string
	var control_type as int
	var process_id as int
	var root_hwnd as point
	var timeout_ms as int

	create()
		self.automation_id = ""
		self.class_name = ""
		self.name = ""
		self.control_type = 0
		self.process_id = 0
		self.root_hwnd = null
		self.timeout_ms = DEFAULT_TIMEOUT_MS
	end
end

func locator() as Locator
	return Locator()
end

func by_automation_id(string automation_id, int control_type) as Locator
	auto loc = Locator()
	loc.automation_id = automation_id
	loc.control_type = control_type
	return loc
end

func by_class_name(string class_name, string name, int control_type) as Locator
	auto loc = Locator()
	loc.class_name = class_name
	loc.name = name
	loc.control_type = control_type
	return loc
end

func by_name(string name, int control_type) as Locator
	auto loc = Locator()
	loc.name = name
	loc.control_type = control_type
	return loc
end

func by_control_type(int control_type) as Locator
	auto loc = Locator()
	loc.control_type = control_type
	return loc
end

func by_process_id(int process_id) as Locator
	auto loc = Locator()
	loc.process_id = process_id
	return loc
end

func within(Locator loc, point hwnd) as Locator
	loc.root_hwnd = hwnd
	return loc
end

func with_timeout(Locator loc, int timeout_ms) as Locator
	loc.timeout_ms = timeout_ms
	return loc
end

func locator_from_json(string json) as Locator
	auto loc = Locator()
	loc.automation_id = json_string(json, "automationId")
	loc.class_name = json_string(json, "className")
	loc.name = json_string(json, "name")
	loc.control_type = json_int(json, "controlType")
	loc.process_id = json_int(json, "processId")
	return loc
end

func wait_exists(Locator loc) as bool
	if loc.root_hwnd != null then
		auto root = x.uia.from_hwnd(loc.root_hwnd)
		if root.valid() == false then
			return false
		end
		return wait_exists_in_root(root, loc)
	end

	auto root = x.uia.desktop()
	if root.valid() == false then
		return false
	end
	return wait_exists_in_root(root, loc)
end

func click(Locator loc) as bool
	if loc.root_hwnd != null then
		auto root = x.uia.from_hwnd(loc.root_hwnd)
		if root.valid() == false then
			return false
		end
		return click_in_root(root, loc)
	end

	auto root = x.uia.desktop()
	if root.valid() == false then
		return false
	end
	return click_in_root(root, loc)
end

func type_text(Locator loc, string text) as bool
	if loc.root_hwnd != null then
		auto root = x.uia.from_hwnd(loc.root_hwnd)
		if root.valid() == false then
			return false
		end
		return type_text_in_root(root, loc, text)
	end

	auto root = x.uia.desktop()
	if root.valid() == false then
		return false
	end
	return type_text_in_root(root, loc, text)
end

func read(Locator loc) as string
	if loc.root_hwnd != null then
		auto root = x.uia.from_hwnd(loc.root_hwnd)
		if root.valid() == false then
			return ""
		end
		return read_in_root(root, loc)
	end

	auto root = x.uia.desktop()
	if root.valid() == false then
		return ""
	end
	return read_in_root(root, loc)
end

func screenshot(Locator loc, string path) as bool
	if loc.root_hwnd != null then
		auto root = x.uia.from_hwnd(loc.root_hwnd)
		if root.valid() == false then
			return false
		end
		return screenshot_in_root(root, loc, path)
	end

	auto root = x.uia.desktop()
	if root.valid() == false then
		return false
	end
	return screenshot_in_root(root, loc, path)
end

func focused_locator_json() as string
	return x.uia.focused_locator()
end

func json_string(string json, string key) as string
	auto pattern = "\"" + key + "\":\""
	auto start = json.index_of(pattern)
	if start < 0 then
		return ""
	end
	start = start + pattern.length
	auto rest = json.slice(start, json.length - start)
	auto end_pos = rest.index_of("\"")
	if end_pos < 0 then
		return ""
	end
	return rest.slice(0, end_pos)
end

func json_int(string json, string key) as int
	auto pattern = "\"" + key + "\":"
	auto start = json.index_of(pattern)
	if start < 0 then
		return 0
	end
	start = start + pattern.length
	auto rest = json.slice(start, json.length - start)
	return parse_int(rest)
end

func find_by_automation_id(Element root, Locator loc) as Element
	if loc.control_type > 0 then
		auto id_cond = x.uia.by_automation_id(loc.automation_id)
		auto type_cond = x.uia.by_control_type(loc.control_type)
		auto cond = x.uia.all_of(id_cond, type_cond)
		return root.find_first_scope(cond, 4, loc.timeout_ms)
	end
	auto cond = x.uia.by_automation_id(loc.automation_id)
	return root.find_first_scope(cond, 4, loc.timeout_ms)
end

func find_by_class_name(Element root, Locator loc) as Element
	auto class_cond = x.uia.by_class_name(loc.class_name)
	if loc.name != "" then
		auto name_cond = x.uia.by_name(loc.name)
		auto first = x.uia.all_of(class_cond, name_cond)
		if loc.control_type > 0 then
			auto type_cond = x.uia.by_control_type(loc.control_type)
			auto cond = x.uia.all_of(first, type_cond)
			return root.find_first_scope(cond, 4, loc.timeout_ms)
		end
		return root.find_first_scope(first, 4, loc.timeout_ms)
	end
	if loc.control_type > 0 then
		auto type_cond = x.uia.by_control_type(loc.control_type)
		auto cond = x.uia.all_of(class_cond, type_cond)
		return root.find_first_scope(cond, 4, loc.timeout_ms)
	end
	return root.find_first_scope(class_cond, 4, loc.timeout_ms)
end

func find_by_name(Element root, Locator loc) as Element
	if loc.control_type > 0 then
		auto name_cond = x.uia.by_name(loc.name)
		auto type_cond = x.uia.by_control_type(loc.control_type)
		auto cond = x.uia.all_of(name_cond, type_cond)
		return root.find_first_scope(cond, 4, loc.timeout_ms)
	end
	auto cond = x.uia.by_name(loc.name)
	return root.find_first_scope(cond, 4, loc.timeout_ms)
end

func find_by_control_type(Element root, Locator loc) as Element
	auto cond = x.uia.by_control_type(loc.control_type)
	return root.find_first_scope(cond, 4, loc.timeout_ms)
end

func find_by_process_id(Element root, Locator loc) as Element
	auto cond = x.uia.by_process_id(loc.process_id)
	return root.find_first_scope(cond, 4, loc.timeout_ms)
end

func find_in_root(Element root, Locator loc) as Element
	if loc.automation_id != "" then
		return find_by_automation_id(root, loc)
	end
	if loc.class_name != "" then
		return find_by_class_name(root, loc)
	end
	if loc.name != "" then
		return find_by_name(root, loc)
	end
	if loc.control_type > 0 then
		return find_by_control_type(root, loc)
	end
	if loc.process_id > 0 then
		return find_by_process_id(root, loc)
	end
	return x.uia.element(null)
end

func wait_exists_in_root(Element root, Locator loc) as bool
	auto element = find_in_root(root, loc)
	return element.valid()
end

func click_in_root(Element root, Locator loc) as bool
	auto element = find_in_root(root, loc)
	if element.valid() == false then
		return false
	end
	return element.click()
end

func type_text_in_root(Element root, Locator loc, string text) as bool
	auto element = find_in_root(root, loc)
	if element.valid() == false then
		return false
	end
	return element.set_value(text)
end

func read_in_root(Element root, Locator loc) as string
	auto element = find_in_root(root, loc)
	if element.valid() == false then
		return ""
	end
	return element.text()
end

func screenshot_in_root(Element root, Locator loc, string path) as bool
	auto element = find_in_root(root, loc)
	if element.valid() == false then
		return false
	end
	auto rect = element.rect_json()
	auto left = json_int(rect, "left")
	auto top = json_int(rect, "top")
	auto width = json_int(rect, "width")
	auto height = json_int(rect, "height")
	auto hwnd = element.hwnd()
	if hwnd != null then
		auto window_image = cv2.capture_window(hwnd)
		if window_image.empty() == false then
			return window_image.save(path)
		end
	end
	auto image = cv2.capture_rect(left, top, width, height)
	if image.empty() then
		return false
	end
	return image.save(path)
end

export DEFAULT_TIMEOUT_MS
export locator
export by_automation_id
export by_class_name
export by_name
export by_control_type
export by_process_id
export within
export with_timeout
export locator_from_json
export wait_exists
export click
export type_text
export read
export screenshot
export focused_locator_json
