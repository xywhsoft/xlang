import std.json
import x.mail.mime as mime

extern "xmail_smtp_capability_json_native" func xmail_smtp_capability_json_native(string config_json) as string
extern "xmail_smtp_send_json_native" func xmail_smtp_send_json_native(string request_json) as string

func result(bool ok, string error, string stage, var data) as var
	return mime.result(ok, error, stage, data)
end

func unsupported(string operation) as var
	return result(false, "x.mail.smtp." + operation + " native binding is not connected", "binding", {})
end

func capability(var config) as var
	return json.decode(xmail_smtp_capability_json_native(json.encode(config)))
end

func send(var request) as var
	return json.decode(xmail_smtp_send_json_native(json.encode(request)))
end

func capability_json(string config_json) as string
	return xmail_smtp_capability_json_native(config_json)
end

func send_json(string request_json) as string
	return xmail_smtp_send_json_native(request_json)
end

export result
export unsupported
export capability
export send
export capability_json
export send_json
