extern "xstbtt_version" func xstbtt_version() as string
extern "xstbtt_last_error" func xstbtt_last_error() as string
extern "xstbtt_load" func xstbtt_load(string path, int font_index) as point
extern "xstbtt_font_valid" func xstbtt_font_valid(point font) as int
extern "xstbtt_font_release" func xstbtt_font_release(point font) as int
extern "xstbtt_scale_for_pixel_height" func xstbtt_scale_for_pixel_height(point font, float pixel_height) as float
extern "xstbtt_ascent" func xstbtt_ascent(point font) as int
extern "xstbtt_descent" func xstbtt_descent(point font) as int
extern "xstbtt_line_gap" func xstbtt_line_gap(point font) as int
extern "xstbtt_find_glyph_index" func xstbtt_find_glyph_index(point font, int codepoint) as int
extern "xstbtt_h_advance" func xstbtt_h_advance(point font, int codepoint) as int
extern "xstbtt_left_bearing" func xstbtt_left_bearing(point font, int codepoint) as int
extern "xstbtt_kern_advance" func xstbtt_kern_advance(point font, int codepoint1, int codepoint2) as int
extern "xstbtt_vmetrics_json" func xstbtt_vmetrics_json(point font) as string
extern "xstbtt_hmetrics_json" func xstbtt_hmetrics_json(point font, int codepoint) as string
extern "xstbtt_codepoint_bitmap" func xstbtt_codepoint_bitmap(point font, int codepoint, float pixel_height) as point
extern "xstbtt_codepoint_bitmap_box_json" func xstbtt_codepoint_bitmap_box_json(point font, int codepoint, float pixel_height) as string
extern "xstbtt_bitmap_valid" func xstbtt_bitmap_valid(point bitmap) as int
extern "xstbtt_bitmap_width" func xstbtt_bitmap_width(point bitmap) as int
extern "xstbtt_bitmap_height" func xstbtt_bitmap_height(point bitmap) as int
extern "xstbtt_bitmap_xoff" func xstbtt_bitmap_xoff(point bitmap) as int
extern "xstbtt_bitmap_yoff" func xstbtt_bitmap_yoff(point bitmap) as int
extern "xstbtt_bitmap_data" func xstbtt_bitmap_data(point bitmap) as point
extern "xstbtt_bitmap_release" func xstbtt_bitmap_release(point bitmap) as int

func version() as string
	return xstbtt_version()
end

func last_error() as string
	return xstbtt_last_error()
end

func load(string path) as point
	return xstbtt_load(path, 0)
end

func load(string path, int font_index) as point
	return xstbtt_load(path, font_index)
end

func valid(point font) as bool
	return xstbtt_font_valid(font) != 0
end

func release(point font) as bool
	return xstbtt_font_release(font) != 0
end

func scale_for_pixel_height(point font, float pixel_height) as float
	return xstbtt_scale_for_pixel_height(font, pixel_height)
end

func ascent(point font) as int
	return xstbtt_ascent(font)
end

func descent(point font) as int
	return xstbtt_descent(font)
end

func line_gap(point font) as int
	return xstbtt_line_gap(font)
end

func find_glyph_index(point font, int codepoint) as int
	return xstbtt_find_glyph_index(font, codepoint)
end

func h_advance(point font, int codepoint) as int
	return xstbtt_h_advance(font, codepoint)
end

func left_bearing(point font, int codepoint) as int
	return xstbtt_left_bearing(font, codepoint)
end

func kern_advance(point font, int codepoint1, int codepoint2) as int
	return xstbtt_kern_advance(font, codepoint1, codepoint2)
end

func vmetrics(point font) as string
	return xstbtt_vmetrics_json(font)
end

func hmetrics(point font, int codepoint) as string
	return xstbtt_hmetrics_json(font, codepoint)
end

func codepoint_bitmap(point font, int codepoint, float pixel_height) as point
	return xstbtt_codepoint_bitmap(font, codepoint, pixel_height)
end

func codepoint_bitmap_box(point font, int codepoint, float pixel_height) as string
	return xstbtt_codepoint_bitmap_box_json(font, codepoint, pixel_height)
end

func bitmap_valid(point bitmap) as bool
	return xstbtt_bitmap_valid(bitmap) != 0
end

func bitmap_width(point bitmap) as int
	return xstbtt_bitmap_width(bitmap)
end

func bitmap_height(point bitmap) as int
	return xstbtt_bitmap_height(bitmap)
end

func bitmap_xoff(point bitmap) as int
	return xstbtt_bitmap_xoff(bitmap)
end

func bitmap_yoff(point bitmap) as int
	return xstbtt_bitmap_yoff(bitmap)
end

func bitmap_data(point bitmap) as point
	return xstbtt_bitmap_data(bitmap)
end

func bitmap_release(point bitmap) as bool
	return xstbtt_bitmap_release(bitmap) != 0
end

export version
export last_error
export load
export valid
export release
export scale_for_pixel_height
export ascent
export descent
export line_gap
export find_glyph_index
export h_advance
export left_bearing
export kern_advance
export vmetrics
export hmetrics
export codepoint_bitmap
export codepoint_bitmap_box
export bitmap_valid
export bitmap_width
export bitmap_height
export bitmap_xoff
export bitmap_yoff
export bitmap_data
export bitmap_release
