extern "xzstd_version" func xzstd_version() as string
extern "xzstd_last_error" func xzstd_last_error() as string
extern "xzstd_compress_hex" func xzstd_compress_hex(string text) as string
extern "xzstd_compress_hex_level" func xzstd_compress_hex_level(string text, int level) as string
extern "xzstd_decompress_hex" func xzstd_decompress_hex(string hex_text) as string
extern "xzstd_compress_file" func xzstd_compress_file(string input_path, string output_path) as int
extern "xzstd_compress_file_level" func xzstd_compress_file_level(string input_path, string output_path, int level) as int
extern "xzstd_decompress_file" func xzstd_decompress_file(string input_path, string output_path) as int

func version() as string
	return xzstd_version()
end

func last_error() as string
	return xzstd_last_error()
end

func compress_hex(string text) as string
	return xzstd_compress_hex(text)
end

func compress_hex_level(string text, int level) as string
	return xzstd_compress_hex_level(text, level)
end

func decompress_hex(string hex_text) as string
	return xzstd_decompress_hex(hex_text)
end

func compress_file(string input_path, string output_path) as bool
	return xzstd_compress_file(input_path, output_path) != 0
end

func compress_file_level(string input_path, string output_path, int level) as bool
	return xzstd_compress_file_level(input_path, output_path, level) != 0
end

func decompress_file(string input_path, string output_path) as bool
	return xzstd_decompress_file(input_path, output_path) != 0
end

export version
export last_error
export compress_hex
export compress_hex_level
export decompress_hex
export compress_file
export compress_file_level
export decompress_file
