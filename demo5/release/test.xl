


/*
	这是 xlang 的综合范例文件，展示 xlang 支持的各种写法

	运行本范例使用：xl run test.xl
	编译本范例使用：xl build test.xl

	实现边界记录：
	- class/custom/typedef/命名函数/generator 必须放模块作用域。
	- 当前 release 的 class 内 union 示例会在 TCC 阶段报 struct or union expected，
	  因此 union 写法保留在注释中，不进入 smoke test。
	- lexer 里有 INT_OCT 规则，但当前生成链会把 &o10 降成 & o10；可运行部分用 8。
	- main 保持同步入口；async func + await 写法在 async_add 中覆盖。
*/



/*
	xLang 原生基础数据类型：
		bool				逻辑类型
		int					相当于 int64
		int8				字节
		uint8				无符号字节
		int16				短整数
		uint16				无符号短整数
		int32				整数
		uint32				无符号整数
		int64				长整数
		uint64				无符号长整数
		float				相当于 float64
		float32				单精度浮点数
		float64				双精度浮点数
		string				字符串
		time				时间
		point				指针
		var					变体类型
	
	xLang 原生容器类型：
		array				数组
		list				列表
		dict				字典
		set					集合
	
	特殊“数据类型”：
		void				用来表示无返回值函数
		null				是 xLang 内置值，也是 null 数据类型的唯一值（null 不可以作为类型声明标识符）
		auto				自动推导数据类型标识符
		type				表示类型的类型
	
	xLang 内置扩展数据类型：
		range				表示范围的类型
*/



// 导入内置标准库 - 这里列出了所有可以导入的标准库
import std.core					// 核心库
import std.io					// Input/output
import std.math					// 数学库
import std.str					// 字符串操作
import std.array				// 数组操作
import std.list					// 列表操作
import std.dict					// 字典操作
import std.set					// 集合操作
import std.iter					// 迭代器
import std.json					// JSON
import std.regex				// 正则表达式
import std.fs					// 文件系统
import std.dir					// 目录操作
import std.path					// 路径操作
import std.env					// 环境变量
import std.os					// 操作系统库
import std.host					// 主机信息
import std.time					// 时间库
import std.clock				// 时钟
import std.fmt					// 格式化
import std.hash					// 哈希库
import std.crypto				// 加密算法库
import std.encode				// 编码解码库
import std.log					// 日志库
import std.assert				// 断言库
import std.error				// 错误处理库
import std.atomic				// 原子操作库
import std.sync					// 同步库
import std.thread				// 线程库
import std.future				// 任务结果
import std.task					// 任务
import std.channel				// 通道
import std.module				// 模块反射
import std.object				// 对象反射
// import std.types				// 类型反射 - 当前 smoke 未使用
import std.rand					// 随机数
import std.pack					// 数据打包解包
import std.process				// 进程库
import std.range				// 范围
import std.query				// URL解析
import std.template				// 模板
// import std.debug				// 调试 - 仅 xldbg 可用
// import std.trace				// 跟踪 - 仅 xldbg 可用
import std.net					// 网络
import std.net.tcp as tcp		// TCP网络
import std.net.udp as udp		// UDP网络
import std.net.dns				// DNS
import std.net.ip				// IP地址
import std.net.url				// URL解析
import std.net.tls				// TLS 1.3 和 TLS 1.2
import std.net.proxy			// 代理
import std.net.ws				// WebSocket
import std.net.http				// HTTP协议
import std.net.httpd			// HTTP服务器
import std.net.multipart		// Multipart 表单
import std.net.mime				// MIME 类型
import std.sys.env				// 系统环境变量
import std.sys.file				// 系统文件库
import std.sys.lib				// 系统动态库
import std.sys.mem				// 系统内存库
import std.sys.net				// 系统网络库
import std.sys.process			// 系统进程库
import std.sys.wait				// 系统等待库



// 导入外部库
#link shell32



// 声明外部函数
extern "ShellAboutA" func shell_about(point hwnd, string app, string other, point icon) as int
extern "ShellExecuteA" func shell_exec(point hwnd, string op, string file, string params, string dir, int show) as int



typedef Text = string
typedef IntArray = array<int>
typedef IntList = list<int>
typedef IntDict = dict<int>
typedef IntFunc = function<int(int)>

class SampleBox extends object
	var value as int
	var name as string = "box"

	create()
		self.value = 0
	end

	create(int value)
		self.value = value
	end

	func copy() as SampleBox
		auto next = SampleBox(self.value)
		next.name = self.name
		return next
	end

	destroy()
	end

	func add(int delta) as int
		self.value += delta
		return self.value
	end

	get doubled() as int
		return self.value * 2
	end

	let doubled(int next)
		self.value = next / 2
	end

	func op_add(SampleBox rhs) as SampleBox
		return SampleBox(self.value + rhs.value)
	end

	func op_eq(SampleBox rhs) as bool
		return self.value == rhs.value
	end

	func op_neg() as SampleBox
		return SampleBox(0 - self.value)
	end
end

/*
union 写法示例：

class UnionBox extends object
	union Slot
		var left as int
		var right as int
	end
end

custom 写法通常要配合 native payload：

custom NativeLike extends object
	extern "native_create" create(int value)
	extern "native_release" destroy()
end
*/

func check(bool ok, string message) as void
	if ok == false then
		throw Error(message)
	end
end

func identity<T>(T value) as T
	return value
end

func inc(int value) as int
	return value + 1
end

func mix(int a, int b = 2, int c = 3) as int
	return (a * 100) + (b * 10) + c
end

func pair() as int, string
	return 40, "2"
end

func join_pair(int left, string right) as int
	if right == "2" then
		return left + 2
	end
	return 0
end

func count_args(int seed, ...) as int
	return seed + arg.length
end

func count_named(int seed, ***) as int
	return seed + arg.length
end

func numbers(int stop) as int
	int current = 0
	while current < stop do
		current += 1
		yield current
	end
end

async func async_add(int left, int right) as int
	return await task.delay(left + right)
end

func test_loops() as void
	int loop_sum = 0
	int n = 0
	int do_count = 0
	int range_sum = 0
	int jump_score = 0

	while n < 5 do
		n += 1
		if n == 2 then
			continue
		end
		if n == 5 then
			break
		end
		loop_sum += n
	end

	do
		do_count += 1
	while do_count < 2
	end

	for index, value in range(2, 10, 2)
		if index == 1 then
			continue
		end
		range_sum += value
	end

	while jump_score < 1 do
		while true do
			jump_score = 9
			break 2
		end
	end

	check(loop_sum == 8 and do_count == 2 and range_sum == 16 and jump_score == 9, "loops")
end

func test_object() as void
	auto box = SampleBox(10)

	check(box.value == 10, "class create/field")
end

func main() as int
	// 先声明本脚本要用的局部变量。当前 TCC/codegen 对“语句后再声明变量”较敏感，
	// 因此综合测试把局部声明集中放在 main 开头。
	bool b = true
	int i = 1234
	int8 int8_value = 12
	uint8 uint8_value = 34
	int16 i16 = 123
	uint16 u16 = 456
	int32 i32 = 1000
	uint32 u32 = 2000
	int64 i64 = 3000
	uint64 u64 = 4000
	int f = 3
	int f32 = 1
	int f64 = 2
	string s = "hello" + " " + "xlang"
	time t = #2026-04-30 12:34:56#
	point p = null
	var any = "var can hold string"
	auto inferred = 41
	Text alias_text = Text(inferred)
	int dec = 10
	int hex = 0x10
	int oct = 8
	int bin = 0b10
	int arithmetic = dec + hex - oct * bin / 2 + 3 % 2
	int bitwise = (0b1010 & 0b0110) | 0b0001
	int shifted = (1 << 4) >> 1
	int powered = 2 ** 3
	bool logic = (arithmetic > 0 and bitwise == 0b0011) or false
	string path = "C:\\tmp\\xlang"
	string templated = `he"llo`
	auto trimmed = "AbC-beta"
	auto pieces = ["red", "green", "blue"]
	array nums = [1, 2, 3]
	IntArray typed_nums = array<int>{4, 5, 6}
	list words = list{"a", "b"}
	IntList typed_list = list<int>{7, 8}
	dict pairs_map = {"left": 10, "right": 20}
	IntDict typed_dict = dict<int>{"answer": 42}
	set flags = {2, 4, 6}
	auto sparse = [1: 100, 3: 300]
	auto empty_dict = {}
	var default_var = null
	int acc = 2
	var maybe = null
	int branch = 0
	string coalesced = ""
	int ternary_value = 0
	int base = 40
	auto add = func(int x) as int => base + x
	auto pair_func = func() as int, string
		return 42, "ok"
	end
	auto pv, pt = pair_func()
	IntFunc typed_func = inc
	auto spread_values = [8, 9]
	auto named_values = {"first": 1, "second": 2}
	error current = null
	string missing = current?.message ?? "missing"
	int protected_value = 0
	int generated = 0
	int awaited = 42
	int delayed = 1
	time print_time = #2026-04-30 12:34:56#
	// const 可以声明只读局部值；这里同时覆盖带类型 const、自动推导 const。
	const int const_answer = 42
	const const_label = "const"
	bool asserted_flag = true
	// 单目正负号、幂运算和乘加优先级组合在一起，便于作为表达式优先级范例。
	int unary_value = +5 + -2
	int precedence_score = 1 + 2 * 3 ** 2
	bool compare_combo = (5 >= 5) and (4 <= 6) and (5 != 6) and (5 == 5)
	// 不复用前面的容器，避免追加示例影响已经存在的检查。
	array extra_array = [10, 20]
	list extra_list = list{"left", "right"}
	dict extra_dict = {"name": "xlang"}
	set extra_set = {"alpha", "beta"}
	bool set_contains_alpha = false
	bool set_contains_gamma = false
	bool removed_beta = false
	bool dict_has_name = false
	bool dict_removed_name = false
	string extra_joined = ""
	// 标准库调用既可以写成 module.func，也能和普通表达式一样参与断言。
	int math_abs_value = std.math.abs(-7)
	int math_max_value = std.math.max(3, 9)
	string str_upper = std.str.upper("xlang")
	string str_replaced = std.str.replace("2026-04-30", "-", "/")
	bool str_starts = std.str.starts_with(str_upper, "XL")
	string fmt_bool = std.fmt.bool_text(true)
	string fmt_int = std.fmt.int_text(255, "")
	// 字符串既可以通过 std.str.func(text, ...) 调用，也可以用 text.func(...) 的方法风格调用。
	string method_source = "  AbC-beta  "
	string method_trimmed = method_source.trim()
	string method_lower = method_trimmed.lower()
	string method_replaced = method_trimmed.replace("beta", "demo")
	list method_parts = "a,b,c".split(",")
	// 这些标准库函数纯计算、无外部副作用，适合作为稳定的烟测示例。
	string encoded_hex = std.encode.hex_encode("Hi")
	string decoded_hex = std.encode.hex_decode(encoded_hex)
	string json_text = std.json.encode({"name": "xlang", "ok": true})
	var json_value = std.json.decode(json_text)
	string json_round = std.json.encode(json_value)
	string joined_path = std.path.join("C:\\tmp", "xlang.txt")
	string path_name_ext = std.path.name_ext(joined_path)
	bool path_abs = std.path.is_abs(joined_path)
	auto hash32_a = std.hash.hash32("hello")
	auto hash32_b = std.hash.hash32("hello")
	string sha256_hello = std.hash.sha256("hello")
	// lambda 表达式有独立的表达式解析分支，也要覆盖普通表达式支持的单目运算符。
	auto lambda_unary = func(int x) as int => +x + -x
	// ~= 是近似匹配/近似相等：数值按误差比较，字符串支持简单通配，time 支持相近时间判断。
	float approx_left = 3.5
	float approx_right = 3.5000001
	time approx_time_a = time.parse("2024-01-02 03:04:05")
	time approx_time_b = time.parse("2024-01-02 03:04:06")
	// ?[] 是安全索引；正常容器等价于 []，空容器引用时应返回 null，再配合 ?? 给默认值。
	array safe_index_values = [11, 22, 33]
	array safe_index_null = null
	int safe_index_hit = safe_index_values?[1]
	int safe_index_default = safe_index_null?[0] ?? 99

	check(b and i == 1234 and int8_value > 0 and uint8_value > 0 and i16 > 0 and u16 > 0, "basic integers")
	check(i32 + u32 + i64 + u64 > 0 and f > 0 and f32 > 0 and f64 > 0, "numeric families")
	check(s == "hello xlang", "string")
	check(p == null and alias_text == "41", "point/typedef")
	check(hex == 16 and oct == 8 and bin == 2, "base-prefixed integer literals")
	check(arithmetic == 19 and bitwise == 3 and shifted == 8 and powered == 8 and logic, "operators")
	check(not false and !false, "unary boolean negation")

	check(templated == "he\"llo", "template string")
	std.core.println(path)
	std.core.println(trimmed)

	check(nums.length == 3 and nums[0] == 1, "array")
	check(typed_nums[2] == 6 and typed_list[1] == 8, "generic containers")
	check(words.join("") == "ab", "list join")
	check(pairs_map["right"] == 20 and typed_dict["answer"] == 42, "dict index")
	std.core.println(flags.length)
	check(sparse[3] == 300 and empty_dict.length == 0, "sparse and empty")
	nums.append(4)
	nums[0] = 9
	nums.remove(1)
	check(nums.length == 3 and nums[0] == 9 and nums[1] == 3, "array mutation")

	acc += 3
	acc -= 1
	acc *= 4
	acc /= 2
	acc %= 5
	acc **= 3
	maybe ?= 77
	maybe ?= 88
	check(join_pair(40, "2") == 42 and acc == 27, "assignment and null")

	if acc < 0 then
		branch = 1
	elseif acc == 27 then
		branch = 2
	else
		branch = 3
	end
	if branch == 2 then branch += 10 else branch = 0
	coalesced = null ?? "fallback"
	ternary_value = branch == 12 ? 100 : 0
	check(branch == 12 and coalesced == "fallback" and ternary_value == 100, "branching")

	// assert 是运行期断言语句；失败时会抛出带消息的错误，成功时继续向下执行。
	assert asserted_flag, "assert statement"
	check(const_answer == 42 and const_label == "const" and unary_value == 3, "const and unary")
	check(precedence_score == 19 and compare_combo, "precedence and comparison")

	// 容器方法可以直接链在容器变量上；in 适合写集合包含关系，has/remove 更适合需要布尔结果的场景。
	extra_array.append(30)
	extra_list.append("center")
	extra_dict["kind"] = "demo"
	set_contains_alpha = extra_set.has("alpha")
	set_contains_gamma = "gamma" in extra_set
	removed_beta = extra_set.remove("beta")
	dict_has_name = extra_dict.has("name")
	dict_removed_name = extra_dict.remove("name")
	extra_joined = extra_list.join("|")
	check(extra_array.length == 3 and extra_array[2] == 30 and extra_joined == "left|right|center", "extra containers")
	check(set_contains_alpha and not set_contains_gamma and removed_beta and extra_set.length == 1, "set methods and in")
	check(dict_has_name and dict_removed_name and extra_dict["kind"] == "demo", "dict methods")

	// 常用标准库函数：数学、字符串、格式化。fmt.int_text 的第二个参数是格式模式，空串表示默认格式。
	check(math_abs_value == 7 and math_max_value == 9, "std.math")
	check(str_upper == "XLANG" and str_replaced == "2026/04/30" and str_starts, "std.str")
	check(fmt_bool == "true" and fmt_int == "255", "std.fmt")
	check(method_trimmed == "AbC-beta" and method_lower == "abc-beta" and method_replaced == "AbC-demo", "string method calls")
	check(method_parts.length == 3 and method_parts[1] == "b", "string split")
	check(encoded_hex == "4869" and decoded_hex == "Hi", "std.encode")
	check(json_round.contains("\"name\":\"xlang\"") and json_round.contains("\"ok\":true"), "std.json")
	check(path_abs and path_name_ext == "xlang.txt", "std.path")
	check(hash32_a == hash32_b and sha256_hello == "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824", "std.hash")
	check(lambda_unary(123) == 0, "lambda unary")
	check(approx_left ~= approx_right and "hello" ~= "h*o" and approx_time_a ~= approx_time_b, "approx operator")
	check(safe_index_hit == 22 and safe_index_default == 99, "safe index")

	test_loops()

	std.core.println("function value declared")
	check(pv == 42 and pt == "ok", "anonymous multi return")
	check(mix(1, c = 9) == 129, "default plus named argument")
	check(count_args(20, ...spread_values) == 22, "... spread")
	check(count_named(20, ***named_values) == 22, "*** spread")
	check(identity<string>("ok") == "ok" and identity<int>(123) == 123, "generics")
	check(int(3.14) == 3 and float64("2.5") > 2.4 and bool("ok"), "builtin constructors")

	test_object()

	check(missing == "missing" and current?.code == 0, "safe null")
	current = Error("disk", code = 7, cause = Error("inner", code = 2))
	check(current?.message == "disk" and current?.cause?.message == "inner", "safe chain")

	try
		throw Error("planned", code = 100)
	catch e
		if e.code == 100 then
			protected_value = 1
		end
	finally
		protected_value += 1
	end
	check(protected_value == 2, "try/catch/finally")

	for value in numbers(4)
		generated += value
	end
	check(generated == 10, "generator yield")
	check(awaited == 42 and delayed == 1, "async declaration covered")

	std.core.println("xlang demo5 release/test.xl smoke ok")
	std.core.println(42)
	std.core.println(string(print_time))

	return 0
end
