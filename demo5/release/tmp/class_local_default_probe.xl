var int total = 0

class LocalDefaultBox extends object
	var value as int

	create()
		self.value = 17
		total = total + 1
	end

	destroy()
		total = total + self.value
	end
end

func make() as int
	LocalDefaultBox box
	return box.value
end

func main() as int
	int value = make()
	return value + total
end
