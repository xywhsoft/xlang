import stb_truetype as stbtt

func main() as int
	var font = stbtt.load("C:\\Windows\\Fonts\\arial.ttf")
	if stbtt.valid(font) == false then
		return 1
	end

	if stbtt.find_glyph_index(font, 65) <= 0 then
		stbtt.release(font)
		return 2
	end

	var bitmap = stbtt.codepoint_bitmap(font, 65, 32.0)
	if stbtt.bitmap_valid(bitmap) == false then
		stbtt.release(font)
		return 3
	end
	if stbtt.bitmap_width(bitmap) <= 0 then
		stbtt.bitmap_release(bitmap)
		stbtt.release(font)
		return 4
	end
	if stbtt.bitmap_height(bitmap) <= 0 then
		stbtt.bitmap_release(bitmap)
		stbtt.release(font)
		return 5
	end

	stbtt.bitmap_release(bitmap)
	stbtt.release(font)
	return 42
end
