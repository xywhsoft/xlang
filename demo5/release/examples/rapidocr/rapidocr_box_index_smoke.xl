import rapidocr

func main() as int
	string boxes = "[{\"box\":[[10,2],[20,2],[20,9],[10,9]],\"score\":1},{\"box\":[[30,5],[50,5],[50,18],[30,18]],\"score\":1}]"
	if rapidocr.box_count(boxes) != 2 then
		return 1
	end
	if rapidocr.box_x(boxes, 0) != 10 then
		return 2
	end
	if rapidocr.box_y(boxes, 0) != 2 then
		return 3
	end
	if rapidocr.box_width(boxes, 1) != 20 then
		return 4
	end
	if rapidocr.box_height(boxes, 1) != 13 then
		return 5
	end
	return 42
end
