import rapidocr

func main() as int
	string boxes = "[{\"box\":[[0,0],[10,0],[10,10],[0,10]],\"score\":1},{\"box\":[[20,0],[30,0],[30,10],[20,10]],\"score\":1}]"
	string rec0 = "{\"text\":\"a\",\"score\":0.9,\"tokens\":1}"
	string rec1 = "{\"text\":\"b\",\"score\":0.8,\"tokens\":1}"
	auto out = rapidocr.assemble_result2(boxes, rec0, rec1)
	if out.contains("\"txts\":[\"a\",\"b\"]") == false then
		return 1
	end
	if out.contains("\"scores\":[0.9,0.8]") == false then
		return 2
	end
	return 42
end
