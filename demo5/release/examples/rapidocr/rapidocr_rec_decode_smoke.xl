import rapidocr

func main() as int
	auto output = "{\"outputs\":{\"softmax\":{\"dtype\":\"float32\",\"shape\":[1,2,3],\"data\":[0.1,0.8,0.1,0.7,0.2,0.1]}}}"
	auto decoded = rapidocr.rec_decode(output, "release\\examples\\libs\\rapidocr\\models\\ppocr_keys_v1.txt")
	if decoded.contains("\"text\"") == false then
		return 1
	end
	if decoded.contains("\"tokens\":1") == false then
		return 2
	end
	return 42
end
