import rapidocr

func main() as int
	auto output = "{\"outputs\":{\"out\":{\"dtype\":\"float32\",\"shape\":[1,1,4,6],\"data\":[0,0,0,0,0,0,0,0.9,0.8,0,0,0,0,0,0,0,0.85,0.8,0,0,0,0,0,0]}}}"
	auto boxes = rapidocr.det_boxes_from_output(output, 120, 40, 0.3)
	if rapidocr.box_count(boxes) != 2 then
		return 1
	end
	if rapidocr.box_width(boxes, 0) <= 0 then
		return 2
	end
	if rapidocr.box_width(boxes, 1) <= 0 then
		return 3
	end
	return 42
end
