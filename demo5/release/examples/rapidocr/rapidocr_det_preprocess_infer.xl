import opencv as cv2
import onnxruntime as ort
import rapidocr

func main() as int
	if cv2.available() == false then
		return 1
	end
	if ort.available() == false then
		return 2
	end

	auto img = cv2.imread("release\\examples\\rapidocr\\sample.png", cv2.IMREAD_COLOR)
	if img.empty() then
		return 3
	end

	auto resized = cv2.resize(img, 32, 32)
	auto tensor = cv2.toCHWTensorJson(resized, 0.0039215689, 0.485, 0.456, 0.406, 0.229, 0.224, 0.225)
	if tensor.contains("\"shape\":[1,3,32,32]") == false then
		return 4
	end

	auto sess = ort.InferenceSession("release\\examples\\libs\\rapidocr\\models\\ch_PP-OCRv4_det_infer.onnx")
	if sess.valid() == false then
		return 5
	end

	auto result = sess.run("[]", "{\"x\":" + tensor + "}")
	if result.ok() == false then
		return 6
	end

	auto output = result.to_json()
	if output.contains("\"dtype\":\"float32\"") == false then
		return 7
	end

	auto boxes = rapidocr.det_boxes_from_output(output, img.width(), img.height(), 0.3)
	if boxes.contains("\"box\"") == false then
		return 8
	end
	if boxes.contains("\"score\"") == false then
		return 9
	end

	return 42
end
