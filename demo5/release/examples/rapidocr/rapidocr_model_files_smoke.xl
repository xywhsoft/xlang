import onnxruntime as ort
import rapidocr

func main() as int
	if ort.available() == false then
		return 1
	end

	auto model_dir = "release\\examples\\libs\\rapidocr\\models\\"

	auto det = ort.InferenceSession(model_dir + "ch_PP-OCRv4_det_infer.onnx")
	if det.valid() == false then
		return 2
	end
	if det.get_inputs().contains("x") == false then
		return 3
	end

	auto cls = ort.InferenceSession(model_dir + "ch_ppocr_mobile_v2.0_cls_infer.onnx")
	if cls.valid() == false then
		return 4
	end

	auto rec = ort.InferenceSession(model_dir + "ch_PP-OCRv4_rec_infer.onnx")
	if rec.valid() == false then
		return 5
	end
	if rec.get_outputs().contains("softmax") == false then
		return 6
	end

	return 42
end
