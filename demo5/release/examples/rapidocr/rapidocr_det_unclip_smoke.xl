import rapidocr

func main() as int
	auto output = "{\"outputs\":{\"out\":{\"dtype\":\"float32\",\"shape\":[1,1,4,5],\"data\":[0,0,0,0,0,0,0.8,0.9,0,0,0,0.7,0.95,0,0,0,0,0,0,0]}}}"
	auto boxes = rapidocr.det_boxes_from_output(output, 100, 40, 0.3)
	if rapidocr.box_x(boxes, 0) >= 20 then
		return 1
	end
	if rapidocr.box_y(boxes, 0) >= 10 then
		return 2
	end
	if rapidocr.box_width(boxes, 0) <= 40 then
		return 3
	end
	if rapidocr.box_height(boxes, 0) <= 20 then
		return 4
	end
	return 42
end
