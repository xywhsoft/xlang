import rapidocr

func main() as int
	auto engine = rapidocr.RapidOCR()
	if engine.valid() == false then
		return 1
	end

	int i = 0
	while i < 50 do
		auto result = engine("release\\examples\\rapidocr\\sample.png")
		if rapidocr.available() == false then
			if result.txts != "[]" then
				return 2
			end
		else
			if result.ok() == false then
				return 3
			end
		end
		i = i + 1
	end

	return 42
end
