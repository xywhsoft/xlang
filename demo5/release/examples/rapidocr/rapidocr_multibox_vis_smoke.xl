import opencv as cv2
import rapidocr

func main() as int
	string boxes = "[{\"box\":[[0,0],[12,0],[12,12],[0,12]],\"score\":1},{\"box\":[[20,5],[38,5],[38,20],[20,20]],\"score\":1}]"
	string out_path = "release\\examples\\rapidocr\\rapidocr_multibox_vis_smoke.png"
	if rapidocr.vis_image("release\\examples\\rapidocr\\sample.png", boxes, out_path) == false then
		return 1
	end
	auto img = cv2.imread(out_path, cv2.IMREAD_COLOR)
	if img.empty() then
		return 2
	end
	return 42
end
