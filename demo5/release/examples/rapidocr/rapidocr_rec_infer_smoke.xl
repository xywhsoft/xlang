import opencv as cv2
import onnxruntime as ort
import rapidocr

func main() as int
	if cv2.available() == false then
		return 1
	end
	if ort.available() == false then
		return 2
	end

	auto img = cv2.imread("release\\examples\\rapidocr\\sample.png", cv2.IMREAD_COLOR)
	if img.empty() then
		return 3
	end

	auto resized = cv2.resize(img, 32, 48)
	auto tensor = ort.TensorFromOpenCV(resized.handle, 0.0039215689, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
	if tensor.valid() == false then
		return 4
	end

	auto sess = ort.InferenceSession("release\\examples\\libs\\rapidocr\\models\\ch_PP-OCRv4_rec_infer.onnx")
	if sess.valid() == false then
		return 5
	end

	auto result = sess.run_tensor("x", tensor, "[]")
	if result.ok() == false then
		return 6
	end

	auto decoded = rapidocr.rec_decode_result(result.handle, "release\\examples\\libs\\rapidocr\\models\\ppocr_keys_v1.txt")
	if decoded.contains("\"text\"") == false then
		return 7
	end
	if decoded.contains("\"score\"") == false then
		return 8
	end

	return 42
end
