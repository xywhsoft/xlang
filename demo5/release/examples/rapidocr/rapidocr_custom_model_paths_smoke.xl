import rapidocr

func main() as int
	auto engine = rapidocr.RapidOCR("release\\examples\\libs\\rapidocr\\models\\ch_PP-OCRv4_det_infer.onnx", "release\\examples\\libs\\rapidocr\\models\\ch_ppocr_mobile_v2.0_cls_infer.onnx", "release\\examples\\libs\\rapidocr\\models\\ch_PP-OCRv4_rec_infer.onnx", "release\\examples\\libs\\rapidocr\\models\\ppocr_keys_v1.txt")
	if engine.valid() == false then
		return 1
	end

	auto result = engine("release\\examples\\rapidocr\\sample.png")
	if result.ok() == false then
		return 2
	end
	if result.to_json().contains("\"boxes\"") == false then
		return 3
	end
	if result.word_results.contains("\"label\"") == false then
		return 4
	end

	return 42
end
