import onnxruntime as ort
import std.str as str

func main() as int
	if ort.available() == false then
		return 1
	end

	auto options = ort.SessionOptions()
	if options.append_execution_provider(ort.CPUExecutionProvider, "{\"use_arena\":\"1\"}") == false then
		return 2
	end

	auto sess = ort.InferenceSession("release\\examples\\onnxruntime\\identity.onnx", options)
	if sess.valid() == false then
		return 3
	end

	auto result = sess.run("[]", "{\"x\":{\"dtype\":\"float32\",\"shape\":[3],\"data\":[41,42,43]}}")
	auto json = result.to_json()
	if str.contains(json, "\"dtype\":\"float32\"") == false then
		return 4
	end
	if str.contains(json, "43") == false then
		return 5
	end

	return 42
end
