import onnxruntime as ort
import std.str as str

func main() as int
	if ort.available() == false then
		return 1
	end

	if ort.ORT_ENABLE_ALL != 99 then
		return 2
	end
	if ort.ORT_SEQUENTIAL != 0 then
		return 3
	end
	if ort.ORT_LOGGING_LEVEL_WARNING != 2 then
		return 4
	end
	if ort.CPUExecutionProvider != "CPUExecutionProvider" then
		return 5
	end

	auto providers = ort.get_providers()
	if str.contains(providers, "CPUExecutionProvider") == false then
		return 6
	end

	auto options = ort.SessionOptions()
	if options.ok() == false then
		return 7
	end
	if options.set_graph_optimization_level(ort.ORT_ENABLE_ALL) == false then
		return 8
	end
	if options.set_execution_mode(ort.ORT_SEQUENTIAL) == false then
		return 9
	end

	auto sess = ort.InferenceSession("release\\examples\\onnxruntime\\identity.onnx", options)
	if sess.ok() == false then
		return 10
	end
	if str.contains(sess.get_providers(), "CPUExecutionProvider") == false then
		return 11
	end

	auto result = sess.run("[]", "{\"x\":{\"dtype\":\"float32\",\"shape\":[3],\"data\":[51,52,53]}}")
	if result.ok() == false then
		return 12
	end
	if str.contains(result.to_json(), "53") == false then
		return 13
	end

	auto bad = ort.InferenceSession("release\\examples\\onnxruntime\\missing_model.onnx")
	if bad.ok() == true then
		return 14
	end
	if bad.error() == "" then
		return 15
	end
	if ort.get_last_error() == "" then
		return 16
	end

	return 42
end
