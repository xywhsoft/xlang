import onnxruntime as ort

func main() as int
	auto sess = ort.InferenceSession("release\\examples\\onnxruntime\\identity.onnx")
	if sess.valid() == false then
		return 1
	end

	auto inputs = sess.get_inputs()
	if inputs.contains("\"shape_symbols\"") == false then
		return 2
	end

	auto outputs = sess.get_outputs()
	if outputs.contains("\"shape_symbols\"") == false then
		return 3
	end

	return 42
end
