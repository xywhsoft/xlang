import onnxruntime as ort
import std.str as str

func main() as int
	if ort.available() == false then
		return 1
	end

	auto sess = ort.InferenceSession("release\\examples\\onnxruntime\\identity_int64.onnx")
	if sess.valid() == false then
		return 2
	end

	auto meta = sess.get_modelmeta()
	if str.contains(meta, "\"graph_name\":\"identity_int64\"") == false then
		return 3
	end
	if str.contains(meta, "\"producer_name\"") == false then
		return 4
	end

	auto run_options = ort.RunOptions()
	if run_options.set_log_verbosity_level(0) == false then
		return 5
	end
	if run_options.set_log_severity_level(2) == false then
		return 6
	end
	if run_options.set_run_tag("xlang-run-options-smoke") == false then
		return 7
	end
	if run_options.set_terminate() == false then
		return 8
	end
	if run_options.unset_terminate() == false then
		return 9
	end

	auto result = sess.run("[\"y\"]", "{\"x\":{\"dtype\":\"int64\",\"shape\":[3],\"data\":[11,12,13]}}", run_options)
	auto json = result.to_json()
	if str.contains(json, "\"dtype\":\"int64\"") == false then
		return 10
	end
	if str.contains(json, "13") == false then
		return 11
	end

	return 42
end
