import onnxruntime as ort
import std.str as str

func main() as int
	if ort.available() == false then
		return 1
	end

	auto sess = ort.InferenceSession("release\\examples\\onnxruntime\\identity_string_meta.onnx")
	if sess.valid() == false then
		return 2
	end

	auto inputs = sess.get_inputs()
	if str.contains(inputs, "\"dtype\":\"string\"") == false then
		return 3
	end

	auto meta = sess.get_modelmeta()
	if str.contains(meta, "\"graph_name\":\"identity_string_meta\"") == false then
		return 4
	end
	if str.contains(meta, "\"purpose\":\"string_tensor\"") == false then
		return 5
	end
	if str.contains(meta, "\"owner\":\"xlang\"") == false then
		return 6
	end

	auto result = sess.run("[]", "{\"x\":{\"dtype\":\"string\",\"shape\":[3],\"data\":[\"alpha\",\"beta\",\"gamma\"]}}")
	auto json = result.to_json()
	if str.contains(json, "\"dtype\":\"string\"") == false then
		return 7
	end
	if str.contains(json, "alpha") == false then
		return 8
	end
	if str.contains(json, "gamma") == false then
		return 9
	end

	return 42
end
