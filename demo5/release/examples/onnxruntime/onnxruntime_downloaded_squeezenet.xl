import onnxruntime as ort

func main() as int
	if ort.available() == false then
		return 1
	end

	auto sess = ort.InferenceSession("release\\examples\\onnxruntime\\squeezenet1.1-7.onnx")
	if sess.valid() == false then
		return 2
	end

	auto inputs = sess.get_inputs()
	auto outputs = sess.get_outputs()
	if inputs == "" then
		return 3
	end
	if outputs == "" then
		return 4
	end
	return 42
end
