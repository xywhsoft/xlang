import std.task

async func stream(int stop) as int
	int current = 0
	int mark = 0

	if false then
		mark += 100
	else
		mark += 10
		while current < stop do
			current += 1
			try
				if current == 2 then
					throw Error("skip")
				end
				int value = await task.delay(current)
				yield value + mark
			catch e
				if e.message == "skip" then
					int skipped = await task.delay(20)
					yield skipped + mark
				end
			finally
				if current == stop then
					int tail = await task.delay(10)
					yield tail + mark
				end
			end
		end
		mark += 20
	end

	return 0
end

func main() as int
	int sum = 0

	for value in stream(3)
		sum += value
	end

	return sum
end
