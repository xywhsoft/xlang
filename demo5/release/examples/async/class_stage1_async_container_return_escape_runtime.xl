var int copies = 0
var int destroys = 0

class AsyncReturnBox extends object
	var value as int

	create(int value)
		self.value = value
	end

	destroy()
		destroys = destroys + 1
	end

	func copy() as AsyncReturnBox
		copies = copies + 1
		return AsyncReturnBox(self.value)
	end
end

async func tick() as int
	return 0
end

async func make_values() as array<AsyncReturnBox>
	auto a = AsyncReturnBox(13)
	await tick()
	auto values = [a]
	return values
end

async func main() as int
	var int result = 34
	auto values = await make_values()
	auto got = values[0]
	if copies != 2 then
		result = -1
	end
	if destroys != 1 then
		result = -2
	end
	if got.value != 13 then
		result = -3
	end
	if copies != 2 then
		result = -4
	end
	if destroys != 1 then
		result = -5
	end
	if result == 34 then
		result = copies * 10 + destroys + got.value
	end
	return result
end
