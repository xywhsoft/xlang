import std.task

async func staged() as int
	int mark = 0

	if false then
		mark += 100
	else
		mark += 10
		try
			int first = await task.delay(1)
			yield first + mark
		finally
			int last = await task.delay(2)
			yield last + mark
		end
		mark += 20
	end

	return 0
end

func main() as int
	int sum = 0

	for value in staged()
		sum += value
	end

	return sum
end
