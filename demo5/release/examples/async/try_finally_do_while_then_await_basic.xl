async func keep_going(int value) as bool
	return value < 2
end

async func bonus() as int
	return 5
end

async func main() as int
	int value = 0
	int mark = 1

	try
		do
			value = value + 1
		while await keep_going(value)
		end
		mark = mark + 20
	finally
		mark = mark + 3
	end

	return value + mark + await bonus()
end
