async func keep_going(int value) as bool
	if value == 3 then
		throw Error("stop")
	end
	return value < 4
end

async func bonus() as int
	return 5
end

async func main() as int
	int value = 1
	int sum = 0
	int mark = 1

	try
		try
			do
				value = value + 1
				if value == 2 then
					continue
				end
				sum = sum + value
			while await keep_going(value)
			end
			mark = 99
		finally
			mark = mark + 10
		end
		mark = 199
	catch e
		if e.message == "stop" then
			sum = sum + 7
		else
			sum = sum + 1
		end
	finally
		mark = mark + 2
	end

	return sum + mark + await bonus()
end
