import std.fs

func main() as int
	const string dir = "release\\tmp\\fs_plus"
	const string src = "release\\tmp\\fs_plus\\a.txt"
	const string copy = "release\\tmp\\fs_plus\\b.txt"
	const string moved = "release\\tmp\\fs_plus\\c.txt"

	if fs.mkdir_all(dir) == false
		return 1
	end
	if fs.write_all(src, "abcdef") == false
		return 2
	end
	if fs.is_dir(dir) == false
		return 3
	end
	if fs.is_file(src) == false
		return 4
	end
	if fs.size(src) != 6
		return 5
	end
	if fs.copy(src, copy) == false
		return 6
	end
	if fs.move(copy, moved) == false
		return 7
	end
	if fs.exists(moved) == false
		return 8
	end
if fs.remove(moved) == false
		return 9
	end
	if fs.exists(moved)
		return 10
	end
	return 0
end
