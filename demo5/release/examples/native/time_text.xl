import std.time
import std.str

func main() as int
	const string now_text = time.now_text()
	const string date_text = time.date_text()
	const string clock_text = time.time_text()
	const time parsed = time.parse("2024-01-02 03:04:05")
	const string parsed_text = time.to_string(parsed)
	const string rel_text = time.relative(parsed, parsed)

	if str.contains(now_text, "-") == false
		return 1
	end
	if str.contains(date_text, "-") == false
		return 2
	end
	if str.contains(clock_text, ":") == false
		return 3
	end
	if str.contains(parsed_text, "2024-01-02") == false
		return 4
	end
	if str.contains(rel_text, "0") == false
		return 5
	end
	return 0
end
