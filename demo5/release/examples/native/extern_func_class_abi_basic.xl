#loadlib "../xlp_native/packages/pkg.probe/bin/pkg_probe.dll"

class NativePair extends object
	var x as int
	var y as int

	create(int x, int y)
		self.x = x
		self.y = y
	end
end

extern "pkg_clock_artifact_pair_make" func pair_make(int x, int y) as NativePair
extern "pkg_clock_artifact_pair_value_sum" func pair_value_sum(NativePair pair) as int
extern "pkg_clock_artifact_pair_add" func pair_add(NativePair pair, int delta) as NativePair

func main() as int
	auto a = pair_make(12, 30)
	if pair_value_sum(a) != 42 then
		return 1
	end

	auto b = pair_add(a, 1)
	if b.x != 13 then
		return 2
	end
	if b.y != 31 then
		return 3
	end
	if pair_value_sum(b) == 44 then
		return 42
	end
	return 4
end
