import std.channel as chm

async func main() as int
	auto ch = chm.make(2)
	if chm.capacity(ch) != 2 or chm.len(ch) != 0 or chm.closed(ch)
		return 9
	end

	bool sent0 = chm.send(ch, 10)
	bool sent1 = chm.send(ch, 20)
	bool sent2 = chm.send(ch, 30)
	if chm.len(ch) != 2
		return 10
	end

	auto ok0, first = await ch.recv()
	bool sent3 = chm.send(ch, 30)
	auto secondRecv = chm.recv(ch)
	bool closed = chm.close(ch)
	auto ok2, third = await ch.recv()
	auto emptyRecv = chm.recv(ch)

	if not sent0 or not sent1 or sent2 or not sent3 or not closed
		return 1
	end
	if not chm.closed(ch)
		return 4
	end
	if not ok0 or secondRecv[0] != true or not ok2 or emptyRecv[0] != false
		return 2
	end
	if emptyRecv[1] != null
		return 3
	end
	return int(first) + int(secondRecv[1]) + int(third)
end
