#loadlib "../xlp_native/packages/pkg.probe/bin/pkg_probe.dll"

extern "pkg_clock_artifact_bool_slot" var probe_bool as bool
extern "pkg_clock_artifact_float_slot" var probe_float as float64
extern "pkg_clock_artifact_bool_slot_is_true" func bool_is_true() as int
extern "pkg_clock_artifact_bool_slot_is_false" func bool_is_false() as int
extern "pkg_clock_artifact_float_slot_score" func float_score() as int

func main() as int
	if probe_bool != true then
		return 1
	end
	if bool_is_true() != 1 then
		return 2
	end

	bool saved_bool = probe_bool
	float64 saved_float = probe_float
	probe_bool = false
	if bool_is_false() != 1 then
		return 3
	end

	if float_score() != 25 then
		return 4
	end
	probe_float = 4.2
	if float_score() != 42 then
		return 5
	end

	probe_bool = saved_bool
	probe_float = saved_float
	if bool_is_true() == 1 then
		return 42
	end
	return 6
end
