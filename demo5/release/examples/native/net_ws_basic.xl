import std.net.ws as ws

func main() as int
	const string known_key = "dGhlIHNhbXBsZSBub25jZQ=="
	auto accept = ws.accept(known_key)
	auto req = ws.request("example.com", "/chat", known_key)
	auto resp = ws.response(known_key)
	auto frame = ws.frame_text("hello", false)
	auto parsed = ws.unframe(frame)
	auto key = ws.key()

	if accept != "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
		return 1
	end
	if req.contains("GET /chat HTTP/1.1") == false
		return 2
	end
	if req.contains("Sec-WebSocket-Key: " + known_key) == false
		return 3
	end
	if resp.contains("HTTP/1.1 101 Switching Protocols") == false
		return 4
	end
	if resp.contains("Sec-WebSocket-Accept: " + accept) == false
		return 5
	end
	if parsed["text"] != "hello"
		return 6
	end
	if parsed["opcode"] != "1"
		return 7
	end
	if parsed["length"] != "5"
		return 8
	end
	if key.length != 24
		return 9
	end

	return 70
end
