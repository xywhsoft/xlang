#loadlib "../xle_native/packages/pkg.probe/bin/pkg_probe.dll"

extern "pkg_clock_artifact_text_slot" var probe_text as string
extern "pkg_clock_artifact_text_slot_is_probe" func is_probe_text() as int
extern "pkg_clock_artifact_text_slot_is_updated" func is_updated_text() as int

func main() as int
	if probe_text != "probe-text" then
		return 1
	end
	if is_probe_text() != 1 then
		return 2
	end

	string saved = probe_text
	probe_text = "updated-text"
	if is_updated_text() != 1 then
		return 3
	end

	probe_text = saved
	if is_probe_text() == 1 then
		return 42
	end
	return 4
end
