import std.hash

func main() as int
	auto a = hash.hash32("hello")
	auto b = hash.hash32("hello")
	auto c = hash.hash32("world")
	if a != b
		return 1
	end
	if a == c
		return 2
	end
	if hash.hash64("hello") == hash.hash64("world")
		return 3
	end
	if hash.hash64_micro("hello") == hash.hash64_micro("world")
		return 4
	end
	if hash.hash64_nano("hello") == hash.hash64_nano("world")
		return 5
	end
	if hash.sha256("hello") != "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"
		return 6
	end
	if hash.sha512("hello") != "9b71d224bd62f3785d96d46ad3ea3d73319bfbc2890caadae2dff72519673ca72323c3d99ba5c11d7c7acc6e14b8c5da0c4663475c2e5c3adef46f73bcdec043"
		return 7
	end
	return 0
end
