import std.clock

func main() as int
	auto now = clock.now()
	auto text = clock.text()
	auto date = clock.date()
	auto tod = clock.time_of_day()

	clock.sleep(1)

	if now == null
		return 1
	end
	if text == ""
		return 2
	end
	if date == ""
		return 3
	end
	if tod == ""
		return 4
	end
	if clock.millis_per_second != 1000
		return 5
	end
	if clock.seconds_per_day != 86400
		return 6
	end
	return 0
end
