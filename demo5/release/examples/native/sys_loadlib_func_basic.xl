import std.sys.lib as sys

func main() as int
	auto lib = sys.loadlib("msvcrt.dll")
	function<int(string)> atoi = function<int(string)>(lib.proc("atoi"))
	var dyn = atoi
	auto ok = lib.close()

	if atoi("123") != 123 then
		return 1
	end
	if dyn("19") != 19 then
		return 2
	end
	if ok == false then
		return 3
	end
	if lib.loaded() then
		return 4
	end
	return 42
end
