import std.sys.lib as sys

func main() as int
	auto k32 = sys.loadlib("kernel32.dll")
	function<bool()> is_debugger_present = function<bool()>(k32.proc("IsDebuggerPresent"))
	auto state = is_debugger_present()

	if state == true then
		return 42
	end
	if state == false then
		return 42
	end
	return 0
end
