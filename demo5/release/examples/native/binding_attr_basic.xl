#loadlib "../xle_native/packages/pkg.probe/bin/pkg_probe.dll"
#binding "binding_attr_probe.h"

func main() as int
	if pkg_clock_artifact_add_one(41) != 42 then
		return 1
	end
	if pkg_clock_artifact_bool_score(1) != 7 then
		return 2
	end
	if pkg_clock_artifact_text_len("hello") != 5 then
		return 3
	end
	return 42
end
