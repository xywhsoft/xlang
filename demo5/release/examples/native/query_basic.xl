import std.query
import std.str

func main() as int
	auto text = query.encode({"name": "x lang", "path": "a/b", "ok": "yes"})
	auto data = query.decode(text)

	if str.contains(text, "name=x+lang") == false
		return 1
	end
	if str.contains(text, "path=a%2Fb") == false
		return 2
	end
	if data["name"] != "x lang"
		return 3
	end
	if data["path"] != "a/b"
		return 4
	end
	if data["ok"] != "yes"
		return 5
	end
	return 0
end
