import std.fs
import std.json
import std.str
import std.process

func main() as int
	const string dir = "release\\tmp\\stdlib_pipeline"
	const string file_path = "release\\tmp\\stdlib_pipeline\\report.txt"
	const string proc_out = process.capture("echo stdlib-pipeline")
	const string payload = json.encode({"kind": "pipeline", "ok": true})
	const string payload2 = json.encode(json.decode(payload))

	if fs.mkdir_all(dir) == false
		return 1
	end
	if str.ends_with(file_path, ".txt") == false
		return 2
	end
	if fs.write_all(file_path, "stamp=") == false
		return 3
	end
	if fs.append_all(file_path, proc_out) == false
		return 4
	end
	if fs.exists(file_path) == false
		return 5
	end
	if str.contains(fs.read_all(file_path), "stamp=") == false
		return 6
	end
	if str.contains(proc_out, "stdlib-pipeline") == false
		return 7
	end
	if str.contains(payload, "\"kind\":\"pipeline\"") == false
		return 8
	end
	if str.contains(payload2, "\"kind\":\"pipeline\"") == false
		return 9
	end

	return 0
end
