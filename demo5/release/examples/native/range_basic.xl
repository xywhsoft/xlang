import std.range

func main() as int
	auto a = range.collect(4)
	auto b = range.collect(2, 6)
	auto c = range.collect(10, 4, -3)

	if a.length != 4
		return 1
	end
	if a[0] != 0 or a[3] != 3
		return 2
	end
	if b.length != 4
		return 3
	end
	if b[0] != 2 or b[3] != 5
		return 4
	end
	if c.length != 2
		return 5
	end
	if c[0] != 10 or c[1] != 7
		return 6
	end
	return 0
end
