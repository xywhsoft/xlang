import std.sys.lib as sys

class NativePair
	var x as int
	var y as int

	create(int x, int y)
		self.x = x
		self.y = y
	end
end

func main() as int
	auto lib = sys.dlopen("examples/xlp_native/packages/pkg.probe/bin/pkg_probe.dll")

	function<NativePair(int, int)> pair_make = function<NativePair(int, int)>(sys.dlsym(lib, "pkg_clock_artifact_pair_make"))
	function<int(NativePair)> pair_value_sum = function<int(NativePair)>(sys.dlsym(lib, "pkg_clock_artifact_pair_value_sum"))
	function<NativePair(NativePair, int)> pair_add = function<NativePair(NativePair, int)>(sys.dlsym(lib, "pkg_clock_artifact_pair_add"))

	auto a = pair_make(12, 30)
	if pair_value_sum(a) != 42 then
		return 1
	end

	auto b = pair_add(a, 1)
	if b.x != 13 then
		return 2
	end
	if b.y != 31 then
		return 3
	end

	sys.dlclose(lib)
	return 42
end
