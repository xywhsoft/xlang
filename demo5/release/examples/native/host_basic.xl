import std.host
import std.str

func main() as int
	const string host_name = host.name()
	const string host_ip = host.ip()
	const string host_user = host.user()
	const string host_os = host.os()
	const string host_arch = host.arch()
	const string exe_path = host.executable()

	if str.contains(host_name, "") == false
		return 1
	end
	if str.contains(host_ip, ".") == false
		return 2
	end
	if host_user == ""
		return 3
	end
	if host_os == ""
		return 4
	end
	if host_arch == ""
		return 5
	end
	if exe_path == ""
		return 6
	end
	return 0
end
