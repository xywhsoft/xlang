import std.core as core
import std.module as mod

func main() as int
	if mod.key(core) != "std.core"
		return 1
	end
	if mod.export_count(core) < 1
		return 2
	end
	if not mod.has_export(core, "println")
		return 3
	end
	if mod.export_symbol(core, "println") == ""
		return 4
	end
	auto names = mod.exports(core)
	if names.length < 1
		return 5
	end
	if mod.abi_id(core) == ""
		return 6
	end
	if mod.descriptor_symbol(core) == ""
		return 7
	end
	return 74
end
