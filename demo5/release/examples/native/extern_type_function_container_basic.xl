extern type Fn = function<int(int,int)>
extern type TextList = list<string>
extern type Handle = point

func add(int a, int b) as int
	return a + b
end

func main() as int
	Fn op = add
	TextList labels = list{"x", "l"}
	Handle handle = null

	if op(20, 22) == 42 then
		if labels.join("") == "xl" then
			if handle == null then
				return 42
			end
		end
	end
	return 0
end
