import std.str
import std.sys.mem

func main() as int
	point a = mem.alloc(16)
	point b = mem.alloc(16)
	string text = ""

	if mem.is_null(a) or mem.is_null(b)
		return 1
	end

	if mem.write_string(a, "hello") != 5
		return 2
	end

	text = mem.read_string(a, 5)
	if text != "hello"
		return 3
	end

	if mem.fill(b, 65, 3) == false
		return 4
	end
	text = mem.read_string(b, 3)
	if text != "AAA"
		return 5
	end

	if mem.copy(b, a, 5) == false
		return 6
	end
	text = mem.read_string(b, 5)
	if str.contains(text, "hello") == false
		return 7
	end

	if mem.free(a) == false
		return 8
	end
	if mem.free(b) == false
		return 9
	end
	return 0
end
