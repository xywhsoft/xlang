#loadlib "../xle_native/libs/pkg.probe/bin/pkg_probe.dll"
#binding "binding_callback_probe.h"

func callback_add(int value, string text) as int
	return value + text.length
end

func callback_void() as void
end

func main() as int
	auto score = pkg_clock_artifact_callback_accept(callback_add)
	if score != 42 then
		return score
	end
	pkg_clock_artifact_callback_void(callback_void)
	return 42
end
