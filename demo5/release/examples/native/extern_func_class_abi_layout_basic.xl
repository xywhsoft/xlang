#loadlib "../xlp_native/packages/pkg.probe/bin/pkg_probe.dll"

class NativeLayout
	var tag as int8
	var count as int32
	var weight as float64

	create(int8 tag, int32 count, float64 weight)
		self.tag = tag
		self.count = count
		self.weight = weight
	end
end

extern "pkg_clock_artifact_layout_slot" var layout_slot as NativeLayout
extern "pkg_clock_artifact_layout_make" func layout_make(int8 tag, int32 count, float64 weight) as NativeLayout
extern "pkg_clock_artifact_layout_score" func layout_score(NativeLayout layout) as int
extern "pkg_clock_artifact_layout_add" func layout_add(NativeLayout layout, int32 delta) as NativeLayout
extern "pkg_clock_artifact_layout_slot_score" func layout_slot_score() as int

func main() as int
	auto saved = layout_slot
	if layout_slot_score() != 42 then
		return 1
	end

	auto a = layout_make(3, 20, 19.5)
	if layout_score(a) != 42 then
		return 2
	end

	auto b = layout_add(a, 1)
	if b.tag != 3 then
		return 3
	end
	if b.count != 21 then
		return 4
	end
	if b.weight < 20.4 then
		return 5
	end

	layout_slot = layout_make(4, 18, 20.5)
	if layout_slot_score() != 42 then
		layout_slot = saved
		return 6
	end
	layout_slot = saved
	return 42
end
