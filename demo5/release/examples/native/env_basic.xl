import std.env

func main() as int
const string path_text = env.read("PATH")
	const string cwd_text = env.cwd()
	const string temp_text = env.temp()
	const string home_text = env.home()
	const string key = "XLANG_ENV_BASIC"

	if env.exists("PATH") == false
		return 1
	end
	if path_text == ""
		return 2
	end
	if cwd_text == ""
		return 3
	end
	if temp_text == ""
		return 4
	end
	if home_text == ""
		return 5
	end
	if env.set(key, "demo5") == false
		return 6
	end
	if env.exists(key) == false
		return 7
	end
if env.read(key) != "demo5"
		return 8
	end
	return 0
end
