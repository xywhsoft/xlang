import std.sys.env

func main() as int
	if env.cwd() == ""
		return 1
	end
	if env.temp() == ""
		return 2
	end
	if env.home() == ""
		return 3
	end
	if env.set("XLANG_SYS_ENV_BASIC", "ok") == false
		return 4
	end
	if env.exists("XLANG_SYS_ENV_BASIC") == false
		return 5
	end
	if env.get("XLANG_SYS_ENV_BASIC") != "ok"
		return 6
	end
	return 0
end
