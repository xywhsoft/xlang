import std.env
import std.process
import std.str

func main() as int
	const string work_dir = env.cwd()
	const string out_text = process.capture_in("cmd /c cd", work_dir)
	const int code = process.exec_in("cmd /c exit 7", work_dir)

	if work_dir == ""
		return 1
	end
	if str.contains(out_text, "demo5") == false
		return 2
	end
	if code != 7
		return 3
	end
	return 0
end
