#loadlib "../xlp_native/packages/pkg.probe/bin/pkg_probe.dll"

extern "pkg_clock_artifact_point_slot" var probe_point as point
extern "pkg_clock_artifact_point_sentinel" func sentinel() as point
extern "pkg_clock_artifact_point_is_sentinel" func is_sentinel() as int
extern "pkg_clock_artifact_point_is_null" func is_null() as int

func main() as int
	if is_sentinel() != 1 then
		return 1
	end

	point saved = probe_point
	probe_point = point(null)
	if is_null() != 1 then
		return 2
	end

	probe_point = sentinel()
	if is_sentinel() != 1 then
		return 3
	end

	probe_point = saved
	if is_sentinel() == 1 then
		return 42
	end
	return 4
end
