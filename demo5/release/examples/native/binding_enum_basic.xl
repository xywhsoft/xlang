#loadlib "../xle_native/packages/pkg.probe/bin/pkg_probe.dll"
#binding "binding_enum_probe.h"

func main() as int
	if PROBE_MODE_OFF != 0 then
		return 1
	end
	if PROBE_MODE_ON != 1 then
		return 2
	end
	if PROBE_PLAIN_A != -1 then
		return 3
	end
	if PROBE_PLAIN_B != 0 then
		return 4
	end
	if PROBE_MODE_SHIFT != 32 then
		return 5
	end
	if PROBE_MODE_EXPR != 42 then
		return 6
	end
	if pkg_clock_artifact_enum_alias_score(PROBE_MODE_ON) != 41 then
		return 7
	end
	return PROBE_MODE_HEX + pkg_clock_artifact_bool_score(PROBE_MODE_ON) - 7
end
