import miniz
import std.fs

func main() as int
	auto dir = "release\\tmp\\miniz"
	auto plain = dir + "\\plain.txt"
	auto packed = dir + "\\plain.miniz"
	auto unpacked = dir + "\\plain.out.txt"
	auto zip_path = dir + "\\one.zip"
	auto text = "hello miniz package"
	auto compressed = miniz.compress_hex(text)

	if fs.mkdir_all(dir) == false
		return 1
	end
	if compressed.length <= 8
		return 2
	end
	if miniz.decompress_hex(compressed) != text
		return 3
	end
	if fs.write_all(plain, text) == false
		return 4
	end
	if miniz.compress_file_level(plain, packed, 6) == false
		return 5
	end
	if miniz.decompress_file(packed, unpacked) == false
		return 6
	end
	if fs.read_all(unpacked) != text
		return 7
	end
	if miniz.zip_write_text(zip_path, "note.txt", text) == false
		return 8
	end
	if miniz.zip_count(zip_path) != 1
		return 9
	end
	if miniz.zip_first_name(zip_path) != "note.txt"
		return 10
	end
	if miniz.zip_read_text(zip_path, "note.txt") != text
		return 11
	end
	return miniz.zip_count(zip_path) * 40 + miniz.zip_first_name(zip_path).length
end
