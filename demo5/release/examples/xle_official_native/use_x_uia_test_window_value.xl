import x.uia
import std.str

func main() as int
	auto win = x.uia.test_window()
	if win.valid() == false then
		return 1
	end

	auto edit = x.uia.from_hwnd(win.edit_hwnd())
	if edit.valid() == false then
		win.release()
		return 2
	end

	if edit.set_value("xlang-uia-controlled-edit") == false then
		win.release()
		return 3
	end

	if str.contains(edit.value(), "xlang-uia-controlled-edit") == false then
		win.release()
		return 4
	end

	if str.contains(edit.text(), "xlang-uia-controlled-edit") == false then
		win.release()
		return 5
	end

	win.release()
	return 0
end
