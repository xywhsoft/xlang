import x.uia
import std.str

func main() as int
	auto win = x.uia.test_window()
	if win.valid() == false then
		return 1
	end

	auto edit = x.uia.from_hwnd(win.edit_hwnd())
	if edit.valid() == false then
		win.release()
		return 2
	end

	auto locator = x.uia.locator_for(edit)
	if str.contains(locator, "\"strategy\"") == false then
		win.release()
		return 3
	end
	if str.contains(locator, "\"controlType\":50004") == false then
		win.release()
		return 4
	end
	if str.contains(locator, "\"classPath\"") == false then
		win.release()
		return 5
	end
	if str.contains(locator, "\"processId\"") == false then
		win.release()
		return 6
	end

	edit.set_focus()
	win.focus_edit()

	auto focused = x.uia.focused_locator()
	if str.contains(focused, "\"strategy\"") == false then
		win.release()
		return 7
	end
	if str.contains(focused, "\"controlType\"") == false then
		win.release()
		return 8
	end

	win.release()
	return 0
end
