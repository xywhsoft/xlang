import x.uia

func as_point(var value) as point
	return value
end

func main() as int
	auto root = x.uia.desktop()
	if root.valid() == false then
		return 1
	end

	auto children = root.children()
	if children.length <= 0 then
		return 2
	end

	auto first = x.uia.element(as_point(children[0]))
	if first.valid() == false then
		return 3
	end

	first.name()
	first.class_name()
	first.rect_json()

	auto parent = first.parent()
	if parent.valid() == false then
		return 4
	end

	return 0
end
