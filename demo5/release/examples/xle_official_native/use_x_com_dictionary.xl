import x.com

func as_array(var value) as array<var>
	return value
end

func main() as int
	auto dict = x.com.create("Scripting.Dictionary")
	if dict.valid() == false then
		return 1
	end

	dict.Add("answer", "42")
	if dict.Exists("answer") != true then
		return 2
	end

	if dict.Item("answer") != "42" then
		return 3
	end

	dict.Add("number", 7)
	if dict.Item("number") != 7 then
		return 4
	end

	auto keys = as_array(dict.Keys())
	if keys.length != 2 then
		return 5
	end
	if keys[0] != "answer" then
		return 6
	end
	if keys[1] != "number" then
		return 7
	end

	return 42
end
