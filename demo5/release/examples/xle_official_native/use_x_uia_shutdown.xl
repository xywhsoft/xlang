import x.uia

func main() as int
	auto root = x.uia.desktop()
	if root.valid() == false then
		return 1
	end
	if root.release() == false then
		return 2
	end
	if x.uia.shutdown() == false then
		return 3
	end
	auto root2 = x.uia.desktop()
	if root2.valid() == false then
		return 4
	end
	if root2.release() == false then
		return 5
	end
	if x.uia.shutdown() == false then
		return 6
	end
	return 0
end
