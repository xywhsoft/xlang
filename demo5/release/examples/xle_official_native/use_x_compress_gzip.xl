import x.compress.gzip
import std.fs

func main() as int
	auto dir = "release\\tmp\\x_compress_gzip"
	auto path = dir + "\\hello.gz"

	if fs.mkdir_all(dir) == false
		return 1
	end
	if x.compress.gzip.write_test_gzip(path, "hello gzip") == false
		return 2
	end
	if x.compress.gzip.is_gzip(path) == false
		return 3
	end
	if x.compress.gzip.uncompressed_size(path) != 10
		return 4
	end
	if x.compress.gzip.is_gzip(path + ".missing")
		return 5
	end
	return x.compress.gzip.uncompressed_size(path) + 32
end
