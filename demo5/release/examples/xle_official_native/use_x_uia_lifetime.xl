import x.uia

func main() as int
	auto root = x.uia.desktop()
	if root.valid() == false then
		return 1
	end
	if root.release() == false then
		return 2
	end
	if root.valid() == true then
		return 3
	end
	root.release()
	if root.name() != "" then
		return 4
	end
	auto cond = x.uia.by_name("xlang-uia-lifetime")
	if cond.valid() == false then
		return 5
	end
	if cond.release() == false then
		return 6
	end
	if cond.valid() == true then
		return 7
	end
	cond.release()
	return 0
end
