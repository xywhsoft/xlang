import x.uia
import std.str

func on_event(string json) as int
	if str.contains(json, "\"type\":\"focus\"") == false then
		return 5
	end
	if str.contains(json, "\"controlType\":") == false then
		return 6
	end
	return 42
end

func main() as int
	auto queue = x.uia.events()
	if queue.valid() == false then
		return 1
	end
	if queue.subscribe_focus_changed() == false then
		queue.release()
		return 2
	end

	auto win = x.uia.test_window()
	if win.valid() == false then
		queue.release()
		return 3
	end

	win.focus_button()
	win.focus_edit()
	auto score = queue.poll_callback(on_event, 3000)
	if score != 42 then
		win.release()
		queue.release()
		return score
	end

	win.release()
	queue.release()
	return 0
end
