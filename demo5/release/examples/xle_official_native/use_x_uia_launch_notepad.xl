import x.uia

func main() as int
	auto proc = x.uia.launch("notepad.exe")
	if proc.valid() == false then
		return 1
	end

	auto root = x.uia.desktop()
	if root.valid() == false then
		proc.close()
		proc.release()
		return 2
	end

	auto window_cond = x.uia.all_of(x.uia.by_process_id(proc.id()), x.uia.by_control_type(50032))
	auto window = root.find_first(window_cond, 5000)
	if window.valid() == false then
		proc.close()
		proc.release()
		return 3
	end

	window.name()
	window.class_name()
	window.rect_json()

	proc.close()
	proc.release()
	return 0
end
