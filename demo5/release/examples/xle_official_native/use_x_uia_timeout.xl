import x.uia
import std.str

func main() as int
	auto root = x.uia.desktop()
	if root.valid() == false then
		return 1
	end
	auto missing = root.find_first(x.uia.by_name("__xlang_missing_uia_element__"), 100)
	if missing.valid() then
		return 2
	end
	if str.contains(x.uia.last_error(), "timeout") == false then
		return 3
	end
	return 0
end
