import x.uia
import std.str

func main() as int
	auto win = x.uia.test_window()
	if win.valid() == false then
		return 1
	end

	auto root = x.uia.from_hwnd(win.hwnd())
	if root.valid() == false then
		win.release()
		return 2
	end

	auto json = root.snapshot_json(2, 16)
	if str.contains(json, "\"children\"") == false then
		win.release()
		return 3
	end
	if str.contains(json, "xlang uia test") == false then
		win.release()
		return 4
	end
	if str.contains(json, "XLangUiaTestWindow") == false then
		win.release()
		return 5
	end
	if str.contains(json, "Click") == false then
		win.release()
		return 6
	end

	win.release()
	return 0
end
