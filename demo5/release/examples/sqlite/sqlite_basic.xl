import sqlite

func main() as int
	auto db = sqlite.sqlite3_open(":memory:")
	if db.valid() == false
		return 1
	end

	auto rc = sqlite.sqlite3_exec(db, "create table people(id integer primary key, name text, age int);")
	if rc != sqlite.SQLITE_OK
		return 2
	end

	auto insert_stmt = sqlite.sqlite3_prepare_v2(db, "insert into people(name, age) values(?, ?);")
	if insert_stmt.valid() == false
		return 3
	end
	if sqlite.sqlite3_bind_text(insert_stmt, 1, "Ada") != sqlite.SQLITE_OK
		return 4
	end
	if sqlite.sqlite3_bind_int(insert_stmt, 2, 37) != sqlite.SQLITE_OK
		return 5
	end
	if sqlite.sqlite3_step(insert_stmt) != sqlite.SQLITE_DONE
		return 6
	end
	if sqlite.sqlite3_finalize(insert_stmt) != sqlite.SQLITE_OK
		return 7
	end

	auto query_stmt = sqlite.sqlite3_prepare_v2(db, "select name, age from people where age > ?;")
	if query_stmt.valid() == false
		return 8
	end
	if sqlite.sqlite3_bind_int(query_stmt, 1, 30) != sqlite.SQLITE_OK
		return 9
	end
	if sqlite.sqlite3_step(query_stmt) != sqlite.SQLITE_ROW
		return 10
	end
	if sqlite.sqlite3_column_text(query_stmt, 0) != "Ada"
		return 11
	end
	if sqlite.sqlite3_column_int(query_stmt, 1) != 37
		return 12
	end
	if sqlite.sqlite3_step(query_stmt) != sqlite.SQLITE_DONE
		return 13
	end
	if sqlite.sqlite3_finalize(query_stmt) != sqlite.SQLITE_OK
		return 14
	end
	if sqlite.sqlite3_close_v2(db) != sqlite.SQLITE_OK
		return 15
	end
	return 0
end
