func take_array(array<int> values) as int
	return values.length
end

func take_dict(dict<int> values) as int
	return values.length
end

func take_list(list<int> values) as int
	return values.length
end

func take_set(set<int> values) as int
	return values.length
end

func make_array() as array<any>
	return [1, 2]
end

func make_dict() as dict<any>
	return {"left": 1, "right": 2}
end

func make_list() as list<any>
	return list{1, 2}
end

func make_set() as set<any>
	return set{1, 2}
end

func main() as int
	return take_array(make_array()) + take_dict(make_dict()) + take_list(make_list()) + take_set(make_set())
end
