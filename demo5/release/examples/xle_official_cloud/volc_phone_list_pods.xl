import x.volc.phone as phone
import std.env as env

func env_or(string name, string fallback) as string
	if env.exists(name) then
		return env.read(name)
	end
	return fallback
end

func main() as int
	if env.exists("VOLC_ACCESS_KEY") == false or env.exists("VOLC_SECRET_KEY") == false or env.exists("VOLC_PHONE_PRODUCT_ID") == false then
		return 0
	end
	auto spec = "action=ListPod\nversion=2023-10-30\naccess_key=" + env.read("VOLC_ACCESS_KEY") + "\nsecret_key=" + env.read("VOLC_SECRET_KEY") + "\nsession_token=" + env_or("VOLC_SESSION_TOKEN", "") + "\nbody=" + phone.product_body(env.read("VOLC_PHONE_PRODUCT_ID")) + "\ntimeout_ms=30000"
	auto body = phone.raw_spec(spec)
	if body == "" then
		return 1
	end
	return 0
end
