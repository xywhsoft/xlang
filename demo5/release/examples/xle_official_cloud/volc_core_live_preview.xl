import x.volc.core as core
import x.volc.phone as phone
import std.env as env
import std.io as io
import std.str as str

func env_or(string name, string fallback) as string
	if env.exists(name) then
		return env.read(name)
	end
	return fallback
end

func bool_text(bool value) as string
	if value then
		return "true"
	end
	return "false"
end

func main() as int
	if env.exists("VOLC_ACCESS_KEY") == false or env.exists("VOLC_SECRET_KEY") == false or env.exists("VOLC_PHONE_PRODUCT_ID") == false then
		return 0
	end
	auto product_id = env.read("VOLC_PHONE_PRODUCT_ID")
	auto spec = "action=ListDc\nversion=2023-10-30\naccess_key=" + env.read("VOLC_ACCESS_KEY") + "\nsecret_key=" + env.read("VOLC_SECRET_KEY") + "\nsession_token=" + env_or("VOLC_SESSION_TOKEN", "") + "\nbody=" + phone.product_body(product_id) + "\nx_date=20260513T000000Z"
	auto preview = core.sign_preview_acep_spec(spec)
	io.println("has_x_security_token=" + bool_text(str.contains(preview, "x_security_token")))
	io.println("credential_has_product_id=" + bool_text(str.contains(preview, "Credential=" + product_id + "/")))
	io.println("body_has_product_id=" + bool_text(str.contains(preview, product_id)))
	return 0
end
