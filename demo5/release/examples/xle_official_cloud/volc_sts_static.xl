import x.volc.sts as sts

func main() as int
	auto preview = sts.preview_assume_role("AK", "SK", "2100310067", "pingkong_phone", "xlang client", 3600, "20260513T030405Z")
	if preview == ""
		return 1
	end
	auto raw = "{\"Result\":{\"Credentials\":{\"AccessKeyId\":\"ak\",\"SecretAccessKey\":\"sk\",\"SessionToken\":\"token\",\"ExpiredTime\":\"tomorrow\",\"CurrentTime\":\"now\"}}}"
	if sts.access_key_id(raw) != "ak"
		return 2
	end
	if sts.secret_access_key(raw) != "sk"
		return 3
	end
	if sts.session_token(raw) != "token"
		return 4
	end
	if sts.expired_time(raw) != "tomorrow"
		return 5
	end
	if sts.current_time(raw) != "now"
		return 6
	end
	if sts.credentials_json(raw) == ""
		return 7
	end
	if sts.projection_credentials_json(raw, "product", "pod") == ""
		return 8
	end
	return 0
end
