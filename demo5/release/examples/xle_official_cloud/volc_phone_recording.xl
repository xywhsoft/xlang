import x.volc.phone as phone
import std.env as env

func env_or(string name, string fallback) as string
	if env.exists(name) then
		return env.read(name)
	end
	return fallback
end

func main() as int
	if env.exists("VOLC_ACCESS_KEY") == false or env.exists("VOLC_SECRET_KEY") == false or env.exists("VOLC_PHONE_PRODUCT_ID") == false or env.exists("VOLC_PHONE_POD_ID") == false then
		return 0
	end
	auto round_id = "xlang-recording-smoke"
	auto token = env_or("VOLC_SESSION_TOKEN", "")
	auto raw = phone.start_recording(env.read("VOLC_ACCESS_KEY"), env.read("VOLC_SECRET_KEY"), token, env.read("VOLC_PHONE_PRODUCT_ID"), env.read("VOLC_PHONE_POD_ID"), round_id, 60, false, 30000)
	if raw == "" then
		return 1
	end
	auto stopped = phone.stop_recording(env.read("VOLC_ACCESS_KEY"), env.read("VOLC_SECRET_KEY"), token, env.read("VOLC_PHONE_PRODUCT_ID"), env.read("VOLC_PHONE_POD_ID"), 30000)
	if stopped == "" then
		return 2
	end
	return 0
end
