import x.volc.phone as phone
import std.env as env
import std.io as io
import std.fmt as fmt

func env_or(string name, string fallback) as string
	if env.exists(name) then
		return env.read(name)
	end
	return fallback
end

func main() as int
	if env.exists("VOLC_ACCESS_KEY") == false or env.exists("VOLC_SECRET_KEY") == false or env.exists("VOLC_PHONE_PRODUCT_ID") == false then
		io.println("SKIP volc phone readonly live: missing VOLC_ACCESS_KEY, VOLC_SECRET_KEY, or VOLC_PHONE_PRODUCT_ID")
		return 0
	end

	auto base_spec = "version=2023-10-30\naccess_key=" + env.read("VOLC_ACCESS_KEY") + "\nsecret_key=" + env.read("VOLC_SECRET_KEY") + "\nsession_token=" + env_or("VOLC_SESSION_TOKEN", "") + "\nbody=" + phone.product_body(env.read("VOLC_PHONE_PRODUCT_ID")) + "\ntimeout_ms=30000"

	auto dc_resp = phone.call_spec("action=ListDc\n" + base_spec)
	if dc_resp.ok_value then
		io.println("ListDc ok=true status=" + fmt.int_text(dc_resp.status_value, "") + " request_id=" + dc_resp.request_id_value)
	else
		io.println("ListDc ok=false status=" + fmt.int_text(dc_resp.status_value, "") + " request_id=" + dc_resp.request_id_value)
		io.println("ListDc code=" + dc_resp.code_value + " message=" + dc_resp.message_value)
		return 1
	end
	auto host_resp = phone.call_spec("action=ListHost\n" + base_spec)
	if host_resp.ok_value then
		io.println("ListHost ok=true status=" + fmt.int_text(host_resp.status_value, "") + " request_id=" + host_resp.request_id_value)
	else
		io.println("ListHost ok=false status=" + fmt.int_text(host_resp.status_value, "") + " request_id=" + host_resp.request_id_value)
		io.println("ListHost code=" + host_resp.code_value + " message=" + host_resp.message_value)
		return 2
	end
	auto pod_resp = phone.call_spec("action=ListPod\n" + base_spec)
	if pod_resp.ok_value then
		io.println("ListPod ok=true status=" + fmt.int_text(pod_resp.status_value, "") + " request_id=" + pod_resp.request_id_value)
	else
		io.println("ListPod ok=false status=" + fmt.int_text(pod_resp.status_value, "") + " request_id=" + pod_resp.request_id_value)
		io.println("ListPod code=" + pod_resp.code_value + " message=" + pod_resp.message_value)
		return 3
	end

	return 0
end
