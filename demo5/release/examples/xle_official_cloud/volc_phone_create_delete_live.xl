import x.volc.phone as phone
import std.env as env
import std.io as io
import x.volc.core as core

func env_or(string name, string fallback) as string
	if env.exists(name) then
		return env.read(name)
	end
	return fallback
end

func main() as int
	if env.exists("VOLC_PHONE_TEST_CREATE") == false or env.read("VOLC_PHONE_TEST_CREATE") != "1" then
		io.println("SKIP volc phone create/delete live: set VOLC_PHONE_TEST_CREATE=1 to create a disposable test pod")
		return 0
	end
	if env.exists("VOLC_ACCESS_KEY") == false or env.exists("VOLC_SECRET_KEY") == false or env.exists("VOLC_PHONE_PRODUCT_ID") == false then
		io.println("SKIP volc phone create/delete live: missing VOLC_ACCESS_KEY, VOLC_SECRET_KEY, or VOLC_PHONE_PRODUCT_ID")
		return 0
	end

	auto product_id = env.read("VOLC_PHONE_PRODUCT_ID")
	auto dc = env_or("VOLC_PHONE_TEST_DC", "hbsjz-ctcucm-01-f572znij")
	auto configuration_code = env_or("VOLC_PHONE_TEST_CONFIGURATION_CODE", "elementaryPro")
	auto layout_id = env_or("VOLC_PHONE_TEST_LAYOUT_ID", "single-display-landscape")
	auto pod_name = env_or("VOLC_PHONE_TEST_POD_NAME", "xlang-live-smoke")

	auto create_body = "{\"ProductId\":" + core.json_string(product_id) + ",\"ResourceType\":200,\"PodName\":" + core.json_string(pod_name) + ",\"HostId\":null,\"ConfigurationCode\":" + core.json_string(configuration_code) + ",\"Dc\":" + core.json_string(dc) + ",\"DisplayLayoutId\":" + core.json_string(layout_id) + ",\"UpBandwidthLimit\":0,\"DownBandwidthLimit\":0,\"Start\":false}"
	auto create_spec = "action=CreatePod\nversion=2023-10-30\naccess_key=" + env.read("VOLC_ACCESS_KEY") + "\nsecret_key=" + env.read("VOLC_SECRET_KEY") + "\nsession_token=\nbody=" + create_body + "\ntimeout_ms=60000"
	auto create_raw = phone.raw_spec(create_spec)
	auto create_resp = phone.normalize_response("CreatePod", create_raw)
	io.println("CreatePod ok=" + create_resp.to_json())
	if create_resp.ok() == false then
		return 1
	end

	auto pod_id = phone.json_string_field(create_raw, "PodId")
	if pod_id == "" then
		io.println("CreatePod did not return PodId; no delete attempted")
		return 2
	end
	io.println("Created disposable pod_id=" + pod_id)

	auto delete_body = "{\"ProductId\":" + core.json_string(product_id) + ",\"PodId\":" + core.json_string(pod_id) + "}"
	auto delete_spec = "action=DeletePod\nversion=2023-10-30\naccess_key=" + env.read("VOLC_ACCESS_KEY") + "\nsecret_key=" + env.read("VOLC_SECRET_KEY") + "\nsession_token=\nbody=" + delete_body + "\ntimeout_ms=60000"
	auto delete_raw = phone.raw_spec(delete_spec)
	auto delete_resp = phone.normalize_response("DeletePod", delete_raw)
	io.println("DeletePod ok=" + delete_resp.to_json())
	if delete_resp.ok() == false then
		io.println("IMPORTANT: disposable pod delete failed, pod_id=" + pod_id)
		return 3
	end

	return 0
end
