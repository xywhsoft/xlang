import x.volc.sts as sts
import std.env as env

func main() as int
	if env.exists("VOLC_ACCESS_KEY") == false or env.exists("VOLC_SECRET_KEY") == false or env.exists("VOLC_ACCOUNT_ID") == false or env.exists("VOLC_ROLE_NAME") == false then
		return 0
	end
	auto role_trn = "trn:iam::" + env.read("VOLC_ACCOUNT_ID") + ":role/" + env.read("VOLC_ROLE_NAME")
	auto spec = "access_key=" + env.read("VOLC_ACCESS_KEY") + "\nsecret_key=" + env.read("VOLC_SECRET_KEY") + "\nrole_trn=" + role_trn + "\nrole_session_name=xlang-client\nduration_seconds=3600\ntimeout_ms=30000"
	auto body = sts.assume_role_spec(spec)
	if body == "" then
		return 1
	end
	return 0
end
