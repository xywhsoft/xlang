import opencv as cv2

func main() as int
	if cv2.IMREAD_COLOR != 1 then
		return 1
	end
	if cv2.IMREAD_GRAYSCALE != 0 then
		return 2
	end
	if cv2.COLOR_BGR2RGB != 4 then
		return 3
	end
	if cv2.COLOR_BGR2GRAY != 6 then
		return 4
	end
	if cv2.BORDER_CONSTANT != 0 then
		return 5
	end

	if cv2.available() == false then
		auto err = cv2.last_error()
		if err == "" then
			return 6
		end
		return 42
	end

	if cv2.backend() == "" then
		return 7
	end

	auto img = cv2.imread("release\\examples\\rapidocr\\sample.png", cv2.IMREAD_COLOR)
	if img.empty() then
		return 8
	end

	auto gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
	if gray.empty() then
		return 9
	end
	if gray.channels() != 1 then
		return 10
	end

	auto padded = cv2.copyMakeBorder(gray, 1, 1, 2, 2, cv2.BORDER_CONSTANT)
	if padded.width() != gray.width() + 4 then
		return 11
	end
	if padded.height() != gray.height() + 2 then
		return 12
	end

	return 42
end
