import opencv as cv2

func main() as int
	if cv2.available() == false then
		return 1
	end
	if cv2.backend().contains("opencv_xlang.dll") == false then
		return 2
	end

	auto img = cv2.imread("release\\examples\\rapidocr\\sample.png", cv2.IMREAD_COLOR)
	if img.empty() then
		return 3
	end
	if img.width() != 360 then
		return 4
	end
	if img.height() != 96 then
		return 5
	end
	if img.channels() != 3 then
		return 6
	end

	auto gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
	if gray.channels() != 1 then
		return 7
	end

	auto padded = cv2.copyMakeBorder(gray, 2, 3, 4, 5, cv2.BORDER_CONSTANT)
	if padded.width() != 369 then
		return 8
	end
	if padded.height() != 101 then
		return 9
	end

	auto tensor = cv2.toCHWTensorJson(img, 0.0039215689, 0, 0, 0, 1, 1, 1)
	if tensor.contains("\"shape\":[1,3,96,360]") == false then
		return 10
	end

	if cv2.imwrite("dev\\extlibs\\opencv\\smoke\\sample_copy.png", img) == false then
		return 11
	end

	return 42
end
