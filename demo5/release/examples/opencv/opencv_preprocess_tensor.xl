import opencv as cv2

func main() as int
	if cv2.available() == false then
		if cv2.last_error() == "" then
			return 1
		end
		return 42
	end

	auto img = cv2.imread("release\\examples\\rapidocr\\sample.png", cv2.IMREAD_COLOR)
	if img.empty() then
		return 2
	end

	auto resized = cv2.resize(img, 64, 32)
	auto padded = cv2.copyMakeBorder(resized, 0, 0, 4, 4, cv2.BORDER_CONSTANT)
	auto norm = cv2.normalize(padded, 0.0039215689, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
	if norm.empty() then
		return 3
	end

	auto tensor = cv2.toCHWTensorJson(norm, 1.0, 0, 0, 0, 1, 1, 1)
	if tensor.contains("\"dtype\":\"float32\"") == false then
		return 4
	end
	if tensor.contains("\"shape\":[1,3,32,72]") == false then
		return 5
	end

	return 42
end
