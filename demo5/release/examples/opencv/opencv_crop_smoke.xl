import opencv as cv2

func main() as int
	auto img = cv2.imread("release\\examples\\rapidocr\\sample.png", cv2.IMREAD_COLOR)
	if img.empty() then
		return 1
	end

	auto cropped = cv2.crop(img, 0, 0, 16, 16)
	if cropped.empty() then
		return 2
	end
	if cropped.width() != 16 then
		return 3
	end
	if cropped.height() != 16 then
		return 4
	end
	if cv2.imwrite("release\\examples\\opencv\\opencv_crop_smoke.png", cropped) == false then
		return 5
	end

	return 42
end
