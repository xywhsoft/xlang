import opencv as cv2

func main() as int
	int i = 0
	while i < 50 do
		auto img = cv2.imread("release\\examples\\rapidocr\\sample.png", cv2.IMREAD_COLOR)
		if img.empty() then
			return 1
		end
		auto resized = cv2.resize(img, 32, 32)
		if resized.empty() then
			return 2
		end
		auto boxed = cv2.rectangle(resized, 2, 2, 29, 29, 0, 255, 0, 1)
		if boxed.empty() then
			return 3
		end
		i = i + 1
	end

	return 42
end
