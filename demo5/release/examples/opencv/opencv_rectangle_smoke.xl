import opencv as cv2

func main() as int
	auto img = cv2.imread("release\\examples\\rapidocr\\sample.png", cv2.IMREAD_COLOR)
	if img.empty() then
		return 1
	end

	auto boxed = cv2.rectangle(img, 2, 2, img.width() - 3, img.height() - 3, 0, 255, 0, 2)
	if boxed.empty() then
		return 2
	end

	if cv2.imwrite("release\\examples\\opencv\\opencv_rectangle_smoke.png", boxed) == false then
		return 3
	end

	auto check = cv2.imread("release\\examples\\opencv\\opencv_rectangle_smoke.png", cv2.IMREAD_COLOR)
	if check.empty() then
		return 4
	end

	return 42
end
