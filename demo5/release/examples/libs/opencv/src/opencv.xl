#loadlib "../bin/opencv_world4130.dll"
#loadlib "../bin/opencv_xlang.dll"

extern "opencv_available_native" func opencv_available_native() as int
extern "opencv_backend_native" func opencv_backend_native() as string
extern "opencv_last_error_native" func opencv_last_error_native() as string
extern "opencv_imread_native" func opencv_imread_native(string path, int flags) as point
extern "opencv_imwrite_native" func opencv_imwrite_native(string path, point image) as int
extern "opencv_resize_native" func opencv_resize_native(point image, int width, int height) as point
extern "opencv_crop_native" func opencv_crop_native(point image, int x, int y, int width, int height) as point
extern "opencv_rotate180_native" func opencv_rotate180_native(point image) as point
extern "opencv_capture_rect_native" func opencv_capture_rect_native(int x, int y, int width, int height) as point
extern "opencv_capture_window_native" func opencv_capture_window_native(point hwnd) as point
extern "opencv_cvt_color_native" func opencv_cvt_color_native(point image, int code) as point
extern "opencv_copy_make_border_native" func opencv_copy_make_border_native(point image, int top, int bottom, int left, int right, int border_type, float value0, float value1, float value2, float value3) as point
extern "opencv_rectangle_native" func opencv_rectangle_native(point image, int x1, int y1, int x2, int y2, float value0, float value1, float value2, float value3, int thickness) as point
extern "opencv_normalize_native" func opencv_normalize_native(point image, float scale, float mean0, float mean1, float mean2, float std0, float std1, float std2) as point
extern "opencv_to_chw_tensor_json_native" func opencv_to_chw_tensor_json_native(point image, float scale, float mean0, float mean1, float mean2, float std0, float std1, float std2) as string
extern "opencv_width_native" func opencv_width_native(point image) as int
extern "opencv_height_native" func opencv_height_native(point image) as int
extern "opencv_channels_native" func opencv_channels_native(point image) as int
extern "opencv_release_native" func opencv_release_native(point image) as int

export const int IMREAD_GRAYSCALE = 0
export const int IMREAD_COLOR = 1
export const int IMREAD_UNCHANGED = -1

export const int COLOR_BGR2GRAY = 6
export const int COLOR_GRAY2BGR = 8
export const int COLOR_BGR2RGB = 4
export const int COLOR_RGB2BGR = 4

export const int BORDER_CONSTANT = 0
export const int BORDER_REPLICATE = 1
export const int BORDER_REFLECT = 2
export const int BORDER_WRAP = 3
export const int BORDER_REFLECT_101 = 4
export const int BORDER_DEFAULT = 4

class Image extends object
	nocopy
	var handle as point

	create(point handle)
		self.handle = handle
	end

	destroy()
		if self.handle != null then
			opencv_release_native(self.handle)
		end
	end

	func empty() as bool
		return self.handle == null
	end

	func ok() as bool
		return self.handle != null
	end

	func valid() as bool
		return self.handle != null
	end

	func error() as string
		return opencv_last_error_native()
	end

	func width() as int
		return opencv_width_native(self.handle)
	end

	func height() as int
		return opencv_height_native(self.handle)
	end

	func channels() as int
		return opencv_channels_native(self.handle)
	end

	func resize(int width, int height) as Image
		return Image(opencv_resize_native(self.handle, width, height))
	end

	func crop(int x, int y, int width, int height) as Image
		return Image(opencv_crop_native(self.handle, x, y, width, height))
	end

	func rotate180() as Image
		return Image(opencv_rotate180_native(self.handle))
	end

	func cvtColor(int code) as Image
		return Image(opencv_cvt_color_native(self.handle, code))
	end

	func copyMakeBorder(int top, int bottom, int left, int right, int border_type, float value0, float value1, float value2, float value3) as Image
		return Image(opencv_copy_make_border_native(self.handle, top, bottom, left, right, border_type, value0, value1, value2, value3))
	end

	func rectangle(int x1, int y1, int x2, int y2, float value0, float value1, float value2, float value3, int thickness) as Image
		return Image(opencv_rectangle_native(self.handle, x1, y1, x2, y2, value0, value1, value2, value3, thickness))
	end

	func normalize(float scale, float mean0, float mean1, float mean2, float std0, float std1, float std2) as Image
		return Image(opencv_normalize_native(self.handle, scale, mean0, mean1, mean2, std0, std1, std2))
	end

	func toCHWTensorJson(float scale, float mean0, float mean1, float mean2, float std0, float std1, float std2) as string
		return opencv_to_chw_tensor_json_native(self.handle, scale, mean0, mean1, mean2, std0, std1, std2)
	end

	func save(string path) as bool
		return opencv_imwrite_native(path, self.handle) != 0
	end
end

func available() as bool
	return opencv_available_native() != 0
end

func backend() as string
	return opencv_backend_native()
end

func last_error() as string
	return opencv_last_error_native()
end

func imread(string path) as Image
	return Image(opencv_imread_native(path, IMREAD_COLOR))
end

func imread(string path, int flags) as Image
	return Image(opencv_imread_native(path, flags))
end

func resize(Image image, int width, int height) as Image
	return image.resize(width, height)
end

func crop(Image image, int x, int y, int width, int height) as Image
	return image.crop(x, y, width, height)
end

func rotate180(Image image) as Image
	return image.rotate180()
end

func capture_rect(int x, int y, int width, int height) as Image
	return Image(opencv_capture_rect_native(x, y, width, height))
end

func capture_window(point hwnd) as Image
	return Image(opencv_capture_window_native(hwnd))
end

func imwrite(string path, Image image) as bool
	return image.save(path)
end

func cvtColor(Image image, int code) as Image
	return image.cvtColor(code)
end

func copyMakeBorder(Image image, int top, int bottom, int left, int right, int border_type) as Image
	return image.copyMakeBorder(top, bottom, left, right, border_type, 0, 0, 0, 0)
end

func copyMakeBorder(Image image, int top, int bottom, int left, int right, int border_type, float value0, float value1, float value2, float value3) as Image
	return image.copyMakeBorder(top, bottom, left, right, border_type, value0, value1, value2, value3)
end

func rectangle(Image image, int x1, int y1, int x2, int y2, float value0, float value1, float value2) as Image
	return image.rectangle(x1, y1, x2, y2, value0, value1, value2, 0, 1)
end

func rectangle(Image image, int x1, int y1, int x2, int y2, float value0, float value1, float value2, int thickness) as Image
	return image.rectangle(x1, y1, x2, y2, value0, value1, value2, 0, thickness)
end

func normalize(Image image, float scale, float mean0, float mean1, float mean2, float std0, float std1, float std2) as Image
	return image.normalize(scale, mean0, mean1, mean2, std0, std1, std2)
end

func toCHWTensorJson(Image image, float scale, float mean0, float mean1, float mean2, float std0, float std1, float std2) as string
	return image.toCHWTensorJson(scale, mean0, mean1, mean2, std0, std1, std2)
end

export available
export backend
export last_error
export imread
export imwrite
export resize
export crop
export rotate180
export capture_rect
export capture_window
export cvtColor
export copyMakeBorder
export rectangle
export normalize
export toCHWTensorJson
