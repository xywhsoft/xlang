extern "pkg_mixed_probe" func native_probe() as int
extern "pkg_mixed_add" func native_add(int left, int right) as int
extern "pkg_mixed_com_ready" func native_com_ready() as bool

func probe() as int
	return native_probe()
end

func add(int left, int right) as int
	return native_add(left, right)
end

func com_ready() as bool
	return native_com_ready()
end
