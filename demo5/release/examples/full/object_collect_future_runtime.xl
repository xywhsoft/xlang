import std.object
import std.task

class Node extends object
end

async func hold(Node self) as int
	await task.delay(1)
	return 1
end

async func main() as int
	var owner = Node()
	var weak = std.object.weak(owner)
	task pending = hold(owner)
	owner["pending"] = pending

	if not std.object.alive(weak)
		return 1
	end
	if std.object.collect() != 0
		return 2
	end

	await pending
	owner = null
	std.object.collect()
	if std.object.alive(weak)
		return 3
	end

	std.object.release(weak)
	return 42
end
