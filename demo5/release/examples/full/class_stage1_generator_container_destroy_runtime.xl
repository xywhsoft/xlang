var int copies = 0
var int destroys = 0

class GenItem extends object
	var value as int

	create(int value)
		self.value = value
	end

	destroy()
		destroys = destroys + 1
	end

	func copy() as GenItem
		copies = copies + 1
		return GenItem(self.value)
	end
end

func make_values() as int
	auto item = GenItem(10)
	auto values = [item]
	yield item.value
	return 0
end

func main() as int
	auto gen = make_values()
	auto ok1, value1 = gen.next()
	auto ok2, value2 = gen.next()
	if (not ok1) or ok2 then
		return -1
	end
	if int(value1) != 10 then
		return -2
	end
	if copies != 1 then
		return -3
	end
	if destroys != 2 then
		return -4
	end
	return int(value1) + copies * 10 + destroys
end
