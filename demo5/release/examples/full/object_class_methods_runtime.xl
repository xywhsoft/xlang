class Bag extends object
	var fixed as int
end

func main() as int
	auto bag = Bag()
	bag.fixed = 1
	bag.set("a", 41)
	if !bag.exists("a") then
		return 1
	end
	if bag.length != 2 then
		return 2
	end

	auto keys = bag.keys()
	auto values = bag.values()
	auto items = bag.items()
	if keys.length != 2 then
		return 3
	end
	if values.length != 2 then
		return 4
	end
	if items.length != 2 then
		return 5
	end
	if !bag.exists("fixed") then
		return 6
	end
	if bag.get("fixed", 0) != 1 then
		return 7
	end
	if keys[0] != "fixed" then
		return 8
	end
	if keys[1] != "a" then
		return 9
	end
	if values[0] != 1 then
		return 10
	end
	if values[1] != 41 then
		return 11
	end
	if bag["a"] != 41 then
		return 12
	end
	if !bag.remove("a") then
		return 13
	end
	if bag.length != 1 then
		return 14
	end
	bag.set("b", 8)
	bag.clear()
	if bag.length != 1 then
		return 15
	end
	return bag.fixed + 47
end
