func main() as int
	var list<float> values = list<float>{1, 2.5}
	var set<float> flags = set<float>{1, 2.5}
	var dict<float> scores = dict<float>{"first": 1, "second": 2.5}

	if values[0] < 0.9 or values[0] > 1.1 then
		return 1
	end
	if not (1.0 in flags) then
		return 2
	end
	if scores["first"] < 0.9 or scores["first"] > 1.1 then
		return 3
	end
	return 42
end
