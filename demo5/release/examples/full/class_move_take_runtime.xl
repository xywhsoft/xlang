import std.core

class Handle
	var value as int

	create(int v)
		self.value = v
	end

	destroy()
		self.value = 0
	end
end

func main() as int
	var array<Handle> items = [move(Handle(11)), move(Handle(13))]
	var dict<Handle> lookup = {"a": move(Handle(17))}
	auto first = items.take(0)
	auto last = items.pop()
	auto named = lookup.take("a")
	return first.value + last.value + named.value + items.length + lookup.length
end
