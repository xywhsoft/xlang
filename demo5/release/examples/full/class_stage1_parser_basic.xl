class Vec2 extends object
	var x as float
	var y as float

	union Data
		var i as int
		var p as point
	end

	create()
		self.x = 0.0
		self.y = 0.0
	end

	create(float x, float y)
		self.x = x
		self.y = y
	end

	destroy()
		self.x = 0.0
	end

	func length() as float
		return self.x + self.y
	end
end
