import std.object

class Node extends object
	var n as int

	create(int value)
		self.n = value
	end
end

func main() as int
	Node node = Node(42)
	if std.object.refcount(node) != 1
		return 1
	end
	if not std.object.unique(node)
		return 2
	end

	Node alias = node
	if std.object.refcount(node) != 2
		return 3
	end
	if std.object.unique(node)
		return 4
	end

	return 42
end
