var int copies = 0
var int destroys = 0

class SetClearBox extends object
	var value as int

	create(int value)
		self.value = value
	end

	destroy()
		destroys = destroys + 1
	end

	func copy() as SetClearBox
		copies = copies + 1
		return SetClearBox(self.value)
	end
end

func main() as int
	auto a = SetClearBox(10)
	auto values = set{a}

	values.clear()

	if copies != 1 then
		return 1
	end
	if destroys != 1 then
		return 2
	end
	return copies * 10 + destroys + values.len()
end
