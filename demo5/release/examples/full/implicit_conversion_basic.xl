func take_float(float value) as int
	return 10
end

func pick(int value) as int
	return 1
end

func pick(float value) as int
	return 2
end

func default_float(float value = 7) as int
	return 30
end

func return_float() as float
	return 3
end

func main() as int
	float local = 1
	float mixed = 1 + 2.5
	float chosen = true ? 1 : 2.5
	local = 2
	if mixed <= 3.0
		return 0
	end
	if chosen < 1.0
		return 0
	end
	return take_float(1) + pick(1) + default_float() + take_float(return_float())
end
