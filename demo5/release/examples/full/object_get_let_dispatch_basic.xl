class Base extends object
	get value() as int
		return 1
	end

	let value(int next)
	end
end

class Child extends Base
	var score as int

	create()
		self.score = 0
	end

	get value() as int
		return self.score
	end

	let value(int next)
		self.score = next
	end
end

func main() as int
	Base item = Child()
	item.value = 42
	return item.value
end
