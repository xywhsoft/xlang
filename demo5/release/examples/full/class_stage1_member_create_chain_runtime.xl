class InnerSeed extends object
	var value as int

	create()
		self.value = 11
	end
end

class OuterSeed extends object
	var inner as InnerSeed
	var value as int

	create(int value)
		self.value = value
	end
end

func main() as int
	auto outer = OuterSeed(31)
	return outer.inner.value + outer.value
end
