#loadlib "../xle_native/packages/pkg.probe/bin/pkg_probe.dll"

extern "pkg_clock_artifact_point_slot" var probe_point as point
extern "pkg_clock_artifact_point_sentinel" func sentinel_payload() as point
extern "pkg_clock_artifact_bool_score" func point_score(point p) as int

custom Token
	create()
		self.payload = sentinel_payload()
	end

	destroy()
		probe_point = self.payload
	end
end

func capture_release() as void
	auto token = Token()
	if point_score(token.payload) != 7 then
		probe_point = point(null)
	end
end

func main() as int
	probe_point = point(null)
	auto token = Token()
	delete token
	if point_score(probe_point) != 7 then
		return 1
	end

	probe_point = point(null)
	capture_release()
	if point_score(probe_point) != 7 then
		return 2
	end

	return 42
end
