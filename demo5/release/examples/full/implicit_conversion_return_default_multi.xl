func ret_float() as float
	return 1
end

func default_float(float value = 1) as float
	return value
end

func pair() as float, string
	return 1, "ok"
end

func take_float(float value) as int
	return 17
end

func main() as int
	float a = ret_float()
	float b = default_float()
	auto c, text = pair()
	if text != "ok"
		return 1
	end
	return take_float(a) + take_float(b) + take_float(c)
end
