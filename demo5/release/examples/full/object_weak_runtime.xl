import std.object

class Node extends object
	var n as int

	create(int value)
		self.n = value
	end

	func get() as int
		return self.n
	end
end

func lock_ok(point ref) as bool
	var live = std.object.lock(ref)
	return true
end

func make_weak(Node node) as point
	return std.object.weak(node)
end

func main() as int
	Node node = Node(42)
	var ref = make_weak(node)

	if not std.object.alive(ref)
		return 1
	end
	if not lock_ok(ref)
		return 2
	end

	std.object.release(ref)
	return 42
end
