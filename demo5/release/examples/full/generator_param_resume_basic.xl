func make_values() as int
	auto current = int((yield 1))
	yield current + 1
	return 0
end

func take(generator g) as int
	auto ok1, value1 = g.next()
	auto ok2, value2 = g.resume(7)
	if (not ok1) or (not ok2)
		return -1
	end
	return int(value1) + int(value2)
end

func main() as int
	return take(make_values())
end
