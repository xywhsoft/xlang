class BaseBox extends object
	func score() as int
		return 1
	end
end

class ChildBox extends BaseBox
	func score() as int
		return 41
	end
end

func take_base(BaseBox value) as int
	return value.score()
end

func make_base() as BaseBox
	auto value = ChildBox()
	return value
end

func main() as int
	auto child = ChildBox()
	BaseBox base = child
	return base.score() + take_base(child) + make_base().score() - 82
end
