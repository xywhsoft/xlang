import std.task

func choose_nested_post(task left, task mid, task right, int outer_steps, int inner_steps, bool pick_right, bool keep_mid) as task
	task result = left
	int outer = 0
	while outer < outer_steps do
		outer = outer + 1
		int inner = 0
		while inner < inner_steps do
			inner = inner + 1
			if outer == 1 and inner == 1 then
				continue
			end
			result = pick_right ? right : mid
			if outer == outer_steps and inner == inner_steps then
				break
			end
		end
	end
	result = keep_mid ? mid : result
	return result
end

func relay_first(task value, bool use_mid) as task
	task current = value
	if use_mid then
		current = task.delay(10)
	end
	return current
end

func relay_second(task value, bool use_fallback) as task
	task current = value
	if use_fallback then
		current = task.delay(1)
	end
	return current
end

func relay_shared(task value, bool prefer_delay) as task
	task current = value
	if prefer_delay then
		current = relay_second(current, false)
	else
		current = relay_first(current, false)
	end
	return current
end

func route_branch_shared(task value, bool prefer_first, bool use_shared_delay) as task
	task branched = prefer_first ? relay_first(value, false) : relay_second(value, false)
	task merged = relay_shared(branched, use_shared_delay)
	return merged
end

async func main() as int
	task computed = choose_nested_post(task.delay(1), task.delay(10), task.delay(41), 2, 2, true, false)
	return await route_branch_shared(computed, true, false) + 1
end
