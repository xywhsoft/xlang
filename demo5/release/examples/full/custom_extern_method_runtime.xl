#loadlib "../xle_native/packages/pkg.probe/bin/pkg_probe.dll"

extern "pkg_clock_artifact_point_sentinel" func sentinel_payload() as point

custom Token
	create()
		self.payload = sentinel_payload()
	end

	extern "pkg_clock_artifact_bool_score" func score() as int
end

func main() as int
	auto token = Token()
	return token.score() + 35
end
