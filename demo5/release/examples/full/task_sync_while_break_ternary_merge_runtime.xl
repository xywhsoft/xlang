import std.task

func choose_loop_break(task left, task mid, task right, int steps, bool pick_right) as task
	task result = left
	int i = 0
	while i < steps do
		result = pick_right ? right : mid
		if i == 0 then
			break
		end
		i = i + 1
	end
	return result
end

async func main() as int
	return await choose_loop_break(task.delay(1), task.delay(10), task.delay(41), 2, true) + 1
end
