import std.task

func choose_nested(task left, task mid, task right, bool pick_mid, bool pick_right) as task
	task result = left
	if pick_mid
		result = mid
		if pick_right
			result = right
		end
	end
	return result
end

async func main() as int
	return await choose_nested(task.delay(1), task.delay(10), task.delay(41), true, true) + 1
end
