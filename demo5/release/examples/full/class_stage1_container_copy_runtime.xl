var int copies = 0

class CopyBox extends object
	var value as int

	create(int value)
		self.value = value
	end

	func copy() as CopyBox
		copies = copies + 1
		return CopyBox(self.value)
	end
end

func main() as int
	auto a = CopyBox(30)
	auto items = [a]
	CopyBox b = items[0]
	return b.value + copies
end
