func main() as int
	for outer in range(1, 4)
		for inner in range(1, 4)
			if outer == 1 then
				if inner == 2 then
					return 11
				end
				continue 2
			end

			if outer == 2 then
				if inner == 2 then
					break 2
				end
			end

			if outer == 3 then
				return 33
			end
		end
	end

	return 22
end
