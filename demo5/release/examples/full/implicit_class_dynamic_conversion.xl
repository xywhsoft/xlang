class DynBox extends object
	var value as int
end

func take_any(any value) as int
	if Type(value) != DynBox then
		return 1
	end
	return 10
end

func take_var(var value) as int
	if Type(value) != DynBox then
		return 2
	end
	return 20
end

func main() as int
	auto box = DynBox()
	box.value = 12

	any any_value = box
	var var_value = box
	if Type(any_value) != DynBox then
		return 3
	end
	if Type(var_value) != DynBox then
		return 4
	end
	return take_any(box) + take_var(box) + box.value
end
