#loadlib "../xlp_native/packages/pkg.probe/bin/pkg_probe.dll"

custom Token
	extern "pkg_clock_artifact_point_create" create()
	extern "pkg_clock_artifact_point_release" destroy()
	extern "pkg_clock_artifact_point_score" func score() as int
end

func main() as int
	auto token = Token()
	var v = token
	if v.score() != 7 then
		return 1
	end
	return v.score() + 35
end
