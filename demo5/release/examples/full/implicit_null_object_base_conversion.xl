func take_object(object value) as int
	if value != null then
		return 1
	end
	return 10
end

func make_object() as object
	return null
end

func main() as int
	object value = null
	if value != null then
		return 2
	end
	if make_object() != null then
		return 3
	end
	return take_object(null) + 32
end
