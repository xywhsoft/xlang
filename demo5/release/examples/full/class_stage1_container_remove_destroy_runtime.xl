var int copies = 0
var int destroys = 0

class RemBox extends object
	var value as int

	create(int value)
		self.value = value
	end

	destroy()
		destroys = destroys + 1
	end

	func copy() as RemBox
		copies = copies + 1
		return RemBox(self.value)
	end
end

func main() as int
	auto a = RemBox(10)
	auto items = [a]
	auto sparse = list{a}
	auto lookup = {"x": a}

	if not items.remove(0) then
		return 1
	end
	if not sparse.remove(0) then
		return 2
	end
	if not lookup.remove("x") then
		return 3
	end
	if copies != 3 then
		return 4
	end
	if destroys != 3 then
		return 5
	end
	return copies * 10 + destroys + items.len() + sparse.len() + lookup.len()
end
