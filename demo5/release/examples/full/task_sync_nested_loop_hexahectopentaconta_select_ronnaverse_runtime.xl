import std.task

func choose_nested_post(task left, task mid, task right, int outer_steps, int inner_steps, bool pick_right, bool keep_mid) as task
	task result = left
	int outer = 0
	while outer < outer_steps do
		outer = outer + 1
		int inner = 0
		while inner < inner_steps do
			inner = inner + 1
			if outer == 1 and inner == 1 then
				continue
			end
			result = pick_right ? right : mid
			if outer == outer_steps and inner == inner_steps then
				break
			end
		end
	end
	result = keep_mid ? mid : result
	return result
end

func relay_first(task value, bool use_mid) as task
	task current = value
	if use_mid then
		current = task.delay(10)
	end
	return current
end

func relay_second(task value, bool use_fallback) as task
	task current = value
	if use_fallback then
		current = task.delay(1)
	end
	return current
end

func relay_shared(task value, bool prefer_delay) as task
	task current = value
	if prefer_delay then
		current = relay_second(current, false)
	else
		current = relay_first(current, false)
	end
	return current
end

func route_hexahectopentaconta_select(task value, bool choose_left, bool choose_delayed, bool choose_shared_delay, bool choose_final_delay, bool choose_alternate_delay, bool choose_merge_shared, bool choose_branch_second, bool choose_tail_shared, bool choose_last_second, bool choose_end_shared, bool choose_closing_second, bool choose_terminal_shared, bool choose_tail_second, bool choose_final_shared, bool choose_closure_second, bool choose_settled_shared, bool choose_anchor_second, bool choose_vector_shared, bool choose_matrix_second, bool choose_tensor_shared, bool choose_signal_second, bool choose_pulse_shared, bool choose_beacon_second, bool choose_orbit_shared, bool choose_flare_second, bool choose_glow_shared, bool choose_spark_second, bool choose_aura_shared, bool choose_halo_second, bool choose_radiant_shared, bool choose_prism_second, bool choose_lumen_shared, bool choose_nova_second, bool choose_quasar_shared, bool choose_nebula_second, bool choose_galaxy_shared, bool choose_cosmos_second, bool choose_universe_shared, bool choose_multiverse_second, bool choose_omniverse_shared, bool choose_hyperverse_second, bool choose_metaverse_shared, bool choose_ultraverse_second, bool choose_megaverse_shared, bool choose_gigaverse_second, bool choose_teraverse_shared, bool choose_extraverse_second, bool choose_superverse_shared, bool choose_macroverse_second, bool choose_microverse_shared, bool choose_nanoverse_second, bool choose_picoverse_shared, bool choose_femtoverse_second, bool choose_attovers_shared, bool choose_zeptoverse_second, bool choose_yoctoverse_shared, bool choose_xenoverse_second, bool choose_zettaverse_shared, bool choose_ronnaverse_second) as task
	task left_path = relay_first(value, false)
	task right_path = relay_second(value, false)
	task first_pick = choose_left ? left_path : right_path
	task delayed_pick = choose_delayed ? task.delay(41) : first_pick
	task shared_pick = relay_shared(delayed_pick, choose_shared_delay)
	task final_pick = choose_final_delay ? relay_second(shared_pick, false) : relay_first(shared_pick, false)
	task alternate_pick = choose_alternate_delay ? task.delay(41) : final_pick
	task merged_pick = choose_merge_shared ? relay_shared(alternate_pick, false) : relay_first(alternate_pick, false)
	task branch_pick = choose_branch_second ? relay_second(merged_pick, false) : relay_first(merged_pick, false)
	task tail_pick = choose_tail_shared ? relay_shared(branch_pick, false) : branch_pick
	task last_pick = choose_last_second ? relay_second(tail_pick, false) : relay_first(tail_pick, false)
	task end_pick = choose_end_shared ? relay_shared(last_pick, false) : last_pick
	task closing_pick = choose_closing_second ? relay_second(end_pick, false) : relay_shared(end_pick, false)
	task terminal_pick = choose_terminal_shared ? relay_shared(closing_pick, false) : relay_first(closing_pick, false)
	task tail_result = choose_tail_second ? relay_second(terminal_pick, false) : relay_shared(terminal_pick, false)
	task final_result = choose_final_shared ? relay_shared(tail_result, false) : relay_second(tail_result, false)
	task closure_pick = choose_closure_second ? relay_second(final_result, false) : relay_shared(final_result, false)
	task settled_pick = choose_settled_shared ? relay_shared(closure_pick, false) : relay_second(closure_pick, false)
	task anchor_pick = choose_anchor_second ? relay_second(settled_pick, false) : relay_shared(settled_pick, false)
	task vector_pick = choose_vector_shared ? relay_shared(anchor_pick, false) : relay_first(anchor_pick, false)
	task matrix_pick = choose_matrix_second ? relay_second(vector_pick, false) : relay_shared(vector_pick, false)
	task tensor_pick = choose_tensor_shared ? relay_shared(matrix_pick, false) : relay_first(matrix_pick, false)
	task signal_pick = choose_signal_second ? relay_second(tensor_pick, false) : relay_shared(tensor_pick, false)
	task pulse_pick = choose_pulse_shared ? relay_shared(signal_pick, false) : relay_first(signal_pick, false)
	task beacon_pick = choose_beacon_second ? relay_second(pulse_pick, false) : relay_shared(pulse_pick, false)
	task orbit_pick = choose_orbit_shared ? relay_shared(beacon_pick, false) : relay_first(beacon_pick, false)
	task flare_pick = choose_flare_second ? relay_second(orbit_pick, false) : relay_shared(orbit_pick, false)
	task glow_pick = choose_glow_shared ? relay_shared(flare_pick, false) : relay_first(flare_pick, false)
	task spark_pick = choose_spark_second ? relay_second(glow_pick, false) : relay_shared(glow_pick, false)
	task aura_pick = choose_aura_shared ? relay_shared(spark_pick, false) : relay_first(spark_pick, false)
	task halo_pick = choose_halo_second ? relay_second(aura_pick, false) : relay_shared(aura_pick, false)
	task radiant_pick = choose_radiant_shared ? relay_shared(halo_pick, false) : relay_first(halo_pick, false)
	task prism_pick = choose_prism_second ? relay_second(radiant_pick, false) : relay_shared(radiant_pick, false)
	task lumen_pick = choose_lumen_shared ? relay_shared(prism_pick, false) : relay_first(prism_pick, false)
	task nova_pick = choose_nova_second ? relay_second(lumen_pick, false) : relay_shared(lumen_pick, false)
	task quasar_pick = choose_quasar_shared ? relay_shared(nova_pick, false) : relay_first(nova_pick, false)
	task nebula_pick = choose_nebula_second ? relay_second(quasar_pick, false) : relay_shared(quasar_pick, false)
	task galaxy_pick = choose_galaxy_shared ? relay_shared(nebula_pick, false) : relay_first(nebula_pick, false)
	task cosmos_pick = choose_cosmos_second ? relay_second(galaxy_pick, false) : relay_shared(galaxy_pick, false)
	task universe_pick = choose_universe_shared ? relay_shared(cosmos_pick, false) : relay_first(cosmos_pick, false)
	task multiverse_pick = choose_multiverse_second ? relay_second(universe_pick, false) : relay_shared(universe_pick, false)
	task omniverse_pick = choose_omniverse_shared ? relay_shared(multiverse_pick, false) : relay_first(multiverse_pick, false)
	task hyperverse_pick = choose_hyperverse_second ? relay_second(omniverse_pick, false) : relay_shared(omniverse_pick, false)
	task metaverse_pick = choose_metaverse_shared ? relay_shared(hyperverse_pick, false) : relay_first(hyperverse_pick, false)
	task ultraverse_pick = choose_ultraverse_second ? relay_second(metaverse_pick, false) : relay_shared(metaverse_pick, false)
	task megaverse_pick = choose_megaverse_shared ? relay_shared(ultraverse_pick, false) : relay_first(ultraverse_pick, false)
	task gigaverse_pick = choose_gigaverse_second ? relay_second(megaverse_pick, false) : relay_shared(megaverse_pick, false)
	task teraverse_pick = choose_teraverse_shared ? relay_shared(gigaverse_pick, false) : relay_first(gigaverse_pick, false)
	task extraverse_pick = choose_extraverse_second ? relay_second(teraverse_pick, false) : relay_shared(teraverse_pick, false)
	task superverse_pick = choose_superverse_shared ? relay_shared(extraverse_pick, false) : relay_first(extraverse_pick, false)
	task macroverse_pick = choose_macroverse_second ? relay_second(superverse_pick, false) : relay_shared(superverse_pick, false)
	task microverse_pick = choose_microverse_shared ? relay_shared(macroverse_pick, false) : relay_first(macroverse_pick, false)
	task nanoverse_pick = choose_nanoverse_second ? relay_second(microverse_pick, false) : relay_shared(microverse_pick, false)
	task picoverse_pick = choose_picoverse_shared ? relay_shared(nanoverse_pick, false) : relay_first(nanoverse_pick, false)
	task femtoverse_pick = choose_femtoverse_second ? relay_second(picoverse_pick, false) : relay_shared(picoverse_pick, false)
	task attovers_pick = choose_attovers_shared ? relay_shared(femtoverse_pick, false) : relay_first(femtoverse_pick, false)
	task zeptoverse_pick = choose_zeptoverse_second ? relay_second(attovers_pick, false) : relay_shared(attovers_pick, false)
	task yoctoverse_pick = choose_yoctoverse_shared ? relay_shared(zeptoverse_pick, false) : relay_first(zeptoverse_pick, false)
	task xenoverse_pick = choose_xenoverse_second ? relay_second(yoctoverse_pick, false) : relay_shared(yoctoverse_pick, false)
	task zettaverse_pick = choose_zettaverse_shared ? relay_shared(xenoverse_pick, false) : relay_first(xenoverse_pick, false)
	task ronnaverse_pick = choose_ronnaverse_second ? relay_second(zettaverse_pick, false) : relay_shared(zettaverse_pick, false)
	return ronnaverse_pick
end

async func main() as int
	task computed = choose_nested_post(task.delay(1), task.delay(10), task.delay(41), 2, 2, true, false)
	return await route_hexahectopentaconta_select(computed, false, false, false, false, false, true, true, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, true, false, true, false, true, false) + 1
end
