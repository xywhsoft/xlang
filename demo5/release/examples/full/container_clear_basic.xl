func main() as int
	array values = [1, 2]
	list items = list{3, 4}
	set flags = set{5, 6}
	dict pairs = dict{"a": 1, "b": 2}
	int total = 0

	values.clear()
	items.clear()
	flags.clear()
	pairs.clear()

	values.append(7)
	items.append(8)

	if not flags.has(5) then
		total += 10
	end
	if not pairs.has("a") then
		total += 20
	end

	return total + values.len() + items.len() + flags.len() + pairs.len() + values[0] + items[0]
end
