import std.object

class Node extends object
end

func make_cycle() as array<point>
	var a = Node()
	var b = Node()
	var wa = std.object.weak(a)
	var wb = std.object.weak(b)

	a.peer = b
	b.peer = a

	return [wa, wb]
end

func main() as int
	var refs = make_cycle()
	var wa = refs[0]
	var wb = refs[1]

	if not std.object.alive(wa)
		return 1
	end
	if not std.object.alive(wb)
		return 2
	end
	if std.object.collect() != 2
		return 3
	end
	if std.object.alive(wa)
		return 4
	end
	if std.object.alive(wb)
		return 5
	end

	std.object.release(wa)
	std.object.release(wb)
	return 42
end
