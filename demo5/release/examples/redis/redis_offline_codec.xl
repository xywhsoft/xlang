import std.net.tcp as tcp
import std.fmt as fmt
import x.redis as redis

func main() as int
	if redis.OK != 0 or redis.ERR != 1 or redis.TIMEOUT != 2 or redis.CLOSED != 3 or redis.PROTOCOL_ERROR != 4
		return 1
	end
	if redis.resp_encode1("PING") != "*1\r\n$4\r\nPING\r\n"
		return 2
	end
	if redis.resp_encode3("SET", "name", "Ada") != "*3\r\n$3\r\nSET\r\n$4\r\nname\r\n$3\r\nAda\r\n"
		return 3
	end
	if redis.resp_encode2("ECHO", "") != "*2\r\n$4\r\nECHO\r\n$0\r\n\r\n"
		return 4
	end
	if redis.resp_encode_array(list{"SET", "name", "Ada"}) != "*3\r\n$3\r\nSET\r\n$4\r\nname\r\n$3\r\nAda\r\n"
		return 5
	end
	if redis.resp_encode_json("[\"PING\"]") != "*1\r\n$4\r\nPING\r\n"
		return 6
	end
	if redis.resp_encode_pipeline_json("[[\"PING\"],[\"GET\",\"name\"]]") != "*1\r\n$4\r\nPING\r\n*2\r\n$3\r\nGET\r\n$4\r\nname\r\n"
		return 7
	end
	if redis.argv_json3("SET", "quote", "a\"b") != "[\"SET\",\"quote\",\"a\\\"b\"]"
		return 8
	end
	if redis.pipeline_json2(redis.argv_json1("PING"), redis.argv_json2("GET", "name")) != "[[\"PING\"],[\"GET\",\"name\"]]"
		return 9
	end
	var array<string> pipeline_commands = [
		redis.argv_json3("SET", "name", "Ada"),
		redis.argv_json2("GET", "name")
	]
	if redis.resp_encode_pipeline_json(redis.pipeline_json_array(pipeline_commands)) != "*3\r\n$3\r\nSET\r\n$4\r\nname\r\n$3\r\nAda\r\n*2\r\n$3\r\nGET\r\n$4\r\nname\r\n"
		return 10
	end
	if redis.transport_name() != "std.net.tcp"
		return 130
	end
	if redis.transport_binary_safe() == true or redis.transport_tls() == true
		return 131
	end
	if redis.transport_limits_json() != "{\"transport\":\"std.net.tcp\",\"binary_safe\":false,\"tls\":false,\"connect_timeout\":false,\"reason\":\"std.net.tcp send and recv expose string-oriented APIs\"}"
		return 132
	end
	if redis.sentinel_capabilities_json().contains("\"background_monitoring\":false") == false
		return 133
	end
	if redis.cluster_capabilities_json().contains("\"transparent_cross_node_routing\":false") == false
		return 134
	end

	if redis.parse_response_json("+OK\r\n") != "{\"type\":\"simple\",\"value\":\"OK\"}"
		return 11
	end
	if redis.parse_response_json("-ERR bad\r\n") != "{\"type\":\"error\",\"value\":\"ERR bad\"}"
		return 12
	end
	if redis.response_error(redis.parse_response_json("-ERR bad\r\n")) == false or redis.response_error_text(redis.parse_response_json("-ERR bad\r\n")) != "ERR bad"
		return 110
	end
	auto ok_response = redis.parse_response_json("+OK\r\n")
	if redis.response_type(ok_response) != "simple" or redis.response_value(ok_response) != "OK" or redis.response_ok(ok_response) == false
		return 101
	end
	if redis.parse_response_json(":12\r\n") != "{\"type\":\"integer\",\"value\":12}"
		return 13
	end
	if redis.response_int(redis.parse_response_json(":12\r\n")) != 12
		return 102
	end
	if redis.parse_response_json("$5\r\nhello\r\n") != "{\"type\":\"bulk\",\"value\":\"hello\",\"nil\":false}"
		return 14
	end
	if redis.parse_response_json("$-1\r\n") != "{\"type\":\"bulk\",\"value\":\"\",\"nil\":true}"
		return 15
	end
	if redis.response_nil(redis.parse_response_json("$-1\r\n")) == false
		return 103
	end
	if redis.parse_response_json("*2\r\n$3\r\nfoo\r\n$3\r\nbar\r\n") != "{\"type\":\"array\",\"items\":[{\"type\":\"bulk\",\"value\":\"foo\",\"nil\":false},{\"type\":\"bulk\",\"value\":\"bar\",\"nil\":false}],\"nil\":false}"
		return 16
	end
	auto array_response = redis.parse_response_json("*2\r\n$3\r\nfoo\r\n$3\r\nbar\r\n")
	if redis.response_array_length(array_response) != 2 or redis.response_array_value(array_response, 0) != "foo" or redis.response_array_value(array_response, 1) != "bar"
		return 106
	end
	if redis.parse_response_json("*-1\r\n") != "{\"type\":\"array\",\"items\":[],\"nil\":true}"
		return 114
	end
	if redis.response_nil(redis.parse_response_json("*-1\r\n")) == false
		return 115
	end
	if redis.parse_response_json("$5\r\nhelloXX") != "{\"type\":\"error\",\"value\":\"missing CRLF after bulk body\"}"
		return 17
	end
	if redis.parse_response_json("?\r\n") != "{\"type\":\"error\",\"value\":\"invalid RESP prefix: ?\"}"
		return 120
	end
	if redis.parse_response_json("_x\r\n") != "{\"type\":\"error\",\"value\":\"invalid RESP3 null\"}"
		return 121
	end
	if redis.parse_response_json("*-2\r\n") != "{\"type\":\"error\",\"value\":\"invalid array length\"}"
		return 122
	end
	if redis.parse_response_chunks_json("$5\r\nhe", "llo\r\n") != "{\"type\":\"bulk\",\"value\":\"hello\",\"nil\":false}"
		return 18
	end
	if redis.parse_response_json("$3\r\na\"b\r\n") != "{\"type\":\"bulk\",\"value\":\"a\\\"b\",\"nil\":false}"
		return 19
	end
	if redis.parse_response_json("$3\r\na\\b\r\n") != "{\"type\":\"bulk\",\"value\":\"a\\\\b\",\"nil\":false}"
		return 20
	end
	if redis.parse_response_json("_\r\n") != "{\"type\":\"null\",\"nil\":true}"
		return 88
	end
	if redis.parse_response_json("#t\r\n") != "{\"type\":\"bool\",\"value\":true}"
		return 89
	end
	if redis.response_bool(redis.parse_response_json("#t\r\n")) == false
		return 104
	end
	if redis.parse_response_json(",3.14\r\n") != "{\"type\":\"double\",\"value\":\"3.14\"}"
		return 90
	end
	if redis.response_double_text(redis.parse_response_json(",3.14\r\n")) != "3.14"
		return 105
	end
	if redis.parse_response_json("(3492890328409238509324850943850943825024385\r\n") != "{\"type\":\"bignumber\",\"value\":\"3492890328409238509324850943850943825024385\"}"
		return 91
	end
	if redis.response_bignumber_text(redis.parse_response_json("(3492890328409238509324850943850943825024385\r\n")) != "3492890328409238509324850943850943825024385"
		return 111
	end
	if redis.parse_response_json("!21\r\nSYNTAX invalid syntax\r\n") != "{\"type\":\"blob_error\",\"value\":\"SYNTAX invalid syntax\"}"
		return 92
	end
	if redis.response_blob_error_text(redis.parse_response_json("!21\r\nSYNTAX invalid syntax\r\n")) != "SYNTAX invalid syntax"
		return 112
	end
	if redis.parse_response_json("=15\r\ntxt:Some string\r\n") != "{\"type\":\"verbatim\",\"value\":\"txt:Some string\"}"
		return 93
	end
	if redis.response_verbatim_text(redis.parse_response_json("=15\r\ntxt:Some string\r\n")) != "txt:Some string"
		return 113
	end
	if redis.parse_response_json("%1\r\n+name\r\n$3\r\nAda\r\n") != "{\"type\":\"map\",\"pairs\":[{\"key\":{\"type\":\"simple\",\"value\":\"name\"},\"value\":{\"type\":\"bulk\",\"value\":\"Ada\",\"nil\":false}}],\"nil\":false}"
		return 94
	end
	auto map_response = redis.parse_response_json("%1\r\n+name\r\n$3\r\nAda\r\n")
	if redis.response_map_length(map_response) != 1 or redis.response_map_key_value(map_response, 0) != "name" or redis.response_map_value_value(map_response, 0) != "Ada"
		return 107
	end
	if redis.response_map_has_key(map_response, "name") == false or redis.response_map_value(map_response, "name") != "Ada" or redis.response_map_has_key(map_response, "missing")
		return 109
	end
	if redis.parse_response_json("%-1\r\n") != "{\"type\":\"map\",\"pairs\":[],\"nil\":true}"
		return 116
	end
	if redis.response_nil(redis.parse_response_json("%-1\r\n")) == false
		return 117
	end
	if redis.parse_response_json("%-2\r\n") != "{\"type\":\"error\",\"value\":\"invalid map length\"}"
		return 123
	end
	if redis.parse_response_json("~2\r\n+red\r\n+blue\r\n") != "{\"type\":\"set\",\"items\":[{\"type\":\"simple\",\"value\":\"red\"},{\"type\":\"simple\",\"value\":\"blue\"}],\"nil\":false}"
		return 95
	end
	auto set_response = redis.parse_response_json("~2\r\n+red\r\n+blue\r\n")
	if redis.response_set_length(set_response) != 2 or redis.response_set_value(set_response, 0) != "red" or redis.response_set_value(set_response, 1) != "blue"
		return 108
	end
	if redis.parse_response_json("~-1\r\n") != "{\"type\":\"set\",\"items\":[],\"nil\":true}"
		return 118
	end
	if redis.response_nil(redis.parse_response_json("~-1\r\n")) == false
		return 119
	end
	if redis.parse_response_json("~-2\r\n") != "{\"type\":\"error\",\"value\":\"invalid set length\"}"
		return 124
	end
	if redis.parse_response_json("!0\r\n\r\n") != "{\"type\":\"blob_error\",\"value\":\"\"}"
		return 96
	end
	if redis.parse_response_json("=0\r\n\r\n") != "{\"type\":\"verbatim\",\"value\":\"\"}"
		return 97
	end
	auto moved = redis.parse_response_json("-MOVED 12182 127.0.0.1:7002\r\n")
	if redis.cluster_redirect_type(moved) != "MOVED"
		return 110
	end
	if redis.cluster_redirect_slot(moved) != 12182
		return 111
	end
	if redis.cluster_redirect_endpoint(moved) != "127.0.0.1:7002"
		return 112
	end
	if redis.cluster_redirect_host(moved) != "127.0.0.1"
		return 113
	end
	if redis.cluster_redirect_port(moved) != 7002
		return 114
	end
	auto ask = redis.parse_response_json("-ASK 3999 redis-node.example:6381\r\n")
	if redis.cluster_redirect_type(ask) != "ASK" or redis.cluster_redirect_slot(ask) != 3999
		return 115
	end
	auto redirect_listener = tcp.listen("127.0.0.1", 0)
	if redirect_listener == null
		return 121
	end
	auto redirect_port = tcp.local_port(redirect_listener)
	auto redirect = redis.parse_response_json("-MOVED 12182 127.0.0.1:" + fmt.int_text(redirect_port, "") + "\r\n")
	auto redirect_client = redis.cluster_connect_redirect(redirect, 100)
	if redirect_client.valid() == false
		redis.close(redirect_client)
		tcp.close(redirect_listener)
		return 122
	end
	auto redirect_server = tcp.accept(redirect_listener, 1000)
	if redirect_server == null
		redis.close(redirect_client)
		tcp.close(redirect_listener)
		return 123
	end
	redis.close(redirect_client)
	tcp.close(redirect_server)
	tcp.close(redirect_listener)
	auto listener = tcp.listen("127.0.0.1", 0)
	if listener == null
		return 21
	end
	auto port = tcp.local_port(listener)
	tcp.close(listener)
	auto c = redis.connect("127.0.0.1", port, 100)
	if c.valid()
		redis.close(c)
		return 22
	end
	if redis.last_error(c).contains("tcp connect failed") == false
		return 23
	end
	auto response = redis.command1(c, "PING")
	if response.contains("redis client is closed") == false
		return 24
	end
	if redis.last_error(c) != "redis client is closed"
		return 25
	end
	if redis.close(c) != false
		return 26
	end
	auto listener2 = tcp.listen("127.0.0.1", 0)
	if listener2 == null
		return 27
	end
	auto port2 = tcp.local_port(listener2)
	auto c2 = redis.connect("127.0.0.1", port2, 100)
	if c2.valid() == false
		tcp.close(listener2)
		return 28
	end
	auto server2 = tcp.accept(listener2, 1000)
	if server2 == null
		redis.close(c2)
		tcp.close(listener2)
		return 29
	end
	tcp.send(server2, "+PONG\r\n")
	if redis.command1(c2, "PING") != "{\"type\":\"simple\",\"value\":\"PONG\"}"
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 30
	end
	tcp.send(server2, "-ERR unknown command\r\n")
	if redis.command1(c2, "XLANG_UNKNOWN_COMMAND").contains("\"type\":\"error\"") == false
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 31
	end
	if redis.last_error(c2) != "ERR unknown command"
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 32
	end
	tcp.send(server2, "+PONG\r\n")
	if redis.ping(c2) != "PONG"
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 33
	end
	tcp.send(server2, "+OK\r\n")
	if redis.select(c2, 0) == false
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 34
	end
	tcp.send(server2, "%2\r\n+proto\r\n:3\r\n+role\r\n+master\r\n")
	auto hello3 = redis.hello(c2, 3)
	if hello3.contains("\"type\":\"map\"") == false or hello3.contains("\"proto\"") == false
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 98
	end
	tcp.send(server2, "%1\r\n+proto\r\n:3\r\n")
	auto hello_auth3 = redis.hello_auth(c2, 3, "default", "secret")
	if hello_auth3.contains("\"type\":\"map\"") == false or hello_auth3.contains("\"proto\"") == false
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 99
	end
	tcp.send(server2, "*1\r\n*4\r\n$4\r\nname\r\n$8\r\nmymaster\r\n$2\r\nip\r\n$9\r\n127.0.0.1\r\n")
	if redis.sentinel_masters_json(c2).contains("mymaster") == false
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 100
	end
	tcp.send(server2, "*4\r\n$4\r\nname\r\n$8\r\nmymaster\r\n$2\r\nip\r\n$9\r\n127.0.0.1\r\n")
	if redis.sentinel_master_json(c2, "mymaster").contains("127.0.0.1") == false
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 101
	end
	tcp.send(server2, "*2\r\n$9\r\n127.0.0.1\r\n$4\r\n6379\r\n")
	auto sentinel_addr = redis.sentinel_get_master_addr_by_name_json(c2, "mymaster")
	if sentinel_addr.contains("6379") == false
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 102
	end
	if redis.sentinel_master_host(sentinel_addr) != "127.0.0.1"
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 116
	end
	if redis.sentinel_master_port(sentinel_addr) != 6379
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 117
	end
	auto master_listener = tcp.listen("127.0.0.1", 0)
	if master_listener == null
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 118
	end
	auto master_port = tcp.local_port(master_listener)
	auto master_port_text = fmt.int_text(master_port, "")
	tcp.send(server2, "*2\r\n$9\r\n127.0.0.1\r\n$" + fmt.int_text(master_port_text.length, "") + "\r\n" + master_port_text + "\r\n")
	auto master_client = redis.sentinel_connect_master(c2, "mymaster", 100)
	if master_client.valid() == false
		redis.close(master_client)
		tcp.close(master_listener)
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 119
	end
	auto master_server = tcp.accept(master_listener, 1000)
	if master_server == null
		redis.close(master_client)
		tcp.close(master_listener)
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 120
	end
	redis.close(master_client)
	tcp.close(master_server)
	tcp.close(master_listener)
	tcp.send(server2, "*1\r\n*4\r\n$4\r\nname\r\n$8\r\nreplica1\r\n$2\r\nip\r\n$9\r\n127.0.0.2\r\n")
	if redis.sentinel_replicas_json(c2, "mymaster").contains("replica1") == false
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 103
	end
	tcp.send(server2, "*1\r\n*4\r\n$4\r\nname\r\n$9\r\nsentinel1\r\n$2\r\nip\r\n$9\r\n127.0.0.3\r\n")
	if redis.sentinel_sentinels_json(c2, "mymaster").contains("sentinel1") == false
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 104
	end
	tcp.send(server2, "$27\r\ncluster_state:ok\r\nslots:1\r\n\r\n")
	if redis.cluster_info_json(c2).contains("cluster_state:ok") == false
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 105
	end
	tcp.send(server2, "$42\r\nnodeid 127.0.0.1:6379@16379 master - 0 0 1\r\n")
	if redis.cluster_nodes_json(c2).contains("nodeid") == false
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 106
	end
	tcp.send(server2, "*1\r\n*3\r\n:0\r\n:5460\r\n*2\r\n$9\r\n127.0.0.1\r\n:6379\r\n")
	auto slots_response = redis.cluster_slots_json(c2)
	if slots_response.contains("5460") == false
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 107
	end
	if redis.cluster_slots_node_host(slots_response, 42) != "127.0.0.1"
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 125
	end
	if redis.cluster_slots_node_port(slots_response, 42) != 6379
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 126
	end
	auto slot_listener = tcp.listen("127.0.0.1", 0)
	if slot_listener == null
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 127
	end
	auto slot_port = tcp.local_port(slot_listener)
	auto slot_port_text = fmt.int_text(slot_port, "")
	auto dynamic_slots = redis.parse_response_json("*1\r\n*3\r\n:0\r\n:16383\r\n*2\r\n$9\r\n127.0.0.1\r\n$" + fmt.int_text(slot_port_text.length, "") + "\r\n" + slot_port_text + "\r\n")
	auto slot_client = redis.cluster_connect_slot(dynamic_slots, 12000, 100)
	if slot_client.valid() == false
		redis.close(slot_client)
		tcp.close(slot_listener)
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 128
	end
	auto slot_server = tcp.accept(slot_listener, 1000)
	if slot_server == null
		redis.close(slot_client)
		tcp.close(slot_listener)
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 129
	end
	redis.close(slot_client)
	tcp.close(slot_server)
	tcp.close(slot_listener)
	tcp.send(server2, ":12182\r\n")
	if redis.cluster_keyslot(c2, "name") != 12182
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 108
	end
	tcp.send(server2, "$6\r\nnode42\r\n")
	if redis.cluster_myid(c2) != "node42"
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 109
	end
	tcp.send(server2, "+OK\r\n")
	if redis.cluster_asking(c2) == false
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 124
	end
	auto timeout_response = redis.command1(c2, "PING")
	if timeout_response.contains("redis receive timeout or closed connection") == false
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 35
	end
	if redis.last_error(c2) != "redis receive timeout or closed connection"
		redis.close(c2)
		tcp.close(server2)
		tcp.close(listener2)
		return 36
	end
	redis.close(c2)
	tcp.close(server2)
	tcp.close(listener2)
	auto listener3 = tcp.listen("127.0.0.1", 0)
	if listener3 == null
		return 37
	end
	auto port3 = tcp.local_port(listener3)
	auto c3 = redis.connect("127.0.0.1", port3, 100)
	if c3.valid() == false
		tcp.close(listener3)
		return 38
	end
	auto server3 = tcp.accept(listener3, 1000)
	if server3 == null
		redis.close(c3)
		tcp.close(listener3)
		return 39
	end
	tcp.send(server3, ":0\r\n")
	if redis.dbsize(c3) != 0
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 40
	end
	tcp.send(server3, "+OK\r\n")
	if redis.set(c3, "k", "Ada") == false
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 41
	end
	tcp.send(server3, "$3\r\nAda\r\n")
	if redis.get(c3, "k") != "Ada"
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 42
	end
	tcp.send(server3, ":1\r\n")
	if redis.exists(c3, "k") == false
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 43
	end
	tcp.send(server3, ":1\r\n")
	if redis.del(c3, "k") != 1
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 44
	end
	tcp.send(server3, "$-1\r\n")
	if redis.get(c3, "missing") != ""
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 45
	end
	tcp.send(server3, "$-1\r\n")
	if redis.get_or(c3, "missing", "fallback") != "fallback"
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 46
	end
	tcp.send(server3, "+OK\r\n")
	if redis.set_ex(c3, "ttl", "short", 60) == false
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 47
	end
	tcp.send(server3, ":60\r\n")
	if redis.ttl(c3, "ttl") != 60
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 48
	end
	tcp.send(server3, ":1\r\n")
	if redis.expire(c3, "ttl", 60) == false
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 49
	end
	tcp.send(server3, ":2\r\n")
	if redis.incr(c3, "n") != 2
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 50
	end
	tcp.send(server3, ":1\r\n")
	if redis.decr(c3, "n") != 1
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 51
	end
	tcp.send(server3, ":1\r\n")
	if redis.hset(c3, "h", "name", "Grace") != 1
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 52
	end
	tcp.send(server3, "$5\r\nGrace\r\n")
	if redis.hget(c3, "h", "name") != "Grace"
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 53
	end
	tcp.send(server3, ":1\r\n")
	if redis.hexists(c3, "h", "name") == false
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 54
	end
	tcp.send(server3, "*2\r\n$4\r\nname\r\n$5\r\nGrace\r\n")
	if redis.hgetall_json(c3, "h").contains("Grace") == false
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 55
	end
	tcp.send(server3, ":1\r\n")
	if redis.hdel(c3, "h", "name") != 1
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 56
	end
	tcp.send(server3, ":1\r\n")
	if redis.lpush(c3, "l", "first") != 1
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 57
	end
	tcp.send(server3, ":2\r\n")
	if redis.rpush(c3, "l", "second") != 2
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 58
	end
	tcp.send(server3, ":2\r\n")
	if redis.llen(c3, "l") != 2
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 59
	end
	tcp.send(server3, "*2\r\n$5\r\nfirst\r\n$6\r\nsecond\r\n")
	if redis.lrange_json(c3, "l", 0, -1).contains("second") == false
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 60
	end
	tcp.send(server3, "$5\r\nfirst\r\n")
	if redis.lpop(c3, "l") != "first"
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 61
	end
	tcp.send(server3, "$6\r\nsecond\r\n")
	if redis.rpop(c3, "l") != "second"
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 62
	end
	tcp.send(server3, ":1\r\n")
	if redis.sadd(c3, "s", "member") != 1
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 63
	end
	tcp.send(server3, ":1\r\n")
	if redis.sismember(c3, "s", "member") == false
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 64
	end
	tcp.send(server3, "*1\r\n$6\r\nmember\r\n")
	if redis.smembers_json(c3, "s").contains("member") == false
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 65
	end
	tcp.send(server3, ":1\r\n")
	if redis.srem(c3, "s", "member") != 1
		redis.close(c3)
		tcp.close(server3)
		tcp.close(listener3)
		return 66
	end
	redis.close(c3)
	tcp.close(server3)
	tcp.close(listener3)
	auto listener4 = tcp.listen("127.0.0.1", 0)
	if listener4 == null
		return 67
	end
	auto port4 = tcp.local_port(listener4)
	auto c4 = redis.connect("127.0.0.1", port4, 100)
	if c4.valid() == false
		tcp.close(listener4)
		return 68
	end
	auto server4 = tcp.accept(listener4, 1000)
	if server4 == null
		redis.close(c4)
		tcp.close(listener4)
		return 69
	end
	tcp.send(server4, "+OK\r\n$3\r\nAda\r\n")
	auto pipeline = redis.command_pipeline_json(c4, "[[\"SET\",\"name\",\"Ada\"],[\"GET\",\"name\"]]")
	if pipeline != "[{\"type\":\"simple\",\"value\":\"OK\"},{\"type\":\"bulk\",\"value\":\"Ada\",\"nil\":false}]"
		redis.close(c4)
		tcp.close(server4)
		tcp.close(listener4)
		return 70
	end
	if redis.command_pipeline_json(c4, "[]") != "[]"
		redis.close(c4)
		tcp.close(server4)
		tcp.close(listener4)
		return 71
	end
	redis.close(c4)
	tcp.close(server4)
	tcp.close(listener4)
	auto listener5 = tcp.listen("127.0.0.1", 0)
	if listener5 == null
		return 72
	end
	auto port5 = tcp.local_port(listener5)
	auto c5 = redis.connect("127.0.0.1", port5, 100)
	if c5.valid() == false
		tcp.close(listener5)
		return 73
	end
	auto server5 = tcp.accept(listener5, 1000)
	if server5 == null
		redis.close(c5)
		tcp.close(listener5)
		return 74
	end
	tcp.send(server5, "*3\r\n$9\r\nsubscribe\r\n$5\r\nnews1\r\n:1\r\n")
	if redis.subscribe(c5, "news1").contains("subscribe") == false
		redis.close(c5)
		tcp.close(server5)
		tcp.close(listener5)
		return 75
	end
	tcp.send(server5, "*3\r\n$7\r\nmessage\r\n$5\r\nnews1\r\n$5\r\nhello\r\n")
	if redis.read_response_json(c5).contains("hello") == false
		redis.close(c5)
		tcp.close(server5)
		tcp.close(listener5)
		return 76
	end
	tcp.send(server5, "*3\r\n$11\r\nunsubscribe\r\n$5\r\nnews1\r\n:0\r\n")
	if redis.unsubscribe(c5, "news1").contains("unsubscribe") == false
		redis.close(c5)
		tcp.close(server5)
		tcp.close(listener5)
		return 77
	end
	redis.close(c5)
	tcp.close(server5)
	tcp.close(listener5)
	auto listener6 = tcp.listen("127.0.0.1", 0)
	if listener6 == null
		return 78
	end
	auto port6 = tcp.local_port(listener6)
	auto pool = redis.pool("127.0.0.1", port6, 100, 2)
	auto pc1 = redis.pool_acquire(pool)
	if pc1.valid() == false
		tcp.close(listener6)
		return 79
	end
	auto server6 = tcp.accept(listener6, 1000)
	if server6 == null
		redis.close(pc1)
		tcp.close(listener6)
		return 80
	end
	tcp.send(server6, "+PONG\r\n")
	if redis.command1(pc1, "PING").contains("PONG") == false
		redis.close(pc1)
		tcp.close(server6)
		tcp.close(listener6)
		return 81
	end
	if redis.pool_release(pool, move(pc1)) == false
		tcp.close(server6)
		tcp.close(listener6)
		return 82
	end
	if redis.pool_idle_count(pool) != 1
		tcp.close(server6)
		tcp.close(listener6)
		return 83
	end
	auto pc2 = redis.pool_acquire(pool)
	if redis.pool_idle_count(pool) != 0
		redis.close(pc2)
		tcp.close(server6)
		tcp.close(listener6)
		return 84
	end
	tcp.send(server6, "+PONG\r\n")
	if redis.command1(pc2, "PING").contains("PONG") == false
		redis.close(pc2)
		tcp.close(server6)
		tcp.close(listener6)
		return 85
	end
	if redis.pool_release(pool, move(pc2)) == false
		tcp.close(server6)
		tcp.close(listener6)
		return 86
	end
	if redis.pool_close(pool) != 1
		tcp.close(server6)
		tcp.close(listener6)
		return 87
	end
	tcp.close(server6)
	tcp.close(listener6)

	return 0
end
