import std.env
import std.time as time
import x.redis as redis

extern "atoi" func parse_int(string text) as int

func env_or(string name, string fallback) as string
	if env.exists(name) then
		return env.read(name)
	end
	return fallback
end

func main() as int
	if env_or("XL_REDIS_REAL", "") != "1"
		return 0
	end

	auto port = parse_int(env_or("XL_REDIS_PORT", "6379"))
	auto password = env_or("XL_REDIS_PASSWORD", "")
	auto db = parse_int(env_or("XL_REDIS_DB", "0"))
	auto host = env_or("XL_REDIS_HOST", "127.0.0.1")
	auto prefix = "xlang:smoke:redis:" + time.now_text() + ":"
	auto key = prefix + "key"
	auto pipe_key = prefix + "pipe"
	auto ttl_key = prefix + "ttl"
	auto missing_key = prefix + "missing"
	auto hash_key = prefix + "hash"
	auto list_key = prefix + "list"
	auto set_key = prefix + "set"
	auto counter_key = prefix + "counter"
	auto batch_key1 = prefix + "batch1"
	auto batch_key2 = prefix + "batch2"
	auto channel = prefix + "channel"

	auto c = redis.connect(host, port, 5000)
	if c.valid() == false
		return 1
	end
	if password != "" and redis.auth(c, password) == false
		return 2
	end
	if redis.select(c, db) == false
		return 3
	end
	redis.del(c, key)
	redis.del(c, pipe_key)
	redis.del(c, ttl_key)
	redis.del(c, missing_key)
	redis.del(c, hash_key)
	redis.del(c, list_key)
	redis.del(c, set_key)
	redis.del(c, counter_key)
	redis.del(c, batch_key1)
	redis.del(c, batch_key2)

	int rc = 0
	if rc == 0 and redis.ping(c) != "PONG"
		rc = 4
	end
	if rc == 0 and redis.command_json(c, "[\"XLANG_UNKNOWN_COMMAND\"]").contains("\"type\":\"error\"") == false
		rc = 5
	end
	if rc == 0 and redis.set(c, key, "Ada") == false
		rc = 6
	end
	if rc == 0 and redis.get(c, key) != "Ada"
		rc = 7
	end
	if rc == 0 and redis.exists(c, key) == false
		rc = 8
	end
	if rc == 0 and redis.del(c, key) < 1
		rc = 9
	end
	if rc == 0 and redis.set_nx(c, key, "NxFirst") == false
		rc = 122
	end
	if rc == 0 and redis.set_nx(c, key, "NxSecond")
		rc = 123
	end
	if rc == 0 and redis.get(c, key) != "NxFirst"
		rc = 124
	end
	if rc == 0 and redis.set_xx(c, key, "XxSecond") == false
		rc = 125
	end
	if rc == 0 and redis.get(c, key) != "XxSecond"
		rc = 126
	end
	redis.del(c, key)
	if rc == 0 and redis.set_xx(c, key, "XxMissing")
		rc = 127
	end
	if rc == 0 and redis.command_pipeline_json(c, "[[\"SET\",\"" + pipe_key + "\",\"Pipe\"],[\"GET\",\"" + pipe_key + "\"]]").contains("Pipe") == false
		rc = 30
	end
	if rc == 0 and redis.mset(c, [batch_key1, "BatchOne", batch_key2, "BatchTwo"]) == false
		rc = 153
	end
	if rc == 0 and redis.mget_json(c, [batch_key1, batch_key2, missing_key]).contains("BatchOne") == false
		rc = 154
	end
	if rc == 0 and redis.mget_json(c, [batch_key1, batch_key2, missing_key]).contains("BatchTwo") == false
		rc = 155
	end
	if rc == 0 and redis.append(c, batch_key1, "-Tail") <= 0
		rc = 159
	end
	if rc == 0 and redis.strlen(c, batch_key1) <= 0
		rc = 160
	end
	if rc == 0 and redis.get(c, batch_key1).contains("Tail") == false
		rc = 161
	end
	if rc == 0 and redis.get(c, missing_key) != ""
		rc = 10
	end
	if rc == 0 and redis.get_or(c, missing_key, "fallback") != "fallback"
		rc = 11
	end
	if rc == 0 and redis.set_ex(c, ttl_key, "short", 60) == false
		rc = 12
	end
	if rc == 0 and redis.ttl(c, ttl_key) < 0
		rc = 13
	end
	if rc == 0 and redis.pttl(c, ttl_key) < 0
		rc = 138
	end
	if rc == 0 and redis.expire(c, ttl_key, 60) == false
		rc = 14
	end
	if rc == 0 and redis.persist(c, ttl_key) == false
		rc = 139
	end
	if rc == 0 and redis.hset(c, hash_key, "name", "Grace") < 0
		rc = 15
	end
	if rc == 0 and redis.hget(c, hash_key, "name") != "Grace"
		rc = 16
	end
	if rc == 0 and redis.hget_or(c, hash_key, "missing", "fallback") != "fallback"
		rc = 113
	end
	if rc == 0 and redis.hexists(c, hash_key, "name") == false
		rc = 17
	end
	if rc == 0 and redis.hlen(c, hash_key) < 1
		rc = 168
	end
	if rc == 0 and redis.hstrlen(c, hash_key, "name") != 5
		rc = 171
	end
	if rc == 0 and redis.hgetall_json(c, hash_key).contains("Grace") == false
		rc = 18
	end
	if rc == 0 and redis.hdel(c, hash_key, "name") < 1
		rc = 19
	end
	if rc == 0 and redis.lpush(c, list_key, "first") < 1
		rc = 20
	end
	if rc == 0 and redis.rpush(c, list_key, "second") < 2
		rc = 21
	end
	if rc == 0 and redis.llen(c, list_key) != 2
		rc = 22
	end
	if rc == 0 and redis.lrange_json(c, list_key, 0, -1).contains("first") == false
		rc = 23
	end
	if rc == 0 and redis.lpop(c, list_key) != "first"
		rc = 24
	end
	if rc == 0 and redis.rpop(c, list_key) != "second"
		rc = 25
	end
	if rc == 0 and redis.lpop_or(c, list_key, "fallback") != "fallback"
		rc = 116
	end
	if rc == 0 and redis.rpop_or(c, list_key, "fallback") != "fallback"
		rc = 117
	end
	if rc == 0 and redis.sadd(c, set_key, "member") < 1
		rc = 26
	end
	if rc == 0 and redis.sismember(c, set_key, "member") == false
		rc = 27
	end
	if rc == 0 and redis.smembers_json(c, set_key).contains("member") == false
		rc = 28
	end
	if rc == 0 and redis.srem(c, set_key, "member") < 1
		rc = 29
	end
	if rc == 0 and redis.incr(c, counter_key) != 1
		rc = 145
	end
	if rc == 0 and redis.incr_by(c, counter_key, 4) != 5
		rc = 146
	end
	if rc == 0 and redis.decr(c, counter_key) != 4
		rc = 147
	end
	if rc == 0 and redis.decr_by(c, counter_key, 3) != 1
		rc = 148
	end
	redis.del(c, counter_key)
	if rc == 0 and env_or("XL_REDIS_FAKE_CLUSTER_REDIRECT", "") == "1" then
		auto moved_resp = redis.cluster_command_redirect_once_json(c, "[\"GET\",\"xlang:redirect:moved\"]", 5000)
		if moved_resp.contains("RedirectMovedOK") == false
			rc = 41
		end
		auto ask_resp = redis.cluster_command_redirect_once_json(c, "[\"GET\",\"xlang:redirect:ask\"]", 5000)
		if rc == 0 and ask_resp.contains("RedirectAskOK") == false
			rc = 42
		end
		auto chain_resp = redis.cluster_command_redirect_retry_json(c, "[\"GET\",\"xlang:redirect:chain\"]", 2, 5000)
		if rc == 0 and chain_resp.contains("RedirectChainOK") == false
			rc = 45
		end
		auto slots_json = redis.cluster_slots_json(c)
		auto slot_resp = redis.cluster_command_slot_once_json(c, slots_json, "xlang:slot:route", "[\"GET\",\"xlang:slot:route\"]", 5000)
		if rc == 0 and slot_resp.contains("SlotRouteOK") == false
			rc = 46
		end
		auto slot_retry_resp = redis.cluster_command_slot_retry_json(c, slots_json, "xlang:slot:stale", "[\"GET\",\"xlang:slot:stale\"]", 1, 5000)
		if rc == 0 and slot_retry_resp.contains("SlotStaleOK") == false
			rc = 47
		end
		auto key_route_resp = redis.cluster_command_key_once_json(c, "xlang:slot:route", "[\"GET\",\"xlang:slot:route\"]", 5000)
		if rc == 0 and key_route_resp.contains("SlotRouteOK") == false
			rc = 48
		end
		auto key_route_password_resp = redis.cluster_command_key_once_password_json(c, "xlang:slot:route", "secret", "[\"GET\",\"xlang:slot:route\"]", 5000)
		if rc == 0 and key_route_password_resp.contains("SlotRouteOK") == false
			rc = 183
		end
		auto key_route_auth_resp = redis.cluster_command_key_once_auth_json(c, "xlang:slot:route", "default", "secret", "[\"GET\",\"xlang:slot:route\"]", 5000)
		if rc == 0 and key_route_auth_resp.contains("SlotRouteOK") == false
			rc = 184
		end
		auto key_retry_resp = redis.cluster_command_key_retry_json(c, "xlang:slot:stale", "[\"GET\",\"xlang:slot:stale\"]", 1, 5000)
		if rc == 0 and key_retry_resp.contains("SlotStaleOK") == false
			rc = 49
		end
		auto key_retry_password_resp = redis.cluster_command_key_retry_password_json(c, "xlang:slot:stale", "secret", "[\"GET\",\"xlang:slot:stale\"]", 1, 5000)
		if rc == 0 and key_retry_password_resp.contains("SlotStaleOK") == false
			rc = 185
		end
		auto key_retry_auth_resp = redis.cluster_command_key_retry_auth_json(c, "xlang:slot:stale", "default", "secret", "[\"GET\",\"xlang:slot:stale\"]", 1, 5000)
		if rc == 0 and key_retry_auth_resp.contains("SlotStaleOK") == false
			rc = 186
		end
		auto slots_cache = redis.cluster_slots_cache("")
		if rc == 0 and redis.cluster_slots_cache_valid(slots_cache)
			rc = 50
		end
		if rc == 0 and redis.cluster_slots_cache_refresh(slots_cache, c) == false
			rc = 51
		end
		if rc == 0 and redis.cluster_slots_cache_valid(slots_cache) == false
			rc = 52
		end
		auto cached_route_resp = redis.cluster_command_cached_key_once_json(c, slots_cache, "xlang:slot:route", "[\"GET\",\"xlang:slot:route\"]", 5000)
		if rc == 0 and cached_route_resp.contains("SlotRouteOK") == false
			rc = 53
		end
		auto cached_route_password_resp = redis.cluster_command_cached_key_once_password_json(c, slots_cache, "xlang:slot:route", "secret", "[\"GET\",\"xlang:slot:route\"]", 5000)
		if rc == 0 and cached_route_password_resp.contains("SlotRouteOK") == false
			rc = 187
		end
		auto cached_route_auth_resp = redis.cluster_command_cached_key_once_auth_json(c, slots_cache, "xlang:slot:route", "default", "secret", "[\"GET\",\"xlang:slot:route\"]", 5000)
		if rc == 0 and cached_route_auth_resp.contains("SlotRouteOK") == false
			rc = 188
		end
		auto cached_retry_resp = redis.cluster_command_cached_key_retry_json(c, slots_cache, "xlang:slot:stale", "[\"GET\",\"xlang:slot:stale\"]", 1, 5000)
		if rc == 0 and cached_retry_resp.contains("SlotStaleOK") == false
			rc = 54
		end
		auto cached_retry_password_resp = redis.cluster_command_cached_key_retry_password_json(c, slots_cache, "xlang:slot:stale", "secret", "[\"GET\",\"xlang:slot:stale\"]", 1, 5000)
		if rc == 0 and cached_retry_password_resp.contains("SlotStaleOK") == false
			rc = 189
		end
		auto cached_retry_auth_resp = redis.cluster_command_cached_key_retry_auth_json(c, slots_cache, "xlang:slot:stale", "default", "secret", "[\"GET\",\"xlang:slot:stale\"]", 1, 5000)
		if rc == 0 and cached_retry_auth_resp.contains("SlotStaleOK") == false
			rc = 190
		end
		auto empty_cache = redis.cluster_slots_cache("")
		auto refresh_route_resp = redis.cluster_command_cache_refresh_key_once_json(c, empty_cache, "xlang:slot:route", "[\"GET\",\"xlang:slot:route\"]", 5000)
		if rc == 0 and refresh_route_resp.contains("SlotRouteOK") == false
			rc = 55
		end
		auto empty_password_cache = redis.cluster_slots_cache("")
		auto refresh_route_password_resp = redis.cluster_command_cache_refresh_key_once_password_json(c, empty_password_cache, "xlang:slot:route", "secret", "[\"GET\",\"xlang:slot:route\"]", 5000)
		if rc == 0 and refresh_route_password_resp.contains("SlotRouteOK") == false
			rc = 191
		end
		auto empty_auth_cache = redis.cluster_slots_cache("")
		auto refresh_route_auth_resp = redis.cluster_command_cache_refresh_key_once_auth_json(c, empty_auth_cache, "xlang:slot:route", "default", "secret", "[\"GET\",\"xlang:slot:route\"]", 5000)
		if rc == 0 and refresh_route_auth_resp.contains("SlotRouteOK") == false
			rc = 192
		end
		auto empty_retry_cache = redis.cluster_slots_cache("")
		auto refresh_retry_resp = redis.cluster_command_cache_refresh_key_retry_json(c, empty_retry_cache, "xlang:slot:stale", "[\"GET\",\"xlang:slot:stale\"]", 1, 5000)
		if rc == 0 and refresh_retry_resp.contains("SlotStaleOK") == false
			rc = 56
		end
		auto empty_retry_password_cache = redis.cluster_slots_cache("")
		auto refresh_retry_password_resp = redis.cluster_command_cache_refresh_key_retry_password_json(c, empty_retry_password_cache, "xlang:slot:stale", "secret", "[\"GET\",\"xlang:slot:stale\"]", 1, 5000)
		if rc == 0 and refresh_retry_password_resp.contains("SlotStaleOK") == false
			rc = 193
		end
		auto empty_retry_auth_cache = redis.cluster_slots_cache("")
		auto refresh_retry_auth_resp = redis.cluster_command_cache_refresh_key_retry_auth_json(c, empty_retry_auth_cache, "xlang:slot:stale", "default", "secret", "[\"GET\",\"xlang:slot:stale\"]", 1, 5000)
		if rc == 0 and refresh_retry_auth_resp.contains("SlotStaleOK") == false
			rc = 194
		end
		auto readonly_retry_cache = redis.cluster_slots_cache("")
		auto readonly_retry_resp = redis.cluster_command_cache_refresh_key_retry_json(c, readonly_retry_cache, "xlang:slot:readonly", "[\"GET\",\"xlang:slot:readonly\"]", 1, 5000)
		if rc == 0 and readonly_retry_resp.contains("ReadOnlyRecoveredOK") == false
			rc = 83
		end
		auto wrapper_cache = redis.cluster_slots_cache("")
		if rc == 0 and redis.cluster_set(c, wrapper_cache, "xlang:cluster:wrapper", "Wrapped") == false
			rc = 57
		end
		if rc == 0 and redis.cluster_get(c, wrapper_cache, "xlang:cluster:wrapper") != "Wrapped"
			rc = 58
		end
		var array<string> cluster_mset_values = [
			"xlang:cluster:{multi}:a",
			"A",
			"xlang:cluster:{multi}:b",
			"B"
		]
		if rc == 0 and redis.cluster_mset(c, wrapper_cache, cluster_mset_values) == false
			rc = 165
		end
		var array<string> cluster_mget_keys = [
			"xlang:cluster:{multi}:a",
			"xlang:cluster:{multi}:b"
		]
		if rc == 0 and redis.cluster_mget_json(c, wrapper_cache, cluster_mget_keys).contains("B") == false
			rc = 166
		end
		redis.cluster_del(c, wrapper_cache, "xlang:cluster:{multi}:a")
		redis.cluster_del(c, wrapper_cache, "xlang:cluster:{multi}:b")
		if rc == 0 and redis.cluster_append(c, wrapper_cache, "xlang:cluster:wrapper", "-Tail") <= 0
			rc = 162
		end
		if rc == 0 and redis.cluster_strlen(c, wrapper_cache, "xlang:cluster:wrapper") <= 0
			rc = 163
		end
		if rc == 0 and redis.cluster_get(c, wrapper_cache, "xlang:cluster:wrapper").contains("Tail") == false
			rc = 164
		end
		if rc == 0 and redis.cluster_get_or(c, wrapper_cache, "xlang:cluster:missing", "fallback") != "fallback"
			rc = 111
		end
		if rc == 0 and redis.cluster_set_nx(c, wrapper_cache, "xlang:cluster:wrapper", "NxSkipped")
			rc = 128
		end
		if rc == 0 and redis.cluster_set_xx(c, wrapper_cache, "xlang:cluster:wrapper", "XxWrapped") == false
			rc = 129
		end
		if rc == 0 and redis.cluster_get(c, wrapper_cache, "xlang:cluster:wrapper") != "XxWrapped"
			rc = 130
		end
		if rc == 0 and redis.cluster_del(c, wrapper_cache, "xlang:cluster:wrapper") < 1
			rc = 59
		end
		if rc == 0 and redis.cluster_set_nx(c, wrapper_cache, "xlang:cluster:wrapper", "NxWrapped") == false
			rc = 131
		end
		if rc == 0 and redis.cluster_set_xx(c, wrapper_cache, "xlang:cluster:missingxx", "XxMissing")
			rc = 132
		end
		redis.cluster_del(c, wrapper_cache, "xlang:cluster:wrapper")
		if rc == 0 and redis.cluster_set(c, wrapper_cache, "xlang:cluster:escape", "A\"B\\C") == false
			rc = 60
		end
		if rc == 0 and redis.cluster_get(c, wrapper_cache, "xlang:cluster:escape") != "A\"B\\C"
			rc = 61
		end
		if rc == 0 and redis.cluster_exists(c, wrapper_cache, "xlang:cluster:escape") == false
			rc = 62
		end
		if rc == 0 and redis.cluster_expire(c, wrapper_cache, "xlang:cluster:escape", 60) == false
			rc = 63
		end
		if rc == 0 and redis.cluster_ttl(c, wrapper_cache, "xlang:cluster:escape") < 0
			rc = 64
		end
		if rc == 0 and redis.cluster_pttl(c, wrapper_cache, "xlang:cluster:escape") < 0
			rc = 140
		end
		if rc == 0 and redis.cluster_persist(c, wrapper_cache, "xlang:cluster:escape") == false
			rc = 141
		end
		redis.cluster_del(c, wrapper_cache, "xlang:cluster:escape")
		if rc == 0 and redis.cluster_set_ex(c, wrapper_cache, "xlang:cluster:ttl", "short", 60) == false
			rc = 109
		end
		if rc == 0 and redis.cluster_ttl(c, wrapper_cache, "xlang:cluster:ttl") < 0
			rc = 110
		end
		if rc == 0 and redis.cluster_pttl(c, wrapper_cache, "xlang:cluster:ttl") < 0
			rc = 142
		end
		redis.cluster_del(c, wrapper_cache, "xlang:cluster:ttl")
		redis.cluster_del(c, wrapper_cache, "xlang:cluster:counter")
		if rc == 0 and redis.cluster_incr(c, wrapper_cache, "xlang:cluster:counter") != 1
			rc = 65
		end
		if rc == 0 and redis.cluster_incr(c, wrapper_cache, "xlang:cluster:counter") != 2
			rc = 66
		end
		if rc == 0 and redis.cluster_decr(c, wrapper_cache, "xlang:cluster:counter") != 1
			rc = 67
		end
		if rc == 0 and redis.cluster_incr_by(c, wrapper_cache, "xlang:cluster:counter", 4) != 5
			rc = 149
		end
		if rc == 0 and redis.cluster_decr_by(c, wrapper_cache, "xlang:cluster:counter", 3) != 2
			rc = 150
		end
		redis.cluster_del(c, wrapper_cache, "xlang:cluster:counter")
		redis.cluster_del(c, wrapper_cache, "xlang:cluster:hash")
		if rc == 0 and redis.cluster_hset(c, wrapper_cache, "xlang:cluster:hash", "name", "Grace") < 1
			rc = 68
		end
		if rc == 0 and redis.cluster_hget(c, wrapper_cache, "xlang:cluster:hash", "name") != "Grace"
			rc = 69
		end
		if rc == 0 and redis.cluster_hget_or(c, wrapper_cache, "xlang:cluster:hash", "missing", "fallback") != "fallback"
			rc = 114
		end
		if rc == 0 and redis.cluster_hexists(c, wrapper_cache, "xlang:cluster:hash", "name") == false
			rc = 70
		end
		if rc == 0 and redis.cluster_hlen(c, wrapper_cache, "xlang:cluster:hash") < 1
			rc = 169
		end
		if rc == 0 and redis.cluster_hstrlen(c, wrapper_cache, "xlang:cluster:hash", "name") != 5
			rc = 172
		end
		if rc == 0 and redis.cluster_hgetall_json(c, wrapper_cache, "xlang:cluster:hash").contains("Grace") == false
			rc = 71
		end
		if rc == 0 and redis.cluster_hdel(c, wrapper_cache, "xlang:cluster:hash", "name") < 1
			rc = 72
		end
		redis.cluster_del(c, wrapper_cache, "xlang:cluster:hash")
		redis.cluster_del(c, wrapper_cache, "xlang:cluster:list")
		if rc == 0 and redis.cluster_lpush(c, wrapper_cache, "xlang:cluster:list", "first") < 1
			rc = 73
		end
		if rc == 0 and redis.cluster_rpush(c, wrapper_cache, "xlang:cluster:list", "second") < 2
			rc = 74
		end
		if rc == 0 and redis.cluster_llen(c, wrapper_cache, "xlang:cluster:list") != 2
			rc = 75
		end
		if rc == 0 and redis.cluster_lrange_json(c, wrapper_cache, "xlang:cluster:list", 0, -1).contains("second") == false
			rc = 76
		end
		if rc == 0 and redis.cluster_lpop(c, wrapper_cache, "xlang:cluster:list") != "first"
			rc = 77
		end
		if rc == 0 and redis.cluster_rpop(c, wrapper_cache, "xlang:cluster:list") != "second"
			rc = 78
		end
		if rc == 0 and redis.cluster_lpop_or(c, wrapper_cache, "xlang:cluster:list", "fallback") != "fallback"
			rc = 118
		end
		if rc == 0 and redis.cluster_rpop_or(c, wrapper_cache, "xlang:cluster:list", "fallback") != "fallback"
			rc = 119
		end
		redis.cluster_del(c, wrapper_cache, "xlang:cluster:list")
		redis.cluster_del(c, wrapper_cache, "xlang:cluster:set")
		if rc == 0 and redis.cluster_sadd(c, wrapper_cache, "xlang:cluster:set", "member") < 1
			rc = 79
		end
		if rc == 0 and redis.cluster_sismember(c, wrapper_cache, "xlang:cluster:set", "member") == false
			rc = 80
		end
		if rc == 0 and redis.cluster_smembers_json(c, wrapper_cache, "xlang:cluster:set").contains("member") == false
			rc = 81
		end
		if rc == 0 and redis.cluster_srem(c, wrapper_cache, "xlang:cluster:set", "member") < 1
			rc = 82
		end
		redis.cluster_del(c, wrapper_cache, "xlang:cluster:set")
	end
	if rc == 0 and env_or("XL_REDIS_FAKE_SENTINEL_MASTER", "") == "1" then
		auto sentinel_resp = redis.sentinel_command_master_once_json(c, "mymaster", "[\"GET\",\"xlang:sentinel:master\"]", 5000)
		if sentinel_resp.contains("SentinelMasterOK") == false
			rc = 43
		end
		auto sentinel_retry_resp = redis.sentinel_command_master_retry_json(c, "mymaster", "[\"GET\",\"xlang:sentinel:retry\"]", 2, 5000)
		if rc == 0 and sentinel_retry_resp.contains("SentinelRetryOK") == false
			rc = 44
		end
		if rc == 0 and redis.sentinel_ping(c, "mymaster") != "PONG"
			rc = 175
		end
		if rc == 0 and redis.sentinel_ping(c, "mymaster", "hello") != "hello"
			rc = 176
		end
		if rc == 0 and redis.sentinel_select(c, "mymaster", db) == false
			rc = 177
		end
		if rc == 0 and redis.sentinel_dbsize(c, "mymaster") < 0
			rc = 178
		end
		auto sentinel_password_resp = redis.sentinel_command_master_once_password_json(c, "mymaster", "secret", "[\"GET\",\"xlang:sentinel:master\"]", 5000)
		if rc == 0 and sentinel_password_resp.contains("SentinelMasterOK") == false
			rc = 179
		end
		auto sentinel_auth_resp = redis.sentinel_command_master_once_auth_json(c, "mymaster", "default", "secret", "[\"GET\",\"xlang:sentinel:master\"]", 5000)
		if rc == 0 and sentinel_auth_resp.contains("SentinelMasterOK") == false
			rc = 180
		end
		auto sentinel_password_retry_resp = redis.sentinel_command_master_retry_password_json(c, "mymaster", "secret", "[\"GET\",\"xlang:sentinel:master\"]", 2, 5000)
		if rc == 0 and sentinel_password_retry_resp.contains("SentinelMasterOK") == false
			rc = 181
		end
		auto sentinel_auth_retry_resp = redis.sentinel_command_master_retry_auth_json(c, "mymaster", "default", "secret", "[\"GET\",\"xlang:sentinel:master\"]", 2, 5000)
		if rc == 0 and sentinel_auth_retry_resp.contains("SentinelMasterOK") == false
			rc = 182
		end
		if rc == 0 and redis.sentinel_set(c, "mymaster", "xlang:sentinel:wrapper", "SentinelWrapped") == false
			rc = 84
		end
		if rc == 0 and redis.sentinel_get(c, "mymaster", "xlang:sentinel:wrapper") != "SentinelWrapped"
			rc = 85
		end
		if rc == 0 and redis.sentinel_get_or(c, "mymaster", "xlang:sentinel:missing", "fallback") != "fallback"
			rc = 112
		end
		if rc == 0 and redis.sentinel_mset(c, "mymaster", ["xlang:sentinel:batch1", "BatchOne", "xlang:sentinel:batch2", "BatchTwo"]) == false
			rc = 156
		end
		if rc == 0 and redis.sentinel_mget_json(c, "mymaster", ["xlang:sentinel:batch1", "xlang:sentinel:batch2", "xlang:sentinel:missing"]).contains("BatchOne") == false
			rc = 157
		end
		if rc == 0 and redis.sentinel_mget_json(c, "mymaster", ["xlang:sentinel:batch1", "xlang:sentinel:batch2", "xlang:sentinel:missing"]).contains("BatchTwo") == false
			rc = 158
		end
		if rc == 0 and redis.sentinel_append(c, "mymaster", "xlang:sentinel:batch1", "-Tail") <= 0
			rc = 165
		end
		if rc == 0 and redis.sentinel_strlen(c, "mymaster", "xlang:sentinel:batch1") <= 0
			rc = 166
		end
		if rc == 0 and redis.sentinel_get(c, "mymaster", "xlang:sentinel:batch1").contains("Tail") == false
			rc = 167
		end
		if rc == 0 and redis.sentinel_set_nx(c, "mymaster", "xlang:sentinel:wrapper", "NxSkipped")
			rc = 133
		end
		if rc == 0 and redis.sentinel_set_xx(c, "mymaster", "xlang:sentinel:wrapper", "XxSentinel") == false
			rc = 134
		end
		if rc == 0 and redis.sentinel_get(c, "mymaster", "xlang:sentinel:wrapper") != "XxSentinel"
			rc = 135
		end
		if rc == 0 and redis.sentinel_exists(c, "mymaster", "xlang:sentinel:wrapper") == false
			rc = 86
		end
		if rc == 0 and redis.sentinel_del(c, "mymaster", "xlang:sentinel:wrapper") < 1
			rc = 87
		end
		if rc == 0 and redis.sentinel_set_nx(c, "mymaster", "xlang:sentinel:wrapper", "NxSentinel") == false
			rc = 136
		end
		if rc == 0 and redis.sentinel_set_xx(c, "mymaster", "xlang:sentinel:missingxx", "XxMissing")
			rc = 137
		end
		redis.sentinel_del(c, "mymaster", "xlang:sentinel:wrapper")
		if rc == 0 and redis.sentinel_set_ex(c, "mymaster", "xlang:sentinel:ttl", "short", 60) == false
			rc = 103
		end
		if rc == 0 and redis.sentinel_expire(c, "mymaster", "xlang:sentinel:ttl", 60) == false
			rc = 104
		end
		if rc == 0 and redis.sentinel_ttl(c, "mymaster", "xlang:sentinel:ttl") < 0
			rc = 105
		end
		if rc == 0 and redis.sentinel_pttl(c, "mymaster", "xlang:sentinel:ttl") < 0
			rc = 143
		end
		if rc == 0 and redis.sentinel_persist(c, "mymaster", "xlang:sentinel:ttl") == false
			rc = 144
		end
		redis.sentinel_del(c, "mymaster", "xlang:sentinel:ttl")
		redis.sentinel_del(c, "mymaster", "xlang:sentinel:counter")
		if rc == 0 and redis.sentinel_incr(c, "mymaster", "xlang:sentinel:counter") != 1
			rc = 106
		end
		if rc == 0 and redis.sentinel_incr(c, "mymaster", "xlang:sentinel:counter") != 2
			rc = 107
		end
		if rc == 0 and redis.sentinel_decr(c, "mymaster", "xlang:sentinel:counter") != 1
			rc = 108
		end
		if rc == 0 and redis.sentinel_incr_by(c, "mymaster", "xlang:sentinel:counter", 4) != 5
			rc = 151
		end
		if rc == 0 and redis.sentinel_decr_by(c, "mymaster", "xlang:sentinel:counter", 3) != 2
			rc = 152
		end
		redis.sentinel_del(c, "mymaster", "xlang:sentinel:counter")
		if rc == 0 and redis.sentinel_hset(c, "mymaster", "xlang:sentinel:hash", "name", "SentinelGrace") < 1
			rc = 88
		end
		if rc == 0 and redis.sentinel_hget(c, "mymaster", "xlang:sentinel:hash", "name") != "SentinelGrace"
			rc = 89
		end
		if rc == 0 and redis.sentinel_hget_or(c, "mymaster", "xlang:sentinel:hash", "missing", "fallback") != "fallback"
			rc = 115
		end
		if rc == 0 and redis.sentinel_hexists(c, "mymaster", "xlang:sentinel:hash", "name") == false
			rc = 90
		end
		if rc == 0 and redis.sentinel_hlen(c, "mymaster", "xlang:sentinel:hash") < 1
			rc = 170
		end
		if rc == 0 and redis.sentinel_hstrlen(c, "mymaster", "xlang:sentinel:hash", "name") != 13
			rc = 173
		end
		if rc == 0 and redis.sentinel_hgetall_json(c, "mymaster", "xlang:sentinel:hash").contains("SentinelGrace") == false
			rc = 91
		end
		if rc == 0 and redis.sentinel_hdel(c, "mymaster", "xlang:sentinel:hash", "name") < 1
			rc = 92
		end
		if rc == 0 and redis.sentinel_lpush(c, "mymaster", "xlang:sentinel:list", "first") < 1
			rc = 93
		end
		if rc == 0 and redis.sentinel_rpush(c, "mymaster", "xlang:sentinel:list", "second") < 2
			rc = 94
		end
		if rc == 0 and redis.sentinel_llen(c, "mymaster", "xlang:sentinel:list") != 2
			rc = 95
		end
		if rc == 0 and redis.sentinel_lrange_json(c, "mymaster", "xlang:sentinel:list", 0, -1).contains("second") == false
			rc = 96
		end
		if rc == 0 and redis.sentinel_lpop(c, "mymaster", "xlang:sentinel:list") != "first"
			rc = 97
		end
		if rc == 0 and redis.sentinel_rpop(c, "mymaster", "xlang:sentinel:list") != "second"
			rc = 98
		end
		if rc == 0 and redis.sentinel_lpop_or(c, "mymaster", "xlang:sentinel:list", "fallback") != "fallback"
			rc = 120
		end
		if rc == 0 and redis.sentinel_rpop_or(c, "mymaster", "xlang:sentinel:list", "fallback") != "fallback"
			rc = 121
		end
		if rc == 0 and redis.sentinel_sadd(c, "mymaster", "xlang:sentinel:set", "member") < 1
			rc = 99
		end
		if rc == 0 and redis.sentinel_sismember(c, "mymaster", "xlang:sentinel:set", "member") == false
			rc = 100
		end
		if rc == 0 and redis.sentinel_smembers_json(c, "mymaster", "xlang:sentinel:set").contains("member") == false
			rc = 101
		end
		if rc == 0 and redis.sentinel_srem(c, "mymaster", "xlang:sentinel:set", "member") < 1
			rc = 102
		end
	end
	if rc == 0 then
		auto sub = redis.connect(host, port, 5000)
		auto pub = redis.connect(host, port, 5000)
		if sub.valid() == false or pub.valid() == false
			rc = 31
		end
		if rc == 0 and redis.subscribe(sub, channel).contains("subscribe") == false
			rc = 32
		end
		if rc == 0 and redis.publish(pub, channel, "hello") < 1
			rc = 33
		end
		if rc == 0 and redis.read_response_json(sub).contains("hello") == false
			rc = 34
		end
		if rc == 0 and redis.unsubscribe(sub, channel).contains("unsubscribe") == false
			rc = 35
		end
		redis.close(pub)
		redis.close(sub)
	end
	if rc == 0 then
		auto pool = redis.pool(host, port, 5000, 2)
		auto pooled = redis.pool_acquire(pool)
		if pooled.valid() == false
			rc = 36
		end
		if rc == 0 and redis.ping(pooled) != "PONG"
			rc = 37
		end
		if rc == 0 and redis.pool_release(pool, move(pooled)) == false
			rc = 38
		end
		if rc == 0 and redis.pool_idle_count(pool) != 1
			rc = 39
		end
		if rc == 0 and redis.pool_close(pool) != 1
			rc = 40
		end
	end
	redis.del(c, key)
	redis.del(c, pipe_key)
	redis.del(c, ttl_key)
	redis.del(c, missing_key)
	redis.del(c, hash_key)
	redis.del(c, list_key)
	redis.del(c, set_key)
	redis.del(c, counter_key)
	redis.del(c, batch_key1)
	redis.del(c, batch_key2)
	redis.close(c)
	return rc
end
