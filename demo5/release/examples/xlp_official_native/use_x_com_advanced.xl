import x.com

func as_array(var value) as array<var>
	return value
end

func main() as int
	auto dict = x.com.create("Scripting.Dictionary")
	if dict.valid() == false then
		return 1
	end

	dict.invoke("Add", ["left", 20])
	if dict.Item("left") != 20 then
		return 2
	end

	dict.invoke("Add", ["right", 22])
	if dict.Item("right") != 22 then
		return 3
	end

	auto keys = as_array(dict.Keys())
	if keys.length != 2 then
		return 4
	end
	if keys[0] != "left" then
		return 5
	end
	if keys[1] != "right" then
		return 6
	end

	if dict.Item("left") != 20 then
		return 7
	end
	if dict.Item("right") != 22 then
		return 8
	end

	auto test = x.com.test_object()
	if test.valid() == false then
		return 9
	end
	if test.invoke_named("Sub", [5, 20], ["right", "left"]) != 15 then
		return 10
	end
	if test.invoke("OptionalAdd", [7, x.com.missing()]) != 17 then
		return 11
	end
	auto bumped = as_array(test.invoke_out("Bump", [41], [true]))
	if bumped.length != 2 then
		return 12
	end
	if bumped[0] != 42 then
		return 13
	end
	if bumped[1] != 42 then
		return 14
	end
	if test.set_ref("Child", null) == false then
		return 15
	end
	if test.invoke("HasChild", []) != true then
		return 16
	end
	return 42
end
