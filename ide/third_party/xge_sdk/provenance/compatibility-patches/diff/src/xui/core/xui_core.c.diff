+		result=xuiInternalFontSlotBegin(pContext,&pContext->pSystemFont,font,true,&systemUpdate);
+		if(result==XUI_OK)result=xuiInternalFontSlotEnd(&systemUpdate,true,xuiSetDefaultFont(pContext,font));
