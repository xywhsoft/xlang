 static int __xuiCodeDocumentUtf8Next(xui_code_document pDocument, int iOffset)
 {
+	int iNext;
+
 	if ( pDocument == NULL ) return 0;
+	if ( iOffset < 0 ) iOffset = 0;
+	if ( iOffset >= pDocument->iLength ) return pDocument->iLength;
+	if ( pDocument->iGapStart == pDocument->iGapEnd ) {
+		return xuiInternalTextGraphemeNext(pDocument->sBuffer,
+			pDocument->iLength, iOffset);
+	}
+	if ( iOffset >= pDocument->iGapStart ) {
+		return pDocument->iGapStart + xuiInternalTextGraphemeNext(
+			pDocument->sBuffer + pDocument->iGapEnd,
+			pDocument->iLength - pDocument->iGapStart,
+			iOffset - pDocument->iGapStart);
+	}
+	iNext = xuiInternalTextGraphemeNext(pDocument->sBuffer,
+		pDocument->iGapStart, iOffset);
+	/* A decoder can look ahead by four bytes at the returned boundary.
+	   Near the gap, retry from the original offset with the logical reader,
+	   preserving clusters and even arbitrary UTF-8 byte splits across it. */
+	if ( iNext <= pDocument->iGapStart - 4 ) return iNext;
 	return xuiInternalTextGraphemeNextRead(__xuiCodeDocumentUnicodeRead,
 		pDocument, pDocument->iLength, iOffset);
 }
