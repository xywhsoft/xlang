+static int __xgeEmojiRootLowerBound(xge_emoji_pack pPack, uint32_t iCodepoint)
+{
+    int iLow = 0, iHigh = pPack->iRootEntryCount;
+    while ( iLow < iHigh ) {
+        int iMiddle = iLow + (iHigh - iLow) / 2;
+        if ( pPack->pRootEntries[iMiddle].iCodepoint < iCodepoint ) iLow = iMiddle + 1;
+        else iHigh = iMiddle;
+    }
+    return iLow;
+}
+
+static int __xgeEmojiEnsureRootEntries(xge_emoji_pack pPack, int iRequired)
+{
+    int iCapacity;
+    xge_emoji_root_entry_t* pEntries;
+    if ( iRequired <= pPack->iRootEntryCapacity ) return XGE_OK;
+    iCapacity = pPack->iRootEntryCapacity > 0 ? pPack->iRootEntryCapacity * 2 : 32;
+    if ( iCapacity < iRequired ) iCapacity = iRequired;
+    pEntries = (xge_emoji_root_entry_t*)xrtRealloc(pPack->pRootEntries,
+        sizeof(*pEntries) * (size_t)iCapacity);
+    if ( pEntries == NULL ) return XGE_ERROR_OUT_OF_MEMORY;
+    pPack->pRootEntries = pEntries;
+    pPack->iRootEntryCapacity = iCapacity;
+    return XGE_OK;
+}
+
+static void __xgeEmojiRootInsert(xge_emoji_pack pPack, uint32_t iCodepoint, int iNode)
+{
+    int iAt = __xgeEmojiRootLowerBound(pPack, iCodepoint);
+    memmove(pPack->pRootEntries + iAt + 1, pPack->pRootEntries + iAt,
+        sizeof(*pPack->pRootEntries) * (size_t)(pPack->iRootEntryCount - iAt));
+    pPack->pRootEntries[iAt].iCodepoint = iCodepoint;
+    pPack->pRootEntries[iAt].iNode = iNode;
+    ++pPack->iRootEntryCount;
+}
