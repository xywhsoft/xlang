+static int __xgeTextOutsidePixelClip(xge_rect_t tBounds, xge_rect_i_t tClip)
+{
+    /* Keep a two-pixel fringe for antialiasing and fractional bounds. */
+    if ( tClip.iW <= 0 || tClip.iH <= 0 || tBounds.fW < 0.0f || tBounds.fH < 0.0f ||
+         !isfinite(tBounds.fX) || !isfinite(tBounds.fY) ||
+         !isfinite(tBounds.fW) || !isfinite(tBounds.fH) ) return 0;
+    return (double)tBounds.fX + tBounds.fW < (double)tClip.iX - 2.0 ||
+        (double)tBounds.fY + tBounds.fH < (double)tClip.iY - 2.0 ||
+        (double)tBounds.fX > (double)tClip.iX + tClip.iW + 2.0 ||
+        (double)tBounds.fY > (double)tClip.iY + tClip.iH + 2.0;
+}
