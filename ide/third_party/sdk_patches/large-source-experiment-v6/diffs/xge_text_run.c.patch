+/* Bounded, call-local lookup reuse. No font state survives the shape call,
+   and collisions use the original resolver before replacing this slot. */
+#define XGE_TEXT_SHAPE_LOOKUP_SLOTS 64u
+typedef struct xge_text_shape_lookup_t {
+    uint32_t iCodepointKey;
+    int iGlyph;
+    xge_font pFont;
+    float fAdvanceX;
+    float fExtentX;
+    int bMeasured;
+} xge_text_shape_lookup_t;
+
+static xge_font __xgeTextShapeResolveCodepoint(xge_font pFont, uint32_t iCodepoint,
+    int* pGlyph, xge_text_shape_lookup_t* pLookup)
+{
+    xge_text_shape_lookup_t* pEntry;
+    xge_font pResolved;
+    uint32_t iKey = iCodepoint + 1u;
+    if ( pLookup == NULL || iKey == 0u ) {
+        return __xgeFontResolveCodepoint(pFont, iCodepoint, pGlyph);
+    }
+    pEntry = &pLookup[(iCodepoint * 0x9e3779b9u) >> 26];
+    if ( pEntry->iCodepointKey == iKey ) {
+        *pGlyph = pEntry->iGlyph;
+        return pEntry->pFont;
+    }
+    pResolved = __xgeFontResolveCodepoint(pFont, iCodepoint, pGlyph);
+    /* A failed lookup leaves the caller's glyph output untouched. */
+    if ( pResolved != NULL ) {
+        pEntry->iCodepointKey = iKey;
+        pEntry->iGlyph = *pGlyph;
+        pEntry->pFont = pResolved;
+        pEntry->bMeasured = 0;
+    }
+    return pResolved;
+}
+
+/* Only the two scalar metrics consumed by shaping are reused. The original
+   getter is read-only; failed measurements are retried and never cached. */
+static int __xgeTextShapeGlyphMeasure(xge_font pFont, int iGlyph, uint32_t iCodepoint,
+    xge_text_shape_lookup_t* pLookup, float* pAdvanceX, float* pExtentX)
+{
+    xge_text_shape_lookup_t* pEntry = NULL;
+    xge_glyph_metrics_t tMetrics;
+    int iRet;
+    if ( pLookup != NULL && iCodepoint + 1u != 0u ) {
+        pEntry = &pLookup[(iCodepoint * 0x9e3779b9u) >> 26];
+        if ( pEntry->iCodepointKey != iCodepoint + 1u || pEntry->pFont != pFont ||
+             pEntry->iGlyph != iGlyph ) pEntry = NULL;
+    }
+    if ( pEntry != NULL && pEntry->bMeasured ) {
+        *pAdvanceX = pEntry->fAdvanceX;
+        *pExtentX = pEntry->fExtentX;
+        return XGE_OK;
+    }
+    iRet = xgeFontGlyphGetByIndex(pFont, iGlyph, &tMetrics);
+    if ( iRet != XGE_OK ) return iRet;
+    *pAdvanceX = tMetrics.fAdvanceX;
+    *pExtentX = tMetrics.fX1;
+    if ( pEntry != NULL ) {
+        pEntry->fAdvanceX = *pAdvanceX;
+        pEntry->fExtentX = *pExtentX;
+        pEntry->bMeasured = 1;
+    }
+    return XGE_OK;
+}
