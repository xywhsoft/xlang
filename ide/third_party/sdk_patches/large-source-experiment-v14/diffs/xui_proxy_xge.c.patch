+typedef struct xui_proxy_xge_cluster_visit_t {
+    xui_internal_text_cluster_visit_proc onVisit;
+    void* pUser;
+    xui_text_cluster_t tCluster;
+    int bCluster;
+    int iCount;
+    int iError;
+} xui_proxy_xge_cluster_visit_t;
+
+static int __xuiProxyXgeVisitPosition(const xge_glyph_position_t* pGlyph, void* pUser)
+{
+    xui_proxy_xge_cluster_visit_t* pState = (xui_proxy_xge_cluster_visit_t*)pUser;
+    xui_text_cluster_t* pCluster = &pState->tCluster;
+    if ( !pState->bCluster || pCluster->iTextStart != (int)pGlyph->iCluster ) {
+        if ( pState->bCluster ) {
+            pState->iError = pState->onVisit(pCluster, pState->pUser);
+            if ( pState->iError != XUI_OK ) return XGE_ERROR;
+        }
+        memset(pCluster, 0, sizeof(*pCluster));
+        pCluster->iSize = sizeof(*pCluster);
+        pCluster->iTextStart = (int)pGlyph->iCluster;
+        pCluster->iTextEnd = (int)pGlyph->iClusterEnd;
+        pCluster->fOffsetX = pGlyph->fOffsetX;
+        pCluster->fOffsetY = pGlyph->fOffsetY;
+        pState->bCluster = 1;
+        pState->iCount++;
+    } else if ( (int)pGlyph->iClusterEnd > pCluster->iTextEnd ) {
+        pCluster->iTextEnd = (int)pGlyph->iClusterEnd;
+    }
+    pCluster->fAdvance += pGlyph->fAdvanceX;
+    if ( (pGlyph->iFlags & XGE_GLYPH_POSITION_LINE_BREAK) != 0 ) pCluster->iFlags |= XUI_TEXT_CLUSTER_LINE_BREAK;
+    if ( pGlyph->iItemKind == XGE_TEXT_ITEM_EMOJI ) pCluster->iFlags |= XUI_TEXT_CLUSTER_EMOJI;
+    return XGE_OK;
+}
+
+int xuiInternalProxyXgeVisitTextShape(xui_proxy pProxy, xui_font pFont, const char* sText,
+    int iTextSize, uint32_t iFlags, xui_internal_text_cluster_visit_proc onVisit,
+    void* pUser, xui_text_shape_t* pShape)
+{
+    xge_text_shape_desc_t tDesc;
+    xge_glyph_run_t tRun;
+    xui_proxy_xge_cluster_visit_t tState;
+    int iRet;
+    if ( pProxy == NULL || pProxy->textShape != __xuiProxyXgeTextShape ) return XUI_ERROR_UNSUPPORTED;
+    if ( !__xuiProxyXgeFontValid(pFont) || sText == NULL || iTextSize < -1 ||
+         onVisit == NULL || pShape == NULL ) return XUI_ERROR_INVALID_ARGUMENT;
+    if ( iTextSize < 0 ) iTextSize = (int)strlen(sText);
+#if (defined(_WIN32) || defined(_WIN64)) && defined(XGE_XRT_PROFILE_IDE) && !defined(XGE_NO_TEXT)
+    if ( iTextSize >= XUI_PROXY_XGE_DRAW_CACHE_MIN ) __xuiProxyXgeDrawCacheClear(NULL);
+#endif
+    memset(pShape, 0, sizeof(*pShape));
+    pShape->iSize = sizeof(*pShape);
+    pShape->iFlags = iFlags;
+    pShape->iTextSize = iTextSize;
+    memset(&tDesc, 0, sizeof(tDesc));
+    tDesc.iSize = sizeof(tDesc);
+    tDesc.pFont = &pFont->tFont;
+    tDesc.sText = sText;
+    tDesc.iTextSize = iTextSize;
+    if ( (iFlags & XUI_TEXT_SHAPE_KERNING) != 0 ) tDesc.iFlags |= XGE_TEXT_SHAPE_KERNING;
+    if ( (iFlags & XUI_TEXT_SHAPE_EMOJI) != 0 ) tDesc.iFlags |= XGE_TEXT_SHAPE_EMOJI;
+    tDesc.iEmojiPresentation = XGE_EMOJI_PRESENTATION_AUTO;
+    tDesc.iEmojiLinePolicy = XGE_EMOJI_LINE_STABLE;
+    tDesc.fEmojiScale = 1.0f;
+    memset(&tRun, 0, sizeof(tRun));
+    memset(&tState, 0, sizeof(tState));
+    tState.onVisit = onVisit;
+    tState.pUser = pUser;
+    iRet = xgeInternalTextShapeVisit(&tDesc, &tRun, __xuiProxyXgeVisitPosition, &tState);
+    if ( iRet == XGE_OK && tState.bCluster ) tState.iError = onVisit(&tState.tCluster, pUser);
+    if ( iRet == XGE_OK && tState.iError == XUI_OK ) {
+        pShape->fWidth = tRun.fWidth;
+        pShape->fHeight = tRun.fHeight;
+        pShape->fAscent = tRun.fAscent;
+        pShape->fDescent = tRun.fDescent;
+        pShape->fLineHeight = tRun.fLineHeight;
+        pShape->iClusterCount = tState.iCount;
+    }
+    xgeGlyphRunFree(&tRun);
+    return tState.iError != XUI_OK ? tState.iError : iRet;
+}
