extern "xssh_code_name" func __xssh_code_name(int code) as string
extern "xssh_last_error" func __xssh_error() as string
extern "xssh_name_valid_native" func __xssh_name_valid(
    string name, c_size size) as bool
extern "xssh_language_valid_native" func __xssh_language_valid(
    string language, c_size size) as bool
extern "xssh_name_list_valid_native" func __xssh_name_list_valid(
    string names, c_size size) as bool
extern "xssh_name_list_contains_native" func __xssh_name_list_contains(
    string names, c_size namesSize, string name, c_size nameSize) as bool
extern "xssh_name_list_duplicate_native" func __xssh_name_list_duplicate(
    string names, c_size size) as bool
extern "xssh_name_list_first_native" func __xssh_name_list_first(
    string preferred, c_size preferredSize,
    string available, c_size availableSize) as point
extern "xssh_fingerprint_native" func __xssh_fingerprint(
    point blob, c_size size) as point
extern "xssh_reader_create_text_native" func __xssh_reader_text(
    string data, c_size size) as point
extern "xssh_known_host_patterns_native" func __xssh_known_host_patterns(
    string patterns, c_size patternsSize, string host, c_size hostSize,
    c_uint port) as c_int
extern "xssh_known_host_hash_write_native" func __xssh_known_host_hash_write(
    string host, c_size hostSize, c_uint port,
    point salt, c_size saltSize) as point
