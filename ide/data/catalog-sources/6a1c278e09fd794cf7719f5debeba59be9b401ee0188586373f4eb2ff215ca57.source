extern "xsysinfo_os_name" @owned func __si_os() as string
extern "xsysinfo_os_version" @owned func __si_ver() as string
extern "xsysinfo_arch" @owned func __si_arch() as string
extern "xsysinfo_hostname" @owned func __si_host() as string
extern "xsysinfo_cpu_count" func __si_cpus() as int
extern "xsysinfo_mem_total" func __si_memtotal() as int
extern "xsysinfo_mem_available" func __si_memavail() as int
extern "xsysinfo_mem_usage_pct" func __si_mempct() as int
extern "xsysinfo_page_size" func __si_pagesz() as int
extern "xsysinfo_uptime" func __si_uptime() as int
extern "xsysinfo_cpu_name" @owned func __si_cpuname() as string



export func osName() as string
    return __si_os()
end

export func osVersion() as string
    return __si_ver()
end

export func arch() as string
    return __si_arch()
end

export func hostname() as string
    return __si_host()
end

export func cpuCount() as int
    return __si_cpus()
end

export func cpuName() as string
    return __si_cpuname()
end

export func memTotal() as int
    return __si_memtotal()
end

export func memAvailable() as int
    return __si_memavail()
end

export func memUsagePct() as int
    return __si_mempct()
end

export func pageSize() as int
    return __si_pagesz()
end

export func uptime() as int
    return __si_uptime()
end
