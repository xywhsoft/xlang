extern "xcli_parse" func __cli_parse(var args, var spec) as var



// parse 解析命令行参数数组，spec 结构：
//   flags: ["verbose", "force"]       布尔旗标（单字母自动可用 -v/-f）
//   options: {"output": "o"}          选项名到短字母映射（无短字母用空串）
//   defaults: {"level": "3"}          选项默认值
//   positional: ["src", "dst"]        位置参数名
// 返回 {"ok", "error", "flags", "options", "positional", "rest"}
// 用户输入错误时 ok=false 且 error 带说明；只有 spec 本身非法才抛 ValueError
export func parse(var args, var spec) as var
    var r = __cli_parse(args, spec)
    if r == null then
        throw ValueError "cli: parse requires an args array and a spec object"
    end
    return r
end

// parseOs 使用当前进程参数解析（等价于 parse(os.args(), spec)）
export func parseOs(var spec) as var
    return parse(os.args(), spec)
end

// usage 由 spec 生成简短用法说明文本
export func usage(string program, var spec) as string
    string text = "usage: " + program
    var flags = spec["flags"]
    if flags != null then
        for f in flags
            text = text + " [--" + string(f) + "]"
        end
    end
    var options = spec["options"]
    if options != null then
        for name, shorts in options
            text = text + " [--" + string(name) + " VALUE]"
        end
    end
    var positional = spec["positional"]
    if positional != null then
        for p in positional
            text = text + " <" + string(p) + ">"
        end
    end
    return text
end
