import xhttp.body
import xhttp.body_codec
import xhttp.protocol
from xhttp.body import Body
from xhttp.body_codec import InflateConfig
from xhttp.protocol import Headers



extern "xhttp_body_decode_value" func __xhttp_body_decode_value(
    point source, string encoding, c_size encodingSize,
    c_longlong format, c_longlong outputLimit,
    c_longlong gzipHeaderLimit, c_longlong windowBits,
    c_longlong readSize, c_longlong queueLimit,
    c_longlong maxCodings) as point
extern "xhttp_body_decode_headers" func __xhttp_body_decode_headers(
    point source, point headers,
    c_longlong format, c_longlong outputLimit,
    c_longlong gzipHeaderLimit, c_longlong windowBits,
    c_longlong readSize, c_longlong queueLimit,
    c_longlong maxCodings) as point



export const int DECODE_ERROR = -1
export const int DECODE_UNCHANGED = 0
export const int DECODE_APPLIED = 1
export const int DECODE_UNSUPPORTED = 2
export const int CONTENT_CODINGS_DEFAULT = 4
export const int CONTENT_CODINGS_MAX = 16



// BodyDecodeResult 保留解码决策，并拥有结果 Body 的独立引用。
export class BodyDecodeResult
    native point handle
    extern "xhttp_body_decode_result_wrap" create(point handle)
    extern "xhttp_body_decode_result_destroy" destroy()
    extern "xhttp_body_decode_result_status" func statusNative() as c_longlong
    extern "xhttp_body_decode_result_body" func bodyNative() as point

    get status() as int
        return int(self.statusNative())
    end

    get applied() as bool
        return self.status == DECODE_APPLIED
    end

    get unchanged() as bool
        return self.status == DECODE_UNCHANGED
    end

    get supported() as bool
        return self.status != DECODE_UNSUPPORTED
    end

    get body() as Body
        point result = self.bodyNative()
        if result == null then
            throw RuntimeError xhttp.body.lastError()
        end
        return Body(result)
    end
end



// 验证自动解码层的层数和 Inflate 安全预算。
func __xhttp_body_decode_config(
    InflateConfig config,
    int maxCodings
)
    if not config.valid then
        throw ValueError "Invalid HTTP body Inflate configuration"
    end
    if maxCodings <= 0 or maxCodings > CONTENT_CODINGS_MAX then
        throw ValueError "Content-Encoding layer limit is invalid"
    end
end



// 检查并接管原生解码结果。
func __xhttp_body_decode_result(point handle) as BodyDecodeResult
    if handle == null then
        throw RuntimeError xhttp.body.lastError()
    end
    return BodyDecodeResult(handle)
end



// 按单个 Content-Encoding 字段值自动解码，未知编码返回原正文引用。
export func decode(Body source, string contentEncoding) as BodyDecodeResult
    return decode(
        source,
        contentEncoding,
        InflateConfig(),
        CONTENT_CODINGS_DEFAULT)
end



// 按单个字段值和显式安全预算自动解码。
export func decode(
    Body source,
    string contentEncoding,
    InflateConfig config,
    int maxCodings = CONTENT_CODINGS_DEFAULT
) as BodyDecodeResult
    __xhttp_body_decode_config(config, maxCodings)
    return __xhttp_body_decode_result(__xhttp_body_decode_value(
        source.nativeHandle(),
        contentEncoding,
        c_size(string.byteLen(contentEncoding)),
        c_longlong(config.format),
        c_longlong(config.outputLimit),
        c_longlong(config.gzipHeaderLimit),
        c_longlong(config.windowBits),
        c_longlong(config.readSize),
        c_longlong(config.queueLimit),
        c_longlong(maxCodings)))
end



// 零拼接扫描 Headers 中全部重复 Content-Encoding 字段。
export func decode(Body source, Headers headers) as BodyDecodeResult
    return decode(
        source,
        headers,
        InflateConfig(),
        CONTENT_CODINGS_DEFAULT)
end



// 按完整 Headers 和显式安全预算自动解码。
export func decode(
    Body source,
    Headers headers,
    InflateConfig config,
    int maxCodings = CONTENT_CODINGS_DEFAULT
) as BodyDecodeResult
    __xhttp_body_decode_config(config, maxCodings)
    return __xhttp_body_decode_result(__xhttp_body_decode_headers(
        source.nativeHandle(),
        headers.nativeHandle(),
        c_longlong(config.format),
        c_longlong(config.outputLimit),
        c_longlong(config.gzipHeaderLimit),
        c_longlong(config.windowBits),
        c_longlong(config.readSize),
        c_longlong(config.queueLimit),
        c_longlong(maxCodings)))
end
