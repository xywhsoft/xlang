extern "xl6_xrt_last_error_text" func __lru_error() as string

// 只验证借用的输入，不为返回校验结果复制整段正文。
func __lru_text(string value)
    if string.indexOf(value, "\0", false, string.byteLen(value), 1) >= 0 then
        throw ValueError "lru: text contains NUL"
    end
end

export class LruCache
    native point handle
    extern "xlru_create" create(int capacity, int mode)
    extern "xlru_destroy" destroy()

    private extern "xlru_put" func putNative(string key, string value) as int
    private extern "xlru_get" func getNative(string key, string fallback) as point
    private extern "xlru_contains" func containsNative(string key) as int
    private extern "xlru_remove" func removeNative(string key) as int
    private extern "xlru_clear" func clearNative() as int
    private extern "xlru_count" func countNative() as int
    private extern "xlru_capacity" func capacityNative() as int
    private extern "xlru_hits" func hitsNative() as int
    private extern "xlru_misses" func missesNative() as int

    get valid() as bool
        return self.handle != null
    end

    get count() as int
        int result = self.countNative()
        if result < 0 then throw RuntimeError __lru_error() end
        return result
    end

    get capacity() as int
        int result = self.capacityNative()
        if result < 0 then throw RuntimeError __lru_error() end
        return result
    end

    get hits() as int
        int result = self.hitsNative()
        if result < 0 then throw RuntimeError __lru_error() end
        return result
    end

    get misses() as int
        int result = self.missesNative()
        if result < 0 then throw RuntimeError __lru_error() end
        return result
    end

    func put(string key, string value)
        if self.handle == null then throw RuntimeError "lru: cache is closed" end
        __lru_text(key)
        __lru_text(value)
        if self.putNative(key, value) == 0 then throw RuntimeError __lru_error() end
    end

    func get(string key, string default = "") as string
        if self.handle == null then throw RuntimeError "lru: cache is closed" end
        __lru_text(key)
        __lru_text(default)
        point result = self.getNative(key, default)
        if result == null then throw RuntimeError __lru_error() end
        return __xl_runtime.takeCstr(result)
    end

    func contains(string key) as bool
        if self.handle == null then throw RuntimeError "lru: cache is closed" end
        __lru_text(key)
        int result = self.containsNative(key)
        if result < 0 then throw RuntimeError __lru_error() end
        return result != 0
    end

    func remove(string key) as bool
        if self.handle == null then throw RuntimeError "lru: cache is closed" end
        __lru_text(key)
        int result = self.removeNative(key)
        if result < 0 then throw RuntimeError __lru_error() end
        return result != 0
    end

    func clear()
        if self.handle == null then throw RuntimeError "lru: cache is closed" end
        if self.clearNative() == 0 then throw RuntimeError __lru_error() end
    end
end

export func create(int capacity) as LruCache
    if capacity <= 0 then throw ValueError "lru: capacity must be positive" end
    LruCache cache = LruCache(capacity, 0)
    if not cache.valid then throw RuntimeError __lru_error() end
    return cache
end

export func createLFU(int capacity) as LruCache
    if capacity <= 0 then throw ValueError "lru: capacity must be positive" end
    LruCache cache = LruCache(capacity, 1)
    if not cache.valid then throw RuntimeError __lru_error() end
    return cache
end
