// xge_oop.xl - XGE 引擎层 OOP 封装
// 此文件手工维护，提供 XgeApp / Shape / Color / Camera 等 class
// 依赖 xge_core.xl / xge_shape.xl / xge_render.xl 的自动生成函数转接层

// ========================================
// Color — 颜色工具
// ========================================
export class Color
    static func rgba(int r, int g, int b, int a) as uint32
        return uint32((r & 255) << 24 | (g & 255) << 16 | (b & 255) << 8 | (a & 255))
    end

    static func rgb(int r, int g, int b) as uint32
        return Color.rgba(r, g, b, 255)
    end

    static func white() as uint32
        return Color.rgba(255, 255, 255, 255)
    end

    static func black() as uint32
        return Color.rgba(0, 0, 0, 255)
    end

    static func red() as uint32
        return Color.rgba(255, 107, 94, 255)
    end

    static func green() as uint32
        return Color.rgba(79, 216, 194, 255)
    end

    static func yellow() as uint32
        return Color.rgba(255, 180, 84, 255)
    end

    static func blue() as uint32
        return Color.rgba(109, 179, 242, 255)
    end

    static func gray() as uint32
        return Color.rgba(100, 120, 140, 255)
    end
end

// ========================================
// XgeApp — XGE 引擎应用（全局单例，静态方法）
// ========================================
export class XgeApp
    // 初始化窗口并启动引擎
    static func init(int width, int height, string title) as int
        c_int ret = xgeTutorialInit(c_int(width), c_int(height), title)
        return int(ret)
    end

    // 初始化窗口（带额外 flags，flags 暂时只支持 VSYNC 默认开启）
    static func initEx(int width, int height, string title, int flags) as int
        c_int ret = xgeTutorialInit(c_int(width), c_int(height), title)
        return int(ret)
    end

    // 运行帧循环，onFrame 是每帧回调
    // 用法：XgeApp.run(onFrame) — onFrame 可以是 func() 或 var
    static func run(var onFrame) as int
        c_int ret = xgeTutorialRun(onFrame)
        return int(ret)
    end

    // 帧开始 + 清屏
    static func beginFrame(uint32 clearColor) as int
        c_int ret = xgeTutorialBeginFrame(c_uint(clearColor))
        return int(ret)
    end

    // 帧结束（提交渲染）
    static func endFrame() as int
        c_int ret = xgeTutorialEndFrame()
        return int(ret)
    end

    // 获取帧间隔（秒）
    static func delta() as float
        c_float d = xgeGetDelta()
        return float(d)
    end

    // 获取当前 FPS
    static func fps() as int
        c_int f = xgeGetFPS()
        return int(f)
    end

    // 请求退出运行循环
    static func quit()
        xgeQuit()
    end

    // 像素精确视口（半开区间 [x, x+w) × [y, y+h)）
    static func setViewportPixels(int x, int y, int w, int h)
        xgeViewportSetPixels(c_int(x), c_int(y), c_int(w), c_int(h))
    end

    // 像素精确裁剪
    static func setClipPixels(int x, int y, int w, int h)
        xgeClipSetPixels(c_int(x), c_int(y), c_int(w), c_int(h))
    end

    // 帧数上限（达到后自动退出；0 = 不限。用于 CI/无头冒烟验证）
    static func setMaxFrames(int maxFrames)
        __xl6_xgeSetMaxFrames(c_int(maxFrames))
    end
end

// ========================================
// Camera — 相机控制
// ========================================
export class Camera
    // 设置简单正交相机
    static func setSimple(float posX, float posY, float scaleX, float scaleY, float width, float height)
        xgeCameraSetSimple(c_float(posX), c_float(posY), c_float(scaleX), c_float(scaleY), c_float(width), c_float(height))
    end
end

// ========================================
// Shape — 形状绘制（即时模式）
// 所有方法在 XgeApp.beginFrame / endFrame 之间调用
// ========================================
export class Shape
    // --- 矩形 ---
    static func rectFill(float x, float y, float w, float h, uint32 color)
        xgeShapeRectFill(c_float(x), c_float(y), c_float(w), c_float(h), c_uint(color))
    end

    static func rectStroke(float x, float y, float w, float h, float lineWidth, uint32 color)
        xgeShapeRectStroke(c_float(x), c_float(y), c_float(w), c_float(h), c_float(lineWidth), c_uint(color))
    end

    // 像素精确矩形填充（整数像素坐标，半开区间，无亚像素模糊）
    static func rectFillPixels(int x, int y, int w, int h, uint32 color)
        xgeShapeRectFillPixels(c_int(x), c_int(y), c_int(w), c_int(h), c_uint(color))
    end

    // 像素精确矩形边框（四边独立宽度）
    static func rectBorderPixels(int x, int y, int w, int h, int left, int top, int right, int bottom, uint32 color)
        xgeShapeRectBorderPixels(c_int(x), c_int(y), c_int(w), c_int(h), c_int(left), c_int(top), c_int(right), c_int(bottom), c_uint(color))
    end

    // --- 圆角矩形 ---
    static func roundRectFill(float x, float y, float w, float h, float radius, uint32 color)
        xgeShapeRoundRectFill(c_float(x), c_float(y), c_float(w), c_float(h), c_float(radius), c_uint(color))
    end

    static func roundRectStroke(float x, float y, float w, float h, float radius, float lineWidth, uint32 color)
        xgeShapeRoundRectStroke(c_float(x), c_float(y), c_float(w), c_float(h), c_float(radius), c_float(lineWidth), c_uint(color))
    end

    static func roundRectDraw(float x, float y, float w, float h, float radius, uint32 fillColor, float strokeWidth, uint32 strokeColor)
        xgeShapeRoundRectDraw(c_float(x), c_float(y), c_float(w), c_float(h), c_float(radius), c_uint(fillColor), c_float(strokeWidth), c_uint(strokeColor))
    end

    // 四角独立半径圆角矩形
    static func roundRectFillEx(float x, float y, float w, float h, float tl, float tr, float br, float bl, int mode, uint32 color)
        xgeShapeRoundRectFillEx(c_float(x), c_float(y), c_float(w), c_float(h), c_float(tl), c_float(tr), c_float(br), c_float(bl), c_int(mode), c_uint(color))
    end

    static func roundRectStrokeEx(float x, float y, float w, float h, float tl, float tr, float br, float bl, int mode, float lineWidth, uint32 color)
        xgeShapeRoundRectStrokeEx(c_float(x), c_float(y), c_float(w), c_float(h), c_float(tl), c_float(tr), c_float(br), c_float(bl), c_int(mode), c_float(lineWidth), c_uint(color))
    end

    // --- 圆形 ---
    static func circleFill(float x, float y, float radius, uint32 color)
        xgeShapeCircleFill(c_float(x), c_float(y), c_float(radius), c_uint(color))
    end

    static func circleStroke(float x, float y, float radius, float lineWidth, uint32 color)
        xgeShapeCircleStroke(c_float(x), c_float(y), c_float(radius), c_float(lineWidth), c_uint(color))
    end

    // --- 直线 ---
    static func line(float x1, float y1, float x2, float y2, float lineWidth, uint32 color)
        xgeShapeLine(c_float(x1), c_float(y1), c_float(x2), c_float(y2), c_float(lineWidth), c_uint(color))
    end

    // --- 点 ---
    static func point(float x, float y, float size, uint32 color)
        xgeShapePoint(c_float(x), c_float(y), c_float(size), c_uint(color))
    end

    // --- 三角形 ---
    static func triangleFill(float x0, float y0, float x1, float y1, float x2, float y2, uint32 color)
        xgeShapeTriangleFill(c_float(x0), c_float(y0), c_float(x1), c_float(y1), c_float(x2), c_float(y2), c_uint(color))
    end

    static func triangleStroke(float x0, float y0, float x1, float y1, float x2, float y2, float lineWidth, uint32 color)
        xgeShapeTriangleStroke(c_float(x0), c_float(y0), c_float(x1), c_float(y1), c_float(x2), c_float(y2), c_float(lineWidth), c_uint(color))
    end

    // --- 胶囊 ---
    static func capsuleFill(float x, float y, float w, float h, uint32 color)
        xgeShapeCapsuleFill(c_float(x), c_float(y), c_float(w), c_float(h), c_uint(color))
    end

    static func capsuleStroke(float x, float y, float w, float h, float lineWidth, uint32 color)
        xgeShapeCapsuleStroke(c_float(x), c_float(y), c_float(w), c_float(h), c_float(lineWidth), c_uint(color))
    end

    // --- 椭圆（参数为半径） ---
    static func ellipseFill(float x, float y, float radiusX, float radiusY, uint32 color)
        xgeShapeEllipseFill(c_float(x), c_float(y), c_float(radiusX), c_float(radiusY), c_uint(color))
    end

    static func ellipseStroke(float x, float y, float radiusX, float radiusY, float lineWidth, uint32 color)
        xgeShapeEllipseStroke(c_float(x), c_float(y), c_float(radiusX), c_float(radiusY), c_float(lineWidth), c_uint(color))
    end

    // --- 弧形（参数为半径、弧度） ---
    static func arc(float x, float y, float radius, float startRadians, float endRadians, float lineWidth, uint32 color)
        xgeShapeArc(c_float(x), c_float(y), c_float(radius), c_float(startRadians), c_float(endRadians), c_float(lineWidth), c_uint(color))
    end

    // --- 扇形（参数为半径、弧度） ---
    static func pieFill(float x, float y, float radiusX, float radiusY, float startRadians, float endRadians, uint32 color)
        xgeShapePieFill(c_float(x), c_float(y), c_float(radiusX), c_float(radiusY), c_float(startRadians), c_float(endRadians), c_uint(color))
    end

    // --- 弓形（参数为半径、弧度） ---
    static func chordFill(float x, float y, float radiusX, float radiusY, float startRadians, float endRadians, uint32 color)
        xgeShapeChordFill(c_float(x), c_float(y), c_float(radiusX), c_float(radiusY), c_float(startRadians), c_float(endRadians), c_uint(color))
    end
end


// ========================================
// 游戏基础设施 bridge extern 声明（来自 xge_native.c）
// ========================================
extern "__xl6_xgeMouseX" func __xl6_xgeMouseX() as c_float
extern "__xl6_xgeMouseY" func __xl6_xgeMouseY() as c_float
extern "__xl6_xgeDrawScaled" func __xl6_xgeDrawScaled(point pTex, c_float fX, c_float fY, c_float fW, c_float fH, c_uint iColor)
extern "__xl6_xgeSetMaxFrames" func __xl6_xgeSetMaxFrames(c_int iMaxFrames)

// ========================================
// Input — 输入查询（键盘/鼠标/手柄，静态方法）
// 键码常量用 xge.XGE_KEY_*（xge_core.xl 已导出）
// ========================================
export class Input
    // --- 键盘 ---
    static func keyPressed(int key) as bool
        return xgeKeyPressed(c_int(key)) != 0
    end

    static func keyDown(int key) as bool
        return xgeKeyDown(c_int(key)) != 0
    end

    // --- 鼠标 ---
    static func mouseX() as float
        return float(__xl6_xgeMouseX())
    end

    static func mouseY() as float
        return float(__xl6_xgeMouseY())
    end

    static func mouseDown(int button) as bool
        return xgeMouseDown(c_int(button)) != 0
    end

    // 按钮常量：xge.XGE_MOUSE_LEFT=1 / RIGHT=2 / MIDDLE=4
    static func mouseLeftDown() as bool
        return xgeMouseDown(c_int(1)) != 0
    end

    static func mouseRightDown() as bool
        return xgeMouseDown(c_int(2)) != 0
    end

    // --- 手柄 ---
    static func gamepadConnected(int pad) as bool
        return xgeGamepadConnected(c_int(pad)) != 0
    end

    static func gamepadButtonDown(int pad, int button) as bool
        return xgeGamepadButtonDown(c_int(pad), c_uint(button)) != 0
    end

    static func gamepadAxis(int pad, int axis) as float
        return float(xgeGamepadAxis(c_int(pad), c_int(axis)))
    end
end

// ========================================
// Font — 字体（native-backed，用于游戏内文本/HUD）
// ========================================
export class Font
    native point handle

    extern "__xl6_xgeFontLoadFile" create(string path, c_float size)
    extern "__xl6_xgeFontFreeFile" destroy()

    // 绘制文本（原色）
    func drawText(string text, float x, float y, uint32 color)
        xgeTextDraw(self.handle, text, c_float(x), c_float(y), c_uint(color))
    end

    get valid() as bool
        return self.handle != null
    end
end

// ========================================
// Texture — 纹理/精灵图（native-backed）
// ========================================
export class Texture
    native point handle

    extern "__xl6_xgeTextureLoadFile" create(string path)
    extern "__xl6_xgeTextureFreeFile" destroy()

    // 原尺寸绘制
    func draw(float x, float y)
        xgeDraw(self.handle, c_float(x), c_float(y))
    end

    // 缩放 + 着色绘制（color=255,255,255,255 为原色，可调 alpha 做半透明）
    func drawScaled(float x, float y, float w, float h, uint32 color)
        __xl6_xgeDrawScaled(self.handle, c_float(x), c_float(y), c_float(w), c_float(h), c_uint(color))
    end

    get valid() as bool
        return self.handle != null
    end
end

// ========================================
// Sound — 音效（native-backed，短音效，可重叠播放）
// ========================================
export class Sound
    native point handle

    extern "__xl6_xgeSoundLoadFile" create(string path)
    extern "__xl6_xgeSoundFreeFile" destroy()

    func play() as int
        return int(xgeSoundPlay(self.handle))
    end

    func stop() as int
        return int(xgeSoundStop(self.handle))
    end

    func setVolume(float volume)
        xgeSoundSetVolume(self.handle, c_float(volume))
    end

    get valid() as bool
        return self.handle != null
    end
end

// ========================================
// Music — 背景音乐（native-backed，流式播放）
// ========================================
export class Music
    native point handle

    extern "__xl6_xgeMusicLoadFile" create(string path)
    extern "__xl6_xgeMusicFreeFile" destroy()

    func play() as int
        return int(xgeMusicPlay(self.handle))
    end

    func stop() as int
        return int(xgeMusicStop(self.handle))
    end

    get valid() as bool
        return self.handle != null
    end
end
