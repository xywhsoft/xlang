extern "xsrt_parse_n" func __srt_parse(string text, c_size size) as var
extern "xsrt_parse_vtt_n" func __srt_parse_vtt(string text, c_size size) as var
extern "xsrt_build" @owned func __srt_build(var cues) as string
extern "xsrt_build_vtt" @owned func __srt_build_vtt(var cues) as string
extern "xsrt_format_time" @owned func __srt_format_time(int ms) as string
extern "xsrt_parse_time_n" func __srt_parse_time(string stamp, c_size size) as int



// parse 解析 SRT 字幕，返回 [{index, startMs, endMs, lines}]；格式错误抛 ValueError
export func parse(string text) as var
    var r = __srt_parse(text, c_size(string.byteLen(text)))
    if r == null then
        throw ValueError "srt: invalid subtitle document"
    end
    return r
end

// parseVtt 解析 WebVTT 字幕（WEBVTT 头、点号毫秒、可选 ID）
export func parseVtt(string text) as var
    var r = __srt_parse_vtt(text, c_size(string.byteLen(text)))
    if r == null then
        throw ValueError "srt: invalid webvtt document"
    end
    return r
end

// build 由 cue 数组生成 SRT 文本（序号自动重排）
export func build(var cues) as string
    return __srt_build(cues)
end

// buildVtt 由 cue 数组生成 WebVTT 文本
export func buildVtt(var cues) as string
    return __srt_build_vtt(cues)
end

// formatTime 把毫秒格式化为 "HH:MM:SS,mmm"
export func formatTime(int ms) as string
    return __srt_format_time(ms)
end

// parseTime 解析 "HH:MM:SS,mmm" 或 "HH:MM:SS.mmm"；非法输入抛 ValueError
export func parseTime(string stamp) as int
    int r = __srt_parse_time(stamp, c_size(string.byteLen(stamp)))
    if r < 0 then
        throw ValueError "srt: invalid timestamp: " + stamp
    end
    return r
end
