        return int(xuiWidgetSetLayoutType(self.handle, c_int(type)))
    end
    func setEnabled(int enabled) as int
        return int(xuiWidgetSetEnabled(self.handle, c_int(enabled)))
    end
    func setVisible(int visible) as int
        return int(xuiWidgetSetVisible(self.handle, c_int(visible)))
    end
    func setMargin(float l, float t, float r, float b) as int
        return int(__xuiOop_xuiWidgetSetMargin(self.handle, c_float(l), c_float(t), c_float(r), c_float(b)))
    end
    func setPadding(float l, float t, float r, float b) as int
        return int(__xuiOop_xuiWidgetSetPadding(self.handle, c_float(l), c_float(t), c_float(r), c_float(b)))
    end
    func setPreferredSize(float w, float h) as int
        return int(__xuiOop_xuiWidgetSetPreferredSize(self.handle, c_float(w), c_float(h)))
    end
    func setFlex(float grow, float shrink) as int
        return int(xuiWidgetSetFlex(self.handle, c_float(grow), c_float(shrink)))
    end
    func setAlign(int alignX, int alignY) as int
        return int(xuiWidgetSetAlign(self.handle, c_int(alignX), c_int(alignY)))
    end
end

