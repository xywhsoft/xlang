// xui_oop.xl - XUI OOP 封装层
// 此文件手工维护，提供 XuiApp / Widget 基类 / 基础控件 class
// 依赖 xui_core.xl 等自动生成的函数转接层 + xui_native.c 的 C bridge

// ========================================
// OOP bridge extern 声明（来自 xui_native.c）
// ========================================

// XuiApp 框架 bridge
extern "__xl6_xuiAppCreate" func __xuiOop_xuiAppCreate(c_int iWidth, c_int iHeight, string sTitle) as point
extern "__xl6_xuiAppFrame" func __xuiOop_xuiAppFrame(point pApp, c_uint iBgColor) as c_int
extern "__xl6_xuiAppContext" func __xuiOop_xuiAppContext(point pApp) as point
extern "__xl6_xuiAppRoot" func __xuiOop_xuiAppRoot(point pApp) as point
extern "__xl6_xuiAppFont" func __xuiOop_xuiAppFont(point pApp) as point
extern "__xl6_xuiAppRun" func __xuiOop_xuiAppRun(point pApp, var pFunc) as c_int

// Widget 基类结构体参数 bridge
extern "__xl6_xuiWidgetSetRect" func __xuiOop_xuiWidgetSetRect(point pWidget, c_float fX, c_float fY, c_float fW, c_float fH) as c_int
extern "__xl6_xuiWidgetSetPreferredSize" func __xuiOop_xuiWidgetSetPreferredSize(point pWidget, c_float fW, c_float fH) as c_int
extern "__xl6_xuiWidgetSetMinSize" func __xuiOop_xuiWidgetSetMinSize(point pWidget, c_float fW, c_float fH) as c_int
extern "__xl6_xuiWidgetSetMaxSize" func __xuiOop_xuiWidgetSetMaxSize(point pWidget, c_float fW, c_float fH) as c_int
extern "__xl6_xuiWidgetSetMargin" func __xuiOop_xuiWidgetSetMargin(point pWidget, c_float fL, c_float fT, c_float fR, c_float fB) as c_int
extern "__xl6_xuiWidgetSetPadding" func __xuiOop_xuiWidgetSetPadding(point pWidget, c_float fL, c_float fT, c_float fR, c_float fB) as c_int

// 控件创建 bridge（out 参数 → 直接返回 handle）
extern "__xl6_xuiButtonCreate" func __xuiOop_xuiButtonCreate(point pCtx, string sText, point pFont) as point
extern "__xl6_xuiLabelCreate" func __xuiOop_xuiLabelCreate(point pCtx, string sText, point pFont) as point
extern "__xl6_xuiPanelCreate" func __xuiOop_xuiPanelCreate(point pCtx) as point
extern "__xl6_xuiCheckBoxCreate" func __xuiOop_xuiCheckBoxCreate(point pCtx, string sText, point pFont) as point
extern "__xl6_xuiRadioCreate" func __xuiOop_xuiRadioCreate(point pCtx, string sText, point pFont) as point
extern "__xl6_xuiToggleCreate" func __xuiOop_xuiToggleCreate(point pCtx, string sText, point pFont) as point
extern "__xl6_xuiSliderCreate" func __xuiOop_xuiSliderCreate(point pCtx, c_float fMin, c_float fMax, c_float fValue) as point
extern "__xl6_xuiProgressCreate" func __xuiOop_xuiProgressCreate(point pCtx, c_float fMin, c_float fMax, c_float fValue) as point
extern "__xl6_xuiSeparatorCreate" func __xuiOop_xuiSeparatorCreate(point pCtx) as point
extern "__xl6_xuiImageCreate" func __xuiOop_xuiImageCreate(point pCtx) as point
extern "__xl6_xuiHyperlinkCreate" func __xuiOop_xuiHyperlinkCreate(point pCtx, string sText, point pFont) as point

// 回调 bridge
extern "__xl6_xuiButtonSetClick" func __xuiOop_xuiButtonSetClick(point pWidget, var pFunc)
extern "__xl6_xuiHyperlinkSetClick" func __xuiOop_xuiHyperlinkSetClick(point pWidget, var pFunc)

// 辅助对象 bridge（模式 B/C）
extern "__xl6_xuiMsgBoxCreate" func __xuiOop_xuiMsgBoxCreate(point pCtx, string sTitle, string sMessage, point pFont) as point
extern "__xl6_xuiFileDialogCreate" func __xuiOop_xuiFileDialogCreate(point pCtx) as point
extern "__xl6_xuiMsgTipCreate" func __xuiOop_xuiMsgTipCreate(point pCtx) as point
extern "__xl6_xuiToastCreate" func __xuiOop_xuiToastCreate(point pCtx, point pFont) as point
extern "__xl6_xuiToastShow" func __xuiOop_xuiToastShow(point pToast, c_int iType, string sTitle, string sMessage, c_float fDuration) as c_int
extern "__xl6_xuiPathCreate" func __xuiOop_xuiPathCreate() as point
extern "__xl6_xuiFlowGraphCreate" func __xuiOop_xuiFlowGraphCreate() as point
extern "__xl6_xuiCodeDocumentCreate" func __xuiOop_xuiCodeDocumentCreate() as point
extern "__xl6_xuiRichDocumentCreate" func __xuiOop_xuiRichDocumentCreate() as point

// ========================================
// XuiApp — XUI 应用框架（封装完整生命周期）
// ========================================
export class XuiApp
    native point handle

    extern "__xl6_xuiAppCreate" create(c_int width, c_int height, string title)
    extern "__xl6_xuiAppDestroy" destroy()

    // 获取 context 句柄（传给控件创建函数）
    func context() as point
        return __xuiOop_xuiAppContext(self.handle)
    end

    // 获取 root widget 句柄
    func rootHandle() as point
        return __xuiOop_xuiAppRoot(self.handle)
    end

    // 获取默认字体句柄
    func font() as point
        return __xuiOop_xuiAppFont(self.handle)
    end

    // 帧管线（输入注入 + 布局 + 渲染）
    func frame(uint32 bgColor) as int
        c_int ret = __xuiOop_xuiAppFrame(self.handle, c_uint(bgColor))
        return int(ret)
    end

    // 启动运行循环，onUpdate 是每帧业务逻辑回调
    func run(var onUpdate) as int
        c_int ret = __xuiOop_xuiAppRun(self.handle, onUpdate)
        return int(ret)
    end
end

// ========================================
// Widget — 控件基类（封装通用 widget 方法）
// 各控件 class 内部持有 point handle，手动暴露常用方法
// ========================================
export class Widget
    native point handle

    // 构造：包装已有 handle（借用语义，不管理生命周期）
    create(point handle)
    end

    extern "__xl6_xuiWidgetDestroyOwned" destroy()

    // --- 树操作 ---
    func addChild(Widget child) as int
        return int(xuiWidgetAddChild(self.handle, child.handle))
    end

    func removeFromParent() as int
        return int(xuiWidgetRemoveFromParent(self.handle))
    end

    func childCount() as int
        return int(xuiWidgetGetChildCount(self.handle))
    end

    // --- 几何 ---
    func setRect(float x, float y, float w, float h) as int
        c_int ret = __xuiOop_xuiWidgetSetRect(self.handle, c_float(x), c_float(y), c_float(w), c_float(h))
        return int(ret)
    end

    func setPreferredSize(float w, float h) as int
        c_int ret = __xuiOop_xuiWidgetSetPreferredSize(self.handle, c_float(w), c_float(h))
        return int(ret)
    end

    func setMinSize(float w, float h) as int
        c_int ret = __xuiOop_xuiWidgetSetMinSize(self.handle, c_float(w), c_float(h))
        return int(ret)
    end

    func setMaxSize(float w, float h) as int
        c_int ret = __xuiOop_xuiWidgetSetMaxSize(self.handle, c_float(w), c_float(h))
        return int(ret)
    end

    func setMargin(float left, float top, float right, float bottom) as int
        c_int ret = __xuiOop_xuiWidgetSetMargin(self.handle, c_float(left), c_float(top), c_float(right), c_float(bottom))
        return int(ret)
    end

    func setPadding(float left, float top, float right, float bottom) as int
        c_int ret = __xuiOop_xuiWidgetSetPadding(self.handle, c_float(left), c_float(top), c_float(right), c_float(bottom))
        return int(ret)
    end

    // --- 布局 ---
    func setLayoutType(int type) as int
        return int(xuiWidgetSetLayoutType(self.handle, c_int(type)))
    end

    func setSizeMode(int widthMode, int heightMode) as int
        return int(xuiWidgetSetSizeMode(self.handle, c_int(widthMode), c_int(heightMode)))
    end

    func setAlign(int alignX, int alignY) as int
        return int(xuiWidgetSetAlign(self.handle, c_int(alignX), c_int(alignY)))
    end

    func setGap(float gap) as int
        return int(xuiWidgetSetGap(self.handle, c_float(gap)))
    end

    func setFlex(float grow, float shrink) as int
        return int(xuiWidgetSetFlex(self.handle, c_float(grow), c_float(shrink)))
    end

    // --- 可视状态 ---
    func setVisible(int visible) as int
        return int(xuiWidgetSetVisible(self.handle, c_int(visible)))
    end

    func setEnabled(int enabled) as int
        return int(xuiWidgetSetEnabled(self.handle, c_int(enabled)))
    end

    // setTooltip 需要 xui_tooltip_desc_t 结构体，暂不在此层暴露
    // 可通过 setStyleName / addStyleClass 设置样式

    // --- 样式 ---
    func setStyleName(string name) as int
        return int(xuiWidgetSetStyleName(self.handle, name))
    end

    func addStyleClass(string className) as int
        return int(xuiWidgetAddStyleClass(self.handle, className))
    end

    func removeStyleClass(string className) as int
        return int(xuiWidgetRemoveStyleClass(self.handle, className))
    end

    // --- invalidate ---
    func invalidate(int flags) as int
        return int(xuiWidgetInvalidate(self.handle, c_uint(flags)))
    end
end

