    end

    func getText() as string
        return xuiLabelGetText(self.handle)
    end

    // Widget 通用方法
    func addChild(Widget child) as int
        return int(xuiWidgetAddChild(self.handle, child.handle))
    end
    func setRect(float x, float y, float w, float h) as int
        return int(__xuiOop_xuiWidgetSetRect(self.handle, c_float(x), c_float(y), c_float(w), c_float(h)))
