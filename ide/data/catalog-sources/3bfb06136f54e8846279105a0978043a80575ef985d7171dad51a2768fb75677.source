// ========================================
// 辅助对象 class（模式 B：对话框/通知，模式 C：独立对象）
// 这些对象不是 widget，使用各自的 destroy 函数
// ========================================

// MsgBox — 消息对话框（模式 B）
export class MsgBox
    native point handle

    extern "__xl6_xuiMsgBoxCreate" create(point ctx, string title, string message, point font)
    extern "__xl6_xuiMsgBoxDestroyOwned" destroy()

    func setText(string title, string message) as int
        return int(xuiMsgBoxSetText(self.handle, title, message))
    end

    func setTitle(string title) as int
        return int(xuiMsgBoxSetTitle(self.handle, title))
    end

    func getTitle() as string
        return xuiMsgBoxGetTitle(self.handle)
    end

    func setMessage(string message) as int
        return int(xuiMsgBoxSetMessage(self.handle, message))
    end

    func getMessage() as string
        return xuiMsgBoxGetMessage(self.handle)
    end

    func setType(int type) as int
        return int(xuiMsgBoxSetType(self.handle, c_int(type)))
    end

    func setButtons(int buttons) as int
        return int(xuiMsgBoxSetButtons(self.handle, c_int(buttons)))
    end

    func setOpen(int open) as int
        return int(xuiMsgBoxSetOpen(self.handle, c_int(open)))
    end

    func isOpen() as int
        return int(xuiMsgBoxIsOpen(self.handle))
    end
end

