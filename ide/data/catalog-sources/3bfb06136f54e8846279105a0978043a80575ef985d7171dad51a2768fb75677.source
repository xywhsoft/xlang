// Toast — 通知气泡（模式 B）
export class Toast
    native point handle

    extern "__xl6_xuiToastCreate" create(point ctx, point font)
    extern "__xl6_xuiToastDestroyOwned" destroy()

    func show(int type, string title, string message, float duration) as int
        return int(__xuiOop_xuiToastShow(self.handle, c_int(type), title, message, c_float(duration)))
    end

    func close(int toastId) as int
        return int(xuiToastClose(self.handle, c_int(toastId)))
    end

    func clear() as int
        return int(xuiToastClear(self.handle))
    end

    func activeCount() as int
        return int(xuiToastGetActiveCount(self.handle))
    end

    func setPlacement(int placement) as int
        return int(xuiToastSetPlacement(self.handle, c_int(placement)))
    end
end

// Path — 矢量路径（模式 C，无 context）
export class Path
    native point handle

    extern "__xl6_xuiPathCreate" create()
    extern "__xl6_xuiPathDestroyOwned" destroy()

    func clear() as int
        return int(xuiPathClear(self.handle))
    end

    func moveTo(float x, float y) as int
        return int(xuiPathMoveTo(self.handle, c_float(x), c_float(y)))
    end

    func lineTo(float x, float y) as int
        return int(xuiPathLineTo(self.handle, c_float(x), c_float(y)))
    end

    func quadTo(float cx, float cy, float x, float y) as int
        return int(xuiPathQuadTo(self.handle, c_float(cx), c_float(cy), c_float(x), c_float(y)))
    end

    func cubicTo(float c1x, float c1y, float c2x, float c2y, float x, float y) as int
        return int(xuiPathCubicTo(self.handle, c_float(c1x), c_float(c1y), c_float(c2x), c_float(c2y), c_float(x), c_float(y)))
    end

    func closePath() as int
        return int(xuiPathClose(self.handle))
    end
end

