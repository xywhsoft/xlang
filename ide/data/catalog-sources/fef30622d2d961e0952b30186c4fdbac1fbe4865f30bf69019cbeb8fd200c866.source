// xge_bridge.xl - 手动维护的桥接函数（回调 trampoline + 教程框架）
// 此文件不由 codegen 生成

// === 颜色工具 ===
export func XGE_COLOR_RGBA(c_uint r, c_uint g, c_uint b, c_uint a) as c_uint
    return (r & 255) << 24 | (g & 255) << 16 | (b & 255) << 8 | (a & 255)
end

// === 运行循环桥接 ===
extern "__xl6_xgeRunBridge" func __xl6_xgeRunBridge_native(var pFunc) as c_int
export func xgeRunBridge(var pFunc) as c_int
    return __xl6_xgeRunBridge_native(pFunc)
end

