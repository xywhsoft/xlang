{
    "format": "xlang-package-1",
    "name": "tar",
    "version": "1.0.0",
    "abiVersion": "1",
    "kind": "demo6-extlib",
    "artifact": {
        "kind": "source",
        "cSources": [
            "xrt_tar_common.c",
            "xrt_tar_reader.c",
            "xrt_tar_writer.c",
            "xrt_tar_extract.c",
            "tar_native.c"
        ],
        "xrtModules": [
            "XRT_MODULE_FILE_ROOT",
            "XRT_MODULE_FILE_TEMP",
            "XRT_MODULE_FILE_TREE",
            "XRT_MODULE_IO_BUFFER",
            "XRT_MODULE_IO_FILE",
            "XRT_MODULE_PATH_SAFE",
            "XRT_MODULE_STRING",
            "XRT_MODULE_STRING_FORMAT",
            "XRT_MODULE_SET",
            "XRT_MODULE_HASH64",
            "XRT_MODULE_NUMBER_INTEGER",
            "XRT_MODULE_VALUE_CONTAINER",
            "XRUNTIME_MODULE_RUNTIME_VALUE_CALLABLE"
        ],
        "xlSources": [
            "src/tar.xl"
        ]
    },
    "links": [],
    "loadlibs": [],
    "dependencies": [
        { "name": "gzip", "version": "1.0.0", "abiVersion": "1" },
        { "name": "bz2", "version": "1.0.0", "abiVersion": "1" },
        { "name": "lzma", "version": "1.0.0", "abiVersion": "1" }
    ],
    "coverage": { "mode": "suite", "tests": ["test/boundaries.xl", "test/named_type.xl", "test/numeric_ids.xl"] },
    "native": {
        "singleton": false,
        "loadName": "",
        "version": ""
    }
}
