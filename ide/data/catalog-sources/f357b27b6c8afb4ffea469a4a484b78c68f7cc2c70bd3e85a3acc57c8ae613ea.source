import xhttp.body
from xhttp.body import Body



extern "xhttp_body_codec_deflate" func __xhttp_body_codec_deflate(
    point source, c_longlong format, c_longlong level,
    c_longlong strategy, c_longlong outputLimit,
    c_longlong windowBits, c_longlong readSize,
    c_longlong queueLimit) as point
extern "xhttp_body_codec_inflate" func __xhttp_body_codec_inflate(
    point source, c_longlong format, c_longlong outputLimit,
    c_longlong gzipHeaderLimit, c_longlong windowBits,
    c_longlong readSize, c_longlong queueLimit) as point



export const int DEFLATE_RAW = 0
export const int DEFLATE_ZLIB = 1
export const int DEFLATE_GZIP = 2

export const int DEFLATE_STRATEGY_DEFAULT = 0
export const int DEFLATE_STRATEGY_FILTERED = 1
export const int DEFLATE_STRATEGY_HUFFMAN = 2
export const int DEFLATE_STRATEGY_RLE = 3
export const int DEFLATE_STRATEGY_FIXED = 4

export const int INFLATE_RAW = 0
export const int INFLATE_ZLIB = 1
export const int INFLATE_DEFLATE = 2
export const int INFLATE_GZIP = 3

export const int BODY_CODEC_READ_DEFAULT = 32768
export const int BODY_DEFLATE_QUEUE_DEFAULT = 1048576
export const int BODY_INFLATE_OUTPUT_DEFAULT = 67108864
export const int BODY_INFLATE_QUEUE_DEFAULT = 67108864
export const int GZIP_HEADER_DEFAULT = 65536



// DeflateConfig 与 XRT 配置逐项对应，-1 表示不限制总输出。
export class DeflateConfig
    int format
    int level
    int strategy
    int outputLimit
    int windowBits
    int readSize
    int queueLimit

    create(
        int format = DEFLATE_GZIP,
        int level = 6,
        int strategy = DEFLATE_STRATEGY_DEFAULT,
        int outputLimit = -1,
        int windowBits = 15,
        int readSize = BODY_CODEC_READ_DEFAULT,
        int queueLimit = BODY_DEFLATE_QUEUE_DEFAULT
    )
        self.format = format
        self.level = level
        self.strategy = strategy
        self.outputLimit = outputLimit
        self.windowBits = windowBits
        self.readSize = readSize
        self.queueLimit = queueLimit
    end

    get valid() as bool
        return (self.format >= DEFLATE_RAW and
            self.format <= DEFLATE_GZIP and
            self.level >= 0 and self.level <= 10 and
            self.strategy >= DEFLATE_STRATEGY_DEFAULT and
            self.strategy <= DEFLATE_STRATEGY_FIXED and
            self.outputLimit >= -1 and
            self.windowBits >= 8 and self.windowBits <= 15 and
            self.readSize > 0 and self.queueLimit >= 0)
    end
end



// InflateConfig 同时限制总解码输出、gzip Header 和内部待交付队列。
export class InflateConfig
    int format
    int outputLimit
    int gzipHeaderLimit
    int windowBits
    int readSize
    int queueLimit

    create(
        int format = INFLATE_DEFLATE,
        int outputLimit = BODY_INFLATE_OUTPUT_DEFAULT,
        int gzipHeaderLimit = GZIP_HEADER_DEFAULT,
        int windowBits = 15,
        int readSize = BODY_CODEC_READ_DEFAULT,
        int queueLimit = BODY_INFLATE_QUEUE_DEFAULT
    )
        self.format = format
        self.outputLimit = outputLimit
        self.gzipHeaderLimit = gzipHeaderLimit
        self.windowBits = windowBits
        self.readSize = readSize
        self.queueLimit = queueLimit
    end

    get valid() as bool
        return (self.format >= INFLATE_RAW and
            self.format <= INFLATE_GZIP and
            self.outputLimit >= -1 and
            self.gzipHeaderLimit >= 10 and
            self.windowBits >= 8 and self.windowBits <= 15 and
            self.readSize > 0 and self.queueLimit >= 0)
    end
end



// 检查返回句柄并接管新的 Body 引用。
func __xhttp_body_codec_result(point handle) as Body
    if handle == null then
        throw RuntimeError xhttp.body.lastError()
    end
    return Body(handle)
end



// 使用 XRT 默认 gzip 配置创建流式压缩正文。
export func deflate(Body source) as Body
    return deflate(source, DeflateConfig())
end



// 创建保留来源异步状态、可重放属性和底层句柄能力的压缩正文。
export func deflate(Body source, DeflateConfig config) as Body
    if not config.valid then
        throw ValueError "Invalid HTTP body Deflate configuration"
    end
    return __xhttp_body_codec_result(__xhttp_body_codec_deflate(
        source.nativeHandle(),
        c_longlong(config.format),
        c_longlong(config.level),
        c_longlong(config.strategy),
        c_longlong(config.outputLimit),
        c_longlong(config.windowBits),
        c_longlong(config.readSize),
        c_longlong(config.queueLimit)))
end



// 使用兼容 HTTP deflate 的默认配置创建流式解压正文。
export func inflate(Body source) as Body
    return inflate(source, InflateConfig())
end



// 创建有界流式解压正文；格式可选择 raw、zlib、HTTP deflate 或 gzip。
export func inflate(Body source, InflateConfig config) as Body
    if not config.valid then
        throw ValueError "Invalid HTTP body Inflate configuration"
    end
    return __xhttp_body_codec_result(__xhttp_body_codec_inflate(
        source.nativeHandle(),
        c_longlong(config.format),
        c_longlong(config.outputLimit),
        c_longlong(config.gzipHeaderLimit),
        c_longlong(config.windowBits),
        c_longlong(config.readSize),
        c_longlong(config.queueLimit)))
end
