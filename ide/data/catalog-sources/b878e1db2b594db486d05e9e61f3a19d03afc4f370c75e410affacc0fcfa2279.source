extern "xws_last_error" func __xws_error() as string
extern "xws_conn_attach_tcp" func __xws_attach_tcp(
    point transport, point config, var handler,
    c_size prefix) as point
extern "xws_conn_attach_tls" func __xws_attach_tls(
    point transport, point config, var handler,
    c_size prefix) as point
extern "xws_writer_begin" func __xws_writer_begin(
    point connection, c_longlong opcode, bool compressed) as point



// 角色、操作码、状态和结果值与 XRT 公共枚举一一对应。
export const int ROLE_CLIENT = 0
export const int ROLE_SERVER = 1

export const int OPCODE_CONTINUATION = 0
export const int OPCODE_TEXT = 1
export const int OPCODE_BINARY = 2
export const int OPCODE_CLOSE = 8
export const int OPCODE_PING = 9
export const int OPCODE_PONG = 10

export const int STATE_OPEN = 0
export const int STATE_CLOSING = 1
export const int STATE_CLOSED = 2

export const int EVENT_MESSAGE_BEGIN = 0
export const int EVENT_MESSAGE_DATA = 1
export const int EVENT_MESSAGE_END = 2
export const int EVENT_PING = 3
export const int EVENT_PONG = 4
export const int EVENT_BACKPRESSURE = 5
export const int EVENT_WRITABLE = 6
export const int EVENT_DRAIN = 7
export const int EVENT_ERROR = 8
export const int EVENT_CLOSE = 9

export const int RESULT_ERROR = -1
export const int RESULT_OK = 0
export const int RESULT_AGAIN = 1
export const int RESULT_CLOSED = 2
export const int RESULT_TRUNCATED = 3
export const int RESULT_TIMEOUT = 4
export const int RESULT_CANCELLED = 5

export const int WAIT_ERROR = -1
export const int WAIT_OK = 0
export const int WAIT_TIMEOUT = 1
export const int WAIT_CANCELLED = 2
export const int WAIT_CLOSED = 3

export const int FUTURE_PENDING = 0
export const int FUTURE_RESOLVED = 1
export const int FUTURE_FAILED = 2
export const int FUTURE_CANCELLED = 3
export const int FUTURE_CLOSED = 4

export const int CONNECTION_WAIT_WRITE = 1
export const int CONNECTION_WAIT_DRAIN = 2
export const int CONNECTION_WAIT_CLOSE = 3

export const int GROUP_OP_REJECTED = 0
export const int GROUP_OP_PENDING = 1
export const int GROUP_OP_RESOLVED = 2
export const int GROUP_OP_FAILED = 3
export const int GROUP_OP_CANCELLED = 4
export const int GROUP_OP_CLOSED = 5



// 接管原生 Buffer 并生成稳定字符串。
func __xws_text(point handle) as string
    if handle == null then
        throw RuntimeError __xws_error()
    end
    return Buffer(handle).text()
end



// 检查返回句柄并保留最近一次 XRT 结构化错误。
func __xws_handle(point handle) as point
    if handle == null then
        throw RuntimeError __xws_error()
    end
    return handle
end



// 返回当前线程最近一次 XRT/xws 错误文本，供底层诊断路径使用。
export func lastError() as string
    return __xws_error()
end



// Connection 配置持有协议副本，并覆盖收发、控制帧和异步队列预算。
export class WsConnectionConfig
    native point handle
    extern "xws_config_create" create(c_longlong role)
    extern "xws_config_destroy" destroy()
    extern "xws_config_native" func nativeHandle() as point
    extern "xws_config_protocol" func protocolNative(string protocol, c_size size) as bool
    extern "xws_config_limits" func limitsNative(
        c_ulonglong messageBytes, c_ulonglong frameBytes,
        c_ulonglong sendBytes) as bool
    extern "xws_config_control" func controlNative(
        c_ulonglong reserveBytes, c_ulonglong closeTimeoutUs) as bool
    extern "xws_config_async" func asyncNative(
        c_ulonglong bytes, c_ulonglong count, c_ulonglong batch) as bool
    extern "xws_config_auto_pong" func autoPong(bool enabled)
    extern "xws_config_deflate" func deflateNative(
        string extensions, c_size size) as bool
    extern "xws_config_valid" get valid() as bool

    static func client() as WsConnectionConfig
        return WsConnectionConfig(c_longlong(ROLE_CLIENT))
    end

    static func server() as WsConnectionConfig
        return WsConnectionConfig(c_longlong(ROLE_SERVER))
    end

    // Upgrade 已完成 HTTP 校验，配置层只复制协商结果。
    static func fromUpgrade(WsUpgrade upgrade) as WsConnectionConfig
        if not upgrade.ready then
            throw ValueError "WebSocket upgrade is not ready"
        end
        WsConnectionConfig result = WsConnectionConfig(c_longlong(upgrade.role))
        string selected = upgrade.protocol()
        if not result.protocol(selected) then
            throw RuntimeError __xws_error()
        end
        if upgrade.deflateEnabled and not result.deflate(upgrade.extensions()) then
            throw RuntimeError __xws_error()
        end
        return result
    end

    func protocol(string value) as bool
        return self.protocolNative(value, c_size(string.byteLen(value)))
    end

    func limits(int messageBytes, int frameBytes, int sendBytes) as bool
        if messageBytes < 0 or frameBytes < 0 or sendBytes < 0 then
            throw ValueError "WebSocket limits must not be negative"
        end
        return self.limitsNative(c_ulonglong(messageBytes),
            c_ulonglong(frameBytes), c_ulonglong(sendBytes))
    end

    func control(int reserveBytes, int closeTimeoutMs) as bool
        if reserveBytes < 0 or closeTimeoutMs < 0 then
            throw ValueError "WebSocket control limits must not be negative"
        end
        return self.controlNative(c_ulonglong(reserveBytes),
            c_ulonglong(closeTimeoutMs) * c_ulonglong(1000))
    end

    func asyncLimits(int bytes, int count, int batch) as bool
        if bytes < 0 or count < 0 or batch < 0 then
            throw ValueError "WebSocket async limits must not be negative"
        end
        return self.asyncNative(c_ulonglong(bytes),
            c_ulonglong(count), c_ulonglong(batch))
    end

    func deflate(string extensions) as bool
        return self.deflateNative(extensions,
            c_size(string.byteLen(extensions)))
    end
end



// WsFuture 保留 XRT Future 的取消、超时和终态，不丢失底层结果。
export class WsFuture
    native point handle
    extern "xws_future_wrap" create(point handle)
    extern "xws_future_destroy" destroy()
    extern "xws_future_state" func stateNative() as c_longlong
    extern "xws_future_cancel" func cancel() as bool
    extern "xws_future_wait" func waitNative(c_longlong timeoutMs) as c_longlong
    extern "xws_future_error" func errorNative() as point

    get valid() as bool
        return self.handle != null
    end

    get state() as int
        return int(self.stateNative())
    end

    get done() as bool
        return self.state != FUTURE_PENDING
    end

    func nativeHandle() as point
        return self.handle
    end

    func waitResult(int timeoutMs = -1) as int
        return int(self.waitNative(c_longlong(timeoutMs)))
    end

    func wait(int timeoutMs = -1) as bool
        return self.waitResult(timeoutMs) == WAIT_OK
    end

    func error() as string
        return __xws_text(self.errorNative())
    end
end



// Connection 是已升级 TCP 或 TLS 链路上的长生命周期 WebSocket 会话。
export class WsConnection
    native point handle
    extern "xws_conn_wrap" create(point handle)
    extern "xws_conn_destroy" destroy()
    extern "xws_conn_native" func nativeHandle() as point
    extern "xws_conn_state" func stateNative() as c_longlong
    extern "xws_conn_role" func roleNative() as c_longlong
    extern "xws_conn_protocol" func protocolNative() as point
    extern "xws_conn_deflate" func deflateNative() as bool
    extern "xws_conn_pending" func pendingNative() as c_ulonglong
    extern "xws_conn_writable" func writableNative() as c_ulonglong
    extern "xws_conn_paused" func pausedNative() as bool
    extern "xws_conn_pause" func pause()
    extern "xws_conn_resume" func resume() as bool
    extern "xws_conn_abort" func abort() as bool
    extern "xws_conn_send_text" func sendTextRaw(
        string text, c_size size, bool compressed) as c_longlong
    extern "xws_conn_send" func sendRaw(
        c_longlong opcode, point data, c_size size,
        bool compressed) as c_longlong
    extern "xws_conn_send_move" func sendMoveRaw(
        c_longlong opcode, point buffer) as c_longlong
    extern "xws_conn_control" func controlRaw(
        c_longlong opcode, point data, c_size size) as c_longlong
    extern "xws_conn_close" func closeRaw(
        c_longlong code, string reason, c_size size) as c_longlong
    extern "xws_conn_send_text_async" func sendTextAsyncRaw(
        string text, c_size size, bool compressed) as point
    extern "xws_conn_send_async" func sendAsyncRaw(
        c_longlong opcode, point data, c_size size,
        bool compressed) as point
    extern "xws_conn_control_async" func controlAsyncRaw(
        c_longlong opcode, point data, c_size size) as point
    extern "xws_conn_close_async" func closeAsyncRaw(
        c_longlong code, string reason, c_size size) as point
    extern "xws_conn_wait_async" func waitAsyncRaw(c_longlong kind) as point
    extern "xws_conn_async_bytes" func asyncBytesNative() as c_ulonglong
    extern "xws_conn_async_count" func asyncCountNative() as c_ulonglong
    extern "xws_conn_close_reason" func closeReasonNative() as point
    extern "xws_conn_close_value" func closeValue(c_longlong field) as c_ulonglong
    extern "xws_conn_error_text" func errorText(c_longlong field) as point
    extern "xws_conn_error_value" func errorValue(c_longlong field) as c_longlong

    static func attachTcp(TcpStream transport, WsUpgrade upgrade,
        func(int, int, int, int, point, int) handler,
        int prefix = 0) as WsConnection
        if prefix < 0 then
            throw ValueError "WebSocket prefix must not be negative"
        end
        WsConnectionConfig config = WsConnectionConfig.fromUpgrade(upgrade)
        var callback = xcall(handler)
        return WsConnection(__xws_handle(__xws_attach_tcp(
            transport.nativeHandle(), config.nativeHandle(), callback,
            c_size(prefix))))
    end

    static func attachTcpWithConfig(TcpStream transport,
        WsConnectionConfig config,
        func(int, int, int, int, point, int) handler,
        int prefix = 0) as WsConnection
        if prefix < 0 then
            throw ValueError "WebSocket prefix must not be negative"
        end
        var callback = xcall(handler)
        return WsConnection(__xws_handle(__xws_attach_tcp(
            transport.nativeHandle(), config.nativeHandle(), callback,
            c_size(prefix))))
    end

    static func attachTls(TlsStream transport, WsUpgrade upgrade,
        func(int, int, int, int, point, int) handler,
        int prefix = 0) as WsConnection
        if prefix < 0 then
            throw ValueError "WebSocket prefix must not be negative"
        end
        WsConnectionConfig config = WsConnectionConfig.fromUpgrade(upgrade)
        var callback = xcall(handler)
        return WsConnection(__xws_handle(__xws_attach_tls(
            transport.nativeHandle(), config.nativeHandle(), callback,
            c_size(prefix))))
    end

    static func attachTlsWithConfig(TlsStream transport,
        WsConnectionConfig config,
        func(int, int, int, int, point, int) handler,
        int prefix = 0) as WsConnection
        if prefix < 0 then
            throw ValueError "WebSocket prefix must not be negative"
        end
        var callback = xcall(handler)
        return WsConnection(__xws_handle(__xws_attach_tls(
            transport.nativeHandle(), config.nativeHandle(), callback,
            c_size(prefix))))
    end

    get valid() as bool
        return self.handle != null
    end

    get state() as int
        return int(self.stateNative())
    end

    get role() as int
        return int(self.roleNative())
    end

    get deflateEnabled() as bool
        return self.deflateNative()
    end

    get pending() as int
        return int(self.pendingNative())
    end

    get writable() as int
        return int(self.writableNative())
    end

    get paused() as bool
        return self.pausedNative()
    end

    get asyncBytes() as int
        return int(self.asyncBytesNative())
    end

    get asyncCount() as int
        return int(self.asyncCountNative())
    end

    func protocol() as string
        return __xws_text(self.protocolNative())
    end

    func sendTextResult(string text, bool compressed = false) as int
        return int(self.sendTextRaw(text,
            c_size(string.byteLen(text)), compressed))
    end

    func sendResult(Buffer data, bool compressed = false) as int
        return int(self.sendRaw(c_longlong(OPCODE_BINARY), data.data(),
            c_size(data.len()), compressed))
    end

    func send(string text, bool compressed = false) as bool
        return self.sendTextResult(text, compressed) == RESULT_OK
    end

    func send(Buffer data, bool compressed = false) as bool
        return self.sendResult(data, compressed) == RESULT_OK
    end

    func sendMoveResult(Buffer data, int opcode = OPCODE_BINARY) as int
        return int(self.sendMoveRaw(c_longlong(opcode), data.nativeHandle()))
    end

    func sendMove(Buffer data, int opcode = OPCODE_BINARY) as bool
        return self.sendMoveResult(data, opcode) == RESULT_OK
    end

    func pingResult(Buffer payload) as int
        return int(self.controlRaw(c_longlong(OPCODE_PING), payload.data(),
            c_size(payload.len())))
    end

    func pongResult(Buffer payload) as int
        return int(self.controlRaw(c_longlong(OPCODE_PONG), payload.data(),
            c_size(payload.len())))
    end

    func ping(Buffer payload) as bool
        return self.pingResult(payload) == RESULT_OK
    end

    func pong(Buffer payload) as bool
        return self.pongResult(payload) == RESULT_OK
    end

    func closeResult(int code = 1000, string reason = "") as int
        return int(self.closeRaw(c_longlong(code), reason,
            c_size(string.byteLen(reason))))
    end

    func close(int code = 1000, string reason = "") as bool
        return self.closeResult(code, reason) == RESULT_OK
    end

    func sendTextAsync(string text, bool compressed = false) as WsFuture
        return WsFuture(__xws_handle(self.sendTextAsyncRaw(text,
            c_size(string.byteLen(text)), compressed)))
    end

    func sendAsync(Buffer data, bool compressed = false) as WsFuture
        return WsFuture(__xws_handle(self.sendAsyncRaw(
            c_longlong(OPCODE_BINARY), data.data(),
            c_size(data.len()), compressed)))
    end

    func pingAsync(Buffer payload) as WsFuture
        return WsFuture(__xws_handle(self.controlAsyncRaw(
            c_longlong(OPCODE_PING), payload.data(), c_size(payload.len()))))
    end

    func pongAsync(Buffer payload) as WsFuture
        return WsFuture(__xws_handle(self.controlAsyncRaw(
            c_longlong(OPCODE_PONG), payload.data(), c_size(payload.len()))))
    end

    func closeAsync(int code = 1000, string reason = "") as WsFuture
        return WsFuture(__xws_handle(self.closeAsyncRaw(c_longlong(code),
            reason, c_size(string.byteLen(reason)))))
    end

    func writableAsync() as WsFuture
        return WsFuture(__xws_handle(
            self.waitAsyncRaw(c_longlong(CONNECTION_WAIT_WRITE))))
    end

    func drainAsync() as WsFuture
        return WsFuture(__xws_handle(
            self.waitAsyncRaw(c_longlong(CONNECTION_WAIT_DRAIN))))
    end

    func closeWaitAsync() as WsFuture
        return WsFuture(__xws_handle(
            self.waitAsyncRaw(c_longlong(CONNECTION_WAIT_CLOSE))))
    end

    func writer(int opcode = OPCODE_BINARY,
        bool compressed = false) as WsWriter
        return WsWriter(__xws_handle(__xws_writer_begin(
            self.handle, c_longlong(opcode), compressed)))
    end

    get closeFlags() as int
        return int(self.closeValue(c_longlong(0)))
    end

    get localCloseCode() as int
        return int(self.closeValue(c_longlong(1)))
    end

    get remoteCloseCode() as int
        return int(self.closeValue(c_longlong(2)))
    end

    get transportResult() as int
        return int(self.closeValue(c_longlong(3)))
    end

    func closeReason() as string
        return __xws_text(self.closeReasonNative())
    end

    get errorKind() as int
        return int(self.errorValue(c_longlong(0)))
    end

    get errorCode() as int
        return int(self.errorValue(c_longlong(1)))
    end

    func errorDomain() as string
        return __xws_text(self.errorText(c_longlong(0)))
    end

    func errorOperation() as string
        return __xws_text(self.errorText(c_longlong(1)))
    end

    func errorMessage() as string
        return __xws_text(self.errorText(c_longlong(2)))
    end
end



// Writer 提供分片、最终分片和 Buffer 所有权移交路径。
export class WsWriter
    native point handle
    extern "xws_writer_wrap" create(point handle)
    extern "xws_writer_destroy" destroy()
    extern "xws_writer_write_text" func writeTextRaw(
        string text, c_size size, bool final) as c_longlong
    extern "xws_writer_write" func writeRaw(
        point data, c_size size, bool final) as c_longlong
    extern "xws_writer_write_move" func writeMoveRaw(
        point buffer, bool final) as c_longlong
    extern "xws_writer_finished" get finished() as bool

    static func begin(WsConnection connection,
        int opcode = OPCODE_BINARY, bool compressed = false) as WsWriter
        return WsWriter(__xws_handle(__xws_writer_begin(
            connection.handle, c_longlong(opcode), compressed)))
    end

    get valid() as bool
        return self.handle != null
    end

    func nativeHandle() as point
        return self.handle
    end

    func writeResult(string text) as int
        return int(self.writeTextRaw(text,
            c_size(string.byteLen(text)), false))
    end

    func writeResult(Buffer data) as int
        return int(self.writeRaw(data.data(), c_size(data.len()), false))
    end

    func finishResult(string text = "") as int
        return int(self.writeTextRaw(text,
            c_size(string.byteLen(text)), true))
    end

    func finishResult(Buffer data) as int
        return int(self.writeRaw(data.data(), c_size(data.len()), true))
    end

    func write(string text) as bool
        return self.writeResult(text) == RESULT_OK
    end

    func write(Buffer data) as bool
        return self.writeResult(data) == RESULT_OK
    end

    func finish(string text = "") as bool
        return self.finishResult(text) == RESULT_OK
    end

    func finish(Buffer data) as bool
        return self.finishResult(data) == RESULT_OK
    end

    func writeMoveResult(Buffer data, bool final = false) as int
        return int(self.writeMoveRaw(data.nativeHandle(), final))
    end

    func writeMove(Buffer data, bool final = false) as bool
        return self.writeMoveResult(data, final) == RESULT_OK
    end
end



// Snapshot 持有创建时的稳定成员引用；nativeConnection 返回借用句柄。
export class WsGroupSnapshot
    native point handle
    extern "xws_group_snapshot_wrap" create(point handle)
    extern "xws_group_snapshot_destroy" destroy()
    extern "xws_group_snapshot_count" func countNative() as c_ulonglong
    extern "xws_group_snapshot_native" func connectionNative(
        c_longlong index) as point

    get valid() as bool
        return self.handle != null
    end

    get count() as int
        return int(self.countNative())
    end

    func nativeHandle() as point
        return self.handle
    end

    func nativeConnection(int index) as point
        if index < 0 or index >= self.count then
            throw IndexError "WebSocket group snapshot index is out of range"
        end
        return self.connectionNative(c_longlong(index))
    end
end



// Group 逐成员结果保留拒绝、终态和结构化错误摘要。
export class WsGroupResult
    int state
    bool hasConnection
    int errorKind
    int errorCode
    string error

    create(int state, bool hasConnection,
        int errorKind, int errorCode, string error)
        self.state = state
        self.hasConnection = hasConnection
        self.errorKind = errorKind
        self.errorCode = errorCode
        self.error = error
    end

    get done() as bool
        return self.state != GROUP_OP_PENDING
    end
end



// GroupOperation 同时暴露逐成员 Future 和聚合完成 Future。
export class WsGroupOperation
    native point handle
    extern "xws_group_op_wrap" create(point handle)
    extern "xws_group_op_destroy" destroy()
    extern "xws_group_op_value" func value(c_longlong field) as c_ulonglong
    extern "xws_group_op_result_value" func resultValue(
        c_longlong index, c_longlong field) as c_longlong
    extern "xws_group_op_result_error" func resultError(
        c_longlong index) as point
    extern "xws_group_op_item_future" func itemFutureNative(
        c_longlong index) as point
    extern "xws_group_op_future" func futureNative() as point
    extern "xws_group_op_cancel" func cancelNative() as c_ulonglong
    extern "xws_group_op_wait" func waitNative(
        c_longlong timeoutMs) as c_longlong

    get valid() as bool
        return self.handle != null
    end

    get count() as int
        return int(self.value(c_longlong(0)))
    end

    get accepted() as int
        return int(self.value(c_longlong(1)))
    end

    get rejected() as int
        return int(self.value(c_longlong(2)))
    end

    get doneCount() as int
        return int(self.value(c_longlong(3)))
    end

    func nativeHandle() as point
        return self.handle
    end

    func result(int index) as WsGroupResult
        if index < 0 or index >= self.count then
            throw IndexError "WebSocket group operation index is out of range"
        end
        return WsGroupResult(
            int(self.resultValue(c_longlong(index), c_longlong(0))),
            self.resultValue(c_longlong(index), c_longlong(1)) != 0,
            int(self.resultValue(c_longlong(index), c_longlong(2))),
            int(self.resultValue(c_longlong(index), c_longlong(3))),
            __xws_text(self.resultError(c_longlong(index))))
    end

    func itemFuture(int index) as WsFuture?
        if index < 0 or index >= self.count then
            throw IndexError "WebSocket group operation index is out of range"
        end
        point result = self.itemFutureNative(c_longlong(index))
        if result == null then
            return null
        end
        return WsFuture(result)
    end

    func future() as WsFuture
        return WsFuture(__xws_handle(self.futureNative()))
    end

    func cancel() as int
        return int(self.cancelNative())
    end

    func waitResult(int timeoutMs = -1) as int
        return int(self.waitNative(c_longlong(timeoutMs)))
    end

    func wait(int timeoutMs = -1) as bool
        return self.waitResult(timeoutMs) == WAIT_OK
    end
end



// Group 并发持有不重复连接，适合广播和统一状态屏障。
export class WsGroup
    native point handle
    extern "xws_group_create" create(c_longlong limit)
    extern "xws_group_wrap" create(point handle)
    extern "xws_group_destroy" destroy()
    extern "xws_group_add" func addNative(point connection) as bool
    extern "xws_group_remove" func removeNative(point connection) as bool
    extern "xws_group_has" func hasNative(point connection) as bool
    extern "xws_group_value" func value(c_longlong field) as c_ulonglong
    extern "xws_group_seal" func seal() as bool
    extern "xws_group_clear" func clearNative() as c_ulonglong
    extern "xws_group_snapshot" func snapshotNative() as point
    extern "xws_group_text" func textNative(
        string text, c_size size) as point
    extern "xws_group_operation" func operationNative(
        c_longlong kind, c_longlong opcode, point data,
        c_size size, c_longlong value) as point
    extern "xws_group_close" func closeNative(
        c_longlong code, string reason, c_size size) as point

    static func unlimited() as WsGroup
        return WsGroup(c_longlong(0))
    end

    get valid() as bool
        return self.handle != null
    end

    get count() as int
        return int(self.value(c_longlong(0)))
    end

    get limit() as int
        return int(self.value(c_longlong(1)))
    end

    get sealed() as bool
        return self.value(c_longlong(2)) != 0
    end

    func nativeHandle() as point
        return self.handle
    end

    func add(WsConnection connection) as bool
        return self.addNative(connection.handle)
    end

    func remove(WsConnection connection) as bool
        return self.removeNative(connection.handle)
    end

    func has(WsConnection connection) as bool
        return self.hasNative(connection.handle)
    end

    func clear() as int
        return int(self.clearNative())
    end

    func snapshot() as WsGroupSnapshot
        return WsGroupSnapshot(__xws_handle(self.snapshotNative()))
    end

    func send(string text) as WsGroupOperation
        return WsGroupOperation(__xws_handle(self.textNative(text,
            c_size(string.byteLen(text)))))
    end

    func send(Buffer data) as WsGroupOperation
        return WsGroupOperation(__xws_handle(self.operationNative(
            c_longlong(1), c_longlong(OPCODE_BINARY), data.data(),
            c_size(data.len()), c_longlong(0))))
    end

    func ping(Buffer payload) as WsGroupOperation
        return WsGroupOperation(__xws_handle(self.operationNative(
            c_longlong(2), c_longlong(0), payload.data(),
            c_size(payload.len()), c_longlong(0))))
    end

    func pong(Buffer payload) as WsGroupOperation
        return WsGroupOperation(__xws_handle(self.operationNative(
            c_longlong(3), c_longlong(0), payload.data(),
            c_size(payload.len()), c_longlong(0))))
    end

    func close(int code = 1000, string reason = "") as WsGroupOperation
        return WsGroupOperation(__xws_handle(self.closeNative(
            c_longlong(code), reason, c_size(string.byteLen(reason)))))
    end

    func waitWritable() as WsGroupOperation
        point empty = null
        return WsGroupOperation(__xws_handle(self.operationNative(
            c_longlong(5), c_longlong(0), empty,
            c_size(0), c_longlong(CONNECTION_WAIT_WRITE))))
    end

    func waitDrain() as WsGroupOperation
        point empty = null
        return WsGroupOperation(__xws_handle(self.operationNative(
            c_longlong(5), c_longlong(0), empty,
            c_size(0), c_longlong(CONNECTION_WAIT_DRAIN))))
    end

    func waitClose() as WsGroupOperation
        point empty = null
        return WsGroupOperation(__xws_handle(self.operationNative(
            c_longlong(5), c_longlong(0), empty,
            c_size(0), c_longlong(CONNECTION_WAIT_CLOSE))))
    end
end
