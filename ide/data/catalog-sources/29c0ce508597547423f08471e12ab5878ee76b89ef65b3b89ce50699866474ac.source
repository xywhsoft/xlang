// Domain-separated SipHash-2-4-128. The 64-bit variant lives in stdlib siphash.
// Digests are 16 bytes in little-endian order. SipHash is a keyed table hash,
// not a password hash or a cryptographic MAC for untrusted messages.
extern "xsiphash128_hash_string_span" func __hashString(string data, c_size actual, cbytes key, int size) as point
extern "xsiphash128_hash_bytes_span" func __hashBytes(cbytes data, cbytes key, int size) as point
extern "xsiphash128_hash_buffer_span" func __hashBuffer(point data, c_size actual, cbytes key, int size) as point

export const int KEY_LENGTH = 16
export const int DIGEST_LENGTH = 16

func __check(bytes key, int size)
    if key.length != KEY_LENGTH then throw ValueError "SipHash key must contain exactly 16 bytes" end
    if size < -1 then throw RangeError "SipHash size is invalid" end
end

export func hash(string data, bytes key, int size = -1) as Buffer
    __check(key, size)
    return Buffer(point(__hashString(data, c_size(string.byteLen(data)), key, size)))
end

export func hash(bytes data, bytes key, int size = -1) as Buffer
    __check(key, size)
    return Buffer(point(__hashBytes(data, key, size)))
end

export func hashBuffer(Buffer data, bytes key, int size = -1) as Buffer
    __check(key, size)
    return Buffer(point(__hashBuffer(data.data(), c_size(data.len()), key, size)))
end

export class SipHasher128
    native point handle
    extern "xsiphash128_hasher_create_span" create(cbytes key)
    extern "xsiphash128_hasher_adopt" create(point handle)
    extern "xsiphash128_hasher_destroy" destroy()
    extern "xsiphash128_hasher_update_string" func updateStringNative(string data, c_size actual, int size) as bool
    extern "xsiphash128_hasher_update_span_checked" func update(cbytes data, int size = -1)
    extern "xsiphash128_hasher_update_span" func updateBytesNative(cbytes data, int size) as bool
    extern "xsiphash128_hasher_update_raw" func updateRawNative(point data, c_size actual, int size) as bool
    extern "xsiphash128_hasher_digest" func digestNative() as point
    extern "xsiphash128_hasher_reset" func reset()
    extern "xsiphash128_hasher_clone" func cloneNative() as point
    extern "xsiphash128_hasher_input_bytes" func inputBytesNative() as c_ulonglong

    func update(string data, int size = -1)
        if size < -1 then throw RangeError "SipHash size is invalid" end
        if not self.updateStringNative(data, c_size(string.byteLen(data)), size) then throw RangeError "SipHash update failed" end
    end
    func updateBuffer(Buffer data, int size = -1)
        if size < -1 then throw RangeError "SipHash size is invalid" end
        if not self.updateRawNative(data.data(), c_size(data.len()), size) then throw RangeError "SipHash update failed" end
    end
    func digest() as Buffer
        return Buffer(point(self.digestNative()))
    end
    func clone() as SipHasher128
        return SipHasher128(point(self.cloneNative()))
    end
    func inputBytes() as uint64
        return uint64(self.inputBytesNative())
    end
end

export func hasher(bytes key) as SipHasher128
    __check(key, -1)
    return SipHasher128(key)
end
