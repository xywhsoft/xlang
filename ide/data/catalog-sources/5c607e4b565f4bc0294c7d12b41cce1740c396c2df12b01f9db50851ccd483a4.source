extern "xtoml_error_code" func __toml_error_code() as int
extern "xtoml_error_line" func __toml_error_line() as int
extern "xtoml_error_column" func __toml_error_column() as int
extern "xtoml_error_offset" func __toml_error_offset() as int
extern "xtoml_error_message" func __toml_error_message() as point
extern "xtoml_parse" func __toml_parse(string data, c_ulonglong size,
    c_ulonglong maxInput, c_ulonglong maxOutput, c_ulonglong maxItem,
    c_ulonglong maxEntries, c_ulonglong maxNodes, c_uint maxDepth) as var
extern "xtoml_load" func __toml_load(string path, c_ulonglong maxInput,
    c_ulonglong maxOutput, c_ulonglong maxItem, c_ulonglong maxEntries,
    c_ulonglong maxNodes, c_uint maxDepth) as var
extern "xtoml_stringify_text" func __toml_stringify_text(var value,
    c_ulonglong maxOutput, c_ulonglong maxItem, c_ulonglong maxEntries,
    c_ulonglong maxNodes, c_uint maxDepth) as point
extern "xtoml_save" func __toml_save(string path, var value,
    c_ulonglong maxOutput, c_ulonglong maxItem, c_ulonglong maxEntries,
    c_ulonglong maxNodes, c_uint maxDepth) as bool

extern "xtoml_date" func __toml_date(c_int year, c_int month, c_int day) as var
extern "xtoml_time" func __toml_time(c_int hour, c_int minute, c_int second,
    c_int microsecond) as var
extern "xtoml_datetime" func __toml_datetime(c_int year, c_int month,
    c_int day, c_int hour, c_int minute, c_int second,
    c_int microsecond) as var
extern "xtoml_offset_datetime" func __toml_offset_datetime(c_int year,
    c_int month, c_int day, c_int hour, c_int minute, c_int second,
    c_int microsecond, c_int offsetMinutes) as var
extern "xtoml_datetime_kind" func __toml_datetime_kind(var value) as int
extern "xtoml_datetime_part" func __toml_datetime_part(var value,
    c_int part) as int
extern "xtoml_datetime_text" func __toml_datetime_text(var value) as point

// 只检查 ABI 窄化边界；日期本身的合法性仍由 XRT TOML 核心判断。
func __toml_cint(int value) as c_int
    if value < -2147483648 or value > 2147483647 then
        throw ValueError "TOML integer argument is outside the C int range"
    end
    return c_int(value)
end

func __toml_limits(int maxInput, int maxOutput, int maxItem,
    int maxEntries, int maxNodes, int maxDepth)
    if (maxInput < 0 or maxOutput < 0 or maxItem < 0 or
        maxEntries < 0 or maxNodes < 0 or maxDepth < 0 or
        maxDepth > 4294967295) then
        throw ValueError "TOML resource limits are outside their ABI range"
    end
end

func __toml_path(string path)
    if string.indexOf(path, "\0", false, string.byteLen(path), 1) >= 0 then
        throw ValueError "TOML path contains an embedded NUL byte"
    end
end



export func errorCode() as int
    return __toml_error_code()
end

export func errorLine() as int
    return __toml_error_line()
end

export func errorColumn() as int
    return __toml_error_column()
end

export func errorOffset() as int
    return __toml_error_offset()
end

func __toml_error() as string
    return __xl_runtime.takeCstr(__toml_error_message())
end

export func parse(string text, int maxInput = 268435456,
    int maxOutput = 536870912, int maxItem = 268435456,
    int maxEntries = 100000, int maxNodes = 1000000,
    int maxDepth = 128) as var
    __toml_limits(maxInput, maxOutput, maxItem, maxEntries, maxNodes, maxDepth)
    var result = __toml_parse(text, c_ulonglong(string.byteLen(text)),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), c_ulonglong(maxItem),
        c_ulonglong(maxEntries), c_ulonglong(maxNodes), c_uint(maxDepth))
    if result == null then
        throw TomlError __toml_error()
    end
    return result
end

export func load(string path, int maxInput = 268435456,
    int maxOutput = 536870912, int maxItem = 268435456,
    int maxEntries = 100000, int maxNodes = 1000000,
    int maxDepth = 128) as var
    __toml_limits(maxInput, maxOutput, maxItem, maxEntries, maxNodes, maxDepth)
    __toml_path(path)
    var result = __toml_load(path, c_ulonglong(maxInput),
        c_ulonglong(maxOutput), c_ulonglong(maxItem),
        c_ulonglong(maxEntries), c_ulonglong(maxNodes), c_uint(maxDepth))
    if result == null then
        throw TomlError __toml_error()
    end
    return result
end

export func stringify(var value, int maxOutput = 536870912,
    int maxItem = 268435456, int maxEntries = 100000,
    int maxNodes = 1000000, int maxDepth = 128) as string
    __toml_limits(0, maxOutput, maxItem, maxEntries, maxNodes, maxDepth)
    point result = __toml_stringify_text(value, c_ulonglong(maxOutput),
        c_ulonglong(maxItem), c_ulonglong(maxEntries),
        c_ulonglong(maxNodes), c_uint(maxDepth))
    if result == null then
        throw TomlError __toml_error()
    end
    return __xl_runtime.takeCstr(result)
end

export func save(string path, var value, int maxOutput = 536870912,
    int maxItem = 268435456, int maxEntries = 100000,
    int maxNodes = 1000000, int maxDepth = 128)
    __toml_limits(0, maxOutput, maxItem, maxEntries, maxNodes, maxDepth)
    __toml_path(path)
    if not __toml_save(path, value, c_ulonglong(maxOutput),
        c_ulonglong(maxItem), c_ulonglong(maxEntries),
        c_ulonglong(maxNodes), c_uint(maxDepth)) then
        throw TomlError __toml_error()
    end
end

export func localDate(int year, int month, int day) as var
    var result = __toml_date(__toml_cint(year), __toml_cint(month), __toml_cint(day))
    if result == null then throw ValueError "invalid TOML local date" end
    return result
end

export func localTime(int hour, int minute, int second = 0,
    int microsecond = 0) as var
    var result = __toml_time(__toml_cint(hour), __toml_cint(minute),
        __toml_cint(second), __toml_cint(microsecond))
    if result == null then throw ValueError "invalid TOML local time" end
    return result
end

export func localDateTime(int year, int month, int day, int hour,
    int minute, int second = 0, int microsecond = 0) as var
    var result = __toml_datetime(__toml_cint(year), __toml_cint(month),
        __toml_cint(day), __toml_cint(hour), __toml_cint(minute),
        __toml_cint(second), __toml_cint(microsecond))
    if result == null then throw ValueError "invalid TOML local datetime" end
    return result
end

export func offsetDateTime(int year, int month, int day, int hour,
    int minute, int second = 0, int microsecond = 0,
    int offsetMinutes = 0) as var
    var result = __toml_offset_datetime(__toml_cint(year), __toml_cint(month),
        __toml_cint(day), __toml_cint(hour), __toml_cint(minute),
        __toml_cint(second), __toml_cint(microsecond),
        __toml_cint(offsetMinutes))
    if result == null then throw ValueError "invalid TOML offset datetime" end
    return result
end

export func dateTimeKind(var value) as int
    return __toml_datetime_kind(value)
end

export func isLocalDate(var value) as bool
    return dateTimeKind(value) == 1
end

export func isLocalTime(var value) as bool
    return dateTimeKind(value) == 2
end

export func isLocalDateTime(var value) as bool
    return dateTimeKind(value) == 3
end

export func isOffsetDateTime(var value) as bool
    return dateTimeKind(value) == 4
end

export func dateTimePart(var value, int part) as int
    if dateTimeKind(value) == 0 then throw TypeError "value is not a TOML date/time value" end
    if part < 0 or part > 7 then throw ValueError "TOML date/time part must be 0 through 7" end
    return __toml_datetime_part(value, c_int(part))
end

export func dateTimeText(var value) as string
    point result = __toml_datetime_text(value)
    if result == null then throw TypeError "value is not a TOML date/time value" end
    return __xl_runtime.takeCstr(result)
end
