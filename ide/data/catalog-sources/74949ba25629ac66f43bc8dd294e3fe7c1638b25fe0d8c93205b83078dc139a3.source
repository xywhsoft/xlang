{
    "format": "xlang-package-1",
    "name": "bz2",
    "version": "1.0.0",
    "abiVersion": "1",
    "kind": "demo6-extlib",
    "artifact": {
        "kind": "source",
        "cSources": [
            "xrt_bz2.c",
            "xrt_bz2_file.c",
            "bz2_native.c"
        ],
        "xlSources": [
            "src/bz2.xl"
        ],
        "xrtModules": [
            "XRT_MODULE_IO_BUFFER",
            "XRT_MODULE_IO_FILE",
            "XRT_MODULE_FILE_TEMP",
            "XRT_MODULE_UNICODE",
            "XRUNTIME_MODULE_RUNTIME_VALUE_CALLABLE"
        ]
    },
    "links": [],
    "loadlibs": [],
    "dependencies": [
        {
            "name": "_bzip2",
            "version": "1.0.8",
            "abiVersion": "1"
        }
    ],
    "coverage": { "mode": "suite", "tests": ["test/file_ops.xl", "test/text_transfer.xl"] },
    "native": {
        "singleton": false,
        "loadName": "",
        "version": ""
    }
}
