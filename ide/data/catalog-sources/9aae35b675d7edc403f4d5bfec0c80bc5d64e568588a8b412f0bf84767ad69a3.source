// snappy 的压缩结果和输入统使用 Buffer，避免二进制数据经过字符串转换。
extern "xl6_xrt_last_error_text" func __snappy_error() as string
extern "xsnappy_version" func __snappy_version() as string
extern "xsnappy_compress" func __snappy_compress(point data, c_size size,
    c_ulonglong maxInput, c_ulonglong maxOutput) as point
extern "xsnappy_compress_str" func __snappy_compress_str(string data, c_size size,
    c_ulonglong maxInput, c_ulonglong maxOutput) as point
extern "xsnappy_decompress" func __snappy_decompress(point data, c_size size,
    c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio) as point
extern "xsnappy_decompress_text" func __snappy_decompress_text(point data, c_size size,
    c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio) as point
extern "xsnappy_text_size" @no_raise func __snappy_text_size(point result) as c_size
extern "xsnappy_text_take" @no_raise func __snappy_text_take(point result) as point
extern "xrtFree" @no_raise func __snappy_free(point data)
extern "xsnappy_compress_file" func __snappy_compress_file(string source, string destination,
    c_bool overwrite, c_ulonglong maxInput, c_ulonglong maxOutput, var onProgress) as c_int
extern "xsnappy_decompress_file" func __snappy_decompress_file(string source, string destination,
    c_bool overwrite, c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio,
    var onProgress) as c_int



func __snappy_check_limit(int value, string name)
    if value <= 0 then
        throw ValueError name + " must be greater than zero"
    end
end

func __snappy_file_path(string value)
    if string.indexOf(value, "\0", false, string.byteLen(value), 1) >= 0 then
        throw ValueError "snappy file path contains NUL"
    end
end

// C 计数器和进度均为无符号 64 位，语言公开 int 前先检查范围。
func __snappy_count(c_ulonglong value) as int
    if value > c_ulonglong(9223372036854775807) then
        throw RangeError "snappy byte count exceeds int range"
    end
    return int(value)
end

func __snappy_progress(func(int, int, int) as bool callback) as var
    return xcall(func(uint64 inputBytes, uint64 totalBytes, uint64 outputBytes) as bool
        return callback(__snappy_count(c_ulonglong(inputBytes)),
            __snappy_count(c_ulonglong(totalBytes)), __snappy_count(c_ulonglong(outputBytes)))
    end)
end

func __snappy_check_file_result(int status)
    if status == -1 then
        throw CancelledError "snappy operation cancelled"
    elseif status != 1 then
        throw CompressionError __snappy_error()
    end
end



// 返回内嵌 snappy 编解码器的版本号（格式兼容 Google Snappy）。
export func version() as string
    return __snappy_version()
end



export func compress(Buffer data, int maxInput = 268435456,
    int maxOutput = 536870912) as Buffer
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    point result = __snappy_compress(data.data(), c_size(data.len()),
        c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if result == null then
        throw CompressionError __snappy_error()
    end
    return Buffer(result)
end

export func compress(string text, int maxInput = 268435456,
    int maxOutput = 536870912) as Buffer
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    point result = __snappy_compress_str(text, c_size(string.byteLen(text)),
        c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if result == null then
        throw CompressionError __snappy_error()
    end
    return Buffer(result)
end

export func decompress(Buffer data, int maxInput = 268435456,
    int maxOutput = 536870912, int maxRatio = 1000) as Buffer
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    __snappy_check_limit(maxRatio, "maxRatio")
    if maxRatio > 4294967295 then
        throw RangeError "snappy maxRatio must fit uint32"
    end
    point result = __snappy_decompress(data.data(), c_size(data.len()),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), c_uint(maxRatio))
    if result == null then
        throw CompressionError __snappy_error()
    end
    return Buffer(result)
end

export func decompressText(Buffer data, int maxInput = 268435456,
    int maxOutput = 536870912, int maxRatio = 1000) as cstring
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    __snappy_check_limit(maxRatio, "maxRatio")
    if maxRatio > 4294967295 then
        throw RangeError "snappy maxRatio must fit uint32"
    end
    point result = __snappy_decompress_text(data.data(), c_size(data.len()),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), c_uint(maxRatio))
    if result == null then throw CompressionError __snappy_error() end
    c_size textSize = __snappy_text_size(result)
    return cstring.take(__snappy_text_take(result), textSize, __snappy_free)
end

export func compressFile(string source, string destination, bool overwrite = true,
    int maxInput = 268435456, int maxOutput = 536870912,
    (func(int, int, int) as bool)? onProgress = null)
    __snappy_file_path(source)
    __snappy_file_path(destination)
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    var progress = null
    if onProgress != null then
        progress = __snappy_progress(onProgress)
    end
    int status = __snappy_compress_file(source, destination, c_bool(overwrite),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), progress)
    __snappy_check_file_result(status)
end

export func decompressFile(string source, string destination, bool overwrite = true,
    int maxInput = 268435456, int maxOutput = 536870912, int maxRatio = 1000,
    (func(int, int, int) as bool)? onProgress = null)
    __snappy_file_path(source)
    __snappy_file_path(destination)
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    __snappy_check_limit(maxRatio, "maxRatio")
    if maxRatio > 4294967295 then
        throw RangeError "snappy maxRatio must fit uint32"
    end
    var progress = null
    if onProgress != null then
        progress = __snappy_progress(onProgress)
    end
    int status = __snappy_decompress_file(source, destination, c_bool(overwrite),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), c_uint(maxRatio), progress)
    __snappy_check_file_result(status)
end



// 增量流式压缩器：update() 喂入数据，drain() 随时取走已产出的压缩字节，
// finish() 封存流。配合 inputBytes/outputBytes 可自行驱动进度回显。
export class SnappyCompressor
    native point handle
    extern "xsnappy_compressor_create" create(c_ulonglong maxInput, c_ulonglong maxOutput)
    extern "xsnappy_compressor_destroy" destroy()
    private extern "xsnappy_compressor_update" func updateNative(point data, c_size size) as bool
    private extern "xsnappy_compressor_update_str" func updateStrNative(string data, c_size size) as bool
    private extern "xsnappy_compressor_finish" func finishNative() as bool
    private extern "xsnappy_compressor_drain" func drainNative() as point
    private extern "xsnappy_compressor_input_bytes" func inputBytesNative() as c_ulonglong
    private extern "xsnappy_compressor_output_bytes" func outputBytesNative() as c_ulonglong

    get valid() as bool
        return self.handle != null
    end

    // 已喂入的原始字节数（进度回显用）。
    get inputBytes() as int
        return __snappy_count(self.inputBytesNative())
    end

    // 已产出的压缩字节数（进度回显用）。
    get outputBytes() as int
        return __snappy_count(self.outputBytesNative())
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw CompressionError __snappy_error()
        end
    end

    func update(string text)
        if not self.updateStrNative(text, c_size(string.byteLen(text))) then
            throw CompressionError __snappy_error()
        end
    end

    // 取走当前已产出的压缩字节并清空内部输出缓冲；无数据时返回空 Buffer。
    func drain() as Buffer
        point result = self.drainNative()
        if result == null then
            throw CompressionError __snappy_error()
        end
        return Buffer(result)
    end

    // 刷出最后一个块。标准 framing 无结束标记；随后可 drain()。
    func finish() as bool
        if not self.finishNative() then
            throw CompressionError __snappy_error()
        end
        return true
    end
end



// 增量流式解压器：update() 喂入压缩字节，drain() 随时取走已解压数据，
// finished 在 finish() 成功后为真；members 统计 stream identifier 数量。
export class SnappyDecompressor
    native point handle
    extern "xsnappy_decompressor_create" create(c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio)
    extern "xsnappy_decompressor_destroy" destroy()
    private extern "xsnappy_decompressor_update" func updateNative(point data, c_size size) as bool
    private extern "xsnappy_decompressor_finish" func finishNative() as bool
    private extern "xsnappy_decompressor_drain" func drainNative() as point
    private extern "xsnappy_decompressor_input_bytes" func inputBytesNative() as c_ulonglong
    private extern "xsnappy_decompressor_output_bytes" func outputBytesNative() as c_ulonglong
    private extern "xsnappy_decompressor_finished" func finishedNative() as bool
    private extern "xsnappy_decompressor_members" func membersNative() as c_ulonglong

    get valid() as bool
        return self.handle != null
    end

    // 已喂入的压缩字节数（进度回显用）。
    get inputBytes() as int
        return __snappy_count(self.inputBytesNative())
    end

    // 已产出的解压字节数（进度回显用）。
    get outputBytes() as int
        return __snappy_count(self.outputBytesNative())
    end

    // finish() 是否已成功完成。
    get finished() as bool
        return self.finishedNative()
    end

    // 已读到的 stream identifier 数；大于 1 表示串联流。
    get members() as int
        return __snappy_count(self.membersNative())
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw CompressionError __snappy_error()
        end
    end

    // 取走当前已解压的数据并清空内部输出缓冲；无数据时返回空 Buffer。
    func drain() as Buffer
        point result = self.drainNative()
        if result == null then
            throw CompressionError __snappy_error()
        end
        return Buffer(result)
    end

    // 校验流已完整结束；流被截断或为空时抛出 CompressionError。
    func finish() as bool
        if not self.finishNative() then
            throw CompressionError __snappy_error()
        end
        return true
    end
end



export func compressor(int maxInput = 268435456, int maxOutput = 536870912) as SnappyCompressor
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    SnappyCompressor result = SnappyCompressor(c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if not result.valid then
        throw CompressionError __snappy_error()
    end
    return result
end

export func decompressor(int maxInput = 268435456, int maxOutput = 536870912,
    int maxRatio = 1000) as SnappyDecompressor
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    __snappy_check_limit(maxRatio, "maxRatio")
    if maxRatio > 4294967295 then
        throw RangeError "snappy maxRatio must fit uint32"
    end
    SnappyDecompressor result = SnappyDecompressor(c_ulonglong(maxInput),
        c_ulonglong(maxOutput), c_uint(maxRatio))
    if not result.valid then
        throw CompressionError __snappy_error()
    end
    return result
end
