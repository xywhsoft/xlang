class Http1Limits
    private int headLimit
    private int startLimit
    private int lineLimit
    private int fieldLimit
    private int bodyLimit
    private int chunkLimit
    private int trailerLimit
    private int trailerLineLimit
    private int trailerFieldLimit
    private int receiveSize
    private int bufferLimit

    create(int maxHead = 65536, int maxStartLine = 8192, int maxFieldLine = 8192, int maxFields = 100, int maxBody = 16777216, int maxChunkLine = 8192, int maxTrailer = 16384, int maxTrailerLine = 8192, int maxTrailers = 32, int readChunk = 65536, int maxBuffered = 1048576)
        if maxHead <= 0 or maxStartLine <= 0 or maxFieldLine <= 0 or maxFields < 0 or maxBody < -1 or maxChunkLine <= 0 or maxTrailer <= 0 or maxTrailerLine <= 0 or maxTrailers < 0 or readChunk <= 0 then
            throw RangeError "invalid HTTP/1 limits"
        end
        if maxBuffered <= maxHead or maxBuffered <= maxChunkLine or maxBuffered <= maxTrailer or maxBuffered < readChunk then
            throw RangeError "HTTP/1 buffer must hold each framing limit and one overflow byte"
        end
        self.headLimit = maxHead
        self.startLimit = maxStartLine
        self.lineLimit = maxFieldLine
        self.fieldLimit = maxFields
        self.bodyLimit = maxBody
        self.chunkLimit = maxChunkLine
        self.trailerLimit = maxTrailer
        self.trailerLineLimit = maxTrailerLine
        self.trailerFieldLimit = maxTrailers
        self.receiveSize = readChunk
        self.bufferLimit = maxBuffered
    end
    get maxHead() as int
        return self.headLimit
    end
    get maxStartLine() as int
        return self.startLimit
    end
    get maxFieldLine() as int
        return self.lineLimit
    end
    get maxFields() as int
        return self.fieldLimit
    end
    get maxBody() as int
        return self.bodyLimit
    end
    get maxChunkLine() as int
        return self.chunkLimit
    end
    get maxTrailer() as int
        return self.trailerLimit
    end
    get maxTrailerLine() as int
        return self.trailerLineLimit
    end
    get maxTrailers() as int
        return self.trailerFieldLimit
    end
    get readChunk() as int
        return self.receiveSize
    end
    get maxBuffered() as int
        return self.bufferLimit
    end
end
// Ordinary language orchestration over the exact resident protocol calls.
// The generator substitutes concrete TCP/TLS calls and sync/await expressions;
// it never generates a protocol parser, a dispatcher or a helper thread.
class Http1TcpTransportHandoff
    private TcpStream connection
    private NetBuffer pending
    private bool ended
    private AtomicInt32 transfer = AtomicInt32(0)
    create(TcpStream stream, NetBuffer buffered, bool endOfStream)
        self.connection = stream
        self.pending = buffered
        self.ended = endOfStream
    end
    get stream() as TcpStream
        if self.transfer.load() != 0 then throw RuntimeError "HTTP handoff is active or already consumed" end
        return self.connection
    end
    get buffered() as NetBuffer
        if self.transfer.load() != 0 then throw RuntimeError "HTTP handoff is active or already consumed" end
        return self.pending
    end
    get endOfStream() as bool
        if self.transfer.load() != 0 then throw RuntimeError "HTTP handoff is active or already consumed" end
        return self.ended
    end
    async func webSocketAsync(WsUpgrade upgrade, WsStreamOptions options, func(WsEvent) as bool events) as WsStream
        if self.ended then throw IOError "WebSocket transport already reached EOF" end
        auto entered, observed = self.transfer.compareExchange(0, 1)
        if not entered then throw RuntimeError "HTTP handoff is active or already consumed" end
        int next = 0
        try
            auto result = await WsStream.attachAsync(self.connection, self.pending, upgrade, options, events)
            next = 2
            return result
        finally
            self.transfer.store(next)
        end
    end

end

class Http1TcpTransport
    private TcpStream connection
    private NetBuffer pending
    private AtomicInt32 phase
    private Http1BodyReader? activeBody = null
    private HttpHeaders? finalTrailers = null
    private bool ended = false
    private bool hasMessage = false
    private int headLimit = 65536
    private int startLimit = 8192
    private int lineLimit = 8192
    private int fieldLimit = 100
    private int bodyLimit = 16777216
    private int chunkLimit = 8192
    private int trailerLimit = 16384
    private int trailerLineLimit = 8192
    private int trailerFieldLimit = 32
    private int receiveSize = 65536
    private int bufferLimit = 1048576

    create(TcpStream stream, Http1Limits? limits = null)
        self.connection = stream
        if limits != null then
            self.headLimit = limits.maxHead
            self.startLimit = limits.maxStartLine
            self.lineLimit = limits.maxFieldLine
            self.fieldLimit = limits.maxFields
            self.bodyLimit = limits.maxBody
            self.chunkLimit = limits.maxChunkLine
            self.trailerLimit = limits.maxTrailer
            self.trailerLineLimit = limits.maxTrailerLine
            self.trailerFieldLimit = limits.maxTrailers
            self.receiveSize = limits.readChunk
            self.bufferLimit = limits.maxBuffered
        end
        self.pending = NetBuffer(self.bufferLimit)
        self.phase = AtomicInt32(0)
    end

    private func enter(bool bodyOperation = false, bool handoff = false) as int
        int old = self.phase.load()
        if old >= 16 then throw RuntimeError "HTTP/1 reader is already active" end
        if handoff then
            if old != 0 and old != 2 then throw RuntimeError "HTTP/1 handoff requires a message boundary or upgrade" end
        elseif bodyOperation then
            if old != 0 and old != 1 then throw RuntimeError "HTTP/1 body is unavailable" end
        elseif old != 0 then
            throw RuntimeError "finish the HTTP/1 body before reading another head"
        end
        auto entered, observed = self.phase.compareExchange(old, old + 16)
        if not entered then throw RuntimeError "concurrent HTTP/1 reader" end
        return old
    end

    get state() as Http1TransportState
        int value = self.phase.load()
        if value >= 16 then value = value - 16 end
        if value == 0 then return Http1TransportState.head end
        if value == 1 then return Http1TransportState.body end
        if value == 2 then return Http1TransportState.upgraded end
        if value == 3 then return Http1TransportState.detached end
        if value == 4 then return Http1TransportState.closed end
        return Http1TransportState.failed
    end
    get busy() as bool
        return self.phase.load() >= 16
    end

    func detach() as Http1TcpTransportHandoff
        int old = self.enter(false, true)
        int next = old
        try
            auto result = Http1TcpTransportHandoff(self.connection, self.pending, self.ended)
            next = 3
            return result
        finally
            self.phase.store(next)
        end
    end

    func close()
        int old = self.phase.load()
        if old == 3 then throw RuntimeError "HTTP/1 transport was detached" end
        if old == 4 then return end
        if old >= 16 then throw RuntimeError "cancel the active HTTP/1 read before closing" end
        auto entered, observed = self.phase.compareExchange(old, old + 16)
        if not entered then throw RuntimeError "concurrent HTTP/1 reader" end
        try
            self.connection.close()
        finally
            self.phase.store(4)
        end
    end

    func trailers() as HttpHeaders
        int old = self.enter(true)
        try
            if old != 0 or not self.hasMessage then throw RuntimeError "HTTP/1 body is not complete" end
            auto fields = self.finalTrailers
            if fields != null then return fields.clone() end
            return HttpHeaders(0)
        finally
            self.phase.store(old)
        end
    end


    private func fill(uint64 deadline, CancellationToken? cancel) as bool
        if self.ended then return false end
        int maximum = self.bufferLimit - self.pending.length
        if maximum <= 0 then throw RangeError "HTTP/1 input buffer limit reached" end
        if maximum > self.receiveSize then maximum = self.receiveSize end
        auto token = cancel
        if token != null then
            auto chunk = self.connection.recvOwnedUntilCancel(deadline, token, maximum)
            if chunk.length == 0 then
                self.ended = true
                return false
            end
            self.pending.appendRef(chunk)
        else
            auto chunk = self.connection.recvOwnedUntil(deadline, maximum)
            if chunk.length == 0 then
                self.ended = true
                return false
            end
            self.pending.appendRef(chunk)
        end
        return true
    end

    private func head(bool response, string method, uint64 deadline, CancellationToken? cancel) as Http1Head?
        auto token = cancel
        if token != null then token.throwIfCancelled() end
        self.enter()
        int next = 5
        try
            while true
                Http1Head? head = null
                if response then
                    head = Http1Head.responseFromNetBuffer(self.pending, self.headLimit, self.startLimit, self.lineLimit, self.fieldLimit)
                else
                    head = Http1Head.requestFromNetBuffer(self.pending, self.headLimit, self.startLimit, self.lineLimit, self.fieldLimit)
                end
                if head != null then
                    auto mode = head.bodyMode(method)
                    Http1BodyReader? body = null
                    if mode != HttpBodyMode.none and mode != HttpBodyMode.tunnel then
                        if mode != HttpBodyMode.fixed or head.contentLength != uint64(0) then
                            body = Http1BodyReader(head, method, self.bodyLimit, self.chunkLimit, self.trailerLimit, self.trailerLineLimit, self.trailerFieldLimit)
                        end
                    end
                    self.pending.consume(head.headerBytes)
                    self.activeBody = body
                    self.finalTrailers = null
                    self.hasMessage = true
                    next = 1
                    if mode == HttpBodyMode.tunnel then
                        next = 2
                        self.activeBody = null
                    elseif body == null then
                        next = 0
                        self.activeBody = null
                    end
                    return head
                end
                if self.ended then
                    if self.pending.length != 0 then throw IOError "truncated HTTP/1 head" end
                    next = 4
                    return null
                end
                self.fill(deadline, cancel)
            end
        finally
            self.phase.store(next)
        end
    end

    func readRequestHead(int timeoutMillis = -1, CancellationToken? cancel = null) as Http1Head?
        return self.head(false, "", Http1.deadline(timeoutMillis), cancel)
    end
    func readResponseHead(string requestMethod = "GET", int timeoutMillis = -1, CancellationToken? cancel = null) as Http1Head?
        return self.head(true, requestMethod, Http1.deadline(timeoutMillis), cancel)
    end

    private func body(Buffer? output, bool whole, uint64 deadline, CancellationToken? cancel) as HttpBodyStatus
        auto token = cancel
        if token != null then token.throwIfCancelled() end
        int old = self.enter(true)
        int next = 5
        try
            if old == 0 then
                next = 0
                if not self.hasMessage then throw RuntimeError "read an HTTP/1 head first" end
                return HttpBodyStatus.done
            end
            auto reader = self.activeBody
            if reader == null then throw RuntimeError "missing HTTP/1 body reader" end
            while true
                HttpBodyStatus status = HttpBodyStatus.more
                if output == null then
                    status = reader.discardFromNetBuffer(self.pending, self.ended)
                else
                    status = reader.readFromNetBuffer(self.pending, output, self.ended)
                end
                if reader.done then
                    if reader.mode == HttpBodyMode.chunked then self.finalTrailers = reader.trailers() end
                    self.activeBody = null
                    next = 0
                    return status
                end
                if status == HttpBodyStatus.data and not whole then
                    next = 1
                    return status
                end
                if status == HttpBodyStatus.more and reader.consumed == 0 then
                    if self.ended then throw IOError "truncated HTTP/1 body" end
                    self.fill(deadline, cancel)
                end
            end
        finally
            self.phase.store(next)
        end
    end

    func readBodyInto(Buffer output, int timeoutMillis = -1, CancellationToken? cancel = null) as HttpBodyStatus
        return self.body(output, false, Http1.deadline(timeoutMillis), cancel)
    end
    func readBodyAllInto(Buffer output, int timeoutMillis = -1, CancellationToken? cancel = null) as int
        int before = output.length
        self.body(output, true, Http1.deadline(timeoutMillis), cancel)
        return output.length - before
    end
    func discardBody(int timeoutMillis = -1, CancellationToken? cancel = null)
        self.body(null, true, Http1.deadline(timeoutMillis), cancel)
    end


    private async func fillAsync(uint64 deadline, CancellationToken? cancel) as bool
        if self.ended then return false end
        int maximum = self.bufferLimit - self.pending.length
        if maximum <= 0 then throw RangeError "HTTP/1 input buffer limit reached" end
        if maximum > self.receiveSize then maximum = self.receiveSize end
        auto token = cancel
        if token != null then
            auto chunk = await self.connection.recvOwnedAsyncUntilCancel(deadline, token, maximum)
            if chunk.length == 0 then
                self.ended = true
                return false
            end
            self.pending.appendRef(chunk)
        else
            auto chunk = await self.connection.recvOwnedAsyncUntil(deadline, maximum)
            if chunk.length == 0 then
                self.ended = true
                return false
            end
            self.pending.appendRef(chunk)
        end
        return true
    end

    private async func headAsync(bool response, string method, uint64 deadline, CancellationToken? cancel) as Http1Head?
        auto token = cancel
        if token != null then token.throwIfCancelled() end
        self.enter()
        int next = 5
        try
            while true
                Http1Head? head = null
                if response then
                    head = Http1Head.responseFromNetBuffer(self.pending, self.headLimit, self.startLimit, self.lineLimit, self.fieldLimit)
                else
                    head = Http1Head.requestFromNetBuffer(self.pending, self.headLimit, self.startLimit, self.lineLimit, self.fieldLimit)
                end
                if head != null then
                    auto mode = head.bodyMode(method)
                    Http1BodyReader? body = null
                    if mode != HttpBodyMode.none and mode != HttpBodyMode.tunnel then
                        if mode != HttpBodyMode.fixed or head.contentLength != uint64(0) then
                            body = Http1BodyReader(head, method, self.bodyLimit, self.chunkLimit, self.trailerLimit, self.trailerLineLimit, self.trailerFieldLimit)
                        end
                    end
                    self.pending.consume(head.headerBytes)
                    self.activeBody = body
                    self.finalTrailers = null
                    self.hasMessage = true
                    next = 1
                    if mode == HttpBodyMode.tunnel then
                        next = 2
                        self.activeBody = null
                    elseif body == null then
                        next = 0
                        self.activeBody = null
                    end
                    return head
                end
                if self.ended then
                    if self.pending.length != 0 then throw IOError "truncated HTTP/1 head" end
                    next = 4
                    return null
                end
                await self.fillAsync(deadline, cancel)
            end
        finally
            self.phase.store(next)
        end
    end

    async func readRequestHeadAsync(int timeoutMillis = -1, CancellationToken? cancel = null) as Http1Head?
        return await self.headAsync(false, "", Http1.deadline(timeoutMillis), cancel)
    end
    async func readResponseHeadAsync(string requestMethod = "GET", int timeoutMillis = -1, CancellationToken? cancel = null) as Http1Head?
        return await self.headAsync(true, requestMethod, Http1.deadline(timeoutMillis), cancel)
    end

    private async func bodyAsync(Buffer? output, bool whole, uint64 deadline, CancellationToken? cancel) as HttpBodyStatus
        auto token = cancel
        if token != null then token.throwIfCancelled() end
        int old = self.enter(true)
        int next = 5
        try
            if old == 0 then
                next = 0
                if not self.hasMessage then throw RuntimeError "read an HTTP/1 head first" end
                return HttpBodyStatus.done
            end
            auto reader = self.activeBody
            if reader == null then throw RuntimeError "missing HTTP/1 body reader" end
            while true
                HttpBodyStatus status = HttpBodyStatus.more
                if output == null then
                    status = reader.discardFromNetBuffer(self.pending, self.ended)
                else
                    status = reader.readFromNetBuffer(self.pending, output, self.ended)
                end
                if reader.done then
                    if reader.mode == HttpBodyMode.chunked then self.finalTrailers = reader.trailers() end
                    self.activeBody = null
                    next = 0
                    return status
                end
                if status == HttpBodyStatus.data and not whole then
                    next = 1
                    return status
                end
                if status == HttpBodyStatus.more and reader.consumed == 0 then
                    if self.ended then throw IOError "truncated HTTP/1 body" end
                    await self.fillAsync(deadline, cancel)
                end
            end
        finally
            self.phase.store(next)
        end
    end

    async func readBodyIntoAsync(Buffer output, int timeoutMillis = -1, CancellationToken? cancel = null) as HttpBodyStatus
        return await self.bodyAsync(output, false, Http1.deadline(timeoutMillis), cancel)
    end
    async func readBodyAllIntoAsync(Buffer output, int timeoutMillis = -1, CancellationToken? cancel = null) as int
        int before = output.length
        await self.bodyAsync(output, true, Http1.deadline(timeoutMillis), cancel)
        return output.length - before
    end
    async func discardBodyAsync(int timeoutMillis = -1, CancellationToken? cancel = null)
        await self.bodyAsync(null, true, Http1.deadline(timeoutMillis), cancel)
    end

end
// Ordinary language orchestration over the exact resident protocol calls.
// The generator substitutes concrete TCP/TLS calls and sync/await expressions;
// it never generates a protocol parser, a dispatcher or a helper thread.
class Http1TlsTransportHandoff
    private TlsStream connection
    private NetBuffer pending
    private bool ended
    private AtomicInt32 transfer = AtomicInt32(0)
    create(TlsStream stream, NetBuffer buffered, bool endOfStream)
        self.connection = stream
        self.pending = buffered
        self.ended = endOfStream
    end
    get stream() as TlsStream
        if self.transfer.load() != 0 then throw RuntimeError "HTTP handoff is active or already consumed" end
        return self.connection
    end
    get buffered() as NetBuffer
        if self.transfer.load() != 0 then throw RuntimeError "HTTP handoff is active or already consumed" end
        return self.pending
    end
    get endOfStream() as bool
        if self.transfer.load() != 0 then throw RuntimeError "HTTP handoff is active or already consumed" end
        return self.ended
    end
    async func webSocketAsync(WsUpgrade upgrade, WsStreamOptions options, func(WsEvent) as bool events) as WsStream
        if self.ended then throw IOError "WebSocket transport already reached EOF" end
        auto entered, observed = self.transfer.compareExchange(0, 1)
        if not entered then throw RuntimeError "HTTP handoff is active or already consumed" end
        int next = 0
        try
            auto result = await WsStream.attachAsync(self.connection, self.pending, upgrade, options, events)
            next = 2
            return result
        finally
            self.transfer.store(next)
        end
    end

end

class Http1TlsTransport
    private TlsStream connection
    private NetBuffer pending
    private AtomicInt32 phase
    private Http1BodyReader? activeBody = null
    private HttpHeaders? finalTrailers = null
    private bool ended = false
    private bool hasMessage = false
    private int headLimit = 65536
    private int startLimit = 8192
    private int lineLimit = 8192
    private int fieldLimit = 100
    private int bodyLimit = 16777216
    private int chunkLimit = 8192
    private int trailerLimit = 16384
    private int trailerLineLimit = 8192
    private int trailerFieldLimit = 32
    private int receiveSize = 65536
    private int bufferLimit = 1048576

    create(TlsStream stream, Http1Limits? limits = null)
        self.connection = stream
        if limits != null then
            self.headLimit = limits.maxHead
            self.startLimit = limits.maxStartLine
            self.lineLimit = limits.maxFieldLine
            self.fieldLimit = limits.maxFields
            self.bodyLimit = limits.maxBody
            self.chunkLimit = limits.maxChunkLine
            self.trailerLimit = limits.maxTrailer
            self.trailerLineLimit = limits.maxTrailerLine
            self.trailerFieldLimit = limits.maxTrailers
            self.receiveSize = limits.readChunk
            self.bufferLimit = limits.maxBuffered
        end
        self.pending = NetBuffer(self.bufferLimit)
        self.phase = AtomicInt32(0)
    end

    private func enter(bool bodyOperation = false, bool handoff = false) as int
        int old = self.phase.load()
        if old >= 16 then throw RuntimeError "HTTP/1 reader is already active" end
        if handoff then
            if old != 0 and old != 2 then throw RuntimeError "HTTP/1 handoff requires a message boundary or upgrade" end
        elseif bodyOperation then
            if old != 0 and old != 1 then throw RuntimeError "HTTP/1 body is unavailable" end
        elseif old != 0 then
            throw RuntimeError "finish the HTTP/1 body before reading another head"
        end
        auto entered, observed = self.phase.compareExchange(old, old + 16)
        if not entered then throw RuntimeError "concurrent HTTP/1 reader" end
        return old
    end

    get state() as Http1TransportState
        int value = self.phase.load()
        if value >= 16 then value = value - 16 end
        if value == 0 then return Http1TransportState.head end
        if value == 1 then return Http1TransportState.body end
        if value == 2 then return Http1TransportState.upgraded end
        if value == 3 then return Http1TransportState.detached end
        if value == 4 then return Http1TransportState.closed end
        return Http1TransportState.failed
    end
    get busy() as bool
        return self.phase.load() >= 16
    end

    func detach() as Http1TlsTransportHandoff
        int old = self.enter(false, true)
        int next = old
        try
            auto result = Http1TlsTransportHandoff(self.connection, self.pending, self.ended)
            next = 3
            return result
        finally
            self.phase.store(next)
        end
    end

    func close()
        int old = self.phase.load()
        if old == 3 then throw RuntimeError "HTTP/1 transport was detached" end
        if old == 4 then return end
        if old >= 16 then throw RuntimeError "cancel the active HTTP/1 read before closing" end
        auto entered, observed = self.phase.compareExchange(old, old + 16)
        if not entered then throw RuntimeError "concurrent HTTP/1 reader" end
        try
            self.connection.close()
        finally
            self.phase.store(4)
        end
    end

    func trailers() as HttpHeaders
        int old = self.enter(true)
        try
            if old != 0 or not self.hasMessage then throw RuntimeError "HTTP/1 body is not complete" end
            auto fields = self.finalTrailers
            if fields != null then return fields.clone() end
            return HttpHeaders(0)
        finally
            self.phase.store(old)
        end
    end


    private func fill(uint64 deadline, CancellationToken? cancel) as bool
        if self.ended then return false end
        int maximum = self.bufferLimit - self.pending.length
        if maximum <= 0 then throw RangeError "HTTP/1 input buffer limit reached" end
        if maximum > self.receiveSize then maximum = self.receiveSize end
        auto token = cancel
        if token != null then
            auto chunk = self.connection.recvOwnedUntilCancel(maximum, deadline, token)
            if chunk.length == 0 then
                self.ended = true
                return false
            end
            self.pending.appendRef(chunk)
        else
            auto chunk = self.connection.recvOwnedUntil(maximum, deadline)
            if chunk.length == 0 then
                self.ended = true
                return false
            end
            self.pending.appendRef(chunk)
        end
        return true
    end

    private func head(bool response, string method, uint64 deadline, CancellationToken? cancel) as Http1Head?
        auto token = cancel
        if token != null then token.throwIfCancelled() end
        self.enter()
        int next = 5
        try
            while true
                Http1Head? head = null
                if response then
                    head = Http1Head.responseFromNetBuffer(self.pending, self.headLimit, self.startLimit, self.lineLimit, self.fieldLimit)
                else
                    head = Http1Head.requestFromNetBuffer(self.pending, self.headLimit, self.startLimit, self.lineLimit, self.fieldLimit)
                end
                if head != null then
                    auto mode = head.bodyMode(method)
                    Http1BodyReader? body = null
                    if mode != HttpBodyMode.none and mode != HttpBodyMode.tunnel then
                        if mode != HttpBodyMode.fixed or head.contentLength != uint64(0) then
                            body = Http1BodyReader(head, method, self.bodyLimit, self.chunkLimit, self.trailerLimit, self.trailerLineLimit, self.trailerFieldLimit)
                        end
                    end
                    self.pending.consume(head.headerBytes)
                    self.activeBody = body
                    self.finalTrailers = null
                    self.hasMessage = true
                    next = 1
                    if mode == HttpBodyMode.tunnel then
                        next = 2
                        self.activeBody = null
                    elseif body == null then
                        next = 0
                        self.activeBody = null
                    end
                    return head
                end
                if self.ended then
                    if self.pending.length != 0 then throw IOError "truncated HTTP/1 head" end
                    next = 4
                    return null
                end
                self.fill(deadline, cancel)
            end
        finally
            self.phase.store(next)
