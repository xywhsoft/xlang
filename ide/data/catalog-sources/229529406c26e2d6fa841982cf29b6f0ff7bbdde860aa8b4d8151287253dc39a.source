    func wait(int timeoutMs = -1) as ProcessExitStatus?
        if not self.waitReady(timeoutMs) then return null end
        return ProcessExitStatus(self)
    end
    async func waitAsync() as ProcessExitStatus
        await self.waitReadyAsync()
        return ProcessExitStatus(self)
    end
