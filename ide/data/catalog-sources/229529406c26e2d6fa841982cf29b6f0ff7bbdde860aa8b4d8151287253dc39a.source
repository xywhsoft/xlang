class SignalHandle
    private SignalSubscription? source = null
    private (func(SignalEvent) as bool)? receiver = null
    private bool consumeBefore = true
    private bool oneShot = false
    private bool dispatching = false
    create(SignalSubscription source, func(SignalEvent) as bool receiver, bool consumeBefore, bool once = false)
        self.source = source
        self.receiver = receiver
        self.consumeBefore = consumeBefore
        self.oneShot = once
end
    private func subscription() as SignalSubscription
        auto source = self.source
        if source == null then throw RuntimeError "signal subscription is not initialized" end
        return source
    end
    get active() as bool
        return self.subscription().active
end
    get code() as int
        return self.subscription().code
end
    get pending() as int
        return self.subscription().pending
end
    get closed() as bool
        return self.subscription().closed
end
    func close() as bool
        auto source = self.subscription()
        source.checkOwner()
        self.receiver = null
        return source.close()
end
    func dispatch(int maxEvents = 64) as int
        return self.dispatchFor(0, maxEvents)
end
    func dispatchFor(int timeoutMs, int maxEvents = 64) as int
        auto source = self.subscription()
        source.checkOwner()
        if self.dispatching then throw RuntimeError "signal dispatch is not reentrant" end
        if maxEvents < 0 or timeoutMs < -1 then throw RangeError "invalid signal dispatch limit" end
        int delivered = 0
        self.dispatching = true
        try
            while delivered < maxEvents
                auto callback = self.receiver
                if callback == null then break end
                if not source.prepare(timeoutMs) then break end
                auto event = SignalEvent(source)
                if self.consumeBefore then source.consume() end
                if self.oneShot then self.close() end
                if not callback(event) then break end
                if not self.consumeBefore then source.consume() end
                delivered += 1
                timeoutMs = 0
            end
        finally
            self.dispatching = false
        end
        return delivered
    end
end
