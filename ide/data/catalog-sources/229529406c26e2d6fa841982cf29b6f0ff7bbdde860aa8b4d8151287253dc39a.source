func __xl_data_public(var input) as var
    throw RuntimeError "public-data intrinsic requires a direct verified call"
end
func __xl_template_scopes(var data, TemplateRenderOptions? options) as var
    var root = data
    var current = data
    var global = null
    if options != null then
        if options.root != null then root = options.root end
        current = root
        if options.current != null then current = options.current end
        global = options.global
    end
    var scopes = __xl_data_public([root, current, global])
    auto prepared = TemplateRenderOptions()
    prepared.root = scopes[0]
    prepared.current = scopes[1]
    prepared.global = scopes[2]
    if options != null then
        prepared.maxOutputBytes = options.maxOutputBytes
        prepared.maxSteps = options.maxSteps
        prepared.maxDepth = options.maxDepth
        prepared.maxLoopIterations = options.maxLoopIterations
        prepared.maxIncludeDepth = options.maxIncludeDepth
        prepared.strictUndefined = options.strictUndefined
        prepared.escapeHtml = options.escapeHtml
    end
    return prepared
end
