func __xl_std_file_access_time(string path) as time
    auto metadata = __xl_std_file_stat(path)
    if (metadata.available & 4) == 0 then throw FileError("file access time metadata is unavailable") end
    return time(metadata.accessed)
end
func __xl_std_file_change_time(string path) as time
    auto metadata = __xl_std_file_stat(path)
    if (metadata.available & 8) == 0 then throw FileError("file modification time metadata is unavailable") end
    return time(metadata.modified)
end
