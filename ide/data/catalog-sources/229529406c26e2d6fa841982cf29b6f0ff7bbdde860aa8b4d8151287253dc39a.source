func __xl_std_time_first_day_of_month(time value) as time
    auto start, finish = __xl_std_time_month_range(value)
    return start
end
func __xl_std_time_last_day_of_month(time value) as time
    auto start, finish = __xl_std_time_month_range(value)
    return __xl_std_xrt_date_add(finish, -1, 4)
end
func __xl_std_time_first_day_of_year(time value) as time
    auto start, finish = __xl_std_time_year_range(value)
    return start
end
func __xl_std_time_last_day_of_year(time value) as time
    auto start, finish = __xl_std_time_year_range(value)
    return __xl_std_xrt_date_add(finish, -1, 4)
end
func __xl_std_time_first_day_of_week(time value, int startDay = 1) as time
    auto start, finish = __xl_std_time_week_range(value, startDay)
    return start
end
func __xl_std_time_last_day_of_week(time value, int startDay = 1) as time
    auto start, finish = __xl_std_time_week_range(value, startDay)
    return __xl_std_xrt_date_add(finish, -1, 4)
end
func __xl_std_time_week_of_year(time value) as int
    auto year, week, weekday = __xl_std_time_iso_week(value)
    return week
end
func __xl_std_time_week_of_month(time value, int startDay = 1) as int
    if startDay < 0 or startDay > 6 then throw RangeError "Invalid first weekday" end
    auto start, finish = __xl_std_time_month_range(value)
    int padding = (__xl_std_time_weekday(start) - startDay + 7) % 7
    return (padding + __xl_std_time_day(value) - 1) / 7 + 1
end
