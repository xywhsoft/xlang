    func readRequestHead(int timeoutMillis = -1, CancellationToken? cancel = null) as Http1Head?
        return self.head(false, "", Http1.deadline(timeoutMillis), cancel)
    end
    func readResponseHead(string requestMethod = "GET", int timeoutMillis = -1, CancellationToken? cancel = null) as Http1Head?
        return self.head(true, requestMethod, Http1.deadline(timeoutMillis), cancel)
    end

    private func body(Buffer? output, bool whole, uint64 deadline, CancellationToken? cancel) as HttpBodyStatus
