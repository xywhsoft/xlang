    if text == null then return __xl_std_log_textFileSink(path, options, LogTextOptions()) end
    return LogSink(path, int(options.level), int(options.mode), int(options.sync), options.maxBytes, options.backupCount, options.recordLimit, options.bufferLimit, options.syncIntervalMs, int(text.style), text.flags, text.utcOffsetSeconds)
end
