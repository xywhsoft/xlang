    func __dispatch(TemplateCall call, array<Template> owners, (func(string) as Template?)? resolver, int maxOwners)
        if call.isInclude then
            if resolver == null then return end
            auto included = resolver(call.name)
            if included == null then return end
            if included.registryIdentity != 0 then
                bool found = included.registryIdentity == self.registryIdentity
                for owner in owners
                    if owner.registryIdentity == included.registryIdentity then found = true end
                end
                if not found then
                    if owners.length >= maxOwners then throw RangeError "template include owner limit" end
                    owners.append(included)
                end
            end
            call.resolve(included)
            return
        end
        Template? owner = null
        if call.registryIdentity == self.registryIdentity then owner = self end
        for candidate in owners
            if candidate.registryIdentity == call.registryIdentity then owner = candidate end
        end
        if owner == null then throw RuntimeError "template callback owner unavailable" end
        if call.extensionIndex < 0 or call.extensionIndex >= owner.handlers.length then throw RuntimeError "template callback index out of range" end
        auto handler = owner.handlers[call.extensionIndex]
        if not handler(call) then throw RuntimeError "template callback rejected invocation" end
end
