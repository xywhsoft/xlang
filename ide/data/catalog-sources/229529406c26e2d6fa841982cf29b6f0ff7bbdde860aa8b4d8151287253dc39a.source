    if not __xl_std_runtime_console_error_line(text) then
        throw IOError "stderr write failed"
    end
end
func __xl_std_console_flush()
    bool stdoutOk = __xl_std_runtime_console_flush(c_int(1))
    bool stderrOk = __xl_std_runtime_console_flush(c_int(2))
    if not stdoutOk then
        throw IOError "stdout flush failed"
    end
    if not stderrOk then
        throw IOError "stderr flush failed"
    end
end
extern "xl6_xrt_console_read_line" func __xl_std_runtime_console_read_line(int maxBytes) as string?
