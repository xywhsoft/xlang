end
func __xl_std_file_walk(string path, func(WalkEntry) as int visitor, func(WalkError) as int onError, int flags = 0, int maxDepth = -1) as WalkStats
    auto visitAdapter = func(var event) as int
        return visitor(WalkEntry(event))
    end
    auto errorAdapter = func(var event) as int
        return onError(WalkError(event))
    end
    return WalkStats(path,visitAdapter,errorAdapter,flags,maxDepth)
end
