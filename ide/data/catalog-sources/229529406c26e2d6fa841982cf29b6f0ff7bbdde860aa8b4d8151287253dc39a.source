class NetResolver
    private native point handle
    extern "xl6NetResolverCreateDefaultV1" create()
    extern "xl6NetResolverCreateV1" create(NetResolverOptions options)
    extern "xl6NetResolverDestroyV1" @no_raise destroy()
    extern "xl6NetResolverCloseV1" @nonblocking func close()
    extern "xl6NetResolverWaitV1" func wait(int timeoutMillis = -1) as bool
    extern "xl6NetResolverRetryV1" @nonblocking func retryCleanup()
    extern "xl6NetResolverClosedV1" @nonblocking get closed() as bool
    extern "xl6NetResolverClearV1" @nonblocking func clearCache()
    extern "xl6NetResolverConfigurationV1" @nonblocking func configuration() as NetResolverOptions
    extern "xl6NetResolverSnapshotV1" @nonblocking func snapshot() as NetResolverStats
    extern "xl6NetResolverQueryV1" @nonblocking func query(string host, int family = 0) as NetResolveOperation
    async func resolveAsync(string host, int port = 0, int family = 0) as NetAddressList
        if port < 0 or port > 65535 then throw RangeError "invalid resolver port" end
        auto operation = self.query(host, family)
        await operation.waitAsync()
        return operation.result(port)
    end
    async func resolveAsyncCancel(string host, CancellationToken token, int port = 0, int family = 0) as NetAddressList
        if port < 0 or port > 65535 then throw RangeError "invalid resolver port" end
        token.throwIfCancelled()
        auto operation = self.query(host, family)
        auto registration = token.onCancel(func()
            operation.cancel()
        end)
        try
            await operation.waitAsync()
            return operation.result(port)
        finally
            registration.close()
        end
    end
end
