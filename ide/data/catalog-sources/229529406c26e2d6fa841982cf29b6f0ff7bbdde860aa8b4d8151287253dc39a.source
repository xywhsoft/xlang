class ConsoleSession
    native point handle
    extern "xl6_xrt_console_session_open" create(int flags)
    extern "xl6_xrt_console_session_destroy" destroy()
    extern "xl6_xrt_console_session_close" func closeNative() as bool
    extern "xl6_xrt_console_session_closed" func closed() as bool
    extern "xl6_xrt_console_session_paste" func pasteSupported() as bool
    extern "xl6_xrt_console_session_write" func writeNative(string text) as bool
    extern "xl6_xrt_console_session_flush" func flushNative() as bool
    extern "xl6_xrt_console_session_move" func moveNative(int x, int y) as bool
    extern "xl6_xrt_console_session_clear" func clearNative(int mode) as bool
    extern "xl6_xrt_console_session_cursor" func cursorNative(bool visible) as bool
    extern "xl6_xrt_console_session_style" func styleNative(int fg, int bg, int attrs) as bool
    extern "xl6_xrt_console_session_read" func readEventNative(int timeoutMs) as point
    func close()
        if not self.closeNative() then throw IOError "terminal close failed" end
    end
    func flush()
        if not self.flushNative() then throw IOError "terminal flush failed" end
    end
    func write(string text)
        if not self.writeNative(text) then throw IOError "terminal write failed" end
    end
    func moveTo(int x, int y)
        if not self.moveNative(x, y) then throw IOError "terminal moveTo failed" end
    end
    func clear(int mode = 0)
        if not self.clearNative(mode) then throw IOError "terminal clear failed" end
    end
    func showCursor(bool visible)
        if not self.cursorNative(visible) then throw IOError "terminal showCursor failed" end
    end
    func setStyle(ConsoleStyle style)
        if not self.styleNative(style.foreground, style.background, style.attributes) then throw IOError "terminal setStyle failed" end
    end
    func resetStyle()
        if not self.styleNative(-1, -1, 0) then throw IOError "terminal style reset failed" end
    end
    func readEvent(int timeoutMs = -1) as ConsoleEvent?
        point event = self.readEventNative(timeoutMs)
        if event == null then return null end
        return ConsoleEvent(event)
    end
end
