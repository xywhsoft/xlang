class Pattern
    private __PatternCode code
    private var payload
    private list<var>? table
    create(string expression, var tag = null, int size = -1)
        self.code = __PatternCode(expression, size)
        self.payload = tag
    end
    create(__PatternCode code, list<var> tags)
        self.code = code
        self.table = tags
    end
    create(PatternOptions options, string expression, var tag = null, int size = -1)
        self.code = __PatternCode(options, expression, size)
        self.payload = tag
    end
    get count() as int
        return self.code.count
    end
    get compiledBytes() as int
        return self.code.compiledBytes
    end
    get separators() as string
        return self.code.separators
    end
    func source(int index = 0) as string
        return self.code.source(index)
    end
    func id(int index = 0) as uint64
        return self.code.id(index)
    end
    func captureCount(int patternIndex = 0) as int
        return self.code.captureCount(patternIndex)
    end
    func captureName(int index, int patternIndex = 0) as string
        return self.code.captureName(index, patternIndex)
    end
    func captureIndex(string name, int patternIndex = 0, int size = -1) as int
        return self.code.captureIndex(name, patternIndex, size)
    end
    func first(string text, int size = -1) as int
        return self.code.first(text, size)
    end
    func test(string text, int size = -1) as bool
        return self.code.test(text, size)
    end
    func tag(int index = 0) as var
        if index < 0 or index >= self.code.count then throw RangeError "Pattern index out of range" end
        auto table = self.table
        if table != null then return table[self.code.tagKey(index)] end
        return self.payload
    end
    func find(string text, int size = -1) as PatternMatch?
        auto capture = __PatternCapture(self.code, text, size)
        if not capture.matched then return null end
        return PatternMatch(capture, self.tag(capture.patternIndex))
    end
end
