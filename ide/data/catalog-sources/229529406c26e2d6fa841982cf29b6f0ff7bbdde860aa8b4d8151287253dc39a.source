func __xl_std_crypto_random_hex(int byteCount) as string
    if byteCount < 0 then throw RangeError "secure random byte count is invalid" end
    return __xl_std_runtime_take_cstr(__xl_std_xrt_secure_hex(byteCount))
end
func __xl_std_crypto_random_string(int length = 22, string alphabet = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-_", int alphabetSize = -1) as string
