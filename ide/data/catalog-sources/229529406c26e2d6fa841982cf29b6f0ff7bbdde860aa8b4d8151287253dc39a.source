    extern "xl6_xrt_rng_shuffle_buffer" func shuffleBufferNative(point target) as bool

    func fillBytes(Buffer target)
        if not self.fillBytesNative(target.nativeHandle()) then throw RuntimeError "random buffer fill failed" end
    end

    func shuffleBuffer(Buffer target)
        if not self.shuffleBufferNative(target.nativeHandle()) then throw RuntimeError "random buffer shuffle failed" end
    end
