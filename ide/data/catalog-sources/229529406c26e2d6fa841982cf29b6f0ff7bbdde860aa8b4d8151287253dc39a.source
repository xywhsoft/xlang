        return uint32(self.u32Native())
    end

    func string(int length = 16, string alphabet = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-_", int alphabetSize = -1) as string
        if length < 0 or alphabetSize < -1 then throw RangeError "random string length is invalid" end
        return __xl_std_runtime_take_cstr(self.stringNative(alphabet, c_size(__xl_std_xrt_string_byte_len(alphabet)), alphabetSize, length))
    end

    func shuffle(array values)
        if not self.shuffleNative(values) then throw RuntimeError "random array shuffle failed" end
    end

