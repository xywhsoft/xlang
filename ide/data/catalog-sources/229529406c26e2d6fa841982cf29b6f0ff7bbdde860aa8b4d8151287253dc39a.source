class __PatternBuildCache
    uint64 version
    Pattern value
    create(uint64 version, Pattern value)
        self.version = version
        self.value = value
    end
end
class PatternBuilder
    private __PatternBuilderCode code
    private var state
    private __PatternBuildCache? cache
    create()
        self.code = __PatternBuilderCode()
        self.state = __xl_pattern_state_create(self.code.identity())
    end
    create(PatternOptions options)
        self.code = __PatternBuilderCode(options)
        self.state = __xl_pattern_state_create(self.code.identity())
    end
    get count() as int
        return self.code.count
    end
    get version() as uint64
        return self.code.version
    end
    get dirty() as bool
        auto cache = self.cache
        if cache == null then return true end
        return cache.version != self.code.version
    end
    func reserve(int capacity)
        self.code.reserve(capacity)
    end
    func contains(PatternKey key) as bool
        return self.code.contains(key)
    end
    func add(string expression, var tag = null, int priority = 0, int size = -1) as PatternKey
        auto edit = __PatternEdit(self.code, expression, priority, size)
        try
            auto key = PatternKey(edit)
            edit.apply(self.state, tag)
            return key
        finally
            edit.cancel()
        end
    end
    func addMany(array<PatternSpec> specs) as array<PatternKey>
        array<PatternKey> keys = array[]
        if specs.length == 0 then return keys end
        array<string> expressions = array[]
        array<int> priorities = array[]
        array<int> sizes = array[]
        array<var> tags = array[]
        for spec in specs
            expressions.push(spec.expression)
            priorities.push(spec.priority)
            sizes.push(spec.size)
            tags.push(spec.tag)
        end
        auto edit = __PatternEdit(self.code, expressions, priorities, sizes)
        try
            int i = 0
            while i < edit.count
                keys.push(PatternKey(edit, i))
                i += 1
            end
            edit.applyMany(self.state, tags)
            return keys
        finally
            edit.cancel()
        end
    end
    func set(PatternKey key, string expression, var tag = null, int priority = 0, int size = -1)
        auto edit = __PatternEdit(self.code, key, expression, priority, size)
        try
            edit.apply(self.state, tag)
        finally
            edit.cancel()
        end
    end
    func remove(PatternKey key) as bool
        if not self.code.contains(key) then return false end
        auto edit = __PatternEdit(self.code, key)
        try
            edit.apply(self.state, null)
            return true
        finally
            edit.cancel()
        end
    end
    func clear()
        auto edit = __PatternEdit(self.code)
        try
            edit.apply(self.state, null)
        finally
            edit.cancel()
        end
    end
    func compile() as Pattern
        auto version = self.code.version
        auto old = self.cache
        if old != null and old.version == version then return old.value end
        auto program = __PatternCode(self.code)
        auto tags = self.code.tags(self.state)
        auto result = Pattern(program, tags)
        auto entry = __PatternBuildCache(version, result)
        self.cache = entry
        return result
    end
end
