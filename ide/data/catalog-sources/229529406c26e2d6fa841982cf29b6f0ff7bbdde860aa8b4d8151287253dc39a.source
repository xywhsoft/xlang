func __xl_std_math_is_normal(float x) as bool
    float magnitude = __xl_std_math_abs(x)
    return magnitude >= 2.2250738585072014e-308 and magnitude <= 1.7976931348623157e308
end
func __xl_std_math_is_subnormal(float x) as bool
    float magnitude = __xl_std_math_abs(x)
    return magnitude > 0.0 and magnitude < 2.2250738585072014e-308
end
func __xl_std_math_classify(float x) as FloatClass
    if x != x then
        return FloatClass.nan
    end
    if x == 0.0 then
        return FloatClass.zero
    end
    float magnitude = __xl_std_math_abs(x)
    if magnitude > 1.7976931348623157e308 then
        return FloatClass.infinite
    end
    if magnitude < 2.2250738585072014e-308 then
        return FloatClass.subnormal
    end
    return FloatClass.normal
end
func __xl_std_math_is_unordered(float x, float y) as bool
    return x != x or y != y
end
func __xl_std_array_sift_down<T>(array<T> values, int root, int limit, func(T, T) as int compare)
    while root < limit / 2
        int child = root * 2 + 1
        if child + 1 < limit and compare(values[child], values[child + 1]) < 0 then
            child += 1
        end
        if compare(values[root], values[child]) >= 0 then
            return
        end
        T temp = values[root]
        values[root] = values[child]
        values[child] = temp
        root = child
    end
end
func __xl_std_array_sort<T>(array<T> values, func(T, T) as int compare)
    int count = values.length
    int start = count / 2
    while start > 0
        start -= 1
        __xl_std_array_sift_down::<T>(values, start, count, compare)
    end
    int limit = count
    while limit > 1
        limit -= 1
        T temp = values[0]
        values[0] = values[limit]
        values[limit] = temp
        __xl_std_array_sift_down::<T>(values, 0, limit, compare)
    end
end
func __xl_std_array_sift_down_by<T, K>(array<T> values, array<K> keys, int root, int limit, func(K, K) as int compare)
    while root < limit / 2
        int child = root * 2 + 1
        if child + 1 < limit and compare(keys[child], keys[child + 1]) < 0 then
            child += 1
        end
        if compare(keys[root], keys[child]) >= 0 then
            return
        end
        K keyTemp = keys[root]
        keys[root] = keys[child]
        keys[child] = keyTemp
        T valueTemp = values[root]
        values[root] = values[child]
        values[child] = valueTemp
        root = child
    end
end
func __xl_std_array_sort_by<T, K>(array<T> values, func(T) as K keyOfValue, func(K, K) as int compare)
    array<K> keys = []
    int i = 0
    while i < values.length
        if not keys.push(keyOfValue(values[i])) then
            throw RuntimeError "sortBy key allocation failed"
        end
        i += 1
    end
    int count = values.length
    int start = count / 2
    while start > 0
        start -= 1
        __xl_std_array_sift_down_by::<T, K>(values, keys, start, count, compare)
    end
    int limit = count
    while limit > 1
        limit -= 1
        K keyTemp = keys[0]
        keys[0] = keys[limit]
        keys[limit] = keyTemp
        T valueTemp = values[0]
        values[0] = values[limit]
        values[limit] = valueTemp
        __xl_std_array_sift_down_by::<T, K>(values, keys, 0, limit, compare)
    end
end
func __xl_std_array_binary_search<T>(array<T> values, T needle, func(T, T) as int compare) as int
    int low = 0
    int high = values.length
    while low < high
        int middle = low + (high - low) / 2
        int order = compare(values[middle], needle)
        if order < 0 then
            low = middle + 1
        else
            high = middle
        end
    end
    if low < values.length and compare(values[low], needle) == 0 then
        return low
    end
    return -1
end
func __xl_std_ascii_is_alpha(char c) as bool
    return (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z')
end
func __xl_std_ascii_is_digit(char c) as bool
    return c >= '0' and c <= '9'
end
func __xl_std_ascii_is_alphanumeric(char c) as bool
    return (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9')
end
func __xl_std_ascii_is_hex_digit(char c) as bool
    return (c >= '0' and c <= '9') or (c >= 'A' and c <= 'F') or (c >= 'a' and c <= 'f')
end
func __xl_std_ascii_is_whitespace(char c) as bool
    return c == ' ' or (c >= '\t' and c <= '\r')
end
func __xl_std_ascii_is_blank(char c) as bool
    return c == ' ' or c == '\t'
end
func __xl_std_ascii_is_control(char c) as bool
    return c < ' ' or c == 127
end
func __xl_std_ascii_is_printable(char c) as bool
    return c >= ' ' and c <= '~'
end
func __xl_std_ascii_is_graphical(char c) as bool
    return c >= '!' and c <= '~'
end
func __xl_std_ascii_is_punctuation(char c) as bool
    return (c >= '!' and c <= '/') or (c >= ':' and c <= '@') or (c >= '[' and c <= '`') or (c >= '{' and c <= '~')
end
func __xl_std_ascii_is_lower(char c) as bool
    return c >= 'a' and c <= 'z'
end
func __xl_std_ascii_is_upper(char c) as bool
    return c >= 'A' and c <= 'Z'
end
func __xl_std_ascii_to_lower(char c) as char
    if c >= 'A' and c <= 'Z' then
        return char(c + 32)
    end
    return c
end
func __xl_std_ascii_to_upper(char c) as char
    if c >= 'a' and c <= 'z' then
        return char(c - 32)
    end
    return c
end
