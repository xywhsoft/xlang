        if not self.updateStringNative(data, __xl_std_xrt_string_byte_len(data), size) then throw RangeError "siphash input is too large" end
    end
    func update(bytes data, int size = -1)
        if size < -1 then throw RangeError "siphash size is invalid" end
        if not self.updateBytesNative(data, size) then throw RangeError "siphash input is too large" end
    end
    func digest() as uint64
        return uint64(self.digestNative())
    end
    func reset()
        self.resetNative()
    end
    func clone() as SipHasher64
        return SipHasher64(point(self.cloneNative()))
    end
    func inputBytes() as uint64
        return uint64(self.inputBytesNative())
    end
    extern "xl6_xrt_siphasher64_update_raw" func updateRawNative(point data, c_size actual, int size) as bool
    func updateBuffer(Buffer data, int size = -1)
        if size < -1 then throw RangeError "siphash size is invalid" end
        if not self.updateRawNative(data.data(), c_size(data.len()), size) then throw RangeError "siphash input is too large" end
