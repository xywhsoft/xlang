func __xl_std_log_customSink(func(LogRecord) as LogResult write, string name = "custom", LogLevel level = LogLevel.trace, (func() as bool)? flush = null) as LogSink
    func(point) as int dispatch = func(point source) as int => int(write(LogRecord(source)))
    var writeValue = xcall(dispatch)
    var flushValue = null
    if flush != null then flushValue = xcall(flush) end
    return LogSink(name, int(level), writeValue, flushValue)
end
