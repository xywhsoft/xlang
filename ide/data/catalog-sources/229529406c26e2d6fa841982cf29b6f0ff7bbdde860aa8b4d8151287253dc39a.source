func __xl_std_log_textWriterSink(IoWriter target, LogTextOptions? options = null, LogLevel level = LogLevel.trace) as LogSink
    if options == null then return __xl_std_log_textWriterSink(target, LogTextOptions(), level) end
    int style = int(options.style)
    int flags = options.flags
    int offset = options.utcOffsetSeconds
    if not __xl_std_runtime_log_text_validate(style, flags, offset) then throw ValueError "invalid log text configuration" end
    func(LogRecord) as LogResult write = func(LogRecord record) as LogResult
        record.textWriterNative(target, style, flags, offset)
        return LogResult.written
    end
    func() as bool flush = func() as bool
        target.flush()
        return true
    end
    return __xl_std_log_customSink(write, "writer-text", level, flush)
end
func __xl_std_log_jsonWriterSink(IoWriter target, LogJsonOptions? options = null, LogLevel level = LogLevel.trace) as LogSink
    if options == null then return __xl_std_log_jsonWriterSink(target, LogJsonOptions(), level) end
    int flags = options.flags
    int escape = options.escapeFlags
