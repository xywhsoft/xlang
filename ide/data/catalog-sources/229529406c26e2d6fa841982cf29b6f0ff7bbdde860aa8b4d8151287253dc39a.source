    end
    get changed() as int
        return int(self.snapshot["changed"])
    end
    get pathBytes() as bytes
        return self.snapshot["pathBytes"] as bytes
    end
    get parentBytes() as bytes
        return self.snapshot["parentBytes"] as bytes
    end
    get nameBytes() as bytes
        return self.snapshot["nameBytes"] as bytes
    end
    get isFile() as bool
        return self.type == 1
    end
    get isDir() as bool
        return self.type == 2
    end
    get isLink() as bool
        return (self.flags & 2) != 0
    end
    get cycle() as bool
        return (self.flags & 4) != 0
    end
    get crossFilesystem() as bool
        return (self.flags & 8) != 0
    end
    get enter() as bool
        return self.event == 1
    end
    get leave() as bool
        return self.event == 3
    end
end
