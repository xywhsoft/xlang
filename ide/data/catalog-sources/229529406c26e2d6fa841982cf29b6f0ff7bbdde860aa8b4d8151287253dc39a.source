func __xl_std_io_copy(IoReader source, IoWriter target) as int
    return __xl_std_runtime_io_copy(source.nativeHandle(), target.nativeHandle(), -1, 0)
end

func __xl_std_io_copy(IoReadable source, IoWritable target) as int
    int limit = -1
    int total = 0
    while limit < 0 or total < limit
        int request = 16384
        if limit >= 0 and limit - total < request then request = limit - total end
        bytes chunk = source.read(request)
        if chunk.length > request then throw IOError "reader exceeded requested length" end
        if chunk.length == 0 then
            return total
        end
        if total > 9223372036854775807 - chunk.length then throw RangeError "copy size overflow" end
        target.writeAll(chunk, -1)
        total += chunk.length
    end
    return total
end

func __xl_std_io_copyExact(IoReader source, IoWriter target, int count) as int
    return __xl_std_runtime_io_copy(source.nativeHandle(), target.nativeHandle(), count, 1)
end

func __xl_std_io_copyExact(IoReadable source, IoWritable target, int count) as int
    int limit = count
    if limit < 0 then throw RangeError "copy limit is invalid" end
    int total = 0
    while limit < 0 or total < limit
        int request = 16384
        if limit >= 0 and limit - total < request then request = limit - total end
        bytes chunk = source.read(request)
        if chunk.length > request then throw IOError "reader exceeded requested length" end
        if chunk.length == 0 then
            throw IOError "unexpected end of stream"
            return total
        end
        if total > 9223372036854775807 - chunk.length then throw RangeError "copy size overflow" end
        target.writeAll(chunk, -1)
        total += chunk.length
    end
    return total
end

func __xl_std_io_copyUpTo(IoReader source, IoWriter target, int count) as int
    return __xl_std_runtime_io_copy(source.nativeHandle(), target.nativeHandle(), count, 2)
end

func __xl_std_io_copyUpTo(IoReadable source, IoWritable target, int count) as int
    int limit = count
    if limit < 0 then throw RangeError "copy limit is invalid" end
    int total = 0
    while limit < 0 or total < limit
        int request = 16384
        if limit >= 0 and limit - total < request then request = limit - total end
        bytes chunk = source.read(request)
        if chunk.length > request then throw IOError "reader exceeded requested length" end
        if chunk.length == 0 then
            return total
        end
        if total > 9223372036854775807 - chunk.length then throw RangeError "copy size overflow" end
        target.writeAll(chunk, -1)
        total += chunk.length
    end
    return total
end

