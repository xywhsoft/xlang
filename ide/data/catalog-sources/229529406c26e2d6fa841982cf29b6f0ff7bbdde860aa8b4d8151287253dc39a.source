    if not __xl_std_runtime_write(text) then
        throw IOError "stdout write failed"
    end
end
func __xl_std_console_write_line(string text = "")
    if not __xl_std_runtime_writeln(text) then
        throw IOError "stdout write failed"
    end
end
func __xl_std_console_error(string text)
    if not __xl_std_runtime_console_error(text) then
        throw IOError "stderr write failed"
    end
end
