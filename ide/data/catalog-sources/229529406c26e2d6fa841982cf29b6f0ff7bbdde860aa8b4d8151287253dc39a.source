class FixedStack<T>
    private Stack<T> values
    private int limit = 0
    create(int capacity)
        if capacity < 0 then throw RangeError "FixedStack capacity must be nonnegative" end
        self.values.reserve(capacity)
        self.limit = capacity
    end
    func count() as int
        return self.values.count()
    end
    func capacity() as int
        return self.limit
    end
    func empty() as bool
        return self.values.count() == 0
    end
    func full() as bool
        return self.values.count() == self.limit
    end
    func push(T value) as bool
        if self.full() then return false end
        return self.values.push(value)
    end
    func pop() as T
        return self.values.pop()
    end
    func peek() as T
        return self.values.peek()
    end
    func peekAt(int depth) as T
        return self.values.peekAt(depth)
    end
    func tryPop() as (bool, T?)
        return self.values.tryPop()
    end
    func tryPeek() as (bool, T?)
        return self.values.tryPeek()
    end
    func tryPeekAt(int depth) as (bool, T?)
        return self.values.tryPeekAt(depth)
    end
    func clear()
        self.values.clear()
    end
    func clone() as FixedStack<T>
        auto result = FixedStack::<T>(self.limit)
        result.values = self.values.clone()
        result.values.reserve(self.limit)
        return result
    end
    func __copy__() as FixedStack<T>
        return self.clone()
    end
    func __clone__() as FixedStack<T>
        return self.clone()
    end
    func equals(FixedStack<T> other) as bool
        return self.values.equals(other.values)
    end
end
