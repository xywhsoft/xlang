func __xl_std_console_readLine(int maxBytes = 1048576) as string?
    return __xl_std_runtime_console_read_line(maxBytes)
end

func __xl_std_console_readChar() as char?
    int value = __xl_std_runtime_console_read_char()
    if value < 0 then return null end
    return char(value)
end

func __xl_std_console_isTerminal(int stream = 1) as bool
    return __xl_std_runtime_console_is_terminal(stream)
end

func __xl_std_console_size(int stream = 1) as (int, int)
    int value = __xl_std_runtime_console_size(stream)
    return value >> 32, value & 4294967295
end

func __xl_std_console_colorMode(int stream = 1) as int
    return __xl_std_runtime_console_color(stream)
end

func __xl_std_console_writeStyled(string text, ConsoleStyle style)
    if not __xl_std_runtime_console_styled(text, 1, style.foreground, style.background, style.attributes) then throw IOError "styled output failed" end
end

func __xl_std_console_errorStyled(string text, ConsoleStyle style)
    if not __xl_std_runtime_console_styled(text, 2, style.foreground, style.background, style.attributes) then throw IOError "styled output failed" end
end

func __xl_std_console_rgb(int red, int green, int blue) as int
    if red < 0 or red > 255 or green < 0 or green > 255 or blue < 0 or blue > 255 then throw RangeError "RGB component out of range" end
    return 16777216 | (red << 16) | (green << 8) | blue
end

func __xl_std_console_openSession(ConsoleOptions? options = null) as ConsoleSession
    if options == null then return ConsoleSession(5) end
    int flags = 0
    if options.raw then flags |= 1 end
    if options.mouse then flags |= 2 end
    if options.paste then flags |= 4 end
    if options.alternateScreen then flags |= 8 end
    return ConsoleSession(flags)
end

