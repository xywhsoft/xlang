func __xl_std_file_set_times(string path, int? accessed = null, int? modified = null, bool follow = true) as bool
    bool hasAccess = accessed != null
    bool hasModify = modified != null
    int a = 0
    int m = 0
    if accessed != null then a = accessed end
    if modified != null then m = modified end
    return __xl_fs_file_set_times(path,a,m,hasAccess,hasModify,follow)
end
