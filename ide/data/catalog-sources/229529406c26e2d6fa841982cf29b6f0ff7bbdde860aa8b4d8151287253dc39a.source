class TemplateEngine
    private TemplateEngineGuard guard = TemplateEngineGuard()
    private array<var> definitions = []
    private array<func(TemplateCall) as bool> handlers = []
    private func register(string name, int kind, func(TemplateCall) as bool handler, int minArgs, int maxArgs) as bool
        self.guard.validate(name, kind, minArgs, maxArgs)
        for definition in self.definitions
            if string(definition[0]) == name then throw ValueError "duplicate template extension" end
        end
        self.definitions.append([name, kind, minArgs, maxArgs])
        try
            self.handlers.append(handler)
        catch failure
            self.definitions.remove(self.definitions.length - 1, 1)
            throw
        end
        return true
end
    func registerFunction(string name, func(TemplateCall) as bool handler, int minArgs = 0, int maxArgs = 256) as bool
        return self.register(name, 1, handler, minArgs, maxArgs)
end
    func registerStatement(string name, func(TemplateCall) as bool handler, int minArgs = 0, int maxArgs = 256) as bool
        return self.register(name, 2, handler, minArgs, maxArgs)
end
    func registerBlock(string name, func(TemplateCall) as bool handler, int minArgs = 0, int maxArgs = 256) as bool
        return self.register(name, 3, handler, minArgs, maxArgs)
end
    func registerRawBlock(string name, func(TemplateCall) as bool handler, int minArgs = 0, int maxArgs = 256) as bool
        return self.register(name, 4, handler, minArgs, maxArgs)
end
    func compile(string text, TemplateCompileOptions? options = null, int size = -1) as Template
        self.guard.check()
        auto compiled = Template(text, options, self.definitions, size)
        compiled.__bindHandlers(self.handlers)
        return compiled
end
    func compileFile(string path, TemplateCompileOptions? options = null, int encoding = 0, int policy = 0, int maxInputBytes = 67108864) as Template
        self.guard.check()
        return self.compile(__xl_template_read_file(path, encoding, policy, maxInputBytes), options)
end
    func compileFileIn(Vfs filesystem, string path, TemplateCompileOptions? options = null, int encoding = 0, int policy = 0, int maxInputBytes = 67108864) as Template
        self.guard.check()
        return self.compile(__xl_template_read_vfs(filesystem, path, encoding, policy, maxInputBytes), options)
end
end
