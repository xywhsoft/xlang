        return self.waitAsync(0)
    end
    func readableAsync() as future<bool>
        return self.waitAsync(1)
    end
    func writableAsync() as future<bool>
        return self.waitAsync(2)
    end
    func drainAsync() as future<bool>
        return self.waitAsync(3)
    end
    func endAsync() as future<bool>
        return self.waitAsync(4)
    end
    func closeAsync() as future<bool>
        return self.waitAsync(5)
