    if not __xl_std_runtime_print(arg, false) then throw IOError "stdout print failed" end
end
func __xl_std_println(...)
    if not __xl_std_runtime_print(arg, true) then throw IOError "stdout print failed" end
end
func __xl_std_write(string text)
    if not __xl_std_runtime_write(text) then
        throw IOError "stdout write failed"
    end
end
