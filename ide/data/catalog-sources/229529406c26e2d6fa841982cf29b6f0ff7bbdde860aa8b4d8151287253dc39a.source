    func waitOpen(int timeoutMillis = -1) as bool
        return self.wait(0, timeoutMillis)
    end
    func waitReadable(int timeoutMillis = -1) as bool
        return self.wait(1, timeoutMillis)
    end
    func waitWritable(int timeoutMillis = -1) as bool
        return self.wait(2, timeoutMillis)
    end
    func drain(int timeoutMillis = -1) as bool
        return self.wait(3, timeoutMillis)
    end
    func waitEnd(int timeoutMillis = -1) as bool
        return self.wait(4, timeoutMillis)
    end
    func waitClose(int timeoutMillis = -1) as bool
        return self.wait(5, timeoutMillis)
    end
