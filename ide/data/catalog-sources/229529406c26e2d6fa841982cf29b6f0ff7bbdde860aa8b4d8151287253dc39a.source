func __xl_std_tcc_context() as TccContext
    return TccContext()
end
func __xl_std_tcc_run(string source) as int
    TccContext ctx = TccContext()
    if ctx.compileString(source) != 0 then
        return -1
    end
    return ctx.run()
end
func __xl_std_tcc_run_file(string path) as int
    TccContext ctx = TccContext()
    if ctx.addFile(path) != 0 then
        return -1
    end
    return ctx.run()
end
func __xl_std_tcc_compile(string source, string output, int outputType = 2) as int
    TccContext ctx = TccContext(c_int(outputType))
    if ctx.compileString(source) != 0 then
        return -1
    end
    return int(ctx.outputFile(output))
end
func __xl_std_tcc_compile_file(string path, string output, int outputType = 2) as int
    TccContext ctx = TccContext(c_int(outputType))
    if ctx.addFile(path) != 0 then
        return -1
    end
    return int(ctx.outputFile(output))
end
