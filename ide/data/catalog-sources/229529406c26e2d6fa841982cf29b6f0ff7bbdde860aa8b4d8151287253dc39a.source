class IoLineReader
    native point handle
    extern "xl6_xrt_io_lines_create" create(point reader, int maxLineBytes)
    extern "xl6_xrt_io_lines_destroy" destroy()
    extern "xl6_xrt_io_lines_close" func closeNative() as bool
    extern "xl6_xrt_io_lines_advance" func advance() as bool
    extern "xl6_xrt_io_lines_bytes" func lineBytes() as bytes
    extern "xl6_xrt_io_lines_ending" func ending() as int
    func __iter__() as IoLineReader
        return self
    end
    func close()
        if not self.closeNative() then throw IOError "line reader close failed" end
    end
    func next() as (bool, bytes, int)
        if not self.advance() then return false, b"", 0 end
        return true, self.lineBytes(), self.ending()
    end
    func __next__() as (bool, bytes)
        if not self.advance() then return false, b"" end
        return true, self.lineBytes()
    end
end

