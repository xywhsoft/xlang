// 构造一个脚本友好的借用地址描述。
export func address(string address, string name = "") as var
    return {"address": address, "name": name}
end


// 构造附件描述；data 可以是 string 或 bytes 动态值。
export func attachment(
    string fileName,
    string mediaType,
    var data,
    string contentId = "",
    bool inline = false
) as var
    return {
        "fileName": fileName,
        "mediaType": mediaType,
        "data": data,
        "contentId": contentId,
        "inline": inline
    }
end


// 保留调用方字段形态；compose/valid 在进入 C 前共享同一映射合同。
export func message(var fields) as var
    return fields
end


// 返回最近一次当前线程 xmail 失败的结构化消息。
export func lastError() as string
    return __xmail_error()
end


// 只验证消息，不生成随机 Date、Message-ID 或 MIME boundary。
export func valid(var value) as bool
    return __xmail_valid(__xmail_data(value))
end


// 直接调用 xrtMailCompose，返回完整 RFC/MIME 报文。
func __xmail_compose_text(var value) as string
    point result = __xmail_compose(__xmail_data(value))
    if result == null then
        throw ValueError __xmail_error()
    end
    return Buffer(result).text()
end


// 直接调用 xrtMailCompose，返回完整 RFC/MIME 报文。
export func compose(var value) as string
    return __xmail_compose_text(value)
end


// 使用保守默认预算解析完整 RFC/MIME 报文。
export func parse(string source) as var
    return parseLimits(source, 0, 0, 0, 0)
end


// 显式控制整棵 MIME 树的资源预算；零值使用 XRT 默认值。
export func parseLimits(
    string source,
    int maxDepth,
    int maxParts,
    int maxSourceBytes,
    int maxDecodedBytes
) as var
    if maxDepth < 0 or maxParts < 0 or maxSourceBytes < 0 or maxDecodedBytes < 0 then
        throw ValueError "xmail parse limits must not be negative"
    end
    var result = __xmail_parse(
        source,
        c_size(string.byteLen(source)),
        c_ulonglong(maxDepth),
        c_ulonglong(maxParts),
        c_ulonglong(maxSourceBytes),
        c_ulonglong(maxDecodedBytes))
    if result == null then
        throw ValueError __xmail_error()
    end
    return result
end


// Message 提供常见路径的对象手感，同时保留 fields 动态扩展能力。
export class Message
    var fields

    create(var fields)
        self.fields = fields
    end

    get valid() as bool
        return __xmail_valid(__xmail_data(self.fields))
    end

    func compose() as string
        return __xmail_compose_text(self.fields)
    end
end



// SmtpConfig 只描述连接和协议边界，Engine 与可选 TlsClientContext 由 open 显式传入。
export class SmtpConfig
    string host
    int port
    int security
    string hello
    int lineLimit
    int timeoutMs

    create(
        string host,
        int port = 25,
        int security = SECURITY_PLAIN,
        string hello = "localhost",
        int timeoutMs = 30000,
        int lineLimit = 0
    )
        self.host = host
        self.port = port
        self.security = security
        self.hello = hello
        self.timeoutMs = timeoutMs
        self.lineLimit = lineLimit
    end
end



// SmtpAuth 保留机制选择和明文凭据策略，不在客户端对象中保存 Secret。
export class SmtpAuth
    int method
    string username
    string secret
    string authorizationId
    bool initialResponse
    bool allowPlaintext

    create(
        string username,
        string secret,
        int method = SMTP_AUTH_PLAIN,
        string authorizationId = "",
        bool initialResponse = true,
        bool allowPlaintext = false
    )
        self.method = method
        self.username = username
        self.secret = secret
        self.authorizationId = authorizationId
        self.initialResponse = initialResponse
        self.allowPlaintext = allowPlaintext
    end
end



// SmtpReply 是从 Client 借用响应复制出的稳定语言值。
export class SmtpReply
    int code
    string text

    create(int code, string text)
        self.code = code
        self.text = text
    end
end



// 检查 SMTP 创建结果并保留 XRT 的结构化失败原因。
func __xmail_smtp_handle(point handle) as point
    if handle == null then
        throw RuntimeError __xmail_error()
    end
    return handle
end



// 把原生响应文本副本转换为稳定字符串。
func __xmail_smtp_text(point handle) as string
    if handle == null then
        return ""
    end
    return Buffer(handle).text()
end



// SmtpClient 同时暴露原始命令、流式 DATA/BDAT 和常用消息提交路径。
export class SmtpClient
    native point handle
    extern "xmail_smtp_wrap" create(point handle)
    extern "xl6ForeignGraphDestroyV1" destroy()
    extern "xmail_smtp_state" get state() as c_longlong
    extern "xmail_smtp_capabilities" get capabilities() as c_ulonglong
    extern "xmail_smtp_size_limit" get sizeLimit() as c_ulonglong
    extern "xmail_smtp_security" get security() as c_longlong
    extern "xmail_smtp_authenticated" get authenticated() as bool
    extern "xmail_smtp_reply_code" func replyCodeNative() as c_longlong
    extern "xmail_smtp_reply_text" func replyTextNative() as point
    extern "xmail_smtp_send" func sendRaw(
        string line, c_size size, c_longlong timeoutMs) as bool
    extern "xmail_smtp_receive" func receiveRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_smtp_command" func commandRaw(
        string verb, c_size verbSize,
        string arguments, c_size argumentsSize,
        c_longlong timeoutMs) as bool
    extern "xmail_smtp_mail" func mailRaw(
        string path, c_size pathSize,
        string parameters, c_size parametersSize,
        c_longlong timeoutMs) as bool
    extern "xmail_smtp_rcpt" func rcptRaw(
        string path, c_size pathSize,
        string parameters, c_size parametersSize,
        c_longlong timeoutMs) as bool
    extern "xmail_smtp_data_begin" func dataBeginRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_smtp_data_write_text" func dataWriteTextRaw(
        string data, c_size size, c_longlong timeoutMs) as bool
    extern "xmail_smtp_data_write" func dataWriteBufferRaw(
        point data, c_size size, c_longlong timeoutMs) as bool
    extern "xmail_smtp_data_end" func dataEndRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_smtp_data" func dataRaw(
        string message, c_size size, c_longlong timeoutMs) as bool
    extern "xmail_smtp_bdat_begin" func bdatBeginRaw(
        c_ulonglong size, bool last, c_longlong timeoutMs) as bool
    extern "xmail_smtp_bdat_write" func bdatWriteRaw(
        point data, c_size size, c_longlong timeoutMs) as bool
    extern "xmail_smtp_bdat_end" func bdatEndRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_smtp_bdat" func bdatRaw(
        point data, c_size size, bool last,
        c_longlong timeoutMs) as bool
    extern "xmail_smtp_auth" func authRaw(
        c_ulonglong method,
        string username, c_size usernameSize,
        string secret, c_size secretSize,
        string authorizationId, c_size authorizationIdSize,
        bool initialResponse, bool allowPlaintext,
        c_longlong timeoutMs) as bool
    extern "xmail_smtp_submit" func submitRaw(
        var message, c_longlong timeoutMs) as bool
    extern "xmail_smtp_reset" func resetRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_smtp_noop" func noopRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_smtp_quit" func quitRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_smtp_close" func closeRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_smtp_abort" func abort() as bool

    static func open(NetEngine engine, SmtpConfig config) as SmtpClient
        var tlsConfig = null
        point created = __xmail_smtp_open(
            __xmail_engine_owner(engine),
            config.host, c_size(string.byteLen(config.host)),
            c_ulonglong(config.port), c_ulonglong(config.security),
            config.hello, c_size(string.byteLen(config.hello)),
            c_ulonglong(config.lineLimit), c_longlong(config.timeoutMs),
            tlsConfig, __xmail_post_owner(config.security))
        return SmtpClient(__xmail_smtp_own(__xmail_smtp_handle(created)))
    end

    static func open(
        NetEngine engine,
        TlsClientContext tlsConfig,
        SmtpConfig config
    ) as SmtpClient
        point created = __xmail_smtp_open(
            __xmail_engine_owner(engine),
            config.host, c_size(string.byteLen(config.host)),
            c_ulonglong(config.port), c_ulonglong(config.security),
            config.hello, c_size(string.byteLen(config.hello)),
            c_ulonglong(config.lineLimit), c_longlong(config.timeoutMs),
            __xmail_tls_owner(tlsConfig), __xmail_post_owner(config.security))
        return SmtpClient(__xmail_smtp_own(__xmail_smtp_handle(created)))
    end

    get valid() as bool
        return self.handle != null
    end

    func lastReply() as SmtpReply
        return SmtpReply(
            int(self.replyCodeNative()),
            __xmail_smtp_text(self.replyTextNative()))
    end

    func send(string line, int timeoutMs = 30000) as bool
        return self.sendRaw(line, c_size(string.byteLen(line)),
            c_longlong(timeoutMs))
    end

    func receive(int timeoutMs = 30000) as bool
        return self.receiveRaw(c_longlong(timeoutMs))
    end

    func command(
        string verb,
        string arguments = "",
        int timeoutMs = 30000
    ) as bool
        return self.commandRaw(
            verb, c_size(string.byteLen(verb)),
            arguments, c_size(string.byteLen(arguments)),
            c_longlong(timeoutMs))
    end

    func mailFrom(
        string path,
        string parameters = "",
        int timeoutMs = 30000
    ) as bool
        return self.mailRaw(
            path, c_size(string.byteLen(path)),
            parameters, c_size(string.byteLen(parameters)),
            c_longlong(timeoutMs))
    end

    func recipient(
        string path,
        string parameters = "",
        int timeoutMs = 30000
    ) as bool
        return self.rcptRaw(
            path, c_size(string.byteLen(path)),
            parameters, c_size(string.byteLen(parameters)),
            c_longlong(timeoutMs))
    end

    func dataBegin(int timeoutMs = 30000) as bool
        return self.dataBeginRaw(c_longlong(timeoutMs))
    end

    func dataWrite(string data, int timeoutMs = 30000) as bool
        return self.dataWriteTextRaw(
            data, c_size(string.byteLen(data)), c_longlong(timeoutMs))
    end

    func dataWrite(Buffer data, int timeoutMs = 30000) as bool
        return self.dataWriteBufferRaw(
            data.data(), c_size(data.len()), c_longlong(timeoutMs))
    end

    func dataEnd(int timeoutMs = 30000) as bool
        return self.dataEndRaw(c_longlong(timeoutMs))
    end

    func data(string message, int timeoutMs = 30000) as bool
        return self.dataRaw(message, c_size(string.byteLen(message)),
            c_longlong(timeoutMs))
    end

    func bdatBegin(
        int size,
        bool last = false,
        int timeoutMs = 30000
    ) as bool
        return self.bdatBeginRaw(c_ulonglong(size), last,
            c_longlong(timeoutMs))
    end

    func bdatWrite(Buffer data, int timeoutMs = 30000) as bool
        return self.bdatWriteRaw(data.data(), c_size(data.len()),
            c_longlong(timeoutMs))
    end

    func bdatEnd(int timeoutMs = 30000) as bool
        return self.bdatEndRaw(c_longlong(timeoutMs))
    end

    func bdat(
        Buffer data,
        bool last = false,
        int timeoutMs = 30000
    ) as bool
        return self.bdatRaw(data.data(), c_size(data.len()), last,
            c_longlong(timeoutMs))
    end

    func auth(SmtpAuth config, int timeoutMs = 30000) as bool
        return self.authRaw(
            c_ulonglong(config.method),
            config.username, c_size(string.byteLen(config.username)),
            config.secret, c_size(string.byteLen(config.secret)),
            config.authorizationId,
            c_size(string.byteLen(config.authorizationId)),
            config.initialResponse, config.allowPlaintext,
            c_longlong(timeoutMs))
    end

    func submit(var message, int timeoutMs = 30000) as bool
        return self.submitRaw(message, c_longlong(timeoutMs))
    end

    func reset(int timeoutMs = 30000) as bool
        return self.resetRaw(c_longlong(timeoutMs))
    end

    func noop(int timeoutMs = 30000) as bool
        return self.noopRaw(c_longlong(timeoutMs))
    end

    func quit(int timeoutMs = 30000) as bool
        return self.quitRaw(c_longlong(timeoutMs))
    end

    func close(int timeoutMs = 30000) as bool
        return self.closeRaw(c_longlong(timeoutMs))
    end
end



// Pop3Config 描述连接边界；默认读取 CAPA 以支持 STLS 和机制发现。
export class Pop3Config
    string host
    int port
    int security
    bool readCapabilities
    int lineLimit
    int timeoutMs

    create(
        string host,
        int port = 110,
        int security = SECURITY_PLAIN,
        bool readCapabilities = true,
        int timeoutMs = 30000,
        int lineLimit = 0
    )
        self.host = host
        self.port = port
        self.security = security
        self.readCapabilities = readCapabilities
        self.timeoutMs = timeoutMs
        self.lineLimit = lineLimit
    end
end



// Pop3Auth 只在认证调用期间借用凭据。
export class Pop3Auth
    int method
    string username
    string secret
    string authorizationId
    bool initialResponse
    bool allowPlaintext

    create(
        string username,
        string secret,
        int method = POP3_AUTH_USER_PASS,
        string authorizationId = "",
        bool initialResponse = true,
        bool allowPlaintext = false
    )
        self.method = method
        self.username = username
        self.secret = secret
        self.authorizationId = authorizationId
        self.initialResponse = initialResponse
        self.allowPlaintext = allowPlaintext
    end
end



// Pop3Reply 是最近状态行的稳定副本。
export class Pop3Reply
    bool ok
    string source
    string text

    create(bool ok, string source, string text)
        self.ok = ok
        self.source = source
        self.text = text
    end
end



// Pop3Stat 保存邮箱消息数和总字节数。
export class Pop3Stat
    int messages
    int bytes

    create(int messages, int bytes)
        self.messages = messages
        self.bytes = bytes
    end
end



// Pop3ListItem 保存一条 LIST 结果。
export class Pop3ListItem
    int message
    int bytes

    create(int message, int bytes)
        self.message = message
        self.bytes = bytes
    end
end



// Pop3UidlItem 保存一条 UIDL 结果。
export class Pop3UidlItem
    int message
    string id

    create(int message, string id)
        self.message = message
        self.id = id
    end
end



// Pop3Line 同时表达 ITEM、END 和 ERROR，不牺牲合法空行。
export class Pop3Line
    int state
    string line

    create(int state, string line)
        self.state = state
        self.line = line
    end
end



// 检查 POP3 创建结果并保留 XRT 的结构化错误。
func __xmail_pop3_handle(point handle) as point
    if handle == null then
        throw RuntimeError __xmail_error()
    end
    return handle
end



// 把 POP3 原生文本副本转换为稳定字符串。
func __xmail_pop3_text(point handle) as string
    if handle == null then
        return ""
    end
    return Buffer(handle).text()
end



// Pop3Client 保留低层命令和逐行多行读取，同时提供常用邮箱命令对象。
export class Pop3Client
    native point handle
    extern "xmail_pop3_wrap" create(point handle)
    extern "xl6ForeignGraphDestroyV1" destroy()
    extern "xmail_pop3_state" get state() as c_longlong
    extern "xmail_pop3_capabilities" get capabilities() as c_ulonglong
    extern "xmail_pop3_sasl" get saslMechanisms() as c_ulonglong
    extern "xmail_pop3_security" get security() as c_longlong
    extern "xmail_pop3_reply_ok" func replyOkNative() as bool
    extern "xmail_pop3_reply_text" func replyTextNative() as point
    extern "xmail_pop3_reply_source" func replySourceNative() as point
    extern "xmail_pop3_send" func sendRaw(
        string line, c_size size, c_longlong timeoutMs) as bool
    extern "xmail_pop3_line" func lineRaw(c_longlong timeoutMs) as bool
    extern "xmail_pop3_receive" func receiveRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_pop3_command" func commandRaw(
        string verb, c_size verbSize,
        string arguments, c_size argumentsSize,
        c_longlong timeoutMs) as bool
    extern "xmail_pop3_begin" func beginRaw(
        string verb, c_size verbSize,
        string arguments, c_size argumentsSize,
        c_longlong timeoutMs) as bool
    extern "xmail_pop3_next" func nextRaw(
        c_longlong timeoutMs) as c_longlong
    extern "xmail_pop3_last_line" func lastLineNative() as point
    extern "xmail_pop3_stat" func statRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_pop3_list" func listRaw(
        c_ulonglong message, c_longlong timeoutMs) as bool
    extern "xmail_pop3_uidl" func uidlRaw(
        c_ulonglong message, c_longlong timeoutMs) as bool
    extern "xmail_pop3_first" func firstNative() as c_ulonglong
    extern "xmail_pop3_second" func secondNative() as c_ulonglong
    extern "xmail_pop3_list_all" func listAllRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_pop3_uidl_all" func uidlAllRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_pop3_retr" func retrRaw(
        c_ulonglong message, c_longlong timeoutMs) as bool
    extern "xmail_pop3_top" func topRaw(
        c_ulonglong message, c_ulonglong lines,
        c_longlong timeoutMs) as bool
    extern "xmail_pop3_auth" func authRaw(
        c_ulonglong method,
        string username, c_size usernameSize,
        string secret, c_size secretSize,
        string authorizationId, c_size authorizationIdSize,
        bool initialResponse, bool allowPlaintext,
        c_longlong timeoutMs) as bool
    extern "xmail_pop3_delete" func deleteRaw(
        c_ulonglong message, c_longlong timeoutMs) as bool
    extern "xmail_pop3_reset" func resetRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_pop3_noop" func noopRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_pop3_quit" func quitRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_pop3_close" func closeRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_pop3_abort" func abort() as bool

    static func open(NetEngine engine, Pop3Config config) as Pop3Client
        var tlsConfig = null
        point created = __xmail_pop3_open(
            __xmail_engine_owner(engine),
            config.host, c_size(string.byteLen(config.host)),
            c_ulonglong(config.port), c_ulonglong(config.security),
            config.readCapabilities, c_ulonglong(config.lineLimit),
            c_longlong(config.timeoutMs), tlsConfig, __xmail_post_owner(config.security))
        return Pop3Client(__xmail_pop3_own(__xmail_pop3_handle(created)))
    end

    static func open(
        NetEngine engine,
        TlsClientContext tlsConfig,
        Pop3Config config
    ) as Pop3Client
        point created = __xmail_pop3_open(
            __xmail_engine_owner(engine),
            config.host, c_size(string.byteLen(config.host)),
            c_ulonglong(config.port), c_ulonglong(config.security),
            config.readCapabilities, c_ulonglong(config.lineLimit),
            c_longlong(config.timeoutMs), __xmail_tls_owner(tlsConfig), __xmail_post_owner(config.security))
        return Pop3Client(__xmail_pop3_own(__xmail_pop3_handle(created)))
    end

    get valid() as bool
        return self.handle != null
    end

    func lastReply() as Pop3Reply
        return Pop3Reply(
            self.replyOkNative(),
            __xmail_pop3_text(self.replySourceNative()),
            __xmail_pop3_text(self.replyTextNative()))
    end

    func send(string line, int timeoutMs = 30000) as bool
        return self.sendRaw(line, c_size(string.byteLen(line)),
            c_longlong(timeoutMs))
    end

    func line(int timeoutMs = 30000) as string
        if not self.lineRaw(c_longlong(timeoutMs)) then
            throw RuntimeError __xmail_error()
        end
        return __xmail_pop3_text(self.lastLineNative())
    end

    func receive(int timeoutMs = 30000) as bool
        return self.receiveRaw(c_longlong(timeoutMs))
    end

    func command(
        string verb,
        string arguments = "",
        int timeoutMs = 30000
    ) as bool
        return self.commandRaw(
            verb, c_size(string.byteLen(verb)),
            arguments, c_size(string.byteLen(arguments)),
            c_longlong(timeoutMs))
    end

    func begin(
        string verb,
        string arguments = "",
        int timeoutMs = 30000
    ) as bool
        return self.beginRaw(
            verb, c_size(string.byteLen(verb)),
            arguments, c_size(string.byteLen(arguments)),
            c_longlong(timeoutMs))
    end

    func next(int timeoutMs = 30000) as Pop3Line
        int state = int(self.nextRaw(c_longlong(timeoutMs)))
        string line = ""
        if state == POP3_NEXT_ITEM then
            line = __xmail_pop3_text(self.lastLineNative())
        end
        return Pop3Line(state, line)
    end

    func stat(int timeoutMs = 30000) as Pop3Stat
        if not self.statRaw(c_longlong(timeoutMs)) then
            throw RuntimeError __xmail_error()
        end
        return Pop3Stat(int(self.firstNative()), int(self.secondNative()))
    end

    func list(int message, int timeoutMs = 30000) as Pop3ListItem
        if not self.listRaw(c_ulonglong(message), c_longlong(timeoutMs)) then
            throw RuntimeError __xmail_error()
        end
        return Pop3ListItem(int(self.firstNative()), int(self.secondNative()))
    end

    func uidl(int message, int timeoutMs = 30000) as Pop3UidlItem
        if not self.uidlRaw(c_ulonglong(message), c_longlong(timeoutMs)) then
            throw RuntimeError __xmail_error()
        end
        return Pop3UidlItem(int(self.firstNative()),
            __xmail_pop3_text(self.lastLineNative()))
    end

    func listAll(int timeoutMs = 30000) as bool
        return self.listAllRaw(c_longlong(timeoutMs))
    end

    func uidlAll(int timeoutMs = 30000) as bool
        return self.uidlAllRaw(c_longlong(timeoutMs))
    end

    func retrieve(int message, int timeoutMs = 30000) as bool
        return self.retrRaw(c_ulonglong(message), c_longlong(timeoutMs))
    end

    func top(int message, int lines, int timeoutMs = 30000) as bool
        return self.topRaw(c_ulonglong(message), c_ulonglong(lines),
            c_longlong(timeoutMs))
    end

    func auth(Pop3Auth config, int timeoutMs = 30000) as bool
        return self.authRaw(
            c_ulonglong(config.method),
            config.username, c_size(string.byteLen(config.username)),
            config.secret, c_size(string.byteLen(config.secret)),
            config.authorizationId,
            c_size(string.byteLen(config.authorizationId)),
            config.initialResponse, config.allowPlaintext,
            c_longlong(timeoutMs))
    end

    func delete(int message, int timeoutMs = 30000) as bool
        return self.deleteRaw(c_ulonglong(message), c_longlong(timeoutMs))
    end

    func reset(int timeoutMs = 30000) as bool
        return self.resetRaw(c_longlong(timeoutMs))
    end

    func noop(int timeoutMs = 30000) as bool
        return self.noopRaw(c_longlong(timeoutMs))
    end

    func quit(int timeoutMs = 30000) as bool
        return self.quitRaw(c_longlong(timeoutMs))
    end

    func close(int timeoutMs = 30000) as bool
        return self.closeRaw(c_longlong(timeoutMs))
    end
end



// ImapConfig 保持连接、响应行和命令行预算显式可调。
export class ImapConfig
    string host
    int port
    int security
    int lineLimit
    int commandLineLimit
    int timeoutMs

    create(
        string host,
        int port = 143,
        int security = SECURITY_PLAIN,
        int timeoutMs = 30000,
        int lineLimit = 0,
        int commandLineLimit = 0
    )
        self.host = host
        self.port = port
        self.security = security
        self.timeoutMs = timeoutMs
        self.lineLimit = lineLimit
        self.commandLineLimit = commandLineLimit
    end
end



// ImapAuth 只在认证调用期间借用凭据。
export class ImapAuth
    int method
    string username
    string secret
    string authorizationId
    bool initialResponse
    bool allowPlaintext

    create(
        string username,
        string secret,
        int method = IMAP_AUTH_LOGIN,
        string authorizationId = "",
        bool initialResponse = true,
        bool allowPlaintext = false
    )
        self.method = method
        self.username = username
        self.secret = secret
        self.authorizationId = authorizationId
        self.initialResponse = initialResponse
        self.allowPlaintext = allowPlaintext
    end
end



// ImapResponse 是 greeting 或 tagged completion 的稳定副本。
export class ImapResponse
    string source
    string tag
    string text
    int kind
    int status

    create(string source, string tag, string text, int kind, int status)
        self.source = source
        self.tag = tag
        self.text = text
        self.kind = kind
        self.status = status
    end
end



// ImapEvent 表达响应、literal 描述和 Next 的 ITEM/END/ERROR 状态。
export class ImapEvent
    int nextState
    string source
    string tag
    string text
    int eventKind
    int responseKind
    int status
    bool hasLiteral
    int literalSize
    bool literalNonSynchronizing
    bool literalBinary

    create(
        int nextState,
        string source,
        string tag,
        string text,
        int eventKind,
        int responseKind,
        int status,
        bool hasLiteral,
        int literalSize,
        bool literalNonSynchronizing,
        bool literalBinary
    )
        self.nextState = nextState
        self.source = source
        self.tag = tag
        self.text = text
        self.eventKind = eventKind
        self.responseKind = responseKind
        self.status = status
        self.hasLiteral = hasLiteral
        self.literalSize = literalSize
        self.literalNonSynchronizing = literalNonSynchronizing
        self.literalBinary = literalBinary
    end
end



// ImapMailbox 保存 SELECT/EXAMINE 的零分配摘要。
export class ImapMailbox
    int exists
    int recent
    int unseen
    int uidValidity
    int uidNext
    int highestModSeq
    int present
    bool readOnly

    create(
        int exists,
        int recent,
        int unseen,
        int uidValidity,
        int uidNext,
        int highestModSeq,
        int present,
        bool readOnly
    )
        self.exists = exists
        self.recent = recent
        self.unseen = unseen
        self.uidValidity = uidValidity
        self.uidNext = uidNext
        self.highestModSeq = highestModSeq
        self.present = present
        self.readOnly = readOnly
    end
end



// 检查 IMAP 创建结果并保留 XRT 的结构化错误。
func __xmail_imap_handle(point handle) as point
    if handle == null then
        throw RuntimeError __xmail_error()
    end
    return handle
end



// 把 IMAP 原生文本副本转换为稳定字符串。
func __xmail_imap_text(point handle) as string
    if handle == null then
        return ""
    end
    return Buffer(handle).text()
end



// ImapClient 以事件和 literal 流为主，并保留显式 tag 原始命令路径。
export class ImapClient
    native point handle
    extern "xmail_imap_wrap" create(point handle)
    extern "xl6ForeignGraphDestroyV1" destroy()
    extern "xmail_imap_state" get state() as c_longlong
    extern "xmail_imap_capabilities" get capabilities() as c_ulonglong
    extern "xmail_imap_security" get security() as c_longlong
    extern "xmail_imap_literal_remaining" get literalRemaining() as c_ulonglong
    extern "xmail_imap_command_limit" get commandLimit() as c_ulonglong
    extern "xmail_imap_append_limit" get appendLimit() as c_ulonglong
    extern "xmail_imap_tag" func tagNative() as point
    extern "xmail_imap_last_response_text" func responseTextNative(
        c_longlong field) as point
    extern "xmail_imap_last_response_value" func responseValueNative(
        c_longlong field) as c_longlong
    extern "xmail_imap_send" func sendRaw(
        string tag, c_size tagSize,
        string command, c_size commandSize,
        string arguments, c_size argumentsSize,
        c_longlong timeoutMs) as bool
    extern "xmail_imap_write" func writeRaw(
        point data, c_size size, c_longlong timeoutMs) as bool
    extern "xmail_imap_continue" func continueRaw(
        string data, c_size size, c_longlong timeoutMs) as bool
    extern "xmail_imap_receive" func receiveRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_imap_begin" func beginRaw(
        string command, c_size commandSize,
        string arguments, c_size argumentsSize,
        c_longlong timeoutMs) as bool
    extern "xmail_imap_next" func nextRaw(
        c_longlong timeoutMs) as c_longlong
    extern "xmail_imap_event_value" func eventValueNative(
        c_longlong field) as c_longlong
    extern "xmail_imap_event_literal_size" func eventLiteralSizeNative() as c_ulonglong
    extern "xmail_imap_event_text" func eventTextNative(
        c_longlong field) as point
    extern "xmail_imap_read_literal" func readLiteralRaw(
        c_ulonglong maximum, c_longlong timeoutMs) as point
    extern "xmail_imap_auth" func authRaw(
        c_ulonglong method,
        string username, c_size usernameSize,
        string secret, c_size secretSize,
        string authorizationId, c_size authorizationIdSize,
        bool initialResponse, bool allowPlaintext,
        c_longlong timeoutMs) as bool
    extern "xmail_imap_simple" func simpleRaw(
        c_longlong operation, c_longlong timeoutMs) as bool
    extern "xmail_imap_select" func selectRaw(
        string mailbox, c_size size, bool readOnly,
        c_longlong timeoutMs) as bool
    extern "xmail_imap_mailbox_value" func mailboxValueNative(
        c_longlong field) as c_ulonglong
    extern "xmail_imap_logout" func logoutRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_imap_close" func closeRaw(
        c_longlong timeoutMs) as bool
    extern "xmail_imap_abort" func abort() as bool

    static func open(NetEngine engine, ImapConfig config) as ImapClient
        var tlsConfig = null
        point created = __xmail_imap_open(
            __xmail_engine_owner(engine),
            config.host, c_size(string.byteLen(config.host)),
            c_ulonglong(config.port), c_ulonglong(config.security),
            c_ulonglong(config.lineLimit),
            c_ulonglong(config.commandLineLimit),
            c_longlong(config.timeoutMs), tlsConfig, __xmail_post_owner(config.security))
        return ImapClient(__xmail_imap_own(__xmail_imap_handle(created)))
    end

    static func open(
        NetEngine engine,
        TlsClientContext tlsConfig,
        ImapConfig config
    ) as ImapClient
        point created = __xmail_imap_open(
            __xmail_engine_owner(engine),
            config.host, c_size(string.byteLen(config.host)),
            c_ulonglong(config.port), c_ulonglong(config.security),
            c_ulonglong(config.lineLimit),
            c_ulonglong(config.commandLineLimit),
            c_longlong(config.timeoutMs), __xmail_tls_owner(tlsConfig), __xmail_post_owner(config.security))
        return ImapClient(__xmail_imap_own(__xmail_imap_handle(created)))
    end

    get valid() as bool
        return self.handle != null
    end

    func tag() as string
        return __xmail_imap_text(self.tagNative())
    end

    func lastResponse() as ImapResponse
        return ImapResponse(
            __xmail_imap_text(self.responseTextNative(c_longlong(0))),
            __xmail_imap_text(self.responseTextNative(c_longlong(1))),
            __xmail_imap_text(self.responseTextNative(c_longlong(2))),
            int(self.responseValueNative(c_longlong(0))),
            int(self.responseValueNative(c_longlong(1))))
    end

    func lastEvent(int nextState = IMAP_NEXT_ITEM) as ImapEvent
        return ImapEvent(
            nextState,
            __xmail_imap_text(self.eventTextNative(c_longlong(0))),
            __xmail_imap_text(self.eventTextNative(c_longlong(1))),
            __xmail_imap_text(self.eventTextNative(c_longlong(2))),
            int(self.eventValueNative(c_longlong(0))),
            int(self.eventValueNative(c_longlong(1))),
            int(self.eventValueNative(c_longlong(2))),
            self.eventValueNative(c_longlong(3)) != 0,
            int(self.eventLiteralSizeNative()),
            self.eventValueNative(c_longlong(4)) != 0,
            self.eventValueNative(c_longlong(5)) != 0)
    end

    func send(
        string tag,
        string command,
        string arguments = "",
        int timeoutMs = 30000
    ) as bool
        return self.sendRaw(
            tag, c_size(string.byteLen(tag)),
            command, c_size(string.byteLen(command)),
            arguments, c_size(string.byteLen(arguments)),
            c_longlong(timeoutMs))
    end

    func write(Buffer data, int timeoutMs = 30000) as bool
        return self.writeRaw(data.data(), c_size(data.len()),
            c_longlong(timeoutMs))
    end

    func sendContinuation(string data, int timeoutMs = 30000) as bool
        return self.continueRaw(data, c_size(string.byteLen(data)),
            c_longlong(timeoutMs))
    end

    func receive(int timeoutMs = 30000) as ImapEvent
        if not self.receiveRaw(c_longlong(timeoutMs)) then
            throw RuntimeError __xmail_error()
        end
        return self.lastEvent()
    end

    func begin(
        string command,
        string arguments = "",
        int timeoutMs = 30000
    ) as bool
        return self.beginRaw(
            command, c_size(string.byteLen(command)),
            arguments, c_size(string.byteLen(arguments)),
            c_longlong(timeoutMs))
    end

    func next(int timeoutMs = 30000) as ImapEvent
        int state = int(self.nextRaw(c_longlong(timeoutMs)))
        if state == IMAP_NEXT_ITEM then
            return self.lastEvent(state)
        end
        return ImapEvent(state, "", "", "", 0, 0, 0,
            false, 0, false, false)
    end

    func readLiteral(
        int maximum = 65536,
        int timeoutMs = 30000
    ) as Buffer
        point result = self.readLiteralRaw(
            c_ulonglong(maximum), c_longlong(timeoutMs))
        if result == null then
            throw RuntimeError __xmail_error()
        end
        return Buffer(result)
    end

    func auth(ImapAuth config, int timeoutMs = 30000) as bool
        return self.authRaw(
            c_ulonglong(config.method),
            config.username, c_size(string.byteLen(config.username)),
            config.secret, c_size(string.byteLen(config.secret)),
            config.authorizationId,
            c_size(string.byteLen(config.authorizationId)),
            config.initialResponse, config.allowPlaintext,
            c_longlong(timeoutMs))
    end

    func refresh(int timeoutMs = 30000) as bool
        return self.simpleRaw(c_longlong(0), c_longlong(timeoutMs))
    end

    func noop(int timeoutMs = 30000) as bool
        return self.simpleRaw(c_longlong(1), c_longlong(timeoutMs))
    end

    func check(int timeoutMs = 30000) as bool
        return self.simpleRaw(c_longlong(2), c_longlong(timeoutMs))
    end

    func unselect(int timeoutMs = 30000) as bool
        return self.simpleRaw(c_longlong(3), c_longlong(timeoutMs))
    end

    func closeMailbox(int timeoutMs = 30000) as bool
        return self.simpleRaw(c_longlong(4), c_longlong(timeoutMs))
    end

    func beginIdle(int timeoutMs = 30000) as bool
        return self.simpleRaw(c_longlong(5), c_longlong(timeoutMs))
    end

    func endIdle(int timeoutMs = 30000) as bool
        return self.simpleRaw(c_longlong(6), c_longlong(timeoutMs))
    end

    func select(
        string mailbox,
        bool readOnly = false,
        int timeoutMs = 30000
    ) as ImapMailbox
        if not self.selectRaw(
            mailbox, c_size(string.byteLen(mailbox)), readOnly,
            c_longlong(timeoutMs)) then
            throw RuntimeError __xmail_error()
        end
        return ImapMailbox(
            int(self.mailboxValueNative(c_longlong(0))),
            int(self.mailboxValueNative(c_longlong(1))),
            int(self.mailboxValueNative(c_longlong(2))),
            int(self.mailboxValueNative(c_longlong(3))),
            int(self.mailboxValueNative(c_longlong(4))),
            int(self.mailboxValueNative(c_longlong(5))),
            int(self.mailboxValueNative(c_longlong(6))),
            self.mailboxValueNative(c_longlong(7)) != 0)
    end

    func logout(int timeoutMs = 30000) as bool
        return self.logoutRaw(c_longlong(timeoutMs))
    end

    func close(int timeoutMs = 30000) as bool
        return self.closeRaw(c_longlong(timeoutMs))
    end
end

extern "xmail_smtp_raw_destroy" func __xmail_smtp_release(point raw)
extern "xmail_smtp_manage" func __xmail_smtp_manage(point raw,var releaser) as point
func __xmail_smtp_drop(point raw)
    __xmail_smtp_release(raw)
end
func __xmail_smtp_own(point raw) as point
    bool accepted = false
    point result = null
    try
        result = __xmail_smtp_manage(raw,xcall(__xmail_smtp_drop))
        accepted = result != null
    finally
        if !accepted then __xmail_smtp_release(raw) end
    end
    return result
end

extern "xmail_pop3_raw_destroy" func __xmail_pop3_release(point raw)
extern "xmail_pop3_manage" func __xmail_pop3_manage(point raw,var releaser) as point
func __xmail_pop3_drop(point raw)
    __xmail_pop3_release(raw)
end
func __xmail_pop3_own(point raw) as point
    bool accepted = false
    point result = null
    try
        result = __xmail_pop3_manage(raw,xcall(__xmail_pop3_drop))
        accepted = result != null
    finally
        if !accepted then __xmail_pop3_release(raw) end
    end
    return result
end

extern "xmail_imap_raw_destroy" func __xmail_imap_release(point raw)
extern "xmail_imap_manage" func __xmail_imap_manage(point raw,var releaser) as point
func __xmail_imap_drop(point raw)
    __xmail_imap_release(raw)
end
func __xmail_imap_own(point raw) as point
    bool accepted = false
    point result = null
    try
        result = __xmail_imap_manage(raw,xcall(__xmail_imap_drop))
        accepted = result != null
    finally
        if !accepted then __xmail_imap_release(raw) end
    end
    return result
end

extern "xmail_post_destroy" func __xmail_post_release(point raw)
func __xmail_post_drop(point raw)
    __xmail_post_release(raw)
end
func __xmail_post_owner(int security) as var
    if security == SECURITY_STARTTLS then return xcall(__xmail_post_drop) end
    return null
end
