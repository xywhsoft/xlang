#include "../src/platform/app_resources.h"
#include "xide_version.h"

XIDE_RESOURCE_APP_ICON ICON "xlang_ide.ico"

1 VERSIONINFO
FILEVERSION XIDE_VERSION_RESOURCE
PRODUCTVERSION XIDE_VERSION_RESOURCE
FILEOS 0x40004
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "xlang IDE"
            VALUE "FileVersion", XIDE_VERSION
            VALUE "ProductName", "xlang"
            VALUE "ProductVersion", XIDE_VERSION
            VALUE "CompanyName", "xLeaves (xywhsoft)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
