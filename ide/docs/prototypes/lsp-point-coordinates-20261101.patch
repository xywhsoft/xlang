+/* Independent flat scalar walk: compare every byte, including invalid UTF-8
+ * and CRLF interior offsets, against both indexed coordinate entry points. */
+static int positionsText(xls_text* text)
+{
+    CHECK(text);
+    const char* source=xlsTextData(text);
+    size_t size=xlsTextSize(text),at=0,line=1,column=1,units=0;
+    CHECK(xlsTextStorageBytes(text)>0 && xlsTextStorageBytes(text)<=32*size+1024);
+    for(;;){
+        xls_position a={SIZE_MAX,SIZE_MAX},b=a;
+        CHECK(xlsTextPosition(text,at,&a) && a.line==line-1 && a.character==units);
+        CHECK(xlsTextSourcePosition(text,at,line,column,&b) && b.line==a.line && b.character==a.character);
+        b=(xls_position){SIZE_MAX,SIZE_MAX};
+        CHECK(!xlsTextSourcePosition(text,at,line,column+1,&b) && b.line==SIZE_MAX && b.character==SIZE_MAX);
+        CHECK(!xlsTextSourcePosition(text,at,line+1,column,&b) && b.line==SIZE_MAX && b.character==SIZE_MAX);
+        if(line>1)CHECK(!xlsTextSourcePosition(text,at,line-1,column,&b) && b.line==SIZE_MAX && b.character==SIZE_MAX);
+        CHECK(!xlsTextSourcePosition(text,at,0,column,&b));
+        CHECK(!xlsTextSourcePosition(text,at,line,0,&b));
+        if(at==size)break;
+        unsigned char c=(unsigned char)source[at];
+        size_t width=c<128 ? 1 : c<224 ? 2 : c<240 ? 3 : 4;
+        if(c=='\r' && source[at+1]=='\n')width=2;
+        for(size_t i=1;i<width;++i){
+            CHECK(!xlsTextPosition(text,at+i,&b));
+            CHECK(!xlsTextSourcePosition(text,at+i,line,column,&b));
+        }
+        if(c=='\r' || c=='\n'){++line;column=1;units=0;}
+        else{++column;units+=width==4 ? 2 : 1;}
+        at+=width;
+    }
+    CHECK(!xlsTextSourcePosition(text,SIZE_MAX,1,1,&(xls_position){0}));
+    CHECK(!xlsTextSourcePosition(text,size+1,line,column,&(xls_position){0}));
+    CHECK(!xlsTextSourcePosition(text,0,SIZE_MAX,1,&(xls_position){0}));
+    CHECK(!xlsTextSourcePosition(text,0,1,SIZE_MAX,&(xls_position){0}));
+    CHECK(!xlsTextSourcePosition(text,0,1,1,NULL));
+    CHECK(!xlsTextSourcePosition(NULL,0,1,1,&(xls_position){0}));
+    return 0;
+}
+static int positions(const char* source)
+{
+    size_t size=strlen(source);
+    xls_text* text=xlsTextCreate(source,size,size,NULL);
+    int result=positionsText(text);xlsTextRelease(text);return result;
+}
