int xlsRawBodyFeatureSpelling(const char* text)
{
    if(!text || !*text)return 0;
    size_t low=0,high=sizeof(rawFeatureNames)/sizeof(*rawFeatureNames);
    while(low<high){size_t mid=low+(high-low)/2;int c=strcmp(text,rawFeatureNames[mid]);if(!c)return 1;if(c<0)high=mid;else low=mid+1;}
    return 0;
}
