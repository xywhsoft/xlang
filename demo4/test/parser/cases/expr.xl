// xlang v4 语法分析测试 - 表达式
// 测试各种表达式的解析

// 算术表达式
1 + 2 * 3
(1 + 2) * 3
2 ** 3
-5
10 % 3

// 比较表达式
1 < 2
a == b
x != null
a >= 10
b <= 100

// 逻辑表达式
a and b
a or b
not a

// 位运算表达式
a & b
a | b
a ^ b
!a
a << 2
a >> 3

// 成员访问
obj.prop
obj?.prop

// 索引访问
arr[0]
arr[i + 1]

// 函数调用
print("hello")
add(1, 2)
max(a, b, c)

// 三元表达式
a > b ? a : b

// 空值合并
a ?? b

// 赋值
a = 1
a += 2
a -= 3
a *= 4
a /= 5
a %= 6
a **= 2

// 自增自减
a++
++a
a--
--a

// 链式调用
obj.method1().method2()
arr[0].name
