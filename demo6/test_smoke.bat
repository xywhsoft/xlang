@echo off
setlocal
cd /d %~dp0

call tools\xl6_toolchain_env.bat
if errorlevel 1 exit /b 1

call build.bat
if errorlevel 1 exit /b 1

if not exist release mkdir release
if not exist release\tmp mkdir release\tmp

echo Running DEMO6 smoke tests...

powershell -NoProfile -ExecutionPolicy Bypass -File tools\check_docs_index.ps1
if errorlevel 1 exit /b 1

powershell -NoProfile -ExecutionPolicy Bypass -File tools\check_source_wiring.ps1
if errorlevel 1 exit /b 1

powershell -NoProfile -ExecutionPolicy Bypass -File tools\check_tool_wiring.ps1
if errorlevel 1 exit /b 1

release\xl.exe lex examples\hello.xl --emit release\tmp\smoke_hello.tokens.txt
if errorlevel 1 exit /b 1
findstr /C:"KW_FUNC" release\tmp\smoke_hello.tokens.txt >nul
if errorlevel 1 (
    echo smoke_hello.tokens.txt missing lexer output.
    exit /b 1
)

release\xl.exe parse examples\hello.xl --emit release\tmp\smoke_hello.ast.txt
if errorlevel 1 exit /b 1
findstr /C:"add" release\tmp\smoke_hello.ast.txt >nul
if errorlevel 1 (
    echo smoke_hello.ast.txt missing parse output.
    exit /b 1
)

release\xl.exe check examples\hello.xl
if errorlevel 1 exit /b 1
release\xl.exe check examples\hello.xl --json > release\tmp\smoke_hello.check.json
if errorlevel 1 exit /b 1
findstr /C:"diagnostics" release\tmp\smoke_hello.check.json >nul
if errorlevel 1 (
    echo smoke_hello.check.json missing diagnostics field.
    exit /b 1
)

release\xl.exe cgen examples\hello.xl --emit release\tmp\smoke_hello.c
if errorlevel 1 exit /b 1
findstr /C:"Generated by xlang DEMO6 cgen." release\tmp\smoke_hello.c >nul
if errorlevel 1 (
    echo smoke_hello.c missing cgen banner.
    exit /b 1
)

release\xl.exe abi examples\c_export.xl --emit release\tmp\smoke_c_export.abi.txt
if errorlevel 1 exit /b 1
findstr /C:"export app_add_i64" release\tmp\smoke_c_export.abi.txt >nul
if errorlevel 1 (
    echo smoke_c_export.abi.txt missing export ABI.
    exit /b 1
)

release\xl.exe xapi examples\hello.xl --emit release\tmp\smoke_hello.xapi.json
if errorlevel 1 exit /b 1
findstr /C:"xlang-xapi-1" release\tmp\smoke_hello.xapi.json >nul
if errorlevel 1 (
    echo smoke_hello.xapi.json missing XAPI format marker.
    exit /b 1
)

release\xl.exe check test\cases\import_metadata.xl
if errorlevel 1 exit /b 1

release\xl.exe run examples\containers.xl %XL6_XL_DEFAULT_LINK_ARGS%
if errorlevel 1 exit /b 1

release\xl.exe run examples\stdlib_string.xl %XL6_XL_DEFAULT_LINK_ARGS%
if errorlevel 1 exit /b 1

echo DEMO6 smoke tests ok.
exit /b 0
