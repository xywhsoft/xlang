async func addAsync(int a, int b) as int
    return a + b
end

async func slowAddAsync(int a, int b) as int
    time.sleep(120)
    return a + b
end

async func touchAsync()
    int marker = 1
    assert marker == 1, "async void body failed"
end

async func failAsync() as int
    throw "task async boom"
    return 0
end

func addPlain(int a, int b) as int
    return a + b
end

func slowAddPlain(int a, int b) as int
    time.sleep(120)
    return a + b
end

func failPlain() as int
    throw "task spawn boom"
    return 0
end

func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

class AsyncBox
    func(int) as int op
    int bias = 0
end

func makeBox(int base) as AsyncBox
    AsyncBox box
    box.op = makeAdder(base)
    box.bias = base
    return box
end

async func makeBoxAsync(int base) as AsyncBox
    AsyncBox box = makeBox(base)
    return box
end

async func makeAdderAsync(int base) as func(int) as int
    return makeAdder(base)
end

async func makeVarAsync(int value) as var
    return value
end

async func asyncNumbers(int base) as generator<int>
    int first = await addAsync(base, 1)
    yield first
    yield await addAsync(first, 2)
end

func asyncNumbersAlias(int base) as async generator<int>
    int first = await addAsync(base, 3)
    yield first
    yield await addAsync(first, 4)
end

func brokenAsyncNumbers() as async generator<int>
    yield await addAsync(0, 1)
    throw "async generator boom"
    yield 2
end

func emptyAsyncNumbers() as async generator<int>
    int guard = await addAsync(1, 1)
    if guard == 0 then
        yield guard
    end
end

func numbers(int count) as generator<int>
    int i = 0
    while i < count do
        i = i + 1
        yield i
    end
end

func toggles() as generator<bool>
    yield true
    yield false
end

func weights() as generator<float>
    yield 1.5
    yield 2.5
end

func clocks() as generator<time>
    yield #12:34:56#
end

func brokenNumbers() as generator<int>
    yield 1
    throw "generator boom"
    yield 2
end

func brokenNumbersEarly() as generator<int>
    throw "generator boom before yield"
    yield 1
end

func emptyNumbers() as generator<int>
    int marker = 1
    if marker == 0 then
        yield marker
    end
end

func worker() as int
    return 7
end

func() as int missingThreadWorker

future<int> futureValue = addAsync(20, 22)
int answer = await futureValue
assert answer == 42, "async/await failed"

auto autoFuture = addAsync(4, 6)
auto autoAnswer = await autoFuture
assert autoAnswer == 10, "auto await failed"

auto voidFuture = touchAsync()
await voidFuture

future<AsyncBox> boxFuture = makeBoxAsync(30)
AsyncBox box = await boxFuture
assert box.op(12) + box.bias == 72, "await class func field failed"

future<func(int) as int> fnFuture = makeAdderAsync(50)
func(int) as int fnA = await fnFuture
func(int) as int fnB = await fnFuture
assert fnA(1) == 51, "await func result failed"
assert fnB(2) == 52, "second await func result failed"

future<AsyncBox> sharedBoxFuture = makeBoxAsync(70)
AsyncBox firstBox = await sharedBoxFuture
AsyncBox secondBox = await sharedBoxFuture
assert firstBox.op(3) + firstBox.bias == 143, "first repeated await class result failed"
assert secondBox.op(4) + secondBox.bias == 144, "second repeated await class result failed"

auto autoBoxFuture = makeBoxAsync(90)
auto autoBox = await autoBoxFuture
assert autoBox.op(5) + autoBox.bias == 185, "auto await class result failed"

int temporaryValue = await addAsync(8, 9)
assert temporaryValue == 17, "temporary await int result failed"

await touchAsync()

func(int) as int temporaryFn = await makeAdderAsync(60)
assert temporaryFn(4) == 64, "temporary await func result failed"

AsyncBox temporaryBox = await makeBoxAsync(110)
assert temporaryBox.op(6) + temporaryBox.bias == 226, "temporary await class result failed"

future<var> varFuture = makeVarAsync(120)
var awaitedVar = await varFuture
assert int(awaitedVar) == 120, "await var result failed"

var temporaryVar = await makeVarAsync(130)
assert int(temporaryVar) == 130, "temporary await var result failed"

future<array<int>> allFuture = task.all([addAsync(1, 2), addAsync(3, 4)])
array<int> allValuesA = await allFuture
array<int> allValuesB = await allFuture
assert allValuesA.length == 2, "task.all length failed"
assert allValuesA[0] == 3, "task.all first result failed"
assert allValuesA[1] == 7, "task.all second result failed"
assert allValuesB[0] == 3 and allValuesB[1] == 7, "task.all repeated await failed"
assert not task.cancel(allFuture), "completed task.all future should not cancel"
array<int> allValuesAfterCancel = await allFuture
assert allValuesAfterCancel[1] == 7, "completed task.all future should remain awaitable"

future<int> raceFuture = task.race([addAsync(5, 6), addAsync(7, 8)])
int raceValueA = await raceFuture
int raceValueB = await raceFuture
assert raceValueA == 11 or raceValueA == 15, "task.race result failed"
assert raceValueB == raceValueA, "task.race repeated await failed"
assert not task.cancel(raceFuture), "completed task.race future should not cancel"
int raceValueAfterCancel = await raceFuture
assert raceValueAfterCancel == raceValueA, "completed task.race future should remain awaitable"

func(int, int) as int addTask = addPlain
future<int> spawnFuture = task.spawn(addTask, 20, 22)
int spawnValueA = await spawnFuture
int spawnValueB = await spawnFuture
assert spawnValueA == 42, "task.spawn result failed"
assert spawnValueB == 42, "task.spawn repeated await failed"
assert not task.cancel(spawnFuture), "completed task.spawn future should not cancel"
int spawnValueAfterCancel = await spawnFuture
assert spawnValueAfterCancel == 42, "completed task.spawn future should remain awaitable"

int failedAllState = 0
try
    array<int> failedAll = await task.all([failAsync()])
    failedAllState = failedAll.length
catch e
    if e.message == "task async boom" then
        failedAllState = 1
    end
end
assert failedAllState == 1, "task.all should propagate async error"

future<int> failedRaceFuture = task.race([failAsync()])
int failedRaceState = 0
try
    int failedRace = await failedRaceFuture
    failedRaceState = failedRace
catch e
    if e.message == "task async boom" then
        failedRaceState = 1
    end
end
assert failedRaceState == 1, "task.race should propagate async error"
assert not task.cancel(failedRaceFuture), "completed failed task.race future should not cancel"
try
    int failedRaceAgain = await failedRaceFuture
    failedRaceState = failedRaceAgain
catch e
    if e.message == "task async boom" then
        failedRaceState = 2
    end
end
assert failedRaceState == 2, "failed task.race future should keep error"

func() as int failTask = failPlain
future<int> failedSpawnFuture = task.spawn(failTask)
int failedSpawnState = 0
try
    int failedSpawn = await failedSpawnFuture
    failedSpawnState = failedSpawn
catch e
    if e.message == "task spawn boom" then
        failedSpawnState = 1
    end
end
assert failedSpawnState == 1, "task.spawn should propagate worker error"
assert not task.cancel(failedSpawnFuture), "completed failed task.spawn future should not cancel"
try
    int failedSpawnAgain = await failedSpawnFuture
    failedSpawnState = failedSpawnAgain
catch e
    if e.message == "task spawn boom" then
        failedSpawnState = 2
    end
end
assert failedSpawnState == 2, "failed task.spawn future should keep error"

future<int> pendingAsyncCancel = slowAddAsync(30, 12)
assert task.cancel(pendingAsyncCancel), "pending async future should cancel"
int pendingAsyncCancelState = 0
try
    int pendingAsyncCancelValue = await pendingAsyncCancel
    pendingAsyncCancelState = pendingAsyncCancelValue
catch e
    if e.message == "future cancel requested." then
        pendingAsyncCancelState = 1
    end
end
assert pendingAsyncCancelState == 1, "pending async future should await as canceled"
time.sleep(160)
try
    int pendingAsyncCancelLateValue = await pendingAsyncCancel
    pendingAsyncCancelState = pendingAsyncCancelLateValue
catch e
    if e.message == "future cancel requested." then
        pendingAsyncCancelState = 2
    end
end
assert pendingAsyncCancelState == 2, "pending async worker completion should not overwrite cancel"

func(int, int) as int slowAddTask = slowAddPlain
future<int> pendingSpawnCancel = task.spawn(slowAddTask, 40, 2)
assert task.cancel(pendingSpawnCancel), "pending task.spawn future should cancel"
int pendingSpawnCancelState = 0
try
    int pendingSpawnCancelValue = await pendingSpawnCancel
    pendingSpawnCancelState = pendingSpawnCancelValue
catch e
    if e.message == "future cancel requested." then
        pendingSpawnCancelState = 1
    end
end
assert pendingSpawnCancelState == 1, "pending task.spawn future should await as canceled"
time.sleep(160)
try
    int pendingSpawnCancelLateValue = await pendingSpawnCancel
    pendingSpawnCancelState = pendingSpawnCancelLateValue
catch e
    if e.message == "future cancel requested." then
        pendingSpawnCancelState = 2
    end
end
assert pendingSpawnCancelState == 2, "pending task.spawn worker completion should not overwrite cancel"

future<int> raceWinner = addAsync(90, 1)
future<int> raceLoser = slowAddAsync(100, 1)
int raceCancelValue = await task.race([raceWinner, raceLoser])
assert raceCancelValue == 91, "task.race should return fast winner"

int raceLoserCancelState = 0
try
    int raceLoserValue = await raceLoser
    raceLoserCancelState = raceLoserValue
catch e
    if e.message == "future cancel requested." then
        raceLoserCancelState = 1
    end
end
assert raceLoserCancelState == 1, "task.race should cancel losing future"
int raceWinnerStillAvailable = await raceWinner
assert raceWinnerStillAvailable == 91, "task.race winner should remain awaitable"

future<int> multiRaceWinner = addAsync(120, 1)
future<int> multiRaceLoserA = slowAddAsync(130, 1)
future<int> multiRaceLoserB = slowAddAsync(140, 1)
int multiRaceValue = await task.race([multiRaceWinner, multiRaceLoserA, multiRaceLoserB])
assert multiRaceValue == 121, "task.race should return three-way fast winner"

int multiRaceLoserAState = 0
try
    int multiRaceLoserAValue = await multiRaceLoserA
    multiRaceLoserAState = multiRaceLoserAValue
catch e
    if e.message == "future cancel requested." then
        multiRaceLoserAState = 1
    end
end
assert multiRaceLoserAState == 1, "task.race should cancel first loser"

int multiRaceLoserBState = 0
try
    int multiRaceLoserBValue = await multiRaceLoserB
    multiRaceLoserBState = multiRaceLoserBValue
catch e
    if e.message == "future cancel requested." then
        multiRaceLoserBState = 1
    end
end
assert multiRaceLoserBState == 1, "task.race should cancel second loser"

array<int> allOrderValues = await task.all([slowAddAsync(150, 1), addAsync(160, 2)])
assert allOrderValues.length == 2, "task.all input order length failed"
assert allOrderValues[0] == 151, "task.all should keep slow first result"
assert allOrderValues[1] == 162, "task.all should keep fast second result"

future<int> cancelAllLeft = slowAddAsync(200, 1)
future<int> cancelAllRight = slowAddAsync(210, 2)
future<array<int>> cancelAllGroup = task.all([cancelAllLeft, cancelAllRight])
assert task.cancel(cancelAllGroup), "pending task.all group should cancel"

int cancelAllGroupState = 0
try
    array<int> cancelAllValues = await cancelAllGroup
    cancelAllGroupState = cancelAllValues.length
catch e
    if e.message == "future cancel requested." then
        cancelAllGroupState = 1
    end
end
assert cancelAllGroupState == 1, "canceled task.all group should await as canceled"

int cancelAllLeftState = 0
try
    int cancelAllLeftValue = await cancelAllLeft
    cancelAllLeftState = cancelAllLeftValue
catch e
    if e.message == "future cancel requested." then
        cancelAllLeftState = 1
    end
end
assert cancelAllLeftState == 1, "task.all cancel should cancel left source"
time.sleep(160)

int cancelAllRightState = 0
try
    int cancelAllRightValue = await cancelAllRight
    cancelAllRightState = cancelAllRightValue
catch e
    if e.message == "future cancel requested." then
        cancelAllRightState = 1
    end
end
assert cancelAllRightState == 1, "task.all cancel should keep right source canceled"

int asyncGeneratorTotal = 0
for await value in asyncNumbers(10)
    asyncGeneratorTotal = asyncGeneratorTotal + value
end
assert asyncGeneratorTotal == 24, "async generator total failed"

int asyncGeneratorAliasTotal = 0
for await value in asyncNumbersAlias(20)
    asyncGeneratorAliasTotal = asyncGeneratorAliasTotal + value
end
assert asyncGeneratorAliasTotal == 50, "async generator alias total failed"

int asyncGeneratorErrorState = 0
try
    for await value in brokenAsyncNumbers()
        asyncGeneratorErrorState = asyncGeneratorErrorState + value
    end
    asyncGeneratorErrorState = 100
catch e
    if e.message == "async generator boom" then
        asyncGeneratorErrorState = asyncGeneratorErrorState + 10
    end
end
assert asyncGeneratorErrorState == 11, "async generator error propagation failed"

int emptyAsyncGeneratorCount = 0
for await value in emptyAsyncNumbers()
    emptyAsyncGeneratorCount = emptyAsyncGeneratorCount + 1
end
assert emptyAsyncGeneratorCount == 0, "empty async generator failed"

int total = 0
for value in numbers(4)
    total = total + value
end
assert total == 10, "generator for-in failed"

int trueCount = 0
for flag in toggles()
    if flag then
        trueCount = trueCount + 1
    end
end
assert trueCount == 1, "bool generator failed"

float weightTotal = 0.0
for weight in weights()
    weightTotal = weightTotal + weight
end
assert weightTotal == 4.0, "float generator failed"

time clockValue = #00:00:00#
for clock in clocks()
    clockValue = clock
end
assert clockValue == #12:34:56#, "time generator failed"

int generatorErrorState = 0
try
    for value in brokenNumbers()
        generatorErrorState = generatorErrorState + value
    end
    generatorErrorState = 100
catch e
    if e.message == "generator boom" then
        generatorErrorState = generatorErrorState + 10
    end
end
assert generatorErrorState == 11, "generator error propagation failed"

int generatorEarlyErrorState = 0
try
    for value in brokenNumbersEarly()
        generatorEarlyErrorState = generatorEarlyErrorState + value
    end
    generatorEarlyErrorState = 100
catch e
    if e.message == "generator boom before yield" then
        generatorEarlyErrorState = 42
    end
end
assert generatorEarlyErrorState == 42, "generator early error propagation failed"

int emptyGeneratorCount = 0
for value in emptyNumbers()
    emptyGeneratorCount = emptyGeneratorCount + 1
end
assert emptyGeneratorCount == 0, "empty generator failed"

channel<int> ch = channel::<int>(2)
assert ch.send(123), "channel send failed"
int received = 0
assert ch.recvInto(received), "channel recv failed"
assert received == 123, "channel value failed"
assert ch.count() == 0, "channel count failed"
ch.close()
assert ch.isClosed(), "channel close failed"

int missingThreadState = 0
try
    thread missingThread = thread(missingThreadWorker)
    missingThreadState = missingThread.exitCode()
catch e
    if e.message == "thread requires a callable func value" then
        missingThreadState = 1
    end
end
assert missingThreadState == 1, "thread empty func value"

thread t = thread(worker)
assert t.wait(), "thread wait failed"
assert t.exitCode() == 7, "thread exit code failed"

int base = 5
auto capturedWorker = func() as int
    return base + 2
end
thread captured = thread(capturedWorker)
assert captured.wait(), "thread captured wait failed"
assert captured.exitCode() == 7, "thread captured exit code failed"

mutex m = mutex()
assert m.lock(), "mutex lock failed"
assert m.unlock(), "mutex unlock failed"
assert m.tryLock(), "mutex tryLock failed"
assert m.unlock(), "mutex tryUnlock failed"

sem gate = sem(0, 2)
assert gate.post(), "sem post failed"
assert gate.waitTimeout(10), "sem waitTimeout failed"
assert not gate.tryWait(), "sem empty tryWait failed"

cond c = cond()
assert c.signal(), "cond signal failed"
assert c.broadcast(), "cond broadcast failed"
mutex condMutex = mutex()
assert condMutex.lock(), "cond waitTimeout mutex lock failed"
assert not c.waitTimeout(condMutex, 1), "cond waitTimeout should time out"
assert condMutex.unlock(), "cond waitTimeout mutex unlock failed"

rwlock rw = rwlock()
assert rw.readLock(), "rwlock readLock failed"
assert rw.readUnlock(), "rwlock readUnlock failed"
assert rw.tryReadLock(), "rwlock tryReadLock failed"
assert rw.readUnlock(), "rwlock tryReadUnlock failed"
assert rw.writeLock(), "rwlock writeLock failed"
assert rw.downgrade(), "rwlock downgrade failed"
assert rw.readUnlock(), "rwlock downgraded unlock failed"
