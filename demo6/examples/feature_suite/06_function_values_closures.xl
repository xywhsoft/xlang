extern "expect_i64" func expect(int actual, int expected)

func add(int left, int right) -> int
    return left + right
end

// function 是一等公民类型，可以保存函数签名。
function(int, int) -> int binary = add
expect(binary(20, 22), 42)

// bare function 类型用于只表达“任意函数值”。
function anyFunction = binary
var boxedAny = anyFunction
expect(int(boxedAny(1, 2)), 3)

// 匿名函数：箭头写法。
auto inc = func(int value) -> int => value + 1
expect(inc(41), 42)

// 匿名函数：块写法。
auto twice = func(int value) -> int
    return value * 2
end
expect(twice(21), 42)

// 捕获外部变量的闭包。
func makeAdder(int base) -> function(int) -> int
    return func(int value) -> int
        return base + value
    end
end

function(int) -> int add40 = makeAdder(40)
expect(add40(2), 42)

// 函数值作为参数与返回值。
func callBinary(function(int, int) -> int fn, int left, int right) -> int
    return fn(left, right)
end

func selectAdder() -> function(int, int) -> int
    return add
end

expect(callBinary(binary, 1, 2), 3)
function(int, int) -> int selected = selectAdder()
expect(selected(30, 12), 42)

// 多返回值 function 签名。
func pair(int seed) -> (int, int)
    return seed, seed + 1
end

function(int) -> (int, int) pairFn = pair
auto left, right = pairFn(10)
expect(left, 10)
expect(right, 11)

// 可变参数 function 签名。
func count(int base, ...) -> int
    return base + arg.length
end

function(int, ...) -> int counter = count
expect(counter(10, 1, 2, 3), 13)

// 字典可变参数 function 签名。
func optionCount(string path, ***) -> int
    return path == "demo.txt" ? arg.length : 0
end

function(string, ***) -> int optionFn = optionCount
expect(optionFn("demo.txt", mode = "fast", retry = 3), 2)

// function 可进入 var 并动态调用。
var boxedBinary = binary
var dynamicResult = boxedBinary(20, 22)
expect(int(dynamicResult), 42)

// function 可进入静态泛型容器。
array<function(int, int) -> int> funcs = array[binary]
function(int, int) -> int first = funcs[0]
expect(first(5, 6), 11)
