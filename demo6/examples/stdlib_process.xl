string text = process.exec("cmd /c echo hello-process")
int okCode = process.exitCode("cmd /c exit /b 0")
int failCode = process.exitCode("cmd /c exit /b 5")

assert string.trim(text) == "hello-process", "process exec failed"
assert process.success("cmd /c exit /b 0"), "process success failed"
assert !process.success("cmd /c exit /b 5"), "process failure check failed"
assert okCode == 0, "process exitCode zero failed"
assert failCode == 5, "process exitCode nonzero failed"
