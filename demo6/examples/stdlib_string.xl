string title = "XLang DEMO6"

int bytes = string.len(title)
int titleOrder = string.compare(title, "xlang demo6", true)
bool hasLang = string.contains(title, "lang", true)
int demoPos = string.indexOf(title, "DEMO")
bool startsWithX = string.startsWith(title, "xlang", true)
bool endsWith6 = string.endsWith(title, "6")
bool hasSeparator = string.hasAny(title, " -_")
bool markdown = string.like("readme.md", "*.md")
bool same = string.equals(title, "xlang demo6", true)
bool approximate = string.approx("xlang", "xlang")
float similarity = string.sim(title, "XLang DEMO6")
bool utf8 = string.isUtf8("中文 UTF-8")
string groupedNumber = string.formatInt(1234567, ",")
string paddedNumber = string.formatInt(42, "04")
string roundedNumber = string.formatFloat(12.345, ".2")
string percentNumber = string.formatFloat(0.125, ".1%")
string lowerTitle = string.lower(title)
string upperTitle = string.upper(title)
string trimmed = string.trim("  xlang  ")
string leftTrimmed = string.ltrim("  xlang  ")
string rightTrimmed = string.rtrim("  xlang  ")
string customTrimmed = string.trim("--xlang--", "-")
string filtered = string.filter("x-lang-demo", "-")
string replaced = string.replace("a-b-c", "-", "/")
array parts = string.split("x-lang-demo", "-")
int partCount = parts.length
string firstPart = string(parts[0])

auto bytesText = bytes.toString()
auto titleOrderText = titleOrder.toString()
auto hasLangText = hasLang.toString()
auto demoPosText = demoPos.toString()
auto startsWithXText = startsWithX.toString()
auto endsWith6Text = endsWith6.toString()
auto hasSeparatorText = hasSeparator.toString()
auto markdownText = markdown.toString()
auto sameText = same.toString()
auto approximateText = approximate.toString()
auto similarityText = similarity.toString()
auto utf8Text = utf8.toString()
auto groupedNumberText = groupedNumber.toString()
auto paddedNumberText = paddedNumber.toString()
auto roundedNumberText = roundedNumber.toString()
auto percentNumberText = percentNumber.toString()
auto lowerText = lowerTitle.toString()
auto upperText = upperTitle.toString()
auto trimmedText = trimmed.toString()
auto leftTrimmedText = leftTrimmed.toString()
auto rightTrimmedText = rightTrimmed.toString()
auto customTrimmedText = customTrimmed.toString()
auto filteredText = filtered.toString()
auto replacedText = replaced.toString()
auto partCountText = partCount.toString()
auto firstPartText = firstPart.toString()
