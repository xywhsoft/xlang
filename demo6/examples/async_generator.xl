async func loadScore(int base, int bonus) as int
    return base + bonus
end

async func scoreStream(int base) as generator<int>
    int first = await loadScore(base, 1)
    yield first
    yield await loadScore(first, 2)
end

func scoreStreamAlias(int base) as async generator<int>
    int first = await loadScore(base, 3)
    yield first
    yield await loadScore(first, 4)
end

func brokenScores() as async generator<int>
    yield await loadScore(0, 1)
    throw "saved async generator boom"
end

func brokenEarlyScores() as async generator<int>
    int guard = await loadScore(1, 1)
    if guard == 2 then
        throw "saved async generator early boom"
    end
    yield guard
end

func emptyScores() as async generator<int>
    int guard = await loadScore(1, 1)
    if guard == 0 then
        yield guard
    end
end

func indexedScores() as async generator<int>
    yield await loadScore(0, 10)
    yield await loadScore(0, 20)
    yield await loadScore(0, 30)
end

func returnEarlyScores() as async generator<int>
    yield await loadScore(0, 5)
    return
    yield await loadScore(0, 50)
end

func returnBeforeYieldScores() as async generator<int>
    return
    yield await loadScore(0, 60)
end

func plainScores() as generator<int>
    yield 7
    yield 8
end

func plainReturnEarlyScores() as generator<int>
    yield 5
    return
    yield 50
end

func plainReturnBeforeYieldScores() as generator<int>
    return
    yield 60
end

int total = 0
for await score in scoreStream(10)
    total = total + score
end

assert total == 24, "scoreStream failed"

int aliasTotal = 0
for await score in scoreStreamAlias(20)
    aliasTotal = aliasTotal + score
end

assert aliasTotal == 50, "scoreStreamAlias failed"

generator<int> savedScores = scoreStream(30)
int savedTotal = 0
for await score in savedScores
    savedTotal = savedTotal + score
end

assert savedTotal == 64, "saved async generator failed"

generator<int> savedBrokenScores = brokenScores()
int savedErrorState = 0
try
    for await score in savedBrokenScores
        savedErrorState = savedErrorState + score
    end
    savedErrorState = 100
catch e
    if e.message == "saved async generator boom" then
        savedErrorState = savedErrorState + 10
    end
end

assert savedErrorState == 11, "saved async generator error failed"

generator<int> savedBrokenEarlyScores = brokenEarlyScores()
int savedEarlyErrorState = 0
try
    for await score in savedBrokenEarlyScores
        savedEarlyErrorState = savedEarlyErrorState + score
    end
    savedEarlyErrorState = 100
catch e
    if e.message == "saved async generator early boom" then
        savedEarlyErrorState = 42
    end
end

assert savedEarlyErrorState == 42, "saved async generator early error failed"

generator<int> savedEmptyScores = emptyScores()
int savedEmptyCount = 0
for await score in savedEmptyScores
    savedEmptyCount = savedEmptyCount + 1
end

assert savedEmptyCount == 0, "saved empty async generator failed"

generator<int> savedIndexedScores = indexedScores()
int savedBreakTotal = 0
for await index, score in savedIndexedScores
    savedBreakTotal = savedBreakTotal + index * 100 + score
    if index == 1 then
        break
    end
end

assert savedBreakTotal == 130, "saved async generator break failed"

int savedBreakAgainState = 0
try
    for await score in savedIndexedScores
        savedBreakAgainState = savedBreakAgainState + score
    end
    savedBreakAgainState = 100
catch e
    if e.message == "iterate null generator" then
        savedBreakAgainState = 42
    end
end

assert savedBreakAgainState == 42, "saved async generator break second pass failed"

generator<int> savedIndexedContinueScores = indexedScores()
int savedContinueTotal = 0
for await index, score in savedIndexedContinueScores
    if index == 1 then
        continue
    end
    savedContinueTotal = savedContinueTotal + index * 100 + score
    if index == 2 then
        break
    end
end

assert savedContinueTotal == 240, "saved async generator continue failed"

int savedContinueAgainState = 0
try
    for await score in savedIndexedContinueScores
        savedContinueAgainState = savedContinueAgainState + score
    end
    savedContinueAgainState = 100
catch e
    if e.message == "iterate null generator" then
        savedContinueAgainState = 42
    end
end

assert savedContinueAgainState == 42, "saved async generator continue second pass failed"

generator<int> savedReturnEarlyScores = returnEarlyScores()
int savedReturnEarlyCount = 0
int savedReturnEarlyTotal = 0
for await score in savedReturnEarlyScores
    savedReturnEarlyCount = savedReturnEarlyCount + 1
    savedReturnEarlyTotal = savedReturnEarlyTotal + score
end

assert savedReturnEarlyCount == 1, "saved async generator return count failed"
assert savedReturnEarlyTotal == 5, "saved async generator return value failed"

int savedReturnEarlyAgainState = 0
try
    for await score in savedReturnEarlyScores
        savedReturnEarlyAgainState = savedReturnEarlyAgainState + score
    end
    savedReturnEarlyAgainState = 100
catch e
    if e.message == "iterate null generator" then
        savedReturnEarlyAgainState = 42
    end
end

assert savedReturnEarlyAgainState == 42, "saved async generator return second pass failed"

generator<int> savedReturnBeforeYieldScores = returnBeforeYieldScores()
int savedReturnBeforeYieldCount = 0
int savedReturnBeforeYieldTotal = 0
for await score in savedReturnBeforeYieldScores
    savedReturnBeforeYieldCount = savedReturnBeforeYieldCount + 1
    savedReturnBeforeYieldTotal = savedReturnBeforeYieldTotal + score
end

assert savedReturnBeforeYieldCount == 0, "saved async generator pre-yield return count failed"
assert savedReturnBeforeYieldTotal == 0, "saved async generator pre-yield return total failed"

int savedReturnBeforeYieldAgainState = 0
try
    for await score in savedReturnBeforeYieldScores
        savedReturnBeforeYieldAgainState = savedReturnBeforeYieldAgainState + score
    end
    savedReturnBeforeYieldAgainState = 100
catch e
    if e.message == "iterate null generator" then
        savedReturnBeforeYieldAgainState = 42
    end
end

assert savedReturnBeforeYieldAgainState == 42, "saved async generator pre-yield return second pass failed"

