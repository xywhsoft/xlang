generator<int> singleUseScores = scoreStream(40)
int singleUseTotal = 0
for await score in singleUseScores
    singleUseTotal = singleUseTotal + score
end

assert singleUseTotal == 84, "single-use async generator first pass failed"

int singleUseState = 0
try
    for await score in singleUseScores
        singleUseState = singleUseState + score
    end
    singleUseState = 100
catch e
    if e.message == "iterate null generator" then
        singleUseState = 42
    end
end

assert singleUseState == 42, "single-use async generator second pass failed"

println("async generator ok")
