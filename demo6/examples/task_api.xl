assert cancelTemporaryBoolAll == true or cancelTemporaryBoolAll == false, "task.cancel bool task.all"
bool cancelTemporaryBoolRace = task.cancel(task.race([flipAsync(true), flipAsync(false)]))
assert cancelTemporaryBoolRace == true or cancelTemporaryBoolRace == false, "task.cancel bool task.race"
array<future<bool>> cancelBoolAllJobs = array[flipAsync(true), flipAsync(false)]
bool cancelTypedBoolAll = task.cancel(task.all(cancelBoolAllJobs))
assert cancelTypedBoolAll == true or cancelTypedBoolAll == false, "task.cancel typed bool task.all"
array<future<bool>> cancelBoolRaceJobs = array[flipAsync(true), flipAsync(false)]
bool cancelTypedBoolRace = task.cancel(task.race(cancelBoolRaceJobs))
assert cancelTypedBoolRace == true or cancelTypedBoolRace == false, "task.cancel typed bool task.race"
bool cancelTemporaryFloatAll = task.cancel(task.all([addHalfAsync(9.5), addHalfAsync(10.5)]))
assert cancelTemporaryFloatAll == true or cancelTemporaryFloatAll == false, "task.cancel float task.all"
bool cancelTemporaryFloatRace = task.cancel(task.race([addHalfAsync(11.5), addHalfAsync(12.5)]))
assert cancelTemporaryFloatRace == true or cancelTemporaryFloatRace == false, "task.cancel float task.race"
array<future<float>> cancelFloatAllJobs = array[addHalfAsync(13.5), addHalfAsync(14.5)]
bool cancelTypedFloatAll = task.cancel(task.all(cancelFloatAllJobs))
assert cancelTypedFloatAll == true or cancelTypedFloatAll == false, "task.cancel typed float task.all"
array<future<float>> cancelFloatRaceJobs = array[addHalfAsync(15.5), addHalfAsync(16.5)]
bool cancelTypedFloatRace = task.cancel(task.race(cancelFloatRaceJobs))
assert cancelTypedFloatRace == true or cancelTypedFloatRace == false, "task.cancel typed float task.race"

future<int> completedTarget = addAsync(2, 3)
int completed = await completedTarget
assert completed == 5, "completed future result"
assert not task.cancel(completedTarget), "completed future cancel result"

async func failAsync() as int
    throw "task boom"
    return 0
end

async func failStringAsync() as string
    throw "task string boom"
    return ""
end

async func failBoolAsync() as bool
    throw "task bool boom"
    return false
end

async func failFloatAsync() as float
    throw "task float boom"
    return 0.0
end

int errorState = 0
try
    array<int> failed = await task.all([failAsync()])
    errorState = failed.length
catch e
    if e.message == "task boom" then
        errorState = 1
    end
end

assert errorState == 1, "task error propagation"

future<int> allFailureSlowSource = slowRaceAsync(909)
future<array<int>> allFailureGroup = task.all([failAsync(), allFailureSlowSource])
int allFailureGroupState = 0
try
    array<int> allFailureValues = await allFailureGroup
    allFailureGroupState = allFailureValues.length
catch e
    if e.message == "task boom" then
        allFailureGroupState = 1
    end
end
assert allFailureGroupState == 1, "task.all should report first failure after sources finish"
int allFailureSlowValue = await allFailureSlowSource
assert allFailureSlowValue == 909, "task.all failure should keep slow source awaitable"

future<array<int>> repeatedFailedAll = task.all([failAsync()])
int repeatedAllErrorA = 0
try
    array<int> repeatedAllA = await repeatedFailedAll
    repeatedAllErrorA = repeatedAllA.length
catch e
    if e.message == "task boom" then
        repeatedAllErrorA = 1
    end
end
assert repeatedAllErrorA == 1, "task.all failed future first await"

int repeatedAllErrorB = 0
try
    array<int> repeatedAllB = await repeatedFailedAll
    repeatedAllErrorB = repeatedAllB.length
catch e
    if e.message == "task boom" then
        repeatedAllErrorB = 1
    end
end
assert repeatedAllErrorB == 1, "task.all failed future repeated await"

assert not task.cancel(repeatedFailedAll), "task.all failed future cancel result"
int postCancelFailedAllError = 0
try
    array<int> postCancelFailedAll = await repeatedFailedAll
    postCancelFailedAllError = postCancelFailedAll.length
catch e
    if e.message == "task boom" then
        postCancelFailedAllError = 1
    end
end
assert postCancelFailedAllError == 1, "task.all failed future should keep error after cancel"

