func(int, ...) as int variadicJob = sumVariadic
int variadicSpawned = await task.spawn(variadicJob, 10, 1, 2, 3)
assert variadicSpawned == 16, "task.spawn array vararg result"
int variadicEmptySpawned = await task.spawn(variadicJob, 10)
assert variadicEmptySpawned == 10, "task.spawn empty array vararg result"

func(...) as int variadicDefaultJob = totalDefault
int variadicDefaultEmptySpawned = await task.spawn(variadicDefaultJob)
assert variadicDefaultEmptySpawned == 5, "task.spawn zero-argument vararg adapter result"
int variadicDefaultExtraSpawned = await task.spawn(variadicDefaultJob, "a", "b")
assert variadicDefaultExtraSpawned == 7, "task.spawn vararg adapter extra result"

future<int> spawnAllA = task.spawn(addJob, 10, 11)
future<int> spawnAllB = task.spawn(defaultJob, 20)
array<int> spawnAllValues = await task.all([spawnAllA, spawnAllB])
assert spawnAllValues.length == 2, "task.all task.spawn count"
assert spawnAllValues[0] == 21, "task.all task.spawn first"
assert spawnAllValues[1] == 21, "task.all task.spawn second"

int spawnRaced = await task.race([task.spawn(addJob, 2, 3), task.spawn(defaultJob, 8)])
assert spawnRaced == 5 or spawnRaced == 9, "task.race task.spawn result"

future<int> raceWinner = fastRaceAsync(77)
future<int> raceLoser = slowRaceAsync(88)
int raceValue = await task.race([raceWinner, raceLoser])
assert raceValue == 77, "task.race winner result"

int loserState = 0
try
    int loserValue = await raceLoser
    loserState = loserValue
catch e
    if e.message == "future cancel requested." then
        loserState = 1
    end
end
assert loserState == 1, "task.race should cancel losing future"
int winnerAgain = await raceWinner
assert winnerAgain == 77, "task.race winner should remain awaitable"
time.sleep(160)

future<int> cancelAllLeft = slowRaceAsync(201)
future<int> cancelAllRight = slowRaceAsync(202)
future<array<int>> cancelAllGroup = task.all([cancelAllLeft, cancelAllRight])
assert task.cancel(cancelAllGroup), "task.cancel should cancel pending task.all group"

int cancelAllSourceState = 0
try
    int cancelAllLeftValue = await cancelAllLeft
    cancelAllSourceState = cancelAllLeftValue
catch e
    if e.message == "future cancel requested." then
        cancelAllSourceState = 1
    end
end
assert cancelAllSourceState == 1, "task.cancel task.all should cancel sources"

future<int> cancelRaceLeft = slowRaceAsync(301)
future<int> cancelRaceRight = slowRaceAsync(302)
future<int> cancelRaceGroup = task.race([cancelRaceLeft, cancelRaceRight])
assert task.cancel(cancelRaceGroup), "task.cancel should cancel pending task.race group"

int cancelRaceSourceState = 0
try
    int cancelRaceRightValue = await cancelRaceRight
    cancelRaceSourceState = cancelRaceRightValue
catch e
    if e.message == "future cancel requested." then
        cancelRaceSourceState = 1
    end
end
assert cancelRaceSourceState == 1, "task.cancel task.race should cancel sources"
