async func addAsync(int a, int b) as int
    return a + b
end

async func greetAsync(string name) as string
    return "hello " + name
end

async func slowGreetAsync(string name) as string
    time.sleep(120)
    return "hello " + name
end

async func slowFlipAsync(bool flag) as bool
    time.sleep(120)
    return not flag
end

async func slowHalfAsync(float value) as float
    time.sleep(120)
    return value + 0.5
end

async func flipAsync(bool flag) as bool
    return not flag
end

async func addHalfAsync(float value) as float
    return value + 0.5
end

async func fastRaceAsync(int value) as int
    return value
end

async func slowRaceAsync(int value) as int
    time.sleep(120)
    return value
end

func greet(string name) as string
    return "hello " + name
end

func slowGreet(string name) as string
    time.sleep(120)
    return "hello " + name
end

func flip(bool flag) as bool
    return not flag
end

func slowFlip(bool flag) as bool
    time.sleep(120)
    return not flag
end

func addHalf(float value) as float
    return value + 0.5
end

func slowAddHalf(float value) as float
    time.sleep(120)
    return value + 0.5
end

func add(int a, int b) as int
    return a + b
end

func slowAdd(int a, int b) as int
    time.sleep(120)
    return a + b
end

func addDefault(int a, int b = 1) as int
    return a + b
end

func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

func fortyTwo() as int
    return 42
end

func sumVariadic(int base, ...) as int
    int total = base
    int i = 0
    while i < arg.length do
        total = total + int(arg[i])
        i = i + 1
    end
    return total
end

func totalDefault(int base = 5, ...) as int
    return base + arg.length
end

func failJob() as int
    throw "task spawn boom"
    return 0
end

func failStringJob() as string
    throw "task spawn string boom"
    return ""
end

func failBoolJob() as bool
    throw "task spawn bool boom"
    return false
end

func failFloatJob() as float
    throw "task spawn float boom"
    return 0.0
end

func() as int zeroJob = fortyTwo
int zeroSpawned = await task.spawn(zeroJob)
assert zeroSpawned == 42, "task.spawn zero-argument result"

func(int, int) as int addJob = add
int spawned = await task.spawn(addJob, 20, 22)
assert spawned == 42, "task.spawn result"
future<int> namedSpawnFuture = task.spawn(addJob, 21, 21)
int namedSpawnA = await namedSpawnFuture
int namedSpawnB = await namedSpawnFuture
assert namedSpawnA == 42, "task.spawn int future first await"
assert namedSpawnB == 42, "task.spawn int future repeated await"
assert not task.cancel(namedSpawnFuture), "completed int task.spawn future cancel result"
int postCancelNamedSpawn = await namedSpawnFuture
assert postCancelNamedSpawn == 42, "post-cancel task.spawn int result"

func(int, int) as int slowAddJob = slowAdd
future<int> pendingSpawnFuture = task.spawn(slowAddJob, 40, 2)
assert task.cancel(pendingSpawnFuture), "pending task.spawn future cancel result"

int pendingSpawnState = 0
try
    int pendingSpawnValue = await pendingSpawnFuture
    pendingSpawnState = pendingSpawnValue
catch e
    if e.message == "future cancel requested." then
        pendingSpawnState = 1
    end
end
assert pendingSpawnState == 1, "pending task.spawn future should await as canceled"

time.sleep(180)

int pendingSpawnStillCanceled = 0
try
    int pendingSpawnLateValue = await pendingSpawnFuture
    pendingSpawnStillCanceled = pendingSpawnLateValue
catch e
    if e.message == "future cancel requested." then
        pendingSpawnStillCanceled = 1
    end
end
assert pendingSpawnStillCanceled == 1, "task.spawn late worker completion should not overwrite cancel"

future<int> pendingSpawnAllLeft = task.spawn(slowAddJob, 50, 1)
future<int> pendingSpawnAllRight = task.spawn(slowAddJob, 60, 2)
future<array<int>> pendingSpawnAllGroup = task.all([pendingSpawnAllLeft, pendingSpawnAllRight])
assert task.cancel(pendingSpawnAllGroup), "pending task.all over task.spawn cancel result"

int pendingSpawnAllSourceState = 0
try
    int pendingSpawnAllLeftValue = await pendingSpawnAllLeft
    pendingSpawnAllSourceState = pendingSpawnAllLeftValue
catch e
    if e.message == "future cancel requested." then
        pendingSpawnAllSourceState = 1
    end
end
assert pendingSpawnAllSourceState == 1, "pending task.all should cancel task.spawn source"

future<int> pendingSpawnRaceLeft = task.spawn(slowAddJob, 70, 3)
future<int> pendingSpawnRaceRight = task.spawn(slowAddJob, 80, 4)
future<int> pendingSpawnRaceGroup = task.race([pendingSpawnRaceLeft, pendingSpawnRaceRight])
assert task.cancel(pendingSpawnRaceGroup), "pending task.race over task.spawn cancel result"

int pendingSpawnRaceSourceState = 0
try
    int pendingSpawnRaceRightValue = await pendingSpawnRaceRight
    pendingSpawnRaceSourceState = pendingSpawnRaceRightValue
catch e
    if e.message == "future cancel requested." then
        pendingSpawnRaceSourceState = 1
    end
end
assert pendingSpawnRaceSourceState == 1, "pending task.race should cancel task.spawn source"
time.sleep(180)

func(int) as int defaultJob = addDefault
int defaultSpawned = await task.spawn(defaultJob, 41)
assert defaultSpawned == 42, "task.spawn default argument result"

func(int) as int missingJob
int missingJobState = 0
try
    int missingJobValue = await task.spawn(missingJob, 1)
    missingJobState = missingJobValue
catch e
    if e.message == "task.spawn requires a callable func value" then
        missingJobState = 1
    end
end
assert missingJobState == 1, "task.spawn empty func value"

func(string) as string missingStringJob
int missingStringJobState = 0
try
    string missingStringJobValue = await task.spawn(missingStringJob, "x")
    missingStringJobState = 9
catch e
    if e.message == "task.spawn requires a callable func value" then
        missingStringJobState = 1
    end
end
assert missingStringJobState == 1, "task.spawn empty string func value"

func(bool) as bool missingBoolJob
int missingBoolJobState = 0
try
    bool missingBoolJobValue = await task.spawn(missingBoolJob, true)
    missingBoolJobState = int(missingBoolJobValue)
catch e
    if e.message == "task.spawn requires a callable func value" then
        missingBoolJobState = 1
    end
end
assert missingBoolJobState == 1, "task.spawn empty bool func value"

func(float) as float missingFloatJob
int missingFloatJobState = 0
try
    float missingFloatJobValue = await task.spawn(missingFloatJob, 1.5)
    missingFloatJobState = int(missingFloatJobValue)
catch e
    if e.message == "task.spawn requires a callable func value" then
        missingFloatJobState = 1
    end
end
assert missingFloatJobState == 1, "task.spawn empty float func value"

func(int) as int capturedJob = makeAdder(30)
int captured = await task.spawn(capturedJob, 12)
assert captured == 42, "task.spawn closure result"

func(string) as string greetJob = greet
future<string> namedGreetFuture = task.spawn(greetJob, "spawn")
string namedGreetA = await namedGreetFuture
string namedGreetB = await namedGreetFuture
assert namedGreetA == "hello spawn", "task.spawn string future first await"
assert namedGreetB == "hello spawn", "task.spawn string future repeated await"
assert not task.cancel(namedGreetFuture), "completed string task.spawn future cancel result"
string postCancelNamedGreet = await namedGreetFuture
assert postCancelNamedGreet == "hello spawn", "post-cancel task.spawn string result"

