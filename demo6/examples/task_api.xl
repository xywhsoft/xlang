future<int> one = addAsync(1, 2)
future<int> two = addAsync(3, 4)

array<int> all = await task.all([one, two])
assert all.length == 2, "task.all count"
assert all[0] == 3, "task.all first"
assert all[1] == 7, "task.all second"

future<array<int>> namedAllFuture = task.all([addAsync(10, 1), addAsync(20, 2)])
array<int> namedAllA = await namedAllFuture
array<int> namedAllB = await namedAllFuture
assert namedAllA[0] == 11, "named task.all first await"
assert namedAllB[1] == 22, "named task.all second await"
assert not task.cancel(namedAllFuture), "completed task.all future cancel result"
array<int> postCancelNamedAll = await namedAllFuture
assert postCancelNamedAll[0] == 11, "post-cancel task.all first"
assert postCancelNamedAll[1] == 22, "post-cancel task.all second"

int raced = await task.race([addAsync(10, 1), addAsync(20, 2)])
assert raced == 11 or raced == 22, "task.race result"

future<int> namedRaceFuture = task.race([addAsync(12, 0)])
int namedRaceValue = await namedRaceFuture
assert namedRaceValue == 12, "named task.race int result"
assert not task.cancel(namedRaceFuture), "completed task.race future cancel result"
int postCancelNamedRaceValue = await namedRaceFuture
assert postCancelNamedRaceValue == 12, "post-cancel task.race int result"

array<string> stringAll = await task.all([greetAsync("alpha"), greetAsync("beta")])
assert stringAll.length == 2, "task.all string count"
assert stringAll[0] == "hello alpha", "task.all string first"
assert stringAll[1] == "hello beta", "task.all string second"

future<array<string>> namedStringAllFuture = task.all([greetAsync("left"), greetAsync("right")])
array<string> namedStringAllA = await namedStringAllFuture
array<string> namedStringAllB = await namedStringAllFuture
assert namedStringAllA[0] == "hello left", "named task.all string first await"
assert namedStringAllB[1] == "hello right", "named task.all string second await"
assert not task.cancel(namedStringAllFuture), "completed string task.all future cancel result"
array<string> postCancelNamedStringAll = await namedStringAllFuture
assert postCancelNamedStringAll[0] == "hello left", "post-cancel string task.all first"
assert postCancelNamedStringAll[1] == "hello right", "post-cancel string task.all second"

array<future<string>> typedStringAllJobs = array[greetAsync("typed-left"), greetAsync("typed-right")]
array<string> typedStringAll = await task.all(typedStringAllJobs)
assert typedStringAll[0] == "hello typed-left", "task.all typed string first"
assert typedStringAll[1] == "hello typed-right", "task.all typed string second"

string stringRace = await task.race([greetAsync("gamma")])
assert stringRace == "hello gamma", "task.race string result"

future<string> namedStringRaceFuture = task.race([greetAsync("delta")])
string namedStringRaceValue = await namedStringRaceFuture
assert namedStringRaceValue == "hello delta", "named task.race string result"
assert not task.cancel(namedStringRaceFuture), "completed string task.race future cancel result"
string postCancelNamedStringRaceValue = await namedStringRaceFuture
assert postCancelNamedStringRaceValue == "hello delta", "post-cancel string task.race result"

array<future<string>> stringRaceJobs = array[greetAsync("typed-race-string")]
string typedStringRace = await task.race(stringRaceJobs)
assert typedStringRace == "hello typed-race-string", "task.race typed string array result"

