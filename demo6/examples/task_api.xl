array<string> spawnStringAll = await task.all([task.spawn(greetJob, "all-left"), task.spawn(greetJob, "all-right")])
assert spawnStringAll.length == 2, "task.all string task.spawn count"
assert spawnStringAll[0] == "hello all-left", "task.all string task.spawn first"
assert spawnStringAll[1] == "hello all-right", "task.all string task.spawn second"

string spawnStringRace = await task.race([task.spawn(greetJob, "race-string")])
assert spawnStringRace == "hello race-string", "task.race string task.spawn result"

array<future<string>> spawnStringAllJobs = array[task.spawn(greetJob, "typed-all-left"), task.spawn(greetJob, "typed-all-right")]
array<string> spawnStringTypedAll = await task.all(spawnStringAllJobs)
assert spawnStringTypedAll.length == 2, "task.all typed string task.spawn count"
assert spawnStringTypedAll[0] == "hello typed-all-left", "task.all typed string task.spawn first"
assert spawnStringTypedAll[1] == "hello typed-all-right", "task.all typed string task.spawn second"

array<future<string>> spawnStringRaceJobs = array[task.spawn(greetJob, "typed-race-string")]
string spawnStringTypedRace = await task.race(spawnStringRaceJobs)
assert spawnStringTypedRace == "hello typed-race-string", "task.race typed string task.spawn result"

array<future<string>> cancelSpawnStringAllJobs = array[task.spawn(greetJob, "cancel-all-left"), task.spawn(greetJob, "cancel-all-right")]
bool cancelSpawnStringTypedAll = task.cancel(task.all(cancelSpawnStringAllJobs))
assert cancelSpawnStringTypedAll == true or cancelSpawnStringTypedAll == false, "task.cancel typed string task.all task.spawn"

array<future<string>> cancelSpawnStringRaceJobs = array[task.spawn(greetJob, "cancel-race-string")]
bool cancelSpawnStringTypedRace = task.cancel(task.race(cancelSpawnStringRaceJobs))
assert cancelSpawnStringTypedRace == true or cancelSpawnStringTypedRace == false, "task.cancel typed string task.race task.spawn"

array<bool> spawnBoolAll = await task.all([task.spawn(flipJob, true), task.spawn(flipJob, false)])
assert spawnBoolAll.length == 2, "task.all bool task.spawn count"
assert spawnBoolAll[0] == false, "task.all bool task.spawn first"
assert spawnBoolAll[1] == true, "task.all bool task.spawn second"

bool spawnBoolRace = await task.race([task.spawn(flipJob, true)])
assert spawnBoolRace == false, "task.race bool task.spawn result"

array<future<bool>> spawnBoolAllJobs = array[task.spawn(flipJob, true), task.spawn(flipJob, false)]
array<bool> spawnBoolTypedAll = await task.all(spawnBoolAllJobs)
assert spawnBoolTypedAll.length == 2, "task.all typed bool task.spawn count"
assert spawnBoolTypedAll[0] == false, "task.all typed bool task.spawn first"
assert spawnBoolTypedAll[1] == true, "task.all typed bool task.spawn second"

array<future<bool>> spawnBoolRaceJobs = array[task.spawn(flipJob, true)]
bool spawnBoolTypedRace = await task.race(spawnBoolRaceJobs)
assert spawnBoolTypedRace == false, "task.race typed bool task.spawn result"

array<future<bool>> cancelSpawnBoolAllJobs = array[task.spawn(flipJob, true), task.spawn(flipJob, false)]
bool cancelSpawnBoolTypedAll = task.cancel(task.all(cancelSpawnBoolAllJobs))
assert cancelSpawnBoolTypedAll == true or cancelSpawnBoolTypedAll == false, "task.cancel typed bool task.all task.spawn"

array<future<bool>> cancelSpawnBoolRaceJobs = array[task.spawn(flipJob, true)]
bool cancelSpawnBoolTypedRace = task.cancel(task.race(cancelSpawnBoolRaceJobs))
assert cancelSpawnBoolTypedRace == true or cancelSpawnBoolTypedRace == false, "task.cancel typed bool task.race task.spawn"

array<float> spawnFloatAll = await task.all([task.spawn(halfJob, 3.5), task.spawn(halfJob, 4.5)])
assert spawnFloatAll.length == 2, "task.all float task.spawn count"
assert spawnFloatAll[0] == 4.0, "task.all float task.spawn first"
assert spawnFloatAll[1] == 5.0, "task.all float task.spawn second"

float spawnFloatRace = await task.race([task.spawn(halfJob, 5.5)])
assert spawnFloatRace == 6.0, "task.race float task.spawn result"

array<future<float>> spawnFloatAllJobs = array[task.spawn(halfJob, 6.5), task.spawn(halfJob, 7.5)]
array<float> spawnFloatTypedAll = await task.all(spawnFloatAllJobs)
assert spawnFloatTypedAll.length == 2, "task.all typed float task.spawn count"
assert spawnFloatTypedAll[0] == 7.0, "task.all typed float task.spawn first"
assert spawnFloatTypedAll[1] == 8.0, "task.all typed float task.spawn second"

array<future<float>> spawnFloatRaceJobs = array[task.spawn(halfJob, 8.5)]
float spawnFloatTypedRace = await task.race(spawnFloatRaceJobs)
