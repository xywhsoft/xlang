bool namedFlipA = await namedFlipFuture
bool namedFlipB = await namedFlipFuture
assert namedFlipA == true, "task.spawn bool future first await"
assert namedFlipB == true, "task.spawn bool future repeated await"
assert not task.cancel(namedFlipFuture), "completed bool task.spawn future cancel result"
bool postCancelNamedFlip = await namedFlipFuture
assert postCancelNamedFlip == true, "post-cancel task.spawn bool result"

