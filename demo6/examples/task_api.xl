future<int> raceFailureGroup = task.race([failAsync(), raceFailureSlowLoser])
int raceFailureGroupState = 0
try
    int raceFailureValue = await raceFailureGroup
    raceFailureGroupState = raceFailureValue
catch e
    if e.message == "task boom" then
        raceFailureGroupState = 1
    end
end
assert raceFailureGroupState == 1, "task.race should report first failure"

int raceFailureLoserStateA = 0
try
    int raceFailureLoserValueA = await raceFailureSlowLoser
    raceFailureLoserStateA = raceFailureLoserValueA
catch e
    if e.message == "future cancel requested." then
        raceFailureLoserStateA = 1
    end
end
assert raceFailureLoserStateA == 1, "task.race failure should cancel pending loser"

time.sleep(160)
int raceFailureLoserStateB = 0
try
    int raceFailureLoserValueB = await raceFailureSlowLoser
    raceFailureLoserStateB = raceFailureLoserValueB
catch e
    if e.message == "future cancel requested." then
        raceFailureLoserStateB = 1
    end
end
assert raceFailureLoserStateB == 1, "task.race failure loser should stay canceled after worker exit"

