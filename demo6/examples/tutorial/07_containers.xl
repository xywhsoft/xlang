// 教学目标：
// 1. array/list/set/dict 的字面量和 typed container。
// 2. list 使用 int64 稀疏索引。
// 3. for in 对不同容器的遍历形态。

func main(...) -> int
    auto values = [1, 2, 3]
    auto sparse = [0: "a", 2: "b"]
    auto unique = {1, 2, 2, 3}
    auto table = {"a": 10, "b": 20}
    var dynamicTable = {"name": 31, "nested": {"count": 32}}

    values[1] = 10
    table["c"] ?= 30
    table["c"] ?= 40
    dynamicTable.extra = 33
    dynamicTable.nested.count = 34

    int arraySum = 0
    for item in values
        arraySum += int(item)
    end

    int arrayIndexSum = 0
    for index, item in values
        arrayIndexSum += index
    end

    int listIndexSum = 0
    string listLast = ""
    for index, item in sparse
        listIndexSum += index
        listLast = string(item)
    end

    int setSum = 0
    for item in unique
        setSum += int(item)
    end

    int dictSum = 0
    int sawB = 0
    for key, item in table
        dictSum += int(item)
        if key == "b" then
            sawB = int(item)
        end
    end

    array<int> numbers = array[10, 20, 30]
    list<string> names = list[0: "alpha", 2: "beta"]
    set<int> ids = set{1, 2, 2}
    dict<int> scores = dict{"alpha": 10, "beta": 20}

    int idCount = 0
    for item in ids
        idCount += 1
    end

    var boxedNumbers = numbers
    var boxedNames = names
    var boxedIds = ids
    var boxedScores = scores

    if values.length != 3 or int(values[1]) != 10 then
        return 1
    end
    if sparse.length != 2 or string(sparse[2]) != "b" then
        return 2
    end
    if unique.length != 3 or 2 in unique != true then
        return 3
    end
    if table.length != 3 or int(table["c"]) != 30 then
        return 4
    end
    if arraySum != 14 or arrayIndexSum != 3 then
        return 5
    end
    if listIndexSum != 2 or listLast != "b" then
        return 6
    end
    if setSum != 6 or dictSum != 60 or sawB != 20 then
        return 7
    end
    if numbers[2] != 30 or string(names[2]) != "beta" or idCount != 2 or scores["beta"] != 20 then
        return 8
    end
    if type(boxedNumbers) != type(numbers) or type(boxedNames) != type(names) then
        return 11
    end
    if type(boxedIds) != type(ids) or type(boxedScores) != type(scores) then
        return 12
    end
    if int(boxedNumbers[2]) != 30 or string(boxedNames[2]) != "beta" then
        return 13
    end
    if 2 in boxedIds != true or int(boxedScores["beta"]) != 20 then
        return 14
    end
    if int(dynamicTable.name) != 31 or int(dynamicTable?.name) != 31 then
        return 9
    end
    if int(dynamicTable?.missing ?? 35) != 35 or int(dynamicTable.extra) != 33 or int(dynamicTable.nested.count) != 34 then
        return 10
    end
    return 0
end
