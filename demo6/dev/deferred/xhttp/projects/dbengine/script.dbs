// script.dbs - dbengine 示例脚本（每行一条命令，// 开头为注释）
CLEAR
SET user:1 {"name":"Alice","age":30}
SET user:2 {"name":"Bob","age":25}
FIND name=Alice
FIND age=25
KEYS user:*
COUNT
INCR counter
INCR counter
GET counter
TYPE user:1
EXPIRE user:2 3600
TTL user:2
BEGIN
SET temp "hello world"
GET temp
ROLLBACK
GET temp
BEGIN
SET perm 99
COMMIT
GET perm
SAVE data.json
