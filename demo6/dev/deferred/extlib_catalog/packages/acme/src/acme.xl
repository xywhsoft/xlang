extern "xacme_new_account" func __acme_acct(string email, bool agree) as string
extern "xacme_new_order" func __acme_order(string domain) as string
extern "xacme_http01_response" func __acme_http01(string token, string thumb) as string
extern "xacme_challenge_type" func __acme_ctype(string type) as string
extern "xacme_directory_url" func __acme_dir(string provider) as string
extern "xacme_status_name" func __acme_status(string status) as string
extern "xacme_dns01_record_name" func __acme_dns01(string domain) as string
extern "xacme_valid_domain" func __acme_vdom(string domain) as bool
extern "xacme_key_usage" func __acme_ku(bool ds, bool ke) as string



export func newAccount(string email, bool terms_agreed) as string
    return __acme_acct(email, terms_agreed)
end

export func newOrder(string domain) as string
    return __acme_order(domain)
end

export func http01Response(string token, string thumbprint) as string
    return __acme_http01(token, thumbprint)
end

export func challengeType(string type) as string
    return __acme_ctype(type)
end

export func directoryUrl(string provider) as string
    return __acme_dir(provider)
end

export func statusName(string status) as string
    return __acme_status(status)
end

export func dns01RecordName(string domain) as string
    return __acme_dns01(domain)
end

export func validDomain(string domain) as bool
    return __acme_vdom(domain)
end

export func keyUsage(bool digital_signature, bool key_encipherment) as string
    return __acme_ku(digital_signature, key_encipherment)
end
