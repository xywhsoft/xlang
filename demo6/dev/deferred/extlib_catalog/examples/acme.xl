import acme



func main(...) as int
    println("LE directory: ", acme.directoryUrl("letsencrypt"))
    println("Order: ", acme.newOrder("mysite.org"))
    println("DNS record: ", acme.dns01RecordName("mysite.org"))
    println("Valid domain: ", acme.validDomain("mysite.org"))
    println("acme example: PASS")
    return 0
end
