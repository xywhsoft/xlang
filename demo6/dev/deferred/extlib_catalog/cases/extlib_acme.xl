import acme



func main(...) as int
    // New account payload
    auto acct = acme.newAccount("admin@example.com", true)
    assert string.contains(acct, "termsOfServiceAgreed"), "has tos"
    assert string.contains(acct, "admin@example.com"), "has email"

    // New order
    auto order = acme.newOrder("example.com")
    assert string.contains(order, "example.com"), "has domain"
    assert string.contains(order, "dns"), "has dns type"

    // HTTP-01 response
    auto resp = acme.http01Response("token123", "thumb456")
    assert resp == "token123.thumb456", "http01 response"

    // Challenge types
    assert acme.challengeType("http-01") == "HTTP Validation", "http-01"
    assert acme.challengeType("dns-01") == "DNS Validation", "dns-01"

    // Directory URLs
    assert string.contains(acme.directoryUrl("letsencrypt"), "letsencrypt.org"), "LE url"
    assert acme.directoryUrl("unknown") == "", "unknown provider"

    // Status names
    assert acme.statusName("pending") == "Pending", "pending"
    assert acme.statusName("valid") == "Valid", "valid"

    // DNS-01 record name
    assert acme.dns01RecordName("example.com") == "_acme-challenge.example.com", "dns01 name"

    // Domain validation
    assert acme.validDomain("example.com"), "valid domain"
    assert acme.validDomain("sub.example.com"), "valid subdomain"
    assert not acme.validDomain("invalid"), "no dot invalid"
    assert not acme.validDomain("a b.com"), "space invalid"

    // Key usage
    assert acme.keyUsage(true, true) == "digitalSignature,keyEncipherment", "both ku"
    assert acme.keyUsage(true, false) == "digitalSignature", "ds only"

    return 0
end
