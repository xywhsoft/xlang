/* A native subscription never captures language values. The facade's ordinary
 * managed fields trace its source and callbacks through the existing graph. */
const char* xl6StdlibSignalClassSource =
    "class SignalSubscription\n"
    "    private native point handle\n"
    "    extern \"xl6SignalQueueCreateV1\" create(int code, bool once = false, int capacity = 64)\n"
    "    extern \"xl6SignalQueueDestroyV1\" destroy()\n"
    "    extern \"xl6SignalQueueCheckOwnerV1\" func checkOwner()\n"
    "    extern \"xl6SignalQueueCloseV1\" func close() as bool\n"
    "    extern \"xl6SignalQueueActiveV1\" get active() as bool\n"
    "    extern \"xl6SignalQueueCodeV1\" get code() as int\n"
    "    extern \"xl6SignalQueuePendingV1\" get pending() as int\n"
    "    extern \"xl6SignalQueueClosedV1\" get closed() as bool\n"
    "    extern \"xl6SignalQueuePrepareV1\" func prepare(int timeoutMs = 0) as bool\n"
    "    extern \"xl6SignalQueueConsumeV1\" func consume()\n"
    "    func next(int timeoutMs = 0) as SignalEvent?\n"
    "        if not self.prepare(timeoutMs) then return null end\n"
    "        auto event = SignalEvent(self)\n"
    "        self.consume()\n        return event\nend\n"
    "end\n"
    "class SignalEvent\n"
    "    private native point handle\n"
    "    extern \"xl6SignalQueueSnapshotV1\" create(SignalSubscription source)\n"
    "    extern \"xl6SignalEventDestroyV1\" destroy()\n"
    "    extern \"xl6SignalEventCodeV1\" get code() as int\n"
    "    extern \"xl6SignalEventSystemCodeV1\" get systemCode() as int\n"
    "    extern \"xl6SignalEventCountV1\" get count() as uint64\n"
    "    extern \"xl6SignalEventTotalV1\" get total() as uint64\n"
    "    extern \"xl6SignalEventTimeV1\" get time() as time\n"
    "    extern \"xl6SignalEventNameV1\" get name() as string\n"
    "    extern \"xl6SignalEventCoalescedV1\" get coalesced() as bool\n"
    "    extern \"xl6SignalEventSaturatedV1\" get saturated() as bool\n"
    "end\n";

const char* xl6StdlibSignalHandleClassSource =
    "class SignalHandle\n"
    "    private SignalSubscription source\n"
    "    private (func(SignalEvent) as bool)? receiver = null\n"
    "    private bool consumeBefore = true\n"
    "    private bool oneShot = false\n"
    "    private bool dispatching = false\n"
    "    create(SignalSubscription source, func(SignalEvent) as bool receiver, bool consumeBefore, bool once = false)\n"
    "        self.source = source\n        self.receiver = receiver\n"
    "        self.consumeBefore = consumeBefore\n        self.oneShot = once\nend\n"
    "    get active() as bool\n        return self.source.active\nend\n"
    "    get code() as int\n        return self.source.code\nend\n"
    "    get pending() as int\n        return self.source.pending\nend\n"
    "    get closed() as bool\n        return self.source.closed\nend\n"
    "    func close() as bool\n"
    "        self.source.checkOwner()\n        self.receiver = null\n"
    "        return self.source.close()\nend\n"
    "    func dispatch(int maxEvents = 64) as int\n"
    "        return self.dispatchFor(0, maxEvents)\nend\n"
    "    func dispatchFor(int timeoutMs, int maxEvents = 64) as int\n"
    "        self.source.checkOwner()\n"
    "        if self.dispatching then throw RuntimeError \"signal dispatch is not reentrant\" end\n"
    "        if maxEvents < 0 or timeoutMs < -1 then throw RangeError \"invalid signal dispatch limit\" end\n"
    "        int delivered = 0\n        self.dispatching = true\n"
    "        try\n"
    "            while delivered < maxEvents\n"
    "                auto callback = self.receiver\n"
    "                if callback == null then break end\n"
    "                if not self.source.prepare(timeoutMs) then break end\n"
    "                auto event = SignalEvent(self.source)\n"
    "                if self.consumeBefore then self.source.consume() end\n"
    "                if self.oneShot then self.close() end\n"
    "                if not callback(event) then break end\n"
    "                if not self.consumeBefore then self.source.consume() end\n"
    "                delivered += 1\n                timeoutMs = 0\n"
    "            end\n"
    "        finally\n            self.dispatching = false\n        end\n"
    "        return delivered\n    end\nend\n";
