const char* xl6StdlibTlsIdentitySource=
    "enum TlsIdentityKind as int\n"
    "    none = 0\n"
    "    rsa = 1\n"
    "    rsaPss = 2\n"
    "    p256 = 3\n"
    "    p384 = 4\n"
    "    p521 = 5\n"
    "    ed25519 = 6\n"
    "    ed448 = 7\n"
    "end\n"
    "class TlsIdentity\n"
    "    private native point handle\n"
    "    extern \"xl6TlsIdentityDestroyV1\" @no_raise @nonblocking destroy()\n"
    "    static extern \"xl6TlsIdentityRsaV1\" @nonblocking func fromRsa(array<Certificate> certificates, RsaPrivateKey key, int maxCertificates = 64, int maxCertificateBytes = 16777216) as TlsIdentity\n"
    "    static extern \"xl6TlsIdentityP256V1\" @nonblocking func fromP256(array<Certificate> certificates, P256Key key, int maxCertificates = 64, int maxCertificateBytes = 16777216) as TlsIdentity\n"
    "    static extern \"xl6TlsIdentityP384V1\" @nonblocking func fromP384(array<Certificate> certificates, P384Key key, int maxCertificates = 64, int maxCertificateBytes = 16777216) as TlsIdentity\n"
    "    static extern \"xl6TlsIdentityEd25519V1\" @nonblocking func fromEd25519(array<Certificate> certificates, Ed25519Key key, int maxCertificates = 64, int maxCertificateBytes = 16777216) as TlsIdentity\n"
    "    extern \"xl6TlsIdentityKindV1\" @pure @nonblocking get kind() as TlsIdentityKind\n"
    "    extern \"xl6TlsIdentityCountV1\" @pure @nonblocking get count() as int\n"
    "    extern \"xl6TlsIdentityCertificateV1\" @pure @nonblocking func at(int index) as Certificate\n"
    "end\n";
