    "            end\n"
    "        finally\n"
    "            self.phase.store(next)\n"
    "        end\n"
    "    end\n"
    "\n"
    "    async func readRequestHeadAsync(int timeoutMillis = -1, CancellationToken? cancel = null) as Http1Head?\n"
    "        return await self.headAsync(false, \"\", Http1.deadline(timeoutMillis), cancel)\n"
