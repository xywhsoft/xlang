    "            self.receiveSize = limits.readChunk\n"
    "            self.bufferLimit = limits.maxBuffered\n"
    "        end\n"
    "        self.pending = NetBuffer(self.bufferLimit)\n"
    "        self.phase = AtomicInt32(0)\n"
    "    end\n"
    "\n"
    "    private func enter(bool bodyOperation = false, bool handoff = false) as int\n"
    "        int old = self.phase.load()\n"
    "        if old >= 16 then throw RuntimeError \"HTTP/1 reader is already active\" end\n"
    "        if handoff then\n"
    "            if old != 0 and old != 2 then throw RuntimeError \"HTTP/1 handoff requires a message boundary or upgrade\" end\n"
    "        elseif bodyOperation then\n"
    "            if old != 0 and old != 1 then throw RuntimeError \"HTTP/1 body is unavailable\" end\n"
    "        elseif old != 0 then\n"
    "            throw RuntimeError \"finish the HTTP/1 body before reading another head\"\n"
    "        end\n"
    "        auto entered, observed = self.phase.compareExchange(old, old + 16)\n"
    "        if not entered then throw RuntimeError \"concurrent HTTP/1 reader\" end\n"
    "        return old\n"
    "    end\n"
    "\n"
    "    get state() as Http1TransportState\n"
    "        int value = self.phase.load()\n"
    "        if value >= 16 then value = value - 16 end\n"
    "        if value == 0 then return Http1TransportState.head end\n"
    "        if value == 1 then return Http1TransportState.body end\n"
    "        if value == 2 then return Http1TransportState.upgraded end\n"
    "        if value == 3 then return Http1TransportState.detached end\n"
    "        if value == 4 then return Http1TransportState.closed end\n"
    "        return Http1TransportState.failed\n"
    "    end\n"
    "    get busy() as bool\n"
    "        return self.phase.load() >= 16\n"
    "    end\n"
    "\n"
    "    func detach() as Http1TlsTransportHandoff\n"
    "        int old = self.enter(false, true)\n"
    "        int next = old\n"
    "        try\n"
    "            auto result = Http1TlsTransportHandoff(self.connection, self.pending, self.ended)\n"
    "            next = 3\n"
    "            return result\n"
    "        finally\n"
    "            self.phase.store(next)\n"
    "        end\n"
    "    end\n"
    "\n"
    "    func close()\n"
    "        int old = self.phase.load()\n"
    "        if old == 3 then throw RuntimeError \"HTTP/1 transport was detached\" end\n"
    "        if old == 4 then return end\n"
    "        if old >= 16 then throw RuntimeError \"cancel the active HTTP/1 read before closing\" end\n"
    "        auto entered, observed = self.phase.compareExchange(old, old + 16)\n"
    "        if not entered then throw RuntimeError \"concurrent HTTP/1 reader\" end\n"
    "        try\n"
    "            self.connection.close()\n"
    "        finally\n"
    "            self.phase.store(4)\n"
    "        end\n"
    "    end\n"
    "\n"
    "    func trailers() as HttpHeaders\n"
    "        int old = self.enter(true)\n"
    "        try\n"
    "            if old != 0 or not self.hasMessage then throw RuntimeError \"HTTP/1 body is not complete\" end\n"
    "            auto fields = self.finalTrailers\n"
    "            if fields != null then return fields.clone() end\n"
    "            return HttpHeaders(0)\n"
    "        finally\n"
    "            self.phase.store(old)\n"
    "        end\n"
    "    end\n"
    "\n"
    "\n"
    "    private func fill(uint64 deadline, CancellationToken? cancel) as bool\n"
    "        if self.ended then return false end\n"
    "        int maximum = self.bufferLimit - self.pending.length\n"
    "        if maximum <= 0 then throw RangeError \"HTTP/1 input buffer limit reached\" end\n"
    "        if maximum > self.receiveSize then maximum = self.receiveSize end\n"
    "        auto token = cancel\n"
    "        if token != null then\n"
    "            auto chunk = self.connection.recvOwnedUntilCancel(maximum, deadline, token)\n"
    "            if chunk.length == 0 then\n"
    "                self.ended = true\n"
    "                return false\n"
    "            end\n"
    "            self.pending.appendRef(chunk)\n"
    "        else\n"
    "            auto chunk = self.connection.recvOwnedUntil(maximum, deadline)\n"
    "            if chunk.length == 0 then\n"
    "                self.ended = true\n"
    "                return false\n"
    "            end\n"
    "            self.pending.appendRef(chunk)\n"
    "        end\n"
    "        return true\n"
    "    end\n"
    "\n"
    "    private func head(bool response, string method, uint64 deadline, CancellationToken? cancel) as Http1Head?\n"
    "        auto token = cancel\n"
    "        if token != null then token.throwIfCancelled() end\n"
    "        self.enter()\n"
    "        int next = 5\n"
    "        try\n"
    "            while true\n"
    "                Http1Head? head = null\n"
    "                if response then\n"
    "                    head = Http1Head.responseFromNetBuffer(self.pending, self.headLimit, self.startLimit, self.lineLimit, self.fieldLimit)\n"
    "                else\n"
    "                    head = Http1Head.requestFromNetBuffer(self.pending, self.headLimit, self.startLimit, self.lineLimit, self.fieldLimit)\n"
    "                end\n"
    "                if head != null then\n"
    "                    auto mode = head.bodyMode(method)\n"
    "                    Http1BodyReader? body = null\n"
    "                    if mode != HttpBodyMode.none and mode != HttpBodyMode.tunnel then\n"
    "                        if mode != HttpBodyMode.fixed or head.contentLength != uint64(0) then\n"
    "                            body = Http1BodyReader(head, method, self.bodyLimit, self.chunkLimit, self.trailerLimit, self.trailerLineLimit, self.trailerFieldLimit)\n"
    "                        end\n"
    "                    end\n"
    "                    self.pending.consume(head.headerBytes)\n"
    "                    self.activeBody = body\n"
    "                    self.finalTrailers = null\n"
    "                    self.hasMessage = true\n"
    "                    next = 1\n"
    "                    if mode == HttpBodyMode.tunnel then\n"
    "                        next = 2\n"
    "                        self.activeBody = null\n"
    "                    elseif body == null then\n"
    "                        next = 0\n"
    "                        self.activeBody = null\n"
    "                    end\n"
    "                    return head\n"
    "                end\n"
    "                if self.ended then\n"
    "                    if self.pending.length != 0 then throw IOError \"truncated HTTP/1 head\" end\n"
    "                    next = 4\n"
    "                    return null\n"
    "                end\n"
    "                self.fill(deadline, cancel)\n"
    "            end\n"
    "        finally\n"
    "            self.phase.store(next)\n"
    "        end\n"
    "    end\n"
    "\n"
    "    func readRequestHead(int timeoutMillis = -1, CancellationToken? cancel = null) as Http1Head?\n"
    "        return self.head(false, \"\", Http1.deadline(timeoutMillis), cancel)\n"
    "    end\n"
    "    func readResponseHead(string requestMethod = \"GET\", int timeoutMillis = -1, CancellationToken? cancel = null) as Http1Head?\n"
    "        return self.head(true, requestMethod, Http1.deadline(timeoutMillis), cancel)\n"
    "    end\n"
    "\n"
    "    private func body(Buffer? output, bool whole, uint64 deadline, CancellationToken? cancel) as HttpBodyStatus\n"
    "        auto token = cancel\n"
    "        if token != null then token.throwIfCancelled() end\n"
    "        int old = self.enter(true)\n"
    "        int next = 5\n"
    "        try\n"
    "            if old == 0 then\n"
    "                next = 0\n"
    "                if not self.hasMessage then throw RuntimeError \"read an HTTP/1 head first\" end\n"
    "                return HttpBodyStatus.done\n"
    "            end\n"
    "            auto reader = self.activeBody\n"
    "            if reader == null then throw RuntimeError \"missing HTTP/1 body reader\" end\n"
    "            while true\n"
    "                HttpBodyStatus status = HttpBodyStatus.more\n"
    "                if output == null then\n"
    "                    status = reader.discardFromNetBuffer(self.pending, self.ended)\n"
    "                else\n"
    "                    status = reader.readFromNetBuffer(self.pending, output, self.ended)\n"
    "                end\n"
    "                if reader.done then\n"
    "                    if reader.mode == HttpBodyMode.chunked then self.finalTrailers = reader.trailers() end\n"
    "                    self.activeBody = null\n"
    "                    next = 0\n"
    "                    return status\n"
    "                end\n"
    "                if status == HttpBodyStatus.data and not whole then\n"
    "                    next = 1\n"
    "                    return status\n"
    "                end\n"
    "                if status == HttpBodyStatus.more and reader.consumed == 0 then\n"
    "                    if self.ended then throw IOError \"truncated HTTP/1 body\" end\n"
    "                    self.fill(deadline, cancel)\n"
    "                end\n"
    "            end\n"
    "        finally\n"
    "            self.phase.store(next)\n"
    "        end\n"
    "    end\n"
    "\n"
    "    func readBodyInto(Buffer output, int timeoutMillis = -1, CancellationToken? cancel = null) as HttpBodyStatus\n"
    "        return self.body(output, false, Http1.deadline(timeoutMillis), cancel)\n"
    "    end\n"
    "    func readBodyAllInto(Buffer output, int timeoutMillis = -1, CancellationToken? cancel = null) as int\n"
    "        int before = output.length\n"
    "        self.body(output, true, Http1.deadline(timeoutMillis), cancel)\n"
    "        return output.length - before\n"
    "    end\n"
    "    func discardBody(int timeoutMillis = -1, CancellationToken? cancel = null)\n"
    "        self.body(null, true, Http1.deadline(timeoutMillis), cancel)\n"
    "    end\n"
    "\n"
    "\n"
    "    private async func fillAsync(uint64 deadline, CancellationToken? cancel) as bool\n"
    "        if self.ended then return false end\n"
