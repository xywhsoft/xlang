    "    async func readResponseHeadAsync(string requestMethod = \"GET\", int timeoutMillis = -1, CancellationToken? cancel = null) as Http1Head?\n"
    "        return await self.headAsync(true, requestMethod, Http1.deadline(timeoutMillis), cancel)\n"
    "    end\n"
    "\n"
