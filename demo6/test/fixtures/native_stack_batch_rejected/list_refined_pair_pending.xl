// A var refined to erased List has an i64 key but dynamic-loop IR currently
// demands a var key. Keep this real language gap visible until its IR/shape
// contract and native List type/cast admission are migrated together.
func refinedListPair(var values) as int
    int count = 0
    if values is list
        for key, value in values
            count += 1
        end
    end
    return count
end
