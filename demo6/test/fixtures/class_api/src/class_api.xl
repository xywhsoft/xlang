class Point
    int x
    int y
end

extern "xl6_class_api_make" func __xl6_native_class_api_makePoint(int x, int y) as Point
extern "xl6_class_api_sum" func __xl6_native_class_api_sum(Point point) as int
export extern "xl6_class_api_origin" Point origin

export func makePoint(int x, int y) as Point
    return __xl6_native_class_api_makePoint(x, y)
end

export func sum(Point point) as int
    return __xl6_native_class_api_sum(point)
end
