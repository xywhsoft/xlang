func worker() as int
    return 7
end

func zero() as int
    return 0
end

func slowWorker() as int
    time.sleep(30)
    return 9
end

func monitorSlowWorker() as int
    time.sleep(120)
    return 19
end

func makeThreadWorker(int code) as func() as int
    return func() as int
        return code
    end
end

class ThreadFuncBox
    func() as int op
end

func() as int borrowedWorker = worker

func() as int missingWorker
int missingThreadState = 0
try
    thread missingThread = thread(missingWorker)
    missingThreadState = missingThread.exitCode()
catch e
    if e.message == "thread requires a callable func value" then
        missingThreadState = 42
    end
end
assert missingThreadState == 42, "thread should reject empty func value"

thread first = thread(worker)
bool waited = first.wait()
int code = first.exitCode()
int state = first.state()

assert waited, "thread wait failed"
assert code == 7, "thread exit code failed"
assert state >= 0, "thread state failed"

thread capturedReceiverThread = thread(worker)
auto threadJoiner = func() as int
    if not capturedReceiverThread.wait() then
        return 10
    end
    return capturedReceiverThread.exitCode()
end
assert threadJoiner() == 7, "captured thread receiver wait/exitCode failed"

thread capturedTimedThread = thread(monitorSlowWorker)
auto threadObserver = func() as int
    if capturedTimedThread.waitTimeout(0) then
        return 10
    end
    if capturedTimedThread.state() < 0 then
        return 11
    end
    if not capturedTimedThread.waitTimeout(2000) then
        return 12
    end
    if capturedTimedThread.exitCode() != 19 then
        return 13
    end
    if capturedTimedThread.state() < 0 then
        return 14
    end
    return capturedTimedThread.exitCode()
end
assert threadObserver() == 19, "captured thread receiver waitTimeout/state failed"

auto second = thread(worker)
bool waitedTimeout = second.waitTimeout(5000)
int secondCode = second.exitCode()

assert waitedTimeout, "thread waitTimeout failed"
assert secondCode == 7, "thread waitTimeout exit code failed"

thread borrowed = thread(borrowedWorker)
bool borrowedWaited = borrowed.wait()
int borrowedCode = borrowed.exitCode()

assert borrowedWaited, "thread borrowed wait failed"
assert borrowedCode == 7, "thread borrowed exit code failed"

int base = 5
auto capturedWorker = func() as int
    return base + 2
end
auto captured = thread(capturedWorker)
bool capturedWaited = captured.wait()
int capturedCode = captured.exitCode()

assert capturedWaited, "thread captured wait failed"
assert capturedCode == 7, "thread captured exit code failed"

func() as int borrowedThreadLeft = makeThreadWorker(11)
func() as int borrowedThreadRight = makeThreadWorker(12)
bool chooseBorrowedThread = false
thread conditionalBorrowedThread = thread(chooseBorrowedThread ? borrowedThreadLeft : borrowedThreadRight)
assert conditionalBorrowedThread.wait(), "thread borrowed conditional wait failed"
assert conditionalBorrowedThread.exitCode() == 12, "thread borrowed conditional exit code failed"
assert borrowedThreadRight() == 12, "thread borrowed conditional should not consume right source"
chooseBorrowedThread = true
thread conditionalBorrowedThreadAgain = thread(chooseBorrowedThread ? borrowedThreadLeft : borrowedThreadRight)
assert conditionalBorrowedThreadAgain.wait(), "thread borrowed conditional second wait failed"
assert conditionalBorrowedThreadAgain.exitCode() == 11, "thread borrowed conditional second exit code failed"
assert borrowedThreadLeft() == 11, "thread borrowed conditional should not consume left source"

func() as int mixedThreadSource = makeThreadWorker(15)
bool chooseMixedThread = false
thread mixedThreadOwned = thread(chooseMixedThread ? mixedThreadSource : makeThreadWorker(16))
assert mixedThreadOwned.wait(), "thread mixed conditional owned wait failed"
assert mixedThreadOwned.exitCode() == 16, "thread mixed conditional owned exit code failed"
assert mixedThreadSource() == 15, "thread mixed conditional should leave source after owned branch"
chooseMixedThread = true
thread mixedThreadBorrowed = thread(chooseMixedThread ? mixedThreadSource : makeThreadWorker(17))
assert mixedThreadBorrowed.wait(), "thread mixed conditional borrowed wait failed"
assert mixedThreadBorrowed.exitCode() == 15, "thread mixed conditional borrowed exit code failed"
assert mixedThreadSource() == 15, "thread mixed conditional should retain copied borrowed branch"

ThreadFuncBox threadBox
threadBox.op = makeThreadWorker(13)
ThreadFuncBox threadBoxAlt
threadBoxAlt.op = makeThreadWorker(14)
bool chooseThreadMember = false
thread conditionalMemberThread = thread(chooseThreadMember ? threadBox.op : threadBoxAlt.op)
assert conditionalMemberThread.wait(), "thread borrowed conditional member wait failed"
assert conditionalMemberThread.exitCode() == 14, "thread borrowed conditional member exit code failed"
assert threadBoxAlt.op() == 14, "thread borrowed conditional member should not consume source"

thread stopped = thread(zero)
bool stoppedSignal = stopped.stop()
bool stoppedWaited = stopped.wait()

assert stoppedSignal, "thread stop failed"
assert stoppedWaited, "thread wait after stop failed"

thread capturedStopThread = thread(slowWorker)
auto threadStopper = func() as int
    if not capturedStopThread.stop() then
        return 10
    end
    if not capturedStopThread.wait() then
        return 11
    end
    return 17
end
assert threadStopper() == 17, "captured thread receiver stop/wait failed"

thread slow = thread(slowWorker)
bool slowImmediate = slow.waitTimeout(0)
assert not slowImmediate, "running thread waitTimeout(0) should time out"

bool slowWaited = slow.waitTimeout(2000)
int slowCode = slow.exitCode()
bool slowRepeatedWait = slow.wait()
int slowCodeAgain = slow.exitCode()

assert slowWaited, "slow thread waitTimeout should eventually finish"
assert slowCode == 9, "slow thread exit code failed"
assert slowRepeatedWait, "completed thread repeated wait should return true"
assert slowCodeAgain == 9, "completed thread exit code should remain stable"
