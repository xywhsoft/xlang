extern "generator_loan_drop" func generatorLoanDrop(int id)
extern "generator_loan_caught" func generatorLoanCaught(int code)
extern "generator_loan_finally" func generatorLoanFinally()

class GeneratorLoanOwner
    int id
    create(int id)
        self.id = id
    end
    destroy()
        generatorLoanDrop(self.id)
    end
end

// The IR contract reuses the first parameter LOAD at the later observations.
// Private parameter storage protects it across both suspensions without retain.
func generatorLoanWords(string text) as generator<string>
    yield text
    yield text
    yield text
end
func generatorLoanOwners(GeneratorLoanOwner owner) as generator<int>
    yield owner.id
    yield owner.id
    yield owner.id
end

string generatorLoanShared = "old"
func generatorLoanSharedWords() as generator<string>
    yield generatorLoanShared
    yield generatorLoanShared
    yield generatorLoanShared
end

export "generator_loan_case" func generatorLoanCase(int kind, int stop) as int
    int count = 0
    int caught = 0
    try
    if kind == 0
        for word in generatorLoanWords("private")
            assert word == "private"
            count += 1
            if count == stop then break end
        end
    elseif kind == 1
        for value in generatorLoanOwners(GeneratorLoanOwner(7))
            assert value == 7
            count += 1
            if count == stop then break end
        end
    else
        generatorLoanShared = "old"
        for word in generatorLoanSharedWords()
            assert word == (count == 0 ? "old" : "new")
            count += 1
            generatorLoanShared = "new"
            if count == stop then break end
        end
    end
    catch failure
        generatorLoanCaught(failure.code)
        caught = 100
    finally
        generatorLoanFinally()
    end
    return count + caught
end
