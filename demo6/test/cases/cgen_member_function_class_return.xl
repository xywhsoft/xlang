extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

class Payload
    int value
    func(int) as int op
end

func makePayload(int base) as Payload
    Payload result
    result.value = base
    result.op = makeAdder(base)
    return result
end

func readPayload(Payload payload) as int
    return payload.value
end

func sumPayload(Payload left, Payload right) as int
    return left.value + right.value
end

func storePayload(Payload payload, int expected)
    expect(payload.value, expected)
end

func consumePayload(Payload payload, int expected)
    expect(payload.value, expected)
end

func makeText(string value) as string
    return value + "!"
end

func textScore(string value) as int
    if value == "call!" then
        return 11
    end

    if value == "nested!" then
        return 30
    end

    return 0
end

func joinTextScore(string left, string right) as int
    if left == "left!" and right == "right!" then
        return 22
    end

    return 0
end

class Maker
    func(int) as Payload make
end

class Sink
    func(Payload, int) consume
end

class TextMaker
    func(string) as string make
end

Maker maker
maker.make = makePayload

Sink sink
sink.consume = consumePayload

TextMaker textMaker
textMaker.make = makeText

Payload explicitPayload = maker.make(10)
auto autoPayload = maker.make(20)

Payload assignedPayload
assignedPayload = maker.make(30)
auto expressionValue = maker.make(40).value
int tempFunctionFieldValue = maker.make(210).op(5)
int explicitExpressionValue = maker.make(50).value
auto argumentValue = readPayload(maker.make(60))
storePayload(maker.make(70), 70)
sink.consume(explicitPayload, 10)
maker.make(80)
int nestedArgumentValue = readPayload(maker.make(90)) + 1
expect(readPayload(maker.make(100)) + 1, 101)
expect(maker.make(220).op(6), 226)
expect(actual = maker.make(230).op(7), expected = 237)
int twoArgumentValue = sumPayload(maker.make(110), maker.make(120))
expect(sumPayload(maker.make(130), maker.make(140)), 270)
int namedArgumentValue = readPayload(payload = maker.make(150))
storePayload(payload = maker.make(160), expected = 160)
int namedTwoArgumentValue = sumPayload(left = maker.make(170), right = maker.make(180))
expect(sumPayload(right = maker.make(200), left = maker.make(190)), 390)

string madeText = textMaker.make("plain")
int textArgValue = textScore(textMaker.make("call"))
int textNestedValue = textScore(textMaker.make("nested")) + 1
int textTwoArgValue = joinTextScore(textMaker.make("left"), textMaker.make("right"))
int namedTextArgValue = textScore(value = textMaker.make("call"))
int namedTextTwoArgValue = joinTextScore(right = textMaker.make("right"), left = textMaker.make("left"))
textMaker.make("discard")

expect(explicitPayload.value, 10)
expect(explicitPayload.op(1), 11)
expect(autoPayload.value, 20)
expect(autoPayload.op(2), 22)
expect(assignedPayload.value, 30)
expect(assignedPayload.op(3), 33)
expect(expressionValue, 40)
expect(tempFunctionFieldValue, 215)
expect(explicitExpressionValue, 50)
expect(argumentValue, 60)
expect(nestedArgumentValue, 91)
expect(twoArgumentValue, 230)
expect(namedArgumentValue, 150)
expect(namedTwoArgumentValue, 350)
expectStr(madeText, "plain!")
expect(textArgValue, 11)
expect(textNestedValue, 31)
expect(textTwoArgValue, 22)
expect(namedTextArgValue, 11)
expect(namedTextTwoArgValue, 22)
