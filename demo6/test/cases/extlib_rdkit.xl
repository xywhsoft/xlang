import rdkit

func main(...) as int
    // Elements
    assert rdkit.element(6) == "C", "elem C"
    assert rdkit.element(8) == "O", "elem O"
    assert rdkit.element(17) == "Cl", "elem Cl"

    // Atomic mass x100
    assert rdkit.atomicMass(1) == 101, "mass H"
    assert rdkit.atomicMass(6) == 1201, "mass C"
    assert rdkit.atomicMass(8) == 1600, "mass O"

    // Bond types
    assert rdkit.bondType(0) == "single", "bond single"
    assert rdkit.bondType(3) == "aromatic", "bond aromatic"

    // Fingerprints
    assert rdkit.fingerprint(0) == "morgan", "fp morgan"
    assert rdkit.fingerprint(2) == "maccs", "fp maccs"

    // Descriptors
    assert rdkit.descriptor(0) == "MolWt", "desc molwt"
    assert rdkit.descriptor(1) == "LogP", "desc logp"

    // SMILES validation
    assert rdkit.validateSmiles("CCO") == 1, "valid ethanol"
    assert rdkit.validateSmiles("c1ccccc1") == 1, "valid benzene"
    assert rdkit.validateSmiles("CC(") == 0, "invalid unbalanced"

    // Count atoms
    assert rdkit.countAtoms("CCO") == 3, "atoms ethanol"
    assert rdkit.countAtoms("CC(=O)O") == 4, "atoms acetic"

    return 0
end
