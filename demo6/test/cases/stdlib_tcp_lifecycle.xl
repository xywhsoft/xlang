func require(string name, bool ok)
    assert ok, name
    println(name + "=ok")
end

func acceptedFirstSend()
    point listenerHandle = tcp.listen(0, "127.0.0.1", 4)
    TcpServer server = TcpServer(listenerHandle)
    require("tcp_listener_transfer", listenerHandle == null)

    point clientHandle = tcp.connect("127.0.0.1", int(server.port()), 3000)
    TcpStream client = TcpStream(clientHandle)
    require("tcp_client_transfer", clientHandle == null)

    point peerHandle = server.accept(3000)
    TcpStream peer = TcpStream(peerHandle)
    require("tcp_accept_transfer", peerHandle == null)

    bool sent = peer.send("220 first\r\n")
    bool drained = peer.drain(3000)
    string received = client.recv(3000)
    require("tcp_accepted_first_send", sent and drained and received == "220 first\r\n")

    peer.close()
    client.close()
end

func gracefulCloseKeepsPendingData()
    point listenerHandle = tcp.listen(0, "127.0.0.1", 4)
    TcpServer server = TcpServer(listenerHandle)
    point clientHandle = tcp.connect("127.0.0.1", int(server.port()), 3000)
    TcpStream client = TcpStream(clientHandle)
    point peerHandle = server.accept(3000)
    TcpStream peer = TcpStream(peerHandle)

    string payload = string.repeat("0123456789abcdef", 4096)
    bool sent = client.send(payload)
    client.close()

    string received = ""
    for attempt in range(0, 64)
        string chunk = peer.recv(3000, 8192)
        if string.byteLen(chunk) == 0 then
            break
        end
        received += chunk
        if string.byteLen(received) == string.byteLen(payload) then
            break
        end
    end
    require("tcp_graceful_close", sent and received == payload)
    peer.close()
end

func gracefulCloseSurvivesDestroy()
    point listenerHandle = tcp.listen(0, "127.0.0.1", 4)
    TcpServer server = TcpServer(listenerHandle)
    point clientHandle = tcp.connect("127.0.0.1", int(server.port()), 3000)
    point peerHandle = server.accept(3000)
    TcpStream peer = TcpStream(peerHandle)
    string payload = string.repeat("scope-close-", 4096)
    bool sent = false

    if true then
        TcpStream client = TcpStream(clientHandle)
        sent = client.send(payload)
        client.close()
    end

    string received = ""
    for attempt in range(0, 64)
        string chunk = peer.recv(3000, 8192)
        if string.byteLen(chunk) == 0 then
            break
        end
        received += chunk
        if string.byteLen(received) == string.byteLen(payload) then
            break
        end
    end
    require("tcp_close_before_destroy", sent and received == payload)
    peer.close()
end

acceptedFirstSend()
gracefulCloseKeepsPendingData()
gracefulCloseSurvivesDestroy()
