// Select actual resident codecs for the native query host. These are existing
// language calls, not proof that the new owned-result language APIs exist.
func main(...) as int
    auto numbers = OrderedMap::<int, int?>()
    assert(numbers.set(1, null) and numbers.set(2, 41))
    int? value = 9
    assert(numbers.getInto(1, value) and value == null)
    auto texts = OrderedMap::<string, string>()
    assert(texts.set("a\0b", "你\0好"))
    string captured = "old"
    assert(texts.getInto("a\0b", captured) and captured == "你\0好")
    auto optional = OrderedMap::<int, string?>()
    assert(optional.set(1, null))
    string? empty = "old"
    assert(optional.getInto(1, empty) and empty == null)
    auto nested = OrderedMap::<int, array<int>>()
    assert(nested.set(1, array[42]))
    auto copy = nested.values()
    assert(copy.length == 1 and copy[0][0] == 42)
    return 0
end
