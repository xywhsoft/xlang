extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

Buffer buf = Buffer()

expect(buf.len(), 0)
expect(buf.length, 0)
expect(buf.capacity(), 0)
expect(buf.append("abc"), 1)
expect(buf.appendByte(100), 1)
expect(buf.appendByte(-1), 0)
expect(buf.appendByte(256), 0)
expect(buf.len(), 4)
expect(buf.length, 4)
expect(buf.byteAt(0), 97)
expect(buf.byteAt(3), 100)
expect(buf.byteAt(-1), -1)
expect(buf.byteAt(4), -1)
expect(buf[1], 98)
buf[1] = 66
expect(buf[1], 66)
expect(buf.setByte(2, 67), 1)
expect(buf.setByte(-1, 1), 0)
expect(buf.setByte(99, 1), 0)
expect(buf.setByte(0, 256), 0)
expectStr(buf.text(), "aBCd")
expect(buf.reserve(128), 1)
expect(buf.capacity() >= 128, 1)
expect(buf.clear(), 1)
expect(buf.len(), 0)
expectStr(buf.text(), "")

Buffer stepped = Buffer(64)
expect(stepped.appendBytes("hello", c_size(2)), 1)
expectStr(stepped.text(), "he")
expect(stepped.appendBytes("ignored", c_size(0)), 1)
expect(stepped.len(), 2)
