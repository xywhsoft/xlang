extern "expect_i64" func expect(int actual, int expected)

auto inc = func(int value) as int => value + 1
expect(inc(41), 42)

func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

func identity(func(int) as int fn) as func(int) as int
    return fn
end

auto add10 = makeAdder(10)
auto value = add10(5)
expect(value, 15)

auto copy = add10
expect(copy(7), 17)

auto same = identity(copy)
expect(same(8), 18)
