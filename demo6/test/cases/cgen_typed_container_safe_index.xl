extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

array<int> values = array[10, 20]
list<string> names = list[2: "beta"]
dict<int> scores = dict{"alpha": 10}
var scoreKey = "alpha"

auto maybeValue = values?[1]
auto missingValue = values?[9]
auto maybeName = names?[2]
auto missingName = names?[9]
auto maybeScore = scores?[scoreKey]
auto missingScore = scores?["missing"]

expect(maybeValue != null, 1)
expect(missingValue == null, 1)
expect(maybeName != null, 1)
expect(missingName == null, 1)
expect(maybeScore != null, 1)
expect(missingScore == null, 1)

expect(values?[1] ?? -1, 20)
expect(values?[9] ?? 77, 77)

expectStr(names?[2] ?? "", "beta")
expectStr(names?[9] ?? "fallback", "fallback")

expect(scores?["alpha"] ?? -1, 10)
expect(scores?[scoreKey] ?? -1, 10)
expect(scores?["missing"] ?? 88, 88)
