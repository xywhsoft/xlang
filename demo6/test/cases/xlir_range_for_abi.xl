extern "expect_i64" func expect(int actual, int expected)

int forwardSum = 0
for value in range(1, 5)
    forwardSum = forwardSum + value
end
expect(forwardSum, 10)

int indexedSum = 0
for index, value in range(1, 8, 2)
    if index == 1
        continue
    end
    indexedSum = indexedSum + index * 10 + value
end
expect(indexedSum, 63)

int backwardSum = 0
for value in range(5, 0, -2)
    backwardSum = backwardSum + value
end
expect(backwardSum, 9)

int startCalls = 0
int endCalls = 0
int stepCalls = 0

func next_start() as int
    startCalls = startCalls + 1
    return 1
end

func next_end() as int
    endCalls = endCalls + 1
    return 5
end

func next_step() as int
    stepCalls = stepCalls + 1
    return 2
end

int evaluatedOnceSum = 0
for value in range(next_start(), next_end(), next_step())
    evaluatedOnceSum = evaluatedOnceSum + value
end
expect(evaluatedOnceSum, 4)
expect(startCalls, 1)
expect(endCalls, 1)
expect(stepCalls, 1)

func zero_step() as int
    return 0
end

int caughtZeroStep = 0
int zeroStepBodyCount = 0
try
    for value in range(3, 0, zero_step())
        zeroStepBodyCount = zeroStepBodyCount + 1
    end
catch RangeError ignored
    caughtZeroStep = 1
end
expect(caughtZeroStep, 1)
expect(zeroStepBodyCount, 0)
