func walk(int n)
    if n == 0 then
        return
    elseif n < 0 then
        return
    else
        while n > 0 do
            n
            break
        end
    end

    for value in range(10)
        continue
    end

    for outer in range(2)
        for index, value in range(1, 10, 2)
            break 2
        end
    end
end
