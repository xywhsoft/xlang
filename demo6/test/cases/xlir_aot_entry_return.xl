extern "graph_probe_begin" func beginGraphProbe() as bool
extern "stack_graph_dropped" func dropped(int id, int count)
assert(beginGraphProbe())
string entryText = "entry" + " alive"
bool finallyRan = false
class EntryReturnMarker
    Stack<EntryReturnMarker> links
    destroy()
        assert(finallyRan and entryText == "entry alive")
        dropped(7, self.links.count())
    end
end
EntryReturnMarker entryMarker = EntryReturnMarker()
assert(entryMarker.links.push(entryMarker))
func main(...) as int
    try
        return 23
    finally
        finallyRan = true
    end
    return 0
end
