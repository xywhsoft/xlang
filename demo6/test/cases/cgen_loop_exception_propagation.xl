func loopThrow() as int
    int state = 0

    try
        for i in range(0, 3)
            state = state + 1
            if i == 1 then
                throw "loop boom"
            end
        end
        state = 1000
    catch e
        if e.message == "loop boom" then
            state = state + 10
        end
    finally
        state = state + 100
    end

    return state
end

func main(...) as int
    if loopThrow() != 112 then
        return 1
    end
    return 0
end
