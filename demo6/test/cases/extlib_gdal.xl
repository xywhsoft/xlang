import gdal

func main(...) as int
    // Drivers
    assert gdal.driver(0) == "GTiff", "driver gtiff"
    assert gdal.driver(3) == "GeoJSON", "driver geojson"

    // Data types
    assert gdal.datatype(0) == "Byte", "dtype byte"
    assert gdal.datatype(6) == "Float64", "dtype f64"

    // Projections
    assert gdal.projection(0) == "EPSG:4326", "proj wgs84"
    assert gdal.projection(1) == "EPSG:3857", "proj mercator"

    // Resampling
    assert gdal.resampling(0) == "nearest", "resamp nearest"
    assert gdal.resampling(1) == "bilinear", "resamp bilinear"

    // Haversine: London to Paris ~343km
    float d = gdal.haversine(51.5074, -0.1278, 48.8566, 2.3522)
    assert d > 340000.0, "haversine min"
    assert d < 345000.0, "haversine max"

    // Geometry types
    assert gdal.geometryType(0) == "Point", "geom point"
    assert gdal.geometryType(2) == "Polygon", "geom polygon"

    return 0
end
