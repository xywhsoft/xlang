int eventCount = 0
bool nested = false
string lastMessage = ""

func onLog(var event)
    eventCount += 1
    lastMessage = string(event["message"])
    assert int(event["level"]) == log.infoLevel
    assert string(event["logger"]) == "object-test"
    assert int(event["threadId"]) == 0
    if not nested then
        nested = true
        log.info("nested")
    end
end

func installLogger(func(var) handler) as LogSink
    Logger logger = log.create("object-test")
    logger.setLevel(log.traceLevel)
    assert logger.makeDefault()
    return logger.customSink("capture", handler, log.infoLevel)
end

LogSink sink = installLogger(onLog)
assert sink.name == "capture"
assert sink.getLevel() == log.infoLevel
sink.setLevel(log.debugLevel)
assert sink.getLevel() == log.debugLevel

log.info("outer")
assert eventCount == 2
assert lastMessage == "nested"

Logger wrapped = log.default()
assert wrapped.getLevel() == log.traceLevel
assert wrapped.removeSink(sink)
assert not wrapped.removeSink(sink)
log.info("after-remove")
assert eventCount == 2
wrapped.flush()
