extern "expect_i64" func expect(int actual, int expected)
extern "nc_probe_reset" func resetProbe()
extern "nc_probe_next_var" func nextProbe() as var
extern "nc_probe_count" func probeCount() as int

func makeValue(int value) as var
    return value
end

func makePair() as (var, int)
    return #2026-06-18#, 7
end

func count(...) as int
    return arg.length
end

var empty
var number = 123
var moment = #2026-06-18#
var textValue = "hello"
var values = [1, 2, 3]
var table = {"a": 1}
var unique = {1, 2, 3}

number = 456
moment = #12:30:59#

var fromFunc = makeValue(789)
var sameNumber = 456
var otherNumber = 789
var funcNumberA = makeValue(321)
var funcNumberB = makeValue(321)
var funcNumberC = makeValue(654)
var lowNumber = 100
var highNumber = 200
var textBefore = "abc"
var textAfter = "abd"
var dayBefore = #2026-06-18#
var dayAfter = #2026-06-19#
var sumNumber = lowNumber + highNumber
var joinedText = textBefore + textAfter
var trueValue = true
var falseValue = false
var negNumber = -lowNumber
var chooseLow = true
var chooseHigh = false
var conditionalPick = chooseLow ? lowNumber : highNumber
var conditionalTemp = chooseHigh ? makeValue(30) : makeValue(40)
auto mixedAuto = chooseLow ? 12 : "alt"
var mixedConditional = chooseHigh ? 12 : "alt"
auto mixedPlus = mixedAuto + 8
bool compareDecl = number == sameNumber
int orderDecl = lowNumber < highNumber
auto autoCompareDecl = highNumber >= lowNumber
bool approxDecl = textBefore ~= "abc"
auto autoApproxDecl = dayBefore ~= #2026-06-18#
var assignBinary = 0
assignBinary = lowNumber + highNumber
var assignConditional = 0
assignConditional = chooseHigh ? makeValue(50) : makeValue(60)
bool assignCompare = false
assignCompare = number == sameNumber
int assignOrder = 0
assignOrder = highNumber > lowNumber
bool assignApprox = false
assignApprox = textBefore ~= "abc"
auto first, _ = makePair()
auto _, pairInt = makePair()

expect(type(empty) == null, 1)
expect(type(number) == int, 1)
expect(type(moment) == time, 1)
expect(type(textValue) == string, 1)
expect(type(values) == array, 1)
expect(type(table) == dict, 1)
expect(type(unique) == set, 1)
expect(type(fromFunc) == int, 1)
expect(type(first) == time, 1)
expect(type(makeValue(10)) == int, 1)

expect(number == sameNumber, 1)
expect(number != otherNumber, 1)
expect(funcNumberA == funcNumberB, 1)
expect(funcNumberA != funcNumberC, 1)
expect(number == 456, 1)
expect(number != 789, 1)
expect(empty == null, 1)
expect(lowNumber < highNumber, 1)
expect(lowNumber <= highNumber, 1)
expect(highNumber > lowNumber, 1)
expect(highNumber >= lowNumber, 1)
expect(textBefore < textAfter, 1)
expect(dayBefore < dayAfter, 1)
expect(textBefore ~= "abc", 1)
expect(lowNumber ~= 100, 1)
expect(dayBefore ~= #2026-06-18#, 1)
expect(int(lowNumber + highNumber), 300)
expect(int(highNumber - lowNumber), 100)
expect(int(lowNumber * 2), 200)
expect(int(highNumber / 2), 100)
expect(int(highNumber % 150), 50)
expect(int(lowNumber & 15), 4)
expect(int(lowNumber | 3), 103)
expect(int(lowNumber ^ 7), 99)
expect(int(lowNumber << 1), 200)
expect(int(highNumber >> 2), 50)
expect(int(sumNumber), 300)
expect(string(joinedText) == "abcabd", 1)
expect(string(textBefore + textAfter) == "abcabd", 1)
expect(int(+lowNumber), 100)
expect(int(-lowNumber), -100)
expect(int(~lowNumber), -101)
expect(int(negNumber), -100)
expect(int(conditionalPick), 100)
expect(int(conditionalTemp), 40)
expect(int(chooseHigh ? makeValue(30) : makeValue(40)), 40)
expect(chooseHigh ? 1 : 2, 2)
expect(type(mixedAuto) == int, 1)
expect(int(mixedAuto), 12)
expect(type(mixedPlus) == int, 1)
expect(int(mixedPlus), 20)
expect(type(mixedConditional) == string, 1)
expect(string(mixedConditional) == "alt", 1)
expect(compareDecl, 1)
expect(orderDecl, 1)
expect(autoCompareDecl, 1)
expect(approxDecl, 1)
expect(autoApproxDecl, 1)
expect(int(assignBinary), 300)
expect(int(assignConditional), 60)
expect(assignCompare, 1)
expect(assignOrder, 1)
expect(assignApprox, 1)
expect(not empty, 1)
expect(not falseValue, 1)
expect(not lowNumber, 0)

int branchValue = 0
if falseValue then
    branchValue = 1
else
    branchValue = 2
end
expect(branchValue, 2)

if trueValue then
    branchValue = 3
end
expect(branchValue, 3)

int dynamicIfCompare = 0
if makeValue(10) == makeValue(10) then
    dynamicIfCompare = 1
end
expect(dynamicIfCompare, 1)

int dynamicIfLogical = 0
if makeValue(0) or makeValue(1) then
    dynamicIfLogical = 1
end
expect(dynamicIfLogical, 1)

int dynamicIfApprox = 0
if textBefore ~= "abc" then
    dynamicIfApprox = 1
end
expect(dynamicIfApprox, 1)

int dynamicElseifCompare = 0
if falseValue then
    dynamicElseifCompare = 1
elseif makeValue(20) == makeValue(20) then
    dynamicElseifCompare = 2
end
expect(dynamicElseifCompare, 2)

int dynamicElseifLogical = 0
if falseValue then
    dynamicElseifLogical = 1
elseif makeValue(0) or makeValue(1) then
    dynamicElseifLogical = 2
end
expect(dynamicElseifLogical, 2)

int dynamicElseifApprox = 0
if falseValue then
    dynamicElseifApprox = 1
elseif textBefore ~= "abc" then
    dynamicElseifApprox = 2
end
expect(dynamicElseifApprox, 2)

resetProbe()
int dynamicElseifSkip = 0
if trueValue then
    dynamicElseifSkip = 1
elseif nextProbe() then
    dynamicElseifSkip = 2
else
    dynamicElseifSkip = 3
end
expect(dynamicElseifSkip, 1)
expect(probeCount(), 0)

int dynamicWhileCompare = 0
while makeValue(dynamicWhileCompare) < makeValue(2)
    dynamicWhileCompare = dynamicWhileCompare + 1
end
expect(dynamicWhileCompare, 2)

int dynamicWhileLogical = 0
var dynamicWhileGate = true
while makeValue(1) and dynamicWhileGate
    dynamicWhileLogical = dynamicWhileLogical + 1
    dynamicWhileGate = false
end
expect(dynamicWhileLogical, 1)

int dynamicWhileApprox = 0
while textBefore ~= "abc"
    dynamicWhileApprox = dynamicWhileApprox + 1
    break
end
expect(dynamicWhileApprox, 1)

int dynamicDoCompare = 0
do
    dynamicDoCompare = dynamicDoCompare + 1
while makeValue(dynamicDoCompare) < makeValue(2) end
expect(dynamicDoCompare, 2)

int dynamicDoLogical = 0
var dynamicDoGate = true
do
    dynamicDoLogical = dynamicDoLogical + 1
    dynamicDoGate = false
while makeValue(1) and dynamicDoGate end
expect(dynamicDoLogical, 1)

int dynamicDoApprox = 0
do
    dynamicDoApprox = dynamicDoApprox + 1
while textBefore ~= "nope" end
expect(dynamicDoApprox, 1)

int loopCount = 0
var loopFlag = true
while loopFlag
    loopCount = loopCount + 1
    loopFlag = false
end
expect(loopCount, 1)

resetProbe()
expect(empty and nextProbe(), 0)
expect(probeCount(), 0)
resetProbe()
expect(lowNumber or nextProbe(), 1)
expect(probeCount(), 0)
resetProbe()
expect(lowNumber and nextProbe(), 1)
expect(probeCount(), 1)

expect(pairInt, 7)
expect(count(empty, number, moment, fromFunc, first, makeValue(10), #2026-06-18 12:30:59#), 7)
