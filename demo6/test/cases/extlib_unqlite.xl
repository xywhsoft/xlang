import unqlite



func main(...) as int
    // DB header
    auto hdr = unqlite.dbHeader(4096, 100)
    assert string.len(hdr) > 0, "header not empty"

    // Record encode/decode
    auto rec = unqlite.record("user:1", "alice")
    assert unqlite.recKey(rec) == "user:1", "rec key"
    assert unqlite.recValue(rec) == "alice", "rec value"

    auto rec2 = unqlite.record("k", "v")
    assert unqlite.recKey(rec2) == "k", "short key"
    assert unqlite.recValue(rec2) == "v", "short value"

    // Pages for record
    assert unqlite.pagesForRecord(10, 100, 4096) == 1, "small record 1 page"
    assert unqlite.pagesForRecord(100, 5000, 4096) == 2, "large record 2 pages"

    // Hash key
    auto h1 = unqlite.hashKey("test")
    auto h2 = unqlite.hashKey("test")
    auto h3 = unqlite.hashKey("other")
    assert h1 == h2, "same key same hash"
    assert h1 != h3, "different key different hash"
    assert h1 >= 0, "positive hash"

    // Cursor names
    assert unqlite.cursorName(0) == "FIRST", "first"
    assert unqlite.cursorName(1) == "LAST", "last"
    assert unqlite.cursorName(2) == "NEXT", "next"
    assert unqlite.cursorName(3) == "PREV", "prev"
    assert unqlite.cursorName(4) == "SEEK", "seek"
    assert unqlite.cursorName(9) == "UNKNOWN", "unknown cursor"

    // Transaction states
    assert unqlite.txState(0) == "NONE", "tx none"
    assert unqlite.txState(1) == "ACTIVE", "tx active"
    assert unqlite.txState(2) == "COMMITTED", "tx committed"
    assert unqlite.txState(3) == "ROLLED_BACK", "tx rolled back"
    assert unqlite.txState(9) == "UNKNOWN", "tx unknown"

    // Defaults
    assert unqlite.pageSize() == 4096, "page size"
    assert unqlite.maxKeySize() == 65535, "max key size"

    // Key validation
    assert unqlite.validKey("valid") == 1, "valid key"
    assert unqlite.validKey("") == 0, "empty key invalid"

    return 0
end
