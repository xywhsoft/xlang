import hcl



func main(...) as int
    auto conf = "variable \"region\" {\n  type = string\n  default = \"us-east-1\"\n}\n\nresource \"instance\" \"web\" {\n  ami = \"ami-12345\"\n  count = 3\n  enabled = true\n  ratio = 0.75\n}\n"

    // Get string attribute
    assert hcl.get(conf, "default") == "us-east-1", "get default"
    assert hcl.get(conf, "ami") == "ami-12345", "get ami"

    // Get int
    assert hcl.getInt(conf, "count") == 3, "get count"

    // Get bool
    assert hcl.getBool(conf, "enabled") == true, "get enabled"

    // Get float
    auto r = hcl.getFloat(conf, "ratio")
    assert r > 0.74 and r < 0.76, "get ratio"

    // Has
    assert hcl.has(conf, "ami"), "has ami"
    assert not hcl.has(conf, "missing"), "not has missing"

    // Count blocks
    assert hcl.countBlocks(conf, "variable") == 1, "1 variable block"
    assert hcl.countBlocks(conf, "resource") == 1, "1 resource block"

    // Block labels
    assert hcl.blockLabel(conf, "variable", 0) == "region", "variable label"
    assert hcl.blockLabel(conf, "resource", 0) == "instance", "resource label"

    // Validate
    assert hcl.validate(conf), "valid hcl"
    assert not hcl.validate("bad { unclosed\n"), "invalid hcl"

    // Count attrs
    assert hcl.countAttrs(conf) == 6, "6 attrs"

    // Syntax-aware parsing: labels, comments and composite values are not
    // confused with line-oriented text matches.
    auto advanced = "# heading\nresource \"aws_instance\" \"web\" {\n  name = \"web = primary\" // inline\n  tags = {\n    role = \"api\"\n  }\n  nested {\n    enabled = false\n  }\n}\n/* trailing */\n"
    assert hcl.validate(advanced), "advanced valid"
    assert hcl.countBlocks(advanced, "resource") == 1, "advanced resource"
    assert hcl.countBlocks(advanced, "nested") == 1, "nested block"
    assert hcl.blockLabelCount(advanced, "resource", 0) == 2, "two labels"
    assert hcl.blockLabelAt(advanced, "resource", 0, 1) == "web", "second label"
    assert hcl.get(advanced, "name") == "web = primary", "string value"
    assert hcl.getRaw(advanced, "tags") == "{\n    role = \"api\"\n  }", "raw object expression"
    assert hcl.countAttrs(advanced) == 3, "nested attrs"
    assert not hcl.validate("resource \"bad\" { name = \"unterminated }"), "unterminated string"

    return 0
end
