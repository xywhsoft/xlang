extern "expect_i64" func expect(int actual, int expected)

union Payload
    int i
    c_double d
end

Payload p
expect(p.i, 0)
p.i = 42
expect(p.i, 42)
expect(string(type(p)) == "Payload", 1)
p.d = 3.0
expect(int(p.d), 3)

class Packet
    int tag
    union
        int code
        c_double ratio
    end
end

Packet pkt = Packet()
pkt.tag = 7
pkt.code = 11
expect(pkt.tag, 7)
expect(pkt.code, 11)
pkt.ratio = 4.0
expect(int(pkt.ratio), 4)

class Envelope
    Payload payload
end

Envelope e = Envelope()
e.payload.i = 9
expect(e.payload.i, 9)
expect(string(type(e)) == "Envelope", 1)

array<Payload> payloads = [p]
expect(string(type(payloads)) == "array<Payload>", 1)
