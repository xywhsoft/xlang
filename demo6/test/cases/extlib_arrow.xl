import arrow

func main(...) as int
    // Data types
    assert arrow.dataType(0) == "null", "type null"
    assert arrow.dataType(5) == "int64", "type int64"
    assert arrow.dataType(12) == "string", "type string"
    assert arrow.dataType(19) == "struct", "type struct"

    // Buffer types
    assert arrow.bufferType(0) == "validity", "buf validity"
    assert arrow.bufferType(2) == "data", "buf data"

    // IPC formats
    assert arrow.ipcFormat(0) == "streaming", "ipc stream"
    assert arrow.ipcFormat(1) == "file", "ipc file"

    // Compute functions
    assert arrow.computeFunc(0) == "add", "comp add"
    assert arrow.computeFunc(4) == "sum", "comp sum"
    assert arrow.computeFunc(13) == "cast", "comp cast"

    // Aligned size: 100 bytes => 128 (64-byte aligned)
    assert arrow.alignedSize(100) == 128, "align 100"
    assert arrow.alignedSize(64) == 64, "align 64"
    assert arrow.alignedSize(1) == 64, "align 1"

    // Memory pools
    assert arrow.memoryPool(0) == "system", "pool system"
    assert arrow.memoryPool(1) == "jemalloc", "pool jemalloc"

    // Flight actions
    assert arrow.flightAction(0) == "do_get", "flight get"
    assert arrow.flightAction(5) == "get_flight_info", "flight info"

    return 0
end
