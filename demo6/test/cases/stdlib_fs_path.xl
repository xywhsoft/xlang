auto parts = path.parse("/tmp/你.txt", 1)
assert parts.root == "/" and parts.parent == "/tmp"
assert parts.name == "你.txt" and parts.stem == "你" and parts.ext == ".txt"
assert parts.rootKind == 1 and parts.flags == 3
auto windows = path.parse(r"C:\work\a.txt", 2)
assert windows.rootKind == 4 and windows.name == "a.txt"
assert path.clean("/a/../b//c", 1) == "/b/c"
assert path.normalize("/a/../b", 1) == "/b"
assert path.relative("/a/b", "/a/c/d", 1) == "../c/d"
assert path.build(["/a", "b", "..", "c"], 1) == "/a/c"
assert path.nameExt(path.join("build", "test", "x.txt")) == "x.txt"
assert path.name("x.txt") == "x.txt" and path.stem("x.txt") == "x"
assert path.ext("x.txt") == ".txt"
assert path.parent("build/test/x.txt") == path.dir("build/test/x.txt")
assert path.withExt("x.txt", "bin") == "x.bin"
assert path.withName("x.txt", "y.bin") == "y.bin"
assert path.isAbs(path.cwd()) and path.isRooted(path.cwd())
assert path.isRoot(path.sep()) or path.isRoot(path.parse(path.cwd()).root)
assert path.isLocal("a/../b", 1) and not path.isLocal("../b", 1)
assert path.isSafeEntry("a/b.txt") and not path.isSafeEntry("CON")
assert not path.isSafeEntry("a/../b")
assert path.listSep().length == 1 and path.sep().length == 1
assert path.home().length > 0 and path.temp().length > 0
assert path.executable().length > 0 and path.appDir().length > 0
assert path.abs("") == path.cwd()
assert path.real("build/test").length > 0
assert path.rel(path.cwd(), path.abs("build/test")).length > 0
string cwd = path.cwd()
assert path.setCwd(cwd)
auto iterator = path.components("/a/../b", 1)
int count = 0
for component in iterator
    if component != null then
        assert component.text.length > 0 and component.kind >= 1 and component.kind <= 4
    else
        assert false, "successful path iteration must return an item"
    end
    count += 1
end
assert count == 4
bool ended = false
try
    iterator.text
catch e
    ended = true
end
assert ended
for operation in range(4)
    bool rejected = false
    try
        if operation == 0 then
            path.clean("a\0b")
        elseif operation == 1 then
            path.parse("a\0b")
        elseif operation == 2 then
            path.build(["a", 1])
        else
            path.components("a", 3)
        end
    catch e
        rejected = true
    end
    assert rejected
end
print("fs path ok")
