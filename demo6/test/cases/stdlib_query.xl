extern "expect_str" func expectStr(string actual, string expected)

assert query.valid("a=1&b=hello+world"), "query should be valid"
assert !query.valid("=value"), "empty key should be invalid"

expectStr(query.encode("hello world/x"), "hello+world%2Fx")
expectStr(query.decode("hello+world%2Fx"), "hello world/x")

expectStr(query.encode("中文"), "%E4%B8%AD%E6%96%87")
expectStr(query.decode("%E4%B8%AD%E6%96%87"), "中文")

expectStr(query.pair("hello world", "x/y"), "hello+world=x%2Fy")
expectStr(query.append("", "a", "1"), "a=1")
expectStr(query.append("a=1", "b", "hello world"), "a=1&b=hello+world")
