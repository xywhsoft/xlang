class Marker
    int id = 0
    create(int id)
        self.id = id
    end
    destroy()
        println(self.id)
    end
end

Marker first = Marker(1)
Marker second = Marker(2)

func main(...) as int
    assert first.id == 1 and second.id == 2, "globals must remain live through main"
    println("module-ready")
    return 0
end
