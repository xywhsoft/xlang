import murmur3

func hex(Buffer data) as string
    return codec.hexEncodeBytes(data.data(), c_size(data.len()))
end

func main(...) as int
    assert murmur3.version() == "3.0.0"
    assert murmur3.hash32("") == 0 and murmur3.hash32("", 42) == 142593372
    assert murmur3.hash128Hex("") == "00000000000000000000000000000000"
    assert murmur3.hash32("abc") == 3017643002
    assert murmur3.hash32("abc", 4294967295) == 4236296879
    assert murmur3.hash32Hex("abc") == "fa93ddb3", "32-bit bytes are little-endian"
    assert hex(murmur3.hash32Bytes("abc")) == "FA93DDB3"
    assert murmur3.hash128Hex("abc", 42) == "d6f7cfb39f08850d303d35422b711075"
    assert hex(murmur3.hash128Bytes("abc", 42)) == "D6F7CFB39F08850D303D35422B711075"

    // 文本长度是 UTF-8 字节数，不是字符数；答案来自独立参考实现。
    string text = "你好🌍尾"
    Buffer bytes = Buffer()
    bytes.append(text)
    assert bytes.len() == 13
    assert murmur3.hash32(text) == 860641026 and murmur3.hash32(bytes) == 860641026
    assert murmur3.hash32Hex(bytes) == "02574c33"
    assert hex(murmur3.hash32Bytes(bytes)) == "02574C33"
    assert murmur3.hash128Hex(text) == "c9d0f49f430181d18ae93978fc73cec5"
    assert murmur3.hash128Hex(bytes) == murmur3.hash128Hex(text)
    assert hex(murmur3.hash128Bytes(bytes)) == "C9D0F49F430181D18AE93978FC73CEC5"

    // 覆盖全部字节值，特别是 NUL 和非 UTF-8 字节。
    Buffer binary = Buffer()
    for i in range(256)
        binary.appendByte((i * 37 + 11) % 256)
    end
    assert murmur3.hash32(binary, 42) == 4199235228
    assert murmur3.hash128Hex(binary, 42) == "e831a644bcc04895cad11db61d7abdcb"
    auto stream = murmur3.hasher(42)
    stream.update(binary)
    assert stream.digestHex() == "e831a644bcc04895cad11db61d7abdcb"
    assert hex(stream.digestBytes()) == "E831A644BCC04895CAD11DB61D7ABDCB"
    assert stream.valid and stream.inputBytes == uint64(256)
    assert stream.reset() and stream.inputBytes == uint64(0)
    assert stream.digestHex() == murmur3.hash128Hex("", 42)

    // clone 是独立快照，读摘要不终结流；已返回的字符串不随后续调用改变。
    stream.update("a")
    string prefix = stream.digestHex()
    auto branch = stream.clone()
    stream.update("bc")
    branch.update("x")
    assert stream.digestHex() == murmur3.hash128Hex("abc", 42)
    assert branch.digestHex() == murmur3.hash128Hex("ax", 42)
    assert stream.inputBytes == uint64(3) and branch.inputBytes == uint64(2)
    for i in range(32)
        assert murmur3.hash128Hex("other", i) != prefix
    end
    assert prefix == murmur3.hash128Hex("a", 42)

    // 超限 update 不接收部分输入；失败保持到 reset，clone 不绕过失败状态。
    auto limited = murmur3.hasher(42, 3)
    limited.update("abc")
    for operation in range(3)
        bool caught = false
        try
            if operation == 0 then
                limited.update("d")
            elseif operation == 1 then
                limited.digestHex()
            else
                limited.clone()
            end
        catch RangeError e
            caught = true
        end
        assert caught and limited.inputBytes == uint64(3)
    end
    assert limited.reset()
    limited.update("abc")
    assert limited.digestHex() == murmur3.hash128Hex("abc", 42)

    for mode in range(2)
        int seed = -1
        if mode == 1 then
            seed = 4294967296
        end
        for operation in range(3)
            bool caught = false
            try
                if operation == 0 then
                    murmur3.hash32("", seed)
                elseif operation == 1 then
                    murmur3.hasher(seed)
                else
                    murmur3.hashFile128Hex("", seed = seed)
                end
            catch ValueError e
                caught = true
            end
            assert caught, "seed must be checked before narrowing"
        end
        for operation in range(3)
            bool caught = false
            try
                if operation == 0 then
                    murmur3.hasher(maxInput = -mode)
                elseif operation == 1 then
                    murmur3.hashFile32("", maxInput = -mode)
                else
                    murmur3.hashFile128Hex("", maxInput = -mode)
                end
            catch ValueError e
                caught = true
            end
            assert caught
        end
    end
    bool caught = false
    try
        murmur3.Murmur3Hasher(null)
    catch RuntimeError e
        assert string.contains(e.message, "invalid murmur3 handle")
        caught = true
    end
    assert caught
    return 0
end
