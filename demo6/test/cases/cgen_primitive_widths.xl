extern "expect_i64" func expect(int actual, int expected)

int8 i8 = -8
uint8 u8 = 8
int16 i16 = -16
uint16 u16 = 16
int32 i32 = -32
uint32 u32 = 32
int64 i64 = -64
uint64 u64 = 64
float32 f32 = 1.5
float64 f64 = 2.5

expect(i8, -8)
expect(u8, 8)
expect(i16, -16)
expect(u16, 16)
expect(i32, -32)
expect(u32, 32)
expect(i64, -64)
expect(u64, 64)
expect(f32 == 1.5, 1)
expect(f64 == 2.5, 1)
