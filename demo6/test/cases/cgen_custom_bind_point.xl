class BorrowedBox
    native point handle
    extern "borrowed_box_close" destroy()
    extern "borrowed_box_value" func value() as int
end

extern "make_borrowed_box" func makeBox(int value) as point
extern "expect_i64" func expect(int actual, int expected)
extern "borrowed_close_count" func closeCount() as int

func exercise()
    auto box = BorrowedBox(makeBox(55))
    expect(box.value(), 55)
    expect(closeCount(), 0)
end

exercise()
expect(closeCount(), 1)
