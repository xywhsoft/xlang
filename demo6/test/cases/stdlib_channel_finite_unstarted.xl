import concurrent

class HeldDeadline<T>
    private native point handle
    static extern "xl6ChannelDeadlineReceiveForLanguageV1" func prepare(channel<T> pipe, int milliseconds) as HeldDeadline<T>
    extern "xl6ChannelDeadlineReceiveBuilderDestroyV1" destroy()
    extern "xl6ChannelDeadlineReceiveResultLanguageV1" @nonblocking func result() as ChannelReceiveResult<T>
end
class HeldSelection
    private native point handle
    static extern "xl6ChannelDeadlineSelectForLanguageV1" func prepare(array<ChannelCase> cases, int milliseconds) as HeldSelection
    extern "xl6ChannelDeadlineSelectBuilderDestroyV1" destroy()
end

channel<string> pipe = channel::<string>(1)
auto builder = HeldDeadline::<string>.prepare(pipe, 30000)
auto result = builder.result()
var alias = builder
auto receiving = ChannelCase.receive(pipe)
auto selection = HeldSelection.prepare([receiving], 30000)
println("unstarted private builders retire without starting or waiting")
