import siphash128

func same(Buffer left, Buffer right) as bool
    return left.compare(right) == 0
end

bytes key = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f"
assert siphash128.KEY_LENGTH == 16 and siphash128.DIGEST_LENGTH == 16
Buffer empty = siphash128.hash(b"", key)
assert empty.len() == 16
assert codec.hexEncodeBytes(empty.data(), c_size(empty.len())) == "A3817F04BA25A8E66DF67214C7550293"
Buffer one = siphash128.hash(b"\x00", key)
assert codec.hexEncodeBytes(one.data(), c_size(one.len())) == "DA87C1D86B99AF44347659119B22FC45"

string text = "A\0你"
bytes binary = b"A\x00你"
Buffer raw = Buffer()
assert raw.appendByte(65)
assert raw.appendByte(0)
assert raw.appendByte(228)
assert raw.appendByte(189)
assert raw.appendByte(160)
assert same(siphash128.hash(text, key), siphash128.hash(binary, key))
assert same(siphash128.hashBuffer(raw, key), siphash128.hash(text, key))
assert same(siphash128.hash(binary, key, 2), siphash128.hash(b"A\x00", key))
assert same(siphash128.hashBuffer(raw, key, 99), siphash128.hash(text, key))
assert same(siphash128.hash(text, key, 0), siphash128.hash(b"", key))

bool badKey = false
try
    siphash128.hash("data", b"short")
catch e
    badKey = e.kind == "ValueError"
end
assert badKey
bool badHasherKey = false
try
    siphash128.hasher(b"short")
catch e
    badHasherKey = e.kind == "ValueError"
end
assert badHasherKey
bool badSize = false
try
    siphash128.hash("data", key, -2)
catch e
    badSize = e.kind == "RangeError"
end
assert badSize

auto stream = siphash128.hasher(key)
assert stream.inputBytes() == uint64(0)
stream.update("A\0")
stream.update(b"你")
assert stream.inputBytes() == uint64(5)
assert same(stream.digest(), siphash128.hash(text, key))
assert same(stream.digest(), siphash128.hash(text, key))
auto copy = stream.clone()
copy.update(b"!")
assert same(copy.digest(), siphash128.hash(b"A\x00你!", key))
assert same(stream.digest(), siphash128.hash(text, key))
stream.reset()
assert stream.inputBytes() == uint64(0)
stream.updateBuffer(raw)
assert same(stream.digest(), siphash128.hash(text, key))
bool badUpdate = false
try
    stream.update(b"x", -2)
catch e
    badUpdate = e.kind == "RangeError"
end
assert badUpdate
assert same(stream.digest(), siphash128.hash(text, key))

bool rejectedNullHandle = false
try
    auto invalid = siphash128.SipHasher128(point(null))
    invalid.digest()
catch e
    rejectedNullHandle = e.kind == "RuntimeError"
end
assert rejectedNullHandle
