extern "expect_i64" func expect(int actual, int expected)

extern "xl6_c_echo_char" func echoChar(c_char value) -> c_char
extern "xl6_c_echo_schar" func echoSChar(c_schar value) -> c_schar
extern "xl6_c_echo_uchar" func echoUChar(c_uchar value) -> c_uchar
extern "xl6_c_echo_short" func echoShort(c_short value) -> c_short
extern "xl6_c_echo_ushort" func echoUShort(c_ushort value) -> c_ushort
extern "xl6_c_echo_int" func echoInt(c_int value) -> c_int
extern "xl6_c_echo_uint" func echoUInt(c_uint value) -> c_uint
extern "xl6_c_echo_long" func echoLong(c_long value) -> c_long
extern "xl6_c_echo_ulong" func echoULong(c_ulong value) -> c_ulong
extern "xl6_c_echo_longlong" func echoLongLong(c_longlong value) -> c_longlong
extern "xl6_c_echo_ulonglong" func echoULongLong(c_ulonglong value) -> c_ulonglong
extern "xl6_c_echo_size" func echoSize(c_size value) -> c_size
extern "xl6_c_echo_ssize" func echoSSize(c_ssize value) -> c_ssize
extern "xl6_c_echo_ptrdiff" func echoPtrDiff(c_ptrdiff value) -> c_ptrdiff
extern "xl6_c_echo_intptr" func echoIntPtr(c_intptr value) -> c_intptr
extern "xl6_c_echo_uintptr" func echoUIntPtr(c_uintptr value) -> c_uintptr
extern "xl6_c_not_bool" func notBool(c_bool value) -> c_bool
extern "xl6_c_echo_float" func echoFloat(c_float value) -> c_float
extern "xl6_c_echo_double" func echoDouble(c_double value) -> c_double
extern "xl6_c_echo_wchar" func echoWChar(c_wchar value) -> c_wchar

expect(echoChar(65), 65)
expect(echoSChar(-5), -5)
expect(echoUChar(250), 250)
expect(echoShort(-123), -123)
expect(echoUShort(456), 456)
expect(echoInt(-789), -789)
expect(echoUInt(789), 789)
expect(echoLong(-321), -321)
expect(echoULong(321), 321)
expect(echoLongLong(-987), -987)
expect(echoULongLong(987), 987)
expect(echoSize(1234), 1234)
expect(echoSSize(-1234), -1234)
expect(echoPtrDiff(-77), -77)
expect(echoIntPtr(-88), -88)
expect(echoUIntPtr(88), 88)
expect(echoWChar(65), 65)

if notBool(false) then
    expect(1, 1)
else
    expect(0, 1)
end

expect(int(echoFloat(3.0)), 3)
expect(int(echoDouble(4.0)), 4)
