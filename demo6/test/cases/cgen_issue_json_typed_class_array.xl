class Item
    derive value
    derive json

    int id = 0
    string text = ""
end

class Store
    derive value
    derive json

    array<Item> items = array[]
end

Item first
first.id = 1
first.text = "x"

Item second
second.id = 2
second.text = "y"

array<Item> items = array[first, second]
assert json.stringify(items) == "[{\"id\":1,\"text\":\"x\"},{\"id\":2,\"text\":\"y\"}]", "typed class array should stringify as json array"

Store store
store.items = items

string packed = json.stringify(store)
assert packed == "{\"items\":[{\"id\":1,\"text\":\"x\"},{\"id\":2,\"text\":\"y\"}]}", "typed class array field should stringify inside class"

Store unpacked = json.parse::<Store>(packed)
assert json.stringify(unpacked) == packed, "typed class array field should parse from json"
