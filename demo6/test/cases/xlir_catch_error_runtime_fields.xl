int observed = 0
try
    throw "payload fields"
catch e
    string domain = e.domain
    string operation = e.operation
    string data = e.data
    int systemCode = e.systemCode
    assert domain == "xlang"
    assert operation == "throw"
    assert data == "Error"
    assert systemCode == 0
    observed = 1
end
assert observed == 1
