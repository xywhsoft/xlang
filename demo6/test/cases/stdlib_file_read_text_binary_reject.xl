string binaryPath = "build/test/file_read_text_binary.bin"
bytes bytes = b"A\0BC"
assert file.writeBytes(binaryPath, bytes)

assert file.readText(binaryPath, 1) == "A\0BC", "NUL is valid UTF-8 text data"
assert file.writeBytes(binaryPath, b"\xff")
bool caught = false
try
    file.readText(binaryPath, 1)
catch e
    caught = true
end
assert caught, "strict UTF-8 decoding rejects malformed bytes, not NUL"
assert file.delete(binaryPath)
