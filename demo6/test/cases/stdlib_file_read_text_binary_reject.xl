string binaryPath = "build/test/file_read_text_binary.bin"
Buffer bytes = Buffer()
assert bytes.appendByte(65)
assert bytes.appendByte(0)
assert bytes.appendByte(66)
assert bytes.appendByte(67)
assert file.writeBytes(binaryPath, bytes)

bool caught = false

try
    string text = file.readText(binaryPath)
    assert false, "file.readText should reject binary data instead of returning: " + text
catch e
    if e.kind == "FileError" and string.contains(e.message, "NUL") then
        caught = true
    end
end

assert caught, "file.readText should reject text containing NUL bytes"
