extern "string_outcome_default" func stringOutcomeDefault() as string

class OutcomeRecord
    derive string
    int value = 41
end
class OutcomeCustom
    int value = 41
    func __toString__() as string
        return "custom" + string(self.value)
    end
end
OutcomeRecord outcomeRecord = OutcomeRecord()
OutcomeCustom outcomeCustom = OutcomeCustom()

func concatPair(string left, string right) as string
    return left + right
end

func concatNested(string left, string right) as string
    return (left + right) + (right + left)
end

func concatInterpolation(string left, string right) as string
    return f"{left}{right}"
end

func concatCompound(string left, string right) as string
    left += right + right
    return left
end

func concatDefault(string left, string right = stringOutcomeDefault()) as string
    return left + right
end

func concatInout(string left, string right) as string
    return left + right + right
end

func allocationLiteral(string left, string right) as string
    return "literal"
end
func allocationInteger(string left, string right) as string
    return string(41)
end
func allocationPrefix(string left, string right) as string
    return f"prefix{left}"
end
func allocationEmpty(string left, string right) as string
    string empty
    return empty
end
func allocationBool(string left, string right) as string
    return string(true)
end
func allocationUnsigned(string left, string right) as string
    return string(uint64(41))
end
func allocationFloat(string left, string right) as string
    return string(41.5)
end
func allocationTime(string left, string right) as string
    return string(time(0))
end
func allocationType(string left, string right) as string
    return string(type(41))
end
func allocationDynamic(string left, string right, var value) as string
    return string(value)
end
func allocationDerived(string left, string right) as string
    return string(outcomeRecord)
end
func allocationNullable(string left, string? right) as string
    string? copy = right
    return copy ?? left
end
func allocationProtocol(string left, string right) as string
    return string(outcomeCustom)
end

export "string_outcome_keep" func stringOutcomeKeep() as int
    string a = concatPair("first", "suffix")
    string b = concatNested("first", "suffix")
    string c = concatInterpolation("first", "suffix")
    string d = concatCompound("first", "suffix")
    func(string) as string callback = concatDefault
    string e = callback("first")
    a = concatInout(a, "suffix")
    string f = allocationLiteral("first", "suffix")
    string g = allocationInteger("first", "suffix")
    string h = allocationPrefix("first", "suffix")
    string i = allocationEmpty("first", "suffix")
    string j = allocationBool("first", "suffix")
    string k = allocationUnsigned("first", "suffix")
    string l = allocationFloat("first", "suffix")
    string m = allocationTime("first", "suffix")
    string n = allocationType("first", "suffix")
    string o = allocationDynamic("first", "suffix", 41)
    string p = allocationDerived("first", "suffix")
    string q = allocationNullable("first", "suffix")
    string r = allocationProtocol("first", "suffix")
    return a.length + b.length + c.length + d.length + e.length
end
