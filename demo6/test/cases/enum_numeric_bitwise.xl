// Generic nominal bitwise rules, all integer backing widths; no network dependency.
enum S8 as int8
    zero = 0
    one = 1
    high = -128
    full = -1
end

const S8 globalS8 = S8.one | S8.high

func combineS8(S8 a, S8 b) as S8
    return a | b
end

func checkS8(S8 a, S8 b)
    auto combined = combineS8(a, b)
    assert globalS8 == combined
    assert int(combined) == -127
    assert (combined & a) == a
    assert (combined ^ a) == b
    auto inverted = ~a
    assert int(inverted) == -2
    assert (~S8.zero) == S8.full
    assert (~S8.full) == S8.zero
    assert ((~a) & a) == S8.zero
    assert (~(~a)) == a
    S8 changed = a
    changed |= b
    assert changed == combined
    changed &= a
    assert changed == a
    changed ^= a
    assert changed == S8.zero
    var boxed = combined
    assert (boxed as S8) == combined
    array<S8> values = [combined, ~a]
    assert values[0] == combined and values[1] == inverted
    const S8 constant = S8.one | S8.high
    assert constant == combined
end

enum U8 as uint8
    zero = 0
    one = 1
    high = 128
    full = 255
end

const U8 globalU8 = U8.one | U8.high

func combineU8(U8 a, U8 b) as U8
    return a | b
end

func checkU8(U8 a, U8 b)
    auto combined = combineU8(a, b)
    assert globalU8 == combined
    assert uint64(combined) == 129
    assert (combined & a) == a
    assert (combined ^ a) == b
    auto inverted = ~a
    assert uint64(inverted) == 254
    assert (~U8.zero) == U8.full
    assert (~U8.full) == U8.zero
    assert ((~a) & a) == U8.zero
    assert (~(~a)) == a
    U8 changed = a
    changed |= b
    assert changed == combined
    changed &= a
    assert changed == a
    changed ^= a
    assert changed == U8.zero
    var boxed = combined
    assert (boxed as U8) == combined
    array<U8> values = [combined, ~a]
    assert values[0] == combined and values[1] == inverted
    const U8 constant = U8.one | U8.high
    assert constant == combined
end

