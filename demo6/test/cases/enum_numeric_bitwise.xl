checkS8(S8.one, S8.high)
checkU8(U8.one, U8.high)
checkS16(S16.one, S16.high)
checkU16(U16.one, U16.high)
checkS32(S32.one, S32.high)
checkU32(U32.one, U32.high)
checkS64(S64.one, S64.high)
checkU64(U64.one, U64.high)
println("numeric enum bitwise: eight backing widths, nominal return, const, arrays, box and compound assignment ok")

