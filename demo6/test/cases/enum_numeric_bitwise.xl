enum U64 as uint64
    zero = 0
    one = 1
    high = 9223372036854775808
    full = 18446744073709551615
end

const U64 globalU64 = U64.one | U64.high

func combineU64(U64 a, U64 b) as U64
    return a | b
end

func checkU64(U64 a, U64 b)
    auto combined = combineU64(a, b)
    assert globalU64 == combined
    assert uint64(combined) == 9223372036854775809
    assert (combined & a) == a
    assert (combined ^ a) == b
    auto inverted = ~a
    assert uint64(inverted) == 18446744073709551614
    assert (~U64.zero) == U64.full
    assert (~U64.full) == U64.zero
    assert ((~a) & a) == U64.zero
    assert (~(~a)) == a
    U64 changed = a
    changed |= b
    assert changed == combined
    changed &= a
