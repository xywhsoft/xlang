extern "expect_i64" func expect(int actual, int expected)

func add(int left, int right) as int
    return left + right
end

func(int, int) as int fn = add
array<func(int, int) as int> funcs = array[fn]
list<func(int, int) as int> listed = list[0: fn]
set<func(int, int) as int> unique = set{fn}
dict<func(int, int) as int> named = dict{"add": fn}
func(int, int) as int first = funcs[0]
var boxed = first
var dynamic = boxed(20, 22)
var loopValue = null

for each in funcs
    loopValue = each(3, 4)
end

for index, each in listed
    loopValue = each(index, 5)
end

for each in unique
    loopValue = each(4, 6)
end

for key, each in named
    loopValue = each(5, 6)
end

expect(first(1, 2), 3)
expect(int(dynamic), 42)
expect(int(loopValue), 11)
