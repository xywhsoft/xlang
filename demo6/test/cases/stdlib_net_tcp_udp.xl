func requireLine(string name, bool ok)
    assert ok, name
    println(name + "=ok")
end

TcpServer server = tcp.listen(0)
int tcpPort = int(server.port())
future<TcpStream> accepted = server.acceptAsync()
assert accepted != null, "tcp_accept_future"
TcpStream client = tcp.connect("127.0.0.1", tcpPort, 8000)
TcpStream peer = await accepted

future<string> received = peer.recvAsync()
assert received != null, "tcp_recv_future"
bool sent = client.send("ping")
bool drained = client.drain(8000)
string request = await received
bool replied = peer.send("pong")
bool replyDrained = peer.drain(3000)
string reply = client.recv(8000)

Buffer tcpBytes = Buffer()
tcpBytes.appendByte(0)
tcpBytes.appendByte(1)
tcpBytes.appendByte(128)
tcpBytes.appendByte(255)
bool tcpBytesSent = client.sendBytes(tcpBytes.data(), c_size(tcpBytes.len()))
bool tcpBytesDrained = client.drain(8000)
Buffer tcpBytesRecv = peer.recvBytes(8000)
bool tcpNulSent = client.send("a\0b")
bool tcpNulDrained = client.drain(8000)
Buffer tcpNulRecv = peer.recvBytes(8000)

client.close()
peer.close()

requireLine(
    "tcp",
    tcpPort > 0 and
        sent and drained and request == "ping" and
        replied and replyDrained and reply == "pong" and
        tcpBytesSent and tcpBytesDrained and
        tcpBytesRecv.len() == 4 and
        tcpBytesRecv[0] == 0 and
        tcpBytesRecv[1] == 1 and
        tcpBytesRecv[2] == 128 and
        tcpBytesRecv[3] == 255 and
        tcpNulSent and tcpNulDrained and
        tcpNulRecv.len() == 3 and
        tcpNulRecv[0] == 97 and tcpNulRecv[1] == 0 and tcpNulRecv[2] == 98
)

TcpServer asyncServer = tcp.listen(0)
int asyncPort = int(asyncServer.port())
future<TcpStream> asyncAccepted = asyncServer.acceptAsync()
future<TcpStream> asyncConnected = tcp.connectAsync("127.0.0.1", asyncPort, 8000)
assert asyncAccepted != null, "tcp_async_accept_future"
assert asyncConnected != null, "tcp_async_connect_future"
TcpStream asyncClient = await asyncConnected
TcpStream asyncPeer = await asyncAccepted

future<string> asyncReceived = asyncPeer.recvAsync()
assert asyncReceived != null, "tcp_async_recv_future"
bool asyncSent = asyncClient.send("as\0ync")
future<bool> asyncDrainFuture = asyncClient.drainAsync()
assert asyncDrainFuture != null, "tcp_async_drain_future"
bool asyncDrained = await asyncDrainFuture
string asyncRequest = await asyncReceived
asyncClient.close()
asyncPeer.close()

requireLine("tcp_async", asyncPort > 0 and asyncSent and asyncDrained and asyncRequest == "as\0ync")

UdpSocket left = udp.bind(0)
UdpSocket right = udp.bind(0)
int leftPort = left.port()
int rightPort = right.port()
time.sleep(10)
bool udpSent = left.send("127.0.0.1", uint16(rightPort), "hello")
UdpPacket packet = right.recv(8000)
bool udpReplySent = right.send("127.0.0.1", uint16(leftPort), "reply")
UdpPacket replyPacket = left.recv(8000)

Buffer udpBytes = Buffer()
udpBytes.appendByte(0)
udpBytes.appendByte(2)
udpBytes.appendByte(127)
udpBytes.appendByte(255)
bool udpBytesSent = left.sendBytes("127.0.0.1", uint16(rightPort), udpBytes.data(), c_size(udpBytes.len()))
UdpPacket bytesPacket = right.recv(8000)
Buffer udpBytesRecv = bytesPacket.bytes()
bool udpNulSent = left.send("127.0.0.1", uint16(rightPort), "a\0b")
UdpPacket nulPacket = right.recv(8000)
Buffer udpNulBytes = nulPacket.bytes()

requireLine(
    "udp",
    leftPort > 0 and rightPort > 0 and
        udpSent and packet.text() == "hello" and
        udpReplySent and replyPacket.text() == "reply" and
        udpBytesSent and
        udpBytesRecv.len() == 4 and
        udpBytesRecv[0] == 0 and
        udpBytesRecv[1] == 2 and
        udpBytesRecv[2] == 127 and
        udpBytesRecv[3] == 255 and
        udpNulSent and udpNulBytes.len() == 3 and
        udpNulBytes[0] == 97 and udpNulBytes[1] == 0 and udpNulBytes[2] == 98
)

UdpSocket asyncLeft = udp.bind(0)
UdpSocket asyncRight = udp.bind(0)
int asyncLeftPort = asyncLeft.port()
int asyncRightPort = asyncRight.port()
future<UdpPacket> packetFuture = asyncRight.recvAsync()
assert packetFuture != null, "udp_async_recv_future"
time.sleep(10)
bool asyncUdpSent = asyncLeft.send("127.0.0.1", uint16(asyncRightPort), "async-udp")
UdpPacket asyncPacket = await packetFuture

requireLine("udp_async", asyncLeftPort > 0 and asyncRightPort > 0 and asyncUdpSent and asyncPacket.text() == "async-udp")
