// Local adapter metadata only; no DNS, sockets or other network service.
func detachedInterface() as NetInterface
    auto snapshot = net.interfaces()
    assert snapshot.count() > 0
    return snapshot.get(0)
end
auto held = detachedInterface()
assert held.name().length > 0
auto hardware = held.hardwareAddress()
if hardware.length > 0 then
    auto original = hardware[0]
    if original == 0 then hardware[0] = 1 else hardware[0] = 0 end
    assert held.hardwareAddress()[0] == original
end
auto snapshot = NetInterfaceList()
assert snapshot.count() > 0
assert snapshot.length == snapshot.count()
assert snapshot[0].name() == snapshot.get(0).name()
assert net.interfaces()[0].name().length > 0
int items = 0
int addresses = 0
while items < snapshot.count()
    auto item = snapshot.get(items)
    assert item.name().length > 0 and item.ipv4Index >= 0 and item.ipv6Index >= 0
    assert item.mtu >= 0 and item.flags >= 0
    assert item.hasFlag(0) and not item.hasFlag(-1) and not item.hasFlag(4294967296)
    assert item.isUp == item.hasFlag(net.interfaceUp)
    assert item.isRunning == item.hasFlag(net.interfaceRunning)
    assert item.isLoopback == item.hasFlag(net.interfaceLoopback)
    assert item.supportsBroadcast == item.hasFlag(net.interfaceBroadcast)
    assert item.isPointToPoint == item.hasFlag(net.interfacePointToPoint)
    assert item.supportsMulticast == item.hasFlag(net.interfaceMulticast)
    int at = 0
    while at < item.addressCount()
        auto entry = item.address(at)
        auto address = entry.address()
        assert entry.family == address.family and entry.scope == address.scope
        assert entry.text() == address.text() and address.port == 0
        assert entry.prefixKnown == (entry.prefixLength != 255)
        if entry.prefixKnown then
            assert entry.prefixLength >= 0
            if entry.family == 4 then assert entry.prefixLength <= 32 else assert entry.prefixLength <= 128 end
        end
        addresses += 1
        at += 1
    end
    items += 1
end
assert items == snapshot.count() and addresses > 0
int rejected = 0
try
    auto invalid = snapshot.get(-1)
catch failure
    assert failure.kind == "RangeError"
    rejected += 1
end
try
    auto invalid = snapshot.get(snapshot.count())
catch failure
    assert failure.kind == "RangeError"
    rejected += 1
end
try
    auto invalid = held.address(held.addressCount())
catch failure
    assert failure.kind == "RangeError"
    rejected += 1
end
assert rejected == 3
