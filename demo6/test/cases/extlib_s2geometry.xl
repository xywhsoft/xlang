import s2geometry



func main(...) as int
    // Encode Beijing (39.9, 116.4) at level 10
    auto cell = s2geometry.fromLatLng(39.9, 116.4, 10)
    assert cell != 0, "cell should not be 0"

    // Check level
    auto lv = s2geometry.level(cell)
    assert lv == 10, "level should be 10, got " + string(lv)

    // Decode back - should be close to original
    auto lat = s2geometry.toLat(cell)
    auto lng = s2geometry.toLng(cell)
    assert lat > 39.0 and lat < 41.0, "lat in range"
    assert lng > 115.0 and lng < 118.0, "lng in range"

    // Face should be 0-5
    auto f = s2geometry.face(cell)
    assert f >= 0 and f <= 5, "face in range"

    // Token should be non-empty
    auto tok = s2geometry.token(cell)
    assert string.len(tok) > 0, "token non-empty"

    // Parent should have level one less
    auto par = s2geometry.parent(cell)
    assert s2geometry.level(par) == 9, "parent level 9"

    // Different levels produce different cells
    auto cell5 = s2geometry.fromLatLng(39.9, 116.4, 5)
    auto cell20 = s2geometry.fromLatLng(39.9, 116.4, 20)
    assert s2geometry.level(cell5) == 5, "level 5"
    assert s2geometry.level(cell20) == 20, "level 20"
    assert cell5 != cell20, "different levels different cells"

    return 0
end
