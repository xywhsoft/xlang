future<int> finallyCatchFuture = asyncFinallyCatchAsync()
int finallyCatchState = await finallyCatchFuture
assert finallyCatchState == 111, "async catch/finally should run finally before successful future completion"
assert not task.cancel(finallyCatchFuture), "completed async catch/finally future should not be canceled"
int finallyCatchRepeated = await finallyCatchFuture
assert finallyCatchRepeated == 111, "async catch/finally completed future should remain awaitable"

future<int> finallyRethrowFuture = asyncFinallyRethrowCatchAsync()
int finallyRethrowState = await finallyRethrowFuture
assert finallyRethrowState == 111, "async try/finally should run finally before inner catch"
assert not task.cancel(finallyRethrowFuture), "completed async rethrow/finally future should not be canceled"
int finallyRethrowRepeated = await finallyRethrowFuture
assert finallyRethrowRepeated == 111, "async rethrow/finally completed future should remain awaitable"

future<int> finallyOverrideFuture = asyncFinallyOverrideAsync()
int finallyOverrideState = 0

try
    int finallyOverrideValue = await finallyOverrideFuture
    finallyOverrideState = finallyOverrideValue
catch e
    if e.message == "async finally override boom" then
        finallyOverrideState = 42
    end
end

assert finallyOverrideState == 42, "async finally throw should override original failed future error"
assert not task.cancel(finallyOverrideFuture), "failed async finally override future should not be canceled"

try
    int finallyOverrideRepeated = await finallyOverrideFuture
    finallyOverrideState = finallyOverrideRepeated
catch e
    if e.message == "async finally override boom" then
        finallyOverrideState = 84
    end
end

assert finallyOverrideState == 84, "failed async finally override future should keep final error after cancel"

auto finallyVoidFuture = asyncFinallyVoidOverrideAsync()
int finallyVoidState = 0

try
    await finallyVoidFuture
    finallyVoidState = 1
catch e
    if e.message == "async finally void override boom" then
        finallyVoidState = 42
    end
end

assert finallyVoidState == 42, "async void finally throw should override original failed future error"
assert not task.cancel(finallyVoidFuture), "failed async void finally future should not be canceled"
