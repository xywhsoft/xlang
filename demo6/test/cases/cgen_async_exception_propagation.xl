async func failAsync() as int
    throw "async boom"
    return 0
end

async func failVoidAsync()
    throw "async void boom"
end

async func failStringAsync() as string
    throw "async string boom"
    return ""
end

async func failBoolAsync() as bool
    throw "async bool boom"
    return false
end

async func failFloatAsync() as float
    throw "async float boom"
    return 0.0
end

async func failVarAsync() as var
    throw "async var boom"
    return 0
end

func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

async func failFunctionAsync() as func(int) as int
    throw "async function boom"
    return makeAdder(1)
end

class FailedAsyncBox
    int value = 0
end

async func failBoxAsync() as FailedAsyncBox
    throw "async class boom"
    FailedAsyncBox box
    box.value = 1
    return box
end

async func failItemsAsync() as array<int>
    throw "async array boom"
    return array[1, 2, 3]
end

async func failListAsync() as list<int>
    throw "async list boom"
    return list[2: 8, 4: 9]
end

async func failSetAsync() as set<int>
    throw "async set boom"
    return set{6, 7}
end

async func failDictAsync() as dict<int>
    throw "async dict boom"
    return dict{"a": 11, "b": 12}
end

async func asyncFinallyCatchAsync() as int
    int state = 0

    try
        state = 1
        throw "async finally catch boom"
    catch e
        if e.message == "async finally catch boom" then
            state = state + 10
        end
    finally
        state = state + 100
    end

    return state
end

async func asyncFinallyRethrowCatchAsync() as int
    int state = 0

    try
        try
            state = 1
            throw "async finally rethrow boom"
        finally
            state = state + 10
        end
    catch e
        if e.message == "async finally rethrow boom" then
            state = state + 100
        end
    end

    return state
end

async func asyncFinallyOverrideAsync() as int
    try
        throw "async finally original boom"
    finally
        throw "async finally override boom"
    end

    return 0
end

async func asyncFinallyVoidOverrideAsync()
    try
        throw "async finally void original boom"
    finally
        throw "async finally void override boom"
    end
end

future<int> failed = failAsync()
int state = 0

try
    int value = await failed
    state = value
catch e
    if e.message == "async boom" then
        state = 7
    end
end

assert state == 7, "async exception should reach catch"

int repeatedState = 0

try
    int secondValue = await failed
    repeatedState = secondValue
catch e
    if e.message == "async boom" then
        repeatedState = 11
    end
end

assert repeatedState == 11, "failed future repeated await should reach catch"

bool cancelFailed = task.cancel(failed)
assert not cancelFailed, "failed completed future should not be canceled"

int tempState = 0

try
    int tempValue = await failAsync()
    tempState = tempValue
catch e
    if e.message == "async boom" then
        tempState = 9
    end
end

assert tempState == 9, "temporary async exception should reach catch"

auto failedVoid = failVoidAsync()
int voidState = 0

try
    await failedVoid
    voidState = 1
catch e
    if e.message == "async void boom" then
        voidState = 21
    end
end

assert voidState == 21, "failed void async future first await should reach catch"
assert not task.cancel(failedVoid), "failed void async future should not be canceled"

try
    await failedVoid
    voidState = 2
catch e
    if e.message == "async void boom" then
        voidState = 42
    end
end

assert voidState == 42, "failed void async future should keep error after cancel"

int tempVoidState = 0

try
    await failVoidAsync()
    tempVoidState = 1
catch e
    if e.message == "async void boom" then
        tempVoidState = 42
    end
end

assert tempVoidState == 42, "temporary async void exception should reach catch"

