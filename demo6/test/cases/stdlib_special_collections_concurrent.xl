func main(...) as int
    MpmcQueue<int> queue = MpmcQueue::<int>(1024)

    auto producerA = func() as int
        for i in range(0, 100)
            if queue.tryPush(i) != queueStatus.ok then return 10 end
        end
        return 0
    end
    auto producerB = func() as int
        for i in range(100, 200)
            if queue.tryPush(i) != queueStatus.ok then return 11 end
        end
        return 0
    end
    auto producerC = func() as int
        for i in range(200, 300)
            if queue.tryPush(i) != queueStatus.ok then return 12 end
        end
        return 0
    end
    auto producerD = func() as int
        for i in range(300, 400)
            if queue.tryPush(i) != queueStatus.ok then return 13 end
        end
        return 0
    end

    thread a = thread(producerA)
    thread b = thread(producerB)
    thread c = thread(producerC)
    thread d = thread(producerD)
    assert(a.waitTimeout(5000))
    assert(b.waitTimeout(5000))
    assert(c.waitTimeout(5000))
    assert(d.waitTimeout(5000))
    assert(a.exitCode() == 0)
    assert(b.exitCode() == 0)
    assert(c.exitCode() == 0)
    assert(d.exitCode() == 0)
    assert(queue.count() == 400)

    int sum = 0
    for i in range(0, 400)
        auto status, value = queue.tryPop()
        assert(status == queueStatus.ok and value != null)
        if value != null then sum += value end
    end
    assert(sum == 79800)
    assert(queue.count() == 0)

    array<int> batchInput = array[7, 8, 9]
    auto pushStatus, pushed = queue.pushBatch(batchInput)
    assert(pushStatus == queueStatus.ok and pushed == 3)
    auto popStatus, batchOutput = queue.popBatch(2)
    assert(popStatus == queueStatus.ok)
    assert(batchOutput.length == 2)
    assert(batchOutput[0] == 7)
    assert(batchOutput[1] == 8)
    auto lastStatus, lastOutput = queue.popBatch(4)
    assert(lastStatus == queueStatus.ok and lastOutput.length == 1 and lastOutput[0] == 9)
    auto emptyStatus, emptyOutput = queue.popBatch(4)
    assert(emptyStatus == queueStatus.empty and emptyOutput.length == 0)
    bool rejected = false
    try
        auto invalidStatus, invalidOutput = queue.popBatch(-1)
    catch RangeError
        rejected = true
    end
    assert(rejected and lastOutput[0] == 9 and batchOutput[0] == 7)

    WaitQueue<string> waits = WaitQueue::<string>(8)
    auto delayed = func() as int
        if not waits.tryPush("ready") then return 20 end
        return 0
    end
    thread worker = thread(delayed)
    string message = ""
    assert(waits.popTimeoutInto(message, 5000))
    assert(message == "ready")
    assert(worker.waitTimeout(5000))
    assert(worker.exitCode() == 0)

    queue.close()
    assert(queue.isClosed())
    assert(queue.isDrained())
    println("stdlib special collection concurrent ok")
    return 0
end
