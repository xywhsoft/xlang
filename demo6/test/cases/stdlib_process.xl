extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

string result = process.exec("cmd /c echo xlang-process")
expectStr(string.trim(result), "xlang-process")

expect(process.success("cmd /c exit /b 0"), 1)
expect(process.success("cmd /c exit /b 7"), 0)
expect(process.exitCode("cmd /c exit /b 0"), 0)
expect(process.exitCode("cmd /c exit /b 7"), 7)

string missing = process.exec("cmd /c exit /b 3")
expectStr(missing, "")

ProcessResult runResult = process.run("cmd /c echo process-run")
expect(runResult.success, 1)
expect(runResult.exitCode, 0)
expect(runResult.timedOut, 0)
expect(runResult.cancelled, 0)
expect(runResult.spawnFailed, 0)
expect(runResult.killed, 0)
expectStr(string.trim(runResult.stdout), "process-run")
expectStr(string.trim(runResult.stderr), "")

ProcessResult fileResult = process.runFile("cmd", ["/c", "echo", "process-file"])
expect(fileResult.success, 1)
expect(fileResult.exitCode, 0)
expectStr(string.trim(fileResult.stdout), "process-file")

PipelineResult pipe = process.pipeline([
    process.shell("cmd /c echo alpha"),
    process.cmd("cmd", ["/c", "findstr alpha"])
])
expect(pipe.success, 1)
expect(pipe.exitCode, 0)
expect(pipe.failedIndex, -1)
expect(pipe.count, 2)
expect(pipe.completedCount, 2)
expect(pipe.timedOut, 0)
expectStr(string.trim(pipe.stdout), "alpha")

ProcessResult secondStage = pipe.result(1)
expect(secondStage.success, 1)
expectStr(string.trim(secondStage.stdout), "alpha")

PipelineResult failedPipe = process.pipeline([
    process.shell("cmd /c exit /b 5"),
    process.shell("cmd /c echo should-not-run")
])
ProcessResult failedStage = failedPipe.result(0)
expect(failedPipe.success, 0)
expect(failedPipe.exitCode, 5)
expect(failedPipe.failedIndex, 0)
expect(failedPipe.count, 2)
expect(failedPipe.completedCount, 1)
expect(failedPipe.timedOut, 0)
expect(failedStage.exitCode, 5)

Process proc = process.startFile("cmd", ["/c", "more"])
expect(proc.running, 1)
expect(proc.writeLine("live-process"), 1)
expect(proc.closeStdin(), 1)
expect(proc.wait(5000), 1)
expect(proc.running, 0)
expect(proc.exitCode, 0)
expectStr(string.trim(proc.stdout), "live-process")

Process shellProc = process.start("cmd /c more")
expect(shellProc.running, 1)
expect(shellProc.writeLine("shell-process"), 1)
expect(shellProc.closeStdin(), 1)
expect(shellProc.wait(5000), 1)
expect(shellProc.running, 0)
expect(shellProc.exitCode, 0)
expectStr(string.trim(shellProc.stdout), "shell-process")
