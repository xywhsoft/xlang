// Check floating bit patterns, including negative zero and a quiet NaN payload.
extern "owned_task_float" @no_raise func floatValue(c_int kind) as c_float
extern "owned_task_double" @no_raise func doubleValue(c_int kind) as c_double
extern "owned_task_float_check" @no_raise func checkFloat(c_float value,c_int kind) as bool
extern "owned_task_double_check" @no_raise func checkDouble(c_double value,c_int kind) as bool
for kind in range(3)
    c_int mode=c_int(kind)
    auto floats=await task.all([task.spawn(echo17,floatValue(mode)),task.spawn(echo17,floatValue(mode))])
    assert checkFloat(floats[0],mode) and checkFloat(floats[1],mode)
    array<future<c_double>> doubles=[task.spawn(echo18,doubleValue(mode)),task.spawn(echo18,doubleValue(mode))]
    auto results=await task.all(doubles)
    assert checkDouble(results[0],mode) and checkDouble(results[1],mode)
end
