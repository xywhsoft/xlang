func echo16(c_bool value) as c_bool
    return value
end
c_bool input16=c_bool(true)
auto first16=task.spawn(echo16,input16)
auto second16=task.spawn(echo16,input16)
auto literal16=await task.all([first16,second16])
assert literal16.length==2 and literal16[0]==input16 and literal16[1]==input16
array<future<c_bool>> jobs16=[first16,second16]
auto array16=await task.all(jobs16)
assert array16[0]==input16 and array16[1]==input16
var boxed16=array16[0]
// The existing native scalar codec deliberately uses the shared bool singleton
// in var/container storage. The typed projection still returns c_bool.
assert type(boxed16)==type(true)
