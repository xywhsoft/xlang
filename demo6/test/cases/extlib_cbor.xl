import cbor

func main(...) as int
    var source = {
        "name": "xlang",
        "version": 6,
        "ready": true,
        "ratio": 3.5,
        "empty": null,
        "items": ["one", 2, false],
        "nested": {"city": "Beijing"}
    }
    Buffer encoded = cbor.encode(source)
    assert encoded.len() > 0, "generic encode returns bytes"
    assert string.startsWith(cbor.toHex(encoded), "a7"), "top-level map is encoded"

    var decoded = cbor.decode(encoded)
    assert decoded["name"] == "xlang", "text roundtrip"
    assert decoded["version"] == 6, "integer roundtrip"
    assert decoded["ready"] == true, "boolean roundtrip"
    assert decoded["ratio"] > 3.49 and decoded["ratio"] < 3.51, "float roundtrip"
    assert decoded["empty"] == null, "null roundtrip"
    assert decoded["items"][2] == false, "array roundtrip"
    assert decoded["nested"]["city"] == "Beijing", "object roundtrip"

    Buffer raw = Buffer()
    raw.appendByte(0xde)
    raw.appendByte(0xad)
    raw.appendByte(0xbe)
    raw.appendByte(0xef)
    Buffer binary = cbor.encodeBytes(raw)
    assert cbor.toHex(binary) == "44deadbeef", "byte string encoding"
    assert cbor.toHex(cbor.decodeBytes(binary)) == "deadbeef", "byte string roundtrip"

    Buffer parsed = cbor.fromHex("a1616101")
    assert cbor.decode(parsed)["a"] == 1, "hex input"

    bool caught = false
    try
        Buffer truncated = cbor.fromHex("a1")
        cbor.decode(truncated)
    catch ValueError e
        caught = true
    end
    assert caught, "truncated input must throw"

    caught = false
    try
        Buffer invalidMap = cbor.fromHex("a10102")
        cbor.decode(invalidMap)
    catch ValueError e
        caught = true
    end
    assert caught, "non-text map key must throw"
    return 0
end
