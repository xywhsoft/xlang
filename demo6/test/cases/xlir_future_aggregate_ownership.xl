extern "aggregate_source" func source(int index) as future<int>
extern "aggregate_closure_source" func closureSource(int index) as future<var>
extern "aggregate_capture" func capture(var value)

export "aggregate_make_closure" func makeClosure(int value)
    capture(xcall(func() as int => value))
end

export "aggregate_build" func buildAggregate(int mode)
    if mode == 6 then
        future<var> a = closureSource(0)
        future<var> b = closureSource(1)
        capture(task.all([a, a, b]))
    else
        future<int> a = source(0)
        future<int> b = source(1)
        if mode == 0 then
            capture(task.all([a, a, b]))
        elseif mode == 1 then
            capture(task.race([a, a, b]))
        elseif mode == 2 then
            capture(task.whenAny([a, a, b]))
        else
            array<future<int>> inputs = [a, a, b]
            if mode == 3 then
                capture(task.all(inputs))
            elseif mode == 4 then
                capture(task.race(inputs))
            else
                capture(task.whenAny(inputs))
            end
        end
    end
end
