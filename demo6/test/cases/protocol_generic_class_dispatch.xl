protocol Reader<T>
    func read() as T
end

protocol Named
    func name() as string
end

class Box<T>
    T value

    create(T value)
        self.value = value
    end

    func read() as T
        return self.value
    end

    func name() as string
        return "box"
    end
end

func readInt(Reader<int> value) as int
    return value.read()
end

func readName(Named value) as string
    return value.name()
end

func main(...) as int
    Box<int> box = Box::<int>(42)
    assert readInt(box) == 42
    assert readName(box) == "box"
    println("generic class protocol dispatch ok")
    return 0
end
