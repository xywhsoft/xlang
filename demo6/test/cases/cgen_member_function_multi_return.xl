extern "expect_i64" func expect(int actual, int expected)

func pair(int seed) as (int, int)
    return seed, seed + 1
end

func makePairer(int base) as func(int) as (int, int)
    return func(int value) as (int, int)
        return base + value, base - value
    end
end

class PairBox
    func(int) as (int, int) op
    int bias = 0
end

class Factory
    func(int) as (PairBox, func(int) as (int, int)) build
end

func makeBox(int base) as PairBox
    PairBox box
    box.op = makePairer(base)
    box.bias = base
    return box
end

func makeBoxAndOp(int base) as (PairBox, func(int) as (int, int))
    PairBox box = makeBox(base)
    return box, box.op
end

PairBox direct
direct.op = pair
direct.bias = 10

auto first, second = direct.op(3)
expect(first, 3)
expect(second, 4)

PairBox closureBox
closureBox.op = makePairer(20)
closureBox.bias = 5

auto closureLeft, closureRight = closureBox.op(7)
expect(closureLeft, 27)
expect(closureRight, 13)

PairBox copied
copied = closureBox

auto copiedLeft, copiedRight = copied.op(8)
expect(copiedLeft + copied.bias, 33)
expect(copiedRight + copied.bias, 17)

array<PairBox> boxes = array[direct]
boxes[0] = closureBox

PairBox fromArray = boxes[0]
auto arrayLeft, arrayRight = fromArray.op(9)
expect(arrayLeft, 29)
expect(arrayRight, 11)

PairBox returned = makeBox(40)
auto returnedLeft, returnedRight = returned.op(2)
expect(returnedLeft + returned.bias, 82)
expect(returnedRight + returned.bias, 78)

PairBox assignedBox
assignedBox.op = pair
assignedBox.bias = 1
func(int) as (int, int) assignedOp = pair

assignedBox, assignedOp = makeBoxAndOp(50)

auto assignedLeft, assignedRight = assignedBox.op(3)
auto assignedFnLeft, assignedFnRight = assignedOp(4)

expect(assignedLeft + assignedBox.bias, 103)
expect(assignedRight + assignedBox.bias, 97)
expect(assignedFnLeft, 54)
expect(assignedFnRight, 46)

auto declaredBox, declaredOp = makeBoxAndOp(60)
auto declaredLeft, declaredRight = declaredBox.op(5)
auto declaredFnLeft, declaredFnRight = declaredOp(6)

expect(declaredLeft + declaredBox.bias, 125)
expect(declaredRight + declaredBox.bias, 115)
expect(declaredFnLeft, 66)
expect(declaredFnRight, 54)

_, _ = makeBoxAndOp(70)

Factory factory
factory.build = makeBoxAndOp
factory.build(80)
