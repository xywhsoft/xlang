extern "xlir_make_string_future" func makeFuture() as future<string>

async func combineText(future<string> left, future<string> right) as string
    return await left + await right
end

future<string> left = makeFuture()
future<string> right = makeFuture()
future<string> pending = combineText(left, right)
string completed = await pending
assert completed == "he\0llohe\0llo"
