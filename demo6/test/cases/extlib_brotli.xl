import brotli



func main(...) as int
    Buffer source = Buffer()
    source.append("abc")
    source.appendByte(0)
    source.appendByte(255)
    Buffer packed = brotli.compress(source)
    Buffer plain = brotli.decompress(packed)
    if not (plain == source) then
        return 1
    end

    auto encoder = brotli.compressor()
    encoder.update("left")
    encoder.update("right")
    encoder.finish()
    Buffer incremental = encoder.drain()
    auto decoder = brotli.decompressor()
    decoder.update(incremental)
    decoder.finish()
    if decoder.drain().text() != "leftright" then
        return 2
    end
    if decoder.members != 1 then
        return 6
    end

    // 流式分块收集 + 字节计数器（进度回显基础）。
    auto enc2 = brotli.compressor()
    Buffer collected = Buffer()
    enc2.update("aaaa")
    collected.append(enc2.drain())
    enc2.update("bbbb")
    collected.append(enc2.drain())
    enc2.finish()
    collected.append(enc2.drain())
    if enc2.inputBytes != 8 then
        return 7
    end
    auto dec2 = brotli.decompressor()
    dec2.update(collected)
    dec2.finish()
    if dec2.drain().text() != "aaaabbbb" then
        return 8
    end
    if not dec2.finished then
        return 9
    end

    // 最高压缩质量与质量常量。
    auto enc3 = brotli.compressor(brotli.BROTLI_MAX_QUALITY)
    enc3.update("tune")
    enc3.finish()
    if brotli.decompress(enc3.drain()).text() != "tune" then
        return 10
    end
    bool badQuality = false
    try
        brotli.compressor(99)
    catch ValueError e
        badQuality = true
    end
    if not badQuality then
        return 11
    end

    // 文本模式压缩（BROTLI_MODE_TEXT 调优 UTF-8 文本）。
    Buffer textPacked = brotli.compress("hello brotli text mode", brotli.BROTLI_DEFAULT_QUALITY,
        brotli.BROTLI_DEFAULT_WINDOW, brotli.BROTLI_MODE_TEXT)
    if brotli.decompress(textPacked).text() != "hello brotli text mode" then
        return 14
    end

    // 串联多成员流：两个独立成员拼接后一次解出。
    auto frameA = brotli.compressor()
    frameA.update("AAA")
    frameA.finish()
    auto frameB = brotli.compressor()
    frameB.update("BBB")
    frameB.finish()
    Buffer joined = Buffer()
    joined.append(frameA.drain())
    joined.append(frameB.drain())
    auto multi = brotli.decompressor()
    multi.update(joined)
    multi.finish()
    if multi.drain().text() != "AAABBB" then
        return 12
    end
    if multi.members != 2 then
        return 13
    end

    bool rejected = false
    int mid = incremental.len() / 2
    incremental[mid] = incremental[mid] ^ 255
    try
        brotli.decompress(incremental)
    catch CompressionError e
        rejected = true
    end
    if not rejected then
        return 3
    end

    string sourcePath = "tmp/extlib_brotli_source.bin"
    string packedPath = "tmp/extlib_brotli_stream.br"
    string plainPath = "tmp/extlib_brotli_plain.bin"
    file.writeBytes(sourcePath, source)
    brotli.compressFile(sourcePath, packedPath)
    brotli.decompressFile(packedPath, plainPath)
    if file.readBytes(plainPath) != source then
        return 4
    end
    bool overwriteRejected = false
    try
        brotli.compressFile(sourcePath, packedPath, overwrite = false)
    catch CompressionError e
        overwriteRejected = true
    end
    if not overwriteRejected then
        return 5
    end
    file.delete(sourcePath)
    file.delete(packedPath)
    file.delete(plainPath)
    return 0
end
