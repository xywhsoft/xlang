import jwt



func main(...) as int
    // Encode a JWT
    auto payload = "{\"sub\":\"1234567890\",\"name\":\"Alice\",\"admin\":true}"
    auto token = jwt.encode(payload, "mysecret")
    assert string.len(token) > 0, "token not empty"

    // Token has 3 parts separated by dots
    auto parts = string.split(token, ".")
    assert parts.length == 3, "three parts"

    // Decode payload
    auto decoded = jwt.decode(token)
    assert decoded == payload, "decode matches original"

    // Get header
    auto hdr = jwt.header(token)
    assert string.contains(hdr, "HS256"), "header has alg"
    assert string.contains(hdr, "JWT"), "header has typ"

    // Verify with correct secret
    assert jwt.verify(token, "mysecret"), "verify correct secret"

    // Verify with wrong secret fails
    assert not jwt.verify(token, "wrongsecret"), "verify wrong secret"

    // Different payload produces different token
    auto token2 = jwt.encode("{\"sub\":\"other\"}", "mysecret")
    assert token2 != token, "different payload different token"

    // Same input is deterministic
    auto token3 = jwt.encode(payload, "mysecret")
    assert token3 == token, "deterministic"

    // RFC 7515 Appendix A.1 HS256 example must interoperate.
    string rfcToken = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
    assert jwt.verify(rfcToken, "your-256-bit-secret"), "RFC HS256 vector"

    // Decoding is inspection only. Verification rejects algorithm downgrade.
    string noneToken = "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJ4bGFuZyJ9."
    assert jwt.decode(noneToken) == "{\"sub\":\"xlang\"}", "decode should inspect compact JWT payload"
    assert not jwt.verify(noneToken, "mysecret"), "alg none must be rejected"

    return 0
end
