import mysql



func main(...) as int
    // Command names
    assert mysql.cmdName(0x03) == "COM_QUERY", "cmd query"
    assert mysql.cmdName(0x0E) == "COM_PING", "cmd ping"
    assert mysql.cmdName(0x16) == "COM_STMT_PREPARE", "cmd prepare"
    assert mysql.cmdName(0xFF) == "UNKNOWN", "cmd unknown"

    // Column types
    assert mysql.colType(0x03) == "LONG", "col long"
    assert mysql.colType(0x05) == "DOUBLE", "col double"
    assert mysql.colType(0xFD) == "VAR_STRING", "col varchar"
    assert mysql.colType(0xF5) == "JSON", "col json"
    assert mysql.colType(0xFC) == "BLOB", "col blob"

    // Status flags
    auto st = mysql.statusStr(0x0003)
    assert st == "IN_TRANS AUTOCOMMIT", "status str"
    assert mysql.statusStr(0x100) == "DB_DROPPED", "database dropped bit"
    assert mysql.statusStr(0x4000) == "SESSION_STATE_CHANGED", "session changed bit"
    assert mysql.cmdName(31) == "COM_RESET_CONNECTION", "reset connection command"

    // Capability names
    assert mysql.capName(0x0200) == "PROTOCOL_41", "cap proto41"
    assert mysql.capName(0x8000) == "SECURE_CONNECTION", "cap secure"
    assert mysql.capName(0x100000) == "CONNECT_ATTRS", "connect attrs bit"
    assert mysql.capName(0x200000) == "PLUGIN_AUTH_LENENC", "lenenc auth bit"

    // Escape
    assert mysql.escape("hello") == "hello", "escape plain"
    assert mysql.escape("it's") == "it\\'s", "escape quote"
    assert mysql.escape("back\\slash") == "back\\\\slash", "escape backslash"

    // DSN format
    auto dsn = mysql.formatDsn("db.example.com", 3306, "myapp", "root")
    assert dsn == "mysql://root@db.example.com:3306/myapp", "dsn format"

    // DSN parse
    assert mysql.dsnPart("mysql://admin@localhost:3306/testdb", "user") == "admin", "dsn user"
    assert mysql.dsnPart("mysql://admin@localhost:3306/testdb", "host") == "localhost", "dsn host"
    assert mysql.dsnPart("mysql://admin@localhost:3306/testdb", "port") == "3306", "dsn port"
    assert mysql.dsnPart("mysql://admin@localhost:3306/testdb", "db") == "testdb", "dsn db"

    // Error class
    assert mysql.errorClass(1045) == "server", "server access denied"
    assert mysql.errorClass(2003) == "client", "client connection error"
    assert mysql.errorClass(3000) == "server", "extended server range"
    assert mysql.errorClass(99) == "global", "shared global range"
    assert mysql.errorClass(5000) == "unknown", "outside current ranges"

    return 0
end
