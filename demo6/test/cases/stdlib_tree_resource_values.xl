func main(...) as int
    auto child = AvlTree::<int, string>()
    assert(child.set(1, "a\0你"))
    auto parent = AvlTree::<int, AvlTree<int, string>>()
    assert(parent.set(7, child))
    auto output = AvlTree::<int, string>()
    assert(parent.getInto(7, output))
    string text = "old"
    assert(output.getInto(1, text) and text == "a\0你")
    auto values = parent.values()
    auto snapshotTree = values[0]
    assert(values.length == 1 and snapshotTree.getInto(1, text) and text == "a\0你")
    auto copy = parent.clone()
    assert(copy.equals(parent))
    assert(child.set(2, "shared"))
    assert(snapshotTree.count() == 2 and output.count() == 2)

    array<AvlTree<int, string>> collection = array[child, output]
    auto stack = Stack::<AvlTree<int, string>>()
    assert(stack.push(child))
    auto stackTree = AvlTree::<int, Stack<AvlTree<int, string>>>()
    assert(stackTree.set(1, stack))
    auto returnedStack = Stack::<AvlTree<int, string>>()
    assert(stackTree.getInto(1, returnedStack))
    auto returnedTree = returnedStack.pop()
    assert(returnedTree.count() == 2)
    auto second = collection[1]
    assert(second.count() == 2)

    auto queue = MpmcQueue::<AvlTree<int, string>>(2)
    assert(queue.tryPush(child) == queueStatus.ok)
    auto status, popped = queue.tryPop()
    assert(status == queueStatus.ok and popped != null)
    if popped != null then assert(popped.count() == 2) end
    auto nested = AvlTree::<int, array<AvlTree<int, string>>>()
    assert(nested.set(1, collection))
    auto arrays = nested.values()
    auto nestedSnapshot = arrays[0][0]
    assert(nestedSnapshot.getInto(1, text) and text == "a\0你")
    return 0
end
