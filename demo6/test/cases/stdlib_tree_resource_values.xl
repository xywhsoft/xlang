func main(...) as int
    auto child = OrderedMap::<int, string>()
    assert(child.set(1, "a\0你"))
    auto parent = OrderedMap::<int, OrderedMap<int, string>>()
    assert(parent.set(7, child))
    auto output = OrderedMap::<int, string>()
    output = parent.get(7)
    string text = "old"
    text = output.get(1)
    assert(text == "a\0你")
    auto values = parent.values()
    auto snapshotTree = values[0]
    text = snapshotTree.get(1)
    assert(values.length == 1 and text == "a\0你")
    auto copy = parent.clone()
    assert(copy.equals(parent))
    assert(child.set(2, "shared"))
    assert(snapshotTree.count() == 2 and output.count() == 2)

    array<OrderedMap<int, string>> collection = array[child, output]
    auto stack = Stack::<OrderedMap<int, string>>()
    assert(stack.push(child))
    auto stackTree = OrderedMap::<int, Stack<OrderedMap<int, string>>>()
    assert(stackTree.set(1, stack))
    auto returnedStack = Stack::<OrderedMap<int, string>>()
    returnedStack = stackTree.get(1)
    auto returnedTree = returnedStack.pop()
    assert(returnedTree.count() == 2)
    auto second = collection[1]
    assert(second.count() == 2)

    auto queue = MpmcQueue::<OrderedMap<int, string>>(2)
    assert(queue.tryPush(child) == queueStatus.ok)
    auto status, popped = queue.tryPop()
    assert(status == queueStatus.ok and popped != null)
    if popped != null then assert(popped.count() == 2) end
    auto nested = OrderedMap::<int, array<OrderedMap<int, string>>>()
    assert(nested.set(1, collection))
    auto arrays = nested.values()
    auto nestedSnapshot = arrays[0][0]
    text = nestedSnapshot.get(1)
    assert(text == "a\0你")
    return 0
end
