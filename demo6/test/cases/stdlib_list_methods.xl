int listMethodFinally = 0
func methods(list<string> values) as int
    try
        assert(values.length == 3)
        assert(values.contains("a\0你"))
        assert(not values.contains("a"))
        assert(not values.remove(19))
        assert(values.remove(-9))
        assert(values.length == 2)
        assert(values.take(19) == null)
        assert(values.take(9223372036854775807) == "z")
        assert(values.length == 1)
        assert(values.trimTo(1) >= 0)
        assert(values.clear())
        assert(values.length == 0)
        assert(values.trim() >= 0)
        return 7
    finally
        listMethodFinally += 1
    end
end
func optionalCount(list<int>? values) as int
    int? count = values?.length
    if count == null then
        return -1
    end
    return count
end
func main(...) as int
    list<string> values = [-9: "discard", 7: "a\0你", 9223372036854775807: "z"]
    assert(methods(values) == 7)
    assert(listMethodFinally == 1)
    assert(optionalCount(null) == -1)
    assert(optionalCount([0: 4]) == 1)
    int caught = 0
    try
        values.trimTo(-1)
    catch RangeError failure
        caught += 1
    end
    assert(caught == 1)
    return 0
end
