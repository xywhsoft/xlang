func mutateArray(array<int> values)
    values.push(3)
    values[0] = 9
end

func mutateList(list<string> values)
    values[2] = "two"
end

func mutateSet(set<int> values)
    values.add(7)
    values.remove(1)
end

func mutateDict(dict<int> values)
    values["count"] = 5
end

func consumeArray(array<int> values) as int
    values.push(8)
    return values.length
end

func makeArray() as array<int>
    return array[10, 20]
end

func rebindArray(array<int> values) as int
    values = array[6, 7, 8]
    return values.length
end

func nestedReturn() as int
    return consumeArray(array[21]) + 5
end

class Store
    array<int> values = array[4]

    func mutate(array<int> source)
        source.push(11)
    end

    func consume(array<int> source) as int
        source.push(13)
        return source.length
    end
end

array<int> arrayValue = array[1, 2]
mutateArray(arrayValue)
assert arrayValue.length == 3, "typed array parameter should borrow the caller handle"
assert arrayValue[0] == 9 and arrayValue[2] == 3, "typed array parameter mutation should be visible"

list<string> listValue = list[0: "zero"]
mutateList(listValue)
assert listValue[2] == "two", "typed list parameter mutation should be visible"

set<int> setValue = set{1, 2}
mutateSet(setValue)
assert setValue.contains(7), "typed set parameter add should be visible"
assert not setValue.contains(1), "typed set parameter remove should be visible"

dict<int> dictValue = dict{}
mutateDict(dictValue)
assert dictValue["count"] == 5, "typed dict parameter mutation should be visible"

Store store = Store()
mutateArray(store.values)
assert store.values.length == 2 and store.values[1] == 3, "typed container field argument should remain borrowed"
store.mutate(store.values)
assert store.values.length == 3 and store.values[2] == 11, "class method typed-container arguments should remain borrowed"
assert store.consume(array[12]) == 2, "class method typed-container literals should materialize for the call"

assert consumeArray(array[1]) == 2, "typed-container literals should materialize for the call"
assert consumeArray(makeArray()) == 3, "owned typed-container returns should move into the call temporary"

int nestedValue = consumeArray(array[2]) + 4
assert nestedValue == 6, "declaration expressions should lower nested owned arguments"
nestedValue = consumeArray(array[3]) + 6
assert nestedValue == 8, "assignment expressions should lower nested owned arguments"
assert nestedReturn() == 7, "return expressions should lower nested owned arguments"

if consumeArray(array[4]) == 2 then
    nestedValue += 1
end
assert nestedValue == 9, "if conditions should lower nested owned arguments"

int loopCount = 0
while loopCount < 2 and consumeArray(array[loopCount]) == 2 do
    loopCount += 1
end
assert loopCount == 2, "while conditions should rebuild and release owned arguments per iteration"

array<int> original = array[42]
assert rebindArray(original) == 3, "callee parameter rebinding should use the replacement value locally"
assert original.length == 1 and original[0] == 42, "callee parameter rebinding must not replace the caller binding"

println("typed container parameter mutation ok")
