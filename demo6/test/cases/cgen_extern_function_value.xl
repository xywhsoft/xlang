extern "native_add_i64" func cadd(int left, int right) as int
extern "expect_i64" func expect(int actual, int expected)

export "xl6_exported_add_i64" func exportedAdd(int left, int right) as int
    return left + right
end

func(int, int) as int fn = cadd
int direct = fn(10, 3)
var boxed = xcall(fn)
var dynamic = boxed(20, 22)

func(int, int) as int exportedFn = exportedAdd
int exportedDirect = exportedFn(5, 6)
var boxedExported = xcall(exportedFn)
var exportedDynamic = boxedExported(7, 8)

expect(direct, 13)
expect(int(dynamic), 42)
expect(exportedDirect, 11)
expect(int(exportedDynamic), 15)
