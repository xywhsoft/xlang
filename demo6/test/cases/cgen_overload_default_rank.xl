func choose(int value, int base = 10, int flags = 0) as int
    return 1
end
func choose(float value, int flags = 0) as int
    return 2
end
assert choose(1) == 1
assert choose(1, 1) == 1
assert choose(1.0) == 2
assert choose(1.0, 1) == 2
assert choose(value = 1, flags = 1) == 1
func generic<T>(T value, int extra = 0) as int
    return 3
end
func generic<T>(float value) as int
    return 4
end
assert generic::<int>(1) == 3
class Choices<T>
    func choose(T value, int base = 10, int flags = 0) as int
        return 5
    end
    func choose(float value, int flags = 0) as int
        return 6
    end
end
Choices<int> choices = Choices::<int>()
assert choices.choose(1, 1) == 5
assert choices.choose(1.0, 1) == 6
