extern "expect_i64" func expect(int actual, int expected)

class Pair
    int left = 0
    int right = 0
end

class Native
    native point handle
end

union Payload
    int i
    c_double d
end

func add(int left, int right) as int
    return left + right
end

func mul(int left, int right) as int
    return left * right
end

func pair() as (int, int)
    return 7, 8
end

func makePairPayload() as (Pair, Payload)
    Pair pair = Pair()
    pair.left = 4
    pair.right = 5

    Payload payload
    payload.i = 9

    return pair, payload
end

func makeNative(Native value) as (Native, int)
    return value, 11
end

func makeOps() as (func(int, int) as int, func(int, int) as int)
    return add, mul
end

array<int> values = array[0]
dict<int> scores = dict{"main": 0}

values[0], scores["main"] = pair()

expect(values[0], 7)
expect(scores["main"], 8)

Pair emptyPair = Pair()
Payload emptyPayload

array<Pair> pairs = array[emptyPair]
list<Payload> payloads = list[0: emptyPayload]

pairs[0], payloads[3] = makePairPayload()

Pair gotPair = pairs[0]
Payload gotPayload = payloads[3]

expect(gotPair.left + gotPair.right, 9)
expect(gotPayload.i, 9)

point rawA
Native nativeA = Native(rawA)
dict<Native> natives = dict{"main": nativeA}
var nativeKey = "dynamic"

natives[nativeKey], scores["native"] = makeNative(nativeA)

Native gotNative = natives[nativeKey]
var boxedNative = gotNative

expect(type(boxedNative) == Native, 1)
expect(scores["native"], 11)

func(int, int) as int fn = add
array<func(int, int) as int> funcs = array[fn]
dict<func(int, int) as int> table = dict{"op": fn}
var opKey = "dyn"

funcs[0], table[opKey] = makeOps()

func(int, int) as int gotAdd = funcs[0]
func(int, int) as int gotMul = table[opKey]

expect(gotAdd(2, 3), 5)
expect(gotMul(4, 5), 20)
