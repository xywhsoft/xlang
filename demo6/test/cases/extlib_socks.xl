import socks



func main(...) as int
    // 方法协商帧
    assert socks.greeting([0]) == "050100", "no-auth greeting"
    assert socks.greeting([0, 2]) == "05020002", "two methods greeting"

    // 服务器选择
    var choice = socks.parseChoice("0500")
    assert choice["method"] == 0, "server chose no auth"
    choice = socks.parseChoice("0502")
    assert choice["method"] == 2, "server chose userpass"

    // 域名 CONNECT 帧：example.com:443
    string domain = socks.connectDomain("example.com", 443)
    assert domain.contains("05010003" + "0b6578616d706c652e636f6d"), "domain frame"
    assert domain.length == 36, "domain frame length"
    assert domain.contains("01bb"), "port 443"

    // IPv4 CONNECT 帧：127.0.0.1:8080
    string ipv4 = socks.connectIpv4("127.0.0.1", 8080)
    assert ipv4 == "050100017f0000011f90", "ipv4 frame"

    // 应答解析：IPv4 绑定地址
    var reply = socks.parseReply("0500000100000000c000")
    assert reply["status"] == 0, "success status"
    assert reply["bindAddress"] == "0.0.0.0", "bind address"
    assert reply["bindPort"] == 49152, "bind port 0xc000"

    // 失败状态
    reply = socks.parseReply("05040001000000000000")
    assert reply["status"] == 4, "host unreachable status"

    // 域名应答
    reply = socks.parseReply("050000030b6578616d706c652e636f6d01bb")
    assert reply["bindAddress"] == "example.com", "domain bind"
    assert reply["bindPort"] == 443, "domain bind port"

    // 错误路径
    int raised = 0
    try
        socks.parseChoice("0600")
    catch e
        raised = 1
    end
    assert raised == 1, "wrong version raises"

    raised = 0
    try
        socks.connectDomain("", 80)
    catch e
        raised = 1
    end
    assert raised == 1, "empty domain raises"

    raised = 0
    try
        socks.connectIpv4("not-an-ip", 80)
    catch e
        raised = 1
    end
    assert raised == 1, "bad ipv4 raises"

    raised = 0
    try
        socks.greeting([])
    catch e
        raised = 1
    end
    assert raised == 1, "empty methods raise"

    return 0
end
