import lz4

class Lz4ProgressState
    int calls = 0
    int lastInput = 0
    int lastTotal = 0
end

func main(...) as int
    string sourcePath = "tmp/extlib_lz4_progress_source.txt"
    string packedPath = "tmp/extlib_lz4_progress.bin"
    string plainPath = "tmp/extlib_lz4_progress_plain.txt"
    string cancelledPath = "tmp/extlib_lz4_progress_cancelled.bin"
    string text = ""
    int i = 0
    while i < 6000
        text += "xlang-progress-" + string(i) + "\n"
        i += 1
    end
    file.writeText(sourcePath, text)

    Lz4ProgressState packedState = Lz4ProgressState()
    lz4.compressFile(sourcePath, packedPath, onProgress = func(int inputBytes,
        int totalBytes, int outputBytes) as bool
        packedState.calls += 1
        packedState.lastInput = inputBytes
        packedState.lastTotal = totalBytes
        return outputBytes >= 0
    end)
    assert packedState.calls > 0
    assert packedState.lastInput == string.byteLen(text)
    assert packedState.lastTotal == packedState.lastInput

    Lz4ProgressState plainState = Lz4ProgressState()
    lz4.decompressFile(packedPath, plainPath, onProgress = func(int inputBytes,
        int totalBytes, int outputBytes) as bool
        plainState.calls += 1
        plainState.lastInput = inputBytes
        plainState.lastTotal = totalBytes
        return outputBytes >= 0
    end)
    assert plainState.calls > 0
    assert plainState.lastInput == plainState.lastTotal
    assert file.readText(plainPath) == text

    bool cancelled = false
    try
        lz4.compressFile(sourcePath, cancelledPath, onProgress = func(int inputBytes,
            int totalBytes, int outputBytes) as bool
            return false
        end)
    catch CancelledError e
        cancelled = true
    end
    assert cancelled
    assert not file.exists(cancelledPath)

    file.delete(sourcePath)
    file.delete(packedPath)
    file.delete(plainPath)
    return 0
end
