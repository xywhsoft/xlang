future<int> duplicateCanceledAllSource = slowRaceAsync(509)
future<array<int>> duplicateCanceledAllGroup = task.all([duplicateCanceledAllSource, duplicateCanceledAllSource])
bool duplicateCanceledAllRequest = task.cancel(duplicateCanceledAllSource)
expect(duplicateCanceledAllRequest, 1)
int duplicateCanceledAllState = 0
try
    array<int> duplicateCanceledAllValues = await duplicateCanceledAllGroup
    duplicateCanceledAllState = duplicateCanceledAllValues.length
catch e
    if e.message == "future cancel requested." then
        duplicateCanceledAllState = 42
    end
end
expect(duplicateCanceledAllState, 42)

int duplicateCanceledAllSourceState = 0
try
    int duplicateCanceledAllSourceValue = await duplicateCanceledAllSource
    duplicateCanceledAllSourceState = duplicateCanceledAllSourceValue
catch e
    if e.message == "future cancel requested." then
        duplicateCanceledAllSourceState = 42
    end
end
expect(duplicateCanceledAllSourceState, 42)
bool duplicateCanceledAllSourceCancelAgain = task.cancel(duplicateCanceledAllSource)
expect(duplicateCanceledAllSourceCancelAgain, 1)

