future<TaskBox> pendingTaskBoxAllLeft = slowMakeTaskBox(210)
future<TaskBox> pendingTaskBoxAllRight = slowMakeTaskBox(220)
array<future<TaskBox>> pendingTaskBoxAllJobs = array[pendingTaskBoxAllLeft, pendingTaskBoxAllRight]
future<array<TaskBox>> pendingTaskBoxAllGroup = task.all(pendingTaskBoxAllJobs)
bool pendingTaskBoxAllRequested = task.cancel(pendingTaskBoxAllGroup)
expect(pendingTaskBoxAllRequested, 1)

int pendingTaskBoxAllGroupState = 0
try
    array<TaskBox> pendingTaskBoxAllValues = await pendingTaskBoxAllGroup
    pendingTaskBoxAllGroupState = pendingTaskBoxAllValues.length
catch e
    if e.message == "future cancel requested." then
        pendingTaskBoxAllGroupState = 42
    end
end
expect(pendingTaskBoxAllGroupState, 42)

int pendingTaskBoxAllLeftState = 0
try
    TaskBox pendingTaskBoxAllLeftValue = await pendingTaskBoxAllLeft
    pendingTaskBoxAllLeftState = pendingTaskBoxAllLeftValue.add(0)
catch e
    if e.message == "future cancel requested." then
        pendingTaskBoxAllLeftState = 42
    end
end
expect(pendingTaskBoxAllLeftState, 42)
time.sleep(300)

int pendingTaskBoxAllLateState = 0
try
    TaskBox pendingTaskBoxAllLateValue = await pendingTaskBoxAllRight
    pendingTaskBoxAllLateState = pendingTaskBoxAllLateValue.add(0)
catch e
    if e.message == "future cancel requested." then
        pendingTaskBoxAllLateState = 42
    end
end
expect(pendingTaskBoxAllLateState, 42)

