future<int> namedRaceFuture = task.race([addAsync(12, 0)])
int namedRaceValue = await namedRaceFuture
expect(namedRaceValue, 12)
bool cancelNamedRaceCompleted = task.cancel(namedRaceFuture)
expect(cancelNamedRaceCompleted, 0)
int postCancelNamedRaceValue = await namedRaceFuture
expect(postCancelNamedRaceValue, 12)

array<string> stringAll = await task.all([greetAsync("alpha"), greetAsync("beta")])
expect(stringAll.length, 2)
assert stringAll[0] == "hello alpha", "task.all should retain first string result"
assert stringAll[1] == "hello beta", "task.all should retain second string result"

future<array<string>> namedStringAllFuture = task.all([greetAsync("left"), greetAsync("right")])
array<string> namedStringAllA = await namedStringAllFuture
array<string> namedStringAllB = await namedStringAllFuture
expect(namedStringAllA.length, 2)
expect(namedStringAllB.length, 2)
assert namedStringAllA[0] == "hello left", "named task.all string first await"
assert namedStringAllB[1] == "hello right", "named task.all string second await"
bool cancelNamedStringAllCompleted = task.cancel(namedStringAllFuture)
expect(cancelNamedStringAllCompleted, 0)
array<string> postCancelNamedStringAll = await namedStringAllFuture
expect(postCancelNamedStringAll.length, 2)
assert postCancelNamedStringAll[0] == "hello left", "post-cancel named task.all string first"
assert postCancelNamedStringAll[1] == "hello right", "post-cancel named task.all string second"

array<future<string>> typedStringAllJobs = array[greetAsync("typed-left"), greetAsync("typed-right")]
array<string> typedStringAll = await task.all(typedStringAllJobs)
expect(typedStringAll.length, 2)
assert typedStringAll[0] == "hello typed-left", "task.all typed string first"
assert typedStringAll[1] == "hello typed-right", "task.all typed string second"

string stringRace = await task.race([greetAsync("gamma")])
assert stringRace == "hello gamma", "task.race should return string result"

future<string> namedStringRaceFuture = task.race([greetAsync("delta")])
string namedStringRaceValue = await namedStringRaceFuture
assert namedStringRaceValue == "hello delta", "named task.race string result"
bool cancelNamedStringRaceCompleted = task.cancel(namedStringRaceFuture)
expect(cancelNamedStringRaceCompleted, 0)
string postCancelNamedStringRaceValue = await namedStringRaceFuture
assert postCancelNamedStringRaceValue == "hello delta", "post-cancel named task.race string result"

array<future<string>> stringRaceJobs = array[greetAsync("typed-race-string")]
string typedStringRace = await task.race(stringRaceJobs)
assert typedStringRace == "hello typed-race-string", "task.race typed string array result"

array<bool> boolAll = await task.all([flipAsync(true), flipAsync(false)])
expect(boolAll.length, 2)
expect(int(boolAll[0]), 0)
expect(int(boolAll[1]), 1)

future<array<bool>> namedBoolAllFuture = task.all([flipAsync(false), flipAsync(false)])
array<bool> namedBoolAllA = await namedBoolAllFuture
array<bool> namedBoolAllB = await namedBoolAllFuture
expect(namedBoolAllA.length, 2)
expect(namedBoolAllB.length, 2)
expect(int(namedBoolAllA[0]), 1)
expect(int(namedBoolAllB[1]), 1)
bool cancelNamedBoolAllCompleted = task.cancel(namedBoolAllFuture)
expect(cancelNamedBoolAllCompleted, 0)
array<bool> postCancelNamedBoolAll = await namedBoolAllFuture
expect(postCancelNamedBoolAll.length, 2)
expect(int(postCancelNamedBoolAll[0]), 1)
expect(int(postCancelNamedBoolAll[1]), 1)

array<future<bool>> typedBoolAllJobs = array[flipAsync(true), flipAsync(false)]
array<bool> typedBoolAll = await task.all(typedBoolAllJobs)
expect(typedBoolAll.length, 2)
expect(int(typedBoolAll[0]), 0)
expect(int(typedBoolAll[1]), 1)

bool boolRace = await task.race([flipAsync(true)])
expect(int(boolRace), 0)

future<bool> namedBoolRaceFuture = task.race([flipAsync(false)])
bool namedBoolRaceValue = await namedBoolRaceFuture
expect(int(namedBoolRaceValue), 1)
bool cancelNamedBoolRaceCompleted = task.cancel(namedBoolRaceFuture)
expect(cancelNamedBoolRaceCompleted, 0)
bool postCancelNamedBoolRaceValue = await namedBoolRaceFuture
expect(int(postCancelNamedBoolRaceValue), 1)

array<future<bool>> boolRaceJobs = array[flipAsync(false)]
bool typedBoolRace = await task.race(boolRaceJobs)
expect(int(typedBoolRace), 1)

array<float> floatAll = await task.all([addHalfAsync(1.5), addHalfAsync(2.5)])
expect(floatAll.length, 2)
assert floatAll[0] == 2.0, "task.all should keep first float result"
assert floatAll[1] == 3.0, "task.all should keep second float result"

future<array<float>> namedFloatAllFuture = task.all([addHalfAsync(3.5), addHalfAsync(4.5)])
array<float> namedFloatAllA = await namedFloatAllFuture
array<float> namedFloatAllB = await namedFloatAllFuture
expect(namedFloatAllA.length, 2)
expect(namedFloatAllB.length, 2)
assert namedFloatAllA[0] == 4.0, "named task.all float first await"
assert namedFloatAllB[1] == 5.0, "named task.all float second await"
bool cancelNamedFloatAllCompleted = task.cancel(namedFloatAllFuture)
expect(cancelNamedFloatAllCompleted, 0)
array<float> postCancelNamedFloatAll = await namedFloatAllFuture
expect(postCancelNamedFloatAll.length, 2)
assert postCancelNamedFloatAll[0] == 4.0, "post-cancel named task.all float first"
assert postCancelNamedFloatAll[1] == 5.0, "post-cancel named task.all float second"

array<future<float>> typedFloatAllJobs = array[addHalfAsync(5.5), addHalfAsync(6.5)]
array<float> typedFloatAll = await task.all(typedFloatAllJobs)
expect(typedFloatAll.length, 2)
assert typedFloatAll[0] == 6.0, "task.all typed float first"
assert typedFloatAll[1] == 7.0, "task.all typed float second"

float floatRace = await task.race([addHalfAsync(7.5)])
assert floatRace == 8.0, "task.race should return float result"

future<float> namedFloatRaceFuture = task.race([addHalfAsync(8.5)])
float namedFloatRaceValue = await namedFloatRaceFuture
assert namedFloatRaceValue == 9.0, "named task.race float result"
bool cancelNamedFloatRaceCompleted = task.cancel(namedFloatRaceFuture)
expect(cancelNamedFloatRaceCompleted, 0)
float postCancelNamedFloatRaceValue = await namedFloatRaceFuture
assert postCancelNamedFloatRaceValue == 9.0, "post-cancel named task.race float result"

array<future<float>> floatRaceJobs = array[addHalfAsync(8.5)]
float typedFloatRace = await task.race(floatRaceJobs)
assert typedFloatRace == 9.0, "task.race typed float array result"

future<int> cancelTarget = addAsync(30, 12)
bool cancelRequested = task.cancel(cancelTarget)
assert cancelRequested == true or cancelRequested == false, "task.cancel should return bool"

future<int> missingCancelFuture
bool cancelMissing = task.cancel(missingCancelFuture)
expect(cancelMissing, 0)

bool cancelTemporaryAsync = task.cancel(addAsync(50, 6))
assert cancelTemporaryAsync == true or cancelTemporaryAsync == false, "task.cancel should release temporary async future"

bool cancelTemporaryAll = task.cancel(task.all([addAsync(60, 1), addAsync(70, 2)]))
assert cancelTemporaryAll == true or cancelTemporaryAll == false, "task.cancel should release temporary task.all future"

bool cancelTemporaryRace = task.cancel(task.race([addAsync(80, 1), addAsync(90, 2)]))
assert cancelTemporaryRace == true or cancelTemporaryRace == false, "task.cancel should release temporary task.race future"

array<future<int>> cancelAllJobs = array[addAsync(100, 1), addAsync(110, 2)]
bool cancelTypedAll = task.cancel(task.all(cancelAllJobs))
assert cancelTypedAll == true or cancelTypedAll == false, "task.cancel should release temporary task.all future from typed array"

array<future<int>> cancelRaceJobs = array[addAsync(120, 1), addAsync(130, 2)]
bool cancelTypedRace = task.cancel(task.race(cancelRaceJobs))
assert cancelTypedRace == true or cancelTypedRace == false, "task.cancel should release temporary task.race future from typed array"

array<future<string>> cancelStringAllJobs = array[greetAsync("cancel-string-left"), greetAsync("cancel-string-right")]
bool cancelTypedStringAll = task.cancel(task.all(cancelStringAllJobs))
assert cancelTypedStringAll == true or cancelTypedStringAll == false, "task.cancel should release temporary string task.all future from typed array"

array<future<string>> cancelStringRaceJobs = array[greetAsync("cancel-string-race")]
bool cancelTypedStringRace = task.cancel(task.race(cancelStringRaceJobs))
assert cancelTypedStringRace == true or cancelTypedStringRace == false, "task.cancel should release temporary string task.race future from typed array"

bool cancelTemporaryBoolAll = task.cancel(task.all([flipAsync(true), flipAsync(false)]))
assert cancelTemporaryBoolAll == true or cancelTemporaryBoolAll == false, "task.cancel should release temporary bool task.all future"

bool cancelTemporaryBoolRace = task.cancel(task.race([flipAsync(true), flipAsync(false)]))
assert cancelTemporaryBoolRace == true or cancelTemporaryBoolRace == false, "task.cancel should release temporary bool task.race future"

array<future<bool>> cancelBoolAllJobs = array[flipAsync(true), flipAsync(false)]
bool cancelTypedBoolAll = task.cancel(task.all(cancelBoolAllJobs))
assert cancelTypedBoolAll == true or cancelTypedBoolAll == false, "task.cancel should release temporary bool task.all future from typed array"

array<future<bool>> cancelBoolRaceJobs = array[flipAsync(true), flipAsync(false)]
bool cancelTypedBoolRace = task.cancel(task.race(cancelBoolRaceJobs))
assert cancelTypedBoolRace == true or cancelTypedBoolRace == false, "task.cancel should release temporary bool task.race future from typed array"

bool cancelTemporaryFloatAll = task.cancel(task.all([addHalfAsync(9.5), addHalfAsync(10.5)]))
assert cancelTemporaryFloatAll == true or cancelTemporaryFloatAll == false, "task.cancel should release temporary float task.all future"

bool cancelTemporaryFloatRace = task.cancel(task.race([addHalfAsync(11.5), addHalfAsync(12.5)]))
assert cancelTemporaryFloatRace == true or cancelTemporaryFloatRace == false, "task.cancel should release temporary float task.race future"

array<future<float>> cancelFloatAllJobs = array[addHalfAsync(13.5), addHalfAsync(14.5)]
bool cancelTypedFloatAll = task.cancel(task.all(cancelFloatAllJobs))
assert cancelTypedFloatAll == true or cancelTypedFloatAll == false, "task.cancel should release temporary float task.all future from typed array"

array<future<float>> cancelFloatRaceJobs = array[addHalfAsync(15.5), addHalfAsync(16.5)]
bool cancelTypedFloatRace = task.cancel(task.race(cancelFloatRaceJobs))
assert cancelTypedFloatRace == true or cancelTypedFloatRace == false, "task.cancel should release temporary float task.race future from typed array"

future<int> completedTarget = addAsync(2, 3)
int completedValue = await completedTarget
expect(completedValue, 5)
bool cancelCompleted = task.cancel(completedTarget)
int cancelCompletedState = 0
if cancelCompleted then
    cancelCompletedState = 1
end
expect(cancelCompletedState, 0)

