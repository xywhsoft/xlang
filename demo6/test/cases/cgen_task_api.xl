extern "expect_i64" func expect(int actual, int expected)

async func addAsync(int a, int b) as int
    return a + b
end

async func greetAsync(string name) as string
    return "hello " + name
end

async func flipAsync(bool flag) as bool
    return not flag
end

async func addHalfAsync(float value) as float
    return value + 0.5
end

async func fastRaceAsync(int value) as int
    return value
end

async func slowRaceAsync(int value) as int
    time.sleep(250)
    return value
end

async func slowGreetAsync(string name) as string
    time.sleep(250)
    return "hello " + name
end

async func slowFlipAsync(bool flag) as bool
    time.sleep(250)
    return not flag
end

async func slowHalfAsync(float value) as float
    time.sleep(250)
    return value + 0.5
end

class TaskBox
    int base

    func add(int value) as int
        return self.base + value
    end
end

async func makeTaskBox(int base) as TaskBox
    TaskBox box
    box.base = base
    return box
end

async func slowMakeTaskBox(int base) as TaskBox
    time.sleep(250)
    TaskBox box
    box.base = base
    return box
end

func makeTaskAdderPlain(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

async func slowMakeTaskAdder(int base) as func(int) as int
    time.sleep(250)
    return makeTaskAdderPlain(base)
end

async func makeTaskAdder(int base) as func(int) as int
    return makeTaskAdderPlain(base)
end

async func failStringAsync() as string
    throw "task string boom"
    return ""
end

async func failBoolAsync() as bool
    throw "task bool boom"
    return false
end

async func failFloatAsync() as float
    throw "task float boom"
    return 0.0
end

async func failTaskBoxAsync() as TaskBox
    throw "task class boom"
    TaskBox box
    return box
end

async func failTaskAdderAsync() as func(int) as int
    throw "task function boom"
    return makeTaskAdderPlain(0)
end

future<int> one = addAsync(1, 2)
future<int> two = addAsync(3, 4)

array<int> literalAll = await task.all([one, two])
expect(literalAll.length, 2)
expect(literalAll[0], 3)
expect(literalAll[1], 7)

future<array<int>> namedAllFuture = task.all([addAsync(10, 1), addAsync(20, 2)])
array<int> namedAllA = await namedAllFuture
array<int> namedAllB = await namedAllFuture
expect(namedAllA.length, 2)
expect(namedAllB.length, 2)
expect(namedAllA[0], 11)
expect(namedAllB[1], 22)
bool cancelNamedAllCompleted = task.cancel(namedAllFuture)
expect(cancelNamedAllCompleted, 0)
array<int> postCancelNamedAll = await namedAllFuture
expect(postCancelNamedAll.length, 2)
expect(postCancelNamedAll[0], 11)
expect(postCancelNamedAll[1], 22)

future<int> three = addAsync(5, 6)
future<int> four = addAsync(7, 8)
array<future<int>> jobs = array[three, four]
array<int> typedAll = await task.all(jobs)
expect(typedAll.length, 2)
expect(typedAll[0], 11)
expect(typedAll[1], 15)

int raced = await task.race([addAsync(9, 1), addAsync(20, 2)])
assert raced == 10 or raced == 22, "task.race should return one completed value"

array<future<int>> raceJobs = array[addAsync(11, 1), addAsync(30, 3)]
int typedRaced = await task.race(raceJobs)
assert typedRaced == 12 or typedRaced == 33, "task.race should accept typed future arrays"

