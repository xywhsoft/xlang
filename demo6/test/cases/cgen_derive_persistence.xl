class Stats
    derive value

    int hp = 0
    float speed = 0.0
end

class Player extends object
    derive value

    int id = 0
    string name = ""
    Stats stats = Stats()
    int? score = null
    string? alias = null
    Stats? backup = null
    array<int>? levels = null
    var tags = []
end

extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectText(string actual, string expected)

auto p = Player()
p.id = 7
p.name = "hero"
p.stats.hp = 120
p.stats.speed = 3.5
p.score = 42
p.backup = Stats()
Stats backup = p.backup as Stats
backup.hp = 80
p.levels = array[3, 5, 8]
p.tags = ["tank", "lead"]
p.rank = 9

auto jsonText = json.stringify(p)
auto fromJson = json.parse::<Player>(jsonText)
expect(fromJson.id, 7)
expectText(fromJson.name, "hero")
expect(fromJson.stats.hp, 120)
assert fromJson.score != null, "nullable scalar should survive JSON"
expect(fromJson.score as int, 42)
assert fromJson.alias == null, "nullable string null should survive JSON"
Stats jsonBackup = fromJson.backup as Stats
expect(jsonBackup.hp, 80)
array<int>? jsonLevelsMaybe = fromJson.levels
if jsonLevelsMaybe != null then
    expect(jsonLevelsMaybe[2], 8)
else
    throw "nullable array should survive JSON"
end
expect(int(fromJson.rank), 9)
expectText(string(fromJson.tags[0]), "tank")

auto xlonText = xlon.stringify(p)
auto fromXlon = xlon.parse::<Player>(xlonText)
expect(fromXlon.id, 7)
expectText(fromXlon.name, "hero")
expect(fromXlon.stats.hp, 120)
assert fromXlon.score != null, "nullable scalar should survive XLON"
expect(fromXlon.score as int, 42)
assert fromXlon.alias == null, "nullable string null should survive XLON"
Stats xlonBackup = fromXlon.backup as Stats
expect(xlonBackup.hp, 80)
array<int>? xlonLevelsMaybe = fromXlon.levels
if xlonLevelsMaybe != null then
    expect(xlonLevelsMaybe[1], 5)
else
    throw "nullable array should survive XLON"
end
expect(int(fromXlon.rank), 9)
expectText(string(fromXlon.tags[1]), "lead")

string jsonPath = "build/test/cgen_derive_persistence.json"
string xlonPath = "build/test/cgen_derive_persistence.xlon"
file.delete(jsonPath)
file.delete(xlonPath)

assert json.write(jsonPath, p, true), "json class persistence write should succeed"
auto fromJsonFile = json.read::<Player>(jsonPath)
expect(fromJsonFile.id, 7)
expectText(fromJsonFile.name, "hero")

assert xlon.write(xlonPath, p), "xlon class persistence write should succeed"
auto fromXlonFile = xlon.read::<Player>(xlonPath)
expect(fromXlonFile.stats.hp, 120)
expectText(string(fromXlonFile.tags[1]), "lead")

file.delete(jsonPath)
file.delete(xlonPath)
