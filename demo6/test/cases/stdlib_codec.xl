assert codec.hexEncode("xlang") == "786c616e67"
assert codec.hexDecode("786C616E67") == b"xlang"
assert codec.base64Encode("xlang") == "eGxhbmc="
assert codec.base64Decode("eGxhbmc=") == b"xlang"
assert codec.percentEncode("alice bob/ok") == "alice%20bob%2Fok"
assert codec.percentDecode("alice+bob%2Fok") == b"alice+bob/ok"
assert codec.hexDecode(codec.hexEncode("a\0b")) == b"a\0b"
assert codec.base64Decode(codec.base64Encode("a\0b")) == b"a\0b"
assert codec.percentDecode(codec.percentEncode("a\0b")) == b"a\0b"
bytes raw = b"\0\xffAZ"
assert codec.hexEncode(raw) == "00ff415a"
assert codec.hexDecode("00FF415A") == raw
assert codec.base64Encode(raw) == "AP9BWg=="
assert codec.base64Decode("AP9BWg==") == raw
assert codec.percentDecode(codec.percentEncode(raw)) == raw
assert encoding.decodeUtf8(codec.hexDecode("786c616e67")) == "xlang"
println("codec safe value interfaces passed")
