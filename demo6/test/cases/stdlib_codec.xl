extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

expectStr(codec.hexEncode("xlang"), "786C616E67")
expectStr(codec.hexDecode("786C616E67"), "xlang")
expectStr(codec.hexDecode("786c616e67"), "xlang")

expectStr(codec.base64Encode("xlang"), "eGxhbmc=")
expectStr(codec.base64Decode("eGxhbmc="), "xlang")

expectStr(codec.hexDecode(codec.hexEncode("hello")), "hello")
expectStr(codec.base64Decode(codec.base64Encode("hello")), "hello")

expect(string.len(codec.hexEncode("abc")), 6)
expect(string.len(codec.base64Encode("abc")), 4)
