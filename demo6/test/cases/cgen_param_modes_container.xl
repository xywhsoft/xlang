func appendShared(array<int> values)
    values.append(2)
end

func appendCopy(array<int> values)
    values.append(3)
end

func rebindLocal(array<int> values)
    values = array[90]
end

func replaceArray(array<int> values) as array<int>
    array<int> next = array[7, 8]
    return next
end

func writeArray() as array<int>
    array<int> next = array[9]
    return next
end

func main(...) as int
    array<int> source = array[1]
    array<int> alias = source
    alias.append(4)
    assert source.length == 2
    assert source[1] == 4

    appendShared(source)
    assert source.length == 3
    assert source[2] == 2

    appendCopy(source)
    assert source.length == 4
    assert source[3] == 3

    rebindLocal(source)
    assert source.length == 4
    assert source[0] == 1

    source = replaceArray(source)
    assert source.length == 2
    assert source[0] == 7

    array<int> output = writeArray()
    assert output.length == 1
    assert output[0] == 9
    return 0
end
