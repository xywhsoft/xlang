import lapack

func main(...) as int
    // Routine categories
    assert lapack.routineCategory(0) == "linear solve", "cat solve"
    assert lapack.routineCategory(2) == "eigenvalue", "cat eigen"
    assert lapack.routineCategory(3) == "singular value", "cat svd"

    // Routine names
    assert lapack.routineName(0) == "dgesv", "name dgesv"
    assert lapack.routineName(4) == "dgetrf", "name dgetrf"
    assert lapack.routineName(8) == "dgeev", "name dgeev"

    // Info codes
    assert lapack.infoCode(0) == "success", "info 0"
    assert lapack.infoCode(-1) == "illegal argument", "info neg"
    assert lapack.infoCode(3) == "convergence failure", "info pos"

    // Solve 2x2: [[2,1],[1,3]] * x = [5,10] => x = [1,3]
    assert lapack.solve2x2("2,1,1,3", "5,10") == "1,3", "solve2x2"

    // Determinant: [[2,1],[1,3]] det = 6-1 = 5
    assert lapack.det2x2("2,1,1,3") == 5.0, "det2x2"

    // Trace of 2x2: [[1,2],[3,4]] trace = 1+4 = 5
    assert lapack.trace("1,2,3,4", 2) == 5.0, "trace"

    // Norm types
    assert lapack.normType(0) == "1-norm (max column sum)", "norm 1"
    assert lapack.normType(2) == "Frobenius norm", "norm frob"

    return 0
end
