extern "xrtClearError" func clearNativeError()
extern "xrtValuePointer" func boxedPointer(point target) as var

string path = "build/test/xlir_xson_value_bridge.xson"
file.delete(path)
string custom = '{"keep":1,"skip":ptr("123"),"after":2}'
XsonOptions decode = xson.options(ignoreUnsupportedDecode = true)
XsonOptions encode = xson.options(pretty = true, ignoreUnsupportedEncode = true)
assert !xson.valid(custom)
assert xson.parse(custom) == null
clearNativeError()
assert xson.valid(custom, decode)
var decoded = xson.parse(custom, decode)
assert decoded["keep"] == 1
assert decoded["skip"] == null
assert decoded["after"] == 2
assert file.writeText(path, custom)
assert xson.read(path) == null
clearNativeError()
assert xson.read(path, decode)["after"] == 2

var value = xson.parse('{"name":"中文","items":[null,true,42],"mapping":intmap{2:"two"},"tags":set[1,2],"when":time("2026-06-18T00:00:00Z")}')
string compact = xson.stringify(value)
string pretty = xson.stringify(value, encode)
assert xson.valid(compact)
assert xson.valid(pretty)
assert string.len(pretty) > string.len(compact)
assert xson.stringify(xson.parse(pretty)) == compact
assert xson.write(path, value)
assert xson.stringify(xson.read(path)) == compact
assert xson.write(path, value, encode)
assert xson.stringify(xson.read(path, decode)) == compact
assert value["name"] == "中文"
assert file.delete(path)
assert xson.read(path) == null
assert !xson.valid("")
assert xson.parse("{") == null
clearNativeError()
assert xson.stringify(xson.parse("null")) == "null"

// Unsupported native values must be skipped only by the explicit policy.
var unsupported = {"keep": 1, "skip": boxedPointer(null), "after": 2}
assert xson.stringify(unsupported) == ""
clearNativeError()
string skipped = xson.stringify(unsupported, encode)
assert !string.contains(skipped, "skip")
assert xson.parse(skipped)["after"] == 2
assert xson.write(path, unsupported, encode)
assert xson.read(path)["keep"] == 1
assert file.delete(path)
