func main(...) as int
    auto requestWire = Buffer("POST /upload?q=1 HTTP/1.1\r\nHost: example.test\r\nContent-Length: 5\r\nX-Trace: abc\r\n\r\nhello")
    auto request = Http1Head.request(requestWire)
    if request == null then throw ValueError "expected request head" end
    assert request.kind == HttpMessageKind.request
    assert request.version == HttpVersion.v11
    assert request.method == "POST"
    assert request.target == "/upload?q=1"
    assert request.contentLength == uint64(5)
    assert (request.getText("host") as string) == "example.test"
    assert request.fieldCount == 3 and request.headerBytes == 82
    requestWire.clear()
    assert request.method == "POST" and (request.getText("X-Trace") as string) == "abc"
    auto fixedBody = Http1BodyReader(request)
    auto decoded = Buffer()
    assert fixedBody.readInto(b"hello", decoded) == HttpBodyStatus.data
    assert fixedBody.consumed == 5 and decoded.text() == "hello"
    assert fixedBody.readInto(b"", decoded, true) == HttpBodyStatus.done
    assert fixedBody.done and fixedBody.received == uint64(5)
    auto responseFields = HttpHeaders.parse("Content-Type: application/json\r\nContent-Length: 2\r\n")
    assert Http1.responseHead(200, "OK", responseFields) == b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n"
    assert Http1.requestHead("GET", "/health", HttpHeaders.parse("Host: localhost\r\n")) == b"GET /health HTTP/1.1\r\nHost: localhost\r\n\r\n"
    assert Http1.chunkLine(uint64(5)) == b"5\r\n"
    assert Http1.chunk(b"hello") == b"5\r\nhello\r\n"
    assert Http1.chunkEnd(HttpHeaders.parse("Digest: ok\r\n")) == b"0\r\nDigest: ok\r\n\r\n"
    auto chunkedHead = Http1Head.response("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n")
    if chunkedHead == null then throw ValueError "expected response head" end
    auto chunkedBody = Http1BodyReader(chunkedHead)
    decoded.clear()
    assert chunkedBody.readInto(b"5\r\nhello", decoded) == HttpBodyStatus.data
    assert decoded.text() == "hello"
    auto chunkEnd = Buffer("\r\n0\r\nDigest: ok\r\n\r\n")
    assert chunkedBody.readInto(chunkEnd, decoded) == HttpBodyStatus.done
    auto trailers = chunkedBody.trailers()
    chunkEnd.clear()
    assert trailers.length == 1 and trailers.nameAt(0) == "Digest" and trailers.textAt(0) == "ok"
    array<int> gzipBytes = [
        31, 139, 8, 0, 0, 0, 0, 0,
        2, 255, 203, 72, 205, 201, 201, 87,
        72, 206, 207, 45, 40, 74, 45, 46,
        78, 77, 81, 40, 207, 47, 202, 73,
        1, 0, 161, 45, 148, 83, 22, 0,
        0, 0
    ]
    auto gzip = Buffer()
    for value in gzipBytes
        gzip.appendByte(value)
    end
    auto decoder = HttpContentDecoder(HttpHeaders.parse("Content-Encoding: gzip\r\n"))
    decoded.clear()
    decoder.write(gzip, decoded, true)
    assert decoder.done and decoder.inputSize == uint64(gzip.length)
    assert decoded.text() == "hello compressed world"
    println("stdlib http1 core ok")
    return 0
end
