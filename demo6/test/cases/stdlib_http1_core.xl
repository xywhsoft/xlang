Buffer requestWire = Buffer()
assert requestWire.append("POST /upload?q=1 HTTP/1.1\r\nHost: example.test\r\nContent-Length: 5\r\nX-Trace: abc\r\n\r\nhello")

Http1Head request = Http1Head.request(requestWire)
assert request.ready
assert request.kind == 1
assert request.version == 11
assert request.method() == "POST"
assert request.target() == "/upload?q=1"
assert request.contentLength == uint64(5)
assert request.field("host") == "example.test"
assert request.fieldCount == 3
assert request.headerBytes == 82

requestWire.clear()
assert request.method() == "POST"
assert request.field("X-Trace") == "abc"

Http1Body fixedBody = request.body()
Buffer fixedInput = Buffer()
assert fixedInput.append("hello")
assert fixedBody.read(fixedInput) == 1
assert fixedBody.consumed == 5
assert fixedBody.dataSize == 5
assert fixedBody.dataCopy().text() == "hello"
Buffer empty = Buffer()
assert fixedBody.read(empty, true) == 2
assert fixedBody.done
assert fixedBody.received == uint64(5)

Buffer responseHead = Http1.responseHead(
    200,
    "OK",
    "Content-Type: application/json\r\nContent-Length: 2\r\n"
)
assert responseHead.text() == "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n"

Buffer requestHead = Http1.requestHead("GET", "/health", "Host: localhost\r\n")
assert requestHead.text() == "GET /health HTTP/1.1\r\nHost: localhost\r\n\r\n"

assert Http1.chunkHead(uint64(5)).text() == "5\r\n"
Buffer hello = Buffer()
assert hello.append("hello")
assert Http1.chunk(hello).text() == "5\r\nhello\r\n"
assert Http1.chunkEnd("Digest: ok\r\n").text() == "0\r\nDigest: ok\r\n\r\n"

Buffer chunkedWire = Buffer()
assert chunkedWire.append("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n")
Http1Head chunkedHead = Http1Head.response(chunkedWire)
assert chunkedHead.ready
Http1Body chunkedBody = chunkedHead.body("GET")

Buffer chunkData = Buffer()
assert chunkData.append("5\r\nhello")
assert chunkedBody.read(chunkData) == 1
assert chunkedBody.dataCopy().text() == "hello"

Buffer chunkEnd = Buffer()
assert chunkEnd.append("\r\n0\r\nDigest: ok\r\n\r\n")
assert chunkedBody.read(chunkEnd) == 2
assert chunkedBody.done
assert chunkedBody.trailerCount == 1
assert chunkedBody.trailerName(0) == "Digest"
assert chunkedBody.trailerValue(0) == "ok"
chunkEnd.clear()
assert chunkedBody.trailerValue(0) == "ok"

array<int> gzipBytes = [
    31, 139, 8, 0, 0, 0, 0, 0,
    2, 255, 203, 72, 205, 201, 201, 87,
    72, 206, 207, 45, 40, 74, 45, 46,
    78, 77, 81, 40, 207, 47, 202, 73,
    1, 0, 161, 45, 148, 83, 22, 0,
    0, 0
]
Buffer gzip = Buffer()
for value in gzipBytes
    assert gzip.appendByte(value)
end

HttpDecoder decoder = HttpDecoder("gzip")
assert decoder.write(gzip, true)
assert decoder.done
assert decoder.inputSize == uint64(gzip.len())
assert decoder.take().text() == "hello compressed world"
assert decoder.pending == 0

println("stdlib http1 core ok")
