import modbus



func main(...) as int
    // FC3 读保持寄存器请求：tid=1, unit=1, 起始 0, 数量 2
    string req = modbus.buildReadHolding(1, 1, 0, 2)
    assert req == "000100000006010300000002", "fc3 request frame"

    // FC6 写单寄存器请求
    string wr = modbus.buildWriteSingle(7, 2, 100, 4660)
    assert wr == "000700000006020600641234", "fc6 request frame"

    // FC1 读线圈
    assert modbus.buildReadCoils(1, 1, 0, 10) == "00010000000601010000000a", "fc1 frame"

    // 读应答：字节数 4，寄存器值 0x1234、0x5678
    var r = modbus.parseResponse("00010000000501030412345678")
    assert r["transaction"] == 1, "transaction echo"
    assert r["unit"] == 1, "unit echo"
    assert r["function"] == 3, "function echo"
    assert r["exception"] == 0, "no exception"
    assert r["values"][0] == 4660, "register 0x1234"
    assert r["values"][1] == 22136, "register 0x5678"

    // 写应答回显
    r = modbus.parseResponse("000700000006020600641234")
    assert r["address"] == 100, "write address echo"
    assert r["value"] == 4660, "write value echo"

    // 线圈应答按字节
    r = modbus.parseResponse("0001000000050102020105")
    assert r["values"][0] == 1, "coil byte 0x01"
    assert r["values"][1] == 5, "coil byte 0x05"

    // 异常帧：FC3 + 0x83，代码 2（非法地址）
    r = modbus.parseResponse("000100000003018302")
    assert r["exception"] == 1, "exception flag"
    assert r["exceptionCode"] == 2, "illegal address"

    // hex ↔ Buffer 往返
    Buffer frame = modbus.hexToFrame(req)
    assert int(frame.len()) == 12, "frame buffer size"
    assert modbus.frameToHex(frame) == req, "frame round trip"

    // 错误路径
    int raised = 0
    try
        modbus.buildReadHolding(1, 1, 0, 200)
    catch e
        raised = 1
    end
    assert raised == 1, "quantity over 125 raises"

    raised = 0
    try
        modbus.parseResponse("deadbeef")
    catch e
        raised = 1
    end
    assert raised == 1, "malformed frame raises"

    raised = 0
    try
        modbus.parseResponse("000100000005010305123456")
    catch e
        raised = 1
    end
    assert raised == 1, "odd byte count raises"

    return 0
end
