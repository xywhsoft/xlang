import tcc

func expect(int actual, int expected, string name)
    if actual != expected then
        print("expect failed: " + name)
        assert false
    end
end

int rc = tcc.run("#include <stdio.h>\nint main(void){ puts(\"c from xlang tcc.run\"); return 0; }\n")
println("tcc.run rc", rc)
expect(rc, 0, "tcc.run")

TccContext ctx = tcc.Context()
int compileRc = int(ctx.compileString("int main(void){ return 0; }\n"))
println("context compile rc", compileRc)
expect(compileRc, 0, "context compile string")
int contextRunRc = ctx.run()
println("context run rc", contextRunRc)
expect(contextRunRc, 0, "context run")

TccContext xrtCtx = tcc.Context()
string xrtSymbolSource = "#include <stddef.h>\n#include <stdbool.h>\ntypedef struct xrt_net_future xfuture;\ntypedef struct xrt_web_app xwebapp;\ntypedef struct xrt_web_server xwebserver;\ntypedef struct xrt_web_request xwebrequest;\ntypedef struct xrt_web_response xwebresponse;\nbool xrtWebResponseReserveBody(xwebresponse* pResp, size_t iCap);\nbool xrtWebResponseAppendBody(xwebresponse* pResp, const void* pData, size_t iLen);\nbool xrtWebResponseAppendText(xwebresponse* pResp, const char* sText);\nbool xrtWebAppStreamRouteAsync(xwebapp* pApp, unsigned int iMethodMask, const char* sPattern, bool (*pBegin)(xwebrequest* pReq, void* pUserData), bool (*pBody)(xwebrequest* pReq, const void* pData, size_t iLen, void* pUserData), xfuture* (*pEndAsync)(xwebrequest* pReq, void* pUserData), void* pUserData);\nbool xrtWebServerStreamRouteAsync(xwebserver* pServer, unsigned int iMethodMask, const char* sPattern, bool (*pBegin)(xwebrequest* pReq, void* pUserData), bool (*pBody)(xwebrequest* pReq, const void* pData, size_t iLen, void* pUserData), xfuture* (*pEndAsync)(xwebrequest* pReq, void* pUserData), void* pUserData);\nint main(void){ return (xrtWebResponseReserveBody && xrtWebResponseAppendBody && xrtWebResponseAppendText && xrtWebAppStreamRouteAsync && xrtWebServerStreamRouteAsync) ? 0 : 1; }\n"
expect(int(xrtCtx.compileString(xrtSymbolSource)), 0, "xrt response append symbol compile")
expect(xrtCtx.run(), 0, "xrt response append symbol run")

int modeSum = tcc.MEMORY + tcc.EXE + tcc.OBJ + tcc.DLL + tcc.PREPROCESS
expect(modeSum, 15, "tcc output type constants")

if not tcc.vfsMount("__xlvfs__/embed_test.c", "int main(void){ return 0; }\n") then
    assert false
end
int runFileRc = tcc.runFile("__xlvfs__/embed_test.c")
println("tcc.runFile rc", runFileRc)
expect(runFileRc, 0, "tcc.runFile dynamic vfs")

int compileRc2 = tcc.compile("int main(void){ return 0; }\n", "build/test/stdlib_tcc_compile.exe", tcc.EXE)
println("tcc.compile rc", compileRc2)
expect(compileRc2, 0, "tcc.compile")

int compileFileRc = tcc.compileFile("__xlvfs__/embed_test.c", "build/test/stdlib_tcc_compile_file.exe", tcc.EXE)
println("tcc.compileFile rc", compileFileRc)
expect(compileFileRc, 0, "tcc.compileFile")
tcc.vfsClear()

println("stdlib tcc embed ok")
