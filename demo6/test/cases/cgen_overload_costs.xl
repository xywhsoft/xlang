// Default int/float are 64-bit; alternatives need genuinely distinct widths.
func choose(int value) as int
    return 10
end

func choose(int32 value) as int
    return 20
end

func chooseFloat(float value) as int
    return 30
end

func chooseFloat(float32 value) as int
    return 40
end

extern "expect_i64" func expect(int actual, int expected)

expect(choose(1), 10)
expect(choose(int32(1)), 20)
expect(chooseFloat(1.5), 30)
expect(chooseFloat(float32(1.5)), 40)
