import argon2

func main(...) as int
    string salt = argon2.generateSalt(16)
    assert salt.length == 32, "secure salt length"

    string encoded = argon2.hash(
        "password",
        timeCost = 1,
        memoryCost = 64,
        parallelism = 1
    )
    assert encoded.length > 0, "argon2 hash output"
    assert string.byteAt(encoded, 0) == 36, "PHC prefix"
    assert argon2.verify("password", encoded), "argon2 verify"
    assert not argon2.verify("wrong", encoded), "argon2 reject"

    // RFC 9106 section 5.3 Argon2id vector.
    string vector = argon2.hashRaw(
        "\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01",
        salt = "\x02\x02\x02\x02\x02\x02\x02\x02\x02\x02\x02\x02\x02\x02\x02\x02",
        secret = "\x03\x03\x03\x03\x03\x03\x03\x03",
        ad = "\x04\x04\x04\x04\x04\x04\x04\x04\x04\x04\x04\x04",
        timeCost = 3,
        memoryCost = 32,
        parallelism = 4,
        hashLen = 32,
        type = argon2.ARGON2ID
    )
    assert vector == "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659", "RFC 9106 Argon2id vector"

    println("argon2_smoke=ok")
    return 0
end
