import xxhash



func main(...) as int
    // 一次性哈希：Buffer 与字符串重载结果一致。
    Buffer data = Buffer()
    data.append("abc")
    data.appendByte(0)
    data.appendByte(255)
    int h64 = xxhash.hash64(data)
    if xxhash.hash64(data) != h64 then
        return 1
    end

    // 十六进制输出长度固定：64 位 16 字符、32 位 8 字符。
    string hex64 = xxhash.hash64Hex(data)
    if string.len(hex64) != 16 then
        return 2
    end
    string hex32 = xxhash.hash32Hex(data)
    if string.len(hex32) != 8 then
        return 3
    end

    // 种子改变哈希分布：不同种子结果不同。
    if xxhash.hash64(data, 1) == h64 then
        return 4
    end

    // 流式哈希器：分段 update 的 digest 与一次性哈希相等。
    auto hasher = xxhash.hasher()
    hasher.update("abc")
    Buffer tail = Buffer()
    tail.appendByte(0)
    tail.appendByte(255)
    hasher.update(tail)
    if hasher.digest() != h64 then
        return 5
    end
    if hasher.digestHex() != hex64 then
        return 6
    end
    if hasher.inputBytes != data.len() then
        return 7
    end

    // reset 复位后重新计算，状态清空。
    hasher.reset()
    hasher.update("abc")
    if hasher.inputBytes != 3 then
        return 8
    end
    if hasher.digest() != xxhash.hash64("abc") then
        return 9
    end

    // 32 位一次性与字符串重载一致。
    if xxhash.hash32(data) != xxhash.hash32(data) then
        return 10
    end

    // 文件哈希与等内容的 Buffer 哈希一致（XRT reader 分块读取）。
    string path = "tmp/extlib_xxhash_source.bin"
    file.writeBytes(path, data)
    if xxhash.hashFile64(path) != h64 then
        return 11
    end
    if xxhash.hashFile64Hex(path) != hex64 then
        return 12
    end
    file.delete(path)

    // 不存在的文件抛出 FileError。
    bool missing = false
    try
        xxhash.hashFile64("tmp/extlib_xxhash_missing.bin")
    catch FileError e
        missing = true
    end
    if not missing then
        return 13
    end

    // 非法限额抛出 ValueError。
    bool badLimit = false
    try
        xxhash.hasher(0, 0)
    catch ValueError e
        badLimit = true
    end
    if not badLimit then
        return 14
    end

    return 0
end
