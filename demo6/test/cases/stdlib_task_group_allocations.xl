extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()
async func ready() as int
    return 7
end
func main(...) as int
    int failures = 0
    int successes = 0
    for operation in range(4)
        for point in range(32)
            TaskGroup group = task.group()
            future<int> source = ready()
            assert source.wait()
            bool caught = false
            assert failAfter(uint64(point))
            try
                if operation == 0 then
                    TaskGroup local = task.group()
                elseif operation == 1 then
                    TaskGroup child = group.child()
                elseif operation == 2 then
                    assert group.bindParent(source)
                else
                    future<null> done = group.joinAsync()
                    assert done.wait()
                end
            catch failure
                caught = true
            end
            bool hit = failTriggered()
            failClear()
            assert hit == caught
            if hit then failures += 1 else successes += 1 end
        end
    end
    assert failures > 0 and successes > 0
    print("task-group-allocations")
    return 0
end
