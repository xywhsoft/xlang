import msgpack

func main(...) as int
    var source = {
        "name": "xlang",
        "version": 6,
        "enabled": true,
        "ratio": 2.5,
        "items": ["one", 2, false],
        "none": null
    }
    Buffer encoded = msgpack.encode(source)
    assert encoded.len() > 0, "generic encode returns bytes"
    assert string.startsWith(msgpack.toHex(encoded), "86"), "top-level map"

    var decoded = msgpack.decode(encoded)
    assert decoded["name"] == "xlang", "string roundtrip"
    assert decoded["version"] == 6, "integer roundtrip"
    assert decoded["enabled"] == true, "boolean roundtrip"
    assert decoded["ratio"] > 2.49 and decoded["ratio"] < 2.51, "float roundtrip"
    assert decoded["items"][2] == false, "array roundtrip"
    assert decoded["none"] == null, "null roundtrip"

    Buffer bytes = Buffer()
    bytes.appendByte(0xca)
    bytes.appendByte(0xfe)
    Buffer encodedBytes = msgpack.encodeBytes(bytes)
    assert msgpack.toHex(encodedBytes) == "c402cafe", "binary encoding"
    assert msgpack.toHex(msgpack.decodeBytes(encodedBytes)) == "cafe", "binary roundtrip"
    Buffer empty = Buffer()
    assert msgpack.toHex(msgpack.encodeBytes(empty)) == "c400", "empty byte string"

    bool caught = false
    try
        Buffer truncated = msgpack.fromHex("82a16101")
        msgpack.decode(truncated)
    catch ValueError e
        caught = true
    end
    assert caught, "truncated map must throw"
    return 0
end
