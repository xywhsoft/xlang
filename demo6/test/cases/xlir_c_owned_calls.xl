extern "c_owned_text" @no_raise func nativeText() as point
extern "c_owned_binary" @no_raise func nativeBytes() as point
extern "c_owned_release" @no_raise func nativeFree(point data)
extern "c_owned_text_is_original" @no_raise func original(string text) as bool
extern "c_owned_binary_span_original" @no_raise func originalBytes(cbytes data) as bool
extern "c_owned_released" @no_raise func released() as int
extern "c_owned_debug" @no_raise func debugMemory() as bool
extern "c_owned_allocations" @no_raise func allocations() as int
func choose<T,U>(T value, U ignored) as T
    return value
end
func recursive<T>(T value, int depth = 1) as T
    if depth == 0 then return value end
    return recursive::<T>(value, depth - 1)
end
func reader(string value) as bool
    return original(value)
end
func many(string x0, string x1, string x2, string x3, string x4, string x5, string x6, string x7, string x8, string x9, string x10, string x11, string x12, string x13, string x14, string x15, string x16, string x17, string x18, string x19, string x20, string x21, string x22, string x23, string x24, string x25, string x26, string x27, string x28, string x29, string x30, string x31, string x32, string x33, string x34, string x35, string x36, string x37, string x38, string x39, string x40, string x41, string x42, string x43, string x44, string x45, string x46, string x47, string x48, string x49, string x50, string x51, string x52, string x53, string x54, string x55, string x56, string x57, string x58, string x59, string x60, string x61, string x62, string x63, string x64) as string
    return x64
end
func checkCalls()
    bool tracking = debugMemory()
    cstring text = cstring.take(nativeText(), nativeFree)
    cbytes data = cbytes.take(nativeBytes(), 4, nativeFree)
    auto callback = reader
    int before = allocations()
    assert original(choose::<string,int>(text,42))
    assert original(choose::<string,bool>(text,true))
    assert original(choose(text,42))
    assert original(recursive::<string>(text,2))
    assert originalBytes(choose::<bytes,int>(data,1))
    assert originalBytes(choose(data,true))
    assert callback(text)
    assert original(many(text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text))
    if tracking then assert allocations() == before end
    assert callback(cstring.take(nativeText(), nativeFree))
    assert released() == 1
end
checkCalls()
assert released() == 3

func factory() as func() as cstring
    return func() as cstring => cstring.take(nativeText(),nativeFree)
end
func binaryFactory() as func() as cbytes
    return func() as cbytes => cbytes.take(nativeBytes(),4,nativeFree)
end
func checkResultCallbacks()
    auto callback = factory()
    auto binaryCallback = binaryFactory()
    string text = callback()
    bytes data = binaryCallback()
    assert original(text) and originalBytes(data)
end
checkResultCallbacks()
assert released() == 5
