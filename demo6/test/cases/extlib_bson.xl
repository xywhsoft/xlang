import bson

func main(...) as int
    // Scalar, null and int64 roundtrip.
    var source = {
        "name": "Alice",
        "age": 30,
        "active": true,
        "score": 3.5,
        "nothing": null,
        "big": 9876543210
    }
    var encoded = bson.encode(source)
    assert bson.docLength(encoded) > 0, "encoded document has bytes"

    var decoded = bson.decode(encoded)
    assert decoded["name"] == "Alice", "string roundtrip"
    assert decoded["age"] == 30, "int32 roundtrip"
    assert decoded["active"] == true, "bool roundtrip"
    assert decoded["score"] > 3.49 and decoded["score"] < 3.51, "float roundtrip"
    assert decoded["nothing"] == null, "null roundtrip"
    assert decoded["big"] == 9876543210, "int64 roundtrip"

    // Nested documents and arrays retain their shape.
    var complex = {
        "profile": {"city": "Beijing", "zip": 100000},
        "tags": ["dev", "xlang", "bson"]
    }
    var complexDecoded = bson.decode(bson.encode(complex))
    assert complexDecoded["profile"]["city"] == "Beijing", "nested document"
    assert complexDecoded["tags"].length == 3, "array length"
    assert complexDecoded["tags"][2] == "bson", "array element"

    // Concatenated document streams preserve order and reject trailing bytes.
    var first = {"id": 1, "message": "hello"}
    var second = {"id": 2, "message": "world"}
    var stream = bson.concat(bson.encode(first), bson.encode(second))
    var documents = bson.decodeAll(stream)
    assert documents.length == 2, "multi-document count"
    assert documents[0]["id"] == 1, "first document"
    assert documents[1]["message"] == "world", "second document"

    string oid = bson.objectId()
    assert string.len(oid) == 24, "ObjectId text length"
    assert time.toUnix(bson.oidTime(oid)) > 0, "ObjectId timestamp"
    assert string.len(bson.toHex(encoded)) == bson.docLength(encoded) * 2, "hex length"

    // XRT file APIs must support an UTF-8 file name on Windows.
    string filePath = "extlib_bson_测试.bson"
    assert bson.save(filePath, source) == bson.docLength(encoded), "save returns encoded size"
    var loaded = bson.load(filePath)
    assert loaded["name"] == "Alice", "load roundtrip"
    file.delete(filePath)

    bool caught = false
    try
        bson.decode("bad")
    catch ValueError e
        caught = true
    end
    assert caught, "truncated document must throw"

    caught = false
    try
        bson.decodeAll(bson.concat(encoded, "bad"))
    catch ValueError e
        caught = true
    end
    assert caught, "truncated document stream must throw"

    caught = false
    try
        bson.oidTime("not-an-object-id")
    catch ValueError e
        caught = true
    end
    assert caught, "invalid ObjectId must throw"

    return 0
end
