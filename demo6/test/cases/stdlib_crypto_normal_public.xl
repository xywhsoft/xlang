// Original comprehensive fixtures stay unchanged; no malformed inputs or tampering here.

func stdlib_crypto_ed25519_values_normal()
    // RFC 8032 public fixed vectors. No malformed inputs or network traffic.
    auto seed_empty = b"\x9d\x61\xb1\x9d\xef\xfd\x5a\x60\xba\x84\x4a\xf4\x92\xec\x2c\xc4\x44\x49\xc5\x69\x7b\x32\x69\x19\x70\x3b\xac\x03\x1c\xae\x7f\x60"
