    assert crypto.ecdsaP384VerifyHashDer(p384.publicKey,crypto.sha256("sample"),p384_sha256_der)
    bytes p384_sha384 = p384.signHash(crypto.sha384("sample"),SignatureHash.sha384)
    assert p384_sha384 == b"\x94\xed\xbb\x92\xa5\xec\xb8\xaa\xd4\x73\x6e\x56\xc6\x91\x91\x6b\x3f\x88\x14\x06\x66\xce\x9f\xa7\x3d\x64\xc4\xea\x95\xad\x13\x3c\x81\xa6\x48\x15\x2e\x44\xac\xf9\x6e\x36\xdd\x1e\x80\xfa\xbe\x46\x66\x10\xb5\x14\xea\x0e\x87\x31\x5e\x01\xbf\x24\xd9\xfc\xec\x70\xec\xf1\x8b\xf5\xe6\x9d\xba\xd9\xa7\x27\xea\x30\x23\x93\x84\x8f\xb4\xf0\x4c\x6c\xd0\x42\x3f\xdc\x71\x69\x52\x50\x94\x62\x9e\xab"
    assert crypto.ecdsaP384VerifyHash(p384.publicKey,crypto.sha384("sample"),p384_sha384)
    bytes p384_sha384_der = p384.signHashDer(crypto.sha384("sample"),SignatureHash.sha384)
    assert crypto.ecdsaP384FromDer(p384_sha384_der) == p384_sha384
    assert crypto.ecdsaP384ToDer(p384_sha384) == p384_sha384_der
    assert crypto.ecdsaP384VerifyHashDer(p384.publicKey,crypto.sha384("sample"),p384_sha384_der)
    bytes p384_sha512 = p384.signHash(crypto.sha512("sample"),SignatureHash.sha512)
    assert p384_sha512 == b"\xed\x09\x59\xd5\x88\x0a\xb2\xd8\x69\xae\x7f\x6c\x29\x15\xc6\xd6\x0f\x96\x50\x7f\x9c\xb3\xe0\x47\xc0\x04\x68\x61\xda\x4a\x79\x9c\xfe\x30\xf3\x5c\xc9\x00\x05\x6d\x7c\x99\xcd\x78\x82\x43\x37\x09\x51\x2c\x8c\xce\xee\x38\x90\xa8\x40\x58\xce\x1e\x22\xdb\xc2\x19\x8f\x42\x32\x3c\xe8\xac\xa9\x13\x53\x29\xf0\x3c\x06\x8e\x51\x12\xdc\x7c\xc3\xef\x34\x46\xde\xfc\xeb\x01\xa4\x5c\x26\x67\xfd\xd5"
    assert crypto.ecdsaP384VerifyHash(p384.publicKey,crypto.sha512("sample"),p384_sha512)
    bytes p384_sha512_der = p384.signHashDer(crypto.sha512("sample"),SignatureHash.sha512)
    assert crypto.ecdsaP384FromDer(p384_sha512_der) == p384_sha512
    assert crypto.ecdsaP384ToDer(p384_sha512) == p384_sha512_der
    assert crypto.ecdsaP384VerifyHashDer(p384.publicKey,crypto.sha512("sample"),p384_sha512_der)
    assert p384.signHash(crypto.sha384("sample")) == p384_sha384
    assert p384.signHashDer(crypto.sha384("sample")) == p384_sha384_der
    assert not crypto.ecdsaP384VerifyHash(p384.publicKey,crypto.sha384("different ordinary message"),p384_sha384)
    assert not crypto.ecdsaP384VerifyHashDer(p384.publicKey,crypto.sha384("different ordinary message"),p384_sha384_der)
    auto p384generated = crypto.p384KeyPair()
    auto p384restored = P384Key(p384generated.exportPrivate())
    assert p384generated.publicKey == p384restored.publicKey
    assert p384.sharedSecret(p384generated.publicKey) == p384generated.sharedSecret(p384.publicKey)
    assert cryptoAdvanced.p384Valid(p384.publicKey)
    assert cryptoAdvanced.p384Multiply(b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01",p384.publicKey) == p384.publicKey
    assert cryptoAdvanced.p384Add(p384.publicKey,p384.publicKey) == cryptoAdvanced.p384Multiply(b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02",p384.publicKey)
    bytes p384copy = p384.exportPrivate()
    p384copy[0] = 0
    assert p384.exportPrivate() == b"\x6b\x9d\x3d\xad\x2e\x1b\x8c\x1c\x05\xb1\x98\x75\xb6\x65\x9f\x4d\xe2\x3c\x3b\x66\x7b\xf2\x97\xba\x9a\xa4\x77\x40\x78\x71\x37\xd8\x96\xd5\x72\x4e\x4c\x70\xa8\x25\xf8\x72\xc9\xea\x60\xd2\xed\xf5"
    array<P384Key> p384owners = [p384,p384generated,p384restored]
    assert p384owners[0].publicKey == p384.publicKey
end

stdlib_crypto_nist_values_normal()

func stdlib_crypto_aead_values_normal()
    // AES-GCM known-answer vector (zero 128-bit key/96-bit nonce), and RFC 8439
    // section 2.8.2. These are public test keys, never application credentials.
    auto key = codec.hexDecode("00000000000000000000000000000000")
    auto nonce = codec.hexDecode("000000000000000000000000")
    auto aes = AesGcm(key)
    assert codec.hexEncode(aes.seal(b"", nonce)) == "58e2fccefa7e3061367f1d57a4e7455a"
    auto zeros = codec.hexDecode("00000000000000000000000000000000")
    auto sealed = aes.seal(zeros, nonce)
    assert codec.hexEncode(sealed) == "0388dace60b6a392f328c2b971b2fe78ab6e47d42cec13bdf53a67b21257bddf"
    assert aes.open(sealed, nonce) == zeros

    // The 192/256-bit NIST CAVP cases also used by the XRT native test suite.
    auto aes192 = AesGcm(codec.hexDecode("6f44f52c2f62dae4e8684bd2bc7d16ee7c557330305a790d"))
    auto nonce192 = codec.hexDecode("9ae35825d7c7edc9a39a0732")
    auto plain192 = codec.hexDecode("37222d30895eb95884bbbbaee4d9cae1")
    auto aad192 = codec.hexDecode("1b4236b846fc2a0f782881ba48a067e9")
    assert codec.hexEncode(aes192.seal(plain192, nonce192, aad192)) == "a54b5da33fc1196a8ef31a5321bfcaeb1c198086450ae1834dd6c2636796bce2"
    auto aes256 = AesGcm(codec.hexDecode("92e11dcdaa866f5ce790fd24501f92509aacf4cb8b1339d50c9c1240935dd08b"))
    auto nonce256 = codec.hexDecode("ac93a1a6145299bde902f21a")
    auto plain256 = codec.hexDecode("2d71bcfa914e4ac045b2aa60955fad24")
    auto aad256 = codec.hexDecode("1e0889016f67601c8ebea4943bc23ad6")
    auto cipher256 = aes256.seal(plain256, nonce256, aad256)
    assert codec.hexEncode(cipher256) == "8995ae2e6df3dbf96fac7b7137bae67feca5aa77d51d4a0a14d9c51e1da474ab"
    assert aes256.open(cipher256, nonce256, aad256) == plain256

    auto chachaKey = codec.hexDecode("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
    auto chachaNonce = codec.hexDecode("070000004041424344454647")
    auto aad = codec.hexDecode("50515253c0c1c2c3c4c5c6c7")
    auto chacha = ChaCha20Poly1305(chachaKey)
    string plain = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."
    auto cipher = chacha.seal(plain, chachaNonce, aad)
    assert codec.hexEncode(cipher) == "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691"
    assert chacha.open(cipher, chachaNonce, aad) == encoding.encodeUtf8(plain)
    bytes nulNonce = b"nul-vector01"
    assert chacha.open(chacha.seal(b"a\0b", nulNonce), nulNonce) == b"a\0b"
end

stdlib_crypto_aead_values_normal()

