    assert not publicKey.verifyPssHash(crypto.sha256("ordinary different digest"),expectedPss)
    assert not publicKey.verifyPkcs1Hash(crypto.sha256("ordinary different digest"),expectedPkcs)
    bytes digest_sha1Legacy = cryptoLegacy.sha1("ordinary digest choice")
