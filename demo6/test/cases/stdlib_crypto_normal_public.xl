    assert key_one.exportSeed() == seed_one
    assert crypto.ed25519PublicKey(seed_one) == key_one.publicKey
    assert key_one.sign(b"\x72") == b"\x92\xa0\x09\xa9\xf0\xd4\xca\xb8\x72\x0e\x82\x0b\x5f\x64\x25\x40\xa2\xb2\x7b\x54\x16\x50\x3f\x8f\xb3\x76\x22\x23\xeb\xdb\x69\xda\x08\x5a\xc1\xe4\x3e\x15\x99\x6e\x45\x8f\x36\x13\xd0\xf1\x1d\x8c\x38\x7b\x2e\xae\xb4\x30\x2a\xee\xb0\x0d\x29\x16\x12\xbb\x0c\x00"
    assert crypto.ed25519Sign(seed_one,b"\x72") == b"\x92\xa0\x09\xa9\xf0\xd4\xca\xb8\x72\x0e\x82\x0b\x5f\x64\x25\x40\xa2\xb2\x7b\x54\x16\x50\x3f\x8f\xb3\x76\x22\x23\xeb\xdb\x69\xda\x08\x5a\xc1\xe4\x3e\x15\x99\x6e\x45\x8f\x36\x13\xd0\xf1\x1d\x8c\x38\x7b\x2e\xae\xb4\x30\x2a\xee\xb0\x0d\x29\x16\x12\xbb\x0c\x00"
    assert crypto.ed25519Verify(key_one.publicKey,b"\x72",b"\x92\xa0\x09\xa9\xf0\xd4\xca\xb8\x72\x0e\x82\x0b\x5f\x64\x25\x40\xa2\xb2\x7b\x54\x16\x50\x3f\x8f\xb3\x76\x22\x23\xeb\xdb\x69\xda\x08\x5a\xc1\xe4\x3e\x15\x99\x6e\x45\x8f\x36\x13\xd0\xf1\x1d\x8c\x38\x7b\x2e\xae\xb4\x30\x2a\xee\xb0\x0d\x29\x16\x12\xbb\x0c\x00")
    auto seed_context = b"\x03\x05\x33\x4e\x38\x1a\xf7\x8f\x14\x1c\xb6\x66\xf6\x19\x9f\x57\xbc\x34\x95\x33\x5a\x25\x6a\x95\xbd\x2a\x55\xbf\x54\x66\x63\xf6"
    auto key_context = Ed25519Key(seed_context)
    assert key_context.publicKey == b"\xdf\xc9\x42\x5e\x4f\x96\x8f\x7f\x0c\x29\xf0\x25\x9c\xf5\xf9\xae\xd6\x85\x1c\x2b\xb4\xad\x8b\xfb\x86\x0c\xfe\xe0\xab\x24\x82\x92"
    assert key_context.exportSeed() == seed_context
    assert crypto.ed25519PublicKey(seed_context) == key_context.publicKey
    assert key_context.signContext(b"\xf7\x26\x93\x6d\x19\xc8\x00\x49\x4e\x3f\xda\xff\x20\xb2\x76\xa8",b"\x66\x6f\x6f") == b"\x55\xa4\xcc\x2f\x70\xa5\x4e\x04\x28\x8c\x5f\x4c\xd1\xe4\x5a\x7b\xb5\x20\xb3\x62\x92\x91\x18\x76\xca\xda\x73\x23\x19\x8d\xd8\x7a\x8b\x36\x95\x0b\x95\x13\x00\x22\x90\x7a\x7f\xb7\xc4\xe9\xb2\xd5\xf6\xcc\xa6\x85\xa5\x87\xb4\xb2\x1f\x4b\x88\x8e\x4e\x7e\xdb\x0d"
    assert crypto.ed25519VerifyContext(key_context.publicKey,b"\xf7\x26\x93\x6d\x19\xc8\x00\x49\x4e\x3f\xda\xff\x20\xb2\x76\xa8",b"\x55\xa4\xcc\x2f\x70\xa5\x4e\x04\x28\x8c\x5f\x4c\xd1\xe4\x5a\x7b\xb5\x20\xb3\x62\x92\x91\x18\x76\xca\xda\x73\x23\x19\x8d\xd8\x7a\x8b\x36\x95\x0b\x95\x13\x00\x22\x90\x7a\x7f\xb7\xc4\xe9\xb2\xd5\xf6\xcc\xa6\x85\xa5\x87\xb4\xb2\x1f\x4b\x88\x8e\x4e\x7e\xdb\x0d",b"\x66\x6f\x6f")
    auto seed_prehash = b"\x83\x3f\xe6\x24\x09\x23\x7b\x9d\x62\xec\x77\x58\x75\x20\x91\x1e\x9a\x75\x9c\xec\x1d\x19\x75\x5b\x7d\xa9\x01\xb9\x6d\xca\x3d\x42"
    auto key_prehash = Ed25519Key(seed_prehash)
    assert key_prehash.publicKey == b"\xec\x17\x2b\x93\xad\x5e\x56\x3b\xf4\x93\x2c\x70\xe1\x24\x50\x34\xc3\x54\x67\xef\x2e\xfd\x4d\x64\xeb\xf8\x19\x68\x34\x67\xe2\xbf"
    assert key_prehash.exportSeed() == seed_prehash
    assert crypto.ed25519PublicKey(seed_prehash) == key_prehash.publicKey
    assert crypto.sha512("abc") == b"\xdd\xaf\x35\xa1\x93\x61\x7a\xba\xcc\x41\x73\x49\xae\x20\x41\x31\x12\xe6\xfa\x4e\x89\xa9\x7e\xa2\x0a\x9e\xee\xe6\x4b\x55\xd3\x9a\x21\x92\x99\x2a\x27\x4f\xc1\xa8\x36\xba\x3c\x23\xa3\xfe\xeb\xbd\x45\x4d\x44\x23\x64\x3c\xe8\x0e\x2a\x9a\xc9\x4f\xa5\x4c\xa4\x9f"
    assert key_prehash.signPrehash(b"\xdd\xaf\x35\xa1\x93\x61\x7a\xba\xcc\x41\x73\x49\xae\x20\x41\x31\x12\xe6\xfa\x4e\x89\xa9\x7e\xa2\x0a\x9e\xee\xe6\x4b\x55\xd3\x9a\x21\x92\x99\x2a\x27\x4f\xc1\xa8\x36\xba\x3c\x23\xa3\xfe\xeb\xbd\x45\x4d\x44\x23\x64\x3c\xe8\x0e\x2a\x9a\xc9\x4f\xa5\x4c\xa4\x9f") == b"\x98\xa7\x02\x22\xf0\xb8\x12\x1a\xa9\xd3\x0f\x81\x3d\x68\x3f\x80\x9e\x46\x2b\x46\x9c\x7f\xf8\x76\x39\x49\x9b\xb9\x4e\x6d\xae\x41\x31\xf8\x50\x42\x46\x3c\x2a\x35\x5a\x20\x03\xd0\x62\xad\xf5\xaa\xa1\x0b\x8c\x61\xe6\x36\x06\x2a\xaa\xd1\x1c\x2a\x26\x08\x34\x06"
    assert crypto.ed25519VerifyPrehash(key_prehash.publicKey,b"\xdd\xaf\x35\xa1\x93\x61\x7a\xba\xcc\x41\x73\x49\xae\x20\x41\x31\x12\xe6\xfa\x4e\x89\xa9\x7e\xa2\x0a\x9e\xee\xe6\x4b\x55\xd3\x9a\x21\x92\x99\x2a\x27\x4f\xc1\xa8\x36\xba\x3c\x23\xa3\xfe\xeb\xbd\x45\x4d\x44\x23\x64\x3c\xe8\x0e\x2a\x9a\xc9\x4f\xa5\x4c\xa4\x9f",b"\x98\xa7\x02\x22\xf0\xb8\x12\x1a\xa9\xd3\x0f\x81\x3d\x68\x3f\x80\x9e\x46\x2b\x46\x9c\x7f\xf8\x76\x39\x49\x9b\xb9\x4e\x6d\xae\x41\x31\xf8\x50\x42\x46\x3c\x2a\x35\x5a\x20\x03\xd0\x62\xad\xf5\xaa\xa1\x0b\x8c\x61\xe6\x36\x06\x2a\xaa\xd1\x1c\x2a\x26\x08\x34\x06")
    auto signatureText = key_one.sign("r")
    // Ordinary verification mismatch: a valid public test signature, no malformed encoding.
    assert not crypto.ed25519Verify(key_empty.publicKey,"different ordinary message",key_empty.sign(b""))
    assert signatureText == b"\x92\xa0\x09\xa9\xf0\xd4\xca\xb8\x72\x0e\x82\x0b\x5f\x64\x25\x40\xa2\xb2\x7b\x54\x16\x50\x3f\x8f\xb3\x76\x22\x23\xeb\xdb\x69\xda\x08\x5a\xc1\xe4\x3e\x15\x99\x6e\x45\x8f\x36\x13\xd0\xf1\x1d\x8c\x38\x7b\x2e\xae\xb4\x30\x2a\xee\xb0\x0d\x29\x16\x12\xbb\x0c\x00"
    assert crypto.ed25519Sign(seed_one,"r") == signatureText
    assert crypto.ed25519Verify(key_one.publicKey,"r",signatureText)
    auto buffer = Buffer(b"r")
    assert key_one.signBuffer(buffer) == signatureText
    assert crypto.ed25519SignBuffer(seed_one,buffer) == signatureText
    assert crypto.ed25519VerifyBuffer(key_one.publicKey,buffer,signatureText)
    auto contextBuffer = Buffer(b"\xf7\x26\x93\x6d\x19\xc8\x00\x49\x4e\x3f\xda\xff\x20\xb2\x76\xa8")
    assert key_context.signContextBuffer(contextBuffer,b"foo") == b"\x55\xa4\xcc\x2f\x70\xa5\x4e\x04\x28\x8c\x5f\x4c\xd1\xe4\x5a\x7b\xb5\x20\xb3\x62\x92\x91\x18\x76\xca\xda\x73\x23\x19\x8d\xd8\x7a\x8b\x36\x95\x0b\x95\x13\x00\x22\x90\x7a\x7f\xb7\xc4\xe9\xb2\xd5\xf6\xcc\xa6\x85\xa5\x87\xb4\xb2\x1f\x4b\x88\x8e\x4e\x7e\xdb\x0d"
    assert crypto.ed25519VerifyContextBuffer(key_context.publicKey,contextBuffer,b"\x55\xa4\xcc\x2f\x70\xa5\x4e\x04\x28\x8c\x5f\x4c\xd1\xe4\x5a\x7b\xb5\x20\xb3\x62\x92\x91\x18\x76\xca\xda\x73\x23\x19\x8d\xd8\x7a\x8b\x36\x95\x0b\x95\x13\x00\x22\x90\x7a\x7f\xb7\xc4\xe9\xb2\xd5\xf6\xcc\xa6\x85\xa5\x87\xb4\xb2\x1f\x4b\x88\x8e\x4e\x7e\xdb\x0d",b"foo")
    string message = "a\0你"
    bytes binary = encoding.encodeUtf8(message)
    bytes context = b"f\0o"
    auto contextTextSignature = key_empty.signContext(message,context)
    assert key_empty.signContext(binary,context) == contextTextSignature
    assert crypto.ed25519VerifyContext(key_empty.publicKey,message,contextTextSignature,context)
    assert crypto.ed25519VerifyContext(key_empty.publicKey,binary,contextTextSignature,context)
    assert key_empty.sign(message) == key_empty.sign(binary)
    assert key_empty.sign(message,0) == b"\xe5\x56\x43\x00\xc3\x60\xac\x72\x90\x86\xe2\xcc\x80\x6e\x82\x8a\x84\x87\x7f\x1e\xb8\xe5\xd9\x74\xd8\x73\xe0\x65\x22\x49\x01\x55\x5f\xb8\x82\x15\x90\xa3\x3b\xac\xc6\x1e\x39\x70\x1c\xf9\xb4\x6b\xd2\x5b\xf5\xf0\x59\x5b\xbe\x24\x65\x51\x41\x43\x8e\x7a\x10\x0b"
    assert key_empty.sign(message,1000) == key_empty.sign(message)
    assert key_empty.signContext(message,context,3) == key_empty.signContext(binary,context,3)
    auto digest = crypto.sha512(message)
    auto ph = key_empty.signPrehash(digest,context)
    assert crypto.ed25519VerifyPrehash(key_empty.publicKey,digest,ph,context)
    seed_empty[0] = uint8(0)
    assert key_empty.exportSeed() == b"\x9d\x61\xb1\x9d\xef\xfd\x5a\x60\xba\x84\x4a\xf4\x92\xec\x2c\xc4\x44\x49\xc5\x69\x7b\x32\x69\x19\x70\x3b\xac\x03\x1c\xae\x7f\x60"
    auto publicCopy = key_empty.publicKey
    publicCopy[0] = uint8(0)
    assert key_empty.publicKey == b"\xd7\x5a\x98\x01\x82\xb1\x0a\xb7\xd5\x4b\xfe\xd3\xc9\x64\x07\x3a\x0e\xe1\x72\xf3\xda\xa6\x23\x25\xaf\x02\x1a\x68\xf7\x07\x51\x1a"
    auto generated = crypto.ed25519KeyPair()
    auto restored = Ed25519Key(generated.exportSeed())
    assert restored.publicKey == generated.publicKey
    assert crypto.ed25519Verify(restored.publicKey,message,generated.sign(message))
    array<Ed25519Key> owners = [key_empty,generated,restored]
    assert owners[0].publicKey == key_empty.publicKey
end

stdlib_crypto_ed25519_values_normal()

func stdlib_crypto_xdh_values_normal()
    // Public fixed RFC 7748 section 6.1/6.2 vectors; no network traffic.
    auto inputX25519 = b"\x77\x07\x6d\x0a\x73\x18\xa5\x7d\x3c\x16\xc1\x72\x51\xb2\x66\x45\xdf\x4c\x2f\x87\xeb\xc0\x99\x2a\xb1\x77\xfb\xa5\x1d\xb9\x2c\x2a"
    auto keyX25519 = X25519Key(inputX25519)
    assert keyX25519.publicKey == b"\x85\x20\xf0\x09\x89\x30\xa7\x54\x74\x8b\x7d\xdc\xb4\x3e\xf7\x5a\x0d\xbf\x3a\x0d\x26\x38\x1a\xf4\xeb\xa4\xa9\x8e\xaa\x9b\x4e\x6a"
    assert keyX25519.exportPrivate() == inputX25519
    assert keyX25519.sharedSecret(b"\xde\x9e\xdb\x7d\x7b\x7d\xc1\xb4\xd3\x5b\x61\xc2\xec\xe4\x35\x37\x3f\x83\x43\xc8\x5b\x78\x67\x4d\xad\xfc\x7e\x14\x6f\x88\x2b\x4f") == b"\x4a\x5d\x9d\x5b\xa4\xce\x2d\xe1\x72\x8e\x3b\xf4\x80\x35\x0f\x25\xe0\x7e\x21\xc9\x47\xd1\x9e\x33\x76\xf0\x9b\x3c\x1e\x16\x17\x42"
    assert cryptoAdvanced.x25519(inputX25519, b"\xde\x9e\xdb\x7d\x7b\x7d\xc1\xb4\xd3\x5b\x61\xc2\xec\xe4\x35\x37\x3f\x83\x43\xc8\x5b\x78\x67\x4d\xad\xfc\x7e\x14\x6f\x88\x2b\x4f") == b"\x4a\x5d\x9d\x5b\xa4\xce\x2d\xe1\x72\x8e\x3b\xf4\x80\x35\x0f\x25\xe0\x7e\x21\xc9\x47\xd1\x9e\x33\x76\xf0\x9b\x3c\x1e\x16\x17\x42"
    inputX25519[0] = uint8(0)
    assert keyX25519.exportPrivate() == b"\x77\x07\x6d\x0a\x73\x18\xa5\x7d\x3c\x16\xc1\x72\x51\xb2\x66\x45\xdf\x4c\x2f\x87\xeb\xc0\x99\x2a\xb1\x77\xfb\xa5\x1d\xb9\x2c\x2a"
    auto publicX25519 = keyX25519.publicKey
    publicX25519[0] = uint8(0)
    assert keyX25519.publicKey == b"\x85\x20\xf0\x09\x89\x30\xa7\x54\x74\x8b\x7d\xdc\xb4\x3e\xf7\x5a\x0d\xbf\x3a\x0d\x26\x38\x1a\xf4\xeb\xa4\xa9\x8e\xaa\x9b\x4e\x6a"
    auto generatedX25519 = crypto.x25519KeyPair()
    auto restoredX25519 = X25519Key(generatedX25519.exportPrivate())
    assert restoredX25519.publicKey == generatedX25519.publicKey
    assert generatedX25519.sharedSecret(keyX25519.publicKey) == keyX25519.sharedSecret(generatedX25519.publicKey)
    array<X25519Key> ownersX25519 = [keyX25519, generatedX25519, restoredX25519]
    assert ownersX25519[0].publicKey == keyX25519.publicKey


    auto inputX448 = b"\x9a\x8f\x49\x25\xd1\x51\x9f\x57\x75\xcf\x46\xb0\x4b\x58\x00\xd4\xee\x9e\xe8\xba\xe8\xbc\x55\x65\xd4\x98\xc2\x8d\xd9\xc9\xba\xf5\x74\xa9\x41\x97\x44\x89\x73\x91\x00\x63\x82\xa6\xf1\x27\xab\x1d\x9a\xc2\xd8\xc0\xa5\x98\x72\x6b"
    auto keyX448 = X448Key(inputX448)
    assert keyX448.publicKey == b"\x9b\x08\xf7\xcc\x31\xb7\xe3\xe6\x7d\x22\xd5\xae\xa1\x21\x07\x4a\x27\x3b\xd2\xb8\x3d\xe0\x9c\x63\xfa\xa7\x3d\x2c\x22\xc5\xd9\xbb\xc8\x36\x64\x72\x41\xd9\x53\xd4\x0c\x5b\x12\xda\x88\x12\x0d\x53\x17\x7f\x80\xe5\x32\xc4\x1f\xa0"
    assert keyX448.exportPrivate() == inputX448
    assert keyX448.sharedSecret(b"\x3e\xb7\xa8\x29\xb0\xcd\x20\xf5\xbc\xfc\x0b\x59\x9b\x6f\xec\xcf\x6d\xa4\x62\x71\x07\xbd\xb0\xd4\xf3\x45\xb4\x30\x27\xd8\xb9\x72\xfc\x3e\x34\xfb\x42\x32\xa1\x3c\xa7\x06\xdc\xb5\x7a\xec\x3d\xae\x07\xbd\xc1\xc6\x7b\xf3\x36\x09") == b"\x07\xff\xf4\x18\x1a\xc6\xcc\x95\xec\x1c\x16\xa9\x4a\x0f\x74\xd1\x2d\xa2\x32\xce\x40\xa7\x75\x52\x28\x1d\x28\x2b\xb6\x0c\x0b\x56\xfd\x24\x64\xc3\x35\x54\x39\x36\x52\x1c\x24\x40\x30\x85\xd5\x9a\x44\x9a\x50\x37\x51\x4a\x87\x9d"
    assert cryptoAdvanced.x448(inputX448, b"\x3e\xb7\xa8\x29\xb0\xcd\x20\xf5\xbc\xfc\x0b\x59\x9b\x6f\xec\xcf\x6d\xa4\x62\x71\x07\xbd\xb0\xd4\xf3\x45\xb4\x30\x27\xd8\xb9\x72\xfc\x3e\x34\xfb\x42\x32\xa1\x3c\xa7\x06\xdc\xb5\x7a\xec\x3d\xae\x07\xbd\xc1\xc6\x7b\xf3\x36\x09") == b"\x07\xff\xf4\x18\x1a\xc6\xcc\x95\xec\x1c\x16\xa9\x4a\x0f\x74\xd1\x2d\xa2\x32\xce\x40\xa7\x75\x52\x28\x1d\x28\x2b\xb6\x0c\x0b\x56\xfd\x24\x64\xc3\x35\x54\x39\x36\x52\x1c\x24\x40\x30\x85\xd5\x9a\x44\x9a\x50\x37\x51\x4a\x87\x9d"
    inputX448[0] = uint8(0)
    assert keyX448.exportPrivate() == b"\x9a\x8f\x49\x25\xd1\x51\x9f\x57\x75\xcf\x46\xb0\x4b\x58\x00\xd4\xee\x9e\xe8\xba\xe8\xbc\x55\x65\xd4\x98\xc2\x8d\xd9\xc9\xba\xf5\x74\xa9\x41\x97\x44\x89\x73\x91\x00\x63\x82\xa6\xf1\x27\xab\x1d\x9a\xc2\xd8\xc0\xa5\x98\x72\x6b"
    auto publicX448 = keyX448.publicKey
    publicX448[0] = uint8(0)
    assert keyX448.publicKey == b"\x9b\x08\xf7\xcc\x31\xb7\xe3\xe6\x7d\x22\xd5\xae\xa1\x21\x07\x4a\x27\x3b\xd2\xb8\x3d\xe0\x9c\x63\xfa\xa7\x3d\x2c\x22\xc5\xd9\xbb\xc8\x36\x64\x72\x41\xd9\x53\xd4\x0c\x5b\x12\xda\x88\x12\x0d\x53\x17\x7f\x80\xe5\x32\xc4\x1f\xa0"
    auto generatedX448 = crypto.x448KeyPair()
    auto restoredX448 = X448Key(generatedX448.exportPrivate())
    assert restoredX448.publicKey == generatedX448.publicKey
    assert generatedX448.sharedSecret(keyX448.publicKey) == keyX448.sharedSecret(generatedX448.publicKey)
    array<X448Key> ownersX448 = [keyX448, generatedX448, restoredX448]
    assert ownersX448[0].publicKey == keyX448.publicKey


    println("managed XDH import/export/generate/shared/advanced: ok")
end

