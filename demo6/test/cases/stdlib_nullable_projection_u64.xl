func main(...) as int
    uint64? first = 0
    uint64? second = 18446744073709551615
    AvlTree<int, uint64?> tree = AvlTree::<int, uint64?>()
    assert(tree.set(1, null) and tree.set(2, first) and tree.set(3, second))
    array<uint64?> values = tree.values()
    assert(values.length == 3 and values[0] == null and values[1] == first and values[2] == second)
    SpscQueue<uint64?> queue = SpscQueue::<uint64?>(4)
    array<uint64?> output = array<uint64?>[second]
    assert(queue.pushBatch(values) == 3 and queue.popBatchInto(output, 4) == 3)
    assert(output.length == 3 and output[0] == null and output[1] == first and output[2] == second)
    uint64? absentA = null
    uint64? absentB = null
    assert(absentA == absentB and absentA != first and first != second and first == first)
    int count = 0
    for item in output
        if item != null
            count += 1
        end
    end
    assert(count == 2)
    return 0
end
