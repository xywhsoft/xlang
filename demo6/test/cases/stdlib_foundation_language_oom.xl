import memory
class FoundationOomItem
    string text = "a\0你"
    bytes data = b"\0\xffz"
end
func main(...)
    assert os.platform().length > 0
    assert os.architecture().length > 0
    auto counters = memory.stats()
    assert counters.classCount == uint64(64)
    auto debug = memory.debugSnapshot()
    assert debug.invalidFreeCount == uint64(0)
    auto text = memory.reportText()
    auto jsonText = memory.reportJson()
    assert text.length > 0 and jsonText.length > 0
    auto pool = ObjectPool::<FoundationOomItem>()
    auto one = pool.make(func() as FoundationOomItem
        return FoundationOomItem()
    end)
    auto two = pool.make(func() as FoundationOomItem
        return FoundationOomItem()
    end)
    assert pool.length == 2
    assert pool.clear() == 2
    assert one.text == "a\0你" and two.data == b"\0\xffz"
    pool.keep(one)
    pool.close()
    assert pool.closed and one.data == b"\0\xffz"
    auto arena = ObjectArena()
    arena.keep(two)
    auto three = arena.make(func() as FoundationOomItem
        return FoundationOomItem()
    end)
    assert arena.length == 2
    arena.close()
    assert three.text == "a\0你"
end
