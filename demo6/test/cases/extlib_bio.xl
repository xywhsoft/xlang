import bio

func main(...) as int
    // Codons
    assert bio.codon(0) == "AUG", "codon start"
    assert bio.codon(1) == "UAA", "codon stop1"

    // Amino acids
    assert bio.aminoAcid(0) == "Ala", "aa ala"
    assert bio.aminoAcid(11) == "Met", "aa met"

    // Complement
    assert bio.complement("ATGC") == "TACG", "complement"
    assert bio.complement("AATTGGCC") == "TTAACCGG", "complement2"

    // Transcribe DNA to RNA
    assert bio.transcribe("ATGC") == "AUGC", "transcribe"
    assert bio.transcribe("TATA") == "UAUA", "transcribe2"

    // GC content: "GGCC" = 100% GC = 10000
    assert bio.gcContent("GGCC") == 10000, "gc 100"
    // "ATGC" = 50% GC = 5000
    assert bio.gcContent("ATGC") == 5000, "gc 50"
    // "AATT" = 0% GC = 0
    assert bio.gcContent("AATT") == 0, "gc 0"

    // Formats
    assert bio.format(0) == "FASTA", "fmt fasta"
    assert bio.format(5) == "VCF", "fmt vcf"

    return 0
end
