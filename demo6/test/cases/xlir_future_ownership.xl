extern "future_graph_source" func graphSource() as future<int>
extern "future_graph_capture" func graphCapture(var value)

async func graphClosure(int base) as func() as int
    return func() as int => base
end

async func graphValue() as var
    int answer = 42
    return xcall(func() as int => answer)
end

async func graphString() as string
    return "res" + "ident"
end

async func graphResumed() as func() as int
    int answer = await graphSource()
    return func() as int => answer
end

func graphSaved(int answer) as func() as int
    return func() as int => answer
end

func graphMake(int mode) as var
    if mode == 0 then
        return graphClosure(42)
    elseif mode == 1 then
        return graphValue()
    elseif mode == 2 then
        return graphString()
    elseif mode == 3 then
        auto ready = graphClosure(42)
        return xcall(func() as int => ready.isDone() ? 42 : 0)
    elseif mode == 4 then
        return graphResumed()
    elseif mode == 5 then
        auto ready = graphClosure(42)
        return ready.then(func(func() as int saved) as func() as int => saved)
    else
        func(int) as func() as int job = graphSaved
        return task.spawn(job, 42)
    end
end

export "future_graph_build" func graphBuild(int mode)
    graphCapture(graphMake(mode))
end
