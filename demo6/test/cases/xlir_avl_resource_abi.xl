OrderedMap<string, int> defaultScores

class AvlHolder
    OrderedMap<string, string> values
end

func main(...) as int
    assert(defaultScores.count() == 0)
    assert(defaultScores.set("root", 1))

    OrderedMap<string, int> scores = OrderedMap::<string, int>()
    assert(scores.set("bob", 70))
    assert(scores.set("alice", 90))
    assert(scores.set("bob", 80))
    assert(scores.count() == 2)
    assert(scores.contains("alice"))

    int number = 0
    number = scores.get("bob")
    assert(number == 80)
    OrderedMap<string, int> clone = scores.clone()
    assert(scores.equals(clone))

    OrderedMap<string, int> patch = OrderedMap::<string, int>()
    assert(patch.set("bob", 81))
    assert(patch.set("carol", 75))
    assert(clone.merge(patch, false))
    number = clone.get("bob")
    assert(number == 80)
    assert(clone.merge(patch))
    number = clone.get("bob")
    assert(number == 81)
    assert(not scores.equals(clone))

    string name = ""
    int score = 0
    name, score = scores.first()
    assert(name == "alice")
    assert(score == 90)
    name, score = scores.last()
    assert(name == "bob")
    assert(score == 80)
    name, score = scores.lowerBound("amy")
    assert(name == "bob")
    name, score = scores.upperBound("alice")
    assert(name == "bob")

    array<string> names = scores.keys()
    assert(names.length == 2)
    assert(names[0] == "alice")
    assert(names[1] == "bob")
    array<int> values = scores.values()
    assert(values.length == 2)
    assert(values[0] == 90)
    assert(values[1] == 80)

    number = scores.take("alice")
    assert(number == 90)
    assert(not scores.contains("alice"))
    assert(scores.remove("bob"))
    assert(scores.count() == 0)
    assert(scores.trimTo(1) >= 0)
    assert(scores.trim() >= 0)

    OrderedMap<int, int> sameType = OrderedMap::<int, int>()
    assert(sameType.set(1, 10))
    int aliasedOutput = 0
    auto independentKey, independentValue = sameType.first()
    assert(independentKey == 1 and independentValue == 10 and aliasedOutput == 0)
    sameType.clear()
    assert(sameType.count() == 0)

    AvlHolder holder = AvlHolder()
    string text = ""
    assert(holder.values.set("key", "value"))
    text = holder.values.get("key")
    assert(text == "value")

    func() as int observe = func() as int
        return clone.count()
    end
    assert(observe() == 3)

    println("xlir avl resource abi ok")
    return 0
end
