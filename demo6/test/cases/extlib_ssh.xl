import ssh

func main(...) as int
    // Message types
    assert ssh.msgType(1) == "SSH_MSG_DISCONNECT", "msg disconnect"
    assert ssh.msgType(20) == "SSH_MSG_KEXINIT", "msg kexinit"
    assert ssh.msgType(50) == "SSH_MSG_USERAUTH_REQUEST", "msg auth req"
    assert ssh.msgType(90) == "SSH_MSG_CHANNEL_OPEN", "msg chan open"
    assert ssh.msgType(94) == "SSH_MSG_CHANNEL_DATA", "msg chan data"

    // Disconnect reasons
    assert ssh.disconnectReason(2) == "PROTOCOL_ERROR", "disc protocol"
    assert ssh.disconnectReason(11) == "BY_APPLICATION", "disc app"
    assert ssh.disconnectReason(14) == "NO_MORE_AUTH_METHODS_AVAILABLE", "disc auth"

    // Channel failure
    assert ssh.channelFailure(2) == "CONNECT_FAILED", "chan connect"
    assert ssh.channelFailure(3) == "UNKNOWN_CHANNEL_TYPE", "chan type"

    // KEX algorithms
    assert ssh.kexName(5) == "curve25519-sha256", "kex curve25519"
    assert ssh.kexName(2) == "diffie-hellman-group14-sha256", "kex dh14"

    // Cipher algorithms
    assert ssh.cipherName(0) == "aes128-ctr", "cipher aes128"
    assert ssh.cipherName(5) == "chacha20-poly1305@openssh.com", "cipher chacha"

    // MAC algorithms
    assert ssh.macName(0) == "hmac-sha2-256", "mac sha256"
    assert ssh.macName(3) == "hmac-sha2-256-etm@openssh.com", "mac etm"

    // Host key algorithms
    assert ssh.hostkeyName(0) == "ssh-rsa", "hk rsa"
    assert ssh.hostkeyName(3) == "ssh-ed25519", "hk ed25519"

    // Auth methods
    assert ssh.authMethod(1) == "password", "auth password"
    assert ssh.authMethod(2) == "publickey", "auth pubkey"

    return 0
end
