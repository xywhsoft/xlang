extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

int allFlags = regex.ignoreCase + regex.multiline + regex.dotAll + regex.ungreedy
expect(allFlags >= 15, 1)

expect(regex.isMatch("abc123", "[a-z]+[0-9]+"), 1)
expect(regex.isMatch("ABC123", "[a-z]+[0-9]+"), 0)
expect(regex.isMatch("ABC123", "[a-z]+[0-9]+", regex.ignoreCase), 1)
expect(regex.isMatch("aa", "a+", regex.ungreedy), 1)
expect(regex.isMatch("ABC", "abc|ABC", regex.ignoreCase), 1)

expect(regex.find("hello 2026", "[0-9]+"), 6)
expect(regex.find("hello", "[0-9]+"), -1)

expect(regex.fullMatch("abc123", "[a-z]+[0-9]+"), 1)
expect(regex.fullMatch("abc123!", "[a-z]+[0-9]+"), 0)
expect(regex.fullMatch("a\nb", "a.b", regex.dotAll), 1)

Regex compiled = regex.compile("[0-9]+")
expect(compiled.isMatch("id=2026"), 1)
expect(compiled.fullMatch("2026"), 1)
expect(compiled.fullMatch("id=2026"), 0)

RegexMatch found = compiled.find("id=2026")
expect(found.ok, 1)
expect(found.byteStart, 3)
expect(found.byteEnd, 7)
expect(found.start, 3)
expect(found.end, 7)
expectStr(string(found.text), "2026")

RegexMatch shifted = regex.findMatch("a1 b2", "[0-9]+", 0, 2)
expect(shifted.ok, 1)
expect(shifted.start, 4)
expectStr(string(shifted.text), "2")

RegexMatch utfFirst = regex.findMatch("你1好2", "[0-9]+")
expect(utfFirst.ok, 1)
expect(utfFirst.start, 1)
expect(utfFirst.end, 2)
expect(utfFirst.byteStart, 3)
expect(utfFirst.byteEnd, 4)
expectStr(string(utfFirst.text), "1")

RegexMatch utfSecond = regex.findMatch("你1好2", "[0-9]+", 0, utfFirst.end)
expect(utfSecond.ok, 1)
expect(utfSecond.start, 3)
expect(utfSecond.end, 4)
expect(utfSecond.byteStart, 7)
expect(utfSecond.byteEnd, 8)
expectStr(string(utfSecond.text), "2")

RegexMatch emptyMatch = regex.findMatch("bbb", "a*")
expect(emptyMatch.ok, 1)
expect(emptyMatch.start, 0)
expect(emptyMatch.end, 0)
expect(emptyMatch.byteStart, 0)
expect(emptyMatch.byteEnd, 0)
expectStr(string(emptyMatch.text), "")

RegexMatch missing = compiled.find("id=none")
expect(missing.ok, 0)
expect(missing.byteStart, -1)
expect(missing.byteEnd, -1)
expect(missing.start, -1)
expect(missing.end, -1)
var missingText = missing.text
expect(type(missingText) == null, 1)

RegexSet regexSet = regex.set(["[0-9]+", "ready"], regex.ignoreCase + regex.multiline)
expect(regexSet.isMatch("READY"), 1)
expect(regexSet.first("READY"), 1)
expect(regexSet.first("code 2026"), 0)
array indexes = regexSet.matches("READY 2026")
expect(indexes.length, 2)
expect((int(indexes[0]) == 0 or int(indexes[1]) == 0), 1)
expect((int(indexes[0]) == 1 or int(indexes[1]) == 1), 1)

expect(regex.isMatch("abc", "["), 0)
expect(regex.find("abc", "["), -1)
RegexMatch bad = regex.findMatch("abc", "[")
expect(bad.ok, 0)
