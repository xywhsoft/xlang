extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

int allFlags = regex.ignoreCase + regex.multiline + regex.dotAll + regex.ungreedy
expect(allFlags >= 15, 1)

expect(regex.isMatch("abc123", "[a-z]+[0-9]+"), 1)
expect(regex.isMatch("ABC123", "[a-z]+[0-9]+"), 0)
expect(regex.isMatch("ABC123", "[a-z]+[0-9]+", regex.ignoreCase), 1)
expect(regex.isMatch("aa", "a+", regex.ungreedy), 1)

expect(regex.find("hello 2026", "[0-9]+"), 6)
expect(regex.find("hello", "[0-9]+"), -1)

expect(regex.fullMatch("abc123", "[a-z]+[0-9]+"), 1)
expect(regex.fullMatch("abc123!", "[a-z]+[0-9]+"), 0)
expect(regex.fullMatch("a\nb", "a.b", regex.dotAll), 1)

Regex compiled = regex.compile("[0-9]+")
expect(compiled.isMatch("id=2026"), 1)
expect(compiled.fullMatch("2026"), 1)
expect(compiled.fullMatch("id=2026"), 0)

RegexMatch match = compiled.match("id=2026")
expect(match.ok, 1)
expect(match.byteStart, 3)
expect(match.byteEnd, 7)
expect(match.start, 3)
expect(match.end, 7)
expectStr(string(match.text), "2026")

RegexMatch shifted = regex.match("a1 b2", "[0-9]+", 0, 2)
expect(shifted.ok, 1)
expect(shifted.start, 4)
expectStr(string(shifted.text), "2")

RegexMatch missing = compiled.find("id=none")
expect(missing.ok, 0)
expect(missing.byteStart, -1)
expect(missing.byteEnd, -1)
expect(missing.start, -1)
expect(missing.end, -1)
var missingText = missing.text
expect(type(missingText) == null, 1)

RegexSet set = regex.set(["[0-9]+", "ready"], regex.ignoreCase + regex.multiline)
expect(set.isMatch("READY"), 1)
expect(set.first("READY"), 1)
expect(set.first("code 2026"), 0)
array indexes = set.matches("READY 2026")
expect(indexes.length, 2)
expect((int(indexes[0]) == 0 or int(indexes[1]) == 0), 1)
expect((int(indexes[0]) == 1 or int(indexes[1]) == 1), 1)

expect(regex.isMatch("abc", "["), 0)
expect(regex.find("abc", "["), -1)
RegexMatch bad = regex.match("abc", "[")
expect(bad.ok, 0)
