extern "expect_i64" func expect(int actual, int expected)

class Pair
    int left = 1
    int right = 2
end

class Native
    native point handle
end

union Payload
    int i
    c_double d
end

func inc(int value) as int
    return value + 1
end

Pair pair = Pair()
pair.left = 7
pair.right = 8

Payload payload
payload.i = 42

point raw
Native native = Native(raw)
func(int) as int fn = inc
type fnType = type(fn)

array<Pair> pairs = array[pair]
array<Payload> payloads = array[payload]
array<Native> natives = array[native]
array<func(int) as int> funcs = array[fn]

list<Pair> pairList = list[4: pair]
list<Payload> payloadList = list[5: payload]
list<Native> nativeList = list[6: native]
list<func(int) as int> funcList = list[7: fn]

dict<Pair> pairDict = dict{"pair": pair}
dict<Payload> payloadDict = dict{"payload": payload}
dict<Native> nativeDict = dict{"native": native}
dict<func(int) as int> funcDict = dict{"fn": fn}
var pairKey = "pair"
var fnKey = "fn"

auto maybePair = pairs?[0]
auto missingPair = pairs?[9]
auto maybePayload = payloads?[0]
auto missingPayload = payloads?[9]
auto maybeNative = natives?[0]
auto missingNative = natives?[9]
auto maybeFn = funcs?[0]
auto missingFn = funcs?[9]

auto maybeListPair = pairList?[4]
auto missingListPair = pairList?[9]
auto maybeListPayload = payloadList?[5]
auto missingListPayload = payloadList?[9]
auto maybeListNative = nativeList?[6]
auto missingListNative = nativeList?[9]
auto maybeListFn = funcList?[7]
auto missingListFn = funcList?[9]

auto maybeDictPair = pairDict?[pairKey]
auto missingDictPair = pairDict?["missing"]
auto maybeDictPayload = payloadDict?["payload"]
auto missingDictPayload = payloadDict?["missing"]
auto maybeDictNative = nativeDict?["native"]
auto missingDictNative = nativeDict?["missing"]
auto maybeDictFn = funcDict?[fnKey]
auto missingDictFn = funcDict?["missing"]

expect(maybePair != null, 1)
expect(missingPair == null, 1)
expect(maybePayload != null, 1)
expect(missingPayload == null, 1)
expect(maybeNative != null, 1)
expect(missingNative == null, 1)
expect(maybeFn != null, 1)
expect(missingFn == null, 1)

expect(maybeListPair != null, 1)
expect(missingListPair == null, 1)
expect(maybeListPayload != null, 1)
expect(missingListPayload == null, 1)
expect(maybeListNative != null, 1)
expect(missingListNative == null, 1)
expect(maybeListFn != null, 1)
expect(missingListFn == null, 1)

expect(maybeDictPair != null, 1)
expect(missingDictPair == null, 1)
expect(maybeDictPayload != null, 1)
expect(missingDictPayload == null, 1)
expect(maybeDictNative != null, 1)
expect(missingDictNative == null, 1)
expect(maybeDictFn != null, 1)
expect(missingDictFn == null, 1)

if maybeFn != null then
    expect(int(maybeFn(41)), 42)
end
if maybeListFn != null then
    expect(int(maybeListFn(41)), 42)
end
if maybeDictFn != null then
    expect(int(maybeDictFn(41)), 42)
end
