func reader(P256Key key) as func() as int
    return func() as int
        if key.signHash(crypto.sha256("sample")) == b"\xef\xd4\x8b\x2a\xac\xb6\xa8\xfd\x11\x40\xdd\x9c\xd4\x5e\x81\xd6\x9d\x2c\x87\x7b\x56\xaa\xf9\x91\xc3\x4d\x0e\xa8\x4e\xaf\x37\x16\x08\x34\xe3\x6a\xd2\x9a\x83\xbf\x2b\xc9\x38\x5e\x49\x1d\x60\x99\xc8\xfd\xf9\xd1\xed\x67\xaa\x7e\xa5\xf5\x1f\x93\x78\x28\x57\xa9" then return 0 end
        return 1
    end
end
auto key = P256Key(b"\xc9\xaf\xa9\xd8\x45\xba\x75\x16\x6b\x5c\x21\x57\x67\xb1\xd6\x93\x4e\x50\xc3\xdb\x36\xe8\x9b\x12\x7b\x8a\x62\x2b\x12\x0f\x67\x21")
auto a = thread(reader(key))
auto d = thread(reader(key))
assert a.waitTimeout(30000)
assert d.waitTimeout(30000)
assert a.exitCode() == 0
assert d.exitCode() == 0
