extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

int value = random.range(0, 100)
string token = random.string(12)
string fixedText = random.string(4, "x")

random.seed(uint64(2026), uint64(1))
uint32 seededA = random.u32()
uint64 seeded64A = random.u64()
random.seed(uint64(2026), uint64(1))
uint32 seededB = random.u32()
uint64 seeded64B = random.u64()

Random rngA = Random(uint64(12345), uint64(7))
Random rngB = Random(uint64(12345), uint64(7))
uint32 obj32A = rngA.u32()
uint32 obj32B = rngB.u32()
uint64 obj64A = rngA.u64()
uint64 obj64B = rngB.u64()
int diceA = rngA.range(1, 6)
int diceB = rngB.range(1, 6)

rngA.seed(uint64(2026), uint64(1))
rngB.seed(uint64(2026), uint64(1))
string objTokenA = rngA.string(10, "ab")
string objTokenB = rngB.string(10, "ab")
string objFixed = rngA.string(5, "z")

Random rngDefault = Random(uint64(0), uint64(1))
int defaultRange = rngDefault.range(3, 3)

expect(value >= 0, 1)
expect(value <= 100, 1)
expect(random.range(7, 7), 7)
expect(string.len(token), 12)
expectStr(fixedText, "xxxx")
expectStr(random.string(0), "")
expect(seededA == seededB, 1)
expect(seeded64A == seeded64B, 1)
expect(obj32A == obj32B, 1)
expect(obj64A == obj64B, 1)
expect(diceA == diceB, 1)
expect(diceA >= 1, 1)
expect(diceA <= 6, 1)
expectStr(objTokenA, objTokenB)
expect(string.len(objTokenA), 10)
expectStr(objFixed, "zzzzz")
expect(defaultRange, 3)
