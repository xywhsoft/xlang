import bz2



func main(...) as int
    Buffer source = Buffer()
    source.append("abc")
    source.appendByte(0)
    source.appendByte(255)
    Buffer packed = bz2.compress(source)
    Buffer plain = bz2.decompress(packed)
    if not (plain == source) then
        return 1
    end

    auto encoder = bz2.compressor()
    encoder.update("left")
    encoder.update("right")
    encoder.finish()
    Buffer incremental = encoder.drain()
    auto decoder = bz2.decompressor()
    decoder.update(incremental)
    decoder.finish()
    if decoder.drain().text() != "leftright" then
        return 2
    end
    if decoder.members != 1 then
        return 6
    end

    // 流式分块收集 + 字节计数器（进度回显基础）。
    auto enc2 = bz2.compressor(6)
    Buffer collected = Buffer()
    enc2.update("aaaa")
    collected.append(enc2.drain())
    enc2.update("bbbb")
    collected.append(enc2.drain())
    enc2.finish()
    collected.append(enc2.drain())
    if enc2.inputBytes != 8 then
        return 7
    end
    auto dec2 = bz2.decompressor()
    dec2.update(collected)
    dec2.finish()
    if dec2.drain().text() != "aaaabbbb" then
        return 8
    end
    if not dec2.finished then
        return 9
    end

    // workFactor 调优参数与常量。
    auto enc3 = bz2.compressor(bz2.BZ2_MAX_LEVEL, bz2.BZ2_MAX_WORK_FACTOR)
    enc3.update("tune")
    enc3.finish()
    if bz2.decompress(enc3.drain()).text() != "tune" then
        return 10
    end
    bool badFactor = false
    try
        bz2.compressor(9, 999)
    catch ValueError e
        badFactor = true
    end
    if not badFactor then
        return 11
    end

    bool rejected = false
    incremental[10] = incremental[10] ^ 1
    try
        bz2.decompress(incremental)
    catch CompressionError e
        rejected = true
    end
    if not rejected then
        return 3
    end

    string sourcePath = "tmp/extlib_bz2_source.bin"
    string packedPath = "tmp/extlib_bz2_stream.bz2"
    string plainPath = "tmp/extlib_bz2_plain.bin"
    file.writeBytes(sourcePath, source)
    bz2.compressFile(sourcePath, packedPath)
    bz2.decompressFile(packedPath, plainPath)
    if file.readBytes(plainPath) != source then
        return 4
    end
    bool overwriteRejected = false
    try
        bz2.compressFile(sourcePath, packedPath, overwrite = false)
    catch CompressionError e
        overwriteRejected = true
    end
    if not overwriteRejected then
        return 5
    end
    file.delete(sourcePath)
    file.delete(packedPath)
    file.delete(plainPath)
    return 0
end
