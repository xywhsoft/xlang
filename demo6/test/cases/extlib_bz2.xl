import bz2



func main(...) as int
    Buffer source = Buffer()
    source.append("abc")
    source.appendByte(0)
    source.appendByte(255)
    Buffer packed = bz2.compress(source)
    Buffer plain = bz2.decompress(packed)
    if not (plain == source) then
        return 1
    end

    auto encoder = bz2.compressor()
    encoder.update("left")
    encoder.update("right")
    Buffer incremental = encoder.finish()
    auto decoder = bz2.decompressor()
    decoder.update(incremental)
    if decoder.finish().text() != "leftright" then
        return 2
    end

    bool rejected = false
    incremental[10] = incremental[10] ^ 1
    try
        bz2.decompress(incremental)
    catch CompressionError e
        rejected = true
    end
    if not rejected then
        return 3
    end

    string sourcePath = "tmp/extlib_bz2_source.bin"
    string packedPath = "tmp/extlib_bz2_stream.bz2"
    string plainPath = "tmp/extlib_bz2_plain.bin"
    file.writeBytes(sourcePath, source)
    bz2.compressFile(sourcePath, packedPath)
    bz2.decompressFile(packedPath, plainPath)
    if file.readBytes(plainPath) != source then
        return 4
    end
    bool overwriteRejected = false
    try
        bz2.compressFile(sourcePath, packedPath, overwrite = false)
    catch CompressionError e
        overwriteRejected = true
    end
    if not overwriteRejected then
        return 5
    end
    file.delete(sourcePath)
    file.delete(packedPath)
    file.delete(plainPath)
    return 0
end
