import kafka

func main(...) as int
    // API names
    assert kafka.apiName(0) == "Produce", "api produce"
    assert kafka.apiName(1) == "Fetch", "api fetch"
    assert kafka.apiName(3) == "Metadata", "api metadata"
    assert kafka.apiName(18) == "ApiVersions", "api versions"

    // Error names
    assert kafka.errorName(0) == "NONE", "err none"
    assert kafka.errorName(3) == "UNKNOWN_TOPIC_OR_PARTITION", "err topic"
    assert kafka.errorName(7) == "REQUEST_TIMED_OUT", "err timeout"
    assert kafka.errorName(25) == "UNKNOWN_MEMBER_ID", "err member"

    // Compression
    assert kafka.compression(0) == "none", "comp none"
    assert kafka.compression(1) == "gzip", "comp gzip"
    assert kafka.compression(3) == "lz4", "comp lz4"
    assert kafka.compression(4) == "zstd", "comp zstd"

    // Magic info
    assert kafka.magicInfo(0) == "v0.8-0.9: no timestamp", "magic 0"
    assert kafka.magicInfo(2) == "v0.11+: record batch, transactions", "magic 2"

    // Isolation
    assert kafka.isolation(0) == "READ_UNCOMMITTED", "iso 0"
    assert kafka.isolation(1) == "READ_COMMITTED", "iso 1"

    // Acks
    assert kafka.acksDesc(0) == "fire-and-forget", "acks 0"
    assert kafka.acksDesc(1) == "leader-ack", "acks 1"
    assert kafka.acksDesc(-1) == "all-replicas-ack", "acks -1"

    // Group state
    assert kafka.groupState(1) == "Stable", "group stable"
    assert kafka.groupState(4) == "Dead", "group dead"

    // Txn state
    assert kafka.txnState(0) == "Ongoing", "txn ongoing"
    assert kafka.txnState(3) == "CompleteCommit", "txn commit"

    return 0
end
