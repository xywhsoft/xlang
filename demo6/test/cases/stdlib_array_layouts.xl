class LayoutItem
    int value = 7
end

// Exact C scalar/type-id resident recipes are validated by the native oracle.
// Source Array still has its old carrier; these signatures do not claim cutover.
func layoutTypeIds(array<type> values) as int
    return values.length
end

func layoutNullableTypeIds(array<type?> values) as int
    return values.length
end

func layoutNestedCScalars(array<array<c_int?>> values) as int
    return values.length
end

// Nested recipes must stay pending when the child's slot/domain is unclosed.
func layoutUnclosed(array<array<func(int) as int>> functions, array<Stack<int>> stacks) as int
    return functions.length + stacks.length
end

