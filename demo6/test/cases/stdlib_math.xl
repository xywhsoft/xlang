extern "expect_i64" func expect(int actual, int expected)

expect(math.sqrt(9.0) ~= 3.0, 1)
expect(math.pow(2.0, 8.0) ~= 256.0, 1)
expect(math.abs(-3.5) ~= 3.5, 1)

expect(math.sin(0.0) ~= 0.0, 1)
expect(math.cos(0.0) ~= 1.0, 1)
expect(math.tan(0.0) ~= 0.0, 1)

expect(math.asin(0.0) ~= 0.0, 1)
expect(math.acos(1.0) ~= 0.0, 1)
expect(math.atan(0.0) ~= 0.0, 1)
expect(math.atan2(0.0, 1.0) ~= 0.0, 1)

expect(math.exp(0.0) ~= 1.0, 1)
expect(math.log(1.0) ~= 0.0, 1)
expect(math.log10(100.0) ~= 2.0, 1)

expect(math.floor(1.9) ~= 1.0, 1)
expect(math.ceil(1.1) ~= 2.0, 1)
expect(math.round(1.6) ~= 2.0, 1)
