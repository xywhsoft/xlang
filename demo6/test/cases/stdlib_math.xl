extern "expect_i64" func expect(int actual, int expected)

expect(math.sqrt(9.0) ~= 3.0, 1)
expect(math.pow(2.0, 8.0) ~= 256.0, 1)
expect(math.abs(-3.5) ~= 3.5, 1)

expect(math.sin(0.0) ~= 0.0, 1)
expect(math.cos(0.0) ~= 1.0, 1)
expect(math.tan(0.0) ~= 0.0, 1)

expect(math.asin(0.0) ~= 0.0, 1)
expect(math.acos(1.0) ~= 0.0, 1)
expect(math.atan(0.0) ~= 0.0, 1)
expect(math.atan2(0.0, 1.0) ~= 0.0, 1)

expect(math.exp(0.0) ~= 1.0, 1)
expect(math.log(1.0) ~= 0.0, 1)
expect(math.log10(100.0) ~= 2.0, 1)

expect(math.floor(1.9) ~= 1.0, 1)
expect(math.ceil(1.1) ~= 2.0, 1)
expect(math.round(1.6) ~= 2.0, 1)

expect(math.pi ~= 3.141592653589793, 1)
expect(math.tau ~= (math.pi * 2.0), 1)
expect(math.e ~= 2.718281828459045, 1)
expect(math.isNaN(math.nan), 1)
expect(math.isInf(math.inf), 1)
expect(math.isFinite(math.pi), 1)
expect(not math.isFinite(math.inf), 1)

expect(math.min(-2.0, 5.0) ~= -2.0, 1)
expect(math.max(-2.0, 5.0) ~= 5.0, 1)
expect(math.clamp(12.0, 0.0, 10.0) ~= 10.0, 1)
expect(math.clamp(-2.0, 0.0, 10.0) ~= 0.0, 1)
expect(math.sign(-3.0), -1)
expect(math.sign(0.0), 0)
expect(math.sign(3.0), 1)

expect(math.trunc(1.9) ~= 1.0, 1)
expect(math.trunc(-1.9) ~= -1.0, 1)
expect(math.fract(1.25) ~= 0.25, 1)
expect(math.fract(-1.25) ~= 0.75, 1)
expect(math.mod(5.5, 2.0) ~= 1.5, 1)

expect(math.rad(180.0) ~= math.pi, 1)
expect(math.deg(math.pi) ~= 180.0, 1)
expect(math.log2(8.0) ~= 3.0, 1)
expect(math.exp2(4.0) ~= 16.0, 1)
expect(math.log1p(1.0) ~= math.log(2.0), 1)
expect(math.expm1(1.0) ~= (math.e - 1.0), 1)
expect(math.cbrt(27.0) ~= 3.0, 1)
expect(math.cbrt(-8.0) ~= -2.0, 1)
expect(math.hypot(3.0, 4.0) ~= 5.0, 1)
