class Point
    int x = 0
    int y = 0

    create(int x, int y)
        return
    end

    func length2() as int
        return 0
    end

    destroy()
        return
    end
end

class Point3 extends Point
    int z = 0

    create(int x, int y, int z)
        base(x, y)
        self.z = z
    end
end

class Bag
    native point handle
    extern "bag_create" create()
    extern "bag_destroy" destroy()
    extern "bag_count" func count() as int

    func empty() as bool
        return false
    end
end

Point p
Bag bag
