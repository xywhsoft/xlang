import autodiff

func main(...) as int
    // Operations
    assert autodiff.op(0) == "add", "op add"
    assert autodiff.op(3) == "relu", "op relu"

    // Sigmoid gradient at x=0: 0.5 * 0.5 = 0.25
    float sg = autodiff.sigmoidGrad(0.0)
    assert sg > 0.24, "sigmoid grad min"
    assert sg < 0.26, "sigmoid grad max"

    // Tanh gradient at x=0: 1 - 0 = 1.0
    float tg = autodiff.tanhGrad(0.0)
    assert tg > 0.99, "tanh grad min"
    assert tg < 1.01, "tanh grad max"

    // ReLU gradient
    assert autodiff.reluGrad(5.0) > 0.99, "relu grad pos"
    assert autodiff.reluGrad(-5.0) < 0.01, "relu grad neg"

    // MSE gradient: pred=2, target=1, n=1 -> 2*(2-1)/1 = 2
    float mg = autodiff.mseGrad(2.0, 1.0, 1)
    assert mg > 1.99, "mse grad min"
    assert mg < 2.01, "mse grad max"

    // Mode
    assert autodiff.mode(0) == "forward", "mode fwd"
    assert autodiff.mode(1) == "reverse", "mode rev"

    return 0
end
