    int pendingVariadicDefaultSpawnValueB = await pendingVariadicDefaultSpawn
    pendingVariadicDefaultSpawnStateB = pendingVariadicDefaultSpawnValueB
catch e
    if e.message == "future cancel requested." then
        pendingVariadicDefaultSpawnStateB = 42
    end
end
assert pendingVariadicDefaultSpawnStateB == 42, "pending zero-fixed variadic task.spawn worker completion should not overwrite cancel"

int variadicExprTailValue = await task.spawn(variadicDefaultJob, true ? makeSpawnValue(1) : makeSpawnValue(9), makeSpawnValue(2) + makeSpawnValue(3))
assert variadicExprTailValue == 7, "task.spawn should lower dynamic vararg tail expressions"

