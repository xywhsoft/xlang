func() as int throwingJob = failJob
int spawnErrorState = 0
try
    int failedValue = await task.spawn(throwingJob)
    spawnErrorState = failedValue
catch e
    if e.message == "spawn boom" then
        spawnErrorState = 42
    end
end
assert spawnErrorState == 42, "task.spawn should propagate original error message"

future<int> repeatedFailedSpawn = task.spawn(throwingJob)
int repeatedFailedSpawnA = 0
try
    int failedSpawnA = await repeatedFailedSpawn
    repeatedFailedSpawnA = failedSpawnA
catch e
    if e.message == "spawn boom" then
        repeatedFailedSpawnA = 42
    end
end
assert repeatedFailedSpawnA == 42, "task.spawn failed future first await should propagate error"

int repeatedFailedSpawnB = 0
try
    int failedSpawnB = await repeatedFailedSpawn
    repeatedFailedSpawnB = failedSpawnB
catch e
    if e.message == "spawn boom" then
        repeatedFailedSpawnB = 42
    end
end
assert repeatedFailedSpawnB == 42, "task.spawn failed future repeated await should propagate error"

bool cancelRepeatedFailedSpawn = task.cancel(repeatedFailedSpawn)
assert not cancelRepeatedFailedSpawn, "failed task.spawn future should not be canceled"

int postCancelFailedSpawnState = 0
try
    int postCancelFailedSpawn = await repeatedFailedSpawn
    postCancelFailedSpawnState = postCancelFailedSpawn
catch e
    if e.message == "spawn boom" then
        postCancelFailedSpawnState = 42
    end
end

assert postCancelFailedSpawnState == 42, "failed task.spawn future should keep error after cancel"

