func(int, ...) as int variadicJob = sumVariadic
int variadicValue = await task.spawn(variadicJob, 10, 1, 2, 3)
assert variadicValue == 16, "task.spawn should pass array varargs through xvalue bridge"
int variadicEmptyValue = await task.spawn(variadicJob, 10)
assert variadicEmptyValue == 10, "task.spawn should pass an empty array vararg tail"

func(...) as int variadicDefaultJob = totalDefault
int variadicDefaultEmptyValue = await task.spawn(variadicDefaultJob)
assert variadicDefaultEmptyValue == 5, "task.spawn should run zero-argument array vararg adapter"
int variadicDefaultExtraValue = await task.spawn(variadicDefaultJob, "a", "b")
assert variadicDefaultExtraValue == 7, "task.spawn should run array vararg adapter with extra values"

future<int> spawnAllA = task.spawn(addJob, 10, 11)
future<int> spawnAllB = task.spawn(defaultJob, 20)
array<int> spawnAllValues = await task.all([spawnAllA, spawnAllB])
assert spawnAllValues.length == 2, "task.all should aggregate task.spawn futures"
assert spawnAllValues[0] == 21, "task.all should keep first task.spawn result"
assert spawnAllValues[1] == 21, "task.all should keep xcall adapter task.spawn result"

int spawnRaceValue = await task.race([task.spawn(addJob, 2, 3), task.spawn(defaultJob, 8)])
assert spawnRaceValue == 5 or spawnRaceValue == 9, "task.race should accept task.spawn futures"

array<string> spawnStringAllValues = await task.all([task.spawn(greetJob, "all-left"), task.spawn(greetJob, "all-right")])
assert spawnStringAllValues.length == 2, "task.all should aggregate string task.spawn futures"
assert spawnStringAllValues[0] == "hello all-left", "task.all should keep first string task.spawn result"
assert spawnStringAllValues[1] == "hello all-right", "task.all should keep second string task.spawn result"

string spawnStringRaceValue = await task.race([task.spawn(greetJob, "race-string")])
assert spawnStringRaceValue == "hello race-string", "task.race should accept string task.spawn futures"

array<future<string>> spawnStringAllJobs = array[task.spawn(greetJob, "typed-all-left"), task.spawn(greetJob, "typed-all-right")]
array<string> spawnStringTypedAll = await task.all(spawnStringAllJobs)
assert spawnStringTypedAll.length == 2, "task.all should aggregate typed array string task.spawn futures"
assert spawnStringTypedAll[0] == "hello typed-all-left", "task.all should keep first typed array string task.spawn result"
assert spawnStringTypedAll[1] == "hello typed-all-right", "task.all should keep second typed array string task.spawn result"

array<future<string>> spawnStringRaceJobs = array[task.spawn(greetJob, "typed-race-string")]
string spawnStringTypedRace = await task.race(spawnStringRaceJobs)
assert spawnStringTypedRace == "hello typed-race-string", "task.race should accept typed array string task.spawn futures"

array<future<string>> cancelSpawnStringAllJobs = array[task.spawn(greetJob, "cancel-all-left"), task.spawn(greetJob, "cancel-all-right")]
bool cancelSpawnStringTypedAll = task.cancel(task.all(cancelSpawnStringAllJobs))
assert cancelSpawnStringTypedAll == true or cancelSpawnStringTypedAll == false, "task.cancel should release typed array string task.all over task.spawn futures"

array<future<string>> cancelSpawnStringRaceJobs = array[task.spawn(greetJob, "cancel-race-string")]
bool cancelSpawnStringTypedRace = task.cancel(task.race(cancelSpawnStringRaceJobs))
assert cancelSpawnStringTypedRace == true or cancelSpawnStringTypedRace == false, "task.cancel should release typed array string task.race over task.spawn futures"

array<bool> spawnBoolAllValues = await task.all([task.spawn(flipJob, true), task.spawn(flipJob, false)])
assert spawnBoolAllValues.length == 2, "task.all should aggregate bool task.spawn futures"
assert spawnBoolAllValues[0] == false, "task.all should keep first bool task.spawn result"
assert spawnBoolAllValues[1] == true, "task.all should keep second bool task.spawn result"

bool spawnBoolRaceValue = await task.race([task.spawn(flipJob, true)])
assert spawnBoolRaceValue == false, "task.race should accept bool task.spawn futures"

array<future<bool>> spawnBoolAllJobs = array[task.spawn(flipJob, true), task.spawn(flipJob, false)]
array<bool> spawnBoolTypedAll = await task.all(spawnBoolAllJobs)
assert spawnBoolTypedAll.length == 2, "task.all should aggregate typed array bool task.spawn futures"
assert spawnBoolTypedAll[0] == false, "task.all should keep first typed array bool task.spawn result"
assert spawnBoolTypedAll[1] == true, "task.all should keep second typed array bool task.spawn result"

array<future<bool>> spawnBoolRaceJobs = array[task.spawn(flipJob, true)]
bool spawnBoolTypedRace = await task.race(spawnBoolRaceJobs)
assert spawnBoolTypedRace == false, "task.race should accept typed array bool task.spawn futures"

array<future<bool>> cancelSpawnBoolAllJobs = array[task.spawn(flipJob, true), task.spawn(flipJob, false)]
bool cancelSpawnBoolTypedAll = task.cancel(task.all(cancelSpawnBoolAllJobs))
assert cancelSpawnBoolTypedAll == true or cancelSpawnBoolTypedAll == false, "task.cancel should release typed array bool task.all over task.spawn futures"

array<future<bool>> cancelSpawnBoolRaceJobs = array[task.spawn(flipJob, true)]
bool cancelSpawnBoolTypedRace = task.cancel(task.race(cancelSpawnBoolRaceJobs))
assert cancelSpawnBoolTypedRace == true or cancelSpawnBoolTypedRace == false, "task.cancel should release typed array bool task.race over task.spawn futures"

array<float> spawnFloatAllValues = await task.all([task.spawn(halfJob, 3.5), task.spawn(halfJob, 4.5)])
assert spawnFloatAllValues.length == 2, "task.all should aggregate float task.spawn futures"
assert spawnFloatAllValues[0] == 4.0, "task.all should keep first float task.spawn result"
assert spawnFloatAllValues[1] == 5.0, "task.all should keep second float task.spawn result"

float spawnFloatRaceValue = await task.race([task.spawn(halfJob, 5.5)])
assert spawnFloatRaceValue == 6.0, "task.race should accept float task.spawn futures"

array<future<float>> spawnFloatAllJobs = array[task.spawn(halfJob, 6.5), task.spawn(halfJob, 7.5)]
array<float> spawnFloatTypedAll = await task.all(spawnFloatAllJobs)
assert spawnFloatTypedAll.length == 2, "task.all should aggregate typed array float task.spawn futures"
assert spawnFloatTypedAll[0] == 7.0, "task.all should keep first typed array float task.spawn result"
assert spawnFloatTypedAll[1] == 8.0, "task.all should keep second typed array float task.spawn result"

array<future<float>> spawnFloatRaceJobs = array[task.spawn(halfJob, 8.5)]
float spawnFloatTypedRace = await task.race(spawnFloatRaceJobs)
assert spawnFloatTypedRace == 9.0, "task.race should accept typed array float task.spawn futures"

array<future<float>> cancelSpawnFloatAllJobs = array[task.spawn(halfJob, 9.5), task.spawn(halfJob, 10.5)]
bool cancelSpawnFloatTypedAll = task.cancel(task.all(cancelSpawnFloatAllJobs))
assert cancelSpawnFloatTypedAll == true or cancelSpawnFloatTypedAll == false, "task.cancel should release typed array float task.all over task.spawn futures"

array<future<float>> cancelSpawnFloatRaceJobs = array[task.spawn(halfJob, 11.5)]
bool cancelSpawnFloatTypedRace = task.cancel(task.race(cancelSpawnFloatRaceJobs))
assert cancelSpawnFloatTypedRace == true or cancelSpawnFloatTypedRace == false, "task.cancel should release typed array float task.race over task.spawn futures"

func() as int throwingJob = failJob
int spawnErrorState = 0
try
    int failedValue = await task.spawn(throwingJob)
    spawnErrorState = failedValue
catch e
    if e.message == "spawn boom" then
        spawnErrorState = 42
    end
end
assert spawnErrorState == 42, "task.spawn should propagate original error message"

future<int> repeatedFailedSpawn = task.spawn(throwingJob)
int repeatedFailedSpawnA = 0
try
    int failedSpawnA = await repeatedFailedSpawn
    repeatedFailedSpawnA = failedSpawnA
catch e
    if e.message == "spawn boom" then
        repeatedFailedSpawnA = 42
    end
end
assert repeatedFailedSpawnA == 42, "task.spawn failed future first await should propagate error"

int repeatedFailedSpawnB = 0
try
    int failedSpawnB = await repeatedFailedSpawn
    repeatedFailedSpawnB = failedSpawnB
catch e
    if e.message == "spawn boom" then
        repeatedFailedSpawnB = 42
    end
end
assert repeatedFailedSpawnB == 42, "task.spawn failed future repeated await should propagate error"

bool cancelRepeatedFailedSpawn = task.cancel(repeatedFailedSpawn)
assert not cancelRepeatedFailedSpawn, "failed task.spawn future should not be canceled"

int postCancelFailedSpawnState = 0
try
    int postCancelFailedSpawn = await repeatedFailedSpawn
    postCancelFailedSpawnState = postCancelFailedSpawn
catch e
    if e.message == "spawn boom" then
        postCancelFailedSpawnState = 42
    end
end

assert postCancelFailedSpawnState == 42, "failed task.spawn future should keep error after cancel"

future<int> spawnAllFailureSlowSource = task.spawn(slowAddJob, 900, 9)
future<array<int>> spawnAllFailureGroup = task.all([task.spawn(throwingJob), spawnAllFailureSlowSource])
int spawnAllFailureGroupState = 0
try
    array<int> spawnAllFailureValues = await spawnAllFailureGroup
    spawnAllFailureGroupState = spawnAllFailureValues.length
catch e
    if e.message == "spawn boom" then
        spawnAllFailureGroupState = 42
    end
end
assert spawnAllFailureGroupState == 42, "task.all over task.spawn should propagate fast failure after slow source completes"
int spawnAllFailureSlowValue = await spawnAllFailureSlowSource
assert spawnAllFailureSlowValue == 909, "task.all failure should keep slow task.spawn source awaitable"

future<int> spawnRaceFailureSlowLoser = task.spawn(slowAddJob, 910, 9)
future<int> spawnRaceFailureGroup = task.race([task.spawn(throwingJob), spawnRaceFailureSlowLoser])
int spawnRaceFailureGroupState = 0
try
    int spawnRaceFailureValue = await spawnRaceFailureGroup
    spawnRaceFailureGroupState = spawnRaceFailureValue
catch e
    if e.message == "spawn boom" then
        spawnRaceFailureGroupState = 42
    end
end
assert spawnRaceFailureGroupState == 42, "task.race over task.spawn should propagate fast failure"

int spawnRaceFailureLoserStateA = 0
try
    int spawnRaceFailureLoserValueA = await spawnRaceFailureSlowLoser
    spawnRaceFailureLoserStateA = spawnRaceFailureLoserValueA
catch e
    if e.message == "future cancel requested." then
        spawnRaceFailureLoserStateA = 42
    end
end
assert spawnRaceFailureLoserStateA == 42, "task.race failure should cancel slow task.spawn loser"
time.sleep(320)
int spawnRaceFailureLoserStateB = 0
try
    int spawnRaceFailureLoserValueB = await spawnRaceFailureSlowLoser
    spawnRaceFailureLoserStateB = spawnRaceFailureLoserValueB
catch e
    if e.message == "future cancel requested." then
        spawnRaceFailureLoserStateB = 42
    end
end
assert spawnRaceFailureLoserStateB == 42, "task.race task.spawn loser should remain canceled after worker completes"

future<int> missingSpawnFuture

int nullSpawnAllState = 0
try
    array<int> nullSpawnAll = await task.all([task.spawn(addJob, 140, 1), missingSpawnFuture])
    nullSpawnAllState = nullSpawnAll.length
catch e
    if e.message == "task.all source future is null" then
        nullSpawnAllState = 42
    end
end
assert nullSpawnAllState == 42, "task.all over task.spawn should reject null source and release owned input"

int nullSpawnRaceState = 0
try
    int nullSpawnRace = await task.race([task.spawn(addJob, 150, 1), missingSpawnFuture])
    nullSpawnRaceState = nullSpawnRace
catch e
    if e.message == "task.race source future is null" then
        nullSpawnRaceState = 42
    end
end
assert nullSpawnRaceState == 42, "task.race over task.spawn should reject null source and release owned input"

