future<string> spawnStringAllFailureSlowSource = task.spawn(slowGreetJob, "slow-all")
future<array<string>> spawnStringAllFailureGroup = task.all([task.spawn(throwingStringJob), spawnStringAllFailureSlowSource])
int spawnStringAllFailureGroupState = 0
try
    array<string> spawnStringAllFailureValues = await spawnStringAllFailureGroup
    spawnStringAllFailureGroupState = spawnStringAllFailureValues.length
catch e
    if e.message == "spawn string boom" then
        spawnStringAllFailureGroupState = 42
    end
end
assert spawnStringAllFailureGroupState == 42, "task.all over string task.spawn should propagate fast failure after slow source completes"
string spawnStringAllFailureSlowValue = await spawnStringAllFailureSlowSource
assert spawnStringAllFailureSlowValue == "hello slow-all", "task.all string failure should keep slow task.spawn source awaitable"

future<string> spawnStringRaceFailureSlowLoser = task.spawn(slowGreetJob, "slow-race")
future<string> spawnStringRaceFailureGroup = task.race([task.spawn(throwingStringJob), spawnStringRaceFailureSlowLoser])
int spawnStringRaceFailureGroupState = 0
try
    string spawnStringRaceFailureValue = await spawnStringRaceFailureGroup
    spawnStringRaceFailureGroupState = 1
catch e
    if e.message == "spawn string boom" then
        spawnStringRaceFailureGroupState = 42
    end
end
assert spawnStringRaceFailureGroupState == 42, "task.race over string task.spawn should propagate fast failure"

int spawnStringRaceFailureLoserStateA = 0
try
    string spawnStringRaceFailureLoserValueA = await spawnStringRaceFailureSlowLoser
    spawnStringRaceFailureLoserStateA = 1
catch e
    if e.message == "future cancel requested." then
        spawnStringRaceFailureLoserStateA = 42
    end
end
assert spawnStringRaceFailureLoserStateA == 42, "task.race string failure should cancel slow task.spawn loser"
time.sleep(320)
int spawnStringRaceFailureLoserStateB = 0
try
    string spawnStringRaceFailureLoserValueB = await spawnStringRaceFailureSlowLoser
    spawnStringRaceFailureLoserStateB = 1
catch e
    if e.message == "future cancel requested." then
        spawnStringRaceFailureLoserStateB = 42
    end
end
assert spawnStringRaceFailureLoserStateB == 42, "task.race string task.spawn loser should remain canceled after worker completes"

