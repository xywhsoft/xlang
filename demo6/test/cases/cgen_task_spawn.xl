assert variadicAllA[0] == 23, "task.all variadic task.spawn first await value"
assert variadicAllB[1] == 7, "task.all variadic task.spawn repeated await value"
assert not task.cancel(variadicAllFuture), "completed variadic task.all future should not be canceled"
array<int> variadicAllAfterCancel = await variadicAllFuture
assert variadicAllAfterCancel[0] == 23, "completed variadic task.all future should remain awaitable"

