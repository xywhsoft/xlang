    string failedStringValue = await task.spawn(throwingStringJob)
    stringSpawnErrorState = 1
catch e
    if e.message == "spawn string boom" then
        stringSpawnErrorState = 42
    end
end
assert stringSpawnErrorState == 42, "task.spawn string failed temporary future should propagate error"

future<string> repeatedFailedStringSpawn = task.spawn(throwingStringJob)
int postCancelFailedStringState = 0
try
    string firstFailedString = await repeatedFailedStringSpawn
    postCancelFailedStringState = 1
catch e
    if e.message == "spawn string boom" then
        postCancelFailedStringState = 21
    end
end
assert postCancelFailedStringState == 21, "task.spawn string failed future first await should propagate error"
assert not task.cancel(repeatedFailedStringSpawn), "failed string task.spawn future should not be canceled"
try
    string postCancelFailedString = await repeatedFailedStringSpawn
    postCancelFailedStringState = 2
catch e
    if e.message == "spawn string boom" then
        postCancelFailedStringState = 42
    end
end
assert postCancelFailedStringState == 42, "failed string task.spawn future should keep error after cancel"

