assert variadicRaceB == 33, "task.race variadic task.spawn repeated await"
assert not task.cancel(variadicRaceFuture), "completed variadic task.race future should not be canceled"
int variadicRaceAfterCancel = await variadicRaceFuture
assert variadicRaceAfterCancel == 33, "completed variadic task.race future should remain awaitable"

