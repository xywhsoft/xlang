time.sleep(320)

int pendingBoolSpawnStateB = 0
try
    bool pendingBoolSpawnValueB = await pendingBoolSpawn
    pendingBoolSpawnStateB = 9
catch e
    if e.message == "future cancel requested." then
        pendingBoolSpawnStateB = 42
    end
end
assert pendingBoolSpawnStateB == 42, "pending bool task.spawn worker completion should not overwrite cancel"

func(float) as float halfJob = addHalf
float halfValue = await task.spawn(halfJob, 1.5)
assert halfValue == 2.0, "task.spawn should bridge float arguments and results"
future<float> namedHalfFuture = task.spawn(halfJob, 2.5)
float namedHalfA = await namedHalfFuture
float namedHalfB = await namedHalfFuture
assert namedHalfA == 3.0, "task.spawn float future first await should copy result"
assert namedHalfB == 3.0, "task.spawn float future repeated await should copy result"
assert not task.cancel(namedHalfFuture), "completed float task.spawn future should not be canceled"
float postCancelNamedHalf = await namedHalfFuture
assert postCancelNamedHalf == 3.0, "completed float task.spawn future should remain awaitable after cancel"

