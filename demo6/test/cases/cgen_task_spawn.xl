func add(int left, int right) as int
    return left + right
end

func slowAdd(int left, int right) as int
    time.sleep(250)
    return left + right
end

func addDefault(int left, int right = 1) as int
    return left + right
end

func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

func makeSleepyAdder(int base) as func(int) as int
    return func(int delay) as int
        time.sleep(delay)
        return base + delay
    end
end

async func makeAsyncAdder(int base) as func(int) as int
    return makeAdder(base)
end

func greet(string name) as string
    return "hello " + name
end

func slowGreet(string name) as string
    time.sleep(250)
    return "hello " + name
end

func flip(bool flag) as bool
    return not flag
end

func slowFlip(bool flag) as bool
    time.sleep(250)
    return not flag
end

func addHalf(float value) as float
    return value + 0.5
end

func slowAddHalf(float value) as float
    time.sleep(250)
    return value + 0.5
end

func fortyTwo() as int
    return 42
end

func sumVariadic(int base, ...) as int
    int total = base
    int i = 0
    while i < arg.length do
        total = total + int(arg[i])
        i = i + 1
    end
    return total
end

func slowSumVariadic(int base, ...) as int
    time.sleep(250)
    int total = base
    int i = 0
    while i < arg.length do
        total = total + int(arg[i])
        i = i + 1
    end
    return total
end

func totalDefault(int base = 5, ...) as int
    return base + arg.length
end

func slowTotalDefault(int base = 5, ...) as int
    time.sleep(250)
    return base + arg.length
end

func addVar(var value) as int
    return int(value) + 1
end

func scoreSpawnResult(int value) as int
    return value + 1
end

func combineSpawnResult(int left, int right) as int
    return left + right
end

func pairSpawnResult(int left, int right) as (int, int)
    return left, right
end

func describeSpawnValue(var value) as string
    return "dynamic " + string(value)
end

func makeSpawnValue(int value) as var
    return value
end

async func makeTypedDynamicSpawnAllValues(func(var) as int job) as array<int>
    return array[
        await task.spawn(job, true ? makeSpawnValue(101) : makeSpawnValue(0)),
        await task.spawn(job, makeSpawnValue(30) + makeSpawnValue(11))
    ]
end

async func makeTypedDynamicSpawnAwaitValues(func(var) as int job, var fallback) as array<int>
    return array[
        await task.spawn(job, fallback ?? makeSpawnValue(41))
    ]
end

func makeDynamicSpawnArray(int value) as array<int>
    return array[value, value + 1]
end

func makeDynamicSpawnGenerator(int value) as generator<int>
    yield value
    yield value + 1
end

func spawnCancelReturnDynamic(func(var) as int job) as bool
    return task.cancel(task.spawn(job, true ? makeSpawnValue(61) : makeSpawnValue(0)))
end

func dynamicSpawnStream() as async generator<int>
    func(var) as int job = addVar
    yield await task.spawn(job, true ? makeSpawnValue(231) : makeSpawnValue(0))
    yield await task.spawn(job, makeSpawnValue(80) + makeSpawnValue(1))
end

func scoreVarString(var value) as int
    if string(value) == "spawn" then
        return 42
    end
    return 0
end

func failJob() as int
    throw "spawn boom"
    return 0
end

func failStringJob() as string
    throw "spawn string boom"
    return ""
end

func failBoolJob() as bool
    throw "spawn bool boom"
    return false
end

func failFloatJob() as float
    throw "spawn float boom"
    return 0.0
end

class SpawnFuncBox
    func(int) as int op
end

func markVoidJob()
    int local = 1
    assert local == 1, "task.spawn void job body should run"
end

func slowVoidJob()
    time.sleep(250)
    int local = 2
    assert local == 2, "slow task.spawn void job body should run"
end

func failVoidJob()
    throw "spawn void boom"
end

func() as int zeroJob = fortyTwo
int zeroValue = await task.spawn(zeroJob)
assert zeroValue == 42, "task.spawn should run zero-argument func value"

func() voidJob = markVoidJob
future<null> voidSpawnFuture = task.spawn(voidJob)
await voidSpawnFuture
await voidSpawnFuture
assert not task.cancel(voidSpawnFuture), "completed void task.spawn future should not be canceled"
await voidSpawnFuture
bool cancelTemporaryVoidSpawn = task.cancel(task.spawn(voidJob))
assert cancelTemporaryVoidSpawn == true or cancelTemporaryVoidSpawn == false, "task.cancel should release temporary void task.spawn future"

future<null> voidAllFuture = task.all([task.spawn(voidJob), task.spawn(voidJob)])
await voidAllFuture
await voidAllFuture
assert not task.cancel(voidAllFuture), "completed void task.all future should not be canceled"
await voidAllFuture

future<null> voidRaceFuture = task.race([task.spawn(voidJob), task.spawn(voidJob)])
await voidRaceFuture
await voidRaceFuture
assert not task.cancel(voidRaceFuture), "completed void task.race future should not be canceled"
await voidRaceFuture

future<null> conditionalVoidCancelSource = task.spawn(voidJob)
await conditionalVoidCancelSource
bool chooseConditionalVoidCancel = true
assert not task.cancel(chooseConditionalVoidCancel ? conditionalVoidCancelSource : task.spawn(voidJob)), "completed conditional void borrowed future should not be canceled"
await conditionalVoidCancelSource
chooseConditionalVoidCancel = false
bool conditionalVoidOwnedCancel = task.cancel(chooseConditionalVoidCancel ? conditionalVoidCancelSource : task.spawn(voidJob))
assert conditionalVoidOwnedCancel == true or conditionalVoidOwnedCancel == false, "conditional void owned future cancel should release temporary future"
await conditionalVoidCancelSource

future<null> conditionalVoidAllSource = task.spawn(voidJob)
bool chooseConditionalVoidAll = true
await task.all([
    chooseConditionalVoidAll ? conditionalVoidAllSource : task.spawn(voidJob),
    false ? conditionalVoidAllSource : task.spawn(voidJob)
])
await conditionalVoidAllSource

future<null> conditionalVoidRaceSource = task.spawn(voidJob)
bool chooseConditionalVoidRace = true
await task.race([chooseConditionalVoidRace ? conditionalVoidRaceSource : task.spawn(voidJob)])
await conditionalVoidRaceSource

future<null> typedConditionalVoidAllSource = task.spawn(voidJob)
bool chooseTypedConditionalVoidAll = true
array<future<null>> typedConditionalVoidAllJobs = array[
    chooseTypedConditionalVoidAll ? typedConditionalVoidAllSource : task.spawn(voidJob),
    false ? typedConditionalVoidAllSource : task.spawn(voidJob)
]
future<null> typedConditionalVoidAllFuture = task.all(typedConditionalVoidAllJobs)
await typedConditionalVoidAllFuture
await typedConditionalVoidAllFuture
assert not task.cancel(typedConditionalVoidAllFuture), "typed-array conditional void task.all completed future should not be canceled"
await typedConditionalVoidAllFuture
await typedConditionalVoidAllSource

future<null> typedConditionalVoidRaceSource = task.spawn(voidJob)
bool chooseTypedConditionalVoidRace = true
array<future<null>> typedConditionalVoidRaceJobs = array[
    chooseTypedConditionalVoidRace ? typedConditionalVoidRaceSource : task.spawn(voidJob)
]
future<null> typedConditionalVoidRaceFuture = task.race(typedConditionalVoidRaceJobs)
await typedConditionalVoidRaceFuture
await typedConditionalVoidRaceFuture
assert not task.cancel(typedConditionalVoidRaceFuture), "typed-array conditional void task.race completed future should not be canceled"
await typedConditionalVoidRaceFuture
await typedConditionalVoidRaceSource

await task.all([task.spawn(voidJob), task.spawn(voidJob)])
await task.race([task.spawn(voidJob), task.spawn(voidJob)])
bool cancelTemporaryVoidAll = task.cancel(task.all([task.spawn(voidJob), task.spawn(voidJob)]))
assert cancelTemporaryVoidAll == true or cancelTemporaryVoidAll == false, "task.cancel should release temporary void task.all future"
bool cancelTemporaryVoidRace = task.cancel(task.race([task.spawn(voidJob), task.spawn(voidJob)]))
assert cancelTemporaryVoidRace == true or cancelTemporaryVoidRace == false, "task.cancel should release temporary void task.race future"

array<future<null>> typedVoidAllJobs = array[task.spawn(voidJob), task.spawn(voidJob)]
future<null> typedVoidAllFuture = task.all(typedVoidAllJobs)
await typedVoidAllFuture
await typedVoidAllFuture
assert not task.cancel(typedVoidAllFuture), "typed-array void task.all completed future should not be canceled"
await typedVoidAllFuture

array<future<null>> typedVoidRaceJobs = array[task.spawn(voidJob)]
future<null> typedVoidRaceFuture = task.race(typedVoidRaceJobs)
await typedVoidRaceFuture
await typedVoidRaceFuture
assert not task.cancel(typedVoidRaceFuture), "typed-array void task.race completed future should not be canceled"
await typedVoidRaceFuture

array<future<null>> emptyVoidJobs = array[]

int emptyVoidAllState = 0
try
    await task.all(emptyVoidJobs)
    emptyVoidAllState = 1
catch e
    if e.message == "task.all requires a non-empty future array" then
        emptyVoidAllState = 42
    end
end
assert emptyVoidAllState == 42, "task.all empty void typed array should require a non-empty future array"

int emptyVoidRaceState = 0
try
    await task.race(emptyVoidJobs)
    emptyVoidRaceState = 1
catch e
    if e.message == "task.race requires a non-empty future array" then
        emptyVoidRaceState = 42
    end
end
assert emptyVoidRaceState == 42, "task.race empty void typed array should require a non-empty future array"

