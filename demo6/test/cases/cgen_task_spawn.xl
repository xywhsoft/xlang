func() throwingVoidJob = failVoidJob
future<null> failedVoidSpawn = task.spawn(throwingVoidJob)
int failedVoidSpawnStateA = 0
try
    await failedVoidSpawn
    failedVoidSpawnStateA = 1
catch e
    if e.message == "spawn void boom" then
        failedVoidSpawnStateA = 21
    end
end
assert failedVoidSpawnStateA == 21, "task.spawn void failed future first await should propagate error"
assert not task.cancel(failedVoidSpawn), "failed void task.spawn future should not be canceled"
try
    await failedVoidSpawn
    failedVoidSpawnStateA = 2
catch e
    if e.message == "spawn void boom" then
        failedVoidSpawnStateA = 42
    end
end
assert failedVoidSpawnStateA == 42, "failed void task.spawn future should keep error after cancel"

future<null> failedVoidAll = task.all([task.spawn(throwingVoidJob)])
int failedVoidAllStateA = 0
try
    await failedVoidAll
    failedVoidAllStateA = 1
catch e
    if e.message == "spawn void boom" then
        failedVoidAllStateA = 21
    end
end
assert failedVoidAllStateA == 21, "task.all should propagate void task.spawn error"
assert not task.cancel(failedVoidAll), "failed void task.all future should not be canceled"
try
    await failedVoidAll
    failedVoidAllStateA = 2
catch e
    if e.message == "spawn void boom" then
        failedVoidAllStateA = 42
    end
end
assert failedVoidAllStateA == 42, "failed void task.all should keep error after cancel"

future<null> failedVoidRace = task.race([task.spawn(throwingVoidJob)])
int failedVoidRaceStateA = 0
try
    await failedVoidRace
    failedVoidRaceStateA = 1
catch e
    if e.message == "spawn void boom" then
        failedVoidRaceStateA = 21
    end
end
assert failedVoidRaceStateA == 21, "task.race should propagate void task.spawn error"
assert not task.cancel(failedVoidRace), "failed void task.race future should not be canceled"
try
    await failedVoidRace
    failedVoidRaceStateA = 2
catch e
    if e.message == "spawn void boom" then
        failedVoidRaceStateA = 42
    end
end
assert failedVoidRaceStateA == 42, "failed void task.race should keep error after cancel"

array<future<null>> failedVoidAllJobs = array[task.spawn(throwingVoidJob)]
int failedVoidTypedAllState = 0
try
    await task.all(failedVoidAllJobs)
    failedVoidTypedAllState = 1
catch e
    if e.message == "spawn void boom" then
        failedVoidTypedAllState = 42
    end
end
assert failedVoidTypedAllState == 42, "task.all typed array should propagate void task.spawn error"

array<future<null>> failedVoidRaceJobs = array[task.spawn(throwingVoidJob)]
int failedVoidTypedRaceState = 0
try
    await task.race(failedVoidRaceJobs)
    failedVoidTypedRaceState = 1
catch e
    if e.message == "spawn void boom" then
        failedVoidTypedRaceState = 42
    end
end
assert failedVoidTypedRaceState == 42, "task.race typed array should propagate void task.spawn error"

func(int, int) as int addJob = add
int addValue = await task.spawn(addJob, 20, 22)
assert addValue == 42, "task.spawn should run typed func value"

future<int> repeatedSpawn = task.spawn(addJob, 21, 21)
int repeatedA = await repeatedSpawn
int repeatedB = await repeatedSpawn
assert repeatedA == 42, "task.spawn named future first await should work"
assert repeatedB == 42, "task.spawn named future repeated await should work"
assert not task.cancel(repeatedSpawn), "completed task.spawn future should not be canceled"
int postCancelRepeatedSpawn = await repeatedSpawn
assert postCancelRepeatedSpawn == 42, "completed task.spawn future should remain awaitable after cancel"
bool cancelTemporarySpawn = task.cancel(task.spawn(addJob, 1, 2))
assert cancelTemporarySpawn == true or cancelTemporarySpawn == false, "task.cancel should release temporary task.spawn future"

