future<float> pendingFloatSpawn = task.spawn(slowHalfJob, 1.5)
assert task.cancel(pendingFloatSpawn), "pending float task.spawn future should accept cancel"

int pendingFloatSpawnStateA = 0
try
    float pendingFloatSpawnValueA = await pendingFloatSpawn
    pendingFloatSpawnStateA = 9
catch e
    if e.message == "future cancel requested." then
        pendingFloatSpawnStateA = 42
    end
end
assert pendingFloatSpawnStateA == 42, "pending float task.spawn future should await as canceled"

time.sleep(320)

int pendingFloatSpawnStateB = 0
try
    float pendingFloatSpawnValueB = await pendingFloatSpawn
    pendingFloatSpawnStateB = 9
catch e
    if e.message == "future cancel requested." then
        pendingFloatSpawnStateB = 42
    end
end
assert pendingFloatSpawnStateB == 42, "pending float task.spawn worker completion should not overwrite cancel"

func(int, ...) as int variadicJob = sumVariadic
int variadicValue = await task.spawn(variadicJob, 10, 1, 2, 3)
assert variadicValue == 16, "task.spawn should pass array varargs through xvalue bridge"
int variadicEmptyValue = await task.spawn(variadicJob, 10)
assert variadicEmptyValue == 10, "task.spawn should pass an empty array vararg tail"

func(...) as int variadicDefaultJob = totalDefault
int variadicDefaultEmptyValue = await task.spawn(variadicDefaultJob)
assert variadicDefaultEmptyValue == 5, "task.spawn should run zero-argument array vararg adapter"
int variadicDefaultExtraValue = await task.spawn(variadicDefaultJob, "a", "b")
assert variadicDefaultExtraValue == 7, "task.spawn should run array vararg adapter with extra values"
int variadicExprTailValue = await task.spawn(variadicDefaultJob, true ? makeSpawnValue(1) : makeSpawnValue(9), makeSpawnValue(2) + makeSpawnValue(3))
assert variadicExprTailValue == 7, "task.spawn should lower dynamic vararg tail expressions"

func(var) as int varArgJob = addVar
var dynamicSpawnArg = 41
future<int> namedVarArgSpawn = task.spawn(varArgJob, dynamicSpawnArg)
int namedVarArgA = await namedVarArgSpawn
int namedVarArgB = await namedVarArgSpawn
assert namedVarArgA == 42, "task.spawn should bridge var argument from named xvalue"
assert namedVarArgB == 42, "task.spawn var argument repeated await should remain stable"
assert not task.cancel(namedVarArgSpawn), "completed task.spawn var argument future should not be canceled"
int postCancelVarArg = await namedVarArgSpawn
assert postCancelVarArg == 42, "completed task.spawn var argument future should remain awaitable after cancel"
int literalVarArgValue = await task.spawn(varArgJob, 41)
assert literalVarArgValue == 42, "task.spawn should bridge scalar literal into var parameter"
int conditionalVarArgValue = await task.spawn(varArgJob, true ? makeSpawnValue(51) : makeSpawnValue(99))
assert conditionalVarArgValue == 52, "task.spawn should lower dynamic conditional var argument"
int binaryVarArgValue = await task.spawn(varArgJob, makeSpawnValue(20) + makeSpawnValue(21))
assert binaryVarArgValue == 42, "task.spawn should lower dynamic binary var argument"
var emptySpawnArg = null
int nullCoalesceVarArgValue = await task.spawn(varArgJob, emptySpawnArg ?? makeSpawnValue(41))
assert nullCoalesceVarArgValue == 42, "task.spawn should lower dynamic null-coalesce var argument"
int nestedCallArgValue = scoreSpawnResult(await task.spawn(varArgJob, true ? makeSpawnValue(31) : makeSpawnValue(0)))
assert nestedCallArgValue == 33, "task.spawn dynamic var argument should lower inside positional call arguments"
int nestedNamedCallArgValue = combineSpawnResult(right = await task.spawn(varArgJob, makeSpawnValue(12) + makeSpawnValue(29)), left = 1)
assert nestedNamedCallArgValue == 43, "task.spawn dynamic var argument should lower inside named call arguments"
int conditionDynamicSpawnCount = 0
if await task.spawn(varArgJob, true ? makeSpawnValue(1) : makeSpawnValue(0)) == 2 then
    conditionDynamicSpawnCount = conditionDynamicSpawnCount + 1
end
assert conditionDynamicSpawnCount == 1, "task.spawn dynamic var argument should lower inside if conditions"
int whileDynamicSpawnCount = 0
while await task.spawn(varArgJob, true ? makeSpawnValue(0) : makeSpawnValue(9)) == 1 do
    whileDynamicSpawnCount = whileDynamicSpawnCount + 1
    if whileDynamicSpawnCount >= 2 then
        break
    end
end
assert whileDynamicSpawnCount == 2, "task.spawn dynamic var argument should lower inside while conditions"
int doDynamicSpawnCount = 0
do
    doDynamicSpawnCount = doDynamicSpawnCount + 1
while doDynamicSpawnCount < 2 and await task.spawn(varArgJob, makeSpawnValue(0) + makeSpawnValue(0)) == 1
assert doDynamicSpawnCount == 2, "task.spawn dynamic var argument should lower inside do while conditions"
bool returnedDynamicSpawnCancel = spawnCancelReturnDynamic(varArgJob)
assert returnedDynamicSpawnCancel == true or returnedDynamicSpawnCancel == false, "task.spawn dynamic var argument should lower in return statements"
future<int> assignedDynamicSpawn
assignedDynamicSpawn = task.spawn(varArgJob, true ? makeSpawnValue(71) : makeSpawnValue(0))
int assignedDynamicSpawnValue = await assignedDynamicSpawn
assert assignedDynamicSpawnValue == 72, "task.spawn dynamic var argument should lower in assignments"
task.cancel(task.spawn(varArgJob, true ? makeSpawnValue(81) : makeSpawnValue(0)))
array<future<int>> typedDynamicSpawnAllJobs = array[
    task.spawn(varArgJob, true ? makeSpawnValue(91) : makeSpawnValue(0)),
    task.spawn(varArgJob, makeSpawnValue(20) + makeSpawnValue(21))
]
array<int> typedDynamicSpawnAllValues = await task.all(typedDynamicSpawnAllJobs)
assert typedDynamicSpawnAllValues.length == 2, "typed array task.spawn dynamic var argument count"
assert typedDynamicSpawnAllValues[0] == 92, "typed array task.spawn dynamic conditional argument"
assert typedDynamicSpawnAllValues[1] == 42, "typed array task.spawn dynamic binary argument"
array<future<int>> typedDynamicSpawnRaceJobs = array[
    task.spawn(varArgJob, emptySpawnArg ?? makeSpawnValue(41))
]
int typedDynamicSpawnRaceValue = await task.race(typedDynamicSpawnRaceJobs)
assert typedDynamicSpawnRaceValue == 42, "typed array task.spawn dynamic null-coalesce argument"
array<int> asyncReturnDynamicSpawnAllValues = await makeTypedDynamicSpawnAllValues(varArgJob)
assert asyncReturnDynamicSpawnAllValues.length == 2, "async returned typed array task.spawn dynamic var argument count"
assert asyncReturnDynamicSpawnAllValues[0] == 102, "async returned typed array task.spawn dynamic conditional argument"
assert asyncReturnDynamicSpawnAllValues[1] == 42, "async returned typed array task.spawn dynamic binary argument"
array<int> asyncReturnDynamicSpawnAwaitValues = await makeTypedDynamicSpawnAwaitValues(varArgJob, emptySpawnArg)
assert asyncReturnDynamicSpawnAwaitValues.length == 1, "async returned typed array task.spawn dynamic await count"
assert asyncReturnDynamicSpawnAwaitValues[0] == 42, "async returned typed array task.spawn dynamic null-coalesce argument"

func(var) as int varStringJob = scoreVarString
var dynamicStringSpawnArg = "spawn"
int varStringValue = await task.spawn(varStringJob, dynamicStringSpawnArg)
assert varStringValue == 42, "task.spawn should bridge string var argument"

future<int> spawnAllA = task.spawn(addJob, 10, 11)
future<int> spawnAllB = task.spawn(defaultJob, 20)
array<int> spawnAllValues = await task.all([spawnAllA, spawnAllB])
assert spawnAllValues.length == 2, "task.all should aggregate task.spawn futures"
assert spawnAllValues[0] == 21, "task.all should keep first task.spawn result"
assert spawnAllValues[1] == 21, "task.all should keep xcall adapter task.spawn result"

int spawnRaceValue = await task.race([task.spawn(addJob, 2, 3), task.spawn(defaultJob, 8)])
assert spawnRaceValue == 5 or spawnRaceValue == 9, "task.race should accept task.spawn futures"

array<future<int>> spawnIntAllCompletedJobs = array[task.spawn(addJob, 30, 12), task.spawn(defaultJob, 41)]
future<array<int>> spawnIntAllCompletedFuture = task.all(spawnIntAllCompletedJobs)
array<int> spawnIntAllCompletedA = await spawnIntAllCompletedFuture
array<int> spawnIntAllCompletedB = await spawnIntAllCompletedFuture
assert spawnIntAllCompletedA.length == 2, "typed-array int task.spawn task.all count"
assert spawnIntAllCompletedB.length == 2, "typed-array int task.spawn task.all repeated count"
assert spawnIntAllCompletedA[0] == 42, "typed-array int task.spawn task.all first await"
assert spawnIntAllCompletedB[1] == 42, "typed-array int task.spawn task.all repeated await"
assert not task.cancel(spawnIntAllCompletedFuture), "typed-array int task.spawn task.all completed cancel"
array<int> postCancelSpawnIntAllCompleted = await spawnIntAllCompletedFuture
assert postCancelSpawnIntAllCompleted[0] == 42, "typed-array int task.spawn task.all post-cancel await"

array<future<int>> spawnIntRaceCompletedJobs = array[task.spawn(addJob, 70, 5)]
future<int> spawnIntRaceCompletedFuture = task.race(spawnIntRaceCompletedJobs)
int spawnIntRaceCompletedA = await spawnIntRaceCompletedFuture
int spawnIntRaceCompletedB = await spawnIntRaceCompletedFuture
assert spawnIntRaceCompletedA == 75, "typed-array int task.spawn task.race first await"
assert spawnIntRaceCompletedB == 75, "typed-array int task.spawn task.race repeated await"
assert not task.cancel(spawnIntRaceCompletedFuture), "typed-array int task.spawn task.race completed cancel"
int postCancelSpawnIntRaceCompleted = await spawnIntRaceCompletedFuture
assert postCancelSpawnIntRaceCompleted == 75, "typed-array int task.spawn task.race post-cancel await"

array<string> spawnStringAllValues = await task.all([task.spawn(greetJob, "all-left"), task.spawn(greetJob, "all-right")])
assert spawnStringAllValues.length == 2, "task.all should aggregate string task.spawn futures"
assert spawnStringAllValues[0] == "hello all-left", "task.all should keep first string task.spawn result"
assert spawnStringAllValues[1] == "hello all-right", "task.all should keep second string task.spawn result"

string spawnStringRaceValue = await task.race([task.spawn(greetJob, "race-string")])
assert spawnStringRaceValue == "hello race-string", "task.race should accept string task.spawn futures"

array<future<string>> spawnStringAllJobs = array[task.spawn(greetJob, "typed-all-left"), task.spawn(greetJob, "typed-all-right")]
array<string> spawnStringTypedAll = await task.all(spawnStringAllJobs)
assert spawnStringTypedAll.length == 2, "task.all should aggregate typed array string task.spawn futures"
assert spawnStringTypedAll[0] == "hello typed-all-left", "task.all should keep first typed array string task.spawn result"
assert spawnStringTypedAll[1] == "hello typed-all-right", "task.all should keep second typed array string task.spawn result"

array<future<string>> spawnStringRaceJobs = array[task.spawn(greetJob, "typed-race-string")]
string spawnStringTypedRace = await task.race(spawnStringRaceJobs)
assert spawnStringTypedRace == "hello typed-race-string", "task.race should accept typed array string task.spawn futures"

array<future<string>> spawnStringAllCompletedJobs = array[task.spawn(greetJob, "typed-complete-left"), task.spawn(greetJob, "typed-complete-right")]
