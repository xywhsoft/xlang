func add(int left, int right) as int
    return left + right
end

func slowAdd(int left, int right) as int
    time.sleep(250)
    return left + right
end

func addDefault(int left, int right = 1) as int
    return left + right
end

func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

func greet(string name) as string
    return "hello " + name
end

func slowGreet(string name) as string
    time.sleep(250)
    return "hello " + name
end

func flip(bool flag) as bool
    return not flag
end

func slowFlip(bool flag) as bool
    time.sleep(250)
    return not flag
end

func addHalf(float value) as float
    return value + 0.5
end

func slowAddHalf(float value) as float
    time.sleep(250)
    return value + 0.5
end

func fortyTwo() as int
    return 42
end

func sumVariadic(int base, ...) as int
    int total = base
    int i = 0
    while i < arg.length do
        total = total + int(arg[i])
        i = i + 1
    end
    return total
end

func totalDefault(int base = 5, ...) as int
    return base + arg.length
end

func addVar(var value) as int
    return int(value) + 1
end

func scoreSpawnResult(int value) as int
    return value + 1
end

func combineSpawnResult(int left, int right) as int
    return left + right
end

func makeSpawnValue(int value) as var
    return value
end

async func makeTypedDynamicSpawnAllValues(func(var) as int job) as array<int>
    return array[
        await task.spawn(job, true ? makeSpawnValue(101) : makeSpawnValue(0)),
        await task.spawn(job, makeSpawnValue(30) + makeSpawnValue(11))
    ]
end

async func makeTypedDynamicSpawnAwaitValues(func(var) as int job, var fallback) as array<int>
    return array[
        await task.spawn(job, fallback ?? makeSpawnValue(41))
    ]
end

func spawnCancelReturnDynamic(func(var) as int job) as bool
    return task.cancel(task.spawn(job, true ? makeSpawnValue(61) : makeSpawnValue(0)))
end

func scoreVarString(var value) as int
    if string(value) == "spawn" then
        return 42
    end
    return 0
end

func failJob() as int
    throw "spawn boom"
    return 0
end

func failStringJob() as string
    throw "spawn string boom"
    return ""
end

func failBoolJob() as bool
    throw "spawn bool boom"
    return false
end

func failFloatJob() as float
    throw "spawn float boom"
    return 0.0
end

func() as int zeroJob = fortyTwo
int zeroValue = await task.spawn(zeroJob)
assert zeroValue == 42, "task.spawn should run zero-argument func value"

func(int, int) as int addJob = add
int addValue = await task.spawn(addJob, 20, 22)
assert addValue == 42, "task.spawn should run typed func value"

future<int> repeatedSpawn = task.spawn(addJob, 21, 21)
int repeatedA = await repeatedSpawn
int repeatedB = await repeatedSpawn
assert repeatedA == 42, "task.spawn named future first await should work"
assert repeatedB == 42, "task.spawn named future repeated await should work"
assert not task.cancel(repeatedSpawn), "completed task.spawn future should not be canceled"
int postCancelRepeatedSpawn = await repeatedSpawn
assert postCancelRepeatedSpawn == 42, "completed task.spawn future should remain awaitable after cancel"
bool cancelTemporarySpawn = task.cancel(task.spawn(addJob, 1, 2))
assert cancelTemporarySpawn == true or cancelTemporarySpawn == false, "task.cancel should release temporary task.spawn future"

func(int, int) as int slowAddJob = slowAdd
future<int> pendingSpawn = task.spawn(slowAddJob, 40, 2)
assert task.cancel(pendingSpawn), "pending task.spawn future should accept cancel"

int pendingSpawnCancelStateA = 0
try
    int pendingSpawnValueA = await pendingSpawn
    pendingSpawnCancelStateA = pendingSpawnValueA
catch e
    if e.message == "future cancel requested." then
        pendingSpawnCancelStateA = 42
    end
end
assert pendingSpawnCancelStateA == 42, "pending task.spawn future should await as canceled"

time.sleep(320)

int pendingSpawnCancelStateB = 0
try
    int pendingSpawnValueB = await pendingSpawn
    pendingSpawnCancelStateB = pendingSpawnValueB
catch e
    if e.message == "future cancel requested." then
        pendingSpawnCancelStateB = 42
    end
end
assert pendingSpawnCancelStateB == 42, "pending task.spawn worker completion should not overwrite cancel"

future<int> pendingSpawnAllLeft = task.spawn(slowAddJob, 50, 1)
future<int> pendingSpawnAllRight = task.spawn(slowAddJob, 60, 2)
future<array<int>> pendingSpawnAllGroup = task.all([pendingSpawnAllLeft, pendingSpawnAllRight])
assert task.cancel(pendingSpawnAllGroup), "pending task.all over task.spawn should accept cancel"

int pendingSpawnAllGroupState = 0
try
    array<int> pendingSpawnAllValues = await pendingSpawnAllGroup
    pendingSpawnAllGroupState = pendingSpawnAllValues.length
catch e
    if e.message == "future cancel requested." then
        pendingSpawnAllGroupState = 42
    end
end
assert pendingSpawnAllGroupState == 42, "pending task.all over task.spawn should await as canceled"

int pendingSpawnAllLeftStateA = 0
try
    int pendingSpawnAllLeftValueA = await pendingSpawnAllLeft
    pendingSpawnAllLeftStateA = pendingSpawnAllLeftValueA
catch e
    if e.message == "future cancel requested." then
        pendingSpawnAllLeftStateA = 42
    end
end
assert pendingSpawnAllLeftStateA == 42, "pending task.all should cancel task.spawn left source"

int pendingSpawnAllRightStateA = 0
try
    int pendingSpawnAllRightValueA = await pendingSpawnAllRight
    pendingSpawnAllRightStateA = pendingSpawnAllRightValueA
catch e
    if e.message == "future cancel requested." then
        pendingSpawnAllRightStateA = 42
    end
end
assert pendingSpawnAllRightStateA == 42, "pending task.all should cancel task.spawn right source"

future<int> pendingSpawnRaceLeft = task.spawn(slowAddJob, 70, 3)
future<int> pendingSpawnRaceRight = task.spawn(slowAddJob, 80, 4)
future<int> pendingSpawnRaceGroup = task.race([pendingSpawnRaceLeft, pendingSpawnRaceRight])
assert task.cancel(pendingSpawnRaceGroup), "pending task.race over task.spawn should accept cancel"

int pendingSpawnRaceGroupState = 0
try
    int pendingSpawnRaceValue = await pendingSpawnRaceGroup
    pendingSpawnRaceGroupState = pendingSpawnRaceValue
catch e
    if e.message == "future cancel requested." then
        pendingSpawnRaceGroupState = 42
    end
end
assert pendingSpawnRaceGroupState == 42, "pending task.race over task.spawn should await as canceled"

int pendingSpawnRaceLeftStateA = 0
try
    int pendingSpawnRaceLeftValueA = await pendingSpawnRaceLeft
    pendingSpawnRaceLeftStateA = pendingSpawnRaceLeftValueA
catch e
    if e.message == "future cancel requested." then
        pendingSpawnRaceLeftStateA = 42
    end
end
assert pendingSpawnRaceLeftStateA == 42, "pending task.race should cancel task.spawn left source"

int pendingSpawnRaceRightStateA = 0
try
    int pendingSpawnRaceRightValueA = await pendingSpawnRaceRight
    pendingSpawnRaceRightStateA = pendingSpawnRaceRightValueA
catch e
    if e.message == "future cancel requested." then
        pendingSpawnRaceRightStateA = 42
    end
end
assert pendingSpawnRaceRightStateA == 42, "pending task.race should cancel task.spawn right source"

time.sleep(320)

int pendingSpawnAllLeftStateB = 0
try
    int pendingSpawnAllLeftValueB = await pendingSpawnAllLeft
    pendingSpawnAllLeftStateB = pendingSpawnAllLeftValueB
catch e
    if e.message == "future cancel requested." then
        pendingSpawnAllLeftStateB = 42
    end
end
assert pendingSpawnAllLeftStateB == 42, "task.all task.spawn source should remain canceled after worker completes"

int pendingSpawnRaceLeftStateB = 0
try
    int pendingSpawnRaceLeftValueB = await pendingSpawnRaceLeft
    pendingSpawnRaceLeftStateB = pendingSpawnRaceLeftValueB
catch e
    if e.message == "future cancel requested." then
        pendingSpawnRaceLeftStateB = 42
    end
end
assert pendingSpawnRaceLeftStateB == 42, "task.race task.spawn source should remain canceled after worker completes"

func(int) as int defaultJob = addDefault
int defaultValue = await task.spawn(defaultJob, 41)
assert defaultValue == 42, "task.spawn should honor optional defaults"

func(int) as int missingJob
int missingJobState = 0
try
    int missingJobValue = await task.spawn(missingJob, 1)
    missingJobState = missingJobValue
catch e
    if e.message == "task.spawn requires a callable func value" then
        missingJobState = 42
    end
end
assert missingJobState == 42, "task.spawn should reject empty func value"

func(string) as string missingStringJob
int missingStringJobState = 0
try
    string missingStringJobValue = await task.spawn(missingStringJob, "x")
    missingStringJobState = 9
catch e
    if e.message == "task.spawn requires a callable func value" then
        missingStringJobState = 42
    end
end
assert missingStringJobState == 42, "task.spawn should reject empty string func value"

func(bool) as bool missingBoolJob
int missingBoolJobState = 0
try
    bool missingBoolJobValue = await task.spawn(missingBoolJob, true)
    missingBoolJobState = int(missingBoolJobValue)
catch e
    if e.message == "task.spawn requires a callable func value" then
        missingBoolJobState = 42
    end
end
assert missingBoolJobState == 42, "task.spawn should reject empty bool func value"

func(float) as float missingFloatJob
int missingFloatJobState = 0
try
    float missingFloatJobValue = await task.spawn(missingFloatJob, 1.5)
    missingFloatJobState = int(missingFloatJobValue)
catch e
    if e.message == "task.spawn requires a callable func value" then
        missingFloatJobState = 42
    end
end
assert missingFloatJobState == 42, "task.spawn should reject empty float func value"

bool cancelTemporarySpawnAll = task.cancel(task.all([task.spawn(addJob, 3, 4), task.spawn(defaultJob, 5)]))
assert cancelTemporarySpawnAll == true or cancelTemporarySpawnAll == false, "task.cancel should release temporary task.all over task.spawn futures"

bool cancelTemporarySpawnRace = task.cancel(task.race([task.spawn(addJob, 6, 7), task.spawn(defaultJob, 8)]))
assert cancelTemporarySpawnRace == true or cancelTemporarySpawnRace == false, "task.cancel should release temporary task.race over task.spawn futures"

func(int) as int capturedJob = makeAdder(30)
int capturedValue = await task.spawn(capturedJob, 12)
assert capturedValue == 42, "task.spawn should retain closure func value"

func(string) as string greetJob = greet
string greetValue = await task.spawn(greetJob, "xlang")
assert greetValue == "hello xlang", "task.spawn should transfer string result"

future<string> namedGreetFuture = task.spawn(greetJob, "future")
string namedGreetA = await namedGreetFuture
string namedGreetB = await namedGreetFuture
assert namedGreetA == "hello future", "task.spawn string future first await should copy result"
assert namedGreetB == "hello future", "task.spawn string future repeated await should copy result"
assert not task.cancel(namedGreetFuture), "completed string task.spawn future should not be canceled"
string postCancelNamedGreet = await namedGreetFuture
assert postCancelNamedGreet == "hello future", "completed string task.spawn future should remain awaitable after cancel"

func(string) as string slowGreetJob = slowGreet
future<string> pendingStringSpawn = task.spawn(slowGreetJob, "pending")
assert task.cancel(pendingStringSpawn), "pending string task.spawn future should accept cancel"

int pendingStringSpawnStateA = 0
try
    string pendingStringSpawnValueA = await pendingStringSpawn
    pendingStringSpawnStateA = 9
catch e
    if e.message == "future cancel requested." then
        pendingStringSpawnStateA = 42
    end
end
assert pendingStringSpawnStateA == 42, "pending string task.spawn future should await as canceled"

time.sleep(320)

int pendingStringSpawnStateB = 0
try
    string pendingStringSpawnValueB = await pendingStringSpawn
    pendingStringSpawnStateB = 9
catch e
    if e.message == "future cancel requested." then
        pendingStringSpawnStateB = 42
    end
end
assert pendingStringSpawnStateB == 42, "pending string task.spawn worker completion should not overwrite cancel"

func(bool) as bool flipJob = flip
bool flippedValue = await task.spawn(flipJob, true)
assert flippedValue == false, "task.spawn should bridge bool arguments and results"
future<bool> namedFlipFuture = task.spawn(flipJob, false)
bool namedFlipA = await namedFlipFuture
bool namedFlipB = await namedFlipFuture
assert namedFlipA == true, "task.spawn bool future first await should copy result"
assert namedFlipB == true, "task.spawn bool future repeated await should copy result"
assert not task.cancel(namedFlipFuture), "completed bool task.spawn future should not be canceled"
bool postCancelNamedFlip = await namedFlipFuture
assert postCancelNamedFlip == true, "completed bool task.spawn future should remain awaitable after cancel"

