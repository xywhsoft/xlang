future<int> successClosureRaceLoser = task.spawn(successClosureRaceLoserSource, 220)
future<int> successClosureRaceGroup = task.race([
    task.spawn(addJob, 650, 1),
    successClosureRaceLoser
])
int successClosureRaceValue = await successClosureRaceGroup
assert successClosureRaceValue == 651, "pending closure task.race should return fast winner"
int successClosureRaceValueAgain = await successClosureRaceGroup
assert successClosureRaceValueAgain == 651, "successful task.race closure group should support repeated await"
assert not task.cancel(successClosureRaceGroup), "completed task.race closure group should not be canceled"
int successClosureRaceValueAfterCancel = await successClosureRaceGroup
assert successClosureRaceValueAfterCancel == 651, "successful task.race closure group should remain awaitable after cancel"

int successClosureRaceLoserStateA = 0
try
    int successClosureRaceLoserValueA = await successClosureRaceLoser
    successClosureRaceLoserStateA = successClosureRaceLoserValueA
catch e
    if e.message == "future cancel requested." then
        successClosureRaceLoserStateA = 42
    end
end
assert successClosureRaceLoserStateA == 42, "successful task.race should cancel pending closure loser"

time.sleep(260)

int successClosureRaceLoserStateB = 0
try
    int successClosureRaceLoserValueB = await successClosureRaceLoser
    successClosureRaceLoserStateB = successClosureRaceLoserValueB
catch e
    if e.message == "future cancel requested." then
        successClosureRaceLoserStateB = 42
    end
end
assert successClosureRaceLoserStateB == 42, "successful task.race closure loser should stay canceled after worker completes"
assert successClosureRaceLoserSource(0) == 650, "successful task.race closure loser source should remain callable"

