int pendingBoolSpawnStateA = 0
try
    bool pendingBoolSpawnValueA = await pendingBoolSpawn
    pendingBoolSpawnStateA = 9
catch e
    if e.message == "future cancel requested." then
        pendingBoolSpawnStateA = 42
    end
end
