func nums(int count) as generator<int>
    int i = 0
    while i < count
        i = i + 1
        yield i
    end
end

func toggles() as generator<bool>
    yield true
    yield false
end

func weights() as generator<float>
    yield 1.5
    yield 2.5
end

func clocks() as generator<time>
    yield #12:34:56#
end

func broken() as generator<int>
    yield 1
    throw "generator boom"
    yield 2
end

func brokenEarly() as generator<int>
    throw "generator boom before yield"
    yield 1
end

func emptyNums() as generator<int>
    int marker = 1
    if marker == 0 then
        yield marker
    end
end

func returnEarlyNums() as generator<int>
    yield 5
    return
    yield 50
end

func returnBeforeYieldNums() as generator<int>
    return
    yield 60
end

int total = 0
for value in nums(3)
    total = total + value
end

assert total == 6, "generator total failed"

int filtered = 0
for value in nums(5)
    if value == 2 then
        continue
    end
    if value == 5 then
        break
    end
    filtered = filtered + value
end

assert filtered == 8, "generator break/continue failed"

generator<int> savedBreakGen = nums(3)
int savedBreakTotal = 0
for index, item in savedBreakGen
    if index == 0 then
        continue
    end
    savedBreakTotal = savedBreakTotal + index * 100 + item
    break
end

assert savedBreakTotal == 102, "saved generator break/continue failed"

int savedBreakAgainState = 0
try
    for item in savedBreakGen
        savedBreakAgainState = savedBreakAgainState + item
    end
    savedBreakAgainState = 100
catch e
    if e.message == "iterate null generator" then
        savedBreakAgainState = 42
    end
end

assert savedBreakAgainState == 42, "saved generator break should close generator"

auto autoGen = nums(2)
int autoTotal = 0
for item in autoGen
    autoTotal = autoTotal + item
end

assert autoTotal == 3, "auto generator failed"

generator<int> explicitGen = nums(1)
int last = 0
for item in explicitGen
    last = item
end

assert last == 1, "explicit generator failed"

generator<int> consumedGen = nums(1)
int consumedFirstTotal = 0
for item in consumedGen
    consumedFirstTotal = consumedFirstTotal + item
end

assert consumedFirstTotal == 1, "consumed generator first pass failed"

int consumedAgainState = 0
try
    for item in consumedGen
        consumedAgainState = consumedAgainState + item
    end
    consumedAgainState = 100
catch e
    if e.message == "iterate null generator" then
        consumedAgainState = 42
    end
end

assert consumedAgainState == 42, "consumed generator should reject second pass"

generator<int> missingGen
int missingGenState = 0
try
    for item in missingGen
        missingGenState = missingGenState + item
    end
    missingGenState = 100
catch e
    if e.message == "iterate null generator" then
        missingGenState = 42
    end
end

assert missingGenState == 42, "null generator should reject iteration"

int trueCount = 0
for flag in toggles()
    if flag then
        trueCount = trueCount + 1
    end
end

assert trueCount == 1, "bool generator failed"

float weightTotal = 0.0
for weight in weights()
    weightTotal = weightTotal + weight
end

assert weightTotal == 4.0, "float generator failed"

time clockValue = #00:00:00#
for clock in clocks()
    clockValue = clock
end

assert clockValue == #12:34:56#, "time generator failed"

int errorState = 0
try
    for value in broken()
        errorState = errorState + value
    end
    errorState = 100
catch e
    if e.message == "generator boom" then
        errorState = errorState + 10
    end
end

assert errorState == 11, "generator error propagation failed"

int earlyErrorState = 0
try
    for value in brokenEarly()
        earlyErrorState = earlyErrorState + value
    end
    earlyErrorState = 100
catch e
    if e.message == "generator boom before yield" then
        earlyErrorState = 42
    end
end

assert earlyErrorState == 42, "generator early error propagation failed"

int emptyCount = 0
for value in emptyNums()
    emptyCount = emptyCount + 1
end

assert emptyCount == 0, "empty generator should not yield values"

generator<int> savedReturnEarlyNums = returnEarlyNums()
int savedReturnEarlyCount = 0
int savedReturnEarlyTotal = 0
for value in savedReturnEarlyNums
    savedReturnEarlyCount = savedReturnEarlyCount + 1
    savedReturnEarlyTotal = savedReturnEarlyTotal + value
end

assert savedReturnEarlyCount == 1, "saved generator return count failed"
assert savedReturnEarlyTotal == 5, "saved generator return total failed"

int savedReturnEarlyAgainState = 0
try
    for value in savedReturnEarlyNums
        savedReturnEarlyAgainState = savedReturnEarlyAgainState + value
    end
    savedReturnEarlyAgainState = 100
catch e
    if e.message == "iterate null generator" then
        savedReturnEarlyAgainState = 42
    end
end

assert savedReturnEarlyAgainState == 42, "saved generator return second pass failed"

generator<int> savedReturnBeforeYieldNums = returnBeforeYieldNums()
int savedReturnBeforeYieldCount = 0
int savedReturnBeforeYieldTotal = 0
for value in savedReturnBeforeYieldNums
    savedReturnBeforeYieldCount = savedReturnBeforeYieldCount + 1
    savedReturnBeforeYieldTotal = savedReturnBeforeYieldTotal + value
end

assert savedReturnBeforeYieldCount == 0, "saved generator pre-yield return count failed"
assert savedReturnBeforeYieldTotal == 0, "saved generator pre-yield return total failed"

int savedReturnBeforeYieldAgainState = 0
try
    for value in savedReturnBeforeYieldNums
        savedReturnBeforeYieldAgainState = savedReturnBeforeYieldAgainState + value
    end
    savedReturnBeforeYieldAgainState = 100
catch e
    if e.message == "iterate null generator" then
        savedReturnBeforeYieldAgainState = 42
    end
end

assert savedReturnBeforeYieldAgainState == 42, "saved generator pre-yield return second pass failed"

int returnEarlyCount = 0
int returnEarlyTotal = 0
for value in returnEarlyNums()
    returnEarlyCount = returnEarlyCount + 1
    returnEarlyTotal = returnEarlyTotal + value
end

assert returnEarlyCount == 1, "generator return count failed"
assert returnEarlyTotal == 5, "generator return total failed"

int returnBeforeYieldCount = 0
int returnBeforeYieldTotal = 0
for value in returnBeforeYieldNums()
    returnBeforeYieldCount = returnBeforeYieldCount + 1
    returnBeforeYieldTotal = returnBeforeYieldTotal + value
end

assert returnBeforeYieldCount == 0, "generator pre-yield return count failed"
assert returnBeforeYieldTotal == 0, "generator pre-yield return total failed"
