func exerciseCapturedChannel() as int
    channel<string> messages = channel::<string>(1)

    auto producer = func() as int
        if not messages.send("captured") then
            return 11
        end
        messages.close()
        return 23
    end

    thread worker = thread(producer)
    string text = "old"
    if not messages.recvTimeoutInto(text, 2000) then
        return 1
    end
    if text != "captured" then
        return 2
    end
    if not worker.waitTimeout(2000) then
        return 3
    end
    if worker.exitCode() != 23 then
        return 4
    end
    if not messages.isClosed() then
        return 5
    end
    if messages.count() != 0 then
        return 6
    end
    if messages.tryRecvInto(text) then
        return 7
    end
    return 0
end

assert exerciseCapturedChannel() == 0, "captured channel runtime ABI failed"

channel<int> numbers = channel::<int>()
assert numbers.send(41), "integer channel send failed"
int number = 0
assert numbers.recvInto(number), "integer channel receive failed"
assert number == 41, "integer channel payload mismatch"
assert numbers.trySend(42), "integer channel trySend failed"
assert numbers.tryRecvInto(number), "integer channel tryRecv failed"
assert number == 42, "integer channel try payload mismatch"
assert numbers.count() == 0, "integer channel count failed"
numbers.close()
assert numbers.isClosed(), "integer channel close failed"

channel<var> dynamicValues = channel::<var>(2)
assert dynamicValues.send(123), "dynamic integer send failed"
assert dynamicValues.send("text"), "dynamic string send failed"
var dynamicValue = null
assert dynamicValues.recvInto(dynamicValue), "dynamic integer receive failed"
assert int(dynamicValue) == 123, "dynamic integer payload mismatch"
assert dynamicValues.recvInto(dynamicValue), "dynamic string receive failed"
assert string(dynamicValue) == "text", "dynamic string payload mismatch"
assert not dynamicValues.tryRecvInto(dynamicValue), "dynamic channel should be empty"
dynamicValues.close()
assert dynamicValues.isClosed(), "dynamic channel close failed"

println("xlir channel resource abi ok")
