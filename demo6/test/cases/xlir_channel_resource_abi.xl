func exerciseCapturedChannel() as int
    channel<string> messages = channel::<string>(1)

    auto producer = func() as int
        if not messages.send("captured") then
            return 11
        end
        messages.close()
        return 23
    end

    thread worker = thread(producer)
    auto status, text = messages.recvTimeout(2000)
    if status != channelStatus.ok then
        return 1
    end
    if text == null then
        return 2
    end
    if text != "captured" then
        return 2
    end
    if not worker.waitTimeout(2000) then
        return 3
    end
    if worker.exitCode() != 23 then
        return 4
    end
    if not messages.isClosed() then
        return 5
    end
    if messages.count() != 0 then
        return 6
    end
    auto closedStatus, closedValue = messages.tryRecv()
    if closedStatus != channelStatus.closed or closedValue != null then
        return 7
    end
    return 0
end

assert exerciseCapturedChannel() == 0, "captured channel runtime ABI failed"

channel<int> numbers = channel::<int>()
assert numbers.send(41), "integer channel send failed"
auto numberStatus, number = numbers.recv()
assert numberStatus == channelStatus.ok, "integer channel receive failed"
assert number != null and number == 41, "integer channel payload mismatch"
assert numbers.trySend(42), "integer channel trySend failed"
auto nextStatus, nextNumber = numbers.tryRecv()
assert nextStatus == channelStatus.ok, "integer channel tryRecv failed"
assert nextNumber != null and nextNumber == 42, "integer channel try payload mismatch"
assert numbers.count() == 0, "integer channel count failed"
numbers.close()
assert numbers.isClosed(), "integer channel close failed"

channel<var> dynamicValues = channel::<var>(2)
assert dynamicValues.send(123), "dynamic integer send failed"
assert dynamicValues.send("text"), "dynamic string send failed"
auto dynamicStatus, dynamicValue = dynamicValues.recv()
assert dynamicStatus == channelStatus.ok, "dynamic integer receive failed"
assert int(dynamicValue) == 123, "dynamic integer payload mismatch"
auto textStatus, textValue = dynamicValues.recv()
assert textStatus == channelStatus.ok, "dynamic string receive failed"
assert string(textValue) == "text", "dynamic string payload mismatch"
auto emptyStatus, emptyValue = dynamicValues.tryRecv()
assert emptyStatus == channelStatus.empty and emptyValue == null, "dynamic channel should be empty"
dynamicValues.close()
assert dynamicValues.isClosed(), "dynamic channel close failed"

println("xlir channel resource abi ok")
