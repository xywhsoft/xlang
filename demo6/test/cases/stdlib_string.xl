extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

expect(string.len("hello"), 5)
expect(string.len("1234你好"), 6)
expect(string.byteLen("1234你好"), 10)

expect(string.compare("abc", "abc"), 0)
expect(string.compare("abc", "abd") < 0, 1)
expect(string.compare("abc", "ABC") != 0, 1)
expect(string.compare("abc", "ABC", true), 0)

expect(string.equals("abc", "abc"), 1)
expect(string.equals("abc", "ABC"), 0)
expect(string.equals("abc", "ABC", true), 1)

expect(string.contains("alphabet", "pha"), 1)
expect(string.contains("alphabet", "PHA"), 0)
expect(string.contains("alphabet", "PHA", true), 1)
expect(string.indexOf("alphabet", "pha"), 2)
expect(string.indexOf("alphabet", "missing"), -1)
expect(string.indexOf("ab你好cd你好", "你好"), 2)
expect(string.lastIndexOf("ab你好cd你好", "你好"), 6)
expect(string.count("ab你好cd你好", "你好"), 2)
expect(string.count("aaaa", "aa"), 2)

expect(string.startsWith("alphabet", "alpha"), 1)
expect(string.startsWith("alphabet", "Alpha"), 0)
expect(string.startsWith("alphabet", "Alpha", true), 1)
expect(string.startsWith("alphabet", ""), 1)
expect(string.startsWith("alphabet", "alphabetical"), 0)
expect(string.endsWith("alphabet", "bet"), 1)
expect(string.endsWith("alphabet", "BET"), 0)
expect(string.endsWith("alphabet", "BET", true), 1)
expect(string.endsWith("alphabet", ""), 1)
expect(string.endsWith("alphabet", "the alphabet"), 0)
expect(string.startsWith("中文 UTF-8", "中文"), 1)
expect(string.endsWith("中文 UTF-8", "UTF-8"), 1)

expect(string.hasAny("alphabet", "xz"), 0)
expect(string.hasAny("alphabet", "xzha"), 1)
expect(string.hasAny("中文 UTF-8", "文"), 1)
expect(string.hasAny("中文 UTF-8", "日"), 0)

expect(string.like("readme.md", "*.md"), 1)
expect(string.like("readme.md", "*.TXT"), 0)
expect(string.like("readme.md", "*.MD", true), 1)

expect(string.approx("xlang", "xlang"), 1)
expect(int(string.sim("xlang", "xlang") * 100.0), 100)
expect(string.sim("abc", "xyz") < 1.0, 1)
expectStr(string.formatInt(1234567, ","), "1,234,567")
expectStr(string.formatInt(42, "04"), "0042")
expectStr(string.formatInt(255, "X"), "FF")
expectStr(string.formatFloat(12.345, ".2"), "12.35")
expectStr(string.formatFloat(0.125, ".1%"), "12.5%")
expect(string.isUtf8("中文 UTF-8"), 1)

expectStr(string.lower("AbC"), "abc")
expectStr(string.upper("AbC"), "ABC")
expectStr(string.trim("  hello  "), "hello")
expectStr(string.trim("--hello--", "-"), "hello")
expectStr(string.ltrim("  hello  "), "hello  ")
expectStr(string.rtrim("  hello  "), "  hello")
expectStr(string.ltrim("--hello--", "-"), "hello--")
expectStr(string.rtrim("--hello--", "-"), "--hello")
expectStr(string.filter("a-b-c", "-"), "abc")
expectStr(string.replace("a-b-c", "-", "/"), "a/b/c")

expectStr(string.slice("ab你好cd", 2, 2), "你好")
expectStr(string.slice("ab你好cd", -2), "cd")
expectStr(string.left("ab你好", 3), "ab你")
expectStr(string.right("ab你好", 2), "你好")
expectStr(string.mid("ab你好cd", 2, 2), "你好")
expectStr(string.charAt("A你B", 1), "你")
expect(string.byteAt("A你", 0), 65)
expect(string.byteAt("A你", 1), 228)
expect(string.byteAt("A你", -1), 160)
expectStr(string.repeat("ha", 3), "hahaha")
expect(string.isEmpty(""), 1)
expect(string.isEmpty(" "), 0)
expect(string.isBlank(" \t"), 1)
expect(string.isBlank(" x "), 0)
expectStr(string.remove("a-b-c", "-"), "abc")
expectStr(string.remove("AbA", "a", true), "b")
expectStr(string.removeAt("ab你好cd", 2, 2), "abcd")
expectStr(string.insert("abcd", 2, "你好"), "ab你好cd")
expectStr(string.padLeft("x", 3, "."), "..x")
expectStr(string.padRight("x", 3, "."), "x..")
expectStr(string.padCenter("x", 5, "."), "..x..")
expectStr(string.reverse("ab你好"), "好你ba")

array parts = string.split("a,b,c", ",")
expect(parts.length, 3)
expectStr(string(parts[0]), "a")
expectStr(string(parts[1]), "b")
expectStr(string(parts[2]), "c")

array unsplit = string.split("abc", ",")
expect(unsplit.length, 1)
expectStr(string(unsplit[0]), "abc")

array emptyParts = string.split("", ",")
expect(emptyParts.length, 1)
expectStr(string(emptyParts[0]), "")

array lines = string.splitLines("a\nb\nc")
expect(lines.length, 3)
expectStr(string(lines[0]), "a")
expectStr(string(lines[1]), "b")
expectStr(string(lines[2]), "c")

array chars = string.chars("A你")
expect(chars.length, 2)
expectStr(string(chars[0]), "A")
expectStr(string(chars[1]), "你")

array bytes = string.bytes("A你")
expect(bytes.length, 4)
expect(int(bytes[0]), 65)
expect(int(bytes[1]), 228)
expect(int(bytes[2]), 189)
expect(int(bytes[3]), 160)

array words = ["red", "green", "blue"]
expectStr(string.join(words, "|"), "red|green|blue")

string joinedChars = ""
for c in "A你B"
    joinedChars = joinedChars + c
end
expectStr(joinedChars, "A你B")

int indexSum = 0
string indexedChars = ""
for i, c in "A你B"
    indexSum = indexSum + i
    indexedChars = indexedChars + c
end
expect(indexSum, 3)
expectStr(indexedChars, "A你B")
