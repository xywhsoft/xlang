// RFC 8439 section 2.4.2, fixed public material, normal operation only.
auto key = codec.hexDecode("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
auto nonce = codec.hexDecode("000000000000004a00000000")
string plain = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."
string expected = "6e2e359a2568f98041ba0728dd0d6981e97e7aec1d4360c20a27afccfd9fae0bf91b65c5524733ab8f593dabcd62b3571639d624e65152ab8f530c359f0861d807ca0dbf500d6a6156a38e088a22b65e52bc514d16ccf806818ce91ab77937365af90bbf74a35be6b40b8eedf2785e42874d"
bytes cipher = cryptoAdvanced.chacha20(key, nonce, plain)
assert codec.hexEncode(cipher) == expected, "RFC cipher"
assert cryptoAdvanced.chacha20(key, nonce, cipher) == encoding.encodeUtf8(plain), "bytes roundtrip"
assert cryptoAdvanced.chacha20(key, nonce, encoding.encodeUtf8(plain)) == cipher, "text and bytes equivalence"

auto buffer = Buffer()
assert buffer.append(plain), "buffer append"
assert cryptoAdvanced.chacha20Buffer(key, nonce, buffer) == cipher, "Buffer equivalence"
assert cryptoAdvanced.chacha20(key, nonce, plain, 1, 3) == codec.hexDecode("6e2e35"), "text prefix"
assert cryptoAdvanced.chacha20(key, nonce, plain, 1, 9999) == cipher, "text clamp"
assert cryptoAdvanced.chacha20Buffer(key, nonce, buffer, 1, 3) == codec.hexDecode("6e2e35"), "Buffer prefix"
assert cryptoAdvanced.chacha20Buffer(key, nonce, buffer, 1, 9999) == cipher, "Buffer clamp"

// Exact binary length, empty input, and both valid counter endpoints.
bytes binary = b"a\0b"
assert cryptoAdvanced.chacha20(key, nonce, "a\0b") == cryptoAdvanced.chacha20(key, nonce, binary)
assert cryptoAdvanced.chacha20(key, nonce, cryptoAdvanced.chacha20(key, nonce, binary)) == binary
assert cryptoAdvanced.chacha20(key, nonce, b"") == b""
assert cryptoAdvanced.chacha20(key, nonce, plain, 1, 0) == b""
assert cryptoAdvanced.chacha20(key, nonce, cryptoAdvanced.chacha20(key, nonce, binary, 0), 0) == binary
assert cryptoAdvanced.chacha20(key, nonce, cryptoAdvanced.chacha20(key, nonce, binary, 4294967295), 4294967295) == binary

// Ordinary argument errors, not malformed cryptographic/protocol campaigns.
int errors = 0
try
    cryptoAdvanced.chacha20(key, nonce, binary, -1)
catch e
    errors += 1
end
try
    cryptoAdvanced.chacha20(key, nonce, binary, 4294967296)
catch e
    errors += 1
end
try
    cryptoAdvanced.chacha20(key, nonce, binary, 1, -2)
catch e
    errors += 1
end
try
    cryptoAdvanced.chacha20(b"short", nonce, binary)
catch e
    errors += 1
end
assert errors == 4, "argument rejection count"
