class GenericDynamic<T>
    T value

    create(T initial)
        self.value = initial
    end

    func get() as T
        return self.value
    end

    func replace(T next) as T
        T previous = self.value
        self.value = next
        return previous
    end
end

var dynamicBox = GenericDynamic::<int>(41)

func main(...) as int
    assert int(dynamicBox.get()) == 41
    assert int(dynamicBox.replace(42)) == 41
    assert int(dynamicBox.get()) == 42
    println("generic dynamic method ok")
    return 0
end
