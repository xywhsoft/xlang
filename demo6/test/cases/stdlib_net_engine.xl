auto options = NetEngineOptions().withWorkers(1).withBackend(NetBackend.select)
auto engine = NetEngine(options)
assert(engine.state == NetEngineState.stopped)
assert(engine.workerCount == 1)
assert(engine.configuration().workers == 1)
engine.start()
assert(engine.state == NetEngineState.running)
assert(engine.backend() == NetBackend.select)
assert(engine.capabilities() != 0)
engine.post(func()
    assert(4 + 5 == 9)
end)
engine.stop()
assert(engine.state == NetEngineState.stopped)
assert(engine.snapshot().postsExecuted == 1)
assert(engine.failureCount == 0)
engine.start()
engine.close()
assert(engine.wait(5000))
assert(engine.state == NetEngineState.stopped)
auto snapshot = net.stats(engine)
assert(snapshot.postsExecuted == 1)
assert(snapshot.workers == 1)
println("managed engine: ok")
