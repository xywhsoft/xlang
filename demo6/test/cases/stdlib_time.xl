extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

time dateValue = time.fromDate(2026, 6, 18)
time clockValue = time.fromTime(12, 30, 59)
time dateTime = time.fromDateTime(2026, 6, 18, 12, 30, 59)
time defaultTime = time.fromDateTime(2026, 6, 18)
time currentDateTime = time.now()
time currentDate = time.today()
time currentClock = time.clock()
time parsed = time.parse("2026-06-18 12:30:59")
time parsedPattern = time.parsePattern("2026/06/18 12:30:59", "yyyy/mm/dd hh:mm:ss")
string formattedPattern = time.formatPattern(dateTime, "yyyy/mm/dd hh:mm:ss")

expect(dateValue == #2026-06-18#, 1)
expect(clockValue == #12:30:59#, 1)
expect(dateTime == #2026-06-18 12:30:59#, 1)
expect(defaultTime == #2026-06-18#, 1)
expect(time.year(currentDateTime) >= 1970, 1)
expect(time.year(currentDate) >= 1970, 1)
expect(time.hour(currentClock) >= 0, 1)
expect(time.hour(currentClock) <= 23, 1)
expect(parsed == dateTime, 1)
expect(parsedPattern == dateTime, 1)
expectStr(formattedPattern, "2026/06/18 12:30:59")

expect(time.year(dateTime), 2026)
expect(time.month(dateTime), 6)
expect(time.day(dateTime), 18)
expect(time.hour(dateTime), 12)
expect(time.minute(dateTime), 30)
expect(time.second(dateTime), 59)
expect(time.weekday(dateTime) >= 0, 1)
expect(time.dayOfYear(dateTime), 169)
expect(time.quarter(dateTime), 2)

expect(time.datePart(dateTime) == #2026-06-18#, 1)
expect(time.timePart(dateTime) == #12:30:59#, 1)

time nextDay = time.addDays(dateTime, 1)
time nextMonth = time.addMonths(dateTime, 1)
time nextYear = time.addYears(dateTime, 1)
time nextHour = time.addHours(dateTime, 1)
time nextMinute = time.addMinutes(dateTime, 1)
time nextSecond = time.addSeconds(dateTime, 1)

expect(time.day(nextDay), 19)
expect(time.month(nextMonth), 7)
expect(time.year(nextYear), 2027)
expect(time.hour(nextHour), 13)
expect(time.minute(nextMinute), 31)
expect(time.second(nextSecond), 0)

expect(time.isSameDay(dateTime, nextHour), 1)
expect(time.isSameMonth(dateTime, nextDay), 1)
expect(time.isSameYear(dateTime, nextMonth), 1)
expect(time.inRange(dateTime, #2026-06-18#, #2026-06-19#), 1)
expect(time.diffDays(dateTime, nextDay), 1)
