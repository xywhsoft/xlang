// Seventeen typed segments cross the old sixteen-entry stack fast path.
auto engine = NetEngine(NetEngineOptions().withWorkers(1).withBackend(NetBackend.select))
engine.start()
auto receiver = udp.bind(engine, NetAddress.loopback())
assert receiver.wait(UdpWait.open, 5000) == NetStatus.ok
auto sender = udp.connect(engine, receiver.localAddress())
assert sender.wait(UdpWait.open, 5000) == NetStatus.ok
auto item = Buffer(b"x")
array<Buffer> many = [item,item,item,item,item,item,item,item,item,item,item,item,item,item,item,item,item]
auto receiving = receiver.recvAsync()
assert sender.sendVector(many) == NetStatus.ok
auto received = await receiving
assert received.bytes() == b"xxxxxxxxxxxxxxxxx" and not received.truncated and item.length == 1
auto message = UdpMessage(item)
array<UdpMessage> messages = [message,message,message,message,message,message,message,message,message,message,message,message,message,message,message,message,message]
auto progress = NetBatchProgress()
auto status, count = sender.sendBatch(messages, progress)
assert status == NetStatus.ok and count == 17 and progress.completedCount == 17
for index in range(17)
    assert receiver.recv(5000).bytes() == b"x"
end
assert item.length == 1
sender.close()
receiver.close()
engine.close()
assert engine.wait(5000)
println("xlir datagram boundaries ok")
