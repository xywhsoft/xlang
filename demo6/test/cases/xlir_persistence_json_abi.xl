class PersistenceAddress
    derive value

    string city = ""
end

class PersistenceBase
    derive value

    int id = 0
end

class PersistenceProfile extends PersistenceBase
    derive value

    string displayName @json("display_name") = ""
    private string secret @persist(name="secret_name", include) = ""
    string password @persist(skip) = ""
    string note @json(omit=empty) = ""
    PersistenceAddress address = PersistenceAddress()

    func setSecret(string value)
        self.secret = value
    end

    func secretValue() as string
        return self.secret
    end
end

extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectText(string actual, string expected)

PersistenceProfile profile = PersistenceProfile()
profile.id = 42
profile.displayName = "Alice"
profile.setSecret("open")
profile.password = "hidden"
profile.note = ""
profile.address.city = "Shanghai"

string compact = json.stringify(profile)
string pretty = json.stringify(profile, true)
string scalarJson = json.stringify("quoted")
string integerJson = json.stringify(42)
string scalarXlon = xlon.stringify("plain")

expect(string.contains(compact, "\"id\":42"), 1)
expect(string.contains(compact, "\"display_name\":\"Alice\""), 1)
expect(string.contains(compact, "\"secret_name\":\"open\""), 1)
expect(string.contains(compact, "\"password\""), 0)
expect(string.contains(compact, "\"note\""), 0)
expect(string.contains(compact, "\"address\""), 1)
expect(string.contains(compact, "\"city\":\"Shanghai\""), 1)
expect(string.contains(pretty, "\"display_name\""), 1)
expectText(scalarJson, "\"quoted\"")
expectText(integerJson, "42")
expectText(scalarXlon, "\"plain\"")

PersistenceProfile restored = json.parse::<PersistenceProfile>(compact)
expect(restored.id, 42)
expectText(restored.displayName, "Alice")
expectText(restored.secretValue(), "open")
expectText(restored.password, "")
expectText(restored.note, "")
expectText(restored.address.city, "Shanghai")

string xlonText = xlon.stringify(profile)
expect(string.contains(xlonText, "displayName"), 1)
expect(string.contains(xlonText, "display_name"), 0)
expect(string.contains(xlonText, "secret_name"), 1)
expect(string.contains(xlonText, "password"), 0)
expect(string.contains(xlonText, "note"), 1)
expect(string.contains(xlonText, "city"), 1)

PersistenceProfile restoredXlon = xlon.parse::<PersistenceProfile>(xlonText)
expect(restoredXlon.id, 42)
expectText(restoredXlon.displayName, "Alice")
expectText(restoredXlon.secretValue(), "open")
expectText(restoredXlon.password, "")
expectText(restoredXlon.note, "")
expectText(restoredXlon.address.city, "Shanghai")

string jsonPath = "build/test/xlir_persistence_json_abi.json"
string xlonPath = "build/test/xlir_persistence_json_abi.xlon"
string scalarPath = "build/test/xlir_persistence_json_scalar.json"
file.delete(jsonPath)
file.delete(xlonPath)
file.delete(scalarPath)

expect(json.write(jsonPath, profile, true), 1)
PersistenceProfile restoredJsonFile = json.read::<PersistenceProfile>(jsonPath)
expect(restoredJsonFile.id, 42)
expectText(restoredJsonFile.displayName, "Alice")
expectText(restoredJsonFile.secretValue(), "open")
expectText(restoredJsonFile.password, "")
expectText(restoredJsonFile.note, "")
expectText(restoredJsonFile.address.city, "Shanghai")

expect(xlon.write(xlonPath, profile), 1)
PersistenceProfile restoredXlonFile = xlon.read::<PersistenceProfile>(xlonPath)
expect(restoredXlonFile.id, 42)
expectText(restoredXlonFile.displayName, "Alice")
expectText(restoredXlonFile.secretValue(), "open")
expectText(restoredXlonFile.password, "")
expectText(restoredXlonFile.note, "")
expectText(restoredXlonFile.address.city, "Shanghai")

expect(json.write(scalarPath, "written"), 1)

file.delete(jsonPath)
file.delete(xlonPath)
file.delete(scalarPath)
