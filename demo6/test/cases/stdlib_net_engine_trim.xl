// Engine-only program: no implicit resolver or transport singleton.
auto engine = net.engine(1)
engine.start()
assert engine.workerCount == 1
auto stats = engine.snapshot()
assert stats.workers == 1 and stats.state == NetEngineState.running
engine.close()
assert engine.wait(5000)
assert stats.workers == 1 and stats.state == NetEngineState.running
println("stdlib net engine trim ok")
