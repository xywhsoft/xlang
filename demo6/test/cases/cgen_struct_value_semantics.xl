struct Pair
    int x
    int y
    union
        int raw
        float64 decimal
    end
end

func mutateDefault(Pair value)
    value.x = 20
end

func mutateByVal(byval Pair value)
    value.x = 30
end

func mutateByRef(byref Pair value)
    value.x = 40
end

func writePair(out Pair value)
    Pair next
    next.x = 50
    next.y = 60
    value = next
end

func passThrough(Pair value) as Pair
    return value
end

func main(...) as int
    Pair value
    value.x = 10
    value.y = 11

    mutateDefault(value)
    assert value.x == 10

    mutateByVal(value)
    assert value.x == 10

    mutateByRef(byref value)
    assert value.x == 40

    Pair output
    writePair(out output)
    assert output.x == 50
    assert output.y == 60

    Pair copied = passThrough(output)
    copied.raw = 7
    assert copied.raw == 7
    assert output.x == 50
    return 0
end
