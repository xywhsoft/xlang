extern "xlir_make_string_future" func makeFuture() as future<string>

async func surroundParameters(future<string> source, string prefix, string suffix) as string
    return prefix + await source + suffix
end

future<string> source = makeFuture()
future<string> pending = surroundParameters(source, "[", "]")
string completed = await pending
assert completed == "[he\0llo]"
