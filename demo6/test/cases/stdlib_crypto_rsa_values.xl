assert publicKey.verifyPkcs1Hash(digest_sha1Legacy,pkcs_sha1Legacy,RsaHash.sha1Legacy)
bytes pss_sha1Legacy = privateKey.signPssHashSalt(digest_sha1Legacy,b"salt",RsaHash.sha1Legacy)
assert publicKey.verifyPssHash(digest_sha1Legacy,pss_sha1Legacy,RsaHash.sha1Legacy,4)
bytes digest_sha224 = crypto.sha224("ordinary digest choice")
bytes pkcs_sha224 = privateKey.signPkcs1Hash(digest_sha224,RsaHash.sha224)
assert publicKey.verifyPkcs1Hash(digest_sha224,pkcs_sha224,RsaHash.sha224)
bytes pss_sha224 = privateKey.signPssHashSalt(digest_sha224,b"salt",RsaHash.sha224)
assert publicKey.verifyPssHash(digest_sha224,pss_sha224,RsaHash.sha224,4)
bytes digest_sha256 = crypto.sha256("ordinary digest choice")
bytes pkcs_sha256 = privateKey.signPkcs1Hash(digest_sha256,RsaHash.sha256)
assert publicKey.verifyPkcs1Hash(digest_sha256,pkcs_sha256,RsaHash.sha256)
bytes pss_sha256 = privateKey.signPssHashSalt(digest_sha256,b"salt",RsaHash.sha256)
assert publicKey.verifyPssHash(digest_sha256,pss_sha256,RsaHash.sha256,4)
bytes digest_sha384 = crypto.sha384("ordinary digest choice")
bytes pkcs_sha384 = privateKey.signPkcs1Hash(digest_sha384,RsaHash.sha384)
assert publicKey.verifyPkcs1Hash(digest_sha384,pkcs_sha384,RsaHash.sha384)
bytes pss_sha384 = privateKey.signPssHashSalt(digest_sha384,b"salt",RsaHash.sha384)
assert publicKey.verifyPssHash(digest_sha384,pss_sha384,RsaHash.sha384,4)
bytes digest_sha512 = crypto.sha512("ordinary digest choice")
bytes pkcs_sha512 = privateKey.signPkcs1Hash(digest_sha512,RsaHash.sha512)
assert publicKey.verifyPkcs1Hash(digest_sha512,pkcs_sha512,RsaHash.sha512)
bytes pss_sha512 = privateKey.signPssHashSalt(digest_sha512,b"salt",RsaHash.sha512)
assert publicKey.verifyPssHash(digest_sha512,pss_sha512,RsaHash.sha512,4)
bytes privateCopy = privateKey.exportPart(RsaPrivatePart.privateExponent)
privateCopy[0] = 0
assert privateKey.exportPart(RsaPrivatePart.privateExponent) == b"\x2e\xbf\xd5\xce\xd4\x12\xeb\x6e\x5d\xa7\x42\x1e\x81\x81\xd5\xbb\x42\xe5\x22\x0c\x32\x3e\x55\x2c\x26\xa1\x95\x18\x99\x90\x58\x93\x70\x20\x48\x59\x86\x3f\xf3\xb6\x12\xa3\xcc\xda\xfb\x8f\x11\x56\xf6\x23\x32\xbe\x12\x5b\xa4\x98\x7a\xf5\x39\xca\x10\x1a\x74\x9f\xaf\x3a\x62\x5d\xc0\x22\x72\xaf\xc1\xe8\xd1\x02\xce\x1b\x4e\xfa\xf9\x20\xad\x86\x82\xe4\x9c\xfd\x2a\x63\xa7\xdc\xa6\x06\xd3\x37\x60\xa6\x44\x4a\x58\x20\x13\xa1\xa6\x96\x5b\x8b\x97\x62\x1f\xad\x99\x53\x68\x46\x68\xe9\x67\x50\xc9\x46\x9b\x82\x37\xe2\xab\x79"
bytes publicCopy = publicKey.modulus
publicCopy[0] = 0
assert publicKey.modulus == b"\xa8\x5c\x1f\x27\x9c\xc3\xb3\x27\x43\x76\x5c\x4e\xb7\x63\x72\x45\x80\x8d\xde\xa6\x90\x24\x91\x36\x19\xcb\xc7\x15\xe5\xf5\xd8\x62\x08\x36\x23\x6b\x50\xaf\x06\xeb\xea\xa4\xce\xb7\xf3\xc3\x12\x83\x62\x06\x42\x22\x90\xb1\xaf\x89\x26\xd2\x75\xc3\x4f\xb6\xb0\xc7\xbf\xce\xcc\x7e\xa2\x30\x11\x3a\xbc\x03\x90\xb1\x62\xfc\x80\x88\x31\x3b\x74\x97\x7c\x07\xd2\xfb\x11\xe1\x11\x49\x38\x13\xdb\x89\xc3\x22\x36\xed\x32\x29\x51\x29\xc4\x23\xdf\x60\x31\xe0\x6b\x5f\x02\x90\x7c\x14\x03\x8f\xc9\xc7\xc1\xb5\xcd\x69\xe1\xaa\x46\xd9"
array<RsaPrivateKey> privateOwners = [privateKey,exponentKey,crtOnlyKey]
array<RsaPublicKey> publicOwners = [publicKey,privateKey.publicKey]
assert privateOwners[0].publicKey.modulus == publicOwners[0].modulus
int rejected = 0
try
    RsaPublicKey(b"short",b"\x01\x00\x01")
catch e
    rejected += 1
end
try
    privateKey.signPkcs1Hash(b"short")
catch e
    rejected += 1
end
try
    publicKey.verifyPssHash(digest,b"short")
catch e
    rejected += 1
end
try
    publicKey.verifyPssHash(digest,expectedPss,RsaHash.sha256,-2)
catch e
    rejected += 1
end
try
    publicKey.verifyPssHash(digest,expectedPss,RsaHash.sha256,9223372036854775807)
catch e
    rejected += 1
end
try
    cryptoAdvanced.rsaPublic(publicKey,b"short")
catch e
    rejected += 1
end
assert rejected == 6
println("managed RSA components, CRT/exponent, PSS/MGF/salt and PKCS1: ok")
