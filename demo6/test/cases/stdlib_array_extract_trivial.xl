    assert(result_c_wchar == c_wchar(7) and native_c_wchar.length == 0)
    array<c_wchar?> optional_c_wchar = [c_wchar(7), null]
    auto missing_c_wchar = optional_c_wchar.take(1)
    auto found_c_wchar = optional_c_wchar.pop()
    assert(missing_c_wchar == null and found_c_wchar != null and found_c_wchar == c_wchar(7))
    array<c_wchar?> reboxed_c_wchar = [found_c_wchar, missing_c_wchar]
    auto absent_again_c_wchar = reboxed_c_wchar.pop()
    auto present_again_c_wchar = reboxed_c_wchar.pop()
    assert(absent_again_c_wchar == null and present_again_c_wchar != null and present_again_c_wchar == c_wchar(7)), "nullable C rebox c_wchar"
end

func checkTrivialEmpty()
    array<int?> empty_values = []
    bool empty_refused = false
    try
        empty_values.pop()
    catch RangeError failure
        empty_refused = true
    end
    assert(empty_refused)
end

checkTrivialNarrow()
checkTrivialNullableLanguage()
