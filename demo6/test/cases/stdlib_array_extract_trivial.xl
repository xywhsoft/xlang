// Full trivial Array results: exact language domains and target C widths.
// Bounded functions keep adversarial whole-module verification proportional.
// Every function executes from module initialization under C/JIT/AOT and OOM.

func checkTrivialNarrow()
    array<int8> narrow_int8 = [int8(-128)]
    auto moved_int8 = narrow_int8.pop()
    assert(moved_int8 == int8(-128) and narrow_int8.length == 0)

    array<uint8> narrow_uint8 = [uint8(255)]
    auto moved_uint8 = narrow_uint8.pop()
    assert(moved_uint8 == uint8(255) and narrow_uint8.length == 0)

    array<int16> narrow_int16 = [int16(-32768)]
    auto moved_int16 = narrow_int16.pop()
    assert(moved_int16 == int16(-32768) and narrow_int16.length == 0)

    array<uint16> narrow_uint16 = [uint16(65535)]
    auto moved_uint16 = narrow_uint16.pop()
    assert(moved_uint16 == uint16(65535) and narrow_uint16.length == 0)

    array<int32> narrow_int32 = [int32(-2147483648)]
    auto moved_int32 = narrow_int32.pop()
    assert(moved_int32 == int32(-2147483648) and narrow_int32.length == 0)

    array<uint32> narrow_uint32 = [uint32(4294967295)]
    auto moved_uint32 = narrow_uint32.pop()
    assert(moved_uint32 == uint32(4294967295) and narrow_uint32.length == 0)
end

func checkTrivialNullableLanguage()
    array<bool?> nullable_bool = [true, null]
    auto absent_bool = nullable_bool.pop()
    auto present_bool = nullable_bool.take(0)
    assert(absent_bool == null and present_bool != null and present_bool == true)
    assert(nullable_bool.length == 0)

    array<int?> nullable_int = [0, null]
    auto absent_int = nullable_int.pop()
    auto present_int = nullable_int.take(0)
    assert(absent_int == null and present_int != null and present_int == 0)
    assert(nullable_int.length == 0)

    uint64 maximum_uint64 = 18446744073709551615
    array<uint64?> nullable_uint64 = [maximum_uint64, null]
    auto absent_uint64 = nullable_uint64.pop()
    auto present_uint64 = nullable_uint64.take(0)
    assert(absent_uint64 == null and present_uint64 != null and present_uint64 == maximum_uint64)
    assert(nullable_uint64.length == 0)

    array<float32?> nullable_float32 = [float32(0.5), null]
    auto absent_float32 = nullable_float32.pop()
    auto present_float32 = nullable_float32.take(0)
    assert(absent_float32 == null and present_float32 != null and present_float32 == float32(0.5))
    assert(nullable_float32.length == 0)

    array<float?> nullable_float = [0.5, null]
    auto absent_float = nullable_float.pop()
    auto present_float = nullable_float.take(0)
    assert(absent_float == null and present_float != null and present_float == 0.5)
    assert(nullable_float.length == 0)

    array<char?> nullable_char = ['你', null]
    auto absent_char = nullable_char.pop()
    auto present_char = nullable_char.take(0)
    assert(absent_char == null and present_char != null and present_char == '你')
    assert(nullable_char.length == 0)

    array<time?> nullable_time = [time.fromUnix(0), null]
    auto absent_time = nullable_time.pop()
    auto present_time = nullable_time.take(0)
    assert(absent_time == null and present_time != null and present_time == time.fromUnix(0))
    assert(nullable_time.length == 0)

    array<int8?> nullable_int8 = [-128, null]
    auto absent_int8 = nullable_int8.pop()
    auto present_int8 = nullable_int8.take(0)
    assert(absent_int8 == null and present_int8 != null and present_int8 == -128)
    assert(nullable_int8.length == 0)

    array<uint8?> nullable_uint8 = [255, null]
    auto absent_uint8 = nullable_uint8.pop()
    auto present_uint8 = nullable_uint8.take(0)
    assert(absent_uint8 == null and present_uint8 != null and present_uint8 == 255)
    assert(nullable_uint8.length == 0)

    array<int16?> nullable_int16 = [-32768, null]
    auto absent_int16 = nullable_int16.pop()
    auto present_int16 = nullable_int16.take(0)
    assert(absent_int16 == null and present_int16 != null and present_int16 == -32768)
    assert(nullable_int16.length == 0)

    array<uint16?> nullable_uint16 = [65535, null]
    auto absent_uint16 = nullable_uint16.pop()
    auto present_uint16 = nullable_uint16.take(0)
    assert(absent_uint16 == null and present_uint16 != null and present_uint16 == 65535)
    assert(nullable_uint16.length == 0)

    array<int32?> nullable_int32 = [-2147483648, null]
    auto absent_int32 = nullable_int32.pop()
    auto present_int32 = nullable_int32.take(0)
    assert(absent_int32 == null and present_int32 != null and present_int32 == -2147483648)
    assert(nullable_int32.length == 0)

    array<uint32?> nullable_uint32 = [4294967295, null]
    auto absent_uint32 = nullable_uint32.pop()
    auto present_uint32 = nullable_uint32.take(0)
    assert(absent_uint32 == null and present_uint32 != null and present_uint32 == 4294967295)
    assert(nullable_uint32.length == 0)
end

func checkTrivialTypeIds()
    array<type> type_ids = [int]
    auto moved_type = type_ids.pop()
    assert(moved_type == int and type_ids.length == 0)
    array<type?> nullable_type_ids = [bool, null]
    auto absent_type = nullable_type_ids.take(1)
    auto present_type = nullable_type_ids.pop()
    assert(absent_type == null and present_type != null)
    if present_type != null then
        type restored_type = present_type
        assert(restored_type == bool)
    end

    array<type?> reboxed_type_ids = [present_type, absent_type]
    auto absent_again_type = reboxed_type_ids.pop()
    auto present_again_type = reboxed_type_ids.pop()
    assert(absent_again_type == null and present_again_type != null)
end

func checkTrivial_c_char()
    array<c_char> native_c_char = [c_char(7)]
    auto result_c_char = native_c_char.pop()
    assert(result_c_char == c_char(7) and native_c_char.length == 0)
    array<c_char?> optional_c_char = [c_char(7), null]
    auto missing_c_char = optional_c_char.take(1)
    auto found_c_char = optional_c_char.pop()
    assert(missing_c_char == null and found_c_char != null and found_c_char == c_char(7))
    array<c_char?> reboxed_c_char = [found_c_char, missing_c_char]
    auto absent_again_c_char = reboxed_c_char.pop()
    auto present_again_c_char = reboxed_c_char.pop()
    assert(absent_again_c_char == null and present_again_c_char != null and present_again_c_char == c_char(7)), "nullable C rebox c_char"
end

