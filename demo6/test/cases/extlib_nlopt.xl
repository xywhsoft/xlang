import nlopt



func main(...) as int
    // Algorithm names
    assert nlopt.algoName(0) == "GN_DIRECT", "direct"
    assert nlopt.algoName(10) == "LN_NELDERMEAD", "neldermead"
    assert nlopt.algoName(24) == "LD_LBFGS", "lbfgs"
    assert nlopt.algoName(40) == "LN_COBYLA", "cobyla"
    assert nlopt.algoName(99) == "UNKNOWN", "unknown algo"

    // Algorithm classification
    assert nlopt.isGlobal(0) == 1, "direct is global"
    assert nlopt.isGlobal(10) == 0, "neldermead not global"
    assert nlopt.isLocal(10) == 1, "neldermead is local"
    assert nlopt.isLocal(0) == 0, "direct not local"
    assert nlopt.usesGradient(24) == 1, "lbfgs uses gradient"
    assert nlopt.usesGradient(10) == 0, "neldermead no gradient"

    // Result names
    assert nlopt.resultName(1) == "SUCCESS", "success"
    assert nlopt.resultName(3) == "FTOL_REACHED", "ftol"
    assert nlopt.resultName(5) == "MAXEVAL_REACHED", "maxeval"
    assert nlopt.resultName(-1) == "FAILURE", "failure"
    assert nlopt.resultName(-2) == "INVALID_ARGS", "invalid args"
    assert nlopt.resultName(99) == "UNKNOWN", "unknown result"

    // Result classification
    assert nlopt.isSuccess(1) == 1, "1 is success"
    assert nlopt.isSuccess(-1) == 0, "-1 not success"
    assert nlopt.isFailure(-1) == 1, "-1 is failure"
    assert nlopt.isFailure(1) == 0, "1 not failure"

    // Test functions
    auto ros = nlopt.rosenbrock(1.0, 1.0)
    assert ros > -0.01 and ros < 0.01, "rosenbrock min at (1,1)"
    auto sph = nlopt.sphere(0.0, 0.0)
    assert sph > -0.01 and sph < 0.01, "sphere min at (0,0)"
    auto sph2 = nlopt.sphere(3.0, 4.0)
    assert sph2 > 24.9 and sph2 < 25.1, "sphere(3,4)=25"
    auto rast = nlopt.rastrigin(0.0, 0.0)
    assert rast > -0.01 and rast < 0.01, "rastrigin min at (0,0)"

    // Gradient step
    auto gs = nlopt.gradStep(5.0, 2.0, 0.1)
    assert gs > 4.79 and gs < 4.81, "grad step"

    // Defaults
    assert nlopt.defaultMaxEval() == 10000, "default maxeval"
    auto ftol = nlopt.defaultFtol()
    assert ftol > 0 and ftol < 1e-7, "default ftol"

    // Version
    assert nlopt.versionMajor() == 2, "major version"
    assert nlopt.versionMinor() == 7, "minor version"

    return 0
end
