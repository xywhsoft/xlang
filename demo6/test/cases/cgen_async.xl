async func addAsync(int a, int b) as int
    return a + b
end

async func slowAddAsync(int a, int b) as int
    time.sleep(250)
    return a + b
end

async func doneAsync()
    int a = 1
    assert a == 1, "async void body failed"
end

async func slowDoneAsync()
    time.sleep(250)
    int a = 1
    assert a == 1, "slow async void body failed"
end

func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

class AsyncBox
    func(int) as int op
    int bias = 0
end

func makeBox(int base) as AsyncBox
    AsyncBox box = AsyncBox()
    box.op = makeAdder(base)
    box.bias = base
    return box
end

async func makeBoxAsync(int base) as AsyncBox
    AsyncBox box = makeBox(base)
    return box
end

async func slowMakeBoxAsync(int base) as AsyncBox
    time.sleep(250)
    AsyncBox box = makeBox(base)
    return box
end

async func makeAdderAsync(int base) as func(int) as int
    return makeAdder(base)
end

async func slowMakeAdderAsync(int base) as func(int) as int
    time.sleep(250)
    return makeAdder(base)
end

async func makeVarAsync(int value) as var
    return value
end

async func slowMakeVarAsync(int value) as var
    time.sleep(250)
    return value
end

async func greetAsync(string name) as string
    return "hello " + name
end

async func slowGreetAsync(string name) as string
    time.sleep(250)
    return "hello " + name
end

async func flipAsync(bool flag) as bool
    return not flag
end

async func slowFlipAsync(bool flag) as bool
    time.sleep(250)
    return not flag
end

async func halfAsync(float value) as float
    return value + 0.5
end

async func slowHalfAsync(float value) as float
    time.sleep(250)
    return value + 0.5
end

async func makeItemsAsync() as array<int>
    return array[3, 4, 5]
end

async func slowMakeItemsAsync() as array<int>
    time.sleep(250)
    return array[13, 14, 15]
end

async func copyItemsAsync() as array<int>
    array<int> values = array[7, 8]
    return values
end

async func makeListAsync() as list<int>
    return list[2: 8, 4: 9]
end

async func slowMakeListAsync() as list<int>
    time.sleep(250)
    return list[2: 18, 4: 19]
end

async func makeSetAsync() as set<int>
    return set{6, 7}
end

async func slowMakeSetAsync() as set<int>
    time.sleep(250)
    return set{16, 17}
end

async func makeDictAsync() as dict<int>
    return dict{"a": 11, "b": 12}
end

async func slowMakeDictAsync() as dict<int>
    time.sleep(250)
    return dict{"a": 21, "b": 22}
end

future<int> futureValue = addAsync(2, 3)
int value = await futureValue

assert value == 5, "await int result failed"
assert not task.cancel(futureValue), "completed async int future should not be canceled"
int postCancelValue = await futureValue
assert postCancelValue == 5, "completed async int future should remain awaitable after cancel"

auto autoFuture = addAsync(4, 6)
auto autoValue = await autoFuture

assert autoValue == 10, "await auto result failed"

auto voidFuture = doneAsync()
await voidFuture
assert not task.cancel(voidFuture), "completed async void future should not be canceled"
await voidFuture

future<bool> boolFuture = flipAsync(false)
bool boolValue = await boolFuture
assert boolValue == true, "await bool result failed"
assert not task.cancel(boolFuture), "completed async bool future should not be canceled"
bool postCancelBool = await boolFuture
assert postCancelBool == true, "completed async bool future should remain awaitable after cancel"

future<float> halfFuture = halfAsync(2.5)
float halfValue = await halfFuture
assert halfValue == 3.0, "await float result failed"
assert not task.cancel(halfFuture), "completed async float future should not be canceled"
float postCancelHalf = await halfFuture
assert postCancelHalf == 3.0, "completed async float future should remain awaitable after cancel"

future<AsyncBox> boxFuture = makeBoxAsync(30)
AsyncBox box = await boxFuture

assert box.op(12) + box.bias == 72, "await class func field failed"
assert not task.cancel(boxFuture), "completed async class future should not be canceled"
AsyncBox postCancelBox = await boxFuture
assert postCancelBox.op(13) + postCancelBox.bias == 73, "completed async class future should remain awaitable after cancel"

future<func(int) as int> fnFuture = makeAdderAsync(50)
func(int) as int fnA = await fnFuture
func(int) as int fnB = await fnFuture

assert fnA(1) == 51, "await func result failed"
assert fnB(2) == 52, "second await func result failed"
assert not task.cancel(fnFuture), "completed async function future should not be canceled"
func(int) as int fnC = await fnFuture
assert fnC(3) == 53, "completed async function future should remain awaitable after cancel"

future<AsyncBox> sharedBoxFuture = makeBoxAsync(70)
AsyncBox firstBox = await sharedBoxFuture
AsyncBox secondBox = await sharedBoxFuture

assert firstBox.op(3) + firstBox.bias == 143, "first repeated await class result failed"
assert secondBox.op(4) + secondBox.bias == 144, "second repeated await class result failed"

auto autoBoxFuture = makeBoxAsync(90)
auto autoBox = await autoBoxFuture

assert autoBox.op(5) + autoBox.bias == 185, "auto await class result failed"

int temporaryValue = await addAsync(8, 9)
assert temporaryValue == 17, "temporary await int result failed"

await doneAsync()

func(int) as int temporaryFn = await makeAdderAsync(60)
assert temporaryFn(4) == 64, "temporary await func result failed"

AsyncBox temporaryBox = await makeBoxAsync(110)
assert temporaryBox.op(6) + temporaryBox.bias == 226, "temporary await class result failed"

future<var> varFuture = makeVarAsync(120)
var awaitedVar = await varFuture
assert int(awaitedVar) == 120, "await var result failed"
assert not task.cancel(varFuture), "completed async var future should not be canceled"
var postCancelVar = await varFuture
assert int(postCancelVar) == 120, "completed async var future should remain awaitable after cancel"

var temporaryVar = await makeVarAsync(130)
assert int(temporaryVar) == 130, "temporary await var result failed"

future<int> conditionalAwaitSource = addAsync(300, 1)
bool chooseConditionalAwait = true
int conditionalAwaitBorrowed = await (chooseConditionalAwait ? conditionalAwaitSource : addAsync(310, 1))
assert conditionalAwaitBorrowed == 301, "conditional await borrowed int branch failed"
int conditionalAwaitSourceAgain = await conditionalAwaitSource
assert conditionalAwaitSourceAgain == 301, "conditional await borrowed int branch should keep named future awaitable"
chooseConditionalAwait = false
int conditionalAwaitOwned = await (chooseConditionalAwait ? conditionalAwaitSource : addAsync(320, 1))
assert conditionalAwaitOwned == 321, "conditional await owned int branch failed"

auto conditionalVoidSource = doneAsync()
await conditionalVoidSource
chooseConditionalAwait = true
await (chooseConditionalAwait ? conditionalVoidSource : doneAsync())
chooseConditionalAwait = false
await (chooseConditionalAwait ? conditionalVoidSource : doneAsync())

future<var> conditionalVarSource = makeVarAsync(330)
chooseConditionalAwait = true
var conditionalVarBorrowed = await (chooseConditionalAwait ? conditionalVarSource : makeVarAsync(340))
assert int(conditionalVarBorrowed) == 330, "conditional await borrowed var branch failed"
var conditionalVarSourceAgain = await conditionalVarSource
assert int(conditionalVarSourceAgain) == 330, "conditional await borrowed var branch should keep named future awaitable"
chooseConditionalAwait = false
var conditionalVarOwned = await (chooseConditionalAwait ? conditionalVarSource : makeVarAsync(350))
assert int(conditionalVarOwned) == 350, "conditional await owned var branch failed"

future<func(int) as int> conditionalFnSource = makeAdderAsync(360)
chooseConditionalAwait = true
func(int) as int conditionalFnBorrowed = await (chooseConditionalAwait ? conditionalFnSource : makeAdderAsync(370))
assert conditionalFnBorrowed(2) == 362, "conditional await borrowed function branch failed"
func(int) as int conditionalFnSourceAgain = await conditionalFnSource
assert conditionalFnSourceAgain(3) == 363, "conditional await borrowed function branch should keep named future awaitable"
chooseConditionalAwait = false
func(int) as int conditionalFnOwned = await (chooseConditionalAwait ? conditionalFnSource : makeAdderAsync(380))
assert conditionalFnOwned(4) == 384, "conditional await owned function branch failed"

future<AsyncBox> conditionalBoxSource = makeBoxAsync(385)
chooseConditionalAwait = true
AsyncBox conditionalBoxBorrowed = await (chooseConditionalAwait ? conditionalBoxSource : makeBoxAsync(395))
assert conditionalBoxBorrowed.op(5) + conditionalBoxBorrowed.bias == 775, "conditional await borrowed class branch failed"
AsyncBox conditionalBoxSourceAgain = await conditionalBoxSource
assert conditionalBoxSourceAgain.op(6) + conditionalBoxSourceAgain.bias == 776, "conditional await borrowed class branch should keep named future awaitable"
chooseConditionalAwait = false
AsyncBox conditionalBoxOwned = await (chooseConditionalAwait ? conditionalBoxSource : makeBoxAsync(395))
assert conditionalBoxOwned.op(7) + conditionalBoxOwned.bias == 797, "conditional await owned class branch failed"

future<int> conditionalMissingAwait
int conditionalMissingAwaitState = 0
bool chooseConditionalMissingAwait = false
try
    int conditionalMissingAwaitValue = await (chooseConditionalMissingAwait ? addAsync(390, 1) : conditionalMissingAwait)
    conditionalMissingAwaitState = conditionalMissingAwaitValue
catch e
    if e.message == "await on null future" then
        conditionalMissingAwaitState = 42
    end
end
assert conditionalMissingAwaitState == 42, "conditional await null int branch should raise AsyncError"

string temporaryGreeting = await greetAsync("temp")
assert temporaryGreeting == "hello temp", "temporary await string result failed"

future<string> greetingFuture = greetAsync("named")
string namedGreetingA = await greetingFuture
string namedGreetingB = await greetingFuture
assert namedGreetingA == "hello named", "named future string first await failed"
assert namedGreetingB == "hello named", "named future string second await failed"
assert not task.cancel(greetingFuture), "completed async string future should not be canceled"
string postCancelGreeting = await greetingFuture
assert postCancelGreeting == "hello named", "completed async string future should remain awaitable after cancel"

future<string> conditionalGreetingSource = greetAsync("conditional named")
bool chooseConditionalGreeting = true
string conditionalGreetingBorrowed = await (chooseConditionalGreeting ? conditionalGreetingSource : greetAsync("conditional owned"))
assert conditionalGreetingBorrowed == "hello conditional named", "conditional await borrowed string branch failed"
string conditionalGreetingAgain = await conditionalGreetingSource
assert conditionalGreetingAgain == "hello conditional named", "conditional await borrowed string branch should keep named future awaitable"
chooseConditionalGreeting = false
string conditionalGreetingOwned = await (chooseConditionalGreeting ? conditionalGreetingSource : greetAsync("conditional owned"))
assert conditionalGreetingOwned == "hello conditional owned", "conditional await owned string branch failed"

