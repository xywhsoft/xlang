array<int> temporaryItems = await makeItemsAsync()
assert temporaryItems.length == 3, "temporary await typed array length failed"
assert int(temporaryItems[1]) == 4, "temporary await typed array item failed"

array<int> copiedItems = await copyItemsAsync()
assert copiedItems.length == 2, "temporary await copied typed array length failed"
assert int(copiedItems[0]) == 7, "temporary await copied typed array item failed"

future<array<int>> itemsFuture = makeItemsAsync()
array<int> namedItemsA = await itemsFuture
array<int> namedItemsB = await itemsFuture
assert namedItemsA.length == 3, "named future typed array first length failed"
assert namedItemsB.length == 3, "named future typed array second length failed"
assert int(namedItemsA[2]) == 5, "named future typed array first item failed"
assert int(namedItemsB[0]) == 3, "named future typed array second item failed"
assert not task.cancel(itemsFuture), "completed async typed array future should not be canceled"
array<int> postCancelItems = await itemsFuture
assert postCancelItems.length == 3, "completed async typed array future should remain awaitable after cancel"
assert int(postCancelItems[1]) == 4, "completed async typed array post-cancel item failed"

future<array<int>> conditionalItemsSource = makeItemsAsync()
bool chooseConditionalItems = true
array<int> conditionalItemsBorrowed = await (chooseConditionalItems ? conditionalItemsSource : slowMakeItemsAsync())
assert int(conditionalItemsBorrowed[0]) == 3, "conditional await borrowed typed array branch failed"
array<int> conditionalItemsAgain = await conditionalItemsSource
assert int(conditionalItemsAgain[2]) == 5, "conditional await borrowed typed array branch should keep named future awaitable"
chooseConditionalItems = false
array<int> conditionalItemsOwned = await (chooseConditionalItems ? conditionalItemsSource : slowMakeItemsAsync())
assert int(conditionalItemsOwned[0]) == 13, "conditional await owned typed array branch failed"

list<int> temporaryList = await makeListAsync()
assert temporaryList.length == 2, "temporary await typed list length failed"
assert int(temporaryList[2]) == 8, "temporary await typed list item failed"

future<list<int>> listFuture = makeListAsync()
list<int> namedListA = await listFuture
list<int> namedListB = await listFuture
assert int(namedListA[4]) == 9, "named future typed list first item failed"
assert int(namedListB[2]) == 8, "named future typed list second item failed"
assert not task.cancel(listFuture), "completed async typed list future should not be canceled"
list<int> postCancelList = await listFuture
assert int(postCancelList[4]) == 9, "completed async typed list future should remain awaitable after cancel"

future<list<int>> conditionalListSource = makeListAsync()
bool chooseConditionalList = true
list<int> conditionalListBorrowed = await (chooseConditionalList ? conditionalListSource : slowMakeListAsync())
assert int(conditionalListBorrowed[2]) == 8, "conditional await borrowed typed list branch failed"
list<int> conditionalListAgain = await conditionalListSource
assert int(conditionalListAgain[4]) == 9, "conditional await borrowed typed list branch should keep named future awaitable"
chooseConditionalList = false
list<int> conditionalListOwned = await (chooseConditionalList ? conditionalListSource : slowMakeListAsync())
assert int(conditionalListOwned[2]) == 18, "conditional await owned typed list branch failed"

set<int> temporarySet = await makeSetAsync()
assert temporarySet.length == 2, "temporary await typed set length failed"

future<set<int>> setFuture = makeSetAsync()
set<int> namedSetA = await setFuture
set<int> namedSetB = await setFuture
assert namedSetA.length == 2, "named future typed set first length failed"
assert namedSetB.length == 2, "named future typed set second length failed"
assert not task.cancel(setFuture), "completed async typed set future should not be canceled"
set<int> postCancelSet = await setFuture
assert postCancelSet.length == 2, "completed async typed set future should remain awaitable after cancel"

future<set<int>> conditionalSetSource = makeSetAsync()
bool chooseConditionalSet = true
set<int> conditionalSetBorrowed = await (chooseConditionalSet ? conditionalSetSource : slowMakeSetAsync())
assert conditionalSetBorrowed.length == 2, "conditional await borrowed typed set branch failed"
set<int> conditionalSetAgain = await conditionalSetSource
assert conditionalSetAgain.length == 2, "conditional await borrowed typed set branch should keep named future awaitable"
chooseConditionalSet = false
set<int> conditionalSetOwned = await (chooseConditionalSet ? conditionalSetSource : slowMakeSetAsync())
assert conditionalSetOwned.length == 2, "conditional await owned typed set branch failed"

dict<int> temporaryDict = await makeDictAsync()
assert temporaryDict.length == 2, "temporary await typed dict length failed"
assert int(temporaryDict["a"]) == 11, "temporary await typed dict item failed"

future<dict<int>> dictFuture = makeDictAsync()
dict<int> namedDictA = await dictFuture
dict<int> namedDictB = await dictFuture
assert int(namedDictA["b"]) == 12, "named future typed dict first item failed"
assert int(namedDictB["a"]) == 11, "named future typed dict second item failed"
assert not task.cancel(dictFuture), "completed async typed dict future should not be canceled"
dict<int> postCancelDict = await dictFuture
assert int(postCancelDict["b"]) == 12, "completed async typed dict future should remain awaitable after cancel"

future<dict<int>> conditionalDictSource = makeDictAsync()
bool chooseConditionalDict = true
dict<int> conditionalDictBorrowed = await (chooseConditionalDict ? conditionalDictSource : slowMakeDictAsync())
assert int(conditionalDictBorrowed["a"]) == 11, "conditional await borrowed typed dict branch failed"
dict<int> conditionalDictAgain = await conditionalDictSource
assert int(conditionalDictAgain["b"]) == 12, "conditional await borrowed typed dict branch should keep named future awaitable"
chooseConditionalDict = false
dict<int> conditionalDictOwned = await (chooseConditionalDict ? conditionalDictSource : slowMakeDictAsync())
assert int(conditionalDictOwned["a"]) == 21, "conditional await owned typed dict branch failed"
