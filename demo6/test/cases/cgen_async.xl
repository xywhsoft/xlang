future<int> pendingAsyncInt = slowAddAsync(40, 2)
assert task.cancel(pendingAsyncInt), "pending async int future should accept cancel"

int pendingAsyncIntStateA = 0
try
    int pendingAsyncIntValueA = await pendingAsyncInt
    pendingAsyncIntStateA = pendingAsyncIntValueA
catch e
    if e.message == "future cancel requested." then
        pendingAsyncIntStateA = 42
    end
end
assert pendingAsyncIntStateA == 42, "pending async int future should await as canceled"

time.sleep(320)

int pendingAsyncIntStateB = 0
try
    int pendingAsyncIntValueB = await pendingAsyncInt
    pendingAsyncIntStateB = pendingAsyncIntValueB
catch e
    if e.message == "future cancel requested." then
        pendingAsyncIntStateB = 42
    end
end
assert pendingAsyncIntStateB == 42, "pending async int worker completion should not overwrite cancel"

