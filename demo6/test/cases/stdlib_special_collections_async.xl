async func stackCountAsync(Stack<int> values) as int
    time.sleep(5)
    return values.count()
end

async func makeStackAsync(int value) as Stack<int>
    Stack<int> result = Stack::<int>()
    result.push(value)
    return result
end

async func makeTreeAsync() as OrderedMap<string, int>
    OrderedMap<string, int> result = OrderedMap::<string, int>()
    result.set("answer", 42)
    return result
end

async func makeQueueAsync() as WaitQueue<string>
    WaitQueue<string> result = WaitQueue::<string>(4)
    result.tryPush("ready")
    return result
end

func makeStackSync() as Stack<int>
    Stack<int> result = Stack::<int>()
    result.push(99)
    return result
end

func takeStackValue(Stack<int> values) as int
    return values.pop()
end

Stack<int> source = Stack::<int>()
source.push(1)
source.push(2)
future<int> countFuture = stackCountAsync(source)
assert await countFuture == 2
assert source.count() == 2

future<Stack<int>> stackFuture = makeStackAsync(7)
Stack<int> stackA = await stackFuture
Stack<int> stackB = await stackFuture
int number = 0
number = stackA.pop()
assert number == 7
assert stackB.count() == 0

Stack<int> temporaryStack = await makeStackAsync(8)
number = temporaryStack.pop()
assert number == 8

bool chooseNamed = true
future<Stack<int>> conditionalSource = makeStackAsync(9)
Stack<int> conditionalNamed = await (chooseNamed ? conditionalSource : makeStackAsync(10))
number = conditionalNamed.pop()
assert number == 9
chooseNamed = false
Stack<int> conditionalOwned = await (chooseNamed ? conditionalSource : makeStackAsync(10))
number = conditionalOwned.pop()
assert number == 10

OrderedMap<string, int> tree = await makeTreeAsync()
assert tree.getInto("answer", number) and number == 42

WaitQueue<string> queue = await makeQueueAsync()
string text = ""
assert queue.popInto(text) and text == "ready"

func() as Stack<int> maker = makeStackSync
future<Stack<int>> spawned = task.spawn(maker)
Stack<int> spawnedStack = await spawned
number = spawnedStack.pop()
assert number == 99

Stack<int> inputStack = Stack::<int>()
inputStack.push(123)
func(Stack<int>) as int consumer = takeStackValue
assert await task.spawn(consumer, inputStack) == 123
assert inputStack.count() == 0

println("stdlib special collection async ok")
