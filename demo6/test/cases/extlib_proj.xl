import proj



func main(...) as int
    // Mercator projection for London (lon=-0.1278, lat=51.5074)
    auto mx = proj.mercatorX(-0.1278, 51.5074)
    auto my = proj.mercatorY(-0.1278, 51.5074)
    assert mx > -14228 and mx < -14226, "mercator x"
    assert my > 6711400 and my < 6711600, "mercator y"

    // Inverse Mercator roundtrip
    auto ilon = proj.invMercatorLon(mx, my)
    auto ilat = proj.invMercatorLat(mx, my)
    assert ilon > -0.13 and ilon < -0.12, "inv mercator lon"
    assert ilat > 51.5 and ilat < 51.52, "inv mercator lat"

    // UTM zone for London
    assert proj.utmZone(-0.1278) == 30, "utm zone london"
    // UTM zone for New York
    assert proj.utmZone(-74.0) == 18, "utm zone ny"

    // UTM easting/northing for equator/prime meridian
    auto east = proj.utmEasting(0.0, 0.0)
    auto north = proj.utmNorthing()
    assert east > 160000 and east < 170000, "utm easting"
    assert north > -1 and north < 1, "utm northing equator"

    // Haversine: London to Paris ~343km
    auto dist = proj.haversine(-0.1278, 51.5074, 2.3522, 48.8566)
    assert dist > 340000 and dist < 346000, "haversine london-paris"

    // Bearing: London to Paris ~148 degrees (SE)
    auto brng = proj.bearing(-0.1278, 51.5074, 2.3522, 48.8566)
    assert brng > 145 and brng < 155, "bearing london-paris"

    // CRS names
    assert proj.crsName(4326) == "WGS 84", "crs 4326"
    assert proj.crsName(3857) == "WGS 84 / Pseudo-Mercator", "crs 3857"
    assert proj.crsName(9999) == "Unknown", "crs unknown"

    // Is projected
    assert proj.isProjected(4326) == 0, "4326 not projected"
    assert proj.isProjected(3857) == 1, "3857 projected"

    // DMS conversion
    auto dms = proj.toDms(51.5074, 0)
    assert string.len(dms) > 5, "dms output"

    // Tile coordinates at zoom 10 for London
    auto tx = proj.tileX(-0.1278, 51.5074, 10)
    auto ty = proj.tileY()
    assert tx == 511, "tile x"
    assert ty > 339 and ty < 342, "tile y"

    return 0
end
