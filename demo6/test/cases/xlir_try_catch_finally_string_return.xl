int catch_string_finally_trace = 0

func string_return_from_catch_through_finally() as string
    try
        throw "caught"
    catch ignored
        string text = "managed-catch"
        return text
    finally
        catch_string_finally_trace = catch_string_finally_trace + 1
    end
end

export "xlir_test_string_return_from_catch_through_finally_check" func string_return_from_catch_through_finally_check() as int
    string value = string_return_from_catch_through_finally()
    if value == "managed-catch" then
        return catch_string_finally_trace
    end
    return 0
end
