import xfeat

func main(...) as int
    assert xfeat.reset_stats(), "runtime stats"
    point engine = xfeat.open("__missing_query__.onnx", "__missing_target__.onnx")
    assert engine == null, "missing models"
    string result = xfeat.locate_json(engine, "__missing_query__.png", "__missing_target__.png")
    assert string.contains(result, "\"found\":false"), "missing image"
    return 0
end
