extern "pending_module_observe" func observe(int event, string text)
extern "pending_module_input" func pendingInput() as future<int>
extern "pending_module_capture" func capture(var value)
class PendingOwner
    string text = "pending owner"
    destroy()
        observe(3, self.text)
    end
end
func callbackThen(future<int> input, int mode) as future<int>
    PendingOwner owner = PendingOwner()
    func() firstCleanup = func()
        observe(1, owner.text)
        if mode == 2 then
            capture(owner)
        end
    end
    func() secondCleanup = func()
        observe(2, owner.text)
    end
    future<int> first = input.finally(firstCleanup)
    return first.finally(secondCleanup)
end
export "pending_module_keep" func keep(int mode)
    future<int> result = callbackThen(pendingInput(), mode)
    if mode == 1 or mode >= 4 then
        capture(result)
    end
end
func main(...) as int
    return 0
end
