extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()
func stop(WalkEntry entry) as int
    return file.walkStop
end
func skipError(WalkError error) as int
    return file.walkSkipError
end
string directory = dir.temp("","fs-walk-oom-","")
file.writeBytes(path.join(directory,"a.txt"),b"abc")
try
    for operation in range(4)
        int failures = 0
        int successes = 0
        for point in range(128)
            bool caught = false
            assert failAfter(uint64(point))
            try
                if operation == 0 then
                    file.walk(directory,stop)
                elseif operation == 1 then
                    dir.entries(directory)
                elseif operation == 2 then
                    dir.glob(directory,"*")
                else
                    file.walk(path.join(directory,"missing"),stop,skipError)
                end
            catch MemoryError
                caught = true
            end
            bool triggered = failTriggered()
            failClear()
            if caught != triggered then print(operation,point,caught,triggered) end
            assert caught == triggered
            if caught then failures += 1 else successes += 1 end
        end
        assert failures > 0 and successes > 0
    end
finally
    failClear()
    dir.delete(directory)
end
print("fs walk allocation ok")
