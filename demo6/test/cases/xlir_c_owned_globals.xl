extern "c_owned_text" @no_raise func nativeText() as point
extern "c_owned_binary" @no_raise func nativeBytes() as point
extern "c_owned_release" @no_raise func nativeFree(point data)
extern "c_owned_released" @no_raise func released() as int
extern "c_owned_text_is_original" @no_raise func original(string text) as bool
extern "c_owned_binary_span_original" @no_raise func originalBytes(cbytes data) as bool
func make() as cstring
    return cstring.take(nativeText(),nativeFree)
end
func makeBytes() as cbytes
    return cbytes.take(nativeBytes(),4,nativeFree)
end
func maybeText(bool present) as cstring?
    return present ? make() : null
end
func maybeBytes(bool present) as cbytes?
    return present ? makeBytes() : null
end
auto text=make()
assert not original(text) and text=="hello" and released()==1
auto data=makeBytes()
assert not originalBytes(data) and data==b"\0\xff\x11*" and released()==2
string typed=make()
assert not original(typed) and typed=="hello" and released()==3
bytes typedData=makeBytes()
assert not originalBytes(typedData) and typedData==data and released()==4
auto optional=maybeText(true)
assert not original(optional ?? "bad") and released()==5
auto optionalData=maybeBytes(true)
assert not originalBytes(optionalData ?? b"bad") and released()==6
auto absent=maybeText(false)
auto absentData=maybeBytes(false)
assert absent==null and absentData==null and released()==6
const string constant=make()
assert not original(constant) and constant=="hello" and released()==7
func pair() as (cstring,cbytes)
    return make(),makeBytes()
end
auto pairedText,pairedData=pair()
assert not original(pairedText) and not originalBytes(pairedData) and released()==9
assert pairedText==text and pairedData==data
func optionalPair(bool present) as (cstring?,cbytes?)
    return maybeText(present),maybeBytes(present)
end
auto pairedOptional,pairedOptionalData=optionalPair(true)
assert not original(pairedOptional ?? "bad") and not originalBytes(pairedOptionalData ?? b"bad")
assert released()==11
auto pairedAbsent,pairedAbsentData=optionalPair(false)
assert pairedAbsent==null and pairedAbsentData==null and released()==11
func update()
    text=make()
    data=makeBytes()
    pairedText,pairedData=pair()
end
update()
assert not original(text) and not originalBytes(data) and released()==15
assert pairedText==text and pairedData==data

if true
    auto localText,localData=pair()
    assert original(localText) and originalBytes(localData)
end
assert released()==17
