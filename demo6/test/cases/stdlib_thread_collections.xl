func collectionWorker() as int
    return 42
end
func main(...) as int
    auto worker = thread(collectionWorker)
    auto stack = Stack::<thread>()
    assert(stack.push(worker))
    auto popped = stack.pop()
    assert(popped.wait() and popped.exitCode() == 42)
    auto optional = Stack::<thread?>()
    assert(optional.push(null) and optional.pop() == null)
    assert(optional.push(worker))
    auto maybe = optional.pop()
    assert(maybe != null)
    if maybe != null then assert(maybe.wait() and maybe.exitCode() == 42) end
    auto tree = AvlTree::<int, thread>()
    assert(tree.set(1, worker))
    auto copy = tree.clone()
    thread returned
    assert(copy.getInto(1, returned) and returned.wait() and returned.exitCode() == 42)
    assert(copy.equals(tree))
    auto values = tree.values()
    // Extract an owned shell: Thread is still not language-copyable.
    auto projected = values.pop()
    assert(projected.wait() and projected.exitCode() == 42)
    auto nested = AvlTree::<int, Stack<thread>>()
    assert(stack.push(worker) and nested.set(1, stack))
    auto inner = Stack::<thread>()
    assert(nested.getInto(1, inner))
    auto twice = inner.pop()
    assert(twice.wait() and twice.exitCode() == 42)
    auto q1 = SpscQueue::<thread>(2)
    auto q2 = MpscQueue::<thread>(2)
    auto q3 = MpmcQueue::<thread>(2)
    assert(q1.tryPush(worker) == queueStatus.ok)
    assert(q2.tryPush(worker) == queueStatus.ok)
    assert(q3.tryPush(worker) == queueStatus.ok)
    auto status1, one = q1.tryPop()
    auto status2, two = q2.tryPop()
    auto status3, three = q3.tryPop()
    assert(status1 == queueStatus.ok and one != null)
    assert(status2 == queueStatus.ok and two != null)
    assert(status3 == queueStatus.ok and three != null)
    if one != null then assert(one.wait() and one.exitCode() == 42) end
    if two != null then assert(two.wait() and two.exitCode() == 42) end
    if three != null then assert(three.wait() and three.exitCode() == 42) end
    return 0
end
