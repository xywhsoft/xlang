import tcc

println("before tcc context")
TccContext ctx = tcc.Context()
string source = "#include <stddef.h>\n#include <stdbool.h>\ntypedef struct xrt_net_future xfuture;\ntypedef struct xrt_web_app xwebapp;\ntypedef struct xrt_web_server xwebserver;\ntypedef struct xrt_web_request xwebrequest;\ntypedef struct xrt_web_response xwebresponse;\nbool xrtWebResponseReserveBody(xwebresponse* pResp, size_t iCap);\nbool xrtWebResponseAppendBody(xwebresponse* pResp, const void* pData, size_t iLen);\nbool xrtWebResponseAppendText(xwebresponse* pResp, const char* sText);\nbool xrtWebAppStreamRouteAsync(xwebapp* pApp, unsigned int iMethodMask, const char* sPattern, bool (*pBegin)(xwebrequest* pReq, void* pUserData), bool (*pBody)(xwebrequest* pReq, const void* pData, size_t iLen, void* pUserData), xfuture* (*pEndAsync)(xwebrequest* pReq, void* pUserData), void* pUserData);\nbool xrtWebServerStreamRouteAsync(xwebserver* pServer, unsigned int iMethodMask, const char* sPattern, bool (*pBegin)(xwebrequest* pReq, void* pUserData), bool (*pBody)(xwebrequest* pReq, const void* pData, size_t iLen, void* pUserData), xfuture* (*pEndAsync)(xwebrequest* pReq, void* pUserData), void* pUserData);\nint main(void){ return (xrtWebResponseReserveBody && xrtWebResponseAppendBody && xrtWebResponseAppendText && xrtWebAppStreamRouteAsync && xrtWebServerStreamRouteAsync) ? 0 : 1; }\n"
assert ctx.compileString(source) == 0, "xrt response append symbols should compile"
assert ctx.run() == 0, "xrt response append symbols should run"
println("after tcc context")
