func main(...) as int
    bool caughtDivision = false
    bool caughtModulo = false
    bool caughtOverflow = false
    bool caughtNegativeShift = false
    bool caughtWideShift = false

    int zero = 0
    try
        int value = 10 / zero
        assert value == 0, "checked division must not continue"
    catch ZeroDivisionError e
        caughtDivision = e.kind == "ZeroDivisionError"
    end

    try
        int value = 10 % zero
        assert value == 0, "checked modulo must not continue"
    catch ArithmeticError e
        caughtModulo = e.kind == "ZeroDivisionError"
    end

    int minimum = -9223372036854775807 - 1
    int negativeOne = -1
    try
        int value = minimum / negativeOne
        assert value == 0, "checked overflow must not continue"
    catch OverflowError e
        caughtOverflow = e.kind == "OverflowError"
    end

    int negativeShift = -1
    try
        int value = 1 << negativeShift
        assert value == 0, "negative shift must not continue"
    catch RangeError e
        caughtNegativeShift = e.kind == "RangeError"
    end

    int wideShift = 64
    try
        int value = 1 >> wideShift
        assert value == 0, "wide shift must not continue"
    catch RangeError e
        caughtWideShift = e.kind == "RangeError"
    end

    assert caughtDivision and caughtModulo and caughtOverflow
    assert caughtNegativeShift and caughtWideShift

    int quotient = 42 / 5
    int remainder = 42 % 5
    int shiftedLeft = 3 << 4
    int shiftedRight = shiftedLeft >> 2
    assert quotient == 8 and remainder == 2
    assert shiftedLeft == 48 and shiftedRight == 12

    int compound = 29
    compound /= 4
    compound %= 5
    assert compound == 2

    int8 narrowSigned = int8(-2)
    int8 narrowCount = int8(1)
    int8 narrowShifted = narrowSigned >> narrowCount
    assert narrowShifted == -1

    uint8 narrowUnsigned = uint8(255)
    uint8 unsignedCount = uint8(1)
    uint8 unsignedShifted = narrowUnsigned >> unsignedCount
    assert unsignedShifted == 127

    uint64 maximum = uint64(18446744073709551615)
    uint64 divisor = uint64(3)
    uint64 unsignedQuotient = maximum / divisor
    uint64 unsignedRemainder = maximum % divisor
    assert unsignedQuotient == uint64(6148914691236517205)
    assert unsignedRemainder == uint64(0)

    println("xlir_checked_integer_arithmetic_abi ok")
    return 0
end
