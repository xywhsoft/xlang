func main(...) as int
    Stack<int> numbers = Stack::<int>()
    assert(numbers.reserve(8))
    assert(numbers.capacity() >= 8)
    assert(numbers.push(10))
    assert(numbers.push(20))
    assert(numbers.count() == 2)
    Stack<int> numbersClone = numbers.clone()
    assert(numbers.equals(numbersClone))
    assert(numbersClone.push(30))
    assert(not numbers.equals(numbersClone))

    int number = 0
    assert(numbers.peekInto(number))
    assert(number == 20)
    assert(numbers.peekAtInto(1, number))
    assert(number == 10)
    assert(not numbers.peekAtInto(-1, number))
    assert(numbers.popInto(number))
    assert(number == 20)
    assert(numbers.popInto(number))
    assert(number == 10)
    assert(not numbers.popInto(number))
    assert(numbers.trim())
    assert(numbers.capacity() == 0)

    Stack<int8> tinyNumbers = Stack::<int8>()
    int8 tiny = int8(-7)
    int8 tinyResult = int8(0)
    assert(tinyNumbers.push(tiny))
    assert(tinyNumbers.popInto(tinyResult))
    assert(tinyResult == tiny)

    Stack<float32> reals = Stack::<float32>()
    float32 real = float32(1.25)
    float32 realResult = float32(0.0)
    assert(reals.push(real))
    assert(reals.popInto(realResult))
    assert(realResult == real)

    Stack<bool> flags = Stack::<bool>()
    bool flag = false
    assert(flags.push(true))
    assert(flags.popInto(flag))
    assert(flag)

    AvlTree<string, int> scores = AvlTree::<string, int>()
    assert(scores.set("bob", 70))
    assert(scores.set("alice", 90))
    assert(scores.set("bob", 80))
    assert(scores.count() == 2)
    assert(scores.contains("alice"))
    assert(scores.getInto("bob", number))
    assert(number == 80)
    AvlTree<string, int> scoresClone = scores.clone()
    assert(scores.equals(scoresClone))
    AvlTree<string, int> scorePatch = AvlTree::<string, int>()
    assert(scorePatch.set("bob", 81))
    assert(scorePatch.set("carol", 75))
    assert(scoresClone.merge(scorePatch, false))
    assert(scoresClone.getInto("bob", number))
    assert(number == 80)
    assert(scoresClone.merge(scorePatch))
    assert(scoresClone.getInto("bob", number))
    assert(number == 81)
    assert(not scores.equals(scoresClone))

    string boundaryName = ""
    int boundaryScore = 0
    assert(scores.firstInto(boundaryName, boundaryScore))
    assert(boundaryName == "alice")
    assert(boundaryScore == 90)
    assert(scores.lastInto(boundaryName, boundaryScore))
    assert(boundaryName == "bob")
    assert(boundaryScore == 80)
    assert(scores.lowerBoundInto("amy", boundaryName, boundaryScore))
    assert(boundaryName == "bob")
    assert(scores.upperBoundInto("alice", boundaryName, boundaryScore))
    assert(boundaryName == "bob")

    array<string> names = scores.keys()
    assert(names.length == 2)
    assert(names[0] == "alice")
    assert(names[1] == "bob")
    assert(scores.takeInto("alice", number))
    assert(number == 90)
    assert(not scores.contains("alice"))
    assert(scores.trimTo(1) >= 0)
    assert(scores.trim() >= 0)

    AvlTree<int, int> sameTypeTree = AvlTree::<int, int>()
    assert(sameTypeTree.set(1, 10))
    int aliasedOutput = 0
    assert(not sameTypeTree.firstInto(aliasedOutput, aliasedOutput))

    SpscQueue<int> spsc = SpscQueue::<int>(4)
    assert(spsc.capacity() >= 4)
    assert(spsc.tryPush(1))
    assert(spsc.tryPopInto(number))
    assert(number == 1)
    spsc.close()
    assert(spsc.isDrained())
    assert(spsc.reset())
    assert(not spsc.isClosed())
    assert(spsc.tryPush(11))
    assert(spsc.tryPopInto(number))
    assert(number == 11)
    array<int> spscInput = array[1, 2, 3]
    array<int> spscOutput = array[99, 100]
    assert(spsc.pushBatch(spscInput) == 3)
    assert(spsc.popBatchInto(spscOutput, 2) == 2)
    assert(spscOutput.length == 2)
    assert(spscOutput[0] == 1)
    assert(spscOutput[1] == 2)
    assert(spsc.popBatchInto(spscOutput, 4) == 1)
    assert(spscOutput.length == 1)
    assert(spscOutput[0] == 3)
    assert(spsc.popBatchInto(spscOutput, -1) == -1)
    assert(spscOutput.length == 1)

    MpscQueue<int> mpsc = MpscQueue::<int>(4)
    assert(mpsc.capacity() >= 4)
    assert(mpsc.tryPush(2))
    assert(mpsc.tryPopInto(number))
    assert(number == 2)
    assert(mpsc.pushBatch(spscInput) == 3)
    assert(mpsc.popBatchInto(spscOutput, 4) == 3)
    assert(spscOutput[2] == 3)

    MpmcQueue<string> messages = MpmcQueue::<string>(4)
    assert(messages.capacity() >= 4)
    assert(messages.tryPush("hello"))
    string message = "old"
    assert(messages.tryPopInto(message))
    assert(message == "hello")
    array<string> messageInput = array["one", "two", "three"]
    array<string> messageOutput = array["old"]
    assert(messages.pushBatch(messageInput) == 3)
    assert(messages.popBatchInto(messageOutput, 8) == 3)
    assert(messageOutput.length == 3)
    assert(messageOutput[0] == "one")
    assert(messageOutput[2] == "three")

    WaitQueue<int> waits = WaitQueue::<int>(4)
    assert(waits.capacity() >= 4)
    assert(not waits.popTimeoutInto(number, -1))
    assert(not waits.popTimeoutInto(number, 1))
    assert(waits.tryPush(42))
    assert(waits.popInto(number))
    assert(number == 42)
    waits.close()
    assert(waits.isClosed())
    assert(waits.isDrained())

    println("stdlib special collections ok")
    return 0
end
