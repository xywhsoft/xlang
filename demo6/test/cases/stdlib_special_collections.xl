func main(...) as int
    Stack<int> numbers = Stack::<int>()
    assert(numbers.reserve(8))
    assert(numbers.capacity() >= 8)
    assert(numbers.push(10))
    assert(numbers.push(20))
    assert(numbers.count() == 2)
    Stack<int> numbersClone = numbers.clone()
    assert(numbers.equals(numbersClone))
    assert(numbersClone.push(30))
    assert(not numbers.equals(numbersClone))

    int number = numbers.peek()
    assert(number == 20)
    number = numbers.peekAt(1)
    assert(number == 10)
    int refused = 0
    try
        numbers.peekAt(-1)
    catch RangeError failure
        refused += 1
    end
    assert(refused == 1 and number == 10)
    number = numbers.pop()
    assert(number == 20)
    number = numbers.pop()
    assert(number == 10)
    auto hasNumber, absentNumber = numbers.tryPop()
    assert(not hasNumber and absentNumber == null and number == 10)
    assert(numbers.trim())
    assert(numbers.capacity() == 0)

    Stack<int8> tinyNumbers = Stack::<int8>()
    int8 tiny = int8(-7)
    int8 tinyResult = int8(0)
    assert(tinyNumbers.push(tiny))
    tinyResult = tinyNumbers.pop()
    assert(tinyResult == tiny)

    Stack<float32> reals = Stack::<float32>()
    float32 real = float32(1.25)
    float32 realResult = float32(0.0)
    assert(reals.push(real))
    realResult = reals.pop()
    assert(realResult == real)

    Stack<bool> flags = Stack::<bool>()
    bool flag = false
    assert(flags.push(true))
    flag = flags.pop()
    assert(flag)

    OrderedMap<string, int> scores = OrderedMap::<string, int>()
    assert(scores.set("bob", 70))
    assert(scores.set("alice", 90))
    assert(scores.set("bob", 80))
    assert(scores.count() == 2)
    assert(scores.contains("alice"))
    number = scores.get("bob")
    assert(number == 80)
    OrderedMap<string, int> scoresClone = scores.clone()
    assert(scores.equals(scoresClone))
    OrderedMap<string, int> scorePatch = OrderedMap::<string, int>()
    assert(scorePatch.set("bob", 81))
    assert(scorePatch.set("carol", 75))
    assert(scoresClone.merge(scorePatch, false))
    number = scoresClone.get("bob")
    assert(number == 80)
    assert(scoresClone.merge(scorePatch))
    number = scoresClone.get("bob")
    assert(number == 81)
    assert(not scores.equals(scoresClone))

    string boundaryName = ""
    int boundaryScore = 0
    boundaryName, boundaryScore = scores.first()
    assert(boundaryName == "alice")
    assert(boundaryScore == 90)
    boundaryName, boundaryScore = scores.last()
    assert(boundaryName == "bob")
    assert(boundaryScore == 80)
    boundaryName, boundaryScore = scores.lowerBound("amy")
    assert(boundaryName == "bob")
    boundaryName, boundaryScore = scores.upperBound("alice")
    assert(boundaryName == "bob")

    array<string> names = scores.keys()
    assert(names.length == 2)
    assert(names[0] == "alice")
    assert(names[1] == "bob")
    number = scores.take("alice")
    assert(number == 90)
    assert(not scores.contains("alice"))
    assert(scores.trimTo(1) >= 0)
    assert(scores.trim() >= 0)

    OrderedMap<int, int> sameTypeTree = OrderedMap::<int, int>()
    assert(sameTypeTree.set(1, 10))
    int aliasedOutput = 0
    auto independentKey, independentValue = sameTypeTree.first()
    assert(independentKey == 1 and independentValue == 10 and aliasedOutput == 0)

    SpscQueue<int> spsc = SpscQueue::<int>(4)
    assert(spsc.capacity() >= 4)
    assert(spsc.tryPush(1) == queueStatus.ok)
    auto firstStatus, first = spsc.tryPop()
    assert(firstStatus == queueStatus.ok and first != null and first == 1)
    spsc.close()
    assert(spsc.isDrained())
    assert(spsc.reset())
    assert(not spsc.isClosed())
    assert(spsc.tryPush(11) == queueStatus.ok)
    auto secondStatus, second = spsc.tryPop()
    assert(secondStatus == queueStatus.ok and second != null and second == 11)
    array<int> spscInput = array[1, 2, 3]
    auto pushStatus, pushed = spsc.pushBatch(spscInput)
    assert(pushStatus == queueStatus.ok and pushed == 3)
    auto popStatus, spscOutput = spsc.popBatch(2)
    assert(popStatus == queueStatus.ok)
    assert(spscOutput.length == 2)
    assert(spscOutput[0] == 1)
    assert(spscOutput[1] == 2)
    auto lastStatus, lastOutput = spsc.popBatch(4)
    assert(lastStatus == queueStatus.ok and lastOutput.length == 1 and lastOutput[0] == 3)
    bool rejectedBatch = false
    try
        auto invalidStatus, invalidOutput = spsc.popBatch(-1)
    catch RangeError
        rejectedBatch = true
    end
    assert(rejectedBatch and spscOutput.length == 2 and lastOutput[0] == 3)

    MpscQueue<int> mpsc = MpscQueue::<int>(4)
    assert(mpsc.capacity() >= 4)
    assert(mpsc.tryPush(2) == queueStatus.ok)
    auto mpscStatus, mpscItem = mpsc.tryPop()
    assert(mpscStatus == queueStatus.ok and mpscItem != null and mpscItem == 2)
    auto mpscPushStatus, mpscPushed = mpsc.pushBatch(spscInput)
    assert(mpscPushStatus == queueStatus.ok and mpscPushed == 3)
    auto mpscPopStatus, mpscOutput = mpsc.popBatch(4)
    assert(mpscPopStatus == queueStatus.ok and mpscOutput.length == 3 and mpscOutput[2] == 3)

    MpmcQueue<string> messages = MpmcQueue::<string>(4)
    assert(messages.capacity() >= 4)
    assert(messages.tryPush("hello") == queueStatus.ok)
    auto messageStatus, message = messages.tryPop()
    assert(messageStatus == queueStatus.ok and message != null and message == "hello")
    array<string> messageInput = array["one", "two", "three"]
    auto messagePushStatus, messagePushed = messages.pushBatch(messageInput)
    assert(messagePushStatus == queueStatus.ok and messagePushed == 3)
    auto messagePopStatus, messageOutput = messages.popBatch(8)
    assert(messagePopStatus == queueStatus.ok)
    assert(messageOutput.length == 3)
    assert(messageOutput[0] == "one")
    assert(messageOutput[2] == "three")

    WaitQueue<int> waits = WaitQueue::<int>(4)
    assert(waits.capacity() >= 4)
    assert(not waits.popTimeoutInto(number, -1))
    assert(not waits.popTimeoutInto(number, 1))
    assert(waits.tryPush(42))
    assert(waits.popInto(number))
    assert(number == 42)
    waits.close()
    assert(waits.isClosed())
    assert(waits.isDrained())

    println("stdlib special collections ok")
    return 0
end
