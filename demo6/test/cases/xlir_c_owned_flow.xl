extern "c_owned_text" @no_raise func nativeText() as point
extern "c_owned_binary" @no_raise func nativeBytes() as point
extern "c_owned_release" @no_raise func nativeFree(point data)
extern "c_owned_text_is_original" @no_raise func original(string text) as bool
extern "c_owned_released" @no_raise func released() as int
func identity(string x) as string
    return x
end
func bin(bytes x, int offset = 1) as int
    return x.length + x[offset]
end
func recursive(string x, int depth = 0) as string
    if depth == 0 then return x end
    return recursive(x, depth - 1)
end
func identityBytes(bytes x) as bytes
    return x
end
func makeBytes() as cbytes
    return cbytes.take(nativeBytes(), 4, nativeFree)
end
extern "c_owned_binary_span_original" @no_raise func originalBytes(cbytes data) as bool
func make() as cstring
    return cstring.take(nativeText(), nativeFree)
end
func checkFlow()
    string a = identity(make())
    auto b = a
    assert original(a) and original(b)
    a = "123"
    assert a == "123" and original(b) and released() == 0
    assert original(recursive(b, depth = 2))
    b = "456"
    assert released() == 1
    bytes c = makeBytes()
    assert bin(c) == 259 and bin(x = c, offset = 1) == 259
    assert originalBytes(identityBytes(c))
end
checkFlow()
assert released() == 2
