func makeValues() as array<int>
    return array[1, 2, 3]
end

func makeNames() as list<string>
    return list[0: "a", 2: "b"]
end

func makeIds() as set<int>
    return set{1, 2, 3}
end

func makeScores() as dict<int>
    return dict{"a": 1, "b": 2}
end

func firstValueFromArray() as int
    for value in makeValues()
        return value
    end
    return 0
end

func firstScoreFromDict() as int
    for key, score in makeScores()
        return score
    end
    return 0
end

func firstNameFromList() as string
    for index, name in makeNames()
        return name
    end
    return ""
end

func firstIdFromSet() as int
    for id in makeIds()
        return id
    end
    return 0
end

func nestedScoreFromDict() as int
    for outerKey, outerScore in makeScores()
        for innerKey, innerScore in makeScores()
            return outerScore + innerScore
        end
    end
    return 0
end

class ArrayMaker
    func() as array<int> values
end

int arrayTotal = 0
for value in makeValues()
    arrayTotal = arrayTotal + value
end
assert arrayTotal == 6, "returned array for-in failed"

int arrayContinueBreakValue = 0
for value in makeValues()
    if value == 1 then
        continue
    end
    arrayContinueBreakValue = value
    break
end
assert arrayContinueBreakValue == 2, "returned typed array continue/break cleanup failed"

int arrayThrowState = 0
try
    for value in makeValues()
        throw "typed array loop boom"
    end
catch e
    if e.message == "typed array loop boom" then
        arrayThrowState = 7
    end
end
assert arrayThrowState == 7, "returned typed array throw cleanup failed"

int arrayReturnValue = firstValueFromArray()
assert arrayReturnValue == 1, "returned typed array return cleanup failed"

int listIndexTotal = 0
int listCount = 0
for index, name in makeNames()
    listIndexTotal = listIndexTotal + index
    if name == "a" or name == "b" then
        listCount = listCount + 1
    end
end
assert listIndexTotal == 2, "returned list index failed"
assert listCount == 2, "returned list value failed"

int listContinueBreakTotal = 0
for index, name in makeNames()
    if index == 0 then
        continue
    end
    listContinueBreakTotal = index
    break
end
assert listContinueBreakTotal == 2, "returned typed list continue/break cleanup failed"

int listThrowState = 0
try
    for index, name in makeNames()
        throw "typed list loop boom"
    end
catch e
    if e.message == "typed list loop boom" then
        listThrowState = 7
    end
end
assert listThrowState == 7, "returned typed list throw cleanup failed"

string listReturnName = firstNameFromList()
assert listReturnName == "a" or listReturnName == "b", "returned typed list return cleanup failed"

int setTotal = 0
for id in makeIds()
    setTotal = setTotal + id
end
assert setTotal == 6, "returned set for-in failed"

int setContinueBreakValue = 0
for id in makeIds()
    if id == 1 then
        continue
    end
    setContinueBreakValue = id
    break
end
assert setContinueBreakValue > 1, "returned typed set continue/break cleanup failed"

int setThrowState = 0
try
    for id in makeIds()
        throw "typed set loop boom"
    end
catch e
    if e.message == "typed set loop boom" then
        setThrowState = 7
    end
end
assert setThrowState == 7, "returned typed set throw cleanup failed"

int setReturnId = firstIdFromSet()
assert setReturnId > 0, "returned typed set return cleanup failed"

int dictTotal = 0
for key, score in makeScores()
    dictTotal = dictTotal + score
end
assert dictTotal == 3, "returned dict for-in failed"

int dictContinueTotal = 0
for key, score in makeScores()
    if key == "a" then
        continue
    end
    dictContinueTotal = dictContinueTotal + score
end
assert dictContinueTotal == 2, "returned typed dict continue cleanup failed"

int dictThrowState = 0
try
    for key, score in makeScores()
        if key == "a" then
            throw "typed dict loop boom"
        end
        dictThrowState = dictThrowState + score
    end
catch e
    if e.message == "typed dict loop boom" then
        dictThrowState = 7
    end
end
assert dictThrowState == 7, "returned typed dict throw cleanup failed"

int dictBreakCount = 0
for key, score in makeScores()
    dictBreakCount = dictBreakCount + 1
    break
end
assert dictBreakCount == 1, "returned typed dict break cleanup failed"

int dictReturnScore = firstScoreFromDict()
assert dictReturnScore > 0, "returned typed dict return cleanup failed"

int nestedDictTotal = 0
for outerKey, outerScore in makeScores()
    for innerKey, innerScore in makeScores()
        if innerKey == "a" then
            continue
        end
        nestedDictTotal = nestedDictTotal + outerScore * 10 + innerScore
        break
    end
end
assert nestedDictTotal == 34, "nested returned typed dict continue/break cleanup failed"

int nestedDictThrowState = 0
try
    for outerKey, outerScore in makeScores()
        for innerKey, innerScore in makeScores()
            throw "nested typed dict loop boom"
        end
    end
catch e
    if e.message == "nested typed dict loop boom" then
        nestedDictThrowState = 7
    end
end
assert nestedDictThrowState == 7, "nested returned typed dict throw cleanup failed"

int nestedDictReturnScore = nestedScoreFromDict()
assert nestedDictReturnScore > 0, "nested returned typed dict return cleanup failed"

int breakTotal = 0
for value in makeValues()
    if value == 3 then
        break
    end
    breakTotal = breakTotal + value
end
assert breakTotal == 3, "returned typed container break cleanup failed"

ArrayMaker maker
maker.values = makeValues

array<int> memberValues = maker.values()
int memberTotal = 0
for value in memberValues
    memberTotal = memberTotal + value
end
assert memberTotal == 6, "member func returned array declaration failed"

memberValues = maker.values()
int memberAssignedTotal = 0
for value in memberValues
    memberAssignedTotal = memberAssignedTotal + value
end
assert memberAssignedTotal == 6, "member func returned array assignment failed"

int memberDirectTotal = 0
for value in maker.values()
    memberDirectTotal = memberDirectTotal + value
end
assert memberDirectTotal == 6, "member func returned array direct for-in failed"
