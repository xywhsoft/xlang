int nested_string_finally_trace = 0

func nested_string_return_through_finally() as string
    string text = "nested-managed"
    try
        try
            return text
        finally
            nested_string_finally_trace = nested_string_finally_trace * 10 + 1
        end
    finally
        nested_string_finally_trace = nested_string_finally_trace * 10 + 2
    end
end

func nested_string_return_through_finally_check() as int
    string value = nested_string_return_through_finally()
    if value == "nested-managed" then
        return nested_string_finally_trace
    end
    return 0
end


if false
    nested_string_return_through_finally_check()
end
