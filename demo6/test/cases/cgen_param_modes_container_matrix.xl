func mutateList(list<int> values)
    values[1] = 2
end

func mutateListCopy(byval list<int> values)
    values[2] = 3
end

func mutateSet(set<int> values)
    values.add(2)
end

func mutateSetCopy(byval set<int> values)
    values.add(3)
end

func mutateDict(dict<int> values)
    values["b"] = 2
end

func mutateDictCopy(byval dict<int> values)
    values["c"] = 3
end

func main(...) as int
    list<int> sparse = list[0: 1]
    list<int> sparseAlias = sparse
    mutateList(sparseAlias)
    assert sparse[1] == 2
    mutateListCopy(sparse)
    assert sparse.contains(3)

    set<int> unique = set{1}
    set<int> uniqueAlias = unique
    mutateSet(uniqueAlias)
    assert unique.contains(2)
    mutateSetCopy(unique)
    assert unique.contains(3)

    dict<int> table = dict{"a": 1}
    dict<int> tableAlias = table
    mutateDict(tableAlias)
    assert table["b"] == 2
    mutateDictCopy(table)
    assert "c" in table
    return 0
end
