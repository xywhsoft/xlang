import siphash



func main(...) as int
    // 准备 16 字节密钥。
    Buffer key = Buffer()
    key.append("0123456789abcdef")

    // 一次性 64 位哈希：Buffer 与 string 重载一致。
    Buffer data = Buffer()
    data.append("hello")
    int h64 = siphash.hash64(data, key)
    if siphash.hash64("hello", key) != h64 then
        return 1
    end

    // 64 位 hex 输出 = 16 字符。
    string hex64 = siphash.hash64Hex(data, key)
    if string.len(hex64) != 16 then
        return 2
    end

    // 128 位 hex 输出 = 32 字符。
    string hex128 = siphash.hash128Hex(data, key)
    if string.len(hex128) != 32 then
        return 3
    end

    // 不同密钥产生不同结果。
    Buffer key2 = Buffer()
    key2.append("fedcba9876543210")
    if siphash.hash64(data, key2) == h64 then
        return 4
    end

    // 流式哈希器：分段 update 与一次性结果一致。
    auto hasher = siphash.hasher(key)
    hasher.update("hel")
    hasher.update("lo")
    if hasher.digest64() != h64 then
        return 5
    end
    if hasher.digest64Hex() != hex64 then
        return 6
    end
    if hasher.inputBytes != 5 then
        return 7
    end

    // 流式 128 位摘要与一次性一致。
    if hasher.digest128Hex() != hex128 then
        return 8
    end

    // reset 复位。
    hasher.reset()
    hasher.update("hello")
    if hasher.digest64() != h64 then
        return 9
    end

    // clone 独立副本。
    auto h1 = siphash.hasher(key)
    h1.update("hel")
    auto h2 = h1.clone()
    h1.update("lo")
    h2.update("xx")
    if h1.digest64() != h64 then
        return 10
    end
    if h2.digest64() == h64 then
        return 11
    end

    // 文件哈希。
    string path = "tmp/extlib_siphash_test.bin"
    file.writeBytes(path, data)
    if siphash.hashFile64(path, key) != h64 then
        return 12
    end
    file.delete(path)

    // 不存在的文件抛出 FileError。
    bool missing = false
    try
        siphash.hashFile64("tmp/extlib_siphash_missing.bin", key)
    catch FileError e
        missing = true
    end
    if not missing then
        return 13
    end

    // 非法限额抛出 ValueError。
    bool badLimit = false
    try
        siphash.hasher(key, 0)
    catch ValueError e
        badLimit = true
    end
    if not badLimit then
        return 14
    end

    // digestBytes / hashBytes 返回 Buffer 长度正确。
    Buffer raw64 = siphash.hash64Bytes(data, key)
    if raw64.len() != 8 then
        return 15
    end
    Buffer raw128 = siphash.hash128Bytes(data, key)
    if raw128.len() != 16 then
        return 16
    end
    auto hb = siphash.hasher(key)
    hb.update("hello")
    if hb.digest64Bytes().len() != 8 then
        return 17
    end
    if hb.digest128Bytes().len() != 16 then
        return 18
    end

    return 0
end
