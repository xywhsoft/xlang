import terraform_state

func main(...) as int
    // Resource types
    assert terraform_state.resourceType(0) == "aws_instance", "res aws_instance"
    assert terraform_state.resourceType(5) == "kubernetes_deployment", "res k8s"

    // State actions
    assert terraform_state.stateAction(0) == "create", "action create"
    assert terraform_state.stateAction(3) == "delete", "action delete"
    assert terraform_state.stateAction(4) == "no-op", "action noop"

    // Backends
    assert terraform_state.backend(0) == "local", "backend local"
    assert terraform_state.backend(1) == "s3", "backend s3"

    // Lock info fields
    assert terraform_state.lockInfo(0) == "ID", "lock ID"
    assert terraform_state.lockInfo(3) == "Who", "lock Who"

    // Validate address
    assert terraform_state.validateAddress("aws_instance.web") == 1, "valid addr"
    assert terraform_state.validateAddress("invalid") == 0, "invalid addr"

    // State version
    assert terraform_state.stateVersion(5) == "4.5", "state ver"

    // Providers
    assert terraform_state.provider(0) == "hashicorp/aws", "provider aws"
    assert terraform_state.provider(3) == "hashicorp/kubernetes", "provider k8s"

    return 0
end
