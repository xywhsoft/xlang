extern "xlir_json_observe_lifetime" func observeLifetime(var target) as var
extern "xlir_json_lifetime_expired" func expired(var witness) as c_bool
extern "xrtClearError" func clearNativeError()
extern "xrtValuePointer" func boxedPointer(point target) as var

func writerScope() as var
    XlonWriter writer = XlonWriter()
    XlonWriter alias = writer
    var payload = {"a": 9}
    assert writer.beginArray()
    assert writer.writeNull()
    assert writer.writeBool(true)
    assert writer.writeInt(-9223372036854775807)
    assert writer.writeFloat(2.5)
    assert writer.writeString("中文")
    assert writer.writeTimeRaw(0)
    assert writer.writeValue(payload)
    assert writer.beginDict()
    assert writer.writeNull("null")
    assert writer.writeBool("bool", true)
    assert writer.writeInt("int", -9223372036854775807)
    assert writer.writeFloat("float", 2.5)
    assert writer.writeString("string", "中文")
    assert writer.writeTimeRaw("timeraw", 0)
    assert writer.writeValue("value", payload)
    assert writer.beginArray("array")
    assert writer.endArray()
    assert writer.beginList("list")
    assert writer.endList()
    assert writer.beginDict("dict")
    assert writer.endDict()
    assert writer.beginSet("set")
    assert writer.endSet()
    assert writer.endDict()
    assert alias.beginList()
    assert alias.writeNull(2)
    assert alias.writeBool(3, true)
    assert alias.writeInt(4, -9223372036854775807)
    assert alias.writeFloat(5, 2.5)
    assert alias.writeString(6, "中文")
    assert alias.writeTimeRaw(7, 0)
    assert alias.writeValue(8, payload)
    assert alias.beginArray(100)
    assert alias.endArray()
    assert alias.beginList(101)
    assert alias.endList()
    assert alias.beginDict(102)
    assert alias.endDict()
    assert alias.beginSet(103)
    assert alias.endSet()
    assert alias.endList()
    assert alias.beginSet()
    assert alias.writeInt(9223372036854775807)
    assert alias.endSet()
    assert alias.endArray()
    string text = alias.finish()
    assert string.contains(text, "intmap{")
    assert string.contains(text, "set[")
    assert string.contains(text, "time(")
    assert string.contains(text, "中文")
    assert string.contains(text, "-9223372036854775807")
    assert string.contains(text, "9223372036854775807")
    assert payload["a"] == 9
    return observeLifetime(writer)
end

for i in range(30)
    assert expired(writerScope())
end

XlonWriter pretty = xlon.writer(true)
assert pretty.beginArray()
assert pretty.writeInt(1)
assert pretty.endArray()
assert string.contains(pretty.finish(), "\n")
XlonWriter options = xlon.writer(xlon.options(pretty = true, ignoreUnsupportedEncode = true, ignoreUnsupportedDecode = true))
assert options.beginDict()
assert options.writeBool("ok", true)
assert options.writeValue("nested", {"keep": 1, "skip": boxedPointer(null)})
assert options.endDict()
string optionText = options.finish()
assert string.contains(optionText, "\n")
assert !string.contains(optionText, "skip")
XlonWriter invalid = XlonWriter()
assert invalid.beginArray()
assert !invalid.writeInt("key", 1)
assert invalid.finish() == ""
clearNativeError()
