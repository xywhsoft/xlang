// Fixed expected results for exact binary inputs and state snapshots.
func check_md5()
    assert cryptoLegacy.md5Hex("a\0b") == "70350f6027bce3713f6b76473084309b"
    assert cryptoLegacy.md5(b"a\0b") == codec.hexDecode("70350f6027bce3713f6b76473084309b")
    assert cryptoLegacy.md5Hex("a\0b", 999) == "70350f6027bce3713f6b76473084309b"
    assert cryptoLegacy.md5("a\0b", 1) == cryptoLegacy.md5("a")
    auto stream = cryptoLegacy.md5Stream()
    stream.update("a")
    auto clone = stream.clone()
    stream.update(b"\0b")
    assert stream.hex() == "70350f6027bce3713f6b76473084309b"
    assert stream.final() == cryptoLegacy.md5(b"a\0b")
    clone.update("c")
    assert clone.final() == cryptoLegacy.md5("ac")
    stream.reset()
    assert stream.final() == cryptoLegacy.md5(b"")
    auto buffer = Buffer("a\0b")
    assert cryptoLegacy.md5Buffer(buffer) == cryptoLegacy.md5(b"a\0b")
end

func check_sha1()
    assert cryptoLegacy.sha1Hex("a\0b") == "4a3dec2d1f8245280855c42db0ee4239f917fdb8"
    assert cryptoLegacy.sha1(b"a\0b") == codec.hexDecode("4a3dec2d1f8245280855c42db0ee4239f917fdb8")
    assert cryptoLegacy.sha1Hex("a\0b", 999) == "4a3dec2d1f8245280855c42db0ee4239f917fdb8"
    assert cryptoLegacy.sha1("a\0b", 1) == cryptoLegacy.sha1("a")
    auto stream = cryptoLegacy.sha1Stream()
    stream.update("a")
    auto clone = stream.clone()
    stream.update(b"\0b")
    assert stream.hex() == "4a3dec2d1f8245280855c42db0ee4239f917fdb8"
    assert stream.final() == cryptoLegacy.sha1(b"a\0b")
    clone.update("c")
    assert clone.final() == cryptoLegacy.sha1("ac")
    stream.reset()
    assert stream.final() == cryptoLegacy.sha1(b"")
    auto buffer = Buffer("a\0b")
    assert cryptoLegacy.sha1Buffer(buffer) == cryptoLegacy.sha1(b"a\0b")
end

func check_sha224()
    assert crypto.sha224Hex("a\0b") == "ae34ddad87465d32c8b179d811015ee23ef83620db929564d68d2991"
    assert crypto.sha224(b"a\0b") == codec.hexDecode("ae34ddad87465d32c8b179d811015ee23ef83620db929564d68d2991")
    assert crypto.sha224Hex("a\0b", 999) == "ae34ddad87465d32c8b179d811015ee23ef83620db929564d68d2991"
    assert crypto.sha224("a\0b", 1) == crypto.sha224("a")
    auto stream = crypto.sha224Stream()
    stream.update("a")
    auto clone = stream.clone()
    stream.update(b"\0b")
    assert stream.hex() == "ae34ddad87465d32c8b179d811015ee23ef83620db929564d68d2991"
    assert stream.final() == crypto.sha224(b"a\0b")
    clone.update("c")
    assert clone.final() == crypto.sha224("ac")
    stream.reset()
    assert stream.final() == crypto.sha224(b"")
    auto buffer = Buffer("a\0b")
    assert crypto.sha224Buffer(buffer) == crypto.sha224(b"a\0b")
end

func check_sha256()
