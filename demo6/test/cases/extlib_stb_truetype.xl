import stb_truetype

func main(...) as int
    if not stb_truetype.available() then return 1 end
    if string.len(stb_truetype.version()) == 0 then return 2 end
    // 不依赖系统字体；完整文件和字形操作由包内边界用例覆盖。
    bool rejected = false
    try
        stb_truetype.loadBytes(Buffer())
    catch ValueError error
        rejected = true
    end
    if not rejected then return 3 end
    return 0
end
