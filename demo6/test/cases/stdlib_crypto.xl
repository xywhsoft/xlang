// Ordinary crypto integration, fixed public material and valid operations only.
// Detailed algorithms, checked errors and key formats have separate fixtures.
assert cryptoLegacy.sha1Hex("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d"
assert crypto.sha256Hex("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
assert crypto.sha384Hex("abc") == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"
assert crypto.sha512Hex("abc") == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
assert crypto.sha256Hex("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
assert cryptoLegacy.sha1("abc").length == 20
assert crypto.sha256("abc").length == 32
assert crypto.sha384("abc").length == 48
assert crypto.sha512("abc").length == 64

string hmacText = "The quick brown fox jumps over the lazy dog"
assert crypto.hmacSha256Hex(b"key", hmacText) == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8"
assert crypto.hmacSha384Hex(b"key", hmacText) == "d7f4727e2c0b39ae0f1e40cc96f60242d5b7801841cea6fc592c5d3e1ae50700582a96cf35e1e554995fe4e03381c237"
assert crypto.hmacSha512Hex(b"key", hmacText) == "b42af09057bac1e2d41708e48a902e09b5ff7f12ab428a4fe86653c73dd248fb82f948a549f7b791a5b41915ee4d1ec3935357e4e2317250d0372afa2ebeeb3a"

bytes key16 = b"0123456789abcdef"
bytes key32 = b"0123456789abcdef0123456789abcdef"
bytes nonce = b"123456789012"
bytes rawNonce = b"123456789014"
bytes aad = b"meta"
string plain = "hello crypto"
auto chacha = ChaCha20Poly1305(key32)
auto aes128 = AesGcm(key16)
auto aes256 = AesGcm(key32)
bytes chachaCipher = chacha.seal(plain, nonce, aad)
bytes aes128Cipher = aes128.seal(plain, nonce, aad)
bytes aes256Cipher = aes256.seal(plain, nonce, aad)
assert chachaCipher.length == string.byteLen(plain) + 16
assert aes128Cipher.length == string.byteLen(plain) + 16
assert aes256Cipher.length == string.byteLen(plain) + 16
assert chacha.open(chachaCipher, nonce, aad) == encoding.encodeUtf8(plain)
assert aes128.open(aes128Cipher, nonce, aad) == encoding.encodeUtf8(plain)
assert aes256.open(aes256Cipher, nonce, aad) == encoding.encodeUtf8(plain)

bytes hkdf256 = crypto.hkdfSha256(b"key", b"salt", b"info", 32)
bytes hkdf384 = crypto.hkdfSha384(b"key", b"salt", b"info", 48)
assert hkdf256.length == 32 and hkdf384.length == 48
assert hkdf256 == crypto.hkdfSha256(b"key", b"salt", b"info", 32)
assert hkdf384 == crypto.hkdfSha384(b"key", b"salt", b"info", 48)
assert crypto.hkdfSha256(b"key", b"salt", b"info", 0) == b""
assert crypto.hkdfSha384(b"key", b"salt", b"info", 0) == b""
assert string.byteLen(crypto.randomHex(16)) == 32
assert crypto.randomHex(0) == ""
assert crypto.randomBytes(17).length == 17
assert crypto.randomBytes(0).length == 0

bytes binary = b"\x00\x01\x02\xff"
auto buffer = Buffer(binary)
assert cryptoLegacy.sha1Buffer(buffer) == cryptoLegacy.sha1(binary)
assert crypto.sha256Buffer(buffer) == crypto.sha256(binary)
assert crypto.sha384Buffer(buffer) == crypto.sha384(binary)
assert crypto.sha512Buffer(buffer) == crypto.sha512(binary)
assert crypto.sha256BufferHex(buffer) == "3d1f57c984978ef98a18378c8166c1cb8ede02c03eeb6aee7e2f121dfeee3e56"
bytes binaryKey = b"k\0ey"
assert crypto.hmacSha256BufferHex(binaryKey, buffer) == "ed8e5575104941f74e6529671b739d9da41ea7a01747e53ead88b999ee547360"
assert crypto.hmacSha384Buffer(binaryKey, buffer).length == 48
assert crypto.hmacSha512Buffer(binaryKey, buffer).length == 64
assert cryptoAdvanced.chacha20(key32, rawNonce, cryptoAdvanced.chacha20Buffer(key32, rawNonce, buffer, 7), 7) == binary

// A different nonce for this second message under each fixed test key.
bytes binaryNonce = b"123456789013"
assert chacha.open(chacha.seal(binary, binaryNonce, aad), binaryNonce, aad) == binary
assert aes128.open(aes128.seal(binary, binaryNonce, aad), binaryNonce, aad) == binary
assert aes256.open(aes256.seal(binary, binaryNonce, aad), binaryNonce, aad) == binary

auto s1 = cryptoLegacy.sha1Stream()
s1.update("a")
s1.update("bc")
assert s1.hex() == cryptoLegacy.sha1Hex("abc")
assert s1.hex() == cryptoLegacy.sha1Hex("abc")
assert s1.final() == cryptoLegacy.sha1(b"abc")
auto s256 = crypto.sha256Stream()
s256.update("a")
s256.update("bc")
assert s256.hex() == crypto.sha256Hex("abc")
assert s256.final() == crypto.sha256(b"abc")
auto binaryStream = crypto.sha256Stream()
binaryStream.updateBuffer(buffer)
assert binaryStream.final() == crypto.sha256(binary)
auto s384 = crypto.sha384Stream()
s384.update("ab")
s384.update("c")
assert s384.hex() == crypto.sha384Hex("abc")
auto s512 = crypto.sha512Stream()
s512.update("abc")
assert s512.hex() == crypto.sha512Hex("abc")
bytes streamCipher = cryptoAdvanced.chacha20(key32, rawNonce, plain)
assert streamCipher.length == string.byteLen(plain)
assert cryptoAdvanced.chacha20(key32, rawNonce, streamCipher) == encoding.encodeUtf8(plain)

auto ed = crypto.ed25519KeyPair()
assert ed.exportSeed().length == 32 and ed.publicKey.length == 32
assert crypto.ed25519PublicKey(ed.exportSeed()) == ed.publicKey
bytes signature = ed.sign("message")
assert signature.length == 64
assert crypto.ed25519Verify(ed.publicKey, "message", signature)
assert crypto.ed25519Sign(ed.exportSeed(), "message") == signature

auto x25519A = crypto.x25519KeyPair()
auto x25519B = crypto.x25519KeyPair()
assert x25519A.sharedSecret(x25519B.publicKey) == x25519B.sharedSecret(x25519A.publicKey)
assert x25519A.exportPrivate().length == 32
auto x448A = crypto.x448KeyPair()
auto x448B = crypto.x448KeyPair()
assert x448A.sharedSecret(x448B.publicKey) == x448B.sharedSecret(x448A.publicKey)
assert x448A.exportPrivate().length == 56
auto p256A = crypto.p256KeyPair()
auto p256B = crypto.p256KeyPair()
assert p256A.exportPrivate().length == 32 and p256A.publicKey.length == 65
assert p256A.sharedSecret(p256B.publicKey) == p256B.sharedSecret(p256A.publicKey)
auto p384A = crypto.p384KeyPair()
auto p384B = crypto.p384KeyPair()
assert p384A.exportPrivate().length == 48 and p384A.publicKey.length == 97
assert p384A.sharedSecret(p384B.publicKey) == p384B.sharedSecret(p384A.publicKey)
bytes digest256 = crypto.sha256("message")
bytes digest384 = crypto.sha384("message")
assert crypto.ecdsaP256VerifyHashDer(p256A.publicKey, digest256, p256A.signHashDer(digest256))
assert crypto.ecdsaP384VerifyHashDer(p384A.publicKey, digest384, p384A.signHashDer(digest384))
// Managed RSA fixed vectors remain in stdlib_crypto_rsa_values.xl.
