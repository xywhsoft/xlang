extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

// Crypto's existing Buffer inputs are raw UTF-8 bytes. Do not use the retired
// encoding.toBytes facade or implicitly transcode these ASCII test vectors.
func utf8Buffer(string text) as Buffer
    Buffer result = Buffer()
    assert result.append(text)
    assert result.len() == string.byteLen(text)
    return result
end

expectStr(crypto.sha1("abc"), "A9993E364706816ABA3E25717850C26C9CD0D89D")
expectStr(crypto.sha256("abc"), "BA7816BF8F01CFEA414140DE5DAE2223B00361A396177A9CB410FF61F20015AD")
expectStr(crypto.sha384("abc"), "CB00753F45A35E8BB5A03D699AC65007272C32AB0EDED1631A8B605A43FF5BED8086072BA1E7CC2358BAECA134C825A7")
expectStr(crypto.sha512("abc"), "DDAF35A193617ABACC417349AE20413112E6FA4E89A97EA20A9EEEE64B55D39A2192992A274FC1A836BA3C23A3FEEBBD454D4423643CE80E2A9AC94FA54CA49F")

expect(string.len(crypto.sha1("abc")), 40)
expect(string.len(crypto.sha256("abc")), 64)
expect(string.len(crypto.sha384("abc")), 96)
expect(string.len(crypto.sha512("abc")), 128)

assert crypto.sha256("") == "E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855", "empty sha256 mismatch"
assert crypto.sha256("xlang") == crypto.sha256("xlang"), "sha256 should be stable"
assert crypto.sha256("xlang") != crypto.sha256("xlang!"), "sha256 should depend on bytes"

string hmacText = "The quick brown fox jumps over the lazy dog"
expectStr(crypto.hmacSha256("key", hmacText), "F7BC83F430538424B13298E6AA6FB143EF4D59A14946175997479DBC2D1A3CD8")
expectStr(crypto.hmacSha384("key", hmacText), "D7F4727E2C0B39AE0F1E40CC96F60242D5B7801841CEA6FC592C5D3E1AE50700582A96CF35E1E554995FE4E03381C237")
expectStr(crypto.hmacSha512("key", hmacText), "B42AF09057BAC1E2D41708E48A902E09B5FF7F12AB428A4FE86653C73DD248FB82F948A549F7B791A5B41915EE4D1EC3935357E4E2317250D0372AFA2EBEEB3A")

string key16 = "0123456789abcdef"
string key32 = "0123456789abcdef0123456789abcdef"
string nonce = "123456789012"
string aad = "meta"
string plain = "hello crypto"

string chachaCipher = crypto.chacha20Poly1305Encrypt(key32, nonce, plain, aad)
expect(string.len(chachaCipher), (string.byteLen(plain) + 16) * 2)
expectStr(crypto.chacha20Poly1305Decrypt(key32, nonce, chachaCipher, aad), plain)
expectStr(crypto.chacha20Poly1305Decrypt(key32, nonce, chachaCipher, "bad"), "")
expectStr(crypto.chacha20Poly1305Encrypt("bad", nonce, plain, aad), "")

string aes128Cipher = crypto.aes128GcmEncrypt(key16, nonce, plain, aad)
expect(string.len(aes128Cipher), (string.byteLen(plain) + 16) * 2)
expectStr(crypto.aes128GcmDecrypt(key16, nonce, aes128Cipher, aad), plain)
expectStr(crypto.aes128GcmDecrypt(key16, nonce, aes128Cipher, "bad"), "")
expectStr(crypto.aes128GcmEncrypt("bad", nonce, plain, aad), "")

string aes256Cipher = crypto.aes256GcmEncrypt(key32, nonce, plain, aad)
expect(string.len(aes256Cipher), (string.byteLen(plain) + 16) * 2)
expectStr(crypto.aes256GcmDecrypt(key32, nonce, aes256Cipher, aad), plain)
expectStr(crypto.aes256GcmDecrypt(key32, nonce, aes256Cipher, "bad"), "")
expectStr(crypto.aes256GcmEncrypt("bad", nonce, plain, aad), "")

string hkdf256 = crypto.hkdfSha256("key", "salt", "info", 32)
string hkdf384 = crypto.hkdfSha384("key", "salt", "info", 32)
expect(string.len(hkdf256), 64)
expect(string.len(hkdf384), 64)
expectStr(hkdf256, crypto.hkdfSha256("key", "salt", "info", 32))
expectStr(hkdf384, crypto.hkdfSha384("key", "salt", "info", 32))
expectStr(crypto.hkdfSha256("key", "salt", "info", 0), "")
expectStr(crypto.hkdfSha384("key", "salt", "info", 0), "")

expect(string.len(crypto.randomHex(16)), 32)
expectStr(crypto.randomHex(0), "")

Buffer binary = Buffer()
binary.appendByte(0)
binary.appendByte(1)
binary.appendByte(2)
binary.appendByte(255)

Buffer binarySha1 = crypto.sha1Bytes(binary)
Buffer binarySha256 = crypto.sha256Bytes(binary)
Buffer binarySha384 = crypto.sha384Bytes(binary)
Buffer binarySha512 = crypto.sha512Bytes(binary)
expect(binarySha1.len(), 20)
expect(binarySha256.len(), 32)
expect(binarySha384.len(), 48)
expect(binarySha512.len(), 64)
expectStr(codec.hexEncodeBytes(binarySha256.data(), c_size(binarySha256.len())), "3D1F57C984978EF98A18378C8166C1CB8EDE02C03EEB6AEE7E2F121DFEEE3E56")

Buffer binaryHmacKey = Buffer()
binaryHmacKey.appendByte(107)
binaryHmacKey.appendByte(0)
binaryHmacKey.appendByte(101)
binaryHmacKey.appendByte(121)
Buffer binaryHmac256 = crypto.hmacSha256Bytes(binaryHmacKey, binary)
Buffer binaryHmac384 = crypto.hmacSha384Bytes(binaryHmacKey, binary)
Buffer binaryHmac512 = crypto.hmacSha512Bytes(binaryHmacKey, binary)
expectStr(codec.hexEncodeBytes(binaryHmac256.data(), c_size(binaryHmac256.len())), "ED8E5575104941F74E6529671B739D9DA41EA7A01747E53EAD88B999EE547360")
expect(binaryHmac384.len(), 48)
expect(binaryHmac512.len(), 64)

Buffer key16Bytes = utf8Buffer(key16)
Buffer key32Bytes = utf8Buffer(key32)
Buffer nonceBytes = utf8Buffer(nonce)
Buffer aadBytes = utf8Buffer(aad)
Buffer streamBinaryCipher = crypto.chacha20Bytes(key32Bytes, nonceBytes, binary, 7)
Buffer streamBinaryPlain = crypto.chacha20Bytes(key32Bytes, nonceBytes, streamBinaryCipher, 7)
assert streamBinaryPlain == binary, "binary chacha20 roundtrip failed"

Buffer chachaBinaryCipher = crypto.chacha20Poly1305EncryptBytes(key32Bytes, nonceBytes, binary, aadBytes)
Buffer chachaBinaryPlain = crypto.chacha20Poly1305DecryptBytes(key32Bytes, nonceBytes, chachaBinaryCipher, aadBytes)
expect(chachaBinaryCipher.len(), binary.len() + 16)
assert chachaBinaryPlain == binary, "binary chacha20-poly1305 roundtrip failed"

Buffer aes128BinaryCipher = crypto.aes128GcmEncryptBytes(key16Bytes, nonceBytes, binary, aadBytes)
Buffer aes128BinaryPlain = crypto.aes128GcmDecryptBytes(key16Bytes, nonceBytes, aes128BinaryCipher, aadBytes)
expect(aes128BinaryCipher.len(), binary.len() + 16)
assert aes128BinaryPlain == binary, "binary aes128-gcm roundtrip failed"

Buffer aes256BinaryCipher = crypto.aes256GcmEncryptBytes(key32Bytes, nonceBytes, binary, aadBytes)
Buffer aes256BinaryPlain = crypto.aes256GcmDecryptBytes(key32Bytes, nonceBytes, aes256BinaryCipher, aadBytes)
expect(aes256BinaryCipher.len(), binary.len() + 16)
assert aes256BinaryPlain == binary, "binary aes256-gcm roundtrip failed"
aes256BinaryCipher[0] = aes256BinaryCipher[0] ^ 1
expect(crypto.aes256GcmDecryptBytes(key32Bytes, nonceBytes, aes256BinaryCipher, aadBytes).len(), 0)

Buffer hkdfKeyBytes = utf8Buffer("key")
Buffer hkdfSaltBytes = utf8Buffer("salt")
Buffer hkdfInfoBytes = utf8Buffer("info")
Buffer hkdf256Bytes = crypto.hkdfSha256Bytes(hkdfKeyBytes, hkdfSaltBytes, hkdfInfoBytes, 32)
Buffer hkdf384Bytes = crypto.hkdfSha384Bytes(hkdfKeyBytes, hkdfSaltBytes, hkdfInfoBytes, 48)
expect(hkdf256Bytes.len(), 32)
expect(hkdf384Bytes.len(), 48)
assert hkdf256Bytes == crypto.hkdfSha256Bytes(hkdfKeyBytes, hkdfSaltBytes, hkdfInfoBytes, 32), "binary hkdf should be stable"
expect(crypto.hkdfSha256Bytes(hkdfKeyBytes, hkdfSaltBytes, hkdfInfoBytes, 0).len(), 0)
expect(crypto.randomBytes(17).length, 17)
expect(crypto.randomBytes(0).length, 0)

Sha1 sha1Stream = crypto.sha1Stream()
assert sha1Stream.update("a"), "sha1 stream update failed"
assert sha1Stream.update("bc"), "sha1 stream second update failed"
expectStr(sha1Stream.hex(), crypto.sha1("abc"))
expectStr(sha1Stream.hex(), crypto.sha1("abc"))
assert sha1Stream.bytes() == crypto.sha1Bytes(utf8Buffer("abc")), "sha1 stream bytes mismatch"

Sha256 sha256Stream = crypto.sha256Stream()
assert sha256Stream.update("a"), "sha256 stream update failed"
assert sha256Stream.update("bc"), "sha256 stream second update failed"
expectStr(sha256Stream.hex(), crypto.sha256("abc"))
expectStr(sha256Stream.hex(), crypto.sha256("abc"))

Sha256 binaryStream = crypto.sha256Stream()
assert binaryStream.update(binary), "binary sha256 stream update failed"
assert binaryStream.bytes() == binarySha256, "binary sha256 stream digest mismatch"

Sha384 sha384Stream = crypto.sha384Stream()
assert sha384Stream.update("ab"), "sha384 stream update failed"
assert sha384Stream.update("c"), "sha384 stream second update failed"
expectStr(sha384Stream.hex(), crypto.sha384("abc"))

Sha512 sha512Stream = crypto.sha512Stream()
assert sha512Stream.update("abc"), "sha512 stream update failed"
expectStr(sha512Stream.hex(), crypto.sha512("abc"))

string chacha20Cipher = crypto.chacha20Encrypt(key32, nonce, plain, 1)
expect(string.len(chacha20Cipher), string.byteLen(plain) * 2)
expectStr(crypto.chacha20Decrypt(key32, nonce, chacha20Cipher, 1), plain)
expectStr(crypto.chacha20Encrypt("bad", nonce, plain, 1), "")
expectStr(crypto.chacha20Decrypt(key32, nonce, "bad", 1), "")

var edKey = crypto.ed25519Keypair()
string edSeed = string(edKey["seed"])
string edPub = string(edKey["publicKey"])
expect(string.len(edSeed), 64)
expect(string.len(edPub), 64)
expectStr(crypto.ed25519PublicKey(edSeed), edPub)
string edSig = crypto.ed25519Sign(edSeed, "message")
expect(string.len(edSig), 128)
assert crypto.ed25519Verify(edPub, "message", edSig), "ed25519 verify failed"
assert not crypto.ed25519Verify(edPub, "message!", edSig), "ed25519 verify should reject modified text"
assert not crypto.ed25519Verify("bad", "message", edSig), "ed25519 verify should reject bad public key"

var x25519A = crypto.x25519Keypair()
var x25519B = crypto.x25519Keypair()
string x25519SecretA = crypto.x25519SharedSecret(string(x25519A["privateKey"]), string(x25519B["publicKey"]))
string x25519SecretB = crypto.x25519SharedSecret(string(x25519B["privateKey"]), string(x25519A["publicKey"]))
expect(string.len(x25519SecretA), 64)
expectStr(x25519SecretA, x25519SecretB)
expectStr(crypto.x25519SharedSecret("bad", string(x25519B["publicKey"])), "")

var x448A = crypto.x448Keypair()
var x448B = crypto.x448Keypair()
string x448SecretA = crypto.x448SharedSecret(string(x448A["privateKey"]), string(x448B["publicKey"]))
string x448SecretB = crypto.x448SharedSecret(string(x448B["privateKey"]), string(x448A["publicKey"]))
expect(string.len(x448SecretA), 112)
expectStr(x448SecretA, x448SecretB)
expectStr(crypto.x448SharedSecret("bad", string(x448B["publicKey"])), "")

var p256A = crypto.p256Keypair()
var p256B = crypto.p256Keypair()
string p256PrivateA = string(p256A["privateKey"])
string p256PublicA = string(p256A["publicKey"])
string p256PrivateB = string(p256B["privateKey"])
string p256PublicB = string(p256B["publicKey"])
expect(string.len(p256PrivateA), 64)
expect(string.len(p256PublicA), 130)
string p256SecretA = crypto.p256SharedSecret(p256PrivateA, p256PublicB)
string p256SecretB = crypto.p256SharedSecret(p256PrivateB, p256PublicA)
expect(string.len(p256SecretA), 64)
expectStr(p256SecretA, p256SecretB)
expectStr(crypto.p256SharedSecret("bad", p256PublicB), "")

var p384A = crypto.p384Keypair()
var p384B = crypto.p384Keypair()
string p384PrivateA = string(p384A["privateKey"])
string p384PublicA = string(p384A["publicKey"])
string p384PrivateB = string(p384B["privateKey"])
string p384PublicB = string(p384B["publicKey"])
expect(string.len(p384PrivateA), 96)
expect(string.len(p384PublicA), 194)
string p384SecretA = crypto.p384SharedSecret(p384PrivateA, p384PublicB)
string p384SecretB = crypto.p384SharedSecret(p384PrivateB, p384PublicA)
expect(string.len(p384SecretA), 96)
expectStr(p384SecretA, p384SecretB)
expectStr(crypto.p384SharedSecret(p384PrivateA, "bad"), "")

assert not crypto.ecdsaVerify("", "", ""), "ecdsaVerify should reject empty values"
assert not crypto.ecdsaVerify(p256PublicA, "00", "00"), "ecdsaVerify should reject malformed signature"

assert not crypto.rsaPssVerify("", "", "", ""), "rsaPssVerify should reject empty hex"
assert not crypto.rsaPkcs1Verify("bad", "00", "00", "010001"), "rsaPkcs1Verify should reject invalid hex"
