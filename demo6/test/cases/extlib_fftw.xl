import fftw



func main(...) as int
    // Power of 2
    assert fftw.nextPow2(1) == 1, "next pow2 1"
    assert fftw.nextPow2(5) == 8, "next pow2 5"
    assert fftw.nextPow2(1000) == 1024, "next pow2 1000"
    assert fftw.isPow2(1024) == 1, "1024 is pow2"
    assert fftw.isPow2(1000) == 0, "1000 not pow2"

    // Frequency resolution
    auto res = fftw.freqResolution(44100.0, 1024)
    assert res > 43.0 and res < 44.0, "freq resolution"

    // Freq to bin and back
    auto bin = fftw.freqToBin(1000.0, 44100.0, 1024)
    assert bin == 23, "freq to bin"
    auto freq = fftw.binToFreq(23, 44100.0, 1024)
    assert freq > 990.0 and freq < 1000.0, "bin to freq"

    // Magnitude and phase
    auto mag = fftw.magnitude(3.0, 4.0)
    assert mag > 4.99 and mag < 5.01, "magnitude 3-4-5"
    auto ph = fftw.phase(1.0, 0.0)
    assert ph > -0.01 and ph < 0.01, "phase 0"

    // Power
    auto pw = fftw.power(3.0, 4.0)
    assert pw > 24.9 and pw < 25.1, "power 25"

    // dB conversion
    auto db = fftw.toDb(10.0)
    assert db > 19.9 and db < 20.1, "20 dB"

    // Window names
    assert fftw.windowName(0) == "RECTANGULAR", "rectangular"
    assert fftw.windowName(1) == "HANN", "hann"
    assert fftw.windowName(2) == "HAMMING", "hamming"
    assert fftw.windowName(3) == "BLACKMAN", "blackman"
    assert fftw.windowName(9) == "UNKNOWN", "unknown window"

    // Window coefficients
    auto h0 = fftw.hann(0, 8)
    assert h0 > -0.01 and h0 < 0.01, "hann start 0"
    auto hm = fftw.hamming(4, 8)
    assert hm > 0.9 and hm < 1.1, "hamming mid ~1"

    // Flags
    assert fftw.flagEstimate() == 64, "estimate flag"
    assert fftw.flagMeasure() == 0, "measure flag"
    assert fftw.flagPatient() == 32, "patient flag"
    assert fftw.flagExhaustive() == 8, "exhaustive flag"

    // Direction
    assert fftw.forward() == -1, "forward"
    assert fftw.backward() == 1, "backward"

    // Complexity
    auto cplx = fftw.complexity(1024)
    assert cplx == 10240, "complexity 1024*10"

    return 0
end
