extern "expect_i64" func expect(int actual, int expected)

func add(int left, int right) as int
    return left + right
end

func mul(int left, int right) as int
    return left * right
end

func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

class FnBox
    func(int) as int op
    int bias = 0
end

func(int) as int add5 = makeAdder(5)
func(int) as int add9 = makeAdder(9)

array<func(int) as int> funcs = array[add5]
array<func(int) as int> funcsCopy = funcs
funcs[0] = add9

func(int) as int copiedFunc = funcsCopy[0]
func(int) as int currentFunc = funcs[0]
expect(copiedFunc(7), 12)
expect(currentFunc(7), 16)

funcsCopy = funcs
funcs[0] = add5
copiedFunc = funcsCopy[0]
expect(copiedFunc(1), 10)

FnBox boxA
boxA.op = add5
boxA.bias = 10

FnBox boxB
boxB.op = add9
boxB.bias = 20

array<FnBox> boxes = array[boxA]
array<FnBox> boxesCopy = boxes
boxes[0] = boxB

FnBox loadedCopy = boxesCopy[0]
FnBox loadedNow = boxes[0]
expect(loadedCopy.op(1) + loadedCopy.bias, 16)
expect(loadedNow.op(1) + loadedNow.bias, 30)

boxesCopy = boxes
boxes[0] = boxA
loadedCopy = boxesCopy[0]
expect(loadedCopy.op(2) + loadedCopy.bias, 31)

dict<FnBox> named = dict{"next": boxB}
dict<FnBox> namedCopy = named
named["next"] = boxA

FnBox namedLoaded = namedCopy["next"]
expect(namedLoaded.op(3) + namedLoaded.bias, 32)

custom Native
end

point rawA
point rawB
Native nativeA = Native(rawA)
Native nativeB = Native(rawB)

array<Native> natives = array[nativeA]
array<Native> nativesCopy = natives
natives[0] = nativeB

Native nativeLoaded = nativesCopy[0]
var boxedNative = nativeLoaded
expect(type(boxedNative) == Native, 1)
