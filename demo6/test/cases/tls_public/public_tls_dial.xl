async func connectDial(int mode,NetEngine engine,NetResolver resolver,TlsClientContext role,TlsDialOptions options,int port,CancellationToken parent) as TlsStream
 if mode == 0 then return await TlsStream.dialAsync(engine,resolver,"127.0.0.1\0ignored",port,role,9) end
 if mode == 1 then return await TlsStream.dialAsyncCancel(engine,resolver,"127.0.0.1\0ignored",port,role,9,parent) end
 if mode == 2 then return await TlsStream.dialAsyncUntil(engine,resolver,"127.0.0.1\0ignored",port,role,9,uint64(9223372036854775807)) end
 if mode == 3 then return await TlsStream.dialAsyncUntilCancel(engine,resolver,"127.0.0.1\0ignored",port,role,9,uint64(9223372036854775807),parent) end
 if mode == 4 then return await TlsStream.dialAsyncTimeout(engine,resolver,"127.0.0.1\0ignored",port,role,9,5000) end
 if mode == 5 then return await TlsStream.dialAsyncTimeoutCancel(engine,resolver,"127.0.0.1\0ignored",port,role,9,parent,5000) end
 if mode == 6 then return TlsStream.dial(engine,resolver,"127.0.0.1\0ignored",port,role,9,5000) end
 if mode == 7 then return TlsStream.dialCancel(engine,resolver,"127.0.0.1\0ignored",port,role,9,parent,5000) end
 if mode == 8 then return TlsStream.dialUntil(engine,resolver,"127.0.0.1\0ignored",port,role,9,uint64(9223372036854775807)) end
 if mode == 9 then return TlsStream.dialUntilCancel(engine,resolver,"127.0.0.1\0ignored",port,role,9,uint64(9223372036854775807),parent) end
 if mode == 10 then return await TlsStream.dialAsync(engine,resolver,"127.0.0.1\0ignored",port,role,options,9) end
 if mode == 11 then return await TlsStream.dialAsyncCancel(engine,resolver,"127.0.0.1\0ignored",port,role,options,9,parent) end
 if mode == 12 then return await TlsStream.dialAsyncUntil(engine,resolver,"127.0.0.1\0ignored",port,role,options,9,uint64(9223372036854775807)) end
 if mode == 13 then return await TlsStream.dialAsyncUntilCancel(engine,resolver,"127.0.0.1\0ignored",port,role,options,9,uint64(9223372036854775807),parent) end
 if mode == 14 then return await TlsStream.dialAsyncTimeout(engine,resolver,"127.0.0.1\0ignored",port,role,options,9,5000) end
 if mode == 15 then return await TlsStream.dialAsyncTimeoutCancel(engine,resolver,"127.0.0.1\0ignored",port,role,options,9,parent,5000) end
 if mode == 16 then return TlsStream.dial(engine,resolver,"127.0.0.1\0ignored",port,role,options,9,5000) end
 if mode == 17 then return TlsStream.dialCancel(engine,resolver,"127.0.0.1\0ignored",port,role,options,9,parent,5000) end
 if mode == 18 then return TlsStream.dialUntil(engine,resolver,"127.0.0.1\0ignored",port,role,options,9,uint64(9223372036854775807)) end
 if mode == 19 then return TlsStream.dialUntilCancel(engine,resolver,"127.0.0.1\0ignored",port,role,options,9,uint64(9223372036854775807),parent) end
 throw "invalid test mode"
end
async func exerciseDial(NetEngine engine, NetResolver resolver)
 auto base=TlsDialOptions()
 assert base.timeoutMillis == -1 and base.serverNameFromHost
 assert base.serverName == "" and base.verifyName == ""
 auto options=base.withServerName("localhost\0ignored",9).withVerifyName("localhost",99).withTimeoutMillis(5000)
 assert base.serverName == "" and options.serverName == "localhost"
 assert options.verifyName == "localhost" and options.timeoutMillis == 5000
 assert options.transport().streamOptions().readSize > 0 and options.stream().asyncBatch > 0
 auto cancellation=CancellationSource()
 auto parent=cancellation.token
 auto role=clientContext()
 auto server=TlsServer(engine,TcpListenOptions(NetAddress.loopback(4,0)),serverContext())
 auto port=server.local().port
 int mode=0
 while mode < 20
  auto accepted=server.acceptAsyncTimeout(5000)
  auto client=await connectDial(mode,engine,resolver,clientContext(),options,port,parent)
  auto peer=await accepted
  assert client.state == 2 and peer.state == 2
  assert client.send(b"a\0b",100,5000) == 3
  assert peer.recv(3,5000) == b"a\0b"
  client.abort()
  peer.abort()
  mode += 1
 end
 assert cancellation.cancel()
 int failures=0
 try
  auto ignored=await TlsStream.dialAsyncCancel(engine,resolver,"127.0.0.1",port,role,options,-1,parent)
 catch failure
  failures += 1
 end
 try
  auto ignored=await TlsStream.dialAsyncUntil(engine,resolver,"127.0.0.1",port,role,options,-1,uint64(0))
 catch failure
  failures += 1
 end
 assert failures == 2
 server.close()
end
auto engine=NetEngine(NetEngineOptions().withWorkers(2).withBackend(NetBackend.select))
auto resolver=NetResolver()
engine.start()
await exerciseDial(engine,resolver)
resolver.close()
assert resolver.wait(10000)
engine.close()
assert engine.wait(10000)
println("resident TLS dial: 20 direct signatures, names, owned results and cancellation: ok")
