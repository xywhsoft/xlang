async func exerciseIo(NetEngine engine)
    auto listen=TcpListenOptions(NetAddress.loopback(4,0))
    auto server=TlsServer(engine,listen,serverContext())
    auto pending=server.acceptAsyncTimeout(5000)
    auto client=TlsStream(engine,server.local(),clientContext(),"localhost")
    assert await client.waitAsyncTimeout(0,5000)
    auto peer=await pending
    assert peer.state == 2
    auto incoming=peer.recvAsyncTimeout(3,5000)
    assert await client.sendAsync("a\0b",100) == 3
    assert await incoming == b"a\0b"
    assert client.send(b"x\0y",100,5000) == 3
    assert peer.recv(3,5000) == b"x\0y"
    auto returning=client.recvAsync(4)
    assert await peer.sendAsync(Buffer(b"buf\0"),-1) == 4
    assert await returning == b"buf\0"
    assert client.wait(0,5000)
    auto empty=client.sendAsync(b"",-1)
    assert await empty == 0

    auto ownedPending=peer.recvOwnedAsyncTimeout(5,5000)
    assert await client.sendVectorAsync(["a\0", "bcd"],100) == 5
    auto owned=await ownedPending
    assert owned.toBytes() == b"a\0bcd"
    assert client.sendVector([b"line", b"\n"],-1,5000) == 5
    auto chunk=peer.recvOwned(5,5000)
    auto frame=NetLineFramer("\n")
    frame.appendRef(chunk)
    assert frame.next().bytes() == b"line"
    auto buffers=[Buffer(b"123"),Buffer(b"456")]
    assert await client.sendVectorAsync(buffers,4) == 4
    assert peer.recvOwnedUntil(4,uint64(9223372036854775807)).toBytes() == b"1234"
    assert client.sendVector(["skip", "extra"],2,5000) == 2
    assert peer.wait(1,5000)
    assert await peer.peekAsync(100) == b"sk"
    assert peer.peek(1,5000) == b"s"
    assert await peer.consumeAsync(1) == 1
    assert peer.consume(1,5000) == 1
    assert peer.available == 0
    assert await peer.protocolAsync() == b""
    assert peer.protocol(5000) == b""
    assert await client.sendBoundAsync(10) >= 10
    assert client.sendBound(10,5000) >= 10

    auto cancelled=peer.recvAsync(1)
    assert cancelled.cancel()
    int failures=0
    try
        auto ignored=await cancelled
    catch failure
        failures += 1
    end
    auto stop=CancellationSource()
    assert stop.cancel()
    try
        auto ignored=await peer.recvAsyncCancel(1,stop.token)
    catch failure
        failures += 1
    end
    try
        auto ignored=await client.sendAsyncCancel("not-sent",-1,stop.token)
    catch failure
        failures += 1
    end
    try
        auto ignored=await peer.recvAsyncUntil(1,uint64(0))
    catch failure
        failures += 1
    end
    try
        auto ignored=await server.acceptAsyncTimeout(0)
    catch failure
        failures += 1
    end
    try
        auto ignored=await server.acceptAsyncCancel(stop.token)
    catch failure
        failures += 1
    end
    try
        auto ignored=peer.recvCancel(1,stop.token,5000)
    catch failure
        failures += 1
    end
    assert failures == 7
    assert peer.available == 0
    auto resumed=peer.recvAsyncTimeout(3,5000)
    assert client.send("ok\0",-1,5000) == 3
    assert await resumed == b"ok\0"
    auto second=TlsStream(engine,server.local(),clientContext(),"localhost")
    auto accepted=server.accept(5000)
    assert second.wait(0,5000)
    assert second.send(Buffer(b"sync"),2,5000) == 2
    assert accepted.recv(2,5000) == b"sy"
    server.close()
    assert peer.state == 2 and accepted.state == 2
    client.abort()
    peer.abort()
    second.abort()
    accepted.abort()
end

auto engine=NetEngine(NetEngineOptions().withWorkers(2).withBackend(NetBackend.select))
engine.start()
await exerciseIo(engine)
engine.close()
assert engine.wait(10000)
println("resident TLS data: vectors, owned receive, worker ops and reference frames: ok")
