 return TlsClientContext(verifier)
end
func makeServer() as TlsServerContext
 array<Certificate> chain=[Certificate.fromDer(b"\x30\x82\x01\xb9\x30\x82\x01\x5f\xa0\x03\x02\x01\x02\x02\x01\x03\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x30\x24\x31\x22\x30\x20\x06\x03\x55\x04\x03\x0c\x19\x6f\x66\x66\x6c\x69\x6e\x65\x20\x70\x32\x35\x36\x20\x69\x6e\x74\x65\x72\x6d\x65\x64\x69\x61\x74\x65\x30\x1e\x17\x0d\x32\x30\x30\x31\x30\x31\x30\x30\x30\x30\x30\x30\x5a\x17\x0d\x34\x30\x30\x31\x30\x31\x30\x30\x30\x30\x30\x30\x5a\x30\x19\x31\x17\x30\x15\x06\x03\x55\x04\x03\x0c\x0e\x6f\x66\x66\x6c\x69\x6e\x65\x20\x74\x61\x72\x67\x65\x74\x30\x59\x30\x13\x06\x07\x2a\x86\x48\xce\x3d\x02\x01\x06\x08\x2a\x86\x48\xce\x3d\x03\x01\x07\x03\x42\x00\x04\x60\xfe\xd4\xba\x25\x5a\x9d\x31\xc9\x61\xeb\x74\xc6\x35\x6d\x68\xc0\x49\xb8\x92\x3b\x61\xfa\x6c\xe6\x69\x62\x2e\x60\xf2\x9f\xb6\x79\x03\xfe\x10\x08\xb8\xbc\x99\xa4\x1a\xe9\xe9\x56\x28\xbc\x64\xf2\xf1\xb2\x0c\x2d\x7e\x9f\x51\x77\xa3\xc2\x94\xd4\x46\x22\x99\xa3\x81\x8c\x30\x81\x89\x30\x0c\x06\x03\x55\x1d\x13\x01\x01\xff\x04\x02\x30\x00\x30\x1d\x06\x03\x55\x1d\x0e\x04\x16\x04\x14\x1a\x95\x69\x57\x9b\xce\x32\x9a\x94\x2d\x07\x69\xc9\xc0\xb5\x64\x31\x56\x37\x10\x30\x1f\x06\x03\x55\x1d\x23\x04\x18\x30\x16\x80\x14\x1a\x95\x69\x57\x9b\xce\x32\x9a\x94\x2d\x07\x69\xc9\xc0\xb5\x64\x31\x56\x37\x10\x30\x0e\x06\x03\x55\x1d\x0f\x01\x01\xff\x04\x04\x03\x02\x07\x80\x30\x14\x06\x03\x55\x1d\x11\x04\x0d\x30\x0b\x82\x09\x6c\x6f\x63\x61\x6c\x68\x6f\x73\x74\x30\x13\x06\x03\x55\x1d\x25\x04\x0c\x30\x0a\x06\x08\x2b\x06\x01\x05\x05\x07\x03\x01\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x03\x48\x00\x30\x45\x02\x21\x00\xbf\xee\x2d\x79\xa6\x62\xc0\xba\xfb\x46\x79\x5e\x0d\xa3\x74\xed\xee\x8e\xd1\x64\xfa\xfd\xb8\x50\x58\x8e\x15\x1a\x8c\x9a\x0b\x17\x02\x20\x2a\x6a\x98\x3c\x9b\x9e\xf9\x2b\x3b\xc6\xd5\xa6\x00\x6a\x2e\x44\xde\x59\xf3\x82\xa4\x4f\x35\xad\x80\x81\x12\xdb\xee\x96\x5e\x42"),Certificate.fromDer(b"\x30\x82\x01\x95\x30\x82\x01\x3b\xa0\x03\x02\x01\x02\x02\x01\x02\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x30\x1c\x31\x1a\x30\x18\x06\x03\x