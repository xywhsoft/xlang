extern "c_owned_text" @no_raise func nativeText() as point
extern "c_owned_binary" @no_raise func nativeBytes() as point
extern "c_owned_release" @no_raise func nativeFree(point data)
extern "c_owned_released" @no_raise func released() as int

typedef Text = string

func consume(string text, bytes data)
    assert text == "hello" and data.length == 4
end

func read() as int
    cstring text = cstring.take(nativeText(), nativeFree)
    cbytes data = cbytes.take(nativeBytes(), 4, nativeFree)
    assert text.length == 5 and text[0] == 'h' and text[-1] == 'o'
    assert data.length == 4 and data[1] == 255 and data[-1] == 42
    assert text == "hello" and data == bytes(data)
    assert string(text) == "hello" and bytes(data).length == 4
    Text aliasText = text
    assert aliasText == text
    string joined = ""
    for scalar in text
        joined = joined + scalar
    end
    assert joined == "hello"
    int byteSum = 0
    for index, octet in data
        byteSum += octet + index
    end
    assert byteSum == 320
    consume(text, data)
    assert text.contains("ell")
    try
        char ignored = text[100]
        assert false
    catch ignored
    end
    try
        uint8 ignored = data[-9223372036854775808]
        assert false
    catch ignored
    end
    assert released() == 0
    return 42
end

assert read() == 42
assert released() == 2
