func main(...) as int
    int? item = null
    SpscQueue<int?> queue = SpscQueue::<int?>(2)
    assert(queue.tryPush(null) == queueStatus.ok and queue.tryPush(0) == queueStatus.ok)
    auto nullStatus, nullItem = queue.tryPop()
    assert(nullStatus == queueStatus.ok and nullItem == null)
    auto itemStatus, zero = queue.tryPop()
    assert(itemStatus == queueStatus.ok and zero != null and zero == 0)
    auto emptyStatus, absent = queue.tryPop()
    assert(emptyStatus == queueStatus.empty and absent == null)

    AvlTree<int, int?> tree = AvlTree::<int, int?>()
    assert(tree.set(1, null) and tree.set(2, 81))
    assert(tree.getInto(1, item) and item == null)
    assert(tree.getInto(2, item) and item != null and item == 81)
    AvlTree<int, int?> copied = tree.clone()
    assert(copied.equals(tree))
    return 0
end
