async func aggregateText() as string
    return "a\0你"
end

future<string> first = aggregateText()
future<string> second = aggregateText()
assert first.wait() and second.wait()
array<string> values = await task.all([first, first, second])
assert values.length == 3
assert values[0] == "a\0你" and values[1] == values[0] and values[2] == values[0]
assert await task.race([first, second]) == "a\0你"
int index = await task.whenAny([first, second])
assert index >= 0 and index < 2
println("variadic aggregate direct ABI ok")
