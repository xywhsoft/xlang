import skiplist



func main(...) as int
    auto sl = skiplist.create()
    assert sl.valid, "skiplist should be valid"
    assert sl.count == 0, "skiplist initial count"

    sl.set("banana", "yellow")
    sl.set("apple", "red")
    sl.set("cherry", "dark red")
    assert sl.count == 3, "skiplist count after sets"
    assert sl.get("apple") == "red", "skiplist get apple"
    assert sl.get("banana") == "yellow", "skiplist get banana"
    assert sl.get("cherry") == "dark red", "skiplist get cherry"
    assert sl.get("missing") == "", "skiplist get missing default"
    assert sl.get("missing", "N/A") == "N/A", "skiplist get missing custom default"

    sl.set("apple", "green")
    assert sl.get("apple") == "green", "skiplist update value"
    assert sl.count == 3, "skiplist count unchanged after update"

    assert sl.contains("banana"), "skiplist contains banana"
    assert not sl.contains("durian"), "skiplist not contains durian"

    bool removed = sl.remove("banana")
    assert removed, "skiplist remove returns true"
    assert sl.count == 2, "skiplist count after remove"
    assert not sl.contains("banana"), "skiplist removed banana"

    removed = sl.remove("nonexistent")
    assert not removed, "skiplist remove nonexistent"
    assert sl.count == 2, "skiplist count unchanged"

    sl.clear()
    assert sl.count == 0, "skiplist count after clear"
    assert not sl.contains("apple"), "skiplist cleared"

    // 结果按完整字节长度保存，keys/range 按键的字节序有序。
    sl.set("你", "中文")
    sl.set("a\0b", "v\0x")
    sl.set("apple", "green")
    assert sl.get("a\0b") == "v\0x", "nul value round trip"
    assert not sl.contains("a"), "nul key not truncated"
    var ordered = sl.keys()
    assert ordered.length == 3, "keys count"
    assert ordered[0] == "a\0b", "keys sorted first"
    assert ordered[1] == "apple", "keys sorted second"
    var subset = sl.range("a", "apple")
    assert subset.length == 2, "inclusive range"
    assert subset[0]["key"] == "a\0b", "range key"
    assert subset[0]["value"] == "v\0x", "range value"
    assert sl.range("z", "a").length == 0, "reversed range empty"
    sl.set("empty", "")
    assert sl.get("empty", "fallback") == "", "stored empty is not missing"
    assert sl.get("absent", "fallback") == "fallback", "missing uses default"
    return 0
end
