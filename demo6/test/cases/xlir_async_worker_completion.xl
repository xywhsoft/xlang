extern "worker_completion_body" func workerBody(bool fail)
extern "worker_completion_drop" func workerDrop(int id)
class WorkerCompletionOwner
    int id
    create(int id)
        self.id = id
    end
    destroy()
        workerDrop(self.id)
    end
end
export "worker_completion_new" func workerNew(int id) as WorkerCompletionOwner
    return WorkerCompletionOwner(id)
end
async func workerScalar(WorkerCompletionOwner first, WorkerCompletionOwner unused, bool fail) as int
    workerBody(fail)
    return first.id
end
async func workerVoid(WorkerCompletionOwner first, WorkerCompletionOwner unused, bool fail)
    workerBody(fail)
    assert first.id == 7
