export "worker_completion_keep" func workerKeep()
    future<int> output = workerScalar(workerNew(7), workerNew(9), false)
    auto empty = workerVoid(workerNew(7), workerNew(9), false)
    auto text = workerString(workerNew(7), workerNew(9), false)
    auto object = workerObject(workerNew(7), workerNew(9), false)
