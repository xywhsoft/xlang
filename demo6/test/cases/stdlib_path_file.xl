extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

func probeFileStream(string path) as bool
    File stream = file.open(path, false)
    if stream.seek(0, file.seekSet) != 0 then
        return false
    end
    if stream.writeText("stream-start") != 12 then
        return false
    end
    if stream.seek(0, file.seekEnd) != 12 then
        return false
    end
    if stream.seek(-6, file.seekCur) != 6 then
        return false
    end
    if stream.write("IO") != 2 then
        return false
    end
    if stream.seek(0, file.seekSet) != 0 then
        return false
    end
    if stream.readText(6) != "stream" then
        return false
    end
    if stream.pos != 6 then
        return false
    end
    if stream.readText() != "IOtart" then
        return false
    end
    if not stream.eof then
        return false
    end
    if stream.seek(6, file.seekSet) != 6 then
        return false
    end
    if not stream.setEOF() then
        return false
    end
    return true
end

string filePath = "build/test/stdlib_file_case.txt"
string copyPath = "build/test/stdlib_file_case.copy.txt"
string movePath = "build/test/stdlib_file_case.move.txt"
string renamePath = "build/test/stdlib_file_case.renamed.txt"
string renameCasePath = "build/test/stdlib_file_case.RENAMED.txt"
string replacePath = "build/test/stdlib_file_case.replace.txt"
string binaryPath = "build/test/stdlib_file_case.bin"
string dirPath = "build/test/stdlib_dir_case"
string nestedDir = "build/test/stdlib_dir_case/nested"
string nestedFile = "build/test/stdlib_dir_case/nested/value.txt"
string copyDir = "build/test/stdlib_dir_case_copy"
string copyFile = "build/test/stdlib_dir_case_copy/nested/value.txt"
string movedDir = "build/test/stdlib_dir_case_moved"
string movedFile = "build/test/stdlib_dir_case_moved/nested/value.txt"
string cleanDir = "build/test/stdlib_dir_clean"
string cleanNested = "build/test/stdlib_dir_clean/nested"
string cleanFile = "build/test/stdlib_dir_clean/nested/value.txt"

file.delete(filePath)
file.delete(copyPath)
file.delete(movePath)
file.delete(renamePath)
file.delete(renameCasePath)
file.delete(replacePath)
file.delete(binaryPath)
dir.delete(copyDir)
dir.delete(movedDir)
dir.delete(cleanDir)
dir.delete(nestedDir)
dir.delete(dirPath)

expect(path.exists("release"), 1)
expect(path.isAbs("build/test"), 0)
expectStr(path.sep(), "\\")
expect(path.isAbs(path.cwd()), 1)
expect(path.setCwd(path.cwd()), 1)
expect(path.isAbs(path.abs("release")), 1)
expectStr(path.rel(path.cwd(), path.join(path.cwd(), "stdlib_rel_child.txt")), "stdlib_rel_child.txt")
expect(string.len(path.home()) > 0, 1)
expect(string.len(path.temp()) > 0, 1)
expect(path.isAbs(path.appDir()), 1)
expectStr(path.nameExt(filePath), "stdlib_file_case.txt")
expectStr(path.name(filePath), "stdlib_file_case")
expectStr(path.ext(filePath), ".txt")
expectStr(path.dir(filePath), "build/test")
expectStr(path.normalize("build/test/./stdlib_dir_case/../stdlib_file_case.txt"), path.join("build", "test", "stdlib_file_case.txt"))
expectStr(path.nameExt(path.withName(filePath, "renamed.log")), "renamed.log")
expectStr(path.ext(path.withExt(filePath, "log")), ".log")

string joinedFile2 = path.join("build/test", "stdlib_file_case.txt")
string joinedFile3 = path.join("build", "test", "stdlib_file_case.txt")
string joinedNested = path.join("build", "test", "stdlib_dir_case", "nested")
expectStr(path.nameExt(joinedFile2), "stdlib_file_case.txt")
expectStr(path.name(joinedFile3), "stdlib_file_case")
expectStr(path.ext(joinedFile3), ".txt")
expect(string.contains(joinedNested, "stdlib_dir_case"), 1)
expectStr(path.nameExt(joinedNested), "nested")
expect(string.len(path.random()), 12)

string randomPath = path.random("build/test/std_", ".txt", 8)
expect(string.len(randomPath), 27)
expectStr(path.dir(randomPath), "build/test")
expectStr(path.ext(randomPath), ".txt")
expect(string.contains(path.nameExt(randomPath), "std_"), 1)
expect(string.len(path.name(randomPath)), 12)

expect(file.exists(filePath), 0)
expect(file.touch(filePath), 1)
expect(file.exists(filePath), 1)
expect(file.writeText(filePath, "abc"), 1)
expectStr(file.readText(filePath), "abc")
expect(file.exists(filePath), 1)
expect(file.size(filePath), 3)
expect(file.appendText(filePath, "de"), 1)
expectStr(file.readText(filePath), "abcde")
expect(file.size(filePath), 5)

Buffer bytes = Buffer()
expect(bytes.appendByte(0), 1)
expect(bytes.appendByte(65), 1)
expect(bytes.appendByte(255), 1)
expect(file.writeBytes(binaryPath, bytes), 1)
expect(file.size(binaryPath), 3)
Buffer readBytes = file.readBytes(binaryPath)
expect(readBytes.len(), 3)
expect(readBytes[0], 0)
expect(readBytes[1], 65)
expect(readBytes[2], 255)
Buffer suffixBytes = Buffer()
expect(suffixBytes.appendByte(66), 1)
expect(file.appendBytes(binaryPath, suffixBytes), 1)
Buffer appendedBytes = file.readBytes(binaryPath)
expect(appendedBytes.len(), 4)
expect(appendedBytes[3], 66)
File binaryStream = file.open(binaryPath)
Buffer streamBytes = binaryStream.readBytes(2)
expect(streamBytes.len(), 2)
expect(streamBytes[0], 0)
expect(streamBytes[1], 65)

expect(probeFileStream(filePath), 1)
expectStr(file.readText(filePath), "stream")
expect(file.size(filePath), 6)
FileInfo info = file.info(filePath)
expect(info.exists, 1)
expect(info.isFile, 1)
expect(info.isDir, 0)
expect(info.size, 6)
expect(info.attr >= 0, 1)
expect(time.year(info.changeTime) >= 2020, 1)
expect(file.writeTextAtomic(filePath, "atomic"), 1)
expectStr(file.readText(filePath), "atomic")
expect(file.rename(filePath, renamePath), 1)
expect(file.exists(filePath), 0)
expect(file.exists(renamePath), 1)
expect(file.rename(renamePath, renameCasePath), 1)
expect(file.exists(renameCasePath), 1)
expectStr(file.readText(renameCasePath), "atomic")
expect(file.rename(renameCasePath, renamePath), 1)
expect(file.exists(renamePath), 1)
expect(file.writeText(replacePath, "old"), 1)
expect(file.replace(renamePath, replacePath), 1)
expect(file.exists(renamePath), 0)
expectStr(file.readText(replacePath), "atomic")
expect(file.move(replacePath, filePath), 1)
expectStr(file.readText(filePath), "atomic")
expect(file.copy(filePath, copyPath), 1)
expect(file.exists(copyPath), 1)
expect(file.move(copyPath, movePath), 1)
expect(file.exists(copyPath), 0)
expect(file.exists(movePath), 1)
expect(file.delete(filePath), 1)
expect(file.delete(movePath), 1)

expect(dir.exists(dirPath), 0)
expect(dir.create(dirPath), 1)
expect(dir.exists(dirPath), 1)
expect(dir.createAll(nestedDir), 1)
expect(dir.exists(nestedDir), 1)
expect(file.writeText(nestedFile, "nested"), 1)
expect(dir.empty(dirPath), 0)
expect(dir.count(dirPath), 1)
expect(dir.count(dirPath, true), 2)
expect(dir.size(dirPath), 6)
expect(dir.size(dirPath, false), 0)
array topEntries = dir.list(dirPath)
string topJson = json.stringify(topEntries)
expect(topEntries.length >= 1, 1)
expect(string.contains(topJson, "nested"), 1)
expect(string.contains(topJson, "value.txt"), 0)
array allEntries = dir.list(dirPath, true)
string allJson = json.stringify(allEntries)
expect(allEntries.length >= 2, 1)
expect(string.contains(allJson, "nested"), 1)
expect(string.contains(allJson, "value.txt"), 1)
array topFiles = dir.files(dirPath)
string topFilesJson = json.stringify(topFiles)
expect(topFiles.length, 0)
expect(string.contains(topFilesJson, "nested"), 0)
array allFiles = dir.files(dirPath, true)
string allFilesJson = json.stringify(allFiles)
expect(allFiles.length >= 1, 1)
expect(string.contains(allFilesJson, "value.txt"), 1)
expect(string.contains(allFilesJson, "nested"), 1)
array topDirs = dir.dirs(dirPath)
string topDirsJson = json.stringify(topDirs)
expect(topDirs.length, 1)
expect(string.contains(topDirsJson, "nested"), 1)
expect(string.contains(topDirsJson, "value.txt"), 0)
array globTxt = dir.glob(dirPath, "*.txt", true)
expect(globTxt.length, 1)
expect(string.contains(json.stringify(globTxt), "value.txt"), 1)
array matchedTxt = dir.matchEntries(dirPath, "*.txt", true)
expect(matchedTxt.length, 1)
var matchedEntry = matchedTxt[0]
expectStr(string(matchedEntry["name"]), "value.txt")
expectStr(path.nameExt(string(matchedEntry["path"])), "value.txt")
expect(int(matchedEntry["size"]), 6)
expect(bool(matchedEntry["isFile"]), 1)
expect(bool(matchedEntry["isDir"]), 0)
array entryItems = dir.entries(dirPath, true)
expect(entryItems.length, 2)
array walkItems = dir.walk(dirPath)
int leaveCount = 0
for walkEntry in walkItems
    if bool(walkEntry["leave"]) then
        leaveCount += 1
    end
end
expect(walkItems.length, 3)
expect(leaveCount, 1)
expect(dir.ensureEmpty(cleanNested), 1)
expect(dir.exists(cleanNested), 1)
expect(file.writeText(cleanFile, "abc"), 1)
expect(dir.empty(cleanDir), 0)
expect(dir.clean(cleanDir), 1)
expect(dir.exists(cleanDir), 1)
expect(dir.empty(cleanDir), 1)
expect(dir.clean(""), 0)
expect(dir.copy(dirPath, copyDir), 1)
expect(dir.exists(copyDir), 1)
expectStr(file.readText(copyFile), "nested")
expect(dir.move(copyDir, movedDir), 1)
expect(dir.exists(copyDir), 0)
expect(dir.exists(movedDir), 1)
expectStr(file.readText(movedFile), "nested")
expect(dir.delete(movedDir), 1)
expect(dir.delete(cleanDir), 1)
expect(file.delete(binaryPath), 1)
expect(dir.delete(nestedDir), 1)
expect(dir.delete(dirPath), 1)
expect(dir.exists(dirPath), 0)
