class Point
    int x = 0
    int y = 0

    create(int x, int y)
        self.x = x
        self.y = y
        return
    end

    func length2() -> int
        return self.x * self.x + self.y * self.y
    end
end

extern "expect_i64" func expect(int actual, int expected)

auto p = Point(3, 4)
int value = p.length2()
expect(value, 25)
