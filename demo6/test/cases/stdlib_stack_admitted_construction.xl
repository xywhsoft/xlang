class AdmittedItem
    int value = 7
end

enum AdmittedI8 as int8
    low = -128
    high = 127
end

func primitive() as bool
    Stack<string> text = Stack::<string>()
    assert(text.push("a\0你") and string.byteLen(text.peek()) == 5)
    assert(text.pop() == "a\0你")
    Stack<int8?> numbers = Stack::<int8?>()
    assert(numbers.push(null) and numbers.push(int8(-128)))
    auto found, item = numbers.tryPop()
    int8? expected = int8(-128)
    assert(found and item == expected and numbers.pop() == null)
    return true
end

func reference() as bool
    Stack<bytes> data = Stack::<bytes>()
    bytes value = b"a\0b"
    assert(data.push(value) and data.peek() == value)
    Stack<bytes> copy = data.clone()
    assert(copy.pop() == value and data.pop() == value)
    return true
end

func nominal() as bool
    Stack<AdmittedItem?> objects = Stack::<AdmittedItem?>()
    assert(objects.push(null) and objects.push(AdmittedItem()))
    Stack<AdmittedItem?> copy = objects.clone()
    AdmittedItem? item = copy.pop()
    assert(item != null and item.value == 7 and copy.pop() == null)
    return true
end

func nativeScalars() as bool
    Stack<c_int> integers = Stack::<c_int>()
    assert(integers.push(c_int(-7)) and integers.pop() == c_int(-7))
    Stack<c_int?> optional = Stack::<c_int?>()
    assert(optional.push(null) and optional.push(c_int(-7)))
    auto present = optional.pop()
    assert(present != null and present == c_int(-7) and optional.pop() == null)
    return true
end

func numericEnums() as bool
    Stack<AdmittedI8> values = Stack::<AdmittedI8>()
    assert(values.push(AdmittedI8.low) and values.pop() == AdmittedI8.low)
    Stack<AdmittedI8?> optional = Stack::<AdmittedI8?>()
    assert(optional.push(null) and optional.push(AdmittedI8.high))
    AdmittedI8? present = optional.pop()
    AdmittedI8? expected = AdmittedI8.high
    assert(present == expected and optional.pop() == null)
    return true
end

func nested() as bool
    Stack<int> child = Stack::<int>()
    assert(child.push(7))
    Stack<Stack<int>> outer = Stack::<Stack<int>>()
    assert(outer.push(child))
    Stack<Stack<int>> copy = outer.clone()
    Stack<int> observed = copy.peek()
    assert(observed.peek() == 7)
    assert(child.push(9) and observed.peek() == 9)
    Stack<Stack<int>?> optional = Stack::<Stack<int>?>()
    assert(optional.push(null) and optional.push(child))
    Stack<int>? read = optional.pop()
    assert(read != null)
    assert(optional.pop() == null)
    assert(child.pop() == 9)
    Stack<Stack<Stack<int>>> deep = Stack::<Stack<Stack<int>>>()
    assert(deep.push(outer))
    Stack<Stack<int>> middle = deep.pop()
    Stack<int> inner = middle.peek()
    assert(inner.pop() == 7)
    return true
end

func main(...) as int
    assert(primitive() and reference() and nominal() and nativeScalars() and numericEnums() and nested())
    return 0
end
