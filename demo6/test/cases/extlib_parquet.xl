import parquet

func main(...) as int
    // Data types
    assert parquet.dataType(0) == "BOOLEAN", "type bool"
    assert parquet.dataType(2) == "INT64", "type int64"
    assert parquet.dataType(6) == "BYTE_ARRAY", "type bytes"

    // Encoding
    assert parquet.encoding(0) == "PLAIN", "enc plain"
    assert parquet.encoding(2) == "RLE", "enc rle"
    assert parquet.encoding(7) == "RLE_DICTIONARY", "enc rle_dict"

    // Compression
    assert parquet.compression(0) == "UNCOMPRESSED", "comp none"
    assert parquet.compression(1) == "SNAPPY", "comp snappy"
    assert parquet.compression(6) == "ZSTD", "comp zstd"

    // Repetition
    assert parquet.repetition(0) == "REQUIRED", "rep req"
    assert parquet.repetition(1) == "OPTIONAL", "rep opt"

    // Converted types
    assert parquet.convertedType(0) == "UTF8", "conv utf8"
    assert parquet.convertedType(5) == "DATE", "conv date"

    // Size estimation: 1000 rows * 10 cols * 8 bytes = 80000
    assert parquet.estimateSize(1000, 10, 8) == 80000, "estimate"

    // Page types
    assert parquet.pageType(0) == "DATA_PAGE", "page data"
    assert parquet.pageType(2) == "DICTIONARY_PAGE", "page dict"

    return 0
end
