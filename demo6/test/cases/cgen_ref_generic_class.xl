extern "expect_i64" func expect(int actual, int expected)

class RefGenericBox<T>
    T value

    create(T input)
        self.value = input
    end

    func get() as T
        return self.value
    end

    func add(T amount) as T
        return self.value + amount
    end

    func __item__(int index) as T
        assert index == 0
        return self.value
    end

    func __add__(T amount) as T
        return self.value + amount
    end
end

ref<RefGenericBox<int>> box = ref(RefGenericBox::<int>(40))

expect(box.value, 40)
expect(box.get(), 40)
expect(box.add(1), 41)
expect(box[0], 40)
expect(box + 2, 42)

