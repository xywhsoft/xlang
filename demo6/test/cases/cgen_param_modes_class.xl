class ParamModeBox
    int value

    create(int value)
        self.value = value
    end

end

func mutate(ParamModeBox box)
    box.value = 20
end

func mutateCopy(byval ParamModeBox box)
    box.value = 30
end

func rebindLocal(byval ParamModeBox box)
    box = ParamModeBox(35)
end

func replace(byref ParamModeBox box)
    ParamModeBox next = ParamModeBox(40)
    box = next
end

func writeValue(out int value)
    value = 50
end

ParamModeBox box = ParamModeBox(10)
mutate(box)
assert box.value == 20

mutateCopy(box)
assert box.value == 30

rebindLocal(box)
assert box.value == 30

replace(byref box)
assert box.value == 40

int value = 0
writeValue(out value)
assert value == 50
