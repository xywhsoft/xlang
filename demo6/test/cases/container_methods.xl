var arr = [1, 3]
assert arr.push(4) == true, "array.push should append one value"
assert arr.insert(1, 2) == true, "array.insert should insert value at index"
assert arr.length == 4, "array insert/push should update length"
assert int(arr[0]) == 1, "array first value should stay unchanged"
assert int(arr[1]) == 2, "array inserted value should be readable"
assert arr.contains(3) == true, "array.contains should find existing value"
assert arr.remove(2) == true, "array.remove should remove one value by index"
assert arr.length == 3, "array.remove should update length"
assert int(arr.pop()) == 4, "array.pop should take last value"
assert int(arr.take(0)) == 1, "array.take should remove and return value"
assert arr.reserve(8) == true, "array.reserve should preallocate capacity"
assert arr.push(5) == true, "array.push should still work after reserve"
assert arr.swap(0, 1) == true, "array.swap should exchange values"
assert int(arr[0]) == 5, "array.swap should move second value to first slot"
assert arr.clear() == true, "array.clear should remove all values"
assert arr.length == 0, "array.clear should update length"

var lst = list[0: "a", 2: "b"]
assert lst.contains("b") == true, "list.contains should scan values"
assert lst.remove(0) == true, "list.remove should delete sparse key"
assert lst.length == 1, "list.remove should update length"
assert string(lst.take(2)) == "b", "list.take should remove and return value"
assert lst.length == 0, "list.take should update length"
assert lst.clear() == true, "list.clear should be valid on empty list"

var st = set{1, 2}
assert st.add(3) == true, "set.add should insert value"
assert st.contains(3) == true, "set.contains should find inserted value"
assert st.remove(2) == true, "set.remove should delete value"
assert st.contains(2) == false, "set.remove should update membership"
assert st.clear() == true, "set.clear should remove all values"
assert st.length == 0, "set.clear should update length"

var tbl = {"a": 1, "b": 2}
assert tbl.contains("a") == true, "dict.contains should check key"
assert int(tbl.take("a")) == 1, "dict.take should remove and return value"
assert tbl.contains("a") == false, "dict.take should update membership"
assert tbl.remove("b") == true, "dict.remove should delete key"
assert tbl.clear() == true, "dict.clear should remove all keys"
assert tbl.length == 0, "dict.clear should update length"

array<int> typedArr = array[1]
assert typedArr.push(2) == true, "typed array.push should append value"
assert typedArr.append(3) == true, "typed array.append should append value"
assert typedArr.remove(1) == true, "typed array.remove should use xlang zero-based index"
assert typedArr.length == 2, "typed array.remove should update length"
assert typedArr[0] == 1, "typed array first value should stay"
assert typedArr[1] == 3, "typed array removed middle value"

list<string> typedList = list[7: "keep", 9: "drop"]
assert typedList.remove(9) == true, "typed list.remove should delete sparse key"
assert typedList.length == 1, "typed list.remove should update length"

set<int> typedSet = set{1}
assert typedSet.add(2) == true, "typed set.add should insert value"
assert typedSet.contains(2) == true, "typed set.contains should find inserted value"
assert typedSet.remove(1) == true, "typed set.remove should delete value"
assert typedSet.contains(1) == false, "typed set.remove should update membership"

dict<int> typedDict = dict{"x": 10, "y": 20}
assert typedDict.contains("x") == true, "typed dict.contains should check key"
assert typedDict.remove("x") == true, "typed dict.remove should delete key"
assert typedDict.contains("x") == false, "typed dict.remove should update membership"

var dynamicArray = [10, 20]
assert dynamicArray.pop() == 20, "var.pop should dispatch to array pop"

println("container methods ok")
