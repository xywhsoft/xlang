// Exercise the current typed Process ABI, not the retired point/dict facade.
// The private child is portable; do not invoke cmd, more or an external service.
string child = env.get("XL6_PROCESS_CHILD") ?? ""
assert child != ""
assert process.stdin == 0 and process.stdout == 1 and process.stderr == 2
assert process.stdioInherit == 0 and process.stdioPipe == 1 and process.stdioNull == 2
assert process.stateRunning == 0 and process.stateExited == 1

ProcessCommand envCommand = process.cmd(child, ["env", "XL6_PROCESS_EXT"])
envCommand.workDir(".")
envCommand.env("XL6_PROCESS_EXT", "configured")
envCommand.inheritEnv(false)
envCommand.processGroup(false)
envCommand.newConsole(false)
envCommand.hideWindow(true)
envCommand.stdio(process.stdout, process.stdioPipe)
envCommand.stdio(process.stderr, process.stdioNull)
// Capture bounds belong to immutable run options, not mutable live event queues.
ProcessRunOptions options = ProcessRunOptions(5000, 1024 * 1024, 1024 * 1024)
ProcessResult envResult = process.run(envCommand, options)
assert envResult.success and envResult.stdoutText() == "configured"
assert not envResult.timedOut and not envResult.cancelled
auto resultExit = envResult.status
assert resultExit.kind == 1 and resultExit.code == 0

// Owned Reader maintains its byte position; retired event/cursor dictionaries
// are deliberately not reconstructed. Every read keeps exact binary lengths.
Process ioProcess = process.startFile(child, ["echo"])
auto inputWriter = ioProcess.stdinWriter()
auto stdoutReader = ioProcess.stdoutReader()
auto stderrReader = ioProcess.stderrReader()
inputWriter.writeAll(b"incremental-out\n")
inputWriter.close()
assert stdoutReader.readExact(4) == b"incr"
assert stdoutReader.readAll() == b"emental-out\n"
assert stderrReader.readAll() == b"E\0R"
auto processExit = ioProcess.wait(5000)
assert processExit != null
if processExit != null then assert processExit.kind == 1 and processExit.code == 0 end
assert ioProcess.state == process.stateExited
stdoutReader.close()
stderrReader.close()

// The byte-oriented writer also accepts Buffer; NUL is not a text terminator.
Buffer input = Buffer()
assert input.append("bytes\0process\n")
Process bytesProcess = process.startFile(child, ["echo"])
auto bytesWriter = bytesProcess.stdinWriter()
auto bytesReader = bytesProcess.stdoutReader()
auto bytesErrors = bytesProcess.stderrReader()
bytesWriter.writeAll(input)
bytesWriter.close()
assert bytesReader.readAll() == b"bytes\0process\n"
assert bytesErrors.readAll() == b"E\0R"
auto bytesExit = bytesProcess.wait(5000)
assert bytesExit != null
if bytesExit != null then assert bytesExit.code == 0 end
bytesReader.close()
bytesErrors.close()

// Invalid configuration now raises checked errors instead of bool failure.
int rejected = 0
try
    envCommand.stdio(9, process.stdioPipe)
catch e
    rejected += 1
end
try
    envCommand.terminalSize(0, 24)
catch e
    rejected += 1
end
try
    bytesProcess.resize(0, 0)
catch e
    rejected += 1
end
assert rejected == 3
bool terminalAvailable = process.terminalSupported()
assert terminalAvailable or not terminalAvailable

Process asyncProcess = process.startFile(child, ["exit", "0"])
future<ProcessExitStatus> waitFuture = asyncProcess.waitAsync()
auto asyncExit = await waitFuture
assert asyncExit.kind == 1 and asyncExit.code == 0
assert not asyncProcess.running

// clearEnv releases the command's overrides, not the host environment.
envCommand.clearEnv()
assert envCommand.run(options).exitCode == 17
assert resultExit.code == 0 and envResult.stdoutText() == "configured"
println("stdlib process extended ok")
