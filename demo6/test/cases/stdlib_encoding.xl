string text = "A\0你😀"
assert encoding.unitSize(encoding.unknown) == 0
assert encoding.unitSize(encoding.utf8) == 1
assert encoding.unitSize(encoding.utf16LE) == 2
assert encoding.unitSize(encoding.utf16BE) == 2
assert encoding.unitSize(encoding.utf32LE) == 4
assert encoding.unitSize(encoding.utf32BE) == 4
assert encoding.name(encoding.unknown) == "unknown"
assert encoding.name(encoding.utf16LE) == "utf-16le"
assert encoding.name(encoding.utf32BE) == "utf-32be"
assert encoding.isUtf8(text) and encoding.isUtf8(b"A\0")
assert not encoding.isUtf8(b"A\xFF")
assert encoding.isUtf8(b"A\xFF", 1)
bytes utf8 = encoding.encodeUtf8(text)
assert encoding.decode(utf8, encoding.utf8, encoding.strict, encoding.stripBom) == text
bytes le16 = encoding.encodeUtf16LE(text)
bytes be16 = encoding.encodeUtf16BE(text)
bytes le32 = encoding.encodeUtf32LE(text)
bytes be32 = encoding.encodeUtf32BE(text)
assert encoding.decodeUtf8(utf8) == text
assert encoding.decodeUtf16LE(le16) == text
assert encoding.decodeUtf16BE(be16) == text
assert encoding.decodeUtf32LE(le32) == text
assert encoding.decodeUtf32BE(be32) == text
assert utf8 == b"A\0\xE4\xBD\xA0\xF0\x9F\x98\x80"
assert le16 == b"A\0\0\0\x60\x4F\x3D\xD8\0\xDE"
assert be16 == b"\0A\0\0\x4F\x60\xD8\x3D\xDE\0"
assert le32 == b"A\0\0\0\0\0\0\0\x60\x4F\0\0\0\xF6\x01\0"
assert be32 == b"\0\0\0A\0\0\0\0\0\0\x4F\x60\0\x01\xF6\0"
for kind in [1,2,3,4,5]
    bytes marked = encoding.encode(text, kind, true)
    assert encoding.bom(marked) == kind
    assert encoding.bomSize(marked) == (kind == 1 ? 3 : kind < 4 ? 2 : 4)
    assert encoding.decode(marked, kind, 0, encoding.requireBom) == text
    assert encoding.transcode(marked, kind, encoding.utf8) == utf8
    assert encoding.decode(encoding.encode("", kind, true), kind) == ""
end
assert encoding.bom(b"x") == encoding.unknown
assert encoding.bomSize(b"x") == 0
assert encoding.bomBytes(encoding.utf8) == b"\xEF\xBB\xBF"
assert encoding.bomBytes(encoding.utf16LE) == b"\xFF\xFE"
assert encoding.bomBytes(encoding.utf16BE) == b"\xFE\xFF"
assert encoding.bomBytes(encoding.utf32LE) == b"\xFF\xFE\0\0"
assert encoding.bomBytes(encoding.utf32BE) == b"\0\0\xFE\xFF"
assert encoding.bomSize(b"\xEF\xBB\xBFA", 2) == 0
assert encoding.decode(b"\xFF\xFE\0\0", encoding.utf16LE) == "\0"
assert encoding.decode(b"\xFF\xFE\0\0", encoding.utf32LE) == ""
assert encoding.decode(b"\xFF\xFE\0\0", encoding.utf16LE, 0, encoding.keepBom) == "\uFEFF\0"
assert encoding.decode(b"\xE4\xBD", 1, encoding.replaceInvalid) == "\uFFFD"
assert encoding.decode(b"\xC0\xAF", 1, encoding.replaceInvalid) == "\uFFFD\uFFFD"
assert encoding.decode(b"\0\xD8A\0", 2, encoding.replaceInvalid) == "\uFFFDA"
assert encoding.decode(b"A\0\0\0\xFF", 4, encoding.replaceInvalid) == "A\uFFFD"
assert encoding.encode(text, 1, false, 0, 1000) == utf8
assert encoding.decode(utf8, 1, 0, 0, 2) == "A\0"
assert encoding.decode(encoding.encode("你", 2, false, 1, 1), 2) == "\uFFFD"
bytes copy = encoding.transcode(utf8, 1, 1)
copy[0] = uint8(66)
assert utf8[0] == uint8(65)
int caught = 0
try
    encoding.decode(b"\xFF")
catch ValueError e
    caught += 1
end
try
    encoding.decode(b"A", 2)
catch ValueError e
    caught += 1
end
try
    encoding.decode(b"A", 1, 0, encoding.requireBom)
catch ValueError e
    caught += 1
end
try
    encoding.decode(b"\xFF\xFEA\0", 1)
catch ValueError e
    caught += 1
end
try
    encoding.decode(b"\xEF\xBB\xBFA", 1, 0, encoding.rejectBom)
catch ValueError e
    caught += 1
end
try
    encoding.encode("A", encoding.unknown)
catch ValueError e
    caught += 1
end
try
    encoding.encode("A", 4294967297)
catch ValueError e
    caught += 1
end
try
    encoding.encode("A", 1, false, 2)
catch ValueError e
    caught += 1
end
try
    encoding.decode(b"A", 1, 0, 4)
catch ValueError e
    caught += 1
end
try
    encoding.transcode(b"A", 1, 1, 0, 8)
catch ValueError e
    caught += 1
end
try
    encoding.decode(b"A", 1, 0, 0, -2)
catch RangeError e
    caught += 1
end
try
    encoding.encode("你", 1, false, 0, 1)
catch ValueError e
    caught += 1
end
assert caught == 12
