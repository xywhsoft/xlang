func main(...) as int
    string? empty = ""
    string? text = "a\0b"
    string? item = "unchanged"
    SpscQueue<string?> queue = SpscQueue::<string?>(4)
    assert(queue.tryPush(null) and queue.tryPush("") and queue.tryPush(text))
    assert(queue.tryPopInto(item) and item == null)
    assert(queue.tryPopInto(item) and item == empty)
    assert(item != null)
    assert(queue.tryPopInto(item) and item == text)
    assert(not queue.tryPopInto(item) and item == text)

    AvlTree<int, string?> tree = AvlTree::<int, string?>()
    assert(tree.set(1, text) and tree.set(2, null))
    assert(tree.count() == 2)
    assert(tree.getInto(1, item) and item == text)
    assert(tree.getInto(2, item) and item == null)
    AvlTree<int, string?> copied = tree.clone()
    assert(tree.equals(copied))
    assert(copied.set(2, "") and not tree.equals(copied))
    array<string?> values = tree.values()
    array<string?> copiedValues = copied.values()
    assert(values.length == 2 and values[0] == text and values[1] == null)
    assert(copiedValues.length == 2 and copiedValues[1] == empty and copiedValues[1] != null)
    assert(tree.set(1, "changed") and values[0] == text)
    assert(tree.set(1, text))
    int key = 99
    assert(tree.firstInto(key, item) and key == 1 and item == text)
    assert(tree.lastInto(key, item) and key == 2 and item == null)
    assert(tree.takeInto(1, item) and item == text)
    assert(tree.count() == 1 and not tree.contains(1))
    return 0
end
