func joinArgs(array<var> args) as var
    string result = ""
    for value in args
        result += string(value)
    end
    return result
end

func upperRaw(array<var> args, string body) as string
    assert args.length == 1
    return string.upper(string(args[0]) + body)
end

func mark(array<var> args) as var
    assert args.length == 0
    return "M"
end

func enabled(array<var> args) as bool
    assert args.length == 1
    return bool(args[0])
end

func makeCustomTemplate() as Template
    TemplateEngine engine = template.engine()
    assert engine.registerFunction("join", joinArgs, 1, 4)
    assert engine.registerStatement("mark", mark, 0, 0)
    assert engine.registerBlock("enabled", enabled, 1, 1)
    assert engine.registerRawBlock("upperraw", upperRaw, 1, 1)
    return engine.compile("{@join:'A':'B'}|{#upperraw:'x'}hello{#end}|{#mark}|{#enabled:true}Y{#end}")
end

Template custom = makeCustomTemplate()
assert custom.render() == "AB|XHELLO|M|Y"
assert custom.valid
assert custom.source == "{@join:'A':'B'}|{#upperraw:'x'}hello{#end}|{#mark}|{#enabled:true}Y{#end}"

assert int(custom.node(0)["type"]) >= 0
assert int(custom.node(0)["line"]) > 0

string outputDir = "build/test/stdlib_template_engine"
string outputPath = outputDir + "/compiled.xte"
dir.createAll(outputDir)

assert file.writeText(outputPath, "Saved {$name}")
Template loaded = template.compileFile(outputPath)
assert loaded.valid
assert loaded.render({"name": "Ada"}) == "Saved Ada"

Template bad = template.compile("{#for:1:3:0}X{#end}")
assert bad.render() == ""
var renderError = bad.error()
assert int(renderError["code"]) > 0
assert string(renderError["description"]) != ""

TemplateEngine errorEngine = template.engine()
Template invalid = errorEngine.compile("{@missing}")
assert not invalid.valid
var parseError = errorEngine.error()
assert int(parseError["code"]) > 0
assert string(parseError["description"]) != ""

file.delete(outputPath)
dir.delete(outputDir)
