import sharedmem

func main(...) as int
    string testName = "xlang_test_shm_" + crypto.randomString(20)
    auto sm = sharedmem.create(testName, 4096)
    assert sm.size == 4096
    assert sm.name == testName

    sm.writeText(0, "Hello SharedMem")
    assert sm.readText(0, 15) == "Hello SharedMem"

    sm.writeInt(100, 123456789)
    assert sm.readInt(100) == 123456789
    sm.writeInt(200, -42)
    assert sm.readInt(200) == -42

    sm.zero()
    assert sm.readInt(100) == 0
    Buffer empty = sm.read(0, 10)
    assert empty.len() == 10
    assert empty.byteAt(0) == 0
    return 0
end
