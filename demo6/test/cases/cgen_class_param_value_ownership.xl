class ValueBox
    string text

    create(string value)
        self.text = value
    end
end

class GenericValueBox<T>
    T value
    string text

    create(T value, string text)
        self.value = value
        self.text = text
    end
end

func mutateShared(ValueBox box, string value) as string
    box.text = value
    return box.text
end

func mutateLocal(ValueBox box, string value) as string
    box.text = value
    return box.text
end

func mutateGenericShared(GenericValueBox<int> box, string value) as string
    box.value = box.value + 1
    box.text = value
    return box.text
end

func mutateGenericLocal(GenericValueBox<int> box, string value) as string
    box.value = box.value + 1
    box.text = value
    return box.text
end

func rebindLocal(ValueBox box)
    box = ValueBox("rebound")
end

ValueBox source = ValueBox("source")
GenericValueBox<int> genericSource = GenericValueBox::<int>(7, "generic-source")

for i in range(0, 64)
    assert mutateShared(source, "shared") == "shared", "default class parameter mutation failed"
    assert source.text == "shared", "default class parameter should preserve object identity"
    source.text = "source"

    assert mutateLocal(source, "local") == "local", "class parameter mutation failed"
    assert source.text == "local", "class parameter must preserve object identity"
    rebindLocal(source)
    assert source.text == "local", "class parameter must not replace the caller slot"
    source.text = "source"

    assert mutateGenericShared(genericSource, "generic-shared") == "generic-shared", "default generic class mutation failed"
    assert genericSource.value == 8, "default generic class parameter should preserve object identity"
    assert genericSource.text == "generic-shared", "default generic class string mutation should be visible"
    genericSource.value = 7
    genericSource.text = "generic-source"

    assert mutateGenericLocal(genericSource, "generic-local") == "generic-local", "generic class parameter mutation failed"
    assert genericSource.value == 8, "generic class must preserve object identity"
    assert genericSource.text == "generic-local", "generic class string mutation must be visible"
    genericSource.value = 7
    genericSource.text = "generic-source"
end

println("class managed-handle parameter ownership ok")
