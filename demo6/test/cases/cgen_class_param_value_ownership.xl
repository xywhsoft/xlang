class ValueBox
    derive copy
    string text

    create(string value)
        self.text = value
    end
end

class GenericValueBox<T>
    derive copy
    T value
    string text

    create(T value, string text)
        self.value = value
        self.text = text
    end
end

func mutateShared(ValueBox box, string value) as string
    box.text = value
    return box.text
end

func mutateCopy(byval ValueBox box, string value) as string
    box.text = value
    return box.text
end

func mutateGenericShared(GenericValueBox<int> box, string value) as string
    box.value = box.value + 1
    box.text = value
    return box.text
end

func mutateGenericCopy(byval GenericValueBox<int> box, string value) as string
    box.value = box.value + 1
    box.text = value
    return box.text
end

ValueBox source = ValueBox("source")
GenericValueBox<int> genericSource = GenericValueBox::<int>(7, "generic-source")

for i in range(0, 64)
    assert mutateShared(source, "shared") == "shared", "default class parameter mutation failed"
    assert source.text == "shared", "default class parameter should preserve object identity"
    source.text = "source"

    assert mutateCopy(source, "local") == "local", "byval class parameter mutation failed"
    assert source.text == "source", "byval class parameter changed caller object"

    assert mutateGenericShared(genericSource, "generic-shared") == "generic-shared", "default generic class mutation failed"
    assert genericSource.value == 8, "default generic class parameter should preserve object identity"
    assert genericSource.text == "generic-shared", "default generic class string mutation should be visible"
    genericSource.value = 7
    genericSource.text = "generic-source"

    assert mutateGenericCopy(genericSource, "generic-local") == "generic-local", "byval generic class mutation failed"
    assert genericSource.value == 7, "byval generic class changed caller scalar field"
    assert genericSource.text == "generic-source", "byval generic class changed caller string field"
end

println("class parameter reference and byval ownership ok")
