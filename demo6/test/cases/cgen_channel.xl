channel<int> ch = channel::<int>(4)

bool sent = ch.send(42)
int value = 0
bool received = ch.recvInto(value)

assert sent, "channel send failed"
assert received, "channel recv failed"
assert value == 42, "channel value mismatch"
assert ch.count() == 0, "channel count mismatch"

ch.close()
bool closed = ch.isClosed()
bool empty = ch.tryRecvInto(value)

assert closed, "channel close failed"
assert not empty, "closed channel should not receive"

auto autoCh = channel::<int>(1)
auto autoSent = autoCh.send(7)
int autoValue = 0
auto autoReceived = autoCh.recvInto(autoValue)

assert autoSent, "auto channel send failed"
assert autoReceived, "auto channel recv failed"
assert autoValue == 7, "auto channel value mismatch"

autoCh.close()

channel<bool> boolCh = channel::<bool>(2)
bool boolValue = false

assert boolCh.send(true), "bool channel send failed"
assert boolCh.recvInto(boolValue), "bool channel recv failed"
assert boolValue, "bool channel value mismatch"
assert not boolCh.tryRecvInto(boolValue), "empty bool channel should not receive"

channel<var> varCh = channel::<var>(2)
assert varCh.send(123), "var channel int send failed"
assert varCh.send("abc"), "var channel string send failed"

var varValue = null
assert varCh.recvInto(varValue), "var channel int recv failed"
assert int(varValue) == 123, "var channel int value mismatch"
assert varCh.recvInto(varValue), "var channel string recv failed"
assert string(varValue) == "abc", "var channel string value mismatch"
assert not varCh.tryRecvInto(varValue), "empty var channel should not receive"
varCh.close()
assert varCh.isClosed(), "var channel close failed"

channel<float> floatCh = channel::<float>(1)
float floatValue = 0.0

assert floatCh.send(1.5), "float channel send failed"
assert floatCh.recvInto(floatValue), "float channel recv failed"
assert floatValue == 1.5, "float channel value mismatch"

channel<time> timeCh = channel::<time>(1)
time timeValue = #00:00:00#

assert timeCh.send(#12:34:56#), "time channel send failed"
assert timeCh.recvInto(timeValue), "time channel recv failed"
assert timeValue == #12:34:56#, "time channel value mismatch"

channel<int> closedCh = channel::<int>(1)
closedCh.close()
assert not closedCh.send(1), "closed channel send should fail"

channel<int> defaultCh = channel::<int>()
assert not defaultCh.isClosed(), "default channel should start open"
assert defaultCh.send(1), "default channel first send failed"
assert defaultCh.send(2), "default channel second send failed"
assert defaultCh.count() == 2, "default channel count after send failed"

int defaultFirst = 0
assert defaultCh.tryRecvInto(defaultFirst), "default channel tryRecv should drain first value"
assert defaultFirst == 1, "default channel first value mismatch"
assert defaultCh.count() == 1, "default channel count after tryRecv failed"

defaultCh.close()
assert defaultCh.isClosed(), "default channel should report closed"

int defaultSecond = 0
assert defaultCh.recvInto(defaultSecond), "closed channel should drain buffered value"
assert defaultSecond == 2, "closed channel buffered value mismatch"
assert not defaultCh.tryRecvInto(defaultSecond), "closed drained channel should not receive"
assert not defaultCh.send(3), "closed default channel send should fail"

defaultCh.close()
assert defaultCh.isClosed(), "channel close should be idempotent"

channel<int> fullCh = channel::<int>(1)
assert fullCh.send(10), "full channel first send failed"
assert fullCh.send(11), "capacity-one channel should normalize to two slots"
assert not fullCh.trySend(12), "full channel third trySend should fail"

int fullValue = 0
assert fullCh.recvInto(fullValue), "full channel receive failed"
assert fullValue == 10, "full channel value mismatch"

channel<int> crossThreadCh = channel::<int>(4)
auto channelProducer = func() as int
    if not crossThreadCh.send(314) then
        return 10
    end
    if not crossThreadCh.send(159) then
        return 11
    end
    crossThreadCh.close()
    return 17
end

thread producerThread = thread(channelProducer)
assert producerThread.waitTimeout(2000), "channel producer thread wait failed"
assert producerThread.exitCode() == 17, "channel producer thread exit failed"
assert crossThreadCh.isClosed(), "cross-thread channel close should be visible"

int crossFirst = 0
int crossSecond = 0
assert crossThreadCh.recvInto(crossFirst), "cross-thread channel first recv failed"
assert crossFirst == 314, "cross-thread channel first value mismatch"
assert crossThreadCh.recvInto(crossSecond), "cross-thread channel second recv failed"
assert crossSecond == 159, "cross-thread channel second value mismatch"
assert not crossThreadCh.tryRecvInto(crossSecond), "cross-thread closed drained channel should not receive"
assert not crossThreadCh.send(265), "cross-thread closed channel send should fail"

channel<int> delayedRecvCh = channel::<int>(1)
auto delayedRecvProducer = func() as int
    time.sleep(30)
    if not delayedRecvCh.send(271) then
        return 10
    end
    return 19
end

thread delayedRecvThread = thread(delayedRecvProducer)
int delayedRecvValue = 0
assert delayedRecvCh.recvInto(delayedRecvValue), "blocking recv should wake after producer send"
assert delayedRecvValue == 271, "blocking recv producer value mismatch"
assert delayedRecvThread.waitTimeout(2000), "blocking recv producer thread wait failed"
assert delayedRecvThread.exitCode() == 19, "blocking recv producer thread exit failed"
delayedRecvCh.close()
assert delayedRecvCh.isClosed(), "blocking recv channel close failed"

channel<int> delayedConsumerCh = channel::<int>(1)
auto delayedConsumer = func() as int
    int got = 0
    if not delayedConsumerCh.recvInto(got) then
        return 10
    end
    return got
end

thread delayedConsumerThread = thread(delayedConsumer)
time.sleep(30)
assert delayedConsumerCh.send(2718), "blocking consumer send should wake receiver thread"
assert delayedConsumerThread.waitTimeout(2000), "blocking consumer thread wait failed"
assert delayedConsumerThread.exitCode() == 2718, "blocking consumer thread exit failed"
delayedConsumerCh.close()
assert delayedConsumerCh.isClosed(), "blocking consumer channel close failed"

channel<int> nonblockingTryThreadCh = channel::<int>(1)
auto nonblockingTryConsumer = func() as int
    int got = 0
    if nonblockingTryThreadCh.tryRecvInto(got) then
        return got
    end
    return 31
end

thread nonblockingTryThread = thread(nonblockingTryConsumer)
assert nonblockingTryThread.waitTimeout(2000), "nonblocking tryRecv thread wait failed"
assert nonblockingTryThread.exitCode() == 31, "empty tryRecv in thread should return false"
assert nonblockingTryThreadCh.send(42), "nonblocking tryRecv should leave channel usable"
int nonblockingTryLater = 0
assert nonblockingTryThreadCh.recvInto(nonblockingTryLater), "nonblocking tryRecv later recv failed"
assert nonblockingTryLater == 42, "nonblocking tryRecv later value mismatch"
nonblockingTryThreadCh.close()
assert nonblockingTryThreadCh.isClosed(), "nonblocking tryRecv channel close failed"

channel<int> timeoutCh = channel::<int>(1)
int timeoutValue = 0
assert not timeoutCh.recvTimeoutInto(timeoutValue, 10), "empty recvTimeoutInto should time out"
assert timeoutValue == 0, "recvTimeoutInto timeout should not modify target"
assert timeoutCh.send(808), "recvTimeoutInto send setup failed"
assert timeoutCh.recvTimeoutInto(timeoutValue, 100), "recvTimeoutInto should receive buffered value"
assert timeoutValue == 808, "recvTimeoutInto value mismatch"
timeoutCh.close()
assert not timeoutCh.recvTimeoutInto(timeoutValue, 0), "closed recvTimeoutInto should fail"

channel<int> closeWakeCh = channel::<int>(1)
auto closeWakeConsumer = func() as int
    int got = 0
    if closeWakeCh.recvInto(got) then
        return got
    end
    return -1
end

thread closeWakeThread = thread(closeWakeConsumer)
time.sleep(30)
closeWakeCh.close()
assert closeWakeThread.waitTimeout(2000), "blocking recv should wake after channel close"
assert closeWakeThread.exitCode() == -1, "blocking recv after close should return false"
