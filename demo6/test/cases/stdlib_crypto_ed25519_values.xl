assert key_context.signContext(b"\xf7\x26\x93\x6d\x19\xc8\x00\x49\x4e\x3f\xda\xff\x20\xb2\x76\xa8",b"\x66\x6f\x6f") == b"\x55\xa4\xcc\x2f\x70\xa5\x4e\x04\x28\x8c\x5f\x4c\xd1\xe4\x5a\x7b\xb5\x20\xb3\x62\x92\x91\x18\x76\xca\xda\x73\x23\x19\x8d\xd8\x7a\x8b\x36\x95\x0b\x95\x13\x00\x22\x90\x7a\x7f\xb7\xc4\xe9\xb2\xd5\xf6\xcc\xa6\x85\xa5\x87\xb4\xb2\x1f\x4b\x88\x8e\x4e\x7e\xdb\x0d"
assert crypto.ed25519VerifyContext(key_context.publicKey,b"\xf7\x26\x93\x6d\x19\xc8\x00\x49\x4e\x3f\xda\xff\x20\xb2\x76\xa8",b"\x55\xa4\xcc\x2f\x70\xa5\x4e\x04\x28\x8c\x5f\x4c\xd1\xe4\x5a\x7b\xb5\x20\xb3\x62\x92\x91\x18\x76\xca\xda\x73\x23\x19\x8d\xd8\x7a\x8b\x36\x95\x0b\x95\x13\x00\x22\x90\x7a\x7f\xb7\xc4\xe9\xb2\xd5\xf6\xcc\xa6\x85\xa5\x87\xb4\xb2\x1f\x4b\x88\x8e\x4e\x7e\xdb\x0d",b"\x66\x6f\x6f")
auto seed_prehash = b"\x83\x3f\xe6\x24\x09\x23\x7b\x9d\x62\xec\x77\x58\x75\x20\x91\x1e\x9a\x75\x9c\xec\x1d\x19\x75\x5b\x7d\xa9\x01\xb9\x6d\xca\x3d\x42"
