assert key_prehash.exportSeed() == seed_prehash
assert crypto.ed25519PublicKey(seed_prehash) == key_prehash.publicKey
assert crypto.sha512("abc") == b"\xdd\xaf\x35\xa1\x93\x61\x7a\xba\xcc\x41\x73\x49\xae\x20\x41\x31\x12\xe6\xfa\x4e\x89\xa9\x7e\xa2\x0a\x9e\xee\xe6\x4b\x55\xd3\x9a\x21\x92\x99\x2a\x27\x4f\xc1\xa8\x36\xba\x3c\x23\xa3\xfe\xeb\xbd\x45\x4d\x44\x23\x64\x3c\xe8\x0e\x2a\x9a\xc9\x4f\xa5\x4c\xa4\x9f"
assert key_prehash.signPrehash(b"\xdd\xaf\x35\xa1\x93\x61\x7a\xba\xcc\x41\x73\x49\xae\x20\x41\x31\x12\xe6\xfa\x4e\x89\xa9\x7e\xa2\x0a\x9e\xee\xe6\x4b\x55\xd3\x9a\x21\x92\x99\x2a\x27\x4f\xc1\xa8\x36\xba\x3c\x23\xa3\xfe\xeb\xbd\x45\x4d\x44\x23\x64\x3c\xe8\x0e\x2a\x9a\xc9\x4f\xa5\x4c\xa4\x9f") == b"\x98\xa7\x02\x22\xf0\xb8\x12\x1a\xa9\xd3\x0f\x81\x3d\x68\x3f\x80\x9e\x46\x2b\x46\x9c\x7f\xf8\x76\x39\x49\x9b\xb9\x4e\x6d\xae\x41\x31\xf8\x50\x42\x46\x3c\x2a\x35\x5a\x20\x03\xd0\x62\xad\xf5\xaa\xa1\x0b\x8c\x61\xe6\x36\x06\x2a\xaa\xd1\x1c\x2a\x26\x08\x34\x06"
assert crypto.ed25519VerifyPrehash(key_prehash.publicKey,b"\xdd\xaf\x35\xa1\x93\x61\x7a\xba\xcc\x41\x73\x49\xae\x20\x41\x31\x12\xe6\xfa\x4e\x89\xa9\x7e\xa2\x0a\x9e\xee\xe6\x4b\x55\xd3\x9a\x21\x92\x99\x2a\x27\x4f\xc1\xa8\x36\xba\x3c\x23\xa3\xfe\xeb\xbd\x45\x4d\x44\x23\x64\x3c\xe8\x0e\x2a\x9a\xc9\x4f\xa5\x4c\xa4\x9f",b"\x98\xa7\x02\x22\xf0\xb8\x12\x1a\xa9\xd3\x0f\x81\x3d\x68\x3f\x80\x9e\x46\x2b\x46\x9c\x7f\xf8\x76\x39\x49\x9b\xb9\x4e\x6d\xae\x41\x31\xf8\x50\x42\x46\x3c\x2a\x35\x5a\x20\x03\xd0\x62\xad\xf5\xaa\xa1\x0b\x8c\x61\xe6\x36\x06\x2a\xaa\xd1\x1c\x2a\x26\x08\x34\x06")
auto signatureText = key_one.sign("r")
// Ordinary verification mismatch: a valid public test signature, no malformed encoding.
assert not crypto.ed25519Verify(key_empty.publicKey,"different ordinary message",key_empty.sign(b""))
assert signatureText == b"\x92\xa0\x09\xa9\xf0\xd4\xca\xb8\x72\x0e\x82\x0b\x5f\x64\x25\x40\xa2\xb2\x7b\x54\x16\x50\x3f\x8f\xb3\x76\x22\x23\xeb\xdb\x69\xda\x08\x5a\xc1\xe4\x3e\x15\x99\x6e\x45\x8f\x36\x13\xd0\xf1\x1d\x8c\x38\x7b\x2e\xae\xb4\x30\x2a\xee\xb0\x0d\x29\x16\x12\xbb\x0c\x00"
assert crypto.ed25519Sign(seed_one,"r") == signatureText
assert crypto.ed25519Verify(key_one.publicKey,"r",signatureText)
auto buffer = Buffer(b"r")
assert key_one.signBuffer(buffer) == signatureText
assert crypto.ed25519SignBuffer(seed_one,buffer) == signatureText
assert crypto.ed25519VerifyBuffer(key_one.publicKey,buffer,signatureText)
auto contextBuffer = Buffer(b"\xf7\x26\x93\x6d\x19\xc8\x00\x49\x4e\x3f\xda\xff\x20\xb2\x76\xa8")
assert key_context.signContextBuffer(contextBuffer,b"foo") == b"\x55\xa4\xcc\x2f\x70\xa5\x4e\x04\x28\x8c\x5f\x4c\xd1\xe4\x5a\x7b\xb5\x20\xb3\x62\x92\x91\x18\x76\xca\xda\x73\x23\x19\x8d\xd8\x7a\x8b\x36\x95\x0b\x95\x13\x00\x22\x90\x7a\x7f\xb7\xc4\xe9\xb2\xd5\xf6\xcc\xa6\x85\xa5\x87\xb4\xb2\x1f\x4b\x88\x8e\x4e\x7e\xdb\x0d"
assert crypto.ed25519VerifyContextBuffer(key_context.publicKey,contextBuffer,b"\x55\xa4\xcc\x2f\x70\xa5\x4e\x04\x28\x8c\x5f\x4c\xd1\xe4\x5a\x7b\xb5\x20\xb3\x62\x92\x91\x18\x76\xca\xda\x73\x23\x19\x8d\xd8\x7a\x8b\x36\x95\x0b\x95\x13\x00\x22\x90\x7a\x7f\xb7\xc4\xe9\xb2\xd5\xf6\xcc\xa6\x85\xa5\x87\xb4\xb2\x1f\x4b\x88\x8e\x4e\x7e\xdb\x0d",b"foo")
string message = "a\0你"
bytes binary = encoding.encodeUtf8(message)
bytes context = b"f\0o"
auto contextTextSignature = key_empty.signContext(message,context)
assert key_empty.signContext(binary,context) == contextTextSignature
assert crypto.ed25519VerifyContext(key_empty.publicKey,message,contextTextSignature,context)
assert crypto.ed25519VerifyContext(key_empty.publicKey,binary,contextTextSignature,context)
assert key_empty.sign(message) == key_empty.sign(binary)
assert key_empty.sign(message,0) == b"\xe5\x56\x43\x00\xc3\x60\xac\x72\x90\x86\xe2\xcc\x80\x6e\x82\x8a\x84\x87\x7f\x1e\xb8\xe5\xd9\x74\xd8\x73\xe0\x65\x22\x49\x01\x55\x5f\xb8\x82\x15\x90\xa3\x3b\xac\xc6\x1e\x39\x70\x1c\xf9\xb4\x6b\xd2\x5b\xf5\xf0\x59\x5b\xbe\x24\x65\x51\x41\x43\x8e\x7a\x10\x0b"
assert key_empty.sign(message,1000) == key_empty.sign(message)
assert key_empty.signContext(message,context,3) == key_empty.signContext(binary,context,3)
auto digest = crypto.sha512(message)
auto ph = key_empty.signPrehash(digest,context)
assert crypto.ed25519VerifyPrehash(key_empty.publicKey,digest,ph,context)
seed_empty[0] = uint8(0)
assert key_empty.exportSeed() == b"\x9d\x61\xb1\x9d\xef\xfd\x5a\x60\xba\x84\x4a\xf4\x92\xec\x2c\xc4\x44\x49\xc5\x69\x7b\x32\x69\x19\x70\x3b\xac\x03\x1c\xae\x7f\x60"
auto publicCopy = key_empty.publicKey
publicCopy[0] = uint8(0)
assert key_empty.publicKey == b"\xd7\x5a\x98\x01\x82\xb1\x0a\xb7\xd5\x4b\xfe\xd3\xc9\x64\x07\x3a\x0e\xe1\x72\xf3\xda\xa6\x23\x25\xaf\x02\x1a\x68\xf7\x07\x51\x1a"
auto generated = crypto.ed25519KeyPair()
auto restored = Ed25519Key(generated.exportSeed())
assert restored.publicKey == generated.publicKey
assert crypto.ed25519Verify(restored.publicKey,message,generated.sign(message))
array<Ed25519Key> owners = [key_empty,generated,restored]
assert owners[0].publicKey == key_empty.publicKey
int rejected = 0
try
    Ed25519Key(b"short")
catch e
    rejected += 1
end
try
    key_empty.signPrehash(b"short")
catch e
    rejected += 1
end
try
    key_empty.signContext(b"data",b"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")
catch e
    rejected += 1
end
try
    crypto.ed25519Verify(key_empty.publicKey,b"data",b"short")
catch e
    rejected += 1
end
try
    key_empty.sign(b"data",-2)
catch e
    rejected += 1
end
assert rejected == 5
println("managed Ed25519 pure/context/prehash, values and owned output: ok")
