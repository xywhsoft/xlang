// Offline valid public fixtures; ordinary ownership/API checks, no network traffic.
auto name = X509Name.fromDer(b"\x30\x3c\x31\x0b\x30\x09\x06\x03\x55\x04\x06\x13\x02\x43\x4e\x31\x2d\x30\x0e\x06\x03\x55\x04\x0b\x0c\x07\x72\x65\x63\x6f\x72\x64\x73\x30\x1b\x06\x03\x55\x04\x03\x0c\x14\x78\x6c\x61\x6e\x67\x20\xe7\xa6\xbb\xe7\xba\xbf\x20\x66\x69\x78\x74\x75\x72\x65")
assert name.equals(X509Name.fromDer(name.toDer()))
assert name.isWithin(name)
