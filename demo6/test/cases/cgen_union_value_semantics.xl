union PairValue
    int integer
    float64 decimal
end

func mutateDefault(PairValue value)
    value.integer = 20
    assert value.integer == 20
end

func mutateByVal(PairValue value)
    value.integer = 30
    assert value.integer == 30
end

func replacedValue(PairValue value) as PairValue
    value.integer = 40
    return value
end

func writeValue() as PairValue
    PairValue next
    next.integer = 50
    return next
end

func passThrough(PairValue value) as PairValue
    return value
end

func main(...) as int
    PairValue value
    value.integer = 10

    mutateDefault(value)
    assert value.integer == 10

    mutateByVal(value)
    assert value.integer == 10

    value = replacedValue(value)
    assert value.integer == 40

    PairValue output = writeValue()
    assert output.integer == 50

    PairValue copied = passThrough(output)
    copied.integer = 7
    assert copied.integer == 7
    assert output.integer == 50
    return 0
end
