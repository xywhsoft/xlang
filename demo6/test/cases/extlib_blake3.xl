import blake3



func main(...) as int
    // 一次性哈希：Buffer 与 string 重载一致。
    Buffer data = Buffer()
    data.append("abc")
    string hex = blake3.hashHex(data)
    if blake3.hashHex("abc") != hex then
        return 1
    end
    // 默认 32 字节 = 64 hex 字符。
    if string.len(hex) != 64 then
        return 2
    end

    // 可变输出长度。
    string long = blake3.hashHex(data, 64)
    if string.len(long) != 128 then
        return 3
    end

    // MAC 模式（keyed hash）。
    Buffer key = Buffer()
    key.append("0123456789abcdef0123456789abcdef")
    string mac = blake3.hashMacHex(data, key)
    if mac == hex then
        return 4
    end
    if string.len(mac) != 64 then
        return 5
    end

    // KDF 模式。
    string kdf = blake3.hashKdfHex(key, "test context")
    if string.len(kdf) != 64 then
        return 6
    end
    if kdf == hex then
        return 7
    end

    // 流式哈希器：分段 update 与一次性一致。
    auto hasher = blake3.hasher()
    hasher.update("ab")
    hasher.update("c")
    if hasher.digestHex() != hex then
        return 8
    end
    if hasher.inputBytes != 3 then
        return 9
    end

    // reset 复位。
    hasher.reset()
    hasher.update("abc")
    if hasher.digestHex() != hex then
        return 10
    end

    // clone 独立副本。
    auto h1 = blake3.hasher()
    h1.update("ab")
    auto h2 = h1.clone()
    h1.update("c")
    h2.update("x")
    if h1.digestHex() != hex then
        return 11
    end
    if h2.digestHex() == hex then
        return 12
    end

    // Keyed 流式哈希器。
    auto khasher = blake3.keyedHasher(key)
    khasher.update("abc")
    if khasher.digestHex() != mac then
        return 13
    end

    // 文件哈希与 Buffer 哈希一致。
    dir.createAll("build/test/blake3_cases")
    string path = "build/test/blake3_cases/main.bin"
    file.writeBytes(path, data.toBytes())
    if blake3.hashFileHex(path) != hex then
        return 14
    end
    bool badPath = false
    try
        blake3.hashFileHex(path + "\0hidden")
    catch ValueError e
        badPath = true
    end
    assert badPath
    file.delete(path)

    // 不存在的文件抛出 FileError。
    bool missing = false
    try
        blake3.hashFileHex("build/test/blake3_cases/missing.bin")
    catch FileError e
        missing = true
    end
    if not missing then
        return 15
    end

    // 非法限额抛出 ValueError。
    bool badLimit = false
    try
        blake3.hasher(0)
    catch ValueError e
        badLimit = true
    end
    if not badLimit then
        return 16
    end

    // digestBytes / hashBytes 返回 Buffer 长度正确。
    Buffer raw = blake3.hashBytes(data)
    if raw.len() != 32 then
        return 17
    end
    auto hb = blake3.hasher()
    hb.update("abc")
    if hb.digestBytes().len() != 32 then
        return 18
    end
    if hb.digestBytes(64).len() != 64 then
        return 19
    end

    return 0
end
