class RefIdentity
    int value

    create(int input)
        self.value = input
    end
end

ref<RefIdentity> empty = null
ref<RefIdentity> first = ref(RefIdentity(1))
ref<RefIdentity> alias = first
ref<RefIdentity> second = ref(RefIdentity(1))

assert empty == null
assert null == empty
assert first != null
assert first == alias
assert first != second

