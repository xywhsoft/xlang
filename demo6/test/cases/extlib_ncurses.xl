import ncurses



func main(...) as int
    // Init screen
    assert ncurses.init(10, 40), "init ok"
    assert ncurses.getMax() == 10040, "max 10x40"

    // Write text
    ncurses.mvAddStr(0, 0, "Hello")
    assert ncurses.getRow(0) == "Hello", "row 0"
    assert ncurses.inCh(0, 0) == 72, "char H"

    // Cursor position after writing
    assert ncurses.getYX() == 5, "cursor at col 5"

    // Clear
    ncurses.clear()
    assert ncurses.getRow(0) == "", "cleared"

    // Box drawing
    ncurses.box(0, 0, 4, 10)
    assert ncurses.inCh(0, 0) == 43, "corner +"
    assert ncurses.inCh(0, 5) == 45, "top -"
    assert ncurses.inCh(2, 0) == 124, "side |"

    // Attributes
    ncurses.attrSet(1)
    ncurses.mvAddStr(2, 2, "Hi")
    assert ncurses.attrAt(2, 2) == 1, "bold attr"
    ncurses.attrSet(0)

    // Fill
    ncurses.fill(6, 0, 6, 4, 46)
    assert ncurses.getRow(6) == ".....", "filled dots"

    // Hline
    ncurses.hline(8, 0, 61, 5)
    assert ncurses.getRow(8) == "=====", "hline"

    return 0
end
