func mustCatchConversion() as string
    try
        int value = int("abc")
        return "bad"
    catch e
        print(e)
        return e.message
    end
    return "unreachable"
end

class FieldBox
    array<int> values = [1, 2]

    func add(int value)
        values.append(value)
    end

    func first() as int
        return values[0]
    end

    func copyValues() as array<int>
        return values
    end
end

string message = mustCatchConversion()
assert message == "invalid integer string", "invalid int conversion should throw ValueError"

try
    float f = float("1.2x")
    assert false, "invalid float conversion should throw ValueError"
catch e
    assert e.message == "invalid float string", "invalid float conversion message mismatch"
end

FieldBox box = FieldBox()
box.add(3)
array<int> copied = box.copyValues()
assert box.first() == 1 and copied[2] == 3, "class naked field access or typed array return failed"

Template tpl = template.compile("hello {$name}")
var data = {"name": "xlang"}
string rendered = "say " + tpl.render(data)
assert rendered == "say hello xlang", "Template.render should be typed as string"

channel<int> ch = channel::<int>(1)
assert ch.trySend(10), "channel.trySend should send when space exists"
assert ch.trySend(20), "channel.trySend should fill normalized second slot"
assert !ch.trySend(30), "channel.trySend should fail when channel is full"
int got = 0
assert ch.recvInto(got) and got == 10, "channel.recvInto should receive first value"
assert ch.send(30), "channel.send should send after space is available"
assert ch.recvInto(got) and got == 20, "channel.recvInto should receive second value"
assert ch.recvInto(got) and got == 30, "channel.recvInto should receive third value"
