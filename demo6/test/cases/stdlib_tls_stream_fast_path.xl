// Declaration/ABI fixture; no connection is opened.
export func sendBinary(TlsStream stream,bytes input) as future<int>
    return stream.sendAsync(input)
end
export func receiveBinary(TlsStream stream) as future<NetBytes>
    return stream.recvOwnedAsync(4096)
end
export func keyUpdate(TlsStream stream) as future<TlsResult>
    return stream.keyUpdateAsync()
end
println("tls-stream-fast-path-ok")
