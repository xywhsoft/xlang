export "pending_loop_finally" func probe_loop_finally() as int
    PendingGuard outer = PendingGuard(1)
    try
        PendingGuard middle = PendingGuard(2)
        for item in PendingSequence()
            assert item.id == 4
            try
                PendingGuard inner = PendingGuard(5)
                primary()
            finally
                PendingGuard last = PendingGuard(6)
                finalCheck(1)
            end
            break
        end
    catch error
        assert outer.id == 1
        checked(error.code)
    end
    return outer.id
end

export "pending_loop_typed" func probe_loop_typed() as int
    PendingGuard outer = PendingGuard(1)
    try
        PendingGuard middle = PendingGuard(2)
        for item in PendingSequence()
            assert item.id == 4
            try
                PendingGuard inner = PendingGuard(5)
                primary()
            catch TypeError ignored
                assert false
            end
            break
        end
    catch error
        assert outer.id == 1
        checked(error.code)
    end
    return outer.id
end

export "pending_nested_finally" func probe_nested_finally() as int
    PendingGuard outer = PendingGuard(1)
    try
        PendingGuard middle = PendingGuard(2)
        try
            PendingGuard inner = PendingGuard(3)
            try
                PendingGuard deepest = PendingGuard(4)
                primary()
            finally
                PendingGuard innerFinal = PendingGuard(5)
                finalCheck(1)
            end
        finally
            PendingGuard outerFinal = PendingGuard(6)
            finalCheck(2)
        end
    catch error
        assert outer.id == 1
        checked(error.code)
    end
    return outer.id
end

export "pending_override" func probe_override() as int
    PendingGuard outer = PendingGuard(1)
    try
        PendingGuard middle = PendingGuard(2)
        try
            PendingGuard inner = PendingGuard(3)
            primary()
        finally
            PendingGuard last = PendingGuard(4)
            finalCheck(1)
            overrideError()
        end
    catch error
        assert outer.id == 1
        checked(error.code)
    end
    return outer.id
end

func main(...) as int
    return 0
end
