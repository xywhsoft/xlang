// All raises are confined to this process while INT is watched.
class SignalCallbacks
    int noArgument = 0
    int withEvent = 0
end
auto state = SignalCallbacks()
auto regular = signal.on(signal.INT, func()
    state.noArgument += 1
end)
auto once = signal.once(signal.INT, func(SignalEvent event)
    assert event.code == signal.INT and event.name == "INT"
    state.withEvent += 1
end)
try
    assert signal.raise(signal.INT)
    assert regular.dispatchFor(1000) == 1
    assert once.dispatchFor(1000) == 1
    assert state.noArgument == 1 and state.withEvent == 1
    assert once.closed and once.dispatch() == 0
    assert signal.count(signal.INT) > 0
finally
    regular.close()
    once.close()
    signal.reset()
end
