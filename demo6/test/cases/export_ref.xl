class ExportRefBase
    int value

    create(int value)
        self.value = value
    end

    virtual func read() as int
        return self.value
    end
end

class ExportRefDerived extends ExportRefBase
    create(int value)
        base(value)
    end

    override func read() as int
        return self.value + 1
    end
end

export "xl6_ref_make" func makeRef(int value) as ref<ExportRefBase>
    return ref(ExportRefDerived(value))
end

export "xl6_ref_read" func readRef(ref<ExportRefBase> value) as int
    return value.read()
end
