extern "graph_probe_begin" func beginGraphProbe() as bool
extern "stack_graph_dropped" func dropped(int id, int count)
assert(beginGraphProbe())
string entryText = "entry" + " alive"
class EntryErrorMarker
    Stack<EntryErrorMarker> links
    destroy()
        assert(entryText == "entry alive")
        dropped(7, self.links.count())
    end
end
EntryErrorMarker entryMarker = EntryErrorMarker()
assert(entryMarker.links.push(entryMarker))
func main(...) as int
    try
        throw "aot-entry-error-sentinel"
    finally
        assert(entryMarker.links.count() == 1)
    end
    return 0
end
