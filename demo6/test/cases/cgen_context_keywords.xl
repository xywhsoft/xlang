extern "expect_i64" func expect(int actual, int expected)

int self = 1
int base = 2
int create = 3
int destroy = 4

func sumContextNames(int self, int base, int create, int destroy) -> int
    return self + base + create + destroy
end

expect(self + base + create + destroy, 10)
expect(sumContextNames(5, 6, 7, 8), 26)
