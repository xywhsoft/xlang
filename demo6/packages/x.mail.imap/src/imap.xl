func __xl6_import_x_mail_imap_result(bool ok, string error, string stage, var data) as var
    return x.mail.mime.result(ok, error, stage, data)
end

func __xl6_import_x_mail_imap_unsupported(string operation) as var
    return x.mail.mime.result(false, "x.mail.imap." + operation + " native binding is not connected", "binding", {})
end

