// Numeric resolution only; no name service or implicit engine singleton.
async func run() as int
    auto engine = net.engine(1)
    engine.start()
    auto addresses = net.resolveAll("127.0.0.1", 8080, 4)
    assert addresses.count() == 1 and addresses.port(0) == 8080
    auto asyncAddresses = await net.resolveAsync("127.0.0.1", 8081, 4)
    assert asyncAddresses.count() == 1 and asyncAddresses.port(0) == 8081
    auto resolverStats = net.resolverStats()
    auto engineStats = net.stats(engine)
    assert resolverStats.submitted >= 1 and resolverStats.resolved >= 1
    assert engineStats.workers == 1
    engine.close()
    assert engine.wait(5000)
    println("net-fast-path=ok")
    return 0
end
assert await run() == 0
