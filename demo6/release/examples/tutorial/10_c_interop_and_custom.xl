func main(...) as int
    Buffer buffer = Buffer()
    if not buffer.append("abc") then
        return 1
    end
    if buffer.len() != 3 then
        return 2
    end
    if buffer[0] != 97 then
        return 3
    end

    Random rngA = Random(uint64(123), uint64(1))
    Random rngB = Random(uint64(123), uint64(1))
    if rngA.u32() != rngB.u32() then
        return 4
    end
    return 0
end
