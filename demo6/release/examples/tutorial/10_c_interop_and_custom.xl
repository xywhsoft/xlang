// 教学目标：
// 1. extern 可以把 C 函数/变量声明到 xlang。
// 2. custom 可以把 C 句柄 + 一组 C 函数抽象成轻量类。

extern "host_add" func hostAdd(int left, int right) as int
extern "host_flip" func hostFlip(bool value) as bool
extern "host_counter" var int hostCounter
extern "counter_closed" func counterClosed() as int
extern "counter_reset" func counterReset()

custom Counter
    extern "counter_open" create(int seed)
    extern "counter_close" destroy()
    extern "counter_add" func add(int value) as int
    extern "counter_value" func value() as int
end

func main(...) as int
    counterReset()

    if hostAdd(20, 22) != 42 then
        return 1
    end
    if hostFlip(false) != true then
        return 2
    end

    int before = hostCounter
    hostCounter = 41
    hostCounter += 1
    if hostCounter != 42 then
        hostCounter = before
        return 3
    end
    hostCounter = before

    do
        Counter counter = Counter(40)
        if counter.add(2) != 42 then
            return 4
        end
        if counter.value() != 42 then
            return 5
        end
    while false

    if counterClosed() != 1 then
        return 6
    end
    return 0
end
