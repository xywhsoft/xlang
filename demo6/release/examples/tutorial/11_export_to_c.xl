export "tutorial_add" func add(int left, int right) as int
    return left + right
end

export "tutorial_pair" func pair(int seed) as (int, int)
    return seed, seed + 1
end

export "tutorial_counter" int counter = 40

export "tutorial_answer" const int answer = 42

export "tutorial_self_check" func selfCheck() as int
    if add(20, 22) != 42 then
        return 1
    end
    if counter + 2 != answer then
        return 2
    end
    return 0
end
