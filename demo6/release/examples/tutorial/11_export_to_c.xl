// 教学目标：
// 1. export 可以把 xlang 函数/变量导出成 C 符号。
// 2. cgen 可以生成配套头文件给 C 宿主调用。

export "tutorial_add" func add(int left, int right) as int
    return left + right
end

export "tutorial_pair" func pair(int seed) as (int, int)
    return seed, seed + 1
end

export "tutorial_counter" var int counter = 40

export "tutorial_answer" const int answer = 42

assert add(20, 22) == 42, "tutorial export add failed"
assert counter + 2 == answer, "tutorial export const failed"
println("tutorial_export_to_c ok")
