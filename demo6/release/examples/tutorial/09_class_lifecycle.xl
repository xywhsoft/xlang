// 教学目标：
// 1. class 是结构化数据 + 方法。
// 2. create/destroy 分别用于构造和析构。
// 3. extends 和 base(...) 形成继承构造链。

class DestroyLog
    int unused = 0
    static int count = 0
    static int value = 0

    static func reset()
        DestroyLog.count = 0
        DestroyLog.value = 0
    end

    static func record(int value)
        DestroyLog.count += 1
        DestroyLog.value = value
    end
end

func resetDestroyLog()
    DestroyLog.reset()
end

func recordDestroy(int value)
    DestroyLog.record(value)
end

func destroyCount() as int
    return DestroyLog.count
end

func destroyValue() as int
    return DestroyLog.value
end

class Point
    int x = 0
    int y = 0

    create(int x, int y)
        self.x = x
        self.y = y
    end

    func sum() as int
        return self.x + self.y
    end

    destroy()
        recordDestroy(self.sum())
    end
end

class Point3 extends Point
    int z = 0

    create(int x, int y, int z)
        base(x, y)
        self.z = z
    end

    func sum3() as int
        return self.sum() + self.z
    end
end

func main(...) as int
    resetDestroyLog()

    int value = 0
    do
        Point3 point = Point3(10, 20, 12)
        value = point.sum3()
    while false end

    if value != 42 then
        return 1
    end
    if destroyCount() != 1 then
        return 2
    end
    if destroyValue() != 30 then
        return 3
    end
    return 0
end
