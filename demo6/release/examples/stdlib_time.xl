time releaseDay = time.fromDate(2026, 6, 18)
time releaseClock = time.fromTime(9, 30, 0)
time releaseMoment = time.fromDateTime(2026, 6, 18, 9, 30, 0)
time defaultMoment = time.fromDateTime(2026, 6, 18)

assert(releaseDay == #2026-06-18#)
assert(releaseClock == #09:30:00#)
assert(releaseMoment == #2026-06-18 09:30:00#)
assert(defaultMoment == releaseDay)
println("construct=ok")

time parsedMoment = time.parse("2026-06-18 09:30:00")
time parsedPattern = time.parsePattern("2026/06/18 09:30:00", "%Y/%m/%d %T")
auto tryOk, tryMoment = time.tryParse("2026-06-18 09:30:00")
auto tryZeroOk, tryZero = time.tryParse("00:00:00")
auto tryBadOk, _ = time.tryParse("bad")
auto tryPatternOk, tryPattern = time.tryParsePattern("2026/06/18 09:30:00", "%Y/%m/%d %T")
auto tryPatternBadOk, _ = time.tryParsePattern("bad", "%Y/%m/%d")

assert(parsedMoment == releaseMoment)
assert(parsedPattern == releaseMoment)
assert(tryOk and tryMoment == releaseMoment)
assert(tryZeroOk and tryZero == #00:00:00#)
assert(not tryBadOk)
assert(tryPatternOk and tryPattern == releaseMoment)
assert(not tryPatternBadOk)
println("parse=ok")

assert(time.year(releaseMoment) == 2026)
assert(time.month(releaseMoment) == 6)
assert(time.day(releaseMoment) == 18)
assert(time.hour(releaseMoment) == 9)
assert(time.minute(releaseMoment) == 30)
assert(time.second(releaseMoment) == 0)
assert(time.weekday(releaseMoment) >= 0)
assert(time.dayOfYear(releaseMoment) == 169)
assert(time.quarter(releaseMoment) == 2)
println("parts=ok")

time nextYear = time.addYears(releaseMoment, 1)
time nextMonth = time.addMonths(releaseMoment, 1)
time nextDay = time.addDays(releaseMoment, 1)
time nextHour = time.addHours(releaseMoment, 1)
time nextMinute = time.addMinutes(releaseMoment, 1)
time nextSecond = time.addSeconds(releaseMoment, 1)
time nextWeek = time.addWeeks(releaseMoment, 1)
time nextQuarter = time.addQuarters(releaseMoment, 1)

assert(time.year(nextYear) == 2027)
assert(time.month(nextMonth) == 7)
assert(time.day(nextDay) == 19)
assert(time.hour(nextHour) == 10)
assert(time.minute(nextMinute) == 31)
assert(time.second(nextSecond) == 1)
assert(time.day(nextWeek) == 25)
assert(time.month(nextQuarter) == 9)
println("add=ok")

assert(time.diffYears(releaseMoment, nextYear) == 1)
assert(time.diffMonths(releaseMoment, nextYear) == 12)
assert(time.diffDays(releaseMoment, nextDay) == 1)
assert(time.diffHours(releaseMoment, nextHour) == 1)
assert(time.diffMinutes(releaseMoment, nextMinute) == 1)
assert(time.diffSeconds(releaseMoment, nextSecond) == 1)
assert(time.diffWeeks(releaseMoment, nextWeek) == 1)
assert(time.diffQuarters(releaseMoment, nextYear) == 4)
println("diff=ok")

assert(time.datePart(releaseMoment) == releaseDay)
assert(time.timePart(releaseMoment) == int(releaseClock))
assert(time.isSameDay(releaseMoment, nextHour))
assert(time.isSameMonth(releaseMoment, nextDay))
assert(time.isSameYear(releaseMoment, nextMonth))
assert(time.inRange(releaseMoment, releaseDay, nextWeek))
assert(time.rangeOverlap(releaseDay, nextWeek, releaseMoment, nextWeek))
assert(time.approx(releaseMoment, releaseMoment))
println("compare=ok")

assert(time.isLeapYear(2024))
assert(not time.isLeapYear(2023))
assert(time.daysInMonth(2024, 2) == 29)
assert(time.daysInYear(2024) == 366)
assert(time.month(time.firstDayOfMonth(releaseMoment)) == 6)
assert(time.day(time.firstDayOfMonth(releaseMoment)) == 1)
assert(time.day(time.lastDayOfMonth(releaseMoment)) == 30)
assert(time.month(time.firstDayOfYear(releaseMoment)) == 1)
assert(time.month(time.lastDayOfYear(releaseMoment)) == 12)
assert(time.firstDayOfWeek(releaseMoment) <= releaseMoment)
assert(time.lastDayOfWeek(releaseMoment) >= releaseMoment)
assert(time.weekOfYear(releaseMoment) > 0)
assert(time.weekOfMonth(releaseMoment) > 0)
println("calendar=ok")

int unixSeconds = time.toUnix(releaseMoment)
time unixMoment = time.fromUnix(unixSeconds)
auto localMoment = time.utcToLocal(releaseMoment)
time utcMoment = time.localToUTC(localMoment)

assert(unixMoment == releaseMoment)
assert(utcMoment == releaseMoment)
assert(time.year(time.now()) >= 1970)
assert(time.year(time.today()) >= 1970)
auto clock = time.clock()
assert(time.monotonic() >= clock)
assert(time.year(time.nowUTC()) >= 1970)
assert(time.timezoneOffset() == time.timezoneOffset())
println("system=ok")

assert(time.format(releaseMoment) == "2026-06-18 09:30:00")
assert(time.formatPattern(releaseMoment, "%Y/%m/%d %T") == "2026/06/18 09:30:00")
assert(time.dateString(releaseMoment) == "2026-06-18")
assert(time.timeString(releaseMoment) == "09:30:00")
println("format=ok")

time precise = time.fromDateTime(2024, 2, 29, 23, 58, 57, 123456)
string protocol = time.rfc3339(precise, 28800)
assert(protocol == "2024-03-01T07:58:57.123456+08:00")
assert(time.parseRFC3339(protocol) == precise)
auto rfcOK, rfcValue = time.tryParseRFC3339(protocol)
assert(rfcOK and rfcValue == precise)
string httpDate = time.httpDate(releaseMoment)
assert(time.parseHTTPDate(httpDate) == releaseMoment)
auto httpOK, httpValue = time.tryParseHTTPDate(httpDate)
assert(httpOK and httpValue == releaseMoment)
auto fields = time.parseFields("2024-03-01 07:58:57.123456 +08:00", "%F %T.%f %:z")
assert(fields.offset == 28800 and fields.toTime() == precise)
assert(fields.format("%F %T.%f %:z") == "2024-03-01 07:58:57.123456 +08:00")
assert(time.parse("2024-02-29\0ignored", 10) == #2024-02-29#)
println("protocol=ok")

float timerSeconds = time.timer()
assert(timerSeconds >= 0.0)
time.sleep(0)
println("timer=ok")
