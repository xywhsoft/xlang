// on/once record native events; only this thread's explicit pump runs script.
println(signal.name(signal.HUP), signal.name(signal.INT), signal.name(signal.TERM))
println(signal.name(signal.BREAK), signal.name(signal.CLOSE), signal.name(signal.LOGOFF), signal.name(signal.SHUTDOWN))
signal.clear()
auto listener = signal.on(signal.INT, func(SignalEvent event)
    println("received " + event.name + " count=" + string(event.count))
end)
auto once = signal.once(signal.INT, func()
    println("one-shot callback")
end)
channel<SignalEvent> inbox = channel::<SignalEvent>(2)
auto route = signal.sendTo(inbox, signal.INT)
auto group = task.group()
auto cancel = signal.cancelOn(group, signal.INT)
auto source = SignalSubscription(signal.INT)
try
    assert signal.raise(signal.INT)
    assert listener.dispatchFor(1000) == 1
    assert once.dispatchFor(1000) == 1
    assert once.closed
    assert route.dispatchFor(1000) == 1
    assert cancel.dispatchFor(1000) == 1
    assert source.prepare(1000)
    auto event = SignalEvent(source)
    source.consume()
    assert inbox.recvInto(event)
    println("routed " + event.name)
finally
    listener.close()
    once.close()
    route.close()
    cancel.close()
    source.close()
    inbox.close()
    group.close()
    signal.restore(signal.INT)
    signal.reset()
end
