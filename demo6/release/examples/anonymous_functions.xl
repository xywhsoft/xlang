func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

auto add10 = makeAdder(10)
auto value = add10(5)

func namedAdd(int left, int right) as int
    return left + right
end

func(int, int) as int named = namedAdd
auto namedValue = named(1, 2)

func erased = func(int left, int right) as int => left + right
var dynamicValue = erased(20, 22)
int dynamicInt = int(dynamicValue)
