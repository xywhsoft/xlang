bool releaseExists = path.exists("release")
bool relativePath = not path.isAbs("release/tmp")
string separator = path.sep()
string cwd = path.cwd()
bool cwdSaved = path.setCwd(cwd)
bool cwdIsAbs = path.isAbs(cwd)
string absRelease = path.abs("release")
string relChild = path.rel(cwd, path.join(cwd, "example_child.txt"))
string homeDir = path.home()
string tempDir = path.temp()
string appDir = path.appDir()
