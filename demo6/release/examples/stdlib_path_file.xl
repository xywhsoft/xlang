string renamePath = "release/tmp/example_stdlib_file.renamed.txt"
string replacePath = "release/tmp/example_stdlib_file.replace.txt"

func probeFileStream(string path) as bool
    File stream = file.open(path, false)
    if stream.seek(0, file.seekSet) != 0 then
        return false
    end
    if stream.writeText("stream-start") != 12 then
        return false
    end
    if stream.seek(0, file.seekEnd) != 12 then
        return false
    end
    if stream.seek(-6, file.seekCur) != 6 then
        return false
    end
    if stream.write("IO") != 2 then
        return false
    end
    if stream.seek(0, file.seekSet) != 0 then
        return false
    end
    if stream.readText(6) != "stream" then
        return false
    end
    if stream.pos != 6 then
        return false
    end
    if stream.readText() != "IOtart" then
        return false
    end
    if not stream.eof then
        return false
    end
    if stream.seek(6, file.seekSet) != 6 then
        return false
    end
    if not stream.setEOF() then
        return false
    end
    return true
end

file.delete(filePath)
file.delete(copyPath)
file.delete(movePath)
file.delete(renamePath)
file.delete(replacePath)
dir.delete(copyDir)
dir.delete(movedDir)
