string dirPath = "release/tmp/example_stdlib_dir"
string nestedDir = "release/tmp/example_stdlib_dir/nested"
string copyDir = "release/tmp/example_stdlib_dir_copy"
string movedDir = "release/tmp/example_stdlib_dir_moved"
string nestedFile = "release/tmp/example_stdlib_dir/nested/value.txt"
string filePath = "release/tmp/example_stdlib_file.txt"
string copyPath = "release/tmp/example_stdlib_file.copy.txt"
string movePath = "release/tmp/example_stdlib_file.move.txt"

file.delete(filePath)
file.delete(copyPath)
file.delete(movePath)
dir.delete(copyDir)
dir.delete(movedDir)
dir.delete(nestedDir)
dir.delete(dirPath)

bool releaseExists = path.exists("release")
bool relativePath = not path.isAbs("release/tmp")
string fileNameExt = path.nameExt(filePath)
string fileName = path.name(filePath)
string fileExt = path.ext(filePath)
string fileDir = path.dir(filePath)
string joinedFile = path.join("release", "tmp", "example_stdlib_file.txt")
string joinedNestedDir = path.join("release", "tmp", "example_stdlib_dir", "nested")
string randomName = path.random("tmp_", ".txt", 8)
int randomNameLen = string.len(randomName)

bool dirCreated = dir.create(dirPath)
bool nestedCreated = dir.createAll(nestedDir)

bool written = file.writeText(filePath, "hello")
string firstText = file.readText(filePath)
bool appended = file.appendText(filePath, " xlang")
string fullText = file.readText(filePath)
int size = file.size(filePath)
bool resized = file.setSize(filePath, 5)
int resizedSize = file.size(filePath)
int attr = file.attr(filePath)
bool attrSaved = file.setAttr(filePath, attr)
time accessTime = file.accessTime(filePath)
time changeTime = file.changeTime(filePath)

bool nestedWritten = file.writeText(nestedFile, "nested")
array listed = dir.list(dirPath, true)
string listedJson = json.stringify(listed)
bool listedNestedFile = string.contains(listedJson, "value.txt")
array filesOnly = dir.files(dirPath, true)
array dirsOnly = dir.dirs(dirPath)
bool filesOnlyHasValue = string.contains(json.stringify(filesOnly), "value.txt")
bool dirsOnlyHasNested = string.contains(json.stringify(dirsOnly), "nested")
bool dirCopied = dir.copy(dirPath, copyDir)
bool dirMoved = dir.move(copyDir, movedDir)

bool copied = file.copy(filePath, copyPath)
bool moved = file.move(copyPath, movePath)

bool fileExists = file.exists(filePath)
bool movedExists = file.exists(movePath)
bool sourceCopyGone = not dir.exists(copyDir)
bool movedDirExists = dir.exists(movedDir)

file.delete(filePath)
file.delete(movePath)
dir.delete(movedDir)
dir.delete(nestedDir)
dir.delete(dirPath)

auto releaseExistsText = releaseExists.toString()
auto relativePathText = relativePath.toString()
auto fileNameExtText = fileNameExt.toString()
auto fileNameText = fileName.toString()
auto fileExtText = fileExt.toString()
auto fileDirText = fileDir.toString()
auto joinedFileText = joinedFile.toString()
auto joinedNestedDirText = joinedNestedDir.toString()
auto randomNameText = randomName.toString()
auto randomNameLenText = randomNameLen.toString()
auto dirCreatedText = dirCreated.toString()
auto nestedCreatedText = nestedCreated.toString()
auto writtenText = written.toString()
auto firstFileText = firstText.toString()
auto appendedText = appended.toString()
auto fullFileText = fullText.toString()
auto sizeText = size.toString()
auto resizedText = resized.toString()
auto resizedSizeText = resizedSize.toString()
auto attrText = attr.toString()
auto attrSavedText = attrSaved.toString()
auto accessYearText = time.year(accessTime).toString()
auto changeYearText = time.year(changeTime).toString()
auto nestedWrittenText = nestedWritten.toString()
auto listedCountText = listed.length.toString()
auto listedNestedFileText = listedNestedFile.toString()
auto filesOnlyCountText = filesOnly.length.toString()
auto dirsOnlyCountText = dirsOnly.length.toString()
auto filesOnlyHasValueText = filesOnlyHasValue.toString()
auto dirsOnlyHasNestedText = dirsOnlyHasNested.toString()
auto dirCopiedText = dirCopied.toString()
auto dirMovedText = dirMoved.toString()
auto copiedText = copied.toString()
auto movedText = moved.toString()
auto fileExistsText = fileExists.toString()
auto movedExistsText = movedExists.toString()
auto sourceCopyGoneText = sourceCopyGone.toString()
auto movedDirExistsText = movedDirExists.toString()
