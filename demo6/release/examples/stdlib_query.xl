string q = query.pair("keyword", "xlang demo6")
q = query.append(q, "page", "1")
q = query.append(q, "lang", "zh-cn")

assert q == "keyword=xlang+demo6&page=1&lang=zh-cn", "query append mismatch"

string encoded = query.encode("hello world/中文")
assert encoded == "hello+world%2F%E4%B8%AD%E6%96%87", "query encode mismatch"

string decoded = query.decode(encoded)
assert decoded == "hello world/中文", "query decode mismatch"

assert query.valid(q), "query should be valid"
