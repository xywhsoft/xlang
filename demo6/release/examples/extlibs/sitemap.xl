import sitemap




func main(...) as int
    // 为一个博客站点生成 sitemap
    var urls = [
        {"loc": "https://blog.xlang.dev/", "priority": "1.0", "changefreq": "daily"},
        {"loc": "https://blog.xlang.dev/post/semver", "lastmod": "2026-08-10"},
        {"loc": "https://blog.xlang.dev/post/statistics", "lastmod": "2026-08-11"},
        {"loc": "https://blog.xlang.dev/about", "priority": "0.5"}
    ]
    string xml = sitemap.build(urls)
    println(xml)

    // 直接解析生成的 XML，范例运行不写文件
    var parsed = sitemap.parse(xml)
    println("---")
    println("parsed entries:", parsed.length)

    // 生成 sitemap 索引
    println(sitemap.buildIndex([
        {"loc": "https://blog.xlang.dev/sitemap-posts.xml", "lastmod": "2026-08-14"},
        {"loc": "https://blog.xlang.dev/sitemap-pages.xml"}
    ]))

    // robots.txt 决策
    string robotsText = "User-agent: *\nDisallow: /admin\nDisallow: /draft\nAllow: /draft/public\nSitemap: https://blog.xlang.dev/sitemap.xml\n"
    var robots = sitemap.robotsParse(robotsText)
    println("---")
    array<string> paths = ["/", "/admin/settings", "/draft/123", "/draft/public/x", "/posts/1"]
    for p in paths
        string verdict = "allow"
        if not sitemap.robotsAllows(robots, "my-crawler", p) then
            verdict = "block "
        end
        println("[", verdict, "]", p)
    end

    println("sitemap example: PASS")
    return 0
end
