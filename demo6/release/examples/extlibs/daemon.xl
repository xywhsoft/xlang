import daemon

func main(...) as int
    auto service = daemon.create("sample-service")
    string pidPath = path.join(path.temp(), "sample-service-" + string(service.pid) + ".pid")

    assert service.writePidFile(pidPath)
    println(service.name + " pid=" + string(daemon.readPidFile(pidPath)))
    println("active=" + string(daemon.isAlive(service.pid)))

    service.requestStop()
    assert service.stopRequested
    assert service.releasePidFile()
    println("daemon example: PASS")
    return 0
end
