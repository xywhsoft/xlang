import murmur3

// MurmurHash3 高性能非加密哈希（32/128 位），适合哈希表、布隆过滤器。

string sample = "hello xlang"

// 32 位哈希（整数 + hex）
int h32 = murmur3.hash32(sample)
println("MurmurHash3-32: " + string(h32))
println("MurmurHash3-32 hex: " + murmur3.hash32Hex(sample))

// 带 seed
println("MurmurHash3-32 (seed=42): " + murmur3.hash32Hex(sample, 42))

// 128 位哈希
println("MurmurHash3-128: " + murmur3.hash128Hex(sample))
println("MurmurHash3-128 (seed=42): " + murmur3.hash128Hex(sample, 42))

// 流式哈希器（128 位变体）
auto hasher = murmur3.hasher()
hasher.update("hello ")
hasher.update("xlang")
assert hasher.digestHex() == murmur3.hash128Hex(sample), "murmur3 streaming mismatch"
println("streaming inputBytes: " + string(hasher.inputBytes))

// reset 复位
hasher.reset()
hasher.update(sample)
assert hasher.digestHex() == murmur3.hash128Hex(sample), "murmur3 reset mismatch"

// clone 独立副本
auto h1 = murmur3.hasher()
h1.update("hello")
auto h2 = h1.clone()
h1.update(" xlang")
h2.update(" world")
println("clone h1: " + h1.digestHex())
println("clone h2: " + h2.digestHex())

// 文件哈希
dir.createAll("examples_out/extlibs")
file.writeText("examples_out/extlibs/murmur3_sample.txt", sample)
assert murmur3.hashFile128Hex("examples_out/extlibs/murmur3_sample.txt") == murmur3.hash128Hex(sample), "murmur3 file mismatch"

println("murmur3 extlib ok")
