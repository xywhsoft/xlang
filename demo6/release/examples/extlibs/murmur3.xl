import murmur3

class Progress
    int calls = 0
end

// 文件示例会创建自己的测试目录，结束时清理文件；与 examples/files.c 输出一致。
func main(...) as int
    string root = "build/test/murmur3-example"
    dir.createAll(root)
    string source = root + "/中文.txt"
    file.writeText(source, "abc")
    try
        Progress state = Progress()
        string digest = murmur3.hashFile128Hex(source, seed = 42,
            onProgress = func(int current, int total, int output) as bool
                assert current == 3 and total == 3 and output == 0
                state.calls += 1
                return true
            end)
        println("file128=" + digest)
        println("callbacks=" + string(state.calls))
        println("file32=" + string(murmur3.hashFile32(source, seed = 42)))

        // 返回 false 取消，抛出异常保留类别与说明，不交付部分摘要。
        bool cancelled = false
        try
            murmur3.hashFile128Hex(source,
                onProgress = func(int current, int total, int output) as bool
                    return false
                end)
        catch CancelledError e
            cancelled = true
        end
        println("cancelled=" + string(cancelled))
        bool callbackError = false
        try
            murmur3.hashFile128Hex(source,
                onProgress = func(int current, int total, int output) as bool
                    throw ValueError "callback marker"
                end)
        catch ValueError e
            callbackError = e.message == "callback marker"
        end
        println("callback-error=" + string(callbackError))
        bool exceeded = false
        try
            murmur3.hashFile128Hex(source, maxInput = 2)
        catch RangeError e
            exceeded = true
        end
        println("budget=" + string(exceeded))
    finally
        file.delete(source)
    end
    return 0
end
