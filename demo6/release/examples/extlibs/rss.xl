import rss




func main(...) as int
    // 组装一份 RSS 2.0
    var channel = {
        "title": "xlang release notes",
        "link": "https://xlang.dev",
        "description": "compiler, stdlib and ecosystem updates",
        "updated": "Wed, 12 Aug 2026 08:00:00 GMT"
    }
    var items = [
        {"title": "semver extension library", "link": "https://xlang.dev/blog/semver",
         "description": "semantic versioning ranges for the package manager", "guid": "post-12"},
        {"title": "statistics extension library", "link": "https://xlang.dev/blog/statistics",
         "description": "descriptive statistics over numeric arrays", "guid": "post-11"},
        {"title": "json.patch extension library", "link": "https://xlang.dev/blog/jsonpatch",
         "description": "RFC 6902 patching for config hot reload", "guid": "post-10"}
    ]
    string xml = rss.buildRSS(channel, items)
    println(xml)

    // 直接在内存中解析生成结果；不依赖工作目录或临时文件。
    var parsed = rss.parse(xml)
    println("---")
    println("parsed type:", parsed["type"])
    println("channel title:", parsed["title"])
    for item in parsed["items"]
        println("-", item["title"], "->", item["link"])
    end

    // Atom 输出
    var feed = {"title": string(parsed["title"]), "link": string(parsed["link"]),
        "id": "urn:xlang:notes", "updated": "2026-08-12T08:00:00Z", "author": "xlang"}
    var atomEntries = []
    for item in parsed["items"]
        atomEntries.append({"title": item["title"], "link": item["link"],
            "id": item["guid"], "updated": "2026-08-12T08:00:00Z",
            "summary": item["description"]})
    end
    string atom = rss.buildAtom(feed, atomEntries)
    var back = rss.parse(atom)
    println("---")
    println("atom round trip entries:", back["items"].length)

    println("rss example: PASS")
    return 0
end
