// ═══════════════════════════════════════════════════════════
// argon2 扩展库教学范例
//
// Argon2 是 2015 年密码哈希竞赛（PHC）冠军，RFC 9106 标准。
// 本库完整实现 Argon2d / Argon2i / Argon2id 三种变体，
// 对标 Python argon2-cffi 全部功能。
//
// 典型场景：用户密码存储、会话令牌派生、密钥拉伸。
// ═══════════════════════════════════════════════════════════

import argon2

func main(...) as int

    // ─────────────────────────────────────────────────────────────
    // 1. 最简用法：一行哈希，一行验证
    // ─────────────────────────────────────────────────────────────
    println("=== 1. 最简用法 ===")

    // hash() 自动生成 CSPRNG 随机盐，返回 PHC 标准编码字符串
    // 格式: $argon2id$v=19$m=65536,t=3,p=4$<salt_b64>$<hash_b64>
    string encoded = argon2.hash("my_secure_password")
    println("哈希: ", encoded)

    // verify() 自动解析编码中的算法、参数、盐，重新计算并比较
    bool ok = argon2.verify("my_secure_password", encoded)
    println("正确密码: ", ok)   // true

    bool fail = argon2.verify("wrong_password", encoded)
    println("错误密码: ", fail)  // false

    // 要点：每次 hash() 调用产生不同盐 → 不同编码，但都能验证通过
    string encoded2 = argon2.hash("my_secure_password")
    println("两次哈希不同: ", encoded != encoded2)  // true
    println("都能验证: ", argon2.verify("my_secure_password", encoded2))  // true

    // ─────────────────────────────────────────────────────────────
    // 2. 手动指定盐（确定性输出）
    // ─────────────────────────────────────────────────────────────
    println("\n=== 2. 手动盐 ===")

    // 传入固定盐 → 相同输入产生相同输出（用于测试/互操作）
    string salt = "my_fixed_salt_16"  // 至少 8 字节
    string h1 = argon2.hash("password", salt = salt)
    string h2 = argon2.hash("password", salt = salt)
    println("确定性: ", h1 == h2)  // true

    // 也可以用 generateSalt() 生成随机盐的 hex 字符串
    string randomSalt = argon2.generateSalt(16)
    println("随机盐(hex): ", randomSalt)  // 32 个 hex 字符

    // ─────────────────────────────────────────────────────────────
    // 3. 参数调节：时间/内存/并行度
    // ─────────────────────────────────────────────────────────────
    println("\n=== 3. 参数调节 ===")

    // timeCost: 迭代次数（越大越慢，抗暴力破解）
    // memoryCost: 内存消耗 KiB（越大越抗 GPU/ASIC）
    // parallelism: 并行线程数（影响哈希值，不只是性能）
    // hashLen: 输出哈希长度（字节）
    // saltLen: 自动盐长度（字节）
    string custom = argon2.hash("pw",
        timeCost = 5,          // 5 次迭代
        memoryCost = 131072,   // 128 MiB
        parallelism = 2,       // 2 路并行
        hashLen = 64,          // 64 字节输出
        saltLen = 32           // 32 字节盐
    )
    println("自定义参数: ", custom)

    // 验证时不需要传参数 —— 全部从 PHC 编码中自动解析
    println("验证: ", argon2.verify("pw", custom))  // true

    // ─────────────────────────────────────────────────────────────
    // 4. 三种变体
    // ─────────────────────────────────────────────────────────────
    println("\n=== 4. 三种变体 ===")

    // Argon2d: 数据依赖寻址，抗 GPU 最强，但有侧信道风险
    // Argon2i: 数据无关寻址，抗侧信道，但抗 GPU 稍弱
    // Argon2id: 混合（前半 Argon2i + 后半 Argon2d），RFC 推荐
    string hd = argon2.hash("test", salt = salt, type = argon2.ARGON2D)
    string hi = argon2.hash("test", salt = salt, type = argon2.ARGON2I)
    string hid = argon2.hash("test", salt = salt, type = argon2.ARGON2ID)

    println("Argon2d:  ", hd)
    println("Argon2i:  ", hi)
    println("Argon2id: ", hid)  // 默认

    // 所有变体都能正确验证（verify 自动识别类型）
    println("验证 d: ", argon2.verify("test", hd))
    println("验证 i: ", argon2.verify("test", hi))
    println("验证 id: ", argon2.verify("test", hid))

    // ─────────────────────────────────────────────────────────────
    // 5. secret 密钥哈希（pepper）
    // ─────────────────────────────────────────────────────────────
    println("\n=== 5. secret 密钥哈希 ===")

    // secret 是一个服务器端密钥，不存入数据库
    // 即使数据库完全泄露（盐+哈希），没有 secret 也无法暴力破解
    string serverKey = "my_server_secret_key_2024"
    string withKey = argon2.hash("user_password", secret = serverKey)
    println("带密钥: ", withKey)

    // 注意：verify() 不含 secret 参数
    // 带 secret 生成的哈希，普通 verify 无法通过（设计意图）
    // 实际部署中，验证时需要重新 hash 后比较

    // ─────────────────────────────────────────────────────────────
    // 6. ad 附加数据（绑定上下文）
    // ─────────────────────────────────────────────────────────────
    println("\n=== 6. ad 附加数据 ===")

    // ad 将哈希绑定到特定上下文（如用户ID、租户ID）
    // 防止攻击者将一个用户的哈希复制到另一个用户
    string withAd = argon2.hash("password", ad = "tenant=acme;user=42")
    println("带AD: ", withAd)

    // ─────────────────────────────────────────────────────────────
    // 7. hashRaw：原始 hex 输出
    // ─────────────────────────────────────────────────────────────
    println("\n=== 7. hashRaw ===")

    // 不生成 PHC 编码，直接返回 hex 字符串
    // 适用于需要自行管理存储格式的场景
    string raw = argon2.hashRaw("password", salt = salt, hashLen = 32)
    println("Raw hex: ", raw)
    println("长度: ", raw.length)  // 64（32字节 × 2）

    // ─────────────────────────────────────────────────────────────
    // 8. checkNeedsRehash：参数升级检测
    // ─────────────────────────────────────────────────────────────
    println("\n=== 8. 参数升级检测 ===")

    // 场景：系统升级后提高了安全参数
    // 用户登录时检查旧哈希是否需要重新计算
    string oldHash = argon2.hash("pw", salt = salt, timeCost = 1, memoryCost = 4096, parallelism = 1)

    // 对比当前推荐参数
    bool needsUpgrade = argon2.checkNeedsRehash(oldHash,
        timeCost = 3, memoryCost = 65536, parallelism = 4)
    println("需要升级: ", needsUpgrade)  // true

    // 用新参数重新哈希后，不再需要升级
    string newHash = argon2.hash("pw", timeCost = 3, memoryCost = 65536, parallelism = 4)
    bool stillNeeds = argon2.checkNeedsRehash(newHash,
        timeCost = 3, memoryCost = 65536, parallelism = 4)
    println("升级后: ", stillNeeds)  // false

    // ─────────────────────────────────────────────────────────────
    // 9. 参数提取（审计/迁移）
    // ─────────────────────────────────────────────────────────────
    println("\n=== 9. 参数提取 ===")

    // 从 PHC 编码中提取参数，无需解码 base64
    string sample = argon2.hash("x", salt = salt, timeCost = 5, memoryCost = 1024, parallelism = 2)
    println("类型: ", argon2.extractType(sample))           // 2 (ARGON2ID)
    println("迭代: ", argon2.extractTimeCost(sample))       // 5
    println("内存: ", argon2.extractMemoryCost(sample))     // 1024
    println("并行: ", argon2.extractParallelism(sample))    // 2

    // ─────────────────────────────────────────────────────────────
    // 10. 推荐参数与 Profiles
    // ─────────────────────────────────────────────────────────────
    println("\n=== 10. 推荐参数 ===")

    println("推荐迭代: ", argon2.recommendedTime())          // 3
    println("推荐内存: ", argon2.recommendedMemory())        // 65536 KiB
    println("推荐并行: ", argon2.recommendedParallelism())   // 4
    println("推荐哈希长: ", argon2.recommendedHashLen())     // 32
    println("推荐盐长: ", argon2.recommendedSaltLen())       // 16

    // RFC 9106 预定义参数集
    println("\n低内存 Profile: t=", argon2.PROFILE_LOW_MEMORY_TIME,
            " m=", argon2.PROFILE_LOW_MEMORY_MEMORY,
            " p=", argon2.PROFILE_LOW_MEMORY_PARALLELISM)
    println("高内存 Profile: t=", argon2.PROFILE_HIGH_MEMORY_TIME,
            " m=", argon2.PROFILE_HIGH_MEMORY_MEMORY,
            " p=", argon2.PROFILE_HIGH_MEMORY_PARALLELISM)

    // 使用 Profile 参数
    string profiled = argon2.hash("pw",
        timeCost = argon2.PROFILE_LOW_MEMORY_TIME,
        memoryCost = argon2.PROFILE_LOW_MEMORY_MEMORY,
        parallelism = argon2.PROFILE_LOW_MEMORY_PARALLELISM)
    println("Profile哈希: ", profiled)

    // ─────────────────────────────────────────────────────────────
    // 11. 综合实战：用户注册/登录流程
    // ─────────────────────────────────────────────────────────────
    println("\n=== 11. 综合实战 ===")

    // ── 注册 ──
    string username = "alice"
    string password = "S3cur3!Pass#2024"

    // 一行完成：自动盐 + 推荐参数 + PHC 编码
    string stored = argon2.hash(password, ad = "user=" + username)
    println("存储到DB: ", stored)

    // ── 登录 ──
    string inputPassword = "S3cur3!Pass#2024"

    if argon2.verify(inputPassword, stored) then
        println("登录成功!")

        // 检查是否需要升级参数（安全策略更新后）
        if argon2.checkNeedsRehash(stored) then
            println("参数已过期，重新哈希...")
            stored = argon2.hash(inputPassword, ad = "user=" + username)
            // UPDATE users SET password_hash = stored WHERE ...
        end
    else
        println("密码错误!")
    end

    // ── 错误密码 ──
    if not argon2.verify("hacker_guess", stored) then
        println("拒绝: 密码不匹配")
    end

    println("\n=== 完成 ===")
    return 0
end
