import nlopt



func main(...) as int
    println("Algo(0):     ", nlopt.algoName(0))
    println("Algo(24):    ", nlopt.algoName(24))
    println("IsGlobal(0): ", nlopt.isGlobal(0))
    println("Result(1):   ", nlopt.resultName(1))
    println("Rosenbrock:  ", nlopt.rosenbrock(1.0, 1.0))
    println("Sphere(3,4): ", nlopt.sphere(3.0, 4.0))
    println("GradStep:    ", nlopt.gradStep(5.0, 2.0, 0.1))
    println("nlopt example: PASS")
    return 0
end
