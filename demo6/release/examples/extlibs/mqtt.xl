import mqtt



func main(...) as int
    // 不需要 broker。与 mqtt_c.c 输出完全相同，展示构帧、解析与拥有权。
    Buffer connect = mqtt.connectFrame("sensor-1", keepalive = 0)
    var options = mqtt.parseFrame(connect)
    println(f"connect: {mqtt.frameToHex(connect)}")
    println(f`keepalive: {options["keepalive"]}`)

    Buffer frame = mqtt.publishFrame(1, "home/temp", "22.5", 42)
    var message = mqtt.parseFrame(frame)
    println(f"publish: {mqtt.frameToHex(frame)}")
    println(f`topic: {message["topic"]}`)
    println(f`payload: {message["payload"]}`)
    println(f`packetId: {message["packetId"]}`)
    println(f`subscribe: {mqtt.subscribe(7, "home/+/temp", 1)}`)
    var suback = mqtt.parse("9003000701")
    println(f`granted: {suback["granted"][0]}`)
    println(f"puback: {mqtt.puback(42)}")
    println(f"ping: {mqtt.pingreq()}")
    println(f"disconnect: {mqtt.disconnect()}")

    // 原始字节使用 Buffer；提取的副本不受原帧清空影响。
    Buffer binary = mqtt.hexToFrame("00ff61")
    Buffer packet = mqtt.publishFrame(0, "raw", binary)
    Buffer saved = mqtt.payloadBytes(packet)
    assert packet.clear()
    println(f"binary: {mqtt.frameToHex(saved)}")
    Buffer prefix = mqtt.hexToFrame("308001")
    println(f"frameSize: {mqtt.frameSize(prefix)}")
    var ack = mqtt.parse("20020000")
    println(f`connack: {ack["returnCode"]}`)

    println("mqtt example: PASS")
    return 0
end
