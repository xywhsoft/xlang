import css



func main(...) as int
    auto sheet = "h1 { color: navy; font-size: 24px; } p { line-height: 1.5; }"
    string clean = css.stripComments("h1/* note */{ color: navy; }")

    assert css.get(sheet, "h1", "color") == "navy"
    assert css.get(sheet, "h1", "font-size") == "24px"
    assert css.countRules(sheet) == 2
    assert css.countProps(sheet, "h1") == 2
    assert css.selectorAt(sheet, 0) == "h1"
    assert css.validate(sheet)
    assert clean == "h1 { color: navy; }"
    assert css.get("a/* selector */ { color/* name */: red; }",
        "a", "color") == "red"

    println("h1 color: ", css.get(sheet, "h1", "color"))
    println("h1 size:  ", css.get(sheet, "h1", "font-size"))
    println("rules:    ", css.countRules(sheet))
    println("props:    ", css.countProps(sheet, "h1"))
    println("sel[0]:   ", css.selectorAt(sheet, 0))
    println("valid:    ", css.validate(sheet))
    println("clean:    ", clean)
    println("comment: ", css.get("a/* selector */ { color/* name */: red; }",
        "a", "color"))

    println("css C/XL example: PASS")
    return 0
end
