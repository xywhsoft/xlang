import xxhash



func main(...) as int
    // ─── 1. 一次性哈希（Buffer 二进制安全）───
    Buffer data = Buffer()
    data.append("xlang xxhash ")
    data.appendByte(0)
    data.appendByte(255)

    int h64 = xxhash.hash64(data)
    string hex64 = xxhash.hash64Hex(data)
    assert xxhash.hash64(data) == h64, "xxhash determinism failed"
    assert string.len(hex64) == 16, "xxhash hex64 length failed"
    println("XXH64: ", hex64, "  (引擎版本 ", xxhash.version(), ")")

    // 字符串重载（内部自动转 Buffer）。
    println("XXH64(\"hello\") = ", xxhash.hash64Hex("hello"))
    println("XXH32(\"hello\") = ", xxhash.hash32Hex("hello"))

    // ─── 2. 种子调优：改变种子得到不同的哈希分布 ───
    assert xxhash.hash64(data, 1) != h64, "xxhash seed should change digest"
    println("换种子(1)后 XXH64 = ", xxhash.hash64Hex(data, 1))

    // ─── 3. 增量流式哈希：update -> digest（可多次读取，不改变状态）───
    auto hasher = xxhash.hasher()
    hasher.update("xlang ")
    hasher.update("xxhash ")
    Buffer tail = Buffer()
    tail.appendByte(0)
    tail.appendByte(255)
    hasher.update(tail)
    println("流式进度: 已喂入 ", hasher.inputBytes, " 字节")
    assert hasher.digest() == h64, "xxhash streaming digest mismatch"
    assert hasher.digestHex() == hex64, "xxhash streaming hex mismatch"

    // ─── 4. reset 复位：清空累计输入，保留原种子重新计算 ───
    hasher.reset()
    hasher.update("abc")
    assert hasher.inputBytes == 3, "xxhash reset inputBytes failed"
    assert hasher.digest() == xxhash.hash64("abc"), "xxhash reset digest failed"
    println("reset 重算 XXH64(\"abc\") = ", hasher.digestHex())

    // ─── 5. 文件哈希（XRT reader 分块读取，受 maxInput 限制）───
    dir.createAll("tmp")
    file.writeBytes("tmp/xxhash_example_source.bin", data)
    assert xxhash.hashFile64("tmp/xxhash_example_source.bin") == h64, "xxhash file digest mismatch"
    println("文件 XXH64 = ", xxhash.hashFile64Hex("tmp/xxhash_example_source.bin"))
    file.delete("tmp/xxhash_example_source.bin")

    // ─── 6. 错误处理：缺失文件抛 FileError，非法限额抛 ValueError ───
    bool missing = false
    try
        xxhash.hashFile64("tmp/xxhash_example_missing.bin")
    catch FileError e
        missing = true
    end
    assert missing, "xxhash missing file must raise FileError"

    bool badLimit = false
    try
        xxhash.hasher(0, 0)
    catch ValueError e
        badLimit = true
    end
    assert badLimit, "xxhash bad limit must raise ValueError"
    println("错误处理: OK")

    println("xxhash example: PASS")
    return 0
end
