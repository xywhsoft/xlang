import pulsar

func main(...) as int
    // Apache Pulsar protocol helpers

    // Commands
    println("Cmd 6 = " + pulsar.cmdName(6))
    println("Cmd 9 = " + pulsar.cmdName(9))

    // Subscription types
    println("SubType 1 = " + pulsar.subType(1))

    // Schema types
    println("Schema 2 = " + pulsar.schemaType(2))

    // Topic parsing
    println("Tenant = " + pulsar.topicTenant("persistent://acme/prod/orders"))

    println("pulsar example: PASS")
    return 0
end
