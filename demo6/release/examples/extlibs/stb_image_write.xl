import stb_image
import stb_image_write

func runExample(string outDir)
    // 解码取得带长度的像素缓冲，再分别编码为各格式。
    string source = path.join(path.appDir(), "examples/extlibs/assets/tiny.png")
    stb_image.StbImage image = stb_image.load(source, 4)
    Buffer pixels = image.pixels()
    int width = image.width()
    int height = image.height()
    int channels = image.channels()

    Buffer png = stb_image_write.encodePng(pixels, width, height, channels)
    Buffer jpeg = stb_image_write.encodeJpeg(pixels, width, height, channels)
    Buffer bmp = stb_image_write.encodeBmp(pixels, width, height, channels)
    Buffer tga = stb_image_write.encodeTga(pixels, width, height, channels)
    stb_image.StbImage roundtrip = stb_image.loadBytes(png, 4)
    assert roundtrip.pixels() == pixels, "PNG roundtrip pixels"
    assert jpeg.len() > 0 and bmp.len() > 0 and tga.len() > 0, "encoded formats"

    stb_image.StbImage floats = stb_image.loadf(source, 4)
    Buffer hdr = stb_image_write.encodeHdr(floats.pixels(), width, height, channels)
    assert hdr.len() > 0, "HDR encoding"

    dir.createAll(outDir)
    assert stb_image_write.writePng(outDir + "/tiny.png", pixels,
        width, height, channels), "PNG file"
    assert stb_image_write.writeJpeg(outDir + "/tiny.jpg", pixels,
        width, height, channels), "JPEG file"
    assert stb_image_write.writeBmp(outDir + "/tiny.bmp", pixels,
        width, height, channels), "BMP file"
    assert stb_image_write.writeTga(outDir + "/tiny.tga", pixels,
        width, height, channels), "TGA file"
    assert stb_image_write.writeHdr(outDir + "/tiny.hdr", floats.pixels(),
        width, height, channels), "HDR file"
    assert Buffer(file.readBytes(outDir + "/tiny.png")) == png, "PNG file bytes"
    println("stb_image_write C/XL example: PASS")
end

func main(...) as int
    if arg.length > 1 then
        runExample(string(arg[1]))
        return 0
    end

    string workDir = path.join(path.temp(), "xlang_stbiw_example_" + crypto.randomString(20))
    dir.createAll(workDir)
    try
        runExample(workDir)
    finally
        assert dir.delete(workDir), "temporary image directory must be removed"
    end
    return 0
end
