import crc32

string sample = "123456789"

assert crc32.version() != "", "crc32 version mismatch"
assert crc32.checksumHex(sample) == "cbf43926", "crc32 checksumHex mismatch"
assert crc32.checksum(sample) != 0, "crc32 checksum mismatch"

crc32.Crc32Hasher streaming = crc32.hasher()
streaming.update("1234")
streaming.update("56789")
assert streaming.digestHex() == "cbf43926", "crc32 streaming mismatch"
assert streaming.inputBytes == 9, "crc32 streaming inputBytes mismatch"

dir.createAll("examples_out/extlibs")
string samplePath = "examples_out/extlibs/crc32_sample.txt"
file.writeText(samplePath, sample)
assert crc32.checksumFileHex(samplePath) == "cbf43926", "crc32 checksumFileHex mismatch"
assert crc32.checksumFile(samplePath) == crc32.checksum(sample), "crc32 checksumFile mismatch"

try
    crc32.checksumFile("")
    assert false, "crc32 empty path should fail"
catch FileError
end

println("crc32 extlib ok")
