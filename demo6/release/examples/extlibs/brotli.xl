import brotli



func main(...) as int
    // ─── 1. 一次性压缩 / 解压（Buffer 二进制安全）───
    Buffer source = Buffer()
    source.append("xlang brotli ")
    source.appendByte(0)
    source.appendByte(255)

    Buffer packed = brotli.compress(source)
    Buffer plain = brotli.decompress(packed)
    assert plain == source, "brotli Buffer round trip failed"
    println("一次性: ", source.len(), " 字节 -> ", packed.len(), " 字节")

    // 直接压缩字符串（内部自动转 Buffer）。
    Buffer textPacked = brotli.compress("hello brotli")
    assert brotli.decompressText(textPacked) == "hello brotli"
    println("引擎版本: ", brotli.version())

    // ─── 2. 增量流式压缩：update -> drain -> finish ───
    // drain() 随时取走已产出的压缩字节，适合边喂数据边落盘/发送。
    auto encoder = brotli.compressor()
    Buffer streamPacked = Buffer()
    encoder.update("hello ")
    streamPacked.append(encoder.drain())
    encoder.update("stream")
    streamPacked.append(encoder.drain())
    encoder.finish()                 // 封存流（写入成员结束标记）
    streamPacked.append(encoder.drain())
    println("流式压缩: 喂入 ", encoder.inputBytes, " 字节, 产出 ",
        encoder.outputBytes, " 字节")

    // ─── 3. 增量流式解压 + 进度回显 + 多成员统计 ───
    auto decoder = brotli.decompressor()
    Buffer restored = Buffer()
    decoder.update(streamPacked)
    restored.append(decoder.drain()) // 取走已解压数据
    println("解压进度: 已喂入 ", decoder.inputBytes, " / 已产出 ",
        decoder.outputBytes, " 字节, 完成=", decoder.finished)
    decoder.finish()                 // 校验流完整性
    restored.append(decoder.drain())
    assert restored.text() == "hello stream", "brotli incremental round trip failed"
    println("成员数: ", decoder.members) // 1；>1 表示串联多成员流

    // ─── 4. 质量 / 窗口 / 模式调优（quality 0..11，window 10..24，mode 通用/文本/字体）───
    auto tuned = brotli.compressor(brotli.BROTLI_MAX_QUALITY)
    tuned.update("tune me")
    tuned.finish()
    assert brotli.decompress(tuned.drain()).text() == "tune me"
    println("最高质量 Q11 流式往返: OK")

    Buffer textMode = brotli.compress("utf8 text tuned by brotli text mode",
        brotli.BROTLI_DEFAULT_QUALITY, brotli.BROTLI_DEFAULT_WINDOW, brotli.BROTLI_MODE_TEXT)
    assert brotli.decompressText(textMode) == "utf8 text tuned by brotli text mode"
    println("文本模式压缩往返: OK")

    // ─── 5. 损坏数据必然抛出 CompressionError（块体安全校验生效）───
    bool rejected = false
    int mid = streamPacked.len() / 2
    streamPacked[mid] = streamPacked[mid] ^ 255
    try
        brotli.decompress(streamPacked)
    catch CompressionError e
        rejected = true
    end
    assert rejected, "corrupt brotli must raise CompressionError"
    println("损坏检出: OK")

    // ─── 6. 文件便捷接口（XRT reader/writer，临时文件+原子重命名）───
    dir.createAll("tmp")
    file.writeBytes("tmp/brotli_example_source.bin", source)
    brotli.compressFile("tmp/brotli_example_source.bin", "tmp/brotli_example.br")
    brotli.decompressFile("tmp/brotli_example.br", "tmp/brotli_example_plain.bin")
    assert file.readBytes("tmp/brotli_example_plain.bin") == source
    file.delete("tmp/brotli_example_source.bin")
    file.delete("tmp/brotli_example.br")
    file.delete("tmp/brotli_example_plain.bin")

    println("brotli example: PASS")
    return 0
end
