import lightgbm

func main(...) as int
    // LightGBM gradient boosting

    println("Objective 0 = " + lightgbm.objective(0))
    println("Boosting 0 = " + lightgbm.boosting(0))
    println("Metric 3 = " + lightgbm.metric(3))
    println("Device 0 = " + lightgbm.device(0))

    println("lightgbm example: PASS")
    return 0
end
