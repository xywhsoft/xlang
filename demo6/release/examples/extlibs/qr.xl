import qr

func main(...) as int
    string text = "HELLO WORLD"
    string image = qr.svg(text)
    println("version:", qr.version(text))
    println("svg bytes:", string.byteLen(image))
    string mixed = "1234567890123456789012345678901234567890a1234567890123456789012345678901234567890"
    println("mixed version:", qr.version(mixed))
    println("qr example: PASS")
    return 0
end
