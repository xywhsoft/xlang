import sharedmem

// 两个句柄访问同一个命名映射；进程间数据协议和同步由应用负责。
auto owner = sharedmem.create("xlang_sharedmem_example_" + crypto.randomString(20), 128)
auto reader = sharedmem.open(owner.name)

owner.writeText(0, "hello")
reader.writeInt(16, 42)
Buffer binary = Buffer()
binary.appendByte(65)
binary.appendByte(0)
binary.appendByte(66)
owner.write(32, binary)

println("text: " + reader.readText(0, 5))
println("integer: " + string(owner.readInt(16)))
println("binary size: " + string(reader.read(32, 3).len()))
