import snappy

class FileProgress
    int calls = 0
    int inputBytes = 0
    int totalBytes = 0
end



func main(...) as int
    // ─── 1. 一次性压缩 / 解压（Buffer 二进制安全）───
    Buffer source = Buffer()
    source.append("xlang snappy ")
    source.appendByte(0)
    source.appendByte(255)

    Buffer packed = snappy.compress(source)
    Buffer plain = snappy.decompress(packed)
    assert plain == source, "snappy Buffer round trip failed"
    assert packed.len() >= 10
    assert packed[0] == 255 and packed[1] == 6, "snappy stream identifier missing"
    println("一次性: ", source.len(), " 字节 -> ", packed.len(), " 字节")

    // 直接压缩字符串（内部自动转 Buffer）。
    Buffer textPacked = snappy.compress("hello snappy")
    assert snappy.decompressText(textPacked) == "hello snappy"
    println("引擎版本: ", snappy.version())

    // ─── 2. 增量流式压缩：update -> drain -> finish ───
    // drain() 随时取走已产出的压缩字节，适合边喂数据边落盘/发送。
    auto encoder = snappy.compressor()
    Buffer streamPacked = Buffer()
    encoder.update("hello ")
    streamPacked.append(encoder.drain())
    encoder.update("stream")
    streamPacked.append(encoder.drain())
    encoder.finish()                 // 刷出最后一个块；标准 framing 没有结束标记
    streamPacked.append(encoder.drain())
    println("流式压缩: 喂入 ", encoder.inputBytes, " 字节, 产出 ",
        encoder.outputBytes, " 字节")

    // ─── 3. 增量流式解压 + 进度回显 + 多成员统计 ───
    auto decoder = snappy.decompressor()
    Buffer restored = Buffer()
    decoder.update(streamPacked)
    restored.append(decoder.drain()) // 取走已解压数据
    println("解压进度: 已喂入 ", decoder.inputBytes, " / 已产出 ",
        decoder.outputBytes, " 字节, 完成=", decoder.finished)
    decoder.finish()                 // 校验流完整性
    restored.append(decoder.drain())
    assert restored.text() == "hello stream", "snappy incremental round trip failed"

    // 末尾 chunk 截断必须拒绝；标准 framing 在完整 chunk 边界没有结束标记。
    Buffer chainedTruncated = Buffer()
    chainedTruncated.append(packed)
    for i in range(0, streamPacked.len() - 1)
        chainedTruncated.appendByte(streamPacked[i])
    end
    bool truncatedRejected = false
    try
        snappy.decompress(chainedTruncated)
    catch IOError e
        truncatedRejected = true
    end
    assert truncatedRejected, "truncated final snappy member must be rejected"
    println("成员数: ", decoder.members) // 1；>1 表示串联多成员流

    // ─── 4. 高冗余数据压缩率展示（snappy 擅长重复模式）───
    Buffer redundant = Buffer()
    int i = 0
    while i < 256
        redundant.append("snappy-snappy-")
        i = i + 1
    end
    Buffer redPacked = snappy.compress(redundant)
    assert snappy.decompress(redPacked) == redundant
    println("高冗余: ", redundant.len(), " 字节 -> ", redPacked.len(), " 字节")

    // ─── 5. 损坏数据必然抛出 CompressionError（块体安全校验生效）───
    bool rejected = false
    int mid = streamPacked.len() / 2
    streamPacked[mid] = 0
    try
        snappy.decompress(streamPacked)
    catch IOError e
        rejected = true
    end
    assert rejected, "corrupt snappy must raise CompressionError"
    println("损坏检出: OK")

    // ─── 6. 文件便捷接口（XRT reader/writer，临时文件+原子重命名）───
    string directory = dir.temp("", "xlang-snappy-example-", "")
    string sourcePath = path.join(directory, "source.bin")
    string packedPath = path.join(directory, "packed.sz")
    string restoredPath = path.join(directory, "restored.bin")
    try
        assert file.writeBytes(sourcePath, source.toBytes())
        FileProgress progress = FileProgress()
        snappy.compressFile(sourcePath, packedPath,
            onProgress = func(int inputBytes, int totalBytes, int outputBytes) as bool
                progress.calls += 1
                progress.inputBytes = inputBytes
                progress.totalBytes = totalBytes
                return true
            end)
        assert progress.calls > 0
        assert progress.inputBytes == source.len()
        assert progress.totalBytes == source.len()
        snappy.decompressFile(packedPath, restoredPath)
        assert file.readBytes(restoredPath) == source.toBytes()
    finally
        assert dir.delete(directory), "snappy example temporary directory must be removed"
    end

    println("snappy example: PASS")
    return 0
end
