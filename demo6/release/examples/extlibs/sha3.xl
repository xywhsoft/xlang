import sha3

// SHA-3 (Keccak) 哈希 + SHAKE XOF，NIST 标准。

string sample = "hello xlang"

// SHA3 一次性哈希（224/256/384/512）
println("SHA3-256: " + sha3.hash256Hex(sample))
println("SHA3-224: " + sha3.hashHex(sample, 224))
println("SHA3-384: " + sha3.hashHex(sample, 384))
println("SHA3-512: " + sha3.hashHex(sample, 512))

// SHAKE XOF（可变输出长度）
println("SHAKE128 (32B): " + sha3.shake128Hex(sample))
println("SHAKE256 (64B): " + sha3.shake256Hex(sample, 64))

// 流式 SHA3 哈希器（默认自然输出长度）
auto hasher = sha3.sha3Hasher(256)
hasher.update("hello ")
hasher.update("xlang")
assert hasher.digestHex() == sha3.hash256Hex(sample), "sha3 streaming mismatch"
println("streaming inputBytes: " + string(hasher.inputBytes))

// SHA3-512 流式：默认输出 128 hex 字符（自然长度 64 字节）
auto h512 = sha3.sha3Hasher(512)
h512.update(sample)
string d512 = h512.digestHex()
assert string.len(d512) == 128, "sha3-512 natural length should be 128 hex chars"
assert d512 == sha3.hashHex(sample, 512), "sha3-512 streaming mismatch"

// SHAKE 流式哈希器
auto shaker = sha3.shakeHasher(128)
shaker.update(sample)
assert shaker.digestHex() == sha3.shake128Hex(sample), "shake128 streaming mismatch"

// clone 独立副本
auto h1 = sha3.sha3Hasher(256)
h1.update("hello")
auto h2 = h1.clone()
h1.update(" xlang")
h2.update(" world")
println("clone h1: " + h1.digestHex())
println("clone h2: " + h2.digestHex())

// 文件哈希
dir.createAll("examples_out/extlibs")
file.writeText("examples_out/extlibs/sha3_sample.txt", sample)
assert sha3.hashFileHex("examples_out/extlibs/sha3_sample.txt") == sha3.hash256Hex(sample), "sha3 file mismatch"

println("sha3 extlib ok")
