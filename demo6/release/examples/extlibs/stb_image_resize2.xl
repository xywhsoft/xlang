import stb_image
import stb_image_resize2

func main(...) as int
    stb_image.StbImage image = stb_image.load(path.join(path.appDir(), "examples/extlibs/assets/tiny.png"), 4)
    Buffer pixels = image.pixels()
    Buffer small = stb_image_resize2.resize(pixels,
        image.width(), image.height(), 4, 4, 4)
    Buffer linear = stb_image_resize2.resizeLinear(pixels,
        image.width(), image.height(), 4, 3, 3)
    Buffer transparentWhite = Buffer()
    Buffer transparentBlack = Buffer()
    transparentWhite.appendByte(255)
    transparentWhite.appendByte(0)
    transparentWhite.appendByte(0)
    transparentWhite.appendByte(255)
    transparentBlack.appendByte(0)
    transparentBlack.appendByte(0)
    transparentBlack.appendByte(0)
    transparentBlack.appendByte(255)
    Buffer grayAlpha = stb_image_resize2.resize(transparentWhite, 2, 1, 2, 1, 1)
    assert small.len() == 64
    assert linear.len() == 36
    assert grayAlpha.len() == 2
    assert grayAlpha == stb_image_resize2.resize(transparentBlack, 2, 1, 2, 1, 1)
    println("sRGB bytes: ", small.len())
    println("linear bytes: ", linear.len())
    println("gray-alpha bytes: ", grayAlpha.len())
    println("stb_image_resize2 C/XL example: PASS")
    return 0
end
