import dotenv

func main(...) as int
    string directory = dir.temp("", "xlang-dotenv-", "")
    string configPath = ""
    try
        configPath = path.join(directory, "配置.env")
        file.writeText(configPath, "# application\nDB_HOST=localhost\nDB_PORT=5432\nGREETING=\"你好, world\"\n")

        auto config = dotenv.create()
        config.load(configPath)
        assert config.count == 3
        assert config.get("GREETING") == "你好, world"
        assert config.get("MISSING", "fallback") == "fallback"
        config.set("DB_PORT", "6432")
        println(config.get("DB_HOST") + ":" + config.get("DB_PORT"))
        println(config.get("GREETING"))
    finally
        if configPath != "" and file.exists(configPath) then file.delete(configPath) end
        dir.remove(directory)
    end

    println("dotenv example: PASS")
    return 0
end
