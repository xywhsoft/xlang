import dotenv



func main(...) as int
    // 范例自带输入，发布目录下可以独立运行。
    string envPath = "examples_out/extlibs/dotenv_sample.env"
    dir.createAll("examples_out/extlibs")
    file.writeText(envPath, "DB_HOST=localhost\nDB_PORT=5432\nDB_NAME=mydb\nAPI_KEY=secret123\n")

    int n = dotenv.load(envPath)
    assert n == 4, "dotenv example input should load"
    println("loaded", n, "variables")

    println("DB_HOST:", dotenv.get("DB_HOST"))
    println("DB_PORT:", dotenv.get("DB_PORT"))
    println("DB_NAME:", dotenv.get("DB_NAME"))
    println("API_KEY:", dotenv.get("API_KEY"))
    println("MISSING:", dotenv.get("MISSING", "default_val"))

    // Programmatic set
    dotenv.set("APP_ENV", "production")
    println("APP_ENV:", dotenv.get("APP_ENV"))
    println("total vars:", dotenv.count())

    println("dotenv example: PASS")
    return 0
end
