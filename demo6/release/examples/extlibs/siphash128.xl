import siphash128

bytes key = b"0123456789abcdef" // Reproducible example only.
Buffer one = siphash128.hash(b"A\x00B", key)
auto stream = siphash128.hasher(key)
stream.update(b"A\x00")
stream.update("B")
assert stream.digest().compare(one) == 0
println(codec.hexEncodeBytes(one.data(), c_size(one.len())))
