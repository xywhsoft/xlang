import xfeat

assert string.contains(xfeat.version(), "xfeat"), "xfeat version failed"
assert xfeat.available(), "xfeat runtime bridge should be available"
assert string.len(xfeat.last_error()) >= 0, "xfeat last_error failed"
assert xfeat.reset_stats(), "xfeat reset_stats failed"
assert string.contains(xfeat.stats_json(), "\"all\""), "xfeat stats_json failed"

point engineMissing = xfeat.open("__missing_xfeat_query_model__.onnx", "__missing_xfeat_target_model__.onnx")
assert engineMissing == null, "xfeat missing model open should fail"

point engineMissingThreaded = xfeat.open("__missing_xfeat_query_model__.onnx", "__missing_xfeat_target_model__.onnx", 1, 1)
assert engineMissingThreaded == null, "xfeat missing threaded model open should fail"

point nullEngine = null
point nullQuerySet = null
point prepared = xfeat.prepare_query(nullEngine, "__missing_query__.png")
assert prepared == null, "xfeat prepare_query null engine failed"
assert xfeat.release_query(nullQuerySet), "xfeat release_query null failed"
assert xfeat.close(nullEngine), "xfeat close null failed"

string jsonPrepared = xfeat.locate_json(nullEngine, nullQuerySet, "__missing_target__.png")
assert string.contains(jsonPrepared, "\"found\":false"), "xfeat locate_json prepared failed"

string jsonEngine = xfeat.locate_json(nullEngine, "__missing_query__.png", "__missing_target__.png")
assert string.contains(jsonEngine, "\"found\":false"), "xfeat locate_json engine failed"

string jsonEngineNamed = xfeat.locate_json(nullEngine, "__missing_query__.png", "__missing_target__.png", "target.png", "out.png")
assert string.contains(jsonEngineNamed, "\"found\":false"), "xfeat locate_json engine named failed"

string jsonPreparedNamed = xfeat.locate_json(nullEngine, nullQuerySet, "__missing_target__.png", "target.png", "out.png")
assert string.contains(jsonPreparedNamed, "\"found\":false"), "xfeat locate_json prepared named failed"

string savedPrepared = xfeat.locate_and_save(nullEngine, nullQuerySet, "__missing_target__.png", "__missing_output__.png")
assert string.contains(savedPrepared, "\"found\":false"), "xfeat locate_and_save prepared failed"

string savedEngine = xfeat.locate_and_save(nullEngine, "__missing_query__.png", "__missing_target__.png", "__missing_output__.png")
assert string.contains(savedEngine, "\"found\":false"), "xfeat locate_and_save engine failed"

println("xfeat extlib ok")
