import vcard

func main(...) as int
    var contact = {
        "fn": "王小明",
        "n": "王;小明;;;",
        "email": ["home@example.com", "work@example.com"]
    }
    string text = vcard.build(contact)
    string expected = "BEGIN:VCARD\r\nVERSION:3.0\r\nFN:王小明\r\nN:王;小明;;;\r\nEMAIL:home@example.com\r\nEMAIL:work@example.com\r\nEND:VCARD\r\n"
    assert text == expected
    if arg.length > 1 then
        assert file.writeText(string(arg[1]), text)
    end
    var back = vcard.parse(text)
    assert back["fn"] == "王小明"
    assert back["email"].length == 2
    assert back["email"][0] == "home@example.com"
    assert back["email"][1] == "work@example.com"
    println("name:", back["fn"])
    println("emails:", back["email"].length)
    println("has CRLF:", text.contains("\r\n"))
    println("vcard example: PASS")
    return 0
end
