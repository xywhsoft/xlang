import siphash

// SipHash-2-4 短输入哈希（MAC），适合哈希表防碰撞。

Buffer key = Buffer()
key.append("0123456789abcdef")

string sample = "hello xlang"

// 一次性 64 位哈希
int h64 = siphash.hash64(sample, key)
println("SipHash-64: " + string(h64))
println("SipHash-64 hex: " + siphash.hash64Hex(sample, key))

// 128 位变体
println("SipHash-128: " + siphash.hash128Hex(sample, key))

// 流式哈希（64 位）
auto hasher = siphash.hasher(key)
hasher.update("hello ")
hasher.update("xlang")
assert hasher.digest64() == h64, "siphash streaming mismatch"
println("streaming inputBytes: " + string(hasher.inputBytes))

// 流式哈希（128 位，独立实例）
auto hasher128 = siphash.hasher(key)
hasher128.update(sample)
assert hasher128.digest128Hex() == siphash.hash128Hex(sample, key), "siphash 128 streaming mismatch"

// clone 独立副本
auto h1 = siphash.hasher(key)
h1.update("hello")
auto h2 = h1.clone()
h1.update(" xlang")
h2.update(" world")
println("clone h1: " + h1.digest64Hex())
println("clone h2: " + h2.digest64Hex())

// 文件哈希
dir.createAll("examples_out/extlibs")
file.writeText("examples_out/extlibs/siphash_sample.txt", sample)
assert siphash.hashFile64("examples_out/extlibs/siphash_sample.txt", key) == h64, "siphash file mismatch"

println("siphash extlib ok")
