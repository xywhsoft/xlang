import dataframe

func main(...) as int
    // DataFrame tabular analysis

    println("Agg 2 = " + dataframe.agg(2))
    println("Join 0 = " + dataframe.joinType(0))
    println("Mean [10,20,30] = " + string.float(dataframe.mean("10,20,30")))
    println("Median [5,1,3] = " + string.float(dataframe.median("5,1,3")))

    println("dataframe example: PASS")
    return 0
end
