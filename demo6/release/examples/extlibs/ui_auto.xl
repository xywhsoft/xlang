import ui.auto

auto window = ui.auto.test_window()
assert window.valid(), "cannot create the UI automation test window"

auto edit = ui.auto.within(ui.auto.by_class_name("Edit", "", 50004), window.hwnd())
assert ui.auto.wait_exists(edit)
assert ui.auto.type_text(edit, "xlang UI automation")
println("edit text: ", ui.auto.read(edit))

auto button = ui.auto.within(ui.auto.by_class_name("Button", "", 50000), window.hwnd())
assert ui.auto.click(button)

assert window.close()
assert window.release()
assert ui.auto.shutdown()
println("ui.auto example: PASS")
