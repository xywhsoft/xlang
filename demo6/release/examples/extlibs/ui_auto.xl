import ui.auto

assert ui.auto.available(), "ui.auto available failed"
assert ui.auto.version() == "0.1.0", "ui.auto version failed"
assert string.len(ui.auto.last_error()) >= 0, "ui.auto last_error failed"

func wait_read_contains(Locator locator, string text) as bool
    for i in range(0, 20)
        if string.contains(ui.auto.read(locator), text) then
            return true
        end
        time.sleep(25)
    end
    return false
end

auto window = ui.auto.test_window()
assert window.valid() == true, "ui.auto helper window failed"

auto baseLocator = ui.auto.locator()
auto scopedBase = ui.auto.within(baseLocator, window.hwnd())
auto timedEdit = ui.auto.with_timeout(ui.auto.by_automation_id("1001", 50004), 2000)
auto editLocator = ui.auto.within(timedEdit, window.hwnd())
auto classLocator = ui.auto.within(ui.auto.by_class_name("Edit", "", 50004), window.hwnd())
auto nameLocator = ui.auto.within(ui.auto.by_name("Click", 50000), window.hwnd())
auto typeLocator = ui.auto.within(ui.auto.by_control_type(50004), window.hwnd())
auto missingProcessLocator = ui.auto.within(ui.auto.by_process_id(0), window.hwnd())
auto jsonLocator = ui.auto.within(ui.auto.locator_from_json('{"automationId":"1001","className":"Edit","name":"","controlType":50004,"processId":0}'), window.hwnd())

assert scopedBase.timeout_ms == 5000, "ui.auto locator default timeout failed"
assert editLocator.timeout_ms == 2000, "ui.auto with_timeout failed"
assert ui.auto.wait_exists(editLocator) == true, "ui.auto wait_exists by automation id failed"
assert ui.auto.wait_exists(classLocator) == true, "ui.auto wait_exists by class failed"
assert ui.auto.wait_exists(typeLocator) == true, "ui.auto wait_exists by control type failed"
assert ui.auto.wait_exists(jsonLocator) == true, "ui.auto locator_from_json failed"
assert ui.auto.wait_exists(missingProcessLocator) == false, "ui.auto missing process locator should not match"

assert ui.auto.type_text(editLocator, "auto-text") == true, "ui.auto type_text failed"
assert wait_read_contains(editLocator, "auto-text") == true, "ui.auto read failed"
assert ui.auto.click(nameLocator) == true, "ui.auto click failed"
assert string.contains(ui.auto.read(editLocator), "button-clicked"), "ui.auto click result failed"

assert ui.auto.screenshot(editLocator, "release/tmp/x_ui_auto_edit.png") == true, "ui.auto screenshot failed"
assert string.len(ui.auto.focused_locator_json()) > 0, "ui.auto focused_locator_json failed"

assert window.close() == true, "ui.auto window close failed"
assert window.release() == true, "ui.auto window release failed"
assert ui.auto.shutdown() == true, "ui.auto shutdown failed"

println("ui.auto extlib ok")
