import bz2

func main(...) as int
    // 字符串直接按 UTF-8 字节压缩；任意二进制使用 Buffer。
    string text = "你好，bz2"
    Buffer first = bz2.compress(text, level = bz2.BZ2_MIN_LEVEL)
    assert bz2.decompressText(first, smallMemory = true) == text

    // finish() 只封存流并返回 bool，最后的输出仍由 drain() 取走。
    auto encoder = bz2.compressor(level = 6, workFactor = bz2.BZ2_MAX_WORK_FACTOR)
    encoder.update("left")
    Buffer second = encoder.drain()
    encoder.update("right")
    assert encoder.finish() and encoder.finished
    second.append(encoder.drain())
    assert encoder.inputBytes == 9 and encoder.outputBytes == second.len()
    assert encoder.drain().len() == 0

    // 完整成员可以串联；finished 表示当前处于成员边界，不代替 finish 校验。
    auto decoder = bz2.decompressor()
    decoder.update(first)
    assert decoder.finished and decoder.members == 1
    Buffer plain = decoder.drain()
    decoder.update(second)
    assert decoder.finish() and decoder.members == 2
    plain.append(decoder.drain())
    assert plain.text() == text + "leftright"
    assert decoder.inputBytes == first.len() + second.len()
    assert decoder.outputBytes == plain.len()

    // 限额是累计字节数；排空内部输出不重置计数。
    bool limited = false
    try
        bz2.decompress(first, maxOutput = 1)
    catch RangeError e
        limited = true
    end
    assert limited

    // 原生错误按 XRT 类别传播，损坏压缩数据应捕获 IOError。
    first[10] = first[10] ^ 1
    bool rejected = false
    try
        bz2.decompress(first)
    catch IOError e
        rejected = true
    end
    assert rejected
    println("bz2 example: PASS")
    return 0
end
