import bz2

class FileProgress
    int calls = 0
    int inputBytes = 0
    int totalBytes = 0
end



func main(...) as int
    // ─── 1. 一次性压缩 / 解压（Buffer 二进制安全）───
    Buffer source = Buffer()
    source.append("xlang bz2 ")
    source.appendByte(0)
    source.appendByte(255)

    Buffer packed = bz2.compress(source, bz2.BZ2_MAX_LEVEL)
    Buffer plain = bz2.decompress(packed)
    assert plain == source, "bz2 Buffer round trip failed"
    println("一次性: ", source.len(), " 字节 -> ", packed.len(), " 字节")

    // 直接压缩字符串（内部自动转 Buffer）。
    Buffer textPacked = bz2.compress("hello bz2")
    assert bz2.decompressText(textPacked) == "hello bz2"

    // ─── 2. 增量流式压缩：update -> drain -> finish ───
    // drain() 随时取走已产出的压缩字节，适合边喂数据边落盘/发送。
    auto encoder = bz2.compressor(6)
    Buffer streamPacked = Buffer()
    encoder.update("hello ")
    streamPacked.append(encoder.drain())
    encoder.update("stream")
    streamPacked.append(encoder.drain())
    encoder.finish()                 // 封存流（写入尾部校验）
    streamPacked.append(encoder.drain())
    println("流式压缩: 喂入 ", encoder.inputBytes, " 字节, 产出 ",
        encoder.outputBytes, " 字节")

    // ─── 3. 增量流式解压 + 进度回显 + 多成员统计 ───
    auto decoder = bz2.decompressor()
    Buffer restored = Buffer()
    decoder.update(streamPacked)
    restored.append(decoder.drain()) // 取走已解压数据
    println("解压进度: 已喂入 ", decoder.inputBytes, " / 已产出 ",
        decoder.outputBytes, " 字节, 完成=", decoder.finished)
    decoder.finish()                 // 校验流完整性
    restored.append(decoder.drain())
    assert restored.text() == "hello stream", "bz2 incremental round trip failed"
    println("成员数: ", decoder.members) // 1；>1 表示串联多成员流

    Buffer chained = Buffer()
    chained.append(packed)
    chained.append(streamPacked)
    Buffer chainedPlain = bz2.decompress(chained)
    Buffer chainedExpected = Buffer()
    chainedExpected.append(source)
    chainedExpected.append("hello stream")
    assert chainedPlain == chainedExpected, "concatenated bz2 member mismatch"

    // 前一成员完整时，不能掩盖后一成员尾部截断。
    Buffer chainedTruncated = Buffer()
    chainedTruncated.append(packed)
    for i in range(0, streamPacked.len() - 1)
        chainedTruncated.appendByte(streamPacked[i])
    end
    bool truncatedRejected = false
    try
        bz2.decompress(chainedTruncated)
    catch CompressionError e
        truncatedRejected = true
    end
    assert truncatedRejected, "truncated final bz2 member must be rejected"

    // ─── 4. workFactor 调优（0..250，控制压缩率/速度权衡）───
    auto tuned = bz2.compressor(bz2.BZ2_MAX_LEVEL, bz2.BZ2_MAX_WORK_FACTOR)
    tuned.update("tune me")
    tuned.finish()
    assert bz2.decompress(tuned.drain()).text() == "tune me"

    // ─── 5. 损坏数据必然抛 CompressionError ───
    bool rejected = false
    streamPacked[10] = streamPacked[10] ^ 1
    try
        bz2.decompress(streamPacked)
    catch CompressionError e
        rejected = true
    end
    assert rejected, "corrupt bz2 must raise CompressionError"

    // ─── 6. 文件便捷接口（XRT reader/writer，临时文件+原子重命名）───
    dir.createAll("tmp")
    file.writeBytes("tmp/bz2_example_source.bin", source)
    FileProgress progress = FileProgress()
    bz2.compressFile("tmp/bz2_example_source.bin", "tmp/bz2_example.bz2",
        onProgress = func(int inputBytes, int totalBytes, int outputBytes) as bool
            progress.calls += 1
            progress.inputBytes = inputBytes
            progress.totalBytes = totalBytes
            return true
        end)
    assert progress.calls > 0
    assert progress.inputBytes == source.len()
    assert progress.totalBytes == source.len()
    bz2.decompressFile("tmp/bz2_example.bz2", "tmp/bz2_example_plain.bin")
    assert file.readBytes("tmp/bz2_example_plain.bin") == source
    file.delete("tmp/bz2_example_source.bin")
    file.delete("tmp/bz2_example.bz2")
    file.delete("tmp/bz2_example_plain.bin")

    println("bz2 example: PASS")
    return 0
end
