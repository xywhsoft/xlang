import gzip

func main(...) as int
    // 与 C 范例使用相同 UTF-8 字节和输出，压缩后数据总是 Buffer。
    string text = "hello 世界"
    assert gzip.decompressText(gzip.compress(text, level = 4)) == text
    println("utf8: ok")

    Buffer binary = Buffer()
    for value in [0, 255, 128, 65]
        binary.appendByte(int(value))
    end
    assert gzip.decompress(gzip.compress(binary, level = 4)) == binary
    println("binary: ok")

    gzip.GzipCompressor encoder = gzip.compressor(level = 4)
    encoder.update("left")
    Buffer packed = encoder.drain()
    encoder.update("right")
    packed.append(encoder.finish())
    gzip.GzipDecompressor decoder = gzip.decompressor()
    decoder.update(packed)
    assert decoder.finish().text() == "leftright"
    assert encoder.inputBytes == 9 and decoder.outputBytes == 9
    println("stream: ok")

    // 空内容的合法 gzip 与零字节的非法压缩输入不同。
    bool rejected = false
    try
        gzip.decompress(Buffer())
    catch IOError e
        rejected = true
    end
    assert rejected
    println("truncated: rejected")
    return 0
end
