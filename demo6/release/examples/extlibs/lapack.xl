import lapack

func main(...) as int
    // LAPACK linear algebra

    // Routine info
    println("Category 0 = " + lapack.routineCategory(0))
    println("Routine 0 = " + lapack.routineName(0))

    // Solve 2x2 system
    println("Solve [[2,1],[1,3]]x=[5,10] = " + lapack.solve2x2("2,1,1,3", "5,10"))

    // Determinant
    println("Det [[2,1],[1,3]] = " + string(lapack.det2x2("2,1,1,3")))

    println("lapack example: PASS")
    return 0
end
