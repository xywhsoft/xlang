import watch



func main(...) as int
    auto w = watch.create()

    // 从 release 或 demo6 目录运行都能找到同一份源文件。
    string watched = "extlibs/watch/src/watch.xl"
    if not path.exists(watched) then
        watched = "release/extlibs/watch/src/watch.xl"
    end
    assert watch.exists(watched), "watch example file missing"
    auto idx = w.add(watched)
    println("watching index: ", idx)
    println("path: ", w.path(idx))
    println("active watches: ", w.count)

    // Poll for changes
    auto evt = w.poll()
    if evt == "" then
        println("no changes detected")
    else
        println("event: ", evt)
    end

    // Check file existence
    println("exists: ", watch.exists(watched))

    println("watch example: PASS")
    return 0
end
