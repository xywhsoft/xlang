import redis

assert redis.available(), "redis available failed"
assert redis.version() == "0.1.0", "redis version failed"
assert redis.parser_last_error() == "", "redis initial parser_last_error failed"

list<string> listArgs = list[0: "SET", 1: "k", 2: "v"]
array<string> arrayArgs = ["k", "v"]
array<string> commandArray = [redis.argv_json1("PING")]

string encoded = redis.resp_encode3("SET", "k", "v")
assert string.contains(encoded, "*3"), "redis resp_encode3 failed"
assert string.contains(redis.resp_encode_array(listArgs), "$3"), "redis resp_encode_array failed"
string argv = redis.argv_json2("GET", "k")
assert string.contains(argv, "GET"), "redis argv_json2 failed"
assert string.contains(redis.resp_encode_json(argv), "*2"), "redis resp_encode_json failed"
string pipe = redis.pipeline_json2(redis.argv_json3("SET", "k", "v"), redis.argv_json2("GET", "k"))
assert string.contains(redis.resp_encode_pipeline_json(pipe), "*3"), "redis resp_encode_pipeline_json failed"
assert string.contains(redis.pipeline_json_array(commandArray), "PING"), "redis pipeline_json_array failed"
assert redis.transport_name() == "std.net.tcp", "redis transport_name failed"
assert redis.transport_binary_safe() == false, "redis transport_binary_safe failed"
assert redis.transport_tls() == false, "redis transport_tls failed"
assert string.contains(redis.transport_limits_json(), "binary_safe"), "redis transport_limits_json failed"
assert string.contains(redis.sentinel_capabilities_json(), "discovery"), "redis sentinel_capabilities_json failed"
assert string.contains(redis.cluster_capabilities_json(), "redirect_parsing"), "redis cluster_capabilities_json failed"

string simpleJson = redis.parse_response_json("+OK\r\n")
string errorJson = redis.parse_response_json("-ERR bad\r\n")
string intJson = redis.parse_response_json(":42\r\n")
string bulkJson = redis.parse_response_json("$5\r\nhello\r\n")
string nilJson = redis.parse_response_json("$-1\r\n")
string arrayJson = redis.parse_response_json("*2\r\n$1\r\na\r\n$1\r\nb\r\n")
string invalidJson = redis.parse_response_json("?bad\r\n")
assert redis.response_error(invalidJson), "redis invalid RESP should fail"
assert string.contains(redis.parser_last_error(), "invalid RESP prefix"), "redis parser_last_error failed"
string setJson = redis.parse_response_json("~1\r\n+red\r\n")
string mapJson = redis.parse_response_json("%1\r\n+name\r\n$3\r\nAda\r\n")
string boolJson = redis.parse_response_json("#t\r\n")
string doubleJson = redis.parse_response_json(",3.14\r\n")
string bigJson = redis.parse_response_json("(3492890328409328509324850943850943825024385\r\n")
string blobErrJson = redis.parse_response_json("!11\r\nSYNTAX fail\r\n")
string verbatimJson = redis.parse_response_json("=8\r\ntxt:demo\r\n")
assert redis.parse_response_chunks_json("+O", "K\r\n") == simpleJson, "redis parse_response_chunks_json failed"
assert redis.response_type(simpleJson) == "simple", "redis response_type failed"
assert redis.response_value(simpleJson) == "OK", "redis response_value failed"
assert redis.response_ok(simpleJson), "redis response_ok failed"
assert redis.response_error(errorJson), "redis response_error failed"
assert redis.response_error_text(errorJson) == "ERR bad", "redis response_error_text failed"
assert redis.response_int(intJson) == 42, "redis response_int failed"
assert redis.response_bool(boolJson), "redis response_bool failed"
assert redis.response_double_text(doubleJson) == "3.14", "redis response_double_text failed"
assert redis.response_bignumber_text(bigJson) != "", "redis response_bignumber_text failed"
assert redis.response_blob_error_text(blobErrJson) == "SYNTAX fail", "redis response_blob_error_text failed"
assert redis.response_verbatim_text(verbatimJson) == "txt:demo", "redis response_verbatim_text failed"
assert redis.response_nil(nilJson), "redis response_nil failed"
assert redis.response_array_length(arrayJson) == 2, "redis response_array_length failed"
assert redis.response_array_value(arrayJson, 1) == "b", "redis response_array_value failed"
assert redis.response_set_length(setJson) == 1, "redis response_set_length failed"
assert redis.response_set_value(setJson, 0) == "red", "redis response_set_value failed"
assert redis.response_map_length(mapJson) == 1, "redis response_map_length failed"
assert redis.response_map_key_value(mapJson, 0) == "name", "redis response_map_key_value failed"
assert redis.response_map_value_value(mapJson, 0) == "Ada", "redis response_map_value_value failed"
assert redis.response_map_value(mapJson, "name") == "Ada", "redis response_map_value failed"
assert redis.response_map_has_key(mapJson, "name"), "redis response_map_has_key failed"

string movedJson = '{"type":"error","value":"MOVED 3999 127.0.0.1:7000"}'
string readonlyJson = '{"type":"error","value":"READONLY replica"}'
assert redis.cluster_redirect_type(movedJson) == "MOVED", "redis cluster_redirect_type failed"
assert redis.cluster_redirect_slot(movedJson) == 3999, "redis cluster_redirect_slot failed"
assert redis.cluster_redirect_endpoint(movedJson) == "127.0.0.1:7000", "redis cluster_redirect_endpoint failed"
assert redis.cluster_redirect_host(movedJson) == "127.0.0.1", "redis cluster_redirect_host failed"
assert redis.cluster_redirect_port(movedJson) == 7000, "redis cluster_redirect_port failed"
assert redis.cluster_retryable_error(readonlyJson), "redis cluster_retryable_error failed"
string slotsJson = '{"type":"array","items":[{"type":"array","items":[{"type":"integer","value":0},{"type":"integer","value":16383},{"type":"array","items":[{"type":"bulk","value":"127.0.0.1","nil":false},{"type":"integer","value":6379}],"nil":false}],"nil":false}],"nil":false}'
auto redisCache = redis.cluster_slots_cache(slotsJson)
assert redis.cluster_slots_cache_valid(redisCache), "redis cluster_slots_cache_valid failed"
assert redis.cluster_slots_cache_json(redisCache) == slotsJson, "redis cluster_slots_cache_json failed"
assert redis.cluster_slots_node_host(slotsJson, 42) == "127.0.0.1", "redis cluster_slots_node_host failed"
assert redis.cluster_slots_node_port(slotsJson, 42) == 6379, "redis cluster_slots_node_port failed"
string sentinelAddrJson = redis.parse_response_json("*2\r\n$9\r\n127.0.0.1\r\n:6379\r\n")
assert redis.sentinel_master_host(sentinelAddrJson) == "127.0.0.1", "redis sentinel_master_host failed"
assert redis.sentinel_master_port(sentinelAddrJson) == 6379, "redis sentinel_master_port failed"

string invalidSlotsJson = "k"
auto invalidClient = redis.cluster_connect_redirect(errorJson, 1)
auto invalidPool = redis.pool("", 0, 1, 2)
auto emptyCache = redis.cluster_slots_cache(invalidSlotsJson)

assert invalidClient.valid() == false, "redis invalid client setup failed"
assert redis.response_error(redis.command1(invalidClient, "PING")), "redis invalid command1 failed"
assert redis.response_error(redis.command2(invalidClient, "GET", "k")), "redis invalid command2 failed"
assert redis.response_error(redis.command3(invalidClient, "SET", "k", "v")), "redis invalid command3 failed"
assert redis.response_error(redis.command4(invalidClient, "SET", "k", "v", "NX")), "redis invalid command4 failed"
assert redis.response_error(redis.command5(invalidClient, "HELLO", "3", "AUTH", "u", "p")), "redis invalid command5 failed"
assert redis.response_error(redis.command_array(invalidClient, listArgs)), "redis invalid command_array list failed"
assert redis.response_error(redis.command_json(invalidClient, argv)), "redis invalid command_json failed"
assert redis.response_error(redis.command_pipeline_json(invalidClient, pipe)), "redis invalid pipeline failed"
assert redis.response_error(redis.read_response_json(invalidClient)), "redis invalid read_response_json failed"

assert string.contains(redis.resp_encode1("PING"), "*1"), "redis resp_encode1 failed"
assert string.contains(redis.resp_encode2("GET", "k"), "*2"), "redis resp_encode2 failed"
assert string.contains(redis.resp_encode4("SET", "k", "v", "NX"), "*4"), "redis resp_encode4 failed"
assert string.contains(redis.resp_encode5("HELLO", "3", "AUTH", "u", "p"), "*5"), "redis resp_encode5 failed"
assert string.contains(redis.argv_json4("SET", "k", "v", "NX"), "NX"), "redis argv_json4 failed"
assert string.contains(redis.argv_json_list("MGET", arrayArgs), "MGET"), "redis argv_json_list failed"
assert string.contains(redis.pipeline_json1(redis.argv_json1("PING")), "PING"), "redis pipeline_json1 failed"
assert string.contains(redis.pipeline_json3(redis.argv_json1("PING"), redis.argv_json1("PING"), redis.argv_json1("PING")), "PING"), "redis pipeline_json3 failed"
assert string.contains(redis.pipeline_json4(redis.argv_json1("PING"), redis.argv_json1("PING"), redis.argv_json1("PING"), redis.argv_json1("PING")), "PING"), "redis pipeline_json4 failed"
assert string.contains(redis.pipeline_json5(redis.argv_json1("PING"), redis.argv_json1("PING"), redis.argv_json1("PING"), redis.argv_json1("PING"), redis.argv_json1("PING")), "PING"), "redis pipeline_json5 failed"

auto acquired = redis.pool_acquire(invalidPool)
assert acquired.valid() == false, "redis invalid pool_acquire failed"
assert redis.pool_release(invalidPool, acquired) == false, "redis invalid pool_release failed"
assert redis.pool_idle_count(invalidPool) == 0, "redis invalid pool_idle_count failed"
assert redis.pool_close(invalidPool) == 0, "redis invalid pool_close failed"
assert redis.close(invalidClient) == false, "redis invalid close failed"
assert string.len(redis.last_error(invalidClient)) > 0, "redis invalid last_error failed"
auto invalidConnect = redis.connect("", 0, 1)
assert invalidConnect.valid() == false, "redis invalid connect failed"

assert string.len(redis.ping(invalidClient)) > 0, "redis invalid ping failed"
assert string.len(redis.ping(invalidClient, "hello")) > 0, "redis invalid ping message failed"
assert redis.auth(invalidClient, "pw") == false, "redis invalid auth failed"
assert redis.auth(invalidClient, "u", "pw") == false, "redis invalid auth user failed"
assert redis.response_error(redis.hello(invalidClient, 3)), "redis invalid hello failed"
assert redis.response_error(redis.hello_auth(invalidClient, 3, "u", "pw")), "redis invalid hello_auth failed"
assert redis.select(invalidClient, 0) == false, "redis invalid select failed"
assert redis.dbsize(invalidClient) == 0, "redis invalid dbsize failed"
assert redis.flushdb(invalidClient) == false, "redis invalid flushdb failed"

auto invalidSentinelMaster = redis.sentinel_connect_master(invalidClient, "master")
auto invalidSentinelMasterTimed = redis.sentinel_connect_master(invalidClient, "master", 1)
assert invalidSentinelMaster.valid() == false and invalidSentinelMasterTimed.valid() == false, "redis invalid sentinel_connect_master failed"
assert redis.response_error(redis.sentinel_masters_json(invalidClient)), "redis invalid sentinel_masters_json failed"
assert redis.response_error(redis.sentinel_master_json(invalidClient, "master")), "redis invalid sentinel_master_json failed"
assert redis.response_error(redis.sentinel_get_master_addr_by_name_json(invalidClient, "master")), "redis invalid sentinel_get_master_addr_by_name_json failed"
assert redis.response_error(redis.sentinel_command_master_once_json(invalidClient, "master", argv)), "redis invalid sentinel once failed"
assert redis.response_error(redis.sentinel_command_master_once_json(invalidClient, "master", argv, 1)), "redis invalid sentinel once timeout failed"
assert redis.response_error(redis.sentinel_command_master_retry_json(invalidClient, "master", argv, 1)), "redis invalid sentinel retry failed"
assert redis.response_error(redis.sentinel_command_master_retry_json(invalidClient, "master", argv, 1, 1)), "redis invalid sentinel retry timeout failed"
assert redis.response_error(redis.sentinel_command_master_once_password_json(invalidClient, "master", "pw", argv)), "redis invalid sentinel once password failed"
assert redis.response_error(redis.sentinel_command_master_once_password_json(invalidClient, "master", "pw", argv, 1)), "redis invalid sentinel once password timeout failed"
assert redis.response_error(redis.sentinel_command_master_retry_password_json(invalidClient, "master", "pw", argv, 1)), "redis invalid sentinel retry password failed"
assert redis.response_error(redis.sentinel_command_master_retry_password_json(invalidClient, "master", "pw", argv, 1, 1)), "redis invalid sentinel retry password timeout failed"
assert redis.response_error(redis.sentinel_command_master_once_auth_json(invalidClient, "master", "u", "pw", argv)), "redis invalid sentinel once auth failed"
assert redis.response_error(redis.sentinel_command_master_once_auth_json(invalidClient, "master", "u", "pw", argv, 1)), "redis invalid sentinel once auth timeout failed"
assert redis.response_error(redis.sentinel_command_master_retry_auth_json(invalidClient, "master", "u", "pw", argv, 1)), "redis invalid sentinel retry auth failed"
assert redis.response_error(redis.sentinel_command_master_retry_auth_json(invalidClient, "master", "u", "pw", argv, 1, 1)), "redis invalid sentinel retry auth timeout failed"
assert string.len(redis.sentinel_ping(invalidClient, "master")) > 0, "redis invalid sentinel_ping failed"
assert string.len(redis.sentinel_ping(invalidClient, "master", "hello")) > 0, "redis invalid sentinel_ping message failed"
assert redis.sentinel_select(invalidClient, "master", 0) == false, "redis invalid sentinel_select failed"
assert redis.sentinel_dbsize(invalidClient, "master") == 0, "redis invalid sentinel_dbsize failed"
assert string.len(redis.sentinel_get(invalidClient, "master", "k")) > 0, "redis invalid sentinel_get failed"
assert redis.sentinel_get_or(invalidClient, "master", "k", "fallback") == "fallback", "redis invalid sentinel_get_or failed"
assert redis.sentinel_set(invalidClient, "master", "k", "v") == false, "redis invalid sentinel_set failed"
assert redis.sentinel_set_nx(invalidClient, "master", "k", "v") == false, "redis invalid sentinel_set_nx failed"
assert redis.sentinel_set_xx(invalidClient, "master", "k", "v") == false, "redis invalid sentinel_set_xx failed"
assert redis.sentinel_set_ex(invalidClient, "master", "k", "v", 1) == false, "redis invalid sentinel_set_ex failed"
assert redis.response_error(redis.sentinel_mget_json(invalidClient, "master", arrayArgs)), "redis invalid sentinel_mget_json failed"
assert redis.sentinel_mset(invalidClient, "master", arrayArgs) == false, "redis invalid sentinel_mset failed"
assert redis.sentinel_append(invalidClient, "master", "k", "v") == 0, "redis invalid sentinel_append failed"
assert redis.sentinel_strlen(invalidClient, "master", "k") == 0, "redis invalid sentinel_strlen failed"
assert redis.sentinel_del(invalidClient, "master", "k") == 0, "redis invalid sentinel_del failed"
assert redis.sentinel_exists(invalidClient, "master", "k") == false, "redis invalid sentinel_exists failed"
assert redis.sentinel_expire(invalidClient, "master", "k", 1) == false, "redis invalid sentinel_expire failed"
assert redis.sentinel_persist(invalidClient, "master", "k") == false, "redis invalid sentinel_persist failed"
assert redis.sentinel_ttl(invalidClient, "master", "k") == 0, "redis invalid sentinel_ttl failed"
assert redis.sentinel_pttl(invalidClient, "master", "k") == 0, "redis invalid sentinel_pttl failed"
assert redis.sentinel_incr(invalidClient, "master", "k") == 0, "redis invalid sentinel_incr failed"
assert redis.sentinel_incr_by(invalidClient, "master", "k", 1) == 0, "redis invalid sentinel_incr_by failed"
assert redis.sentinel_decr(invalidClient, "master", "k") == 0, "redis invalid sentinel_decr failed"
assert redis.sentinel_decr_by(invalidClient, "master", "k", 1) == 0, "redis invalid sentinel_decr_by failed"
assert string.len(redis.sentinel_hget(invalidClient, "master", "k", "f")) > 0, "redis invalid sentinel_hget failed"
assert redis.sentinel_hget_or(invalidClient, "master", "k", "f", "fallback") == "fallback", "redis invalid sentinel_hget_or failed"
assert redis.sentinel_hset(invalidClient, "master", "k", "f", "v") == 0, "redis invalid sentinel_hset failed"
assert redis.sentinel_hdel(invalidClient, "master", "k", "f") == 0, "redis invalid sentinel_hdel failed"
assert redis.sentinel_hexists(invalidClient, "master", "k", "f") == false, "redis invalid sentinel_hexists failed"
assert redis.sentinel_hlen(invalidClient, "master", "k") == 0, "redis invalid sentinel_hlen failed"
assert redis.sentinel_hstrlen(invalidClient, "master", "k", "f") == 0, "redis invalid sentinel_hstrlen failed"
assert redis.response_error(redis.sentinel_hgetall_json(invalidClient, "master", "k")), "redis invalid sentinel_hgetall_json failed"
assert redis.sentinel_lpush(invalidClient, "master", "k", "v") == 0, "redis invalid sentinel_lpush failed"
assert redis.sentinel_rpush(invalidClient, "master", "k", "v") == 0, "redis invalid sentinel_rpush failed"
assert string.len(redis.sentinel_lpop(invalidClient, "master", "k")) > 0, "redis invalid sentinel_lpop failed"
assert redis.sentinel_lpop_or(invalidClient, "master", "k", "fallback") == "fallback", "redis invalid sentinel_lpop_or failed"
assert string.len(redis.sentinel_rpop(invalidClient, "master", "k")) > 0, "redis invalid sentinel_rpop failed"
assert redis.sentinel_rpop_or(invalidClient, "master", "k", "fallback") == "fallback", "redis invalid sentinel_rpop_or failed"
assert redis.sentinel_llen(invalidClient, "master", "k") == 0, "redis invalid sentinel_llen failed"
assert redis.response_error(redis.sentinel_lrange_json(invalidClient, "master", "k", 0, 1)), "redis invalid sentinel_lrange_json failed"
assert redis.sentinel_sadd(invalidClient, "master", "k", "m") == 0, "redis invalid sentinel_sadd failed"
assert redis.sentinel_srem(invalidClient, "master", "k", "m") == 0, "redis invalid sentinel_srem failed"
assert redis.sentinel_sismember(invalidClient, "master", "k", "m") == false, "redis invalid sentinel_sismember failed"
assert redis.response_error(redis.sentinel_smembers_json(invalidClient, "master", "k")), "redis invalid sentinel_smembers_json failed"
assert redis.response_error(redis.sentinel_replicas_json(invalidClient, "master")), "redis invalid sentinel_replicas_json failed"
assert redis.response_error(redis.sentinel_sentinels_json(invalidClient, "master")), "redis invalid sentinel_sentinels_json failed"

assert redis.response_error(redis.cluster_info_json(invalidClient)), "redis invalid cluster_info_json failed"
assert redis.response_error(redis.cluster_nodes_json(invalidClient)), "redis invalid cluster_nodes_json failed"
assert redis.response_error(redis.cluster_slots_json(invalidClient)), "redis invalid cluster_slots_json failed"
assert redis.cluster_slots_cache_refresh(emptyCache, invalidClient) == false, "redis invalid cluster_slots_cache_refresh failed"
auto invalidSlotClient = redis.cluster_connect_slot(invalidSlotsJson, 42, 1)
assert invalidSlotClient.valid() == false, "redis invalid cluster_connect_slot failed"
assert redis.cluster_keyslot(invalidClient, "k") == 0, "redis invalid cluster_keyslot failed"
assert redis.response_error(redis.cluster_command_redirect_once_json(invalidClient, argv)), "redis invalid cluster redirect once failed"
assert redis.response_error(redis.cluster_command_redirect_once_json(invalidClient, argv, 1)), "redis invalid cluster redirect once timeout failed"
assert redis.response_error(redis.cluster_command_redirect_retry_json(invalidClient, argv, 1)), "redis invalid cluster redirect retry failed"
assert redis.response_error(redis.cluster_command_redirect_retry_json(invalidClient, argv, 1, 1)), "redis invalid cluster redirect retry timeout failed"
assert redis.response_error(redis.cluster_command_slot_once_json(invalidClient, invalidSlotsJson, "k", argv)), "redis invalid cluster slot once failed"
assert redis.response_error(redis.cluster_command_slot_once_json(invalidClient, invalidSlotsJson, "k", argv, 1)), "redis invalid cluster slot once timeout failed"
assert redis.response_error(redis.cluster_command_slot_retry_json(invalidClient, invalidSlotsJson, "k", argv, 1)), "redis invalid cluster slot retry failed"
assert redis.response_error(redis.cluster_command_slot_retry_json(invalidClient, invalidSlotsJson, "k", argv, 1, 1)), "redis invalid cluster slot retry timeout failed"
assert redis.response_error(redis.cluster_command_slot_once_password_json(invalidClient, invalidSlotsJson, "k", "pw", argv)), "redis invalid cluster slot once password failed"
assert redis.response_error(redis.cluster_command_slot_once_password_json(invalidClient, invalidSlotsJson, "k", "pw", argv, 1)), "redis invalid cluster slot once password timeout failed"
assert redis.response_error(redis.cluster_command_slot_retry_password_json(invalidClient, invalidSlotsJson, "k", "pw", argv, 1)), "redis invalid cluster slot retry password failed"
assert redis.response_error(redis.cluster_command_slot_retry_password_json(invalidClient, invalidSlotsJson, "k", "pw", argv, 1, 1)), "redis invalid cluster slot retry password timeout failed"
assert redis.response_error(redis.cluster_command_slot_once_auth_json(invalidClient, invalidSlotsJson, "k", "u", "pw", argv)), "redis invalid cluster slot once auth failed"
assert redis.response_error(redis.cluster_command_slot_once_auth_json(invalidClient, invalidSlotsJson, "k", "u", "pw", argv, 1)), "redis invalid cluster slot once auth timeout failed"
assert redis.response_error(redis.cluster_command_slot_retry_auth_json(invalidClient, invalidSlotsJson, "k", "u", "pw", argv, 1)), "redis invalid cluster slot retry auth failed"
assert redis.response_error(redis.cluster_command_slot_retry_auth_json(invalidClient, invalidSlotsJson, "k", "u", "pw", argv, 1, 1)), "redis invalid cluster slot retry auth timeout failed"
assert redis.response_error(redis.cluster_command_key_once_json(invalidClient, "k", argv)), "redis invalid cluster key once failed"
assert redis.response_error(redis.cluster_command_key_once_json(invalidClient, "k", argv, 1)), "redis invalid cluster key once timeout failed"
assert redis.response_error(redis.cluster_command_key_retry_json(invalidClient, "k", argv, 1)), "redis invalid cluster key retry failed"
assert redis.response_error(redis.cluster_command_key_retry_json(invalidClient, "k", argv, 1, 1)), "redis invalid cluster key retry timeout failed"
assert redis.response_error(redis.cluster_command_key_once_password_json(invalidClient, "k", "pw", argv)), "redis invalid cluster key once password failed"
assert redis.response_error(redis.cluster_command_key_once_password_json(invalidClient, "k", "pw", argv, 1)), "redis invalid cluster key once password timeout failed"
assert redis.response_error(redis.cluster_command_key_retry_password_json(invalidClient, "k", "pw", argv, 1)), "redis invalid cluster key retry password failed"
assert redis.response_error(redis.cluster_command_key_retry_password_json(invalidClient, "k", "pw", argv, 1, 1)), "redis invalid cluster key retry password timeout failed"
assert redis.response_error(redis.cluster_command_key_once_auth_json(invalidClient, "k", "u", "pw", argv)), "redis invalid cluster key once auth failed"
assert redis.response_error(redis.cluster_command_key_once_auth_json(invalidClient, "k", "u", "pw", argv, 1)), "redis invalid cluster key once auth timeout failed"
assert redis.response_error(redis.cluster_command_key_retry_auth_json(invalidClient, "k", "u", "pw", argv, 1)), "redis invalid cluster key retry auth failed"
assert redis.response_error(redis.cluster_command_key_retry_auth_json(invalidClient, "k", "u", "pw", argv, 1, 1)), "redis invalid cluster key retry auth timeout failed"
assert redis.response_error(redis.cluster_command_cached_key_once_json(invalidClient, emptyCache, "k", argv)), "redis invalid cluster cached once failed"
assert redis.response_error(redis.cluster_command_cached_key_retry_json(invalidClient, emptyCache, "k", argv, 1)), "redis invalid cluster cached retry failed"
