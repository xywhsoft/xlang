import mpfr



func main(...) as int
    println("Default prec: ", mpfr.defaultPrec())
    println("Prec(10 dig):  ", mpfr.precForDigits(10))
    println("Pi:            ", mpfr.format(mpfr.constPi(), 10))
    println("E:             ", mpfr.format(mpfr.constE(), 10))
    println("Sqrt2:         ", mpfr.format(mpfr.constSqrt2(), 10))
    println("Format(3.14):  ", mpfr.format(3.14159265, 4))
    println("Scientific:    ", mpfr.scientific(123456.789, 3))
    println("mpfr example: PASS")
    return 0
end
