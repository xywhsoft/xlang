import rtree



func main(...) as int
    auto t = rtree.create()

    // Insert buildings as bounding boxes
    t.insert(1, 100.0, 200.0, 110.0, 210.0)
    t.insert(2, 150.0, 250.0, 160.0, 260.0)
    t.insert(3, 105.0, 205.0, 115.0, 215.0)
    t.insert(4, 500.0, 500.0, 510.0, 510.0)

    println("total items: ", t.count)

    // Query a region
    auto results = t.search(99.0, 199.0, 112.0, 212.0)
    println("search(99,199,112,212) = [", results, "]")
    println("  count: ", t.searchCount(99.0, 199.0, 112.0, 212.0))

    // Remove one
    t.remove(1)
    println("after remove(1), count: ", t.count)

    println("rtree example: PASS")
    return 0
end
