import rtree



func main(...) as int
    auto t = rtree.create()

    // 用建筑物的包围盒建立空间索引。
    t.insert(1, 100.0, 200.0, 110.0, 210.0)
    t.insert(2, 150.0, 250.0, 160.0, 260.0)
    t.insert(3, 105.0, 205.0, 115.0, 215.0)
    t.insert(4, 500.0, 500.0, 510.0, 510.0)

    var results = t.search(99.0, 199.0, 112.0, 212.0)
    println("hits:", results.length)
    t.remove(1)
    println("remaining:", t.count)
    println("rtree example: PASS")
    return 0
end
