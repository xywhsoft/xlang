import geohash



func main(...) as int
    // Encode coordinates (Beijing)
    string h = geohash.encode(39.9042, 116.4074, 7)
    println("Beijing geohash:", h)
    println("precision:", geohash.precision(h))

    // Decode back and check that the center remains in Beijing.
    float lat = geohash.decodeLat(h)
    float lon = geohash.decodeLon(h)
    println("center near Beijing:", lat > 39.9 and lat < 39.91 and lon > 116.4 and lon < 116.41)

    // Bounding box
    println("bbox:", geohash.bbox(h))

    // Neighbors
    println("north:", geohash.north(h))
    println("south:", geohash.south(h))
    println("east:", geohash.east(h))
    println("west:", geohash.west(h))

    println("geohash example: PASS")
    return 0
end
