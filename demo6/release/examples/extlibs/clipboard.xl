import clipboard

dir.createAll("release/tmp/extlibs")
string sample = "demo6 clipboard text"
string filePath = "release/tmp/extlibs/clipboard_file.txt"
string imagePath = "release/tmp/extlibs/clipboard_image.bmp"
string missingImagePath = "release/tmp/extlibs/clipboard_missing.bmp"
int cfText = 1
int cfUnicodeText = 13

file.writeText(filePath, "clipboard file marker")
file.delete(imagePath)

assert clipboard.available(), "clipboard should be available on Windows"
assert clipboard.version() == "clipboard 0.1.0", "clipboard version mismatch"
assert clipboard.snapshot(), "clipboard snapshot failed"
assert cfText == 1, "CF_TEXT mismatch"
assert cfUnicodeText == 13, "CF_UNICODETEXT mismatch"
assert clipboard.format_name(cfUnicodeText) == "CF_UNICODETEXT", "format_name mismatch"
assert clipboard.is_format_available(-1) == false, "negative format should not be available"

assert clipboard.clear(), "clipboard clear failed"
assert clipboard.count_formats() == 0, "clear should remove formats"
assert clipboard.has_text() == false, "text should not be available after clear"
assert clipboard.has_image() == false, "image should not be available after clear"
assert clipboard.has_files() == false, "files should not be available after clear"
var emptyTypes = clipboard.types()
assert emptyTypes.length == 0, "types should be empty after clear"
assert clipboard.types_json() == clipboard.formats_json(), "types_json alias mismatch"

assert clipboard.set_text(sample), "set_text failed"
assert clipboard.has_text(), "has_text failed"
assert clipboard.get_text() == sample, "get_text mismatch"
assert clipboard.read_text() == sample, "read_text alias mismatch"
assert clipboard.write_text(sample + " write"), "write_text failed"
assert clipboard.get_text() == sample + " write", "write_text mismatch"
assert clipboard.count_formats() > 0, "set_text should create formats"
assert string.contains(clipboard.formats_json(), "CF_UNICODETEXT"), "formats_json should include text format"
var textTypes = clipboard.types()
assert textTypes.length > 0, "types should include text format"

assert clipboard.set_file(filePath), "set_file failed"
assert clipboard.has_files(), "has_files failed"
assert clipboard.get_file() == filePath, "get_file mismatch"
var files = clipboard.get_files()
assert files.length == 1, "get_files count mismatch"
assert string(files[0]) == filePath, "get_files path mismatch"
var readFiles = clipboard.read_files()
assert readFiles.length == 1, "read_files count mismatch"
assert string(readFiles[0]) == filePath, "read_files path mismatch"
assert clipboard.set_files([filePath]), "set_files failed"
assert clipboard.get_file() == filePath, "set_files get_file mismatch"
assert clipboard.write_files([filePath]), "write_files failed"
assert clipboard.get_file() == filePath, "write_files get_file mismatch"

assert clipboard.save_image(imagePath) == false, "save_image should fail when clipboard has file data"
assert clipboard.read_image(imagePath) == false, "read_image alias should fail when clipboard has file data"
assert string.contains(clipboard.image_info_json(), "\"available\":false"), "image_info_json no-image mismatch"
assert clipboard.set_image(missingImagePath) == false, "set_image missing file should fail"
assert clipboard.write_image(missingImagePath) == false, "write_image alias should fail"
assert string.len(clipboard.last_error()) > 0, "last_error should report the last image failure"

int customFormat = clipboard.register_format("xlang.demo6.clipboard")
assert customFormat > 0, "register_format failed"
assert clipboard.sequence_number() >= 0, "sequence_number should be non-negative"
assert clipboard.restore(), "clipboard restore failed"
assert clipboard.count_formats() >= 0, "count_formats should remain callable after restore"

println("clipboard extlib ok")
