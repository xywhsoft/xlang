import avro



func main(...) as int
    println("Type(7):       ", avro.typeName(7))
    println("Logical(4):    ", avro.logicalName(4))
    println("Zigzag(-1):    ", avro.zigzagEncode(-1))
    println("Encode(300):   ", avro.encodeLong(300))
    println("Decode round:  ", avro.decodeLong(avro.encodeLong(300)))
    println("String enc:    ", avro.encodeString("hi"))
    println("Magic:         ", avro.magic())
    println("Codec(2):      ", avro.codecName(2))
    println("avro example: PASS")
    return 0
end
