import dns

func main(...) as int
    println("type A: " + dns.typeName(1))
    println("class IN: " + dns.className(1))
    println("rcode 3: " + dns.rcodeName(3))
    println("opcode 5: " + dns.opcodeName(5))
    println("example.com: " + dns.encodeName("example.com"))
    println("valid example.com: " + string(dns.validName("example.com")))
    println("valid bad..name: " + string(dns.validName("bad..name")))
    println("IPv4 127.0.0.1: " + string(dns.isIpv4("127.0.0.1")))
    println("IPv4 invalid: " + string(dns.isIpv4("256.1.1.1")))
    array<string> addresses = dns.resolve("localhost", 4)
    assert addresses.length > 0
    println("localhost IPv4: yes")
    return 0
end
