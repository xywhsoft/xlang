import blas

func main(...) as int
    // BLAS linear algebra

    // Levels
    println("Level 1 = " + blas.level(1))

    // Dot product
    println("[1,2,3].[4,5,6] = " + string.float(blas.dot("1,2,3", "4,5,6")))

    // Norm
    println("||[3,4]|| = " + string.float(blas.nrm2("3,4")))

    // AXPY
    println("2*[1,2]+[10,20] = " + blas.axpy(2.0, "1,2", "10,20"))

    println("blas example: PASS")
    return 0
end
