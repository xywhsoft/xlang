import mail.smtp

assert mail.smtp.available(), "smtp available failed"
assert mail.smtp.version() == "0.1.0", "smtp version failed"
assert mail.smtp.last_error() == "", "smtp last_error failed"

var config = {"host": "", "port": 0, "timeout_ms": 0, "secure": "none", "dry_run": true}
var message = {
    "from": {"email": "sender@example.com", "name": "Sender"},
    "to": [{"email": "user@example.com", "name": "User"}],
    "subject": "hello",
    "text": "plain body",
    "headers": [{"name": "X-Test", "value": "ok"}],
    "attachments": [{"filename": "note.txt", "content_type": "text/plain", "content": "body"}]
}
var request = {"config": config, "message": message, "dsn": {"notify": "failure", "orcpt": "rfc822;user@example.com"}}

var result = mail.smtp.result(true, "", "unit", {"value": 7})
assert bool(result["ok"]) == true, "smtp result ok mismatch"

string capabilityJson = mail.smtp.capability_json(json.stringify(config))
assert string.contains(capabilityJson, "\"ok\":true"), "smtp capability_json failed"
assert string.contains(capabilityJson, "\"stage\":\"dry_run\""), "smtp capability_json stage failed"
assert string.contains(capabilityJson, "\"operation\":\"capability\""), "smtp capability_json operation failed"

var capability = mail.smtp.capability(config)
assert string.contains(json.stringify(capability), "\"ok\":true"), "smtp capability failed"
assert string.contains(json.stringify(capability), "\"EHLO\""), "smtp capability commands failed"

string sendJson = mail.smtp.send_json(json.stringify(request))
assert string.contains(sendJson, "\"ok\":true"), "smtp send_json failed"
assert string.contains(sendJson, "\"operation\":\"send\""), "smtp send_json operation failed"
assert string.contains(sendJson, "\"MAIL FROM\""), "smtp send_json commands failed"

var sent = mail.smtp.send(request)
assert string.contains(json.stringify(sent), "\"ok\":true"), "smtp send failed"
assert string.contains(json.stringify(sent), "\"DATA\""), "smtp send commands failed"

println("mail.smtp extlib ok")
