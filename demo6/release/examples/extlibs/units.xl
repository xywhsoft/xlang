import units



func main(...) as int
    // 文件大小场景
    array<float> sizes = [0.0, 423.0, 1024.0, 91750.0, 1048576.0, 3221225472.0]
    for s in sizes
        println(units.bytes(s), "=", s, "bytes")
    end
    println("disk 500GB in binary:", units.bytes(units.parseBytes("500GB")))

    // 请求耗时场景
    array<float> times = [0.04, 1.8, 62.5, 3725.0, 90061.0]
    for t in times
        println(units.durationShort(t), "(", units.duration(t), ")")
    end
    println("cache ttl 1h30m =", units.parseDuration("1h30m"), "s =", units.duration(units.parseDuration("1h30m")))

    // 指标数字
    array<float> metrics = [986.0, 12000.0, 8900000.0, 4200000000.0]
    for m in metrics
        println("events:", units.count(m))
    end

    println("units example: PASS")
    return 0
end
