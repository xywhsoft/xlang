import units

func main(...) as int
    println("binary:", units.bytes(1536.0))
    println("decimal:", units.bytesDecimal(1500.0))
    println("rounded:", units.bytes(1048575.0))
    println("parsed:", units.parseBytes("1.5MiB"))
    println("duration:", units.duration(3725.0))
    println("short:", units.durationShort(3725.0))
    println("seconds:", units.parseDuration("1h2m5s"))
    println("count:", units.count(1200.0))
    println("rounded count:", units.count(999960.0))
    println("power of two:", units.isPow2(64))
    return 0
end
