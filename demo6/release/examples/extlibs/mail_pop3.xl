import mail.pop3

assert mail.pop3.available(), "pop3 available failed"
assert mail.pop3.version() == "0.1.0", "pop3 version failed"
assert mail.pop3.last_error() == "", "pop3 last_error failed"

var config = {"host": "", "port": 0, "timeout_ms": 0, "secure": "none", "dry_run": true}
var request = {"config": config, "request": {"number": 0, "top": true, "lines": 1, "parse_mime": false}}

var result = mail.pop3.result(true, "", "unit", {"value": 7})
assert bool(result["ok"]) == true, "pop3 result ok mismatch"

string capabilityJson = mail.pop3.capability_json(json.stringify(config))
assert string.contains(capabilityJson, "\"ok\":true"), "pop3 capability_json failed"
assert string.contains(capabilityJson, "\"operation\":\"capability\""), "pop3 capability_json operation failed"
assert string.contains(json.stringify(mail.pop3.capability(config)), "\"CAPA\""), "pop3 capability failed"

string statusJson = mail.pop3.status_json(json.stringify(config))
assert string.contains(statusJson, "\"ok\":true"), "pop3 status_json failed"
assert string.contains(statusJson, "\"operation\":\"status\""), "pop3 status_json operation failed"
assert string.contains(json.stringify(mail.pop3.status(config)), "\"STAT\""), "pop3 status failed"

string listJson = mail.pop3.list_json(json.stringify(config))
assert string.contains(listJson, "\"ok\":true"), "pop3 list_json failed"
assert string.contains(listJson, "\"operation\":\"list\""), "pop3 list_json operation failed"
assert string.contains(json.stringify(mail.pop3.list(config)), "\"LIST\""), "pop3 list failed"

string fetchJson = mail.pop3.fetch_json(json.stringify(request))
assert string.contains(fetchJson, "\"ok\":true"), "pop3 fetch_json failed"
assert string.contains(fetchJson, "\"operation\":\"fetch\""), "pop3 fetch_json operation failed"
assert string.contains(json.stringify(mail.pop3.fetch(request)), "\"RETR\""), "pop3 fetch failed"

string deleteJson = mail.pop3.delete_message_json(json.stringify(request))
assert string.contains(deleteJson, "\"ok\":true"), "pop3 delete_message_json failed"
assert string.contains(deleteJson, "\"operation\":\"delete_message\""), "pop3 delete_message_json operation failed"
assert string.contains(json.stringify(mail.pop3.delete_message(request)), "\"DELE\""), "pop3 delete_message failed"

println("mail.pop3 extlib ok")
