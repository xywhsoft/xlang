import imagehash

string imagePath = "release/examples/extlibs/assets/tiny.png"

assert imagehash.available(), "imagehash available failed"
assert imagehash.version() == "imagehash 0.1.0", "imagehash version mismatch"
string a = imagehash.ahash(imagePath)
string d = imagehash.dhash(imagePath)
string p = imagehash.phash(imagePath)
assert imagehash.valid(a) != 0, "imagehash ahash invalid"
assert imagehash.valid(d) != 0, "imagehash dhash invalid"
assert imagehash.valid(p) != 0, "imagehash phash invalid"
assert imagehash.hamming(a, a) == 0, "imagehash hamming self mismatch"
assert imagehash.hamming(a, d) >= 0, "imagehash hamming cross mismatch"
assert imagehash.valid("not-hash") == 0, "imagehash invalid hash accepted"
assert imagehash.hamming("not-hash", a) == -1, "imagehash invalid hamming should fail"
assert imagehash.last_error() == "invalid hash string", "imagehash diagnostic mismatch"

println("imagehash extlib ok")
