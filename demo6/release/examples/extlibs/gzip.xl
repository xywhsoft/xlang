import gzip



func main(...) as int
    Buffer source = Buffer()
    source.append("xlang gzip ")
    source.appendByte(0)
    source.append("二进制范例")

    // 一次性接口固定返回 Buffer，NUL 和任意字节不会经过字符串转换。
    Buffer packed = gzip.compress(source, 9)
    Buffer plain = gzip.decompress(packed)
    assert plain == source, "gzip Buffer round trip failed"
    assert packed[0] == 31 and packed[1] == 139 and packed[2] == 8

    Buffer timed = gzip.compress("mtime", 6, 16909060)
    assert timed[4] == 4 and timed[5] == 3 and timed[6] == 2 and timed[7] == 1

    Buffer members = Buffer()
    Buffer firstMember = gzip.compress("first")
    Buffer secondMember = gzip.compress("second")
    members.append(firstMember)
    members.append(secondMember)
    assert gzip.decompressText(members) == "firstsecond"

    Buffer truncatedMembers = Buffer()
    truncatedMembers.append(firstMember)
    for i in range(0, secondMember.len() - 1)
        truncatedMembers.appendByte(secondMember[i])
    end
    bool truncatedRejected = false
    try
        gzip.decompress(truncatedMembers)
    catch IOError e
        truncatedRejected = true
    end
    assert truncatedRejected, "truncated final gzip member must be rejected"

    // 未提前 drain 时，finish 取得完整结果；提前 drain 则只取得剩余部分。
    auto encoder = gzip.compressor(6)
    encoder.update("hello ")
    encoder.update("stream")
    Buffer streamPacked = encoder.finish()

    auto decoder = gzip.decompressor()
    decoder.update(streamPacked)
    Buffer streamPlain = decoder.finish()
    assert streamPlain.text() == "hello stream", "gzip incremental round trip failed"

    // 格式错误沿用 XRT 的 IOError，不以空 Buffer 冒充成功。
    bool rejected = false
    streamPacked[streamPacked.len() - 1] = streamPacked[streamPacked.len() - 1] ^ 1
    try
        gzip.decompress(streamPacked)
    catch IOError e
        rejected = true
    end
    assert rejected, "corrupt gzip must raise IOError"

    // 文件便捷接口仍使用 XRT 流式处理，不会把整个文件读入内存。
    string directory = dir.temp("", "xlang-gzip-example-", "")
    string inputPath = path.join(directory, "input.bin")
    string packedPath = path.join(directory, "output.gz")
    string outputPath = path.join(directory, "restored.bin")
    try
        assert file.writeBytes(inputPath, source.toBytes())
        gzip.compressFile(inputPath, packedPath, onProgress = func(int read, int total, int written) as bool
            // true 继续，false 取消；计数均为字节数。
            assert read <= total and written >= 0
            return true
        end)
        gzip.decompressFile(packedPath, outputPath)
        assert file.readBytes(outputPath) == source.toBytes()
    finally
        assert dir.delete(directory), "gzip example temporary directory must be removed"
    end

    println("gzip example: PASS")
    return 0
end
