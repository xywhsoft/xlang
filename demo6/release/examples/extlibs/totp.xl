import totp



func main(...) as int
    string secret = "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ"
    string hotp = totp.hotp(secret, 0)
    string code = totp.generateAt(secret, 59, 30, 8)
    println("HOTP(0):", hotp)
    println("TOTP(59):", code)
    println("valid:", totp.verifyAt(secret, code, 59, 30, 8, 0))
    return 0
end
