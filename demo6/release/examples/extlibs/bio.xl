import bio

func main(...) as int
    // Bioinformatics toolkit

    println("Codon 0 = " + bio.codon(0))
    println("AA 0 = " + bio.aminoAcid(0))
    println("Complement ATGC = " + bio.complement("ATGC"))
    println("Transcribe ATGC = " + bio.transcribe("ATGC"))
    println("Format 0 = " + bio.format(0))

    println("bio example: PASS")
    return 0
end
