import terraform_state

func main(...) as int
    string stateText = """
{
  "version": 4,
  "serial": 7,
  "lineage": "example-lineage",
  "outputs": { "site_url": { "value": "https://example.test" } },
  "resources": [
    { "type": "aws_s3_bucket", "name": "assets", "instances": [ { "attributes": { "id": "assets-bucket" } } ] }
  ]
}
"""
    var state = terraform_state.parse(stateText)

    println("state version: " + string(terraform_state.version(state)))
    println("state serial: " + string(terraform_state.serial(state)))
    for address in terraform_state.addresses(state)
        var attributes = terraform_state.attributes(state, address as string)
        println(string(address) + " -> " + string(attributes["id"]))
    end
    println("site URL: " + string(terraform_state.output(state, "site_url")["value"]))
    println("terraform_state example: PASS")
    return 0
end
