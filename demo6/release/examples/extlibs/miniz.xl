import miniz

class FileProgress
    int calls = 0
    int inputBytes = 0
    int totalBytes = 0
end



func main(...) as int
    // ─── 1. 一次性压缩 / 解压（Buffer 二进制安全）───
    Buffer source = Buffer()
    source.append("xlang miniz ")
    source.appendByte(0)
    source.appendByte(255)

    Buffer packed = miniz.compress(source)
    Buffer plain = miniz.decompress(packed)
    assert plain == source, "miniz Buffer round trip failed"
    for i in range(packed.len() - 8, packed.len())
        assert packed[i] == 0, "miniz member end record must be deterministic"
    end
    println("一次性: ", source.len(), " 字节 -> ", packed.len(), " 字节")

    // 直接压缩字符串（内部自动转 Buffer）。
    Buffer textPacked = miniz.compress("hello miniz")
    assert miniz.decompressText(textPacked) == "hello miniz"
    println("引擎版本: ", miniz.version())

    // ─── 2. 增量流式压缩：update -> drain -> finish ───
    // drain() 随时取走已产出的压缩字节，适合边喂数据边落盘/发送。
    auto encoder = miniz.compressor()
    Buffer streamPacked = Buffer()
    encoder.update("hello ")
    streamPacked.append(encoder.drain())
    encoder.update("stream")
    streamPacked.append(encoder.drain())
    encoder.finish()                 // 封存流（写入成员结束标记）
    streamPacked.append(encoder.drain())
    println("流式压缩: 喂入 ", encoder.inputBytes, " 字节, 产出 ",
        encoder.outputBytes, " 字节")

    // ─── 3. 增量流式解压 + 进度回显 + 多成员统计 ───
    auto decoder = miniz.decompressor()
    Buffer restored = Buffer()
    decoder.update(streamPacked)
    restored.append(decoder.drain()) // 取走已解压数据
    println("解压进度: 已喂入 ", decoder.inputBytes, " / 已产出 ",
        decoder.outputBytes, " 字节, 完成=", decoder.finished)
    decoder.finish()                 // 校验流完整性
    restored.append(decoder.drain())
    assert restored.text() == "hello stream", "miniz incremental round trip failed"

    // 前一成员完整时，不能掩盖后一成员缺失结束记录。
    Buffer chainedTruncated = Buffer()
    chainedTruncated.append(packed)
    for i in range(0, streamPacked.len() - 12)
        chainedTruncated.appendByte(streamPacked[i])
    end
    bool truncatedRejected = false
    try
        miniz.decompress(chainedTruncated)
    catch CompressionError e
        truncatedRejected = true
    end
    assert truncatedRejected, "truncated final miniz member must be rejected"
    println("成员数: ", decoder.members) // 1；>1 表示串联多成员流

    // ─── 4. 压缩级别调优（0..10，越高压缩率越高但越慢）───
    auto tuned = miniz.compressor(miniz.MINIZ_MAX_LEVEL)
    tuned.update("tune me")
    tuned.finish()
    assert miniz.decompress(tuned.drain()).text() == "tune me"
    println("最高级别 L10 流式往返: OK")

    // ─── 5. 损坏数据必然抛出 CompressionError（块体安全校验生效）───
    bool rejected = false
    int mid = streamPacked.len() / 2
    streamPacked[mid] = streamPacked[mid] ^ 255
    try
        miniz.decompress(streamPacked)
    catch CompressionError e
        rejected = true
    end
    assert rejected, "corrupt miniz must raise CompressionError"
    println("损坏检出: OK")

    // ─── 6. 文件便捷接口（XRT reader/writer，临时文件+原子重命名）───
    dir.createAll("tmp")
    file.writeBytes("tmp/miniz_example_source.bin", source)
    FileProgress progress = FileProgress()
    miniz.compressFile("tmp/miniz_example_source.bin", "tmp/miniz_example.miniz",
        onProgress = func(int inputBytes, int totalBytes, int outputBytes) as bool
            progress.calls += 1
            progress.inputBytes = inputBytes
            progress.totalBytes = totalBytes
            return true
        end)
    assert progress.calls > 0
    assert progress.inputBytes == source.len()
    assert progress.totalBytes == source.len()
    miniz.decompressFile("tmp/miniz_example.miniz", "tmp/miniz_example_plain.bin")
    assert file.readBytes("tmp/miniz_example_plain.bin") == source
    file.delete("tmp/miniz_example_source.bin")
    file.delete("tmp/miniz_example.miniz")
    file.delete("tmp/miniz_example_plain.bin")

    println("miniz example: PASS")
    return 0
end
