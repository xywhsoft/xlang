import archive



func main(...) as int
    println("Format(1):     ", archive.formatName(1))
    println("Detect(gzip):  ", archive.detect("1f8b08000000"))
    println("Detect(zip):   ", archive.detect("504b03041400"))
    println("TarType(48):   ", archive.tarType(48))
    println("TarSize:       ", archive.tarParseSize("0000000144"))
    println("ZipMethod(8):  ", archive.zipMethod(8))
    println("Ratio(50,200): ", archive.ratio(50, 200))
    println("archive example: PASS")
    return 0
end
