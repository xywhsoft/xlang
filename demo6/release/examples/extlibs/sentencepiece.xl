import sentencepiece

func main(...) as int
    // SentencePiece tokenizer

    println("Model 0 = " + sentencepiece.modelType(0))
    println("Encode = " + sentencepiece.encode("hello world"))
    println("Pieces = " + string.fromInt(sentencepiece.countPieces("hello world")))

    println("sentencepiece example: PASS")
    return 0
end
