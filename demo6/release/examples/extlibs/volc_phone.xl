import volc.phone

// 离线范例只解析固定响应和生成签名预览，不发送请求。
string body = volc.phone.product_body("prod-1")
assert json.parse(body)["ProductId"] == "prod-1"
assert json.parse(volc.phone.pod_body("prod-1", "pod-1"))["PodId"] == "pod-1"
assert json.parse(volc.phone.command_body("prod-1", "pod-1", "echo 你好"))["Command"] == "echo 你好"
assert json.parse(volc.phone.create_pod_body("prod-1", "dc-a", "small", 1, "host-1", "pod-name", "layout-1", true))["Start"] == true

string success = `{"ResponseMetadata":{"RequestId":"req-1","Action":"DetailPod"},"Result":{"PodId":"pod-1","Online":1,"AdbStatus":1,"Adb":"127.0.0.1:5555","PodNumAvailable":8,"PodNumOnHost":3,"DownloadUrl":"https://example.test/r.mp4"}}`
string failure = `{"ResponseMetadata":{"RequestId":"req-2","Error":{"Code":"BadRequest","CodeN":400,"Message":"bad request"}}}`
volc.phone.Response ok = volc.phone.parse_response("DetailPod", success, 200)
volc.phone.Response bad = volc.phone.parse_response("DetailPod", failure, 400)
assert ok.ok() and ok.request_id() == "req-1"
assert not bad.ok() and bad.code() == "BadRequest" and bad.code_n() == 400
assert json.parse(ok.result_json())["PodId"] == "pod-1"
assert json.parse(volc.phone.response_json("DetailPod", success, 200))["ok"] == true
assert volc.phone.json_int_field(success, "Online") == 1
assert volc.phone.task_state(`{"ResponseMetadata":{"RequestId":"req-3"},"Result":{"TaskResult":100}}`) == "success"
assert volc.phone.recording_download_url(success) == "https://example.test/r.mp4"
assert volc.phone.pod_adb_endpoint(success) == "127.0.0.1:5555"
assert volc.phone.host_remain_text(success) == "3,5"

// 定型预览直接传参；逐行 spec 仅用于调用方明确选择的接口。
string preview = volc.phone.preview_call("AKID", "SECRET", "", "ListPod", "2023-10-30", body, "20240102T030405Z")
assert string.contains(preview, "\"authorization\"")
string spec = "action=ListPod\nversion=2023-10-30\naccess_key=AKID\nsecret_key=SECRET\nsession_token=\nbody=" + body + "\nx_date=20240102T030405Z\n"
assert string.contains(volc.phone.preview_spec(spec), "\"authorization\"")

println("volc.phone offline example: ok")
