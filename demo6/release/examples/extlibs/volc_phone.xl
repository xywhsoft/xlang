	string launched = volc.phone.launch_app("ak", "sk", "token", "prod-1", "pod-1", "com.example", 1)
	string closed = volc.phone.close_app("ak", "sk", "token", "prod-1", "pod-1", "com.example", 1)
	string shot = volc.phone.screenshot("ak", "sk", "token", "prod-1", "pod-1", "round-1", 1)
	string batchShot = volc.phone.batch_screenshot("ak", "sk", "token", "prod-1", "[\"pod-1\"]", "round-1", 1)
	string recordingStart = volc.phone.start_recording("ak", "sk", "token", "prod-1", "pod-1", "round-1", 30, true, 1)
	string recordingStop = volc.phone.stop_recording("ak", "sk", "token", "prod-1", "pod-1", 1)
	string pushed = volc.phone.push_file("ak", "sk", "token", "prod-1", "pod-1", "local.txt", "/sdcard/local.txt", 1)
	string pulled = volc.phone.pull_file("ak", "sk", "token", "prod-1", "pod-1", "/sdcard/remote.txt", "remote.txt", 1)
	auto clientResponse = phoneClient.call("ListPod", "2023-10-30", productBody)
	auto clientDefault = phoneClient.call_default("ListPod", productBody)
	auto clientListPods = phoneClient.list_pods()
	auto clientListHosts = phoneClient.list_hosts()
	auto clientListDcs = phoneClient.list_dcs()
	auto clientDetailPod = phoneClient.detail_pod("pod-1")
	auto clientDetailHost = phoneClient.detail_host("host-1")
	auto clientCreatePod = phoneClient.create_pod("dc-a", "small", 1, "host-1", "pod-name", "layout-1", true)
	auto clientCreatePodBatch = phoneClient.create_pod_batch("dc-a", "small", 2, 1, "host-1", "pod-name", "layout-1", false)
