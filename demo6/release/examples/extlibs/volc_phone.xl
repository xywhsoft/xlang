	string powerOff = volc.phone.power_off("ak", "sk", "token", "prod-1", "pod-1", 1)
	string reboot = volc.phone.reboot("ak", "sk", "token", "prod-1", "pod-1", 1)
	string reset = volc.phone.reset("ak", "sk", "token", "prod-1", "pod-1", 1)
	string deletePod = volc.phone.delete_pod("ak", "sk", "token", "prod-1", "pod-1", 1)
