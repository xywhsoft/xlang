import protobuf

func main(...) as int
    println("Wire 0 = " + protobuf.wireType(0))
    println("Varint size 300 = " + string.int(protobuf.varintSize(300)))
    println("Tag(1,0) = " + string.int(protobuf.tag(1, 0)))
    println("Field# from 18 = " + string.int(protobuf.fieldNumber(18)))
    println("Type 3 = " + protobuf.typeName(3))

    println("protobuf example: PASS")
    return 0
end
