import pinyin



func main(...) as int
    // 中国人民 = zhong guo ren min
    string text = "\xE4\xB8\xAD\xE5\x9B\xBD\xE4\xBA\xBA\xE6\xB0\x91"
    println("pinyin:", pinyin.convert(text))
    println("initials:", pinyin.initials(text))

    // 你好世界 = ni hao shi jie
    string hello = "\xE4\xBD\xA0\xE5\xA5\xBD\xE4\xB8\x96\xE7\x95\x8C"
    println("pinyin:", pinyin.convert(hello))
    println("initials:", pinyin.initials(hello))

    println("pinyin example: PASS")
    return 0
end
