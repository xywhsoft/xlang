import jwt



func main(...) as int
    // Create a JWT token
    auto payload = "{\"sub\":\"user42\",\"role\":\"admin\",\"iat\":1700000000}"
    auto secret = "super-secret-key"

    auto token = jwt.encode(payload, secret)
    println("token: ", token)

    // Decode payload
    println("payload: ", jwt.decode(token))

    // Read header
    println("header: ", jwt.header(token))

    // Verify signature
    println("verify (correct): ", jwt.verify(token, secret))
    println("verify (wrong):   ", jwt.verify(token, "bad-key"))

    println("jwt example: PASS")
    return 0
end
