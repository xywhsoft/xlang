func main(...) as int
    Stack<int> stack = Stack::<int>()
    stack.push(10)
    stack.push(20)
    int value = stack.pop()
    assert(value == 20)
    println("stack=ok")

    OrderedMap<string, int> tree = OrderedMap::<string, int>()
    tree.set("b", 2)
    tree.set("a", 1)
    array<string> keys = tree.keys()
    assert(keys.length == 2 and keys[0] == "a" and keys[1] == "b")
    println("ordered_map=ok")

    SpscQueue<int> spsc = SpscQueue::<int>(4)
    assert(spsc.tryPush(1) == queueStatus.ok)
    auto spscStatus, spscValue = spsc.tryPop()
    assert(spscStatus == queueStatus.ok and spscValue != null and spscValue == 1)
    println("spsc=ok")

    MpscQueue<int> mpsc = MpscQueue::<int>(4)
    assert(mpsc.tryPush(2) == queueStatus.ok)
    auto mpscStatus, mpscValue = mpsc.tryPop()
    assert(mpscStatus == queueStatus.ok and mpscValue != null and mpscValue == 2)
    println("mpsc=ok")

    Queue<string> queue = Queue::<string>(8)
    assert(queue.tryPush("hello") == queueStatus.ok)
    auto status, text = queue.tryPop()
    assert(status == queueStatus.ok and text != null and text == "hello")
    println("mpmc=ok")

    WaitQueue<int> waits = WaitQueue::<int>(4)
    assert(not waits.popTimeoutInto(value, 1))
    assert(waits.tryPush(42) and waits.popInto(value) and value == 42)
    println("wait_queue=ok")
    return 0
end
