assert conditionalStringRace == "hello conditional race string", "task.race conditional string borrowed branch"
assert await conditionalStringRaceSource == "hello conditional race string", "task.race conditional string source remains awaitable"

future<TaskBox> conditionalBoxAllSource = makeTaskBox(810)
bool chooseConditionalBoxAll = true
future<array<TaskBox>> conditionalBoxAllFuture = task.all([
    chooseConditionalBoxAll ? conditionalBoxAllSource : makeTaskBox(820),
    false ? conditionalBoxAllSource : makeTaskBox(830)
])
array<TaskBox> conditionalBoxAll = await conditionalBoxAllFuture
TaskBox conditionalBoxAllA = conditionalBoxAll[0]
TaskBox conditionalBoxAllB = conditionalBoxAll[1]
assert conditionalBoxAllA.add(1) == 811, "task.all conditional class borrowed branch"
assert conditionalBoxAllB.add(2) == 832, "task.all conditional class owned branch"
TaskBox conditionalBoxAllAgain = await conditionalBoxAllSource
assert conditionalBoxAllAgain.add(3) == 813, "task.all conditional class source remains awaitable"

future<TaskBox> conditionalBoxRaceSource = makeTaskBox(840)
bool chooseConditionalBoxRace = true
future<TaskBox> conditionalBoxRaceFuture = task.race([chooseConditionalBoxRace ? conditionalBoxRaceSource : makeTaskBox(850)])
TaskBox conditionalBoxRace = await conditionalBoxRaceFuture
assert conditionalBoxRace.add(1) == 841, "task.race conditional class borrowed branch"
TaskBox conditionalBoxRaceAgain = await conditionalBoxRaceSource
assert conditionalBoxRaceAgain.add(2) == 842, "task.race conditional class source remains awaitable"

future<func(int) as int> conditionalFuncAllSource = makeTaskAdder(860)
bool chooseConditionalFuncAll = true
array<func(int) as int> conditionalFuncAll = await task.all([
    chooseConditionalFuncAll ? conditionalFuncAllSource : makeTaskAdder(870),
    false ? conditionalFuncAllSource : makeTaskAdder(880)
])
func(int) as int conditionalFuncAllA = conditionalFuncAll[0]
func(int) as int conditionalFuncAllB = conditionalFuncAll[1]
assert conditionalFuncAllA(1) == 861, "task.all conditional function borrowed branch"
assert conditionalFuncAllB(2) == 882, "task.all conditional function owned branch"
func(int) as int conditionalFuncAllAgain = await conditionalFuncAllSource
assert conditionalFuncAllAgain(3) == 863, "task.all conditional function source remains awaitable"

future<func(int) as int> conditionalFuncRaceSource = makeTaskAdder(890)
bool chooseConditionalFuncRace = true
func(int) as int conditionalFuncRace = await task.race([chooseConditionalFuncRace ? conditionalFuncRaceSource : makeTaskAdder(900)])
assert conditionalFuncRace(1) == 891, "task.race conditional function borrowed branch"
func(int) as int conditionalFuncRaceAgain = await conditionalFuncRaceSource
assert conditionalFuncRaceAgain(2) == 892, "task.race conditional function source remains awaitable"

future<int> nestedRaceLeft = task.race([addAsync(910, 1)])
future<int> nestedRaceRight = task.race([addAsync(920, 2)])
array<int> nestedRaceAll = await task.all([nestedRaceLeft, nestedRaceRight])
assert nestedRaceAll[0] == 911, "task.all over nested task.race first value"
assert nestedRaceAll[1] == 922, "task.all over nested task.race second value"
assert await nestedRaceLeft == 911, "nested task.race source remains awaitable after task.all"
assert await nestedRaceRight == 922, "nested task.race source remains awaitable after task.all"

future<int> nestedRaceFast = task.race([addAsync(930, 3)])
future<int> nestedRaceSlow = task.race([slowRaceAsync(940)])
future<int> nestedRaceGroup = task.race([nestedRaceFast, nestedRaceSlow])
int nestedRaceWinner = await nestedRaceGroup
assert nestedRaceWinner == 933, "task.race over nested task.race winner"
assert await nestedRaceGroup == 933, "nested task.race group repeated await"
assert not task.cancel(nestedRaceGroup), "completed nested task.race group cancel result"
assert await nestedRaceFast == 933, "nested task.race fast source remains awaitable"

int nestedRaceSlowState = 0
try
    int nestedRaceSlowValue = await nestedRaceSlow
    nestedRaceSlowState = nestedRaceSlowValue
catch e
    if e.message == "future cancel requested." then
        nestedRaceSlowState = 1
    end
end
assert nestedRaceSlowState == 1, "nested task.race should cancel pending nested loser"

time.sleep(180)

int nestedRaceSlowStillCanceled = 0
try
    int nestedRaceSlowLateValue = await nestedRaceSlow
    nestedRaceSlowStillCanceled = nestedRaceSlowLateValue
catch e
    if e.message == "future cancel requested." then
        nestedRaceSlowStillCanceled = 1
    end
end
assert nestedRaceSlowStillCanceled == 1, "nested task.race loser should stay canceled"

println("task api ok")
