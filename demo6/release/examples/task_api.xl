func(int) as int typedConditionalFuncAgain = await typedConditionalFuncSource
assert typedConditionalFuncAgain(2) == 810, "typed task.race conditional function source remains awaitable"

future<string> conditionalStringAllSource = greetAsync("conditional all string")
bool chooseConditionalStringAll = true
array<string> conditionalStringAll = await task.all([
    chooseConditionalStringAll ? conditionalStringAllSource : greetAsync("conditional all string borrowed alt"),
    false ? conditionalStringAllSource : greetAsync("conditional all string owned")
])
assert conditionalStringAll[0] == "hello conditional all string", "task.all conditional string borrowed branch"
assert conditionalStringAll[1] == "hello conditional all string owned", "task.all conditional string owned branch"
assert await conditionalStringAllSource == "hello conditional all string", "task.all conditional string source remains awaitable"

future<string> conditionalStringRaceSource = greetAsync("conditional race string")
