func() as int throwingJob = failJob
int spawnErrorState = 0
try
    int failedSpawned = await task.spawn(throwingJob)
    spawnErrorState = failedSpawned
catch e
    if e.message == "task spawn boom" then
        spawnErrorState = 1
    end
end
assert spawnErrorState == 1, "task.spawn error propagation"

future<int> repeatedFailedSpawn = task.spawn(throwingJob)
int repeatedSpawnErrorA = 0
try
    int repeatedA = await repeatedFailedSpawn
    repeatedSpawnErrorA = repeatedA
catch e
    if e.message == "task spawn boom" then
        repeatedSpawnErrorA = 1
    end
end
assert repeatedSpawnErrorA == 1, "task.spawn failed future first await"

int repeatedSpawnErrorB = 0
try
    int repeatedB = await repeatedFailedSpawn
    repeatedSpawnErrorB = repeatedB
catch e
    if e.message == "task spawn boom" then
        repeatedSpawnErrorB = 1
    end
end
assert repeatedSpawnErrorB == 1, "task.spawn failed future repeated await"

assert not task.cancel(repeatedFailedSpawn), "task.spawn failed future cancel result"
int postCancelFailedSpawnError = 0
try
    int postCancelFailedSpawn = await repeatedFailedSpawn
    postCancelFailedSpawnError = postCancelFailedSpawn
catch e
    if e.message == "task spawn boom" then
        postCancelFailedSpawnError = 1
    end
end
assert postCancelFailedSpawnError == 1, "task.spawn failed future should keep error after cancel"

future<int> spawnAllFailureSlowSource = task.spawn(slowAddJob, 900, 9)
future<array<int>> spawnAllFailureGroup = task.all([task.spawn(throwingJob), spawnAllFailureSlowSource])
int spawnAllFailureGroupState = 0
try
    array<int> spawnAllFailureValues = await spawnAllFailureGroup
    spawnAllFailureGroupState = spawnAllFailureValues.length
catch e
    if e.message == "task spawn boom" then
        spawnAllFailureGroupState = 1
    end
end
assert spawnAllFailureGroupState == 1, "task.all over task.spawn should report fast failure"
int spawnAllFailureSlowValue = await spawnAllFailureSlowSource
assert spawnAllFailureSlowValue == 909, "task.all task.spawn failure should keep slow source awaitable"

future<int> typedSpawnAllFailureSlowSource = task.spawn(slowAddJob, 920, 9)
array<future<int>> typedSpawnAllFailureJobs = array[task.spawn(throwingJob), typedSpawnAllFailureSlowSource]
