async func failAsync() as int
    throw "task boom"
    return 0
end

async func slowFailAsync() as int
    time.sleep(120)
    throw "task boom"
    return 0
end

async func failStringAsync() as string
    throw "task string boom"
    return ""
end

async func failBoolAsync() as bool
    throw "task bool boom"
    return false
end

async func failFloatAsync() as float
    throw "task float boom"
    return 0.0
end

async func failTaskBoxAsync() as TaskBox
    throw "task class boom"
    TaskBox box
    return box
end

async func failTaskAdderAsync() as func(int) as int
    throw "task function boom"
    return makeAdder(0)
end

int errorState = 0
try
    array<int> failed = await task.all([failAsync()])
    errorState = failed.length
catch e
    if e.message == "task boom" then
        errorState = 1
    end
end

assert errorState == 1, "task error propagation"

