bool spawnBoolRace = await task.race([task.spawn(flipJob, true)])
assert spawnBoolRace == false, "task.race bool task.spawn result"

array<future<bool>> spawnBoolAllJobs = array[task.spawn(flipJob, true), task.spawn(flipJob, false)]
array<bool> spawnBoolTypedAll = await task.all(spawnBoolAllJobs)
assert spawnBoolTypedAll.length == 2, "task.all typed bool task.spawn count"
assert spawnBoolTypedAll[0] == false, "task.all typed bool task.spawn first"
assert spawnBoolTypedAll[1] == true, "task.all typed bool task.spawn second"

array<future<bool>> spawnBoolRaceJobs = array[task.spawn(flipJob, true)]
bool spawnBoolTypedRace = await task.race(spawnBoolRaceJobs)
assert spawnBoolTypedRace == false, "task.race typed bool task.spawn result"

array<future<bool>> spawnBoolAllCompletedJobs = array[task.spawn(flipJob, true), task.spawn(flipJob, false)]
future<array<bool>> spawnBoolAllCompletedFuture = task.all(spawnBoolAllCompletedJobs)
array<bool> spawnBoolAllCompletedA = await spawnBoolAllCompletedFuture
array<bool> spawnBoolAllCompletedB = await spawnBoolAllCompletedFuture
assert spawnBoolAllCompletedA[0] == false, "typed bool task.spawn task.all first await"
assert spawnBoolAllCompletedB[1] == true, "typed bool task.spawn task.all repeated await"
assert not task.cancel(spawnBoolAllCompletedFuture), "typed bool task.spawn task.all completed cancel"
array<bool> postCancelSpawnBoolAllCompleted = await spawnBoolAllCompletedFuture
assert postCancelSpawnBoolAllCompleted[1] == true, "typed bool task.spawn task.all post-cancel await"

array<future<bool>> spawnBoolRaceCompletedJobs = array[task.spawn(flipJob, true)]
future<bool> spawnBoolRaceCompletedFuture = task.race(spawnBoolRaceCompletedJobs)
bool spawnBoolRaceCompletedA = await spawnBoolRaceCompletedFuture
bool spawnBoolRaceCompletedB = await spawnBoolRaceCompletedFuture
assert spawnBoolRaceCompletedA == false, "typed bool task.spawn task.race first await"
assert spawnBoolRaceCompletedB == false, "typed bool task.spawn task.race repeated await"
assert not task.cancel(spawnBoolRaceCompletedFuture), "typed bool task.spawn task.race completed cancel"
bool postCancelSpawnBoolRaceCompleted = await spawnBoolRaceCompletedFuture
assert postCancelSpawnBoolRaceCompleted == false, "typed bool task.spawn task.race post-cancel await"

array<future<bool>> cancelSpawnBoolAllJobs = array[task.spawn(flipJob, true), task.spawn(flipJob, false)]
bool cancelSpawnBoolTypedAll = task.cancel(task.all(cancelSpawnBoolAllJobs))
assert cancelSpawnBoolTypedAll == true or cancelSpawnBoolTypedAll == false, "task.cancel typed bool task.all task.spawn"

array<future<bool>> cancelSpawnBoolRaceJobs = array[task.spawn(flipJob, true)]
bool cancelSpawnBoolTypedRace = task.cancel(task.race(cancelSpawnBoolRaceJobs))
assert cancelSpawnBoolTypedRace == true or cancelSpawnBoolTypedRace == false, "task.cancel typed bool task.race task.spawn"

