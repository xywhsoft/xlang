async func addAsync(int a, int b) as int
    return a + b
end

async func greetAsync(string name) as string
    return "hello " + name
end

async func slowGreetAsync(string name) as string
    time.sleep(120)
    return "hello " + name
end

async func slowFlipAsync(bool flag) as bool
    time.sleep(120)
    return not flag
end

async func slowHalfAsync(float value) as float
    time.sleep(120)
    return value + 0.5
end

async func flipAsync(bool flag) as bool
    return not flag
end

async func addHalfAsync(float value) as float
    return value + 0.5
end

async func fastRaceAsync(int value) as int
    return value
end

async func slowRaceAsync(int value) as int
    time.sleep(120)
    return value
end

class TaskBox
    int base

    func add(int value) as int
        return self.base + value
    end
end

async func makeTaskBox(int base) as TaskBox
    TaskBox box
    box.base = base
    return box
end

async func slowMakeTaskBox(int base) as TaskBox
    time.sleep(120)
    TaskBox box
    box.base = base
    return box
end

func greet(string name) as string
    return "hello " + name
end

func slowGreet(string name) as string
    time.sleep(120)
    return "hello " + name
end

func flip(bool flag) as bool
    return not flag
end

func slowFlip(bool flag) as bool
    time.sleep(120)
    return not flag
end

func addHalf(float value) as float
    return value + 0.5
end

func slowAddHalf(float value) as float
    time.sleep(120)
    return value + 0.5
end

func add(int a, int b) as int
    return a + b
end

func slowAdd(int a, int b) as int
    time.sleep(120)
    return a + b
end

func addDefault(int a, int b = 1) as int
    return a + b
end

func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

func makeSleepyAdder(int base) as func(int) as int
    return func(int delay) as int
        time.sleep(delay)
        return base + delay
    end
end

class TaskFuncBox
    func(int) as int op
end

async func slowMakeTaskAdder(int base) as func(int) as int
    time.sleep(120)
    return makeAdder(base)
end

async func makeTaskAdder(int base) as func(int) as int
    return makeAdder(base)
end

func fortyTwo() as int
    return 42
end

func sumVariadic(int base, ...) as int
    int total = base
    int i = 0
    while i < arg.length do
        total = total + int(arg[i])
        i = i + 1
    end
    return total
end

func slowSumVariadic(int base, ...) as int
    time.sleep(120)
    int total = base
    int i = 0
    while i < arg.length do
        total = total + int(arg[i])
        i = i + 1
    end
    return total
end

func totalDefault(int base = 5, ...) as int
    return base + arg.length
end

func slowTotalDefault(int base = 5, ...) as int
    time.sleep(120)
    return base + arg.length
end

func addVar(var value) as int
    return int(value) + 1
end

func scoreSpawnResult(int value) as int
    return value + 1
end

func combineSpawnResult(int left, int right) as int
    return left + right
end

func pairSpawnResult(int left, int right) as (int, int)
    return left, right
end

func describeSpawnValue(var value) as string
    return "dynamic " + string(value)
end

func makeSpawnValue(int value) as var
    return value
end

async func makeTypedDynamicSpawnAllValues(func(var) as int job) as array<int>
    return array[
        await task.spawn(job, true ? makeSpawnValue(101) : makeSpawnValue(0)),
        await task.spawn(job, makeSpawnValue(30) + makeSpawnValue(11))
    ]
end

async func makeTypedDynamicSpawnAwaitValues(func(var) as int job, var fallback) as array<int>
    return array[
        await task.spawn(job, fallback ?? makeSpawnValue(41))
    ]
end

func makeDynamicSpawnArray(int value) as array<int>
    return array[value, value + 1]
end

func makeDynamicSpawnGenerator(int value) as generator<int>
    yield value
    yield value + 1
end

func spawnCancelReturnDynamic(func(var) as int job) as bool
    return task.cancel(task.spawn(job, true ? makeSpawnValue(61) : makeSpawnValue(0)))
end

func dynamicSpawnStream() as async generator<int>
    func(var) as int job = addVar
    yield await task.spawn(job, true ? makeSpawnValue(231) : makeSpawnValue(0))
    yield await task.spawn(job, makeSpawnValue(80) + makeSpawnValue(1))
end

func scoreVarString(var value) as int
    if string(value) == "spawn" then
        return 42
    end
    return 0
end

func failJob() as int
    throw "task spawn boom"
    return 0
end

func failStringJob() as string
    throw "task spawn string boom"
    return ""
end

func failBoolJob() as bool
    throw "task spawn bool boom"
    return false
end

func failFloatJob() as float
    throw "task spawn float boom"
    return 0.0
end

func markVoidJob()
    int local = 1
    assert local == 1, "task.spawn void body"
end

func slowVoidJob()
    time.sleep(120)
    int local = 2
    assert local == 2, "task.spawn slow void body"
end

func failVoidJob()
    throw "task spawn void boom"
end

func() as int zeroJob = fortyTwo
int zeroSpawned = await task.spawn(zeroJob)
assert zeroSpawned == 42, "task.spawn zero-argument result"

func() voidJob = markVoidJob
future<null> voidSpawnFuture = task.spawn(voidJob)
await voidSpawnFuture
await voidSpawnFuture
assert not task.cancel(voidSpawnFuture), "completed void task.spawn future cancel result"
await voidSpawnFuture

future<null> voidAllFuture = task.all([task.spawn(voidJob), task.spawn(voidJob)])
await voidAllFuture
await voidAllFuture
assert not task.cancel(voidAllFuture), "completed void task.all future cancel result"
await voidAllFuture

future<null> voidRaceFuture = task.race([task.spawn(voidJob), task.spawn(voidJob)])
await voidRaceFuture
await voidRaceFuture
assert not task.cancel(voidRaceFuture), "completed void task.race future cancel result"
await voidRaceFuture

future<null> conditionalVoidSource = task.spawn(voidJob)
await conditionalVoidSource
bool chooseConditionalVoid = true
assert not task.cancel(chooseConditionalVoid ? conditionalVoidSource : task.spawn(voidJob)), "conditional void borrowed future cancel result"
await conditionalVoidSource
chooseConditionalVoid = false
bool conditionalVoidOwnedCancel = task.cancel(chooseConditionalVoid ? conditionalVoidSource : task.spawn(voidJob))
assert conditionalVoidOwnedCancel == true or conditionalVoidOwnedCancel == false, "conditional void owned future cancel result"
await conditionalVoidSource

future<null> conditionalVoidAllSource = task.spawn(voidJob)
bool chooseConditionalVoidAll = true
await task.all([chooseConditionalVoidAll ? conditionalVoidAllSource : task.spawn(voidJob)])
await conditionalVoidAllSource

future<null> conditionalVoidRaceSource = task.spawn(voidJob)
bool chooseConditionalVoidRace = true
await task.race([chooseConditionalVoidRace ? conditionalVoidRaceSource : task.spawn(voidJob)])
await conditionalVoidRaceSource

future<null> typedConditionalVoidAllSource = task.spawn(voidJob)
bool chooseTypedConditionalVoidAll = true
array<future<null>> typedConditionalVoidAllJobs = array[
    chooseTypedConditionalVoidAll ? typedConditionalVoidAllSource : task.spawn(voidJob),
    false ? typedConditionalVoidAllSource : task.spawn(voidJob)
]
future<null> typedConditionalVoidAllFuture = task.all(typedConditionalVoidAllJobs)
await typedConditionalVoidAllFuture
await typedConditionalVoidAllFuture
await typedConditionalVoidAllSource

future<null> typedConditionalVoidRaceSource = task.spawn(voidJob)
bool chooseTypedConditionalVoidRace = true
array<future<null>> typedConditionalVoidRaceJobs = array[
    chooseTypedConditionalVoidRace ? typedConditionalVoidRaceSource : task.spawn(voidJob)
]
future<null> typedConditionalVoidRaceFuture = task.race(typedConditionalVoidRaceJobs)
await typedConditionalVoidRaceFuture
await typedConditionalVoidRaceFuture
await typedConditionalVoidRaceSource

array<future<null>> typedVoidAllJobs = array[task.spawn(voidJob), task.spawn(voidJob)]
future<null> typedVoidAllFuture = task.all(typedVoidAllJobs)
await typedVoidAllFuture
await typedVoidAllFuture

array<future<null>> typedVoidRaceJobs = array[task.spawn(voidJob)]
future<null> typedVoidRaceFuture = task.race(typedVoidRaceJobs)
await typedVoidRaceFuture
await typedVoidRaceFuture

array<future<null>> emptyVoidJobs = array[]

int emptyVoidAllState = 0
try
    await task.all(emptyVoidJobs)
    emptyVoidAllState = 9
catch e
    if e.message == "task.all requires a non-empty future array" then
        emptyVoidAllState = 1
    end
end
assert emptyVoidAllState == 1, "empty void task.all should report non-empty requirement"

int emptyVoidRaceState = 0
try
    await task.race(emptyVoidJobs)
    emptyVoidRaceState = 9
catch e
    if e.message == "task.race requires a non-empty future array" then
        emptyVoidRaceState = 1
    end
end
assert emptyVoidRaceState == 1, "empty void task.race should report non-empty requirement"

array<future<null>> defaultVoidJobs

int defaultVoidAllState = 0
try
    await task.all(defaultVoidJobs)
    defaultVoidAllState = 9
catch e
    if e.message == "task.all requires a non-empty future array" then
        defaultVoidAllState = 1
    end
end
assert defaultVoidAllState == 1, "default void task.all should report non-empty requirement"

int defaultVoidRaceState = 0
try
    await task.race(defaultVoidJobs)
    defaultVoidRaceState = 9
catch e
    if e.message == "task.race requires a non-empty future array" then
        defaultVoidRaceState = 1
    end
end
assert defaultVoidRaceState == 1, "default void task.race should report non-empty requirement"

func() slowVoidTask = slowVoidJob
future<null> pendingVoidSpawnFuture = task.spawn(slowVoidTask)
assert task.cancel(pendingVoidSpawnFuture), "pending void task.spawn cancel result"

int pendingVoidSpawnState = 0
try
    await pendingVoidSpawnFuture
    pendingVoidSpawnState = 9
catch e
    if e.message == "future cancel requested." then
        pendingVoidSpawnState = 1
    end
end
assert pendingVoidSpawnState == 1, "pending void task.spawn should await as canceled"

time.sleep(180)

int pendingVoidSpawnStillCanceled = 0
try
    await pendingVoidSpawnFuture
    pendingVoidSpawnStillCanceled = 9
catch e
    if e.message == "future cancel requested." then
        pendingVoidSpawnStillCanceled = 1
    end
end
assert pendingVoidSpawnStillCanceled == 1, "pending void task.spawn late completion should not overwrite cancel"

func() throwingVoidJob = failVoidJob
future<null> failedVoidSpawnFuture = task.spawn(throwingVoidJob)
int failedVoidSpawnState = 0
try
    await failedVoidSpawnFuture
    failedVoidSpawnState = 9
catch e
    if e.message == "task spawn void boom" then
        failedVoidSpawnState = 1
    end
end
assert failedVoidSpawnState == 1, "task.spawn void failed future first await"
assert not task.cancel(failedVoidSpawnFuture), "failed void task.spawn future cancel result"
try
    await failedVoidSpawnFuture
    failedVoidSpawnState = 9
catch e
    if e.message == "task spawn void boom" then
        failedVoidSpawnState = 2
    end
end
assert failedVoidSpawnState == 2, "failed void task.spawn future should keep error after cancel"

future<null> failedVoidAllFuture = task.all([task.spawn(throwingVoidJob)])
int failedVoidAllState = 0
try
    await failedVoidAllFuture
    failedVoidAllState = 9
catch e
    if e.message == "task spawn void boom" then
        failedVoidAllState = 1
    end
end
assert failedVoidAllState == 1, "task.all should propagate void task.spawn error"

future<null> failedVoidRaceFuture = task.race([task.spawn(throwingVoidJob)])
int failedVoidRaceState = 0
try
    await failedVoidRaceFuture
    failedVoidRaceState = 9
catch e
    if e.message == "task spawn void boom" then
        failedVoidRaceState = 1
    end
end
assert failedVoidRaceState == 1, "task.race should propagate void task.spawn error"

func(int, int) as int addJob = add
int spawned = await task.spawn(addJob, 20, 22)
assert spawned == 42, "task.spawn result"
future<int> namedSpawnFuture = task.spawn(addJob, 21, 21)
int namedSpawnA = await namedSpawnFuture
int namedSpawnB = await namedSpawnFuture
assert namedSpawnA == 42, "task.spawn int future first await"
assert namedSpawnB == 42, "task.spawn int future repeated await"
assert not task.cancel(namedSpawnFuture), "completed int task.spawn future cancel result"
int postCancelNamedSpawn = await namedSpawnFuture
assert postCancelNamedSpawn == 42, "post-cancel task.spawn int result"

func(int, int) as int slowAddJob = slowAdd
future<int> pendingSpawnFuture = task.spawn(slowAddJob, 40, 2)
assert task.cancel(pendingSpawnFuture), "pending task.spawn future cancel result"

int pendingSpawnState = 0
try
    int pendingSpawnValue = await pendingSpawnFuture
    pendingSpawnState = pendingSpawnValue
catch e
    if e.message == "future cancel requested." then
        pendingSpawnState = 1
    end
end
assert pendingSpawnState == 1, "pending task.spawn future should await as canceled"

time.sleep(180)

int pendingSpawnStillCanceled = 0
try
    int pendingSpawnLateValue = await pendingSpawnFuture
    pendingSpawnStillCanceled = pendingSpawnLateValue
catch e
    if e.message == "future cancel requested." then
        pendingSpawnStillCanceled = 1
    end
end
assert pendingSpawnStillCanceled == 1, "task.spawn late worker completion should not overwrite cancel"

future<int> pendingSpawnAllLeft = task.spawn(slowAddJob, 50, 1)
future<int> pendingSpawnAllRight = task.spawn(slowAddJob, 60, 2)
future<array<int>> pendingSpawnAllGroup = task.all([pendingSpawnAllLeft, pendingSpawnAllRight])
assert task.cancel(pendingSpawnAllGroup), "pending task.all over task.spawn cancel result"

int pendingSpawnAllSourceState = 0
try
    int pendingSpawnAllLeftValue = await pendingSpawnAllLeft
    pendingSpawnAllSourceState = pendingSpawnAllLeftValue
catch e
    if e.message == "future cancel requested." then
        pendingSpawnAllSourceState = 1
    end
end
assert pendingSpawnAllSourceState == 1, "pending task.all should cancel task.spawn source"

future<int> pendingSpawnRaceLeft = task.spawn(slowAddJob, 70, 3)
future<int> pendingSpawnRaceRight = task.spawn(slowAddJob, 80, 4)
future<int> pendingSpawnRaceGroup = task.race([pendingSpawnRaceLeft, pendingSpawnRaceRight])
assert task.cancel(pendingSpawnRaceGroup), "pending task.race over task.spawn cancel result"

int pendingSpawnRaceSourceState = 0
try
    int pendingSpawnRaceRightValue = await pendingSpawnRaceRight
    pendingSpawnRaceSourceState = pendingSpawnRaceRightValue
catch e
    if e.message == "future cancel requested." then
        pendingSpawnRaceSourceState = 1
    end
end
assert pendingSpawnRaceSourceState == 1, "pending task.race should cancel task.spawn source"
time.sleep(180)

func(int) as int defaultJob = addDefault
int defaultSpawned = await task.spawn(defaultJob, 41)
assert defaultSpawned == 42, "task.spawn default argument result"
future<int> defaultFuture = task.spawn(defaultJob, 41)
int defaultFutureA = await defaultFuture
int defaultFutureB = await defaultFuture
assert defaultFutureA == 42, "task.spawn optional adapter future first await"
assert defaultFutureB == 42, "task.spawn optional adapter future repeated await"
assert not task.cancel(defaultFuture), "completed optional adapter task.spawn future cancel result"
int defaultFutureAfterCancel = await defaultFuture
assert defaultFutureAfterCancel == 42, "post-cancel optional adapter task.spawn future result"

func(int) as int missingJob
int missingJobState = 0
try
    int missingJobValue = await task.spawn(missingJob, 1)
    missingJobState = missingJobValue
catch e
    if e.message == "task.spawn requires a callable func value" then
        missingJobState = 1
    end
end
assert missingJobState == 1, "task.spawn empty func value"

func(string) as string missingStringJob
int missingStringJobState = 0
try
    string missingStringJobValue = await task.spawn(missingStringJob, "x")
    missingStringJobState = 9
catch e
    if e.message == "task.spawn requires a callable func value" then
        missingStringJobState = 1
    end
end
assert missingStringJobState == 1, "task.spawn empty string func value"

func(bool) as bool missingBoolJob
int missingBoolJobState = 0
try
    bool missingBoolJobValue = await task.spawn(missingBoolJob, true)
    missingBoolJobState = int(missingBoolJobValue)
catch e
    if e.message == "task.spawn requires a callable func value" then
        missingBoolJobState = 1
    end
end
assert missingBoolJobState == 1, "task.spawn empty bool func value"

func(float) as float missingFloatJob
int missingFloatJobState = 0
try
    float missingFloatJobValue = await task.spawn(missingFloatJob, 1.5)
    missingFloatJobState = int(missingFloatJobValue)
catch e
    if e.message == "task.spawn requires a callable func value" then
        missingFloatJobState = 1
    end
end
assert missingFloatJobState == 1, "task.spawn empty float func value"

func(int) as int capturedJob = makeAdder(30)
int captured = await task.spawn(capturedJob, 12)
assert captured == 42, "task.spawn closure result"

int directClosureSpawned = await task.spawn(makeAdder(40), 2)
assert directClosureSpawned == 42, "task.spawn direct closure result"
future<int> directClosureFuture = task.spawn(makeAdder(41), 1)
int directClosureA = await directClosureFuture
int directClosureB = await directClosureFuture
assert directClosureA == 42, "task.spawn direct closure first await"
assert directClosureB == 42, "task.spawn direct closure repeated await"

array<future<int>> directClosureJobs = array[task.spawn(makeAdder(50), 1), task.spawn(makeAdder(60), 2)]
array<int> directClosureValues = await task.all(directClosureJobs)
assert directClosureValues[0] == 51, "task.all direct closure first"
assert directClosureValues[1] == 62, "task.all direct closure second"

int directClosureRace = await task.race([task.spawn(makeAdder(70), 3)])
assert directClosureRace == 73, "task.race direct closure"

int awaitedClosureSpawned = await task.spawn(await makeTaskAdder(80), 2)
assert awaitedClosureSpawned == 82, "task.spawn awaited closure result"
future<int> awaitedClosureFuture = task.spawn(await makeTaskAdder(81), 1)
int awaitedClosureA = await awaitedClosureFuture
int awaitedClosureB = await awaitedClosureFuture
assert awaitedClosureA == 82, "task.spawn awaited closure first await"
assert awaitedClosureB == 82, "task.spawn awaited closure repeated await"

array<future<int>> awaitedClosureJobs = array[task.spawn(await makeTaskAdder(90), 1), task.spawn(await makeTaskAdder(100), 2)]
array<int> awaitedClosureValues = await task.all(awaitedClosureJobs)
assert awaitedClosureValues[0] == 91, "task.all awaited closure first"
assert awaitedClosureValues[1] == 102, "task.all awaited closure second"

int awaitedClosureRace = await task.race([task.spawn(await makeTaskAdder(110), 3)])
assert awaitedClosureRace == 113, "task.race awaited closure"

bool chooseFirstClosure = false
int conditionalClosureSpawned = await task.spawn(true ? makeAdder(150) : makeAdder(160), 5)
assert conditionalClosureSpawned == 155, "task.spawn conditional closure result"
future<int> conditionalClosureFuture = task.spawn(chooseFirstClosure ? makeAdder(150) : makeAdder(160), 6)
int conditionalClosureA = await conditionalClosureFuture
int conditionalClosureB = await conditionalClosureFuture
assert conditionalClosureA == 166, "task.spawn conditional closure first await"
assert conditionalClosureB == 166, "task.spawn conditional closure repeated await"
assert not task.cancel(conditionalClosureFuture), "completed conditional closure task.spawn future cancel result"
int conditionalClosureAfterCancel = await conditionalClosureFuture
assert conditionalClosureAfterCancel == 166, "post-cancel conditional closure task.spawn result"

array<future<int>> conditionalClosureJobs = array[task.spawn(true ? makeAdder(170) : makeAdder(180), 7), task.spawn(false ? makeAdder(190) : makeAdder(200), 8)]
array<int> conditionalClosureValues = await task.all(conditionalClosureJobs)
assert conditionalClosureValues[0] == 177, "task.all conditional closure first"
assert conditionalClosureValues[1] == 208, "task.all conditional closure second"

int conditionalClosureRace = await task.race([task.spawn(true ? makeAdder(210) : makeAdder(220), 9)])
assert conditionalClosureRace == 219, "task.race conditional closure"

func(int) as int borrowedClosureLeft = makeAdder(230)
func(int) as int borrowedClosureRight = makeAdder(240)
bool chooseBorrowedClosure = true
int borrowedConditionalClosure = await task.spawn(chooseBorrowedClosure ? borrowedClosureLeft : borrowedClosureRight, 5)
assert borrowedConditionalClosure == 235, "task.spawn borrowed conditional closure"
assert borrowedClosureLeft(6) == 236, "borrowed conditional closure source remains usable"
chooseBorrowedClosure = false
future<int> borrowedConditionalClosureFuture = task.spawn(chooseBorrowedClosure ? borrowedClosureLeft : borrowedClosureRight, 7)
assert await borrowedConditionalClosureFuture == 247, "task.spawn borrowed conditional closure future"
assert await borrowedConditionalClosureFuture == 247, "task.spawn borrowed conditional closure repeated await"
assert borrowedClosureRight(8) == 248, "borrowed conditional closure right source remains usable"

func(int) as int mixedTaskClosureSource = makeAdder(260)
bool chooseMixedTaskClosure = false
int mixedTaskOwnedClosure = await task.spawn(chooseMixedTaskClosure ? mixedTaskClosureSource : makeAdder(270), 1)
assert mixedTaskOwnedClosure == 271, "task.spawn mixed conditional owned closure"
assert mixedTaskClosureSource(2) == 262, "mixed conditional closure source remains usable after owned branch"
chooseMixedTaskClosure = true
int mixedTaskBorrowedClosure = await task.spawn(chooseMixedTaskClosure ? mixedTaskClosureSource : makeAdder(280), 3)
assert mixedTaskBorrowedClosure == 263, "task.spawn mixed conditional borrowed closure"
assert mixedTaskClosureSource(4) == 264, "mixed conditional closure source remains usable after borrowed branch"

TaskFuncBox memberClosureBox
memberClosureBox.op = makeAdder(120)
int memberClosureSpawned = await task.spawn(memberClosureBox.op, 3)
assert memberClosureSpawned == 123, "task.spawn member closure result"
future<int> memberClosureFuture = task.spawn(memberClosureBox.op, 4)
int memberClosureA = await memberClosureFuture
int memberClosureB = await memberClosureFuture
assert memberClosureA == 124, "task.spawn member closure first await"
assert memberClosureB == 124, "task.spawn member closure repeated await"

TaskFuncBox memberClosureAlt
memberClosureAlt.op = makeAdder(250)
bool chooseMemberClosure = false
int borrowedMemberConditionalClosure = await task.spawn(chooseMemberClosure ? memberClosureBox.op : memberClosureAlt.op, 9)
assert borrowedMemberConditionalClosure == 259, "task.spawn borrowed conditional member closure"
assert memberClosureAlt.op(10) == 260, "borrowed conditional member closure source remains usable"

array<func(int) as int> indexedClosureFuncs = array[makeAdder(130), makeAdder(140)]
int indexedClosureSpawned = await task.spawn(indexedClosureFuncs[0], 5)
assert indexedClosureSpawned == 135, "task.spawn indexed closure result"
future<int> indexedClosureFuture = task.spawn(indexedClosureFuncs[1], 6)
int indexedClosureA = await indexedClosureFuture
int indexedClosureB = await indexedClosureFuture
assert indexedClosureA == 146, "task.spawn indexed closure first await"
assert indexedClosureB == 146, "task.spawn indexed closure repeated await"

array<future<int>> indexedClosureJobs = array[task.spawn(indexedClosureFuncs[0], 7), task.spawn(indexedClosureFuncs[1], 8)]
array<int> indexedClosureValues = await task.all(indexedClosureJobs)
assert indexedClosureValues[0] == 137, "task.all indexed closure first"
assert indexedClosureValues[1] == 148, "task.all indexed closure second"

int indexedClosureRace = await task.race([task.spawn(indexedClosureFuncs[0], 9)])
assert indexedClosureRace == 139, "task.race indexed closure"

func(string) as string greetJob = greet
future<string> namedGreetFuture = task.spawn(greetJob, "spawn")
string namedGreetA = await namedGreetFuture
string namedGreetB = await namedGreetFuture
assert namedGreetA == "hello spawn", "task.spawn string future first await"
assert namedGreetB == "hello spawn", "task.spawn string future repeated await"
assert not task.cancel(namedGreetFuture), "completed string task.spawn future cancel result"
string postCancelNamedGreet = await namedGreetFuture
assert postCancelNamedGreet == "hello spawn", "post-cancel task.spawn string result"

func(string) as string slowGreetJob = slowGreet
future<string> pendingStringSpawnFuture = task.spawn(slowGreetJob, "pending")
assert task.cancel(pendingStringSpawnFuture), "pending string task.spawn cancel result"

int pendingStringSpawnState = 0
try
    string pendingStringSpawnValue = await pendingStringSpawnFuture
    pendingStringSpawnState = 9
catch e
    if e.message == "future cancel requested." then
        pendingStringSpawnState = 1
