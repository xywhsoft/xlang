    if e.message == "future cancel requested." then
        typedFailureClosureRaceLoserState = 1
    end
end
assert typedFailureClosureRaceLoserState == 1, "failed typed task.race should cancel pending closure loser"

time.sleep(180)

int typedFailureClosureRaceLoserStillCanceled = 0
try
    int typedFailureClosureRaceLoserLateValue = await typedFailureClosureRaceLoser
    typedFailureClosureRaceLoserStillCanceled = typedFailureClosureRaceLoserLateValue
catch e
    if e.message == "future cancel requested." then
        typedFailureClosureRaceLoserStillCanceled = 1
    end
end
assert typedFailureClosureRaceLoserStillCanceled == 1, "failed typed task.race closure loser should stay canceled"

assert typedFailureClosureRaceLoserSource(0) == 690, "failed typed task.race closure loser source remains callable"

future<int> conditionalFutureSource = addAsync(610, 1)
assert await conditionalFutureSource == 611, "conditional future source first await"
bool chooseConditionalFuture = true
assert not task.cancel(chooseConditionalFuture ? conditionalFutureSource : addAsync(620, 1)), "completed conditional borrowed future should not be canceled"
assert await conditionalFutureSource == 611, "conditional future source remains awaitable after cancel"

chooseConditionalFuture = false
bool conditionalFutureOwnedCancel = task.cancel(chooseConditionalFuture ? conditionalFutureSource : addAsync(630, 1))
assert conditionalFutureOwnedCancel == true or conditionalFutureOwnedCancel == false, "conditional owned future cancel should release temporary future"
assert await conditionalFutureSource == 611, "conditional owned branch should not affect source future"

future<string> conditionalStringFutureSource = greetAsync("conditional string")
assert await conditionalStringFutureSource == "hello conditional string", "conditional string future source first await"
bool chooseConditionalStringFuture = true
assert not task.cancel(chooseConditionalStringFuture ? conditionalStringFutureSource : greetAsync("conditional temp")), "completed conditional string borrowed future should not be canceled"
assert await conditionalStringFutureSource == "hello conditional string", "conditional string source remains awaitable"

future<TaskBox> conditionalClassFutureSource = makeTaskBox(690)
TaskBox conditionalClassBoxA = await conditionalClassFutureSource
assert conditionalClassBoxA.add(1) == 691, "conditional class future source first await"
bool chooseConditionalClassFuture = true
assert not task.cancel(chooseConditionalClassFuture ? conditionalClassFutureSource : makeTaskBox(700)), "completed conditional class borrowed future should not be canceled"
TaskBox conditionalClassBoxB = await conditionalClassFutureSource
assert conditionalClassBoxB.add(2) == 692, "conditional class source remains awaitable"

future<func(int) as int> conditionalFuncFutureSource = makeTaskAdder(710)
func(int) as int conditionalFuncA = await conditionalFuncFutureSource
assert conditionalFuncA(1) == 711, "conditional function future source first await"
bool chooseConditionalFuncFuture = true
assert not task.cancel(chooseConditionalFuncFuture ? conditionalFuncFutureSource : makeTaskAdder(720)), "completed conditional function borrowed future should not be canceled"
func(int) as int conditionalFuncB = await conditionalFuncFutureSource
assert conditionalFuncB(2) == 712, "conditional function source remains awaitable"

future<array<int>> conditionalAllFutureSource = task.all([addAsync(730, 1), addAsync(740, 2)])
array<int> conditionalAllSourceValues = await conditionalAllFutureSource
assert conditionalAllSourceValues[0] == 731, "conditional task.all future source first value"
assert conditionalAllSourceValues[1] == 742, "conditional task.all future source second value"
bool chooseConditionalAllFuture = true
assert not task.cancel(chooseConditionalAllFuture ? conditionalAllFutureSource : task.all([addAsync(750, 1)])), "completed conditional task.all borrowed future should not be canceled"
array<int> conditionalAllSourceValuesAgain = await conditionalAllFutureSource
assert conditionalAllSourceValuesAgain[0] == 731, "conditional task.all source remains awaitable"

future<int> conditionalAllSource = addAsync(640, 1)
bool chooseConditionalAll = true
array<int> conditionalFutureAll = await task.all([
    chooseConditionalAll ? conditionalAllSource : addAsync(650, 1),
    false ? conditionalAllSource : addAsync(660, 1)
])
assert conditionalFutureAll[0] == 641, "task.all conditional future borrowed branch"
assert conditionalFutureAll[1] == 661, "task.all conditional future owned branch"
assert await conditionalAllSource == 641, "task.all conditional future source remains awaitable"

future<int> conditionalRaceSource = addAsync(670, 1)
bool chooseConditionalRace = true
int conditionalFutureRace = await task.race([chooseConditionalRace ? conditionalRaceSource : addAsync(680, 1)])
assert conditionalFutureRace == 671, "task.race conditional future borrowed branch"
assert await conditionalRaceSource == 671, "task.race conditional future source remains awaitable"

future<int> typedConditionalAllSource = addAsync(760, 1)
bool chooseTypedConditionalAll = true
array<future<int>> typedConditionalAllJobs = array[
    chooseTypedConditionalAll ? typedConditionalAllSource : addAsync(770, 1),
    false ? typedConditionalAllSource : addAsync(780, 1)
]
array<int> typedConditionalAll = await task.all(typedConditionalAllJobs)
assert typedConditionalAll[0] == 761, "typed task.all conditional future borrowed branch"
assert typedConditionalAll[1] == 781, "typed task.all conditional future owned branch"
assert await typedConditionalAllSource == 761, "typed task.all conditional future source remains awaitable"

future<int> typedConditionalRaceSource = addAsync(790, 1)
bool chooseTypedConditionalRace = true
array<future<int>> typedConditionalRaceJobs = array[
    chooseTypedConditionalRace ? typedConditionalRaceSource : addAsync(800, 1)
]
int typedConditionalRace = await task.race(typedConditionalRaceJobs)
assert typedConditionalRace == 791, "typed task.race conditional future borrowed branch"
assert await typedConditionalRaceSource == 791, "typed task.race conditional future source remains awaitable"

future<bool> typedConditionalBoolSource = flipAsync(false)
bool chooseTypedConditionalBool = true
array<future<bool>> typedConditionalBoolJobs = array[
    chooseTypedConditionalBool ? typedConditionalBoolSource : flipAsync(true)
]
bool typedConditionalBoolRace = await task.race(typedConditionalBoolJobs)
assert typedConditionalBoolRace, "typed task.race conditional bool borrowed branch"
assert await typedConditionalBoolSource, "typed task.race conditional bool source remains awaitable"

future<float> typedConditionalFloatSource = addHalfAsync(800.5)
bool chooseTypedConditionalFloat = true
array<future<float>> typedConditionalFloatJobs = array[
    chooseTypedConditionalFloat ? typedConditionalFloatSource : addHalfAsync(801.5)
]
float typedConditionalFloatRace = await task.race(typedConditionalFloatJobs)
assert typedConditionalFloatRace == 801.0, "typed task.race conditional float borrowed branch"
assert await typedConditionalFloatSource == 801.0, "typed task.race conditional float source remains awaitable"

future<string> typedConditionalStringSource = greetAsync("typed conditional string")
bool chooseTypedConditionalString = true
array<future<string>> typedConditionalStringJobs = array[
    chooseTypedConditionalString ? typedConditionalStringSource : greetAsync("typed conditional string alt"),
    false ? typedConditionalStringSource : greetAsync("typed conditional string owned")
]
array<string> typedConditionalStrings = await task.all(typedConditionalStringJobs)
assert typedConditionalStrings[0] == "hello typed conditional string", "typed task.all conditional string borrowed branch"
assert typedConditionalStrings[1] == "hello typed conditional string owned", "typed task.all conditional string owned branch"
assert await typedConditionalStringSource == "hello typed conditional string", "typed task.all conditional string source remains awaitable"

future<TaskBox> typedConditionalBoxSource = makeTaskBox(805)
bool chooseTypedConditionalBox = true
array<future<TaskBox>> typedConditionalBoxJobs = array[
    chooseTypedConditionalBox ? typedConditionalBoxSource : makeTaskBox(806)
]
future<TaskBox> typedConditionalBoxRaceFuture = task.race(typedConditionalBoxJobs)
TaskBox typedConditionalBoxRace = await typedConditionalBoxRaceFuture
assert typedConditionalBoxRace.add(1) == 806, "typed task.race conditional class borrowed branch"
TaskBox typedConditionalBoxAgain = await typedConditionalBoxSource
assert typedConditionalBoxAgain.add(2) == 807, "typed task.race conditional class source remains awaitable"

future<func(int) as int> typedConditionalFuncSource = makeTaskAdder(808)
bool chooseTypedConditionalFunc = true
array<future<func(int) as int> > typedConditionalFuncJobs = array[
    chooseTypedConditionalFunc ? typedConditionalFuncSource : makeTaskAdder(809)
]
