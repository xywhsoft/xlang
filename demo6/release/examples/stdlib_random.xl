uint32 seed32 = random.u32()
uint64 seed64 = random.u64()
int dice = random.range(1, 6)
string token = random.string(16)
string fixedText = random.string(4, "x")

random.seed(uint64(2026), uint64(1))
uint32 replayA = random.u32()
random.seed(uint64(2026), uint64(1))
uint32 replayB = random.u32()

Random rngA = Random(uint64(12345), uint64(7))
Random rngB = Random(uint64(12345), uint64(7))
uint32 obj32A = rngA.u32()
uint32 obj32B = rngB.u32()
uint64 obj64A = rngA.u64()
uint64 obj64B = rngB.u64()
int diceA = rngA.range(1, 6)
int diceB = rngB.range(1, 6)

rngA.seed(uint64(2026), uint64(1))
rngB.seed(uint64(2026), uint64(1))
string objTokenA = rngA.string(10, "ab")
string objTokenB = rngB.string(10, "ab")
string objFixed = rngA.string(5, "z")

assert(seed32 >= 0)
assert(seed64 >= 0)
assert(dice >= 1)
assert(dice <= 6)
assert(string.len(token) == 16)
assert(fixedText == "xxxx")
println("global=ok")

assert(replayA == replayB)
println("seed_replay=ok")

assert(obj32A == obj32B)
assert(obj64A == obj64B)
assert(diceA == diceB)
assert(diceA >= 1)
assert(diceA <= 6)
assert(objTokenA == objTokenB)
assert(string.len(objTokenA) == 10)
assert(objFixed == "zzzzz")
println("object_replay=ok")
