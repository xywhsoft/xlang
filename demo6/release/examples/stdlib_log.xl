string baseDir = path.join(path.temp(), "xl6_stdlib_log_example")
dir.createAll(baseDir)

string logPath = path.join(baseDir, "stdlib_log.log")
string defaultPath = path.join(baseDir, "default.log")
string defaultRollingPath = path.join(baseDir, "default_rolling.log")
string rollingPath = path.join(baseDir, "rolling.log")

file.delete(logPath)
file.delete(defaultPath)
file.delete(defaultRollingPath)
file.delete(defaultRollingPath + ".1")
file.delete(rollingPath)
file.delete(rollingPath + ".1")

assert(log.levelName(log.warnLevel) == "WARN")
assert(log.levelName(log.debugLevel) == "DEBUG")
assert(log.levelName(log.errorLevel) == "ERROR")
assert(log.levelName(log.fatalLevel) == "FATAL")
log.setLevel(log.offLevel)
assert(log.getLevel() == log.offLevel)
assert(log.addConsole(log.offLevel, false, log.textFormat))
assert(log.addFile(defaultPath, log.offLevel, log.jsonFormat))
assert(log.addRollingFile(defaultRollingPath, 96, 1, log.offLevel, log.textFormat))
log.write(log.infoLevel, "silent-write")
log.trace("silent-trace")
log.debug("silent-debug")
log.info("silent-info")
log.warn("silent-warn")
log.error("silent-error")
log.fatal("silent-fatal")
log.flush()
Logger defaultLogger = log.default()
defaultLogger.flush()
println("level=ok")

Logger logger = log.create("example")
logger.setLevel(log.traceLevel)
assert(logger.getLevel() == log.traceLevel)
assert(logger.addFile(logPath, log.traceLevel, log.simpleFormat))
logger.info("hello-log")
logger.warn("warn-log")
logger.flush()

string text = file.readText(logPath)
assert(string.contains(text, "hello-log"))
assert(string.contains(text, "warn-log"))
println("file=ok")

Logger rolling = Logger("rolling")
assert(rolling.addRollingFile(rollingPath, 96, 2, log.traceLevel, log.simpleFormat))
for i in range(0, 8)
    rolling.info("rolling-line-" + int.format(i, "00"))
end
rolling.flush()

assert(file.exists(rollingPath))
assert(file.exists(rollingPath + ".1"))
println("rolling=ok")

int customCount = 0
string customLast = ""

func captureLog(var event)
    customCount += 1
    customLast = string(event["message"])
end

Logger customLogger = log.create("custom-example")
customLogger.setLevel(log.traceLevel)
assert(customLogger.makeDefault())
LogSink capture = customLogger.customSink("capture", captureLog, log.infoLevel)
assert(capture.name == "capture")
customLogger.info("captured")
assert(customCount == 1)
assert(customLast == "captured")
assert(customLogger.removeSink(capture))
customLogger.info("ignored")
assert(customCount == 1)
println("custom=ok")
