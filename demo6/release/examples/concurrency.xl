future<int> pendingAsyncInt = slowAddAsync(40, 2)
assert task.cancel(pendingAsyncInt), "pending async int cancel result"

int pendingAsyncIntState = 0
try
    int pendingAsyncIntValue = await pendingAsyncInt
    pendingAsyncIntState = pendingAsyncIntValue
catch e
    if e.message == "future cancel requested." then
        pendingAsyncIntState = 1
    end
end
assert pendingAsyncIntState == 1, "pending async int should await as canceled"

time.sleep(180)

int pendingAsyncIntStillCanceled = 0
try
    int pendingAsyncIntLateValue = await pendingAsyncInt
    pendingAsyncIntStillCanceled = pendingAsyncIntLateValue
catch e
    if e.message == "future cancel requested." then
        pendingAsyncIntStillCanceled = 1
    end
end
assert pendingAsyncIntStillCanceled == 1, "pending async int late completion should not overwrite cancel"

