async func addAsync(int a, int b) as int
    return a + b
end

async func slowAddAsync(int a, int b) as int
    time.sleep(120)
    return a + b
end

async func makeVarAsync(int value) as var
    return value
end

async func failTextAsync() as string
    throw "async text boom"
    return ""
end

async func failDoneAsync()
    throw "async void boom"
end

async func failScoresAsync() as dict<int>
    throw "async dict boom"
    return dict{"score": 42}
end

async func asyncFinallyCatchExample() as int
    int state = 0

    try
        state = 1
        throw "async finally catch example"
    catch e
        if e.message == "async finally catch example" then
            state = state + 10
        end
    finally
        state = state + 100
    end

    return state
end

async func asyncFinallyRethrowExample() as int
    int state = 0

    try
        try
            state = 1
            throw "async finally rethrow example"
        finally
            state = state + 10
        end
    catch e
        if e.message == "async finally rethrow example" then
            state = state + 100
        end
    end

    return state
end

async func asyncFinallyOverrideExample() as int
    try
        throw "async finally original example"
    finally
        throw "async finally override example"
    end

    return 0
end

async func asyncFinallyVoidOverrideExample()
    try
        throw "async finally void original example"
    finally
        throw "async finally void override example"
    end
end

async func slowVoidAsync()
    time.sleep(120)
end

async func slowVarAsync(int value) as var
    time.sleep(120)
    return value
end

async func slowTextAsync(string name) as string
    time.sleep(120)
    return "hello " + name
end

async func slowFlagAsync(bool flag) as bool
    time.sleep(120)
    return not flag
end

async func slowFloatAsync(float value) as float
    time.sleep(120)
    return value + 0.5
end

func makeOffset(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

class AsyncExampleBox
    int bias = 0
    func(int) as int op
end

async func slowFuncAsync(int base) as func(int) as int
    time.sleep(120)
    return makeOffset(base)
end

async func slowBoxAsync(int base) as AsyncExampleBox
    time.sleep(120)
    AsyncExampleBox box = AsyncExampleBox()
    box.bias = base
    box.op = makeOffset(base)
    return box
end

async func slowArrayAsync() as array<int>
    time.sleep(120)
    return array[3, 4, 5]
end

async func slowAltArrayAsync() as array<int>
    time.sleep(120)
    return array[13, 14, 15]
end

async func slowScoresAsync() as dict<int>
    time.sleep(120)
    return dict{"score": 42}
end

func numbers(int count) as generator<int>
    int i = 0
    while i < count do
        i = i + 1
        yield i
    end
end

func brokenNumbersEarly() as generator<int>
    throw "generator boom before yield"
    yield 1
end

func emptyNumbers() as generator<int>
    int marker = 1
    if marker == 0 then
        yield marker
    end
end

func worker() as int
    return 7
end

func slowWorker() as int
    time.sleep(30)
    return 9
end

func monitorSlowWorker() as int
    time.sleep(120)
    return 19
end

func makeThreadWorker(int code) as func() as int
    return func() as int
        return code
    end
end

func() as int missingThreadWorker

auto f = addAsync(20, 22)
int answer = await f
assert answer == 42, "async/await failed"
assert not task.cancel(f), "completed async future cancel result"
int answerAfterCancel = await f
assert answerAfterCancel == 42, "completed async future remains awaitable"

future<var> vf = makeVarAsync(120)
var dynamicAnswer = await vf
assert int(dynamicAnswer) == 120, "async var await failed"
assert not task.cancel(vf), "completed async var future cancel result"
var dynamicAfterCancel = await vf
assert int(dynamicAfterCancel) == 120, "completed async var future remains awaitable"

future<int> conditionalAwaitSource = addAsync(30, 12)
bool chooseConditionalAwait = true
int conditionalAwaitBorrowed = await (chooseConditionalAwait ? conditionalAwaitSource : addAsync(1, 1))
assert conditionalAwaitBorrowed == 42, "conditional await borrowed future failed"
int conditionalAwaitAgain = await conditionalAwaitSource
assert conditionalAwaitAgain == 42, "conditional await borrowed future should remain awaitable"
chooseConditionalAwait = false
int conditionalAwaitOwned = await (chooseConditionalAwait ? conditionalAwaitSource : addAsync(40, 2))
assert conditionalAwaitOwned == 42, "conditional await owned future failed"

future<var> conditionalVarSource = makeVarAsync(140)
chooseConditionalAwait = true
var conditionalVarBorrowed = await (chooseConditionalAwait ? conditionalVarSource : makeVarAsync(1))
assert int(conditionalVarBorrowed) == 140, "conditional await borrowed var future failed"
var conditionalVarAgain = await conditionalVarSource
assert int(conditionalVarAgain) == 140, "conditional await borrowed var future should remain awaitable"
chooseConditionalAwait = false
var conditionalVarOwned = await (chooseConditionalAwait ? conditionalVarSource : makeVarAsync(141))
assert int(conditionalVarOwned) == 141, "conditional await owned var future failed"

future<func(int) as int> conditionalFuncSource = slowFuncAsync(142)
bool chooseConditionalFunc = true
func(int) as int conditionalFuncBorrowed = await (chooseConditionalFunc ? conditionalFuncSource : slowFuncAsync(143))
assert conditionalFuncBorrowed(1) == 143, "conditional await borrowed function future failed"
func(int) as int conditionalFuncAgain = await conditionalFuncSource
assert conditionalFuncAgain(2) == 144, "conditional await borrowed function future should remain awaitable"
chooseConditionalFunc = false
func(int) as int conditionalFuncOwned = await (chooseConditionalFunc ? conditionalFuncSource : slowFuncAsync(143))
assert conditionalFuncOwned(3) == 146, "conditional await owned function future failed"

future<string> conditionalTextSource = slowTextAsync("named conditional")
bool chooseConditionalText = true
string conditionalTextBorrowed = await (chooseConditionalText ? conditionalTextSource : slowTextAsync("owned conditional"))
assert conditionalTextBorrowed == "hello named conditional", "conditional await borrowed string future failed"
string conditionalTextAgain = await conditionalTextSource
assert conditionalTextAgain == "hello named conditional", "conditional await borrowed string future should remain awaitable"
chooseConditionalText = false
string conditionalTextOwned = await (chooseConditionalText ? conditionalTextSource : slowTextAsync("owned conditional"))
assert conditionalTextOwned == "hello owned conditional", "conditional await owned string future failed"

future<array<int>> conditionalArraySource = slowArrayAsync()
bool chooseConditionalArray = true
array<int> conditionalArrayBorrowed = await (chooseConditionalArray ? conditionalArraySource : slowAltArrayAsync())
assert conditionalArrayBorrowed[0] == 3, "conditional await borrowed array future failed"
array<int> conditionalArrayAgain = await conditionalArraySource
assert conditionalArrayAgain[2] == 5, "conditional await borrowed array future should remain awaitable"
chooseConditionalArray = false
array<int> conditionalArrayOwned = await (chooseConditionalArray ? conditionalArraySource : slowAltArrayAsync())
assert conditionalArrayOwned[0] == 13, "conditional await owned array future failed"

future<AsyncExampleBox> conditionalBoxSource = slowBoxAsync(150)
bool chooseConditionalBox = true
AsyncExampleBox conditionalBoxBorrowed = await (chooseConditionalBox ? conditionalBoxSource : slowBoxAsync(160))
assert conditionalBoxBorrowed.op(2) + conditionalBoxBorrowed.bias == 302, "conditional await borrowed class future failed"
AsyncExampleBox conditionalBoxAgain = await conditionalBoxSource
assert conditionalBoxAgain.op(3) + conditionalBoxAgain.bias == 303, "conditional await borrowed class future should remain awaitable"
chooseConditionalBox = false
AsyncExampleBox conditionalBoxOwned = await (chooseConditionalBox ? conditionalBoxSource : slowBoxAsync(160))
assert conditionalBoxOwned.op(4) + conditionalBoxOwned.bias == 324, "conditional await owned class future failed"

auto failedDone = failDoneAsync()
int failedDoneState = 0
try
    await failedDone
    failedDoneState = 9
catch e
    if e.message == "async void boom" then
        failedDoneState = 1
    end
end
assert failedDoneState == 1, "failed async void future should reach catch"
assert not task.cancel(failedDone), "failed async void future cancel result"
try
    await failedDone
    failedDoneState = 9
catch e
    if e.message == "async void boom" then
        failedDoneState = 2
    end
end
assert failedDoneState == 2, "failed async void future remains awaitable"

future<string> failedText = failTextAsync()
int failedTextState = 0
try
    string textValue = await failedText
    failedTextState = 9
catch e
    if e.message == "async text boom" then
        failedTextState = 1
    end
end
assert failedTextState == 1, "failed async future should reach catch"
assert not task.cancel(failedText), "failed async future cancel result"
try
    string textValueAgain = await failedText
    failedTextState = 9
catch e
    if e.message == "async text boom" then
        failedTextState = 2
    end
end
assert failedTextState == 2, "failed async future remains awaitable"

