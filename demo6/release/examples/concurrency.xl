int total = 0
for value in numbers(4)
    total = total + value
end
assert total == 10, "generator failed"

int generatorEarlyErrorState = 0
try
    for value in brokenNumbersEarly()
        generatorEarlyErrorState = generatorEarlyErrorState + value
    end
    generatorEarlyErrorState = 100
catch e
    if e.message == "generator boom before yield" then
        generatorEarlyErrorState = 42
    end
end
assert generatorEarlyErrorState == 42, "generator early error propagation failed"

int emptyGeneratorCount = 0
for value in emptyNumbers()
    emptyGeneratorCount = emptyGeneratorCount + 1
end
assert emptyGeneratorCount == 0, "empty generator failed"

channel<int> ch = channel::<int>(1)
assert ch.send(123), "channel send failed"
int received = 0
assert ch.recvInto(received), "channel recv failed"
assert received == 123, "channel value failed"
ch.close()

channel<int> buffered = channel::<int>()
assert buffered.send(1), "default channel first send failed"
assert buffered.send(2), "default channel second send failed"
assert buffered.count() == 2, "default channel count failed"

int bufferedFirst = 0
assert buffered.tryRecvInto(bufferedFirst), "default channel tryRecv failed"
assert bufferedFirst == 1, "default channel first value failed"

buffered.close()
assert buffered.isClosed(), "default channel close failed"

int bufferedSecond = 0
assert buffered.recvInto(bufferedSecond), "closed channel buffered recv failed"
assert bufferedSecond == 2, "closed channel buffered value failed"
assert not buffered.tryRecvInto(bufferedSecond), "closed drained channel recv should fail"
assert not buffered.send(3), "closed channel send should fail"

channel<int> full = channel::<int>(1)
assert full.send(10), "full channel first send failed"
assert full.send(11), "capacity-one channel should normalize to two slots"
assert not full.trySend(12), "full channel third trySend should fail"

channel<int> crossThreadChannel = channel::<int>(4)
auto channelProducer = func() as int
    if not crossThreadChannel.send(314) then
        return 10
    end
    if not crossThreadChannel.send(159) then
        return 11
    end
    crossThreadChannel.close()
    return 17
end

thread producerThread = thread(channelProducer)
assert producerThread.waitTimeout(2000), "channel producer thread wait failed"
assert producerThread.exitCode() == 17, "channel producer thread exit failed"
assert crossThreadChannel.isClosed(), "cross-thread channel close should be visible"

int crossFirst = 0
int crossSecond = 0
assert crossThreadChannel.recvInto(crossFirst), "cross-thread channel first recv failed"
assert crossFirst == 314, "cross-thread channel first value failed"
assert crossThreadChannel.recvInto(crossSecond), "cross-thread channel second recv failed"
assert crossSecond == 159, "cross-thread channel second value failed"
assert not crossThreadChannel.tryRecvInto(crossSecond), "cross-thread closed drained channel recv should fail"
assert not crossThreadChannel.send(265), "cross-thread closed channel send should fail"

channel<int> nonblockingTryChannel = channel::<int>(1)
auto nonblockingTryWorker = func() as int
    int got = 0
    if nonblockingTryChannel.tryRecvInto(got) then
        return got
    end
    return 31
end

thread nonblockingTryThread = thread(nonblockingTryWorker)
assert nonblockingTryThread.waitTimeout(2000), "nonblocking tryRecv thread wait failed"
assert nonblockingTryThread.exitCode() == 31, "empty tryRecv in thread should return false"
assert nonblockingTryChannel.send(42), "nonblocking tryRecv should leave channel usable"
int nonblockingTryLater = 0
assert nonblockingTryChannel.recvInto(nonblockingTryLater), "nonblocking tryRecv later recv failed"
assert nonblockingTryLater == 42, "nonblocking tryRecv later value failed"
nonblockingTryChannel.close()
assert nonblockingTryChannel.isClosed(), "nonblocking tryRecv channel close failed"

channel<int> timeoutChannel = channel::<int>(1)
int timeoutValue = 0
assert not timeoutChannel.recvTimeoutInto(timeoutValue, 10), "empty timeout channel should time out"
assert timeoutValue == 0, "timeout receive should not change output value"
assert timeoutChannel.send(88), "timeout channel send failed"
assert timeoutChannel.recvTimeoutInto(timeoutValue, 100), "timeout receive should get sent value"
assert timeoutValue == 88, "timeout channel value failed"
timeoutChannel.close()
assert not timeoutChannel.recvTimeoutInto(timeoutValue, 0), "closed timeout channel should not receive"

int missingThreadState = 0
try
    thread missingThread = thread(missingThreadWorker)
    missingThreadState = missingThread.exitCode()
catch e
    if e.message == "thread requires a callable func value" then
        missingThreadState = 1
    end
end
assert missingThreadState == 1, "thread empty func value"

thread t = thread(worker)
assert t.wait(), "thread wait failed"
assert t.exitCode() == 7, "thread exit code failed"

func() as int borrowedThreadLeft = makeThreadWorker(11)
func() as int borrowedThreadRight = makeThreadWorker(12)
bool chooseBorrowedThread = false
thread borrowedConditionalThread = thread(chooseBorrowedThread ? borrowedThreadLeft : borrowedThreadRight)
assert borrowedConditionalThread.wait(), "thread borrowed conditional wait failed"
assert borrowedConditionalThread.exitCode() == 12, "thread borrowed conditional exit code failed"
assert borrowedThreadRight() == 12, "thread borrowed conditional source remains usable"

func() as int mixedThreadSource = makeThreadWorker(15)
bool chooseMixedThread = false
thread mixedThreadOwned = thread(chooseMixedThread ? mixedThreadSource : makeThreadWorker(16))
assert mixedThreadOwned.wait(), "thread mixed conditional owned wait failed"
assert mixedThreadOwned.exitCode() == 16, "thread mixed conditional owned exit code failed"
assert mixedThreadSource() == 15, "thread mixed conditional source remains usable after owned branch"
chooseMixedThread = true
thread mixedThreadBorrowed = thread(chooseMixedThread ? mixedThreadSource : makeThreadWorker(17))
assert mixedThreadBorrowed.wait(), "thread mixed conditional borrowed wait failed"
assert mixedThreadBorrowed.exitCode() == 15, "thread mixed conditional borrowed exit code failed"
assert mixedThreadSource() == 15, "thread mixed conditional source remains usable after borrowed branch"

thread slowThread = thread(slowWorker)
assert not slowThread.waitTimeout(0), "running thread waitTimeout(0) should time out"
assert slowThread.waitTimeout(2000), "slow thread waitTimeout failed"
assert slowThread.exitCode() == 9, "slow thread exit code failed"
assert slowThread.wait(), "completed thread repeated wait failed"
assert slowThread.exitCode() == 9, "completed thread exit code should remain stable"

thread capturedTimedThread = thread(monitorSlowWorker)
auto threadObserver = func() as int
    if capturedTimedThread.waitTimeout(0) then
        return 10
    end
    if capturedTimedThread.state() < 0 then
        return 11
    end
    if not capturedTimedThread.waitTimeout(2000) then
        return 12
    end
    if capturedTimedThread.exitCode() != 19 then
        return 13
    end
    if capturedTimedThread.state() < 0 then
        return 14
    end
    return capturedTimedThread.exitCode()
end
assert threadObserver() == 19, "captured thread receiver waitTimeout/state failed"

thread capturedStopThread = thread(slowWorker)
auto threadStopper = func() as int
    if not capturedStopThread.stop() then
        return 10
    end
    if not capturedStopThread.wait() then
        return 11
    end
    return 17
end
assert threadStopper() == 17, "captured thread receiver stop/wait failed"

sem gate = sem(0, 2)
assert gate.postMultiple(2), "sem postMultiple failed"
assert gate.waitTimeout(10), "sem first waitTimeout failed"
assert gate.waitTimeout(10), "sem second waitTimeout failed"
assert not gate.tryWait(), "sem empty tryWait failed"

sem capped = sem(1, 2)
assert not capped.postMultiple(2), "sem postMultiple overflow should fail"
assert capped.waitTimeout(10), "sem postMultiple overflow should keep original count"
assert not capped.tryWait(), "sem postMultiple overflow should not partially post"

sem fullSem = sem(1, 1)
assert not fullSem.post(), "sem post on full semaphore should fail"
assert fullSem.waitTimeout(10), "sem full original wait failed"
assert fullSem.post(), "sem post after drain failed"
assert fullSem.waitTimeout(10), "sem refill wait failed"

sem semWakeGate = sem(0, 1)
auto semWakeWorker = func() as int
    if not semWakeGate.waitTimeout(2000) then
        return 10
    end
    return 23
end

thread semWakeThread = thread(semWakeWorker)
assert not semWakeThread.waitTimeout(1), "sem worker should wait before post"
assert semWakeGate.post(), "sem cross-thread post failed"
assert semWakeThread.waitTimeout(2000), "sem cross-thread wait failed"
assert semWakeThread.exitCode() == 23, "sem cross-thread worker exit failed"

cond c = cond()
mutex m = mutex()
assert m.lock(), "cond mutex lock failed"
assert not c.waitTimeout(m, 1), "cond waitTimeout should time out"
assert m.unlock(), "cond mutex unlock failed"

cond wakeCond = cond()
mutex wakeMutex = mutex()
sem wakeReady = sem(0, 1)
auto wakeWorker = func() as int
    if not wakeReady.waitTimeout(2000) then
        return 10
    end
    time.sleep(20)
    if not wakeMutex.lock() then
        return 11
    end
    if not wakeCond.signal() then
        wakeMutex.unlock()
        return 12
    end
    if not wakeMutex.unlock() then
        return 13
    end
    return 17
end

thread wakeThread = thread(wakeWorker)
assert wakeMutex.lock(), "cond cross-thread mutex lock failed"
assert wakeReady.post(), "cond cross-thread ready post failed"
assert wakeCond.waitTimeout(wakeMutex, 2000), "cond cross-thread waitTimeout should be signaled"
assert wakeMutex.unlock(), "cond cross-thread mutex unlock failed"
assert wakeThread.wait(), "cond cross-thread worker wait failed"
assert wakeThread.exitCode() == 17, "cond cross-thread worker exit failed"

rwlock rw = rwlock()
assert rw.tryReadLock(), "rwlock tryReadLock failed"
assert rw.readUnlock(), "rwlock readUnlock failed"

rwlock upgradeRw = rwlock()
assert not upgradeRw.upgrade(), "rwlock upgrade without read lock should fail"
assert upgradeRw.readLock(), "rwlock upgrade readLock failed"
assert upgradeRw.upgrade(), "rwlock upgrade failed"
assert upgradeRw.writeUnlock(), "rwlock upgraded writeUnlock failed"

rwlock capturedRw = rwlock()
auto capturedRwWorker = func() as int
    if not capturedRw.writeLock() then
        return 10
    end
    if not capturedRw.downgrade() then
        capturedRw.writeUnlock()
        return 11
    end
    if not capturedRw.readUnlock() then
        return 12
    end
    return 29
end

thread capturedRwThread = thread(capturedRwWorker)
assert capturedRwThread.waitTimeout(2000), "captured rwlock worker wait failed"
assert capturedRwThread.exitCode() == 29, "captured rwlock worker exit failed"
assert capturedRw.tryWriteLock(), "captured rwlock should be unlocked after worker"
assert capturedRw.writeUnlock(), "captured rwlock final writeUnlock failed"

println("concurrency ok")
