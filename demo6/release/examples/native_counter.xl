class Counter
    int value = 0

    create(int seed)
        self.value = seed
    end

    func add(int delta) as int
        self.value += delta
        return self.value
    end
end

Counter counter = Counter(40)
assert counter.add(2) == 42, "counter add failed"

Buffer nativeData = Buffer()
assert nativeData.appendByte(42), "native-backed object failed"
assert nativeData[0] == 42, "native-backed object item failed"

println("native_counter ok")
