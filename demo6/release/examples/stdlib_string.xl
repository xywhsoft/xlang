string title = "XLang DEMO6"
string utf = "1234你好"

assert(string.len(utf) == 6)
assert(string.byteLen(utf) == 10)
println("length=ok")

assert(string.compare(title, "xlang demo6", true) == 0)
assert(string.equals(title, "xlang demo6", true))
assert(string.contains(title, "lang", true))
assert(string.indexOf(title, "DEMO") == 6)
assert(string.lastIndexOf("ab你好cd你好", "你好") == 6)
assert(string.count("ab你好cd你好", "你好") == 2)
assert(string.startsWith(title, "xlang", true))
assert(string.endsWith(title, "6"))
assert(string.hasAny(title, " -_"))
assert(string.like("readme.md", "*.md"))
assert(string.approx("xlang", "xlang"))
assert(string.sim(title, "XLang DEMO6") ~= 1.0)
assert(string.isUtf8("中文 UTF-8"))
println("search=ok")

assert(int.format(1234567, ",") == "1,234,567")
assert(int.format(42, "04") == "0042")
uint64 sampleU64 = uint64(255)
assert(int.format(sampleU64, "X") == "FF")
assert(string.format(42, "04") == "0042")
assert(string.format(sampleU64, "X") == "FF")
assert(string.format(0.125, ".1%") == "12.5%")
assert(float.format(12.345, ".2") == "12.35")
assert(float.format(0.125, ".1%") == "12.5%")
println("format=ok")

assert(string.lower(title) == "xlang demo6")
assert(string.upper(title) == "XLANG DEMO6")
assert(string.trim("  xlang  ") == "xlang")
assert(string.ltrim("  xlang  ") == "xlang  ")
assert(string.rtrim("  xlang  ") == "  xlang")
assert(string.trim("--xlang--", "-") == "xlang")
assert(string.filter("x-lang-demo", "-") == "xlangdemo")
assert(string.replace("a-b-c", "-", "/") == "a/b/c")
println("case_trim=ok")

// 第三个参数是 UTF-8 字符数量，不是结束索引。
assert(string.slice("ab你好cd", 2, 2) == "你好")
int sliceStart = 2
int sliceEnd = 4
assert(string.slice("ab你好cd", sliceStart, sliceEnd - sliceStart) == "你好")
assert(string.slice("ab你好cd", -2) == "cd")
assert(string.left("ab你好", 3) == "ab你")
assert(string.right("ab你好", 2) == "你好")
assert(string.mid("ab你好cd", 2, 2) == "你好")
assert(string.charAt("A你B", 1) == '你')
assert(string.byteAt("A你", 1) == 228)
println("slice=ok")

assert(string.join(["red", "green", "blue"], "|") == "red|green|blue")
assert(string.repeat("ha", 3) == "hahaha")
assert(string.isEmpty(""))
assert(not string.isEmpty(" "))
assert(string.isBlank(" \t"))
assert(not string.isBlank(" x "))
assert(string.remove("a-b-c", "-") == "abc")
assert(string.removeAt("ab你好cd", 2, 2) == "abcd")
assert(string.insert("abcd", 2, "你好") == "ab你好cd")
assert(string.padLeft("x", 3, ".") == "..x")
assert(string.padRight("x", 3, ".") == "x..")
assert(string.padCenter("x", 5, ".") == "..x..")
assert(string.reverse("ab你好") == "好你ba")
println("edit=ok")

array parts = string.split("x-lang-demo", "-")
assert(parts.length == 3)
assert(string(parts[0]) == "x")
assert(string(parts[1]) == "lang")
assert(string(parts[2]) == "demo")

array lines = string.splitLines("a\nb\nc")
assert(lines.length == 3)
assert(string(lines[0]) == "a")
assert(string(lines[1]) == "b")
assert(string(lines[2]) == "c")
println("split=ok")

array<char> chars = string.chars("A你")
assert(chars.length == 2)
assert(string(chars[0]) == "A")
assert(string(chars[1]) == "你")

bytes octets = string.bytes("A你")
assert(octets.length == 4)
assert(int(octets[0]) == 65)
assert(int(octets[1]) == 228)
assert(int(octets[2]) == 189)
assert(int(octets[3]) == 160)
println("arrays=ok")

string iterText = ""
for c in "A你B"
    iterText = iterText + c
end
assert(iterText == "A你B")

int indexSum = 0
for i, c in "A你B"
    indexSum = indexSum + i
end
assert(indexSum == 3)
println("iteration=ok")
