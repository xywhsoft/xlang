func hello(string method, string path, string query, string body) as string
    if method == "GET" and path == "/legacy" then
        return "legacy handler"
    end
    return "xlang http server"
end

func route(point reqHandle, point respHandle) as bool
    HttpRequest req = HttpRequest(reqHandle)
    HttpResponse resp = HttpResponse(respHandle)

    resp.header("X-Server", "xlang")

    if req.method() == "GET" and req.path() == "/hello" then
        return resp.text("hello from xlang")
    end

    if req.method() == "GET" and req.param("id") == "42" then
        if req.queryValue("name") == "xlang" then
            return resp.text("user 42 xlang")
        end
        return resp.text("user 42")
    end

    if req.method() == "POST" and req.path() == "/echo" then
        return resp.text(req.body())
    end

    if req.path() == "/json" then
        return resp.jsonText("{\"ok\":true}")
    end

    if req.path() == "/any" then
        return resp.text(req.method())
    end

    resp.status(404)
    return resp.text("not found")
end

func(string, string, string, string) as string handler = hello
func(point, point) as bool requestHandler = route

dir.createAll("release/tmp/example_http_static")
file.writeText("release/tmp/example_http_static/index.txt", "static from xlang")

point server = http.server.create(8080)
http.server.get(server, "/legacy", handler)
http.server.post(server, "/legacy-post", handler)
http.server.any(server, "/legacy-any", handler)
http.server.getRequest(server, "/hello", requestHandler)
http.server.getRequest(server, "/users/{id}", requestHandler)
http.server.postRequest(server, "/echo", requestHandler)
http.server.anyRequest(server, "/any", requestHandler)
http.server.anyRequest(server, "/json", requestHandler)
http.server.static(server, "/public", "release/tmp/example_http_static")
assert http.server.mimeByPath("data.json") == "application/json; charset=utf-8", "mimeByPath should inspect extension"

if http.server.start(server) then
    int boundPort = http.server.port(server)
    auto portText = boundPort.toString()
    time.sleep(1000)
    http.server.stop(server)
end

http.server.destroy(server)
file.delete("release/tmp/example_http_static/index.txt")
dir.delete("release/tmp/example_http_static")
