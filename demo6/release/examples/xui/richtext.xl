// richtext.xl — 富文本：RichEdit 控件
import xui

xui.XuiApp g_app

func onFrame()
    g_app.frame(0xE5232823)
end

func main(...) as int
    g_app = xui.XuiApp(800, 500, "RichEdit Demo")
    point ctx = g_app.context()
    point font = g_app.font()
    xui.Widget root = xui.Widget(g_app.rootHandle())

    xui.Label title = xui.Label(ctx, "RichEdit Demo", font)
    root.addChild(title)

    xui.RichEdit rich = xui.RichEdit(ctx, font)
    rich.setFlex(1.0, 1.0)
    root.addChild(rich)

    xui.Label hint = xui.Label(ctx, "Rich text editing area", font)
    root.addChild(hint)

    g_app.run(onFrame)
    return 0
end
