// breadcrumb.xl — 面包屑：Breadcrumb 控件（多级路径）
import xui

xui.XuiApp g_app

func onFrame()
    g_app.frame(0xE5232823)
end

func main(...) as int
    g_app = xui.XuiApp(800, 500, "Breadcrumb Demo")
    point ctx = g_app.context()
    point font = g_app.font()
    xui.Widget root = xui.Widget(g_app.rootHandle())

    xui.Label title = xui.Label(ctx, "Breadcrumb Demo", font)
    root.addChild(title)

    xui.Breadcrumb bc = xui.Breadcrumb(ctx)
    bc.setPreferredSize(700.0, 36.0)

    // (widget, text, clickable, value)
    xui.xuiBreadcrumbAddItem(bc.handle, "Home", 1, 0)
    xui.xuiBreadcrumbAddItem(bc.handle, "Projects", 1, 1)
    xui.xuiBreadcrumbAddItem(bc.handle, "x-lang", 1, 2)
    xui.xuiBreadcrumbAddItem(bc.handle, "extlibs", 0, 3)

    root.addChild(bc)

    g_app.run(onFrame)
    return 0
end
