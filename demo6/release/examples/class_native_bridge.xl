func demoSize() as int
    Buffer buffer = Buffer()
    assert buffer.appendByte(42), "appendByte failed"
    assert buffer.append("xy"), "append text failed"
    buffer[1] = 65
    return buffer[0] + buffer[1] + buffer.len()
end

assert demoSize() == 110, "native bridge result failed"
println("class_native_bridge ok")
