func require(string name, bool ok)
    assert ok, name + " failed"
    println(name + "=ok")
end

assert process.stdin == 0 and process.stdout == 1 and process.stderr == 2
assert process.stdioInherit == 0 and process.stdioPipe == 1 and process.stdioNull == 2
assert process.stateRunning == 0 and process.stateExited == 1
bool terminalAvailable = process.terminalSupported()
assert terminalAvailable or not terminalAvailable

string text = process.exec("cmd /c echo hello-process")
require("shell",
    string.trim(text) == "hello-process" and
    process.success("cmd /c exit /b 0") and
    !process.success("cmd /c exit /b 5") and
    process.exitCode("cmd /c exit /b 0") == 0 and
    process.exitCode("cmd /c exit /b 5") == 5)

ProcessResult runResult = process.run("cmd /c echo process-run")
require("run",
    runResult.success and
    runResult.exitCode == 0 and
    !runResult.timedOut and
    !runResult.spawnFailed and
    string.trim(runResult.stdout) == "process-run" and
    string.trim(runResult.stderr) == "")

ProcessCommand configured = process.shell("cmd /c echo %XL6_PROCESS_EXAMPLE%")
configured.env("XL6_PROCESS_EXAMPLE", "configured")
configured.readChunkSize(1024)
configured.maxEventCount(64)
ProcessResult configuredResult = process.run(configured, "", 5000)
var configuredExit = configuredResult.exitInfo()
require("configured",
    configuredResult.success and
    string.trim(configuredResult.stdout) == "configured" and
    int(configuredExit["exitCode"]) == 0)

ProcessResult fileResult = process.runFile("cmd", ["/c", "echo", "process-file"])
require("runFile",
    fileResult.success and
    fileResult.exitCode == 0 and
    string.trim(fileResult.stdout) == "process-file")

PipelineResult pipe = process.pipeline([
    process.shell("cmd /c echo alpha"),
    process.cmd("cmd", ["/c", "findstr alpha"])
])
ProcessResult pipeStage = pipe.result(1)
require("pipeline",
    pipe.success and
    pipe.exitCode == 0 and
    pipe.failedIndex == -1 and
    pipe.count == 2 and
    pipe.completedCount == 2 and
    string.trim(pipe.stdout) == "alpha" and
    pipeStage.success)

PipelineResult failedPipe = process.pipeline([
    process.shell("cmd /c exit /b 5"),
    process.shell("cmd /c echo should-not-run")
])
ProcessResult failedStage = failedPipe.result(0)
require("pipelineFail",
    !failedPipe.success and
    failedPipe.exitCode == 0 and
    failedPipe.failedIndex == 0 and
    failedPipe.count == 2 and
    failedPipe.completedCount == 2 and
    failedStage.exitCode == 5)

Process proc = process.startFile("cmd", ["/c", "more"])
proc.writeLine("live-process")
proc.closeStdin()
Process shellProc = process.start("cmd /c more")
shellProc.writeLine("shell-process")
shellProc.closeStdin()
require("process",
    proc.wait(5000) and
    !proc.running and
    proc.exitCode == 0 and
    string.trim(proc.stdout) == "live-process" and
    shellProc.wait(5000) and
    !shellProc.running and
    shellProc.exitCode == 0 and
    string.trim(shellProc.stdout) == "shell-process")

ProcessCommand incrementalCommand = process.shell("cmd /c echo incremental-out ^& echo incremental-err 1^>^&2")
Process incremental = process.start(incrementalCommand)
incremental.wait(5000)
var incrementalOut = incremental.readStdout(0, 4)
var incrementalErr = incremental.readStderr()
var incrementalEvents = incremental.readEvents()
var incrementalExit = incremental.exitInfo()
require("incremental",
    string(incrementalOut["data"]) == "incr" and
    int(incrementalOut["nextOffset"]) == 4 and
    string.trim(string(incrementalErr["data"])) == "incremental-err" and
    int(incrementalEvents["eventEndSeq"]) >= int(incrementalEvents["nextSeq"]) and
    bool(incrementalEvents["done"]) and
    int(incrementalExit["exitCode"]) == 0)
