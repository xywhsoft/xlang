string text = "A\0你好"
assert encoding.unitSize(encoding.utf32LE) == 4
assert encoding.name(encoding.utf16BE) == "utf-16be"
assert encoding.isUtf8(text)
assert not encoding.isUtf8(b"\xFF")
println("validate=ok")

bytes utf16 = encoding.encode(text, encoding.utf16LE)
assert utf16 == b"A\0\0\0\x60\x4F\x7D\x59"
assert encoding.decode(utf16, encoding.utf16LE) == text
println("utf16=ok")

bytes utf8 = encoding.transcode(utf16, encoding.utf16LE, encoding.utf8)
assert encoding.decode(utf8) == text
println("convert=ok")

bytes be16 = encoding.encodeUtf16BE(text)
bytes le32 = encoding.encodeUtf32LE(text)
bytes be32 = encoding.encodeUtf32BE(text)
assert encoding.decodeUtf8(encoding.encodeUtf8(text)) == text
assert encoding.decodeUtf16LE(utf16) == text
assert encoding.decodeUtf16BE(be16) == text
assert encoding.decodeUtf32LE(le32) == text
assert encoding.decodeUtf32BE(be32) == text
assert encoding.transcode(be16, encoding.utf16BE, encoding.utf16LE) == utf16
assert encoding.transcode(le32, encoding.utf32LE, encoding.utf32BE) == be32
println("explicit=ok")
