export "app_counter" var int counter = 0
export "app_version" const int version = 1

export "app_set_counter" func setCounter(int value)
    counter = value
end

export "app_get_counter" func getCounter() as int
    return counter
end

setCounter(41)
assert getCounter() == 41, "c_variables get failed"
counter += version
assert getCounter() == 42, "c_variables version failed"
println("c_variables ok")
