string requestId = id.xid()

assert string.len(requestId) == 32, "xid length mismatch"

string localIP = net.localIP()
string localMAC = net.localMAC()
string localName = net.localName()

assert string.len(localIP) >= 0, "localIP should return a string"
assert string.len(localMAC) >= 0, "localMAC should return a string"
assert string.len(localName) >= 0, "localName should return a string"

println("id_net=ok")
