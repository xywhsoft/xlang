func require(string name, bool condition)
    if not condition then
        println("FAILED: " + name)
        assert false
    end
end

string requestId = id.xid()

require("xid_length", string.len(requestId) == 32)

Xid original = id.make()
string encoded = original.toString()
Xid decoded = id.parse(encoded)
require("xid_valid", not original.isZero() and not decoded.isZero())
require("xid_roundtrip", original == decoded)
require("xid_compare", original.compare(decoded) == 0)
require("xid_invalid", id.tryParse("invalid") == null)

string localIP = net.localIP()
string localMAC = net.localMAC()
string localName = net.localName()

require("local_ip", string.len(localIP) >= 0)
require("local_mac", string.len(localMAC) >= 0)
require("local_name", string.len(localName) >= 0)

NetAddress resolved = net.resolve("127.0.0.1", 80)
require("resolve", resolved.port == 80 and resolved.text() != "")

NetProxy socksProxy = net.proxy(NetProxyType.socks5, "127.0.0.1", 1080)
NetProxy httpProxy = net.proxy(NetProxyType.httpConnect, "127.0.0.1", 8080)
require("proxy_socks", socksProxy.type == NetProxyType.socks5)
require("proxy_http", httpProxy.type == NetProxyType.httpConnect)

auto stream = TcpStreamOptions().withConnectTimeoutMillis(100).withWriteWatermarks(4096, 1024, 8192).withReadBuffer(1024, 8192)
require("connect_timeout", stream.connectTimeoutMillis == 100)
require("connect_watermarks", stream.writeHighWater == 4096 and stream.writeLowWater == 1024)
require("connect_recv_limit", stream.readLimit == 8192)
auto listen = TcpListenOptions(NetAddress.loopback()).withBacklog(16).withStreamOptions(stream)
require("listen_backlog", listen.backlog == 16)
require("listen_watermarks", listen.streamOptions().writeHighWater == 4096)
require("listen_recv_limit", listen.streamOptions().readLimit == 8192)
auto udpConfig = UdpConfig().withReceive(8192, 2, 8).withReceiveQueue(64, 65536, UdpOverflow.error)
require("udp_batch", udpConfig.receiveBatch == 8)
require("udp_queues", udpConfig.receiveQueueLimit == 64)

NetEngine engine = net.engine(1)
engine.start()
require("engine_start", engine.state == NetEngineState.running)
engine.close()
require("engine_close", engine.wait(5000))

println("id_net=ok")
