auto text = "xlang"
auto hex = codec.hexEncode(text)
assert hex == "786c616e67", "hex encode failed"
assert encoding.decodeUtf8(codec.hexDecode(hex)) == text, "hex decode failed"
auto b64 = codec.base64Encode(text)
assert b64 == "eGxhbmc=", "base64 encode failed"
assert encoding.decodeUtf8(codec.base64Decode(b64)) == text, "base64 decode failed"
auto escaped = codec.percentEncode("alice bob/ok")
assert escaped == "alice%20bob%2Fok", "percent encode failed"
assert codec.percentDecode(escaped) == b"alice bob/ok", "percent decode failed"
bytes raw = b"\0\xffAZ"
assert codec.hexEncode(raw, flags = codec.hexUpper) == "00FF415A"
assert codec.hexDecode("00FF415A") == raw
assert codec.base64Decode(codec.base64Encode(raw)) == raw
assert codec.percentDecode(codec.percentEncode(raw)) == raw
println("codec=ok")
