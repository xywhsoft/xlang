// ch19 — 渲染线程：主线程与渲染线程协作示意
import xge

func draw_scene()
    // 主线程管道（上方）
    xge.xgeShapeRectFill(c_float(50), c_float(100), c_float(700), c_float(80), xge.XGE_COLOR_RGBA(c_uint(25), c_uint(40), c_uint(55), c_uint(255)))
    xge.xgeShapeRectStroke(c_float(50), c_float(100), c_float(700), c_float(80), c_float(1.5), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(150)))

    // 主线程阶段块
    int i = 0
    while i < 4
        float x = 70.0 + float(i) * 170.0
        xge.xgeShapeRectFill(c_float(x), c_float(120), c_float(140), c_float(40), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(180)))
        i = i + 1
    end

    // 渲染线程管道（下方）
    xge.xgeShapeRectFill(c_float(50), c_float(280), c_float(700), c_float(80), xge.XGE_COLOR_RGBA(c_uint(40), c_uint(30), c_uint(20), c_uint(255)))
    xge.xgeShapeRectStroke(c_float(50), c_float(280), c_float(700), c_float(80), c_float(1.5), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(150)))

    // 渲染线程阶段块
    i = 0
    while i < 3
        float x = 150.0 + float(i) * 200.0
        xge.xgeShapeRectFill(c_float(x), c_float(300), c_float(160), c_float(40), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(180)))
        i = i + 1
    end

    // 命令缓冲区（连接线）
    xge.xgeShapeLine(c_float(400), c_float(180), c_float(400), c_float(280), c_float(2.0), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(107), c_uint(94), c_uint(200)))
    xge.xgeShapeLine(c_float(400), c_float(180), c_float(390), c_float(195), c_float(2.0), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(107), c_uint(94), c_uint(200)))
    xge.xgeShapeLine(c_float(400), c_float(180), c_float(410), c_float(195), c_float(2.0), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(107), c_uint(94), c_uint(200)))

    // 时间轴箭头
    xge.xgeShapeLine(c_float(50), c_float(450), c_float(750), c_float(450), c_float(1.5), xge.XGE_COLOR_RGBA(c_uint(200), c_uint(210), c_uint(220), c_uint(120)))
    xge.xgeShapeLine(c_float(750), c_float(450), c_float(735), c_float(443), c_float(1.5), xge.XGE_COLOR_RGBA(c_uint(200), c_uint(210), c_uint(220), c_uint(120)))
    xge.xgeShapeLine(c_float(750), c_float(450), c_float(735), c_float(457), c_float(1.5), xge.XGE_COLOR_RGBA(c_uint(200), c_uint(210), c_uint(220), c_uint(120)))

    // 帧标记
    i = 0
    while i < 5
        float x = 100.0 + float(i) * 150.0
        xge.xgeShapeLine(c_float(x), c_float(440), c_float(x), c_float(460), c_float(1.0), xge.XGE_COLOR_RGBA(c_uint(200), c_uint(210), c_uint(220), c_uint(100)))
        i = i + 1
    end
end

func on_frame()
    xge.xgeTutorialBeginFrame(xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(255)))
    draw_scene()
    xge.xgeTutorialEndFrame()
end

func main(...) as int
    c_int ret = xge.xgeTutorialInit(840, 640, "ch19")
    if ret != c_int(0) then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.xgeTutorialRun(on_frame)
    return 0
end
