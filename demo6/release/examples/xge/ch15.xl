// ch15 — 透视投影：2.5D 透视效果
import xge

func draw_scene()
    // 用梯形模拟透视地面网格
    // 远处窄，近处宽
    int i = 0
    while i < 8
        float t = float(i) / 8.0
        float y = 150.0 + t * 350.0
        float halfW = 50.0 + t * 350.0
        float cx = 400.0
        int alpha = 80 + int(t * 120.0)

        // 横线
        xge.Shape.line(cx - halfW, y, cx + halfW, y, 1.0,
            xge.Color.rgba(79, 216, 194, alpha))
        i = i + 1
    end

    // 纵向汇聚线（灭点在中心上方）
    i = -3
    while i <= 3
        float topX = 400.0 + float(i) * 15.0
        float botX = 400.0 + float(i) * 120.0
        xge.Shape.line(topX, 150, botX, 500, 1.0,
            xge.Color.rgba(79, 216, 194, 100))
        i = i + 1
    end

    // 灭点标记
    xge.Shape.circleFill(400, 150, 5, xge.Color.rgba(255, 180, 84, 255))

    // 透视缩放的物体（远小近大）
    xge.Shape.circleFill(350, 200, 10, xge.Color.rgba(255, 107, 94, 200))
    xge.Shape.circleFill(300, 350, 25, xge.Color.rgba(255, 107, 94, 220))
    xge.Shape.circleFill(250, 470, 40, xge.Color.rgba(255, 107, 94, 255))
end

func on_frame()
    xge.XgeApp.beginFrame(xge.Color.rgba(13, 17, 22, 255))
    draw_scene()
    xge.XgeApp.endFrame()
end

func main(...) as int
    int ret = xge.XgeApp.init(840, 640, "ch15")
    if ret != 0 then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.XgeApp.run(on_frame)
    return 0
end
