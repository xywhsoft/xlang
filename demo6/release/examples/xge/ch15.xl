// ch15 — 透视投影：2.5D 透视效果
import xge

func draw_scene()
    // 用梯形模拟透视地面网格
    // 远处窄，近处宽
    int i = 0
    while i < 8
        float t = float(i) / 8.0
        float y = 150.0 + t * 350.0
        float halfW = 50.0 + t * 350.0
        float cx = 400.0
        c_uint alpha = c_uint(80 + int(t * 120.0))

        // 横线
        xge.xgeShapeLine(c_float(cx - halfW), c_float(y), c_float(cx + halfW), c_float(y), c_float(1.0),
            xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), alpha))
        i = i + 1
    end

    // 纵向汇聚线（灭点在中心上方）
    i = -3
    while i <= 3
        float topX = 400.0 + float(i) * 15.0
        float botX = 400.0 + float(i) * 120.0
        xge.xgeShapeLine(c_float(topX), c_float(150), c_float(botX), c_float(500), c_float(1.0),
            xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(100)))
        i = i + 1
    end

    // 灭点标记
    xge.xgeShapeCircleFill(c_float(400), c_float(150), c_float(5), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(255)))

    // 透视缩放的物体（远小近大）
    xge.xgeShapeCircleFill(c_float(350), c_float(200), c_float(10), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(107), c_uint(94), c_uint(200)))
    xge.xgeShapeCircleFill(c_float(300), c_float(350), c_float(25), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(107), c_uint(94), c_uint(220)))
    xge.xgeShapeCircleFill(c_float(250), c_float(470), c_float(40), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(107), c_uint(94), c_uint(255)))
end

func on_frame()
    xge.xgeTutorialBeginFrame(xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(255)))
    draw_scene()
    xge.xgeTutorialEndFrame()
end

func main(...) as int
    c_int ret = xge.xgeTutorialInit(840, 640, "ch15")
    if ret != c_int(0) then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.xgeTutorialRun(on_frame)
    return 0
end
