// ch03 — 帧循环：旋转图形（静态截取一帧）
import xge

func draw_scene()
    float cx = 400.0
    float cy = 300.0
    float angle = 45.0 * math.pi / 180.0  // 模拟旋转 45°
    float r = 120.0

    // 绘制旋转正方形的 4 条边
    int i = 0
    while i < 4
        float a0 = angle + float(i) * math.pi / 2.0
        float a1 = angle + float(i + 1) * math.pi / 2.0
        float x0 = cx + r * math.cos(a0)
        float y0 = cy + r * math.sin(a0)
        float x1 = cx + r * math.cos(a1)
        float y1 = cy + r * math.sin(a1)
        xge.xgeShapeLine(c_float(x0), c_float(y0), c_float(x1), c_float(y1), c_float(3.0), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(255)))
        i = i + 1
    end

    // 中心点
    xge.xgeShapeCircleFill(c_float(cx), c_float(cy), c_float(6), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(255)))

    // 旋转轴指示线
    xge.xgeShapeLine(c_float(cx), c_float(cy), c_float(cx + r * math.cos(angle)), c_float(cy + r * math.sin(angle)),
        c_float(1.5), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(107), c_uint(94), c_uint(200)))

    // 轨迹圆
    xge.xgeShapeCircleStroke(c_float(cx), c_float(cy), c_float(r), c_float(1.0), xge.XGE_COLOR_RGBA(c_uint(100), c_uint(120), c_uint(140), c_uint(120)))
end

func on_frame()
    xge.xgeTutorialBeginFrame(xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(255)))
    draw_scene()
    xge.xgeTutorialEndFrame()
end

func main(...) as int
    c_int ret = xge.xgeTutorialInit(840, 640, "ch03")
    if ret != c_int(0) then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.xgeTutorialRun(on_frame)
    return 0
end
