// ch26 — 椭圆：行星轨道
import xge

func draw_scene()
    float cx = 400.0
    float cy = 300.0
    float angle = 0.8

    // 横向椭圆
    xge.Shape.ellipseFill(200, 150, 120, 60, xge.Color.rgba(79, 216, 194, 200))

    // 纵向椭圆
    xge.Shape.ellipseFill(600, 150, 40, 100, xge.Color.rgba(255, 180, 84, 200))

    // 轨道
    xge.Shape.ellipseStroke(cx, cy, 250, 120, 1.5, xge.Color.rgba(100, 120, 140, 150))

    // 中心恒星
    xge.Shape.circleFill(cx, cy, 25, xge.Color.rgba(255, 180, 84, 255))

    // 行星
    xge.Shape.circleFill(cx + 250.0 * math.cos(angle), cy + 120.0 * math.sin(angle), 12, xge.Color.rgba(109, 179, 242, 255))

    // 角色阴影
    xge.Shape.ellipseFill(400, 520, 40, 12, xge.Color.rgba(0, 0, 0, 96))
    xge.Shape.circleFill(400, 460, 30, xge.Color.rgba(255, 107, 94, 255))
end

func on_frame()
    xge.XgeApp.beginFrame(xge.Color.rgba(13, 17, 22, 255))
    draw_scene()
    xge.XgeApp.endFrame()
end

func main(...) as int
    int ret = xge.XgeApp.init(840, 640, "ch26")
    if ret != 0 then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.XgeApp.run(on_frame)
    return 0
end
