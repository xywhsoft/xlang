// ch04 — 手动渲染模式：离屏渲染圆形
import xge

func draw_scene()
    // 大圆形（教程示例中的琥珀色圆）
    xge.xgeShapeCircleFill(c_float(400), c_float(300), c_float(150), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(255)))

    // 内圈装饰
    xge.xgeShapeCircleStroke(c_float(400), c_float(300), c_float(100), c_float(2.0), xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(180)))
    xge.xgeShapeCircleStroke(c_float(400), c_float(300), c_float(50), c_float(2.0), xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(120)))

    // 中心点
    xge.xgeShapeCircleFill(c_float(400), c_float(300), c_float(8), xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(200)))

    // 边框表示离屏帧缓冲
    xge.xgeShapeRectStroke(c_float(50), c_float(30), c_float(700), c_float(540), c_float(1.5), xge.XGE_COLOR_RGBA(c_uint(100), c_uint(120), c_uint(140), c_uint(150)))
end

func on_frame()
    xge.xgeTutorialBeginFrame(xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(255)))
    draw_scene()
    xge.xgeTutorialEndFrame()
end

func main(...) as int
    c_int ret = xge.xgeTutorialInit(840, 640, "ch04")
    if ret != c_int(0) then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.xgeTutorialRun(on_frame)
    return 0
end
