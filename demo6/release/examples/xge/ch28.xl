// ch28 — 胶囊形：按钮 + 进度条
import xge

func draw_scene()
    // 水平胶囊按钮
    xge.xgeShapeCapsuleFill(c_float(300), c_float(100), c_float(200), c_float(50), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(255)))

    // 描边胶囊
    xge.xgeShapeCapsuleStroke(c_float(300), c_float(180), c_float(200), c_float(50), c_float(2.0), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(255)))

    // 进度条
    xge.xgeShapeCapsuleFill(c_float(100), c_float(300), c_float(600), c_float(24), xge.XGE_COLOR_RGBA(c_uint(51), c_uint(51), c_uint(51), c_uint(255)))
    xge.xgeShapeCapsuleFill(c_float(100), c_float(300), c_float(390), c_float(24), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(255)))

    // 垂直胶囊
    xge.xgeShapeCapsuleFill(c_float(150), c_float(380), c_float(40), c_float(160), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(107), c_uint(94), c_uint(255)))

    // 正方形 → 圆形
    xge.xgeShapeCapsuleFill(c_float(250), c_float(400), c_float(80), c_float(80), xge.XGE_COLOR_RGBA(c_uint(109), c_uint(179), c_uint(242), c_uint(255)))
end

func on_frame()
    xge.xgeTutorialBeginFrame(xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(255)))
    draw_scene()
    xge.xgeTutorialEndFrame()
end

func main(...) as int
    c_int ret = xge.xgeTutorialInit(840, 640, "ch28")
    if ret != c_int(0) then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.xgeTutorialRun(on_frame)
    return 0
end
