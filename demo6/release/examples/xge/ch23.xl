// ch23 — 圆形：填充、描边、同心靶心
import xge

func draw_scene()
    // 实心圆
    xge.xgeShapeCircleFill(c_float(200), c_float(200), c_float(80), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(255)))

    // 空心圆环
    xge.xgeShapeCircleStroke(c_float(200), c_float(200), c_float(110), c_float(4.0), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(255)))

    // 同心圆靶心
    int i = 5
    while i >= 1
        c_uint col
        if i % 2 != 0 then
            col = xge.XGE_COLOR_RGBA(c_uint(255), c_uint(107), c_uint(94), c_uint(255))
        else
            col = xge.XGE_COLOR_RGBA(c_uint(255), c_uint(255), c_uint(255), c_uint(255))
        end
        xge.xgeShapeCircleFill(c_float(550), c_float(300), c_float(float(i) * 25.0), col)
        i = i - 1
    end

    // 多个不同大小的圆
    xge.xgeShapeCircleFill(c_float(150), c_float(450), c_float(30), xge.XGE_COLOR_RGBA(c_uint(109), c_uint(179), c_uint(242), c_uint(200)))
    xge.xgeShapeCircleFill(c_float(250), c_float(480), c_float(20), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(200)))
    xge.xgeShapeCircleFill(c_float(350), c_float(460), c_float(40), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(150)))
    xge.xgeShapeCircleStroke(c_float(500), c_float(480), c_float(35), c_float(2.0), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(107), c_uint(94), c_uint(200)))
end

func on_frame()
    xge.xgeTutorialBeginFrame(xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(255)))
    draw_scene()
    xge.xgeTutorialEndFrame()
end

func main(...) as int
    c_int ret = xge.xgeTutorialInit(840, 640, "ch23")
    if ret != c_int(0) then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.xgeTutorialRun(on_frame)
    return 0
end
