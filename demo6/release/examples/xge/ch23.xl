// ch23 — 圆形：填充、描边、同心靶心
import xge

func draw_scene()
    // 实心圆
    xge.Shape.circleFill(200, 200, 80, xge.Color.rgba(79, 216, 194, 255))

    // 空心圆环
    xge.Shape.circleStroke(200, 200, 110, 4.0, xge.Color.rgba(255, 180, 84, 255))

    // 同心圆靶心
    int i = 5
    while i >= 1
        uint32 col
        if i % 2 != 0 then
            col = xge.Color.rgba(255, 107, 94, 255)
        else
            col = xge.Color.rgba(255, 255, 255, 255)
        end
        xge.Shape.circleFill(550, 300, float(i) * 25.0, col)
        i = i - 1
    end

    // 多个不同大小的圆
    xge.Shape.circleFill(150, 450, 30, xge.Color.rgba(109, 179, 242, 200))
    xge.Shape.circleFill(250, 480, 20, xge.Color.rgba(255, 180, 84, 200))
    xge.Shape.circleFill(350, 460, 40, xge.Color.rgba(79, 216, 194, 150))
    xge.Shape.circleStroke(500, 480, 35, 2.0, xge.Color.rgba(255, 107, 94, 200))
end

func on_frame()
    xge.XgeApp.beginFrame(xge.Color.rgba(13, 17, 22, 255))
    draw_scene()
    xge.XgeApp.endFrame()
end

func main(...) as int
    int ret = xge.XgeApp.init(840, 640, "ch23")
    if ret != 0 then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.XgeApp.run(on_frame)
    return 0
end
