// ch17 — 视口与裁剪：分屏 + 滚动裁剪
import xge

func draw_scene()
    // 左半屏：玩家 1 视角
    xge.xgeShapeRectFill(c_float(10), c_float(30), c_float(380), c_float(540), xge.XGE_COLOR_RGBA(c_uint(10), c_uint(26), c_uint(32), c_uint(255)))
    xge.xgeShapeRectStroke(c_float(10), c_float(30), c_float(380), c_float(540), c_float(2.0), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(150)))
    // 玩家 1 内容
    xge.xgeShapeCircleFill(c_float(200), c_float(300), c_float(25), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(255)))
    xge.xgeShapeRectFill(c_float(50), c_float(450), c_float(300), c_float(20), xge.XGE_COLOR_RGBA(c_uint(42), c_uint(74), c_uint(63), c_uint(255)))

    // 右半屏：玩家 2 视角
    xge.xgeShapeRectFill(c_float(410), c_float(30), c_float(380), c_float(540), xge.XGE_COLOR_RGBA(c_uint(20), c_uint(16), c_uint(10), c_uint(255)))
    xge.xgeShapeRectStroke(c_float(410), c_float(30), c_float(380), c_float(540), c_float(2.0), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(150)))
    // 玩家 2 内容
    xge.xgeShapeCircleFill(c_float(600), c_float(300), c_float(25), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(255)))
    xge.xgeShapeRectFill(c_float(450), c_float(450), c_float(300), c_float(20), xge.XGE_COLOR_RGBA(c_uint(74), c_uint(60), c_uint(42), c_uint(255)))

    // 分隔线
    xge.xgeShapeLine(c_float(400), c_float(30), c_float(400), c_float(570), c_float(2.0), xge.XGE_COLOR_RGBA(c_uint(200), c_uint(210), c_uint(220), c_uint(100)))

    // 裁剪演示区域（右下角小窗）
    xge.xgeShapeRectFill(c_float(500), c_float(60), c_float(250), c_float(150), xge.XGE_COLOR_RGBA(c_uint(0), c_uint(0), c_uint(0), c_uint(150)))
    // 被裁剪的列表项（超出区域不显示）
    int i = 0
    while i < 6
        float y = 70.0 + float(i) * 30.0
        if y + 25.0 > 210.0 then
            // 超出裁剪区
            i = 6  // break
        else
            xge.xgeShapeRectFill(c_float(510), c_float(y), c_float(230), c_float(25), xge.XGE_COLOR_RGBA(c_uint(26), c_uint(42), c_uint(48), c_uint(255)))
            i = i + 1
        end
    end
    xge.xgeShapeRectStroke(c_float(500), c_float(60), c_float(250), c_float(150), c_float(1.0), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(107), c_uint(94), c_uint(180)))
end

func on_frame()
    xge.xgeTutorialBeginFrame(xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(255)))
    draw_scene()
    xge.xgeTutorialEndFrame()
end

func main(...) as int
    c_int ret = xge.xgeTutorialInit(840, 640, "ch17")
    if ret != c_int(0) then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.xgeTutorialRun(on_frame)
    return 0
end
