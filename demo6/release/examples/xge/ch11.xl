// ch11 — 清屏与颜色模型：颜色色板展示
import xge

func draw_scene()
    // 教程中列出的常用颜色
    c_uint c0 = xge.XGE_COLOR_RGBA(c_uint(8), c_uint(17), c_uint(20), c_uint(255))     // 深石油蓝
    c_uint c1 = xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(255))   // 琥珀色
    c_uint c2 = xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(255))   // 青绿色
    c_uint c3 = xge.XGE_COLOR_RGBA(c_uint(255), c_uint(107), c_uint(94), c_uint(255))   // 珊瑚红
    c_uint c4 = xge.XGE_COLOR_RGBA(c_uint(109), c_uint(179), c_uint(242), c_uint(255))  // 天蓝色
    c_uint c5 = xge.XGE_COLOR_RGBA(c_uint(160), c_uint(120), c_uint(255), c_uint(255))  // 紫色
    c_uint c6 = xge.XGE_COLOR_RGBA(c_uint(120), c_uint(220), c_uint(120), c_uint(255))  // 草绿色
    c_uint c7 = xge.XGE_COLOR_RGBA(c_uint(255), c_uint(220), c_uint(100), c_uint(255))  // 明黄色

    float sw = 160.0
    float sh = 100.0
    float gap = 20.0
    float startX = 60.0
    float startY = 80.0

    int i = 0
    while i < 8
        int col = i % 4
        int row = i / 4
        float x = startX + float(col) * (sw + gap)
        float y = startY + float(row) * (sh + gap + 40.0)
        c_uint color = c0
        if i == 1 then color = c1 end
        if i == 2 then color = c2 end
        if i == 3 then color = c3 end
        if i == 4 then color = c4 end
        if i == 5 then color = c5 end
        if i == 6 then color = c6 end
        if i == 7 then color = c7 end
        xge.xgeShapeRectFill(c_float(x), c_float(y), c_float(sw), c_float(sh), color)
        xge.xgeShapeRectStroke(c_float(x), c_float(y), c_float(sw), c_float(sh), c_float(1.5), xge.XGE_COLOR_RGBA(c_uint(200), c_uint(210), c_uint(220), c_uint(100)))
        i = i + 1
    end

    // Alpha 渐变条
    i = 0
    while i < 16
        c_uint a = c_uint(255 - i * 16)
        float x = 60.0 + float(i) * 43.0
        xge.xgeShapeRectFill(c_float(x), c_float(420.0), c_float(40), c_float(60), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), a))
        i = i + 1
    end
end

func on_frame()
    xge.xgeTutorialBeginFrame(xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(255)))
    draw_scene()
    xge.xgeTutorialEndFrame()
end

func main(...) as int
    c_int ret = xge.xgeTutorialInit(840, 640, "ch11")
    if ret != c_int(0) then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.xgeTutorialRun(on_frame)
    return 0
end
