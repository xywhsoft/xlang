// ch11 — 清屏与颜色模型：颜色色板展示
import xge

func draw_scene()
    // 教程中列出的常用颜色
    uint32 c0 = xge.Color.rgba(8, 17, 20, 255)     // 深石油蓝
    uint32 c1 = xge.Color.rgba(255, 180, 84, 255)   // 琥珀色
    uint32 c2 = xge.Color.rgba(79, 216, 194, 255)   // 青绿色
    uint32 c3 = xge.Color.rgba(255, 107, 94, 255)   // 珊瑚红
    uint32 c4 = xge.Color.rgba(109, 179, 242, 255)  // 天蓝色
    uint32 c5 = xge.Color.rgba(160, 120, 255, 255)  // 紫色
    uint32 c6 = xge.Color.rgba(120, 220, 120, 255)  // 草绿色
    uint32 c7 = xge.Color.rgba(255, 220, 100, 255)  // 明黄色

    float sw = 160.0
    float sh = 100.0
    float gap = 20.0
    float startX = 60.0
    float startY = 80.0

    int i = 0
    while i < 8
        int col = i % 4
        int row = i / 4
        float x = startX + float(col) * (sw + gap)
        float y = startY + float(row) * (sh + gap + 40.0)
        uint32 color = c0
        if i == 1 then color = c1 end
        if i == 2 then color = c2 end
        if i == 3 then color = c3 end
        if i == 4 then color = c4 end
        if i == 5 then color = c5 end
        if i == 6 then color = c6 end
        if i == 7 then color = c7 end
        xge.Shape.rectFill(x, y, sw, sh, color)
        xge.Shape.rectStroke(x, y, sw, sh, 1.5, xge.Color.rgba(200, 210, 220, 100))
        i = i + 1
    end

    // Alpha 渐变条
    i = 0
    while i < 16
        int a = 255 - i * 16
        float x = 60.0 + float(i) * 43.0
        xge.Shape.rectFill(x, 420.0, 40, 60, xge.Color.rgba(79, 216, 194, a))
        i = i + 1
    end
end

func on_frame()
    xge.XgeApp.beginFrame(xge.Color.rgba(13, 17, 22, 255))
    draw_scene()
    xge.XgeApp.endFrame()
end

func main(...) as int
    int ret = xge.XgeApp.init(840, 640, "ch11")
    if ret != 0 then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.XgeApp.run(on_frame)
    return 0
end
