// ch05 — 窗口管理：自适应居中圆形
import xge

func draw_scene()
    float cx = 400.0
    float cy = 300.0
    float r = 180.0  // 短边 600 * 0.3 = 180

    // 主圆形（青绿色填充）
    xge.xgeShapeCircleFill(c_float(cx), c_float(cy), c_float(r), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(255)))

    // 琥珀色描边（r+10）
    xge.xgeShapeCircleStroke(c_float(cx), c_float(cy), c_float(r + 10.0), c_float(3.0), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(255)))

    // 十字准线标识中心
    xge.xgeShapeLine(c_float(cx - 20.0), c_float(cy), c_float(cx + 20.0), c_float(cy), c_float(1.5), xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(180)))
    xge.xgeShapeLine(c_float(cx), c_float(cy - 20.0), c_float(cx), c_float(cy + 20.0), c_float(1.5), xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(180)))
end

func on_frame()
    xge.xgeTutorialBeginFrame(xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(255)))
    draw_scene()
    xge.xgeTutorialEndFrame()
end

func main(...) as int
    c_int ret = xge.xgeTutorialInit(840, 640, "ch05")
    if ret != c_int(0) then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.xgeTutorialRun(on_frame)
    return 0
end
