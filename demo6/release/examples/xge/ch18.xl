// ch18 — 按需渲染：静态工具界面
import xge

func draw_scene()
    // 工具栏背景
    xge.xgeShapeRectFill(c_float(0), c_float(0), c_float(800), c_float(40), xge.XGE_COLOR_RGBA(c_uint(25), c_uint(35), c_uint(45), c_uint(255)))

    // 工具栏按钮
    int i = 0
    while i < 5
        float x = 10.0 + float(i) * 55.0
        xge.xgeShapeRectFill(c_float(x), c_float(8), c_float(45), c_float(24), xge.XGE_COLOR_RGBA(c_uint(40), c_uint(55), c_uint(70), c_uint(255)))
        xge.xgeShapeRectStroke(c_float(x), c_float(8), c_float(45), c_float(24), c_float(1.0), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(80)))
        i = i + 1
    end

    // 主编辑区
    xge.xgeShapeRectFill(c_float(0), c_float(40), c_float(600), c_float(530), xge.XGE_COLOR_RGBA(c_uint(18), c_uint(24), c_uint(30), c_uint(255)))

    // 静态内容（网格线）
    i = 1
    while i < 6
        xge.xgeShapeLine(c_float(0), c_float(40.0 + float(i) * 88.0), c_float(600), c_float(40.0 + float(i) * 88.0),
            c_float(0.5), xge.XGE_COLOR_RGBA(c_uint(50), c_uint(65), c_uint(80), c_uint(100)))
        i = i + 1
    end
    i = 1
    while i < 8
        xge.xgeShapeLine(c_float(float(i) * 75.0), c_float(40), c_float(float(i) * 75.0), c_float(570),
            c_float(0.5), xge.XGE_COLOR_RGBA(c_uint(50), c_uint(65), c_uint(80), c_uint(100)))
        i = i + 1
    end

    // 右侧属性面板
    xge.xgeShapeRectFill(c_float(600), c_float(40), c_float(200), c_float(530), xge.XGE_COLOR_RGBA(c_uint(22), c_uint(30), c_uint(38), c_uint(255)))
    xge.xgeShapeLine(c_float(600), c_float(40), c_float(600), c_float(570), c_float(1.0), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(60)))

    // 属性面板条目
    i = 0
    while i < 6
        float y = 60.0 + float(i) * 45.0
        xge.xgeShapeRectFill(c_float(615), c_float(y), c_float(170), c_float(30), xge.XGE_COLOR_RGBA(c_uint(35), c_uint(48), c_uint(60), c_uint(255)))
        i = i + 1
    end

    // 状态栏
    xge.xgeShapeRectFill(c_float(0), c_float(570), c_float(800), c_float(30), xge.XGE_COLOR_RGBA(c_uint(25), c_uint(35), c_uint(45), c_uint(255)))
end

func on_frame()
    xge.xgeTutorialBeginFrame(xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(255)))
    draw_scene()
    xge.xgeTutorialEndFrame()
end

func main(...) as int
    c_int ret = xge.xgeTutorialInit(840, 640, "ch18")
    if ret != c_int(0) then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.xgeTutorialRun(on_frame)
    return 0
end
