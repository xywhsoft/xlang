// ch02 — 引擎初始化与窗口创建
import xge

c_uint BG_COLOR = xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(255))

func draw_scene()
    // 模拟窗口边框
    xge.xgeShapeRectStroke(c_float(100), c_float(60), c_float(600), c_float(480),
        c_float(2.0), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(255)))

    // 标题栏区域
    xge.xgeShapeRectFill(c_float(100), c_float(60), c_float(600), c_float(36),
        xge.XGE_COLOR_RGBA(c_uint(30), c_uint(40), c_uint(50), c_uint(255)))

    // 标题栏小圆点（窗口按钮）
    xge.xgeShapeCircleFill(c_float(120), c_float(78), c_float(6),
        xge.XGE_COLOR_RGBA(c_uint(255), c_uint(107), c_uint(94), c_uint(255)))
    xge.xgeShapeCircleFill(c_float(140), c_float(78), c_float(6),
        xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(255)))
    xge.xgeShapeCircleFill(c_float(160), c_float(78), c_float(6),
        xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(255)))

    // 客户区中心标识
    xge.xgeShapeCircleFill(c_float(400), c_float(320), c_float(40),
        xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(180)))
    xge.xgeShapeCircleStroke(c_float(400), c_float(320), c_float(55), c_float(2.0),
        xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(200)))

    // 尺寸标注线
    xge.xgeShapeLine(c_float(100), c_float(560), c_float(700), c_float(560), c_float(1.5),
        xge.XGE_COLOR_RGBA(c_uint(100), c_uint(120), c_uint(140), c_uint(255)))
    xge.xgeShapeLine(c_float(720), c_float(60), c_float(720), c_float(540), c_float(1.5),
        xge.XGE_COLOR_RGBA(c_uint(100), c_uint(120), c_uint(140), c_uint(255)))
end

func on_frame()
    xge.xgeTutorialBeginFrame(BG_COLOR)
    draw_scene()
    xge.xgeTutorialEndFrame()
end

func main(...) as int
    c_int ret = xge.xgeTutorialInit(840, 640, "ch02")
    if ret != c_int(0) then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.xgeTutorialRun(on_frame)
    return 0
end
