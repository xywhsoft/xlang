// ch27 — 扇形与弓形：饼图 + 冷却遮罩
import xge

func draw_scene()
    float pi = math.pi

    // 饼图数据
    float d0 = 0.35
    float d1 = 0.25
    float d2 = 0.20
    float d3 = 0.20

    uint32 c0 = xge.Color.rgba(79, 216, 194, 255)
    uint32 c1 = xge.Color.rgba(255, 180, 84, 255)
    uint32 c2 = xge.Color.rgba(255, 107, 94, 255)
    uint32 c3 = xge.Color.rgba(109, 179, 242, 255)

    float start = 0.0 - pi / 2.0

    // 饼图
    float endAngle = start + d0 * 2.0 * pi
    xge.Shape.pieFill(250, 280, 140, 140, start, endAngle, c0)
    start = endAngle
    endAngle = start + d1 * 2.0 * pi
    xge.Shape.pieFill(250, 280, 140, 140, start, endAngle, c1)
    start = endAngle
    endAngle = start + d2 * 2.0 * pi
    xge.Shape.pieFill(250, 280, 140, 140, start, endAngle, c2)
    start = endAngle
    endAngle = start + d3 * 2.0 * pi
    xge.Shape.pieFill(250, 280, 140, 140, start, endAngle, c3)

    // 技能冷却遮罩
    xge.Shape.circleFill(600, 200, 40, xge.Color.rgba(79, 216, 194, 255))
    xge.Shape.pieFill(600, 200, 40, 40,
        0.0 - pi / 2.0, 0.0 - pi / 2.0 + 0.7 * 2.0 * pi,
        xge.Color.rgba(0, 0, 0, 160))

    // 弓形
    xge.Shape.chordFill(600, 430, 100, 100, 0, pi,
        xge.Color.rgba(255, 180, 84, 128))
end

func on_frame()
    xge.XgeApp.beginFrame(xge.Color.rgba(13, 17, 22, 255))
    draw_scene()
    xge.XgeApp.endFrame()
end

func main(...) as int
    int ret = xge.XgeApp.init(840, 640, "ch27")
    if ret != 0 then
        println("XgeApp.init failed: " + string(ret))
        return 1
    end
    xge.XgeApp.run(on_frame)
    return 0
end
