// ch12 — 混合模式：加法混合发光效果
import xge

func draw_scene()
    // 底层圆形（正常 Alpha 混合）
    xge.xgeBlendSet(xge.XGE_BLEND_ALPHA)
    xge.xgeShapeCircleFill(c_float(400), c_float(280), c_float(100), xge.XGE_COLOR_RGBA(c_uint(79), c_uint(216), c_uint(194), c_uint(255)))

    // 切换为加法混合 → 重叠区域更亮
    xge.xgeBlendSet(xge.XGE_BLEND_ADD)
    xge.xgeShapeCircleFill(c_float(350), c_float(280), c_float(80), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(107), c_uint(94), c_uint(128)))
    xge.xgeShapeCircleFill(c_float(450), c_float(280), c_float(80), xge.XGE_COLOR_RGBA(c_uint(255), c_uint(180), c_uint(84), c_uint(128)))

    // 恢复默认
    xge.xgeBlendSet(xge.XGE_BLEND_ALPHA)

    // 下方：正片叠底阴影演示
    xge.xgeShapeRectFill(c_float(150), c_float(400), c_float(500), c_float(150), xge.XGE_COLOR_RGBA(c_uint(109), c_uint(179), c_uint(242), c_uint(255)))

    xge.xgeBlendSet(xge.XGE_BLEND_MULTIPLY)
    xge.xgeShapeRectFill(c_float(250), c_float(430), c_float(250), c_float(100), xge.XGE_COLOR_RGBA(c_uint(128), c_uint(128), c_uint(128), c_uint(255)))

    xge.xgeBlendSet(xge.XGE_BLEND_ALPHA)
end

func on_frame()
    xge.xgeTutorialBeginFrame(xge.XGE_COLOR_RGBA(c_uint(13), c_uint(17), c_uint(22), c_uint(255)))
    draw_scene()
    xge.xgeTutorialEndFrame()
end

func main(...) as int
    c_int ret = xge.xgeTutorialInit(840, 640, "ch12")
    if ret != c_int(0) then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.xgeTutorialRun(on_frame)
    return 0
end
