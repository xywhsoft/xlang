extern "expect_i64" func expect(int actual, int expected)
extern "native_add_i64" func nativeAdd(int left, int right) as int
extern "native_flip_bool" func nativeFlip(bool value) as bool
extern "host_counter" var int hostCounter

// extern 函数：xlang 声明 C 符号后直接调用。
expect(nativeAdd(20, 22), 42)
expect(nativeFlip(false), 1)

// extern 变量：xlang 可以读写 C 全局变量。
expect(hostCounter, 40)
hostCounter += 2
expect(hostCounter, 42)

// export 函数：生成给 C 调用的 ABI 符号。
export "xl6_feature_add_i64" func exportedAdd(int left, int right) as int
    return left + right
end

// export 多返回值：C 侧通过生成头文件中的 out 参数接收。
export "xl6_feature_pair_i64" func exportedPair(int seed) as (int, int)
    return seed, seed + 1
end

// export 变量：生成 C 可见全局符号。
export "xl6_feature_counter" var int exportedCounter = 1
export "xl6_feature_version" const int exportedVersion = 6

func getExportedTotal() as int
    return exportedCounter + exportedVersion
end

export "xl6_feature_get_total" func exportedTotal() as int
    return getExportedTotal()
end

// 导出的函数和变量在 xlang 内部仍可正常使用。
expect(exportedAdd(30, 12), 42)
expect(exportedTotal(), 7)
exportedCounter = 36
expect(exportedTotal(), 42)
