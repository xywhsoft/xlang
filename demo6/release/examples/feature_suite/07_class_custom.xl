extern "expect_i64" func expect(int actual, int expected)
extern "destroy_reset" func destroyReset()
extern "record_destroy" func recordDestroy(int value)
extern "destroy_count" func destroyCount() as int
extern "destroy_value" func destroyValue() as int
extern "counter_reset" func counterReset()
extern "counter_closed" func counterClosed() as int

// class：标准 OOP 数据类型，字段、构造、方法、析构。
class Point
    int x = 0
    int y = 0

    create(int x, int y)
        self.x = x
        self.y = y
    end

    func length2() as int
        return self.x * self.x + self.y * self.y
    end
end

Point point = Point(3, 4)
expect(point.length2(), 25)

// class 继承与 base 构造调用。
class Base
    int seed = 0

    create(int seed)
        self.seed = seed
    end

    func value() as int
        return self.seed
    end
end

class Child extends Base
    int extra = 0

    create(int seed, int extra)
        base(seed)
        self.extra = extra
    end

    func total() as int
        return self.value() + self.extra
    end
end

Child child = Child(10, 32)
expect(child.total(), 42)

// 方法重载与构造重载。
class Overloaded
    int value = 0

    create()
        self.value = 1
    end

    create(int value)
        self.value = value
    end

    func add(int right) as int
        return self.value + right
    end

    func add(string text) as int
        return self.value + int(text)
    end
end

auto defaultObject = Overloaded()
auto overloadedObject = Overloaded(40)
expect(defaultObject.add(2), 3)
expect(overloadedObject.add("2"), 42)

// 析构在作用域退出、return、break、continue 时自动执行。
class Tracker
    int value = 0

    create(int value)
        self.value = value
    end

    destroy()
        recordDestroy(self.value)
    end
end

func scopedDestroy()
    auto tracker = Tracker(77)
    expect(destroyCount(), 0)
end

func returnDestroy() as int
    auto tracker = Tracker(88)
    return 9
end

func breakDestroy()
    for i in range(0, 3)
        auto tracker = Tracker(100 + i)
        break
    end
end

func continueDestroy()
    for i in range(0, 2)
        auto tracker = Tracker(200 + i)
        continue
    end
end

destroyReset()
scopedDestroy()
expect(destroyCount(), 1)
expect(destroyValue(), 77)

expect(returnDestroy(), 9)
expect(destroyCount(), 2)
expect(destroyValue(), 88)

breakDestroy()
expect(destroyCount(), 3)
expect(destroyValue(), 100)

continueDestroy()
expect(destroyCount(), 5)
expect(destroyValue(), 201)

// native-backed class：把 C 句柄与 C 函数直接抽象为 xlang class。
class Counter
    native point handle
    extern "counter_open" create(int seed)
    extern "counter_close" destroy()
    extern "counter_add" func add(int value) as int
    extern "counter_value" func value() as int

    func isZero() as bool
        return self.value() == 0
    end
end

func nativeLifecycle()
    auto counter = Counter(40)
    expect(counter.add(2), 42)
    expect(counter.value(), 42)
    expect(counter.isZero(), 0)
end

counterReset()
nativeLifecycle()
expect(counterClosed(), 1)

// native-backed class 也可以只绑定已有 point，不额外负责内存管理。
class NativeView
    native point handle
end

point raw
NativeView view = NativeView(raw)
var boxedView = view
expect(type(boxedView) == NativeView, 1)
