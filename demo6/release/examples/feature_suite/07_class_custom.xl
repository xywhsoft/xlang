func expect(int actual, int expected)
    assert actual == expected, "expect int failed"
end

class DestroyLog
    int unused = 0
    static int count = 0
    static int value = 0

    static func reset()
        DestroyLog.count = 0
        DestroyLog.value = 0
    end

    static func record(int value)
        DestroyLog.count += 1
        DestroyLog.value = value
    end
end

func destroyReset()
    DestroyLog.reset()
end

func recordDestroy(int value)
    DestroyLog.record(value)
end

func destroyCount() as int
    return DestroyLog.count
end

func destroyValue() as int
    return DestroyLog.value
end

// class：标准 OOP 数据类型，字段、构造、方法、析构。
class Point
    int x = 0
    int y = 0

    create(int x, int y)
        self.x = x
        self.y = y
    end

    func length2() as int
        return self.x * self.x + self.y * self.y
    end
end

Point point = Point(3, 4)
expect(point.length2(), 25)

// class 继承与 base 构造调用。
class Base
    int seed = 0

    create(int seed)
        self.seed = seed
    end

    func value() as int
        return self.seed
    end
end

class Child extends Base
    int extra = 0

    create(int seed, int extra)
        base(seed)
        self.extra = extra
    end

    func total() as int
        return self.value() + self.extra
    end
end

Child child = Child(10, 32)
expect(child.total(), 42)

// 方法重载与构造重载。
class Overloaded
    int value = 0

    create()
        self.value = 1
    end

    create(int value)
        self.value = value
    end

    func add(int right) as int
        return self.value + right
    end

    func add(string text) as int
        return self.value + int(text)
    end
end

auto defaultObject = Overloaded()
auto overloadedObject = Overloaded(40)
expect(defaultObject.add(2), 3)
expect(overloadedObject.add("2"), 42)

// 析构在作用域退出、return、break、continue 时自动执行。
class Tracker
    int value = 0

    create(int value)
        self.value = value
    end

    destroy()
        recordDestroy(self.value)
    end
end

func scopedDestroy()
    auto tracker = Tracker(77)
    expect(destroyCount(), 0)
end

func returnDestroy() as int
    auto tracker = Tracker(88)
    return 9
end

func breakDestroy()
    for i in range(0, 3)
        auto tracker = Tracker(100 + i)
        break
    end
end

func continueDestroy()
    for i in range(0, 2)
        auto tracker = Tracker(200 + i)
        continue
    end
end

destroyReset()
scopedDestroy()
expect(destroyCount(), 1)
expect(destroyValue(), 77)

expect(returnDestroy(), 9)
expect(destroyCount(), 2)
expect(destroyValue(), 88)

breakDestroy()
expect(destroyCount(), 3)
expect(destroyValue(), 100)

continueDestroy()
expect(destroyCount(), 5)
expect(destroyValue(), 201)

// native-backed class：标准库对象同样走 class 体系，可以直接拥有 C 句柄。
func nativeBackedClass()
    Buffer buffer = Buffer()
    assert buffer.append("xlang"), "buffer append failed"
    expect(buffer.len(), 5)
    expect(buffer[0], 120)
end

nativeBackedClass()

// native-backed class 也可以只绑定已有 point，不额外负责内存管理。
class NativeView
    native point handle
end

point raw
NativeView view = NativeView(raw)
var boxedView = view
expect(type(boxedView) == NativeView, 1)
