func expect(int actual, int expected)
    assert actual == expected, "expect int failed"
end

func expectStr(string actual, string expected)
    assert actual == expected, "expect string failed"
end

// 动态容器字面量。
auto values = [1, 2, 3]
auto sparse = [0: "a", 2: "b"]
auto table = {"a": 10, "b": 20}
auto unique = {1, 2, 2, 3}
var dynamicTable = {"name": 31, "nested": {"count": 32}}

expect(values.length, 3)
expect(table.length, 2)
expect(sparse.length, 2)
expect(unique.length, 3)
expect(int(dynamicTable.name), 31)
expect(int(dynamicTable?.name), 31)
var missingDynamicField = dynamicTable?.missing ?? 33
expect(int(missingDynamicField), 33)

dynamicTable.extra = 34
dynamicTable.nested.count = 35

expect(int(dynamicTable.extra), 34)
expect(int(dynamicTable.nested.count), 35)

var dynamicUnique = unique
expect(dynamicUnique.length, 3)

int sparseLength = 0
for index, item in sparse
    sparseLength += 1
end

int uniqueLength = 0
for item in unique
    uniqueLength += 1
end

expect(sparseLength, 2)
expect(uniqueLength, 3)

expect(int(values[0]), 1)
expectStr(string(sparse[2]), "b")
expect(int(table["b"]), 20)
expect(2 in unique, 1)

// 显式容器前缀，空集合必须写 set{}，空字典可写 {} 或 dict{}。
auto explicitArray = array[4, 5]
auto explicitList = list[1: "x"]
dict emptyDict = {}
auto explicitDict = dict{"k": 8}
set emptySet = set{}
auto explicitSet = set{6, 7}

int explicitArrayCount = 0
for item in explicitArray
    explicitArrayCount += 1
end

int explicitListCount = 0
for index, item in explicitList
    explicitListCount += 1
end

int explicitSetCount = 0
for item in explicitSet
    explicitSetCount += 1
end

expect(explicitArrayCount, 2)
expect(explicitListCount, 1)
expect(emptyDict.length, 0)
expect(int(explicitDict["k"]), 8)
expect(emptySet.length, 0)
expect(explicitSetCount, 2)

// 索引读写、复合赋值、空赋值。
values[1] = 10
values[1] += 5
table["c"] ?= 30
table["c"] ?= 40

expect(int(values[1]), 15)
expect(int(table["c"]), 30)

// for in：array 可以取 value，也可以取 index, value。
int valueSum = 0
for item in values
    valueSum += int(item)
end
expect(valueSum, 19)

int indexSum = 0
for index, item in values
    indexSum += index
end
expect(indexSum, 3)

// for in：list 返回稀疏索引和值。
int listIndexSum = 0
string listLast = ""
for index, item in sparse
    listIndexSum += index
    listLast = string(item)
end
expect(listIndexSum, 2)
expectStr(listLast, "b")

// for in：set 返回值，dict 返回 key/value。
int setSum = 0
for item in unique
    setSum += int(item)
end
expect(setSum, 6)

int dictSum = 0
int sawB = 0
for key, item in table
    dictSum += int(item)
    if key == "b" then
        sawB = int(item)
    end
end
expect(dictSum, 60)
expect(sawB, 20)

// 静态泛型容器。
array<int> numbers = array[10, 20, 30]
list<string> names = list[0: "alpha", 2: "beta"]
set<int> ids = set{1, 2, 2}
dict<int> scores = dict{"alpha": 10, "beta": 20}

expect(numbers[2], 30)
expectStr(names[2], "beta")
int idCount = 0
for item in ids
    idCount += 1
end
expect(idCount, 2)
expect(scores["beta"], 20)

var boxedNumbers = numbers
var boxedNames = names
var boxedIds = ids
var boxedScores = scores

expect(type(boxedNumbers) == type(numbers), 1)
expect(type(boxedNames) == type(names), 1)
expect(type(boxedIds) == type(ids), 1)
expect(type(boxedScores) == type(scores), 1)
expect(int(boxedNumbers[2]), 30)
expectStr(string(boxedNames[2]), "beta")
expect(2 in boxedIds, 1)
expect(int(boxedScores["beta"]), 20)

// 静态泛型容器复制和赋值会生成独立容器。
array<int> numbersCopy = numbers
list<string> namesCopy = names
set<int> idsCopy = ids
dict<int> scoresCopy = scores

numbers[0] = 99
names[2] = "gamma"
ids = set{3, 4}
scores["beta"] = 25

expect(numbersCopy[0], 10)
expectStr(namesCopy[2], "beta")
expect(1 in idsCopy, 1)
expect(3 in idsCopy, 0)
expect(scoresCopy["beta"], 20)

numbersCopy = array[7, 8]
namesCopy = list[5: "five"]
idsCopy = ids
scoresCopy = dict{"z": 99}

expect(numbersCopy.length, 2)
expectStr(namesCopy[5], "five")
expect(3 in idsCopy, 1)
expect(scoresCopy.length, 1)
expect(scoresCopy["z"], 99)

// 泛型容器可以保存 class、native-backed class、func 等一等公民类型。
class Pair
    int left = 0
    int right = 0
end

class FnBox
    func(int) as int op
    int bias = 0
end

class Native
    native point handle
end

func add(int left, int right) as int
    return left + right
end

func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

Pair seed
seed.left = 5
seed.right = 6
array<Pair> pairs = array[seed]
Pair fromPair = pairs[0]
expect(fromPair.left + fromPair.right, 11)

point raw
Native native = Native(raw)
array<Native> nativeArray = array[native]
Native fromNative = nativeArray[0]
expect(type(fromNative) == Native, 1)

func(int, int) as int fn = add
dict<func(int, int) as int> funcs = dict{"add": fn}
func(int, int) as int picked = funcs["add"]
expect(picked(20, 22), 42)

func(int) as int add5 = makeAdder(5)
func(int) as int add9 = makeAdder(9)
array<func(int) as int> unaryFuncs = array[add5]
array<func(int) as int> unaryFuncsCopy = unaryFuncs
unaryFuncs[0] = add9
func(int) as int copiedUnary = unaryFuncsCopy[0]
expect(copiedUnary(7), 12)

FnBox box
box.op = add5
box.bias = 10
FnBox nextBox
nextBox.op = add9
nextBox.bias = 20

array<FnBox> boxes = array[box]
array<FnBox> boxesCopy = boxes
boxes[0] = nextBox
FnBox copiedBox = boxesCopy[0]
expect(copiedBox.op(1) + copiedBox.bias, 16)
