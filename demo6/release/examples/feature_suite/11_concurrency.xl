assert task.cancel(pendingSpawnCancel), "pending task.spawn future should cancel"
int pendingSpawnCancelState = 0
try
    int pendingSpawnCancelValue = await pendingSpawnCancel
    pendingSpawnCancelState = pendingSpawnCancelValue
catch e
    if e.message == "future cancel requested." then
        pendingSpawnCancelState = 1
    end
end
assert pendingSpawnCancelState == 1, "pending task.spawn future should await as canceled"
time.sleep(160)
try
    int pendingSpawnCancelLateValue = await pendingSpawnCancel
    pendingSpawnCancelState = pendingSpawnCancelLateValue
catch e
    if e.message == "future cancel requested." then
        pendingSpawnCancelState = 2
    end
end
assert pendingSpawnCancelState == 2, "pending task.spawn worker completion should not overwrite cancel"

future<int> raceWinner = addAsync(90, 1)
future<int> raceLoser = slowAddAsync(100, 1)
int raceCancelValue = await task.race([raceWinner, raceLoser])
assert raceCancelValue == 91, "task.race should return fast winner"

int raceLoserCancelState = 0
try
    int raceLoserValue = await raceLoser
    raceLoserCancelState = raceLoserValue
catch e
    if e.message == "future cancel requested." then
        raceLoserCancelState = 1
    end
end
assert raceLoserCancelState == 1, "task.race should cancel losing future"
int raceWinnerStillAvailable = await raceWinner
assert raceWinnerStillAvailable == 91, "task.race winner should remain awaitable"
time.sleep(160)
try
    int raceLoserLateValue = await raceLoser
    raceLoserCancelState = raceLoserLateValue
catch e
    if e.message == "future cancel requested." then
        raceLoserCancelState = 2
    end
end
assert raceLoserCancelState == 2, "task.race loser late completion should not overwrite cancel"

