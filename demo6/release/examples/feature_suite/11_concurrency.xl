async func addAsync(int a, int b) as int
    return a + b
end

async func slowAddAsync(int a, int b) as int
    time.sleep(120)
    return a + b
end

async func touchAsync()
    int marker = 1
    assert marker == 1, "async void body failed"
end

async func failAsync() as int
    throw "task async boom"
    return 0
end

async func slowFailAsync() as int
    time.sleep(120)
    throw "task async boom"
    return 0
end

async func asyncFinallyVoidOverrideExample()
    try
        throw "async finally void original example"
    finally
        throw "async finally void override example"
    end
end

func addPlain(int a, int b) as int
    return a + b
end

func addDefault(int a, int b = 1) as int
    return a + b
end

func greetPlain(string name) as string
    return "hello " + name
end

func flipPlain(bool value) as bool
    return not value
end

func addHalfPlain(float value) as float
    return value + 0.5
end

func sumVariadic(int base, ...) as int
    int total = base
    int i = 0
    while i < arg.length
        total = total + int(arg[i])
        i = i + 1
    end
    return total
end

func totalDefault(int base = 5, ...) as int
    return base + arg.length
end

func slowAddPlain(int a, int b) as int
    time.sleep(120)
    return a + b
end

func failPlain() as int
    throw "task spawn boom"
    return 0
end

func failPlainString() as string
    throw "task spawn string boom"
    return ""
end

func failPlainBool() as bool
    throw "task spawn bool boom"
    return false
end

func failPlainFloat() as float
    throw "task spawn float boom"
    return 0.0
end

func markPlainVoid()
    int marker = 1
    assert marker == 1, "task.spawn void body failed"
end

func failPlainVoid()
    throw "task spawn void boom"
end

func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

class AsyncBox
    func(int) as int op
    int bias = 0
end

func makeBox(int base) as AsyncBox
    AsyncBox box = AsyncBox()
    box.op = makeAdder(base)
    box.bias = base
    return box
end

async func makeBoxAsync(int base) as AsyncBox
    AsyncBox box = makeBox(base)
    return box
end

async func makeAdderAsync(int base) as func(int) as int
    return makeAdder(base)
end

async func makeVarAsync(int value) as var
    return value
end

async func makeTextAsync(string text) as string
    return text
end

async func makeArrayAsync(int first) as array<int>
    return array[first, first + 1]
end

async func makeListAsync(int first) as list<int>
    return list[2: first, 4: first + 1]
end

async func makeSetAsync(int first) as set<int>
    return set{first, first + 1}
end

async func makeDictAsync(int first) as dict<int>
    return dict{"a": first, "b": first + 1}
end

async func asyncNumbers(int base) as generator<int>
    int first = await addAsync(base, 1)
    yield first
    yield await addAsync(first, 2)
end

func asyncNumbersAlias(int base) as async generator<int>
    int first = await addAsync(base, 3)
    yield first
    yield await addAsync(first, 4)
end

func brokenAsyncNumbers() as async generator<int>
    yield await addAsync(0, 1)
    throw "async generator boom"
    yield 2
end

func brokenAsyncNumbersEarly() as async generator<int>
    int guard = await addAsync(1, 1)
    if guard == 2 then
        throw "async generator boom before yield"
    end
    yield guard
end

func emptyAsyncNumbers() as async generator<int>
    int guard = await addAsync(1, 1)
    if guard == 0 then
        yield guard
    end
end

func indexedAsyncNumbers() as async generator<int>
    yield await addAsync(0, 10)
    yield await addAsync(0, 20)
    yield await addAsync(0, 30)
    yield await addAsync(0, 40)
end

func numbers(int count) as generator<int>
    int i = 0
    while i < count
        i = i + 1
        yield i
    end
end

func toggles() as generator<bool>
    yield true
    yield false
end

func weights() as generator<float>
    yield 1.5
    yield 2.5
end

func clocks() as generator<time>
    yield #12:34:56#
end

func brokenNumbers() as generator<int>
    yield 1
    throw "generator boom"
    yield 2
end

func brokenNumbersEarly() as generator<int>
    throw "generator boom before yield"
    yield 1
end

func emptyNumbers() as generator<int>
    int marker = 1
    if marker == 0 then
        yield marker
    end
end

func worker() as int
    return 7
end

func makeThreadWorker(int code) as func() as int
    return func() as int
        return code
    end
end

func() as int missingThreadWorker

future<int> futureValue = addAsync(20, 22)
int answer = await futureValue
assert answer == 42, "async/await failed"

auto autoFuture = addAsync(4, 6)
auto autoAnswer = await autoFuture
assert autoAnswer == 10, "auto await failed"

auto voidFuture = touchAsync()
await voidFuture

future<AsyncBox> boxFuture = makeBoxAsync(30)
AsyncBox box = await boxFuture
assert box.op(12) + box.bias == 72, "await class func field failed"

future<func(int) as int> fnFuture = makeAdderAsync(50)
func(int) as int fnA = await fnFuture
func(int) as int fnB = await fnFuture
assert fnA(1) == 51, "await func result failed"
assert fnB(2) == 52, "second await func result failed"

future<AsyncBox> sharedBoxFuture = makeBoxAsync(70)
AsyncBox firstBox = await sharedBoxFuture
AsyncBox secondBox = await sharedBoxFuture
assert firstBox.op(3) + firstBox.bias == 143, "first repeated await class result failed"
assert secondBox.op(4) + secondBox.bias == 144, "second repeated await class result failed"

auto autoBoxFuture = makeBoxAsync(90)
auto autoBox = await autoBoxFuture
assert autoBox.op(5) + autoBox.bias == 185, "auto await class result failed"

int temporaryValue = await addAsync(8, 9)
assert temporaryValue == 17, "temporary await int result failed"

await touchAsync()

func(int) as int temporaryFn = await makeAdderAsync(60)
assert temporaryFn(4) == 64, "temporary await func result failed"
assert (await makeAdderAsync(65))(5) == 70, "direct await func call failed"

AsyncBox temporaryBox = await makeBoxAsync(110)
assert temporaryBox.op(6) + temporaryBox.bias == 226, "temporary await class result failed"

future<var> varFuture = makeVarAsync(120)
var awaitedVar = await varFuture
assert int(awaitedVar) == 120, "await var result failed"

var temporaryVar = await makeVarAsync(130)
assert int(temporaryVar) == 130, "temporary await var result failed"

future<int> conditionalAwaitSource = addAsync(30, 12)
bool chooseConditionalAwait = true
int conditionalAwaitBorrowed = await (chooseConditionalAwait ? conditionalAwaitSource : addAsync(1, 1))
assert conditionalAwaitBorrowed == 42, "conditional await borrowed future failed"
int conditionalAwaitAgain = await conditionalAwaitSource
assert conditionalAwaitAgain == 42, "conditional await borrowed future should remain awaitable"
chooseConditionalAwait = false
int conditionalAwaitOwned = await (chooseConditionalAwait ? conditionalAwaitSource : addAsync(40, 2))
assert conditionalAwaitOwned == 42, "conditional await owned future failed"

future<var> conditionalVarSource = makeVarAsync(132)
bool chooseConditionalVar = true
var conditionalVarBorrowed = await (chooseConditionalVar ? conditionalVarSource : makeVarAsync(133))
assert int(conditionalVarBorrowed) == 132, "conditional await borrowed var failed"
var conditionalVarAgain = await conditionalVarSource
assert int(conditionalVarAgain) == 132, "conditional await borrowed var should remain awaitable"
chooseConditionalVar = false
var conditionalVarOwned = await (chooseConditionalVar ? conditionalVarSource : makeVarAsync(133))
assert int(conditionalVarOwned) == 133, "conditional await owned var failed"

future<func(int) as int> conditionalFnSource = makeAdderAsync(134)
bool chooseConditionalFn = true
func(int) as int conditionalFnBorrowed = await (chooseConditionalFn ? conditionalFnSource : makeAdderAsync(135))
assert conditionalFnBorrowed(1) == 135, "conditional await borrowed function failed"
func(int) as int conditionalFnAgain = await conditionalFnSource
assert conditionalFnAgain(2) == 136, "conditional await borrowed function should remain awaitable"
chooseConditionalFn = false
func(int) as int conditionalFnOwned = await (chooseConditionalFn ? conditionalFnSource : makeAdderAsync(135))
assert conditionalFnOwned(3) == 138, "conditional await owned function failed"

future<string> conditionalTextSource = makeTextAsync("named")
bool chooseConditionalText = true
string conditionalTextBorrowed = await (chooseConditionalText ? conditionalTextSource : makeTextAsync("owned"))
assert conditionalTextBorrowed == "named", "conditional await borrowed string failed"
string conditionalTextAgain = await conditionalTextSource
assert conditionalTextAgain == "named", "conditional await borrowed string should remain awaitable"
chooseConditionalText = false
string conditionalTextOwned = await (chooseConditionalText ? conditionalTextSource : makeTextAsync("owned"))
assert conditionalTextOwned == "owned", "conditional await owned string failed"

future<array<int>> conditionalArraySource = makeArrayAsync(10)
bool chooseConditionalArray = true
array<int> conditionalArrayBorrowed = await (chooseConditionalArray ? conditionalArraySource : makeArrayAsync(20))
assert conditionalArrayBorrowed[0] == 10, "conditional await borrowed array failed"
array<int> conditionalArrayAgain = await conditionalArraySource
assert conditionalArrayAgain[1] == 11, "conditional await borrowed array should remain awaitable"
chooseConditionalArray = false
array<int> conditionalArrayOwned = await (chooseConditionalArray ? conditionalArraySource : makeArrayAsync(20))
assert conditionalArrayOwned[0] == 20, "conditional await owned array failed"

future<list<int>> conditionalListSource = makeListAsync(30)
bool chooseConditionalList = true
list<int> conditionalListBorrowed = await (chooseConditionalList ? conditionalListSource : makeListAsync(40))
assert int(conditionalListBorrowed[2]) == 30, "conditional await borrowed list failed"
list<int> conditionalListAgain = await conditionalListSource
assert int(conditionalListAgain[4]) == 31, "conditional await borrowed list should remain awaitable"
chooseConditionalList = false
list<int> conditionalListOwned = await (chooseConditionalList ? conditionalListSource : makeListAsync(40))
assert int(conditionalListOwned[2]) == 40, "conditional await owned list failed"

future<set<int>> conditionalSetSource = makeSetAsync(50)
bool chooseConditionalSet = true
set<int> conditionalSetBorrowed = await (chooseConditionalSet ? conditionalSetSource : makeSetAsync(60))
assert conditionalSetBorrowed.length == 2, "conditional await borrowed set failed"
set<int> conditionalSetAgain = await conditionalSetSource
assert conditionalSetAgain.length == 2, "conditional await borrowed set should remain awaitable"
chooseConditionalSet = false
set<int> conditionalSetOwned = await (chooseConditionalSet ? conditionalSetSource : makeSetAsync(60))
assert conditionalSetOwned.length == 2, "conditional await owned set failed"

future<dict<int>> conditionalDictSource = makeDictAsync(70)
bool chooseConditionalDict = true
dict<int> conditionalDictBorrowed = await (chooseConditionalDict ? conditionalDictSource : makeDictAsync(80))
assert int(conditionalDictBorrowed["a"]) == 70, "conditional await borrowed dict failed"
dict<int> conditionalDictAgain = await conditionalDictSource
assert int(conditionalDictAgain["b"]) == 71, "conditional await borrowed dict should remain awaitable"
chooseConditionalDict = false
dict<int> conditionalDictOwned = await (chooseConditionalDict ? conditionalDictSource : makeDictAsync(80))
assert int(conditionalDictOwned["a"]) == 80, "conditional await owned dict failed"

future<AsyncBox> conditionalBoxSource = makeBoxAsync(140)
bool chooseConditionalBox = true
AsyncBox conditionalBoxBorrowed = await (chooseConditionalBox ? conditionalBoxSource : makeBoxAsync(150))
assert conditionalBoxBorrowed.op(2) + conditionalBoxBorrowed.bias == 282, "conditional await borrowed class failed"
AsyncBox conditionalBoxAgain = await conditionalBoxSource
assert conditionalBoxAgain.op(3) + conditionalBoxAgain.bias == 283, "conditional await borrowed class should remain awaitable"
chooseConditionalBox = false
AsyncBox conditionalBoxOwned = await (chooseConditionalBox ? conditionalBoxSource : makeBoxAsync(150))
assert conditionalBoxOwned.op(4) + conditionalBoxOwned.bias == 304, "conditional await owned class failed"

future<string> typedConditionalStringSource = makeTextAsync("typed-source")
bool chooseTypedConditionalString = true
array<future<string>> typedConditionalStringJobs = array[
    chooseTypedConditionalString ? typedConditionalStringSource : makeTextAsync("typed-owned"),
    false ? typedConditionalStringSource : makeTextAsync("typed-tail")
]
array<string> typedConditionalStringValues = await task.all(typedConditionalStringJobs)
assert typedConditionalStringValues[0] == "typed-source", "typed future string all borrowed branch failed"
assert typedConditionalStringValues[1] == "typed-tail", "typed future string all owned branch failed"
string typedConditionalStringAgain = await typedConditionalStringSource
assert typedConditionalStringAgain == "typed-source", "typed future string source should remain awaitable"

future<AsyncBox> typedConditionalBoxSource = makeBoxAsync(170)
bool chooseTypedConditionalBox = true
array<future<AsyncBox>> typedConditionalBoxJobs = array[
    chooseTypedConditionalBox ? typedConditionalBoxSource : makeBoxAsync(180)
]
future<AsyncBox> typedConditionalBoxRaceFuture = task.race(typedConditionalBoxJobs)
AsyncBox typedConditionalBoxValue = await typedConditionalBoxRaceFuture
assert typedConditionalBoxValue.op(1) == 171, "typed future class race borrowed branch failed"
AsyncBox typedConditionalBoxAgain = await typedConditionalBoxSource
assert typedConditionalBoxAgain.op(2) == 172, "typed future class source should remain awaitable"

future<func(int) as int> typedConditionalFuncSource = makeAdderAsync(190)
bool chooseTypedConditionalFunc = true
array<future<func(int) as int> > typedConditionalFuncJobs = array[
    chooseTypedConditionalFunc ? typedConditionalFuncSource : makeAdderAsync(200),
    false ? typedConditionalFuncSource : makeAdderAsync(210)
]
array<func(int) as int> typedConditionalFuncs = await task.all(typedConditionalFuncJobs)
func(int) as int typedConditionalFuncA = typedConditionalFuncs[0]
func(int) as int typedConditionalFuncB = typedConditionalFuncs[1]
assert typedConditionalFuncA(1) == 191, "typed future function all borrowed branch failed"
assert typedConditionalFuncB(2) == 212, "typed future function all owned branch failed"
assert typedConditionalFuncs[0](4) == 194, "typed future function direct item call borrowed branch failed"
assert typedConditionalFuncs[1](5) == 215, "typed future function direct item call owned branch failed"
func(int) as int typedConditionalFuncAgain = await typedConditionalFuncSource
assert typedConditionalFuncAgain(3) == 193, "typed future function source should remain awaitable"

array<future<func(int) as int> > typedConditionalFuncRaceBorrowedJobs = array[
    chooseTypedConditionalFunc ? typedConditionalFuncSource : makeAdderAsync(220)
]
future<func(int) as int> typedConditionalFuncRaceBorrowedFuture = task.race(typedConditionalFuncRaceBorrowedJobs)
func(int) as int typedConditionalFuncRaceBorrowedA = await typedConditionalFuncRaceBorrowedFuture
func(int) as int typedConditionalFuncRaceBorrowedB = await typedConditionalFuncRaceBorrowedFuture
assert typedConditionalFuncRaceBorrowedA(6) == 196, "typed future function race borrowed branch failed"
assert typedConditionalFuncRaceBorrowedB(7) == 197, "typed future function race repeated await failed"
assert (await typedConditionalFuncRaceBorrowedFuture)(12) == 202, "typed future function race direct await call borrowed branch failed"
func(int) as int typedConditionalFuncAfterRace = await typedConditionalFuncSource
assert typedConditionalFuncAfterRace(8) == 198, "typed future function race source should remain awaitable"

array<future<func(int) as int> > typedConditionalFuncRaceOwnedJobs = array[
    false ? typedConditionalFuncSource : makeAdderAsync(230)
]
future<func(int) as int> typedConditionalFuncRaceOwnedFuture = task.race(typedConditionalFuncRaceOwnedJobs)
func(int) as int typedConditionalFuncRaceOwnedA = await typedConditionalFuncRaceOwnedFuture
func(int) as int typedConditionalFuncRaceOwnedB = await typedConditionalFuncRaceOwnedFuture
assert typedConditionalFuncRaceOwnedA(9) == 239, "typed future function race owned branch failed"
assert typedConditionalFuncRaceOwnedB(10) == 240, "typed future function race owned repeated await failed"
assert (await typedConditionalFuncRaceOwnedFuture)(11) == 241, "typed future function race direct await call owned branch failed"

future<array<int>> allFuture = task.all([addAsync(1, 2), addAsync(3, 4)])
array<int> allValuesA = await allFuture
array<int> allValuesB = await allFuture
assert allValuesA.length == 2, "task.all length failed"
assert allValuesA[0] == 3, "task.all first result failed"
assert allValuesA[1] == 7, "task.all second result failed"
assert allValuesB[0] == 3 and allValuesB[1] == 7, "task.all repeated await failed"
assert not task.cancel(allFuture), "completed task.all future should not cancel"
array<int> allValuesAfterCancel = await allFuture
assert allValuesAfterCancel[1] == 7, "completed task.all future should remain awaitable"

future<int> raceFuture = task.race([addAsync(5, 6), addAsync(7, 8)])
int raceValueA = await raceFuture
int raceValueB = await raceFuture
assert raceValueA == 11 or raceValueA == 15, "task.race result failed"
assert raceValueB == raceValueA, "task.race repeated await failed"
assert not task.cancel(raceFuture), "completed task.race future should not cancel"
int raceValueAfterCancel = await raceFuture
assert raceValueAfterCancel == raceValueA, "completed task.race future should remain awaitable"

func(int, int) as int addTask = addPlain
future<int> spawnFuture = task.spawn(addTask, 20, 22)
int spawnValueA = await spawnFuture
int spawnValueB = await spawnFuture
assert spawnValueA == 42, "task.spawn result failed"
assert spawnValueB == 42, "task.spawn repeated await failed"
assert not task.cancel(spawnFuture), "completed task.spawn future should not cancel"
int spawnValueAfterCancel = await spawnFuture
assert spawnValueAfterCancel == 42, "completed task.spawn future should remain awaitable"

func(string) as string greetTask = greetPlain
future<string> stringSpawnFuture = task.spawn(greetTask, "spawn")
string stringSpawnA = await stringSpawnFuture
string stringSpawnB = await stringSpawnFuture
assert stringSpawnA == "hello spawn", "task.spawn string result failed"
assert stringSpawnB == "hello spawn", "task.spawn string repeated await failed"
assert not task.cancel(stringSpawnFuture), "completed string task.spawn future should not cancel"
string stringSpawnAfterCancel = await stringSpawnFuture
assert stringSpawnAfterCancel == "hello spawn", "completed string task.spawn future should remain awaitable"

func(bool) as bool flipTask = flipPlain
future<bool> boolSpawnFuture = task.spawn(flipTask, false)
bool boolSpawnA = await boolSpawnFuture
bool boolSpawnB = await boolSpawnFuture
assert boolSpawnA, "task.spawn bool result failed"
assert boolSpawnB, "task.spawn bool repeated await failed"
assert not task.cancel(boolSpawnFuture), "completed bool task.spawn future should not cancel"
bool boolSpawnAfterCancel = await boolSpawnFuture
assert boolSpawnAfterCancel, "completed bool task.spawn future should remain awaitable"

func(float) as float halfTask = addHalfPlain
future<float> floatSpawnFuture = task.spawn(halfTask, 2.5)
float floatSpawnA = await floatSpawnFuture
float floatSpawnB = await floatSpawnFuture
assert floatSpawnA == 3.0, "task.spawn float result failed"
assert floatSpawnB == 3.0, "task.spawn float repeated await failed"
assert not task.cancel(floatSpawnFuture), "completed float task.spawn future should not cancel"
float floatSpawnAfterCancel = await floatSpawnFuture
assert floatSpawnAfterCancel == 3.0, "completed float task.spawn future should remain awaitable"

array<future<string>> stringSpawnAllJobs = array[
    task.spawn(greetTask, "all-left"),
    task.spawn(greetTask, "all-right")
]
array<string> stringSpawnAllValues = await task.all(stringSpawnAllJobs)
assert stringSpawnAllValues[0] == "hello all-left", "task.all string task.spawn first result failed"
assert stringSpawnAllValues[1] == "hello all-right", "task.all string task.spawn second result failed"
array<future<string>> stringSpawnRaceJobs = array[
    task.spawn(greetTask, "race")
]
string stringSpawnRaceValue = await task.race(stringSpawnRaceJobs)
assert stringSpawnRaceValue == "hello race", "task.race string task.spawn result failed"

array<future<string>> stringSpawnSavedAllJobs = array[
    task.spawn(greetTask, "saved-all-left"),
    task.spawn(greetTask, "saved-all-right")
]
future<array<string>> stringSpawnSavedAllFuture = task.all(stringSpawnSavedAllJobs)
array<string> stringSpawnSavedAllA = await stringSpawnSavedAllFuture
array<string> stringSpawnSavedAllB = await stringSpawnSavedAllFuture
assert stringSpawnSavedAllA[0] == "hello saved-all-left", "saved task.all string first await failed"
assert stringSpawnSavedAllB[1] == "hello saved-all-right", "saved task.all string repeated await failed"
assert not task.cancel(stringSpawnSavedAllFuture), "completed saved string task.all future should not cancel"
array<string> stringSpawnSavedAllAfterCancel = await stringSpawnSavedAllFuture
assert stringSpawnSavedAllAfterCancel[0] == "hello saved-all-left", "completed saved string task.all future should remain awaitable"

array<future<string>> stringSpawnSavedRaceJobs = array[
    task.spawn(greetTask, "saved-race")
]
future<string> stringSpawnSavedRaceFuture = task.race(stringSpawnSavedRaceJobs)
string stringSpawnSavedRaceA = await stringSpawnSavedRaceFuture
string stringSpawnSavedRaceB = await stringSpawnSavedRaceFuture
assert stringSpawnSavedRaceA == "hello saved-race", "saved task.race string first await failed"
assert stringSpawnSavedRaceB == "hello saved-race", "saved task.race string repeated await failed"
assert not task.cancel(stringSpawnSavedRaceFuture), "completed saved string task.race future should not cancel"
string stringSpawnSavedRaceAfterCancel = await stringSpawnSavedRaceFuture
assert stringSpawnSavedRaceAfterCancel == "hello saved-race", "completed saved string task.race future should remain awaitable"

array<future<bool>> boolSpawnAllJobs = array[
    task.spawn(flipTask, true),
    task.spawn(flipTask, false)
]
array<bool> boolSpawnAllValues = await task.all(boolSpawnAllJobs)
assert not boolSpawnAllValues[0], "task.all bool task.spawn first result failed"
assert boolSpawnAllValues[1], "task.all bool task.spawn second result failed"
array<future<bool>> boolSpawnRaceJobs = array[
    task.spawn(flipTask, false)
]
bool boolSpawnRaceValue = await task.race(boolSpawnRaceJobs)
assert boolSpawnRaceValue, "task.race bool task.spawn result failed"

array<future<bool>> boolSpawnSavedAllJobs = array[
    task.spawn(flipTask, true),
    task.spawn(flipTask, false)
]
future<array<bool>> boolSpawnSavedAllFuture = task.all(boolSpawnSavedAllJobs)
array<bool> boolSpawnSavedAllA = await boolSpawnSavedAllFuture
array<bool> boolSpawnSavedAllB = await boolSpawnSavedAllFuture
assert not boolSpawnSavedAllA[0], "saved task.all bool first await failed"
assert boolSpawnSavedAllB[1], "saved task.all bool repeated await failed"
assert not task.cancel(boolSpawnSavedAllFuture), "completed saved bool task.all future should not cancel"
array<bool> boolSpawnSavedAllAfterCancel = await boolSpawnSavedAllFuture
assert boolSpawnSavedAllAfterCancel[1], "completed saved bool task.all future should remain awaitable"

array<future<bool>> boolSpawnSavedRaceJobs = array[
    task.spawn(flipTask, true)
]
future<bool> boolSpawnSavedRaceFuture = task.race(boolSpawnSavedRaceJobs)
bool boolSpawnSavedRaceA = await boolSpawnSavedRaceFuture
bool boolSpawnSavedRaceB = await boolSpawnSavedRaceFuture
assert not boolSpawnSavedRaceA, "saved task.race bool first await failed"
assert not boolSpawnSavedRaceB, "saved task.race bool repeated await failed"
assert not task.cancel(boolSpawnSavedRaceFuture), "completed saved bool task.race future should not cancel"
bool boolSpawnSavedRaceAfterCancel = await boolSpawnSavedRaceFuture
assert not boolSpawnSavedRaceAfterCancel, "completed saved bool task.race future should remain awaitable"

array<future<float>> floatSpawnAllJobs = array[
    task.spawn(halfTask, 6.5),
    task.spawn(halfTask, 7.5)
]
array<float> floatSpawnAllValues = await task.all(floatSpawnAllJobs)
assert floatSpawnAllValues[0] == 7.0, "task.all float task.spawn first result failed"
assert floatSpawnAllValues[1] == 8.0, "task.all float task.spawn second result failed"
array<future<float>> floatSpawnRaceJobs = array[
    task.spawn(halfTask, 8.5)
]
float floatSpawnRaceValue = await task.race(floatSpawnRaceJobs)
assert floatSpawnRaceValue == 9.0, "task.race float task.spawn result failed"

array<future<float>> floatSpawnSavedAllJobs = array[
    task.spawn(halfTask, 12.5),
    task.spawn(halfTask, 13.5)
]
future<array<float>> floatSpawnSavedAllFuture = task.all(floatSpawnSavedAllJobs)
array<float> floatSpawnSavedAllA = await floatSpawnSavedAllFuture
array<float> floatSpawnSavedAllB = await floatSpawnSavedAllFuture
assert floatSpawnSavedAllA[0] == 13.0, "saved task.all float first await failed"
assert floatSpawnSavedAllB[1] == 14.0, "saved task.all float repeated await failed"
assert not task.cancel(floatSpawnSavedAllFuture), "completed saved float task.all future should not cancel"
array<float> floatSpawnSavedAllAfterCancel = await floatSpawnSavedAllFuture
assert floatSpawnSavedAllAfterCancel[0] == 13.0, "completed saved float task.all future should remain awaitable"

array<future<float>> floatSpawnSavedRaceJobs = array[
    task.spawn(halfTask, 14.5)
]
future<float> floatSpawnSavedRaceFuture = task.race(floatSpawnSavedRaceJobs)
float floatSpawnSavedRaceA = await floatSpawnSavedRaceFuture
float floatSpawnSavedRaceB = await floatSpawnSavedRaceFuture
assert floatSpawnSavedRaceA == 15.0, "saved task.race float first await failed"
assert floatSpawnSavedRaceB == 15.0, "saved task.race float repeated await failed"
assert not task.cancel(floatSpawnSavedRaceFuture), "completed saved float task.race future should not cancel"
