future<int> pendingAsyncCancel = slowAddAsync(30, 12)
assert task.cancel(pendingAsyncCancel), "pending async future should cancel"
int pendingAsyncCancelState = 0
try
    int pendingAsyncCancelValue = await pendingAsyncCancel
    pendingAsyncCancelState = pendingAsyncCancelValue
catch e
    if e.message == "future cancel requested." then
        pendingAsyncCancelState = 1
    end
end
assert pendingAsyncCancelState == 1, "pending async future should await as canceled"
time.sleep(160)
try
    int pendingAsyncCancelLateValue = await pendingAsyncCancel
    pendingAsyncCancelState = pendingAsyncCancelLateValue
catch e
    if e.message == "future cancel requested." then
        pendingAsyncCancelState = 2
    end
end
assert pendingAsyncCancelState == 2, "pending async worker completion should not overwrite cancel"

func(int, int) as int slowAddTask = slowAddPlain
