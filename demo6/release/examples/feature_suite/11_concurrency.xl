channel<int> ch = channel::<int>(2)
assert ch.send(123), "channel send failed"
int received = 0
assert ch.recvInto(received), "channel recv failed"
assert received == 123, "channel value failed"
assert ch.count() == 0, "channel count failed"
ch.close()
assert ch.isClosed(), "channel close failed"

int missingThreadState = 0
try
    thread missingThread = thread(missingThreadWorker)
    missingThreadState = missingThread.exitCode()
catch e
    if e.message == "thread requires a callable func value" then
        missingThreadState = 1
    end
end
assert missingThreadState == 1, "thread empty func value"

thread t = thread(worker)
assert t.wait(), "thread wait failed"
assert t.exitCode() == 7, "thread exit code failed"

int base = 5
auto capturedWorker = func() as int
    return base + 2
end
thread captured = thread(capturedWorker)
assert captured.wait(), "thread captured wait failed"
assert captured.exitCode() == 7, "thread captured exit code failed"

func() as int borrowedThreadLeft = makeThreadWorker(11)
func() as int borrowedThreadRight = makeThreadWorker(12)
bool chooseBorrowedThread = false
thread borrowedConditionalThread = thread(chooseBorrowedThread ? borrowedThreadLeft : borrowedThreadRight)
assert borrowedConditionalThread.wait(), "thread borrowed conditional wait failed"
assert borrowedConditionalThread.exitCode() == 12, "thread borrowed conditional exit code failed"
assert borrowedThreadRight() == 12, "thread borrowed conditional source failed"

func() as int mixedThreadSource = makeThreadWorker(15)
bool chooseMixedThread = false
thread mixedThread = thread(chooseMixedThread ? mixedThreadSource : makeThreadWorker(16))
assert mixedThread.wait(), "thread mixed conditional wait failed"
assert mixedThread.exitCode() == 16, "thread mixed conditional exit code failed"
assert mixedThreadSource() == 15, "thread mixed conditional source failed"

mutex m = mutex()
assert m.lock(), "mutex lock failed"
assert m.unlock(), "mutex unlock failed"
assert m.tryLock(), "mutex tryLock failed"
assert m.unlock(), "mutex tryUnlock failed"

sem gate = sem(0, 2)
assert gate.post(), "sem post failed"
assert gate.waitTimeout(10), "sem waitTimeout failed"
assert not gate.tryWait(), "sem empty tryWait failed"

cond c = cond()
assert c.signal(), "cond signal failed"
assert c.broadcast(), "cond broadcast failed"
mutex condMutex = mutex()
assert condMutex.lock(), "cond waitTimeout mutex lock failed"
assert not c.waitTimeout(condMutex, 1), "cond waitTimeout should time out"
assert condMutex.unlock(), "cond waitTimeout mutex unlock failed"

rwlock rw = rwlock()
assert rw.readLock(), "rwlock readLock failed"
assert rw.readUnlock(), "rwlock readUnlock failed"
assert rw.tryReadLock(), "rwlock tryReadLock failed"
assert rw.readUnlock(), "rwlock tryReadUnlock failed"
assert rw.writeLock(), "rwlock writeLock failed"
assert rw.downgrade(), "rwlock downgrade failed"
assert rw.readUnlock(), "rwlock downgraded unlock failed"
