    if savedContinueAsyncIndex == 1 then
        continue
    end
    savedIndexedContinueAsyncGeneratorWeighted = savedIndexedContinueAsyncGeneratorWeighted + savedContinueAsyncIndex * 100 + savedContinueAsyncValue
    if savedContinueAsyncIndex == 2 then
