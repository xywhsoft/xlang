generator<int> savedIndexedAsyncNumbers = indexedAsyncNumbers()
int savedIndexedAsyncGeneratorSeen = 0
int savedIndexedAsyncGeneratorWeighted = 0
for await savedAsyncIndex, savedAsyncValue in savedIndexedAsyncNumbers
    savedIndexedAsyncGeneratorSeen = savedIndexedAsyncGeneratorSeen + 1
    savedIndexedAsyncGeneratorWeighted = savedIndexedAsyncGeneratorWeighted + savedAsyncIndex * 100 + savedAsyncValue
    if savedAsyncIndex == 1 then
        break
    end
end
assert savedIndexedAsyncGeneratorSeen == 2, "saved async generator break seen failed"
assert savedIndexedAsyncGeneratorWeighted == 130, "saved async generator break index/value failed"

