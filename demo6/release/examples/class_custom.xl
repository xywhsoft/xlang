class Vec2
    int x = 0
    int y = 0

    create(int x, int y)
        self.x = x
        self.y = y
    end

    func length2() as int
        return self.x * self.x + self.y * self.y
    end
end

Vec2 v = Vec2(3, 4)
assert v.length2() == 25, "class method failed"

Buffer buffer = Buffer()
assert buffer.append("abc"), "native-backed class append failed"
assert buffer.len() == 3, "native-backed class length failed"
assert buffer[0] == 97, "native-backed class item failed"

Random rngA = Random(uint64(2026), uint64(1))
Random rngB = Random(uint64(2026), uint64(1))
assert rngA.u32() == rngB.u32(), "native-backed class replay failed"

println("class_custom ok")
