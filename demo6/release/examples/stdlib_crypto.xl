// Fixed public example material, not production keys or a security test suite.
// In applications, never reuse a nonce under the same AEAD key.
func line(string name, bool ok)
    assert ok, name + " failed"
    println(name + "=ok")
end

// Legacy SHA1 is explicitly separated; main digest functions return bytes.
line("hash",
    cryptoLegacy.sha1("xlang").length == 20 and
    crypto.sha256("xlang").length == 32 and
    crypto.sha384("xlang").length == 48 and
    crypto.sha512("xlang").length == 64 and
    crypto.sha256("xlang") == crypto.sha256("xlang") and
    crypto.sha256("xlang") != crypto.sha256("xlang!"))

string hmacText = "The quick brown fox jumps over the lazy dog"
line("hmac",
    crypto.hmacSha256Hex(b"key", hmacText) == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8" and
    crypto.hmacSha384(b"key", hmacText).length == 48 and
    crypto.hmacSha512(b"key", hmacText).length == 64)

bytes key16 = b"0123456789abcdef"
bytes key32 = b"0123456789abcdef0123456789abcdef"
bytes nonce = b"123456789012"
bytes rawNonce = b"123456789014"
bytes aad = b"meta"
string plain = "hello crypto"
auto chacha = ChaCha20Poly1305(key32)
auto aes128 = AesGcm(key16)
auto aes256 = AesGcm(key32)
line("aead",
    chacha.open(chacha.seal(plain, nonce, aad), nonce, aad) == encoding.encodeUtf8(plain) and
    aes128.open(aes128.seal(plain, nonce, aad), nonce, aad) == encoding.encodeUtf8(plain) and
    aes256.open(aes256.seal(plain, nonce, aad), nonce, aad) == encoding.encodeUtf8(plain))

line("hkdf_random",
    crypto.hkdfSha256(b"key", b"salt", b"info", 32).length == 32 and
    crypto.hkdfSha384(b"key", b"salt", b"info", 32).length == 32 and
    string.byteLen(crypto.randomHex(16)) == 32)

auto s1 = cryptoLegacy.sha1Stream()
s1.update("a")
s1.update("bc")
auto s256 = crypto.sha256Stream()
s256.update("a")
s256.update("bc")
auto s384 = crypto.sha384Stream()
s384.update("abc")
auto s512 = crypto.sha512Stream()
s512.update("ab")
s512.update("c")
line("stream", s1.final() == cryptoLegacy.sha1("abc") and s256.final() == crypto.sha256("abc") and
    s384.final() == crypto.sha384("abc") and s512.final() == crypto.sha512("abc"))

bytes binary = b"\x00\x01\x02\xff"
auto buffer = Buffer(binary)
bytes binaryNonce = b"123456789013"
auto binaryStream = crypto.sha256Stream()
binaryStream.updateBuffer(buffer)
line("binary",
    crypto.sha256BufferHex(buffer) == "3d1f57c984978ef98a18378c8166c1cb8ede02c03eeb6aee7e2f121dfeee3e56" and
    cryptoLegacy.sha1Buffer(buffer).length == 20 and crypto.sha384Buffer(buffer).length == 48 and
    crypto.sha512Buffer(buffer).length == 64 and crypto.hmacSha256Buffer(b"key", buffer).length == 32 and
    crypto.hmacSha384Buffer(b"key", buffer).length == 48 and crypto.hmacSha512Buffer(b"key", buffer).length == 64 and
    binaryStream.final() == crypto.sha256(binary) and
    cryptoAdvanced.chacha20(key32, rawNonce, cryptoAdvanced.chacha20Buffer(key32, rawNonce, buffer, 3), 3) == binary and
    chacha.open(chacha.seal(binary, binaryNonce, aad), binaryNonce, aad) == binary and
    aes128.open(aes128.seal(binary, binaryNonce, aad), binaryNonce, aad) == binary and
    aes256.open(aes256.seal(binary, binaryNonce, aad), binaryNonce, aad) == binary and
    crypto.randomBytes(17).length == 17)

bytes streamCipher = cryptoAdvanced.chacha20(key32, rawNonce, plain)
line("chacha20", cryptoAdvanced.chacha20(key32, rawNonce, streamCipher) == encoding.encodeUtf8(plain))

auto ed = crypto.ed25519KeyPair()
bytes signature = ed.sign("message")
line("ed25519", ed.exportSeed().length == 32 and ed.publicKey.length == 32 and
    crypto.ed25519PublicKey(ed.exportSeed()) == ed.publicKey and crypto.ed25519Verify(ed.publicKey, "message", signature))
auto x25519A = crypto.x25519KeyPair()
auto x25519B = crypto.x25519KeyPair()
line("x25519", x25519A.sharedSecret(x25519B.publicKey) == x25519B.sharedSecret(x25519A.publicKey))
auto x448A = crypto.x448KeyPair()
auto x448B = crypto.x448KeyPair()
line("x448", x448A.sharedSecret(x448B.publicKey) == x448B.sharedSecret(x448A.publicKey))
auto p256A = crypto.p256KeyPair()
auto p256B = crypto.p256KeyPair()
auto p384A = crypto.p384KeyPair()
auto p384B = crypto.p384KeyPair()
line("ecdh", p256A.sharedSecret(p256B.publicKey) == p256B.sharedSecret(p256A.publicKey) and
    p384A.sharedSecret(p384B.publicKey) == p384B.sharedSecret(p384A.publicKey))
bytes digest256 = crypto.sha256("message")
bytes digest384 = crypto.sha384("message")
line("signature", crypto.ecdsaP256VerifyHashDer(p256A.publicKey, digest256, p256A.signHashDer(digest256)) and
    crypto.ecdsaP384VerifyHashDer(p384A.publicKey, digest384, p384A.signHashDer(digest384)))
