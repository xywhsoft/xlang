func line(string name, bool ok)
    assert ok, name + " failed"
    println(name + "=ok")
end

string text = "xlang"
string sha1 = crypto.sha1(text)
string sha256 = crypto.sha256(text)
string sha384 = crypto.sha384(text)
string sha512 = crypto.sha512(text)

line("hash",
    string.len(sha1) == 40 and
    string.len(sha256) == 64 and
    string.len(sha384) == 96 and
    string.len(sha512) == 128 and
    sha256 == crypto.sha256("xlang") and
    sha256 != crypto.sha256("xlang!"))

string hmacText = "The quick brown fox jumps over the lazy dog"
line("hmac",
    crypto.hmacSha256("key", hmacText) == "F7BC83F430538424B13298E6AA6FB143EF4D59A14946175997479DBC2D1A3CD8" and
    string.len(crypto.hmacSha384("key", hmacText)) == 96 and
    string.len(crypto.hmacSha512("key", hmacText)) == 128)

string key16 = "0123456789abcdef"
string key32 = "0123456789abcdef0123456789abcdef"
string nonce = "123456789012"
string aad = "meta"
string plain = "hello crypto"

string chachaAead = crypto.chacha20Poly1305Encrypt(key32, nonce, plain, aad)
string aes128 = crypto.aes128GcmEncrypt(key16, nonce, plain, aad)
string aes256 = crypto.aes256GcmEncrypt(key32, nonce, plain, aad)
line("aead",
    crypto.chacha20Poly1305Decrypt(key32, nonce, chachaAead, aad) == plain and
    crypto.aes128GcmDecrypt(key16, nonce, aes128, aad) == plain and
    crypto.aes256GcmDecrypt(key32, nonce, aes256, aad) == plain and
    crypto.aes256GcmDecrypt(key32, nonce, aes256, "bad") == "")

string hkdf256 = crypto.hkdfSha256("key", "salt", "info", 32)
string hkdf384 = crypto.hkdfSha384("key", "salt", "info", 32)
line("hkdf_random", string.len(hkdf256) == 64 and string.len(hkdf384) == 64 and string.len(crypto.randomHex(16)) == 32)

Sha1 s1 = crypto.sha1Stream()
s1.update("a")
s1.update("bc")
Sha256 s256 = crypto.sha256Stream()
s256.update("a")
s256.update("bc")
Sha384 s384 = crypto.sha384Stream()
s384.update("abc")
Sha512 s512 = crypto.sha512Stream()
s512.update("ab")
s512.update("c")
line("stream", s1.hex() == crypto.sha1("abc") and s256.hex() == crypto.sha256("abc") and s384.hex() == crypto.sha384("abc") and s512.hex() == crypto.sha512("abc"))

Buffer binary = Buffer()
binary.appendByte(0)
binary.appendByte(1)
binary.appendByte(2)
binary.appendByte(255)
Buffer key16Bytes = encoding.toBytes(key16)
Buffer key32Bytes = encoding.toBytes(key32)
Buffer nonceBytes = encoding.toBytes(nonce)
Buffer aadBytes = encoding.toBytes(aad)
Buffer binarySha = crypto.sha256Bytes(binary)
Buffer binarySha1 = crypto.sha1Bytes(binary)
Buffer binarySha384 = crypto.sha384Bytes(binary)
Buffer binarySha512 = crypto.sha512Bytes(binary)
Buffer binaryHmac = crypto.hmacSha256Bytes(encoding.toBytes("key"), binary)
Buffer binaryHmac384 = crypto.hmacSha384Bytes(encoding.toBytes("key"), binary)
Buffer binaryHmac512 = crypto.hmacSha512Bytes(encoding.toBytes("key"), binary)
Buffer binaryStreamCipher = crypto.chacha20Bytes(key32Bytes, nonceBytes, binary, 3)
Buffer binaryStreamPlain = crypto.chacha20Bytes(key32Bytes, nonceBytes, binaryStreamCipher, 3)
Buffer binaryAead = crypto.chacha20Poly1305EncryptBytes(key32Bytes, nonceBytes, binary, aadBytes)
Buffer binaryAeadPlain = crypto.chacha20Poly1305DecryptBytes(key32Bytes, nonceBytes, binaryAead, aadBytes)
Buffer binaryAes128 = crypto.aes128GcmEncryptBytes(key16Bytes, nonceBytes, binary, aadBytes)
Buffer binaryAes128Plain = crypto.aes128GcmDecryptBytes(key16Bytes, nonceBytes, binaryAes128, aadBytes)
Buffer binaryAes256 = crypto.aes256GcmEncryptBytes(key32Bytes, nonceBytes, binary, aadBytes)
Buffer binaryAes256Plain = crypto.aes256GcmDecryptBytes(key32Bytes, nonceBytes, binaryAes256, aadBytes)
Buffer binaryHkdf = crypto.hkdfSha256Bytes(encoding.toBytes("key"), encoding.toBytes("salt"), encoding.toBytes("info"), 32)
Buffer binaryHkdf384 = crypto.hkdfSha384Bytes(encoding.toBytes("key"), encoding.toBytes("salt"), encoding.toBytes("info"), 32)
Sha256 binaryStream = crypto.sha256Stream()
binaryStream.update(binary)
line("binary",
    codec.hexEncodeBytes(binarySha.data(), c_size(binarySha.len())) == "3D1F57C984978EF98A18378C8166C1CB8EDE02C03EEB6AEE7E2F121DFEEE3E56" and
    binarySha1.len() == 20 and binarySha384.len() == 48 and binarySha512.len() == 64 and
    binaryHmac.len() == 32 and
    binaryHmac384.len() == 48 and binaryHmac512.len() == 64 and
    binaryStream.bytes() == binarySha and
    binaryStreamPlain == binary and
    binaryAeadPlain == binary and
    binaryAes128Plain == binary and
    binaryAes256Plain == binary and
    binaryHkdf.len() == 32 and binaryHkdf384.len() == 32 and
    crypto.randomBytes(17).len() == 17)

string streamCipher = crypto.chacha20Encrypt(key32, nonce, plain, 1)
line("chacha20", crypto.chacha20Decrypt(key32, nonce, streamCipher, 1) == plain and crypto.chacha20Encrypt("bad", nonce, plain, 1) == "")

var ed = crypto.ed25519Keypair()
string seed = string(ed["seed"])
string pub = string(ed["publicKey"])
string sig = crypto.ed25519Sign(seed, "message")
line("ed25519",
    string.len(seed) == 64 and
    string.len(pub) == 64 and
    crypto.ed25519PublicKey(seed) == pub and
    crypto.ed25519Verify(pub, "message", sig) and
    not crypto.ed25519Verify(pub, "message!", sig))

var x25519A = crypto.x25519Keypair()
var x25519B = crypto.x25519Keypair()
string x25519SecretA = crypto.x25519SharedSecret(string(x25519A["privateKey"]), string(x25519B["publicKey"]))
string x25519SecretB = crypto.x25519SharedSecret(string(x25519B["privateKey"]), string(x25519A["publicKey"]))
line("x25519", string.len(x25519SecretA) == 64 and x25519SecretA == x25519SecretB)

var x448A = crypto.x448Keypair()
var x448B = crypto.x448Keypair()
string x448SecretA = crypto.x448SharedSecret(string(x448A["privateKey"]), string(x448B["publicKey"]))
string x448SecretB = crypto.x448SharedSecret(string(x448B["privateKey"]), string(x448A["publicKey"]))
line("x448", string.len(x448SecretA) == 112 and x448SecretA == x448SecretB)

var p256A = crypto.p256Keypair()
var p256B = crypto.p256Keypair()
string p256SecretA = crypto.p256SharedSecret(string(p256A["privateKey"]), string(p256B["publicKey"]))
string p256SecretB = crypto.p256SharedSecret(string(p256B["privateKey"]), string(p256A["publicKey"]))
var p384A = crypto.p384Keypair()
var p384B = crypto.p384Keypair()
string p384SecretA = crypto.p384SharedSecret(string(p384A["privateKey"]), string(p384B["publicKey"]))
string p384SecretB = crypto.p384SharedSecret(string(p384B["privateKey"]), string(p384A["publicKey"]))
line("ecdh",
    string.len(p256SecretA) == 64 and p256SecretA == p256SecretB and
    string.len(p384SecretA) == 96 and p384SecretA == p384SecretB)

line("signature_guard",
    not crypto.ecdsaVerify("", "", "") and
    not crypto.rsaPssVerify("", "", "", "") and
    not crypto.rsaPkcs1Verify("bad", "00", "00", "010001"))
