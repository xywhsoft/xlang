import skiplist

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

int createFailures = 0
int createSuccesses = 0
for allocation in range(16)
    bool caught = false
    assert failAfter(uint64(allocation))
    try
        skiplist.SkipList candidate = skiplist.create()
        assert candidate.valid
    catch MemoryError error
        caught = true
    end
    bool triggered = failTriggered()
    failClear()
    assert triggered == caught
    if caught then createFailures += 1 else createSuccesses += 1 end
end
assert createFailures > 0 and createSuccesses > 0

int insertFailures = 0
int insertSuccesses = 0
for allocation in range(16)
    skiplist.SkipList list = skiplist.create()
    bool caught = false
    assert failAfter(uint64(allocation))
    try
        list.set("key", "value")
    catch MemoryError error
        caught = true
    end
    bool triggered = failTriggered()
    failClear()
    assert triggered == caught
    if caught then
        assert list.count == 0 and not list.contains("key")
        insertFailures += 1
    else
        assert list.count == 1 and list.get("key") == "value"
        insertSuccesses += 1
    end
end
assert insertFailures > 0 and insertSuccesses > 0

int overwriteFailures = 0
int overwriteSuccesses = 0
for allocation in range(16)
    skiplist.SkipList list = skiplist.create()
    list.set("key", "old")
    bool caught = false
    assert failAfter(uint64(allocation))
    try
        list.set("key", "new")
    catch MemoryError error
        caught = true
    end
    bool triggered = failTriggered()
    failClear()
    assert triggered == caught
    if caught then
        assert list.get("key") == "old"
        overwriteFailures += 1
    else
        assert list.get("key") == "new"
        overwriteSuccesses += 1
    end
end
assert overwriteFailures > 0 and overwriteSuccesses > 0

skiplist.SkipList list = skiplist.create()
list.set("a", "first")
list.set("b", "second")
for operation in range(3)
    int failures = 0
    int successes = 0
    int attempts = 16
    if operation == 2 then attempts = 64 end
    for allocation in range(attempts)
        bool caught = false
        assert failAfter(uint64(allocation))
        try
            if operation == 0 then
                assert list.get("a") == "first"
            elseif operation == 1 then
                assert list.keys().length == 2
            else
                assert list.range("a", "b").length == 2
            end
        catch MemoryError error
            caught = true
        end
        bool triggered = failTriggered()
        failClear()
        assert triggered == caught
        if caught then failures += 1 else successes += 1 end
        assert list.count == 2 and list.get("b") == "second"
    end
    assert failures > 0 and successes > 0
end

skiplist.SkipList large = skiplist.create()
for i in range(64)
    large.set("k" + string(i), "v" + string(i))
end
int largeFailures = 0
for allocation in range(64)
    bool caught = false
    var matches = null
    assert failAfter(uint64(allocation))
    try
        matches = large.range("k0", "k99")
    catch MemoryError error
        caught = true
    end
    bool triggered = failTriggered()
    failClear()
    assert not caught or triggered
    if caught then
        largeFailures += 1
    else
        assert matches.length == 64
    end
    assert large.count == 64 and large.get("k0") == "v0"
end
assert largeFailures > 0
assert large.range("k0", "k99").length == 64
