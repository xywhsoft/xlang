extern "xsw_split" func __sw_split(string line) as var
extern "xsw_quote" func __sw_quote(string word) as string
extern "xsw_quote_windows" func __sw_quote_windows(string word) as string
extern "xsw_join" func __sw_join(var words) as string



// split 按 POSIX shell 规则拆分命令行：单引号原样、双引号转义、反斜杠转义
// 引号不闭合抛 ValueError
export func split(string line) as var
    var r = __sw_split(line)
    if r == null then
        throw ValueError "shellwords: unbalanced quotes"
    end
    return r
end

// quote 生成 POSIX 安全的单词：安全词原样返回，否则用单引号包裹
export func quote(string word) as string
    return __sw_quote(word)
end

// quoteWindows 按 MSVCRT 规则生成 Windows 命令行参数
export func quoteWindows(string word) as string
    return __sw_quote_windows(word)
end

// join 把字符串数组逐个 quote 后用空格连接成一条命令行
export func join(var words) as string
    return __sw_join(words)
end
