export func html(string markdown) as string
    __md4c_text(markdown)
    point result = __xl6_native_md4c_html(markdown)
    if result == null then
        throw ValueError "md4c: render failed: " + last_error()
    end
    return __xl_runtime.takeCstr(result)
end
