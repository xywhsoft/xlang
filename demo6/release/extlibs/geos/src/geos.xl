extern "xgeos_point_in_polygon" func __point_in_polygon(float px, float py, string poly) as int
extern "xgeos_polygon_area" func __polygon_area(string poly) as float
extern "xgeos_centroid_x" func __centroid_x(string poly) as float
extern "xgeos_centroid_y" func __centroid_y() as float
extern "xgeos_perimeter" func __perimeter(string poly) as float
extern "xgeos_point_segment_dist" func __point_segment_dist(float px, float py, float x1, float y1, float x2, float y2) as float
extern "xgeos_bbox_minx" func __bbox_minx(string poly) as float
extern "xgeos_bbox_miny" func __bbox_miny() as float
extern "xgeos_bbox_maxx" func __bbox_maxx() as float
extern "xgeos_bbox_maxy" func __bbox_maxy() as float
extern "xgeos_segments_intersect" func __segments_intersect(float ax, float ay, float bx, float by, float cx, float cy, float dx, float dy) as int
extern "xgeos_type_name" func __type_name(int code) as string

export func pointInPolygon(float px, float py, string poly) as int
    return __point_in_polygon(px, py, poly)
end

export func polygonArea(string poly) as float
    return __polygon_area(poly)
end

export func centroidX(string poly) as float
    return __centroid_x(poly)
end

export func centroidY() as float
    return __centroid_y()
end

export func perimeter(string poly) as float
    return __perimeter(poly)
end

export func pointSegmentDist(float px, float py, float x1, float y1, float x2, float y2) as float
    return __point_segment_dist(px, py, x1, y1, x2, y2)
end

export func bboxMinX(string poly) as float
    return __bbox_minx(poly)
end

export func bboxMinY() as float
    return __bbox_miny()
end

export func bboxMaxX() as float
    return __bbox_maxx()
end

export func bboxMaxY() as float
    return __bbox_maxy()
end

export func segmentsIntersect(float ax, float ay, float bx, float by, float cx, float cy, float dx, float dy) as int
    return __segments_intersect(ax, ay, bx, by, cx, cy, dx, dy)
end

export func typeName(int code) as string
    return __type_name(code)
end
