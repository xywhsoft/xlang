extern "xssh_msg_type" func __msg_type(int type) as string
extern "xssh_disconnect_reason" func __disconnect_reason(int code) as string
extern "xssh_channel_failure" func __channel_failure(int code) as string
extern "xssh_kex_name" func __kex_name(int id) as string
extern "xssh_cipher_name" func __cipher_name(int id) as string
extern "xssh_mac_name" func __mac_name(int id) as string
extern "xssh_hostkey_name" func __hostkey_name(int id) as string
extern "xssh_auth_method" func __auth_method(int id) as string

export func msgType(int type) as string
    return __msg_type(type)
end

export func disconnectReason(int code) as string
    return __disconnect_reason(code)
end

export func channelFailure(int code) as string
    return __channel_failure(code)
end

export func kexName(int id) as string
    return __kex_name(id)
end

export func cipherName(int id) as string
    return __cipher_name(id)
end

export func macName(int id) as string
    return __mac_name(id)
end

export func hostkeyName(int id) as string
    return __hostkey_name(id)
end

export func authMethod(int id) as string
    return __auth_method(id)
end
