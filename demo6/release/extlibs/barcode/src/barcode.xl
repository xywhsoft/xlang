extern "xb_ean13" func __b_ean13(string digits, c_size length) as var
extern "xb_upc_a" func __b_upc_a(string digits, c_size length) as var
extern "xb_checksum_ean" func __b_checksum_ean(string digits, c_size length) as int
extern "xb_validate_ean" func __b_validate_ean(string code, c_size length) as bool
extern "xb_svg" @owned func __b_svg(string digits, c_size length, bool isUpcA, int height, int scale) as string?
extern "xb_ascii" @owned func __b_ascii(string digits, c_size length, bool isUpcA) as string?



// ean13 生成 EAN-13 模块位串（0/1 数组，共 95 位）
// 输入 12 位时自动补校验位；输入 13 位时校验失败抛 ValueError
export func ean13(string digits) as var
    var r = __b_ean13(digits, c_size(string.byteLen(digits)))
    if r == null then
        throw ValueError "barcode: ean13 needs 12 digits or a valid 13-digit code"
    end
    return r
end

// upcA 生成 UPC-A 条码（实现为前缀 0 的 EAN-13）
export func upcA(string digits) as var
    var r = __b_upc_a(digits, c_size(string.byteLen(digits)))
    if r == null then
        throw ValueError "barcode: upcA needs 11 digits or a valid 12-digit code"
    end
    return r
end

// checksumEan 计算 12 位 EAN 数据的校验位；非法输入返回 -1
export func checksumEan(string digits) as int
    return __b_checksum_ean(digits, c_size(string.byteLen(digits)))
end

// validateEan 校验 13 位 EAN 码
export func validateEan(string code) as bool
    return __b_validate_ean(code, c_size(string.byteLen(code)))
end

// ean13Svg 生成矢量条形图
export func ean13Svg(string digits, int height, int scale) as string
    string? result = __b_svg(digits, c_size(string.byteLen(digits)), false, height, scale)
    if result == null then
        throw ValueError "barcode: invalid EAN-13 or SVG size"
    end
    return result
end

// upcASvg 生成 UPC-A 矢量条形图
export func upcASvg(string digits, int height, int scale) as string
    string? result = __b_svg(digits, c_size(string.byteLen(digits)), true, height, scale)
    if result == null then
        throw ValueError "barcode: invalid UPC-A or SVG size"
    end
    return result
end

// ean13Ascii 用明暗字符渲染条码
export func ean13Ascii(string digits) as string
    string? result = __b_ascii(digits, c_size(string.byteLen(digits)), false)
    if result == null then
        throw ValueError "barcode: invalid EAN-13"
    end
    return result
end

export func upcAAscii(string digits) as string
    string? result = __b_ascii(digits, c_size(string.byteLen(digits)), true)
    if result == null then
        throw ValueError "barcode: invalid UPC-A"
    end
    return result
end
