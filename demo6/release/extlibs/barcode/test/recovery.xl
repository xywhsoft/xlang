import barcode

func main(...) as int
    bool caught = false
    try
        barcode.ean13Svg("bad", 60, 3)
    catch e
        caught = true
    end
    assert caught
    assert barcode.checksumEan("400638133393") == 1
    assert barcode.validateEan("4006381333931")
    assert barcode.ean13Ascii("4006381333931").length == 95
    assert barcode.upcAAscii("12345678901").length == 95
    println("barcode recovery: PASS")
    return 0
end
