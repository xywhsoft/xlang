// md5 — MD5 消息摘要（128 位），支持 Buffer/string/文件/流式四种输入模式。
// 输入统一使用 Buffer，避免二进制数据经过字符串转换。
extern "xl6_xrt_last_error_text" func __md5_error() as string
extern "xmd5_version" func __md5_version() as string
extern "xmd5_hash_hex" func __md5_hash_hex(point data, c_size size) as string
extern "xmd5_hash_str_hex" func __md5_hash_str(string data, c_size size) as string
extern "xmd5_hash_bytes" func __md5_hash_bytes(point data, c_size size) as point
extern "xmd5_hash_str_bytes" func __md5_hash_str_bytes(string data, c_size size) as point
extern "xmd5_file_hex" func __md5_file_hex(string path, c_ulonglong maxInput, var onProgress) as string
extern "xmd5_file_bytes" func __md5_file_bytes(string path, c_ulonglong maxInput, var onProgress) as point
extern "xmd5_file_status" func __md5_file_status() as c_int



// 返回 MD5 摘要长度（字节）。
export const int MD5_DIGEST_SIZE = 16



// 返回内嵌 MD5 引擎的版本号。
export func version() as string
    return __md5_version()
end

func __md5_check_limit(int value, string name)
    if value <= 0 then
        throw ValueError name + " must be greater than zero"
    end
end





// 一次性 MD5 哈希（返回 32 位十六进制小写字符串）。
export func hashHex(Buffer data) as string
    string result = __md5_hash_hex(data.data(), c_size(data.len()))
    if result == "" then
        throw ValueError __md5_error()
    end
    return result
end

export func hashHex(string text) as string
    string result = __md5_hash_str(text, c_size(string.len(text)))
    if result == "" then
        throw ValueError __md5_error()
    end
    return result
end

// 一次性 MD5 哈希（返回 16 字节原始摘要 Buffer）。
export func hash(Buffer data) as Buffer
    point result = __md5_hash_bytes(data.data(), c_size(data.len()))
    if result == null then
        throw ValueError __md5_error()
    end
    return Buffer(result)
end

export func hash(string text) as Buffer
    point result = __md5_hash_str_bytes(text, c_size(string.len(text)))
    if result == null then
        throw ValueError __md5_error()
    end
    return Buffer(result)
end



// 文件 MD5 哈希（XRT reader 分块读取，受 maxInput 限制）。
export func hashFileHex(string path, int maxInput = 268435456,
    (func(int, int, int) as bool)? onProgress = null) as string
    __md5_check_limit(maxInput, "maxInput")
    var progress = null
    if onProgress != null then
        progress = xcall(onProgress)
    end
    string result = __md5_file_hex(path, c_ulonglong(maxInput), progress)
    int status = __md5_file_status()
    if status == -1 then
        throw CancelledError "md5 operation cancelled"
    elseif status != 1 then
        throw FileError __md5_error()
    end
    return result
end

export func hashFile(string path, int maxInput = 268435456,
    (func(int, int, int) as bool)? onProgress = null) as Buffer
    __md5_check_limit(maxInput, "maxInput")
    var progress = null
    if onProgress != null then
        progress = xcall(onProgress)
    end
    point result = __md5_file_bytes(path, c_ulonglong(maxInput), progress)
    int status = __md5_file_status()
    if status == -1 then
        throw CancelledError "md5 operation cancelled"
    elseif status != 1 then
        throw FileError __md5_error()
    end
    return Buffer(result)
end



// 增量流式哈希器：update() 喂入数据，digestHex()/digest() 读取当前哈希值（不终结），
// reset() 复位重新计算。配合 inputBytes 可自行驱动进度回显。
export class Md5Hasher
    native point handle
    extern "xmd5_hasher_create" create(c_ulonglong maxInput)
    extern "xmd5_hasher_destroy" destroy()
    extern "xmd5_hasher_update" func updateNative(point data, c_size size) as bool
    extern "xmd5_hasher_update_str" func updateStrNative(string data, c_size size) as bool
    extern "xmd5_hasher_digest_hex" func digestHexNative() as string
    extern "xmd5_hasher_digest_bytes" func digestBytesNative() as point
    extern "xmd5_hasher_reset" func resetNative() as bool
    extern "xmd5_hasher_input_bytes" func inputBytesNative() as int

    get valid() as bool
        return self.handle != null
    end

    // 已喂入的字节数（进度回显用）。
    get inputBytes() as int
        return self.inputBytesNative()
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw ValueError __md5_error()
        end
    end

    func update(string text)
        if not self.updateStrNative(text, c_size(string.len(text))) then
            throw ValueError __md5_error()
        end
    end

    // 读取当前累计输入的 MD5 摘要（32 位十六进制小写字符串，不终结状态）。
    func digestHex() as string
        string result = self.digestHexNative()
        if result == "" then
            throw ValueError __md5_error()
        end
        return result
    end

    // 读取当前累计输入的 MD5 摘要（16 字节原始 Buffer，不终结状态）。
    func digest() as Buffer
        point result = self.digestBytesNative()
        if result == null then
            throw ValueError __md5_error()
        end
        return Buffer(result)
    end

    // 复位哈希器（清空累计输入）。
    func reset() as bool
        if not self.resetNative() then
            throw ValueError __md5_error()
        end
        return true
    end
end



// 创建流式 MD5 哈希器。
export func hasher(int maxInput = 268435456) as Md5Hasher
    __md5_check_limit(maxInput, "maxInput")
    Md5Hasher result = Md5Hasher(c_ulonglong(maxInput))
    if not result.valid then
        throw ValueError __md5_error()
    end
    return result
end
