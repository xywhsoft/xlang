end

func __xl6_import_x_uia_from_point(int x, int y) as Element
	return from_point(x, y)
end

func __xl6_import_x_uia_events() as Events
	return events()
end

func __xl6_import_x_uia_element(point handle) as Element
	return element(handle)
end

func __xl6_import_x_uia_locator_for(Element element_value) as string
	return locator_for(element_value)
end

func __xl6_import_x_uia_by_name(string name) as Condition
	return by_name(name)
end

func __xl6_import_x_uia_by_process_id(int process_id) as Condition
	return by_process_id(process_id)
