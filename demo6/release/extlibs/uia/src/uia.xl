end

func __xl6_import_x_uia_all_of(Condition left, Condition right) as Condition
	return all_of(left, right)
end

func __xl6_import_x_uia_any_of(Condition left, Condition right) as Condition
	return any_of(left, right)
end

func __xl6_import_x_uia_not_condition(Condition condition) as Condition
