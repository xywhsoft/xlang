class Element
	point handle

	create(point h)
		self.handle = h
	end


	func release() as bool
		return x_uia_element_release(self.handle)
	end

	func valid() as bool
		return x_uia_element_valid(self.handle)
	end

	func name() as string
		return x_uia_element_name(self.handle)
	end

	func automation_id() as string
		return x_uia_element_automation_id(self.handle)
	end

	func class_name() as string
		return x_uia_element_class_name(self.handle)
	end

	func control_type() as int
		return x_uia_element_control_type(self.handle)
	end

	func hwnd() as point
		return x_uia_element_hwnd(self.handle)
	end

	func rect_json() as string
		return x_uia_element_rect_json(self.handle)
	end

	func snapshot_json(int depth, int max_nodes) as string
		return x_uia_element_snapshot_json(self.handle, depth, max_nodes)
	end

	func cached_children_json(int depth, int max_nodes) as string
		return x_uia_element_cached_children_json(self.handle, depth, max_nodes)
	end

	func locator_json() as string
		return x_uia_locator_for(self.handle)
	end

	func find_first(Condition condition, int timeout_ms) as Element
		return Element(x_uia_element_find_first(self.handle, condition.handle, 4, timeout_ms))
	end

	func find_first_scope(Condition condition, int scope, int timeout_ms) as Element
		return Element(x_uia_element_find_first(self.handle, condition.handle, scope, timeout_ms))
	end

	func find_all(Condition condition, int scope, int timeout_ms) as var
		return x_uia_element_find_all(self.handle, condition.handle, scope, timeout_ms)
	end

	func parent() as Element
		return Element(x_uia_element_parent(self.handle))
	end

	func children() as var
		return x_uia_element_children(self.handle)
	end

	func set_focus() as bool
		return x_uia_element_set_focus(self.handle)
	end

	func click() as bool
		return x_uia_element_click(self.handle, 5000)
	end

	func click_timeout(int timeout_ms) as bool
		return x_uia_element_click(self.handle, timeout_ms)
	end

	func invoke() as bool
		return x_uia_element_invoke(self.handle)
	end

	func value() as string
		return x_uia_element_value(self.handle)
	end

	func set_value(string value) as bool
		return x_uia_element_set_value(self.handle, value)
	end

	func text() as string
		return x_uia_element_text(self.handle)
	end

	func toggle() as bool
		return x_uia_element_toggle(self.handle)
	end

	func toggle_state() as int
		return x_uia_element_toggle_state(self.handle)
	end

	func range_value() as float
		return x_uia_element_range_value(self.handle)
	end

	func range_min() as float
		return x_uia_element_range_min(self.handle)
	end

	func range_max() as float
		return x_uia_element_range_max(self.handle)
	end

	func set_range_value(float value) as bool
		return x_uia_element_set_range_value(self.handle, value)
	end

	func scroll(int horizontal, int vertical) as bool
		return x_uia_element_scroll(self.handle, horizontal, vertical)
	end

	func close_window() as bool
		return x_uia_element_close_window(self.handle)
	end

	func wait_window_closed(int timeout_ms) as bool
		return x_uia_element_wait_window_closed(self.handle, timeout_ms)
	end
end

class Events
	point handle

	create(point h)
		self.handle = h
	end


	func valid() as bool
		return x_uia_events_valid(self.handle)
	end

	func subscribe_focus_changed() as bool
		return x_uia_events_subscribe_focus_changed(self.handle)
	end

	func subscribe_property_changed(Element element, int property_id) as bool
		return x_uia_events_subscribe_property_changed(self.handle, element.handle, property_id)
	end

	func poll_json(int timeout_ms) as string
		return x_uia_events_poll_json(self.handle, timeout_ms)
	end

	func poll_callback(func(string) as int callback, int timeout_ms) as int
		auto json = x_uia_events_poll_json(self.handle, timeout_ms)
		if json == "{}" then
			return 0
		end
		return callback(json)
	end

	func release() as bool
		return x_uia_events_release(self.handle)
	end
end

func version() as string
	return x_uia_version()
end

func available() as bool
	return string.len(version()) > 0
end

func last_error() as string
	return x_uia_last_error()
end

func shutdown() as bool
	return x_uia_shutdown()
end

func launch(string command) as Process
	return Process(x_uia_launch(command))
end

func test_window() as TestWindow
	return TestWindow(x_uia_test_window_create())
end

func desktop() as Element
	return Element(x_uia_desktop())
end

func focused() as Element
	return Element(x_uia_focused())
end

func focused_locator() as string
	return x_uia_focused_locator()
end

func from_hwnd(point hwnd) as Element
	return Element(x_uia_from_hwnd(hwnd))
end

func from_point(int x, int y) as Element
	return Element(x_uia_from_point(x, y))
end

func events() as Events
	return Events(x_uia_events_create())
end

func element(point handle) as Element
	return Element(handle)
end

func locator_for(Element element) as string
	return x_uia_locator_for(element.handle)
end

func by_name(string name) as Condition
	return Condition(x_uia_by_name(name))
end

func by_process_id(int process_id) as Condition
	return Condition(x_uia_by_process_id(process_id))
end

func by_automation_id(string automation_id) as Condition
	return Condition(x_uia_by_automation_id(automation_id))
end

func by_class_name(string class_name) as Condition
	return Condition(x_uia_by_class_name(class_name))
end

func by_control_type(int control_type) as Condition
	return Condition(x_uia_by_control_type(control_type))
end

func all_of(Condition left, Condition right) as Condition
	return Condition(x_uia_condition_and(left.handle, right.handle))
end

func any_of(Condition left, Condition right) as Condition
	return Condition(x_uia_condition_or(left.handle, right.handle))
end

func not_condition(Condition condition) as Condition
	return Condition(x_uia_condition_not(condition.handle))
end

