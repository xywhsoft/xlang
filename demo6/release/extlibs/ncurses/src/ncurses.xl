extern "xncurses_init" func __nc_init(int rows, int cols) as bool
extern "xncurses_clear" func __nc_clear()
extern "xncurses_move" func __nc_move(int row, int col)
extern "xncurses_addstr" func __nc_addstr(string s)
extern "xncurses_mvaddstr" func __nc_mvadd(int row, int col, string s)
extern "xncurses_addch" func __nc_addch(int ch)
extern "xncurses_inch" func __nc_inch(int row, int col) as int
extern "xncurses_attrset" func __nc_attrset(int attr)
extern "xncurses_attrat" func __nc_attrat(int row, int col) as int
extern "xncurses_hline" func __nc_hline(int row, int col, int ch, int len)
extern "xncurses_vline" func __nc_vline(int row, int col, int ch, int len)
extern "xncurses_box" func __nc_box(int r1, int c1, int r2, int c2)
extern "xncurses_getrow" func __nc_getrow(int row) as string
extern "xncurses_render" func __nc_render() as string
extern "xncurses_getyx" func __nc_getyx() as int
extern "xncurses_getmax" func __nc_getmax() as int
extern "xncurses_fill" func __nc_fill(int r1, int c1, int r2, int c2, int ch)



export func init(int rows = 24, int cols = 80) as bool
    return __nc_init(rows, cols)
end

export func clear()
    __nc_clear()
end

export func move(int row, int col)
    __nc_move(row, col)
end

export func addStr(string s)
    __nc_addstr(s)
end

export func mvAddStr(int row, int col, string s)
    __nc_mvadd(row, col, s)
end

export func addCh(int ch)
    __nc_addch(ch)
end

export func inCh(int row, int col) as int
    return __nc_inch(row, col)
end

export func attrSet(int attr)
    __nc_attrset(attr)
end

export func attrAt(int row, int col) as int
    return __nc_attrat(row, col)
end

export func hline(int row, int col, int ch, int len)
    __nc_hline(row, col, ch, len)
end

export func vline(int row, int col, int ch, int len)
    __nc_vline(row, col, ch, len)
end

export func box(int r1, int c1, int r2, int c2)
    __nc_box(r1, c1, r2, c2)
end

export func getRow(int row) as string
    return __nc_getrow(row)
end

export func render() as string
    return __nc_render()
end

export func getYX() as int
    return __nc_getyx()
end

export func getMax() as int
    return __nc_getmax()
end

export func fill(int r1, int c1, int r2, int c2, int ch)
    __nc_fill(r1, c1, r2, c2, ch)
end
