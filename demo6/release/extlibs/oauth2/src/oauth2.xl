extern "xoa_build_authorize_url" func __oa_build_authorize_url(string baseUrl, string clientId, string redirectUri, string scope, string state, string challenge) as string
extern "xoa_code_challenge" func __oa_code_challenge(string verifier) as string
extern "xoa_verify_challenge" func __oa_verify_challenge(string verifier, string challenge) as bool
extern "xoa_make_verifier" func __oa_make_verifier() as string
extern "xoa_parse_callback" func __oa_parse_callback(string query) as var



// buildAuthorizeUrl 组装带 PKCE 的授权端点 URL（参数做百分号转义）
// scope 与 state 可传空串省略
export func buildAuthorizeUrl(string baseUrl, string clientId, string redirectUri, string scope, string state, string challenge) as string
    string url = __oa_build_authorize_url(baseUrl, clientId, redirectUri, scope, state, challenge)
    if url == "" then
        throw ValueError "oauth2: authorize url assembly failed"
    end
    return url
end

// codeChallenge 计算 S256 挑战：base64url(SHA-256(verifier))
// verifier 长度必须 43-128，否则抛 ValueError
export func codeChallenge(string verifier) as string
    string challenge = __oa_code_challenge(verifier)
    if challenge == "" then
        throw ValueError "oauth2: verifier must be 43-128 characters"
    end
    return challenge
end

// verifyChallenge 服务端校验工具：重算挑战并与给定值比对
export func verifyChallenge(string verifier, string challenge) as bool
    return __oa_verify_challenge(verifier, challenge)
end

// makeVerifier 生成 43 字符 base64url 校验器
// 种子为时间与地址熵，适合演示；生产环境建议使用密码学随机源
export func makeVerifier() as string
    return __oa_make_verifier()
end

// parseCallback 解析回调查询串（?code=...&state=... 或 error 场景）
export func parseCallback(string query) as var
    var r = __oa_parse_callback(query)
    if r == null then
        throw ValueError "oauth2: callback query is null"
    end
    return r
end
