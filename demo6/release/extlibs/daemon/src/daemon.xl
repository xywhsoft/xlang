extern "xrtGetError" func __daemon_error() as string



class Daemon
    native point handle
    extern "xdaemon_create" create(string name)
    extern "xdaemon_destroy" destroy()

    extern "xdaemon_detach" func detachNative() as bool
    extern "xdaemon_write_pidfile" func writePidNative(string path) as bool
    extern "xdaemon_get_pid" func pidNative() as int
    extern "xdaemon_is_daemonized" func isDaemonizedNative() as bool
    extern "xdaemon_set_running" func setRunningNative(int val)
    extern "xdaemon_is_running" func isRunningNative() as bool
    extern "xdaemon_name" func nameNative() as string
    extern "xdaemon_status" func statusNative() as string

    get valid() as bool
        return self.handle != null
    end

    get pid() as int
        return self.pidNative()
    end

    get name() as string
        return self.nameNative()
    end

    get isDaemonized() as bool
        return self.isDaemonizedNative()
    end

    get isRunning() as bool
        return self.isRunningNative()
    end

    get status() as string
        return self.statusNative()
    end

    func stop()
        self.setRunningNative(0)
    end

    func writePidFile(string path) as bool
        return self.writePidNative(path)
    end
end

extern "xdaemon_read_pidfile" func __daemon_read_pid(string path) as int
extern "xdaemon_is_alive" func __daemon_alive(int pid) as bool



export func create(string name) as Daemon
    return Daemon(name)
end

export func readPidFile(string path) as int
    return __daemon_read_pid(path)
end

export func isAlive(int pid) as bool
    return __daemon_alive(pid)
end
