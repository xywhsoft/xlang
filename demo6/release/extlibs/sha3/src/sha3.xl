// SHA3 固定摘要与 SHAKE 变长输出。文本统一按 UTF-8 字节处理。
extern "xsha3_version" func __version() as string
extern "xsha3_hash_hex_owned" func __hex(point data, c_size size, c_int bits) as point
extern "xsha3_hash_str_hex_owned" func __hexStr(string data, c_size size, c_int bits) as point
extern "xsha3_hash_bytes" func __bytes(point data, c_size size, c_int bits) as point
extern "xsha3_hash_str_bytes" func __bytesStr(string data, c_size size, c_int bits) as point
extern "xshake_hash_hex_owned" func __shakeHex(point data, c_size size, c_int strength, c_size length) as point
extern "xshake_hash_str_hex_owned" func __shakeHexStr(string data, c_size size, c_int strength, c_size length) as point
extern "xshake_hash_bytes" func __shakeBytes(point data, c_size size, c_int strength, c_size length) as point
extern "xshake_hash_str_bytes" func __shakeBytesStr(string data, c_size size, c_int strength, c_size length) as point
extern "xsha3_file_hex" func __fileHex(string path, c_ulonglong maximum, c_int bits, var callback) as string
extern "xsha3_file_bytes" func __fileBytes(string path, c_ulonglong maximum, c_int bits, var callback) as point

func __bits(int bits) as c_int
    if bits != 224 and bits != 256 and bits != 384 and bits != 512 then
        throw ValueError "sha3 bits must be 224, 256, 384 or 512"
    end
    return c_int(bits)
end
func __strength(int strength) as c_int
    if strength != 128 and strength != 256 then
        throw ValueError "shake strength must be 128 or 256"
    end
    return c_int(strength)
end
func __length(int length) as c_size
    if length < 0 then
        throw ValueError "sha3 output length must not be negative"
    end
    c_size result = c_size(length)
    if uint64(result) != uint64(length) then
        throw RangeError "sha3 output length exceeds native size range"
    end
    return result
end
func __limit(int maximum)
    if maximum <= 0 then
        throw ValueError "maxInput must be greater than zero"
    end
end

// ----------------------------- 文本与二进制摘要 -----------------------------

export func version() as string
    return __version()
end
export func hashHex(Buffer data, int bits = 256) as string
    return __xl_runtime.takeCstr(__hex(data.data(), c_size(data.len()), __bits(bits)))
end
export func hashHex(string text, int bits = 256) as string
    return __xl_runtime.takeCstr(__hexStr(text, c_size(string.byteLen(text)), __bits(bits)))
end
export func hashBytes(Buffer data, int bits = 256) as Buffer
    return Buffer(__bytes(data.data(), c_size(data.len()), __bits(bits)))
end
export func hashBytes(string text, int bits = 256) as Buffer
    return Buffer(__bytesStr(text, c_size(string.byteLen(text)), __bits(bits)))
end
export func hash256Hex(Buffer data) as string
    return hashHex(data, 256)
end
export func hash256Hex(string text) as string
    return hashHex(text, 256)
end
export func hash256Bytes(Buffer data) as Buffer
    return hashBytes(data, 256)
end
export func hash256Bytes(string text) as Buffer
    return hashBytes(text, 256)
end
export func shake128Hex(Buffer data, int outLen = 32) as string
    return __xl_runtime.takeCstr(__shakeHex(data.data(), c_size(data.len()), c_int(128), __length(outLen)))
end
export func shake128Hex(string text, int outLen = 32) as string
    return __xl_runtime.takeCstr(__shakeHexStr(text, c_size(string.byteLen(text)), c_int(128), __length(outLen)))
end
export func shake256Hex(Buffer data, int outLen = 32) as string
    return __xl_runtime.takeCstr(__shakeHex(data.data(), c_size(data.len()), c_int(256), __length(outLen)))
end
export func shake256Hex(string text, int outLen = 32) as string
    return __xl_runtime.takeCstr(__shakeHexStr(text, c_size(string.byteLen(text)), c_int(256), __length(outLen)))
end
export func shake128Bytes(Buffer data, int outLen = 32) as Buffer
    return Buffer(__shakeBytes(data.data(), c_size(data.len()), c_int(128), __length(outLen)))
end
export func shake128Bytes(string text, int outLen = 32) as Buffer
    return Buffer(__shakeBytesStr(text, c_size(string.byteLen(text)), c_int(128), __length(outLen)))
end
export func shake256Bytes(Buffer data, int outLen = 32) as Buffer
    return Buffer(__shakeBytes(data.data(), c_size(data.len()), c_int(256), __length(outLen)))
end
export func shake256Bytes(string text, int outLen = 32) as Buffer
    return Buffer(__shakeBytesStr(text, c_size(string.byteLen(text)), c_int(256), __length(outLen)))
end

// ----------------------------- 文件与同步进度 -----------------------------

func __progress(func(int, int, int) as bool callback) as var
    return xcall(func(uint64 current, uint64 total, uint64 output) as bool
        uint64 maximum = uint64(9223372036854775807)
        if current > maximum or total > maximum or output > maximum then
            throw RangeError "sha3 progress exceeds int range"
        end
        return callback(int(current), int(total), int(output))
    end)
end
export func hashFileHex(string path, int bits = 256, int maxInput = 268435456,
    (func(int, int, int) as bool)? onProgress = null) as string
    __limit(maxInput)
    var callback = null
    if onProgress != null then
        callback = __progress(onProgress)
    end
    return __fileHex(path, c_ulonglong(maxInput), __bits(bits), callback)
end
export func hashFileBytes(string path, int bits = 256, int maxInput = 268435456,
    (func(int, int, int) as bool)? onProgress = null) as Buffer
    __limit(maxInput)
    var callback = null
    if onProgress != null then
        callback = __progress(onProgress)
    end
    return Buffer(__fileBytes(path, c_ulonglong(maxInput), __bits(bits), callback))
end

// ----------------------------- 固定摘要的流式对象 -----------------------------

export class Sha3Hasher
    native point handle
    extern "xsha3_hasher_create" create(c_int bits, c_ulonglong maxInput)
    private extern "xsha3_hasher_adopt" create(point handle)
    extern "xsha3_hasher_destroy" destroy()
    private extern "xsha3_hasher_update" func updateNative(point data, c_size size) as bool
    private extern "xsha3_hasher_update_str" func updateStrNative(string data, c_size size) as bool
    private extern "xsha3_hasher_digest_hex_owned" func digestHexNative(c_size length) as point
    private extern "xsha3_hasher_digest_bytes" func digestBytesNative(c_size length) as point
    extern "xsha3_hasher_reset" func reset() as bool
    private extern "xsha3_hasher_input_bytes" func inputBytesNative() as c_ulonglong
    private extern "xsha3_hasher_out_bytes" func outBytesNative() as c_int
    private extern "xsha3_hasher_clone" func cloneNative() as point

    get valid() as bool
        return self.handle != null
    end
    get inputBytes() as uint64
        return uint64(self.inputBytesNative())
    end
    func update(Buffer data)
        self.updateNative(data.data(), c_size(data.len()))
    end
    func update(string text)
        self.updateStrNative(text, c_size(string.byteLen(text)))
    end
    // 零表示自然长度；显式长度必须等于对应 SHA3 的固定摘要长度。
    func digestHex(int outLen = 0) as string
        if outLen == 0 then
            outLen = int(self.outBytesNative())
        end
        return __xl_runtime.takeCstr(self.digestHexNative(__length(outLen)))
    end
    func digestBytes(int outLen = 0) as Buffer
        if outLen == 0 then
            outLen = int(self.outBytesNative())
        end
        return Buffer(self.digestBytesNative(__length(outLen)))
    end
    func clone() as Sha3Hasher
        return Sha3Hasher(self.cloneNative())
    end
end

// ----------------------------- SHAKE 非终结输出快照 -----------------------------

export class ShakeHasher
    native point handle
    extern "xsha3_shake_hasher_create" create(c_int strength, c_ulonglong maxInput)
    private extern "xsha3_hasher_adopt" create(point handle)
    extern "xsha3_hasher_destroy" destroy()
    private extern "xsha3_hasher_update" func updateNative(point data, c_size size) as bool
    private extern "xsha3_hasher_update_str" func updateStrNative(string data, c_size size) as bool
    private extern "xsha3_hasher_digest_hex_owned" func digestHexNative(c_size length) as point
    private extern "xsha3_hasher_digest_bytes" func digestBytesNative(c_size length) as point
    extern "xsha3_hasher_reset" func reset() as bool
    private extern "xsha3_hasher_input_bytes" func inputBytesNative() as c_ulonglong
    private extern "xsha3_hasher_clone" func cloneNative() as point

    get valid() as bool
        return self.handle != null
    end
    get inputBytes() as uint64
        return uint64(self.inputBytesNative())
    end
    func update(Buffer data)
        self.updateNative(data.data(), c_size(data.len()))
    end
    func update(string text)
        self.updateStrNative(text, c_size(string.byteLen(text)))
    end
    // 每次从同一流前缀产生输出，不是推进游标的 squeeze。
    func digestHex(int outLen = 32) as string
        return __xl_runtime.takeCstr(self.digestHexNative(__length(outLen)))
    end
    func digestBytes(int outLen = 32) as Buffer
        return Buffer(self.digestBytesNative(__length(outLen)))
    end
    func clone() as ShakeHasher
        return ShakeHasher(self.cloneNative())
    end
end

export func sha3Hasher(int bits = 256, int maxInput = 268435456) as Sha3Hasher
    __limit(maxInput)
    return Sha3Hasher(__bits(bits), c_ulonglong(maxInput))
end
export func shakeHasher(int strength = 128, int maxInput = 268435456) as ShakeHasher
    __limit(maxInput)
    return ShakeHasher(__strength(strength), c_ulonglong(maxInput))
end
