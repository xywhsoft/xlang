        end
    end

    func update(string text)
        if not self.updateStrNative(text, c_size(string.len(text))) then
            throw ValueError __blake2_error()
        end
    end

    func digestHex(int digestSize = BLAKE2B_OUT_LEN) as string
        string result = self.digestHexNative(c_size(digestSize))
        if result == "" then
            throw ValueError __blake2_error()
        end
        return result
    end

    func digestBytes(int digestSize = BLAKE2B_OUT_LEN) as Buffer
        point result = self.digestBytesNative(c_size(digestSize))
        if result == null then
