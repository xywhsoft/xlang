// ═══════════════ 工厂函数 ═══════════════

export func blake2bHasher(int digestSize = BLAKE2B_OUT_LEN,
    int maxInput = 268435456) as Blake2bHasher
    __blake2_check_limit(maxInput, "maxInput")
    Blake2bHasher result = Blake2bHasher(c_size(digestSize), c_ulonglong(maxInput))
    if not result.valid then
        throw ValueError __blake2_error()
    end
    return result
end

export func blake2bKeyedHasher(Buffer key, int digestSize = BLAKE2B_OUT_LEN,
    int maxInput = 268435456) as Blake2bKeyedHasher
    __blake2_check_limit(maxInput, "maxInput")
    Blake2bKeyedHasher result = Blake2bKeyedHasher(c_size(digestSize), key.toBytes(), c_ulonglong(maxInput))
    if not result.valid then
        throw ValueError __blake2_error()
    end
    return result
end

export func blake2sHasher(int digestSize = BLAKE2S_OUT_LEN,
    int maxInput = 268435456) as Blake2sHasher
    __blake2_check_limit(maxInput, "maxInput")
    Blake2sHasher result = Blake2sHasher(c_size(digestSize), c_ulonglong(maxInput))
    if not result.valid then
        throw ValueError __blake2_error()
    end
    return result
end

export func blake2sKeyedHasher(Buffer key, int digestSize = BLAKE2S_OUT_LEN,
    int maxInput = 268435456) as Blake2sKeyedHasher
    __blake2_check_limit(maxInput, "maxInput")
    Blake2sKeyedHasher result = Blake2sKeyedHasher(c_size(digestSize), key.toBytes(), c_ulonglong(maxInput))
    if not result.valid then
        throw ValueError __blake2_error()
    end
    return result
end
