    func reset() as bool
        if not self.resetNative() then
            throw ValueError __blake2_error()
        end
        return true
    end

    func clone() as Blake2bKeyedHasher
        point hp = self.cloneNative()
        if hp == null then
            throw ValueError __blake2_error()
        end
        return Blake2bKeyedHasher(hp)
    end
end



