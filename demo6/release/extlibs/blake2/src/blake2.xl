    extern "xblake2b_hasher_update_str" func updateStrNative(string data, c_size size) as bool
    extern "xblake2b_hasher_digest_hex" func digestHexNative(c_size outLen) as string
    extern "xblake2b_hasher_digest_bytes" func digestBytesNative(c_size outLen) as point
    extern "xblake2b_hasher_reset" func resetNative() as bool
    extern "xblake2b_hasher_input_bytes" func inputBytesNative() as int
    extern "xblake2b_hasher_clone" func cloneNative() as point

    get valid() as bool
