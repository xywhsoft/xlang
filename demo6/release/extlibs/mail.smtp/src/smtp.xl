import mail.mime

extern "xmail_smtp_capability_json_native" func xmail_smtp_capability_json_native(string config_json) as string
extern "xmail_smtp_send_json_native" func xmail_smtp_send_json_native(string request_json) as string

export func available() as bool
    return true
end

export func version() as string
    return "0.1.0"
end

export func last_error() as string
    return ""
end

func mail_smtp_dry_run_text(string text) as bool
    string compact = string.replace(text, " ", "")
    compact = string.replace(compact, "\t", "")
    compact = string.replace(compact, "\r", "")
    compact = string.replace(compact, "\n", "")
    if string.contains(compact, "\"dry_run\":true") or string.contains(compact, "\"dry_run\":1") then
        return true
    end
    if string.contains(compact, "\"timeout_ms\":0") or string.contains(compact, "\"timeout_ms\":-") then
        return true
    end
    return false
end

func mail_smtp_dry_run(var value) as bool
    return mail_smtp_dry_run_text(json.stringify(value))
end

func mail_smtp_preview(string operation, var payload) as var
    var commands = ["EHLO", "STARTTLS", "AUTH", "MAIL FROM", "RCPT TO", "DATA", "QUIT"]
    if operation == "capability" then
        commands = ["EHLO", "QUIT"]
    end
    return mail.mime.result(true, "", "dry_run", {
        "dry_run": true,
        "operation": operation,
        "commands": commands,
        "payload": payload
    })
end

func mail_smtp_preview_json(string operation, string payload_json) as string
    return json.stringify(mail_smtp_preview(operation, {"payload_json": payload_json}))
end

export func result(bool ok, string error, string stage, var data) as var
    return mail.mime.result(ok, error, stage, data)
end

export func capability(var config) as var
    if mail_smtp_dry_run(config) then
        return mail_smtp_preview("capability", config)
    end
    return json.parse(xmail_smtp_capability_json_native(json.stringify(config)))
end

export func send(var request) as var
    if mail_smtp_dry_run(request) then
        return mail_smtp_preview("send", request)
    end
    return json.parse(xmail_smtp_send_json_native(json.stringify(request)))
end

export func capability_json(string config_json) as string
    if mail_smtp_dry_run_text(config_json) then
        return mail_smtp_preview_json("capability", config_json)
    end
    return xmail_smtp_capability_json_native(config_json)
end

export func send_json(string request_json) as string
    if mail_smtp_dry_run_text(request_json) then
        return mail_smtp_preview_json("send", request_json)
    end
    return xmail_smtp_send_json_native(request_json)
end
