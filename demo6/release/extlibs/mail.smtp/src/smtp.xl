import mail.mime

extern "xmail_smtp_capability_json_native" func xmail_smtp_capability_json_native(string config_json) as string
extern "xmail_smtp_send_json_native" func xmail_smtp_send_json_native(string request_json) as string

func __xl6_import_x_mail_smtp_result(bool ok, string error, string stage, var data) as var
    return mail.mime.result(ok, error, stage, data)
end

func __xl6_import_x_mail_smtp_unsupported(string operation) as var
    return mail.mime.result(false, "mail.smtp." + operation + " native binding is not connected", "binding", {})
end

func __xl6_import_x_mail_smtp_capability(var config) as var
    return json.parse(xmail_smtp_capability_json_native(json.stringify(config)))
end

func __xl6_import_x_mail_smtp_send(var request) as var
    return json.parse(xmail_smtp_send_json_native(json.stringify(request)))
end

func __xl6_import_x_mail_smtp_capability_json(string config_json) as string
    return xmail_smtp_capability_json_native(config_json)
end

func __xl6_import_x_mail_smtp_send_json(string request_json) as string
    return xmail_smtp_send_json_native(request_json)
end
