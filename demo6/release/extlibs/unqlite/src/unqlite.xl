extern "xunqlite_db_header" func __uql_hdr(int page_size, int page_count) as string
extern "xunqlite_record" func __uql_rec(string key, string value) as string
extern "xunqlite_rec_key" func __uql_rkey(string rec_hex) as string
extern "xunqlite_rec_value" func __uql_rval(string rec_hex) as string
extern "xunqlite_pages_for_record" func __uql_pages(int klen, int vlen, int psize) as int
extern "xunqlite_hash_key" func __uql_hash(string key) as int
extern "xunqlite_cursor_name" func __uql_cname(int dir) as string
extern "xunqlite_tx_state" func __uql_txstate(int state) as string
extern "xunqlite_page_size" func __uql_psize() as int
extern "xunqlite_max_key_size" func __uql_mks() as int
extern "xunqlite_valid_key" func __uql_vkey(string key) as int

export func dbHeader(int page_size, int page_count) as string
    return __uql_hdr(page_size, page_count)
end

export func record(string key, string value) as string
    return __uql_rec(key, value)
end

export func recKey(string rec_hex) as string
    return __uql_rkey(rec_hex)
end

export func recValue(string rec_hex) as string
    return __uql_rval(rec_hex)
end

export func pagesForRecord(int key_len, int val_len, int page_size) as int
    return __uql_pages(key_len, val_len, page_size)
end

export func hashKey(string key) as int
    return __uql_hash(key)
end

export func cursorName(int dir) as string
    return __uql_cname(dir)
end

export func txState(int state) as string
    return __uql_txstate(state)
end

export func pageSize() as int
    return __uql_psize()
end

export func maxKeySize() as int
    return __uql_mks()
end

export func validKey(string key) as int
    return __uql_vkey(key)
end
