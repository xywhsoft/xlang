extern "xplist_parse" func __plist_parse(point data, c_ulonglong size,
    c_int format, c_ulonglong maxInput, c_ulonglong maxOutput,
    c_ulonglong maxItem, c_ulonglong maxEntries, c_ulonglong maxNodes,
    c_uint maxDepth) as point
extern "xplist_load" func __plist_load(string path, c_int format,
    c_ulonglong maxInput, c_ulonglong maxOutput, c_ulonglong maxItem,
    c_ulonglong maxEntries, c_ulonglong maxNodes, c_uint maxDepth) as point
extern "xplist_error_code" func __plist_error_code() as int
extern "xplist_error_line" func __plist_error_line() as int
extern "xplist_error_column" func __plist_error_column() as int
extern "xplist_error_offset" func __plist_error_offset() as int
extern "xplist_error_message" func __plist_error_message() as point



class UID
    uint64 value

    create(uint64 value)
        self.value = value
    end
end



class NativeDocument
    native point handle
    extern "xplist_create" create()
    extern "xplist_adopt" create(point handle)
    extern "xplist_destroy" destroy()
    extern "xplist_root" func root() as point
    extern "xplist_set_root" func setRoot(point node) as bool
    extern "xplist_node_count" func nodeCount() as int
    extern "xplist_type" func nodeType(point node) as int
    extern "xplist_bool" func boolValue(point node) as bool
    extern "xplist_int" func intValue(point node) as int
    extern "xplist_real" func realValue(point node) as float
    extern "xplist_date_value" func dateValue(point node) as var
    extern "xplist_uid" func uidValue(point node) as c_ulonglong
    extern "xplist_string" func stringValue(point node) as var
    extern "xplist_data" func dataValue(point node) as point
    extern "xplist_count" func count(point node) as int
    extern "xplist_array_get" func arrayGet(point node, c_uint index) as point
    extern "xplist_dict_key" func dictKey(point node, c_uint index) as var
    extern "xplist_dict_value" func dictValue(point node,
        c_uint index) as point
    extern "xplist_new_null" func newNull() as point
    extern "xplist_new_bool" func newBool(c_bool value) as point
    extern "xplist_new_int" func newInt(int value) as point
    extern "xplist_new_real" func newReal(float value) as point
    extern "xplist_new_string" func newString(string value) as point
    extern "xplist_new_data" func newData(point data,
        c_ulonglong size) as point
    extern "xplist_new_date_value" func newDate(var value) as point
    extern "xplist_new_array" func newArray() as point
    extern "xplist_new_dict" func newDict() as point
    extern "xplist_new_uid" func newUid(c_ulonglong value) as point
    extern "xplist_array_append" func arrayAppend(point node,
        point value) as bool
    extern "xplist_dict_set" func dictSet(point node, string key,
        point value) as bool
    extern "xplist_stringify" func stringifyNative(c_int format,
        c_bool pretty, c_bool sortKeys, c_uint indent,
        c_ulonglong maxOutput, c_ulonglong maxItem,
        c_ulonglong maxEntries, c_ulonglong maxNodes,
        c_uint maxDepth) as point
    extern "xplist_save" func saveNative(string path, c_int format,
        c_bool pretty, c_bool sortKeys, c_uint indent,
        c_ulonglong maxOutput, c_ulonglong maxItem,
        c_ulonglong maxEntries, c_ulonglong maxNodes,
        c_uint maxDepth) as bool
end



func __plist_error() as string
    return __xl_std_runtime_take_cstr(__plist_error_message())
end

func __plist_read_format(string format) as int
    if format == "auto" then return 0 end
    if format == "xml" then return 1 end
    if format == "binary" then return 2 end
    throw ValueError "plist format must be auto, xml, or binary"
end

func __plist_write_format(string format) as int
    int result = __plist_read_format(format)
    if result == 0 then throw ValueError "plist output format must be xml or binary" end
    return result
end

func __plist_to_value(NativeDocument document, point node,
    int depth, int maxDepth) as var
    if node == null then throw PlistError "invalid plist node" end
    if depth > maxDepth then throw PlistError "plist nesting depth exceeds the configured limit" end
    int kind = document.nodeType(node)
    if kind == 0 then
        return null
    elseif kind == 1 then
        return document.boolValue(node)
    elseif kind == 2 then
        return document.intValue(node)
    elseif kind == 3 then
        return document.realValue(node)
    elseif kind == 4 then
        return document.stringValue(node)
    elseif kind == 5 then
        point data = document.dataValue(node)
        if data == null then throw PlistError "could not allocate plist data buffer" end
        Buffer result = Buffer(data)
        return result
    elseif kind == 6 then
        return document.dateValue(node)
    elseif kind == 7 then
        var result = []
        int index = 0
        while index < document.count(node)
            result.append(__plist_to_value(document,
                document.arrayGet(node, c_uint(index)), depth + 1, maxDepth))
            index += 1
        end
        return result
    elseif kind == 8 then
        var result = {}
        int index = 0
        while index < document.count(node)
            string key = string(document.dictKey(node, c_uint(index)))
            result[key] = __plist_to_value(document,
                document.dictValue(node, c_uint(index)), depth + 1, maxDepth)
            index += 1
        end
        return result
    elseif kind == 9 then
        return UID(uint64(document.uidValue(node)))
    end
    throw PlistError "unsupported plist node type"
end

func __plist_from_value(NativeDocument document, var value,
    int depth, int maxDepth) as point
    if depth > maxDepth then throw PlistError "plist nesting depth exceeds the configured limit" end
    if value is Buffer then
        Buffer data = value as Buffer
        return document.newData(data.data(), c_ulonglong(data.len()))
    end
    if value is UID then
        UID uid = value as UID
        return document.newUid(c_ulonglong(uid.value))
    end
    type valueType = type(value)
    if valueType == null then
        return document.newNull()
    elseif valueType == bool then
        return document.newBool(c_bool(value))
    elseif valueType == int then
        return document.newInt(int(value))
    elseif valueType == float then
        return document.newReal(float(value))
    elseif valueType == string then
        return document.newString(string(value))
    elseif valueType == time then
        return document.newDate(value)
    elseif valueType == array then
        point result = document.newArray()
        for item in value
            point child = __plist_from_value(document, item,
                depth + 1, maxDepth)
            if child == null or not document.arrayAppend(result, child) then
                throw PlistError "could not build plist array"
            end
        end
        return result
    elseif valueType == dict then
        point result = document.newDict()
        for key, item in value
            if type(key) != string then throw TypeError "plist dict keys must be strings" end
            point child = __plist_from_value(document, item,
                depth + 1, maxDepth)
            if child == null or not document.dictSet(result,
                string(key), child) then
                throw PlistError "could not build plist dict"
            end
        end
        return result
    end
    throw TypeError "value cannot be encoded as plist"
end

func __plist_finish_load(point handle, int maxDepth) as var
    if handle == null then throw PlistError __plist_error() end
    NativeDocument document = NativeDocument(handle)
    return __plist_to_value(document, document.root(), 1, maxDepth)
end



export func errorCode() as int
    return __plist_error_code()
end
export func errorLine() as int
    return __plist_error_line()
end
export func errorColumn() as int
    return __plist_error_column()
end
export func errorOffset() as int
    return __plist_error_offset()
end

export func uid(uint64 value) as UID
    return UID(value)
end

export func isUid(var value) as bool
    return value is UID
end

export func uidValue(var value) as uint64
    if not value is UID then throw TypeError "value is not a plist UID" end
    UID typed = value as UID
    return typed.value
end

export func loads(string text, string format = "auto",
    int maxInput = 268435456, int maxOutput = 536870912,
    int maxItem = 268435456, int maxEntries = 100000,
    int maxNodes = 1000000, int maxDepth = 128) as var
    Buffer data = Buffer()
    data.append(text)
    point result = __plist_parse(data.data(), c_ulonglong(data.len()),
        c_int(__plist_read_format(format)), c_ulonglong(maxInput),
        c_ulonglong(maxOutput), c_ulonglong(maxItem),
        c_ulonglong(maxEntries), c_ulonglong(maxNodes), c_uint(maxDepth))
    return __plist_finish_load(result, maxDepth)
end

export func loads(Buffer data, string format = "auto",
    int maxInput = 268435456, int maxOutput = 536870912,
    int maxItem = 268435456, int maxEntries = 100000,
    int maxNodes = 1000000, int maxDepth = 128) as var
    point result = __plist_parse(data.data(), c_ulonglong(data.len()),
        c_int(__plist_read_format(format)), c_ulonglong(maxInput),
        c_ulonglong(maxOutput), c_ulonglong(maxItem),
        c_ulonglong(maxEntries), c_ulonglong(maxNodes), c_uint(maxDepth))
    return __plist_finish_load(result, maxDepth)
end

export func load(string path, string format = "auto",
    int maxInput = 268435456, int maxOutput = 536870912,
    int maxItem = 268435456, int maxEntries = 100000,
    int maxNodes = 1000000, int maxDepth = 128) as var
    point result = __plist_load(path, c_int(__plist_read_format(format)),
        c_ulonglong(maxInput), c_ulonglong(maxOutput),
        c_ulonglong(maxItem), c_ulonglong(maxEntries),
        c_ulonglong(maxNodes), c_uint(maxDepth))
    return __plist_finish_load(result, maxDepth)
end

export func dumps(var value, string format = "xml", bool pretty = true,
    bool sortKeys = false, int indent = 2, int maxOutput = 536870912,
    int maxItem = 268435456, int maxEntries = 100000,
    int maxNodes = 1000000, int maxDepth = 128) as Buffer
    NativeDocument document = NativeDocument()
    point root = __plist_from_value(document, value, 1, maxDepth)
    if root == null or not document.setRoot(root) then
        throw PlistError "could not build plist document"
    end
    if document.nodeCount() > maxNodes then
        throw PlistError "plist node count exceeds the configured limit"
    end
    point result = document.stringifyNative(c_int(__plist_write_format(format)),
        c_bool(pretty), c_bool(sortKeys), c_uint(indent),
        c_ulonglong(maxOutput), c_ulonglong(maxItem),
        c_ulonglong(maxEntries), c_ulonglong(maxNodes), c_uint(maxDepth))
    if result == null then throw PlistError __plist_error() end
    return Buffer(result)
end

export func stringify(var value, bool pretty = true,
    bool sortKeys = false, int indent = 2, int maxOutput = 536870912,
    int maxItem = 268435456, int maxEntries = 100000,
    int maxNodes = 1000000, int maxDepth = 128) as string
    Buffer result = dumps(value, "xml", pretty, sortKeys, indent,
        maxOutput, maxItem, maxEntries, maxNodes, maxDepth)
    return result.text()
end

export func dump(string path, var value, string format = "xml",
    bool pretty = true, bool sortKeys = false, int indent = 2,
    int maxOutput = 536870912, int maxItem = 268435456,
    int maxEntries = 100000, int maxNodes = 1000000,
    int maxDepth = 128)
    NativeDocument document = NativeDocument()
    point root = __plist_from_value(document, value, 1, maxDepth)
    if root == null or not document.setRoot(root) then
        throw PlistError "could not build plist document"
    end
    if document.nodeCount() > maxNodes then
        throw PlistError "plist node count exceeds the configured limit"
    end
    if not document.saveNative(path, c_int(__plist_write_format(format)),
        c_bool(pretty), c_bool(sortKeys), c_uint(indent),
        c_ulonglong(maxOutput), c_ulonglong(maxItem),
        c_ulonglong(maxEntries), c_ulonglong(maxNodes),
        c_uint(maxDepth)) then
        throw PlistError __plist_error()
    end
end
