import ansi

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

// 覆盖固定文本、样式、调色板、真彩色和去转义五条结果分配路径。
func result(int kind) as string
    if kind == 0 then return ansi.reset() end
    if kind == 1 then return ansi.bold("text") end
    if kind == 2 then return ansi.fg256("text", 42) end
    if kind == 3 then return ansi.fgTrue("text", 1, 2, 3) end
    return ansi.strip("\x1b[1mtext\x1b[0m")
end

func main(...) as int
    array<string> expected = [ansi.reset(), ansi.bold("text"),
        ansi.fg256("text", 42), ansi.fgTrue("text", 1, 2, 3), "text"]

    for kind in range(5)
        int failures = 0
        int successes = 0
        for point in range(32)
            bool caught = false
            string value = ""
            assert failAfter(uint64(point))
            try
                value = result(kind)
            catch MemoryError error
                caught = true
            end
            bool triggered = failTriggered()
            failClear()
            assert not caught or triggered
            if caught then
                failures += 1
            else
                successes += 1
                assert value == expected[kind]
            end
            assert result(kind) == expected[kind]
        end
        assert failures > 0 and successes > 0
    end
    println("ansi allocations: PASS")
    return 0
end
