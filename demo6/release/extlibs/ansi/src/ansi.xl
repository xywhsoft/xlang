extern "xansi_reset" func __ansi_reset() as string
extern "xansi_bold" func __ansi_bold(string text) as string
extern "xansi_dim" func __ansi_dim(string text) as string
extern "xansi_italic" func __ansi_italic(string text) as string
extern "xansi_underline" func __ansi_underline(string text) as string
extern "xansi_blink" func __ansi_blink(string text) as string
extern "xansi_inverse" func __ansi_inverse(string text) as string
extern "xansi_hidden" func __ansi_hidden(string text) as string
extern "xansi_strike" func __ansi_strike(string text) as string
extern "xansi_fg" func __ansi_fg(string text, int code) as string
extern "xansi_bg" func __ansi_bg(string text, int code) as string
extern "xansi_fg256" func __ansi_fg256(string text, int n) as string
extern "xansi_bg256" func __ansi_bg256(string text, int n) as string
extern "xansi_fg_true" func __ansi_fg_true(string text, int r, int g, int b) as string
extern "xansi_bg_true" func __ansi_bg_true(string text, int r, int g, int b) as string
extern "xansi_up" func __ansi_up(int n) as string
extern "xansi_down" func __ansi_down(int n) as string
extern "xansi_right" func __ansi_right(int n) as string
extern "xansi_left" func __ansi_left(int n) as string
extern "xansi_next_line" func __ansi_next_line(int n) as string
extern "xansi_prev_line" func __ansi_prev_line(int n) as string
extern "xansi_column" func __ansi_column(int n) as string
extern "xansi_clear_screen" func __ansi_clear_screen() as string
extern "xansi_clear_line" func __ansi_clear_line() as string
extern "xansi_clear_to_end" func __ansi_clear_to_end() as string
extern "xansi_hide_cursor" func __ansi_hide_cursor() as string
extern "xansi_show_cursor" func __ansi_show_cursor() as string
extern "xansi_title" func __ansi_title(string text) as string
extern "xansi_strip" func __ansi_strip(string text) as string
extern "xansi_display_width" func __ansi_display_width(string text) as int



// 样式函数返回「转义开头 + 文本 + 重置结尾」的完整字符串
export func bold(string text) as string
    return __ansi_bold(text)
end

export func dim(string text) as string
    return __ansi_dim(text)
end

export func italic(string text) as string
    return __ansi_italic(text)
end

export func underline(string text) as string
    return __ansi_underline(text)
end

export func blink(string text) as string
    return __ansi_blink(text)
end

export func inverse(string text) as string
    return __ansi_inverse(text)
end

export func hidden(string text) as string
    return __ansi_hidden(text)
end

export func strike(string text) as string
    return __ansi_strike(text)
end

// reset 返回单独的重置序列
export func reset() as string
    return __ansi_reset()
end

// fg/bg 使用基本 16 色 SGR 码：前景 30-37/90-97，背景 40-47/100-107；越界返回空字符串
export func fg(string text, int code) as string
    return __ansi_fg(text, code)
end

export func bg(string text, int code) as string
    return __ansi_bg(text, code)
end

// fg256/bg256 使用 256 色调色板索引
export func fg256(string text, int n) as string
    return __ansi_fg256(text, n)
end

export func bg256(string text, int n) as string
    return __ansi_bg256(text, n)
end

// fgTrue/bgTrue 使用 24 位真彩色
export func fgTrue(string text, int r, int g, int b) as string
    return __ansi_fg_true(text, r, g, b)
end

export func bgTrue(string text, int r, int g, int b) as string
    return __ansi_bg_true(text, r, g, b)
end

// 光标与屏幕控制：只生成序列，不直接操作控制台
export func up(int n) as string
    return __ansi_up(n)
end

export func down(int n) as string
    return __ansi_down(n)
end

export func right(int n) as string
    return __ansi_right(n)
end

export func left(int n) as string
    return __ansi_left(n)
end

export func nextLine(int n) as string
    return __ansi_next_line(n)
end

export func prevLine(int n) as string
    return __ansi_prev_line(n)
end

export func column(int n) as string
    return __ansi_column(n)
end

export func clearScreen() as string
    return __ansi_clear_screen()
end

export func clearLine() as string
    return __ansi_clear_line()
end

export func clearToEnd() as string
    return __ansi_clear_to_end()
end

export func hideCursor() as string
    return __ansi_hide_cursor()
end

export func showCursor() as string
    return __ansi_show_cursor()
end

// title 生成设置终端窗口标题的 OSC 序列
export func title(string text) as string
    return __ansi_title(text)
end

// strip 去掉文本中的 ANSI 转义序列
export func strip(string text) as string
    return __ansi_strip(text)
end

// displayWidth 返回终端显示宽度：跳过转义序列，东亚宽字符按 2 列计
export func displayWidth(string text) as int
    return __ansi_display_width(text)
end
