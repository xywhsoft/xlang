extern "xproj_mercator_x" func __mercator_x(float lon, float lat) as float
extern "xproj_mercator_y" func __mercator_y(float lon, float lat) as float
extern "xproj_invmercator_lon" func __invmercator_lon(float x, float y) as float
extern "xproj_invmercator_lat" func __invmercator_lat(float x, float y) as float
extern "xproj_utm_zone" func __utm_zone(float lon) as int
extern "xproj_utm_easting" func __utm_easting(float lon, float lat) as float
extern "xproj_utm_northing" func __utm_northing() as float
extern "xproj_haversine" func __haversine(float lon1, float lat1, float lon2, float lat2) as float
extern "xproj_bearing" func __bearing(float lon1, float lat1, float lon2, float lat2) as float
extern "xproj_crs_name" func __crs_name(int epsg) as string
extern "xproj_is_projected" func __is_projected(int epsg) as int
extern "xproj_to_dms" func __to_dms(float degrees, int is_lon) as string
extern "xproj_tile_x" func __tile_x(float lon, float lat, int zoom) as int
extern "xproj_tile_y" func __tile_y() as int

export func mercatorX(float lon, float lat) as float
    return __mercator_x(lon, lat)
end

export func mercatorY(float lon, float lat) as float
    return __mercator_y(lon, lat)
end

export func invMercatorLon(float x, float y) as float
    return __invmercator_lon(x, y)
end

export func invMercatorLat(float x, float y) as float
    return __invmercator_lat(x, y)
end

export func utmZone(float lon) as int
    return __utm_zone(lon)
end

export func utmEasting(float lon, float lat) as float
    return __utm_easting(lon, lat)
end

export func utmNorthing() as float
    return __utm_northing()
end

export func haversine(float lon1, float lat1, float lon2, float lat2) as float
    return __haversine(lon1, lat1, lon2, lat2)
end

export func bearing(float lon1, float lat1, float lon2, float lat2) as float
    return __bearing(lon1, lat1, lon2, lat2)
end

export func crsName(int epsg) as string
    return __crs_name(epsg)
end

export func isProjected(int epsg) as int
    return __is_projected(epsg)
end

export func toDms(float degrees, int is_lon) as string
    return __to_dms(degrees, is_lon)
end

export func tileX(float lon, float lat, int zoom) as int
    return __tile_x(lon, lat, zoom)
end

export func tileY() as int
    return __tile_y()
end
