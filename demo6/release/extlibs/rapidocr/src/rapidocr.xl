func rapidocr_assemble_result4(string boxes_json, string rec0_json, string rec1_json, string rec2_json, string rec3_json, float elapse) as string
	rapidocr_require_json(boxes_json)
	rapidocr_require_json(rec0_json)
	rapidocr_require_json(rec1_json)
	rapidocr_require_json(rec2_json)
	rapidocr_require_json(rec3_json)
	return rapidocr_assembled_text(rapidocr_assemble_result4_native(boxes_json, rec0_json, rec1_json, rec2_json, rec3_json, elapse))
end

func rapidocr_last_error() as string
	string local_error = rapidocr_last_error_native()
	if local_error != "" then return local_error end
	if opencv.available() == false then
		return opencv.last_error()
	end
	if onnxruntime.available() == false then
		return onnxruntime.last_error()
	end
	return ""
end

