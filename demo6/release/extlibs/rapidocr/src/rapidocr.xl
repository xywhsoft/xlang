func rapidocr_to_c_int(int value) as c_int
	if value < -2147483648 or value > 2147483647 then
		throw ValueError "RapidOCR integer exceeds the C int range"
	end
	return c_int(value)
end

func rapidocr_require_path(string path)
	// 原生路径参数以 NUL 结尾；先拒绝后缀，避免打开另一个有效文件。
	if string.indexOf(path, "\0", false, string.byteLen(path), 1) >= 0 then
		throw ValueError "RapidOCR path contains an embedded NUL"
	end
end

func rapidocr_require_json(string value)
	// JSON 作为 C 字符串传入时，内嵌 NUL 不得被静默截断。
	if string.indexOf(value, "\0", false, string.byteLen(value), 1) >= 0 then
		throw ValueError "RapidOCR JSON contains an embedded NUL"
	end
end

func rapidocr_take_json_result(point result) as string
	if result == null then
		string message = rapidocr_last_error_native()
		if message == "" then message = "RapidOCR native result failed" end
		throw RuntimeError message
	end
	return __xl_runtime.takeCstr(result)
end

func rapidocr_open_session(string model_path, bool needed) as InferenceSessionObject
	if needed then
		return onnxruntime.InferenceSession(model_path)
	end
	return onnxruntime.InferenceSessionFromHandle(null)
end

func rapidocr_quote_arg(string value) as string
	return "\"" + value + "\""
end

func rapidocr_bool_arg(bool value) as string
	if value then
		return "1"
	end
	return "0"
end

func rapidocr_model_path(string file_name) as string
	return rapidocr_extlib_path("models/" + file_name)
end

func rapidocr_extlib_path(string relative) as string
	string? result = rapidocr_extlib_path_native(relative)
	if result == null then
		string message = rapidocr_last_error_native()
		if message == "" then message = "RapidOCR resource path resolution failed" end
		throw RuntimeError message
	end
	return result
end

func rapidocr_json_path(string value) as string
	return string.replace(value, "\\", "\\\\")
end

func rapidocr_det_resize_width(int width, int height, int limit_side_len) as int
	int target_w = width
	int target_h = height
	int min_side = width
	if height < min_side then
		min_side = height
	end
	if min_side < limit_side_len then
		if height < width then
			target_h = limit_side_len
			target_w = width * limit_side_len / height
		else
			target_w = limit_side_len
			target_h = height * limit_side_len / width
		end
	end
	if target_w < 32 then
		target_w = 32
	end
	target_w = (target_w + 16) / 32 * 32
	return target_w
end

func rapidocr_det_resize_height(int width, int height, int limit_side_len) as int
	int target_w = width
	int target_h = height
	int min_side = width
	if height < min_side then
		min_side = height
	end
	if min_side < limit_side_len then
		if height < width then
			target_h = limit_side_len
			target_w = width * limit_side_len / height
		else
			target_w = limit_side_len
			target_h = height * limit_side_len / width
		end
	end
	if target_h < 32 then
		target_h = 32
	end
	target_h = (target_h + 16) / 32 * 32
	return target_h
end

func rapidocr_rec_target_width(int crop_w, int crop_h, int rec_img_w, int rec_img_h) as int
	if crop_h <= 0 then
		return rec_img_w
	end
	int target_w = (crop_w * rec_img_h + crop_h - 1) / crop_h
	if target_w < rec_img_w then
		target_w = rec_img_w
	end
	if target_w > 2048 then
		target_w = 2048
	end
	return target_w
end

func rapidocr_rec_resize_width(int crop_w, int crop_h, int target_img_w, int rec_img_h) as int
	if crop_h <= 0 then
		return target_img_w
	end
	int resized_w = (crop_w * rec_img_h + crop_h - 1) / crop_h
	if resized_w < 1 then
		resized_w = 1
	end
	if resized_w > target_img_w then
		resized_w = target_img_w
	end
	return resized_w
end

func rapidocr_cls_resize_width(int crop_w, int crop_h, int cls_img_w, int cls_img_h) as int
	if crop_h <= 0 then
		return cls_img_w
	end
	int resized_w = (crop_w * cls_img_h + crop_h - 1) / crop_h
	if resized_w < 1 then
		resized_w = 1
	end
	if resized_w > cls_img_w then
		resized_w = cls_img_w
	end
	return resized_w
end

func rapidocr_classify_image(Image source_img, InferenceSessionObject cls_sess, int cls_img_w, int cls_img_h) as string
	if source_img.empty() then
		return "{}"
	end
	int cls_w = rapidocr_cls_resize_width(source_img.width(), source_img.height(), cls_img_w, cls_img_h)
	auto cls_resized_img = opencv.resize(source_img, cls_w, cls_img_h)
	auto cls_img = opencv.copyMakeBorder_rgba(cls_resized_img, 0, 0, 0, cls_img_w - cls_w, 0, 127.5, 127.5, 127.5, 0.0)
	auto cls_tensor = onnxruntime.TensorFromOpenCV(cls_img.handle, 0.0039215689, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
	auto cls_result = cls_sess.run_tensor_fast("x", cls_tensor, "[]")
	if cls_result.ok() then
		return rapidocr_cls_decode_result(cls_result.handle)
	end
	return "{}"
end

func rapidocr_prepare_cls_image(Image source_img, int cls_img_w, int cls_img_h) as Image
	if source_img.empty() then
		point nullHandle = null
		return Image(nullHandle)
	end
	int cls_w = rapidocr_cls_resize_width(source_img.width(), source_img.height(), cls_img_w, cls_img_h)
	auto cls_resized_img = opencv.resize(source_img, cls_w, cls_img_h)
	return opencv.copyMakeBorder_rgba(cls_resized_img, 0, 0, 0, cls_img_w - cls_w, 0, 127.5, 127.5, 127.5, 0.0)
end

func rapidocr_prepare_cls_image(Image source_img, bool active, int cls_img_w, int cls_img_h) as Image
	if active == false then
		point nullHandle = null
		return Image(nullHandle)
	end
	return rapidocr_prepare_cls_image(source_img, cls_img_w, cls_img_h)
end

func rapidocr_prepare_rec_image(Image source_img, string cls_json, bool use_cls, float cls_thresh, int target_rec_w, int rec_img_h) as Image
	if source_img.empty() then
		point nullHandle = null
		return Image(nullHandle)
	end
	rapidocr_require_json(cls_json)
	if use_cls and rapidocr_cls_should_rotate_native(cls_json, cls_thresh) != 0 then
		auto rotated_img = opencv.rotate180(source_img)
		int rec_w_rot = rapidocr_rec_resize_width(rotated_img.width(), rotated_img.height(), target_rec_w, rec_img_h)
		auto rec_resized_rot = opencv.resize(rotated_img, rec_w_rot, rec_img_h)
		return opencv.copyMakeBorder_rgba(rec_resized_rot, 0, 0, 0, target_rec_w - rec_w_rot, 0, 127.5, 127.5, 127.5, 0.0)
	end
	int rec_w_plain = rapidocr_rec_resize_width(source_img.width(), source_img.height(), target_rec_w, rec_img_h)
	auto rec_resized_plain = opencv.resize(source_img, rec_w_plain, rec_img_h)
	return opencv.copyMakeBorder_rgba(rec_resized_plain, 0, 0, 0, target_rec_w - rec_w_plain, 0, 127.5, 127.5, 127.5, 0.0)
end

func rapidocr_prepare_rec_image(Image source_img, bool active, string cls_json, bool use_cls, float cls_thresh, int target_rec_w, int rec_img_h) as Image
	if active == false then
		point nullHandle = null
		return Image(nullHandle)
	end
	return rapidocr_prepare_rec_image(source_img, cls_json, use_cls, cls_thresh, target_rec_w, rec_img_h)
end

class RapidBoxGeometry
	point handle
	create(string boxes)
		rapidocr_require_json(boxes)
		self.handle = rapidocr_boxes_open_native(boxes)
	end
	destroy()
		if self.handle != null then
			rapidocr_boxes_release_native(self.handle)
		end
	end
end

func rapidocr_crop_box_image(Image img, RapidBoxGeometry geometry, int index, int boxes_count) as Image
	if index >= boxes_count then
		point nullHandle = null
		return Image(nullHandle)
	end
	float x0 = rapidocr_boxes_coord_native(geometry.handle, rapidocr_to_c_int(index), 0)
	float y0 = rapidocr_boxes_coord_native(geometry.handle, rapidocr_to_c_int(index), 1)
	float x1 = rapidocr_boxes_coord_native(geometry.handle, rapidocr_to_c_int(index), 2)
	float y1 = rapidocr_boxes_coord_native(geometry.handle, rapidocr_to_c_int(index), 3)
	float x2 = rapidocr_boxes_coord_native(geometry.handle, rapidocr_to_c_int(index), 4)
	float y2 = rapidocr_boxes_coord_native(geometry.handle, rapidocr_to_c_int(index), 5)
	float x3 = rapidocr_boxes_coord_native(geometry.handle, rapidocr_to_c_int(index), 6)
	float y3 = rapidocr_boxes_coord_native(geometry.handle, rapidocr_to_c_int(index), 7)
	return opencv.perspectiveCrop(img, x0, y0, x1, y1, x2, y2, x3, y3)
end

func rapidocr_crop_box_image(Image img, bool active, RapidBoxGeometry geometry, int index, int boxes_count) as Image
	if active == false then
		point nullHandle = null
		return Image(nullHandle)
	end
	return rapidocr_crop_box_image(img, geometry, index, boxes_count)
end

func rapidocr_image_rec_target_width(Image crop, int rec_img_w, int rec_img_h) as int
	if crop.empty() then
		return rec_img_w
	end
	return rapidocr_rec_target_width(crop.width(), crop.height(), rec_img_w, rec_img_h)
end

func rapidocr_batch_can_add(int current_min_w, int current_max_w, int next_w, int rec_img_w) as bool
	int next_min = current_min_w
	int next_max = current_max_w
	if next_w < next_min then
		next_min = next_w
	end
	if next_w > next_max then
		next_max = next_w
	end
	if next_max <= rec_img_w then
		return true
	end
	return false
end

func rapidocr_max_rec_target_width_6(Image crop0, Image crop1, Image crop2, Image crop3, Image crop4, Image crop5, int batch_count, int rec_img_w, int rec_img_h) as int
	int target_rec_w = rec_img_w
	if batch_count > 0 and crop0.empty() == false then
		int w0 = rapidocr_rec_target_width(crop0.width(), crop0.height(), rec_img_w, rec_img_h)
		if w0 > target_rec_w then
			target_rec_w = w0
		end
	end
	if batch_count > 1 and crop1.empty() == false then
		int w1 = rapidocr_rec_target_width(crop1.width(), crop1.height(), rec_img_w, rec_img_h)
		if w1 > target_rec_w then
			target_rec_w = w1
		end
	end
	if batch_count > 2 and crop2.empty() == false then
		int w2 = rapidocr_rec_target_width(crop2.width(), crop2.height(), rec_img_w, rec_img_h)
		if w2 > target_rec_w then
			target_rec_w = w2
		end
	end
	if batch_count > 3 and crop3.empty() == false then
		int w3 = rapidocr_rec_target_width(crop3.width(), crop3.height(), rec_img_w, rec_img_h)
		if w3 > target_rec_w then
			target_rec_w = w3
		end
	end
	if batch_count > 4 and crop4.empty() == false then
		int w4 = rapidocr_rec_target_width(crop4.width(), crop4.height(), rec_img_w, rec_img_h)
		if w4 > target_rec_w then
			target_rec_w = w4
		end
	end
	if batch_count > 5 and crop5.empty() == false then
		int w5 = rapidocr_rec_target_width(crop5.width(), crop5.height(), rec_img_w, rec_img_h)
		if w5 > target_rec_w then
			target_rec_w = w5
		end
	end
	return target_rec_w
end

func rapidocr_text_from_recs(string recs_json) as string
	var entries = json.parse(recs_json)
	string result = ""
	for entry in entries
		var value = entry?["text"]
		if value != null and string(value) != "" then
			if result != "" then result += "\n" end
			result += string(value)
		end
	end
	return result
end

export class RapidOCROutput
    point handle
    string error_text
    string json_text
    string text_value
    string boxes
    string txts
    string scores
    string word_results
    string elapse_list
    float elapse
    string source_path
    float text_score
	create(point handle)
		self.handle = handle
		self.error_text = ""
		self.json_text = ""
		self.text_value = ""
		self.boxes = rapidocr_output_boxes_native(handle)
		self.txts = rapidocr_output_txts_native(handle)
		self.scores = rapidocr_output_scores_native(handle)
		self.word_results = rapidocr_output_word_results_native(handle)
		self.elapse_list = rapidocr_output_elapse_list_native(handle)
		self.elapse = rapidocr_output_elapse_native(handle)
		self.source_path = ""
		self.text_score = 0.5
	end

	create(string json_text, string text_value, string boxes, string txts, string scores, string word_results, string elapse_list, float elapse)
		self.handle = null
		self.error_text = ""
		self.json_text = json_text
		self.text_value = text_value
		self.boxes = boxes
		self.txts = txts
		self.scores = scores
		self.word_results = word_results
		self.elapse_list = elapse_list
		self.elapse = elapse
		self.source_path = ""
		self.text_score = 0.5
	end

	create(string json_text, string text_value, string boxes, string txts, string scores, string word_results, string elapse_list, float elapse, string source_path)
		self.handle = null
		self.error_text = ""
		self.json_text = json_text
		self.text_value = text_value
		self.boxes = boxes
		self.txts = txts
		self.scores = scores
		self.word_results = word_results
		self.elapse_list = elapse_list
		self.elapse = elapse
		self.source_path = source_path
		self.text_score = 0.5
	end

	create(string json_text, string text_value, string boxes, string txts, string scores, string word_results, string elapse_list, float elapse, string source_path, float text_score)
		self.handle = null
		self.error_text = ""
		self.json_text = json_text
		self.text_value = text_value
		self.boxes = boxes
		self.txts = txts
		self.scores = scores
		self.word_results = word_results
		self.elapse_list = elapse_list
		self.elapse = elapse
		self.source_path = source_path
		self.text_score = text_score
	end

	create(string reason)
		self.handle = null
		self.error_text = reason
		self.json_text = ""
		self.text_value = ""
		self.boxes = "[]"
		self.txts = "[]"
		self.scores = "[]"
		self.word_results = "[]"
		self.elapse_list = "[]"
		self.elapse = 0.0
		self.source_path = ""
		self.text_score = 0.5
	end

	func release() as bool
		if self.handle != null then
			rapidocr_output_release_native(self.handle)
			self.handle = null
			return true
		end
		return false
	end

	destroy()
		if self.handle != null then
			rapidocr_output_release_native(self.handle)
		end
	end

	func error() as string
		if self.error_text != "" then
			return self.error_text
		end
		return rapidocr_last_error_native()
	end

	func ok() as bool
		if self.handle == null then
			return self.json_text != ""
		end
		return rapidocr_output_ok_native(self.handle) != 0
	end

	func text() as string
		if self.handle == null then
			return self.text_value
		end
		return rapidocr_output_text_native(self.handle)
	end

	func to_json() as string
		if self.handle == null then
			return self.json_text
		end
		return rapidocr_output_json_native(self.handle)
	end

	func to_ocr_json() as string
		if self.handle == null then
			return rapidocr_ocr_items_json2(self.json_text, self.text_score)
		end
		return rapidocr_ocr_items_json2(rapidocr_output_json_native(self.handle), self.text_score)
	end

	func to_ocr_json(float text_score) as string
		if self.handle == null then
			return rapidocr_ocr_items_json2(self.json_text, text_score)
		end
		return rapidocr_ocr_items_json2(rapidocr_output_json_native(self.handle), text_score)
	end

	func vis(string save_path) as bool
		rapidocr_require_path(save_path)
		if self.handle == null then
			if self.source_path == "" then
				return false
			end
			rapidocr_require_path(self.source_path)
			rapidocr_require_json(self.boxes)
			return rapidocr_vis_image_native(self.source_path, self.boxes, save_path) != 0
		end
		return rapidocr_output_vis_native(self.handle, save_path) != 0
	end
end

func rapidocr_recognize_boxes(Image img, string boxes, bool use_cls, InferenceSessionObject cls_sess, InferenceSessionObject rec_sess, point charset_handle, float cls_thresh, int cls_img_w, int cls_img_h, int rec_img_w, int rec_img_h) as (string, string, string)
	string cls = "{}"
	RapidBoxGeometry geometry = RapidBoxGeometry(boxes)
	if geometry.handle == null then return "", "", "invalid detector boxes: " + rapidocr_last_error_native() end
	int boxes_count = rapidocr_boxes_count_handle_native(geometry.handle)
	string parts = "["
	int i = 0
	while i < boxes_count
		int w0 = rapidocr_boxes_rec_target_width_native(geometry.handle, rapidocr_to_c_int(i), rapidocr_to_c_int(rec_img_w), rapidocr_to_c_int(rec_img_h))
		int w1 = rapidocr_boxes_rec_target_width_native(geometry.handle, rapidocr_to_c_int(i + 1), rapidocr_to_c_int(rec_img_w), rapidocr_to_c_int(rec_img_h))
		int w2 = rapidocr_boxes_rec_target_width_native(geometry.handle, rapidocr_to_c_int(i + 2), rapidocr_to_c_int(rec_img_w), rapidocr_to_c_int(rec_img_h))
		int w3 = rapidocr_boxes_rec_target_width_native(geometry.handle, rapidocr_to_c_int(i + 3), rapidocr_to_c_int(rec_img_w), rapidocr_to_c_int(rec_img_h))
		int w4 = rapidocr_boxes_rec_target_width_native(geometry.handle, rapidocr_to_c_int(i + 4), rapidocr_to_c_int(rec_img_w), rapidocr_to_c_int(rec_img_h))
		int w5 = rapidocr_boxes_rec_target_width_native(geometry.handle, rapidocr_to_c_int(i + 5), rapidocr_to_c_int(rec_img_w), rapidocr_to_c_int(rec_img_h))
		int batch_count = 1
		int batch_min_w = w0
		int batch_max_w = w0
		if i + 1 < boxes_count and rapidocr_batch_can_add(batch_min_w, batch_max_w, w1, rec_img_w) then
			batch_count = 2
			if w1 < batch_min_w then
				batch_min_w = w1
			end
			if w1 > batch_max_w then
				batch_max_w = w1
			end
		end
		if i + 2 < boxes_count and batch_count == 2 and rapidocr_batch_can_add(batch_min_w, batch_max_w, w2, rec_img_w) then
			batch_count = 3
			if w2 < batch_min_w then
				batch_min_w = w2
			end
			if w2 > batch_max_w then
				batch_max_w = w2
			end
		end
		if i + 3 < boxes_count and batch_count == 3 and rapidocr_batch_can_add(batch_min_w, batch_max_w, w3, rec_img_w) then
			batch_count = 4
			if w3 < batch_min_w then
				batch_min_w = w3
			end
			if w3 > batch_max_w then
				batch_max_w = w3
			end
		end
		if i + 4 < boxes_count and batch_count == 4 and rapidocr_batch_can_add(batch_min_w, batch_max_w, w4, rec_img_w) then
			batch_count = 5
			if w4 < batch_min_w then
				batch_min_w = w4
			end
			if w4 > batch_max_w then
				batch_max_w = w4
			end
		end
		if i + 5 < boxes_count and batch_count == 5 and rapidocr_batch_can_add(batch_min_w, batch_max_w, w5, rec_img_w) then
			batch_count = 6
			if w5 < batch_min_w then
				batch_min_w = w5
			end
			if w5 > batch_max_w then
				batch_max_w = w5
			end
		end
		auto crop0 = rapidocr_crop_box_image(img, true, geometry, i, boxes_count)
		auto crop1 = rapidocr_crop_box_image(img, batch_count > 1, geometry, i + 1, boxes_count)
		auto crop2 = rapidocr_crop_box_image(img, batch_count > 2, geometry, i + 2, boxes_count)
		auto crop3 = rapidocr_crop_box_image(img, batch_count > 3, geometry, i + 3, boxes_count)
		auto crop4 = rapidocr_crop_box_image(img, batch_count > 4, geometry, i + 4, boxes_count)
		auto crop5 = rapidocr_crop_box_image(img, batch_count > 5, geometry, i + 5, boxes_count)
		string cls0 = "{}"
		string cls1 = "{}"
		string cls2 = "{}"
		string cls3 = "{}"
		string cls4 = "{}"
		string cls5 = "{}"
		if use_cls then
			auto cls_img0 = rapidocr_prepare_cls_image(crop0, true, cls_img_w, cls_img_h)
			auto cls_img1 = rapidocr_prepare_cls_image(crop1, batch_count > 1, cls_img_w, cls_img_h)
			auto cls_img2 = rapidocr_prepare_cls_image(crop2, batch_count > 2, cls_img_w, cls_img_h)
			auto cls_img3 = rapidocr_prepare_cls_image(crop3, batch_count > 3, cls_img_w, cls_img_h)
			auto cls_img4 = rapidocr_prepare_cls_image(crop4, batch_count > 4, cls_img_w, cls_img_h)
			auto cls_img5 = rapidocr_prepare_cls_image(crop5, batch_count > 5, cls_img_w, cls_img_h)
			auto cls_tensor = onnxruntime.TensorFromOpenCVBatch(batch_count, cls_img0.handle, cls_img1.handle, cls_img2.handle, cls_img3.handle, cls_img4.handle, cls_img5.handle, 0.0039215689, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
			auto cls_result = cls_sess.run_tensor_fast("x", cls_tensor, "[]")
			if not cls_result.ok() then
				return "", "", "classifier inference failed: " + cls_result.error()
			end
			if cls_result.ok() then
				cls0 = rapidocr_cls_decode_result_at(cls_result.handle, 0)
				if cls0 == "" then return "", "", "classifier decode failed: " + rapidocr_last_error_native() end
				if batch_count > 1 then
					cls1 = rapidocr_cls_decode_result_at(cls_result.handle, 1)
					if cls1 == "" then return "", "", "classifier decode failed: " + rapidocr_last_error_native() end
				end
				if batch_count > 2 then
					cls2 = rapidocr_cls_decode_result_at(cls_result.handle, 2)
					if cls2 == "" then return "", "", "classifier decode failed: " + rapidocr_last_error_native() end
				end
				if batch_count > 3 then
					cls3 = rapidocr_cls_decode_result_at(cls_result.handle, 3)
					if cls3 == "" then return "", "", "classifier decode failed: " + rapidocr_last_error_native() end
				end
				if batch_count > 4 then
					cls4 = rapidocr_cls_decode_result_at(cls_result.handle, 4)
					if cls4 == "" then return "", "", "classifier decode failed: " + rapidocr_last_error_native() end
				end
				if batch_count > 5 then
					cls5 = rapidocr_cls_decode_result_at(cls_result.handle, 5)
					if cls5 == "" then return "", "", "classifier decode failed: " + rapidocr_last_error_native() end
				end
				cls = cls0
			end
		end
		int target_rec_w = batch_max_w
		auto rec_img0 = rapidocr_prepare_rec_image(crop0, true, cls0, use_cls, cls_thresh, target_rec_w, rec_img_h)
		auto rec_img1 = rapidocr_prepare_rec_image(crop1, batch_count > 1, cls1, use_cls, cls_thresh, target_rec_w, rec_img_h)
		auto rec_img2 = rapidocr_prepare_rec_image(crop2, batch_count > 2, cls2, use_cls, cls_thresh, target_rec_w, rec_img_h)
		auto rec_img3 = rapidocr_prepare_rec_image(crop3, batch_count > 3, cls3, use_cls, cls_thresh, target_rec_w, rec_img_h)
		auto rec_img4 = rapidocr_prepare_rec_image(crop4, batch_count > 4, cls4, use_cls, cls_thresh, target_rec_w, rec_img_h)
		auto rec_img5 = rapidocr_prepare_rec_image(crop5, batch_count > 5, cls5, use_cls, cls_thresh, target_rec_w, rec_img_h)
		string one_rec0 = "{\"text\":\"\",\"score\":0,\"tokens\":0}"
		string one_rec1 = "{\"text\":\"\",\"score\":0,\"tokens\":0}"
		string one_rec2 = "{\"text\":\"\",\"score\":0,\"tokens\":0}"
		string one_rec3 = "{\"text\":\"\",\"score\":0,\"tokens\":0}"
		string one_rec4 = "{\"text\":\"\",\"score\":0,\"tokens\":0}"
		string one_rec5 = "{\"text\":\"\",\"score\":0,\"tokens\":0}"
		auto rec_tensor = onnxruntime.TensorFromOpenCVBatch(batch_count, rec_img0.handle, rec_img1.handle, rec_img2.handle, rec_img3.handle, rec_img4.handle, rec_img5.handle, 0.0039215689, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
		auto rec_result = rec_sess.run_tensor_fast("x", rec_tensor, "[]")
		if not rec_result.ok() then
			return "", "", "recognizer inference failed: " + rec_result.error()
		end
		if rec_result.ok() then
			one_rec0 = rapidocr_rec_decode_at_charset(rec_result.handle, charset_handle, 0)
			if one_rec0 == "" then return "", "", "recognizer decode failed: " + rapidocr_last_error_native() end
			if batch_count > 1 then
				one_rec1 = rapidocr_rec_decode_at_charset(rec_result.handle, charset_handle, 1)
				if one_rec1 == "" then return "", "", "recognizer decode failed: " + rapidocr_last_error_native() end
			end
			if batch_count > 2 then
				one_rec2 = rapidocr_rec_decode_at_charset(rec_result.handle, charset_handle, 2)
				if one_rec2 == "" then return "", "", "recognizer decode failed: " + rapidocr_last_error_native() end
			end
			if batch_count > 3 then
				one_rec3 = rapidocr_rec_decode_at_charset(rec_result.handle, charset_handle, 3)
				if one_rec3 == "" then return "", "", "recognizer decode failed: " + rapidocr_last_error_native() end
			end
			if batch_count > 4 then
				one_rec4 = rapidocr_rec_decode_at_charset(rec_result.handle, charset_handle, 4)
				if one_rec4 == "" then return "", "", "recognizer decode failed: " + rapidocr_last_error_native() end
			end
			if batch_count > 5 then
				one_rec5 = rapidocr_rec_decode_at_charset(rec_result.handle, charset_handle, 5)
				if one_rec5 == "" then return "", "", "recognizer decode failed: " + rapidocr_last_error_native() end
			end
		end
		if i > 0 then
			parts = parts + ","
		end
		parts = parts + one_rec0
		if batch_count > 1 then
			parts = parts + "," + one_rec1
		end
		if batch_count > 2 then
			parts = parts + "," + one_rec2
		end
		if batch_count > 3 then
			parts = parts + "," + one_rec3
		end
		if batch_count > 4 then
			parts = parts + "," + one_rec4
		end
		if batch_count > 5 then
			parts = parts + "," + one_rec5
		end
		i = i + batch_count
	end
	return parts + "]", cls, ""
end

func rapidocr_run_xlang_pipeline(string img_path, bool use_det, bool use_cls, bool use_rec, InferenceSessionObject det_sess, InferenceSessionObject cls_sess, InferenceSessionObject rec_sess, point charset_handle, float det_threshold, float box_thresh, float unclip_ratio, bool det_use_dilation, int min_box_size, bool filter_small_boxes, float cls_thresh, float text_score, int cls_img_w, int cls_img_h, int rec_img_w, int rec_img_h) as RapidOCROutput
	auto img = opencv.imread_flags(img_path, 1)
	if img.empty() then
		return RapidOCROutput("cannot open OCR image: " + img_path)
	end

	string boxes = "[]"
	if use_det then
		int det_w = rapidocr_det_resize_width(img.width(), img.height(), 736)
		int det_h = rapidocr_det_resize_height(img.width(), img.height(), 736)
		auto det_img = opencv.resize(img, det_w, det_h)
		auto det_tensor = onnxruntime.TensorFromOpenCV(det_img.handle, 0.0039215689, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
		auto det_result = det_sess.run_tensor_fast("x", det_tensor, "[]")
		if not det_result.ok() then
			return RapidOCROutput("detector inference failed: " + det_result.error())
		end
		if det_result.ok() then
			int dilation_flag = 0
			int small_filter_flag = 0
			if det_use_dilation then
				dilation_flag = 1
			end
			if filter_small_boxes then
				small_filter_flag = 1
			end
			point boxes_ptr = rapidocr_det_boxes_from_result_db_native(det_result.handle, rapidocr_to_c_int(img.width()), rapidocr_to_c_int(img.height()), det_threshold, box_thresh, unclip_ratio, rapidocr_to_c_int(dilation_flag), rapidocr_to_c_int(min_box_size), rapidocr_to_c_int(small_filter_flag))
			if boxes_ptr == null then return RapidOCROutput("detector postprocess failed: " + rapidocr_last_error_native()) end
			boxes = __xl_runtime.takeCstr(boxes_ptr)
		end
	end

	string cls = "{}"
	string recs_json = "[]"
	string txts = "[\"\"]"
	string scores = "[0]"
	if use_rec then
		string recognition_error = ""
		recs_json, cls, recognition_error = rapidocr_recognize_boxes(img, boxes, use_cls, cls_sess, rec_sess, charset_handle, cls_thresh, cls_img_w, cls_img_h, rec_img_w, rec_img_h)
		if recognition_error != "" then return RapidOCROutput(recognition_error) end
	end
	rapidocr_require_json(boxes)
	rapidocr_require_json(recs_json)
	point assembled_ptr = rapidocr_assemble_result_list_native(boxes, recs_json, 0.0)
	if assembled_ptr == null then return RapidOCROutput("OCR result assembly failed") end
	string assembled = __xl_runtime.takeCstr(assembled_ptr)
	return RapidOCROutput(assembled, rapidocr_text_from_recs(recs_json), boxes, txts, scores, cls, "[]", 0.0, img_path, text_score)
end

export class RapidOCREngine
    point handle
    string config_path
    string det_model_path
    string cls_model_path
    string rec_model_path
    string keys_path
    point charset_handle
    InferenceSessionObject det_session
    InferenceSessionObject cls_session
    InferenceSessionObject rec_session
    float det_threshold
    float box_thresh
    float unclip_ratio
    float text_score
    float cls_thresh
    bool det_use_dilation
    bool filter_small_boxes
    int min_box_size
    int cls_img_w
    int cls_img_h
    int rec_img_w
    int rec_img_h
	create()
		self.config_path = ""
		self.det_model_path = rapidocr_model_path("ch_PP-OCRv4_det_infer.onnx")
		self.cls_model_path = rapidocr_model_path("ch_ppocr_mobile_v2.0_cls_infer.onnx")
		self.rec_model_path = rapidocr_model_path("ch_PP-OCRv4_rec_infer.onnx")
		self.keys_path = rapidocr_model_path("ppocr_keys_v1.txt")
		bool needed = rapidocr_available_native() == 0
		self.charset_handle = null
		if needed then self.charset_handle = rapidocr_charset_open_native(self.keys_path) end
		self.det_session = rapidocr_open_session(self.det_model_path, needed)
		self.cls_session = rapidocr_open_session(self.cls_model_path, needed)
		self.rec_session = rapidocr_open_session(self.rec_model_path, needed)
		self.det_threshold = 0.3
		self.box_thresh = 0.5
		self.unclip_ratio = 1.6
		self.text_score = 0.5
		self.cls_thresh = 0.9
		self.det_use_dilation = true
		self.filter_small_boxes = true
		self.min_box_size = 3
		self.cls_img_w = 192
		self.cls_img_h = 48
		self.rec_img_w = 320
		self.rec_img_h = 48
		self.handle = null
		if not needed then self.handle = rapidocr_create_native("") end
	end

	create(string config_path)
		rapidocr_require_path(config_path)
		self.config_path = config_path
		self.det_model_path = rapidocr_model_path("ch_PP-OCRv4_det_infer.onnx")
		self.cls_model_path = rapidocr_model_path("ch_ppocr_mobile_v2.0_cls_infer.onnx")
		self.rec_model_path = rapidocr_model_path("ch_PP-OCRv4_rec_infer.onnx")
		self.keys_path = rapidocr_model_path("ppocr_keys_v1.txt")
		bool needed = rapidocr_available_native() == 0 and config_path == ""
		self.charset_handle = null
		if needed then self.charset_handle = rapidocr_charset_open_native(self.keys_path) end
		self.det_session = rapidocr_open_session(self.det_model_path, needed)
		self.cls_session = rapidocr_open_session(self.cls_model_path, needed)
		self.rec_session = rapidocr_open_session(self.rec_model_path, needed)
		self.det_threshold = 0.3
		self.box_thresh = 0.5
		self.unclip_ratio = 1.6
		self.text_score = 0.5
		self.cls_thresh = 0.9
		self.det_use_dilation = true
		self.filter_small_boxes = true
		self.min_box_size = 3
		self.cls_img_w = 192
		self.cls_img_h = 48
		self.rec_img_w = 320
		self.rec_img_h = 48
		self.handle = null
		if not needed then self.handle = rapidocr_create_native(config_path) end
	end

	create(string det_model_path, string cls_model_path, string rec_model_path, string keys_path)
		rapidocr_require_path(det_model_path)
		rapidocr_require_path(cls_model_path)
		rapidocr_require_path(rec_model_path)
		rapidocr_require_path(keys_path)
		self.config_path = ""
		self.det_model_path = det_model_path
		self.cls_model_path = cls_model_path
		self.rec_model_path = rec_model_path
		self.keys_path = keys_path
		bool needed = rapidocr_available_native() == 0
		self.charset_handle = null
		if needed then self.charset_handle = rapidocr_charset_open_native(self.keys_path) end
		self.det_session = rapidocr_open_session(self.det_model_path, needed)
		self.cls_session = rapidocr_open_session(self.cls_model_path, needed)
		self.rec_session = rapidocr_open_session(self.rec_model_path, needed)
		self.det_threshold = 0.3
		self.box_thresh = 0.5
		self.unclip_ratio = 1.6
		self.text_score = 0.5
		self.cls_thresh = 0.9
		self.det_use_dilation = true
		self.filter_small_boxes = true
		self.min_box_size = 3
		self.cls_img_w = 192
		self.cls_img_h = 48
		self.rec_img_w = 320
		self.rec_img_h = 48
		self.handle = null
		if not needed then self.handle = rapidocr_create_native("") end
	end

	func release() as bool
		bool released = false
		if self.handle != null then
			rapidocr_release_native(self.handle)
			self.handle = null
			released = true
		end
		if self.charset_handle != null then
			rapidocr_charset_release_native(self.charset_handle)
			self.charset_handle = null
			released = true
		end
		if self.det_session.release() then released = true end
		if self.cls_session.release() then released = true end
		if self.rec_session.release() then released = true end
		return released
	end

	destroy()
		if self.handle != null then
			rapidocr_release_native(self.handle)
		end
		if self.charset_handle != null then
			rapidocr_charset_release_native(self.charset_handle)
		end
		self.det_session.release()
		self.cls_session.release()
		self.rec_session.release()
	end

	func valid() as bool
		if rapidocr_available_native() != 0 then
			return self.handle != null
		end
		return self.config_path == "" and self.charset_handle != null and self.det_session.valid() and self.cls_session.valid() and self.rec_session.valid()
	end

	func set_det_threshold(float value) as bool
		if value <= 0 then
			return false
		end
		self.det_threshold = value
		return true
	end

	func set_text_score(float value) as bool
		if value < 0 then
			return false
		end
		self.text_score = value
		return true
	end

	func set_box_thresh(float value) as bool
		if value < 0 then
			return false
		end
		self.box_thresh = value
		return true
	end

	func set_unclip_ratio(float value) as bool
		if value <= 0 then
			return false
		end
		self.unclip_ratio = value
		return true
	end

	func set_cls_thresh(float value) as bool
		if value < 0 then
			return false
		end
		self.cls_thresh = value
		return true
	end

	func set_det_use_dilation(bool value) as bool
		self.det_use_dilation = value
		return true
	end

	func set_min_box_size(int value) as bool
		if value <= 0 then
			return false
		end
		self.min_box_size = value
		return true
	end

	func set_filter_small_boxes(bool value) as bool
		self.filter_small_boxes = value
		return true
	end

	func set_small_box_filter(bool value, int min_size) as bool
		if min_size <= 0 then
			return false
		end
		self.filter_small_boxes = value
		self.min_box_size = min_size
		return true
	end

	func set_cls_image_shape(int width, int height) as bool
		if width <= 0 or height <= 0 then
			return false
		end
		self.cls_img_w = width
		self.cls_img_h = height
		return true
	end

	func set_rec_image_shape(int width, int height) as bool
		if width <= 0 or height <= 0 then
			return false
		end
		self.rec_img_w = width
		self.rec_img_h = height
		return true
	end

	func op_call(string img) as RapidOCROutput
		rapidocr_require_path(img)
		if not self.valid() then
			return RapidOCROutput("RapidOCR model sessions are unavailable")
		end
		if rapidocr_available_native() == 0 then
			return rapidocr_run_xlang_pipeline(img, true, true, true, self.det_session, self.cls_session, self.rec_session, self.charset_handle, self.det_threshold, self.box_thresh, self.unclip_ratio, self.det_use_dilation, self.min_box_size, self.filter_small_boxes, self.cls_thresh, self.text_score, self.cls_img_w, self.cls_img_h, self.rec_img_w, self.rec_img_h)
		end
		point output = rapidocr_call_native(self.handle, img, 1, 1, 1, 0)
		if output == null then return RapidOCROutput(rapidocr_last_error_native()) end
		return RapidOCROutput(output)
	end

	func op_call(string img, bool use_det, bool use_cls, bool use_rec) as RapidOCROutput
		rapidocr_require_path(img)
		if not self.valid() then
			return RapidOCROutput("RapidOCR model sessions are unavailable")
		end
		int det = 0
		int cls = 0
		int rec = 0
		if use_det then
			det = 1
		end
		if use_cls then
			cls = 1
		end
		if use_rec then
			rec = 1
		end
		if rapidocr_available_native() == 0 then
			return rapidocr_run_xlang_pipeline(img, use_det, use_cls, use_rec, self.det_session, self.cls_session, self.rec_session, self.charset_handle, self.det_threshold, self.box_thresh, self.unclip_ratio, self.det_use_dilation, self.min_box_size, self.filter_small_boxes, self.cls_thresh, self.text_score, self.cls_img_w, self.cls_img_h, self.rec_img_w, self.rec_img_h)
		end
		point output = rapidocr_call_native(self.handle, img, rapidocr_to_c_int(det), rapidocr_to_c_int(cls), rapidocr_to_c_int(rec), 0)
		if output == null then return RapidOCROutput(rapidocr_last_error_native()) end
		return RapidOCROutput(output)
	end
end

func rapidocr_RapidOCR() as RapidOCREngine
	return RapidOCREngine()
end

func rapidocr_RapidOCR(string config_path) as RapidOCREngine
	return RapidOCREngine(config_path)
end

func rapidocr_RapidOCR(string det_model_path, string cls_model_path, string rec_model_path, string keys_path) as RapidOCREngine
	return RapidOCREngine(det_model_path, cls_model_path, rec_model_path, keys_path)
end

func rapidocr_available() as bool
	return opencv.available() and onnxruntime.available()
end

func rapidocr_backend() as string
	if rapidocr_available_native() == 0 then
		return "xlang-pipeline"
	end
	return rapidocr_backend_native()
end

func rapidocr_version() as string
	return "rapidocr 0.1.0"
end

func rapidocr_dependency_status() as string
	return "opencv=" + opencv.backend() + "; onnxruntime=" + onnxruntime.backend() + "; rapidocr=" + rapidocr_backend()
end

func rapidocr_default_model_dir() as string
	return rapidocr_extlib_path("models")
end

func rapidocr_default_config_json() as string
	string modelDir = rapidocr_default_model_dir()
	string detPath = rapidocr_model_path("ch_PP-OCRv4_det_infer.onnx")
	string clsPath = rapidocr_model_path("ch_ppocr_mobile_v2.0_cls_infer.onnx")
	string recPath = rapidocr_model_path("ch_PP-OCRv4_rec_infer.onnx")
	string keysPath = rapidocr_model_path("ppocr_keys_v1.txt")
	return "{\"model_dir\":\"" + rapidocr_json_path(modelDir) + "\",\"det_model_path\":\"" + rapidocr_json_path(detPath) + "\",\"cls_model_path\":\"" + rapidocr_json_path(clsPath) + "\",\"rec_model_path\":\"" + rapidocr_json_path(recPath) + "\",\"keys_path\":\"" + rapidocr_json_path(keysPath) + "\",\"use_det\":true,\"use_cls\":true,\"use_rec\":true,\"return_word_box\":false,\"det_limit_side_len\":960,\"rec_img_h\":48,\"rec_img_w\":320}"
end

func rapidocr_model_layout_json() as string
	string detPath = rapidocr_model_path("ch_PP-OCRv4_det_infer.onnx")
	string clsPath = rapidocr_model_path("ch_ppocr_mobile_v2.0_cls_infer.onnx")
	string recPath = rapidocr_model_path("ch_PP-OCRv4_rec_infer.onnx")
	string keysPath = rapidocr_model_path("ppocr_keys_v1.txt")
	return "{\"models\":[{\"name\":\"det\",\"path\":\"" + rapidocr_json_path(detPath) + "\"},{\"name\":\"cls\",\"path\":\"" + rapidocr_json_path(clsPath) + "\"},{\"name\":\"rec\",\"path\":\"" + rapidocr_json_path(recPath) + "\"},{\"name\":\"keys\",\"path\":\"" + rapidocr_json_path(keysPath) + "\"}]}"
end

func rapidocr_det_boxes_from_output(string output_json, int image_width, int image_height) as string
	rapidocr_require_json(output_json)
	point result = rapidocr_det_boxes_from_output_native(output_json, rapidocr_to_c_int(image_width), rapidocr_to_c_int(image_height), 0.3)
	return rapidocr_take_json_result(result)
end

func rapidocr_det_boxes_from_output(string output_json, int image_width, int image_height, float threshold) as string
	rapidocr_require_json(output_json)
	point result = rapidocr_det_boxes_from_output_native(output_json, rapidocr_to_c_int(image_width), rapidocr_to_c_int(image_height), threshold)
	return rapidocr_take_json_result(result)
end

func rapidocr_charset_info(string path) as string
	rapidocr_require_path(path)
	point result = rapidocr_charset_info_native(path)
	return rapidocr_take_json_result(result)
end

func rapidocr_rec_decode(string output_json, string keys_path) as string
	rapidocr_require_json(output_json)
	rapidocr_require_path(keys_path)
	point result = rapidocr_rec_decode_native(output_json, keys_path)
	return rapidocr_take_json_result(result)
end

func rapidocr_rec_decode_result(point result_handle, string keys_path) as string
	rapidocr_require_path(keys_path)
	point result = rapidocr_rec_decode_result_native(result_handle, keys_path)
	return rapidocr_take_json_result(result)
end

func rapidocr_rec_decode_at_charset(point result_handle, point charset, int batch_index) as string
	point result = rapidocr_rec_decode_result_at_charset_native(result_handle, charset, rapidocr_to_c_int(batch_index))
	if result == null then return "" end
	return __xl_runtime.takeCstr(result)
end

func rapidocr_cls_decode_result(point result_handle) as string
	point result = rapidocr_cls_decode_result_native(result_handle)
	return rapidocr_take_json_result(result)
end

func rapidocr_cls_decode_result_at(point result_handle, int batch_index) as string
	point result = rapidocr_cls_decode_result_at_native(result_handle, rapidocr_to_c_int(batch_index))
	if result == null then return "" end
	return __xl_runtime.takeCstr(result)
end

func rapidocr_ocr_items_json2(string result_json, float text_score) as string
	rapidocr_require_json(result_json)
	point result = rapidocr_to_ocr_items_json2_native(result_json, text_score)
	return rapidocr_take_json_result(result)
end

func rapidocr_ocr_items_json(string result_json) as string
	return rapidocr_ocr_items_json2(result_json, 0.5)
end

