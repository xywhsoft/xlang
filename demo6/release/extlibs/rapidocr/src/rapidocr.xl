func rapidocr_vis_image(string source_path, string boxes_json, string save_path) as bool
	rapidocr_require_path(source_path)
	rapidocr_require_path(save_path)
	rapidocr_require_json(boxes_json)
	return rapidocr_vis_image_native(source_path, boxes_json, save_path) != 0
end

func rapidocr_assembled_text(point result) as string
	if result == null then throw ValueError "RapidOCR result JSON is invalid or too large" end
	return __xl_runtime.takeCstr(result)
end

func rapidocr_assemble_result(string boxes_json, string rec_json) as string
	rapidocr_require_json(boxes_json)
	rapidocr_require_json(rec_json)
	return rapidocr_assembled_text(rapidocr_assemble_result_native(boxes_json, rec_json, 0.0))
end

func rapidocr_assemble_result(string boxes_json, string rec_json, float elapse) as string
	rapidocr_require_json(boxes_json)
	rapidocr_require_json(rec_json)
	return rapidocr_assembled_text(rapidocr_assemble_result_native(boxes_json, rec_json, elapse))
end

