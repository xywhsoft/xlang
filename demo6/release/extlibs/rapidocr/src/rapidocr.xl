end

func rapidocr_box_x(string boxes_json, int index) as int
	return rapidocr_box_x_native(boxes_json, index)
end

func rapidocr_box_y(string boxes_json, int index) as int
	return rapidocr_box_y_native(boxes_json, index)
end

func rapidocr_box_width(string boxes_json, int index) as int
	return rapidocr_box_width_native(boxes_json, index)
end

func rapidocr_box_height(string boxes_json, int index) as int
	return rapidocr_box_height_native(boxes_json, index)
end

func rapidocr_box_point_x(string boxes_json, int index, int point_index) as float
	return rapidocr_box_point_x_native(boxes_json, index, point_index)
end

func rapidocr_box_point_y(string boxes_json, int index, int point_index) as float
	return rapidocr_box_point_y_native(boxes_json, index, point_index)
end

func rapidocr_vis_image(string source_path, string boxes_json, string save_path) as bool
	return rapidocr_vis_image_native(source_path, boxes_json, save_path) != 0
end

func rapidocr_assemble_result(string boxes_json, string rec_json) as string
	return rapidocr_assemble_result_native(boxes_json, rec_json, 0)
end

func rapidocr_assemble_result(string boxes_json, string rec_json, float elapse) as string
	return rapidocr_assemble_result_native(boxes_json, rec_json, elapse)
end

func rapidocr_assemble_result2(string boxes_json, string rec0_json, string rec1_json) as string
	return rapidocr_assemble_result2_native(boxes_json, rec0_json, rec1_json, 0)
end

func rapidocr_assemble_result2(string boxes_json, string rec0_json, string rec1_json, float elapse) as string
