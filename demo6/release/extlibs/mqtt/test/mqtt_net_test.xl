import mqtt

extern "mqtt_fixture_open" func fixtureOpen() as point
extern "mqtt_fixture_client" func fixtureClient(point fixture) as point
extern "mqtt_fixture_close" func fixtureClose(point fixture) as bool



// 参数校验失败不应消费 TCP 数据，也不应覆盖原始 MQTT 诊断。
func invalidTransport(TcpStream stream, int kind)
    if kind == 0 then
        mqtt.recvFrame(stream, timeoutMs = -2)
    elseif kind == 1 then
        mqtt.recvFrame(stream, packetLimit = 1)
    elseif kind == 2 then
        mqtt.sendFrame(stream, mqtt.pingreqFrame(), timeoutMs = 0)
    elseif kind == 3 then
        mqtt.handshake(stream, "bad", keepalive = -1)
    elseif kind == 4 then
        mqtt.handshake(stream, "bad", timeoutMs = 9223372036854775807)
    else
        mqtt.sendFrame(stream, mqtt.hexToFrame("c000d000"))
    end
end

func conversation(point fixture)
    TcpStream stream = TcpStream(fixtureClient(fixture))
    for kind in range(6)
        bool raised = false
        try
            invalidTransport(stream, kind)
        catch e
            raised = true
            assert e.message.contains("mqtt:")
        end
        assert raised
    end
    var ack = mqtt.handshake(stream, "xlang-client", keepalive = 0)
    assert ack["returnCode"] == 0
    Buffer incoming = mqtt.recvFrame(stream)
    var message = mqtt.parseFrame(incoming)
    Buffer binary = mqtt.payloadBytes(incoming)
    assert message["topic"] == "t" and binary.len() == 4
    assert binary.byteAt(0) == 0 and binary.byteAt(1) == 255
    assert mqtt.frameToHex(mqtt.recvFrame(stream)) == "d000", "following frame was not consumed"

    Buffer payload = Buffer()
    for i in range(16384)
        assert payload.appendByte(i % 256)
    end
    mqtt.sendFrame(stream, mqtt.publishFrame(1, "upload", payload, 7), 10000)
    assert mqtt.parseFrame(mqtt.recvFrame(stream))["packetId"] == 7
end



func main(...) as int
    point fixture = fixtureOpen()
    assert fixture != null
    conversation(fixture)
    assert fixtureClose(fixture)
    println("mqtt xlang TCP boundaries: PASS")
    return 0
end
