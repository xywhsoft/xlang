extern "xhttp_protocol_last_error" func __xhttp_protocol_error_native() as point
extern "xhttp_protocol_cookie_count" func __xhttp_cookie_count(
    string text, c_size size) as c_longlong
extern "xhttp_protocol_set_cookie_validate" func __xhttp_set_cookie_validate(
    string text, c_size size) as bool
extern "xhttp_protocol_set_cookie_build" func __xhttp_set_cookie_build(
    string name, c_size nameSize,
    string value, c_size valueSize,
    string domain, c_size domainSize,
    string path, c_size pathSize,
    bool hasExpires, c_longlong expires,
    bool hasMaxAge, c_longlong maxAge,
    c_longlong sameSite, c_longlong priority,
    bool secure, bool httpOnly, bool partitioned) as point
extern "xhttp_protocol_mime_lookup" func __xhttp_mime_lookup(
    string text, c_size size, bool path) as point
extern "xhttp_protocol_content_compressible" func __xhttp_content_compressible(
    string text, c_size size) as bool
extern "xhttp_protocol_buffer_take_cstr" func __xhttp_protocol_buffer_take_cstr(point handle) as point



export const int HTTP_PARAM_HAS_VALUE = 1
export const int HTTP_PARAM_QUOTED = 2

export const int SET_COOKIE_HAS_DOMAIN = 1
export const int SET_COOKIE_HAS_PATH = 2
export const int SET_COOKIE_HAS_EXPIRES = 4
export const int SET_COOKIE_HAS_MAX_AGE = 8
export const int SET_COOKIE_HAS_SAME_SITE = 16
export const int SET_COOKIE_SECURE = 32
export const int SET_COOKIE_HTTP_ONLY = 64
export const int SET_COOKIE_PARTITIONED = 128
export const int SET_COOKIE_HAS_PRIORITY = 256

export const int SAME_SITE_DEFAULT = 0
export const int SAME_SITE_LAX = 1
export const int SAME_SITE_STRICT = 2
export const int SAME_SITE_NONE = 3

export const int COOKIE_PRIORITY_UNSPECIFIED = 0
export const int COOKIE_PRIORITY_LOW = 1
export const int COOKIE_PRIORITY_MEDIUM = 2
export const int COOKIE_PRIORITY_HIGH = 3



// 接管当前线程错误文本的独立快照。
func __xhttp_protocol_error() as string
    point handle = __xhttp_protocol_error_native()
    if handle == null then
        return "xhttp.protocol operation failed"
    end
    Buffer result = Buffer(handle)
    point text = __xhttp_protocol_buffer_take_cstr(result.handle)
    if text != null then return __xl_runtime.takeCstr(text) end
    return result.text()
end



// 普通文本移交 Buffer 数据；含 NUL 的结果保持长度感知转换。
func __xhttp_protocol_text(point handle) as string
    if handle == null then
        throw RuntimeError __xhttp_protocol_error()
    end
    Buffer result = Buffer(handle)
    point text = __xhttp_protocol_buffer_take_cstr(result.handle)
    if text != null then return __xl_runtime.takeCstr(text) end
    return result.text()
end



// 检查拥有型原生句柄并保留 XRT 的结构化失败原因。
func __xhttp_protocol_handle(point handle) as point
    if handle == null then
        throw RuntimeError __xhttp_protocol_error()
    end
    return handle
end



// 返回当前线程最近一次 xhttp.protocol/XRT 错误文本。
export func lastError() as string
    return __xhttp_protocol_error()
end



// Header 是保留原始大小写和值字节的不可变字段值。
export class Header
    string name
    string value

    create(string name, string value)
        self.name = name
        self.value = value
    end
end



// Headers 是大小写不敏感查询、允许重复字段的拥有型容器。
export class Headers
    native point handle
    extern "xhttp_protocol_headers_create" create()
    extern "xhttp_protocol_headers_parse" create(
        string text, c_size size)
    extern "xhttp_protocol_headers_wrap" create(point handle)
    extern "xhttp_protocol_headers_destroy" destroy()
    extern "xhttp_protocol_headers_native" func nativeHandle() as point
    extern "xhttp_protocol_headers_clone" func cloneNative() as point
    extern "xhttp_protocol_headers_value" func valueNative(
        c_longlong field) as c_ulonglong
    extern "xhttp_protocol_headers_clear" func clear()
    extern "xhttp_protocol_headers_reserve" func reserveNative(
        c_size fields, c_size bytes) as bool
    extern "xhttp_protocol_headers_compact" func compact() as bool
    extern "xhttp_protocol_headers_write" func writeNative(
        string name, c_size nameSize,
        string value, c_size valueSize,
        bool set) as bool
    extern "xhttp_protocol_headers_name" func nameNative(
        string name, c_size size, c_longlong operation) as c_ulonglong
    extern "xhttp_protocol_headers_at_text" func atTextNative(
        c_ulonglong index, c_longlong field) as point
    extern "xhttp_protocol_headers_get" func getNative(
        string name, c_size size, c_ulonglong occurrence) as point
    extern "xhttp_protocol_headers_add_block" func addBlockNative(
        string text, c_size size) as bool
    extern "xhttp_protocol_headers_build" func buildNative() as point

    static func parse(string text) as Headers
        return Headers(text, c_size(string.byteLen(text)))
    end

    get valid() as bool
        return self.handle != null
    end

    get count() as int
        return int(self.valueNative(c_longlong(0)))
    end

    get bytes() as int
        return int(self.valueNative(c_longlong(1)))
    end

    func reserve(int fields, int bytes) as bool
        if fields < 0 or bytes < 0 then
            throw ValueError "Headers reserve values must not be negative"
        end
        return self.reserveNative(c_size(fields), c_size(bytes))
    end

    func add(string name, string value) as bool
        return self.writeNative(
            name, c_size(string.byteLen(name)),
            value, c_size(string.byteLen(value)), false)
    end

    func set(string name, string value) as bool
        return self.writeNative(
            name, c_size(string.byteLen(name)),
            value, c_size(string.byteLen(value)), true)
    end

    func remove(string name) as int
        return int(self.nameNative(
            name, c_size(string.byteLen(name)), c_longlong(0)))
    end

    func countName(string name) as int
        return int(self.nameNative(
            name, c_size(string.byteLen(name)), c_longlong(1)))
    end

    func has(string name) as bool
        return self.nameNative(
            name, c_size(string.byteLen(name)), c_longlong(2)) != 0
    end

    func nameAt(int index) as string
        if index < 0 or index >= self.count then
            throw IndexError "Header index is out of range"
        end
        return __xhttp_protocol_text(self.atTextNative(
            c_ulonglong(index), c_longlong(0)))
    end

    func valueAt(int index) as string
        if index < 0 or index >= self.count then
            throw IndexError "Header index is out of range"
        end
        return __xhttp_protocol_text(self.atTextNative(
            c_ulonglong(index), c_longlong(1)))
    end

    func at(int index) as Header
        return Header(self.nameAt(index), self.valueAt(index))
    end

    func get(string name, int occurrence = 0) as string?
        if occurrence < 0 then
            throw ValueError "Header occurrence must not be negative"
        end
        point result = self.getNative(
            name, c_size(string.byteLen(name)), c_ulonglong(occurrence))
        if result == null then
            return null
        end
        return __xhttp_protocol_text(result)
    end

    func getAll(string name) as array<string>
        array<string> result = array<string>[]
        int count = self.countName(name)
        int index = 0
        while index < count
            string? value = self.get(name, index)
            if value != null then
                result.push(value)
            end
            index += 1
        end
        return result
    end

    func addBlock(string text) as bool
        return self.addBlockNative(text, c_size(string.byteLen(text)))
    end

    func clone() as Headers
        return Headers(__xhttp_protocol_handle(self.cloneNative()))
    end

    func build() as string
        return __xhttp_protocol_text(self.buildNative())
    end

    func __len__() as int
        return self.count
    end

    func __item__(string name) as string?
        return self.get(name)
    end

    func __iter__() as HeadersIter
        return HeadersIter(self.nativeHandle())
    end

    func __toString__() as string
        return self.build()
    end
end



// HeadersIter 持有深复制快照，外部修改和销毁不会破坏迭代状态。
export class HeadersIter
    native point handle
    int index
    extern "xhttp_protocol_headers_clone" create(point source)
    extern "xhttp_protocol_headers_destroy" destroy()
    extern "xhttp_protocol_headers_value" func valueNative(
        c_longlong field) as c_ulonglong
    extern "xhttp_protocol_headers_at_text" func atTextNative(
        c_ulonglong index, c_longlong field) as point

    get count() as int
        return int(self.valueNative(c_longlong(0)))
    end

    func at(int index) as Header
        return Header(
            __xhttp_protocol_text(self.atTextNative(
                c_ulonglong(index), c_longlong(0))),
            __xhttp_protocol_text(self.atTextNative(
                c_ulonglong(index), c_longlong(1))))
    end

    func __next__() as (bool, Header)
        if self.index >= self.count then
            return false, Header("", "")
        end
        Header result = self.at(self.index)
        self.index += 1
        return true, result
    end
end



// CookiePair 是 Cookie 请求字段中的不可变名称和值。
export class CookiePair
    string name
    string value

    create(string name, string value)
        self.name = name
        self.value = value
    end
end



// Cookies 拥有原始字段文本及全部解析 pair，允许重复名称。
export class Cookies
    native point handle
    extern "xhttp_protocol_cookies_parse" create(
        string text, c_size size)
    extern "xhttp_protocol_cookies_wrap" create(point handle)
    extern "xhttp_protocol_cookies_destroy" destroy()
    extern "xhttp_protocol_cookies_native" func nativeHandle() as point
    extern "xhttp_protocol_cookies_clone" func cloneNative() as point
    extern "xhttp_protocol_cookies_count" func countNative() as c_ulonglong
    extern "xhttp_protocol_cookies_text" func textNative() as point
    extern "xhttp_protocol_cookies_at_text" func atTextNative(
        c_ulonglong index, c_longlong field) as point
    extern "xhttp_protocol_cookies_get" func getNative(
        string name, c_size size, c_ulonglong occurrence) as point
    extern "xhttp_protocol_cookies_build" func buildNative() as point

    static func parse(string text) as Cookies
        return Cookies(text, c_size(string.byteLen(text)))
    end

    static func countOf(string text) as int
        int count = int(__xhttp_cookie_count(
            text, c_size(string.byteLen(text))))
        if count < 0 then
            throw ValueError __xhttp_protocol_error()
        end
        return count
    end

    get count() as int
        return int(self.countNative())
    end

    func text() as string
        return __xhttp_protocol_text(self.textNative())
    end

    func nameAt(int index) as string
        if index < 0 or index >= self.count then
            throw IndexError "Cookie index is out of range"
        end
        return __xhttp_protocol_text(self.atTextNative(
            c_ulonglong(index), c_longlong(0)))
    end

    func valueAt(int index) as string
        if index < 0 or index >= self.count then
            throw IndexError "Cookie index is out of range"
        end
        return __xhttp_protocol_text(self.atTextNative(
            c_ulonglong(index), c_longlong(1)))
    end

    func at(int index) as CookiePair
        return CookiePair(self.nameAt(index), self.valueAt(index))
    end

    func get(string name, int occurrence = 0) as string?
        if occurrence < 0 then
            throw ValueError "Cookie occurrence must not be negative"
        end
        point result = self.getNative(
            name, c_size(string.byteLen(name)), c_ulonglong(occurrence))
        if result == null then
            return null
        end
        return __xhttp_protocol_text(result)
    end

    func clone() as Cookies
        return Cookies(__xhttp_protocol_handle(self.cloneNative()))
    end

    func build() as string
        return __xhttp_protocol_text(self.buildNative())
    end

    func __len__() as int
        return self.count
    end

    func __item__(string name) as string?
        return self.get(name)
    end

    func __iter__() as CookiesIter
        return CookiesIter(self.cloneNative())
    end

    func __toString__() as string
        return self.text()
    end
end



// CookiesIter 持有独立 Cookies 快照。
export class CookiesIter
    Cookies cookies
    int index

    create(point handle)
        self.cookies = Cookies(__xhttp_protocol_handle(handle))
    end

    func __next__() as (bool, CookiePair)
        if self.index >= self.cookies.count then
            return false, CookiePair("", "")
        end
        CookiePair result = self.cookies.at(self.index)
        self.index += 1
        return true, result
    end
end



// SetCookieAttribute 保留 Foo 与 Foo= 的区别。
export class SetCookieAttribute
    string name
    string? value
    bool hasValue

    create(string name, string? value, bool hasValue)
        self.name = name
        self.value = value
        self.hasValue = hasValue
    end
end



// SetCookie 拥有原始字段文本并公开 RFC 接收算法的结构化结果。
export class SetCookie
    native point handle
    extern "xhttp_protocol_set_cookie_parse" create(
        string text, c_size size)
    extern "xhttp_protocol_set_cookie_wrap" create(point handle)
    extern "xhttp_protocol_set_cookie_destroy" destroy()
    extern "xhttp_protocol_set_cookie_native" func nativeHandle() as point
    extern "xhttp_protocol_set_cookie_clone" func cloneNative() as point
    extern "xhttp_protocol_set_cookie_text" func textNative(
        c_longlong field) as point
    extern "xhttp_protocol_set_cookie_value" func valueNative(
        c_longlong field) as c_longlong
    extern "xhttp_protocol_set_cookie_attribute_count" func attributeCountNative() as c_ulonglong
    extern "xhttp_protocol_set_cookie_attribute_text" func attributeTextNative(
        c_ulonglong index, c_longlong field) as point
    extern "xhttp_protocol_set_cookie_attribute_value" func attributeHasValueNative(
        c_ulonglong index) as bool

    static func parse(string text) as SetCookie
        return SetCookie(text, c_size(string.byteLen(text)))
    end

    static func validate(string text) as bool
        return __xhttp_set_cookie_validate(
            text, c_size(string.byteLen(text)))
    end

    static func build(
        string name,
        string value,
        string domain = "",
        string path = "",
        bool hasExpires = false,
        int expires = 0,
        bool hasMaxAge = false,
        int maxAge = 0,
        int sameSite = SAME_SITE_DEFAULT,
        int priority = COOKIE_PRIORITY_UNSPECIFIED,
        bool secure = false,
        bool httpOnly = false,
        bool partitioned = false
    ) as string
        return __xhttp_protocol_text(__xhttp_set_cookie_build(
            name, c_size(string.byteLen(name)),
            value, c_size(string.byteLen(value)),
            domain, c_size(string.byteLen(domain)),
            path, c_size(string.byteLen(path)),
            hasExpires, c_longlong(expires),
            hasMaxAge, c_longlong(maxAge),
            c_longlong(sameSite), c_longlong(priority),
            secure, httpOnly, partitioned))
    end

    get flags() as int
        return int(self.valueNative(c_longlong(0)))
    end

    get hasDomain() as bool
        return (self.flags & SET_COOKIE_HAS_DOMAIN) != 0
    end

    get hasPath() as bool
        return (self.flags & SET_COOKIE_HAS_PATH) != 0
    end

    get hasExpires() as bool
        return (self.flags & SET_COOKIE_HAS_EXPIRES) != 0
    end

    get hasMaxAge() as bool
        return (self.flags & SET_COOKIE_HAS_MAX_AGE) != 0
    end

    get hasSameSite() as bool
        return (self.flags & SET_COOKIE_HAS_SAME_SITE) != 0
    end

    get secure() as bool
        return (self.flags & SET_COOKIE_SECURE) != 0
    end

    get httpOnly() as bool
        return (self.flags & SET_COOKIE_HTTP_ONLY) != 0
    end

    get partitioned() as bool
        return (self.flags & SET_COOKIE_PARTITIONED) != 0
    end

    get hasPriority() as bool
        return (self.flags & SET_COOKIE_HAS_PRIORITY) != 0
    end

    get expires() as int
        return int(self.valueNative(c_longlong(1)))
    end

    get maxAge() as int
        return int(self.valueNative(c_longlong(2)))
    end

    get sameSite() as int
        return int(self.valueNative(c_longlong(3)))
    end

    get priority() as int
        return int(self.valueNative(c_longlong(4)))
    end

    get attributeCount() as int
        return int(self.attributeCountNative())
    end

    func text() as string
        return __xhttp_protocol_text(self.textNative(c_longlong(0)))
    end

    func name() as string
        return __xhttp_protocol_text(self.textNative(c_longlong(1)))
    end

    func value() as string
        return __xhttp_protocol_text(self.textNative(c_longlong(2)))
    end

    func domain() as string
        return __xhttp_protocol_text(self.textNative(c_longlong(3)))
    end

    func path() as string
        return __xhttp_protocol_text(self.textNative(c_longlong(4)))
    end

    func rawAttributes() as string
        return __xhttp_protocol_text(self.textNative(c_longlong(5)))
    end

    func attribute(int index) as SetCookieAttribute
        if index < 0 or index >= self.attributeCount then
            throw IndexError "Set-Cookie attribute index is out of range"
        end
        bool hasValue = self.attributeHasValueNative(c_ulonglong(index))
        string? value = null
        if hasValue then
            value = __xhttp_protocol_text(self.attributeTextNative(
                c_ulonglong(index), c_longlong(1)))
        end
        return SetCookieAttribute(
            __xhttp_protocol_text(self.attributeTextNative(
                c_ulonglong(index), c_longlong(0))),
            value,
            hasValue)
    end

    func clone() as SetCookie
        return SetCookie(__xhttp_protocol_handle(self.cloneNative()))
    end

    func __toString__() as string
        return self.text()
    end
end



// MediaParam 保留 quoted-string 标志和解码后的语义值。
export class MediaParam
    string name
    string value
    bool quoted

    create(string name, string value, bool quoted)
        self.name = name
        self.value = value
        self.quoted = quoted
    end
end



// MediaType 拥有 Content-Type 原文并公开严格解析后的组件。
export class MediaType
    native point handle
    extern "xhttp_protocol_media_parse" create(
        string text, c_size size)
    extern "xhttp_protocol_media_wrap" create(point handle)
    extern "xhttp_protocol_media_destroy" destroy()
    extern "xhttp_protocol_media_native" func nativeHandle() as point
    extern "xhttp_protocol_media_clone" func cloneNative() as point
    extern "xhttp_protocol_media_text" func textNative(
        c_longlong field) as point
    extern "xhttp_protocol_media_equal" func isNative(
        string type, c_size typeSize,
        string subtype, c_size subtypeSize) as bool
    extern "xhttp_protocol_media_compressible" func compressibleNative() as bool
    extern "xhttp_protocol_media_param_flags" func paramFlagsNative(
        string name, c_size size) as c_longlong
    extern "xhttp_protocol_media_param_text" func paramTextNative(
        string name, c_size size) as point
    extern "xhttp_protocol_media_build" func buildNative() as point

    static func parse(string text) as MediaType
        return MediaType(text, c_size(string.byteLen(text)))
    end

    static func contentCompressible(string text) as bool
        return __xhttp_content_compressible(
            text, c_size(string.byteLen(text)))
    end

    func text() as string
        return __xhttp_protocol_text(self.textNative(c_longlong(0)))
    end

    func type() as string
        return __xhttp_protocol_text(self.textNative(c_longlong(1)))
    end

    func subtype() as string
        return __xhttp_protocol_text(self.textNative(c_longlong(2)))
    end

    func parameters() as string
        return __xhttp_protocol_text(self.textNative(c_longlong(3)))
    end

    func suffix() as string
        return __xhttp_protocol_text(self.textNative(c_longlong(4)))
    end

    get compressible() as bool
        return self.compressibleNative()
    end

    func matches(string type, string subtype) as bool
        return self.isNative(
            type, c_size(string.byteLen(type)),
            subtype, c_size(string.byteLen(subtype)))
    end

    func param(string name) as MediaParam?
        int flags = int(self.paramFlagsNative(
            name, c_size(string.byteLen(name))))
        if flags == -1 then
            return null
        end
        if flags < -1 then
            throw RuntimeError __xhttp_protocol_error()
        end
        return MediaParam(
            name,
            __xhttp_protocol_text(self.paramTextNative(
                name, c_size(string.byteLen(name)))),
            (flags & HTTP_PARAM_QUOTED) != 0)
    end

    func clone() as MediaType
        return MediaType(__xhttp_protocol_handle(self.cloneNative()))
    end

    func build() as string
        return __xhttp_protocol_text(self.buildNative())
    end

    func __toString__() as string
        return self.build()
    end
end



// Mime 提供不分配查表能力的语言级入口，结果复制为稳定字符串。
export class Mime
    static func byExt(string extension) as string
        return __xhttp_protocol_text(__xhttp_mime_lookup(
            extension, c_size(string.byteLen(extension)), false))
    end

    static func byPath(string path) as string
        return __xhttp_protocol_text(__xhttp_mime_lookup(
            path, c_size(string.byteLen(path)), true))
    end
end
