extern "xgeohash_encode" func __geo_encode(c_double lat, c_double lon, c_int precision) as string
extern "xgeohash_decode_lat" func __geo_decode_lat(string hash) as float
extern "xgeohash_decode_lon" func __geo_decode_lon(string hash) as float
extern "xgeohash_bbox" func __geo_bbox(string hash) as string
extern "xgeohash_neighbor" func __geo_neighbor(string hash, c_int direction) as string
extern "xgeohash_precision" func __geo_precision(string hash) as int



export func encode(float lat, float lon, int precision = 6) as string
    return __geo_encode(c_double(lat), c_double(lon), c_int(precision))
end

export func decodeLat(string hash) as float
    return __geo_decode_lat(hash)
end

export func decodeLon(string hash) as float
    return __geo_decode_lon(hash)
end

export func bbox(string hash) as string
    return __geo_bbox(hash)
end

export func north(string hash) as string
    return __geo_neighbor(hash, c_int(0))
end

export func south(string hash) as string
    return __geo_neighbor(hash, c_int(1))
end

export func east(string hash) as string
    return __geo_neighbor(hash, c_int(2))
end

export func west(string hash) as string
    return __geo_neighbor(hash, c_int(3))
end

export func precision(string hash) as int
    return __geo_precision(hash)
end
