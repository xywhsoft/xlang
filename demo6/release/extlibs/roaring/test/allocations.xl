import roaring

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

int createFailures = 0
int createSuccesses = 0
for allocation in range(12)
    bool caught = false
    assert failAfter(uint64(allocation))
    try
        roaring.RoaringBitmap candidate = roaring.create()
        assert candidate.valid
    catch MemoryError error
        caught = true
    end
    bool triggered = failTriggered()
    failClear()
    assert caught == triggered
    if caught then createFailures += 1 else createSuccesses += 1 end
end
assert createFailures > 0 and createSuccesses > 0

int addFailures = 0
int addSuccesses = 0
for allocation in range(12)
    roaring.RoaringBitmap bitmap = roaring.create()
    bool caught = false
    assert failAfter(uint64(allocation))
    try
        bitmap.add(123)
    catch MemoryError error
        caught = true
    end
    bool triggered = failTriggered()
    failClear()
    assert caught == triggered
    if caught then
        assert bitmap.count == 0 and not bitmap.contains(123)
        addFailures += 1
    else
        assert bitmap.count == 1 and bitmap.contains(123)
        addSuccesses += 1
    end
end
assert addFailures > 0 and addSuccesses > 0

roaring.RoaringBitmap upgraded = roaring.create()
for i in range(4096)
    upgraded.add(i)
end
assert failAfter(0)
bool caught = false
try
    upgraded.add(4096)
catch MemoryError error
    caught = true
end
assert caught and failTriggered()
failClear()
assert upgraded.count == 4096 and not upgraded.contains(4096)
upgraded.add(4096)
assert upgraded.count == 4097 and upgraded.contains(4096)

assert failAfter(0)
caught = false
try
    upgraded.remove(4096)
catch MemoryError error
    caught = true
end
assert caught and failTriggered()
failClear()
assert upgraded.count == 4097 and upgraded.contains(4096)
assert upgraded.remove(4096) and upgraded.count == 4096

for i in range(1025, 4096)
    assert upgraded.remove(i)
end
assert upgraded.count == 1025
assert failAfter(0)
caught = false
try
    upgraded.remove(1024)
catch MemoryError error
    caught = true
end
assert caught and failTriggered()
failClear()
assert upgraded.count == 1025 and upgraded.contains(1024)
assert upgraded.remove(1024) and upgraded.count == 1024

roaring.RoaringBitmap snapshotSet = roaring.create()
snapshotSet.add(7)
snapshotSet.add(65536)
snapshotSet.add(4294967295)
int snapshotFailures = 0
int snapshotSuccesses = 0
for allocation in range(16)
    bool snapshotCaught = false
    assert failAfter(uint64(allocation))
    try
        var ordered = snapshotSet.toArray()
        assert ordered.length == 3
    catch MemoryError error
        snapshotCaught = true
    end
    bool snapshotTriggered = failTriggered()
    failClear()
    assert snapshotCaught == snapshotTriggered
    assert snapshotSet.count == 3 and snapshotSet.contains(4294967295)
    if snapshotCaught then snapshotFailures += 1 else snapshotSuccesses += 1 end
end
assert snapshotFailures > 0 and snapshotSuccesses > 0
