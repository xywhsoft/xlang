// ----------------------------- 流式：快照、分支与失败复位 -----------------------------

export class SipHasher
    native point handle
    extern "xsiphash_hasher_create" create(point key, c_size keySize, c_ulonglong maxInput)
    extern "xsiphash_hasher_create_key_str" create(string key, c_size keySize, c_ulonglong maxInput)
    extern "xsiphash_hasher_adopt" create(point handle)
    extern "xsiphash_hasher_destroy" destroy()
    extern "xsiphash_hasher_update" func updateNative(point data, c_size size) as bool
    extern "xsiphash_hasher_update_str" func updateStrNative(string data, c_size size) as bool
    extern "xsiphash_hasher_digest64" func digest64Native() as c_ulonglong
    extern "xsiphash_hasher_digest64_hex" func digest64Hex() as string
    extern "xsiphash_hasher_digest64_bytes" func digest64BytesNative() as point
    extern "xsiphash_hasher_digest128_hex" func digest128Hex() as string
    extern "xsiphash_hasher_digest128_bytes" func digest128BytesNative() as point
    extern "xsiphash_hasher_reset" func reset() as bool
    extern "xsiphash_hasher_input_bytes" func inputBytesNative() as c_ulonglong
    extern "xsiphash_hasher_clone" func cloneNative() as point

    get valid() as bool
        return self.handle != null
    end
    get inputBytes() as uint64
        return uint64(self.inputBytesNative())
    end
    func update(Buffer data)
        self.updateNative(data.data(), c_size(data.len()))
    end
    func update(string text)
        self.updateStrNative(text, c_size(string.byteLen(text)))
    end
    func digest64() as uint64
        return uint64(self.digest64Native())
    end
    func digest64Bytes() as Buffer
        return Buffer(self.digest64BytesNative())
    end
    func digest128Bytes() as Buffer
        return Buffer(self.digest128BytesNative())
    end
    func clone() as SipHasher
        return SipHasher(self.cloneNative())
    end
end

export func hasher(Buffer key, int maxInput = 268435456) as SipHasher
    __limit(maxInput)
    return SipHasher(key.data(), c_size(key.len()), c_ulonglong(maxInput))
end
export func hasher(string key, int maxInput = 268435456) as SipHasher
    __limit(maxInput)
    return SipHasher(key, c_size(string.byteLen(key)), c_ulonglong(maxInput))
end
