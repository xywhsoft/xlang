import x.uia
import opencv

const int DEFAULT_TIMEOUT_MS = 5000

class Locator
	string automation_id
	string class_name
	string name
	int control_type
	int process_id
	point root_hwnd
	int timeout_ms

	create()
		self.automation_id = ""
		self.class_name = ""
		self.name = ""
		self.control_type = 0
		self.process_id = 0
		self.root_hwnd = null
		self.timeout_ms = 5000
	end
end

class AutoTestWindow
	point handle

	create(point h)
		self.handle = h
	end

	func valid() as bool
		return x_uia_test_window_valid(self.handle)
	end

	func hwnd() as point
		return x_uia_test_window_hwnd(self.handle)
	end

	func close() as bool
		return x_uia_test_window_close(self.handle)
	end

	func release() as bool
		return x_uia_test_window_release(self.handle)
	end
end

func x_ui_auto_locator() as Locator
	return Locator()
end

func x_ui_auto_test_window() as AutoTestWindow
	return AutoTestWindow(x_uia_test_window_create())
end

func x_ui_auto_shutdown() as bool
	return x_uia_shutdown()
end

func x_ui_auto_by_automation_id(string automation_id, int control_type) as Locator
	auto loc = Locator()
	loc.automation_id = automation_id
	loc.control_type = control_type
	return loc
end

func x_ui_auto_by_class_name(string class_name, string name, int control_type) as Locator
	auto loc = Locator()
	loc.class_name = class_name
	loc.name = name
	loc.control_type = control_type
	return loc
end

func x_ui_auto_by_name(string name, int control_type) as Locator
	auto loc = Locator()
	loc.name = name
	loc.control_type = control_type
	return loc
end

func x_ui_auto_by_control_type(int control_type) as Locator
	auto loc = Locator()
	loc.control_type = control_type
	return loc
end

func x_ui_auto_by_process_id(int process_id) as Locator
	auto loc = Locator()
	loc.process_id = process_id
	return loc
end

func x_ui_auto_within(Locator loc, point hwnd) as Locator
	loc.root_hwnd = hwnd
	return loc
end

func x_ui_auto_with_timeout(Locator loc, int timeout_ms) as Locator
	loc.timeout_ms = timeout_ms
	return loc
end

func x_ui_auto_locator_from_json(string json) as Locator
	auto loc = Locator()
	loc.automation_id = json_string(json, "automationId")
	loc.class_name = json_string(json, "className")
	loc.name = json_string(json, "name")
	loc.control_type = json_int(json, "controlType")
	loc.process_id = json_int(json, "processId")
	return loc
end

func x_ui_auto_wait_exists(Locator loc) as bool
	if loc.root_hwnd != null then
		auto root = x.uia.from_hwnd(loc.root_hwnd)
		if root.valid() == false then
			return false
		end
		return wait_exists_in_root(root, loc)
	end

	auto root = x.uia.desktop()
	if root.valid() == false then
		return false
	end
	return wait_exists_in_root(root, loc)
end

func x_ui_auto_click(Locator loc) as bool
	if loc.root_hwnd != null then
		auto root = x.uia.from_hwnd(loc.root_hwnd)
		if root.valid() == false then
			return false
		end
		return click_in_root(root, loc)
	end

	auto root = x.uia.desktop()
	if root.valid() == false then
		return false
	end
	return click_in_root(root, loc)
end

