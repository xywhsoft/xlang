	return screenshot_in_root(root, loc, path)
end

func x_ui_auto_focused_locator_json() as string
	return x.uia.focused_locator()
end

func json_string(string text, string key) as string
	var obj = json.parse(text)
	var value = obj?[key]
	if value == null then
		return ""
	end
	return string(value)
end

func json_int(string text, string key) as int
	var obj = json.parse(text)
	var value = obj?[key]
	if value == null then
		return 0
	end
	return int(value)
end

func find_by_automation_id(Element root, Locator loc) as Element
	if loc.control_type > 0 then
		auto id_cond = x.uia.by_automation_id(loc.automation_id)
		auto type_cond = x.uia.by_control_type(loc.control_type)
		auto cond = x.uia.all_of(id_cond, type_cond)
		return root.find_first_scope(cond, 4, loc.timeout_ms)
	end
	auto cond = x.uia.by_automation_id(loc.automation_id)
	return root.find_first_scope(cond, 4, loc.timeout_ms)
end

func find_by_class_name(Element root, Locator loc) as Element
	auto class_cond = x.uia.by_class_name(loc.class_name)
	if loc.name != "" then
		auto name_cond = x.uia.by_name(loc.name)
		auto first = x.uia.all_of(class_cond, name_cond)
		if loc.control_type > 0 then
			auto type_cond = x.uia.by_control_type(loc.control_type)
			auto cond = x.uia.all_of(first, type_cond)
			return root.find_first_scope(cond, 4, loc.timeout_ms)
		end
		return root.find_first_scope(first, 4, loc.timeout_ms)
	end
	if loc.control_type > 0 then
		auto type_cond = x.uia.by_control_type(loc.control_type)
		auto cond = x.uia.all_of(class_cond, type_cond)
		return root.find_first_scope(cond, 4, loc.timeout_ms)
	end
	return root.find_first_scope(class_cond, 4, loc.timeout_ms)
end

func find_by_name(Element root, Locator loc) as Element
	if loc.control_type > 0 then
		auto name_cond = x.uia.by_name(loc.name)
		auto type_cond = x.uia.by_control_type(loc.control_type)
		auto cond = x.uia.all_of(name_cond, type_cond)
		return root.find_first_scope(cond, 4, loc.timeout_ms)
	end
	auto cond = x.uia.by_name(loc.name)
	return root.find_first_scope(cond, 4, loc.timeout_ms)
end

func find_by_control_type(Element root, Locator loc) as Element
	auto cond = x.uia.by_control_type(loc.control_type)
	return root.find_first_scope(cond, 4, loc.timeout_ms)
end

func find_by_process_id(Element root, Locator loc) as Element
	auto cond = x.uia.by_process_id(loc.process_id)
	return root.find_first_scope(cond, 4, loc.timeout_ms)
end

func find_in_root(Element root, Locator loc) as Element
	if loc.automation_id != "" then
		return find_by_automation_id(root, loc)
	end
	if loc.class_name != "" then
		return find_by_class_name(root, loc)
	end
	if loc.name != "" then
		return find_by_name(root, loc)
	end
	if loc.control_type > 0 then
		return find_by_control_type(root, loc)
	end
	if loc.process_id > 0 then
		return find_by_process_id(root, loc)
	end
	point emptyHandle
	return x.uia.element(emptyHandle)
end

func wait_exists_in_root(Element root, Locator loc) as bool
	auto element = find_in_root(root, loc)
	return element.valid()
end

func click_in_root(Element root, Locator loc) as bool
	auto element = find_in_root(root, loc)
	if element.valid() == false then
		return false
	end
	return element.click()
end

func type_text_in_root(Element root, Locator loc, string text) as bool
	auto element = find_in_root(root, loc)
	if element.valid() == false then
		return false
	end
	return element.set_value(text)
end

func read_in_root(Element root, Locator loc) as string
	auto element = find_in_root(root, loc)
	if element.valid() == false then
		return ""
	end
	return element.text()
end

func screenshot_in_root(Element root, Locator loc, string path) as bool
	auto element = find_in_root(root, loc)
	if element.valid() == false then
		return false
	end
	auto rect = element.rect_json()
	auto left = json_int(rect, "left")
	auto top = json_int(rect, "top")
	auto width = json_int(rect, "width")
	auto height = json_int(rect, "height")
	auto hwnd = element.hwnd()
	if hwnd != null then
		auto window_image = opencv.capture_window(hwnd)
		if window_image.empty() == false then
			return window_image.save(path)
		end
	end
	auto image = opencv.capture_rect(left, top, width, height)
	if image.empty() then
		return false
	end
	return image.save(path)
end
