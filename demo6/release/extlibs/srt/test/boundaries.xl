import srt

func main(...) as int
    var cues = srt.parse("1\r\n00:00:01,000 --> 00:00:02,000\r\n你好\r\n\r\n")
    assert cues.length == 1, "CRLF cue count"
    assert cues[0]["lines"][0] == "你好", "UTF-8 body"

    string first = srt.build(cues)
    var web = srt.parseVtt("WEBVTT\n\nopening\n00:00:00.500 --> 00:00:01.500 align:start\nHi\n\n")
    assert web[0]["id"] == "opening", "VTT identifier"
    assert web[0]["settings"] == "align:start", "VTT settings"
    string second = srt.buildVtt(web)
    assert first.contains("你好"), "independent SRT result"
    assert second.contains("align:start"), "VTT settings round trip"
    assert srt.parseVtt(second)[0]["id"] == "opening", "VTT id round trip"
    assert srt.parseTime("00:02.500") == 2500, "VTT minute timestamp"
    assert srt.parseTime("2562047788015:00:00,000") == 9223372036854000000, "int64 timestamp bound"
    var noted = srt.parseVtt("WEBVTT\n\nNOTE\tcomment\nskipped\n\n00:00.000 --> 00:01.000\nVisible\n")
    assert noted.length == 1, "tab-prefixed VTT note skipped"
    var styled = srt.parseVtt("WEBVTT\n\nSTYLE\n::cue { color: white }\n\nREGION\nid:main\n\n00:00.000 --> 00:01.000\nVisible\n\nNOTE after cue\ncomment\n")
    assert styled.length == 1, "layout blocks before cue and note after cue"
    assert srt.parseVtt("WEBVTT\n\n00:00.000\t-->\t00:01.000\nHi\n").length == 1, "tab-separated VTT arrow"
    assert srt.parse("1\n00:00:00,000-->00:00:01,000\nHi\n").length == 1, "SRT arrow spacing remains lenient"

    int badArrowSpacing = 0
    try
        srt.parseVtt("WEBVTT\n\n00:00.000--> 00:01.000\nHi\n")
    catch e
        badArrowSpacing = 1
    end
    assert badArrowSpacing == 1, "VTT arrow requires preceding whitespace"
    badArrowSpacing = 0
    try
        srt.parseVtt("WEBVTT\n\n00:00.000 -->00:01.000\nHi\n")
    catch e
        badArrowSpacing = 1
    end
    assert badArrowSpacing == 1, "VTT arrow requires following whitespace"

    int badPayload = 0
    try
        srt.parseVtt("WEBVTT\n\n00:00.000 --> 00:01.000\nHi --> there\n")
    catch e
        badPayload = 1
    end
    assert badPayload == 1, "VTT payload arrow rejected"
    int zeroDuration = 0
    try
        srt.parseVtt("WEBVTT\n\n00:01.000 --> 00:01.000\nZero duration\n")
    catch e
        zeroDuration = 1
    end
    assert zeroDuration == 1, "VTT cue end must follow start"
    zeroDuration = 0
    try
        srt.buildVtt([{"startMs": 1000, "endMs": 1000, "lines": ["Zero duration"]}])
    catch e
        zeroDuration = 1
    end
    assert zeroDuration == 1, "VTT builder rejects zero duration"
    assert srt.parse("1\n00:00:01,000 --> 00:00:01,000\nZero duration\n").length == 1, "SRT zero duration remains accepted"
    badPayload = 0
    try
        srt.parseVtt("WEBVTT\n\nNOTE bad --> note\nignored\n\n00:00.000 --> 00:01.000\nVisible\n")
    catch e
        badPayload = 1
    end
    assert badPayload == 1, "VTT note arrow rejected"
    badPayload = 0
    try
        srt.parseVtt("WEBVTT\n\n00:00.000 --> 00:01.000\nVisible\n\nNOTE after cue\nignored --> text\n")
    catch e
        badPayload = 1
    end
    assert badPayload == 1, "VTT trailing note arrow rejected"
    badPayload = 0
    try
        srt.parseVtt("WEBVTT\n\nSTYLE\n::cue { content: '-->'; }\n\n00:00.000 --> 00:01.000\nVisible\n")
    catch e
        badPayload = 1
    end
    assert badPayload == 1, "VTT style arrow rejected"
    badPayload = 0
    try
        srt.parseVtt("WEBVTT\n\nREGION\nid:bad-->region\n\n00:00.000 --> 00:01.000\nVisible\n")
    catch e
        badPayload = 1
    end
    assert badPayload == 1, "VTT region arrow rejected"
    badPayload = 0
    try
        srt.parseVtt("WEBVTT\n\n00:00.000 --> 00:01.000\nVisible\n\nREGION\nid:late\n")
    catch e
        badPayload = 1
    end
    assert badPayload == 1, "VTT region after cue rejected"
    badPayload = 0
    try
        srt.parseVtt("WEBVTT\n\n00:00.000 --> 00:01.000\nHi\n\nSTYLE\n::cue { color: white }\n")
    catch e
        badPayload = 1
    end
    assert badPayload == 1, "VTT style after first cue rejected"
    badPayload = 0
    try
        srt.buildVtt([{"startMs": 0, "endMs": 1000, "lines": ["Hi --> there"]}])
    catch e
        badPayload = 1
    end
    assert badPayload == 1, "VTT builder rejects payload arrow"
    badPayload = 0
    try
        srt.parseVtt("WEBVTT\n\n00:02.000 --> 00:03.000\nLater\n\n00:01.000 --> 00:02.000\nEarlier\n")
    catch e
        badPayload = 1
    end
    assert badPayload == 1, "VTT cue start must not move backward"
    badPayload = 0
    try
        srt.parseVtt("WEBVTT\n\nrepeat\n00:00.000 --> 00:01.000\nA\n\nrepeat\n00:01.000 --> 00:02.000\nB\n")
    catch e
        badPayload = 1
    end
    assert badPayload == 1, "VTT cue identifiers must be unique"
    badPayload = 0
    try
        srt.buildVtt([{"id": "first", "startMs": 1000, "endMs": 2000, "lines": ["A"]}, {"id": "second", "startMs": 0, "endMs": 3000, "lines": ["B"]}])
    catch e
        badPayload = 1
    end
    assert badPayload == 1, "VTT builder rejects decreasing start"
    badPayload = 0
    try
        srt.buildVtt([{"id": "repeat", "startMs": 0, "endMs": 1000, "lines": ["A"]}, {"id": "repeat", "startMs": 1000, "endMs": 2000, "lines": ["B"]}])
    catch e
        badPayload = 1
    end
    assert badPayload == 1, "VTT builder rejects duplicate identifiers"
    assert srt.parseVtt("WEBVTT\n\n00:01.000 --> 00:02.000\nA\n\n00:01.000 --> 00:03.000\nB\n").length == 2, "equal start times remain valid"
    var srtArrow = srt.parse("1\n00:00:00,000 --> 00:00:01,000\nHi --> there\n")
    assert srt.build(srtArrow).contains("Hi --> there"), "SRT payload arrow preserved"

    int malformedSettings = 0
    try
        srt.parseVtt("WEBVTT\n\n00:00.000 --> 00:01.000 align:start --> hidden\nVisible\n")
    catch e
        malformedSettings = 1
    end
    assert malformedSettings == 1, "second VTT arrow in settings rejected"

    int raised = 0
    try
        srt.parse("1\n00:00:01,1234 --> 00:00:02,000\nBad\n")
    catch e
        raised = 1
    end
    assert raised == 1, "four-digit milliseconds rejected"
    raised = 0
    try
        srt.build([{"startMs": 2000, "endMs": 1000, "lines": ["Bad"]}])
    catch e
        raised = 1
    end
    assert raised == 1, "reversed build range rejected"
    raised = 0
    try
        srt.buildVtt([{"id": "NOTE", "startMs": 0, "endMs": 1000, "lines": ["Bad"]}])
    catch e
        raised = 1
    end
    assert raised == 1, "VTT control-block identifier rejected"
    raised = 0
    try
        srt.formatTime(-1)
    catch e
        raised = 1
    end
    assert raised == 1, "negative format rejected"
    raised = 0
    try
        srt.parse("1\n00:00:01,000 --> 00:00:02,000\nGood\n\0hidden")
    catch e
        raised = 1
    end
    assert raised == 1, "embedded NUL rejected"
    raised = 0
    try
        srt.parse("1\n00:00:00,000 --> 00:00:01,000\nline\rbroken\n")
    catch e
        raised = 1
    end
    assert raised == 1, "bare carriage return rejected"
    raised = 0
    try
        srt.parseVtt("WEBVTT\n\n00:00.000 --> 00:01.000\nline\r")
    catch e
        raised = 1
    end
    assert raised == 1, "VTT trailing bare carriage return rejected"
    return 0
end
