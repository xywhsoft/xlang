import hyperloglog

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

int failures = 0
int successes = 0
for allocation in range(16)
    bool caught = false
    assert failAfter(uint64(allocation))
    try
        hyperloglog.HyperLogLog sketch = hyperloglog.create(8)
        assert sketch.valid
        assert sketch.count() == 0
    catch MemoryError
        caught = true
    end
    bool triggered = failTriggered()
    failClear()
    assert caught == triggered
    if caught then failures += 1 else successes += 1 end
end
assert failures > 0 and successes > 0

hyperloglog.HyperLogLog recovered = hyperloglog.create(8)
recovered.add("after failure")
assert recovered.added == 1
println("hyperloglog allocations: PASS")
