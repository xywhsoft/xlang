import volc.core

export func available() as bool
    return string.len(volc.core.version()) > 0
end

export func version() as string
    return "0.1.0"
end

export func last_error() as string
    return volc.core.last_error()
end

export func assume_role_spec(string spec) as string
    return volc.core.request_sts_spec(spec)
end

export func preview_assume_role_spec(string spec) as string
    return volc.core.sign_preview_sts_spec(spec)
end

export func assume_role_trn(string access_key, string secret_key, string role_trn, string role_session_name, int duration_seconds, int timeout_ms) as string
    auto spec = "access_key=" + access_key + "\nsecret_key=" + secret_key + "\nrole_trn=" + role_trn + "\nrole_session_name=" + role_session_name + "\nduration_seconds=" + string.format(duration_seconds, "") + "\ntimeout_ms=" + string.format(timeout_ms, "")
    return volc.core.request_sts_spec(spec)
end

export func assume_role(string access_key, string secret_key, string account_id, string role_name, string role_session_name, int duration_seconds, int timeout_ms) as string
    auto role_trn = "trn:iam::" + account_id + ":role/" + role_name
    return assume_role_trn(access_key, secret_key, role_trn, role_session_name, duration_seconds, timeout_ms)
end

export func preview_assume_role(string access_key, string secret_key, string account_id, string role_name, string role_session_name, int duration_seconds, string x_date) as string
    auto role_trn = "trn:iam::" + account_id + ":role/" + role_name
    auto spec = "access_key=" + access_key + "\nsecret_key=" + secret_key + "\nrole_trn=" + role_trn + "\nrole_session_name=" + role_session_name + "\nduration_seconds=" + string.format(duration_seconds, "") + "\nx_date=" + x_date
    return volc.core.sign_preview_sts_spec(spec)
end

export func json_string_field(string raw, string key) as string
    auto pattern = "\"" + key + "\":\""
    var parts = string.split(raw, pattern)
    if parts.length < 2 then
        pattern = "\"" + key + "\": \""
        parts = string.split(raw, pattern)
    end
    if parts.length < 2 then
        return ""
    end
    var tail_parts = string.split(string(parts[1]), "\"")
    if tail_parts.length < 1 then
        return ""
    end
    return string(tail_parts[0])
end

export func access_key_id(string assume_role_json) as string
    return json_string_field(assume_role_json, "AccessKeyId")
end

export func secret_access_key(string assume_role_json) as string
    return json_string_field(assume_role_json, "SecretAccessKey")
end

export func session_token(string assume_role_json) as string
    return json_string_field(assume_role_json, "SessionToken")
end

export func expired_time(string assume_role_json) as string
    return json_string_field(assume_role_json, "ExpiredTime")
end

export func current_time(string assume_role_json) as string
    return json_string_field(assume_role_json, "CurrentTime")
end

export func credentials_json(string assume_role_json) as string
    return json.stringify({
        "access_key": access_key_id(assume_role_json),
        "secret_key": secret_access_key(assume_role_json),
        "session_token": session_token(assume_role_json),
        "expired_time": expired_time(assume_role_json),
        "current_time": current_time(assume_role_json)
    })
end

export func projection_credentials_json(string assume_role_json, string product_id, string pod_id) as string
    return json.stringify({
        "access_key": access_key_id(assume_role_json),
        "secret_key": secret_access_key(assume_role_json),
        "session_token": session_token(assume_role_json),
        "expired_time": expired_time(assume_role_json),
        "current_time": current_time(assume_role_json),
        "product_id": product_id,
        "pod_id": pod_id
    })
end
