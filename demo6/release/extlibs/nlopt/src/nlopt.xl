extern "xnlopt_algo_name" func __nlo_aname(int algo) as string
extern "xnlopt_is_global" func __nlo_iglob(int algo) as int
extern "xnlopt_is_local" func __nlo_iloc(int algo) as int
extern "xnlopt_uses_gradient" func __nlo_ugrad(int algo) as int
extern "xnlopt_result_name" func __nlo_rname(int result) as string
extern "xnlopt_is_success" func __nlo_isucc(int result) as int
extern "xnlopt_is_failure" func __nlo_ifail(int result) as int
extern "xnlopt_rosenbrock" func __nlo_rosen(float x, float y) as float
extern "xnlopt_sphere" func __nlo_sphere(float x, float y) as float
extern "xnlopt_rastrigin" func __nlo_rast(float x, float y) as float
extern "xnlopt_grad_step" func __nlo_gstep(float x, float grad, float lr) as float
extern "xnlopt_line_search" func __nlo_lsearch(float f0, float grad, float alpha, float c) as float
extern "xnlopt_default_maxeval" func __nlo_maxeval() as int
extern "xnlopt_default_ftol" func __nlo_ftol() as float
extern "xnlopt_default_xtol" func __nlo_xtol() as float
extern "xnlopt_version_major" func __nlo_vmaj() as int
extern "xnlopt_version_minor" func __nlo_vmin() as int

export func algoName(int algo) as string
    return __nlo_aname(algo)
end

export func isGlobal(int algo) as int
    return __nlo_iglob(algo)
end

export func isLocal(int algo) as int
    return __nlo_iloc(algo)
end

export func usesGradient(int algo) as int
    return __nlo_ugrad(algo)
end

export func resultName(int result) as string
    return __nlo_rname(result)
end

export func isSuccess(int result) as int
    return __nlo_isucc(result)
end

export func isFailure(int result) as int
    return __nlo_ifail(result)
end

export func rosenbrock(float x, float y) as float
    return __nlo_rosen(x, y)
end

export func sphere(float x, float y) as float
    return __nlo_sphere(x, y)
end

export func rastrigin(float x, float y) as float
    return __nlo_rast(x, y)
end

export func gradStep(float x, float grad, float learning_rate) as float
    return __nlo_gstep(x, grad, learning_rate)
end

export func lineSearch(float f0, float grad, float alpha, float c) as float
    return __nlo_lsearch(f0, grad, alpha, c)
end

export func defaultMaxEval() as int
    return __nlo_maxeval()
end

export func defaultFtol() as float
    return __nlo_ftol()
end

export func defaultXtol() as float
    return __nlo_xtol()
end

export func versionMajor() as int
    return __nlo_vmaj()
end

export func versionMinor() as int
    return __nlo_vmin()
end
