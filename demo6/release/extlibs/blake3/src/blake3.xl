// blake3 — BLAKE3 高性能哈希（支持哈希/MAC/KDF 三模式），Buffer/string/文件/流式。
extern "xl6_xrt_last_error_text" func __blake3_error() as string
extern "xblake3_version" func __blake3_version() as string
extern "xblake3_hash_hex" func __blake3_hash_hex(point data, c_size size, c_size outLen) as string
extern "xblake3_hash_str_hex" func __blake3_hash_str(string data, c_size size, c_size outLen) as string
extern "xblake3_hash_bytes" func __blake3_hash_bytes(point data, c_size size, c_size outLen) as point
extern "xblake3_hash_str_bytes" func __blake3_hash_str_bytes(string data, c_size size, c_size outLen) as point
extern "xblake3_hash_mac_hex" func __blake3_hash_mac_hex(point data, c_size size, point key, c_size keyLen, c_size outLen) as string
extern "xblake3_hash_mac_str_hex" func __blake3_hash_mac_str(string data, c_size size, string key, c_size keyLen, c_size outLen) as string
extern "xblake3_hash_kdf_hex" func __blake3_hash_kdf_hex(point keyMat, c_size keyMatLen, string context, c_size outLen) as string
extern "xblake3_hash_kdf_str_hex" func __blake3_hash_kdf_str(string keyMat, c_size keyMatLen, string context, c_size outLen) as string
extern "xblake3_file_hex" func __blake3_file_hex(string path, c_ulonglong maxInput, c_size outLen, var onProgress) as string
extern "xblake3_file_status" func __blake3_file_status() as c_int



// 默认输出长度（字节）。
export const int BLAKE3_OUT_LEN = 32
export const int BLAKE3_KEY_LEN = 32



// 返回内嵌 BLAKE3 引擎的版本号。
export func version() as string
    return __blake3_version()
end

func __blake3_check_limit(int value, string name)
    if value <= 0 then
        throw ValueError name + " must be greater than zero"
    end
end





// 一次性 BLAKE3 哈希（返回十六进制小写字符串，默认 32 字节 = 64 hex 字符）。
export func hashHex(Buffer data, int outLen = BLAKE3_OUT_LEN) as string
    string result = __blake3_hash_hex(data.data(), c_size(data.len()), c_size(outLen))
    if result == "" then
        throw ValueError __blake3_error()
    end
    return result
end

export func hashHex(string text, int outLen = BLAKE3_OUT_LEN) as string
    string result = __blake3_hash_str(text, c_size(string.len(text)), c_size(outLen))
    if result == "" then
        throw ValueError __blake3_error()
    end
    return result
end

// 一次性 BLAKE3 哈希（返回原始字节 Buffer，默认 32 字节）。
export func hashBytes(Buffer data, int outLen = BLAKE3_OUT_LEN) as Buffer
    point result = __blake3_hash_bytes(data.data(), c_size(data.len()), c_size(outLen))
    if result == null then
        throw ValueError __blake3_error()
    end
    return Buffer(result)
end

export func hashBytes(string text, int outLen = BLAKE3_OUT_LEN) as Buffer
    point result = __blake3_hash_str_bytes(text, c_size(string.len(text)), c_size(outLen))
    if result == null then
        throw ValueError __blake3_error()
    end
    return Buffer(result)
end

// MAC 模式（keyed hash，BLAKE3 原生支持，无需 HMAC 包装）。
export func hashMacHex(Buffer data, Buffer key, int outLen = BLAKE3_OUT_LEN) as string
    string result = __blake3_hash_mac_hex(data.data(), c_size(data.len()),
        key.data(), c_size(key.len()), c_size(outLen))
    if result == "" then
        throw ValueError __blake3_error()
    end
    return result
end

export func hashMacHex(string text, string key, int outLen = BLAKE3_OUT_LEN) as string
    string result = __blake3_hash_mac_str(text, c_size(string.len(text)),
        key, c_size(string.len(key)), c_size(outLen))
    if result == "" then
        throw ValueError __blake3_error()
    end
    return result
end

// KDF 模式（密钥派生）。
export func hashKdfHex(Buffer keyMaterial, string context, int outLen = BLAKE3_OUT_LEN) as string
    string result = __blake3_hash_kdf_hex(keyMaterial.data(), c_size(keyMaterial.len()),
        context, c_size(outLen))
    if result == "" then
        throw ValueError __blake3_error()
    end
    return result
end

export func hashKdfHex(string keyMaterial, string context, int outLen = BLAKE3_OUT_LEN) as string
    string result = __blake3_hash_kdf_str(keyMaterial, c_size(string.len(keyMaterial)),
        context, c_size(outLen))
    if result == "" then
        throw ValueError __blake3_error()
    end
    return result
end



// 文件 BLAKE3 哈希。
export func hashFileHex(string path, int maxInput = 268435456,
    int outLen = BLAKE3_OUT_LEN,
    (func(int, int, int) as bool)? onProgress = null) as string
    __blake3_check_limit(maxInput, "maxInput")
    var progress = null
    if onProgress != null then
        progress = xcall(onProgress)
    end
    string result = __blake3_file_hex(path, c_ulonglong(maxInput), c_size(outLen), progress)
    int status = __blake3_file_status()
    if status == -1 then
        throw CancelledError "blake3 operation cancelled"
    elseif status != 1 then
        throw FileError __blake3_error()
    end
    return result
end



// 增量流式哈希器。
export class Blake3Hasher
    native point handle
    extern "xblake3_hasher_create" create(c_ulonglong maxInput)
    extern "xblake3_hasher_adopt" create(point handle)
    extern "xblake3_hasher_destroy" destroy()
    extern "xblake3_hasher_update" func updateNative(point data, c_size size) as bool
    extern "xblake3_hasher_update_str" func updateStrNative(string data, c_size size) as bool
    extern "xblake3_hasher_digest_hex" func digestHexNative(c_size outLen) as string
    extern "xblake3_hasher_digest_bytes" func digestBytesNative(c_size outLen) as point
    extern "xblake3_hasher_reset" func resetNative() as bool
    extern "xblake3_hasher_input_bytes" func inputBytesNative() as int
    extern "xblake3_hasher_clone" func cloneNative() as point

    get valid() as bool
        return self.handle != null
    end

    get inputBytes() as int
        return self.inputBytesNative()
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw ValueError __blake3_error()
        end
    end

    func update(string text)
        if not self.updateStrNative(text, c_size(string.len(text))) then
            throw ValueError __blake3_error()
        end
    end

    func digestHex(int outLen = BLAKE3_OUT_LEN) as string
        string result = self.digestHexNative(c_size(outLen))
        if result == "" then
            throw ValueError __blake3_error()
        end
        return result
    end

    // 读取当前摘要（原始 Buffer，不终结状态）。
    func digestBytes(int outLen = BLAKE3_OUT_LEN) as Buffer
        point result = self.digestBytesNative(c_size(outLen))
        if result == null then
            throw ValueError __blake3_error()
        end
        return Buffer(result)
    end

    func reset() as bool
        if not self.resetNative() then
            throw ValueError __blake3_error()
        end
        return true
    end

    func clone() as Blake3Hasher
        point hp = self.cloneNative()
        if hp == null then
            throw ValueError __blake3_error()
        end
        return Blake3Hasher(hp)
    end
end

// Keyed 流式哈希器（MAC 模式）。
export class Blake3KeyedHasher
    native point handle
    extern "xblake3_hasher_create_keyed" create(point key, c_size keyLen, c_ulonglong maxInput)
    extern "xblake3_hasher_adopt" create(point handle)
    extern "xblake3_hasher_destroy" destroy()
    extern "xblake3_hasher_update" func updateNative(point data, c_size size) as bool
    extern "xblake3_hasher_update_str" func updateStrNative(string data, c_size size) as bool
    extern "xblake3_hasher_digest_hex" func digestHexNative(c_size outLen) as string
    extern "xblake3_hasher_digest_bytes" func digestBytesNative(c_size outLen) as point
    extern "xblake3_hasher_reset" func resetNative() as bool
    extern "xblake3_hasher_input_bytes" func inputBytesNative() as int
    extern "xblake3_hasher_clone" func cloneNative() as point

    get valid() as bool
        return self.handle != null
    end

    get inputBytes() as int
        return self.inputBytesNative()
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw ValueError __blake3_error()
        end
    end

    func update(string text)
        if not self.updateStrNative(text, c_size(string.len(text))) then
            throw ValueError __blake3_error()
        end
    end

    func digestHex(int outLen = BLAKE3_OUT_LEN) as string
        string result = self.digestHexNative(c_size(outLen))
        if result == "" then
            throw ValueError __blake3_error()
        end
        return result
    end

    // 读取当前摘要（原始 Buffer，不终结状态）。
    func digestBytes(int outLen = BLAKE3_OUT_LEN) as Buffer
        point result = self.digestBytesNative(c_size(outLen))
        if result == null then
            throw ValueError __blake3_error()
        end
        return Buffer(result)
    end

    func reset() as bool
        if not self.resetNative() then
            throw ValueError __blake3_error()
        end
        return true
    end

    func clone() as Blake3KeyedHasher
        point hp = self.cloneNative()
        if hp == null then
            throw ValueError __blake3_error()
        end
        return Blake3KeyedHasher(hp)
    end
end



// 工厂函数。
export func hasher(int maxInput = 268435456) as Blake3Hasher
    __blake3_check_limit(maxInput, "maxInput")
    Blake3Hasher result = Blake3Hasher(c_ulonglong(maxInput))
    if not result.valid then
        throw ValueError __blake3_error()
    end
    return result
end

export func keyedHasher(Buffer key, int maxInput = 268435456) as Blake3KeyedHasher
    __blake3_check_limit(maxInput, "maxInput")
    Blake3KeyedHasher result = Blake3KeyedHasher(key.data(), c_size(key.len()), c_ulonglong(maxInput))
    if not result.valid then
        throw ValueError __blake3_error()
    end
    return result
end
