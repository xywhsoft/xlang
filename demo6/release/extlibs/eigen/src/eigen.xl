extern "xeigen_matrix_type" func __matrix_type(int id) as string
extern "xeigen_decomposition" func __decomposition(int id) as string
extern "xeigen_storage_order" func __storage_order(int id) as string
extern "xeigen_inverse2x2" func __inverse2x2(string mat) as string
extern "xeigen_multiply2x2" func __multiply2x2(string a, string b) as string
extern "xeigen_transpose2x2" func __transpose2x2(string mat) as string
extern "xeigen_solver_type" func __solver_type(int id) as string

export func matrixType(int id) as string
    return __matrix_type(id)
end

export func decomposition(int id) as string
    return __decomposition(id)
end

export func storageOrder(int id) as string
    return __storage_order(id)
end

export func inverse2x2(string mat) as string
    return __inverse2x2(mat)
end

export func multiply2x2(string a, string b) as string
    return __multiply2x2(a, b)
end

export func transpose2x2(string mat) as string
    return __transpose2x2(mat)
end

export func solverType(int id) as string
    return __solver_type(id)
end
