// snappy 的压缩结果和输入统使用 Buffer，避免二进制数据经过字符串转换。
extern "xrtGetError" func __snappy_error() as string
extern "xsnappy_version" func __snappy_version() as string
extern "xsnappy_compress" func __snappy_compress(point data, c_size size,
    c_ulonglong maxInput, c_ulonglong maxOutput) as point
extern "xsnappy_compress_str" func __snappy_compress_str(string data, c_size size,
    c_ulonglong maxInput, c_ulonglong maxOutput) as point
extern "xsnappy_decompress" func __snappy_decompress(point data, c_size size,
    c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio) as point
extern "xsnappy_compress_file" func __snappy_compress_file(string source, string destination,
    c_bool overwrite, c_ulonglong maxInput, c_ulonglong maxOutput) as bool
extern "xsnappy_decompress_file" func __snappy_decompress_file(string source, string destination,
    c_bool overwrite, c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio) as bool



func __snappy_check_limit(int value, string name)
    if value <= 0 then
        throw ValueError name + " must be greater than zero"
    end
end



// 返回内嵌 snappy 编解码器的版本号（格式兼容 Google Snappy）。
export func version() as string
    return __snappy_version()
end



export func compress(Buffer data, int maxInput = 268435456,
    int maxOutput = 536870912) as Buffer
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    point result = __snappy_compress(data.data(), c_size(data.len()),
        c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if result == null then
        throw CompressionError __snappy_error()
    end
    return Buffer(result)
end

export func compress(string text, int maxInput = 268435456,
    int maxOutput = 536870912) as Buffer
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    point result = __snappy_compress_str(text, c_size(string.len(text)),
        c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if result == null then
        throw CompressionError __snappy_error()
    end
    return Buffer(result)
end

export func decompress(Buffer data, int maxInput = 268435456,
    int maxOutput = 536870912, int maxRatio = 1000) as Buffer
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    __snappy_check_limit(maxRatio, "maxRatio")
    point result = __snappy_decompress(data.data(), c_size(data.len()),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), c_uint(maxRatio))
    if result == null then
        throw CompressionError __snappy_error()
    end
    return Buffer(result)
end

export func decompressText(Buffer data, int maxInput = 268435456,
    int maxOutput = 536870912, int maxRatio = 1000) as string
    return decompress(data, maxInput, maxOutput, maxRatio).text()
end

export func compressFile(string source, string destination, bool overwrite = true,
    int maxInput = 268435456, int maxOutput = 536870912)
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    if not __snappy_compress_file(source, destination, c_bool(overwrite),
        c_ulonglong(maxInput), c_ulonglong(maxOutput)) then
        throw CompressionError __snappy_error()
    end
end

export func decompressFile(string source, string destination, bool overwrite = true,
    int maxInput = 268435456, int maxOutput = 536870912, int maxRatio = 1000)
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    __snappy_check_limit(maxRatio, "maxRatio")
    if not __snappy_decompress_file(source, destination, c_bool(overwrite),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), c_uint(maxRatio)) then
        throw CompressionError __snappy_error()
    end
end



// 增量流式压缩器：update() 喂入数据，drain() 随时取走已产出的压缩字节，
// finish() 封存流。配合 inputBytes/outputBytes 可自行驱动进度回显。
export class SnappyCompressor
    native point handle
    extern "xsnappy_compressor_create" create(c_ulonglong maxInput, c_ulonglong maxOutput)
    extern "xsnappy_compressor_destroy" destroy()
    extern "xsnappy_compressor_update" func updateNative(point data, c_size size) as bool
    extern "xsnappy_compressor_update_str" func updateStrNative(string data, c_size size) as bool
    extern "xsnappy_compressor_finish" func finishNative() as bool
    extern "xsnappy_compressor_drain" func drainNative() as point
    extern "xsnappy_compressor_input_bytes" func inputBytesNative() as int
    extern "xsnappy_compressor_output_bytes" func outputBytesNative() as int

    get valid() as bool
        return self.handle != null
    end

    // 已喂入的原始字节数（进度回显用）。
    get inputBytes() as int
        return self.inputBytesNative()
    end

    // 已产出的压缩字节数（进度回显用）。
    get outputBytes() as int
        return self.outputBytesNative()
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw CompressionError __snappy_error()
        end
    end

    func update(string text)
        if not self.updateStrNative(text, c_size(string.len(text))) then
            throw CompressionError __snappy_error()
        end
    end

    // 取走当前已产出的压缩字节并清空内部输出缓冲；无数据时返回空 Buffer。
    func drain() as Buffer
        point result = self.drainNative()
        if result == null then
            throw CompressionError __snappy_error()
        end
        return Buffer(result)
    end

    // 封存压缩流（写入成员结束标记）。返回后 drain() 可取走最后的压缩字节。
    func finish() as bool
        if not self.finishNative() then
            throw CompressionError __snappy_error()
        end
        return true
    end
end



// 增量流式解压器：update() 喂入压缩字节，drain() 随时取走已解压数据，
// finished 反映当前成员是否结束，members 统计已完整解出的成员数（支持串联多成员流）。
export class SnappyDecompressor
    native point handle
    extern "xsnappy_decompressor_create" create(c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio)
    extern "xsnappy_decompressor_destroy" destroy()
    extern "xsnappy_decompressor_update" func updateNative(point data, c_size size) as bool
    extern "xsnappy_decompressor_finish" func finishNative() as bool
    extern "xsnappy_decompressor_drain" func drainNative() as point
    extern "xsnappy_decompressor_input_bytes" func inputBytesNative() as int
    extern "xsnappy_decompressor_output_bytes" func outputBytesNative() as int
    extern "xsnappy_decompressor_finished" func finishedNative() as bool
    extern "xsnappy_decompressor_members" func membersNative() as int

    get valid() as bool
        return self.handle != null
    end

    // 已喂入的压缩字节数（进度回显用）。
    get inputBytes() as int
        return self.inputBytesNative()
    end

    // 已产出的解压字节数（进度回显用）。
    get outputBytes() as int
        return self.outputBytesNative()
    end

    // 当前成员是否已完整解出（流结束时为 true）。
    get finished() as bool
        return self.finishedNative()
    end

    // 已完整解出的成员数；大于 1 表示输入是串联的多成员 snappy 流。
    get members() as int
        return self.membersNative()
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw CompressionError __snappy_error()
        end
    end

    // 取走当前已解压的数据并清空内部输出缓冲；无数据时返回空 Buffer。
    func drain() as Buffer
        point result = self.drainNative()
        if result == null then
            throw CompressionError __snappy_error()
        end
        return Buffer(result)
    end

    // 校验流已完整结束；流被截断或为空时抛出 CompressionError。
    func finish() as bool
        if not self.finishNative() then
            throw CompressionError __snappy_error()
        end
        return true
    end
end



export func compressor(int maxInput = 268435456, int maxOutput = 536870912) as SnappyCompressor
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    SnappyCompressor result = SnappyCompressor(c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if not result.valid then
        throw CompressionError __snappy_error()
    end
    return result
end

export func decompressor(int maxInput = 268435456, int maxOutput = 536870912,
    int maxRatio = 1000) as SnappyDecompressor
    __snappy_check_limit(maxInput, "maxInput")
    __snappy_check_limit(maxOutput, "maxOutput")
    __snappy_check_limit(maxRatio, "maxRatio")
    SnappyDecompressor result = SnappyDecompressor(c_ulonglong(maxInput),
        c_ulonglong(maxOutput), c_uint(maxRatio))
    if not result.valid then
        throw CompressionError __snappy_error()
    end
    return result
end
