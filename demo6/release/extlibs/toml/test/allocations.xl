import toml

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

string source = "title = \"xlang\"\n[server]\nport = 8080\n"
var value = toml.parse(source)
int failures = 0
int successes = 0
string directory = dir.temp("", "xlang-toml-allocation-", "")
string inputPath = path.join(directory, "input.toml")
string outputPath = path.join(directory, "output.toml")

try
    assert file.writeText(inputPath, source)
    for operation in range(4)
        for allocation in range(32)
            bool memoryCaught = false
            bool wrongCaught = false
            assert failAfter(uint64(allocation))
            try
                if operation == 0 then
                    toml.parse(source)
                elseif operation == 1 then
                    toml.stringify(value)
                elseif operation == 2 then
                    toml.load(inputPath)
                else
                    toml.save(outputPath, value)
                end
            catch MemoryError error
                memoryCaught = true
            catch TomlError error
                wrongCaught = true
            catch ValueError error
                wrongCaught = true
            catch IOError error
                wrongCaught = true
            catch RuntimeError error
                wrongCaught = true
            end
            bool triggered = failTriggered()
            failClear()
            if wrongCaught or memoryCaught != triggered then
                println("operation=", operation, " allocation=", allocation,
                    " triggered=", triggered, " memory=", memoryCaught,
                    " wrong=", wrongCaught)
            end
            assert not wrongCaught and memoryCaught == triggered
            if triggered then failures += 1 else successes += 1 end
        end
    end

    assert failures > 0 and successes > 0
    string encoded = toml.stringify(value)
    var again = toml.parse(encoded)
    assert again["title"] == "xlang"
    assert again["server"]["port"] == 8080
    assert toml.load(inputPath)["title"] == "xlang"
    toml.save(outputPath, value)
    assert toml.load(outputPath)["server"]["port"] == 8080
finally
    failClear()
    assert dir.delete(directory)
end
println("toml allocation: PASS")
