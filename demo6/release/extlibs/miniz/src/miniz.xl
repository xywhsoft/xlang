// miniz 的压缩结果和输入统一使用 Buffer，避免二进制数据经过字符串转换。
extern "xl6_xrt_last_error_text" func __miniz_error() as string
extern "xminiz_version" func __miniz_version() as string
extern "xminiz_compress" func __miniz_compress(point data, c_size size, c_int level,
    c_ulonglong maxInput, c_ulonglong maxOutput) as point
extern "xminiz_compress_str" func __miniz_compress_str(string data, c_size size, c_int level,
    c_ulonglong maxInput, c_ulonglong maxOutput) as point
extern "xminiz_decompress" func __miniz_decompress(point data, c_size size,
    c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio) as point
extern "xminiz_compress_file" func __miniz_compress_file(string source, string destination,
    c_int level, c_bool overwrite, c_ulonglong maxInput, c_ulonglong maxOutput,
    var onProgress) as c_int
extern "xminiz_decompress_file" func __miniz_decompress_file(string source, string destination,
    c_bool overwrite, c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio,
    var onProgress) as c_int



// 压缩级别常量（miniz 调优维度：0 不压缩、9 最佳压缩、10 极限压缩，6 为默认平衡点）。
export const int MINIZ_MIN_LEVEL = 0
export const int MINIZ_MAX_LEVEL = 10
export const int MINIZ_DEFAULT_LEVEL = 6



// 返回内嵌 miniz 引擎的版本号。
export func version() as string
    return __miniz_version()
end

func __miniz_check_level(int level)
    if level < MINIZ_MIN_LEVEL or level > MINIZ_MAX_LEVEL then
        throw ValueError "miniz level must be 0..10"
    end
end

func __miniz_check_limit(int value, string name)
    if value <= 0 then
        throw ValueError name + " must be greater than zero"
    end
end

func __miniz_check_file_result(int status)
    if status == -1 then
        throw CancelledError "miniz operation cancelled"
    elseif status != 1 then
        throw CompressionError __miniz_error()
    end
end



export func compress(Buffer data, int level = MINIZ_DEFAULT_LEVEL,
    int maxInput = 268435456, int maxOutput = 536870912) as Buffer
    __miniz_check_level(level)
    __miniz_check_limit(maxInput, "maxInput")
    __miniz_check_limit(maxOutput, "maxOutput")
    point result = __miniz_compress(data.data(), c_size(data.len()), c_int(level),
        c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if result == null then
        throw CompressionError __miniz_error()
    end
    return Buffer(result)
end

export func compress(string text, int level = MINIZ_DEFAULT_LEVEL,
    int maxInput = 268435456, int maxOutput = 536870912) as Buffer
    __miniz_check_level(level)
    __miniz_check_limit(maxInput, "maxInput")
    __miniz_check_limit(maxOutput, "maxOutput")
    point result = __miniz_compress_str(text, c_size(string.len(text)), c_int(level),
        c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if result == null then
        throw CompressionError __miniz_error()
    end
    return Buffer(result)
end

export func decompress(Buffer data, int maxInput = 268435456,
    int maxOutput = 536870912, int maxRatio = 1000) as Buffer
    __miniz_check_limit(maxInput, "maxInput")
    __miniz_check_limit(maxOutput, "maxOutput")
    __miniz_check_limit(maxRatio, "maxRatio")
    point result = __miniz_decompress(data.data(), c_size(data.len()),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), c_uint(maxRatio))
    if result == null then
        throw CompressionError __miniz_error()
    end
    return Buffer(result)
end

export func decompressText(Buffer data, int maxInput = 268435456,
    int maxOutput = 536870912, int maxRatio = 1000) as string
    return decompress(data, maxInput, maxOutput, maxRatio).text()
end

export func compressFile(string source, string destination,
    int level = MINIZ_DEFAULT_LEVEL, bool overwrite = true,
    int maxInput = 268435456, int maxOutput = 536870912,
    (func(int, int, int) as bool)? onProgress = null)
    __miniz_check_level(level)
    __miniz_check_limit(maxInput, "maxInput")
    __miniz_check_limit(maxOutput, "maxOutput")
    var progress = null
    if onProgress != null then
        progress = xcall(onProgress)
    end
    int status = __miniz_compress_file(source, destination, c_int(level), c_bool(overwrite),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), progress)
    __miniz_check_file_result(status)
end

export func decompressFile(string source, string destination, bool overwrite = true,
    int maxInput = 268435456, int maxOutput = 536870912, int maxRatio = 1000,
    (func(int, int, int) as bool)? onProgress = null)
    __miniz_check_limit(maxInput, "maxInput")
    __miniz_check_limit(maxOutput, "maxOutput")
    __miniz_check_limit(maxRatio, "maxRatio")
    var progress = null
    if onProgress != null then
        progress = xcall(onProgress)
    end
    int status = __miniz_decompress_file(source, destination, c_bool(overwrite),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), c_uint(maxRatio), progress)
    __miniz_check_file_result(status)
end



// 增量流式压缩器：update() 喂入数据，drain() 随时取走已产出的压缩字节，
// finish() 封存流。配合 inputBytes/outputBytes 可自行驱动进度回显。
export class MinizCompressor
    native point handle
    extern "xminiz_compressor_create" create(c_int level, c_ulonglong maxInput, c_ulonglong maxOutput)
    extern "xminiz_compressor_destroy" destroy()
    extern "xminiz_compressor_update" func updateNative(point data, c_size size) as bool
    extern "xminiz_compressor_update_str" func updateStrNative(string data, c_size size) as bool
    extern "xminiz_compressor_finish" func finishNative() as bool
    extern "xminiz_compressor_drain" func drainNative() as point
    extern "xminiz_compressor_input_bytes" func inputBytesNative() as int
    extern "xminiz_compressor_output_bytes" func outputBytesNative() as int

    get valid() as bool
        return self.handle != null
    end

    // 已喂入的原始字节数（进度回显用）。
    get inputBytes() as int
        return self.inputBytesNative()
    end

    // 已产出的压缩字节数（进度回显用）。
    get outputBytes() as int
        return self.outputBytesNative()
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw CompressionError __miniz_error()
        end
    end

    func update(string text)
        if not self.updateStrNative(text, c_size(string.len(text))) then
            throw CompressionError __miniz_error()
        end
    end

    // 取走当前已产出的压缩字节并清空内部输出缓冲；无数据时返回空 Buffer。
    func drain() as Buffer
        point result = self.drainNative()
        if result == null then
            throw CompressionError __miniz_error()
        end
        return Buffer(result)
    end

    // 封存压缩流（写入成员结束标记）。返回后 drain() 可取走最后的压缩字节。
    func finish() as bool
        if not self.finishNative() then
            throw CompressionError __miniz_error()
        end
        return true
    end
end



// 增量流式解压器：update() 喂入压缩字节，drain() 随时取走已解压数据，
// finished 反映当前成员是否结束，members 统计已完整解出的成员数（支持串联多成员流）。
export class MinizDecompressor
    native point handle
    extern "xminiz_decompressor_create" create(c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio)
    extern "xminiz_decompressor_destroy" destroy()
    extern "xminiz_decompressor_update" func updateNative(point data, c_size size) as bool
    extern "xminiz_decompressor_finish" func finishNative() as bool
    extern "xminiz_decompressor_drain" func drainNative() as point
    extern "xminiz_decompressor_input_bytes" func inputBytesNative() as int
    extern "xminiz_decompressor_output_bytes" func outputBytesNative() as int
    extern "xminiz_decompressor_finished" func finishedNative() as bool
    extern "xminiz_decompressor_members" func membersNative() as int

    get valid() as bool
        return self.handle != null
    end

    // 已喂入的压缩字节数（进度回显用）。
    get inputBytes() as int
        return self.inputBytesNative()
    end

    // 已产出的解压字节数（进度回显用）。
    get outputBytes() as int
        return self.outputBytesNative()
    end

    // 当前成员是否已完整解出（流结束时为 true）。
    get finished() as bool
        return self.finishedNative()
    end

    // 已完整解出的成员数；大于 1 表示输入是串联的多成员 miniz 流。
    get members() as int
        return self.membersNative()
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw CompressionError __miniz_error()
        end
    end

    // 取走当前已解压的数据并清空内部输出缓冲；无数据时返回空 Buffer。
    func drain() as Buffer
        point result = self.drainNative()
        if result == null then
            throw CompressionError __miniz_error()
        end
        return Buffer(result)
    end

    // 校验流已完整结束；流被截断或为空时抛出 CompressionError。
    func finish() as bool
        if not self.finishNative() then
            throw CompressionError __miniz_error()
        end
        return true
    end
end



export func compressor(int level = MINIZ_DEFAULT_LEVEL,
    int maxInput = 268435456, int maxOutput = 536870912) as MinizCompressor
    __miniz_check_level(level)
    __miniz_check_limit(maxInput, "maxInput")
    __miniz_check_limit(maxOutput, "maxOutput")
    MinizCompressor result = MinizCompressor(c_int(level),
        c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if not result.valid then
        throw CompressionError __miniz_error()
    end
    return result
end

export func decompressor(int maxInput = 268435456, int maxOutput = 536870912,
    int maxRatio = 1000) as MinizDecompressor
    __miniz_check_limit(maxInput, "maxInput")
    __miniz_check_limit(maxOutput, "maxOutput")
    __miniz_check_limit(maxRatio, "maxRatio")
    MinizDecompressor result = MinizDecompressor(c_ulonglong(maxInput),
        c_ulonglong(maxOutput), c_uint(maxRatio))
    if not result.valid then
        throw CompressionError __miniz_error()
    end
    return result
end
