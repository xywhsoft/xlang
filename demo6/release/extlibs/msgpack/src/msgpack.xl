extern "xmsgpack_encode_int" func __mp_enc_int(int value) as string
extern "xmsgpack_decode_int" func __mp_dec_int(string hex) as int
extern "xmsgpack_encode_str" func __mp_enc_str(string s) as string
extern "xmsgpack_decode_str" func __mp_dec_str(string hex) as string
extern "xmsgpack_encode_bin" func __mp_enc_bin(string data_hex) as string
extern "xmsgpack_decode_bin" func __mp_dec_bin(string hex) as string
extern "xmsgpack_encode_nil" func __mp_enc_nil() as string
extern "xmsgpack_encode_bool" func __mp_enc_bool(bool val) as string
extern "xmsgpack_decode_bool" func __mp_dec_bool(string hex) as bool
extern "xmsgpack_encode_float" func __mp_enc_float(float val) as string
extern "xmsgpack_decode_float" func __mp_dec_float(string hex) as float
extern "xmsgpack_encode_array_hdr" func __mp_arr_hdr(int count) as string
extern "xmsgpack_encode_map_hdr" func __mp_map_hdr(int pairs) as string
extern "xmsgpack_type_name" func __mp_tname(string hex) as string
extern "xmsgpack_concat" func __mp_cat(string a, string b) as string



export func encodeInt(int value) as string
    return __mp_enc_int(value)
end

export func decodeInt(string hex) as int
    return __mp_dec_int(hex)
end

export func encodeStr(string s) as string
    return __mp_enc_str(s)
end

export func decodeStr(string hex) as string
    return __mp_dec_str(hex)
end

export func encodeBin(string data_hex) as string
    return __mp_enc_bin(data_hex)
end

export func decodeBin(string hex) as string
    return __mp_dec_bin(hex)
end

export func encodeNil() as string
    return __mp_enc_nil()
end

export func encodeBool(bool val) as string
    return __mp_enc_bool(val)
end

export func decodeBool(string hex) as bool
    return __mp_dec_bool(hex)
end

export func encodeFloat(float val) as string
    return __mp_enc_float(val)
end

export func decodeFloat(string hex) as float
    return __mp_dec_float(hex)
end

export func arrayHdr(int count) as string
    return __mp_arr_hdr(count)
end

export func mapHdr(int pairs) as string
    return __mp_map_hdr(pairs)
end

export func typeName(string hex) as string
    return __mp_tname(hex)
end

export func concat(string a, string b) as string
    return __mp_cat(a, b)
end
