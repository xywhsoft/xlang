// crc32 — CRC-32/ISO-HDLC 校验和（slice-by-8 高性能实现），支持 Buffer/string/文件/流式。
extern "xrtGetError" func __crc32_error() as string
extern "xcrc32_version" func __crc32_version() as string
extern "xcrc32_hash" func __crc32_hash(point data, c_size size) as int
extern "xcrc32_hash_hex" func __crc32_hash_hex(point data, c_size size) as string
extern "xcrc32_hash_str" func __crc32_hash_str(string data, c_size size) as int
extern "xcrc32_hash_str_hex" func __crc32_hash_str_hex(string data, c_size size) as string
extern "xcrc32_file" func __crc32_file(string path, c_ulonglong maxInput) as int
extern "xcrc32_file_hex" func __crc32_file_hex(string path, c_ulonglong maxInput) as string



// 返回内嵌 CRC32 引擎的版本号。
export func version() as string
    return __crc32_version()
end

func __crc32_check_limit(int value, string name)
    if value <= 0 then
        throw ValueError name + " must be greater than zero"
    end
end



// 一次性 CRC32 校验和（返回 32 位无符号整数）。
export func checksum(Buffer data) as int
    return __crc32_hash(data.data(), c_size(data.len()))
end

export func checksum(string text) as int
    return __crc32_hash_str(text, c_size(string.len(text)))
end

// 一次性 CRC32 校验和（返回 8 位十六进制小写字符串）。
export func checksumHex(Buffer data) as string
    string result = __crc32_hash_hex(data.data(), c_size(data.len()))
    if result == "" then
        throw ValueError __crc32_error()
    end
    return result
end

export func checksumHex(string text) as string
    string result = __crc32_hash_str_hex(text, c_size(string.len(text)))
    if result == "" then
        throw ValueError __crc32_error()
    end
    return result
end



// 文件 CRC32 校验和（XRT reader 分块读取，受 maxInput 限制）。
export func checksumFile(string path, int maxInput = 268435456) as int
    __crc32_check_limit(maxInput, "maxInput")
    int result = __crc32_file(path, c_ulonglong(maxInput))
    if __crc32_error() != "" then
        throw FileError __crc32_error()
    end
    return result
end

export func checksumFileHex(string path, int maxInput = 268435456) as string
    __crc32_check_limit(maxInput, "maxInput")
    string result = __crc32_file_hex(path, c_ulonglong(maxInput))
    if result == "" then
        throw FileError __crc32_error()
    end
    return result
end



// 增量流式校验器：update() 喂入数据，digest()/digestHex() 读取当前值（不终结），
// reset() 复位。配合 inputBytes 可驱动进度回显。
export class Crc32Hasher
    native point handle
    extern "xcrc32_hasher_create" create(c_ulonglong maxInput)
    extern "xcrc32_hasher_destroy" destroy()
    extern "xcrc32_hasher_update" func updateNative(point data, c_size size) as bool
    extern "xcrc32_hasher_update_str" func updateStrNative(string data, c_size size) as bool
    extern "xcrc32_hasher_digest" func digestNative() as int
    extern "xcrc32_hasher_digest_hex" func digestHexNative() as string
    extern "xcrc32_hasher_reset" func resetNative() as bool
    extern "xcrc32_hasher_input_bytes" func inputBytesNative() as int

    get valid() as bool
        return self.handle != null
    end

    // 已喂入的字节数（进度回显用）。
    get inputBytes() as int
        return self.inputBytesNative()
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw ValueError __crc32_error()
        end
    end

    func update(string text)
        if not self.updateStrNative(text, c_size(string.len(text))) then
            throw ValueError __crc32_error()
        end
    end

    // 读取当前累计输入的 CRC32 值（不终结状态）。
    func digest() as int
        return self.digestNative()
    end

    // 读取当前累计输入的 CRC32 值（8 位十六进制小写字符串）。
    func digestHex() as string
        string result = self.digestHexNative()
        if result == "" then
            throw ValueError __crc32_error()
        end
        return result
    end

    // 复位校验器（清空累计输入）。
    func reset() as bool
        if not self.resetNative() then
            throw ValueError __crc32_error()
        end
        return true
    end
end



// 创建流式 CRC32 校验器。
export func hasher(int maxInput = 268435456) as Crc32Hasher
    __crc32_check_limit(maxInput, "maxInput")
    Crc32Hasher result = Crc32Hasher(c_ulonglong(maxInput))
    if not result.valid then
        throw ValueError __crc32_error()
    end
    return result
end
