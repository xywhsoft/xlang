extern "xlangdetect_detect" func __langdetect(string text) as string
extern "xlangdetect_code" func __langdetect_code(string text) as string
extern "xlangdetect_script" func __langdetect_script(string text) as string
extern "xlangdetect_confidence" func __langdetect_confidence(string text) as int
extern "xlangdetect_valid_utf8" func __langdetect_valid_utf8(string text) as bool
extern "xlangdetect_last_error" func __langdetect_last_error() as string



export func detect(string text) as string
    return __langdetect(text)
end



export func code(string text) as string
    return __langdetect_code(text)
end



export func script(string text) as string
    return __langdetect_script(text)
end



export func confidence(string text) as int
    return __langdetect_confidence(text)
end



export func isValidUtf8(string text) as bool
    return __langdetect_valid_utf8(text)
end



export func lastError() as string
    return __langdetect_last_error()
end

export func isChinese(string text) as bool
    return __langdetect(text) == "chinese"
end

export func isEnglish(string text) as bool
    return __langdetect(text) == "english"
end

export func isJapanese(string text) as bool
    return __langdetect(text) == "japanese"
end

export func isKorean(string text) as bool
    return __langdetect(text) == "korean"
end
