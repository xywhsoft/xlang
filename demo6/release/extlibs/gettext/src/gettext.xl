extern "xgt_parse_po" func __gt_parse_po(string text) as var
extern "xgt_parse_mo" func __gt_parse_mo(var data) as var
extern "xgt_load_mo" func __gt_load_mo(string path) as var
extern "xgt_t" func __gt_t(var catalog, string msgid) as string
extern "xgt_tn" func __gt_tn(var catalog, string msgid, string msgidPlural, int n) as string



// parsePo 解析 PO 文本为目录对象；支持多行字符串、转义与复数形式
// 复数条目在目录中保存为 [单数译文, 复数译文, ...] 数组
export func parsePo(string text) as var
    var r = __gt_parse_po(text)
    if r == null then
        throw ValueError "gettext: po text is null"
    end
    return r
end

// parseMo 解析 MO 二进制目录（来自 file.readBytes 的 Buffer）
export func parseMo(var data) as var
    var r = __gt_parse_mo(data)
    if r == null then
        throw ValueError "gettext: not a valid mo file"
    end
    return r
end

// loadMo 直接读取并解析 .mo 文件；文件不可读抛 ValueError
export func loadMo(string path) as var
    var r = __gt_load_mo(path)
    if r == null then
        throw ValueError "gettext: mo file cannot be read: " + path
    end
    return r
end

// t 查询单数译文；缺失时返回 msgid 本身
export func t(var catalog, string msgid) as string
    return __gt_t(catalog, msgid)
end

// tn 查询复数译文；n==1 取单数，否则取第一个复数形式；缺失时回退原文
export func tn(var catalog, string msgid, string msgidPlural, int n) as string
    return __gt_tn(catalog, msgid, msgidPlural, n)
end
