import gettext

func main(...) as int
    // PO 元数据控制复数形式，同名 msgid 还能通过上下文消歧。
    var catalog = gettext.parsePo("""msgid ""
msgstr "Plural-Forms: nplurals=3; plural=n==1?0:n==2?1:2;\\n"

msgctxt "menu"
msgid "Open"
msgstr "打开菜单"

msgid "file"
msgid_plural "files"
msgstr[0] "一个文件"
msgstr[1] "两个文件"
msgstr[2] "多个文件"

msgctxt "toolbar"
msgid "file"
msgid_plural "files"
msgstr[0] "工具栏文件"
msgstr[1] "工具栏两个文件"
msgstr[2] "工具栏多个文件"

#, fuzzy
msgid "Draft"
msgstr "未审核"

msgid "Blank"
msgstr ""

msgid "escaped"
msgstr "\\x41\\x42\\?"
""")
    assert gettext.tc(catalog, "menu", "Open") == "打开菜单"
    assert gettext.tn(catalog, "file", "files", 3) == "多个文件"
    assert gettext.tnc(catalog, "toolbar", "file", "files", 2) == "工具栏两个文件"
    println("menu:", gettext.tc(catalog, "menu", "Open"))
    println("many:", gettext.tn(catalog, "file", "files", 3))
    println("toolbar:", gettext.tnc(catalog, "toolbar", "file", "files", 2))
    println(gettext.t(catalog, "missing"))
    println(gettext.t(catalog, "Draft"))
    println(gettext.t(catalog, "Blank"))
    println(gettext.t(catalog, "escaped"))
    var mo = gettext.parseMo(file.readBytes("../test/fixtures/gettext_mini.mo"))
    assert gettext.t(mo, "hello") == "world!"
    println("mo:", gettext.t(mo, "hello"))
    return 0
end
