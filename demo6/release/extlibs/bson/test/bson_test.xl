import bson

func main(...) as int
    var document = {"name": "中文 BSON", "pi": 3.14159, "big": 9876543210,
        "active": true, "at": time(1000), "tags": ["dev", "xlang"]}
    var wire = bson.encode(document)
    assert bson.docLength(wire) > 5
    var decoded = bson.decode(wire)
    assert decoded["name"] == "中文 BSON"
    assert decoded["pi"] == 3.14159
    assert decoded["big"] == 9876543210
    assert decoded["active"] == true
    assert decoded["at"] == time(1000)
    assert decoded["tags"][1] == "xlang"
    assert string.len(bson.toHex(wire)) == bson.docLength(wire) * 2

    var documents = bson.decodeAll(bson.concat(wire, wire))
    assert documents.length == 2
    assert documents[1]["big"] == 9876543210

    string workDir = path.join(path.temp(), "xlang_bson_" + crypto.randomString(20))
    dir.createAll(workDir)
    string filename = path.join(workDir, "中文.bson")
    try
        assert bson.save(filename, document) == bson.docLength(wire)
        var loaded = bson.load(filename)
        assert loaded["name"] == "中文 BSON"
        assert loaded["pi"] == 3.14159
        assert loaded["tags"][0] == "dev"
    finally
        if file.exists(filename) then assert file.delete(filename) end
        assert dir.delete(workDir), "temporary BSON directory must be removed"
    end
    println("bson integration: PASS")
    return 0
end
