extern "xep_build" func __epub_build(string path, var meta, var chapters) as int
extern "xep_read_entry" func __epub_read_entry(string path, string name) as string



// build 生成一本 EPUB 3 电子书（存储式 ZIP，无需压缩依赖）
// meta 支持 title、author、language、identifier 字段
// chapters 为 [{title, text}] 数组；text 支持简单的 "# "/"## " 标题与空行分段
// 返回文件字节数；生成失败抛 ValueError
export func build(string path, var meta, var chapters) as int
    int size = __epub_build(path, meta, chapters)
    if size <= 0 then
        throw ValueError "epub: build failed (1-100 chapters required, write error possible)"
    end
    return size
end

// readEntry 读取 epub 内指定文本条目（用于验证与调试）；不存在返回空字符串
export func readEntry(string path, string name) as string
    return __epub_read_entry(path, name)
end
