func __xl6_import_x_mail_pop3_capability_json(string config_json) as string
    if mail_pop3_dry_run_text(config_json) then
        return mail_pop3_preview_json("capability", config_json)
    end
    return xmail_pop3_capability_json_native(config_json)
end

