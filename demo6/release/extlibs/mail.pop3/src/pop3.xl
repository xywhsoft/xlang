import mail.mime

extern "xmail_pop3_capability_json_native" func xmail_pop3_capability_json_native(string config_json) as string
extern "xmail_pop3_status_json_native" func xmail_pop3_status_json_native(string config_json) as string
extern "xmail_pop3_list_json_native" func xmail_pop3_list_json_native(string config_json) as string
extern "xmail_pop3_fetch_json_native" func xmail_pop3_fetch_json_native(string request_json) as string
extern "xmail_pop3_delete_json_native" func xmail_pop3_delete_json_native(string request_json) as string

func __xl6_import_x_mail_pop3_result(bool ok, string error, string stage, var data) as var
    return mail.mime.result(ok, error, stage, data)
end

func __xl6_import_x_mail_pop3_unsupported(string operation) as var
    return mail.mime.result(false, "mail.pop3." + operation + " native binding is not connected", "binding", {})
end

func __xl6_import_x_mail_pop3_capability(var config) as var
    return json.parse(xmail_pop3_capability_json_native(json.stringify(config)))
end

func __xl6_import_x_mail_pop3_status(var config) as var
    return json.parse(xmail_pop3_status_json_native(json.stringify(config)))
end

func __xl6_import_x_mail_pop3_list(var config) as var
    return json.parse(xmail_pop3_list_json_native(json.stringify(config)))
end

func __xl6_import_x_mail_pop3_fetch(var request) as var
    return json.parse(xmail_pop3_fetch_json_native(json.stringify(request)))
end

func __xl6_import_x_mail_pop3_delete_message(var request) as var
    return json.parse(xmail_pop3_delete_json_native(json.stringify(request)))
end

func __xl6_import_x_mail_pop3_capability_json(string config_json) as string
    return xmail_pop3_capability_json_native(config_json)
end

func __xl6_import_x_mail_pop3_status_json(string config_json) as string
    return xmail_pop3_status_json_native(config_json)
end

func __xl6_import_x_mail_pop3_list_json(string config_json) as string
    return xmail_pop3_list_json_native(config_json)
end

func __xl6_import_x_mail_pop3_fetch_json(string request_json) as string
    return xmail_pop3_fetch_json_native(request_json)
end

func __xl6_import_x_mail_pop3_delete_message_json(string request_json) as string
    return xmail_pop3_delete_json_native(request_json)
end
