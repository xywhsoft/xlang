import mail.mime

extern "xmail_pop3_capability_json_native" func xmail_pop3_capability_json_native(string config_json) as string
extern "xmail_pop3_status_json_native" func xmail_pop3_status_json_native(string config_json) as string
extern "xmail_pop3_list_json_native" func xmail_pop3_list_json_native(string config_json) as string
extern "xmail_pop3_fetch_json_native" func xmail_pop3_fetch_json_native(string request_json) as string
extern "xmail_pop3_delete_json_native" func xmail_pop3_delete_json_native(string request_json) as string

func __xl6_import_x_mail_pop3_available() as bool
    return true
end

func __xl6_import_x_mail_pop3_version() as string
    return "0.1.0"
end

func __xl6_import_x_mail_pop3_last_error() as string
    return ""
end

func mail_pop3_dry_run_text(string text) as bool
    string compact = string.replace(text, " ", "")
    compact = string.replace(compact, "\t", "")
    compact = string.replace(compact, "\r", "")
    compact = string.replace(compact, "\n", "")
    if string.contains(compact, "\"dry_run\":true") or string.contains(compact, "\"dry_run\":1") then
        return true
    end
    if string.contains(compact, "\"timeout_ms\":0") or string.contains(compact, "\"timeout_ms\":-") then
        return true
    end
    return false
end

func mail_pop3_dry_run(var value) as bool
    return mail_pop3_dry_run_text(json.stringify(value))
end

func mail_pop3_preview(string operation, var payload) as var
    var commands = ["QUIT"]
    if operation == "capability" then
        commands = ["CAPA", "QUIT"]
    end
    if operation == "status" then
        commands = ["STAT", "QUIT"]
    end
    if operation == "list" then
        commands = ["LIST", "QUIT"]
    end
    if operation == "fetch" then
        commands = ["RETR", "TOP", "QUIT"]
    end
    if operation == "delete_message" then
        commands = ["DELE", "QUIT"]
    end
    return mail.mime.result(true, "", "dry_run", {
        "dry_run": true,
        "operation": operation,
        "commands": commands,
        "payload": payload
    })
end

func mail_pop3_preview_json(string operation, string payload_json) as string
    return json.stringify(mail_pop3_preview(operation, {"payload_json": payload_json}))
end

func __xl6_import_x_mail_pop3_result(bool ok, string error, string stage, var data) as var
    return mail.mime.result(ok, error, stage, data)
end

func __xl6_import_x_mail_pop3_capability(var config) as var
    if mail_pop3_dry_run(config) then
        return mail_pop3_preview("capability", config)
    end
    return json.parse(xmail_pop3_capability_json_native(json.stringify(config)))
end

func __xl6_import_x_mail_pop3_status(var config) as var
    if mail_pop3_dry_run(config) then
        return mail_pop3_preview("status", config)
