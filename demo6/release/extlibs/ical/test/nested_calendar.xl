import ical

func main(...) as int
    string nested = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:test\nBEGIN:VCALENDAR\nEND:VCALENDAR\nEND:VCALENDAR\n"
    string badComponentSpace = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:test\nBEGIN:BAD NAME\nEND:BAD NAME\nEND:VCALENDAR\n"
    string badComponentUnderscore = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:test\nBEGIN:X_BAD\nEND:X_BAD\nEND:VCALENDAR\n"
    string badComponentUnicode = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:test\nBEGIN:中文\nEND:中文\nEND:VCALENDAR\n"
    string markedBegin = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:test\nBEGIN;X=1:VALARM\nEND:VCALENDAR\n"
    string markedEnd = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:test\nEND;X=1:VCALENDAR\nEND:VCALENDAR\n"
    string badVersion = "BEGIN:VCALENDAR\nVERSION;=x:2.0\nPRODID:test\nEND:VCALENDAR\n"
    string badProdid = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID;X:test\nEND:VCALENDAR\n"
    string trailingParam = "BEGIN:VCALENDAR\nVERSION;X=1;:2.0\nPRODID:test\nEND:VCALENDAR\n"
    string badParamName = "BEGIN:VCALENDAR\nVERSION;X_BAD=1:2.0\nPRODID:test\nEND:VCALENDAR\n"
    string badParamTail = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID;X=\"ok\"tail:test\nEND:VCALENDAR\n"
    string badParamQuote = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID;X=a\"b\"c:test\nEND:VCALENDAR\n"
    string badEventParam = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:test\nBEGIN:VEVENT\nSUMMARY;X_BAD=1:hello\nEND:VEVENT\nEND:VCALENDAR\n"
    string badExtensionName = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:test\nX_CUSTOM;X-KEY=1:opaque\nEND:VCALENDAR\n"
    string badExtensionParam = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:test\nX-CUSTOM;X_KEY=1:opaque\nEND:VCALENDAR\n"
    int rejected = 0
    try
        ical.parse(nested)
    catch e
        rejected += 1
    end
    try
        ical.parse(badComponentSpace)
    catch e
        rejected += 1
    end
    try
        ical.parse(badComponentUnderscore)
    catch e
        rejected += 1
    end
    try
        ical.parse(badComponentUnicode)
    catch e
        rejected += 1
    end
    try
        ical.parse(markedBegin)
    catch e
        rejected += 1
    end
    try
        ical.parse(markedEnd)
    catch e
        rejected += 1
    end
    try
        ical.parse(badVersion)
    catch e
        rejected += 1
    end
    try
        ical.parse(badProdid)
    catch e
        rejected += 1
    end
    try
        ical.parse(trailingParam)
    catch e
        rejected += 1
    end
    try
        ical.parse(badParamName)
    catch e
        rejected += 1
    end
    try
        ical.parse(badParamTail)
    catch e
        rejected += 1
    end
    try
        ical.parse(badParamQuote)
    catch e
        rejected += 1
    end
    try
        ical.parse(badEventParam)
    catch e
        rejected += 1
    end
    try
        ical.parse(badExtensionName)
    catch e
        rejected += 1
    end
    try
        ical.parse(badExtensionParam)
    catch e
        rejected += 1
    end
    assert rejected == 15, "invalid iCalendar markers, components and parameters must be rejected"
    var calendar = ical.parse("BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:test\nX-CUSTOM;X-KEY=1:opaque\nEND:VCALENDAR\n")
    assert calendar["events"].length == 0, "ordinary extension properties remain ignorable"
    var extensionComponent = ical.parse("BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:test\nBEGIN:X-CUSTOM\nX-KEY:opaque\nEND:X-CUSTOM\nEND:VCALENDAR\n")
    assert extensionComponent["events"].length == 0, "valid extension components remain ignorable"
    var parameterized = ical.parse("BEGIN:VCALENDAR\nVERSION;X=\"a;b:c\":2.0\nPRODID;X=\"b:c;d\":test\nEND:VCALENDAR\n")
    assert parameterized["prodid"] == "test", "valid extension parameters remain accepted"
    var listed = ical.parse("BEGIN:VCALENDAR\nVERSION:2.0\nPRODID;X=\"a;b:c\",\"d,e\":test\nEND:VCALENDAR\n")
    assert listed["prodid"] == "test", "quoted extension parameter lists remain accepted"
    println("ical nested calendar: PASS")
    return 0
end
