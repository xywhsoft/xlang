extern "xi_parse" func __i_parse(string text, c_size size) as var
extern "xi_build" func __i_build(var calendar) as point
// parse 解析 iCalendar 文本，返回 {events: [...], todos: [...]}
// 常用字段为字符串；日期的 TZID、VALUE 分别保存在 *Tzid、*Value 中。
// 自动展开折行，仅对 TEXT 字段解码转义。
export func parse(string text) as var
    var r = __i_parse(text, c_size(string.byteLen(text)))
    if r == null then
        throw ValueError "ical: invalid iCalendar input"
    end
    return r
end

// build 由 {events: [...], todos: [...]} 生成 iCalendar 文本
// TEXT 值重新转义，物理行按最多 75 字节折叠。
export func build(var calendar) as string
    point result = __i_build(calendar)
    if result == null then
        throw ValueError "ical: invalid event or calendar fields"
    end
    return __xl_runtime.takeCstr(result)
end
