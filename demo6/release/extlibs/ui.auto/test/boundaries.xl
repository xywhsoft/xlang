import ui.auto
import uia

func main(...) as int
	auto window = ui.auto.test_window()
	assert window.valid(), "test window unavailable"

	auto missing = ui.auto.within(
		ui.auto.with_timeout(ui.auto.by_automation_id("missing-uia-test-id", 0), 0),
		window.hwnd()
	)
	assert not ui.auto.wait_exists(missing), "missing locator should not match"
	assert not ui.auto.click(missing), "missing locator should not click"
	assert not ui.auto.type_text(missing, "x"), "missing locator should not accept text"
	assert ui.auto.read(missing) == "", "missing locator should read empty text"

	auto edit = ui.auto.within(ui.auto.by_class_name("Edit", "", 50004), window.hwnd())
	assert ui.auto.wait_exists(edit), "edit locator should match"
	assert ui.auto.type_text(edit, "hello"), "edit input failed"
	assert ui.auto.read(edit) == "hello", "edit read failed"
	bool rejected = false
	try
		ui.auto.type_text(edit, "hello\0hidden")
	catch ValueError e
		rejected = true
	end
	assert rejected, "embedded NUL must not truncate text input"
	assert ui.auto.read(edit) == "hello", "rejected input must not change the control"
	auto truncated = ui.auto.within(
		ui.auto.by_class_name("Edit\0hidden", "", 50004), window.hwnd())
	rejected = false
	try
		ui.auto.wait_exists(truncated)
	catch ValueError e
		rejected = true
	end
	assert rejected, "embedded NUL must not turn a locator into a prefix match"

	// 复合定位器必须同时约束控件类和进程，不能只命中第一个条件。
	auto wrong_process = ui.auto.within(
		ui.auto.with_timeout(ui.auto.locator_from_json(
			"{\"className\":\"Edit\",\"controlType\":50004,\"processId\":2147483647}"), 0),
		window.hwnd())
	assert not ui.auto.wait_exists(wrong_process), "process filter was ignored"
	string generated = uia.from_hwnd(window.edit_hwnd()).locator_json()
	auto from_json = ui.auto.within(
		ui.auto.with_timeout(ui.auto.locator_from_json(generated), 0), window.hwnd())
	assert ui.auto.wait_exists(from_json), "generated locator should match"
	var generated_fields = json.parse(generated)
	string class_path = string(generated_fields["classPath"])
	int process_id = int(generated_fields["processId"])
	int sibling_index = int(generated_fields["index"])
	string path_json = json.stringify({"strategy": "processClassPath",
		"classPath": class_path, "processId": process_id, "index": sibling_index})
	auto by_path = ui.auto.within(
		ui.auto.with_timeout(ui.auto.locator_from_json(path_json), 0), window.hwnd())
	assert ui.auto.wait_exists(by_path), "generated class path should resolve"
	assert ui.auto.read(by_path) == "hello", "class path resolved the wrong control"
	by_path.name = "not-this-control"
	assert not ui.auto.wait_exists(by_path), "class path ignored the name filter"
	by_path.name = ""
	by_path.process_id = 2147483647
	assert not ui.auto.wait_exists(by_path), "class path ignored the process filter"
	by_path.process_id = process_id
	by_path.class_path = class_path + "/Edit#50004[999]"
	assert not ui.auto.wait_exists(by_path), "missing class path should not match"

	rejected = false
	try
		ui.auto.locator_from_json("{}")
	catch ValueError e
		rejected = true
	end
	assert rejected, "empty locator must be rejected"
	rejected = false
	try
		ui.auto.locator_from_json("{\"controlType\":\"50004\"}")
	catch TypeError e
		rejected = true
	end
	assert rejected, "locator field type must be checked"
	rejected = false
	try
		ui.auto.locator_from_json("{\"strategy\":\"processClassPath\",\"processId\":1}")
	catch ValueError e
		rejected = true
	end
	assert rejected, "class path strategy requires a path"
	rejected = false
	try
		ui.auto.locator_from_json("{\"strategy\":\"processClasPath\",\"name\":\"hello\"}")
	catch ValueError e
		rejected = true
	end
	assert rejected, "unknown locator strategy must not be ignored"
	rejected = false
	try
		ui.auto.locator_from_json("{\"strategy\":\"automationId\",\"processId\":1}")
	catch ValueError e
		rejected = true
	end
	assert rejected, "automationId strategy requires an automation ID"
	rejected = false
	try
		ui.auto.locator_from_json("{\"strategy\":\"classNameName\",\"name\":\"hello\"}")
	catch ValueError e
		rejected = true
	end
	assert rejected, "classNameName strategy requires a class name"
	auto by_id_strategy = ui.auto.locator_from_json(
		"{\"strategy\":\"automationId\",\"automationId\":\"edit\"}")
	assert by_id_strategy.automation_id == "edit", "automationId strategy must remain valid"
	auto by_class_strategy = ui.auto.locator_from_json(
		"{\"strategy\":\"classNameName\",\"className\":\"Edit\"}")
	assert by_class_strategy.class_name == "Edit", "classNameName strategy must remain valid"
	rejected = false
	try
		ui.auto.locator_from_json(json.stringify({"strategy": "processClassPath",
			"classPath": class_path, "index": sibling_index + 1}))
	catch ValueError e
		rejected = true
	end
	assert rejected, "inconsistent class path index must be rejected"
	rejected = false
	try
		ui.auto.locator_from_json("{\"index\":0,\"processId\":1}")
	catch ValueError e
		rejected = true
	end
	assert rejected, "index without class path must be rejected"
	rejected = false
	try
		ui.auto.with_timeout(edit, -1)
	catch ValueError e
		rejected = true
	end
	assert rejected, "negative timeout must be rejected"
	edit.process_id = -1
	rejected = false
	try
		ui.auto.wait_exists(edit)
	catch ValueError e
		rejected = true
	end
	assert rejected, "negative direct field must be rejected"
	edit.process_id = 0

	assert window.release(), "window release failed"
	assert ui.auto.shutdown(), "uia shutdown failed"
	println("ui.auto boundaries ok")
	return 0
end
