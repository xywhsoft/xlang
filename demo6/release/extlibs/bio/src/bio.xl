extern "xbio_codon" func __codon(int id) as string
extern "xbio_amino_acid" func __amino_acid(int id) as string
extern "xbio_complement" func __complement(string seq) as string
extern "xbio_transcribe" func __transcribe(string dna) as string
extern "xbio_gc_content" func __gc_content(string seq) as int
extern "xbio_format" func __format(int id) as string

export func codon(int id) as string
    return __codon(id)
end

export func aminoAcid(int id) as string
    return __amino_acid(id)
end

export func complement(string seq) as string
    return __complement(seq)
end

export func transcribe(string dna) as string
    return __transcribe(dna)
end

export func gcContent(string seq) as int
    return __gc_content(seq)
end

export func format(int id) as string
    return __format(id)
end
