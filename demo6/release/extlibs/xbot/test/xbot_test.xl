from xbot import XBOT_VERSION, Size, Pixel, Ratio, OpResult


func main(...) as int
    assert string.startsWith(XBOT_VERSION, "0.1."), "xbot version"

    Size screen = Size(1920, 1080)
    Pixel pixel = Pixel(12.5, 24.5)
    Ratio center = Ratio(0.5, 0.5)
    OpResult result = OpResult(true, "ready", "")

    assert screen.width == 1920 and screen.height == 1080, "xbot size"
    assert pixel.x == 12.5 and pixel.y == 24.5, "xbot pixel"
    assert center.x == 0.5 and center.y == 0.5, "xbot ratio"
    assert result.ok() and not result.fail(), "xbot result"

    println("xbot package test ok")
    return 0
end
