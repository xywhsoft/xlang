// xbot/agent.xl - Agent 工具系统
// 对应 xbot.py L1754-2725：ToolDefinition, AgentPolicy, AgentWorkspace, AgentToolkit
// 12 个内置文件工具 + 权限控制 + JSONL Trace

// ─── 权限常量 ───
const string AGENT_PERMISSION_READ = "read"
const string AGENT_PERMISSION_WRITE = "write"
const string AGENT_PERMISSION_EXECUTE = "execute"
const string AGENT_PERMISSION_DESTRUCTIVE = "destructive"

// ─── 工具调用 ───
export class ToolCall
    string name
    string arguments
    string call_id

    create(string n, string args, string id)
        self.name = n
        self.arguments = args
        self.call_id = id
    end
end
// ─── 工具执行结果 ───
export class ToolResult
    bool success
    string content
    string error
    var data
    bool truncated

    create(bool ok, string msg, string err)
        self.success = ok
        self.content = msg
        self.error = err
        self.data = null
        self.truncated = false
    end

    func ToModelText(int max_chars) as string
        string text = "{\"success\":" + string(self.success)
        if self.content != "" then
            text = text + ",\"content\":\"" + _json_escape(self.content) + "\""
        end
        if self.error != "" then
            text = text + ",\"error\":\"" + _json_escape(self.error) + "\""
        end
        text = text + "}"
        if string.len(text) > max_chars then
            text = string.mid(text, 0, max_chars) + "...[truncated]"
            self.truncated = true
        end
        return text
    end
end
// ─── 工具定义 ───
export class ToolDefinition
    string name
    string description
    string parameters
    func(string) as ToolResult handler
    string permission
    int timeout_seconds

    create(string n, string desc, string params, func(string) as ToolResult fn, string perm)
        self.name = n
        self.description = desc
        self.parameters = params
        self.handler = fn
        self.permission = perm
        self.timeout_seconds = 120
    end
end
// ─── Agent 策略 ───
export class AgentPolicy
    int max_command_seconds
    int max_output_chars
    int max_read_bytes
    int max_search_results
    bool allow_destructive

    create()
        self.max_command_seconds = 120
        self.max_output_chars = 65536
        self.max_read_bytes = 1048576
        self.max_search_results = 200
        self.allow_destructive = false
    end
end
// ─── Agent 工作区 ───
export class AgentWorkspace
    string root
    string run_id
    string trace_dir
    string artifacts_dir
    bool trace_enabled

    create(string root_path, string rid, bool trace)
        self.root = path.abs(root_path)
        self.run_id = rid
        self.trace_dir = path.join(self.root, "logs", "agent", rid)
        self.artifacts_dir = path.join(self.trace_dir, "artifacts")
        self.trace_enabled = trace
        if trace then
            dir.createAll(self.artifacts_dir)
        end
    end
    // 解析工作区内路径，防止逃逸
    func Resolve(string value, bool writable) as string
        string candidate = value
        if path.isAbs(value) == false then
            candidate = path.join(self.root, value)
        end
        string resolved = path.abs(candidate)
        // 检查是否在工作区内
        if string.len(resolved) < string.len(self.root) then
            throw RuntimeError "路径超出 Agent 工作区: " + value
        end
        if string.mid(resolved, 0, string.len(self.root)) != self.root then
            throw RuntimeError "路径超出 Agent 工作区: " + value
        end
        return resolved
    end

    // JSONL 审计日志
    func Trace(string event, string payload_json)
        if self.trace_enabled == false then
            return
        end
        dir.createAll(self.trace_dir)
        string trace_file = path.join(self.trace_dir, "trace.jsonl")
        string row = "{\"event\":\"" + event + "\",\"run_id\":\"" + self.run_id + "\"," + payload_json + "}\n"
        file.appendText(trace_file, row)
    end
end
// ─── Agent 工具箱 ───
export class AgentToolkit
    AgentWorkspace workspace
    AgentPolicy policy
    var device
    array<ToolDefinition> tools
    bool closed

    create(AgentWorkspace ws, AgentPolicy pol, var dev)
        self.workspace = ws
        self.policy = pol
        self.device = dev
        self.tools = []
        self.closed = false
    end

    // 注册工具
    func Register(ToolDefinition tool)
        int i = 0
        while i < self.tools.length
            if self.tools[i].name == tool.name then
                self.tools[i] = tool
                return
            end
            i += 1
        end
        self.tools.push(tool)
    end

    // 注销工具
    func Unregister(string name)
        array<ToolDefinition> kept = []
        int i = 0
        while i < self.tools.length
            if self.tools[i].name != name then
                kept.push(self.tools[i])
            end
            i += 1
        end
        self.tools = kept
    end

    // 获取所有工具名
    func ToolNames() as array<string>
        array<string> names = []
        int i = 0
        while i < self.tools.length
            names.push(self.tools[i].name)
            i += 1
        end
        return names
    end

    // 获取工具 Schema（供 LLM Function Calling）
    func ToolSchemas() as string
        Buffer buf = Buffer()
        buf.append("[")
        int i = 0
        while i < self.tools.length
            if i > 0 then
                buf.append(",")
            end
            buf.append("{\"type\":\"function\",\"function\":{\"name\":\"")
            buf.append(self.tools[i].name)
            buf.append("\",\"description\":\"")
            buf.append(_json_escape(self.tools[i].description))
            buf.append("\",\"parameters\":")
            buf.append(self.tools[i].parameters)
            buf.append("}}")
            i += 1
        end
        buf.append("]")
        return buf.text()
    end

    // 执行工具调用
    func Execute(ToolCall call) as ToolResult
        if self.closed then
            return ToolResult(false, "", "工具箱已关闭")
        end

        // 查找工具
        ToolDefinition? tool = null
        int i = 0
        while i < self.tools.length
            if self.tools[i].name == call.name then
                tool = self.tools[i]
                break
            end
            i += 1
        end

        if tool == null then
            return ToolResult(false, "", "未注册的工具: " + call.name)
        end
        ToolDefinition selected = tool as ToolDefinition

        // 权限检查
        if selected.permission == AGENT_PERMISSION_DESTRUCTIVE and self.policy.allow_destructive == false then
            return ToolResult(false, "", "工具 " + call.name + " 属于 destructive 权限，当前策略未允许")
        end

        // 执行
        float start_time = time.timer()
        self.workspace.Trace("before_execute", "\"name\":\"" + call.name + "\"")

        ToolResult result = ToolResult(false, "", "执行异常")
        // 调用 handler（函数类型: func(string) as ToolResult）
        result = selected.handler(call.arguments)

        int elapsed = int((time.timer() - start_time) * 1000.0)
        self.workspace.Trace("tool_call", "\"name\":\"" + call.name + "\",\"success\":" + string(result.success) + ",\"elapsed\":" + string(elapsed))
        LogInfo("Agent 工具 " + call.name + ": success=" + string(result.success))
        return result
    end

    // 将调用结果转为 LLM tool 消息
    func ToMessage(ToolCall call, ToolResult result) as string
        string text = result.ToModelText(self.policy.max_output_chars)
        return "{\"role\":\"tool\",\"tool_call_id\":\"" + call.call_id + "\",\"content\":\"" + _json_escape(text) + "\"}"
    end

    // 关闭工具箱
    func Close()
        self.closed = true
        self.workspace.Trace("toolkit_closed", "\"tools\":" + string(self.tools.length))
    end
end
// ─── 工厂函数 ───

// 创建自定义工具
export func DefineTool(string name, string description, string parameters, func(string) as ToolResult handler, string permission) as ToolDefinition
    if name == "" then
        throw RuntimeError "工具名不能为空"
    end
    if permission != AGENT_PERMISSION_READ and permission != AGENT_PERMISSION_WRITE and permission != AGENT_PERMISSION_EXECUTE and permission != AGENT_PERMISSION_DESTRUCTIVE then
        throw RuntimeError "未知 Agent 工具权限: " + permission
    end
    return ToolDefinition(name, description, parameters, handler, permission)
end

// 创建工具箱
export func CreateAgentToolkit(string workspace_root, var device, AgentPolicy policy) as AgentToolkit
    string run_id = string(time.now())
    AgentWorkspace ws = AgentWorkspace(workspace_root, run_id, true)
    AgentToolkit toolkit = AgentToolkit(ws, policy, device)
    return toolkit
end

// ─── 内置文件工具注册 ───
export func RegisterBuiltinTools(AgentToolkit toolkit, array<string> enabled)
    int i = 0
    while i < enabled.length
        string name = enabled[i]
        if name == "fs_list" then
            toolkit.Register(_make_fs_list(toolkit))
        elseif name == "fs_read" then
            toolkit.Register(_make_fs_read(toolkit))
        elseif name == "fs_write" then
            toolkit.Register(_make_fs_write(toolkit))
        elseif name == "fs_stat" then
            toolkit.Register(_make_fs_stat(toolkit))
        elseif name == "fs_mkdir" then
            toolkit.Register(_make_fs_mkdir(toolkit))
        elseif name == "fs_delete" then
            toolkit.Register(_make_fs_delete(toolkit))
        end
        i += 1
    end
end
// ─── 内置工具构造 ───

func _make_fs_list(AgentToolkit tk) as ToolDefinition
    string params = "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"目录路径\"},\"recursive\":{\"type\":\"boolean\"}},\"required\":[\"path\"]}"
    func(string) as ToolResult handler = func(string args_json) as ToolResult
        string dir_path = _json_extract_string(args_json, "path")
        if dir_path == "" then dir_path = "." end
        string resolved = tk.workspace.Resolve(dir_path, false)
        if dir.exists(resolved) == false then
            return ToolResult(false, "", "目录不存在: " + dir_path)
        end
        array<string> entries = dir.list(resolved)
        Buffer buf = Buffer()
        buf.append("[")
        int j = 0
        while j < entries.length and j < tk.policy.max_search_results
            if j > 0 then buf.append(",") end
            buf.append("\"")
            buf.append(_json_escape(entries[j]))
            buf.append("\"")
            j += 1
        end
        buf.append("]")
        ToolResult r = ToolResult(true, "列出 " + string(j) + " 项", "")
        r.data = buf.text()
        return r
    end
    return ToolDefinition("fs_list", "列出目录内容", params, handler, AGENT_PERMISSION_READ)
end

func _make_fs_read(AgentToolkit tk) as ToolDefinition
    string params = "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"start_line\":{\"type\":\"integer\"},\"end_line\":{\"type\":\"integer\"}},\"required\":[\"path\"]}"
    func(string) as ToolResult handler = func(string args_json) as ToolResult
        string file_path = _json_extract_string(args_json, "path")
        string resolved = tk.workspace.Resolve(file_path, false)
        if file.exists(resolved) == false then
            return ToolResult(false, "", "文件不存在: " + file_path)
        end
        string content = file.readText(resolved)
        if string.len(content) > tk.policy.max_read_bytes then
            content = string.mid(content, 0, tk.policy.max_read_bytes)
            ToolResult r = ToolResult(true, content, "")
            r.truncated = true
            return r
        end
        return ToolResult(true, content, "")
    end
    return ToolDefinition("fs_read", "读取文件内容", params, handler, AGENT_PERMISSION_READ)
end

func _make_fs_write(AgentToolkit tk) as ToolDefinition
    string params = "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"}},\"required\":[\"path\",\"content\"]}"
    func(string) as ToolResult handler = func(string args_json) as ToolResult
        string file_path = _json_extract_string(args_json, "path")
        string content = _json_extract_string(args_json, "content")
        string resolved = tk.workspace.Resolve(file_path, true)
        if file.exists(resolved) then
            string ow = _json_extract_string(args_json, "overwrite")
            if ow != "true" then
                return ToolResult(false, "", "目标已存在；如确认覆盖，请传 overwrite=true")
            end
        end
        dir.createAll(path.dir(resolved))
        file.writeText(resolved, content)
        return ToolResult(true, "文件写入成功: " + file_path, "")
    end
    return ToolDefinition("fs_write", "写入文件", params, handler, AGENT_PERMISSION_WRITE)
end

func _make_fs_stat(AgentToolkit tk) as ToolDefinition
    string params = "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}"
    func(string) as ToolResult handler = func(string args_json) as ToolResult
        string file_path = _json_extract_string(args_json, "path")
        string resolved = tk.workspace.Resolve(file_path, false)
        if file.exists(resolved) == false then
            return ToolResult(false, "", "路径不存在: " + file_path)
        end
        int size = file.size(resolved)
        string kind = "file"
        if dir.exists(resolved) then kind = "directory" end
        string info = "{\"path\":\"" + _json_escape(file_path) + "\",\"type\":\"" + kind + "\",\"size\":" + string(size) + "}"
        return ToolResult(true, info, "")
    end
    return ToolDefinition("fs_stat", "获取文件/目录信息", params, handler, AGENT_PERMISSION_READ)
end

func _make_fs_mkdir(AgentToolkit tk) as ToolDefinition
    string params = "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}"
    func(string) as ToolResult handler = func(string args_json) as ToolResult
        string dir_path = _json_extract_string(args_json, "path")
        string resolved = tk.workspace.Resolve(dir_path, true)
        dir.createAll(resolved)
        return ToolResult(true, "目录已就绪: " + dir_path, "")
    end
    return ToolDefinition("fs_mkdir", "创建目录", params, handler, AGENT_PERMISSION_WRITE)
end

func _make_fs_delete(AgentToolkit tk) as ToolDefinition
    string params = "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}"
    func(string) as ToolResult handler = func(string args_json) as ToolResult
        string file_path = _json_extract_string(args_json, "path")
        string resolved = tk.workspace.Resolve(file_path, true)
        if file.exists(resolved) == false then
            return ToolResult(false, "", "路径不存在: " + file_path)
        end
        file.delete(resolved)
        return ToolResult(true, "已删除: " + file_path, "")
    end
    return ToolDefinition("fs_delete", "删除文件或目录", params, handler, AGENT_PERMISSION_DESTRUCTIVE)
end

