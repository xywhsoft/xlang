extern "xm_format" func __m_format(int amount, string currency, c_size length) as point
extern "xm_symbol" func __m_symbol(string currency, c_size length) as string
extern "xm_exponent" func __m_exponent(string currency, c_size length) as int
extern "xm_add" func __m_add(int a, int b) as var
extern "xm_sub" func __m_sub(int a, int b) as var
extern "xm_mul" func __m_mul(int a, int n) as var
extern "xm_scale" func __m_scale(int amount, int numerator, int denominator) as var
extern "xm_rate" func __m_rate(int amount, c_double rate) as var
extern "xm_split" func __m_split(int amount, int n) as var



// 金额用最小货币单位的 64 位整数表示（分、円等），避免浮点误差

// format 格式化金额：已知货币带符号与千分位，未知货币输出 "XXX 1.00" 风格
export func format(int amount, string currency) as string
    c_size length = c_size(string.byteLen(currency))
    if __m_exponent(currency, length) < 0 then
        throw ValueError "money: currency must contain three ASCII letters"
    end
    point result = __m_format(amount, currency, length)
    if result == null then throw MemoryError "money: cannot format amount" end
    return __xl_runtime.takeCstr(result)
end

// symbol 返回货币符号（如 USD → $）；未知货币返回空字符串
export func symbol(string currency) as string
    c_size length = c_size(string.byteLen(currency))
    if __m_exponent(currency, length) < 0 then
        throw ValueError "money: currency must contain three ASCII letters"
    end
    return __m_symbol(currency, length)
end

// exponent 返回货币小数位数（JPY/KRW/VND 为 0，默认 2）
export func exponent(string currency) as int
    int result = __m_exponent(currency, c_size(string.byteLen(currency)))
    if result < 0 then
        throw ValueError "money: currency must contain three ASCII letters"
    end
    return result
end

// add/sub 精确加减；调用方需保证同币种
// 原生 XRT 错误会先由运行时抛出；走到空结果分支表示原生合同被破坏。
export func add(int a, int b) as int
    var result = __m_add(a, b)
    if result == null then
        throw RuntimeError "money: native add returned null without an error"
    end
    return int(result)
end

export func sub(int a, int b) as int
    var result = __m_sub(a, b)
    if result == null then
        throw RuntimeError "money: native sub returned null without an error"
    end
    return int(result)
end

// mul 金额乘整数倍数
export func mul(int a, int n) as int
    var result = __m_mul(a, n)
    if result == null then
        throw RuntimeError "money: native mul returned null without an error"
    end
    return int(result)
end

// scale 精确计算 amount * numerator / denominator，按绝对值四舍五入。
export func scale(int amount, int numerator, int denominator) as int
    if denominator == 0 then
        throw ValueError "money scale denominator is zero"
    end
    var result = __m_scale(amount, numerator, denominator)
    if result == null then
        throw RuntimeError "money: native scale returned null without an error"
    end
    return int(result)
end

// rate 按汇率换算，四舍五入到最小单位
export func rate(int amount, float rate) as int
    var result = __m_rate(amount, c_double(rate))
    if result == null then
        throw RuntimeError "money: native rate returned null without an error"
    end
    return int(result)
end

// split 把金额均分为 n 份；余数分给前几份，保证总和相等；n<=0 抛 ValueError
export func split(int amount, int n) as var
    if n <= 0 or n > 1000000 then
        throw ValueError "money: split requires 1..1000000 parts"
    end
    var r = __m_split(amount, n)
    if r == null then throw MemoryError "money: cannot allocate split result" end
    return r
end
