// gzip 使用 Buffer 表示压缩后的二进制数据。

extern "xgzip_last_error" func __gzip_error() as string
extern "xgzip_compress" func __gzip_compress(point data, c_size size, c_int level,
    c_uint mtime, c_ulonglong maxInput, c_ulonglong maxOutput) as point
extern "xgzip_compress_str" func __gzip_compress_str(string data, c_size size, c_int level,
    c_uint mtime, c_ulonglong maxInput, c_ulonglong maxOutput) as point
extern "xgzip_decompress" func __gzip_decompress(point data, c_size size,
    c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio) as point
extern "xgzip_compress_file" func __gzip_compress_file(string source, string destination,
    c_int level, c_uint mtime, c_bool overwrite, c_ulonglong maxInput,
    c_ulonglong maxOutput) as bool
extern "xgzip_decompress_file" func __gzip_decompress_file(string source, string destination,
    c_bool overwrite, c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio) as bool



func __gzip_check_level(int level)
    if level < -1 or level > 9 then
        throw ValueError "gzip level must be -1..9"
    end
end

func __gzip_check_limit(int value, string name)
    if value <= 0 then
        throw ValueError name + " must be greater than zero"
    end
end



export func compress(Buffer data, int level = -1, int mtime = 0,
    int maxInput = 268435456, int maxOutput = 536870912) as Buffer
    __gzip_check_level(level)
    __gzip_check_limit(maxInput, "maxInput")
    __gzip_check_limit(maxOutput, "maxOutput")
    if mtime < 0 then
        throw ValueError "gzip mtime must not be negative"
    end
    point result = __gzip_compress(data.data(), c_size(data.len()), c_int(level),
        c_uint(mtime), c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if result == null then
        throw CompressionError __gzip_error()
    end
    return Buffer(result)
end

export func compress(string text, int level = -1, int mtime = 0,
    int maxInput = 268435456, int maxOutput = 536870912) as Buffer
    __gzip_check_level(level)
    __gzip_check_limit(maxInput, "maxInput")
    __gzip_check_limit(maxOutput, "maxOutput")
    if mtime < 0 then
        throw ValueError "gzip mtime must not be negative"
    end
    point result = __gzip_compress_str(text, c_size(string.len(text)), c_int(level),
        c_uint(mtime), c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if result == null then
        throw CompressionError __gzip_error()
    end
    return Buffer(result)
end

export func decompress(Buffer data, int maxInput = 268435456,
    int maxOutput = 536870912, int maxRatio = 1000) as Buffer
    __gzip_check_limit(maxInput, "maxInput")
    __gzip_check_limit(maxOutput, "maxOutput")
    __gzip_check_limit(maxRatio, "maxRatio")
    point result = __gzip_decompress(data.data(), c_size(data.len()),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), c_uint(maxRatio))
    if result == null then
        throw CompressionError __gzip_error()
    end
    return Buffer(result)
end

export func decompressText(Buffer data, int maxInput = 268435456,
    int maxOutput = 536870912, int maxRatio = 1000) as string
    return decompress(data, maxInput, maxOutput, maxRatio).text()
end

export func compressFile(string source, string destination, int level = -1,
    int mtime = 0, bool overwrite = true, int maxInput = 268435456,
    int maxOutput = 536870912)
    __gzip_check_level(level)
    __gzip_check_limit(maxInput, "maxInput")
    __gzip_check_limit(maxOutput, "maxOutput")
    if mtime < 0 then
        throw ValueError "gzip mtime must not be negative"
    end
    if not __gzip_compress_file(source, destination, c_int(level), c_uint(mtime),
        c_bool(overwrite), c_ulonglong(maxInput), c_ulonglong(maxOutput)) then
        throw CompressionError __gzip_error()
    end
end

export func decompressFile(string source, string destination, bool overwrite = true,
    int maxInput = 268435456, int maxOutput = 536870912, int maxRatio = 1000)
    __gzip_check_limit(maxInput, "maxInput")
    __gzip_check_limit(maxOutput, "maxOutput")
    __gzip_check_limit(maxRatio, "maxRatio")
    if not __gzip_decompress_file(source, destination, c_bool(overwrite),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), c_uint(maxRatio)) then
        throw CompressionError __gzip_error()
    end
end



class GzipCompressor
    native point handle
    extern "xgzip_compressor_create" create(c_int level, c_uint mtime,
        c_ulonglong maxInput, c_ulonglong maxOutput)
    extern "xgzip_compressor_destroy" destroy()
    extern "xgzip_compressor_update" func updateNative(point data, c_size size) as bool
    extern "xgzip_compressor_update_str" func updateStrNative(string data, c_size size) as bool
    extern "xgzip_compressor_finish" func finishNative() as point

    get valid() as bool
        return self.handle != null
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw CompressionError __gzip_error()
        end
    end

    func update(string text)
        if not self.updateStrNative(text, c_size(string.len(text))) then
            throw CompressionError __gzip_error()
        end
    end

    func finish() as Buffer
        point result = self.finishNative()
        if result == null then
            throw CompressionError __gzip_error()
        end
        return Buffer(result)
    end
end



class GzipDecompressor
    native point handle
    extern "xgzip_decompressor_create" create(c_ulonglong maxInput,
        c_ulonglong maxOutput, c_uint maxRatio)
    extern "xgzip_decompressor_destroy" destroy()
    extern "xgzip_decompressor_update" func updateNative(point data, c_size size) as bool
    extern "xgzip_decompressor_finish" func finishNative() as point

    get valid() as bool
        return self.handle != null
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw CompressionError __gzip_error()
        end
    end

    func finish() as Buffer
        point result = self.finishNative()
        if result == null then
            throw CompressionError __gzip_error()
        end
        return Buffer(result)
    end
end



export func compressor(int level = -1, int mtime = 0,
    int maxInput = 268435456, int maxOutput = 536870912) as GzipCompressor
    __gzip_check_level(level)
    __gzip_check_limit(maxInput, "maxInput")
    __gzip_check_limit(maxOutput, "maxOutput")
    if mtime < 0 then
        throw ValueError "gzip mtime must not be negative"
    end
    GzipCompressor result = GzipCompressor(c_int(level), c_uint(mtime),
        c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if not result.valid then
        throw CompressionError __gzip_error()
    end
    return result
end

export func decompressor(int maxInput = 268435456,
    int maxOutput = 536870912, int maxRatio = 1000) as GzipDecompressor
    __gzip_check_limit(maxInput, "maxInput")
    __gzip_check_limit(maxOutput, "maxOutput")
    __gzip_check_limit(maxRatio, "maxRatio")
    GzipDecompressor result = GzipDecompressor(c_ulonglong(maxInput),
        c_ulonglong(maxOutput), c_uint(maxRatio))
    if not result.valid then
        throw CompressionError __gzip_error()
    end
    return result
end
