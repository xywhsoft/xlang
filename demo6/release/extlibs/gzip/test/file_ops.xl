import gzip

class GzipFileProgress
    int calls = 0
end

func main(...) as int
    string workDir = path.join(path.temp(), "xlang_gzip_file_" + crypto.randomString(20))
    dir.createAll(workDir)
    string source = path.join(workDir, "source.txt")
    string packed = path.join(workDir, "source.gz")
    string restored = path.join(workDir, "restored.txt")
    string cancelledPath = path.join(workDir, "cancelled.gz")
    string failedPath = path.join(workDir, "failed.gz")
    string racedPath = path.join(workDir, "raced.gz")
    string content = "你好 gzip\n" + string.repeat("gzip-file-boundary\n", 4096)
    try
        assert file.writeText(source, content)
        GzipFileProgress progress = GzipFileProgress()
        gzip.compressFile(source, packed, onProgress = func(int inputBytes,
            int totalBytes, int outputBytes) as bool
            progress.calls += 1
            return inputBytes <= totalBytes and outputBytes >= 0
        end)
        assert progress.calls > 0
        gzip.decompressFile(packed, restored)
        assert file.readText(restored) == content

        // 同一路径先读后写；只有压缩或解压全部成功才替换原文件。
        gzip.compressFile(source, source)
        gzip.decompressFile(source, source)
        assert file.readText(source) == content

        bool rejected = false
        try
            gzip.compressFile(source, packed, overwrite = false)
        catch ValueError e
            rejected = true
        end
        assert rejected and file.readText(restored) == content

        rejected = false
        try
            gzip.compressFile(source, source, overwrite = false)
        catch ValueError e
            rejected = true
        end
        assert rejected and file.readText(source) == content

        // 目标父路径是普通文件时，拒绝错误路径且不改写源文件。
        bool invalidParent = false
        try
            gzip.compressFile(source, path.join(source, "child.gz"), overwrite = false)
        catch IOError e
            invalidParent = true
        end
        assert invalidParent and file.readText(source) == content

        // 预检后才出现目标文件时，最终提交仍不能覆盖另一个写者的数据。
        bool createdDuringProgress = false
        bool raceRejected = false
        try
            gzip.compressFile(source, racedPath, overwrite = false,
                onProgress = func(int inputBytes, int totalBytes, int outputBytes) as bool
                if not createdDuringProgress then
                    assert file.writeText(racedPath, "other writer")
                    createdDuringProgress = true
                end
                return true
            end)
        catch ValueError e
            raceRejected = true
        end
        assert createdDuringProgress and raceRejected
        assert file.readText(racedPath) == "other writer"
        assert file.readText(source) == content

        bool cancelled = false
        try
            gzip.compressFile(source, cancelledPath, onProgress = func(int inputBytes,
                int totalBytes, int outputBytes) as bool
                return false
            end)
        catch CancelledError e
            cancelled = true
        end
        assert cancelled and not file.exists(cancelledPath)

        bool callbackError = false
        try
            gzip.compressFile(source, failedPath, onProgress = func(int inputBytes,
                int totalBytes, int outputBytes) as bool
                throw ValueError "progress callback failed"
            end)
        catch ValueError e
            callbackError = e.message == "progress callback failed"
        end
        assert callbackError and not file.exists(failedPath)

        callbackError = false
        try
            gzip.decompressFile(packed, restored, onProgress = func(int inputBytes,
                int totalBytes, int outputBytes) as bool
                throw ValueError "decompress progress failed"
            end)
        catch ValueError e
            callbackError = e.message == "decompress progress failed"
        end
        assert callbackError and file.readText(restored) == content

        bool limited = false
        try
            gzip.decompressFile(packed, restored, maxOutput = 8)
        catch RangeError e
            limited = true
        end
        assert limited and file.readText(restored) == content
    finally
        if file.exists(source) then assert file.delete(source) end
        if file.exists(packed) then assert file.delete(packed) end
        if file.exists(restored) then assert file.delete(restored) end
        if file.exists(cancelledPath) then assert file.delete(cancelledPath) end
        if file.exists(failedPath) then assert file.delete(failedPath) end
        if file.exists(racedPath) then assert file.delete(racedPath) end
        assert dir.delete(workDir), "temporary gzip directory must be removed"
    end
    println("gzip file operations: PASS")
    return 0
end
