export func normalize_response(string action, string raw) as Response
	int status = volc.core.last_status()
	return __phone_normalize_response(action, raw, status, volc.core.last_error())
end

export func response_json(string action, string raw) as string
	Response response = normalize_response(action, raw)
	return response.to_json()
end

