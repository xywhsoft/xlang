import volc.core

const string ACEP_HOST = "open.volcengineapi.com"
const string ACEP_SERVICE = "ACEP"
const string DEFAULT_REGION = "cn-north-1"
const string DEFAULT_VERSION = "2023-10-30"
const string RECORDING_VERSION = "2025-05-01"
const string JSON_CONTENT_TYPE = "application/json"

func bool_text(bool value) as string
	if value then
		return "true"
	end
	return "false"
end
class Client
	string access_key
	string secret_key
	string session_token
	string product_id
	int timeout_ms

	create()
		self.access_key = ""
		self.secret_key = ""
		self.session_token = ""
		self.product_id = ""
		self.timeout_ms = 30000
	end

	create(string access_key, string secret_key, string product_id)
		self.access_key = access_key
		self.secret_key = secret_key
		self.session_token = ""
		self.product_id = product_id
		self.timeout_ms = 30000
	end

	create(string access_key, string secret_key, string session_token, string product_id)
		self.access_key = access_key
		self.secret_key = secret_key
		self.session_token = session_token
		self.product_id = product_id
		self.timeout_ms = 30000
	end

	func set_timeout(int timeout_ms) as bool
		self.timeout_ms = timeout_ms
		return true
	end

	func set_session_token(string session_token) as bool
		self.session_token = session_token
		return true
	end

	func call(string action, string version, string body) as Response
		string raw = raw_call(self.access_key, self.secret_key, self.session_token, action, version, body, self.timeout_ms)
		return normalize_response(action, raw)
	end

	func call_default(string action, string body) as Response
		string raw = raw_call(self.access_key, self.secret_key, self.session_token, action, "2023-10-30", body, self.timeout_ms)
		return normalize_response(action, raw)
	end

	func list_pods() as Response
		string spec = "action=ListPod\nversion=2023-10-30\naccess_key=" + self.access_key + "\nsecret_key=" + self.secret_key + "\nsession_token=" + self.session_token + "\nbody=" + product_body(self.product_id) + "\ntimeout_ms=" + string.format(self.timeout_ms, "")
		return normalize_response("ListPod", phone_request_acep_spec(spec))
	end

	func list_hosts() as Response
		string spec = "action=ListHost\nversion=2023-10-30\naccess_key=" + self.access_key + "\nsecret_key=" + self.secret_key + "\nsession_token=" + self.session_token + "\nbody=" + product_body(self.product_id) + "\ntimeout_ms=" + string.format(self.timeout_ms, "")
		return normalize_response("ListHost", phone_request_acep_spec(spec))
	end

	func list_dcs() as Response
		string spec = "action=ListDc\nversion=2023-10-30\naccess_key=" + self.access_key + "\nsecret_key=" + self.secret_key + "\nsession_token=" + self.session_token + "\nbody=" + product_body(self.product_id) + "\ntimeout_ms=" + string.format(self.timeout_ms, "")
		return normalize_response("ListDc", phone_request_acep_spec(spec))
	end

	func detail_pod(string pod_id) as Response
		return normalize_response("DetailPod", detail_pod(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, self.timeout_ms))
	end

	func detail_host(string host_id) as Response
		return normalize_response("DetailHost", detail_host(self.access_key, self.secret_key, self.session_token, self.product_id, host_id, self.timeout_ms))
	end

	func create_pod(string dc, string configuration_code, int resource_type, string host_id, string pod_name, string display_layout_id, bool start) as Response
		return normalize_response("CreatePod", create_pod(self.access_key, self.secret_key, self.session_token, self.product_id, dc, configuration_code, resource_type, host_id, pod_name, display_layout_id, start, self.timeout_ms))
	end

	func create_pod_batch(string dc, string configuration_code, int apply_num, int resource_type, string host_id, string pod_name, string display_layout_id, bool start) as Response
		return normalize_response("CreatePod", create_pod_batch(self.access_key, self.secret_key, self.session_token, self.product_id, dc, configuration_code, apply_num, resource_type, host_id, pod_name, display_layout_id, start, self.timeout_ms))
	end

	func delete_pod(string pod_id) as Response
		return normalize_response("DeletePod", delete_pod(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, self.timeout_ms))
	end

	func power_on(string pod_id) as Response
		return normalize_response("PowerOnPod", power_on(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, self.timeout_ms))
	end

	func power_off(string pod_id) as Response
		return normalize_response("PowerOffPod", power_off(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, self.timeout_ms))
	end

	func reboot(string pod_id) as Response
		return normalize_response("RebootPod", reboot(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, self.timeout_ms))
	end

	func reset(string pod_id) as Response
		return normalize_response("ResetPod", reset(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, self.timeout_ms))
	end

	func pod_adb(string pod_id, bool enable) as Response
		return normalize_response("PodAdb", pod_adb(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, enable, self.timeout_ms))
	end

	func run_command(string pod_id, string command) as Response
		return normalize_response("RunCommand", run_command(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, command, self.timeout_ms))
	end

	func run_sync_command(string pod_id, string command) as Response
		return normalize_response("RunSyncCommand", run_sync_command(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, command, self.timeout_ms))
	end

	func install_app(string pod_id, string app_id, string version_id) as Response
		return normalize_response("InstallApp", install_app(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, app_id, version_id, self.timeout_ms))
	end

	func launch_app(string pod_id, string package_name) as Response
		return normalize_response("LaunchApp", launch_app(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, package_name, self.timeout_ms))
	end

	func close_app(string pod_id, string package_name) as Response
		return normalize_response("CloseApp", close_app(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, package_name, self.timeout_ms))
	end

	func get_task_info(string task_id) as Response
		return normalize_response("GetTaskInfo", get_task_info(self.access_key, self.secret_key, self.session_token, self.product_id, task_id, self.timeout_ms))
	end

	func wait_task(string task_id, int timeout_ms, int poll_interval_ms) as Response
		return normalize_response("GetTaskInfo", wait_task(self.access_key, self.secret_key, self.session_token, self.product_id, task_id, timeout_ms, poll_interval_ms))
	end

	func screenshot(string pod_id, string round_id) as Response
		return normalize_response("ScreenShot", screenshot(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, round_id, self.timeout_ms))
	end

	func batch_screenshot(string pod_id_list_json, string round_id) as Response
		return normalize_response("BatchScreenShot", batch_screenshot(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id_list_json, round_id, self.timeout_ms))
	end

	func start_recording(string pod_id, string round_id, int duration_limit, bool saved_on_pod) as Response
		return normalize_response("StartRecording", start_recording(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, round_id, duration_limit, saved_on_pod, self.timeout_ms))
	end

	func stop_recording(string pod_id) as Response
		return normalize_response("StopRecording", stop_recording(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, self.timeout_ms))
	end

	func push_file(string pod_id, string local_path, string remote_path) as Response
		return normalize_response("PushFile", push_file(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, local_path, remote_path, self.timeout_ms))
	end

	func pull_file(string pod_id, string remote_path, string local_path) as Response
		return normalize_response("PullFile", pull_file(self.access_key, self.secret_key, self.session_token, self.product_id, pod_id, remote_path, local_path, self.timeout_ms))
	end
end

export func last_error() as string
	return volc.core.last_error()
end

export func available() as bool
	return string.len(volc.core.version()) > 0
end

export func version() as string
	return "0.1.0"
end

func phone_spec_dry_run(string spec) as bool
	if string.contains(spec, "dry_run=true") or string.contains(spec, "dry_run=1") then
		return true
	end
	if string.contains(spec, "timeout_ms=0") or string.contains(spec, "timeout_ms=-") then
		return true
	end
	return false
end

func phone_request_acep_spec(string spec) as string
	if phone_spec_dry_run(spec) then
		return volc.core.sign_preview_acep_spec(spec)
	end
	return volc.core.request_acep_spec(spec)
end

export func call_spec(string spec) as Response
	return normalize_response("ACEP", phone_request_acep_spec(spec))
end

export func raw_spec(string spec) as string
	return phone_request_acep_spec(spec)
end

export func client(string access_key, string secret_key, string product_id) as Client
	return Client(access_key, secret_key, product_id)
end

export func client_token(string access_key, string secret_key, string session_token, string product_id) as Client
	return Client(access_key, secret_key, session_token, product_id)
end

export func raw_call(string access_key, string secret_key, string session_token, string action, string version, string body, int timeout_ms) as string
	string spec = "action=" + action + "\nversion=" + version + "\naccess_key=" + access_key + "\nsecret_key=" + secret_key + "\nsession_token=" + session_token + "\nbody=" + body + "\ntimeout_ms=" + string.format(timeout_ms, "")
	return phone_request_acep_spec(spec)
end

export func call(string access_key, string secret_key, string session_token, string action, string version, string body, int timeout_ms) as string
	return raw_call(access_key, secret_key, session_token, action, version, body, timeout_ms)
end

export func call_default(string access_key, string secret_key, string session_token, string action, string body, int timeout_ms) as string
	return raw_call(access_key, secret_key, session_token, action, "2023-10-30", body, timeout_ms)
end

export func product_body(string product_id) as string
	return "{\"ProductId\":" + volc.core.json_string(product_id) + "}"
end

export func pod_body(string product_id, string pod_id) as string
	return "{\"ProductId\":" + volc.core.json_string(product_id) + ",\"PodId\":" + volc.core.json_string(pod_id) + "}"
end

export func create_pod_body(string product_id, string dc, string configuration_code, int resource_type, string host_id, string pod_name, string display_layout_id, bool start) as string
	return "{\"ProductId\":" + volc.core.json_string(product_id) + ",\"ResourceType\":" + string.format(resource_type, "") + ",\"PodName\":" + volc.core.json_string(pod_name) + ",\"HostId\":" + volc.core.json_string(host_id) + ",\"ConfigurationCode\":" + volc.core.json_string(configuration_code) + ",\"Dc\":" + volc.core.json_string(dc) + ",\"DisplayLayoutId\":" + volc.core.json_string(display_layout_id) + ",\"UpBandwidthLimit\":0,\"DownBandwidthLimit\":0,\"Start\":" + bool_text(start) + "}"
end

export func create_pod_batch_body(string product_id, string dc, string configuration_code, int apply_num, int resource_type, string host_id, string pod_name, string display_layout_id, bool start) as string
	string spec = "{\"ApplyNum\":" + string.format(apply_num, "") + ",\"Dc\":" + volc.core.json_string(dc) + ",\"ConfigurationCode\":" + volc.core.json_string(configuration_code) + ",\"HostId\":" + volc.core.json_string(host_id) + ",\"PodName\":" + volc.core.json_string(pod_name) + ",\"DisplayLayoutId\":" + volc.core.json_string(display_layout_id) + ",\"UpBandwidthLimit\":0,\"DownBandwidthLimit\":0,\"Start\":" + bool_text(start) + "}"
	return "{\"ProductId\":" + volc.core.json_string(product_id) + ",\"ResourceType\":" + string.format(resource_type, "") + ",\"PodSpecList\":[" + spec + "]}"
end

