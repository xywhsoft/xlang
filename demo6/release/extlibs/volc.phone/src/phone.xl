export func get_task_info(string access_key, string secret_key, string session_token, string product_id, string task_id, int timeout_ms) as string
	string body = "{\"ProductId\":" + volc.core.json_string(product_id) + ",\"TaskId\":" + volc.core.json_string(task_id) + "}"
	return call_default(access_key, secret_key, session_token, "GetTaskInfo", body, timeout_ms)
end

export func wait_task(string access_key, string secret_key, string session_token, string product_id, string task_id, int timeout_ms, int poll_interval_ms) as string
	if timeout_ms <= 0 then
		return get_task_info(access_key, secret_key, session_token, product_id, task_id, timeout_ms)
	end
	int elapsed = 0
	int interval = poll_interval_ms
	if interval <= 0 then
		interval = 3000
	end
	while elapsed <= timeout_ms
		string info = get_task_info(access_key, secret_key, session_token, product_id, task_id, interval)
		string state = task_state(info)
		if state == "success" or state == "failed" then
			return info
		end
		time.sleep(interval)
		elapsed = elapsed + interval
	end
	return get_task_info(access_key, secret_key, session_token, product_id, task_id, interval)
end

