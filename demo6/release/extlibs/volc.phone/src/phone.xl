export func recording_download_url(string raw) as string
	string value = json_string_field(raw, "DownloadUrl")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "DownloadURL")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "DownloadLink")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "DownloadUri")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "DownloadURI")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "RecordUrl")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "RecordURL")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "RecordingUrl")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "RecordingURL")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "VideoUrl")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "VideoURL")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "FileUrl")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "FileURL")
	if value != "" then
		return value
	end
	value = json_string_field(raw, "Url")
	if value != "" then
		return value
	end
	return json_string_field(raw, "URL")
end

export func pod_adb_endpoint(string detail_pod_json) as string
	if json_int_field(detail_pod_json, "AdbStatus") != 1 then
		return ""
	end
	return json_string_field(detail_pod_json, "Adb")
end

export func pod_run_state(string detail_pod_json) as int
	return json_int_field(detail_pod_json, "Online")
end

export func host_remain_text(string detail_host_json) as string
	int available = json_int_field(detail_host_json, "PodNumAvailable")
	int on_host = json_int_field(detail_host_json, "PodNumOnHost")
	return string.format(on_host, "") + "," + string.format(available - on_host, "")
end

export func push_file(string access_key, string secret_key, string session_token, string product_id, string pod_id, string local_path, string remote_path, int timeout_ms) as string
	return call_default(access_key, secret_key, session_token, "PushFile", file_body(product_id, pod_id, local_path, remote_path), timeout_ms)
end

export func pull_file(string access_key, string secret_key, string session_token, string product_id, string pod_id, string remote_path, string local_path, int timeout_ms) as string
	return call_default(access_key, secret_key, session_token, "PullFile", pull_file_body(product_id, pod_id, remote_path, local_path), timeout_ms)
end


























































