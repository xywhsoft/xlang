extern "xceres_solver_type" func __solver_type(int id) as string
extern "xceres_loss_function" func __loss_function(int id) as string
extern "xceres_termination" func __termination(int id) as string
extern "xceres_parameterization" func __parameterization(int id) as string
extern "xceres_sqrt_newton" func __sqrt_newton(float target) as float
extern "xceres_linear_fit" func __linear_fit(string points) as string
extern "xceres_ordering_type" func __ordering_type(int id) as string

export func solverType(int id) as string
    return __solver_type(id)
end

export func lossFunction(int id) as string
    return __loss_function(id)
end

export func termination(int id) as string
    return __termination(id)
end

export func parameterization(int id) as string
    return __parameterization(id)
end

export func sqrtNewton(float target) as float
    return __sqrt_newton(target)
end

export func linearFit(string points) as string
    return __linear_fit(points)
end

export func orderingType(int id) as string
    return __ordering_type(id)
end
