// lzma 的压缩结果和输入统一使用 Buffer，避免二进制数据经过字符串转换。
extern "xl6_xrt_last_error_text" func __lzma_error() as string
extern "xlzma_version" func __lzma_version() as string
extern "xlzma_compress" func __lzma_compress(point data, c_size size, c_int level,
    c_ulonglong maxInput, c_ulonglong maxOutput) as point
extern "xlzma_compress_str" func __lzma_compress_str(string data, c_size size, c_int level,
    c_ulonglong maxInput, c_ulonglong maxOutput) as point
extern "xlzma_decompress" func __lzma_decompress(point data, c_size size,
    c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio) as point
extern "xlzma_compress_file" func __lzma_compress_file(string source, string destination,
    c_int level, c_bool overwrite, c_ulonglong maxInput, c_ulonglong maxOutput,
    var onProgress) as c_int
extern "xlzma_decompress_file" func __lzma_decompress_file(string source, string destination,
    c_bool overwrite, c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio,
    var onProgress) as c_int



// 压缩级别常量（LZMA 调优维度：0 最快、9 压缩率最高，5 为默认平衡点）。
export const int LZMA_MIN_LEVEL = 0
export const int LZMA_MAX_LEVEL = 9
export const int LZMA_DEFAULT_LEVEL = 5



// 返回内嵌 LZMA SDK 的版本标识。
export func version() as string
    return __lzma_version()
end

func __lzma_check_level(int level)
    if level < LZMA_MIN_LEVEL or level > LZMA_MAX_LEVEL then
        throw ValueError "lzma level must be 0..9"
    end
end

func __lzma_check_limit(int value, string name)
    if value <= 0 then
        throw ValueError name + " must be greater than zero"
    end
end

func __lzma_file_path(string value)
    if string.indexOf(value, "\0", false, string.byteLen(value), 1) >= 0 then
        throw ValueError "lzma file path contains NUL"
    end
end

// C 计数器和进度均为无符号 64 位，语言公开 int 前先检查范围。
func __lzma_count(c_ulonglong value) as int
    if value > c_ulonglong(9223372036854775807) then
        throw RangeError "lzma byte count exceeds int range"
    end
    return int(value)
end

func __lzma_progress(func(int, int, int) as bool callback) as var
    return xcall(func(uint64 inputBytes, uint64 totalBytes, uint64 outputBytes) as bool
        return callback(__lzma_count(c_ulonglong(inputBytes)),
            __lzma_count(c_ulonglong(totalBytes)), __lzma_count(c_ulonglong(outputBytes)))
    end)
end

func __lzma_check_file_result(int status)
    if status == -1 then
        throw CancelledError "lzma operation cancelled"
    elseif status != 1 then
        throw CompressionError __lzma_error()
    end
end



export func compress(Buffer data, int level = LZMA_DEFAULT_LEVEL,
    int maxInput = 268435456, int maxOutput = 536870912) as Buffer
    __lzma_check_level(level)
    __lzma_check_limit(maxInput, "maxInput")
    __lzma_check_limit(maxOutput, "maxOutput")
    point result = __lzma_compress(data.data(), c_size(data.len()), c_int(level),
        c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if result == null then
        throw CompressionError __lzma_error()
    end
    return Buffer(result)
end

export func compress(string text, int level = LZMA_DEFAULT_LEVEL,
    int maxInput = 268435456, int maxOutput = 536870912) as Buffer
    __lzma_check_level(level)
    __lzma_check_limit(maxInput, "maxInput")
    __lzma_check_limit(maxOutput, "maxOutput")
    point result = __lzma_compress_str(text, c_size(string.byteLen(text)), c_int(level),
        c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if result == null then
        throw CompressionError __lzma_error()
    end
    return Buffer(result)
end

export func decompress(Buffer data, int maxInput = 268435456,
    int maxOutput = 536870912, int maxRatio = 1000) as Buffer
    __lzma_check_limit(maxInput, "maxInput")
    __lzma_check_limit(maxOutput, "maxOutput")
    __lzma_check_limit(maxRatio, "maxRatio")
    if maxRatio > 4294967295 then
        throw RangeError "lzma maxRatio must fit uint32"
    end
    point result = __lzma_decompress(data.data(), c_size(data.len()),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), c_uint(maxRatio))
    if result == null then
        throw CompressionError __lzma_error()
    end
    return Buffer(result)
end

export func decompressText(Buffer data, int maxInput = 268435456,
    int maxOutput = 536870912, int maxRatio = 1000) as string
    return decompress(data, maxInput, maxOutput, maxRatio).text()
end

export func compressFile(string source, string destination,
    int level = LZMA_DEFAULT_LEVEL, bool overwrite = true,
    int maxInput = 268435456, int maxOutput = 536870912,
    (func(int, int, int) as bool)? onProgress = null)
    __lzma_file_path(source)
    __lzma_file_path(destination)
    __lzma_check_level(level)
    __lzma_check_limit(maxInput, "maxInput")
    __lzma_check_limit(maxOutput, "maxOutput")
    var progress = null
    if onProgress != null then
        progress = __lzma_progress(onProgress)
    end
    int status = __lzma_compress_file(source, destination, c_int(level), c_bool(overwrite),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), progress)
    __lzma_check_file_result(status)
end

export func decompressFile(string source, string destination, bool overwrite = true,
    int maxInput = 268435456, int maxOutput = 536870912, int maxRatio = 1000,
    (func(int, int, int) as bool)? onProgress = null)
    __lzma_file_path(source)
    __lzma_file_path(destination)
    __lzma_check_limit(maxInput, "maxInput")
    __lzma_check_limit(maxOutput, "maxOutput")
    __lzma_check_limit(maxRatio, "maxRatio")
    if maxRatio > 4294967295 then
        throw RangeError "lzma maxRatio must fit uint32"
    end
    var progress = null
    if onProgress != null then
        progress = __lzma_progress(onProgress)
    end
    int status = __lzma_decompress_file(source, destination, c_bool(overwrite),
        c_ulonglong(maxInput), c_ulonglong(maxOutput), c_uint(maxRatio), progress)
    __lzma_check_file_result(status)
end



// 增量压缩器：update() 喂入数据，finish() 编码为一条标准 .xz 流。
// 对象暂存全部输入，finish() 前 drain() 返回空缓冲区；大文件使用 compressFile()。
export class LzmaCompressor
    native point handle
    extern "xlzma_compressor_create" create(c_int level, c_ulonglong maxInput, c_ulonglong maxOutput)
    extern "xlzma_compressor_destroy" destroy()
    private extern "xlzma_compressor_update" func updateNative(point data, c_size size) as bool
    private extern "xlzma_compressor_update_str" func updateStrNative(string data, c_size size) as bool
    private extern "xlzma_compressor_finish" func finishNative() as bool
    private extern "xlzma_compressor_drain" func drainNative() as point
    private extern "xlzma_compressor_input_bytes" func inputBytesNative() as c_ulonglong
    private extern "xlzma_compressor_output_bytes" func outputBytesNative() as c_ulonglong

    get valid() as bool
        return self.handle != null
    end

    // 已喂入的原始字节数（进度回显用）。
    get inputBytes() as int
        return __lzma_count(self.inputBytesNative())
    end

    // 已产出的压缩字节数（进度回显用）。
    get outputBytes() as int
        return __lzma_count(self.outputBytesNative())
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw CompressionError __lzma_error()
        end
    end

    func update(string text)
        if not self.updateStrNative(text, c_size(string.byteLen(text))) then
            throw CompressionError __lzma_error()
        end
    end

    // 取走当前已产出的压缩字节并清空内部输出缓冲；无数据时返回空 Buffer。
    func drain() as Buffer
        point result = self.drainNative()
        if result == null then
            throw CompressionError __lzma_error()
        end
        return Buffer(result)
    end

    // 编码并封存完整压缩流；返回后 drain() 可取走压缩字节。
    func finish() as bool
        if not self.finishNative() then
            throw CompressionError __lzma_error()
        end
        return true
    end
end



// 增量流式解压器：update() 喂入压缩字节，drain() 随时取走已解压数据，
// finished 反映当前成员是否结束，members 统计已完整解出的成员数（支持串联多成员流）。
export class LzmaDecompressor
    native point handle
    extern "xlzma_decompressor_create" create(c_ulonglong maxInput, c_ulonglong maxOutput, c_uint maxRatio)
    extern "xlzma_decompressor_destroy" destroy()
    private extern "xlzma_decompressor_update" func updateNative(point data, c_size size) as bool
    private extern "xlzma_decompressor_finish" func finishNative() as bool
    private extern "xlzma_decompressor_drain" func drainNative() as point
    private extern "xlzma_decompressor_input_bytes" func inputBytesNative() as c_ulonglong
    private extern "xlzma_decompressor_output_bytes" func outputBytesNative() as c_ulonglong
    private extern "xlzma_decompressor_finished" func finishedNative() as bool
    private extern "xlzma_decompressor_members" func membersNative() as c_ulonglong

    get valid() as bool
        return self.handle != null
    end

    // 已喂入的压缩字节数（进度回显用）。
    get inputBytes() as int
        return __lzma_count(self.inputBytesNative())
    end

    // 已产出的解压字节数（进度回显用）。
    get outputBytes() as int
        return __lzma_count(self.outputBytesNative())
    end

    // 当前成员是否已完整解出（流结束时为 true）。
    get finished() as bool
        return self.finishedNative()
    end

    // 已完整解出的流数；大于 1 表示输入是串联的多个 xz 流。
    get members() as int
        return __lzma_count(self.membersNative())
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw CompressionError __lzma_error()
        end
    end

    // 取走当前已解压的数据并清空内部输出缓冲；无数据时返回空 Buffer。
    func drain() as Buffer
        point result = self.drainNative()
        if result == null then
            throw CompressionError __lzma_error()
        end
        return Buffer(result)
    end

    // 校验流已完整结束；截断或空流通过 XRT 错误映射为 IOError。
    func finish() as bool
        if not self.finishNative() then
            throw CompressionError __lzma_error()
        end
        return true
    end
end



export func compressor(int level = LZMA_DEFAULT_LEVEL,
    int maxInput = 268435456, int maxOutput = 536870912) as LzmaCompressor
    __lzma_check_level(level)
    __lzma_check_limit(maxInput, "maxInput")
    __lzma_check_limit(maxOutput, "maxOutput")
    LzmaCompressor result = LzmaCompressor(c_int(level),
        c_ulonglong(maxInput), c_ulonglong(maxOutput))
    if not result.valid then
        throw CompressionError __lzma_error()
    end
    return result
end

export func decompressor(int maxInput = 268435456, int maxOutput = 536870912,
    int maxRatio = 1000) as LzmaDecompressor
    __lzma_check_limit(maxInput, "maxInput")
    __lzma_check_limit(maxOutput, "maxOutput")
    __lzma_check_limit(maxRatio, "maxRatio")
    if maxRatio > 4294967295 then
        throw RangeError "lzma maxRatio must fit uint32"
    end
    LzmaDecompressor result = LzmaDecompressor(c_ulonglong(maxInput),
        c_ulonglong(maxOutput), c_uint(maxRatio))
    if not result.valid then
        throw CompressionError __lzma_error()
    end
    return result
end
