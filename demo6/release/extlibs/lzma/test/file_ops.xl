import lzma

class LzmaFileProgress
    int calls = 0
    int lastInput = 0
end

func main(...) as int
    string workDir = path.join(path.temp(), "xlang_lzma_file_" + crypto.randomString(20))
    dir.createAll(workDir)
    string source = path.join(workDir, "source.txt")
    string packed = path.join(workDir, "source.xz")
    string restored = path.join(workDir, "restored.txt")
    string cancelledPath = path.join(workDir, "cancelled.xz")
    string content = "你好 xlang\n" + string.repeat("xz-file-boundary\n", 4096)
    try
        assert file.writeText(source, content)

        LzmaFileProgress encode = LzmaFileProgress()
        lzma.compressFile(source, packed, onProgress = func(int inputBytes,
            int totalBytes, int outputBytes) as bool
            encode.calls += 1
            encode.lastInput = inputBytes
            return inputBytes <= totalBytes and outputBytes >= 0
        end)
        assert encode.calls > 0 and encode.lastInput == string.byteLen(content)

        LzmaFileProgress decode = LzmaFileProgress()
        lzma.decompressFile(packed, restored, onProgress = func(int inputBytes,
            int totalBytes, int outputBytes) as bool
            decode.calls += 1
            decode.lastInput = inputBytes
            return inputBytes <= totalBytes and outputBytes >= 0
        end)
        assert decode.calls > 0 and decode.lastInput > 0
        assert file.readText(restored) == content

        bool rejected = false
        try
            lzma.compressFile(source, packed, overwrite = false)
        catch ValueError e
            rejected = true
        end
        assert rejected and file.readText(restored) == content

        bool cancelled = false
        try
            lzma.compressFile(source, cancelledPath, onProgress = func(int inputBytes,
                int totalBytes, int outputBytes) as bool
                return false
            end)
        catch CancelledError e
            cancelled = true
        end
        assert cancelled and not file.exists(cancelledPath)

        bool limited = false
        try
            lzma.decompressFile(packed, restored, maxOutput = 8)
        catch RangeError e
            limited = true
        end
        assert limited and file.readText(restored) == content
    finally
        if file.exists(source) then assert file.delete(source) end
        if file.exists(packed) then assert file.delete(packed) end
        if file.exists(restored) then assert file.delete(restored) end
        if file.exists(cancelledPath) then assert file.delete(cancelledPath) end
        assert dir.delete(workDir), "temporary lzma directory must be removed"
    end
    println("lzma file operations: PASS")
    return 0
end
