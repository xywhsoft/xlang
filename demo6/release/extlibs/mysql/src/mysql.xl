extern "xmysql_cmd_name" func __cmd_name(int cmd) as string
extern "xmysql_col_type" func __col_type(int type) as string
extern "xmysql_status_str" func __status_str(int status) as string
extern "xmysql_cap_name" func __cap_name(int cap) as string
extern "xmysql_escape" func __escape(string input) as string
extern "xmysql_format_dsn" func __format_dsn(string host, int port, string dbname, string user) as string
extern "xmysql_dsn_part" func __dsn_part(string dsn, string part) as string
extern "xmysql_error_class" func __error_class(int code) as string

export func cmdName(int cmd) as string
    return __cmd_name(cmd)
end

export func colType(int type) as string
    return __col_type(type)
end

export func statusStr(int status) as string
    return __status_str(status)
end

export func capName(int cap) as string
    return __cap_name(cap)
end

export func escape(string input) as string
    return __escape(input)
end

export func formatDsn(string host, int port, string dbname, string user) as string
    return __format_dsn(host, port, dbname, user)
end

export func dsnPart(string dsn, string part) as string
    return __dsn_part(dsn, part)
end

export func errorClass(int code) as string
    return __error_class(code)
end
