func __xl6_import_x_mail_imap_available() as bool
    return true
end

func __xl6_import_x_mail_imap_version() as string
    return "0.1.0"
end

func __xl6_import_x_mail_imap_last_error() as string
    return ""
end

func mail_imap_dry_run_text(string text) as bool
    string compact = string.replace(text, " ", "")
    compact = string.replace(compact, "\t", "")
    compact = string.replace(compact, "\r", "")
    compact = string.replace(compact, "\n", "")
    if string.contains(compact, "\"dry_run\":true") or string.contains(compact, "\"dry_run\":1") then
        return true
    end
    if string.contains(compact, "\"timeout_ms\":0") or string.contains(compact, "\"timeout_ms\":-") then
        return true
    end
    return false
end

func mail_imap_dry_run(var value) as bool
    return mail_imap_dry_run_text(json.stringify(value))
end

func mail_imap_preview(string operation, var payload) as var
    var commands = ["LOGOUT"]
    if operation == "capability" then
        commands = ["CAPABILITY", "LOGOUT"]
    end
    if operation == "status" then
        commands = ["STATUS", "LOGOUT"]
    end
    if operation == "list" then
        commands = ["LIST", "LOGOUT"]
    end
    if operation == "search" then
        commands = ["SELECT", "SEARCH", "LOGOUT"]
    end
    if operation == "fetch" then
        commands = ["SELECT", "FETCH", "LOGOUT"]
    end
    if operation == "bodystructure" then
        commands = ["SELECT", "FETCH BODYSTRUCTURE", "LOGOUT"]
    end
    if operation == "fetch_flags" then
        commands = ["SELECT", "FETCH FLAGS", "LOGOUT"]
    end
    if operation == "store_flags" then
        commands = ["SELECT", "STORE FLAGS", "LOGOUT"]
    end
    if operation == "expunge" then
        commands = ["SELECT", "EXPUNGE", "LOGOUT"]
    end
    if operation == "idle_probe" then
        commands = ["SELECT", "IDLE", "DONE", "LOGOUT"]
    end
    if operation == "idle" then
        commands = ["SELECT", "IDLE", "DONE", "LOGOUT"]
    end
    if operation == "watch" then
        commands = ["SELECT", "IDLE", "DONE", "LOGOUT"]
    end
    return mail.mime.result(true, "", "dry_run", {
        "dry_run": true,
        "operation": operation,
        "commands": commands,
        "payload": payload
    })
end

func mail_imap_preview_json(string operation, string payload_json) as string
    return json.stringify(mail_imap_preview(operation, {"payload_json": payload_json}))
end

func __xl6_import_x_mail_imap_result(bool ok, string error, string stage, var data) as var
    return mail.mime.result(ok, error, stage, data)
end

func __xl6_import_x_mail_imap_capability(var request) as var
    if mail_imap_dry_run(request) then
        return mail_imap_preview("capability", request)
    end
    return json.parse(xmail_imap_capability_json_native(json.stringify(request)))
end

