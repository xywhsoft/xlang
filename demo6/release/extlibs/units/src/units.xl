extern "xu_bytes" func __u_bytes(float n) as point
extern "xu_bytes_decimal" func __u_bytes_decimal(float n) as point
extern "xu_parse_bytes" func __u_parse_bytes(string text, c_longlong length) as float
extern "xu_duration" func __u_duration(float seconds) as point
extern "xu_duration_short" func __u_duration_short(float seconds) as point
extern "xu_parse_duration" func __u_parse_duration(string text, c_longlong length) as float
extern "xu_count" func __u_count(float n) as point
extern "xu_is_pow2" func __u_is_pow2(int n) as c_int
extern "xl6_xrt_last_error_text" func __u_error() as string

export func bytes(float n) as string
    point result = __u_bytes(n)
    if result == null then throw ValueError __u_error() end
    return __xl_runtime.takeCstr(result)
end

export func bytesDecimal(float n) as string
    point result = __u_bytes_decimal(n)
    if result == null then throw ValueError __u_error() end
    return __xl_runtime.takeCstr(result)
end

export func parseBytes(string text) as float
    float result = __u_parse_bytes(text, c_longlong(string.byteLen(text)))
    if math.isNaN(result) then throw ValueError __u_error() end
    return result
end

export func duration(float seconds) as string
    point result = __u_duration(seconds)
    if result == null then throw ValueError __u_error() end
    return __xl_runtime.takeCstr(result)
end

export func durationShort(float seconds) as string
    point result = __u_duration_short(seconds)
    if result == null then throw ValueError __u_error() end
    return __xl_runtime.takeCstr(result)
end

export func parseDuration(string text) as float
    float result = __u_parse_duration(text, c_longlong(string.byteLen(text)))
    if math.isNaN(result) then throw ValueError __u_error() end
    return result
end

export func count(float n) as string
    point result = __u_count(n)
    if result == null then throw ValueError __u_error() end
    return __xl_runtime.takeCstr(result)
end

export func isPow2(int n) as bool
    return __u_is_pow2(n) == 1
end
