import units

assert units.bytes(1536.0) == "1.50 KiB"
assert units.bytes(-0.0) == "0 B"
assert units.bytes(-0.4) == "0 B"
assert units.bytes(-0.6) == "-1 B"
assert units.bytes(1023.9) == "1.00 KiB"
assert units.bytes(1048575.0) == "1.00 MiB"
assert units.bytes(-1048575.0) == "-1.00 MiB"
assert units.bytesDecimal(1500.0) == "1.50 kB"
assert units.bytesDecimal(-0.4) == "0 B"
assert units.bytesDecimal(999.9) == "1.00 kB"
assert units.bytesDecimal(999999.0) == "1.00 MB"
assert units.count(999.96) == "1.0K"
assert units.count(999960.0) == "1.0M"
assert units.count(-999960.0) == "-1.0M"
assert units.count(-0.4) == "0"
assert units.count(-0.6) == "-1"
assert units.parseBytes("1.50 KiB") == 1536.0
assert units.parseBytes("1.50 kB") == 1500.0
assert units.parseBytes("-1 B") == -1.0
assert units.duration(-3725.0) == "-1h 2m 5s"
assert units.durationShort(-3725.0) == "-1:02:05"
assert units.parseDuration("-1h30m") == -5400.0
assert units.parseDuration("-1") == -1.0
assert units.duration(59.6) == "1m"
for i in range(200)
    int seconds = i * 987654321
    if i % 2 == 1 then seconds = -seconds end
    assert units.parseDuration(units.duration(float(seconds))) == float(seconds)
end
assert units.isPow2(64) and not units.isPow2(63)

int rejected = 0
try
    units.parseBytes("1K")
catch ValueError error
    rejected += 1
end
try
    units.parseBytes("1e3B")
catch ValueError error
    rejected += 1
end
try
    units.parseBytes("1\0MB")
catch ValueError error
    rejected += 1
end
try
    units.parseDuration("1h2h")
catch ValueError error
    rejected += 1
end
try
    units.parseDuration("1m2h")
catch ValueError error
    rejected += 1
end
try
    units.parseDuration("1\0h")
catch ValueError error
    rejected += 1
end
try
    units.bytes(math.inf)
catch ValueError error
    rejected += 1
end
try
    units.duration(1e13)
catch ValueError error
    rejected += 1
end
assert rejected == 8
println("units boundaries: PASS")
