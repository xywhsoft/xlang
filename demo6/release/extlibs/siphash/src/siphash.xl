// siphash — SipHash-2-4 短输入哈希（MAC），Buffer/string/文件/流式。
extern "xrtGetError" func __siphash_error() as string
extern "xsiphash_version" func __siphash_version() as string
extern "xsiphash_hash64" func __siphash_hash64(point data, c_size size, point key, c_size keyLen) as int
extern "xsiphash_hash64_str" func __siphash_hash64_str_int(string data, c_size size, point key, c_size keyLen) as int
extern "xsiphash_hash64_hex" func __siphash_hash64_hex(point data, c_size size, point key, c_size keyLen) as string
extern "xsiphash_hash64_str_hex" func __siphash_hash64_str(string data, c_size size, string key, c_size keyLen) as string
extern "xsiphash_hash64_str_hex_buffer" func __siphash_hash64_str_buffer(string data, c_size size, point key, c_size keyLen) as string
extern "xsiphash_hash128_hex" func __siphash_hash128_hex(point data, c_size size, point key, c_size keyLen) as string
extern "xsiphash_hash128_str_hex" func __siphash_hash128_str(string data, c_size size, string key, c_size keyLen) as string
extern "xsiphash_hash128_str_hex_buffer" func __siphash_hash128_str_buffer(string data, c_size size, point key, c_size keyLen) as string
extern "xsiphash_hash64_bytes" func __siphash_hash64_bytes(point data, c_size size, point key, c_size keyLen) as point
extern "xsiphash_hash64_str_str_bytes" func __siphash_hash64_str_bytes(string data, c_size size, string key, c_size keyLen) as point
extern "xsiphash_hash64_str_bytes" func __siphash_hash64_str_bytes_bufkey(string data, c_size size, point key, c_size keyLen) as point
extern "xsiphash_hash128_bytes" func __siphash_hash128_bytes(point data, c_size size, point key, c_size keyLen) as point
extern "xsiphash_hash128_str_str_bytes" func __siphash_hash128_str_bytes(string data, c_size size, string key, c_size keyLen) as point
extern "xsiphash_hash128_str_bytes" func __siphash_hash128_str_bytes_bufkey(string data, c_size size, point key, c_size keyLen) as point
extern "xsiphash_file64" func __siphash_file64(string path, c_ulonglong maxInput, point key, c_size keyLen) as int



// SipHash 密钥长度（字节）。
export const int SIPHASH_KEY_LEN = 16



// 返回内嵌 SipHash 引擎的版本号。
export func version() as string
    return __siphash_version()
end

func __siphash_check_limit(int value, string name)
    if value <= 0 then
        throw ValueError name + " must be greater than zero"
    end
end



// ═══════════════ 一次性哈希 ═══════════════

// SipHash-2-4 64 位哈希（返回整数值）。
export func hash64(Buffer data, Buffer key) as int
    return __siphash_hash64(data.data(), c_size(data.len()), key.data(), c_size(key.len()))
end

export func hash64(string text, Buffer key) as int
    return __siphash_hash64_str_int(text, c_size(string.len(text)), key.data(), c_size(key.len()))
end

// SipHash-2-4 64 位哈希（返回 16 字符十六进制字符串）。
export func hash64Hex(Buffer data, Buffer key) as string
    return __siphash_hash64_hex(data.data(), c_size(data.len()), key.data(), c_size(key.len()))
end

export func hash64Hex(string text, string key) as string
    return __siphash_hash64_str(text, c_size(string.len(text)), key, c_size(string.len(key)))
end

export func hash64Hex(string text, Buffer key) as string
    return __siphash_hash64_str_buffer(text, c_size(string.len(text)), key.data(), c_size(key.len()))
end

// SipHash-2-4 64 位哈希（返回 8 字节原始摘要 Buffer）。
export func hash64Bytes(Buffer data, Buffer key) as Buffer
    point result = __siphash_hash64_bytes(data.data(), c_size(data.len()), key.data(), c_size(key.len()))
    if result == null then
        throw ValueError __siphash_error()
    end
    return Buffer(result)
end

export func hash64Bytes(string text, string key) as Buffer
    point result = __siphash_hash64_str_bytes(text, c_size(string.len(text)), key, c_size(string.len(key)))
    if result == null then
        throw ValueError __siphash_error()
    end
    return Buffer(result)
end

// SipHash-2-4 128 位变体（返回 32 字符十六进制字符串）。
export func hash128Hex(Buffer data, Buffer key) as string
    string result = __siphash_hash128_hex(data.data(), c_size(data.len()), key.data(), c_size(key.len()))
    if result == "" then
        throw ValueError __siphash_error()
    end
    return result
end

export func hash128Hex(string text, string key) as string
    string result = __siphash_hash128_str(text, c_size(string.len(text)), key, c_size(string.len(key)))
    if result == "" then
        throw ValueError __siphash_error()
    end
    return result
end

export func hash128Hex(string text, Buffer key) as string
    string result = __siphash_hash128_str_buffer(text, c_size(string.len(text)), key.data(), c_size(key.len()))
    if result == "" then
        throw ValueError __siphash_error()
    end
    return result
end

// SipHash-2-4 128 位变体（返回 16 字节原始摘要 Buffer）。
export func hash128Bytes(Buffer data, Buffer key) as Buffer
    point result = __siphash_hash128_bytes(data.data(), c_size(data.len()), key.data(), c_size(key.len()))
    if result == null then
        throw ValueError __siphash_error()
    end
    return Buffer(result)
end

export func hash128Bytes(string text, string key) as Buffer
    point result = __siphash_hash128_str_bytes(text, c_size(string.len(text)), key, c_size(string.len(key)))
    if result == null then
        throw ValueError __siphash_error()
    end
    return Buffer(result)
end



// ═══════════════ 文件哈希 ═══════════════

export func hashFile64(string path, Buffer key, int maxInput = 268435456) as int
    __siphash_check_limit(maxInput, "maxInput")
    int result = __siphash_file64(path, c_ulonglong(maxInput), key.data(), c_size(key.len()))
    if result == 0 then
        string err = __siphash_error()
        if err != "" then
            throw FileError err
        end
    end
    return result
end



// ═══════════════ 流式哈希器 ═══════════════

export class SipHasher
    native point handle
    extern "xsiphash_hasher_create" create(point key, c_size keyLen, c_ulonglong maxInput)
    extern "xsiphash_hasher_adopt" create(point handle)
    extern "xsiphash_hasher_destroy" destroy()
    extern "xsiphash_hasher_update" func updateNative(point data, c_size size) as bool
    extern "xsiphash_hasher_update_str" func updateStrNative(string data, c_size size) as bool
    extern "xsiphash_hasher_digest64" func digest64Native() as int
    extern "xsiphash_hasher_digest64_hex" func digest64HexNative() as string
    extern "xsiphash_hasher_digest64_bytes" func digest64BytesNative() as point
    extern "xsiphash_hasher_digest128_hex" func digest128HexNative() as string
    extern "xsiphash_hasher_digest128_bytes" func digest128BytesNative() as point
    extern "xsiphash_hasher_reset" func resetNative() as bool
    extern "xsiphash_hasher_input_bytes" func inputBytesNative() as int
    extern "xsiphash_hasher_clone" func cloneNative() as point

    get valid() as bool
        return self.handle != null
    end

    get inputBytes() as int
        return self.inputBytesNative()
    end

    func update(Buffer data)
        if not self.updateNative(data.data(), c_size(data.len())) then
            throw ValueError __siphash_error()
        end
    end

    func update(string text)
        if not self.updateStrNative(text, c_size(string.len(text))) then
            throw ValueError __siphash_error()
        end
    end

    func digest64() as int
        return self.digest64Native()
    end

    func digest64Hex() as string
        return self.digest64HexNative()
    end

    // SipHash-2-4 64 位流式摘要（8 字节原始 Buffer）。
    func digest64Bytes() as Buffer
        point result = self.digest64BytesNative()
        if result == null then
            throw ValueError __siphash_error()
        end
        return Buffer(result)
    end

    // SipHash-2-4 128 位变体流式摘要（32 字符 hex）。
    func digest128Hex() as string
        string result = self.digest128HexNative()
        if result == "" then
            throw ValueError __siphash_error()
        end
        return result
    end

    // SipHash-2-4 128 位变体流式摘要（16 字节原始 Buffer）。
    func digest128Bytes() as Buffer
        point result = self.digest128BytesNative()
        if result == null then
            throw ValueError __siphash_error()
        end
        return Buffer(result)
    end

    func reset() as bool
        if not self.resetNative() then
            throw ValueError __siphash_error()
        end
        return true
    end

    func clone() as SipHasher
        point hp = self.cloneNative()
        if hp == null then
            throw ValueError __siphash_error()
        end
        return SipHasher(hp)
    end
end



// ═══════════════ 工厂函数 ═══════════════

export func hasher(Buffer key, int maxInput = 268435456) as SipHasher
    __siphash_check_limit(maxInput, "maxInput")
    SipHasher result = SipHasher(key.data(), c_size(key.len()), c_ulonglong(maxInput))
    if not result.valid then
        throw ValueError __siphash_error()
    end
    return result
end
