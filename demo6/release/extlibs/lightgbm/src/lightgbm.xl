extern "xlgbm_objective" func __objective(int id) as string
extern "xlgbm_boosting" func __boosting(int id) as string
extern "xlgbm_metric" func __metric(int id) as string
extern "xlgbm_param" func __param(int id) as string
extern "xlgbm_split_gain" func __split_gain(float gl, float hl, float gr, float hr, float lambda) as float
extern "xlgbm_leaf_weight" func __leaf_weight(float grad, float hess, float lambda) as float
extern "xlgbm_device" func __device(int id) as string

export func objective(int id) as string
    return __objective(id)
end

export func boosting(int id) as string
    return __boosting(id)
end

export func metric(int id) as string
    return __metric(id)
end

export func param(int id) as string
    return __param(id)
end

export func splitGain(float gl, float hl, float gr, float hr, float lambda) as float
    return __split_gain(gl, hl, gr, hr, lambda)
end

export func leafWeight(float grad, float hess, float lambda) as float
    return __leaf_weight(grad, hess, lambda)
end

export func device(int id) as string
    return __device(id)
end
