extern "xta_sma" func __sma(string csv, int period) as float
extern "xta_ema" func __ema(string csv, int period) as float
extern "xta_rsi" func __rsi(string csv, int period) as float
extern "xta_macd" func __macd(string csv, int fast, int slow, int signal_period) as float
extern "xta_macd_signal" func __macd_signal() as float
extern "xta_macd_hist" func __macd_hist() as float
extern "xta_bollinger" func __bollinger(string csv, int period, float num_std) as float
extern "xta_bollinger_upper" func __bollinger_upper() as float
extern "xta_bollinger_lower" func __bollinger_lower() as float
extern "xta_stddev" func __stddev(string csv, int period) as float
extern "xta_highest" func __highest(string csv, int period) as float
extern "xta_lowest" func __lowest(string csv, int period) as float
extern "xta_roc" func __roc(string csv, int period) as float
extern "xta_name" func __name(int code) as string

export func sma(string csv, int period) as float
    return __sma(csv, period)
end

export func ema(string csv, int period) as float
    return __ema(csv, period)
end

export func rsi(string csv, int period) as float
    return __rsi(csv, period)
end

export func macd(string csv, int fast, int slow, int signal_period) as float
    return __macd(csv, fast, slow, signal_period)
end

export func macdSignal() as float
    return __macd_signal()
end

export func macdHist() as float
    return __macd_hist()
end

export func bollinger(string csv, int period, float num_std) as float
    return __bollinger(csv, period, num_std)
end

export func bollingerUpper() as float
    return __bollinger_upper()
end

export func bollingerLower() as float
    return __bollinger_lower()
end

export func stddev(string csv, int period) as float
    return __stddev(csv, period)
end

export func highest(string csv, int period) as float
    return __highest(csv, period)
end

export func lowest(string csv, int period) as float
    return __lowest(csv, period)
end

export func roc(string csv, int period) as float
    return __roc(csv, period)
end

export func name(int code) as string
    return __name(code)
end
