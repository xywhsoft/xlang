import pkcs

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

func probe(int operation) as string
    if operation == 0 then return pkcs.encodeOid("1.2.840.113549.1.1.1") end
    if operation == 1 then return pkcs.decodeOid("06092a864886f70d010101") end
    if operation == 2 then return pkcs.getContent("06092a864886f70d010101") end
    return pkcs.concat("020101", "0500")
end

func main(...) as int
    for operation in range(4)
        string expected = probe(operation)
        int failures = 0
        int successes = 0
        for allocation in range(64)
            bool caught = false
            string result = ""
            assert failAfter(uint64(allocation))
            try
                result = probe(operation)
            catch MemoryError error
                caught = true
            end
            bool triggered = failTriggered()
            failClear()
            assert triggered == caught
            if caught then
                failures += 1
            else
                assert result == expected
                successes += 1
            end
            assert probe(operation) == expected
        end
        assert failures > 0 and successes > 0
    end
    println("pkcs allocations: PASS")
    return 0
end
