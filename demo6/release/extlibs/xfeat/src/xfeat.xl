extern "xfeat_stats_json_native" func xfeat_stats_json_raw_native() as point
extern "xfeat_engine_create_native" func xfeat_engine_create_native(point query_session, point target_session) as point
extern "xfeat_engine_query_session_native" func xfeat_engine_query_session_native(point handle) as point
