extern "xgdal_driver" func __driver(int id) as string
extern "xgdal_datatype" func __datatype(int id) as string
extern "xgdal_projection" func __projection(int id) as string
extern "xgdal_resampling" func __resampling(int id) as string
extern "xgdal_haversine" func __haversine(float lat1, float lon1, float lat2, float lon2) as float
extern "xgdal_to_mercator" func __to_mercator(float lon, float lat) as string
extern "xgdal_geometry_type" func __geometry_type(int id) as string

export func driver(int id) as string
    return __driver(id)
end

export func datatype(int id) as string
    return __datatype(id)
end

export func projection(int id) as string
    return __projection(id)
end

export func resampling(int id) as string
    return __resampling(id)
end

export func haversine(float lat1, float lon1, float lat2, float lon2) as float
    return __haversine(lat1, lon1, lat2, lon2)
end

export func toMercator(float lon, float lat) as string
    return __to_mercator(lon, lat)
end

export func geometryType(int id) as string
    return __geometry_type(id)
end
