extern "xl6_xrt_last_error_text" func __cuckoo_error() as string



class CuckooFilter
    native point handle
    extern "xcuckoo_create" create(c_longlong capacity)
    extern "xcuckoo_destroy" destroy()

    extern "xcuckoo_add" func addNative(string data, c_longlong len) as bool
    extern "xcuckoo_contains" func containsNative(string data, c_longlong len) as bool
    extern "xcuckoo_remove" func removeNative(string data, c_longlong len) as bool
    extern "xcuckoo_clear" func clearNative()
    extern "xcuckoo_count" func countNative() as int
    extern "xcuckoo_buckets" func bucketsNative() as int

    get valid() as bool
        return self.handle != null
    end

    get count() as int
        return self.countNative()
    end

    get buckets() as int
        return self.bucketsNative()
    end

    func add(string item)
        if self.handle == null then
            throw RuntimeError "cuckoo: filter is destroyed"
        end
        if not self.addNative(item, c_longlong(-1)) then
            throw RuntimeError __cuckoo_error()
        end
    end

    func contains(string item) as bool
        if self.handle == null then
            throw RuntimeError "cuckoo: filter is destroyed"
        end
        return self.containsNative(item, c_longlong(-1))
    end

    func remove(string item) as bool
        if self.handle == null then
            throw RuntimeError "cuckoo: filter is destroyed"
        end
        return self.removeNative(item, c_longlong(-1))
    end

    func clear()
        if self.handle == null then
            throw RuntimeError "cuckoo: filter is destroyed"
        end
        self.clearNative()
    end
end



export func create(int capacity) as CuckooFilter
    if capacity <= 0 then
        throw ValueError "cuckoo: capacity must be positive"
    end
    return CuckooFilter(c_longlong(capacity))
end
