// Terraform state 的只读查询接口。解析结果保留为 var，方便直接访问原始字段。
extern "xtf_parse" func __parse(string text) as var
extern "xtf_valid" func __valid(string text) as bool
extern "xtf_version_ref" func __version(byref var state) as int
extern "xtf_serial_ref" func __serial(byref var state) as int
extern "xtf_lineage_ref" func __lineage(byref var state) as string
extern "xtf_addresses_ref" func __addresses(byref var state) as var
extern "xtf_find_ref" func __find(byref var state, string address) as var
extern "xtf_instances_ref" func __instances(byref var state, string address) as var
extern "xtf_attributes_ref" func __attributes(byref var state, string address, int index) as var
extern "xtf_outputs_ref" func __outputs(byref var state) as var
extern "xtf_output_ref" func __output(byref var state, string name) as var
extern "xtf_last_error" func __last_error() as string

export func parse(string text) as var
    var state = __parse(text)
    if state == null then
        throw ValueError __last_error()
    end
    return state
end

export func valid(string text) as bool
    return __valid(text)
end

export func version(var state) as int
    return __version(byref state)
end

export func serial(var state) as int
    return __serial(byref state)
end

export func lineage(var state) as string
    return __lineage(byref state)
end

export func addresses(var state) as var
    var result = __addresses(byref state)
    if result == null then
        throw ValueError __last_error()
    end
    return result
end

export func find(var state, string address) as var
    return __find(byref state, address)
end

export func instances(var state, string address) as var
    var result = __instances(byref state, address)
    if result == null and __last_error() != "" then
        throw ValueError __last_error()
    end
    return result
end

export func attributes(var state, string address, int index = 0) as var
    var result = __attributes(byref state, address, index)
    if result == null and __last_error() != "" then
        throw ValueError __last_error()
    end
    return result
end

export func outputs(var state) as var
    var result = __outputs(byref state)
    if result == null and __last_error() != "" then
        throw ValueError __last_error()
    end
    return result
end

export func output(var state, string name) as var
    var result = __output(byref state, name)
    if result == null and __last_error() != "" then
        throw ValueError __last_error()
    end
    return result
end

export func lastError() as string
    return __last_error()
end
