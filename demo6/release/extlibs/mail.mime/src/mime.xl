extern "xmail_mime_result_native" func xmail_mime_result_native(bool ok, string error, string stage, var data) as var
extern "xmail_mime_address_native" func xmail_mime_address_native(string email, string name) as var
extern "xmail_mime_attachment_native" func xmail_mime_attachment_native(string filename, string content_type, var content, string content_id, bool is_inline) as var
extern "xmail_mime_message_native" func xmail_mime_message_native(var fields) as var
extern "xmail_mime_build_native" func xmail_mime_build_native(var message_value) as var
extern "xmail_mime_parse_native" func xmail_mime_parse_native(string raw_message) as var
extern "xmail_mime_build_json_native" func xmail_mime_build_json_native(string message_json) as string
extern "xmail_mime_parse_json_native" func xmail_mime_parse_json_native(string raw_message) as string

export func available() as bool
    return true
end

export func version() as string
    return "0.1.0"
end

export func last_error() as string
    return ""
end

export func result(bool ok, string error, string stage, var data) as var
    return xmail_mime_result_native(ok, error, stage, data)
end

export func address(string email, string name) as var
    return xmail_mime_address_native(email, name)
end

export func attachment(string filename, string content_type, var content, string content_id, bool is_inline) as var
    return xmail_mime_attachment_native(filename, content_type, content, content_id, is_inline)
end

export func message(var fields) as var
    return xmail_mime_message_native(fields)
end

export func build(var message_value) as var
    return xmail_mime_build_native(message_value)
end

export func parse(string raw_message) as var
    return xmail_mime_parse_native(raw_message)
end

export func build_json(string message_json) as string
    return xmail_mime_build_json_native(message_json)
end

export func parse_json(string raw_message) as string
    return xmail_mime_parse_json_native(raw_message)
end
