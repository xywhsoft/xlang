    point stream)



export const int HTTP1_TARGET_AUTO = 0
export const int HTTP1_TARGET_ORIGIN = 1
export const int HTTP1_TARGET_ABSOLUTE = 2
export const int HTTP1_TARGET_AUTHORITY = 3
export const int HTTP1_TARGET_ASTERISK = 4
export const int HTTP1_TARGET_CUSTOM = 5

export const int REQUEST_BODY_NONE = 0
export const int REQUEST_BODY_FIXED = 1
export const int REQUEST_BODY_CHUNKED = 2

export const int HTTP1_OUTPUT_ERROR = -1
export const int HTTP1_OUTPUT_AGAIN = 0
export const int HTTP1_OUTPUT_DATA = 1
export const int HTTP1_OUTPUT_DONE = 2
export const int HTTP1_OUTPUT_CONTINUE = 3

export const int HTTP1_FEED_ERROR = -1
export const int HTTP1_FEED_MORE = 0
export const int HTTP1_FEED_PAUSED = 1
export const int HTTP1_FEED_DONE = 2
export const int HTTP1_FEED_UPGRADED = 3

export const int RESPONSE_STREAMED = 1
export const int RESPONSE_DECOMPRESSED = 2
export const int RESPONSE_UPGRADED = 4



// 复制当前线程错误文本并生成稳定字符串。
func __xhttp_client_error() as string
    point handle = __xhttp_client_error_native()
    if handle == null then
        return "xhttp.client operation failed"
    end
    return Buffer(handle).text()
end



// 检查拥有型原生句柄并保留 XRT 的结构化失败原因。
func __xhttp_client_handle(point handle) as point
    if handle == null then
        throw RuntimeError __xhttp_client_error()
    end
    return handle
end



// 把可空的原生文本副本转换为语言字符串。
func __xhttp_client_optional_text(point handle) as string?
    if handle == null then
        return null
    end
    return Buffer(handle).text()
end



// 返回当前线程最近一次 xhttp.client/XRT 错误文本。
export func lastError() as string
    return __xhttp_client_error()
end



// Request 是拥有型可变客户端请求构建器，正文使用共享引用而非重复复制。
export class Request
    native point handle
    extern "xhttp_client_request_wrap" create(point handle)
    extern "xhttp_client_request_destroy_abi" destroy()
    extern "xhttp_client_request_native" func nativeHandle() as point
    extern "xhttp_client_request_clone" func cloneNative() as point
    extern "xhttp_client_request_text" func textNative(
        c_longlong field) as point
    extern "xhttp_client_request_set_text" func setTextNative(
        string text, c_size size, c_longlong field) as bool
    extern "xhttp_client_request_write_field" func writeFieldNative(
        string name, c_size nameSize,
        string value, c_size valueSize,
        bool trailer, bool set) as bool
    extern "xhttp_client_request_remove_field" func removeFieldNative(
        string name, c_size nameSize, bool trailer) as c_ulonglong
    extern "xhttp_client_request_field" func fieldNative(
        string name, c_size nameSize, bool trailer) as point
    extern "xhttp_client_request_field_count" func fieldCountNative(
        bool trailer) as c_ulonglong
    extern "xhttp_client_request_fields" func fieldsNative(
        bool trailer) as point
    extern "xhttp_client_request_clear_fields" func clearFieldsNative(
        bool trailer) as c_longlong
    extern "xhttp_client_request_set_body" func setBodyNative(
        point body) as bool
    extern "xhttp_client_request_clear_body" func clearBodyNative() as bool
    extern "xhttp_client_request_set_text_body" func setTextBodyNative(
        cstring text, cstring contentType) as bool
    extern "xhttp_client_request_set_bytes" func setBytesNative(
        point data, c_size size,
        string contentType, c_size contentTypeSize) as bool
    extern "xhttp_client_request_body" func bodyNative() as point
    extern "xhttp_client_request_accept_trailers" func acceptTrailersNative() as bool
    extern "xhttp_client_request_set_params" func setParamsNative(
        point params, bool form) as bool
    extern "xhttp_client_request_set_form_data" func setFormDataNative(
        point form, point boundary) as bool

    static func make(string method, string url) as Request
        return Request(__xhttp_client_handle(
            __xhttp_client_request_create(
                method, c_size(string.byteLen(method)),
                url, c_size(string.byteLen(url)))))
    end

    get valid() as bool
        return self.handle != null
    end

    get method() as string
        return Buffer(__xhttp_client_handle(
            self.textNative(c_longlong(0)))).text()
    end

    get url() as string
        return Buffer(__xhttp_client_handle(
            self.textNative(c_longlong(1)))).text()
    end

    get parsedUrl() as Url
        return Url.parse(self.url)
    end

    get headerCount() as int
        return int(self.fieldCountNative(false))
    end

    get trailerCount() as int
        return int(self.fieldCountNative(true))
    end

    func clone() as Request
        return Request(__xhttp_client_handle(self.cloneNative()))
    end

    func setMethod(string method)
        if not self.setTextNative(
            method, c_size(string.byteLen(method)), c_longlong(0)) then
            throw ValueError __xhttp_client_error()
        end
    end

    func setUrl(string url)
        if not self.setTextNative(
            url, c_size(string.byteLen(url)), c_longlong(1)) then
            throw ValueError __xhttp_client_error()
        end
    end

    func addHeader(string name, string value)
        if not self.writeFieldNative(
            name, c_size(string.byteLen(name)),
            value, c_size(string.byteLen(value)), false, false) then
            throw ValueError __xhttp_client_error()
        end
    end

    func setHeader(string name, string value)
        if not self.writeFieldNative(
            name, c_size(string.byteLen(name)),
            value, c_size(string.byteLen(value)), false, true) then
            throw ValueError __xhttp_client_error()
        end
    end

    func removeHeader(string name) as int
        return int(self.removeFieldNative(
            name, c_size(string.byteLen(name)), false))
    end

    func header(string name) as string?
        return __xhttp_client_optional_text(self.fieldNative(
            name, c_size(string.byteLen(name)), false))
    end

    func headers() as Headers
        return Headers(__xhttp_client_handle(self.fieldsNative(false)))
    end

    func clearHeaders()
        self.clearFieldsNative(false)
    end

    func addTrailer(string name, string value)
        if not self.writeFieldNative(
            name, c_size(string.byteLen(name)),
            value, c_size(string.byteLen(value)), true, false) then
            throw ValueError __xhttp_client_error()
        end
    end

    func setTrailer(string name, string value)
        if not self.writeFieldNative(
            name, c_size(string.byteLen(name)),
            value, c_size(string.byteLen(value)), true, true) then
            throw ValueError __xhttp_client_error()
        end
    end

    func removeTrailer(string name) as int
        return int(self.removeFieldNative(
            name, c_size(string.byteLen(name)), true))
    end

    func trailer(string name) as string?
        return __xhttp_client_optional_text(self.fieldNative(
            name, c_size(string.byteLen(name)), true))
    end

    func trailers() as Headers
        return Headers(__xhttp_client_handle(self.fieldsNative(true)))
    end

    func clearTrailers()
        self.clearFieldsNative(true)
    end

    func setBody(Body body)
        if not self.setBodyNative(body.nativeHandle()) then
            throw RuntimeError __xhttp_client_error()
        end
    end

    func setBody(Buffer data, string contentType = "")
        if not self.setBytesNative(
            data.data(), c_size(data.len()),
            contentType, c_size(string.byteLen(contentType))) then
            throw RuntimeError __xhttp_client_error()
        end
    end

    func setBody(
        string text,
        string contentType = "text/plain; charset=utf-8"
    )
        if not self.setTextBodyNative(text, contentType) then
            throw RuntimeError __xhttp_client_error()
        end
    end

    func clearBody()
        if not self.clearBodyNative() then
            throw RuntimeError __xhttp_client_error()
        end
    end

    func body() as Body?
        point result = self.bodyNative()
        if result == null then
            return null
        end
        return Body(result)
    end

    func acceptResponseTrailers()
        if not self.acceptTrailersNative() then
            throw ValueError __xhttp_client_error()
        end
    end

    func setQuery(QueryParams params)
        if not self.setParamsNative(params.nativeHandle(), false) then
            throw ValueError __xhttp_client_error()
        end
    end

    func setForm(QueryParams params)
        if not self.setParamsNative(params.nativeHandle(), true) then
            throw ValueError __xhttp_client_error()
        end
    end

    func setFormData(FormData form, MultipartBoundary boundary)
        if not self.setFormDataNative(
            form.nativeHandle(), boundary.nativeHandle()) then
            throw ValueError __xhttp_client_error()
        end
    end

    func setFormData(FormData form) as MultipartBoundary
        MultipartBoundary boundary = MultipartBoundary.random()
        self.setFormData(form, boundary)
        return boundary
    end

    func prepare(
        int targetForm = HTTP1_TARGET_AUTO,
        string customTarget = ""
    ) as Http1RequestPlan
        return Http1RequestPlan(__xhttp_client_handle(
            __xhttp_client_plan_prepare(
                self.nativeHandle(), c_longlong(targetForm),
                customTarget, c_size(string.byteLen(customTarget)))))
    end
end



// Http1RequestPlan 是冻结后的线路计划，open 会把唯一所有权转移给 Exchange。
export class Http1RequestPlan
    native point handle
    extern "xhttp_client_plan_wrap" create(point handle)
    extern "xhttp_client_plan_destroy_abi" destroy()
    extern "xhttp_client_plan_native" func nativeHandle() as point
    extern "xhttp_client_plan_text" func textNative(
        c_longlong field) as point
    extern "xhttp_client_plan_value" func valueNative(
        c_longlong field) as c_longlong
    extern "xhttp_client_plan_body" func bodyNative() as point
    extern "xhttp_client_exchange_create" func openNative() as point

    get valid() as bool
        return self.nativeHandle() != null
    end

    get head() as Buffer
        return Buffer(__xhttp_client_handle(
            self.textNative(c_longlong(0))))
    end

    get endBytes() as Buffer
        return Buffer(__xhttp_client_handle(
            self.textNative(c_longlong(1))))
    end

    get method() as string
        return Buffer(__xhttp_client_handle(
            self.textNative(c_longlong(2)))).text()
    end

    get url() as string
        return Buffer(__xhttp_client_handle(
            self.textNative(c_longlong(3)))).text()
    end

    get target() as string
        return Buffer(__xhttp_client_handle(
            self.textNative(c_longlong(4)))).text()
    end

    get host() as string
        return Buffer(__xhttp_client_handle(
            self.textNative(c_longlong(5)))).text()
    end

    get port() as int
        return int(self.valueNative(c_longlong(0)))
    end

    get bodyMode() as int
        return int(self.valueNative(c_longlong(1)))
    end

    get bodyLength() as int
        return int(self.valueNative(c_longlong(2)))
    end

    get secure() as bool
        return self.valueNative(c_longlong(3)) != 0
    end

    get closeAfterResponse() as bool
        return self.valueNative(c_longlong(4)) != 0
    end

    get expectContinue() as bool
        return self.valueNative(c_longlong(5)) != 0
    end

    func body() as Body?
        point result = self.bodyNative()
        if result == null then
            return null
        end
        return Body(result)
    end

    func open() as Http1Exchange
        return Http1Exchange(__xhttp_client_handle(self.openNative()))
    end
end



// Http1Output 保留底层状态；DATA 必须由调用方显式 consume。
export class Http1Output
    int status
    Buffer? data

    create(int status, Buffer? data)
        self.status = status
        self.data = data
    end

    get hasData() as bool
        return self.status == HTTP1_OUTPUT_DATA and self.data != null
    end
end



// Http1FeedResult 同时公开状态和被接受的输入前缀长度。
export class Http1FeedResult
    int status
    int accepted

    create(int status, int accepted)
        self.status = status
        self.accepted = accepted
    end
end



// Response 是 Exchange 交付的只读拥有型响应。
export class Response
    native point handle
    extern "xhttp_client_response_wrap" create(point handle)
    extern "xhttp_client_response_destroy_abi" destroy()
    extern "xhttp_client_response_native" func nativeHandle() as point
    extern "xhttp_client_response_value" func valueNative(
        c_longlong field) as c_ulonglong
    extern "xhttp_client_response_success" func successNative() as bool
    extern "xhttp_client_response_text" func textNative(
        c_longlong field) as point
    extern "xhttp_client_response_field" func fieldNative(
        string name, c_size nameSize, bool trailer) as point
    extern "xhttp_client_response_fields" func fieldsNative(
        bool trailer) as point
    extern "xhttp_client_response_body" func bodyNative() as point

    get valid() as bool
        return self.handle != null
    end

    get version() as int
        return int(self.valueNative(c_longlong(0)))
    end

    get status() as int
        return int(self.valueNative(c_longlong(1)))
    end

    get success() as bool
        return self.successNative()
    end

    get flags() as int
        return int(self.valueNative(c_longlong(2)))
    end

    get reason() as string
        return Buffer(__xhttp_client_handle(
            self.textNative(c_longlong(0)))).text()
    end

    get headerCount() as int
        return int(self.valueNative(c_longlong(3)))
    end

    get trailerCount() as int
        return int(self.valueNative(c_longlong(4)))
    end

    get bodyBytes() as int
        return int(self.valueNative(c_longlong(5)))
    end

    get wireBodyBytes() as int
        return int(self.valueNative(c_longlong(6)))
    end

    get url() as string
        return Buffer(__xhttp_client_handle(
            self.textNative(c_longlong(1)))).text()
    end

    get parsedUrl() as Url
        return Url.parse(self.url)
    end

    get redirects() as int
        return int(self.valueNative(c_longlong(7)))
    end

    func header(string name) as string?
        return __xhttp_client_optional_text(self.fieldNative(
            name, c_size(string.byteLen(name)), false))
    end

    func trailer(string name) as string?
        return __xhttp_client_optional_text(self.fieldNative(
            name, c_size(string.byteLen(name)), true))
    end

    func headers() as Headers
        return Headers(__xhttp_client_handle(self.fieldsNative(false)))
    end

    func trailers() as Headers
        return Headers(__xhttp_client_handle(self.fieldsNative(true)))
    end

    func body() as Buffer
        return Buffer(__xhttp_client_handle(self.bodyNative()))
    end

    func text() as string
        return self.body().text()
    end
end



// Http1Exchange 是无 I/O 的 HTTP/1 双向状态机，可直接接到任意传输层。
export class Http1Exchange
    native point handle
    extern "xhttp_client_exchange_wrap" create(point handle)
    extern "xhttp_client_exchange_destroy_abi" destroy()
    extern "xhttp_client_exchange_native" func nativeHandle() as point
    extern "xhttp_client_exchange_output" func outputNative(
        c_size maxBytes) as point
    extern "xhttp_client_exchange_output_status" func outputStatusNative() as c_longlong
    extern "xhttp_client_exchange_consume" func consumeNative(
        c_size size) as bool
    extern "xhttp_client_exchange_continue" func continueNative() as bool
    extern "xhttp_client_exchange_pause" func pauseNative(
        bool pause) as bool
    extern "xhttp_client_exchange_paused" func pausedNative() as bool
    extern "xhttp_client_exchange_feed" func feedNative(
        point data, c_size size, bool finish) as c_ulonglong
    extern "xhttp_client_exchange_feed_status" func feedStatusNative() as c_longlong
    extern "xhttp_client_exchange_take_response" func takeResponseNative() as point
    extern "xhttp_client_exchange_remainder" func remainderNative() as point
    extern "xhttp_client_exchange_value" func valueNative(
        c_longlong field) as c_ulonglong

    get valid() as bool
        return self.nativeHandle() != null
    end

    get paused() as bool
        return self.pausedNative()
    end

    get requestComplete() as bool
        return self.valueNative(c_longlong(0)) != 0
    end

    get responseComplete() as bool
        return self.valueNative(c_longlong(1)) != 0
    end

    get upgraded() as bool
        return self.valueNative(c_longlong(2)) != 0
    end

    get reusable() as bool
        return self.valueNative(c_longlong(3)) != 0
    end

    get informationalCount() as int
        return int(self.valueNative(c_longlong(4)))
    end

    get requestWireBytes() as int
        return int(self.valueNative(c_longlong(5)))
    end

    func output(int maxBytes = 65536) as Http1Output
        if maxBytes <= 0 then
            throw ValueError "HTTP/1 output size must be positive"
        end
        point result = self.outputNative(c_size(maxBytes))
        int status = int(self.outputStatusNative())
        if status == HTTP1_OUTPUT_ERROR then
            throw RuntimeError __xhttp_client_error()
        end
        if result == null then
            return Http1Output(status, null)
        end
        return Http1Output(status, Buffer(result))
    end

    func consume(int size)
        if size < 0 then
            throw ValueError "HTTP/1 consumed size must not be negative"
        end
        if not self.consumeNative(c_size(size)) then
            throw RuntimeError __xhttp_client_error()
        end
    end

    func takeOutput(int maxBytes = 65536) as Http1Output
        Http1Output result = self.output(maxBytes)
        if result.hasData then
            Buffer data = result.data as Buffer
            self.consume(data.len())
        end
        return result
    end

    func allowContinue()
        if not self.continueNative() then
            throw RuntimeError __xhttp_client_error()
        end
    end

    func pause()
        if not self.pauseNative(true) then
            throw RuntimeError __xhttp_client_error()
        end
    end

    func resume()
        if not self.pauseNative(false) then
            throw RuntimeError __xhttp_client_error()
        end
    end

    func feed(Buffer input, bool finish = false) as Http1FeedResult
        int accepted = int(self.feedNative(
            input.data(), c_size(input.len()), finish))
        int status = int(self.feedStatusNative())
        if status == HTTP1_FEED_ERROR then
            throw RuntimeError __xhttp_client_error()
        end
        return Http1FeedResult(status, accepted)
    end

    func finish() as Http1FeedResult
        return self.feed(Buffer(), true)
    end

    func takeResponse() as Response
        return Response(__xhttp_client_handle(self.takeResponseNative()))
    end

    func remainder() as Buffer
        return Buffer(__xhttp_client_handle(self.remainderNative()))
    end
end



extern "xhttp_client_create" func __xhttp_client_create(
    point engine, c_longlong timeoutMs,
    c_longlong idleTimeoutMs, bool systemTrust) as point
