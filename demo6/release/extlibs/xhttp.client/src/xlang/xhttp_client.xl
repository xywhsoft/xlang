    point lease)
extern "xl6ExtlibTlsLeaseContextHandle" func __xhttp_client_tls_lease_context(
    point lease) as point
extern "xl6ExtlibTlsLeaseShareVerifierHandle" func __xhttp_client_tls_lease_share_verifier(
    point lease) as point
extern "xhttp_client_result_ref" func __xhttp_client_result_ref(
    point handle) as point



export const int CLIENT_RUNNING = 0
export const int CLIENT_DRAINING = 1
export const int CLIENT_ABORTING = 2
export const int CLIENT_CLOSED = 3

export const int CALL_QUEUED = 0
export const int CALL_DIALING = 1
export const int CALL_HANDSHAKING = 2
export const int CALL_EXCHANGING = 3
export const int CALL_SUCCEEDED = 4
export const int CALL_FAILED = 5
export const int CALL_CANCELLED = 6

export const int CALL_PHASE_QUEUED = 0
export const int CALL_PHASE_POOL = 3
export const int CALL_PHASE_CONNECT = 4
export const int CALL_PHASE_PROXY = 5
export const int CALL_PHASE_TLS = 6
export const int CALL_PHASE_REQUEST = 7
export const int CALL_PHASE_RESPONSE_HEADERS = 8
export const int CALL_PHASE_RESPONSE_BODY = 9



// HttpClientConfig 只保存跨调用共享的传输策略，默认使用安全系统信任与两类 30 秒超时。
export class HttpClientConfig
    int timeoutMs
    int idleTimeoutMs
    bool systemTrust

    create(
        int timeoutMs = 30000,
        int idleTimeoutMs = 30000,
        bool systemTrust = true
    )
        if timeoutMs < -1 or idleTimeoutMs < -1 then
            throw ValueError "HTTP client timeouts must be positive or -1"
        end
        self.timeoutMs = timeoutMs
        self.idleTimeoutMs = idleTimeoutMs
        self.systemTrust = systemTrust
    end
end



// HttpCallOptions 为一次调用覆盖超时和正文上限；零表示继承，负一表示无限。
export class HttpCallOptions
    int timeoutMs
    int idleTimeoutMs
    int responseBodyLimit

    create(
        int timeoutMs = 0,
        int idleTimeoutMs = 0,
        int responseBodyLimit = 0
    )
        if timeoutMs < -1 or idleTimeoutMs < -1 then
            throw ValueError "HTTP call timeouts must be zero, positive or -1"
        end
        if responseBodyLimit < -1 then
            throw ValueError "HTTP response body limit must be non-negative or -1"
        end
        self.timeoutMs = timeoutMs
        self.idleTimeoutMs = idleTimeoutMs
        self.responseBodyLimit = responseBodyLimit
    end
end



// HttpResult 同时拥有普通响应和可选 Upgrade 传输，所有资源至多取走一次。
export class HttpResult
    native point handle
    extern "xhttp_client_result_wrap" create(point handle)
    extern "xhttp_client_result_destroy_abi" destroy()
    extern "xhttp_client_result_native" func nativeHandle() as point
    extern "xhttp_client_result_has_response" get hasResponse() as bool
    extern "xhttp_client_result_take_response" func takeResponseNative() as point
    extern "xhttp_client_result_take_tcp" func takeTcpNative() as point
    extern "xhttp_client_result_take_tls" func takeTlsNative() as point
    extern "xhttp_client_result_value" func valueNative(
        c_longlong field) as c_longlong

    get valid() as bool
        return self.nativeHandle() != null
    end

    get state() as int
        return int(self.valueNative(c_longlong(0)))
    end

    get phase() as int
        return int(self.valueNative(c_longlong(1)))
    end

    get result() as int
        return int(self.valueNative(c_longlong(2)))
    end

    get errorCode() as int
        return int(self.valueNative(c_longlong(3)))
    end

    get submittedAt() as int
        return int(self.valueNative(c_longlong(4)))
    end

    get startedAt() as int
        return int(self.valueNative(c_longlong(5)))
    end

    get transportReadyAt() as int
        return int(self.valueNative(c_longlong(6)))
    end

    get requestSentAt() as int
        return int(self.valueNative(c_longlong(7)))
    end

    get firstByteAt() as int
        return int(self.valueNative(c_longlong(8)))
    end

    get headersAt() as int
        return int(self.valueNative(c_longlong(9)))
    end

    get lastProgressAt() as int
        return int(self.valueNative(c_longlong(10)))
    end

    get completedAt() as int
        return int(self.valueNative(c_longlong(11)))
    end

    get requestWireBytes() as int
        return int(self.valueNative(c_longlong(12)))
    end

    get responseWireBytes() as int
        return int(self.valueNative(c_longlong(13)))
    end

    get responseBodyBytes() as int
        return int(self.valueNative(c_longlong(14)))
    end

    get redirects() as int
        return int(self.valueNative(c_longlong(15)))
    end

    get reusedConnection() as bool
        return self.valueNative(c_longlong(16)) != 0
    end

    get secure() as bool
        return self.valueNative(c_longlong(17)) != 0
    end

    get bufferedBytes() as int
        return int(self.valueNative(c_longlong(18)))
    end

    get upgraded() as bool
        return self.valueNative(c_longlong(19)) != 0
    end

    func takeResponse() as Response
        return Response(__xhttp_client_handle(self.takeResponseNative()))
    end

    func takeTcp() as TcpStream?
        point stream = self.takeTcpNative()
        if stream == null then
            return null
        end
        return TcpStream(stream)
    end

    func takeTls() as TlsStream?
        point nativeStream = self.takeTlsNative()
        point stream
        if nativeStream == null then
            return null
        end
        stream = __xhttp_client_tls_stream_adopt(nativeStream)
        if stream == null then
            __xhttp_client_tls_stream_discard(nativeStream)
            return null
        end
        return TlsStream(stream)
    end
end



// Future 装箱时增加独立结果引用，源 Future 和语言对象可以分别析构。
func __xhttp_client_result_box(point handle) as HttpResult
    return HttpResult(__xhttp_client_handle(
        __xhttp_client_result_ref(handle)))
end



// HttpClient 绑定显式 NetEngine，避免扩展库偷偷依赖进程全局网络状态。
export class HttpClient
    native point handle
    extern "xhttp_client_wrap" create(point handle)
    extern "xhttp_client_destroy_abi" destroy()
    extern "xhttp_client_native" func nativeHandle() as point
    extern "xhttp_client_drain" func drain() as bool
    extern "xhttp_client_abort" func abort() as bool
    extern "xhttp_client_state" get state() as c_longlong
    extern "xhttp_client_wait_async" func waitClosed() as future<null>
    extern "xhttp_client_execute" func executeNative(
        point request, c_longlong timeoutMs,
        c_longlong idleTimeoutMs,
        c_longlong responseBodyLimit) as point
    extern "xhttp_client_execute_async" func executeAsyncNative(
        point request, c_longlong timeoutMs,
        c_longlong idleTimeoutMs,
        c_longlong responseBodyLimit,
        var boxer) as future<HttpResult>

    static func open(NetEngine engine) as HttpClient
        return HttpClient.open(engine, HttpClientConfig())
    end

    static func open(
        NetEngine engine,
        HttpClientConfig config
    ) as HttpClient
        point created = __xhttp_client_create(
            engine.nativeHandle(),
            c_longlong(config.timeoutMs),
			c_longlong(config.idleTimeoutMs),
			config.systemTrust
		)
		return HttpClient(__xhttp_client_handle(created))
	end

	static func open(
		NetEngine engine,
		TlsConfig tlsConfig
	) as HttpClient
		return HttpClient.open(engine, tlsConfig, HttpClientConfig())
	end

	static func open(
		NetEngine engine,
		TlsConfig tlsConfig,
		HttpClientConfig config
	) as HttpClient
		point lease = __xhttp_client_tls_lease_create(
			tlsConfig.nativeHandle())
		point created = __xhttp_client_create_tls(
			engine.nativeHandle(),
			__xhttp_client_tls_lease_context(lease),
			__xhttp_client_tls_lease_share_verifier(lease),
			c_longlong(config.timeoutMs),
			c_longlong(config.idleTimeoutMs)
		)
		__xhttp_client_tls_lease_release(lease)
		return HttpClient(__xhttp_client_handle(created))
	end

    get valid() as bool
        return self.nativeHandle() != null
    end

    func execute(Request request) as HttpResult
        return self.execute(request, HttpCallOptions())
    end

    func execute(
        Request request,
        HttpCallOptions options
    ) as HttpResult
        return HttpResult(__xhttp_client_handle(self.executeNative(
            request.nativeHandle(),
            c_longlong(options.timeoutMs),
            c_longlong(options.idleTimeoutMs),
            c_longlong(options.responseBodyLimit)
        )))
    end

    func send(Request request) as Response
        return self.execute(request).takeResponse()
    end

    func send(
        Request request,
        HttpCallOptions options
    ) as Response
        return self.execute(request, options).takeResponse()
    end

    func executeAsync(Request request) as future<HttpResult>
        return self.executeAsync(request, HttpCallOptions())
    end

    func executeAsync(
        Request request,
        HttpCallOptions options
    ) as future<HttpResult>
        var boxer = xcall(__xhttp_client_result_box)
        return self.executeAsyncNative(
            request.nativeHandle(),
            c_longlong(options.timeoutMs),
            c_longlong(options.idleTimeoutMs),
            c_longlong(options.responseBodyLimit),
            boxer
        )
    end
end
