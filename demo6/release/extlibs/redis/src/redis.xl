end

export func cluster_slots_cache_refresh(ClusterSlotsCache cache, Client seed) as bool
	auto slots = cluster_slots_json(seed)
	if response_type(slots) == "error" then
		seed.last_error_text = response_value(slots)
		return false
	end
	if response_type(slots) != "array" then
		seed.last_error_text = "cluster slots response is not an array"
		return false
	end
	cache.slots_json = slots
	return true
end

export func cluster_slots_node_host(string slots_response_json, int slot) as string
	return xredis_cluster_slots_node_host_native(slots_response_json, slot)
end

export func cluster_slots_node_port(string slots_response_json, int slot) as int
	return xredis_cluster_slots_node_port_native(slots_response_json, slot)
end

export func cluster_connect_slot(string slots_response_json, int slot) as Client
	return cluster_connect_slot(slots_response_json, slot, 5000)
end

export func cluster_connect_slot(string slots_response_json, int slot, int timeout_ms) as Client
	auto host = cluster_slots_node_host(slots_response_json, slot)
	auto port = cluster_slots_node_port(slots_response_json, slot)
	if host == "" or port <= 0 then
		return Client(host, port, timeout_ms, "cluster slot node not found")
	end
	return xredis_connect(host, port, timeout_ms)
end

export func cluster_keyslot(Client client, string key) as int
	return response_int(command3(client, "CLUSTER", "KEYSLOT", key))
end

export func cluster_command_slot_once_json(Client seed, string slots_response_json, string key, string argv_json) as string
	return cluster_command_slot_once_json(seed, slots_response_json, key, argv_json, seed.timeout_ms)
end

export func cluster_command_slot_once_json(Client seed, string slots_response_json, string key, string argv_json, int timeout_ms) as string
	auto slot = cluster_keyslot(seed, key)
	if slot < 0 then
		seed.last_error_text = "cluster keyslot failed"
		return json_error(seed.last_error_text)
	end
	auto target = cluster_connect_slot(slots_response_json, slot, timeout_ms)
	if target.valid() == false then
		seed.last_error_text = target.last_error()
		return json_error(seed.last_error_text)
	end
	auto result = command_json(target, argv_json)
	if response_type(result) == "error" then
		seed.last_error_text = response_value(result)
	else
		seed.last_error_text = ""
	end
	xredis_close(target)
	return result
end

export func cluster_command_slot_once_password_json(Client seed, string slots_response_json, string key, string password, string argv_json) as string
	return cluster_command_slot_once_password_json(seed, slots_response_json, key, password, argv_json, seed.timeout_ms)
end

export func cluster_command_slot_once_password_json(Client seed, string slots_response_json, string key, string password, string argv_json, int timeout_ms) as string
