func command_array_with_head(Client client, string command, array<string> values) as string
	string encoded = bulk(command)
	int count = 1
	for value in values
		encoded = encoded + bulk(value)
		count = count + 1
	end
	return command_raw(client, "*" + string.formatInt(count, "") + "\r\n" + encoded)
end

func json_simple(string value) as string
	return "{\"type\":\"simple\",\"value\":" + json_string(value) + "}"
end

func json_error(string value) as string
	return "{\"type\":\"error\",\"value\":" + json_string(value) + "}"
end

func json_integer_text(string value) as string
	return "{\"type\":\"integer\",\"value\":" + value + "}"
end

func json_bulk(string value, bool is_nil) as string
	return "{\"type\":\"bulk\",\"value\":" + json_string(value) + ",\"nil\":" + xredis_bool_text(is_nil) + "}"
end

func json_array(string items, bool is_nil) as string
	return "{\"type\":\"array\",\"items\":[" + items + "],\"nil\":" + xredis_bool_text(is_nil) + "}"
end

func json_null() as string
	return "{\"type\":\"null\",\"nil\":true}"
end

func json_bool(bool value) as string
	return "{\"type\":\"bool\",\"value\":" + xredis_bool_text(value) + "}"
end

func json_double_text(string value) as string
	return "{\"type\":\"double\",\"value\":" + json_string(value) + "}"
end

func json_big_number(string value) as string
	return "{\"type\":\"bignumber\",\"value\":" + json_string(value) + "}"
end

func json_blob_error(string value) as string
	return "{\"type\":\"blob_error\",\"value\":" + json_string(value) + "}"
end

func json_verbatim(string value) as string
	return "{\"type\":\"verbatim\",\"value\":" + json_string(value) + "}"
end

func json_map(string pairs, bool is_nil) as string
	return "{\"type\":\"map\",\"pairs\":[" + pairs + "],\"nil\":" + xredis_bool_text(is_nil) + "}"
end

func json_pair(string key, string value) as string
	return "{\"key\":" + key + ",\"value\":" + value + "}"
end

func json_set(string items, bool is_nil) as string
	return "{\"type\":\"set\",\"items\":[" + items + "],\"nil\":" + xredis_bool_text(is_nil) + "}"
end

func reader_reset(string text)
	g_resp_buffer = text
	g_resp_pos = 0
	g_resp_error = ""
end

func reader_append(string chunk)
	g_resp_buffer = g_resp_buffer + chunk
end

func reader_available() as int
	return string.len(g_resp_buffer) - g_resp_pos
end

func reader_fail(string message) as string
	g_resp_error = message
	return json_error(message)
end

func read_line() as string
	if g_resp_pos > string.len(g_resp_buffer) then
		return ""
	end
	auto rest = xredis_substr_native(g_resp_buffer, g_resp_pos, string.len(g_resp_buffer) - g_resp_pos)
	auto idx = string.indexOf(rest, "\r\n")
	if idx < 0 then
		return ""
	end
	auto line = xredis_substr_native(rest, 0, idx)
	g_resp_pos = g_resp_pos + idx + 2
	return line
end

func parse_one_json() as string
	auto save = g_resp_pos
	g_resp_error = ""
	auto result = parse_value_json(0)
	if result == "" and g_resp_error == "" then
		g_resp_pos = save
	end
	return result
end

func parse_value_json(int depth) as string
	if depth > 16 then
		return reader_fail("RESP array nesting too deep")
	end
	if reader_available() <= 0 then
		return ""
	end
	auto prefix = xredis_substr_native(g_resp_buffer, g_resp_pos, 1)
	g_resp_pos = g_resp_pos + 1
	if prefix == "+" then
		auto line = read_line()
		if line == "" and g_resp_error == "" then
			return ""
		end
		return json_simple(line)
	end
	if prefix == "-" then
		auto line = read_line()
		if line == "" and g_resp_error == "" then
			return ""
		end
		return json_error(line)
	end
	if prefix == ":" then
		auto line = read_line()
		if line == "" and g_resp_error == "" then
			return ""
		end
		return json_integer_text(line)
	end
	if prefix == "$" then
		return parse_bulk_json()
	end
	if prefix == "*" then
		return parse_array_json(depth)
	end
	if prefix == "_" then
		if reader_available() < 2 then
			return ""
		end
		auto crlf = xredis_substr_native(g_resp_buffer, g_resp_pos, 2)
		if crlf != "\r\n" then
			return reader_fail("invalid RESP3 null")
		end
		g_resp_pos = g_resp_pos + 2
		return json_null()
	end
	if prefix == "#" then
		auto line = read_line()
		if line == "" and g_resp_error == "" then
			return ""
		end
		return json_bool(line == "t")
	end
	if prefix == "," then
		auto line = read_line()
		if line == "" and g_resp_error == "" then
			return ""
		end
		return json_double_text(line)
	end
	if prefix == "(" then
		auto line = read_line()
		if line == "" and g_resp_error == "" then
			return ""
		end
		return json_big_number(line)
	end
	if prefix == "!" then
		return parse_blob_error_json()
	end
	if prefix == "=" then
		return parse_verbatim_json()
	end
	if prefix == "%" then
		return parse_map_json(depth)
	end
	if prefix == "~" then
		return parse_set_json(depth)
	end
	return reader_fail("invalid RESP prefix: " + string(prefix))
end

func parse_bulk_json() as string
	auto line = read_line()
	if line == "" then
		return ""
	end
	auto len = int(line)
	if len == -1 then
		return json_bulk("", true)
	end
	if len < 0 then
		return reader_fail("invalid bulk length")
	end
	if reader_available() < len + 2 then
		return ""
	end
	auto value = xredis_substr_native(g_resp_buffer, g_resp_pos, len)
	auto crlf = xredis_substr_native(g_resp_buffer, g_resp_pos + len, 2)
	if crlf != "\r\n" then
		return reader_fail("missing CRLF after bulk body")
	end
	g_resp_pos = g_resp_pos + len + 2
	return json_bulk(value, false)
end

func parse_blob_text() as string
	auto line = read_line()
	if line == "" then
		return ""
	end
	auto len = int(line)
	if len < 0 then
		return reader_fail("invalid bulk length")
	end
	if reader_available() < len + 2 then
		return ""
	end
	auto value = xredis_substr_native(g_resp_buffer, g_resp_pos, len)
	auto crlf = xredis_substr_native(g_resp_buffer, g_resp_pos + len, 2)
	if crlf != "\r\n" then
		return reader_fail("missing CRLF after bulk body")
	end
	g_resp_pos = g_resp_pos + len + 2
	return value
end

func parse_blob_error_json() as string
	auto line = read_line()
	if line == "" then
		return ""
	end
	auto len = int(line)
	if len < 0 then
		return reader_fail("invalid bulk length")
	end
	if reader_available() < len + 2 then
		return ""
	end
	auto value = xredis_substr_native(g_resp_buffer, g_resp_pos, len)
	auto crlf = xredis_substr_native(g_resp_buffer, g_resp_pos + len, 2)
	if crlf != "\r\n" then
		return reader_fail("missing CRLF after bulk body")
	end
	g_resp_pos = g_resp_pos + len + 2
	return json_blob_error(value)
end

func parse_verbatim_json() as string
	auto line = read_line()
	if line == "" then
		return ""
	end
	auto len = int(line)
	if len < 0 then
		return reader_fail("invalid bulk length")
	end
	if reader_available() < len + 2 then
		return ""
	end
	auto value = xredis_substr_native(g_resp_buffer, g_resp_pos, len)
	auto crlf = xredis_substr_native(g_resp_buffer, g_resp_pos + len, 2)
	if crlf != "\r\n" then
		return reader_fail("missing CRLF after bulk body")
	end
	g_resp_pos = g_resp_pos + len + 2
	return json_verbatim(value)
end

func parse_array_json(int depth) as string
	auto line = read_line()
	if line == "" then
		return ""
	end
	auto count = int(line)
	if count == -1 then
		return json_array("", true)
	end
	if count < 0 then
		return reader_fail("invalid array length")
	end
	auto items = ""
	int i = 0
	while i < count do
		auto item = parse_value_json(depth + 1)
		if item == "" then
			return ""
		end
		if g_resp_error != "" then
			return item
		end
		if i > 0 then
			items = items + ","
		end
		items = items + item
		i = i + 1
	end
	return json_array(items, false)
end

func parse_map_json(int depth) as string
	auto line = read_line()
	if line == "" then
		return ""
	end
	auto count = int(line)
	if count == -1 then
		return json_map("", true)
	end
	if count < 0 then
		return reader_fail("invalid map length")
	end
	auto pairs = ""
	int i = 0
	while i < count do
		auto key = parse_value_json(depth + 1)
		if key == "" then
			return ""
		end
		if g_resp_error != "" then
			return key
		end
		auto value = parse_value_json(depth + 1)
		if value == "" then
			return ""
		end
		if g_resp_error != "" then
			return value
		end
		if i > 0 then
			pairs = pairs + ","
		end
		pairs = pairs + json_pair(key, value)
		i = i + 1
	end
	return json_map(pairs, false)
end

func parse_set_json(int depth) as string
	auto line = read_line()
	if line == "" then
		return ""
	end
	auto count = int(line)
	if count == -1 then
		return json_set("", true)
	end
	if count < 0 then
		return reader_fail("invalid set length")
	end
	auto items = ""
	int i = 0
	while i < count do
		auto item = parse_value_json(depth + 1)
		if item == "" then
			return ""
		end
		if g_resp_error != "" then
			return item
		end
		if i > 0 then
			items = items + ","
		end
		items = items + item
		i = i + 1
	end
	return json_set(items, false)
end


func xredis_connect(string host, int port) as Client
	return xredis_connect(host, port, 5000)
end

func xredis_connect(string host, int port, int timeout_ms) as Client
	point socket = null
	string error_text = ""
	try
		socket = xredis_tcp_connect_native(host, port, timeout_ms)
	catch e
		error_text = "tcp connect failed: " + host + ":" + string.formatInt(port, "") + ": " + e.message
	end
	if error_text != "" then
		return Client(host, port, timeout_ms, error_text)
	end
	if socket == null then
		return Client(host, port, timeout_ms, "tcp connect failed: " + host + ":" + string.formatInt(port, ""))
	end
	return Client(socket, host, port, timeout_ms)
end

func xredis_close(Client client) as bool
	return client.close()
end

