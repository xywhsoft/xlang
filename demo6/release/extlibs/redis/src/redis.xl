	return cluster_command_cache_refresh_key_once_json(seed, cache, key, argv_json, seed.timeout_ms)
end

export func cluster_command_cache_refresh_key_once_json(Client seed, ClusterSlotsCache cache, string key, string argv_json, int timeout_ms) as string
	if cluster_slots_cache_valid(cache) == false then
		if cluster_slots_cache_refresh(cache, seed) == false then
			return json_error(seed.last_error_text)
		end
	end
	return cluster_command_cached_key_once_json(seed, cache, key, argv_json, timeout_ms)
end

export func cluster_command_cache_refresh_key_retry_json(Client seed, ClusterSlotsCache cache, string key, string argv_json, int max_redirects) as string
	return cluster_command_cache_refresh_key_retry_json(seed, cache, key, argv_json, max_redirects, seed.timeout_ms)
end

export func cluster_command_cache_refresh_key_retry_json(Client seed, ClusterSlotsCache cache, string key, string argv_json, int max_redirects, int timeout_ms) as string
	if cluster_slots_cache_valid(cache) == false then
		if cluster_slots_cache_refresh(cache, seed) == false then
			return json_error(seed.last_error_text)
		end
	end
	auto result = cluster_command_cached_key_retry_json(seed, cache, key, argv_json, max_redirects, timeout_ms)
	if cluster_redirect_type(result) != "" then
		if cluster_slots_cache_refresh(cache, seed) then
			result = cluster_command_cached_key_retry_json(seed, cache, key, argv_json, max_redirects, timeout_ms)
		end
	end
	if cluster_retryable_error(result) then
		if cluster_slots_cache_refresh(cache, seed) then
			result = cluster_command_cached_key_retry_json(seed, cache, key, argv_json, max_redirects, timeout_ms)
		end
	end
	return result
end

