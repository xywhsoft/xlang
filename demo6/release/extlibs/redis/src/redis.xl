export func cluster_command_slot_retry_json(Client seed, string slots_response_json, string key, string argv_json, int max_redirects) as string
	return cluster_command_slot_retry_json(seed, slots_response_json, key, argv_json, max_redirects, seed.timeout_ms)
end

export func cluster_command_slot_retry_json(Client seed, string slots_response_json, string key, string argv_json, int max_redirects, int timeout_ms) as string
	auto result = cluster_command_slot_once_json(seed, slots_response_json, key, argv_json, timeout_ms)
	int redirects = 0
	while cluster_redirect_type(result) != "" and redirects < max_redirects do
		auto redirect_type = cluster_redirect_type(result)
		auto target = cluster_connect_redirect(result, timeout_ms)
		if target.valid() == false then
			seed.last_error_text = target.last_error()
			return json_error(seed.last_error_text)
		end
		if redirect_type == "ASK" then
			if cluster_asking(target) == false then
				seed.last_error_text = target.last_error()
				auto ask_error = json_error(seed.last_error_text)
				xredis_close(target)
				return ask_error
			end
		end
		result = command_json(target, argv_json)
		xredis_close(target)
		redirects = redirects + 1
	end
	if response_type(result) == "error" then
		seed.last_error_text = response_value(result)
	else
		seed.last_error_text = ""
	end
	return result
end

