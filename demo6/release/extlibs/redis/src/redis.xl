export func cluster_myid(Client client) as string
	auto response = command2(client, "CLUSTER", "MYID")
	return response_value(response)
end

export func cluster_asking(Client client) as bool
	return response_ok(command1(client, "ASKING"))
end

export func cluster_get(Client seed, ClusterSlotsCache cache, string key) as string
	auto response = cluster_command_cache_refresh_key_retry_json(seed, cache, key, argv_json2("GET", key), 1, seed.timeout_ms)
	if response_nil(response) then
		return ""
	end
	return response_value(response)
end

