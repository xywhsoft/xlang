func xredis_bool_text(bool value) as string
	if value then
		return "true"
	end
	return "false"
end
const int OK = 0
const int ERR = 1
const int TIMEOUT = 2
const int CLOSED = 3
const int PROTOCOL_ERROR = 4

const int DEFAULT_TIMEOUT_MS = 5000
const int RECV_SIZE = 4096
const int MAX_RESPONSE_BYTES = 16777216
const int MAX_ARRAY_DEPTH = 16

