end

export func sentinel_command_master_retry_auth_json(Client sentinel, string name, string username, string password, string argv_json, int max_attempts) as string
	return sentinel_command_master_retry_auth_json(sentinel, name, username, password, argv_json, max_attempts, sentinel.timeout_ms)
end

export func sentinel_command_master_retry_auth_json(Client sentinel, string name, string username, string password, string argv_json, int max_attempts, int timeout_ms) as string
	if max_attempts <= 0 then
		max_attempts = 1
	end
	int attempt = 0
	auto result = ""
	while attempt < max_attempts do
		result = sentinel_command_master_once_auth_json(sentinel, name, username, password, argv_json, timeout_ms)
		if response_type(result) != "error" then
			return result
		end
		attempt = attempt + 1
	end
	return result
end

