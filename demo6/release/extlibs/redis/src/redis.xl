func bulk(string value) as string
	return "$" + string.formatInt(string.len(value), "") + "\r\n" + value + "\r\n"
end

export func resp_encode1(string a0) as string
	return "*1\r\n" + bulk(a0)
end

export func resp_encode2(string a0, string a1) as string
	return "*2\r\n" + bulk(a0) + bulk(a1)
end

export func resp_encode3(string a0, string a1, string a2) as string
	return "*3\r\n" + bulk(a0) + bulk(a1) + bulk(a2)
end

export func resp_encode4(string a0, string a1, string a2, string a3) as string
	return "*4\r\n" + bulk(a0) + bulk(a1) + bulk(a2) + bulk(a3)
end

export func resp_encode5(string a0, string a1, string a2, string a3, string a4) as string
	return "*5\r\n" + bulk(a0) + bulk(a1) + bulk(a2) + bulk(a3) + bulk(a4)
end

export func resp_encode_array(list<string> args) as string
	auto result = "*" + string.formatInt(args.length, "") + "\r\n"
	for value in args
		result = result + bulk(value)
	end
	return result
end

func resp_encode_array_values(var args) as string
	auto result = "*" + string.formatInt(args.length, "") + "\r\n"
	for value in args
		result = result + bulk(string(value))
	end
	return result
end

export func resp_encode_json(string argv_json) as string
    var args = json.parse(argv_json)
	return resp_encode_array_values(args)
end

export func resp_encode_pipeline_json(string commands_json) as string
    var commands = json.parse(commands_json)
	auto result = ""
	for command in commands
        var args = command
		result = result + resp_encode_array_values(args)
	end
	return result
end

export func parse_response_json(string text) as string
	reader_reset(text)
	return parse_one_json()
end

export func parse_response_chunks_json(string first, string second) as string
	reader_reset("")
	reader_append(first)
	auto result = parse_one_json()
	if result != "" then
		return result
	end
	reader_append(second)
	return parse_one_json()
end

