export func sentinel_command_master_once_password_json(Client sentinel, string name, string password, string argv_json, int timeout_ms) as string
	auto master = sentinel_connect_master(sentinel, name, timeout_ms)
	if master.valid() == false then
		sentinel.last_error_text = master.last_error()
		return json_error(sentinel.last_error_text)
	end
	auto auth_response = command2(master, "AUTH", password)
	if response_ok(auth_response) == false then
		sentinel.last_error_text = response_value(auth_response)
		xredis_close(master)
		return auth_response
	end
	auto result = command_json(master, argv_json)
	if response_type(result) == "error" then
		sentinel.last_error_text = response_value(result)
	else
		sentinel.last_error_text = ""
	end
	xredis_close(master)
	return result
end

