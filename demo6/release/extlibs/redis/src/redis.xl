	if keys.length <= 0 then
		seed.last_error_text = "cluster_mget_json requires at least one key"
		return json_error(seed.last_error_text)
	end
	return cluster_command_cache_refresh_key_retry_json(seed, cache, keys[0], argv_json_list("MGET", keys), 1, seed.timeout_ms)
end

