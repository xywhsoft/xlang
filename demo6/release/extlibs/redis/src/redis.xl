export func argv_json_list(string command, array<string> values) as string
	auto result = "[" + json_string(command)
	for value in values
		result = result + "," + json_string(value)
	end
	return result + "]"
end

export func pipeline_json_array(array<string> commands) as string
	auto result = "["
	int index = 0
	for command in commands
		if index > 0 then
			result = result + ","
		end
		result = result + command
		index = index + 1
	end
	return result + "]"
end

