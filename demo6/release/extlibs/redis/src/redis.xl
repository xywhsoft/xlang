	auto response = cluster_command_cache_refresh_key_retry_json(seed, cache, key, argv_json2("GET", key), 1, seed.timeout_ms)
	if response_nil(response) then
		return fallback
	end
	if response_type(response) == "error" then
		return fallback
	end
	return response_value(response)
end

