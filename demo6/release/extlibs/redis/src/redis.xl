	if target.valid() == false then
		seed.last_error_text = target.last_error()
		return json_error(seed.last_error_text)
	end
	auto auth_response = command2(target, "AUTH", password)
	if response_ok(auth_response) == false then
		seed.last_error_text = response_value(auth_response)
		xredis_close(target)
		return auth_response
	end
	auto result = command_json(target, argv_json)
	if response_type(result) == "error" then
