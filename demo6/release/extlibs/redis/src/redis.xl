func command_raw(Client client, string encoded) as string
	if client.valid() == false then
		client.last_error_text = "redis client is closed"
		return json_error(client.last_error_text)
	end
	auto sent = xredis_tcp_send_native(client.socket, encoded)
	if sent != string.len(encoded) then
		client.last_error_text = "tcp send failed"
		return json_error(client.last_error_text)
	end
	reader_reset("")
	while string.len(g_resp_buffer) < 16777216 do
		auto chunk = xredis_tcp_recv_native(client.socket, 4096, client.timeout_ms)
		if chunk == "" then
			client.last_error_text = "redis receive timeout or closed connection"
			return json_error(client.last_error_text)
		end
		reader_append(chunk)
		auto parsed = parse_one_json()
		if parsed != "" then
			if g_resp_error != "" then
				client.last_error_text = g_resp_error
				client.close()
			else
				auto typ = response_type(parsed)
				if typ == "error" then
					client.last_error_text = response_value(parsed)
				else
					client.last_error_text = ""
				end
			end
			return parsed
		end
	end
	client.last_error_text = "redis response exceeds maximum buffer"
	client.close()
	return json_error(client.last_error_text)
end

export func command1(Client client, string a0) as string
	return command_raw(client, resp_encode1(a0))
end

export func command2(Client client, string a0, string a1) as string
	return command_raw(client, resp_encode2(a0, a1))
