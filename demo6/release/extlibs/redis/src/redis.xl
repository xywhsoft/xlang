export func cluster_command_redirect_once_json(Client client, string argv_json) as string
	return cluster_command_redirect_once_json(client, argv_json, client.timeout_ms)
end

export func cluster_command_redirect_once_json(Client client, string argv_json, int timeout_ms) as string
	auto first = command_json(client, argv_json)
	auto redirect_type = cluster_redirect_type(first)
	if redirect_type == "" then
		return first
	end
	auto target = cluster_connect_redirect(first, timeout_ms)
	if target.valid() == false then
		client.last_error_text = target.last_error()
		return json_error(client.last_error_text)
	end
	if redirect_type == "ASK" then
		if cluster_asking(target) == false then
			client.last_error_text = target.last_error()
			auto ask_error = json_error(client.last_error_text)
			xredis_close(target)
			return ask_error
		end
	end
	auto result = command_json(target, argv_json)
	if response_type(result) == "error" then
		client.last_error_text = response_value(result)
	else
		client.last_error_text = ""
	end
	xredis_close(target)
	return result
end

export func cluster_command_redirect_retry_json(Client client, string argv_json, int max_redirects) as string
	return cluster_command_redirect_retry_json(client, argv_json, max_redirects, client.timeout_ms)
end

export func cluster_command_redirect_retry_json(Client client, string argv_json, int max_redirects, int timeout_ms) as string
	auto result = command_json(client, argv_json)
	int redirects = 0
	while cluster_redirect_type(result) != "" and redirects < max_redirects do
		auto redirect_type = cluster_redirect_type(result)
		auto target = cluster_connect_redirect(result, timeout_ms)
		if target.valid() == false then
			client.last_error_text = target.last_error()
			return json_error(client.last_error_text)
		end
		if redirect_type == "ASK" then
			if cluster_asking(target) == false then
				client.last_error_text = target.last_error()
				auto ask_error = json_error(client.last_error_text)
				xredis_close(target)
				return ask_error
			end
		end
		result = command_json(target, argv_json)
		xredis_close(target)
		redirects = redirects + 1
	end
	if response_type(result) == "error" then
		client.last_error_text = response_value(result)
	else
		client.last_error_text = ""
	end
	return result
end

export func command_pipeline_json(Client client, string commands_json) as string
    var commands = json.parse(commands_json)
	auto encoded = ""
	for command in commands
        var args = command
		encoded = encoded + resp_encode_array_values(args)
	end
	return command_pipeline_raw(client, encoded, commands.length)
end

func command_pipeline_raw(Client client, string encoded, int count) as string
	if count <= 0 then
		return "[]"
	end
	if client.valid() == false then
		client.last_error_text = "redis client is closed"
		return json_error(client.last_error_text)
	end
	auto sent = xredis_tcp_send_native(client.socket, encoded)
	if sent != string.len(encoded) then
		client.last_error_text = "tcp send failed"
		return json_error(client.last_error_text)
	end
	reader_reset("")
	auto items = ""
	int parsed_count = 0
	while string.len(g_resp_buffer) < 16777216 do
		auto parsed = parse_one_json()
		if parsed != "" then
			if g_resp_error != "" then
				client.last_error_text = g_resp_error
				client.close()
				return json_error(client.last_error_text)
			end
			if response_type(parsed) == "error" then
				client.last_error_text = response_value(parsed)
			end
			if parsed_count > 0 then
				items = items + ","
			end
			items = items + parsed
			parsed_count = parsed_count + 1
			if parsed_count >= count then
				return "[" + items + "]"
			end
		else
			auto chunk = xredis_tcp_recv_native(client.socket, 4096, client.timeout_ms)
			if chunk == "" then
				client.last_error_text = "redis receive timeout or closed connection"
				return json_error(client.last_error_text)
			end
			reader_append(chunk)
		end
	end
	client.last_error_text = "redis response exceeds maximum buffer"
	client.close()
	return json_error(client.last_error_text)
end

export func read_response_json(Client client) as string
	if client.valid() == false then
		client.last_error_text = "redis client is closed"
		return json_error(client.last_error_text)
	end
	if reader_available() <= 0 then
		reader_reset("")
	end
	while string.len(g_resp_buffer) < 16777216 do
		auto parsed = parse_one_json()
		if parsed != "" then
			if g_resp_error != "" then
				client.last_error_text = g_resp_error
				client.close()
			else
				auto typ = response_type(parsed)
				if typ == "error" then
					client.last_error_text = response_value(parsed)
				else
					client.last_error_text = ""
				end
			end
			return parsed
		end
		auto chunk = xredis_tcp_recv_native(client.socket, 4096, client.timeout_ms)
		if chunk == "" then
			client.last_error_text = "redis receive timeout or closed connection"
			return json_error(client.last_error_text)
		end
		reader_append(chunk)
	end
	client.last_error_text = "redis response exceeds maximum buffer"
	client.close()
	return json_error(client.last_error_text)
end

