export func cluster_slots_cache_valid(ClusterSlotsCache cache) as bool
	if cache.slots_json == "" then
		return false
	end
	return response_type(cache.slots_json) == "array"
end

func cluster_redirect_message(string response_json) as string
	if response_type(response_json) != "error" then
		return ""
	end
	auto message = response_value(response_json)
	if string.len(message) >= 5 and xredis_substr_native(message, 0, 5) == "MOVED" then
		return message
	end
	if string.len(message) >= 3 and xredis_substr_native(message, 0, 3) == "ASK" then
		return message
	end
	return ""
end

export func cluster_redirect_type(string response_json) as string
	auto message = cluster_redirect_message(response_json)
	if string.len(message) >= 5 and xredis_substr_native(message, 0, 5) == "MOVED" then
		return "MOVED"
	end
	if string.len(message) >= 3 and xredis_substr_native(message, 0, 3) == "ASK" then
		return "ASK"
	end
	return ""
end

export func cluster_retryable_error(string response_json) as bool
	if response_type(response_json) != "error" then
		return false
	end
	auto message = response_value(response_json)
	if string.len(message) >= 8 and xredis_substr_native(message, 0, 8) == "READONLY" then
		return true
	end
	if string.len(message) >= 8 and xredis_substr_native(message, 0, 8) == "TRYAGAIN" then
		return true
	end
	if string.len(message) >= 11 and xredis_substr_native(message, 0, 11) == "CLUSTERDOWN" then
		return true
	end
	return false
end

export func cluster_redirect_slot(string response_json) as int
	auto message = cluster_redirect_message(response_json)
	auto first = string.indexOf(message, " ")
	if first < 0 then
		return -1
	end
	auto rest = xredis_substr_native(message, first + 1, string.len(message) - first - 1)
	auto second = string.indexOf(rest, " ")
	if second < 0 then
		return -1
	end
	return int(xredis_substr_native(rest, 0, second))
end

export func cluster_redirect_endpoint(string response_json) as string
	auto message = cluster_redirect_message(response_json)
	auto first = string.indexOf(message, " ")
	if first < 0 then
		return ""
	end
	auto rest = xredis_substr_native(message, first + 1, string.len(message) - first - 1)
	auto second = string.indexOf(rest, " ")
	if second < 0 then
		return ""
	end
	return xredis_substr_native(rest, second + 1, string.len(rest) - second - 1)
end

export func cluster_redirect_host(string response_json) as string
	auto endpoint = cluster_redirect_endpoint(response_json)
	auto idx = string.indexOf(endpoint, ":")
	if idx < 0 then
		return endpoint
	end
	return xredis_substr_native(endpoint, 0, idx)
end

export func cluster_redirect_port(string response_json) as int
	auto endpoint = cluster_redirect_endpoint(response_json)
	auto idx = string.indexOf(endpoint, ":")
	if idx < 0 then
		return -1
	end
	return int(xredis_substr_native(endpoint, idx + 1, string.len(endpoint) - idx - 1))
end

export func cluster_connect_redirect(string response_json) as Client
