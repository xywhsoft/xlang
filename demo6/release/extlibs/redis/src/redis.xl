class Client
	point socket
	string host
	int port
	int timeout_ms
	string last_error_text

	create()
		self.socket = null
		self.host = ""
		self.port = 0
		self.timeout_ms = 5000
		self.last_error_text = ""
	end

	create(point socket, string host, int port, int timeout_ms)
		self.socket = socket
		self.host = host
		self.port = port
		self.timeout_ms = timeout_ms
		self.last_error_text = ""
	end

	create(point socket, string host, int port, int timeout_ms, string last_error_text)
		self.socket = socket
		self.host = host
		self.port = port
		self.timeout_ms = timeout_ms
		self.last_error_text = last_error_text
	end

	create(string host, int port, int timeout_ms, string last_error_text)
		self.socket = null
		self.host = host
		self.port = port
		self.timeout_ms = timeout_ms
		self.last_error_text = last_error_text
	end

	func valid() as bool
		return self.socket != null
	end

	func close() as bool
		if self.socket == null then
			return false
		end
		auto ok = xredis_tcp_close_native(self.socket)
		self.socket = null
		return ok
	end

	func last_error() as string
		return self.last_error_text
	end

	func set_timeout(int timeout_ms)
		self.timeout_ms = timeout_ms
	end

	func command(string a0) as string
		return command1(self, a0)
	end

	func command(string a0, string a1) as string
		return command2(self, a0, a1)
	end

	func command(string a0, string a1, string a2) as string
		return command3(self, a0, a1, a2)
	end

	func command(string a0, string a1, string a2, string a3) as string
		return command4(self, a0, a1, a2, a3)
	end

	func command(string a0, string a1, string a2, string a3, string a4) as string
		return command5(self, a0, a1, a2, a3, a4)
	end

	func get(string key) as string
		return get_value(self, key)
	end

	func get_or(string key, string fallback) as string
		auto response = command2(self, "GET", key)
		if response_nil(response) then
			return fallback
		end
		if response_type(response) == "error" then
			return fallback
		end
		return response_value(response)
	end

	func set_value(string key, string value) as bool
		return xredis_set(self, key, value)
	end

	func delete(string key) as int
		return xredis_del(self, key)
	end

	func exists(string key) as bool
		return xredis_exists(self, key)
	end

	func select_db(int db) as bool
		return xredis_select(self, db)
	end

	func length(string key) as int
		return xredis_strlen(self, key)
	end

	func incr(string key) as int
		return response_int(command2(self, "INCR", key))
	end

	func decr(string key) as int
		return response_int(command2(self, "DECR", key))
	end
end

class Pool
	string host
	int port
	int timeout_ms
	int max_idle
	int idle_count
	point socket0
	point socket1
	point socket2
	point socket3

	create(string host, int port, int timeout_ms, int max_idle)
		self.host = host
		self.port = port
		self.timeout_ms = timeout_ms
		self.max_idle = max_idle
		self.idle_count = 0
		self.socket0 = null
		self.socket1 = null
		self.socket2 = null
		self.socket3 = null
	end

	func acquire() as Client
		if self.idle_count == 4 then
			self.idle_count = 3
			auto socket = self.socket3
			self.socket3 = null
			return Client(socket, self.host, self.port, self.timeout_ms)
		end
		if self.idle_count == 3 then
			self.idle_count = 2
			auto socket = self.socket2
			self.socket2 = null
			return Client(socket, self.host, self.port, self.timeout_ms)
		end
		if self.idle_count == 2 then
			self.idle_count = 1
			auto socket = self.socket1
			self.socket1 = null
			return Client(socket, self.host, self.port, self.timeout_ms)
		end
		if self.idle_count == 1 then
			self.idle_count = 0
			auto socket = self.socket0
			self.socket0 = null
			return Client(socket, self.host, self.port, self.timeout_ms)
		end
		return xredis_connect(self.host, self.port, self.timeout_ms)
	end

	func release(Client client) as bool
		if client.valid() == false then
			return false
		end
		if self.idle_count >= self.max_idle or self.idle_count >= 4 then
			client.close()
			return false
		end
		if self.idle_count == 0 then
			self.socket0 = client.socket
		end
		if self.idle_count == 1 then
			self.socket1 = client.socket
		end
		if self.idle_count == 2 then
			self.socket2 = client.socket
		end
		if self.idle_count == 3 then
			self.socket3 = client.socket
		end
		client.socket = null
		self.idle_count = self.idle_count + 1
		return true
	end

	func close() as int
		int count = 0
		if self.socket0 != null then
			xredis_tcp_close_native(self.socket0)
			self.socket0 = null
			count = count + 1
		end
		if self.socket1 != null then
			xredis_tcp_close_native(self.socket1)
			self.socket1 = null
			count = count + 1
		end
		if self.socket2 != null then
			xredis_tcp_close_native(self.socket2)
			self.socket2 = null
			count = count + 1
		end
		if self.socket3 != null then
			xredis_tcp_close_native(self.socket3)
			self.socket3 = null
			count = count + 1
		end
		self.idle_count = 0
		return count
	end

	func idle_size() as int
		return self.idle_count
	end
end

class ClusterSlotsCache
