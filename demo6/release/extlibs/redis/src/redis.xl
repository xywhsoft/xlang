export func cluster_command_key_retry_json(Client seed, string key, string argv_json, int max_redirects, int timeout_ms) as string
	auto slots = cluster_slots_json(seed)
	if response_type(slots) == "error" then
		seed.last_error_text = response_value(slots)
		return slots
	end
	return cluster_command_slot_retry_json(seed, slots, key, argv_json, max_redirects, timeout_ms)
end

