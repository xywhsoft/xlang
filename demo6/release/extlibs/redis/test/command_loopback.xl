import redis

func serve(TcpStream peer, string response) as int
    string request = ""
    while not redis.isComplete(request)
        string chunk = peer.recv(5000)
        assert chunk != ""
        request += chunk
    end
    var command = redis.decode(request)
    assert command["value"]["type"] == "array"
    assert command["value"]["value"].length == 1
    assert command["value"]["value"][0]["value"] == "PING"
    if response == "+PONG\r\n" then
        assert peer.send("+PO")
        assert peer.drain(5000)
        time.sleep(20)
        assert peer.send("NG\r\n")
    else
        assert peer.send(response)
    end
    assert peer.drain(5000)
    peer.close()
    return 1
end

// 持续滴送不完整 bulk；单次读取都能及时返回，但整条命令必须按总期限失败。
func serveSlow(TcpStream peer) as int
    string request = ""
    while not redis.isComplete(request)
        string chunk = peer.recv(5000)
        assert chunk != ""
        request += chunk
    end
    peer.send("$10\r\n")
    peer.drain(5000)
    for i in range(7)
        time.sleep(900)
        try
            if not peer.send("x") then break end
            if not peer.drain(5000) then break end
        catch ValueError error
            break
        end
    end
    peer.close()
    return 1
end

// 畸形回复后保持服务端连接，验证客户端主动终止失同步的流。
func serveMalformed(TcpStream peer) as int
    string request = ""
    while not redis.isComplete(request)
        string chunk = peer.recv(5000)
        assert chunk != "", "malformed server request ended early"
        request += chunk
    end
    assert peer.send("?bad\r\n"), "malformed server send failed"
    assert peer.drain(5000), "malformed server drain failed"
    time.sleep(1000)
    peer.close()
    return 1
end

// 完整命令收到半截 bulk 后断线，客户端必须丢弃失同步连接。
func servePartial(TcpStream peer) as int
    string request = ""
    while not redis.isComplete(request)
        string chunk = peer.recv(5000)
        assert chunk != "", "partial server request ended early"
        request += chunk
    end
    assert peer.send("$5\r\nab"), "partial server send failed"
    assert peer.drain(5000), "partial server drain failed"
    peer.close()
    return 1
end

func serveBinaryError(TcpStream peer) as int
    string request = ""
    while not redis.isComplete(request)
        string chunk = peer.recv(5000)
        assert chunk != "", "binary error server request ended early"
        request += chunk
    end
    Buffer response = Buffer.fromHex("2d45525220ff0d0a")
    assert peer.sendBytes(response.data(), c_size(response.len()))
    assert peer.drain(5000)
    request = ""
    while not redis.isComplete(request)
        string chunk = peer.recv(5000)
        assert chunk != "", "binary error follow-up request ended early"
        request += chunk
    end
    assert redis.decode(request)["value"]["value"][0]["value"] == "PING"
    assert peer.send("+PONG\r\n")
    assert peer.drain(5000)
    peer.close()
    return 1
end

func serveStalled(TcpStream peer) as int
    string request = ""
    while not redis.isComplete(request)
        string chunk = peer.recv(5000)
        assert chunk != ""
        request += chunk
    end
    time.sleep(250)
    peer.close()
    return 1
end

func main(...) as int
    TcpServer server = tcp.listen(0)
    TcpStream client = tcp.connect("127.0.0.1", int(server.port()), 5000)
    TcpStream peer = server.accept(5000)
    future<int> job = task.spawn(serve, peer, "+PONG\r\n")
    bool invalidTimeout = false
    try
        redis.command(client, ["PING"], 0)
    catch ValueError error
        invalidTimeout = true
    end
    assert invalidTimeout
    bool invalidLimit = false
    try
        redis.command(client, ["PING"], 250, 0)
    catch ValueError error
        invalidLimit = true
    end
    assert invalidLimit
    bool invalidArgs = false
    try
        redis.command(client, [])
    catch ValueError error
        invalidArgs = true
    end
    assert invalidArgs, "invalid command must fail before sending"
    assert redis.command(client, ["PING"], 250) == "PONG"
    assert job.wait()
    client.close()

    TcpStream client2 = tcp.connect("127.0.0.1", int(server.port()), 5000)
    TcpStream peer2 = server.accept(5000)
    future<int> job2 = task.spawn(serve, peer2, "-ERR denied\r\n")
    bool rejected = false
    try
        redis.command(client2, ["PING"])
    catch ValueError error
        rejected = true
    end
    assert rejected
    assert job2.wait()
    client2.close()

    TcpStream binaryErrorClient = tcp.connect("127.0.0.1", int(server.port()), 5000)
    TcpStream binaryErrorPeer = server.accept(5000)
    future<int> binaryErrorJob = task.spawn(serveBinaryError, binaryErrorPeer)
    bool binaryErrorRejected = false
    try
        redis.command(binaryErrorClient, ["PING"])
    catch ValueError error
        binaryErrorRejected = string.indexOf(error.message, "redis:", false,
            string.byteLen(error.message), 1) == 0
    end
    assert binaryErrorRejected, "binary server error must become ValueError"
    assert redis.command(binaryErrorClient, ["PING"]) == "PONG", "complete binary error must leave the connection synchronized"
    assert binaryErrorJob.wait(), "binary error server task failed"
    binaryErrorClient.close()

    TcpStream malformedClient = tcp.connect("127.0.0.1", int(server.port()), 5000)
    TcpStream malformedPeer = server.accept(5000)
    future<int> malformedJob = task.spawn(serveMalformed, malformedPeer)
    bool malformedRejected = false
    try
        redis.command(malformedClient, ["PING"])
    catch ValueError error
        malformedRejected = error.message == "RESP reply is malformed"
    end
    assert malformedRejected, "malformed reply must report a protocol error"
    assert not malformedClient.send("PING"), "malformed reply must abort the stream"
    assert malformedJob.wait(), "malformed server task failed"
    malformedClient.close()

    TcpStream partialClient = tcp.connect("127.0.0.1", int(server.port()), 5000)
    TcpStream partialPeer = server.accept(5000)
    future<int> partialJob = task.spawn(servePartial, partialPeer)
    bool partialRejected = false
    try
        redis.command(partialClient, ["PING"])
    catch ValueError error
        partialRejected = true
    end
    assert partialRejected, "partial reply must fail when the peer closes"
    assert not partialClient.send("PING"), "partial reply must abort the stream"
    assert partialJob.wait(), "partial server task failed"
    partialClient.close()

    TcpStream limitedClient = tcp.connect("127.0.0.1", int(server.port()), 5000)
    TcpStream limitedPeer = server.accept(5000)
    future<int> limitedJob = task.spawn(serve, limitedPeer, "$10\r\nabcdefghij\r\n")
    bool limitRejected = false
    try
        redis.command(limitedClient, ["PING"], 5000, 8)
    catch ValueError error
        limitRejected = error.message == "redis: reply exceeds configured limit"
    end
    assert limitRejected, "configured reply limit was not enforced"
    assert not limitedClient.send("PING"), "reply limit must abort the stream"
    assert limitedJob.wait()
    limitedClient.close()

    TcpStream stalledClient = tcp.connect("127.0.0.1", int(server.port()), 5000)
    TcpStream stalledPeer = server.accept(5000)
    future<int> stalledJob = task.spawn(serveStalled, stalledPeer)
    uint64 shortStarted = time.monotonic()
    bool shortTimedOut = false
    try
        redis.command(stalledClient, ["PING"], 80)
    catch ValueError error
        shortTimedOut = error.message == "redis: command timed out"
    end
    assert shortTimedOut, "configured deadline was not enforced"
    assert time.monotonic() - shortStarted < 1_000_000
    assert not stalledClient.send("PING"), "deadline must abort the stream"
    assert stalledJob.wait()
    stalledClient.close()

    TcpStream client3 = tcp.connect("127.0.0.1", int(server.port()), 5000)
    TcpStream peer3 = server.accept(5000)
    future<int> job3 = task.spawn(serve, peer3, "$3\r\na\0b\r\n")
    var binary = redis.command(client3, ["PING"])
    assert string.byteLen(string(binary)) == 3
    assert string(binary) == "a\0b"
    assert job3.wait()
    client3.close()

    TcpStream slowClient = tcp.connect("127.0.0.1", int(server.port()), 5000)
    TcpStream slowPeer = server.accept(5000)
    future<int> slowJob = task.spawn(serveSlow, slowPeer)
    uint64 started = time.monotonic()
    bool timedOut = false
    try
        redis.command(slowClient, ["PING"])
    catch ValueError error
        timedOut = error.message == "redis: command timed out"
    end
    uint64 elapsed = time.monotonic() - started
    assert timedOut, "slow RESP reply must hit the total deadline"
    assert elapsed >= 4_000_000 and elapsed < 6_000_000, "redis deadline is not bounded"
    assert not slowClient.send("PING"), "timed out command must abort the stream"
    assert slowJob.wait(), "slow server task failed"
    slowClient.close()
    server.close()
    println("redis command loopback: ok")
    return 0
end
