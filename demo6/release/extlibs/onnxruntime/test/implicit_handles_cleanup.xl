import onnxruntime

func main(...) as int
    assert onnxruntime.available()
    auto sessionOptions = onnxruntime.SessionOptions()
    auto runOptions = onnxruntime.RunOptions()
    assert sessionOptions.valid() and runOptions.valid()
    auto session = onnxruntime.InferenceSession(
        "extlibs/rapidocr/models/ch_ppocr_mobile_v2.0_cls_infer.onnx", sessionOptions)
    assert session.valid(), session.error()
    auto tensor = onnxruntime.TensorZerosF32("[1,3,48,192]")
    assert tensor.valid(), tensor.error()
    auto result = session.run_tensor("x", tensor, "[\"save_infer_model/scale_0.tmp_1\"]")
    assert result.valid(), result.error()
    auto binding = session.io_binding()
    assert binding.valid(), binding.error()
    return 0
end
