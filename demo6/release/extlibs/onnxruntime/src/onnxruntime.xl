	end
end

class InferenceSessionObject
    point handle

	create(point handle)
		self.handle = handle
	end

	create(string model_path)
		__ort_c_text(model_path)
		self.handle = ort_session_create_native(model_path, null)
	end

	create(string model_path, SessionOptionsObject options)
		__ort_c_text(model_path)
		self.handle = ort_session_create_native(model_path, options.handle)
	end

	func release() as bool
		if self.handle != null then
			ort_session_release_native(self.handle)
			self.handle = null
			return true
		end
		return false
	end

	destroy()
		if self.handle != null then
			ort_session_release_native(self.handle)
			self.handle = null
		end
	end

	func valid() as bool
		return self.handle != null
	end

	func ok() as bool
		return self.handle != null
	end

	func error() as string
		return ort_last_error_native()
	end

	func get_providers() as string
		return ort_get_available_providers_json_native()
	end

	func get_inputs() as string
		return ort_session_inputs_native(self.handle)
	end

	func get_outputs() as string
		return ort_session_outputs_native(self.handle)
	end

	func get_modelmeta() as string
		return ort_session_modelmeta_native(self.handle)
	end

	func end_profiling() as string
		return ort_session_end_profiling_native(self.handle)
	end

	func io_binding() as IoBindingObject
		return IoBindingObject(self.handle)
	end

	func run(string output_names_json, string input_feed_json) as RunResult
		__ort_c_text(output_names_json)
		__ort_c_text(input_feed_json)
		return RunResult(ort_session_run_json_native(self.handle, output_names_json, input_feed_json))
	end

	func run(string output_names_json, string input_feed_json, RunOptionsObject run_options) as RunResult
		__ort_c_text(output_names_json)
		__ort_c_text(input_feed_json)
		return RunResult(ort_session_run_json_with_options_native(self.handle, output_names_json, input_feed_json, run_options.handle))
	end

	func run_tensor(string input_name, TensorObject tensor, string output_names_json) as RunResult
		__ort_c_text(input_name)
		__ort_c_text(output_names_json)
		return RunResult(ort_session_run_tensor_native(self.handle, input_name, tensor.handle, output_names_json))
	end

	func run_tensor_fast(string input_name, TensorObject tensor, string output_names_json) as RunResult
		__ort_c_text(input_name)
		__ort_c_text(output_names_json)
		return RunResult(ort_session_run_tensor_fast_native(self.handle, input_name, tensor.handle, output_names_json))
	end

	func run_with_iobinding(IoBindingObject binding) as RunResult
		return RunResult(ort_session_run_with_iobinding_native(self.handle, binding.handle, null))
	end

	func run_with_iobinding(IoBindingObject binding, RunOptionsObject run_options) as RunResult
		return RunResult(ort_session_run_with_iobinding_native(self.handle, binding.handle, run_options.handle))
	end
end

export func SessionOptions() as SessionOptionsObject
	return SessionOptionsObject()
end

export func CpuSessionOptions(int intra_op, int inter_op) as SessionOptionsObject
	auto options = SessionOptionsObject()
	options.set_threads(intra_op, inter_op)
	options.optimize_all()
	options.use_cpu()
	return options
end

export func RunOptions() as RunOptionsObject
	return RunOptionsObject()
end

export func RunResultFromHandle(point handle) as RunResult
	return RunResult(handle)
end

export func TensorZerosF32(string shape_json) as TensorObject
	__ort_c_text(shape_json)
	return TensorObject(ort_tensor_zeros_f32_native(shape_json))
end

export func TensorFromOpenCV(point image, float scale, float mean0, float mean1, float mean2, float std0, float std1, float std2) as TensorObject
	return TensorObject(ort_tensor_from_opencv_native(image, scale, mean0, mean1, mean2, std0, std1, std2))
end

export func TensorFromOpenCVResized(point image, int width, int height, float scale, float mean0, float mean1, float mean2, float std0, float std1, float std2) as TensorObject
	if not __fits_c_int(width) or not __fits_c_int(height) then
		return TensorObject(null)
	end
	return TensorObject(ort_tensor_from_opencv_resized_native(image, c_int(width), c_int(height), scale, mean0, mean1, mean2, std0, std1, std2))
end

export func TensorFromOpenCVBatch(int batch_count, point image0, point image1, point image2, point image3, point image4, point image5, float scale, float mean0, float mean1, float mean2, float std0, float std1, float std2) as TensorObject
	if not __fits_c_int(batch_count) then
		return TensorObject(null)
	end
	return TensorObject(ort_tensor_from_opencv_batch_native(c_int(batch_count), image0, image1, image2, image3, image4, image5, scale, mean0, mean1, mean2, std0, std1, std2))
end

export func InferenceSession(string model_path) as InferenceSessionObject
	return InferenceSessionObject(model_path)
end

export func InferenceSession(string model_path, SessionOptionsObject options) as InferenceSessionObject
	return InferenceSessionObject(model_path, options)
end

export func InferenceSessionFromHandle(point handle) as InferenceSessionObject
	return InferenceSessionObject(handle)
end

export func available() as bool
	return ort_available_native() != 0
end

export func backend() as string
	return ort_backend_native()
end

export func get_version_string() as string
	return ort_get_version_string_native()
end

export func version() as string
	return get_version_string()
end

export func get_available_providers() as string
	return ort_get_available_providers_json_native()
end

export func get_providers() as string
	return get_available_providers()
end

export func last_error() as string
	return ort_last_error_native()
end

export func get_last_error() as string
	return last_error()
end
















