class RunResult
    point handle

	create(point handle)
		self.handle = handle
	end

	func release() as bool
		if self.handle != null then
			ort_result_release_native(self.handle)
			self.handle = null
			return true
		end
		return false
	end

	destroy()
		if self.handle != null then
			ort_result_release_native(self.handle)
			self.handle = null
		end
	end

	func ok() as bool
		return self.handle != null
	end

	func valid() as bool
		return self.handle != null
	end

	func error() as string
		return ort_last_error_native()
	end

	func to_json() as string
		return ort_result_json_native(self.handle)
	end

	func float_shape_json() as string
		return ort_result_float_shape_json_native(self.handle)
	end

	func float_count() as int
		return ort_result_float_count_native(self.handle)
	end

	func float_at(int index) as float
		if not __fits_c_int(index) then
			return 0.0
		end
		return ort_result_float_at_native(self.handle, c_int(index))
	end
end

