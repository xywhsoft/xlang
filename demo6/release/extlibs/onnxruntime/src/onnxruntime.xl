class SessionOptionsObject
    point handle

	create()
		self.handle = ort_session_options_create_native()
	end

	func release() as bool
		if self.handle != null then
			ort_session_options_release_native(self.handle)
			self.handle = null
			return true
		end
		return false
	end

	func valid() as bool
		return self.handle != null
	end

	func ok() as bool
		return self.handle != null
	end

	func error() as string
		return ort_last_error_native()
	end

	func set_intra_op_num_threads(int value) as bool
		return ort_session_options_set_intra_op_num_threads_native(self.handle, value) != 0
	end

	func set_inter_op_num_threads(int value) as bool
		return ort_session_options_set_inter_op_num_threads_native(self.handle, value) != 0
	end

	func set_graph_optimization_level(int value) as bool
		return ort_session_options_set_graph_optimization_level_native(self.handle, value) != 0
	end

	func set_execution_mode(int value) as bool
		return ort_session_options_set_execution_mode_native(self.handle, value) != 0
	end

	func enable_profiling(string prefix) as bool
		return ort_session_options_enable_profiling_native(self.handle, prefix) != 0
	end

	func disable_profiling() as bool
		return ort_session_options_disable_profiling_native(self.handle) != 0
	end

	func enable_cpu_mem_arena() as bool
		return ort_session_options_enable_cpu_mem_arena_native(self.handle) != 0
	end

	func disable_cpu_mem_arena() as bool
		return ort_session_options_disable_cpu_mem_arena_native(self.handle) != 0
	end

	func enable_mem_pattern() as bool
		return ort_session_options_enable_mem_pattern_native(self.handle) != 0
	end

	func disable_mem_pattern() as bool
		return ort_session_options_disable_mem_pattern_native(self.handle) != 0
	end

	func set_log_id(string value) as bool
		return ort_session_options_set_log_id_native(self.handle, value) != 0
	end

	func set_log_verbosity_level(int value) as bool
		return ort_session_options_set_log_verbosity_level_native(self.handle, value) != 0
	end

	func set_log_severity_level(int value) as bool
		return ort_session_options_set_log_severity_level_native(self.handle, value) != 0
	end

	func append_execution_provider(string provider_name) as bool
		return ort_session_options_append_execution_provider_native(self.handle, provider_name) != 0
	end

	func append_execution_provider(string provider_name, string options_json) as bool
		return ort_session_options_append_execution_provider_with_options_native(self.handle, provider_name, options_json) != 0
	end
end

