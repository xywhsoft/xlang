const int ORT_DISABLE_ALL = 0
const int ORT_ENABLE_BASIC = 1
const int ORT_ENABLE_EXTENDED = 2
const int ORT_ENABLE_ALL = 99

const int ORT_SEQUENTIAL = 0
const int ORT_PARALLEL = 1

const int ORT_LOGGING_LEVEL_VERBOSE = 0
const int ORT_LOGGING_LEVEL_INFO = 1
const int ORT_LOGGING_LEVEL_WARNING = 2
const int ORT_LOGGING_LEVEL_ERROR = 3
const int ORT_LOGGING_LEVEL_FATAL = 4

const string CPUExecutionProvider = "CPUExecutionProvider"

func __fits_c_int(int value) as bool
	return value >= -2147483648 and value <= 2147483647
end

// 桥接 API 接收零结尾文本；不能把 NUL 后缀悄悄丢给后端。
func __ort_c_text(string value)
	if string.indexOf(value, "\0", false, string.byteLen(value), 1) >= 0 then
		throw ValueError "onnxruntime text contains NUL"
	end
end

class SessionOptionsObject
    point handle

	create()
		self.handle = ort_session_options_create_native()
	end

	func release() as bool
		if self.handle != null then
			ort_session_options_release_native(self.handle)
			self.handle = null
			return true
		end
		return false
	end

	destroy()
		if self.handle != null then
			ort_session_options_release_native(self.handle)
			self.handle = null
		end
	end

	func valid() as bool
		return self.handle != null
	end

	func ok() as bool
		return self.handle != null
	end

	func error() as string
		return ort_last_error_native()
	end

	func set_intra_op_num_threads(int value) as bool
		if not __fits_c_int(value) then
			return false
		end
		return ort_session_options_set_intra_op_num_threads_native(self.handle, c_int(value)) != 0
	end

	func set_inter_op_num_threads(int value) as bool
		if not __fits_c_int(value) then
			return false
		end
		return ort_session_options_set_inter_op_num_threads_native(self.handle, c_int(value)) != 0
	end

	func set_graph_optimization_level(int value) as bool
		if not __fits_c_int(value) then
			return false
		end
		return ort_session_options_set_graph_optimization_level_native(self.handle, c_int(value)) != 0
	end

	func set_execution_mode(int value) as bool
		if not __fits_c_int(value) then
			return false
		end
		return ort_session_options_set_execution_mode_native(self.handle, c_int(value)) != 0
	end

	func enable_profiling(string prefix) as bool
		__ort_c_text(prefix)
		return ort_session_options_enable_profiling_native(self.handle, prefix) != 0
	end

	func disable_profiling() as bool
		return ort_session_options_disable_profiling_native(self.handle) != 0
	end

	func enable_cpu_mem_arena() as bool
		return ort_session_options_enable_cpu_mem_arena_native(self.handle) != 0
	end

	func disable_cpu_mem_arena() as bool
		return ort_session_options_disable_cpu_mem_arena_native(self.handle) != 0
	end

	func enable_mem_pattern() as bool
		return ort_session_options_enable_mem_pattern_native(self.handle) != 0
	end

	func disable_mem_pattern() as bool
		return ort_session_options_disable_mem_pattern_native(self.handle) != 0
	end

	func set_log_id(string value) as bool
		__ort_c_text(value)
		return ort_session_options_set_log_id_native(self.handle, value) != 0
	end

	func set_log_verbosity_level(int value) as bool
		if not __fits_c_int(value) then
			return false
		end
		return ort_session_options_set_log_verbosity_level_native(self.handle, c_int(value)) != 0
	end

	func set_log_severity_level(int value) as bool
		if not __fits_c_int(value) then
			return false
		end
		return ort_session_options_set_log_severity_level_native(self.handle, c_int(value)) != 0
	end

	func append_execution_provider(string provider_name) as bool
		__ort_c_text(provider_name)
		return ort_session_options_append_execution_provider_native(self.handle, provider_name) != 0
	end

	func append_execution_provider(string provider_name, string options_json) as bool
		__ort_c_text(provider_name)
		__ort_c_text(options_json)
		return ort_session_options_append_execution_provider_with_options_native(self.handle, provider_name, options_json) != 0
	end

	func set_threads(int intra_op, int inter_op) as bool
		bool ok1 = self.set_intra_op_num_threads(intra_op)
		bool ok2 = self.set_inter_op_num_threads(inter_op)
		return ok1 and ok2
	end

	func optimize_all() as bool
		return self.set_graph_optimization_level(ORT_ENABLE_ALL)
	end

	func use_cpu() as bool
		return self.append_execution_provider(CPUExecutionProvider)
	end
end

