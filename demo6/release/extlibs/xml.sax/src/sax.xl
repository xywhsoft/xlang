extern "xsax_open_memory" func __sax_open_memory(point data,
    c_ulonglong size, c_bool namespaceAware, c_bool preserveComments,
    c_bool allowDtd, c_bool allowExternalEntities, c_ulonglong maxInput,
    c_ulonglong maxOutput, c_ulonglong maxItem, c_ulonglong maxEntries,
    c_ulonglong maxNodes, c_uint maxDepth) as point
extern "xsax_open_file" func __sax_open_file(string path,
    c_bool namespaceAware, c_bool preserveComments, c_bool allowDtd,
    c_bool allowExternalEntities, c_ulonglong maxInput,
    c_ulonglong maxOutput, c_ulonglong maxItem, c_ulonglong maxEntries,
    c_ulonglong maxNodes, c_uint maxDepth) as point
extern "xsax_next" func __sax_next(point handle) as var
extern "xsax_status" func __sax_status() as int
extern "xsax_error_code" func __sax_error_code() as int
extern "xsax_error_line" func __sax_error_line() as int
extern "xsax_error_column" func __sax_error_column() as int
extern "xsax_error_offset" func __sax_error_offset() as int
extern "xsax_error_message" func __sax_error_message() as point



func __sax_error() as string
    return __xl_std_runtime_take_cstr(__sax_error_message())
end

class ReaderIter
    native point handle
    extern "xsax_retain" create(point handle)
    extern "xsax_destroy" destroy()

    func __next__() as (bool, var)
        var result = __sax_next(self.handle)
        if result == null and __sax_status() < 0 then
            throw XmlError __sax_error()
        end
        return result != null, result
    end
end

class Reader
    native point handle
    extern "xsax_destroy" destroy()

    func next() as var
        var result = __sax_next(self.handle)
        if result == null and __sax_status() < 0 then
            throw XmlError __sax_error()
        end
        return result
    end

    func __iter__() as ReaderIter
        return ReaderIter(self.handle)
    end

    func __next__() as (bool, var)
        var result = self.next()
        return result != null, result
    end
end

export func errorCode() as int
    return __sax_error_code()
end

export func errorLine() as int
    return __sax_error_line()
end

export func errorColumn() as int
    return __sax_error_column()
end

export func errorOffset() as int
    return __sax_error_offset()
end

export func reader(string text, bool namespaceAware = true,
    bool preserveComments = true, bool allowDtd = false,
    bool allowExternalEntities = false, int maxInput = 268435456,
    int maxOutput = 536870912, int maxItem = 268435456,
    int maxEntries = 100000, int maxNodes = 1000000,
    int maxDepth = 128) as Reader
    Buffer data = Buffer()
    data.append(text)
    point handle = __sax_open_memory(data.data(), c_ulonglong(data.len()),
        c_bool(namespaceAware), c_bool(preserveComments), c_bool(allowDtd),
        c_bool(allowExternalEntities), c_ulonglong(maxInput),
        c_ulonglong(maxOutput), c_ulonglong(maxItem),
        c_ulonglong(maxEntries), c_ulonglong(maxNodes), c_uint(maxDepth))
    if handle == null then throw XmlError __sax_error() end
    return Reader(handle)
end

export func open(string path, bool namespaceAware = true,
    bool preserveComments = true, bool allowDtd = false,
    bool allowExternalEntities = false, int maxInput = 268435456,
    int maxOutput = 536870912, int maxItem = 268435456,
    int maxEntries = 100000, int maxNodes = 1000000,
    int maxDepth = 128) as Reader
    point handle = __sax_open_file(path, c_bool(namespaceAware),
        c_bool(preserveComments), c_bool(allowDtd),
        c_bool(allowExternalEntities), c_ulonglong(maxInput),
        c_ulonglong(maxOutput), c_ulonglong(maxItem),
        c_ulonglong(maxEntries), c_ulonglong(maxNodes), c_uint(maxDepth))
    if handle == null then throw XmlError __sax_error() end
    return Reader(handle)
end

export func parse(string text, func(var) handler,
    bool namespaceAware = true, bool preserveComments = true,
    bool allowDtd = false, bool allowExternalEntities = false,
    int maxInput = 268435456, int maxOutput = 536870912,
    int maxItem = 268435456, int maxEntries = 100000,
    int maxNodes = 1000000, int maxDepth = 128)
    Reader source = reader(text, namespaceAware, preserveComments, allowDtd,
        allowExternalEntities, maxInput, maxOutput, maxItem, maxEntries,
        maxNodes, maxDepth)
    for event in source
        handler(event)
    end
end

export func parseFile(string path, func(var) handler,
    bool namespaceAware = true, bool preserveComments = true,
    bool allowDtd = false, bool allowExternalEntities = false,
    int maxInput = 268435456, int maxOutput = 536870912,
    int maxItem = 268435456, int maxEntries = 100000,
    int maxNodes = 1000000, int maxDepth = 128)
    Reader source = open(path, namespaceAware, preserveComments, allowDtd,
        allowExternalEntities, maxInput, maxOutput, maxItem, maxEntries,
        maxNodes, maxDepth)
    for event in source
        handler(event)
    end
end
