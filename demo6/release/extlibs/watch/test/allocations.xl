import watch

extern "xrtMemDebugFailAfter" func __watch_fail_after(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func __watch_fail_triggered() as c_bool
extern "xrtMemDebugFailClear" func __watch_fail_clear()

int createFailures = 0
int addFailures = 0
int pollFailures = 0
bool createCompleted = false
bool addCompleted = false
bool pollCompleted = false

// 每次故障都使用新实例，避免上一次成功添加的路径改变后续扫描。
for allocation in range(16)
    assert __watch_fail_after(uint64(allocation))
    bool createCaught = false
    try
        watch.create()
    catch MemoryError error
        createCaught = true
    end
    bool createTriggered = __watch_fail_triggered()
    __watch_fail_clear()
    assert createCaught == createTriggered
    if createTriggered then createFailures += 1 else createCompleted = true end

    auto adding = watch.create()
    assert __watch_fail_after(uint64(allocation))
    bool addCaught = false
    try
        adding.add("missing-watch-allocation")
    catch MemoryError error
        addCaught = true
    end
    bool addTriggered = __watch_fail_triggered()
    __watch_fail_clear()
    assert addCaught == addTriggered
    if addTriggered then
        addFailures += 1
        assert adding.count == 0
        assert adding.add("missing-watch-allocation") == 0
    else
        addCompleted = true
        assert adding.count == 1
    end
    assert adding.remove(0)

    auto polling = watch.create()
    assert polling.add("missing-watch-allocation") == 0
    assert __watch_fail_after(uint64(allocation))
    bool pollCaught = false
    try
        assert polling.poll() == ""
    catch MemoryError error
        pollCaught = true
    end
    bool pollTriggered = __watch_fail_triggered()
    __watch_fail_clear()
    assert pollCaught == pollTriggered
    if pollTriggered then pollFailures += 1 else pollCompleted = true end
    assert polling.count == 1 and polling.poll() == ""
end

assert createFailures > 0 and createCompleted
assert addFailures > 0 and addCompleted
assert pollFailures > 0 and pollCompleted
