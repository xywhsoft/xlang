import xml.etree

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

func main(...) as int
    int failures = 0
    int successes = 0
    for allocation in range(12)
        auto root = xml.etree.create("root")
        bool memoryCaught = false
        bool wrongCaught = false
        assert failAfter(uint64(allocation))
        try
            root.set("mode", "safe")
        catch MemoryError error
            memoryCaught = true
        catch XmlError error
            wrongCaught = true
        end
        bool triggered = failTriggered()
        failClear()
        assert not wrongCaught and memoryCaught == triggered
        if triggered then
            failures += 1
            assert root.get("mode") == ""
            root.set("mode", "safe")
        else
            successes += 1
        end
        assert root.get("mode") == "safe"
    end
    assert failures > 0 and successes > 0

    // 解析路径在原生层构造 XML 树时会发生多次分配。
    failures = 0
    successes = 0
    for allocation in range(256)
        bool memoryCaught = false
        bool wrongCaught = false
        bool parsed = false
        assert failAfter(uint64(allocation))
        try
            auto root = xml.etree.parse("<root id='one'><item>text</item></root>")
            parsed = root.name == "root"
        catch MemoryError error
            memoryCaught = true
        catch XmlError error
            wrongCaught = true
        catch ValueError error
            wrongCaught = true
        end
        bool triggered = failTriggered()
        failClear()
        if wrongCaught or (memoryCaught and not triggered) or (not memoryCaught and not parsed) then
            println("xml.etree parse allocation mismatch at ", allocation)
        end
        assert not wrongCaught and (memoryCaught or parsed)
        if triggered then failures += 1 else successes += 1 end
        if successes > 0 then break end
    end
    assert failures > 0 and successes > 0
    auto savedRoot = xml.etree.parse("<root id='one'><item>text</item></root>")
    string directory = dir.temp("", "xlang-xml-etree-allocation-", "")
    string outputPath = path.join(directory, "output.xml")
    int saveFailures = 0
    int saveSuccesses = 0
    try
        for allocation in range(64)
            bool memoryCaught = false
            bool wrongCaught = false
            assert failAfter(uint64(allocation))
            try
                savedRoot.save(outputPath)
            catch MemoryError error
                memoryCaught = true
            catch XmlError error
                wrongCaught = true
            catch ValueError error
                wrongCaught = true
            catch IOError error
                wrongCaught = true
            end
            bool triggered = failTriggered()
            failClear()
            if wrongCaught or memoryCaught != triggered then
                println("xml.etree save allocation mismatch at ", allocation,
                    ": triggered=", triggered, ", memory=", memoryCaught,
                    ", other=", wrongCaught)
            end
            assert not wrongCaught and memoryCaught == triggered
            if triggered then saveFailures += 1 else saveSuccesses += 1 end
            if saveSuccesses > 0 then break end
        end
        assert saveFailures > 0 and saveSuccesses > 0
        savedRoot.save(outputPath)
        assert xml.etree.parse(file.readText(outputPath)).name == "root"
    finally
        failClear()
        assert dir.delete(directory)
    end
    println("xml.etree allocation: PASS")
    return 0
end
