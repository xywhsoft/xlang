extern "xcss_get" @owned func __css_get(string css, string sel, string prop) as string
extern "xcss_count_rules" func __css_crules(string css) as int
extern "xcss_count_props" func __css_cprops(string css, string sel) as int
extern "xcss_selector_at" @owned func __css_selat(string css, int idx) as string
extern "xcss_validate" func __css_valid(string css) as bool
extern "xcss_strip_comments" @owned func __css_strip(string css) as string

// 原生解析器使用零结尾 C 字符串，不能忽略内嵌 NUL 后的样式表。
func __css_text(string value)
    if string.indexOf(value, "\0", false, string.byteLen(value), 1) >= 0 then
        throw ValueError "css: text contains NUL"
    end
end



export func get(string css, string selector, string property) as string
    __css_text(css)
    __css_text(selector)
    __css_text(property)
    return __css_get(css, selector, property)
end

export func countRules(string css) as int
    __css_text(css)
    return __css_crules(css)
end

export func countProps(string css, string selector) as int
    __css_text(css)
    __css_text(selector)
    return __css_cprops(css, selector)
end

export func selectorAt(string css, int idx) as string
    __css_text(css)
    return __css_selat(css, idx)
end

export func validate(string css) as bool
    __css_text(css)
    return __css_valid(css)
end

export func stripComments(string css) as string
    __css_text(css)
    return __css_strip(css)
end
