extern "xsysinfo_os_name" func __si_os() as point
extern "xsysinfo_os_version" func __si_ver() as point
extern "xsysinfo_arch" func __si_arch() as point
extern "xsysinfo_hostname" func __si_host() as point
extern "xsysinfo_cpu_count" func __si_cpus() as int
extern "xsysinfo_mem_total" func __si_memtotal() as int
extern "xsysinfo_mem_available" func __si_memavail() as int
extern "xsysinfo_mem_usage_pct" func __si_mempct() as int
extern "xsysinfo_page_size" func __si_pagesz() as int
extern "xsysinfo_uptime" func __si_uptime() as int
extern "xsysinfo_cpu_name" func __si_cpuname() as point
extern "xrtFree" @no_raise func __si_free(point data)



export func osName() as cstring
    return cstring.take(__si_os(), __si_free)
end

export func osVersion() as cstring
    return cstring.take(__si_ver(), __si_free)
end

export func arch() as cstring
    return cstring.take(__si_arch(), __si_free)
end

export func hostname() as cstring
    return cstring.take(__si_host(), __si_free)
end

export func cpuCount() as int
    return __si_cpus()
end

export func cpuName() as cstring
    return cstring.take(__si_cpuname(), __si_free)
end

export func memTotal() as int
    return __si_memtotal()
end

export func memAvailable() as int
    return __si_memavail()
end

export func memUsagePct() as int
    return __si_mempct()
end

export func pageSize() as int
    return __si_pagesz()
end

export func uptime() as int
    return __si_uptime()
end
