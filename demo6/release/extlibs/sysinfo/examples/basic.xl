import sysinfo

func main(...) as int
    // 这些字段不依赖采样瞬间的空闲内存，适合与 C 输出对照。
    println("os:", sysinfo.osName())
    println("version:", sysinfo.osVersion())
    println("arch:", sysinfo.arch())
    println("host:", sysinfo.hostname())
    println("cpu:", sysinfo.cpuName())
    println("cpus:", sysinfo.cpuCount())
    println("memory:", sysinfo.memTotal())
    println("page:", sysinfo.pageSize())
    return 0
end
