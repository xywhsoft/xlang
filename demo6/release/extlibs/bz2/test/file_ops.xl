import bz2

class Bz2FileProgress
    int calls = 0
end

func main(...) as int
    string workDir = path.join(path.temp(), "xlang_bz2_file_" + crypto.randomString(20))
    dir.createAll(workDir)
    string source = path.join(workDir, "source.txt")
    string packed = path.join(workDir, "source.bz2")
    string restored = path.join(workDir, "restored.txt")
    string cancelledPath = path.join(workDir, "cancelled.bz2")
    string failedPath = path.join(workDir, "failed.bz2")
    string content = "你好 bz2\n" + string.repeat("bzip2-file-boundary\n", 2048)
    try
        assert file.writeText(source, content)
        Bz2FileProgress progress = Bz2FileProgress()
        bz2.compressFile(source, packed, onProgress = func(int inputBytes,
            int totalBytes, int outputBytes) as bool
            progress.calls += 1
            return inputBytes <= totalBytes and outputBytes >= 0
        end)
        assert progress.calls > 0
        bz2.decompressFile(packed, restored, smallMemory = true)
        assert file.readText(restored) == content

        bool rejected = false
        try
            bz2.compressFile(source, packed, overwrite = false)
        catch ValueError e
            rejected = true
        end
        assert rejected and file.readText(restored) == content

        bool cancelled = false
        try
            bz2.compressFile(source, cancelledPath, onProgress = func(int inputBytes,
                int totalBytes, int outputBytes) as bool
                return false
            end)
        catch CancelledError e
            cancelled = true
        end
        assert cancelled and not file.exists(cancelledPath)

        bool callbackError = false
        try
            bz2.compressFile(source, failedPath, onProgress = func(int inputBytes,
                int totalBytes, int outputBytes) as bool
                throw ValueError "bz2 progress failed"
            end)
        catch ValueError e
            callbackError = e.message == "bz2 progress failed"
        end
        assert callbackError and not file.exists(failedPath)

        callbackError = false
        try
            bz2.decompressFile(packed, restored, onProgress = func(int inputBytes,
                int totalBytes, int outputBytes) as bool
                throw ValueError "bz2 decompression progress failed"
            end)
        catch ValueError e
            callbackError = e.message == "bz2 decompression progress failed"
        end
        assert callbackError and file.readText(restored) == content

        bool limited = false
        try
            bz2.decompressFile(packed, restored, maxOutput = 8)
        catch RangeError e
            limited = true
        end
        assert limited and file.readText(restored) == content
    finally
        if file.exists(source) then assert file.delete(source) end
        if file.exists(packed) then assert file.delete(packed) end
        if file.exists(restored) then assert file.delete(restored) end
        if file.exists(cancelledPath) then assert file.delete(cancelledPath) end
        if file.exists(failedPath) then assert file.delete(failedPath) end
        assert dir.delete(workDir), "temporary bz2 directory must be removed"
    end
    println("bz2 file operations: PASS")
    return 0
end
