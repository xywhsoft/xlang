// 原生声明严格采用 C 的物理类型；公开参数保持 xlang int，转换前检查范围。
func __sqlite_c_int(int value) as c_int
    if value < -2147483648 or value > 2147483647 then
        throw RangeError "sqlite argument exceeds C int range"
    end
    return c_int(value)
end

