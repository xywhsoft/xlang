export const int SQLITE_OK = 0
export const int SQLITE_ERROR = 1
export const int SQLITE_INTERNAL = 2
export const int SQLITE_PERM = 3
export const int SQLITE_ABORT = 4
export const int SQLITE_BUSY = 5
export const int SQLITE_LOCKED = 6
export const int SQLITE_NOMEM = 7
export const int SQLITE_READONLY = 8
export const int SQLITE_INTERRUPT = 9
export const int SQLITE_IOERR = 10
export const int SQLITE_CORRUPT = 11
export const int SQLITE_NOTFOUND = 12
export const int SQLITE_FULL = 13
export const int SQLITE_CANTOPEN = 14
export const int SQLITE_PROTOCOL = 15
export const int SQLITE_EMPTY = 16
export const int SQLITE_SCHEMA = 17
export const int SQLITE_TOOBIG = 18
export const int SQLITE_CONSTRAINT = 19
export const int SQLITE_MISMATCH = 20
export const int SQLITE_MISUSE = 21
export const int SQLITE_NOLFS = 22
export const int SQLITE_AUTH = 23
export const int SQLITE_FORMAT = 24
export const int SQLITE_RANGE = 25
export const int SQLITE_NOTADB = 26
export const int SQLITE_NOTICE = 27
export const int SQLITE_WARNING = 28
export const int SQLITE_ROW = 100
export const int SQLITE_DONE = 101
export const int SQLITE_INTEGER = 1
export const int SQLITE_FLOAT = 2
export const int SQLITE_TEXT = 3
export const int SQLITE_BLOB = 4
export const int SQLITE_NULL = 5
export const int SQLITE_OPEN_READONLY = 0x00000001
export const int SQLITE_OPEN_READWRITE = 0x00000002
export const int SQLITE_OPEN_CREATE = 0x00000004
export const int SQLITE_OPEN_URI = 0x00000040
export const int SQLITE_OPEN_MEMORY = 0x00000080
export const int SQLITE_OPEN_NOMUTEX = 0x00008000
export const int SQLITE_OPEN_FULLMUTEX = 0x00010000
export const int SQLITE_OPEN_SHAREDCACHE = 0x00020000
export const int SQLITE_OPEN_PRIVATECACHE = 0x00040000

export class Statement
    private point handle

    private func checkedHandle() as point
        if self.handle == null then
            throw RuntimeError "sqlite statement is finalized"
        end
        return self.handle
    end

    create()
        self.handle = null
    end

    create(point handle)
        self.handle = handle
    end

    destroy()
        if self.handle != null then
            sqlite3_finalize(self.handle)
            self.handle = null
        end
    end

    func valid() as bool
        return self.handle != null
    end

    func finalize() as int
        if self.handle == null then
            return SQLITE_OK
        end
        auto rc = sqlite3_finalize(self.handle)
        self.handle = null
        return rc
    end

    func reset() as int
        return sqlite3_reset(self.checkedHandle())
    end

    func clear_bindings() as int
        return sqlite3_clear_bindings(self.checkedHandle())
    end

    func bind(int index, int value) as int
        return sqlite3_bind_int64(self.checkedHandle(), index, value)
    end

    func bind(int index, float value) as int
        return sqlite3_bind_double(self.checkedHandle(), index, value)
    end

    func bind(int index, string value) as int
        return sqlite3_bind_text(self.checkedHandle(), index, value)
    end

    func bind(int index, Buffer value) as int
        return sqlite3_bind_blob(self.checkedHandle(), index, value)
    end

    func bind_text_bytes(int index, Buffer value) as int
        return sqlite3_bind_text_bytes(self.checkedHandle(), index, value)
    end

    func bind_null(int index) as int
        return sqlite3_bind_null(self.checkedHandle(), index)
    end

    func bind_blob_text(int index, string value) as int
        return sqlite3_bind_blob_text(self.checkedHandle(), index, value)
    end

    func step() as int
        return sqlite3_step(self.checkedHandle())
    end

    func done() as bool
        int rc = self.step()
        if rc != SQLITE_ROW and rc != SQLITE_DONE then
            throw RuntimeError self.last_error()
        end
        return rc == SQLITE_DONE
    end

    func row_ready() as bool
        int rc = self.step()
        if rc != SQLITE_ROW and rc != SQLITE_DONE then
            throw RuntimeError self.last_error()
        end
        return rc == SQLITE_ROW
    end

    func last_error() as string
        return sqlite3_stmt_errmsg(self.checkedHandle())
    end

    func column_count() as int
        return sqlite3_column_count(self.checkedHandle())
    end

    func column_name(int column) as string
        return sqlite3_column_name(self.checkedHandle(), column)
    end

    func column_type(int column) as int
        return sqlite3_column_type(self.checkedHandle(), column)
    end

    func column_int(int column) as int
        return sqlite3_column_int64(self.checkedHandle(), column)
    end

    func column_float(int column) as float
        return sqlite3_column_double(self.checkedHandle(), column)
    end

    func column_text(int column) as string
        return sqlite3_column_text(self.checkedHandle(), column)
    end

    func column_blob_text(int column) as string
        return sqlite3_column_blob_text(self.checkedHandle(), column)
    end

    func column_blob(int column) as Buffer
        return sqlite3_column_blob(self.checkedHandle(), column)
    end

    func column_text_bytes(int column) as Buffer
        return sqlite3_column_text_bytes(self.checkedHandle(), column)
    end

    func value(int column) as var
        int kind = self.column_type(column)
        if kind == SQLITE_INTEGER then
            return self.column_int(column)
        elseif kind == SQLITE_FLOAT then
            return self.column_float(column)
        elseif kind == SQLITE_TEXT then
            return self.column_text(column)
        elseif kind == SQLITE_BLOB then
            return self.column_blob(column)
        end
        return null
    end

    func row() as var
        var result = {}
        int count = self.column_count()
        int i = 0
        while i < count
            result[self.column_name(i)] = self.value(i)
            i += 1
        end
        return result
    end
end

export class Database
    private point handle

    private func checkedHandle() as point
        if self.handle == null then
            throw RuntimeError "sqlite database is closed"
        end
        return self.handle
    end

    create()
        self.handle = null
    end

    create(point handle)
        self.handle = handle
    end

    create(string filename)
        self.handle = sqlite3_open(filename)
    end

    destroy()
        if self.handle != null then
            sqlite3_close_v2(self.handle)
            self.handle = null
        end
    end

    func valid() as bool
        return self.handle != null
    end

    func close() as int
        if self.handle == null then
            return SQLITE_OK
        end
        auto rc = sqlite3_close(self.handle)
        if rc == SQLITE_OK then
            self.handle = null
        end
        return rc
    end

    func close_v2() as int
        if self.handle == null then
            return SQLITE_OK
        end
        auto rc = sqlite3_close_v2(self.handle)
        if rc == SQLITE_OK then
            self.handle = null
        end
        return rc
    end

    func last_error() as string
        return sqlite3_errmsg(self.checkedHandle())
    end

    func execute(string sql) as bool
        return sqlite3_exec(self.checkedHandle(), sql) == SQLITE_OK
    end

    func exec_code(string sql) as int
        return sqlite3_exec(self.checkedHandle(), sql)
    end

    func prepare(string sql) as Statement
        return Statement(sqlite3_prepare_v2(self.checkedHandle(), sql))
    end

    func changes() as int
        return sqlite3_changes(self.checkedHandle())
    end

    func total_changes() as int
        return sqlite3_total_changes(self.checkedHandle())
    end

    func last_insert_rowid_text() as string
        return sqlite3_last_insert_rowid_text(self.checkedHandle())
    end

    func last_insert_rowid() as int
        return sqlite3_last_insert_rowid(self.checkedHandle())
    end

    func busy_timeout(int milliseconds) as bool
        return sqlite3_busy_timeout(self.checkedHandle(), milliseconds) == SQLITE_OK
    end

    func begin() as bool
        return self.execute("begin")
    end

    func commit() as bool
        return self.execute("commit")
    end

    func rollback() as bool
        return self.execute("rollback")
    end

    func query(string sql) as var
        var rows = []
        auto stmt = self.prepare(sql)
        try
            int rc = stmt.step()
            while rc == SQLITE_ROW
                rows.append(stmt.row())
                rc = stmt.step()
            end
            if rc != SQLITE_DONE then
                throw RuntimeError stmt.last_error()
            end
        finally
            stmt.finalize()
        end
        return rows
    end
end

export func open(string filename) as Database
    return Database(filename)
end

export func open_v2(string filename, int flags, string vfs) as Database
    return Database(sqlite3_open_v2(filename, flags, vfs))
end

export func memory() as Database
    return open(":memory:")
end
