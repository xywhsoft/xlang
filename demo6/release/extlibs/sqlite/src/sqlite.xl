// 二进制与含 NUL 的文本按字节绑定；SQLite 复制数据，不保留 Buffer 的借用指针。
export func sqlite3_bind_blob(point stmt, int index, Buffer value) as int
    return __sqlite_bind_blob(stmt, __sqlite_c_int(index), value.data(), c_size(value.len()))
end

