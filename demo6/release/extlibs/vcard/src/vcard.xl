extern "xv_parse" func __v_parse(string text) as var
extern "xv_build" func __v_build(var card) as string



// parse 解析 vCard 文本（3.0/4.0 通用），返回字段映射
// 重复字段（TEL/EMAIL/ADR 等）自动提升为数组；折行自动展开；转义解码
// 常见字段：fn、n、nickname、tel、email、org、title、adr、url、note、bday 等
export func parse(string text) as var
    var r = __v_parse(text)
    if r == null then
        throw ValueError "vcard: input is null"
    end
    return r
end

// build 由字段映射生成 vCard 3.0 文本（长行按 74 字节折叠）
export func build(var card) as string
    return __v_build(card)
end
