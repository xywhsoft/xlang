extern "xhttp_last_error" func __xhttp_error_native() as point
extern "xhttp_url_path_normalize" func __xhttp_path_normalize(
    string path, c_size size) as point
extern "xhttp_url_default_port" func __xhttp_default_port(
    string scheme, c_size size) as c_longlong
extern "xhttp_form_encode" func __xhttp_form_encode(
    point data, c_size size) as point
extern "xhttp_form_encode_text" func __xhttp_form_encode_text(
    string text, c_size size) as point
extern "xhttp_form_decode" func __xhttp_form_decode(
    string text, c_size size) as point
extern "xhttp_query_count" func __xhttp_query_count(
    string text, c_size size) as c_longlong
extern "xhttp_buffer_take_cstr" func __xhttp_buffer_take_cstr(point handle) as point



export const int URL_HAS_SCHEME = 1
export const int URL_HAS_AUTHORITY = 2
export const int URL_HAS_USERINFO = 4
export const int URL_HAS_HOST = 8
export const int URL_HAS_PORT = 16
export const int URL_HAS_QUERY = 32
export const int URL_HAS_FRAGMENT = 64
export const int URL_HOST_IP_LITERAL = 128
export const int URL_PORT_EMPTY = 256
export const int URL_PORT_VALUE = 512



// 接管当前线程错误文本的独立快照。
func __xhttp_error() as string
    point handle = __xhttp_error_native()
    if handle == null then
        return "xhttp operation failed"
    end
    Buffer result = Buffer(handle)
    point text = __xhttp_buffer_take_cstr(result.handle)
    if text != null then return __xl_runtime.takeCstr(text) end
    return result.text()
end



// 普通文本移交 Buffer 数据；含 NUL 的结果保持长度感知转换。
func __xhttp_text(point handle) as string
    if handle == null then
        throw RuntimeError __xhttp_error()
    end
    Buffer result = Buffer(handle)
    point text = __xhttp_buffer_take_cstr(result.handle)
    if text != null then return __xl_runtime.takeCstr(text) end
    return result.text()
end



// 检查拥有型原生句柄并保留 XRT 的结构化失败原因。
func __xhttp_handle(point handle) as point
    if handle == null then
        throw RuntimeError __xhttp_error()
    end
    return handle
end



// 返回当前线程最近一次 xhttp/XRT 错误文本。
export func lastError() as string
    return __xhttp_error()
end



// Url 拥有原始文本，所有组件视图和 nativeHandle 在对象生命周期内稳定。
export class Url
    native point handle
    extern "xhttp_url_parse" create(string text, c_size size)
    extern "xhttp_url_wrap" create(point handle)
    extern "xhttp_url_destroy" destroy()
    extern "xhttp_url_native" func nativeHandle() as point
    extern "xhttp_url_text" func textNative() as point
    extern "xhttp_url_component" func componentNative(
        c_longlong field) as point
    extern "xhttp_url_value" func valueNative(
        c_longlong field) as c_ulonglong
    extern "xhttp_url_port" func portNative() as c_longlong
    extern "xhttp_url_scheme_is" func schemeIsNative(
        string scheme, c_size size) as bool
    extern "xhttp_url_write" func writeNative(c_longlong mode) as point
    extern "xhttp_url_resolve" func resolveNative(
        string reference, c_size size) as point

    static func parse(string text) as Url
        return Url(text, c_size(string.byteLen(text)))
    end

    static func normalizePath(string path) as string
        return __xhttp_text(__xhttp_path_normalize(
            path, c_size(string.byteLen(path))))
    end

    static func defaultPort(string scheme) as int
        return int(__xhttp_default_port(
            scheme, c_size(string.byteLen(scheme))))
    end

    get valid() as bool
        return self.handle != null
    end

    get flags() as int
        return int(self.valueNative(c_longlong(0)))
    end

    get hasScheme() as bool
        return (self.flags & URL_HAS_SCHEME) != 0
    end

    get hasAuthority() as bool
        return (self.flags & URL_HAS_AUTHORITY) != 0
    end

    get hasUserInfo() as bool
        return (self.flags & URL_HAS_USERINFO) != 0
    end

    get hasHost() as bool
        return (self.flags & URL_HAS_HOST) != 0
    end

    get hasPort() as bool
        return (self.flags & URL_HAS_PORT) != 0
    end

    get hasQuery() as bool
        return (self.flags & URL_HAS_QUERY) != 0
    end

    get hasFragment() as bool
        return (self.flags & URL_HAS_FRAGMENT) != 0
    end

    get hostIsIpLiteral() as bool
        return (self.flags & URL_HOST_IP_LITERAL) != 0
    end

    get portIsEmpty() as bool
        return (self.flags & URL_PORT_EMPTY) != 0
    end

    get hasPortValue() as bool
        return (self.flags & URL_PORT_VALUE) != 0
    end

    get explicitPort() as int
        if not self.hasPortValue then
            return -1
        end
        return int(self.valueNative(c_longlong(1)))
    end

    get secure() as bool
        return self.valueNative(c_longlong(2)) != 0
    end

    get portIsDefault() as bool
        return self.valueNative(c_longlong(3)) != 0
    end

    get port() as int
        int result = int(self.portNative())
        if result < 0 then
            throw ValueError __xhttp_error()
        end
        return result
    end

    func text() as string
        return __xhttp_text(self.textNative())
    end

    func scheme() as string
        return __xhttp_text(self.componentNative(c_longlong(0)))
    end

    func authority() as string
        return __xhttp_text(self.componentNative(c_longlong(1)))
    end

    func userInfo() as string
        return __xhttp_text(self.componentNative(c_longlong(2)))
    end

    func host() as string
        return __xhttp_text(self.componentNative(c_longlong(3)))
    end

    func portText() as string
        return __xhttp_text(self.componentNative(c_longlong(4)))
    end

    func path() as string
        return __xhttp_text(self.componentNative(c_longlong(5)))
    end

    func query() as string
        return __xhttp_text(self.componentNative(c_longlong(6)))
    end

    func fragment() as string
        return __xhttp_text(self.componentNative(c_longlong(7)))
    end

    func schemeIs(string scheme) as bool
        return self.schemeIsNative(
            scheme, c_size(string.byteLen(scheme)))
    end

    func build() as string
        return __xhttp_text(self.writeNative(c_longlong(0)))
    end

    func authorityText() as string
        return __xhttp_text(self.writeNative(c_longlong(1)))
    end

    func hostText() as string
        return __xhttp_text(self.writeNative(c_longlong(2)))
    end

    func target() as string
        return __xhttp_text(self.writeNative(c_longlong(3)))
    end

    func resolve(string reference) as Url
        return Url(__xhttp_handle(self.resolveNative(
            reference, c_size(string.byteLen(reference)))))
    end

    func clone() as Url
        return Url.parse(self.text())
    end

    func __toString__() as string
        return self.text()
    end
end



// QueryParam 保留 a 与 a= 的差异，value 只有在 hasValue 时存在。
export class QueryParam
    string name
    string? value
    bool hasValue

    create(string name, string? value, bool hasValue)
        self.name = name
        self.value = value
        self.hasValue = hasValue
    end
end



// QueryParams 是有序、区分大小写并允许重复名称的拥有型参数容器。
export class QueryParams
    native point handle
    extern "xhttp_params_create_default" create()
    extern "xhttp_params_create" create(bool lenient)
    extern "xhttp_params_parse" create(
        string text, c_size size, bool lenient)
    extern "xhttp_params_wrap" create(point handle)
    extern "xhttp_params_destroy" destroy()
    extern "xhttp_params_native" func nativeHandle() as point
    extern "xhttp_params_clone" func cloneNative() as point
    extern "xhttp_params_value" func valueNative(
        c_longlong field) as c_ulonglong
    extern "xhttp_params_clear" func clear()
    extern "xhttp_params_reserve" func reserveNative(
        c_size pairs, c_size bytes) as bool
    extern "xhttp_params_append" func appendNative(
        string name, c_size nameSize, string value,
        c_size valueSize, bool hasValue) as bool
    extern "xhttp_params_set" func setNative(
        string name, c_size nameSize, string value,
        c_size valueSize, bool hasValue) as bool
    extern "xhttp_params_name_value" func nameValueNative(
        string name, c_size size, c_longlong operation) as c_ulonglong
    extern "xhttp_params_at_text" func atTextNative(
        c_ulonglong index, c_longlong field) as point
    extern "xhttp_params_at_has_value" func hasValueAtNative(
        c_ulonglong index) as bool
    extern "xhttp_params_get" func getNative(
        string name, c_size size, c_ulonglong occurrence) as point
    extern "xhttp_params_parse_append" func parseAppendNative(
        string text, c_size size) as bool
    extern "xhttp_params_maintain" func maintainNative(
        c_longlong operation) as bool
    extern "xhttp_params_build" func buildNative() as point

    static func parse(string text, bool lenient = false) as QueryParams
        return QueryParams(text, c_size(string.byteLen(text)), lenient)
    end

    get valid() as bool
        return self.handle != null
    end

    get count() as int
        return int(self.valueNative(c_longlong(0)))
    end

    get bytes() as int
        return int(self.valueNative(c_longlong(1)))
    end

    func reserve(int pairs, int bytes) as bool
        if pairs < 0 or bytes < 0 then
            throw ValueError "QueryParams reserve values must not be negative"
        end
        return self.reserveNative(c_size(pairs), c_size(bytes))
    end

    func append(string name, string value) as bool
        return self.appendNative(name, c_size(string.byteLen(name)),
            value, c_size(string.byteLen(value)), true)
    end

    func appendName(string name) as bool
        return self.appendNative(name, c_size(string.byteLen(name)),
            "", c_size(0), false)
    end

    func set(string name, string value) as bool
        return self.setNative(name, c_size(string.byteLen(name)),
            value, c_size(string.byteLen(value)), true)
    end

    func setName(string name) as bool
        return self.setNative(name, c_size(string.byteLen(name)),
            "", c_size(0), false)
    end

    func remove(string name) as int
        return int(self.nameValueNative(name,
            c_size(string.byteLen(name)), c_longlong(0)))
    end

    func countName(string name) as int
        return int(self.nameValueNative(name,
            c_size(string.byteLen(name)), c_longlong(1)))
    end

    func has(string name) as bool
        return self.nameValueNative(name,
            c_size(string.byteLen(name)), c_longlong(2)) != 0
    end

    func nameAt(int index) as string
        if index < 0 or index >= self.count then
            throw IndexError "Query parameter index is out of range"
        end
        return __xhttp_text(self.atTextNative(
            c_ulonglong(index), c_longlong(0)))
    end

    func hasValueAt(int index) as bool
        if index < 0 or index >= self.count then
            throw IndexError "Query parameter index is out of range"
        end
        return self.hasValueAtNative(c_ulonglong(index))
    end

    func valueAt(int index) as string?
        if not self.hasValueAt(index) then
            return null
        end
        return __xhttp_text(self.atTextNative(
            c_ulonglong(index), c_longlong(1)))
    end

    func at(int index) as QueryParam
        bool hasValue = self.hasValueAt(index)
        string? value = null
        if hasValue then
            value = self.valueAt(index)
        end
        return QueryParam(self.nameAt(index), value, hasValue)
    end

    func get(string name, int occurrence = 0) as string?
        if occurrence < 0 then
            throw ValueError "Query parameter occurrence must not be negative"
        end
        point result = self.getNative(name,
            c_size(string.byteLen(name)), c_ulonglong(occurrence))
        if result == null then
            return null
        end
        return __xhttp_text(result)
    end

    func parseAppend(string text) as bool
        return self.parseAppendNative(
            text, c_size(string.byteLen(text)))
    end

    func sort() as bool
        return self.maintainNative(c_longlong(0))
    end

    func compact() as bool
        return self.maintainNative(c_longlong(1))
    end

    func clone() as QueryParams
        return QueryParams(__xhttp_handle(self.cloneNative()))
    end

    func build() as string
        return __xhttp_text(self.buildNative())
    end

    func __len__() as int
        return self.count
    end

    func __item__(string name) as string?
        return self.get(name)
    end

    func __iter__() as QueryParamsIter
        return QueryParamsIter(self.nativeHandle())
    end

    func __toString__() as string
        return self.build()
    end
end



// QueryParamsIter 持有原生深复制快照，外部修改和销毁不会破坏迭代状态。
export class QueryParamsIter
    native point handle
    int index
    extern "xhttp_params_clone" create(point source)
    extern "xhttp_params_destroy" destroy()
    extern "xhttp_params_value" func valueNative(
        c_longlong field) as c_ulonglong
    extern "xhttp_params_at_text" func atTextNative(
        c_ulonglong index, c_longlong field) as point
    extern "xhttp_params_at_has_value" func hasValueAtNative(
        c_ulonglong index) as bool

    get count() as int
        return int(self.valueNative(c_longlong(0)))
    end

    func at(int index) as QueryParam
        bool hasValue = self.hasValueAtNative(c_ulonglong(index))
        string? value = null
        if hasValue then
            value = __xhttp_text(self.atTextNative(
                c_ulonglong(index), c_longlong(1)))
        end
        return QueryParam(__xhttp_text(self.atTextNative(
            c_ulonglong(index), c_longlong(0))), value, hasValue)
    end

    func __next__() as (bool, QueryParam)
        if self.index >= self.count then
            return false, QueryParam("", null, false)
        end
        QueryParam result = self.at(self.index)
        self.index += 1
        return true, result
    end
end



// FormCodec 提供字节优先的 application/x-www-form-urlencoded 单值编解码。
export class FormCodec
    static func encode(string text) as string
        return __xhttp_text(__xhttp_form_encode_text(
            text, c_size(string.byteLen(text))))
    end

    static func encode(Buffer data) as string
        return __xhttp_text(__xhttp_form_encode(
            data.data(), c_size(data.len())))
    end

    static func decode(string text) as Buffer
        return Buffer(__xhttp_handle(__xhttp_form_decode(
            text, c_size(string.byteLen(text)))))
    end

    static func decodeText(string text) as string
        return FormCodec.decode(text).text()
    end
end



// Query 暴露不创建容器的原始查询预检和计数路径。
export class Query
    static func count(string text) as int
        return int(__xhttp_query_count(
            text, c_size(string.byteLen(text))))
    end

    static func valid(string text) as bool
        return Query.count(text) >= 0
    end
end
