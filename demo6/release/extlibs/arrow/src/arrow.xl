extern "xarrow_type" func __type(int id) as string
extern "xarrow_buffer_type" func __buffer_type(int id) as string
extern "xarrow_ipc_format" func __ipc_format(int id) as string
extern "xarrow_compute_func" func __compute_func(int id) as string
extern "xarrow_aligned_size" func __aligned_size(int bytes) as int
extern "xarrow_memory_pool" func __memory_pool(int id) as string
extern "xarrow_flight_action" func __flight_action(int id) as string

export func dataType(int id) as string
    return __type(id)
end

export func bufferType(int id) as string
    return __buffer_type(id)
end

export func ipcFormat(int id) as string
    return __ipc_format(id)
end

export func computeFunc(int id) as string
    return __compute_func(id)
end

export func alignedSize(int bytes) as int
    return __aligned_size(bytes)
end

export func memoryPool(int id) as string
    return __memory_pool(id)
end

export func flightAction(int id) as string
    return __flight_action(id)
end
