import "./src/logging.xl"
import "./src/service_runtime.xl"

func xsUsage()
    println("xs 2.0")
    println("usage: xl run projects/xs/xs.xl -- [options]")
    println("  --config <path>   configuration file")
    println("  --check           validate configuration and exit")
    println("  --status          start, print status, then stop")
    println("  --duration <ms>   stop after a bounded test interval")
    println("  --help            show this help")
end

func xsCloseSignal(SignalHandle handle)
    if handle != null then
        handle.close()
    end
end

func xsRun(
    string configPath,
    string includeDir,
    var normalized,
    bool printStatus,
    int durationMs) as int
    auto runtimeLog = src.logging.open(normalized["logging"])
    if not runtimeLog.ready() then
        println("xs logging error: " + runtimeLog.lastError())
        return 5
    end

    auto runtime = src.service_runtime.open(configPath, includeDir)
    if not runtime.ready() then
        runtimeLog.errorMessage("configuration rejected: " + runtime.lastError())
        runtimeLog.flush()
        return 3
    end
    if not runtime.start() then
        runtimeLog.errorMessage("startup failed: " + runtime.lastError())
        runtimeLog.flush()
        return 4
    end

    runtimeLog.info("xs 2.0 started: " + json.stringify(runtime.status()))
    if printStatus then
        println(json.stringify(runtime.status(), true))
        runtime.stop()
        runtimeLog.info("xs 2.0 stopped after status probe")
        return 0
    end

    channel<var> events = channel::<var>(32)
    SignalHandle intHandle
    SignalHandle termHandle
    SignalHandle hupHandle
    SignalHandle breakHandle
    SignalHandle closeHandle
    SignalHandle shutdownHandle
    if signal.supported(signal.INT) then intHandle = signal.sendTo(events, signal.INT) end
    if signal.supported(signal.TERM) then termHandle = signal.sendTo(events, signal.TERM) end
    if signal.supported(signal.HUP) then hupHandle = signal.sendTo(events, signal.HUP) end
    if signal.supported(signal.BREAK) then breakHandle = signal.sendTo(events, signal.BREAK) end
    if signal.supported(signal.CLOSE) then closeHandle = signal.sendTo(events, signal.CLOSE) end
    if signal.supported(signal.SHUTDOWN) then shutdownHandle = signal.sendTo(events, signal.SHUTDOWN) end

    bool stopping = false
    int elapsedMs = 0
    int pollMs = 100
    while not stopping do
        var event = null
        while events.tryRecvInto(event) do
            int code = int(event["code"])
            if code == signal.HUP or code == signal.BREAK then
                int debounceMs = int(normalized["runtime"]["reloadDebounceMs"])
                if debounceMs > 0 then time.sleep(debounceMs) end
                if runtime.reload() then
                    runtimeLog.info("reload committed: " + json.stringify(runtime.status()))
                else
                    runtimeLog.errorMessage("reload rejected: " + runtime.lastError())
                end
            else
                runtimeLog.info("stop signal received: " + signal.name(code))
                stopping = true
            end
            event = null
        end
        if durationMs >= 0 and elapsedMs >= durationMs then
            stopping = true
        end
        if not stopping then
            time.sleep(pollMs)
            if durationMs >= 0 then elapsedMs += pollMs end
        end
    end

    bool stopped = runtime.stop()
    if stopped then
        runtimeLog.info("xs 2.0 stopped")
    else
        runtimeLog.errorMessage("xs 2.0 stopped with errors: " + runtime.lastError())
    end
    runtimeLog.flush()

    xsCloseSignal(shutdownHandle)
    xsCloseSignal(closeHandle)
    xsCloseSignal(breakHandle)
    xsCloseSignal(hupHandle)
    xsCloseSignal(termHandle)
    xsCloseSignal(intHandle)
    events.close()
    return stopped ? 0 : 6
end

func main(...) as int
    string configPath = path.abs("projects/xs/xs.json")
    string includeDir = path.abs("projects/xs/include")
    bool checkOnly = false
    bool printStatus = false
    int durationMs = -1

    int index = 0
    if arg.length > 0 then
        string first = string(arg[0])
        if string.endsWith(first, ".xl") or string.endsWith(first, ".exe") then
            index = 1
        end
    end
    while index < arg.length do
        string option = string(arg[index])
        if option == "--help" or option == "-h" then
            xsUsage()
            return 0
        elseif option == "--check" then
            checkOnly = true
            index += 1
        elseif option == "--status" then
            printStatus = true
            index += 1
        elseif option == "--config" and index + 1 < arg.length then
            configPath = path.abs(string(arg[index + 1]))
            index += 2
        elseif option == "--duration" and index + 1 < arg.length then
            durationMs = int(arg[index + 1])
            if durationMs < 0 then
                println("--duration must not be negative")
                return 2
            end
            index += 2
        else
            println("unknown or incomplete option: " + option)
            return 2
        end
    end

    auto loaded = src.service_runtime.loadConfig(configPath)
    if not loaded.ok then
        println("xs config error: " + string(loaded.error))
        return 3
    end
    if checkOnly then
        println("xs config ok: " + configPath)
        return 0
    end
    return xsRun(configPath, includeDir, json.parse(loaded.json), printStatus, durationMs)
end
