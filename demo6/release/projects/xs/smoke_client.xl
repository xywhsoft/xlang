func require(string name, bool ok)
    if not ok then
        println("xs smoke failed: ", name)
        assert false
    end
    println(name + "=ok")
end

HttpClientResponse home = http.get("http://127.0.0.1:18080/", 5000)
require("http_static", home.status() == 200 and string.contains(home.body(), "xs prototype") != 0)

HttpClientResponse xlResp = http.post("http://127.0.0.1:18080/api/xlang", "from-xlang", "text/plain", 5000)
require("http_xlang_handler", xlResp.status() == 200 and xlResp.body() == "from-xlang")

HttpClientResponse cResp = http.post("http://127.0.0.1:18080/api/c", "from-c", "text/plain", 5000)
require("http_c_handler", cResp.status() == 200 and cResp.body() == "from-c")

HttpClientResponse cRespAgain = http.post("http://127.0.0.1:18080/api/c", "again", "text/plain", 5000)
require("http_c_handler_reuse", cRespAgain.status() == 200 and cRespAgain.body() == "again")

point tcpHandle = tcp.connect("127.0.0.1", 18081, 5000)
require("tcp_connect", tcpHandle != null)
TcpStream tcpClient = TcpStream(tcpHandle)
require("tcp_send", tcpClient.send("ping"))
require("tcp_drain", tcpClient.drain(5000))
Buffer tcpReplyBytes = tcpClient.recvBytes(10000, 65536)
string tcpReply = tcpReplyBytes.text()
tcpClient.close()
if tcpReply != "ping" then
    println("tcp_reply=[", tcpReply, "]")
end
require("tcp_xlang_handler", tcpReply == "ping")

point udpHandle = udp.bind(0)
require("udp_bind", udpHandle != null)
UdpSocket udpClient = UdpSocket(udpHandle)
require("udp_send", udpClient.send("127.0.0.1", uint16(18082), "dgram"))
point udpPacketHandle = udpClient.recv(5000)
require("udp_recv", udpPacketHandle != null)
UdpPacket udpPacket = UdpPacket(udpPacketHandle)
string udpReply = udpPacket.text()
require("udp_c_handler", udpReply == "dgram")

println("xs smoke client ok")
