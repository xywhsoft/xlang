func shHistory() as string
    string s = ""
    int i = 0
    int n = g_history.length
    while i < n do
        s = s + i2s(i + 1) + "  " + g_history[i] + "\n"
        i += 1
    end
    return s
end

func shTree() as string
    string s = ""
    int i = 0
    while i < g_inodes.length do
        Inode n = g_inodes[i]
        if n.parent == NIL and i != g_rootIno then
            // orphan, skip
        else
            string pad = ""
            int cur = i
            int depth = 0
            while cur != g_rootIno and cur != NIL do
                Inode c = g_inodes[cur]
                cur = c.parent
                depth += 1
                if depth > 64 then cur = g_rootIno end
            end
            int d = 0
            while d < depth do
                pad = pad + "  "
                d += 1
            end
            string typ = "D"
            if n.type == FT_FILE then
                typ = "F"
            elseif n.type == FT_SYMLINK then
                typ = "L"
            elseif n.type == FT_FIFO then
                typ = "P"
            elseif n.type == FT_CHARDEV then
                typ = "C"
            end
            s = s + pad + typ + " " + n.name
            if n.type == FT_SYMLINK then
                s = s + " -> " + n.target
            end
            s = s + "\n"
        end
        i += 1
    end
    return s
end

func shWrite(var args) as string
    if args.length < 2 then
        return "write: usage: write <path> <text>\n"
    end
    string p = string(args[0])
    string txt = ""
    int i = 1
    while i < args.length do
        if i > 1 then txt = txt + " " end
        txt = txt + args[i]
        i += 1
    end
    if not fsWriteFile(p, txt) then
        return "write: cannot write '" + p + "'\n"
    end
    return ""
end

func shAlloc(var args) as string
    if args.length < 2 then
        return "alloc: usage: alloc <pid> <vaddr>\n"
    end
    int pid = parseIntSafe(string(args[0]), -1)
    int vaddr = parseIntSafe(string(args[1]), 0)
    if pid < 1 or pid >= g_pcb.length then
        return "alloc: invalid pid\n"
    end
    int paddr = memTranslate(pid, vaddr)
    if paddr == NIL then
        return "alloc: translation failed\n"
    end
    return "vaddr " + i2s(vaddr) + " -> paddr " + i2s(paddr) + "\n"
end

func shPipe(var args) as string
    var r = pipeCreate()
    int rfd = int(r[0])
    int wfd = int(r[1])
    return "pipe: read_fd=" + i2s(rfd) + " write_fd=" + i2s(wfd) + "\n"
end

func shMkfifo(var args) as string
    if args.length == 0 then
        return "mkfifo: usage: mkfifo <path>\n"
    end
    if not fsMkfifo(string(args[0]), PERM_RW) then
        return "mkfifo: cannot create '" + string(args[0]) + "'\n"
    end
    return ""
end

func shDate() as string
    return "tick=" + i2s(g_totalTick) + "\n"
end

func shUname() as string
    return "xos2 xlang-2.0 " + fsReadFile("/etc/hostname") + "\n"
end

func shHead(var args, string stdin) as string
    int n = 10
    int i = 0
    while i < args.length do
        string a = string(args[i])
        if startsWithP(a, "-") and string.len(a) > 1 then
            int v = parseIntSafe(string.mid(a, 1, string.len(a) - 1), 10)
            if v > 0 then n = v end
        end
        i += 1
    end
    var lines = string.splitLines(stdin)
    if lines.length == 0 then return "" end
    int take = mini(n, lines.length)
    string s = ""
    int j = 0
    while j < take do
        s = s + string(lines[j]) + "\n"
        j += 1
    end
    return s
end

func shTail(var args, string stdin) as string
    int n = 10
    int i = 0
    while i < args.length do
        string a = string(args[i])
        if startsWithP(a, "-") and string.len(a) > 1 then
            int v = parseIntSafe(string.mid(a, 1, string.len(a) - 1), 10)
            if v > 0 then n = v end
        end
        i += 1
    end
    var lines = string.splitLines(stdin)
    if lines.length == 0 then return "" end
    int start = lines.length - n
    if start < 0 then start = 0 end
    string s = ""
    int j = start
    while j < lines.length do
        s = s + string(lines[j]) + "\n"
        j += 1
    end
    return s
end

func shWc(var args, string stdin) as string
    int lines = 0
    int words = 0
    int chars = string.len(stdin)
    var ls = string.splitLines(stdin)
    lines = ls.length
    var ws = string.split(stdin, " ")
    words = ws.length
    return i2s(lines) + " " + i2s(words) + " " + i2s(chars) + "\n"
end

func shGrep(var args, string stdin) as string
    if args.length == 0 then
        return "grep: usage: grep <pattern>\n"
    end
    string pat = string(args[0])
    var lines = string.splitLines(stdin)
    string s = ""
    int i = 0
    while i < lines.length do
        string l = string(lines[i])
        if containsP(l, pat) then
            s = s + l + "\n"
        end
        i += 1
    end
    return s
end

func shSort(var args, string stdin) as string
    var lines = string.splitLines(stdin)
    if lines.length <= 1 then return stdin end
    // Simple insertion sort (var comparisons via string)
    int i = 1
    while i < lines.length do
        string cur = string(lines[i])
        int j = i - 1
        bool stop = false
        while j >= 0 and not stop do
            string prev = string(lines[j])
            if string.compare(prev, cur) > 0 then
                lines[j + 1] = prev
                j -= 1
            else
                stop = true
            end
        end
        lines[j + 1] = cur
        i += 1
    end
    string s = ""
    int k = 0
    while k < lines.length do
        s = s + string(lines[k]) + "\n"
        k += 1
    end
    return s
end

func shUniq(var args, string stdin) as string
    var lines = string.splitLines(stdin)
    if lines.length == 0 then return "" end
    string s = string(lines[0]) + "\n"
    string prev = string(lines[0])
    int i = 1
    while i < lines.length do
        string cur = string(lines[i])
        if cur != prev then
            s = s + cur + "\n"
            prev = cur
        end
        i += 1
    end
    return s
end


// =============================================================================
//  Part 28: Shell script runner
// =============================================================================
//
// Reads a file from the host filesystem and runs each line as a shell command.
// Lines starting with '#' are comments. The sequence separator ';' is honoured
// by splitting before parsing.
// =============================================================================

func shRunScript(string path) as int
    if not file.exists(path) then
        println("xos2: script not found: " + path)
        return 1
    end
    string text = file.readText(path)
    var rawLines = string.splitLines(text)
    int n = rawLines.length
    int i = 0
    int errors = 0
    while i < n do
        string line = string(rawLines[i])
        i += 1
        string t = trimP(line)
        if string.len(t) == 0 then
            // blank
        else
            int hb = string.byteAt(t, 0)
            if hb == HASH_BYTE then
                // comment
            else
                g_history.append(t)
                if g_history.length > g_historyLimit then
                    g_history.remove(0)
                end
                // Split on ';' for sequence
                var seq = string.split(t, ";")
                int j = 0
                while j < seq.length do
                    string stmt = trimP(string(seq[j]))
                    if string.len(stmt) > 0 then
                        var parsed = shParse(stmt)
                        shExecParsed(parsed)
                    end
                    j += 1
                end
            end
        end
    end
    return errors
end

// Run an in-memory script (string of newline-separated commands)
func shRunText(string text) as int
    var rawLines = string.splitLines(text)
    int n = rawLines.length
    int i = 0
    int errors = 0
    while i < n do
        string line = string(rawLines[i])
        i += 1
        string t = trimP(line)
        if string.len(t) == 0 then
            // blank
        else
            int hb = string.byteAt(t, 0)
            if hb == HASH_BYTE then
                // comment
            else
                g_history.append(t)
                if g_history.length > g_historyLimit then
                    g_history.remove(0)
                end
                var seq = string.split(t, ";")
                int j = 0
                while j < seq.length do
                    string stmt = trimP(string(seq[j]))
                    if string.len(stmt) > 0 then
                        var parsed = shParse(stmt)
                        shExecParsed(parsed)
                    end
                    j += 1
                end
            end
        end
    end
    return errors
end


// =============================================================================
//  Part 29: Self-test suite
// =============================================================================

func testFS()
    println("[testFS] file system: mkdir/ls/write/read/links/chmod")
    fsMkdir("/home", PERM_RWX)
    expectTrue(fsExists("/home"), "fs mkdir /home")
    fsWriteFile("/home/a.txt", "hello")
    expectS(fsReadFile("/home/a.txt"), "hello", "fs write+read")
    fsAppendFile("/home/a.txt", " world")
    expectS(fsReadFile("/home/a.txt"), "hello world", "fs append")
    var items = fsListDir("/home")
    expectTrue(items.length >= 1, "fs ls /home")
    // Hard link
    fsLink("/home/a.txt", "/home/b.txt")
    expectEq(g_inodes[fsResolve("/home/a.txt")].nlink, 2, "fs hardlink nlink==2")
    // Symlink
    fsSymlink("/home/a.txt", "/home/c.txt")
    expectEq(g_inodes[fsResolveNoFollow("/home/c.txt")].type, FT_SYMLINK, "fs symlink type")
    expectS(fsReadlink("/home/c.txt"), "/home/a.txt", "fs readlink target")
    expectS(fsReadFile("/home/c.txt"), "hello world", "fs symlink follows target")
    // Chmod
    fsChmod("/home/a.txt", PERM_R)
    expectEq(g_inodes[fsResolve("/home/a.txt")].perm, PERM_R, "fs chmod 0444 -> r--")
    fsChmod("/home/a.txt", PERM_RW)
    // Stat
    var st = fsStat("/home/a.txt")
    expectTrue(bool(st["ok"]), "fs stat ok")
    expectEq(int(st["size"]), 11, "fs stat size==11")
    // Remove
    expectTrue(fsRemove("/home/b.txt"), "fs remove hardlink")
    expectEq(g_inodes[fsResolve("/home/a.txt")].nlink, 1, "fs nlink back to 1 after rm")
    expectTrue(fsRemove("/home/c.txt"), "fs remove symlink")
    expectTrue(fsRemove("/home/a.txt"), "fs remove file")
    expectFalse(fsExists("/home/a.txt"), "fs file gone after rm")
end

func testMem()
    println("[testMem] memory: paging / TLB / replacement / SHM / COW")
    int pid = procCreate("mem-test", 0, 5, 0, array["compute 1"])
    procArrive(pid)
    int paddr1 = memTranslate(pid, 0)
    expectNe(paddr1, NIL, "mem translate vaddr 0")
    int paddr2 = memTranslate(pid, 0)
    expectEq(paddr1, paddr2, "mem TLB hit returns same paddr")
    expectGt(g_memTlbHit, 0, "mem TLB hit count > 0")
    // Different vaddr should produce different frame
    int paddr3 = memTranslate(pid, FRAME_SIZE)
    expectNe(paddr3, paddr1, "mem different vaddr -> different paddr")
    expectGt(g_memPageFault, 0, "mem page fault occurred")
    // SHM
    int sid = shmGet(42, 8192)
    expectNe(sid, NIL, "shmget returns id")
    expectTrue(shmAttach(sid, pid), "shmat attaches")
    shmDetachByPid(sid, pid)
    // COW fork
    memTranslate(pid, 0)
    int childPid = procFork(pid)
    expectNe(childPid, NIL, "fork creates child")
    expectGt(g_pcb[childPid].ptDirId, -1, "child has its own page dir")
    // All replacement policies should at least run
    g_memReplPolicy = REPL_LRU
    int p4 = memTranslate(pid, 0)
    expectNe(p4, NIL, "LRU translate")
    g_memReplPolicy = REPL_CLOCK
    int p5 = memTranslate(pid, 0)
    expectNe(p5, NIL, "CLOCK translate")
    g_memReplPolicy = REPL_OPT
    int p6 = memTranslate(pid, 0)
    expectNe(p6, NIL, "OPT translate")
    g_memReplPolicy = REPL_LRU
end

func testSched()
    println("[testSched] MLFQ + fork/exec/wait/exit")
    int p1 = procCreate("alpha", 0, 5, 0, array["compute 5"])
    int p2 = procCreate("beta",  0, 6, 1, array["compute 6"])
    int p3 = procCreate("gamma", 0, 8, 2, array["compute 8"])
    procArrive(p1)
    procArrive(p2)
    procArrive(p3)
    schedulerLoop(500)
    procReapZombies()
    expectTrue(g_pcb[p1].state >= PROC_ZOMBIE, "alpha terminated")
    expectTrue(g_pcb[p2].state >= PROC_ZOMBIE, "beta terminated")
    expectTrue(g_pcb[p3].state >= PROC_ZOMBIE, "gamma terminated")
    expectGt(g_contextSwitches, 2, "multiple context switches")
    // Boost: run a process long enough to trigger the periodic priority boost
    g_totalTick = 0
    g_lastBoost = 0
    int q = procCreate("longrun", 0, 200, 2, array["compute 200"])
    procArrive(q)
    schedulerLoop(300)
    procReapZombies()
    expectTrue(g_pcb[q].state >= PROC_ZOMBIE, "longrun finished")
    expectGe(g_totalTick, MLFQ_BOOST, "boost threshold reached")
end

func testShellParse()
    println("[testShellParse] pipeline/redirect/env expansion")
    boot()
    var p = shParse("echo hi | cat")
    expectFalse(bool(p["empty"]), "pipeline not empty")
    expectEq(p["pipeline"].length, 2, "two pipeline stages")
    var p2 = shParse("echo x > /tmp/out")
    expectS(string(p2["redirOut"]), "/tmp/out", "redirect out parsed")
    var p3 = shParse("cat < /tmp/in")
    expectS(string(p3["redirIn"]), "/tmp/in", "redirect in parsed")
    var p4 = shParse("sleep 5 &")
    expectTrue(bool(p4["bg"]), "background parsed")
    // env expansion
    envSet("FOO", "bar99")
    expectS(envExpand("x$FOO"), "xbar99", "env expand $VAR")
    expectS(envExpand("x${FOO}y"), "xbar99y", "env expand ${VAR}")
end

func testShellExec()
    println("[testShellExec] end-to-end shell commands")
    boot()
    shRunText("mkdir /t1\ncd /t1\necho hello > a.txt\ncat a.txt\nls")
    expectTrue(fsExists("/t1"), "shell mkdir /t1")
    expectTrue(fsExists("/t1/a.txt"), "shell echo > a.txt creates file")
    expectS(fsReadFile("/t1/a.txt"), "hello\n", "shell echo > writes content")
    // Append
    shRunText("echo world >> /t1/a.txt")
    expectS(fsReadFile("/t1/a.txt"), "hello\nworld\n", "shell >> appends")
    // Pipe
    shRunText("echo abc | cat")
    // Env vars
    shRunText("export FOO=baz")
    expectS(envGet("FOO"), "baz", "shell export sets env")
end

func testSyscall()
    println("[testSyscall] unified syscall interface")
    fsWriteFile("/etc/s.txt", "syscall-data")
    var r1 = syscall(SYS_CAT, ["/etc/s.txt"])
    expectS(string(r1["ret"]), "syscall-data", "SYS_CAT returns content")
    var r2 = syscall(SYSOPEN, ["/etc/s.txt", "r"])
    int fd = int(r2["ret"])
    expectTrue(fd >= 0, "SYSOPEN returns fd")
    var r3 = syscall(SYS_READ, [fd, 8])
    expectS(string(r3["ret"]), "syscall-", "SYS_READ first 8 bytes")
    var r4 = syscall(SYS_CLOSE, [fd])
    expectTrue(bool(r4["ret"]), "SYS_CLOSE ok")
    var r5 = syscall(SYS_LS, ["/etc"])
    expectTrue(r5["ret"].length > 0, "SYS_LS returns entries")
    int beforeIno = g_nextIno
    var r6 = syscall(SYS_MKDIR, ["/scdir"])
    expectTrue(int(r6["ret"]) >= 0, "SYS_MKDIR returns ino")
    expectTrue(g_nextIno > beforeIno, "nextIno advanced after mkdir")
    var r7 = syscall(SYS_PIPE, [])
    expectTrue(r7["ret"].length == 2, "SYS_PIPE returns two fds")
    var r8 = syscall(9999, [])
    expectTrue(containsP(string(r8["msg"]), "unknown syscall"), "unknown syscall reported")
end

func testSignals()
    println("[testSignals] signal delivery: SIGTERM/SIGKILL/SIGCHLD")
    boot()
    int p1 = procCreate("target", 0, 50, 0, array["compute 50"])
    procArrive(p1)
    procSignal(p1, SIGTERM)
    expectEq(g_pcb[p1].state, PROC_ZOMBIE, "SIGTERM terminates target")
    int p2 = procCreate("hard", 0, 50, 0, array["compute 50"])
    procArrive(p2)
    procSignal(p2, SIGKILL)
    expectEq(g_pcb[p2].state, PROC_ZOMBIE, "SIGKILL terminates hard")
    int p3 = procCreate("parent", 0, 50, 0, array["compute 50"])
    procArrive(p3)
    int c = procFork(p3)
    expectNe(c, NIL, "fork before SIGCHLD")
    procTerminate(c, 0)
    // Parent should have a SIGCHLD pending
    bool hasSig = false
    PCB par = g_pcb[p3]
    int i = 0
    while i < par.pendingSignals.length do
        if par.pendingSignals[i] == SIGCHLD then hasSig = true end
        i += 1
    end
    expectTrue(hasSig, "SIGCHLD delivered to parent")
end

func testPipes()
    println("[testPipes] anonymous + FIFO")
    boot()
    var pr = pipeCreate()
    int rfd = int(pr[0])
    int wfd = int(pr[1])
    expectTrue(rfd >= 0, "pipe read fd")
    expectTrue(wfd >= 0, "pipe write fd")
    int wn = fsWrite(wfd, "hello-pipe")
    expectEq(wn, 10, "pipe write returns 10")
    string rd = fsRead(rfd, 100)
    expectS(rd, "hello-pipe", "pipe read returns content")
    fsClose(rfd)
    fsClose(wfd)
    // FIFO
    fsMkfifo("/tmp/fifo", PERM_RW)
    expectEq(g_inodes[fsResolve("/tmp/fifo")].type, FT_FIFO, "mkfifo creates FT_FIFO")
    int frd = fsOpen("/tmp/fifo", "r")
    int fwd = fsOpen("/tmp/fifo", "w")
    expectTrue(frd >= 0, "fifo open read end")
    expectTrue(fwd >= 0, "fifo open write end")
    fsWrite(fwd, "fifo-data")
    expectS(fsRead(frd, 100), "fifo-data", "fifo read after write")
end

func testDevices()
    println("[testDevices] /dev/null /dev/zero /dev/random /dev/console")
    boot()
    expectTrue(fsExists("/dev/null"), "/dev/null exists")
    expectTrue(fsExists("/dev/zero"), "/dev/zero exists")
    expectTrue(fsExists("/dev/random"), "/dev/random exists")
    expectTrue(fsExists("/dev/console"), "/dev/console exists")
    int dn = fsOpen("/dev/null", "w")
    expectTrue(dn >= 0, "/dev/null open")
    int wn = fsWrite(dn, "ignored")
    expectEq(wn, 7, "/dev/null write returns len")
    fsClose(dn)
    int dz = fsOpen("/dev/zero", "r")
    string z = fsRead(dz, 4)
    expectEq(string.len(z), 4, "/dev/zero read 4 bytes")
    fsClose(dz)
    int dr = fsOpen("/dev/random", "r")
    string r = fsRead(dr, 8)
    expectEq(string.len(r), 8, "/dev/random read 8 bytes")
    fsClose(dr)
end

func testVFS()
    println("[testVFS] mount / umount")
    boot()
    fsMkdir("/mnt/test", PERM_RWX)
    expectTrue(fsMount("srcfs", "/mnt/test", "xfs"), "fsMount /mnt/test")
    expectFalse(fsMount("srcfs", "/mnt/test", "xfs"), "duplicate mount fails")
    expectTrue(fsUmount("/mnt/test"), "fsUmount /mnt/test")
    expectFalse(fsUmount("/mnt/test"), "double umount fails")
    expectFalse(fsUmount("/"), "umount / fails")
end

func testIntegration()
    println("[testIntegration] boot -> schedule -> memory -> fs -> terminate")
    boot()
    int p1 = procCreate("writer", 0, 8, 0, array["compute 4", "mkdir /srv", "create /srv/a", "compute 2"])
    int p2 = procCreate("reader", 0, 6, 0, array["compute 6"])
    // memhog touches the same vaddr twice so we get at least one TLB hit
    int p3 = procCreate("memhog", 0, 9, 1, array["access 0", "access 4096", "access 8192", "access 0", "compute 4"])
    int p4 = procCreate("cpu",    0, 10, 0, array["compute 10"])
    procArrive(p1)
    procArrive(p2)
    procArrive(p3)
    procArrive(p4)
    schedulerLoop(4000)
    procReapZombies()
    bool allDone = true
    if g_pcb[p1].state < PROC_ZOMBIE then allDone = false end
    if g_pcb[p2].state < PROC_ZOMBIE then allDone = false end
    if g_pcb[p3].state < PROC_ZOMBIE then allDone = false end
    if g_pcb[p4].state < PROC_ZOMBIE then allDone = false end
    expectTrue(allDone, "integration: all 4 procs terminated")
    expectGt(g_contextSwitches, 3, "integration: context switches")
    expectGt(g_memTranslate, 0, "integration: memory translates")
    expectGt(g_memPageFault, 0, "integration: page faults")
    expectGt(g_memTlbHit, 0, "integration: TLB hits")
    expectTrue(fsExists("/srv"), "integration: writer created /srv")
end

func runAllTests() as int
    banner("xos2 self-test")
    boot()
    testFS()
    boot()
    testMem()
    boot()
    testSched()
    testShellParse()
    testShellExec()
    boot()
    testSyscall()
    boot()
    testSignals()
    boot()
    testPipes()
    boot()
    testDevices()
    boot()
    testVFS()
    boot()
    testIntegration()
    return testSummary()
end


// =============================================================================
//  Part 30: Demo / main entrypoint
// =============================================================================

func runDemo() as int
    banner("xos2 demo")
    boot()
    banner("file system")
    fsDumpTree()
    banner("process / memory / fs scenario")
    shRunText("# Demo script\n" +
              "mkdir /home\n" +
              "cd /home\n" +
              "echo hello > test.txt\n" +
              "cat test.txt\n" +
              "ls -l\n" +
              "ps\n" +
              "mem\n" +
              "echo world >> test.txt\n" +
              "cat test.txt\n" +
              "sleep 2\n" +
              "env\n" +
              "help\n")
    banner("state after demo")
    procListReport()
    println(procTop())
    memReport()
    return 0
end

func printUsage()
    println("xos2 - Complete Operating System Simulator (xlang)")
    println("")
    println("usage:")
    println("  xos2 boot <script.xsh>    boot the kernel and run a shell script")
    println("  xos2 test                 run the integrated self-test suite")
    println("  xos2 demo                 run a short interactive demo")
    println("  xos2 help                 show this help")
end

func main(...) as int
    if arg.length < 2 then
        printUsage()
        return 1
    end
    string cmd = string(arg[1])
    if cmd == "help" or cmd == "-h" or cmd == "--help" then
        printUsage()
        return 0
    end
    if cmd == "test" then
        return runAllTests()
    end
    if cmd == "demo" then
        return runDemo()
    end
    if cmd == "boot" then
        if arg.length < 3 then
            println("xos2: 'boot' needs <script.xsh>")
            return 1
        end
        boot()
        // Create an idle shell process so kill/exec have a target
        int sh = procCreate("shell", 0, 999, 0, array["compute 999"])
        procArrive(sh)
        g_currentPid = sh
        string script = string(arg[2])
        return shRunScript(script)
    end
    println("xos2: unknown command: " + cmd)
    println("")
    printUsage()
    return 1
end
