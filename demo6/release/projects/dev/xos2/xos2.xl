    s = s + "  echo <text>             print text\n"
    s = s + "  ls [-l] [path]          list directory\n"
    s = s + "  cat <file>              print file (reads stdin if no arg)\n"
    s = s + "  pwd                     print working directory\n"
    s = s + "  cd <path>               change directory\n"
    s = s + "  mkdir <path>            create directory\n"
    s = s + "  rmdir <path>            remove empty directory\n"
    s = s + "  touch <path>            create empty file\n"
    s = s + "  rm [-rf] <path>         remove file or tree\n"
    s = s + "  ln [-s] <src> <dst>     hard / symbolic link\n"
    s = s + "  readlink <path>         print symlink target\n"
    s = s + "  stat <path>             print file info\n"
    s = s + "  chmod <perm> <path>     change permissions\n"
    s = s + "  chown <uid> <path>      change owner\n"
    s = s + "  mount <src> <tgt>       mount filesystem\n"
    s = s + "  umount <tgt>            unmount filesystem\n"
    s = s + "  export VAR=VAL          set environment variable\n"
    s = s + "  unset VAR               unset environment variable\n"
    s = s + "  env                     list environment\n"
    s = s + "  ps                      list processes\n"
    s = s + "  top                     process summary\n"
    s = s + "  mem                     memory stats\n"
    s = s + "  free                    free memory\n"
    s = s + "  kill <pid> [sig]        terminate process\n"
    s = s + "  exec <name> <burst>     create a process\n"
    s = s + "  alloc <pid> <vaddr>     translate virtual address\n"
    s = s + "  pipe <a> | <b>          create a pipe\n"
    s = s + "  mkfifo <path>           create named pipe\n"
    s = s + "  sleep <n>               sleep n ticks\n"
