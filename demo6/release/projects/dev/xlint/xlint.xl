// xlint - xlang lint 工具（用 xlang 分析 xlang 自身代码）
//
// 通过 `xl parse <file.xl> --format json` 取 AST，递归遍历应用规则：
//   no-while-without-do  while 必须带 do（源码扫描，捕获无法解析的坏代码）
//   no-undefined-var     变量使用前必须声明
//   consistent-naming    变量 snake_case / 类名 PascalCase
//   no-magic-numbers     未命名的魔法数字（可配置阈值，默认 >= 100）
//   require-doc          公开函数（模块级 func，除 main）应有 #doc
//   max-function-length  函数体不超过 N 行（默认 80）
//   no-deep-nesting      if/while/for/try 嵌套不超过 N 层（默认 5）
//   unused-variable      声明但未使用的局部变量
//
// 用法：
//   xl run  projects\dev\xlint\xlint.xl <file.xl|dir> [-r] [--format json]
//          [--rule <name>] [--threshold <n>] [--config <path>] [--strict]
//
// 退出码：默认 0（lint 发现不影响工具退出）；加 --strict 时发现任何 issue 返回 1。

// ===== Issue =====

class Issue
    string file
    int line
    int column
    string rule
    string severity
    string message
    create(string file, int line, int column, string rule, string severity, string message)
        self.file = file
        self.line = line
        self.column = column
        self.rule = rule
        self.severity = severity
        self.message = message
    end
end

class Local
    string name
    int line
    create(string name, int line)
        self.name = name
        self.line = line
    end
end

// ===== 全局状态 =====

string g_xl
string g_curFile
array<Issue> g_issues
set<string> g_enabledRules
set<string> g_builtins
int g_maxMagic
int g_maxFuncLen
int g_maxNesting
set<string> g_decl
array<Local> g_locals

func resetState()
    g_issues = array[]
    g_enabledRules = set<string>{}
    g_decl = set<string>{}
    g_locals = array[]
    g_maxMagic = 100
    g_maxFuncLen = 80
    g_maxNesting = 5
end

