// chatroom - HTTP 聊天室，验证 http.server 并发状态管理 + 长轮询
//
// 用法：
//   chatroom                -> self-test：启动 server、HttpClient 自发自收 + 并发长轮询、报告后退出
//   chatroom serve [port]   -> 常驻模式，监听 port（默认 18300）
//
// 验证范围：
//   1. http.server 对象化路由 getRequest/postRequest（HttpRequest/HttpResponse）
//   2. 并发状态管理：全局可变状态在多 worker HTTP 回调间共享
//   3. 长轮询 long-poll：/api/poll?since=N&timeout=M（sleep + 检查循环，最多 30s）
//   4. cookie session：登录下发 chat_token，后续请求带 cookie 鉴权
//   5. JSON API：login/message/messages/users/logout
//   6. 内嵌 HTML+JS 客户端（GET /）
//
// 设计约束：
//   * native-backed class（HttpRequest/HttpResponse/HttpClientRequest/
//     HttpClientResponse）不可跨函数按值传参，对象化操作全部内联到 handler。
//   * 多 worker（workerCount=4）下共享可变 string 需要 mutex 串行化临界区。
//   * 长轮询的 sleep 循环里不能持锁，否则 POST 拿不到锁 → 死锁；只在
//     快速的 int 读取 / parse-modify-stringify 临界区持锁。

const int DEFAULT_PORT = 18300
const int POLL_INTERVAL_MS = 200
const int POLL_MAX_MS = 30000
const int MAX_MESSAGES = 500
const int WORKERS = 4


// ============================================================
// 全局状态
// ============================================================
string gMessages = "[]"        // JSON 数组：[{id,user,text,time}]
string gSessions = "{}"        // JSON 对象：{token: username}
int gNextId = 1                // 下一条消息的 id（= 当前最大 id + 1）
int gNextTokenSeq = 1          // 会话 token 序号（确定性，便于自测）
mutex gLock                    // 串行化 gMessages/gSessions/gNextId 临界区


// ============================================================
// self-test 计数
// ============================================================
int gPassed = 0
int gFailed = 0
string gBase = ""

func check(bool cond, string name, string detail)
    if cond then
        gPassed += 1
        println("[ PASS ] " + name)
    else
        gFailed += 1
        println("[ FAIL ] " + name + "  " + detail)
    end
end

func expectStatus(int got, int want, string name)
    check(got == want, name, "got status " + got.toString() + " want " + want.toString())
end


// ============================================================
// 纯数据辅助函数（不触碰 native-backed class，可独立拆分）
// ============================================================

// 从 JSON 数组文本里取最大 id（空/非法返回 0）。
func maxMessageId(string jsonArrayStr) as int
    if not json.valid(jsonArrayStr) then
        return 0
    end
    var arr = json.parse(jsonArrayStr)
    int maxId = 0
    for m in arr
        int msgId = int(m["id"])
        if msgId > maxId then
            maxId = msgId
        end
    end
    return maxId
end

// 从会话 JSON 里按 token 查用户名（找不到返回 ""）。
func lookupUser(string token) as string
    gLock.lock()
    string snapshot = gSessions
    gLock.unlock()
    if not json.valid(snapshot) then
        return ""
    end
    var sess = json.parse(snapshot)
    if not (token in sess) then
        return ""
    end
    return string(sess[token])
end


// ============================================================
// 内嵌 HTML 客户端（GET /）
// 用三单引号多行字符串承载；内部 HTML/JS 统一用双引号，避免单引号冲突。
// ============================================================
func chatPage() as string
    string html = '''<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>xlang chatroom</title>
<style>
body { font-family: system-ui, Arial, sans-serif; background: #f4f5f7; margin: 0; padding: 20px; }
h1 { color: #2c3e50; margin-top: 0; }
.card { background: #fff; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.12); padding: 16px; max-width: 760px; margin: 0 auto; }
.row { display: flex; gap: 8px; margin-bottom: 12px; align-items: center; }
input[type=text] { flex: 1; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; }
button { padding: 8px 16px; border: none; border-radius: 4px; background: #2980b9; color: #fff; cursor: pointer; font-size: 14px; }
button:hover { background: #2471a3; }
button.danger { background: #c0392b; }
button.danger:hover { background: #a93226; }
#messages { height: 320px; overflow-y: auto; border: 1px solid #eee; border-radius: 4px; padding: 8px; background: #fafafa; }
.msg { padding: 4px 6px; border-bottom: 1px solid #f0f0f0; word-wrap: break-word; }
.msg .u { font-weight: bold; color: #2980b9; }
.msg .t { color: #888; font-size: 12px; margin-left: 8px; }
.sys { color: #888; font-style: italic; }
#users { font-size: 13px; color: #444; margin-top: 6px; }
.hidden { display: none; }
</style>
</head>
<body>
<div class="card">
<h1>xlang chatroom</h1>
<div id="login">
  <div class="row">
    <input id="user" type="text" placeholder="pick a nickname" maxlength="20">
    <button onclick="doLogin()">Join</button>
  </div>
</div>
<div id="chat" class="hidden">
  <div class="row">
    <div style="flex:1"><b>Logged in as</b> <span id="me">?</span></div>
    <button class="danger" onclick="doLogout()">Logout</button>
  </div>
  <div id="messages"></div>
  <div class="row">
    <input id="msg" type="text" placeholder="type a message and press Send" maxlength="500" onkeydown="if(event.key=="Enter"){doSend();}">
    <button onclick="doSend()">Send</button>
  </div>
  <div id="users">online: loading...</div>
</div>
</div>
<script>
var lastId = 0;
var connected = false;

function api(method, path, body) {
    var opts = { method: method, credentials: "include" };
    if (body) {
        opts.headers = { "Content-Type": "application/json" };
        opts.body = JSON.stringify(body);
    }
    return fetch(path, opts).then(function(r) {
        return r.text().then(function(t) { return { status: r.status, text: t }; });
    });
}

function doLogin() {
    var name = document.getElementById("user").value.trim();
    if (!name) { return; }
    api("POST", "/api/login", { username: name }).then(function(r) {
        if (r.status == 200) {
            var data = JSON.parse(r.text);
            document.getElementById("me").textContent = data.username;
            document.getElementById("login").classList.add("hidden");
            document.getElementById("chat").classList.remove("hidden");
            connected = true;
            lastId = 0;
            document.getElementById("messages").innerHTML = "";
            pollLoop();
            refreshUsers();
        } else {
            alert("login failed: " + r.text);
        }
    });
}

function doSend() {
    var t = document.getElementById("msg").value.trim();
    if (!t) { return; }
    document.getElementById("msg").value = "";
    api("POST", "/api/message", { text: t }).then(function(r) {
        if (r.status != 200) { alert("send failed: " + r.text); }
    });
}

function doLogout() {
    api("POST", "/api/logout", {}).then(function() {
        connected = false;
        document.getElementById("chat").classList.add("hidden");
        document.getElementById("login").classList.remove("hidden");
    });
}

function addMessage(m) {
    var box = document.getElementById("messages");
    var div = document.createElement("div");
    div.className = "msg";
    var d = new Date(m.time * 1000);
    var hh = d.getHours(); var mm = d.getMinutes(); var ss = d.getSeconds();
    var ts = (hh < 10 ? "0" + hh : hh) + ":" + (mm < 10 ? "0" + mm : mm) + ":" + (ss < 10 ? "0" + ss : ss);
    div.innerHTML = "<span class="u">" + escapeHtml(m.user) + "</span>: " + escapeHtml(m.text) + "<span class="t">" + ts + "</span>";
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
}

function escapeHtml(s) {
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

function pollLoop() {
    if (!connected) { return; }
    fetch("/api/poll?since=" + lastId + "&timeout=30000", { credentials: "include" }).then(function(r) {
        return r.text();
    }).then(function(t) {
        var arr = JSON.parse(t || "[]");
        arr.forEach(function(m) {
            addMessage(m);
            if (m.id > lastId) { lastId = m.id; }
        });
        pollLoop();
    }).catch(function() {
        setTimeout(pollLoop, 2000);
    });
}

function refreshUsers() {
    if (!connected) { return; }
    api("GET", "/api/users").then(function(r) {
        if (r.status == 200) {
            var users = JSON.parse(r.text || "[]");
            document.getElementById("users").textContent = "online (" + users.length + "): " + users.join(", ");
        }
        setTimeout(refreshUsers, 5000);
    });
}
</script>
</body>
</html>'''
    return html
end


// ============================================================
// HTTP 路由 handler（HttpRequest/HttpResponse 必须内联使用）
// 单一集中式 handler，按 method/path 分发。
// ============================================================
func route(point reqHandle, point respHandle) as bool
    HttpRequest req = HttpRequest(reqHandle)
    HttpResponse resp = HttpResponse(respHandle)

    resp.header("X-Server", "xlang-chatroom")

    string method = req.method()
    string path = req.path()

    // ---------- GET / -> 聊天页面 ----------
    if method == "GET" and path == "/" then
        return resp.text(chatPage(), "text/html; charset=utf-8")
    end

    // ---------- POST /api/login -> 登录，下发 cookie ----------
    if method == "POST" and path == "/api/login" then
        string body = req.body()
        if not json.valid(body) then
            resp.status(400)
            return resp.jsonText("{\"ok\":false,\"error\":\"invalid json\"}")
        end
        var payload = json.parse(body)
        if not ("username" in payload) then
            resp.status(400)
            return resp.jsonText("{\"ok\":false,\"error\":\"missing username\"}")
        end
        string username = string.trim(string(payload["username"]))
        int ulen = string.len(username)
        if ulen < 1 or ulen > 20 then
            resp.status(400)
            return resp.jsonText("{\"ok\":false,\"error\":\"username length must be 1..20\"}")
        end

        gLock.lock()
        string token = "tok-" + gNextTokenSeq.toString()
        gNextTokenSeq = gNextTokenSeq + 1
        var sess = json.parse(gSessions)
        sess[token] = username
        gSessions = json.stringify(sess)
        gLock.unlock()

        int cookieFlags = http.server.cookieHttpOnly
        resp.cookie("chat_token", token, "/", 86400, http.server.sameSiteLax, cookieFlags)
        return resp.jsonText("{\"ok\":true,\"token\":\"" + token + "\",\"username\":\"" + username + "\"}")
    end

    // ---------- POST /api/message -> 发送消息（需 cookie 鉴权）----------
    if method == "POST" and path == "/api/message" then
        string token = req.cookie("chat_token")
        string username = lookupUser(token)
        if username == "" then
            resp.status(401)
            return resp.jsonText("{\"ok\":false,\"error\":\"not logged in\"}")
        end
        string body = req.body()
        if not json.valid(body) then
            resp.status(400)
            return resp.jsonText("{\"ok\":false,\"error\":\"invalid json\"}")
        end
        var payload = json.parse(body)
        if not ("text" in payload) then
            resp.status(400)
            return resp.jsonText("{\"ok\":false,\"error\":\"missing text\"}")
        end
        string text = string(payload["text"])
        if string.len(text) < 1 or string.len(text) > 500 then
            resp.status(400)
            return resp.jsonText("{\"ok\":false,\"error\":\"text length must be 1..500\"}")
        end

        gLock.lock()
        int msgId = gNextId
        gNextId = gNextId + 1
        int ts = time.toUnix(time.now())
        var msgs = json.parse(gMessages)
        var msg = {}
        msg["id"] = msgId
        msg["user"] = username
        msg["text"] = text
        msg["time"] = ts
        msgs.push(msg)
        // 只保留最近 MAX_MESSAGES 条
        int mlen = msgs.length
        if mlen > MAX_MESSAGES then
            var trimmed = []
            int start = mlen - MAX_MESSAGES
            int i = start
            while i < mlen do
                trimmed.push(msgs[i])
                i = i + 1
            end
            msgs = trimmed
        end
        gMessages = json.stringify(msgs)
        gLock.unlock()

        return resp.jsonText("{\"ok\":true,\"id\":" + msgId.toString() + "}")
    end

    // ---------- GET /api/messages?since=N -> 消息列表（增量）----------
    if method == "GET" and path == "/api/messages" then
        int since = int(req.queryValue("since"))
        gLock.lock()
        string snapshot = gMessages
        gLock.unlock()
        var msgs = json.parse(snapshot)
        var out = []
        for m in msgs
            if int(m["id"]) > since then
                out.push(m)
            end
        end
        return resp.jsonText(json.stringify(out))
    end

    // ---------- GET /api/poll?since=N&timeout=M -> 长轮询 ----------
    if method == "GET" and path == "/api/poll" then
        int since = int(req.queryValue("since"))
        string tstr = req.queryValue("timeout")
        int timeoutMs = POLL_MAX_MS
        if tstr != "" then
            int parsed = int(tstr)
            if parsed > 0 and parsed < POLL_MAX_MS then
                timeoutMs = parsed
            end
        end

        float deadline = time.timer() + float(timeoutMs) / 1000.0
        bool gotNew = false
        while true do
            gLock.lock()
            int maxId = gNextId - 1
            gLock.unlock()
            if maxId > since then
                gotNew = true
                break
            end
            if time.timer() >= deadline then
                break
            end
            time.sleep(POLL_INTERVAL_MS)
        end

        // 无论是否有新消息，都返回 since 之后的列表（可能为 []）
        gLock.lock()
        string snap = gMessages
        gLock.unlock()
        var msgs = json.parse(snap)
        var out = []
        for m in msgs
            if int(m["id"]) > since then
                out.push(m)
            end
        end
        return resp.jsonText(json.stringify(out))
    end

    // ---------- GET /api/users -> 在线用户列表 ----------
    if method == "GET" and path == "/api/users" then
        gLock.lock()
        string snap2 = gSessions
        gLock.unlock()
        var sess = json.parse(snap2)
        var users = []
        for k, v in sess
            users.push(v)
        end
        return resp.jsonText(json.stringify(users))
    end

    // ---------- POST /api/logout -> 登出，清 cookie ----------
    if method == "POST" and path == "/api/logout" then
        string token2 = req.cookie("chat_token")
        gLock.lock()
        if json.valid(gSessions) then
            var sess2 = json.parse(gSessions)
            if token2 in sess2 then
                sess2.remove(token2)
            end
            gSessions = json.stringify(sess2)
        end
        gLock.unlock()
        resp.deleteCookie("chat_token", "/")
        return resp.jsonText("{\"ok\":true}")
    end

    // 未匹配
    resp.status(404)
    return resp.jsonText("{\"ok\":false,\"error\":\"not found\"}")
end

func errorHandler(int status, string message, point reqHandle, point respHandle) as bool
    HttpRequest req = HttpRequest(reqHandle)
    HttpResponse resp = HttpResponse(respHandle)
    resp.status(status)
    resp.header("X-Error-Path", req.path())
    string body = "{\"status\":"
    body = body + status.toString()
    body = body + ",\"error\":\""
    body = body + message
    body = body + "\"}"
    return resp.jsonText(body)
end

func(point, point) as bool requestHandler = route
func(int, string, point, point) as bool serverErrorHandler = errorHandler


// ============================================================
// buildServer
// ============================================================
func buildServer(int port) as point
    point server = http.server.create(port, "127.0.0.1", 128, 1048576, 1048576, 100, 65536, WORKERS)
    if server == null then
        return null
    end
    http.server.getRequest(server, "/", requestHandler)
    http.server.getRequest(server, "/api/messages", requestHandler)
    http.server.getRequest(server, "/api/poll", requestHandler)
    http.server.getRequest(server, "/api/users", requestHandler)
    http.server.postRequest(server, "/api/login", requestHandler)
    http.server.postRequest(server, "/api/message", requestHandler)
    http.server.postRequest(server, "/api/logout", requestHandler)
    http.server.error(server, serverErrorHandler)
    return server
end


// ============================================================
// 并发长轮询自测：后台线程发 poll，主线程发消息，验证 poll 被唤醒。
// ============================================================
int gPollDone = 0
int gPollStatus = 0
string gPollBody = ""
float gPollElapsed = 0.0

func makePoller(string url) as func() as int
    return func() as int
        float t0 = time.timer()
        HttpClientRequest req = HttpClientRequest(url)
        req.method("GET")
        req.timeout(12000)
        HttpClientResponse resp = req.execute()
        gPollStatus = resp.status()
        gPollBody = resp.body()
        gPollElapsed = time.timer() - t0
        gPollDone = 1
        return 0
    end
end


// ============================================================
// self-test：HttpClientRequest 反向打自己的 server。
// native-backed class 不可跨函数传参，每个 case 内联到 if true then 作用域。
// ============================================================
func runSelfTest(int port) as int
    gBase = "http://127.0.0.1:" + port.toString()

    println("")
    println("================ chatroom self-test ================")
    println("base url: " + gBase)
    println("")

    // 跨 case 需要保留的字符串（token 不是 native-backed，可跨作用域）
    string tokenA = ""
    string tokenB = ""

    // ---- case 1: GET / -> 200 + HTML 客户端
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/")
        req.method("GET")
        req.timeout(5000)
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 200, "1. GET / status")
        check(resp.header("X-Server") == "xlang-chatroom", "1. GET / X-Server header", "got " + resp.header("X-Server"))
        check(string.contains(resp.body(), "xlang chatroom"), "1. GET / body has title", "body-len=" + string.len(resp.body()).toString())
        check(string.contains(resp.body(), "doLogin"), "1. GET / body has JS client", "")
    end

    // ---- case 2: GET /api/users 空房间 -> []
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/api/users")
        req.method("GET")
        req.timeout(5000)
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 200, "2. GET /api/users (empty) status")
        check(resp.body() == "[]", "2. empty users list", "body=" + resp.body())
    end

    // ---- case 3: POST /api/login alice -> token + Set-Cookie
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/api/login")
        req.method("POST")
        req.timeout(5000)
        req.text("{\"username\":\"alice\"}", "application/json")
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 200, "3. POST /api/login alice status")
        check(string.contains(resp.body(), "\"ok\":true"), "3. login ok", "body=" + resp.body())
        check(string.contains(resp.body(), "\"username\":\"alice\""), "3. login echoes username", "body=" + resp.body())
        check(string.contains(resp.header("Set-Cookie"), "chat_token="), "3. Set-Cookie chat_token", "Set-Cookie=" + resp.header("Set-Cookie"))
        var j = json.parse(resp.body())
        tokenA = string(j["token"])
        check(tokenA != "", "3. token returned", "token=" + tokenA)
    end

    // ---- case 4: POST /api/login 用户名长度校验 -> 400
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/api/login")
        req.method("POST")
        req.timeout(5000)
        req.text("{\"username\":\"\"}", "application/json")
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 400, "4. login empty username -> 400")
    end

    // ---- case 5: POST /api/message 无 cookie -> 401
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/api/message")
        req.method("POST")
        req.timeout(5000)
        req.text("{\"text\":\"should fail\"}", "application/json")
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 401, "5. POST /api/message no auth -> 401")
    end

    // ---- case 6: POST /api/message alice 发消息 -> ok + id
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/api/message")
        req.method("POST")
        req.timeout(5000)
        req.header("Cookie", "chat_token=" + tokenA)
        req.text("{\"text\":\"hello from alice\"}", "application/json")
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 200, "6. POST /api/message alice status")
        check(string.contains(resp.body(), "\"ok\":true"), "6. message ok", "body=" + resp.body())
        check(string.contains(resp.body(), "\"id\":1"), "6. first message id=1", "body=" + resp.body())
    end

    // ---- case 7: GET /api/messages?since=0 -> 含 alice 的消息
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/api/messages?since=0")
        req.method("GET")
        req.timeout(5000)
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 200, "7. GET /api/messages status")
        check(string.contains(resp.body(), "alice"), "7. messages has alice", "body=" + resp.body())
        check(string.contains(resp.body(), "hello from alice"), "7. messages has text", "body=" + resp.body())
    end

    // ---- case 8: GET /api/users -> 含 alice
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/api/users")
        req.method("GET")
        req.timeout(5000)
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 200, "8. GET /api/users status")
        check(string.contains(resp.body(), "alice"), "8. users has alice", "body=" + resp.body())
    end

    // ---- case 9: login bob + bob 发消息
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/api/login")
        req.method("POST")
        req.timeout(5000)
        req.text("{\"username\":\"bob\"}", "application/json")
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 200, "9. login bob status")
        var j = json.parse(resp.body())
        tokenB = string(j["token"])
        check(tokenB != "" and tokenB != tokenA, "9. bob token differs from alice", "tokenB=" + tokenB)
    end
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/api/message")
        req.method("POST")
        req.timeout(5000)
        req.header("Cookie", "chat_token=" + tokenB)
        req.text("{\"text\":\"hi from bob\"}", "application/json")
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 200, "9b. POST /api/message bob status")
    end

    // ---- case 10: GET /api/messages?since=1 -> 只含 bob 的消息（增量）
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/api/messages?since=1")
        req.method("GET")
        req.timeout(5000)
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 200, "10. GET /api/messages?since=1 status")
        check(string.contains(resp.body(), "hi from bob"), "10. since=1 has bob", "body=" + resp.body())
        check(not string.contains(resp.body(), "hello from alice"), "10. since=1 excludes alice (id=1)", "body=" + resp.body())
    end

    // ---- case 11: logout alice -> /api/users 不再含 alice
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/api/logout")
        req.method("POST")
        req.timeout(5000)
        req.header("Cookie", "chat_token=" + tokenA)
        req.text("{}", "application/json")
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 200, "11. logout alice status")
    end
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/api/users")
        req.method("GET")
        req.timeout(5000)
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 200, "11b. GET /api/users status")
        check(string.contains(resp.body(), "bob"), "11b. users still has bob", "body=" + resp.body())
        check(not string.contains(resp.body(), "alice"), "11b. users no longer has alice", "body=" + resp.body())
    end

    // ---- case 12: alice 登出后发消息 -> 401
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/api/message")
        req.method("POST")
        req.timeout(5000)
        req.header("Cookie", "chat_token=" + tokenA)
        req.text("{\"text\":\"ghost\"}", "application/json")
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 401, "12. logged-out alice -> 401")
    end

    // ---- case 13: 并发长轮询唤醒测试
    //     bob 仍在会话里。后台线程 poll(since=当前最大id)，主线程稍后发消息，
    //     poll 必须被新消息唤醒并快速返回（而不是等满 timeout）。
    if true then
        int curMax = 0
        // 先取当前最大 id
        HttpClientRequest req0 = HttpClientRequest(gBase + "/api/messages?since=0")
        req0.method("GET")
        req0.timeout(5000)
        HttpClientResponse resp0 = req0.execute()
        curMax = maxMessageId(resp0.body())
        println("  (concurrency test) current max id = " + curMax.toString())

        gPollDone = 0
        gPollStatus = 0
        gPollBody = ""
        gPollElapsed = 0.0

        string pollUrl = gBase + "/api/poll?since=" + curMax.toString() + "&timeout=5000"
        thread(makePoller(pollUrl))

        // 等 poll 连上 server 并进入等待循环
        time.sleep(700)

        // 主线程发一条新消息（bob）
        HttpClientRequest req = HttpClientRequest(gBase + "/api/message")
        req.method("POST")
        req.timeout(5000)
        req.header("Cookie", "chat_token=" + tokenB)
        req.text("{\"text\":\"concurrency-wakeup\"}", "application/json")
        HttpClientResponse resp = req.execute()
        check(resp.status() == 200, "13. post during poll status", "status=" + resp.status().toString())

        // 等 poll 线程完成（最多 8s）
        float waitStart = time.timer()
        while gPollDone == 0 and (time.timer() - waitStart) < 8.0 do
            time.sleep(50)
        end

        check(gPollDone == 1, "13. long-poll completed", "gPollDone=" + gPollDone.toString())
        check(gPollStatus == 200, "13. long-poll status 200", "status=" + gPollStatus.toString())
        check(string.contains(gPollBody, "concurrency-wakeup"), "13. long-poll got wakeup message", "body=" + gPollBody)
        // timeout=5000；若被唤醒，应远小于 5s（给足余量到 3.5s）
        check(gPollElapsed < 3.5, "13. long-poll woke on new message (not timeout)", "elapsed=" + gPollElapsed.toString())
        println("  (concurrency test) poll elapsed = " + gPollElapsed.toString() + "s")
    end

    // ---- case 14: 长轮询超时测试（无新消息，等满 timeout 返回 []）
    if true then
        float t0 = time.timer()
        HttpClientRequest req = HttpClientRequest(gBase + "/api/poll?since=9999999&timeout=1200")
        req.method("GET")
        req.timeout(8000)
        HttpClientResponse resp = req.execute()
        float elapsed = time.timer() - t0
        expectStatus(resp.status(), 200, "14. long-poll timeout status")
        check(resp.body() == "[]", "14. timeout returns empty list", "body=" + resp.body())
        check(elapsed >= 1.0 and elapsed < 2.6, "14. timeout waited ~1.2s", "elapsed=" + elapsed.toString())
        println("  (timeout test) poll elapsed = " + elapsed.toString() + "s")
    end

    // ---- case 15: 404 兜底 -> 错误处理器
    if true then
        HttpClientRequest req = HttpClientRequest(gBase + "/api/no-such-endpoint")
        req.method("GET")
        req.timeout(5000)
        HttpClientResponse resp = req.execute()
        expectStatus(resp.status(), 404, "15. unknown endpoint -> 404")
        check(resp.header("X-Error-Path") == "/api/no-such-endpoint", "15. X-Error-Path", "X-Error-Path=" + resp.header("X-Error-Path"))
    end

    println("")
    println("------------------- summary -------------------")
    println("passed: " + gPassed.toString() + " / " + (gPassed + gFailed).toString())
    println("failed: " + gFailed.toString())
    println("")

    if gFailed > 0 then
        return 1
    end
    return 0
end


// ============================================================
// main
// ============================================================
func main(...) as int
    println("xlang chatroom - HTTP chat with concurrent state + long-polling")
    println("")

    // 初始化全局状态（mutex 需显式构造，见 prodcon 用法）
    gMessages = "[]"
    gSessions = "{}"
    gNextId = 1
    gNextTokenSeq = 1
    gLock = mutex()

    string mode = "selftest"
    int port = DEFAULT_PORT
    if arg.length >= 2 then
        string a1 = string(arg[1])
        if a1 == "serve" then
            mode = "serve"
        elseif a1 == "selftest" then
            mode = "selftest"
        elseif a1 == "-h" or a1 == "--help" then
            println("Usage:")
            println("  chatroom               run self-test (start server, fire requests, exit)")
            println("  chatroom serve [port]  serve forever (default port " + DEFAULT_PORT.toString() + ")")
            return 0
        else
            int parsed = int(a1)
            if parsed > 0 then
                port = parsed
            end
        end
    end
    if arg.length >= 3 and mode == "serve" then
        int parsed = int(string(arg[2]))
        if parsed > 0 then
            port = parsed
        end
    end

    if mode == "selftest" then
        point server = buildServer(0)
        if server == null then
            println("FATAL: http.server.create returned null")
            return 1
        end
        if not http.server.start(server) then
            println("FATAL: http.server.start failed")
            http.server.destroy(server)
            return 1
        end
        int boundPort = http.server.port(server)
        println("server started on 127.0.0.1:" + boundPort.toString() + " (workers=" + WORKERS.toString() + ")")
        println("requestCount=" + http.server.requestCount(server).toString() + " connectionCount=" + http.server.connectionCount(server).toString())

        time.sleep(200)

        int rc = runSelfTest(boundPort)

        println("post-test requestCount=" + http.server.requestCount(server).toString())
        println("post-test connectionCount=" + http.server.connectionCount(server).toString())

        if not http.server.drain(server, 3000) then
            println("WARN: drain timed out, forcing stop")
        end
        http.server.stop(server)
        http.server.destroy(server)
        println("server stopped & destroyed")
        return rc
    end

    // serve 模式
    point server = buildServer(port)
    if server == null then
        println("FATAL: http.server.create returned null")
        return 1
    end
    if not http.server.start(server) then
        println("FATAL: http.server.start failed (port " + port.toString() + " busy?)")
        http.server.destroy(server)
        return 1
    end
    println("listening on http://127.0.0.1:" + port.toString())
    println("open the URL in a browser to chat. press Ctrl+C to stop.")
    while true do
        time.sleep(5000)
        println("[stats] requestCount=" + http.server.requestCount(server).toString() + " connectionCount=" + http.server.connectionCount(server).toString())
    end
end
