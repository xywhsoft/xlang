// bigint - 任意精度整数运算工具（用字符串模拟手工竖式）
//
// 用法：
//   bigint add <a> <b>          大整数加法
//   bigint sub <a> <b>          大整数减法
//   bigint mul <a> <b>          大整数乘法
//   bigint pow <base> <exp>     大整数幂（exp 为非负普通整数）
//   bigint fact <n>             阶乘 n!（n 为非负普通整数，可达 100+）
//   bigint fib <n>              斐波那契数列第 n 项（fib(0)=0, fib(1)=1）
//   bigint selftest             内置自检
//
// 设计要点：
//   - 大整数以十进制字符串存储，可选前导符号 +/-。
//   - 加减乘均为字符串逐位运算，模拟手工竖式；不依赖 int64。
//   - exp / n / 索引使用普通 int（它们本身不会超出 int64）。
//   - 幂使用快速幂（平方求幂），阶乘/斐波那契为迭代累乘/累加。

// ---- 数字字符串工具 ----

// 去除前导符号，返回纯数字部分（可能含前导零）。
func rawDigits(string s) as string
    int n = string.len(s)
    if n == 0 then
        return s
    end
    string c0 = string.charAt(s, 0)
    if c0 == "-" or c0 == "+" then
        return string.slice(s, 1)
    end
    return s
end

// 取符号：负数返回 -1，否则返回 1。
func signOf(string s) as int
    if string.len(s) > 0 and string.charAt(s, 0) == "-" then
        return -1
    end
    return 1
end

// 去除前导零；全零时返回 "0"。
func stripLeadZeros(string body) as string
    int n = string.len(body)
    int i = 0
    while i < n do
        if string.charAt(body, i) != "0" then
            break
        end
        i += 1
    end
    string digits = string.slice(body, i)
    if digits == "" then
        return "0"
    end
    return digits
end

// 规范化：去前导符号/前导零，返回无前导零的形式（"0" 无符号）。
func normalize(string s) as string
    int sign = signOf(s)
    string digits = stripLeadZeros(rawDigits(s))
    if digits == "0" then
        return "0"
    end
    if sign < 0 then
        return "-" + digits
    end
    return digits
end

// 检查是否为合法整数串（可选符号 + 纯数字）。
func isValidNumber(string s) as bool
    int n = string.len(s)
    if n == 0 then
        return false
    end
    int start = 0
    string c0 = string.charAt(s, 0)
    if c0 == "-" or c0 == "+" then
        start = 1
        if n == 1 then
            return false
        end
    end
    int i = start
    while i < n do
        int b = string.byteAt(s, i)
        if b < 48 or b > 57 then
            return false
        end
        i += 1
    end
    return true
end

// 把符号应用到无符号量上。
func applySign(int sign, string mag) as string
    if mag == "0" then
        return "0"
    end
    if sign < 0 then
        return "-" + mag
    end
    return mag
end

// 取反（仅规范化后的输入）。
func negate(string s) as string
    string n = normalize(s)
    if n == "0" then
        return "0"
    end
    if string.charAt(n, 0) == "-" then
        return string.slice(n, 1)
    end
    return "-" + n
end

// ---- 无符号（纯数字串）运算 ----

// 比较两个无符号数字串大小：a<b -> -1, == -> 0, a>b -> 1。
func cmpAbs(string a, string b) as int
    int la = string.len(a)
    int lb = string.len(b)
    if la > lb then
        return 1
    end
    if la < lb then
        return -1
    end
    int i = 0
    while i < la do
        int da = string.byteAt(a, i) - 48
        int db = string.byteAt(b, i) - 48
        if da > db then
            return 1
        end
        if da < db then
            return -1
        end
        i += 1
    end
    return 0
end

// 无符号加法（a, b 为纯数字串）。
func addAbs(string a, string b) as string
    string ra = string.reverse(a)
    string rb = string.reverse(b)
    int la = string.len(ra)
    int lb = string.len(rb)
    int n = la
    if lb > n then
        n = lb
    end
    string outputValue = ""
    int carry = 0
    int i = 0
    while i < n do
        int da = 0
        int db = 0
        if i < la then
            da = string.byteAt(ra, i) - 48
        end
        if i < lb then
            db = string.byteAt(rb, i) - 48
        end
        int sum = da + db + carry
        carry = sum / 10
        outputValue = outputValue + string.charAt("0123456789", sum - carry * 10)
        i += 1
    end
    if carry > 0 then
        outputValue = outputValue + "1"
    end
    return string.reverse(outputValue)
end

// 无符号减法（要求 a >= b，返回 a - b）。
func subAbs(string a, string b) as string
    string ra = string.reverse(a)
    string rb = string.reverse(b)
    int la = string.len(ra)
    int lb = string.len(rb)
    string outputValue = ""
    int borrow = 0
    int i = 0
    while i < la do
        int da = string.byteAt(ra, i) - 48
        int db = 0
        if i < lb then
            db = string.byteAt(rb, i) - 48
        end
        int diff = da - db - borrow
        if diff < 0 then
            diff = diff + 10
            borrow = 1
        else
            borrow = 0
        end
        outputValue = outputValue + string.charAt("0123456789", diff)
        i += 1
    end
    return stripLeadZeros(string.reverse(outputValue))
end

// 大数 a 乘以单个数字 d（0..9）。
func mulDigit(string a, int d) as string
    if d == 0 then
        return "0"
    end
    string ra = string.reverse(a)
    int la = string.len(ra)
    string outputValue = ""
    int carry = 0
    int i = 0
    while i < la do
        int da = string.byteAt(ra, i) - 48
        int prod = da * d + carry
        carry = prod / 10
        outputValue = outputValue + string.charAt("0123456789", prod - carry * 10)
        i += 1
    end
    while carry > 0 do
        int m = carry % 10
        outputValue = outputValue + string.charAt("0123456789", m)
        carry = carry / 10
    end
    return string.reverse(outputValue)
end

// 无符号乘法（竖式：对 b 的每一位做 mulDigit 并移位累加）。
func mulAbs(string a, string b) as string
    if a == "0" or b == "0" then
        return "0"
    end
    string rb = string.reverse(b)
    int lb = string.len(rb)
    string result = "0"
    int j = 0
    while j < lb do
        int db = string.byteAt(rb, j) - 48
        string row = mulDigit(a, db)
        if row != "0" then
            if j > 0 then
                row = row + string.repeat("0", j)
            end
            result = addAbs(result, row)
        end
        j += 1
    end
    return result
end

// ---- 带符号运算 ----

func bigAdd(string a, string b) as string
    string na = normalize(a)
    string nb = normalize(b)
    int sa = signOf(na)
    string da = rawDigits(na)
    int sb = signOf(nb)
    string db = rawDigits(nb)
    if sa == sb then
        return applySign(sa, addAbs(da, db))
    end
    int c = cmpAbs(da, db)
    if c == 0 then
        return "0"
    end
    if c > 0 then
        return applySign(sa, subAbs(da, db))
    end
    return applySign(sb, subAbs(db, da))
end

func bigSub(string a, string b) as string
    return bigAdd(a, negate(b))
end

func bigMul(string a, string b) as string
    string na = normalize(a)
    string nb = normalize(b)
    int sa = signOf(na)
    string da = rawDigits(na)
    int sb = signOf(nb)
    string db = rawDigits(nb)
    int sign = sa * sb
    return applySign(sign, mulAbs(da, db))
end

// 快速幂：base^exp（exp 为非负普通整数）。
func bigPow(string base, int exp) as string
    if exp < 0 then
        throw "pow: exponent must be non-negative"
    end
    string result = "1"
    string b = normalize(base)
    int e = exp
    while e > 0 do
        if e % 2 == 1 then
            result = bigMul(result, b)
        end
        e = e / 2
        if e > 0 then
            b = bigMul(b, b)
        end
    end
    return result
end

// 阶乘 n!（n 为非负普通整数）。
func bigFact(int n) as string
    if n < 0 then
        throw "fact: n must be non-negative"
    end
    string result = "1"
    int i = 2
    while i <= n do
        result = bigMul(result, string(i))
        i += 1
    end
    return result
end

// 斐波那契第 n 项（fib(0)=0, fib(1)=1, fib(2)=1, ...）。
func bigFib(int n) as string
    if n < 0 then
        throw "fib: n must be non-negative"
    end
    if n == 0 then
        return "0"
    end
    if n == 1 then
        return "1"
    end
    string a = "0"
    string b = "1"
    int i = 2
    while i <= n do
        string c = bigAdd(a, b)
        a = b
        b = c
        i += 1
    end
    return b
end

// 解析非负普通整数串，非法时返回 -1。
func parseNonNegInt(string s) as int
    int n = string.len(s)
    if n == 0 then
        return -1
    end
    int i = 0
    while i < n do
        int b = string.byteAt(s, i)
        if b < 48 or b > 57 then
            return -1
        end
        i += 1
    end
    return int(s)
end

// ---- 自检 ----

func assertEq(string got, string want)
    if got != want then
        println("FAIL: got ", got, " want ", want)
        throw "selftest failed"
    end
end

func selftest()
    assertEq(bigAdd("99999999999999999999", "1"), "100000000000000000000")
    assertEq(bigAdd("0", "0"), "0")
    assertEq(bigAdd("123", "456"), "579")
    assertEq(bigSub("100000000000000000000", "1"), "99999999999999999999")
    assertEq(bigSub("100", "100"), "0")
    assertEq(bigSub("50", "100"), "-50")
    assertEq(bigSub("-50", "-100"), "50")
    assertEq(bigAdd("-50", "100"), "50")
    assertEq(bigAdd("-50", "30"), "-20")
    assertEq(bigMul("12345678901234567890", "98765432109876543210"), "1219326311370217952237463801111263526900")
    assertEq(bigMul("0", "12345"), "0")
    assertEq(bigMul("-3", "4"), "-12")
    assertEq(bigMul("-3", "-4"), "12")
    assertEq(bigPow("2", 10), "1024")
    assertEq(bigPow("2", 0), "1")
    assertEq(bigPow("0", 5), "0")
    assertEq(bigPow("99999", 2), "9999800001")
    assertEq(bigFact(0), "1")
    assertEq(bigFact(1), "1")
    assertEq(bigFact(5), "120")
    assertEq(bigFact(10), "3628800")
    assertEq(bigFact(20), "2432902008176640000")
    assertEq(bigFact(50), "30414093201713378043612608166064768844377641568960512000000000000")
    assertEq(bigFib(0), "0")
    assertEq(bigFib(1), "1")
    assertEq(bigFib(2), "1")
    assertEq(bigFib(10), "55")
    assertEq(bigFib(100), "354224848179261915075")
    println("selftest OK")
end

func printUsage()
    println("bigint - arbitrary precision integer arithmetic")
    println("Usage:")
    println("  bigint add <a> <b>        a + b")
    println("  bigint sub <a> <b>        a - b")
    println("  bigint mul <a> <b>        a * b")
    println("  bigint pow <base> <exp>   base ** exp (exp >= 0)")
    println("  bigint fact <n>           n! (n >= 0)")
    println("  bigint fib <n>            n-th Fibonacci (fib(0)=0, fib(1)=1)")
    println("  bigint selftest           run built-in checks")
    println("Numbers are decimal integers of any length with optional leading sign.")
end

func requireNum(string label, string v)
    if isValidNumber(v) == false then
        throw label + ": '" + v + "' is not a valid integer"
    end
end

func main(...) as int
    if arg.length < 2 then
        printUsage()
        return 1
    end

    string cmd = string(arg[1])

    if cmd == "selftest" then
        try
            selftest()
            return 0
        catch e
            println("Error: " + e.message)
            return 1
        end
        return 0
    end

    if cmd == "add" or cmd == "sub" or cmd == "mul" then
        if arg.length < 4 then
            println("Error: '" + cmd + "' needs <a> <b>")
            return 1
        end
        string a = string(arg[2])
        string b = string(arg[3])
        try
            requireNum(cmd, a)
            requireNum(cmd, b)
            if cmd == "add" then
                println(bigAdd(a, b))
            elseif cmd == "sub" then
                println(bigSub(a, b))
            else
                println(bigMul(a, b))
            end
            return 0
        catch e
            println("Error: " + e.message)
            return 1
        end
        return 0
    end

    if cmd == "pow" then
        if arg.length < 4 then
            println("Error: 'pow' needs <base> <exp>")
            return 1
        end
        string base = string(arg[2])
        int exp = parseNonNegInt(string(arg[3]))
        if exp < 0 then
            println("Error: 'pow' <exp> must be a non-negative integer")
            return 1
        end
        try
            requireNum("pow", base)
            println(bigPow(base, exp))
            return 0
        catch e
            println("Error: " + e.message)
            return 1
        end
        return 0
    end

    if cmd == "fact" then
        if arg.length < 3 then
            println("Error: 'fact' needs <n>")
            return 1
        end
        int n = parseNonNegInt(string(arg[2]))
        if n < 0 then
            println("Error: 'fact' <n> must be a non-negative integer")
            return 1
        end
        try
            println(bigFact(n))
        catch e
            println("Error: " + e.message)
            return 1
        end
        return 0
    end

    if cmd == "fib" then
        if arg.length < 3 then
            println("Error: 'fib' needs <n>")
            return 1
        end
        int n = parseNonNegInt(string(arg[2]))
        if n < 0 then
            println("Error: 'fib' <n> must be a non-negative integer")
            return 1
        end
        try
            println(bigFib(n))
        catch e
            println("Error: " + e.message)
            return 1
        end
        return 0
    end

    println("Error: unknown command '" + cmd + "'")
    printUsage()
    return 1
end
