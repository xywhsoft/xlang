// fontrender - 位图字体渲染器（5x7 Bitmap Font -> ASCII Art）
//
// 完整的命令行 ASCII Art 文本渲染工具，验证 xlang 的：
//   * var 大型字库的构建与查找
//   * string 逐字符处理（charAt / 字符串拼接）
//   * array<string> 行缓冲的逐行构建
//   * 嵌套 while 整数循环（scale 缩放 / 对齐填充）
//
// 功能：
//   * 5x7 点阵字体（每个字符 7 行 x 5 列，# / 空格）
//   * 字库：A-Z / 0-9 / 常用标点（. , ! ? : ; ' " - + = / * ( ) < > _ 空格）
//   * 文本渲染：字符串 -> ASCII Art（字符间 1 列间隔，按 scale 缩放）
//   * 多种尺寸：1x / 2x / 4x（每个像素重复 N x N）
//   * 对齐：left / center / right（在给定 width 内填充）
//   * Banner：大标题（scale=4 + ASCII 边框）
//
// 用法：
//   fontrender                                打印用法
//   fontrender text "<text>" [scale=1] [align=left] [width=0]
//                                             渲染文本到 ASCII Art
//                                             scale:  1/2/4
//                                             align:  left/center/right
//                                             width:  对齐目标宽度（0=自然宽度）
//   fontrender banner "<text>"                生成大标题横幅（scale=4 + 边框）
//   fontrender test                           自检（字库/渲染/缩放/对齐）
//
// 验证：
//   cd /d D:\GIT\x-lang\demo6\release
//   xl run projects\dev\fontrender\fontrender.xl text "HELLO" scale=2
//   xl run projects\dev\fontrender\fontrender.xl banner "XLANG"
//   xl build projects\dev\fontrender\fontrender.xl -o projects\dev\fontrender\fontrender.exe


// ========================================================================
// 字库：var
//   key   = 单个字符（大写）
//   value = array<string>，7 个字符串，每个 5 字符（# 或空格）
//
// 全局只初始化一次，全程只读，规避「typed 容器作函数形参被值拷贝」。
// ========================================================================
var gFont = {}

// 空白字形（未定义字符的占位）
array<string> gBlank = array[]


// 添加一个字形到字库。
func addGlyph(string ch, string r0, string r1, string r2, string r3, string r4, string r5, string r6)
    array<string> g = array[]
    g.append(r0)
    g.append(r1)
    g.append(r2)
    g.append(r3)
    g.append(r4)
    g.append(r5)
    g.append(r6)
    gFont[ch] = g
end


// 初始化字库（A-Z / 0-9 / 标点 / 空格）。
