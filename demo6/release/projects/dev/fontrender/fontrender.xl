// ========================================================================
// 参数解析辅助
// ========================================================================

// 安全整数解析。
func parseArgInt(string s, int defValue) as int
    s = string.trim(s)
    if string.len(s) == 0 then
        return defValue
    end
    int start = 0
    string first = string.slice(s, 0, 1)
    if first == "-" or first == "+" then
        start = 1
        if string.len(s) == 1 then
            return defValue
        end
    end
    int i = start
    while i < string.len(s) do
        string ch = string.slice(s, i, 1)
        if string.indexOf("0123456789", ch) < 0 then
            return defValue
        end
        i = i + 1
    end
    return int(s)
end

// 把 scale 归一为合法值（1/2/4），否则返回 1。
func normalizeScale(int sc) as int
    if sc == 2 then
        return 2
    end
    if sc == 4 then
        return 4
    end
    return 1
end


// ========================================================================
// 渲染核心
//
// renderText：把字符串渲染成 ASCII Art 行数组。
//   text  : 待渲染文本（自动大写化，小写字母映射到对应大写字形）
//   scale : 像素缩放倍数（1/2/4），每个像素重复 scale x scale
//
// 返回：array<string>，7*scale 行；字符间有 scale 列空格间隔。
//
// 算法（行优先构建）：
//   预分配 7*scale 个空行缓冲；
//   逐字符处理：
//     取字形（未定义用 gBlank）；
//     对每个输出行（0 .. 7*scale-1），源行 = outRow / scale，
//     逐列（0..4）取源像素，重复 scale 次追加到该行缓冲；
//     字符末尾追加 scale 列空格作间隔。
func loadGlyph(string ch) as array<string>
    var src = gFont[ch]
    array<string> out = array[]
    int i = 0
    int n = src.length
    while i < n do
        out.append(string(src[i]))
        i += 1
    end
    return out
end

// ========================================================================
func renderText(string text, int scale) as array<string>
    int rowTotal = 7 * scale
    array<string> lines = array[]
    int r = 0
    while r < rowTotal do
        lines.append("")
        r = r + 1
    end

    int ci = 0
    int n = string.len(text)
    while ci < n do
        string raw = string.charAt(text, ci)
        string ch = string.upper(raw)
        array<string> glyph
        if gFont.contains(ch) then
            glyph = loadGlyph(ch)
        else
            glyph = gBlank
        end

        // 把字形按 scale 缩放追加到每一行
        int outRow = 0
        while outRow < rowTotal do
            int srcRow = outRow / scale
            string srcLine = glyph[srcRow]
            string acc = lines[outRow]
            int col = 0
            while col < 5 do
                string pixel = string.charAt(srcLine, col)
                int rep = 0
                while rep < scale do
                    acc = acc + pixel
                    rep = rep + 1
                end
                col = col + 1
            end
            lines[outRow] = acc
            outRow = outRow + 1
        end

        // 字符间隔（scale 列空格）
        int or2 = 0
        while or2 < rowTotal do
            string acc2 = lines[or2]
            int rep = 0
            while rep < scale do
                acc2 = acc2 + " "
                rep = rep + 1
            end
            lines[or2] = acc2
            or2 = or2 + 1
        end

        ci = ci + 1
    end

    return lines
end


// 计算行数组的最大显示宽度。
func maxWidthOf(array<string> lines) as int
    int w = 0
    int i = 0
    while i < lines.length do
        int lw = string.len(lines[i])
        if lw > w then
            w = lw
        end
        i = i + 1
    end
    return w
end


// 按指定对齐方式把每行填充到 targetWidth。
//   align : "left" / "center" / "right"（其它视为 left）
//   不足 targetWidth 时补空格；超出则原样保留。
func applyAlign(array<string> lines, int targetWidth, string align) as array<string>
    array<string> out = array[]
    int i = 0
    while i < lines.length do
        string line = lines[i]
        int lw = string.len(line)
        int pad = targetWidth - lw
        if pad <= 0 then
            out.append(line)
        elseif align == "center" then
            int left = pad / 2
            int right = pad - left
            out.append(string.repeat(" ", left) + line + string.repeat(" ", right))
        elseif align == "right" then
            out.append(string.repeat(" ", pad) + line)
        else
            out.append(line + string.repeat(" ", pad))
        end
        i = i + 1
    end
    return out
end


// 打印行数组（每行一条 println）。
func printLines(array<string> lines)
    int i = 0
    while i < lines.length do
        println(lines[i])
        i = i + 1
    end
end


// ========================================================================
// 子命令实现
// ========================================================================

func cmdText(string text, int scale, string align, int width) as int
    scale = normalizeScale(scale)
    array<string> lines = renderText(text, scale)
    if width > 0 then
        int natural = maxWidthOf(lines)
        int target = width
        if target < natural then
            target = natural
        end
        lines = applyAlign(lines, target, align)
    end
    println("[text] scale=" + string(scale) + " align=" + align + " chars=" + string(string.len(text)))
    println(string.repeat("-", maxWidthOf(lines)))
    printLines(lines)
    println(string.repeat("-", maxWidthOf(lines)))
    return 0
end


func cmdBanner(string text) as int
    int scale = 4
    array<string> lines = renderText(text, scale)
    int w = maxWidthOf(lines)
    if w == 0 then
        w = 1
    end

    println("[banner] scale=" + string(scale) + " chars=" + string(string.len(text)) + " width=" + string(w))

    // 顶部边框：+ ---...--- +
    string top = "+" + string.repeat("-", w + 2) + "+"
    println(top)

    // 内容行：| <居中文本> |
    int i = 0
    while i < lines.length do
        string line = lines[i]
        int lw = string.len(line)
        int pad = w - lw
        int left = 0
        int right = 0
        if pad > 0 then
            left = pad / 2
            right = pad - left
        end
        println("| " + string.repeat(" ", left) + line + string.repeat(" ", right) + " |")
        i = i + 1
    end

    println(top)
    return 0
end


// ========================================================================
// 自检
// ========================================================================
int g_pass = 0
int g_fail = 0

func check(bool cond, string name)
    if cond then
        g_pass = g_pass + 1
        println("  [PASS] " + name)
    else
        g_fail = g_fail + 1
        println("  [FAIL] " + name)
    end
end


func cmdTest() as int
    println("fontrender self-test")
    println("================================================================")

    // ---- 1. 字库 ----
    println("[1] font library")
    check(gFont.contains("A"), "font has 'A'")
    check(gFont.contains("Z"), "font has 'Z'")
    check(gFont.contains("0"), "font has '0'")
    check(gFont.contains("9"), "font has '9'")
    check(gFont.contains(" "), "font has space")
    check(gFont.contains("."), "font has '.'")
    check(gFont.length >= 26 + 10 + 1, "font has >= 37 glyphs (got " + string(gFont.length) + ")")

    array<string> ga = loadGlyph("A")
    check(ga.length == 7, "'A' glyph has 7 rows (got " + string(ga.length) + ")")
    check(string.len(ga[0]) == 5, "'A' row 0 width == 5")
    check(ga[3] == "#####", "'A' row 3 == '#####' (got '" + ga[3] + "')")
    check(ga[0] == " ### ", "'A' row 0 == ' ### ' (got '" + ga[0] + "')")

    array<string> go = loadGlyph("O")
    check(go[0] == " ### " and go[6] == " ### ", "'O' top/bottom symmetric")

    // 字形宽度一致性：抽检若干字形每行都是 5
    bool widthOk = true
    array<string> keysToCheck = array["A", "B", "M", "W", "0", "5", " ", ".", "?", "/"]
    int ki = 0
    while ki < keysToCheck.length do
        array<string> g = loadGlyph(keysToCheck[ki])
        int ri = 0
        while ri < g.length do
            if string.len(g[ri]) != 5 then
                widthOk = false
            end
            ri = ri + 1
        end
        ki = ki + 1
    end
    check(widthOk, "sampled glyphs all have 5-wide rows")

    // ---- 2. 渲染（scale=1） ----
    println("[2] render scale=1")
    array<string> hi = renderText("HI", 1)
    check(hi.length == 7, "'HI' scale=1 -> 7 rows (got " + string(hi.length) + ")")
    // 每个字形 5 列 + 1 列间隔；'H' + 间隔 + 'I' + 间隔 = 5+1+5+1 = 12
    check(string.len(hi[0]) == 12, "'HI' scale=1 row width == 12 (got " + string(string.len(hi[0])) + ")")
    // 第 0 行 H 是 "#   #"，间隔空格，I 是 "#####"，间隔空格 => "#   # ##### "
    check(hi[0] == "#   # ##### ", "'HI' scale=1 row 0 == '#   # ##### ' (got '" + hi[0] + "')")

    // ---- 3. 缩放（scale=2） ----
    println("[3] render scale=2")
    array<string> i2 = renderText("I", 2)
    check(i2.length == 14, "'I' scale=2 -> 14 rows (got " + string(i2.length) + ")")
    // 5 列 * 2 = 10 列像素 + 2 列间隔 = 12
    check(string.len(i2[0]) == 12, "'I' scale=2 row width == 12 (got " + string(string.len(i2[0])) + ")")
    // I 顶行 "#####"，scale=2 => "##########" + 2 空格间隔
    check(i2[0] == "##########  ", "'I' scale=2 row 0 == '##########  ' (got '" + i2[0] + "')")
    // I 的第 3 源行（index 2）= "  #  "，对应 scale=2 输出行 4/5
    check(i2[4] == "    ##      ", "'I' scale=2 row 4 (src row 2 '  #  ') correct (got '" + i2[4] + "')")

    // ---- 4. 缩放（scale=4） ----
    println("[4] render scale=4")
    array<string> i4 = renderText("A", 4)
    check(i4.length == 28, "'A' scale=4 -> 28 rows (got " + string(i4.length) + ")")
    // 5*4=20 像素 + 4 间隔 = 24
    check(string.len(i4[0]) == 24, "'A' scale=4 row width == 24 (got " + string(string.len(i4[0])) + ")")
    // A 顶行 " ### " => scale=4 => 4 空格 + 12 # + 4 空格 + 4 列间隔 = 24
    check(i4[0] == "    ############        ", "'A' scale=4 row 0 correct (got '" + i4[0] + "')")

    // ---- 5. 未知字符 ----
    println("[5] unknown char")
    array<string> unk = renderText("[", 1)
    check(unk.length == 7, "'[' (undefined) -> 7 rows")
    check(unk[0] == "      ", "'[' row 0 blank (6 wide: 5 glyph + 1 gap)")

    // ---- 6. 小写映射 ----
    println("[6] lowercase mapping")
    array<string> lo = renderText("a", 1)
    array<string> up = renderText("A", 1)
    check(lo[0] == up[0], "'a' maps to 'A' glyph")
    check(lo[3] == "##### ", "'a' row 3 == '##### '")

    // ---- 7. 对齐 ----
    println("[7] alignment")
    array<string> base = renderText("A", 1)
    // 自然宽度 6（5 像素 + 1 间隔）
    int nat = maxWidthOf(base)
    check(nat == 6, "'A' natural width == 6 (got " + string(nat) + ")")

    array<string> left = applyAlign(base, 12, "left")
    check(string.len(left[0]) == 12, "left align width 12")
    check(string.slice(left[0], 0, 5) == " ### ", "left align content at start")

    array<string> right = applyAlign(base, 12, "right")
    check(string.len(right[0]) == 12, "right align width 12")
    check(string.slice(right[0], 6, 5) == " ### ", "right align content at end (got '" + string.slice(right[0], 6, 5) + "')")
    // 右对齐前 6 位应为空格
    check(string.slice(right[0], 0, 6) == "      ", "right align leading spaces")

    array<string> center = applyAlign(base, 12, "center")
    check(string.len(center[0]) == 12, "center align width 12")
    // 居中：pad=6, left=3, right=3 => 前 3 空格 + 内容
    check(string.slice(center[0], 0, 3) == "   ", "center align 3 leading spaces")
    check(string.slice(center[0], 3, 5) == " ### ", "center align content in middle")

    // ---- 8. maxWidthOf ----
    println("[8] maxWidthOf")
    array<string> mixed = array[]
    mixed.append("###")
    mixed.append("#####")
    mixed.append("#")
    check(maxWidthOf(mixed) == 5, "maxWidthOf finds 5")

    println("================================================================")
    println("result: " + string(g_pass) + " passed, " + string(g_fail) + " failed")
    if g_fail > 0 then
        return 1
    end
    return 0
end


// ========================================================================
// 用法
// ========================================================================
func printUsage()
    println("fontrender - 5x7 bitmap font -> ASCII Art renderer")
    println("usage:")
    println("  fontrender                                  show this help")
    println("  fontrender text \"<text>\" [scale=1] [align=left] [width=0]")
    println("                                              render text to ASCII art")
    println("                                              scale: 1/2/4 (each pixel NxN)")
    println("                                              align: left/center/right")
    println("                                              width: align target width (0=natural)")
    println("  fontrender banner \"<text>\"                  big banner (scale=4 + border)")
    println("  fontrender test                             run self-test")
    println("font: 5x7, A-Z / 0-9 / punctuation, stored in var")
end


func main(...) as int
    initFont()

    if arg.length < 2 then
        printUsage()
        return 1
    end

    string cmd = string(arg[1])

    if cmd == "-h" or cmd == "--help" or cmd == "help" then
        printUsage()
        return 0
    end

    try
        if cmd == "test" then
            return cmdTest()
        elseif cmd == "text" then
            string text = ""
            bool hasText = false
            int scale = 1
            string align = "left"
            int width = 0
            int i = 2
            while i < arg.length do
                string a = string(arg[i])
                int eq = string.indexOf(a, "=")
                if eq >= 0 then
                    string k = string.slice(a, 0, eq)
                    string v = string.slice(a, eq + 1, string.len(a))
                    if k == "scale" then
                        scale = parseArgInt(v, 1)
                    elseif k == "align" then
                        align = v
                    elseif k == "width" then
                        width = parseArgInt(v, 0)
                    end
                else
                    if not hasText then
                        text = a
                        hasText = true
                    else
                        text = text + " " + a
                    end
                end
                i = i + 1
            end
            if not hasText then
                println("error: 'text' command needs <text>")
                return 1
            end
            return cmdText(text, scale, align, width)
        elseif cmd == "banner" then
            string text = ""
            bool hasText = false
            int i = 2
            while i < arg.length do
                string a = string(arg[i])
                if not hasText then
                    text = a
                    hasText = true
                else
                    text = text + " " + a
                end
                i = i + 1
            end
            if not hasText then
                println("error: 'banner' command needs <text>")
                return 1
            end
            return cmdBanner(text)
        else
            println("error: unknown command '" + cmd + "'")
            printUsage()
            return 1
        end
    catch e
        println("error: " + e.message)
        return 1
    end

    return 0
end
