// deepclone.xl - derive 全套验证工具
//
// 验证 xlang 全部 derive 能力，对每一项给出 PASS / FAIL 报告：
//   derive copy        - copy(obj) 浅拷贝
//   derive clone       - clone(obj) 深拷贝
//   derive moveOnly    - 与 copy/clone 冲突的语义检查（合法独立使用）
//   derive value       - __toValue__ / __fromValue__（经 json/xson 路径验证）
//   derive json        - json.stringify / json.parse::<Class>
//   derive xson        - xson.stringify / xson.parse::<Class>
//   derive string      - 字符串表示（详见 BUG-D2，当前 derive 不生成代码）
//   derive hash        - 字段哈希（详见 BUG-D2，当前 derive 不生成代码）
//   derive equals      - == / != 比较（详见 BUG-D2，当前 derive 不生成代码）
//   字段级注解:
//     @json("name")            - 自定义 JSON 字段名
//     @persist(name="...")     - 通用字段名（同时影响 json/xson）
//     @persist(skip)           - 跳过持久化
//     omit=empty / omit=null   - 空值省略
//
// 用法:
//   deepclone            运行全部用例，PASS=0 失败项时 EXIT=1
//   deepclone --help     显示帮助
//
// 重要说明（详见 README.md / dev/BUGS.md）:
//  * derive string / hash / equals 当前只通过语义校验，不生成任何协议方法。
//    为演示这些 derive 「应该生成什么」，Product 上手写了
//    __eq__ / __ne__ / __toString__ / hashByFields 作为兜底实现；
//    derive 本身没有提供这些能力（BUG-D2）。
// ---------------------------------------------------------------------------

const string SEPARATOR = "----------------------------------------"

// 统计用例结果
int g_pass = 0
int g_fail = 0

func section(string title)
    println("")
    println(SEPARATOR)
    println(title)
    println(SEPARATOR)
end

func pass(string name)
    g_pass += 1
    println("[ PASS ] " + name)
end

func fail(string name, string detail)
    g_fail += 1
    println("[ FAIL ] " + name + " : " + detail)
end

// 整数相等断言
func expectInt(int got, int want, string label) as bool
    if got == want then
        return true
    end
    fail(label, "got " + string.formatInt(got) + " want " + string.formatInt(want))
    return false
end

// 浮点相等断言
func expectFloat(float got, float want, string label) as bool
    if got == want then
        return true
    end
    fail(label, "got " + string.formatFloat(got) + " want " + string.formatFloat(want))
    return false
end

// 字符串相等断言
func expectStr(string got, string want, string label) as bool
    if got == want then
        return true
    end
    fail(label, "got \"" + got + "\" want \"" + want + "\"")
    return false
end

// 布尔断言
func expectBool(bool got, bool want, string label) as bool
    if got == want then
        return true
    end
    string g = "false"
    if got then
        g = "true"
    end
    string w = "false"
    if want then
        w = "true"
    end
    fail(label, "got " + g + " want " + w)
    return false
end

// 包含子串断言
func expectContains(string haystack, string needle, string label) as bool
    if string.contains(haystack, needle) then
        return true
    end
    fail(label, "\"" + haystack + "\" 不包含 \"" + needle + "\"")
    return false
end

// 不包含子串断言
func expectNotContains(string haystack, string needle, string label) as bool
    if not string.contains(haystack, needle) then
        return true
    end
    fail(label, "\"" + haystack + "\" 不应包含 \"" + needle + "\"")
    return false
end

// ---------------------------------------------------------------------------
// 测试用主类：声明全部 derive + 字段级注解
// ---------------------------------------------------------------------------
class Product
    derive copy
    derive clone
    derive value
    derive json
    derive xson
    // derive string/hash/equals: reserved but not implemented in demo6
    // 手写 __eq__/__ne__/__toString__/hashByFields 提供运行能力

    int id = 0
    string name = ""
    float price = 0.0
    string createdAt @json("created_at") @persist(name="createdAt") = ""
    string internalNote @persist(skip) = ""
    string memo @json(omit=empty) @xson(omit=null) = ""

    // ---- derive equals 兜底（BUG-D2：derive 不生成 __eq__/__ne__） ----
    func __eq__(Product other) as bool
        if self.id != other.id then
            return false
        end
        if self.name != other.name then
            return false
        end
        if self.price != other.price then
            return false
        end
        return true
    end

    func __ne__(Product other) as bool
        if self.id != other.id then
            return true
        end
        if self.name != other.name then
            return true
        end
        if self.price != other.price then
            return true
        end
        return false
    end

    // ---- derive string 兜底（BUG-D2：derive 不生成 __toString__） ----
    func __toString__() as string
        string s = "Product(id=" + string.formatInt(self.id)
        s = s + ", name=\"" + self.name + "\""
        s = s + ", price=" + string.formatFloat(self.price) + ")"
        return s
    end

    // ---- derive hash 兜底（BUG-D2：derive 不生成 hash） ----
    // 把字段拼成字符串后交给 hash.u32 / hash.u64。
    func hashByFields() as uint64
        string buf = "Product|" + string.formatInt(self.id) + "|"
        buf = buf + self.name + "|" + string.formatFloat(self.price) + "|"
        buf = buf + self.createdAt
        return hash.u64(buf)
    end
end

// ---------------------------------------------------------------------------
// derive moveOnly：合法独立使用（不与 copy/clone 同列）
// ---------------------------------------------------------------------------
class MoveOnlyHandle
    derive moveOnly
    int handle = 0
end

// ---------------------------------------------------------------------------
// 各 derive 测试函数
// ---------------------------------------------------------------------------

func testDeriveCopy() as int
    section("derive copy - copy(obj) 浅拷贝")
    Product src
    src.id = 100
    src.name = "Widget"
    src.price = 19.95
    src.createdAt = "2026-07-09"
    src.internalNote = "secret"

    Product c = copy(src)
    if expectInt(c.id, 100, "copy.id") then pass("copy 保留 id") end
    if expectStr(c.name, "Widget", "copy.name") then pass("copy 保留 name") end
    if expectFloat(c.price, 19.95, "copy.price") then pass("copy 保留 price") end
    if expectStr(c.createdAt, "2026-07-09", "copy.createdAt") then pass("copy 保留 createdAt") end
    if expectStr(c.internalNote, "secret", "copy.internalNote") then pass("copy 保留 internalNote") end

    // 改原对象，副本不应跟随
    src.id = 999
    src.name = "Changed"
    if expectInt(c.id, 100, "copy 隔离 id") then pass("copy 隔离 id") end
    if expectStr(c.name, "Widget", "copy 隔离 name") then pass("copy 隔离 name") end
    return 0
end

func testDeriveClone() as int
    section("derive clone - clone(obj) 深拷贝")
    Product src
    src.id = 200
    src.name = "Gadget"
    src.price = 5.5
    src.memo = "filled"

    Product d = clone(src)
    if expectInt(d.id, 200, "clone.id") then pass("clone 保留 id") end
    if expectStr(d.name, "Gadget", "clone.name") then pass("clone 保留 name") end
    if expectStr(d.memo, "filled", "clone.memo") then pass("clone 保留 memo") end

    src.id = 0
    src.name = "Reset"
    src.memo = ""
    if expectInt(d.id, 200, "clone 隔离 id") then pass("clone 隔离 id") end
    if expectStr(d.name, "Gadget", "clone 隔离 name") then pass("clone 隔离 name") end
    if expectStr(d.memo, "filled", "clone 隔离 memo") then pass("clone 隔离 memo") end
    return 0
end

func testDeriveMoveOnly() as int
    section("derive moveOnly - 合法独立声明 + 冲突检查说明")
    // moveOnly 单独声明是合法的（MoveOnlyHandle 类）。
    MoveOnlyHandle m
    m.handle = 42
    if expectInt(m.handle, 42, "moveOnly.handle") then pass("moveOnly 类可正常实例化/读写") end

    // 冲突检查（derive copy + derive moveOnly）需要单独文件触发，否则本工具
    // 自身会编译失败。此处仅打印说明，实际冲突用例见 README.md。
    println("[ INFO ] derive moveOnly + derive copy 的冲突检查已由 xl 在语义")
    println("         阶段拦截（实测：[sem] derive moveOnly 不能与 derive copy")
    println("         或 derive clone 同时使用）。本工具不能把非法源码内联进")
    println("         自身，否则 EXIT!=0；冲突复现见 README.md。")
    pass("moveOnly 独立声明合法 + 冲突检查已验证（外部用例）")
    return 0
end

func testDeriveValue() as int
    section("derive value - 经 json/xson 路径验证 __toValue__/__fromValue__")
    // __toValue__ / __fromValue__ 是内部协议，不能直接当方法调用
    // （p.__toValue__() 报 [sem] unknown class/union field）。
    // 它的能力通过 json / xson 标准库导出，下面用往返测试间接验证。
    Product p
    p.id = 303
    p.name = "ValueProbe"
    p.price = 1.25

    string j = json.stringify(p)
    Product back = json.parse::<Product>(j)
    if expectInt(back.id, 303, "value/json 往返 id") then pass("value -> json -> id") end
    if expectStr(back.name, "ValueProbe", "value/json 往返 name") then pass("value -> json -> name") end
    if expectFloat(back.price, 1.25, "value/json 往返 price") then pass("value -> json -> price") end

    string x = xson.stringify(p)
    Product backX = xson.parse::<Product>(x)
    if expectInt(backX.id, 303, "value/xson 往返 id") then pass("value -> xson -> id") end
    if expectStr(backX.name, "ValueProbe", "value/xson 往返 name") then pass("value -> xson -> name") end
    return 0
end

func testDeriveJson() as int
    section("derive json - json.stringify / json.parse::<Product>")
    Product p
    p.id = 404
    p.name = "JsonItem"
    p.price = 99.0
    p.createdAt = "2026-01-02"
    p.internalNote = "should-skip"
    p.memo = "keep"

    string j = json.stringify(p)
    println("  json: " + j)

    // 字段重命名
    if expectContains(j, "created_at", "@json(created_at) 重命名") then pass("@json 字段重命名") end
    // skip
    if expectNotContains(j, "internalNote", "@persist(skip)") then pass("@persist(skip) 跳过字段") end
    if expectNotContains(j, "should-skip", "@persist(skip) 值不出现") then pass("@persist(skip) 值不出现") end
    // omit=empty：memo 非空时应出现
    if expectContains(j, "memo", "omit=empty + 非空 -> 出现") then pass("omit=empty 非空保留") end

    // 解析回来
    Product back = json.parse::<Product>(j)
    if expectInt(back.id, 404, "json.parse id") then pass("json.parse id") end
    if expectStr(back.name, "JsonItem", "json.parse name") then pass("json.parse name") end
    if expectStr(back.createdAt, "2026-01-02", "json.parse createdAt") then pass("json.parse created_at -> createdAt") end
    if expectStr(back.memo, "keep", "json.parse memo") then pass("json.parse memo") end

    // omit=empty：空 memo 应被省略
    p.memo = ""
    string j2 = json.stringify(p)
    println("  json(empty memo): " + j2)
    if expectNotContains(j2, "memo", "omit=empty + 空 -> 省略") then pass("omit=empty 空值省略") end
    return 0
end

func testDeriveXson() as int
    section("derive xson - xson.stringify / xson.parse::<Product>")
    Product p
    p.id = 505
    p.name = "XsonItem"
    p.price = 7.77
    p.createdAt = "2026-03-04"
    p.memo = ""

    string x = xson.stringify(p)
    println("  xson: " + x)

    // xson 走 @persist(name="createdAt")，所以字段名应仍是 createdAt
    if expectContains(x, "createdAt", "xson 使用 @persist(name=)") then pass("xson 使用通用字段名") end
    // @json 重命名不应影响 xson
    if expectNotContains(x, "created_at", "xson 不受 @json 影响") then pass("xson 不受 @json 影响") end
    // @persist(skip)
    if expectNotContains(x, "internalNote", "xson @persist(skip)") then pass("xson @persist(skip)") end
    // omit=null：memo 是 ""（非 null），所以应出现
    if expectContains(x, "memo", "omit=null + 非null -> 出现") then pass("omit=null 非null保留") end

    Product back = xson.parse::<Product>(x)
    if expectInt(back.id, 505, "xson.parse id") then pass("xson.parse id") end
    if expectStr(back.name, "XsonItem", "xson.parse name") then pass("xson.parse name") end
    if expectStr(back.createdAt, "2026-03-04", "xson.parse createdAt") then pass("xson.parse createdAt") end
    return 0
end

func testDeriveString() as int
    section("derive string - 字符串表示（手写 __toString__ 兜底）")
    Product p
    p.id = 606
    p.name = "StringItem"
    p.price = 12.34

    // BUG-D2: derive string 不生成 __toString__，且 string(p) 报
    // [sem] 该表达式不能转换为目标类型。本工具靠手写 __toString__ 协议方法。
    string s = p.__toString__()
    println("  toString: " + s)
    if expectContains(s, "606", "__toString__ 含 id") then pass("__toString__ 含 id") end
    if expectContains(s, "StringItem", "__toString__ 含 name") then pass("__toString__ 含 name") end
    if expectContains(s, "12.34", "__toString__ 含 price") then pass("__toString__ 含 price") end

    println("[ INFO ] derive string 当前是 no-op（BUG-D2）。string(p) 直接构造")
    println("         在 [sem] 阶段被拒，仅手写 __toString__ 协议可用。")
    pass("derive string 声明通过语义校验（运行能力靠手写协议）")
    return 0
end

func testDeriveHash() as int
    section("derive hash - 字段哈希（手写 hashByFields 兜底）")
    Product a
    a.id = 707
    a.name = "HashItem"
    a.price = 0.5
    a.createdAt = "2026-05-06"

    Product b
    b.id = 707
    b.name = "HashItem"
    b.price = 0.5
    b.createdAt = "2026-05-06"

    Product c
    c.id = 708
    c.name = "HashItem"
    c.price = 0.5
    c.createdAt = "2026-05-06"

    // BUG-D2: derive hash 不生成代码。本工具用手写 hashByFields 演示预期行为。
    uint64 ha = a.hashByFields()
    uint64 hb = b.hashByFields()
    uint64 hc = c.hashByFields()

    println("  hash a: " + string.formatUInt(ha, "x16"))
    println("  hash b: " + string.formatUInt(hb, "x16"))
    println("  hash c: " + string.formatUInt(hc, "x16"))

    if expectBool(ha == hb, true, "同值同哈希") then pass("相同字段 -> 相同 hash") end
    if expectBool(ha == hc, false, "异值异哈希") then pass("不同字段 -> 不同 hash") end

    println("[ INFO ] derive hash 当前是 no-op（BUG-D2）。hash.u32(p) 等标准库")
    println("         入口在 [sem] 阶段拒绝 class 实参。")
    pass("derive hash 声明通过语义校验（运行能力靠手写实现）")
    return 0
end

func testDeriveEquals() as int
    section("derive equals - == / != 比较（手写 __eq__/__ne__ 兜底）")
    Product a
    a.id = 808
    a.name = "EqItem"
    a.price = 3.0

    Product b
    b.id = 808
    b.name = "EqItem"
    b.price = 3.0

    Product c
    c.id = 809
    c.name = "Other"
    c.price = 4.0

    // BUG-D2: derive equals 不生成 __eq__/__ne__，必须手写。
    if expectBool(a == b, true, "a == b (同值)") then pass("== 同值返回 true") end
    if expectBool(a == c, false, "a == c (异值)") then pass("== 异值返回 false") end
    if expectBool(a != c, true, "a != c (异值)") then pass("!= 异值返回 true") end
    if expectBool(a != b, false, "a != b (同值)") then pass("!= 同值返回 false") end

    println("[ INFO ] derive equals 当前是 no-op（BUG-D2）。本工具靠手写 __eq__/__ne__。")
    pass("derive equals 声明通过语义校验（运行能力靠手写协议）")
    return 0
end

func testFieldAnnotations() as int
    section("字段级注解综合 - @json / @persist(skip) / @persist(name=) / omit")
    Product p
    p.id = 909
    p.name = "Anno"
    p.price = 0.99
    p.createdAt = "2026-08-09"
    p.internalNote = "topsecret"
    p.memo = "visible"

    string j = json.stringify(p)
    string x = xson.stringify(p)
    println("  json: " + j)
    println("  xson: " + x)

    // @json("created_at") 只影响 json
    if expectContains(j, "created_at", "json 用 @json 名") then pass("json @json(created_at)") end
    if expectNotContains(j, "\"createdAt\"", "json 不用原文名") then pass("json 不输出 createdAt 原名") end

    // @persist(name="createdAt") 在 xson 侧保留原名
    if expectContains(x, "createdAt", "xson 用 @persist 名") then pass("xson @persist(name=createdAt)") end
    if expectNotContains(x, "created_at", "xson 不受 @json 名影响") then pass("xson 不受 @json 影响") end

    // @persist(skip) 对两侧都生效
    if expectNotContains(j, "internalNote", "json @persist(skip)") then pass("json @persist(skip)") end
    if expectNotContains(x, "internalNote", "xson @persist(skip)") then pass("xson @persist(skip)") end
    if expectNotContains(j, "topsecret", "skip 值不出现(json)") then pass("skip 值不泄露(json)") end
    if expectNotContains(x, "topsecret", "skip 值不出现(xson)") then pass("skip 值不泄露(xson)") end

    // omit：memo 非空时两侧都出现
    if expectContains(j, "memo", "omit=empty 非空(json)") then pass("omit=empty 非空保留(json)") end
    if expectContains(x, "memo", "omit=null 非空(xson)") then pass("omit=null 非空保留(xson)") end
    return 0
end

func printSummary() as int
    section("汇总")
    println("PASS: " + string.formatInt(g_pass))
    println("FAIL: " + string.formatInt(g_fail))
    println("")
    println("已知限制（不计入 FAIL，详见 README.md / dev/BUGS.md）:")
    println("  * BUG-D2: derive string/hash/equals 仅过语义校验，不生成代码")
    if g_fail == 0 then
        println("")
        println("全部「已实现」derive 能力均通过。")
        return 0
    end
    return 1
end

func printHelp()
    println("deepclone - xlang derive 全套验证工具")
    println("")
    println("用法:")
    println("  deepclone            运行全部 derive 用例")
    println("  deepclone --help     显示本帮助")
    println("")
    println("覆盖:")
    println("  derive copy / clone / moveOnly / value / json / xson")
    println("  derive string / hash / equals (声明 + 手写协议兜底)")
    println("  字段级注解 @json / @persist(skip) / @persist(name=) / omit=empty/null")
    println("")
    println("退出码:")
    println("  0  全部「已实现」能力 PASS")
    println("  1  存在 FAIL（已知 no-op 项不计入）")
end

func main(...) as int
    int i = 1
    while i < arg.length do
        string a = string(arg[i])
        if a == "--help" or a == "-h" then
            printHelp()
            return 0
        end
        i += 1
    end

    println("deepclone: derive 全套验证工具")
    println("xlang derive capabilities verification")

    testDeriveCopy()
    testDeriveClone()
    testDeriveMoveOnly()
    testDeriveValue()
    testDeriveJson()
    testDeriveXson()
    testDeriveString()
    testDeriveHash()
    testDeriveEquals()
    testFieldAnnotations()

    return printSummary()
end
