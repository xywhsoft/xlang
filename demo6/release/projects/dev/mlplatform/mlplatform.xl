// ============================================================================
// 自检测试
// ============================================================================

func testTensorBasic()
    println("")
    println("--- Tensor basics ---")
    array<int> shp = array[]
    shp.append(2)
    shp.append(3)
    Tensor t = Tensor(shp)
    expectI(t.numel, 6, "tensor numel")
    expectI(t.shape[0], 2, "tensor shape[0]")
    expectI(t.shape[1], 3, "tensor shape[1]")
    expectI(t.strides[0], 3, "tensor strides[0]")
    expectI(t.strides[1], 1, "tensor strides[1]")

    int i = 0
    while i < 6 do
        t.data[i] = float(i + 1)
        i += 1
    end
    expectF(tensorAt2(t, 0, 0), 1.0, 1e-9, "tensorAt2(0,0)")
    expectF(tensorAt2(t, 1, 2), 6.0, 1e-9, "tensorAt2(1,2)")
end

func testTensorOps()
    println("")
    println("--- Tensor operations ---")
    // matmul
    array<float> aData = [1.0, 2.0, 3.0, 4.0]
    array<float> bData = [5.0, 6.0, 7.0, 8.0]
    Tensor a = tensor2d(aData, 2, 2)
    Tensor b = tensor2d(bData, 2, 2)
    Tensor c = matmul(a, b)
    // [[1*5+2*7, 1*6+2*8],[3*5+4*7, 3*6+4*8]] = [[19,22],[43,50]]
    expectF(tensorAt2(c, 0, 0), 19.0, 1e-6, "matmul(0,0)")
    expectF(tensorAt2(c, 0, 1), 22.0, 1e-6, "matmul(0,1)")
    expectF(tensorAt2(c, 1, 0), 43.0, 1e-6, "matmul(1,0)")
    expectF(tensorAt2(c, 1, 1), 50.0, 1e-6, "matmul(1,1)")

    // transpose
    Tensor at = transpose2d(a)
    expectF(tensorAt2(at, 0, 0), 1.0, 1e-9, "transpose(0,0)")
    expectF(tensorAt2(at, 0, 1), 3.0, 1e-9, "transpose(0,1)")
    expectF(tensorAt2(at, 1, 0), 2.0, 1e-9, "transpose(1,0)")

    // add / sub / mul / div
    Tensor s = tensorAdd(a, b)
    expectF(tensorAt2(s, 0, 0), 6.0, 1e-9, "add(0,0)")
    expectF(tensorAt2(s, 1, 1), 12.0, 1e-9, "add(1,1)")
    Tensor m = tensorMul(a, b)
    expectF(tensorAt2(m, 0, 0), 5.0, 1e-9, "mul(0,0)")
    expectF(tensorAt2(m, 1, 1), 32.0, 1e-9, "mul(1,1)")

    // reshape
    array<int> newShp = array[]
    newShp.append(4)
    newShp.append(1)
    Tensor r = reshape(a, newShp)
    expectI(r.numel, 4, "reshape numel")
    expectF(r.data[3], 4.0, 1e-9, "reshape data[3]")

    // slice
    array<float> sliceData = array[]
    sliceData.append(10.0)
    sliceData.append(20.0)
    sliceData.append(30.0)
    sliceData.append(40.0)
    Tensor sl = slice1d(tensor1d(sliceData), 1, 3)
    expectI(sl.shape[0], 2, "slice1d length")
    expectF(sl.data[0], 20.0, 1e-9, "slice1d data[0]")
    expectF(sl.data[1], 30.0, 1e-9, "slice1d data[1]")

    // broadcast
    array<int> shpA = array[]
    shpA.append(3)
    shpA.append(1)
    array<int> shpB = array[]
    shpB.append(1)
    shpB.append(4)
    Tensor big = ones(shpA)
    Tensor small = ones(shpB)
    array<int> bc = broadcastShapes(big.shape, small.shape)
    expectI(bc.length, 2, "broadcast shape length")
    expectI(bc[0], 3, "broadcast shape[0]")
    expectI(bc[1], 4, "broadcast shape[1]")
    Tensor bb = tensorAdd(big, small)
    expectI(bb.shape[0], 3, "broadcast add shape[0]")
    expectI(bb.shape[1], 4, "broadcast add shape[1]")
    expectF(bb.data[5], 2.0, 1e-9, "broadcast add data[5]")
end

func testActivations()
    println("")
    println("--- Activations ---")
    expectF(reluF(-1.0), 0.0, 1e-9, "relu(-1)")
    expectF(reluF(2.5), 2.5, 1e-9, "relu(2.5)")
    expectF(sigmoidF(0.0), 0.5, 1e-9, "sigmoid(0)")
    expectF(tanhF(0.0), 0.0, 1e-9, "tanh(0)")
    expectF(leakyReluF(-2.0, 0.1), -0.2, 1e-9, "leaky_relu(-2,0.1)")
    expectF(eluF(-1.0, 1.0), -0.6321, 1e-3, "elu(-1)")
    expectF(geluF(0.0), 0.0, 1e-9, "gelu(0)")

    // softmax
    array<float> sv = [1.0, 2.0, 3.0]
    array<int> shp = array[]
    shp.append(3)
    Tensor st = tensorFrom(sv, shp)
    Tensor sm = tensorSoftmax(st)
    float sum = tensorSum(sm)
    expectF(sum, 1.0, 1e-6, "softmax sums to 1")
    expectF(sm.data[2], 0.6652, 1e-3, "softmax max arg")
end

func testAutodiff()
    println("")
    println("--- Autodiff (Tape) ---")
    // f(x,y) = (x * y).sum()  => df/dx = y, df/dy = x
    Tape tape = newTape()
    array<float> xv = [1.0, 2.0, 3.0]
    array<float> yv = [4.0, 5.0, 6.0]
    array<int> shp = array[]
    shp.append(3)
    Tensor x = tensorFrom(xv, shp)
    Tensor y = tensorFrom(yv, shp)
    requiresGrad(x, true)
    requiresGrad(y, true)
    Tensor z = adMul(tape, x, y)
    Tensor loss = adSum(tape, z)
    tapeBackward(tape, loss, 1.0)
    Tensor xg = x.grad
    Tensor yg = y.grad
    expectF(xg.data[0], 4.0, 1e-6, "adMul dx[0]=y[0]")
    expectF(xg.data[2], 6.0, 1e-6, "adMul dx[2]=y[2]")
    expectF(yg.data[1], 2.0, 1e-6, "adMul dy[1]=x[1]")

    // matmul gradient: z = x @ y, loss = sum(z)
    // dx[i,j] = sum_k grad_z[i,k] * y[j,k] = sum of j-th row of y
    Tape tape2 = newTape()
    array<float> x2v = [1.0, 2.0, 3.0, 4.0]
    array<float> y2v = [5.0, 6.0, 7.0, 8.0]
    Tensor x2 = tensor2d(x2v, 2, 2)
    Tensor y2 = tensor2d(y2v, 2, 2)
    requiresGrad(x2, true)
    requiresGrad(y2, true)
    Tensor z2 = adMatmul(tape2, x2, y2)
    Tensor loss2 = adSum(tape2, z2)
    tapeBackward(tape2, loss2, 1.0)
    // y = [[5,6],[7,8]]
    // dx[i,j] = y[j,0] + y[j,1]
    Tensor x2g = x2.grad
    expectF(x2g.data[0], 11.0, 1e-6, "adMatmul dx[0,0]=y[0,0]+y[0,1]")
    expectF(x2g.data[1], 15.0, 1e-6, "adMatmul dx[0,1]=y[1,0]+y[1,1]")
end

func testLayers()
    println("")
    println("--- Layers ---")
    seedRandom(99)
    Dense d = Dense()
    d.init(3, 4)
    array<int> shp = array[]
    shp.append(2)
    shp.append(3)
    Tensor x = Tensor(shp)
    int i = 0
    while i < x.numel do
        x.data[i] = float(i + 1)
        i += 1
    end
    println("  x: ", x.shape[0], "x", x.shape[1])
    Tensor y = d.forward(x)
    expectI(y.shape[0], 2, "Dense output rows")
    expectI(y.shape[1], 4, "Dense output cols")

    // ReLU
    ReLU r = ReLU()
    array<float> rv = [-1.0, 2.0, -3.0, 4.0]
    Tensor rt = tensor1d(rv)
    Tensor ry = r.forward(rt)
    expectF(ry.data[0], 0.0, 1e-9, "ReLU forward neg")
    expectF(ry.data[1], 2.0, 1e-9, "ReLU forward pos")
    Tensor rb = r.backward(rt)
    expectF(rb.data[0], 0.0, 1e-9, "ReLU backward mask")

    // Sigmoid
    Sigmoid sg = Sigmoid()
    Tensor sy = sg.forward(rt)
    expectF(sy.data[1], sigmoidF(2.0), 1e-9, "Sigmoid forward")

    // Tanh
    Tanh th = Tanh()
    Tensor ty = th.forward(rt)
    expectF(ty.data[1], tanhF(2.0), 1e-9, "Tanh forward")

    // Sequential
    Sequential seq = Sequential()
    Dense d3 = Dense()
    d3.init(3, 4)
    ReLU r3 = ReLU()
    Dense d4 = Dense()
    d4.init(4, 2)
    seq.add(d3)
    seq.add(r3)
    seq.add(d4)
    Tensor so = seq.forward(x)
    expectI(so.shape[0], 2, "Sequential output rows")
    expectI(so.shape[1], 2, "Sequential output cols")
    array<Tensor> ps = seq.params()
    // d3: W+b=2, d4: W+b=2 -> total 4
    expectI(ps.length, 4, "Sequential params count")
end

func testOptimizers()
    println("")
    println("--- Optimizers ---")
    // 拟合 y = 2x 的简单参数：用 SGD
    array<int> shp = array[]
    shp.append(1)
    Tensor w = Tensor(shp)
    w.data[0] = 0.5
    Tensor gw = Tensor(shp)
    gw.data[0] = 1.0
    array<Tensor> params = array[]
    params.append(w)
    array<Tensor> grads = array[]
    grads.append(gw)
    SGD opt = SGD(0.1)
    opt.step(params, grads)
    expectF(w.data[0], 0.4, 1e-9, "SGD step")

    // Momentum
    Tensor w2 = Tensor(shp)
    w2.data[0] = 1.0
    Tensor gw2 = Tensor(shp)
    gw2.data[0] = 1.0
    array<Tensor> p2 = array[]
    p2.append(w2)
    array<Tensor> g2 = array[]
    g2.append(gw2)
    Momentum mom = Momentum(0.1, 0.9)
    mom.step(p2, g2)
    // v = 0.9*0 + 1 = 1; w = 1 - 0.1*1 = 0.9
    expectF(w2.data[0], 0.9, 1e-9, "Momentum step")

    // Adam one step
    Tensor w3 = Tensor(shp)
    w3.data[0] = 1.0
    Tensor gw3 = Tensor(shp)
    gw3.data[0] = 1.0
    array<Tensor> p3 = array[]
    p3.append(w3)
    array<Tensor> g3 = array[]
    g3.append(gw3)
    Adam adam = Adam(0.1)
    adam.step(p3, g3)
    // 一步后 w3 应该减小
    expectTrue(w3.data[0] < 1.0, "Adam step decreases w")

    // RMSprop
    Tensor w4 = Tensor(shp)
    w4.data[0] = 1.0
    Tensor gw4 = Tensor(shp)
    gw4.data[0] = 1.0
    array<Tensor> p4 = array[]
    p4.append(w4)
    array<Tensor> g4 = array[]
    g4.append(gw4)
    RMSprop rms = RMSprop(0.1)
    rms.step(p4, g4)
    expectTrue(w4.data[0] < 1.0, "RMSprop step decreases w")

    // AdamW
    Tensor w5 = Tensor(shp)
    w5.data[0] = 1.0
    Tensor gw5 = Tensor(shp)
    gw5.data[0] = 1.0
    array<Tensor> p5 = array[]
    p5.append(w5)
    array<Tensor> g5 = array[]
    g5.append(gw5)
    AdamW adamw = AdamW(0.1, 0.01)
    adamw.step(p5, g5)
    expectTrue(w5.data[0] < 1.0, "AdamW step decreases w")
end

func testLosses()
    println("")
    println("--- Losses ---")
    MSELoss mse = MSELoss()
    array<float> pv = [1.0, 2.0, 3.0]
    array<float> tv = [1.0, 2.0, 4.0]
    Tensor pred = tensor1d(pv)
    Tensor tgt = tensor1d(tv)
    float v = mse.compute(pred, tgt)
    // MSE = ((0)^2 + (0)^2 + (-1)^2)/3 = 1/3
    expectF(v, 0.3333, 1e-3, "MSE forward")

    CrossEntropyLoss ce = CrossEntropyLoss()
    array<int> shp2 = array[]
    shp2.append(2)
    shp2.append(3)
    Tensor logits = Tensor(shp2)
    logits.data[0] = 1.0
    logits.data[1] = 2.0
    logits.data[2] = 3.0
    logits.data[3] = 0.5
    logits.data[4] = 0.5
    logits.data[5] = 0.5
    array<float> labelData = array[]
    labelData.append(0.0)
    labelData.append(1.0)
    Tensor labels = tensor1d(labelData)
    float cv = ce.compute(logits, labels)
    expectTrue(cv > 0.0, "CrossEntropy > 0")

    BCELoss bce = BCELoss()
    array<float> bp = [0.8, 0.4]
    array<float> bt = [1.0, 0.0]
    Tensor bpT = tensor1d(bp)
    Tensor btT = tensor1d(bt)
    float bv = bce.compute(bpT, btT)
    expectTrue(bv > 0.0, "BCE > 0")

    FocalLoss fl = FocalLoss(0.25, 2.0)
    float fv = fl.compute(logits, labels)
    expectTrue(fv > 0.0, "Focal > 0")
end

func testSchedulers()
    println("")
    println("--- Schedulers ---")
    StepLR s1 = StepLR(0.1, 10, 0.5)
    expectF(s1.getLR(0, 0.0), 0.1, 1e-9, "StepLR epoch 0")
    expectF(s1.getLR(9, 0.0), 0.1, 1e-9, "StepLR epoch 9")
    expectF(s1.getLR(10, 0.0), 0.05, 1e-9, "StepLR epoch 10")
    expectF(s1.getLR(20, 0.0), 0.025, 1e-9, "StepLR epoch 20")

    CosineAnnealingLR s2 = CosineAnnealingLR(0.1, 0.0, 100)
    expectF(s2.getLR(0, 0.0), 0.1, 1e-9, "Cosine epoch 0")
    expectF(s2.getLR(100, 0.0), 0.0, 1e-6, "Cosine epoch 100")
    float mid = s2.getLR(50, 0.0)
    expectTrue(mid < 0.1 and mid > 0.0, "Cosine epoch 50 mid")

    ReduceOnPlateau s3 = ReduceOnPlateau(0.1, 0.5, 3)
    s3.step(0, 1.0)
    expectF(s3.getLR(0, 0.0), 0.1, 1e-9, "ReduceOnPlateau initial")
    s3.step(1, 1.1)
    s3.step(2, 1.2)
    s3.step(3, 1.3)
    expectF(s3.getLR(3, 0.0), 0.05, 1e-9, "ReduceOnPlateau after patience")
end

func testConvAndPool()
    println("")
    println("--- Conv2D / Pool ---")
    // 单通道 4x4 输入，1x1 卷积到 2 通道
    Conv2D conv = Conv2D()
    conv.init(1, 2, 1)
    array<int> shp = array[]
    shp.append(1)
    shp.append(1)
    shp.append(4)
    shp.append(4)
    Tensor x = Tensor(shp)
    int i = 0
    while i < 16 do
        x.data[i] = float(i + 1)
        i += 1
    end
    Tensor y = conv.forward(x)
    expectI(y.shape[0], 1, "Conv2D batch")
    expectI(y.shape[1], 2, "Conv2D outCh")
    expectI(y.shape[2], 4, "Conv2D outH")
    expectI(y.shape[3], 4, "Conv2D outW")

    // MaxPool2d 2x2 -> 2x2
    MaxPool2d mp = MaxPool2d(2)
    Tensor my = mp.forward(x)
    expectI(my.shape[2], 2, "MaxPool outH")
    expectI(my.shape[3], 2, "MaxPool outW")
    expectF(my.data[0], 6.0, 1e-9, "MaxPool max(0,0)")

    // AvgPool2d
    AvgPool2d ap = AvgPool2d(2)
    Tensor ay = ap.forward(x)
    expectF(ay.data[0], 3.5, 1e-9, "AvgPool avg(0,0)")
end

func testBatchNormDropout()
    println("")
    println("--- BatchNorm / Dropout / Embedding ---")
    BatchNorm bn = BatchNorm()
    bn.init(3)
    array<int> shp = array[]
    shp.append(4)
    shp.append(3)
    Tensor x = Tensor(shp)
    int i = 0
    while i < 12 do
        x.data[i] = float(i) * 0.5 - 1.0
        i += 1
    end
    Tensor y = bn.forward(x)
    expectI(y.shape[0], 4, "BatchNorm batch")
    expectI(y.shape[1], 3, "BatchNorm features")

    Dropout dp = Dropout(0.5)
    Tensor dx = dp.forward(x)
    expectI(dx.numel, x.numel, "Dropout preserves numel")

    Embedding em = Embedding()
    em.init(10, 4)
    array<float> iv = [0.0, 3.0, 7.0]
    Tensor idxT = tensor1d(iv)
    Tensor ev = em.forward(idxT)
    expectI(ev.shape[0], 3, "Embedding batch")
    expectI(ev.shape[1], 4, "Embedding dim")
end

func testDatasets()
    println("")
    println("--- Datasets ---")
    Dataset xor = makeXOR()
    expectI(xor.nSamples, 4, "XOR samples")
    expectI(xor.xs[0].shape[0], 2, "XOR feature dim")

    Dataset sp = makeSpiral(5)
    expectI(sp.nSamples, 15, "Spiral samples (5*3)")
    expectI(sp.nClasses, 3, "Spiral classes")

    Dataset sinD = makeSinRegression(10, 0.0, 1.0)
    expectI(sinD.nSamples, 10, "Sin samples")
    expectF(sinD.ys[0].data[0], math.sin(0.0), 1e-9, "Sin y[0]")

    Dataset mn = makeMnistStyle(2)
    expectI(mn.nSamples, 20, "MnistStyle samples (2*10)")
    expectI(mn.xs[0].shape[0], 64, "MnistStyle feature dim")
end

func testSerialization()
    println("")
    println("--- Serialization ---")
    Sequential model = Sequential()
    Dense d1 = Dense()
    d1.init(2, 3)
    ReLU r1 = ReLU()
    model.add(d1)
    model.add(r1)
    // 改一下权重
    d1.W.data[0] = 0.123
    d1.W.data[5] = -0.456
    string path = "projects/dev/mlplatform/_test_model.json"
    bool saved = saveModel(model, path)
    expectTrue(saved, "saveModel")

    // 创建新模型，加载
    Sequential model2 = Sequential()
    Dense d2 = Dense()
    d2.init(2, 3)
    ReLU r2 = ReLU()
    model2.add(d2)
    model2.add(r2)
    bool loaded = loadModel(model2, path)
    expectTrue(loaded, "loadModel")
    expectF(d2.W.data[0], 0.123, 1e-6, "loaded W[0]")
    expectF(d2.W.data[5], -0.456, 1e-6, "loaded W[5]")
end

func testGradientClipping()
    println("")
    println("--- Gradient clipping ---")
    array<int> shp = array[]
    shp.append(3)
    Tensor g = Tensor(shp)
    g.data[0] = 3.0
    g.data[1] = 4.0
    g.data[2] = 0.0
    array<Tensor> grads = array[]
    grads.append(g)
    // 原始 norm = 5.0, clip 到 1.0 -> scale = 0.2
    clipGradientsGlobalNorm(grads, 1.0)
    expectF(g.data[0], 0.6, 1e-6, "clip grad[0]")
    expectF(g.data[1], 0.8, 1e-6, "clip grad[1]")
end

func testTrainingLoop()
    println("")
    println("--- Training loop (mini XOR) ---")
    seedRandom(42)
    Dataset d = makeXOR()
    Sequential model = Sequential()
    Dense d1 = Dense()
    d1.init(2, 4)
    Tanh a1 = Tanh()
    Dense d2 = Dense()
    d2.init(4, 1)
    Sigmoid a2 = Sigmoid()
    model.add(d1)
    model.add(a1)
    model.add(d2)
    model.add(a2)
    TrainConfig cfg = TrainConfig()
    cfg.epochs = 100
    cfg.batchSize = 4
    cfg.lr = 0.5
    cfg.verbose = false
    cfg.logEvery = 100
    cfg.earlyStopPatience = 0
    Adam opt = Adam(0.1)
    MSELoss lossFn = MSELoss()
    CosineAnnealingLR sched = CosineAnnealingLR(0.5, 0.01, 100)
    TrainHistory h = runTraining(model, opt, sched, lossFn, d.xs, d.ys, cfg)
    expectTrue(h.losses.length > 0, "Training history not empty")
    float last = h.losses[h.losses.length - 1]
    expectTrue(last < 0.5, "Training loss decreased below 0.5")
end

func testAutodiffNumericCheck()
    println("")
    println("--- Autodiff numeric gradient check ---")
    // f(x) = sum(x^2), df/dx = 2x
    Tape tape = newTape()
    array<float> xv = [1.0, 2.0, 3.0]
    array<int> shp = array[]
    shp.append(3)
    Tensor x = tensorFrom(xv, shp)
    requiresGrad(x, true)
    Tensor sq = adSquare(tape, x)
    Tensor loss = adSum(tape, sq)
    tapeBackward(tape, loss, 1.0)
    Tensor xg = x.grad
    expectF(xg.data[0], 2.0, 1e-6, "d sum(x^2)/dx[0]=2")
    expectF(xg.data[1], 4.0, 1e-6, "d sum(x^2)/dx[1]=4")
    expectF(xg.data[2], 6.0, 1e-6, "d sum(x^2)/dx[2]=6")

    // sigmoid 梯度
    Tape tape2 = newTape()
    array<float> x2v = array[]
    x2v.append(0.0)
    x2v.append(1.0)
    x2v.append(-1.0)
    Tensor x2 = tensorFrom(x2v, shp)
    requiresGrad(x2, true)
    Tensor s = adSigmoid(tape2, x2)
    Tensor loss2 = adSum(tape2, s)
    tapeBackward(tape2, loss2, 1.0)
    Tensor x2g = x2.grad
    // sigmoid'(0) = 0.25, sigmoid'(1) = sigmoid(1)*(1-sigmoid(1)) ≈ 0.1966
    expectF(x2g.data[0], 0.25, 1e-4, "sigmoid grad at 0")
    expectF(x2g.data[1], 0.1966, 1e-3, "sigmoid grad at 1")
end

func cmdTest() as int
    println("============================================================")
    println("ML Platform - 自检测试套件")
    println("============================================================")
    testTensorBasic()
    testTensorOps()
    testActivations()
    testAutodiff()
    testAutodiffNumericCheck()
    testLayers()
    testConvAndPool()
    testBatchNormDropout()
    testLosses()
    testOptimizers()
    testSchedulers()
    testDatasets()
    testGradientClipping()
    testTrainingLoop()
    testSerialization()
    return summary()
end

// ============================================================================
// 主入口
// ============================================================================

func printUsage()
    println("mlplatform - Machine Learning Platform in xlang")
    println("Usage:")
    println("  mlplatform xor          Train XOR classification")
    println("  mlplatform spiral       Train spiral classification")
    println("  mlplatform regression   Train sin regression")
    println("  mlplatform mnist        Train MNIST-style classification")
    println("  mlplatform test         Run self-tests")
    println("  mlplatform info         Show version and features")
end

func main(...) as int
    if arg.length < 2 then
        printUsage()
        return 1
    end

    string cmd = string(arg[1])
    try
        if cmd == "xor" then
            return cmdXor()
        elseif cmd == "spiral" then
            return cmdSpiral()
        elseif cmd == "regression" then
            return cmdRegression()
        elseif cmd == "mnist" then
            return cmdMnist()
        elseif cmd == "test" then
            return cmdTest()
        elseif cmd == "info" then
            return cmdInfo()
        else
            println("Error: unknown command '" + cmd + "'")
            printUsage()
            return 1
        end
    catch e
        println("Error: " + e.message)
        return 1
    end

    return 0
end












