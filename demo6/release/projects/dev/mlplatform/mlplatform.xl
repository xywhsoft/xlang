// ============================================================================
// mlplatform - 机器学习平台（Machine Learning Platform in xlang）
//
// 用法：
//   mlplatform xor          训练 XOR 分类（2->8->1 网络，自动微分引擎）
//   mlplatform spiral       训练螺旋分类（2->32->32->3 网络，CrossEntropy）
//   mlplatform regression   训练 sin 回归（1->16->16->1 网络，MSE）
//   mlplatform test         完整自检（张量运算 + 自动微分 + 所有层/优化器）
//   mlplatform mnist        训练简化 MNIST-style 数字分类（8x8 -> 10）
//   mlplatform info         打印版本与功能清单
//
// 设计要点：
//   - Tensor: N 维张量，扁平 array<float> 存储 + shape/strides。
//   - 自动微分引擎 Tape：记录计算图节点（op + inputs + local_grad 闭包），
//     反向传播按拓扑序累积 .grad 字段，用户不需要手写 backward。
//   - 层（Layer 基类，virtual forward/backward）：Dense/Conv2D(im2col)/
//     MaxPool/AvgPool/BatchNorm/Dropout/Flatten/Embedding +
//     ReLU/LeakyReLU/Sigmoid/Tanh/Softmax/ELU/GELU。
//   - 损失：MSE / CrossEntropy / BinaryCrossEntropy / FocalLoss。
//   - 优化器：SGD / Momentum / Adam / AdamW / RMSprop（每个参数维护状态）。
//   - 学习率调度：StepLR / CosineAnnealing / ReduceOnPlateau。
//   - 训练循环：mini-batch + epoch + early stopping + 梯度裁剪。
//   - 序列化：save/load 权重为 JSON。
//   - 数据集：XOR / 螺旋分类 / sin 回归 / MNIST-style 简化数据。
//
// 关键工程要点（绕开当前 xl.exe 的限制，参考 dev/README.md 限制表）：
//   (L1) 多态层用 array<var> + `as Layer` 还原 vtable，避免 typed array 切片。
//   (L2) Tensor 等持有其他 class 字段的 class 加 `derive value` 注解，
//        满足持久化检查。
//   (L3) 不使用 string.formatFloat 在闭包内（部分版本会触发 xrtNumFormat 冲突）。
//   (L4) 自实现 sigmoid/tanh/sinh/cosh（math 标准库未导出这些）。
//   (L5) 嵌套数组赋值走 get/modify/put；普通 array<float> 单层赋值正常。
//
// 运行与验证：
//   cd /d D:\GIT\x-lang\demo6\release
//   xl build projects\dev\mlplatform\mlplatform.xl -o projects\dev\mlplatform\mlplatform.exe
//   projects\dev\mlplatform\mlplatform.exe test
//   projects\dev\mlplatform\mlplatform.exe xor
//   projects\dev\mlplatform\mlplatform.exe spiral
//   projects\dev\mlplatform\mlplatform.exe regression
//
// 注意：当前 xl.exe（2026/7/13 构建）的 `xl run` 路径存在 xvoCreateObject
// 符号未导出的回归（class 创建会失败），故采用 `xl build` 路径验证。详见 BUGS.md。
// ============================================================================

// ============================================================================
// 全局常量与版本
// ============================================================================

string MLP_VERSION = "1.0.0"
float MLP_EPS = 1e-12
float MLP_INF = 1e30
float MLP_NEG_INF = -1e30

// ============================================================================
// 数学辅助函数（自实现 sigmoid/tanh/sinh/cosh 等）
// ============================================================================

func clampF(float x, float lo, float hi) as float
    if x < lo then
        return lo
    end
    if x > hi then
        return hi
    end
    return x
end

func absF(float x) as float
    if x < 0.0 then
        return -x
    end
    return x
end

func safeExp(float x) as float
    if x > 30.0 then
        return math.exp(30.0)
    end
    if x < -30.0 then
        return math.exp(-30.0)
    end
    return math.exp(x)
end

func sigmoidF(float x) as float
    if x >= 0.0 then
        float z = safeExp(-x)
        return 1.0 / (1.0 + z)
    end
    float z = safeExp(x)
    return z / (1.0 + z)
end

func tanhF(float x) as float
    if x >= 15.0 then
        return 1.0
    end
    if x <= -15.0 then
        return -1.0
    end
    float e2 = safeExp(2.0 * x)
    return (e2 - 1.0) / (e2 + 1.0)
end

func sinhF(float x) as float
    float ep = safeExp(x)
    float em = safeExp(-x)
    return (ep - em) * 0.5
end

func coshF(float x) as float
    float ep = safeExp(x)
    float em = safeExp(-x)
    return (ep + em) * 0.5
end

func reluF(float x) as float
    if x > 0.0 then
        return x
    end
    return 0.0
end

func leakyReluF(float x, float alpha) as float
    if x > 0.0 then
        return x
    end
    return alpha * x
end

func eluF(float x, float alpha) as float
    if x > 0.0 then
        return x
    end
    return alpha * (safeExp(x) - 1.0)
end

func geluF(float x) as float
    float c = math.sqrt(2.0 / math.pi)
    float inner = c * (x + 0.044715 * x * x * x)
    return 0.5 * x * (1.0 + tanhF(inner))
end

func safeLog(float x) as float
    if x < MLP_EPS then
        return math.log(MLP_EPS)
    end
    return math.log(x)
end

func approxEq(float a, float b, float tol) as bool
    float d = a - b
    if d < 0.0 then
        d = -d
    end
    return d < tol
end

func relError(float a, float b) as float
    float denom = absF(a) + absF(b)
    if denom < MLP_EPS then
        return 0.0
    end
    return absF(a - b) / denom
end

// 浮点格式化为字符串（不依赖 string.formatFloat 以避免某些版本的冲突）。
func fmtF(float v) as string
    if math.isNaN(v) then
        return "nan"
    end
    if math.isInf(v) then
        if v < 0.0 then
            return "-inf"
        end
        return "inf"
    end
    if v < 0.0 then
        return "-" + fmtF(-v)
    end
    if v == math.floor(v) and v < 1e15 then
        return string(int64(v))
    end
    int64 whole = int64(v)
    float frac = v - float(whole)
    if frac < 0.0 then
        frac = 0.0
    end
    int64 scaled = int64((frac * 1000000.0) + 0.5)
    if scaled == 0 then
        return string(whole)
    end
    if scaled >= 1000000 then
        int64 wplus = whole + int64(1)
        return string(wplus)
    end
    string fracS = string(scaled)
    while string.len(fracS) < 6 do
        fracS = "0" + fracS
    end
    while string.len(fracS) > 1 do
        int L = string.len(fracS)
        string last = string.slice(fracS, L - 1, 1)
        if last != "0" then
            break
        end
        fracS = string.slice(fracS, 0, L - 1)
    end
    return string(whole) + "." + fracS
end

func fmtN(float v, int n) as string
    if math.isNaN(v) then
        return "nan"
    end
    if math.isInf(v) then
        if v < 0.0 then
            return "-inf"
        end
        return "inf"
    end
    if v < 0.0 then
        return "-" + fmtN(-v, n)
    end
    if n <= 0 then
        return string(int64(v + 0.5))
    end
    float mul = math.pow(10.0, float(n))
    int64 scaled = int64(v * mul + 0.5)
    int64 whole = scaled / int64(mul)
    int64 frac = scaled - whole * int64(mul)
    string fracS = string(frac)
    while string.len(fracS) < n do
        fracS = "0" + fracS
    end
    return string(whole) + "." + fracS
end

// ============================================================================
// 随机数辅助
// ============================================================================

func randF() as float
    return float(random.u32()) / 4294967296.0
end

func randRange(float lo, float hi) as float
    return lo + (hi - lo) * randF()
end

func randInt(int lo, int hi) as int
    if hi <= lo then
        return lo
    end
    int span = hi - lo + 1
    uint64 r = random.u32()
    return lo + int(r % uint64(span))
end

func randNormal() as float
    float u1 = randF()
    if u1 < MLP_EPS then
        u1 = MLP_EPS
    end
    float u2 = randF()
    float r = math.sqrt(-2.0 * math.log(u1))
    return r * math.cos(2.0 * math.pi * u2)
end

func seedRandom(int seed)
    random.seed(uint64(seed), uint64(1))
end

// ============================================================================
// 测试框架（轻量级断言）
// ============================================================================

int g_pass = 0
int g_fail = 0

func ok(string label)
    g_pass += 1
    println("  [PASS] " + label)
end

func bad(string label, string detail)
    g_fail += 1
    println("  [FAIL] " + label + " :: " + detail)
end

func expectF(float got, float want, float tol, string label)
    if approxEq(got, want, tol) then
        ok(label)
    else
        bad(label, "got " + fmtF(got) + " want " + fmtF(want))
    end
end

func expectI(int got, int want, string label)
    if got == want then
        ok(label)
    else
        bad(label, "got " + string(got) + " want " + string(want))
    end
end

func expectTrue(bool cond, string label)
    if cond then
        ok(label)
    else
        bad(label, "condition false")
    end
end

func summary() as int
    println("")
    println("============================================================")
    println("Test summary:  pass=" + string(g_pass) + "  fail=" + string(g_fail))
    println("============================================================")
    if g_fail == 0 then
        return 0
    end
    return 1
end

// ============================================================================
// Tensor - N 维张量
// ============================================================================
// 存储模型：
//   - data: 一维 array<float>，长度为 numel。
//   - shape: array<int>，每维大小。
//   - strides: 行主序计算。
//   - grad: 反向传播累积梯度。
//   - requiresGrad: 是否需要梯度。
//   - gradFn: autograd 节点（在反向时调用）。
// 持有其他 class 字段的 class 加 `derive value` 注解满足持久化检查。
// ============================================================================

class Tensor
    derive value

    array<float> data = array[]
    array<int> shape = array[]
    array<int> strides = array[]
    int numel = 0
    int ndim = 0
    bool requiresGrad = false
    Tensor grad
    var gradFn = null

    create()
        self.data = array[]
        self.shape = array[]
        self.strides = array[]
        self.numel = 0
        self.ndim = 0
        self.requiresGrad = false
    end

    create(array<int> shp)
        int k = 0
        while k < shp.length do
            self.shape.append(shp[k])
            k += 1
        end
        self.recomputeMeta()
        int j = 0
        while j < self.numel do
            self.data.append(0.0)
            j += 1
        end
    end

    create(int n)
        self.shape.append(n)
        self.recomputeMeta()
        int j = 0
        while j < self.numel do
            self.data.append(0.0)
            j += 1
        end
    end

    create(int rows, int cols)
        self.shape.append(rows)
        self.shape.append(cols)
        self.recomputeMeta()
        int j = 0
        while j < self.numel do
            self.data.append(0.0)
            j += 1
        end
    end

    func recomputeMeta()
        int n = self.shape.length
        self.ndim = n
        int total = 1
        int i = n - 1
        while i >= 0 do
            self.strides.insert(0, total)
            total = total * self.shape[i]
            i -= 1
        end
        self.numel = total
    end
end

// ============================================================================
// 张量构造辅助
// ============================================================================

func tensorFrom(array<float> data, array<int> shape) as Tensor
    Tensor t = Tensor(shape)
    int i = 0
    while i < t.numel do
        if i < data.length then
            t.data[i] = data[i]
        end
        i += 1
    end
    return t
end

func tensor1d(array<float> data) as Tensor
    array<int> shp = array[]
    shp.append(data.length)
    Tensor t = Tensor(shp)
    int i = 0
    while i < data.length do
        t.data[i] = data[i]
        i += 1
    end
    return t
end

func tensor2d(array<float> flat, int rows, int cols) as Tensor
    Tensor t = Tensor(rows, cols)
    int i = 0
    while i < flat.length and i < rows * cols do
        t.data[i] = flat[i]
        i += 1
    end
    return t
end

func scalarTensor(float v) as Tensor
    array<int> shp = array[]
    Tensor t = Tensor(shp)
    t.data.append(v)
    t.numel = 1
    return t
end

func zeros(array<int> shape) as Tensor
    return Tensor(shape)
end

func ones(array<int> shape) as Tensor
    Tensor t = Tensor(shape)
    int i = 0
    while i < t.numel do
        t.data[i] = 1.0
        i += 1
    end
    return t
end

func fullTensor(array<int> shape, float v) as Tensor
    Tensor t = Tensor(shape)
    int i = 0
    while i < t.numel do
        t.data[i] = v
        i += 1
    end
    return t
end

func cloneTensor(Tensor t) as Tensor
    Tensor r = Tensor(t.shape)
    int i = 0
    while i < t.numel do
        r.data[i] = t.data[i]
        i += 1
    end
    r.requiresGrad = t.requiresGrad
    return r
end

func zerosLike(Tensor t) as Tensor
    return Tensor(t.shape)
end

func onesLike(Tensor t) as Tensor
    return ones(t.shape)
end

// ============================================================================
// shape 辅助
// ============================================================================

func shapeEquals(array<int> a, array<int> b) as bool
    if a.length != b.length then
        return false
    end
    int i = 0
    while i < a.length do
        if a[i] != b[i] then
            return false
        end
        i += 1
    end
    return true
end

func shapeProduct(array<int> shp) as int
    int p = 1
    int i = 0
    while i < shp.length do
        p = p * shp[i]
        i += 1
    end
    return p
end

func shapeStr(array<int> shp) as string
    string s = "("
    int i = 0
    while i < shp.length do
        if i > 0 then
            s = s + ", "
        end
        s = s + string(shp[i])
        i += 1
    end
    return s + ")"
end

// 多维显式读取
func tensorAt1(Tensor t, int i) as float
    return t.data[i]
end

func tensorAt2(Tensor t, int i, int j) as float
    return t.data[i * t.shape[1] + j]
end

func tensorAt3(Tensor t, int i, int j, int k) as float
    return t.data[(i * t.shape[1] + j) * t.shape[2] + k]
end

func tensorAt4(Tensor t, int i, int j, int k, int l) as float
    return t.data[((i * t.shape[1] + j) * t.shape[2] + k) * t.shape[3] + l]
end

func tensorSet1(Tensor t, int i, float v)
    t.data[i] = v
end

func tensorSet2(Tensor t, int i, int j, float v)
    t.data[i * t.shape[1] + j] = v
end

func tensorSet3(Tensor t, int i, int j, int k, float v)
    t.data[(i * t.shape[1] + j) * t.shape[2] + k] = v
end

func tensorSet4(Tensor t, int i, int j, int k, int l, float v)
    t.data[((i * t.shape[1] + j) * t.shape[2] + k) * t.shape[3] + l] = v
end

func tensorItem(Tensor t) as float
    if t.numel == 0 then
        return 0.0
    end
    return t.data[0]
end

// ============================================================================
// reshape / transpose / slice
// ============================================================================

func reshape(Tensor t, array<int> newShape) as Tensor
    int newNumel = shapeProduct(newShape)
    if newNumel != t.numel then
        throw "reshape: numel mismatch (" + string(t.numel) + " vs " + string(newNumel) + ")"
    end
    Tensor r = Tensor(newShape)
    int i = 0
    while i < t.numel do
        r.data[i] = t.data[i]
        i += 1
    end
    return r
end

func flatten2d(Tensor t) as Tensor
    if t.ndim <= 1 then
        array<int> shp = array[]
        shp.append(1)
        shp.append(t.numel)
        return reshape(t, shp)
    end
    int batch = t.shape[0]
    int rest = t.numel / batch
    array<int> shp = array[]
    shp.append(batch)
    shp.append(rest)
    return reshape(t, shp)
end

func transpose2d(Tensor t) as Tensor
    if t.ndim != 2 then
        throw "transpose2d requires 2D tensor"
    end
    int rows = t.shape[0]
    int cols = t.shape[1]
    Tensor r = Tensor(cols, rows)
    int i = 0
    while i < rows do
        int j = 0
        while j < cols do
            r.data[j * rows + i] = t.data[i * cols + j]
            j += 1
        end
        i += 1
    end
    return r
end

func transpose(Tensor t) as Tensor
    if t.ndim == 2 then
        return transpose2d(t)
    end
    if t.ndim == 1 then
        return cloneTensor(t)
    end
    if t.ndim == 3 then
        int d0 = t.shape[0]
        int d1 = t.shape[1]
        int d2 = t.shape[2]
        array<int> shp = array[]
        shp.append(d0)
        shp.append(d2)
        shp.append(d1)
        Tensor r = Tensor(shp)
        int i = 0
        while i < d0 do
            int j = 0
            while j < d1 do
                int k = 0
                while k < d2 do
                    r.data[i * d2 * d1 + k * d1 + j] = t.data[i * d1 * d2 + j * d2 + k]
                    k += 1
                end
                j += 1
            end
            i += 1
        end
        return r
    end
    throw "transpose only supports ndim<=3"
end

func slice1d(Tensor t, int start, int endExcl) as Tensor
    if t.ndim != 1 then
        throw "slice1d requires 1D tensor"
    end
    if start < 0 then
        start = 0
    end
    if endExcl > t.shape[0] then
        endExcl = t.shape[0]
    end
    if endExcl <= start then
        array<int> shp = array[]
        shp.append(0)
        return Tensor(shp)
    end
    int n = endExcl - start
    array<int> shp = array[]
    shp.append(n)
    Tensor r = Tensor(shp)
    int i = 0
    while i < n do
        r.data[i] = t.data[start + i]
        i += 1
    end
    return r
end

func sliceRow(Tensor t, int row) as Tensor
    if t.ndim < 1 then
        throw "sliceRow requires ndim>=1"
    end
    if row < 0 or row >= t.shape[0] then
        throw "sliceRow: row out of range"
    end
    array<int> newShape = array[]
    int i = 1
    while i < t.ndim do
        newShape.append(t.shape[i])
        i += 1
    end
    if newShape.length == 0 then
        newShape.append(1)
    end
    int subNumel = shapeProduct(newShape)
    int off = row * subNumel
    Tensor r = Tensor(newShape)
    int j = 0
    while j < subNumel do
        r.data[j] = t.data[off + j]
        j += 1
    end
    return r
end

// ============================================================================
// 广播
// ============================================================================

func broadcastShapes(array<int> a, array<int> b) as array<int>
    int na = a.length
    int nb = b.length
    int n = na
    if nb > n then
        n = nb
    end
    array<int> result = array[]
    int i = n - 1
    while i >= 0 do
        int ai = 1
        if i - (n - na) >= 0 then
            ai = a[i - (n - na)]
        end
        int bi = 1
        if i - (n - nb) >= 0 then
            bi = b[i - (n - nb)]
        end
        int ri = ai
        if bi > ri then
            ri = bi
        end
        if ai != 1 and bi != 1 and ai != bi then
            throw "broadcastShapes: incompatible dims " + string(ai) + " vs " + string(bi)
        end
        result.insert(0, ri)
        i -= 1
    end
    return result
end

func broadcastTo(Tensor src, array<int> targetShape) as Tensor
    if shapeEquals(src.shape, targetShape) then
        return cloneTensor(src)
    end
    array<int> srcShape = src.shape
    int nt = targetShape.length
    int ns = srcShape.length
    if ns > nt then
        throw "broadcastTo: src ndim > target ndim"
    end
    array<int> alignedSrcShape = array[]
    array<int> alignedSrcStrides = array[]
    int pad = nt - ns
    int p = 0
    while p < pad do
        alignedSrcShape.append(1)
        alignedSrcStrides.append(0)
        p += 1
    end
    int q = 0
    while q < ns do
        alignedSrcShape.append(srcShape[q])
        alignedSrcStrides.append(src.strides[q])
        q += 1
    end
    Tensor result = Tensor(targetShape)
    array<int> idx = array[]
    int k = 0
    while k < nt do
        idx.append(0)
        k += 1
    end
    int total = result.numel
    int iter = 0
    while iter < total do
        int srcOff = 0
        int d = 0
        while d < nt do
            int ss = alignedSrcShape[d]
            int sel = idx[d]
            if ss == 1 then
                sel = 0
            else
                if sel >= ss then
                    throw "broadcastTo: dim mismatch"
                end
            end
            srcOff = srcOff + sel * alignedSrcStrides[d]
            d += 1
        end
        result.data[iter] = src.data[srcOff]
        iter += 1
        int c = nt - 1
        while c >= 0 do
            idx[c] += 1
            if idx[c] < targetShape[c] then
                break
            end
            idx[c] = 0
            c -= 1
        end
    end
    return result
end

// ============================================================================
// 逐元素二元运算
// ============================================================================

func elementwiseBinary(Tensor a, Tensor b, string op) as Tensor
    array<int> outShape = broadcastShapes(a.shape, b.shape)
    Tensor ab = broadcastTo(a, outShape)
    Tensor bb = broadcastTo(b, outShape)
    Tensor r = Tensor(outShape)
    int i = 0
    while i < r.numel do
        float x = ab.data[i]
        float y = bb.data[i]
        float z = 0.0
        if op == "+" then
            z = x + y
        elseif op == "-" then
            z = x - y
        elseif op == "*" then
            z = x * y
        elseif op == "/" then
            if absF(y) < MLP_EPS then
                z = 0.0
            else
                z = x / y
            end
        elseif op == "max" then
            if x > y then
                z = x
            else
                z = y
            end
        elseif op == "min" then
            if x < y then
                z = x
            else
                z = y
            end
        else
            throw "unknown elementwise op: " + op
        end
        r.data[i] = z
        i += 1
    end
    return r
end

func tensorAdd(Tensor a, Tensor b) as Tensor
    return elementwiseBinary(a, b, "+")
end

func tensorSub(Tensor a, Tensor b) as Tensor
    return elementwiseBinary(a, b, "-")
end

func tensorMul(Tensor a, Tensor b) as Tensor
    return elementwiseBinary(a, b, "*")
end

func tensorDiv(Tensor a, Tensor b) as Tensor
    return elementwiseBinary(a, b, "/")
end

func tensorAddScalar(Tensor a, float s) as Tensor
    Tensor r = Tensor(a.shape)
    int i = 0
    while i < a.numel do
        r.data[i] = a.data[i] + s
        i += 1
    end
    return r
end

func tensorMulScalar(Tensor a, float s) as Tensor
    Tensor r = Tensor(a.shape)
    int i = 0
    while i < a.numel do
        r.data[i] = a.data[i] * s
        i += 1
    end
    return r
end

func tensorSubScalar(Tensor a, float s) as Tensor
    return tensorAddScalar(a, -s)
end

// ============================================================================
// 逐元素一元运算
// ============================================================================

func applyUnary(Tensor a, string op) as Tensor
    Tensor r = Tensor(a.shape)
    int i = 0
    while i < a.numel do
        float x = a.data[i]
        float z = 0.0
        if op == "relu" then
            z = reluF(x)
        elseif op == "sigmoid" then
            z = sigmoidF(x)
        elseif op == "tanh" then
            z = tanhF(x)
        elseif op == "sin" then
            z = math.sin(x)
        elseif op == "cos" then
            z = math.cos(x)
        elseif op == "exp" then
            z = safeExp(x)
        elseif op == "log" then
            z = safeLog(x)
        elseif op == "sqrt" then
            if x < 0.0 then
                z = 0.0
            else
                z = math.sqrt(x)
            end
        elseif op == "square" then
            z = x * x
        elseif op == "neg" then
            z = -x
        elseif op == "abs" then
            z = absF(x)
        elseif op == "leaky_relu" then
            z = leakyReluF(x, 0.01)
        elseif op == "elu" then
            z = eluF(x, 1.0)
        elseif op == "gelu" then
            z = geluF(x)
        elseif op == "inv" then
            if absF(x) < MLP_EPS then
                z = 0.0
            else
                z = 1.0 / x
            end
        else
            throw "unknown unary op: " + op
        end
        r.data[i] = z
        i += 1
    end
    return r
end

func tensorSigmoid(Tensor a) as Tensor
    return applyUnary(a, "sigmoid")
end

func tensorRelu(Tensor a) as Tensor
    return applyUnary(a, "relu")
end

func tensorTanh(Tensor a) as Tensor
    return applyUnary(a, "tanh")
end

func tensorExp(Tensor a) as Tensor
    return applyUnary(a, "exp")
end

func tensorLog(Tensor a) as Tensor
    return applyUnary(a, "log")
end

func tensorSquare(Tensor a) as Tensor
    return applyUnary(a, "square")
end

func tensorNeg(Tensor a) as Tensor
    return applyUnary(a, "neg")
end

func tensorAbs(Tensor a) as Tensor
    return applyUnary(a, "abs")
end

// 沿最后一维 softmax
func tensorSoftmax(Tensor t) as Tensor
    if t.ndim < 1 then
        return cloneTensor(t)
    end
    int lastDim = t.shape[t.ndim - 1]
    int outer = t.numel / lastDim
    Tensor r = Tensor(t.shape)
    int g = 0
    while g < outer do
        int base = g * lastDim
        float m = t.data[base]
        int k = 1
        while k < lastDim do
            if t.data[base + k] > m then
                m = t.data[base + k]
            end
            k += 1
        end
        float sum = 0.0
        int i = 0
        while i < lastDim do
            float e = safeExp(t.data[base + i] - m)
            r.data[base + i] = e
            sum = sum + e
            i += 1
        end
        if sum < MLP_EPS then
            sum = MLP_EPS
        end
        int j = 0
        while j < lastDim do
            r.data[base + j] = r.data[base + j] / sum
            j += 1
        end
        g += 1
    end
    return r
end

// ============================================================================
// 矩阵乘法
// ============================================================================

func matmul(Tensor a, Tensor b) as Tensor
    if a.ndim == 2 and b.ndim == 2 then
        int m = a.shape[0]
        int k = a.shape[1]
        int k2 = b.shape[0]
        int n = b.shape[1]
        if k != k2 then
            throw "matmul: inner dim mismatch (" + string(k) + " vs " + string(k2) + ")"
        end
        Tensor r = Tensor(m, n)
        int i = 0
        while i < m do
            int j = 0
            while j < n do
                float sum = 0.0
                int p = 0
                while p < k do
                    sum = sum + a.data[i * k + p] * b.data[p * n + j]
                    p += 1
                end
                r.data[i * n + j] = sum
                j += 1
            end
            i += 1
        end
        return r
    end
    if a.ndim == 3 and b.ndim == 3 then
        int B = a.shape[0]
        int m = a.shape[1]
        int k = a.shape[2]
        int k2 = b.shape[1]
        int n = b.shape[2]
        if B != b.shape[0] or k != k2 then
            throw "matmul batched: shape mismatch"
        end
        array<int> shp = array[]
        shp.append(B)
        shp.append(m)
        shp.append(n)
        Tensor r = Tensor(shp)
        int bi = 0
        while bi < B do
            int i = 0
            while i < m do
                int j = 0
                while j < n do
                    float sum = 0.0
                    int p = 0
                    while p < k do
                        float av = a.data[(bi * m + i) * k + p]
                        float bv = b.data[(bi * k + p) * n + j]
                        sum = sum + av * bv
                        p += 1
                    end
                    r.data[(bi * m + i) * n + j] = sum
                    j += 1
                end
                i += 1
            end
            bi += 1
        end
        return r
    end
    throw "matmul only supports 2D or batched 3D tensors"
end

func matvec(Tensor A, Tensor x) as Tensor
    if A.ndim != 2 or x.ndim != 1 then
        throw "matvec requires 2D x 1D"
    end
    int m = A.shape[0]
    int k = A.shape[1]
    if x.shape[0] != k then
        throw "matvec: dim mismatch"
    end
    array<int> shp = array[]
    shp.append(m)
    Tensor r = Tensor(shp)
    int i = 0
    while i < m do
        float sum = 0.0
        int j = 0
        while j < k do
            sum = sum + A.data[i * k + j] * x.data[j]
            j += 1
        end
        r.data[i] = sum
        i += 1
    end
    return r
end

// ============================================================================
// 规约
// ============================================================================

func tensorSum(Tensor t) as float
    float s = 0.0
    int i = 0
    while i < t.numel do
        s = s + t.data[i]
        i += 1
    end
    return s
end

func tensorSumAxis(Tensor t, int axis) as Tensor
    if t.ndim == 1 then
        return scalarTensor(tensorSum(t))
    end
    if t.ndim == 2 then
        if axis == 0 then
            int cols = t.shape[1]
            array<int> shp = array[]
            shp.append(cols)
            Tensor r = Tensor(shp)
            int j = 0
            while j < cols do
                float s = 0.0
                int i = 0
                while i < t.shape[0] do
                    s = s + t.data[i * cols + j]
                    i += 1
                end
                r.data[j] = s
                j += 1
            end
            return r
        end
        if axis == 1 then
            int rows = t.shape[0]
            array<int> shp = array[]
            shp.append(rows)
            Tensor r = Tensor(shp)
            int i = 0
            while i < rows do
                float s = 0.0
                int j = 0
                while j < t.shape[1] do
                    s = s + t.data[i * t.shape[1] + j]
                    j += 1
                end
                r.data[i] = s
                i += 1
            end
            return r
        end
    end
    return scalarTensor(tensorSum(t))
end

func tensorMean(Tensor t) as float
    if t.numel == 0 then
        return 0.0
    end
    return tensorSum(t) / float(t.numel)
end

func tensorMax(Tensor t) as float
    if t.numel == 0 then
        return 0.0
    end
    float m = t.data[0]
    int i = 1
    while i < t.numel do
        if t.data[i] > m then
            m = t.data[i]
        end
        i += 1
    end
    return m
end

func tensorMin(Tensor t) as float
    if t.numel == 0 then
        return 0.0
    end
    float m = t.data[0]
    int i = 1
    while i < t.numel do
        if t.data[i] < m then
            m = t.data[i]
        end
        i += 1
    end
    return m
end

func tensorNorm(Tensor t) as float
    float s = 0.0
    int i = 0
    while i < t.numel do
        float v = t.data[i]
        s = s + v * v
        i += 1
    end
    return math.sqrt(s)
end

func tensorArgmax(Tensor t) as Tensor
    if t.ndim < 1 then
        return scalarTensor(0.0)
    end
    int lastDim = t.shape[t.ndim - 1]
    int outer = t.numel / lastDim
    array<int> shp = array[]
    if t.ndim > 1 then
        int i = 0
        while i < t.ndim - 1 do
            shp.append(t.shape[i])
            i += 1
        end
    else
        shp.append(1)
    end
    Tensor r = Tensor(shp)
    int g = 0
    while g < outer do
        int base = g * lastDim
        float m = t.data[base]
        int mi = 0
        int k = 1
        while k < lastDim do
            if t.data[base + k] > m then
                m = t.data[base + k]
                mi = k
            end
            k += 1
        end
        r.data[g] = float(mi)
        g += 1
    end
    return r
end

// ============================================================================
// 拼接
// ============================================================================

func concatAxis0(array<Tensor> ts) as Tensor
    if ts.length == 0 then
        return Tensor(0)
    end
    if ts[0].ndim == 1 then
        int total = 0
        int i = 0
        while i < ts.length do
            total = total + ts[i].shape[0]
            i += 1
        end
        array<int> shp = array[]
        shp.append(total)
        Tensor r = Tensor(shp)
        int off = 0
        int j = 0
        while j < ts.length do
            int k = 0
            while k < ts[j].shape[0] do
                r.data[off + k] = ts[j].data[k]
                k += 1
            end
            off = off + ts[j].shape[0]
            j += 1
        end
        return r
    end
    int cols = ts[0].shape[1]
    int totalRows = 0
    int i = 0
    while i < ts.length do
        totalRows = totalRows + ts[i].shape[0]
        if ts[i].shape[1] != cols then
            throw "concatAxis0: column mismatch"
        end
        i += 1
    end
    Tensor r = Tensor(totalRows, cols)
    int off = 0
    int j = 0
    while j < ts.length do
        int k = 0
        while k < ts[j].numel do
            r.data[off + k] = ts[j].data[k]
            k += 1
        end
        off = off + ts[j].numel
        j += 1
    end
    return r
end

// ============================================================================
// 初始化器
// ============================================================================

func initZeros(Tensor t)
    int i = 0
    while i < t.numel do
        t.data[i] = 0.0
        i += 1
    end
end

func initOnes(Tensor t)
    int i = 0
    while i < t.numel do
        t.data[i] = 1.0
        i += 1
    end
end

func initUniform(Tensor t, float lo, float hi)
    int i = 0
    while i < t.numel do
        t.data[i] = randRange(lo, hi)
        i += 1
    end
end

func initNormal(Tensor t, float mean, float std)
    int i = 0
    while i < t.numel do
        t.data[i] = mean + std * randNormal()
        i += 1
    end
end

func initXavierUniform(Tensor t, int fanIn, int fanOut)
    float bound = math.sqrt(6.0 / float(fanIn + fanOut))
    initUniform(t, -bound, bound)
end

func initHeNormal(Tensor t, int fanIn)
    float std = math.sqrt(2.0 / float(fanIn))
    initNormal(t, 0.0, std)
end

func initXavierNormal(Tensor t, int fanIn, int fanOut)
    float std = math.sqrt(2.0 / float(fanIn + fanOut))
    initNormal(t, 0.0, std)
end

// 打印 Tensor 摘要（前若干元素）
func tensorPreview(Tensor t, int maxElems) as string
    string s = "Tensor shape=" + shapeStr(t.shape) + " ["
    int n = t.numel
    if n > maxElems then
        n = maxElems
    end
    int i = 0
    while i < n do
        if i > 0 then
            s = s + ", "
        end
        s = s + fmtF(t.data[i])
        i += 1
    end
    if t.numel > maxElems then
        s = s + ", ..."
    end
    return s + "]"
end

// ============================================================================
// 自动微分引擎（Tape）
// ============================================================================
// 用户在 Tensor 上做前向运算时，如果输入 Tensor.requiresGrad=true，
// 则结果 Tensor 也会标记 requiresGrad=true，并把一个 TapeNode 推入 Tape。
// TapeNode 持有：输出 Tensor 引用 + 输入 Tensor 引用列表 +
// 闭包（输入上游梯度 -> 各输入的局部梯度）。
// 反向时调用 lossTensor.backward(seed)，按 Tape 逆序调用每个 TapeNode 的闭包，
// 把梯度累积到 .grad 字段。
// ============================================================================

class TapeNode
    derive value

    array<Tensor> inputs = array[]
    Tensor output
    string opName = "?"
    var localGradFunc = null
end

class Tape
    derive value

    array<TapeNode> nodes = array[]
end

func newTape() as Tape
    Tape t = Tape()
    return t
end

func requiresGrad(Tensor t, bool v)
    t.requiresGrad = v
end

func tapeRecord(Tape tape, array<Tensor> inputs, Tensor output, string opName, var fn)
    if tape == null then
        return
    end
    TapeNode n = TapeNode()
    int i = 0
    while i < inputs.length do
        n.inputs.append(inputs[i])
        i += 1
    end
    n.output = output
    n.opName = opName
    n.localGradFunc = fn
    tape.nodes.append(n)
end

func accumulateGradTensor(Tensor t, Tensor grad)
    if t.grad == null then
        t.grad = Tensor(t.shape)
    end
    int i = 0
    while i < t.grad.numel do
        t.grad.data[i] = t.grad.data[i] + grad.data[i]
        i += 1
    end
end

func tapeBackward(Tape tape, Tensor loss, float seed)
    if loss == null then
        throw "tapeBackward: loss is null"
    end
    loss.grad = Tensor(loss.shape)
    int i = 0
    while i < loss.numel do
        loss.grad.data[i] = seed
        i += 1
    end
    int n = tape.nodes.length
    int k = n - 1
    while k >= 0 do
        TapeNode node = tape.nodes[k]
        if node.output != null and node.output.grad != null and node.localGradFunc != null then
            var fn = node.localGradFunc
            fn()
        end
        k -= 1
    end
end

func tapeReset(Tape tape)
    if tape == null then
        return
    end
    tape.nodes.clear()
end

func tapeSize(Tape tape) as int
    if tape == null then
        return 0
    end
    return tape.nodes.length
end

// ============================================================================
// 可微原语
// ============================================================================

func adAdd(Tape tape, Tensor a, Tensor b) as Tensor
    Tensor r = tensorAdd(a, b)
    if tape != null and (a.requiresGrad or b.requiresGrad) then
        r.requiresGrad = true
        array<Tensor> ins = array[]
        ins.append(a)
        ins.append(b)
        func() as int fn = func() as int
            Tensor up = r.grad
            accumulateGradTensor(a, up)
            accumulateGradTensor(b, up)
            return 0
        end
        tapeRecord(tape, ins, r, "add", fn)
    end
    return r
end

func adSub(Tape tape, Tensor a, Tensor b) as Tensor
    Tensor r = tensorSub(a, b)
    if tape != null and (a.requiresGrad or b.requiresGrad) then
        r.requiresGrad = true
        array<Tensor> ins = array[]
        ins.append(a)
        ins.append(b)
        func() as int fn = func() as int
            Tensor up = r.grad
            accumulateGradTensor(a, up)
            Tensor ng = tensorNeg(up)
            accumulateGradTensor(b, ng)
            return 0
        end
        tapeRecord(tape, ins, r, "sub", fn)
    end
    return r
end

func adMul(Tape tape, Tensor a, Tensor b) as Tensor
    Tensor r = tensorMul(a, b)
    if tape != null and (a.requiresGrad or b.requiresGrad) then
        r.requiresGrad = true
        array<Tensor> ins = array[]
        ins.append(a)
        ins.append(b)
        func() as int fn = func() as int
            Tensor up = r.grad
            Tensor ga = tensorMul(up, b)
            Tensor gb = tensorMul(up, a)
            accumulateGradTensor(a, ga)
            accumulateGradTensor(b, gb)
            return 0
        end
        tapeRecord(tape, ins, r, "mul", fn)
    end
    return r
end

func adMatmul(Tape tape, Tensor a, Tensor b) as Tensor
    Tensor r = matmul(a, b)
    if tape != null and (a.requiresGrad or b.requiresGrad) then
        r.requiresGrad = true
        array<Tensor> ins = array[]
        ins.append(a)
        ins.append(b)
        func() as int fn = func() as int
            Tensor up = r.grad
            Tensor bT = transpose2d(b)
            Tensor ga = matmul(up, bT)
            Tensor aT = transpose2d(a)
            Tensor gb = matmul(aT, up)
            accumulateGradTensor(a, ga)
            accumulateGradTensor(b, gb)
            return 0
        end
        tapeRecord(tape, ins, r, "matmul", fn)
    end
    return r
end

func adMulScalar(Tape tape, Tensor a, float s) as Tensor
    Tensor r = tensorMulScalar(a, s)
    if tape != null and a.requiresGrad then
        r.requiresGrad = true
        array<Tensor> ins = array[]
        ins.append(a)
        func() as int fn = func() as int
            Tensor up = r.grad
            Tensor ga = tensorMulScalar(up, s)
            accumulateGradTensor(a, ga)
            return 0
        end
        tapeRecord(tape, ins, r, "mul_scalar", fn)
    end
    return r
end

func adRelu(Tape tape, Tensor a) as Tensor
    Tensor r = tensorRelu(a)
    if tape != null and a.requiresGrad then
        r.requiresGrad = true
        array<Tensor> ins = array[]
        ins.append(a)
        func() as int fn = func() as int
            Tensor up = r.grad
            Tensor ga = Tensor(a.shape)
            int i = 0
            while i < a.numel do
                if a.data[i] > 0.0 then
                    ga.data[i] = up.data[i]
                else
                    ga.data[i] = 0.0
                end
                i += 1
            end
            accumulateGradTensor(a, ga)
            return 0
        end
        tapeRecord(tape, ins, r, "relu", fn)
    end
    return r
end

func adTanh(Tape tape, Tensor a) as Tensor
    Tensor r = tensorTanh(a)
    if tape != null and a.requiresGrad then
        r.requiresGrad = true
        array<Tensor> ins = array[]
        ins.append(a)
        func() as int fn = func() as int
            Tensor up = r.grad
            Tensor ga = Tensor(a.shape)
            int i = 0
            while i < a.numel do
                float t = r.data[i]
                ga.data[i] = up.data[i] * (1.0 - t * t)
                i += 1
            end
            accumulateGradTensor(a, ga)
            return 0
        end
        tapeRecord(tape, ins, r, "tanh", fn)
    end
    return r
end

func adSigmoid(Tape tape, Tensor a) as Tensor
    Tensor r = tensorSigmoid(a)
    if tape != null and a.requiresGrad then
        r.requiresGrad = true
        array<Tensor> ins = array[]
        ins.append(a)
        func() as int fn = func() as int
            Tensor up = r.grad
            Tensor ga = Tensor(a.shape)
            int i = 0
            while i < a.numel do
                float s = r.data[i]
                ga.data[i] = up.data[i] * s * (1.0 - s)
                i += 1
            end
            accumulateGradTensor(a, ga)
            return 0
        end
        tapeRecord(tape, ins, r, "sigmoid", fn)
    end
    return r
end

func adSquare(Tape tape, Tensor a) as Tensor
    Tensor r = tensorSquare(a)
    if tape != null and a.requiresGrad then
        r.requiresGrad = true
        array<Tensor> ins = array[]
        ins.append(a)
        func() as int fn = func() as int
            Tensor up = r.grad
            Tensor ga = Tensor(a.shape)
            int i = 0
            while i < a.numel do
                ga.data[i] = up.data[i] * 2.0 * a.data[i]
                i += 1
            end
            accumulateGradTensor(a, ga)
            return 0
        end
        tapeRecord(tape, ins, r, "square", fn)
    end
    return r
end

func adSum(Tape tape, Tensor a) as Tensor
    Tensor r = scalarTensor(tensorSum(a))
    if tape != null and a.requiresGrad then
        r.requiresGrad = true
        array<Tensor> ins = array[]
        ins.append(a)
        func() as int fn = func() as int
            Tensor up = r.grad
            float u = up.data[0]
            Tensor ga = Tensor(a.shape)
            int i = 0
            while i < a.numel do
                ga.data[i] = u
                i += 1
            end
            accumulateGradTensor(a, ga)
            return 0
        end
        tapeRecord(tape, ins, r, "sum", fn)
    end
    return r
end

func adMean(Tape tape, Tensor a) as Tensor
    float n = float(a.numel)
    Tensor r = scalarTensor(tensorSum(a) / n)
    if tape != null and a.requiresGrad then
        r.requiresGrad = true
        array<Tensor> ins = array[]
        ins.append(a)
        func() as int fn = func() as int
            Tensor up = r.grad
            float u = up.data[0] / n
            Tensor ga = Tensor(a.shape)
            int i = 0
            while i < a.numel do
                ga.data[i] = u
                i += 1
            end
            accumulateGradTensor(a, ga)
            return 0
        end
        tapeRecord(tape, ins, r, "mean", fn)
    end
    return r
end

func adLeakyRelu(Tape tape, Tensor a, float alpha) as Tensor
    Tensor r = Tensor(a.shape)
    int i = 0
    while i < a.numel do
        r.data[i] = leakyReluF(a.data[i], alpha)
        i += 1
    end
    if tape != null and a.requiresGrad then
        r.requiresGrad = true
        array<Tensor> ins = array[]
        ins.append(a)
        func() as int fn = func() as int
            Tensor up = r.grad
            Tensor ga = Tensor(a.shape)
            int j = 0
            while j < a.numel do
                if a.data[j] > 0.0 then
                    ga.data[j] = up.data[j]
                else
                    ga.data[j] = up.data[j] * alpha
                end
                j += 1
            end
            accumulateGradTensor(a, ga)
            return 0
        end
        tapeRecord(tape, ins, r, "leaky_relu", fn)
    end
    return r
end

func adElu(Tape tape, Tensor a, float alpha) as Tensor
    Tensor r = Tensor(a.shape)
    int i = 0
    while i < a.numel do
        r.data[i] = eluF(a.data[i], alpha)
        i += 1
    end
    if tape != null and a.requiresGrad then
        r.requiresGrad = true
        array<Tensor> ins = array[]
        ins.append(a)
        func() as int fn = func() as int
            Tensor up = r.grad
            Tensor ga = Tensor(a.shape)
            int j = 0
            while j < a.numel do
                if a.data[j] > 0.0 then
                    ga.data[j] = up.data[j]
                else
                    ga.data[j] = up.data[j] * (r.data[j] + alpha)
                end
                j += 1
            end
            accumulateGradTensor(a, ga)
            return 0
        end
        tapeRecord(tape, ins, r, "elu", fn)
    end
    return r
end

func adGelu(Tape tape, Tensor a) as Tensor
    Tensor r = Tensor(a.shape)
    int i = 0
    while i < a.numel do
        r.data[i] = geluF(a.data[i])
        i += 1
    end
    if tape != null and a.requiresGrad then
        r.requiresGrad = true
        array<Tensor> ins = array[]
        ins.append(a)
        func() as int fn = func() as int
            Tensor up = r.grad
            Tensor ga = Tensor(a.shape)
            float c = math.sqrt(2.0 / math.pi)
            int j = 0
            while j < a.numel do
                float x = a.data[j]
                float inner = c * (x + 0.044715 * x * x * x)
                float t = tanhF(inner)
                float dinner = c * (1.0 + 3.0 * 0.044715 * x * x)
                float grad = 0.5 * (1.0 + t) + 0.5 * x * (1.0 - t * t) * dinner
                ga.data[j] = up.data[j] * grad
                j += 1
            end
            accumulateGradTensor(a, ga)
            return 0
        end
        tapeRecord(tape, ins, r, "gelu", fn)
    end
    return r
end

// AD: 数值梯度检查（中心差分）
func numericGradient(Tensor x, func(Tensor) as float lossFn, float eps)
    int i = 0
    while i < x.numel do
        float orig = x.data[i]
        x.data[i] = orig + eps
        float lp = lossFn(x)
        x.data[i] = orig - eps
        float lm = lossFn(x)
        x.data[i] = orig
        float grad = (lp - lm) / (2.0 * eps)
        if x.grad == null then
            x.grad = Tensor(x.shape)
        end
        x.grad.data[i] = x.grad.data[i] + grad
        i += 1
    end
end

// ============================================================================
// 层（Layer）基类与具体实现
// ============================================================================
// 所有层继承自 Layer，统一接口：
//   forward(Tensor x) -> Tensor     前向（同时缓存中间值给 backward）
//   backward(Tensor gradOutput) -> Tensor   返回 gradInput
//   params() -> array<Tensor>        返回可训练参数列表
//   paramGrads() -> array<Tensor>    返回对应梯度列表
// 多态存储：Sequential.layers 使用 array<var>，调用时用 `as Layer` 还原。
// ============================================================================

class Layer
    derive value

    string name = "Layer"
    bool training = true

    virtual func forward(Tensor x) as Tensor
        return x
    end

    virtual func backward(Tensor gradOutput) as Tensor
        return gradOutput
    end

    virtual func params() as array<Tensor>
        array<Tensor> p = array[]
        return p
    end

    virtual func paramGrads() as array<Tensor>
        array<Tensor> p = array[]
        return p
    end

    virtual func resetState()
    end

    func setTraining(bool mode)
        self.training = mode
    end
end

// ----------------------------------------------------------------------------
// Dense - 全连接层
// ----------------------------------------------------------------------------

class Dense extends Layer
    int inFeatures = 0
    int outFeatures = 0
    Tensor W = Tensor(1, 1)
    Tensor b = Tensor(1)
    Tensor gradW = Tensor(1, 1)
    Tensor gradB = Tensor(1)
    Tensor cachedX = Tensor(1)
    bool useBias = true
    string initType = "he"

    create()
        self.name = "Dense"
    end

    func init(int inF, int outF)
        self.name = "Dense"
        self.inFeatures = inF
        self.outFeatures = outF
        Tensor wT = Tensor(inF, outF)
        self.W = wT
        Tensor bT = Tensor(outF)
        self.b = bT
        Tensor gwT = Tensor(inF, outF)
        self.gradW = gwT
        Tensor gbT = Tensor(outF)
        self.gradB = gbT
        self.initHeNormal()
    end

    func init(int inF, int outF, bool useBias)
        self.name = "Dense"
        self.inFeatures = inF
        self.outFeatures = outF
        self.useBias = useBias
        self.W = Tensor(inF, outF)
        self.b = Tensor(outF)
        self.gradW = Tensor(inF, outF)
        self.gradB = Tensor(outF)
        self.initHeNormal()
    end

    func init(int inF, int outF, bool useBias, string initT)
        self.name = "Dense"
        self.inFeatures = inF
        self.outFeatures = outF
        self.useBias = useBias
        self.initType = initT
        self.W = Tensor(inF, outF)
        self.b = Tensor(outF)
        self.gradW = Tensor(inF, outF)
        self.gradB = Tensor(outF)
        if initT == "xavier" then
            self.initXavier()
        elseif initT == "uniform" then
            initUniform(self.W, -0.1, 0.1)
            initUniform(self.b, -0.1, 0.1)
        elseif initT == "zeros" then
            initZeros(self.W)
            initZeros(self.b)
        else
            self.initHeNormal()
        end
    end

    func initHeNormal()
        initHeNormal(self.W, self.inFeatures)
        initZeros(self.b)
    end

    func initXavier()
        initXavierUniform(self.W, self.inFeatures, self.outFeatures)
        initZeros(self.b)
    end

    override func forward(Tensor x) as Tensor
        bool was1d = false
        Tensor x2d = x
        if x.ndim == 1 then
            was1d = true
            array<int> shp = array[]
            shp.append(1)
            shp.append(x.shape[0])
            x2d = reshape(x, shp)
        end
        Tensor y = matmul(x2d, self.W)
        if self.useBias then
            int batch = y.shape[0]
            int i = 0
            while i < batch do
                int j = 0
                while j < self.outFeatures do
                    y.data[i * self.outFeatures + j] = y.data[i * self.outFeatures + j] + self.b.data[j]
                    j += 1
                end
                i += 1
            end
        end
        self.cachedX = x2d
        if was1d then
            array<int> shp = array[]
            shp.append(self.outFeatures)
            return reshape(y, shp)
        end
        return y
    end

    override func backward(Tensor gradOutput) as Tensor
        Tensor x2d = self.cachedX
        bool was1d = false
        if self.cachedX.ndim == 1 then
            was1d = true
            array<int> shp = array[]
            shp.append(1)
            shp.append(self.cachedX.shape[0])
            x2d = reshape(self.cachedX, shp)
        end
        Tensor g2d = gradOutput
        if gradOutput.ndim == 1 then
            array<int> shp = array[]
            shp.append(1)
            shp.append(gradOutput.shape[0])
            g2d = reshape(gradOutput, shp)
        end
        int batch = x2d.shape[0]
        Tensor x2dT = transpose2d(x2d)
        Tensor newGradW = matmul(x2dT, g2d)
        Tensor newGradB = Tensor(self.outFeatures)
        int j = 0
        while j < self.outFeatures do
            float s = 0.0
            int i = 0
            while i < batch do
                s = s + g2d.data[i * self.outFeatures + j]
                i += 1
            end
            newGradB.data[j] = s
            j += 1
        end
        int k = 0
        while k < self.gradW.numel do
            self.gradW.data[k] = self.gradW.data[k] + newGradW.data[k]
            k += 1
        end
        int m = 0
        while m < self.gradB.numel do
            self.gradB.data[m] = self.gradB.data[m] + newGradB.data[m]
            m += 1
        end
        Tensor wT = transpose2d(self.W)
        Tensor gradInput = matmul(g2d, wT)
        if was1d then
            array<int> shp = array[]
            shp.append(self.inFeatures)
            return reshape(gradInput, shp)
        end
        return gradInput
    end

    override func params() as array<Tensor>
        array<Tensor> p = array[]
        p.append(self.W)
        if self.useBias then
            p.append(self.b)
        end
        return p
    end

    override func paramGrads() as array<Tensor>
        array<Tensor> p = array[]
        p.append(self.gradW)
        if self.useBias then
            p.append(self.gradB)
        end
        return p
    end

    override func resetState()
        int i = 0
        while i < self.gradW.numel do
            self.gradW.data[i] = 0.0
            i += 1
        end
        int j = 0
        while j < self.gradB.numel do
            self.gradB.data[j] = 0.0
            j += 1
        end
        self.cachedX = null
    end
end

// ----------------------------------------------------------------------------
// 激活层
// ----------------------------------------------------------------------------

class ReLU extends Layer
    derive value

    Tensor cachedMask

    create()
        self.name = "ReLU"
    end

    override func forward(Tensor x) as Tensor
        Tensor r = Tensor(x.shape)
        Tensor mask = Tensor(x.shape)
        int i = 0
        while i < x.numel do
            if x.data[i] > 0.0 then
                r.data[i] = x.data[i]
                mask.data[i] = 1.0
            else
                r.data[i] = 0.0
                mask.data[i] = 0.0
            end
            i += 1
        end
        self.cachedMask = mask
        return r
    end

    override func backward(Tensor gradOutput) as Tensor
        Tensor r = Tensor(gradOutput.shape)
        int i = 0
        while i < gradOutput.numel do
            r.data[i] = gradOutput.data[i] * self.cachedMask.data[i]
            i += 1
        end
        return r
    end
end

class LeakyReLU extends Layer
    derive value

    float alpha = 0.01
    Tensor cachedX

    create()
        self.name = "LeakyReLU"
        self.alpha = 0.01
    end

    create(float a)
        self.name = "LeakyReLU"
        self.alpha = a
    end

    override func forward(Tensor x) as Tensor
        self.cachedX = x
        Tensor r = Tensor(x.shape)
        int i = 0
        while i < x.numel do
            r.data[i] = leakyReluF(x.data[i], self.alpha)
            i += 1
        end
        return r
    end

    override func backward(Tensor gradOutput) as Tensor
        Tensor r = Tensor(gradOutput.shape)
        int i = 0
        while i < gradOutput.numel do
            if self.cachedX.data[i] > 0.0 then
                r.data[i] = gradOutput.data[i]
            else
                r.data[i] = gradOutput.data[i] * self.alpha
            end
            i += 1
        end
        return r
    end
end

class Sigmoid extends Layer
    derive value

    Tensor cachedY

    create()
        self.name = "Sigmoid"
    end

    override func forward(Tensor x) as Tensor
        Tensor r = tensorSigmoid(x)
        self.cachedY = r
        return r
    end

    override func backward(Tensor gradOutput) as Tensor
        Tensor r = Tensor(gradOutput.shape)
        int i = 0
        while i < gradOutput.numel do
            float s = self.cachedY.data[i]
            r.data[i] = gradOutput.data[i] * s * (1.0 - s)
            i += 1
        end
        return r
    end
end

class Tanh extends Layer
    derive value

    Tensor cachedY

    create()
        self.name = "Tanh"
    end

    override func forward(Tensor x) as Tensor
        Tensor r = tensorTanh(x)
        self.cachedY = r
        return r
    end

    override func backward(Tensor gradOutput) as Tensor
        Tensor r = Tensor(gradOutput.shape)
        int i = 0
        while i < gradOutput.numel do
            float t = self.cachedY.data[i]
            r.data[i] = gradOutput.data[i] * (1.0 - t * t)
            i += 1
        end
        return r
    end
end

class Softmax extends Layer
    derive value

    Tensor cachedY

    create()
        self.name = "Softmax"
    end

    override func forward(Tensor x) as Tensor
        Tensor r = tensorSoftmax(x)
        self.cachedY = r
        return r
    end

    override func backward(Tensor gradOutput) as Tensor
        Tensor r = Tensor(gradOutput.shape)
        int lastDim = self.cachedY.shape[self.cachedY.ndim - 1]
        int outer = self.cachedY.numel / lastDim
        int g = 0
        while g < outer do
            int base = g * lastDim
            float s = 0.0
            int i = 0
            while i < lastDim do
                s = s + gradOutput.data[base + i] * self.cachedY.data[base + i]
                i += 1
            end
            int j = 0
            while j < lastDim do
                r.data[base + j] = self.cachedY.data[base + j] * (gradOutput.data[base + j] - s)
                j += 1
            end
            g += 1
        end
        return r
    end
end

class ELU extends Layer
    derive value

    float alpha = 1.0
    Tensor cachedX
    Tensor cachedY

    create()
        self.name = "ELU"
        self.alpha = 1.0
    end

    create(float a)
        self.name = "ELU"
        self.alpha = a
    end

    override func forward(Tensor x) as Tensor
        self.cachedX = x
        Tensor r = Tensor(x.shape)
        int i = 0
        while i < x.numel do
            r.data[i] = eluF(x.data[i], self.alpha)
            i += 1
        end
        self.cachedY = r
        return r
    end

    override func backward(Tensor gradOutput) as Tensor
        Tensor r = Tensor(gradOutput.shape)
        int i = 0
        while i < gradOutput.numel do
            if self.cachedX.data[i] > 0.0 then
                r.data[i] = gradOutput.data[i]
            else
                r.data[i] = gradOutput.data[i] * (self.cachedY.data[i] + self.alpha)
            end
            i += 1
        end
        return r
    end
end

class GELU extends Layer
    derive value

    Tensor cachedX

    create()
        self.name = "GELU"
    end

    override func forward(Tensor x) as Tensor
        self.cachedX = x
        Tensor r = Tensor(x.shape)
        int i = 0
        while i < x.numel do
            r.data[i] = geluF(x.data[i])
            i += 1
        end
        return r
    end

    override func backward(Tensor gradOutput) as Tensor
        Tensor r = Tensor(gradOutput.shape)
        float c = math.sqrt(2.0 / math.pi)
        int i = 0
        while i < gradOutput.numel do
            float x = self.cachedX.data[i]
            float inner = c * (x + 0.044715 * x * x * x)
            float t = tanhF(inner)
            float dinner = c * (1.0 + 3.0 * 0.044715 * x * x)
            float grad = 0.5 * (1.0 + t) + 0.5 * x * (1.0 - t * t) * dinner
            r.data[i] = gradOutput.data[i] * grad
            i += 1
        end
        return r
    end
end

// ----------------------------------------------------------------------------
// Flatten
// ----------------------------------------------------------------------------

class Flatten extends Layer
    derive value

    array<int> cachedShape = array[]

    create()
        self.name = "Flatten"
    end

    override func forward(Tensor x) as Tensor
        self.cachedShape = array[]
        int i = 0
        while i < x.ndim do
            self.cachedShape.append(x.shape[i])
            i += 1
        end
        return flatten2d(x)
    end

    override func backward(Tensor gradOutput) as Tensor
        return reshape(gradOutput, self.cachedShape)
    end
end

// ----------------------------------------------------------------------------
// Dropout
// ----------------------------------------------------------------------------

class Dropout extends Layer
    derive value

    float rate = 0.5
    Tensor cachedMask

    create()
        self.name = "Dropout"
        self.rate = 0.5
    end

    create(float r)
        self.name = "Dropout"
        if r < 0.0 then
            r = 0.0
        end
        if r > 0.99 then
            r = 0.99
        end
        self.rate = r
    end

    override func forward(Tensor x) as Tensor
        if not self.training or self.rate <= 0.0 then
            return x
        end
        Tensor r = Tensor(x.shape)
        Tensor mask = Tensor(x.shape)
        float keep = 1.0 - self.rate
        if keep < MLP_EPS then
            keep = MLP_EPS
        end
        float scale = 1.0 / keep
        int i = 0
        while i < x.numel do
            if randF() < keep then
                r.data[i] = x.data[i] * scale
                mask.data[i] = scale
            else
                r.data[i] = 0.0
                mask.data[i] = 0.0
            end
            i += 1
        end
        self.cachedMask = mask
        return r
    end

    override func backward(Tensor gradOutput) as Tensor
        if self.cachedMask == null then
            return gradOutput
        end
        Tensor r = Tensor(gradOutput.shape)
        int i = 0
        while i < gradOutput.numel do
            r.data[i] = gradOutput.data[i] * self.cachedMask.data[i]
            i += 1
        end
        return r
    end
end

// ----------------------------------------------------------------------------
// BatchNorm
// ----------------------------------------------------------------------------

class BatchNorm extends Layer
    derive value

    int numFeatures = 0
    float momentum = 0.9
    float eps = 1e-5
    Tensor gamma
    Tensor beta
    Tensor gradGamma
    Tensor gradBeta
    Tensor runningMean
    Tensor runningVar
    Tensor cachedXHat
    Tensor cachedMean
    Tensor cachedVar
    Tensor cachedX

    create()
        self.name = "BatchNorm"
    end

    func init(int nf)
        self.name = "BatchNorm"
        self.numFeatures = nf
        self.gamma = Tensor(nf)
        self.beta = Tensor(nf)
        self.gradGamma = Tensor(nf)
        self.gradBeta = Tensor(nf)
        self.runningMean = Tensor(nf)
        self.runningVar = Tensor(nf)
        initOnes(self.gamma)
        initZeros(self.beta)
        initZeros(self.runningMean)
        int k = 0
        while k < nf do
            self.runningVar.data[k] = 1.0
            k += 1
        end
    end

    func init(int nf, float mom)
        self.name = "BatchNorm"
        self.numFeatures = nf
        self.momentum = mom
        self.eps = 1e-5
        self.gamma = Tensor(nf)
        self.beta = Tensor(nf)
        self.gradGamma = Tensor(nf)
        self.gradBeta = Tensor(nf)
        self.runningMean = Tensor(nf)
        self.runningVar = Tensor(nf)
        initOnes(self.gamma)
        initZeros(self.beta)
        initZeros(self.runningMean)
        int k = 0
        while k < nf do
            self.runningVar.data[k] = 1.0
            k += 1
        end
    end

    override func forward(Tensor x) as Tensor
        self.cachedX = x
        int batch = x.shape[0]
        int nf = self.numFeatures
        Tensor mean = Tensor(nf)
        int j = 0
        while j < nf do
            float s = 0.0
            int i = 0
            while i < batch do
                s = s + x.data[i * nf + j]
                i += 1
            end
            mean.data[j] = s / float(batch)
            j += 1
        end
        Tensor variance = Tensor(nf)
        int j2 = 0
        while j2 < nf do
            float s = 0.0
            float m = mean.data[j2]
            int i = 0
            while i < batch do
                float d = x.data[i * nf + j2] - m
                s = s + d * d
                i += 1
            end
            variance.data[j2] = s / float(batch)
            j2 += 1
        end
        Tensor xhat = Tensor(x.shape)
        int i = 0
        while i < batch do
            int jj = 0
            while jj < nf do
                float denom = math.sqrt(variance.data[jj] + self.eps)
                xhat.data[i * nf + jj] = (x.data[i * nf + jj] - mean.data[jj]) / denom
                jj += 1
            end
            i += 1
        end
        Tensor y = Tensor(x.shape)
        int i2 = 0
        while i2 < batch do
            int jj2 = 0
            while jj2 < nf do
                y.data[i2 * nf + jj2] = xhat.data[i2 * nf + jj2] * self.gamma.data[jj2] + self.beta.data[jj2]
                jj2 += 1
            end
            i2 += 1
        end
        self.cachedXHat = xhat
        self.cachedMean = mean
        self.cachedVar = variance
        if self.training then
            int kk = 0
            while kk < nf do
                self.runningMean.data[kk] = self.momentum * self.runningMean.data[kk] + (1.0 - self.momentum) * mean.data[kk]
                self.runningVar.data[kk] = self.momentum * self.runningVar.data[kk] + (1.0 - self.momentum) * variance.data[kk]
                kk += 1
            end
        end
        return y
    end

    override func backward(Tensor gradOutput) as Tensor
        int batch = gradOutput.shape[0]
        int nf = self.numFeatures
        Tensor newGradGamma = Tensor(nf)
        Tensor newGradBeta = Tensor(nf)
        int j = 0
        while j < nf do
            float sg = 0.0
            float sb = 0.0
            int i = 0
            while i < batch do
                sg = sg + gradOutput.data[i * nf + j] * self.cachedXHat.data[i * nf + j]
                sb = sb + gradOutput.data[i * nf + j]
                i += 1
            end
            newGradGamma.data[j] = sg
            newGradBeta.data[j] = sb
            j += 1
        end
        int kk = 0
        while kk < nf do
            self.gradGamma.data[kk] = self.gradGamma.data[kk] + newGradGamma.data[kk]
            self.gradBeta.data[kk] = self.gradBeta.data[kk] + newGradBeta.data[kk]
            kk += 1
        end
        Tensor gradInput = Tensor(gradOutput.shape)
        float invBatch = 1.0 / float(batch)
        int jj = 0
        while jj < nf do
            float stdInv = 1.0 / math.sqrt(self.cachedVar.data[jj] + self.eps)
            float g = self.gamma.data[jj]
            float sumDxhat = 0.0
            float sumDxhatXhat = 0.0
            int i = 0
            while i < batch do
                float dxhat = gradOutput.data[i * nf + jj] * g
                sumDxhat = sumDxhat + dxhat
                sumDxhatXhat = sumDxhatXhat + dxhat * self.cachedXHat.data[i * nf + jj]
                i += 1
            end
            int i2 = 0
            while i2 < batch do
                float dxhat = gradOutput.data[i2 * nf + jj] * g
                gradInput.data[i2 * nf + jj] = stdInv * invBatch * (float(batch) * dxhat - sumDxhat - self.cachedXHat.data[i2 * nf + jj] * sumDxhatXhat)
                i2 += 1
            end
            jj += 1
        end
        return gradInput
    end

    override func params() as array<Tensor>
        array<Tensor> p = array[]
        p.append(self.gamma)
        p.append(self.beta)
        return p
    end

    override func paramGrads() as array<Tensor>
        array<Tensor> p = array[]
        p.append(self.gradGamma)
        p.append(self.gradBeta)
        return p
    end

    override func resetState()
        int i = 0
        while i < self.gradGamma.numel do
            self.gradGamma.data[i] = 0.0
            i += 1
        end
        int j = 0
        while j < self.gradBeta.numel do
            self.gradBeta.data[j] = 0.0
            j += 1
        end
        self.cachedXHat = null
        self.cachedMean = null
        self.cachedVar = null
        self.cachedX = null
    end
end

// ----------------------------------------------------------------------------
// Conv2D - 2D 卷积（im2col 实现）
// ----------------------------------------------------------------------------

class Conv2D extends Layer
    derive value

    int inChannels = 0
    int outChannels = 0
    int kernelSize = 3
    int stride = 1
    int pad = 0
    Tensor W
    Tensor b
    Tensor gradW
    Tensor gradB
    Tensor cachedX
    Tensor cachedCol
    int cachedOutH = 0
    int cachedOutW = 0

    create()
        self.name = "Conv2D"
    end

    func init(int inCh, int outCh, int ks)
        self.name = "Conv2D"
        self.inChannels = inCh
        self.outChannels = outCh
        self.kernelSize = ks
        self.stride = 1
        self.pad = 0
        array<int> ws = array[]
        ws.append(outCh)
        ws.append(inCh)
        ws.append(ks)
        ws.append(ks)
        self.W = Tensor(ws)
        self.b = Tensor(outCh)
        self.gradW = Tensor(ws)
        self.gradB = Tensor(outCh)
        int fanIn = inCh * ks * ks
        initHeNormal(self.W, fanIn)
        initZeros(self.b)
    end

    func init(int inCh, int outCh, int ks, int st, int pp)
        self.name = "Conv2D"
        self.inChannels = inCh
        self.outChannels = outCh
        self.kernelSize = ks
        self.stride = st
        self.pad = pp
        array<int> ws = array[]
        ws.append(outCh)
        ws.append(inCh)
        ws.append(ks)
        ws.append(ks)
        self.W = Tensor(ws)
        self.b = Tensor(outCh)
        self.gradW = Tensor(ws)
        self.gradB = Tensor(outCh)
        int fanIn = inCh * ks * ks
        initHeNormal(self.W, fanIn)
        initZeros(self.b)
    end

    override func forward(Tensor x) as Tensor
        self.cachedX = x
        int batch = x.shape[0]
        int inCh = x.shape[1]
        int H = x.shape[2]
        int Wd = x.shape[3]
        int ks = self.kernelSize
        int outH = (H + 2 * self.pad - ks) / self.stride + 1
        int outW = (Wd + 2 * self.pad - ks) / self.stride + 1
        self.cachedOutH = outH
        self.cachedOutW = outW
        int colRows = batch * outH * outW
        int colCols = inCh * ks * ks
        array<int> colShp = array[]
        colShp.append(colRows)
        colShp.append(colCols)
        Tensor col = Tensor(colShp)
        int r = 0
        int bi = 0
        while bi < batch do
            int oh = 0
            while oh < outH do
                int ow = 0
                while ow < outW do
                    int c = 0
                    int ic = 0
                    while ic < inCh do
                        int ky = 0
                        while ky < ks do
                            int kx = 0
                            while kx < ks do
                                int ih = oh * self.stride + ky - self.pad
                                int iw = ow * self.stride + kx - self.pad
                                float v = 0.0
                                if ih >= 0 and ih < H and iw >= 0 and iw < Wd then
                                    v = x.data[((bi * inCh + ic) * H + ih) * Wd + iw]
                                end
                                col.data[r * colCols + c] = v
                                c += 1
                                kx += 1
                            end
                            ky += 1
                        end
                        ic += 1
                    end
                    r += 1
                    ow += 1
                end
                oh += 1
            end
            bi += 1
        end
        self.cachedCol = col
        Tensor wReshape = Tensor(colCols, self.outChannels)
        int idx = 0
        int oc = 0
        while oc < self.outChannels do
            int ic2 = 0
            while ic2 < inCh do
                int ky2 = 0
                while ky2 < ks do
                    int kx2 = 0
                    while kx2 < ks do
                        int row = ic2 * ks * ks + ky2 * ks + kx2
                        wReshape.data[row * self.outChannels + oc] = self.W.data[idx]
                        idx += 1
                        kx2 += 1
                    end
                    ky2 += 1
                end
                ic2 += 1
            end
            oc += 1
        end
        Tensor y = matmul(col, wReshape)
        int i = 0
        while i < colRows do
            int j = 0
            while j < self.outChannels do
                y.data[i * self.outChannels + j] = y.data[i * self.outChannels + j] + self.b.data[j]
                j += 1
            end
            i += 1
        end
        array<int> outShape = array[]
        outShape.append(batch)
        outShape.append(self.outChannels)
        outShape.append(outH)
        outShape.append(outW)
        Tensor outT = Tensor(outShape)
        int i2 = 0
        while i2 < batch do
            int oh2 = 0
            while oh2 < outH do
                int ow2 = 0
                while ow2 < outW do
                    int oc2 = 0
                    while oc2 < self.outChannels do
                        int rowIdx = (i2 * outH + oh2) * outW + ow2
                        float v = y.data[rowIdx * self.outChannels + oc2]
                        outT.data[((i2 * self.outChannels + oc2) * outH + oh2) * outW + ow2] = v
                        oc2 += 1
                    end
                    ow2 += 1
                end
                oh2 += 1
            end
            i2 += 1
        end
        return outT
    end

    override func backward(Tensor gradOutput) as Tensor
        Tensor x = self.cachedX
        int batch = x.shape[0]
        int inCh = x.shape[1]
        int H = x.shape[2]
        int Wd = x.shape[3]
        int ks = self.kernelSize
        int outH = self.cachedOutH
        int outW = self.cachedOutW
        int colRows = batch * outH * outW
        int colCols = inCh * ks * ks
        Tensor g2d = Tensor(colRows, self.outChannels)
        int bi = 0
        while bi < batch do
            int oh = 0
            while oh < outH do
                int ow = 0
                while ow < outW do
                    int oc = 0
                    while oc < self.outChannels do
                        int rowIdx = (bi * outH + oh) * outW + ow
                        float v = gradOutput.data[((bi * self.outChannels + oc) * outH + oh) * outW + ow]
                        g2d.data[rowIdx * self.outChannels + oc] = v
                        oc += 1
                    end
                    ow += 1
                end
                oh += 1
            end
            bi += 1
        end
        Tensor newGradB = Tensor(self.outChannels)
        int i = 0
        while i < colRows do
            int j = 0
            while j < self.outChannels do
                newGradB.data[j] = newGradB.data[j] + g2d.data[i * self.outChannels + j]
                j += 1
            end
            i += 1
        end
        Tensor colT = transpose2d(self.cachedCol)
        Tensor gradWReshape = matmul(colT, g2d)
        int idx = 0
        int oc = 0
        while oc < self.outChannels do
            int ic = 0
            while ic < inCh do
                int ky = 0
                while ky < ks do
                    int kx = 0
                    while kx < ks do
                        int row = ic * ks * ks + ky * ks + kx
                        float g = gradWReshape.data[row * self.outChannels + oc]
                        self.gradW.data[idx] = self.gradW.data[idx] + g
                        idx += 1
                        kx += 1
                    end
                    ky += 1
                end
                ic += 1
            end
            oc += 1
        end
        int kb = 0
        while kb < self.outChannels do
            self.gradB.data[kb] = self.gradB.data[kb] + newGradB.data[kb]
            kb += 1
        end
        Tensor wReshape = Tensor(colCols, self.outChannels)
        int idx2 = 0
        int oc2 = 0
        while oc2 < self.outChannels do
            int ic2 = 0
            while ic2 < inCh do
                int ky2 = 0
                while ky2 < ks do
                    int kx2 = 0
                    while kx2 < ks do
                        int row = ic2 * ks * ks + ky2 * ks + kx2
                        wReshape.data[row * self.outChannels + oc2] = self.W.data[idx2]
                        idx2 += 1
                        kx2 += 1
                    end
                    ky2 += 1
                end
                ic2 += 1
            end
            oc2 += 1
        end
        Tensor wRT = transpose2d(wReshape)
        Tensor gradCol = matmul(g2d, wRT)
        Tensor gradInput = Tensor(x.shape)
        int rr = 0
        int bi3 = 0
        while bi3 < batch do
            int oh = 0
            while oh < outH do
                int ow = 0
                while ow < outW do
                    int c = 0
                    int ic = 0
                    while ic < inCh do
                        int ky = 0
                        while ky < ks do
                            int kx = 0
                            while kx < ks do
                                int ih = oh * self.stride + ky - self.pad
                                int iw = ow * self.stride + kx - self.pad
                                if ih >= 0 and ih < H and iw >= 0 and iw < Wd then
                                    int pos = ((bi3 * inCh + ic) * H + ih) * Wd + iw
                                    gradInput.data[pos] = gradInput.data[pos] + gradCol.data[rr * colCols + c]
                                end
                                c += 1
                                kx += 1
                            end
                            ky += 1
                        end
                        ic += 1
                    end
                    rr += 1
                    ow += 1
                end
                oh += 1
            end
            bi3 += 1
        end
        return gradInput
    end

    override func params() as array<Tensor>
        array<Tensor> p = array[]
        p.append(self.W)
        p.append(self.b)
        return p
    end

    override func paramGrads() as array<Tensor>
        array<Tensor> p = array[]
        p.append(self.gradW)
        p.append(self.gradB)
        return p
    end

    override func resetState()
        int i = 0
        while i < self.gradW.numel do
            self.gradW.data[i] = 0.0
            i += 1
        end
        int j = 0
        while j < self.gradB.numel do
            self.gradB.data[j] = 0.0
            j += 1
        end
        self.cachedX = null
        self.cachedCol = null
    end
end

// ----------------------------------------------------------------------------
// MaxPool2D
// ----------------------------------------------------------------------------

class MaxPool2d extends Layer
    derive value

    int kernelSize = 2
    int stride = 2
    Tensor cachedX
    Tensor cachedArgmax

    create()
        self.name = "MaxPool2d"
        self.kernelSize = 2
        self.stride = 2
    end

    create(int ks)
        self.name = "MaxPool2d"
        self.kernelSize = ks
        self.stride = ks
    end

    create(int ks, int st)
        self.name = "MaxPool2d"
        self.kernelSize = ks
        self.stride = st
    end

    override func forward(Tensor x) as Tensor
        self.cachedX = x
        int batch = x.shape[0]
        int ch = x.shape[1]
        int H = x.shape[2]
        int Wd = x.shape[3]
        int ks = self.kernelSize
        int outH = (H - ks) / self.stride + 1
        int outW = (Wd - ks) / self.stride + 1
        array<int> outShape = array[]
        outShape.append(batch)
        outShape.append(ch)
        outShape.append(outH)
        outShape.append(outW)
        Tensor outT = Tensor(outShape)
        Tensor argmax = Tensor(outShape)
        int bi = 0
        while bi < batch do
            int c = 0
            while c < ch do
                int oh = 0
                while oh < outH do
                    int ow = 0
                    while ow < outW do
                        float m = MLP_NEG_INF
                        int mi = 0
                        int ky = 0
                        while ky < ks do
                            int kx = 0
                            while kx < ks do
                                int ih = oh * self.stride + ky
                                int iw = ow * self.stride + kx
                                float v = x.data[((bi * ch + c) * H + ih) * Wd + iw]
                                if v > m then
                                    m = v
                                    mi = ky * ks + kx
                                end
                                kx += 1
                            end
                            ky += 1
                        end
                        outT.data[((bi * ch + c) * outH + oh) * outW + ow] = m
                        argmax.data[((bi * ch + c) * outH + oh) * outW + ow] = float(mi)
                        ow += 1
                    end
                    oh += 1
                end
                c += 1
            end
            bi += 1
        end
        self.cachedArgmax = argmax
        return outT
    end

    override func backward(Tensor gradOutput) as Tensor
        Tensor x = self.cachedX
        int batch = x.shape[0]
        int ch = x.shape[1]
        int H = x.shape[2]
        int Wd = x.shape[3]
        int ks = self.kernelSize
        int outH = gradOutput.shape[2]
        int outW = gradOutput.shape[3]
        Tensor gradInput = Tensor(x.shape)
        int bi = 0
        while bi < batch do
            int c = 0
            while c < ch do
                int oh = 0
                while oh < outH do
                    int ow = 0
                    while ow < outW do
                        float g = gradOutput.data[((bi * ch + c) * outH + oh) * outW + ow]
                        int mi = int(self.cachedArgmax.data[((bi * ch + c) * outH + oh) * outW + ow])
                        int ky = mi / ks
                        int kx = mi - ky * ks
                        int ih = oh * self.stride + ky
                        int iw = ow * self.stride + kx
                        int pos = ((bi * ch + c) * H + ih) * Wd + iw
                        gradInput.data[pos] = gradInput.data[pos] + g
                        ow += 1
                    end
                    oh += 1
                end
                c += 1
            end
            bi += 1
        end
        return gradInput
    end
end

// ----------------------------------------------------------------------------
// AvgPool2D
// ----------------------------------------------------------------------------

class AvgPool2d extends Layer
    derive value

    int kernelSize = 2
    int stride = 2
    Tensor cachedX

    create()
        self.name = "AvgPool2d"
        self.kernelSize = 2
        self.stride = 2
    end

    create(int ks)
        self.name = "AvgPool2d"
        self.kernelSize = ks
        self.stride = ks
    end

    create(int ks, int st)
        self.name = "AvgPool2d"
        self.kernelSize = ks
        self.stride = st
    end

    override func forward(Tensor x) as Tensor
        self.cachedX = x
        int batch = x.shape[0]
        int ch = x.shape[1]
        int H = x.shape[2]
        int Wd = x.shape[3]
        int ks = self.kernelSize
        int outH = (H - ks) / self.stride + 1
        int outW = (Wd - ks) / self.stride + 1
        array<int> outShape = array[]
        outShape.append(batch)
        outShape.append(ch)
        outShape.append(outH)
        outShape.append(outW)
        Tensor outT = Tensor(outShape)
        float poolSize = float(ks * ks)
        int bi = 0
        while bi < batch do
            int c = 0
            while c < ch do
                int oh = 0
                while oh < outH do
                    int ow = 0
                    while ow < outW do
                        float s = 0.0
                        int ky = 0
                        while ky < ks do
                            int kx = 0
                            while kx < ks do
                                int ih = oh * self.stride + ky
                                int iw = ow * self.stride + kx
                                s = s + x.data[((bi * ch + c) * H + ih) * Wd + iw]
                                kx += 1
                            end
                            ky += 1
                        end
                        outT.data[((bi * ch + c) * outH + oh) * outW + ow] = s / poolSize
                        ow += 1
                    end
                    oh += 1
                end
                c += 1
            end
            bi += 1
        end
        return outT
    end

    override func backward(Tensor gradOutput) as Tensor
        Tensor x = self.cachedX
        int batch = x.shape[0]
        int ch = x.shape[1]
        int H = x.shape[2]
        int Wd = x.shape[3]
        int ks = self.kernelSize
        int outH = gradOutput.shape[2]
        int outW = gradOutput.shape[3]
        Tensor gradInput = Tensor(x.shape)
        float poolSize = float(ks * ks)
        int bi = 0
        while bi < batch do
            int c = 0
            while c < ch do
                int oh = 0
                while oh < outH do
                    int ow = 0
                    while ow < outW do
                        float g = gradOutput.data[((bi * ch + c) * outH + oh) * outW + ow] / poolSize
                        int ky = 0
                        while ky < ks do
                            int kx = 0
                            while kx < ks do
                                int ih = oh * self.stride + ky
                                int iw = ow * self.stride + kx
                                int pos = ((bi * ch + c) * H + ih) * Wd + iw
                                gradInput.data[pos] = gradInput.data[pos] + g
                                kx += 1
                            end
                            ky += 1
                        end
                        ow += 1
                    end
                    oh += 1
                end
                c += 1
            end
            bi += 1
        end
        return gradInput
    end
end

// ----------------------------------------------------------------------------
// Embedding
// ----------------------------------------------------------------------------

class Embedding extends Layer
    derive value

    int vocabSize = 0
    int embedDim = 0
    Tensor W
    Tensor gradW
    Tensor cachedIdx

    create()
        self.name = "Embedding"
    end

    func init(int vs, int ed)
        self.name = "Embedding"
        self.vocabSize = vs
        self.embedDim = ed
        self.W = Tensor(vs, ed)
        self.gradW = Tensor(vs, ed)
        initNormal(self.W, 0.0, 1.0)
    end

    override func forward(Tensor x) as Tensor
        self.cachedIdx = x
        int n = x.shape[0]
        array<int> outShape = array[]
        outShape.append(n)
        outShape.append(self.embedDim)
        Tensor outT = Tensor(outShape)
        int i = 0
        while i < n do
            int idx = int(x.data[i])
            if idx < 0 then
                idx = 0
            end
            if idx >= self.vocabSize then
                idx = self.vocabSize - 1
            end
            int j = 0
            while j < self.embedDim do
                outT.data[i * self.embedDim + j] = self.W.data[idx * self.embedDim + j]
                j += 1
            end
            i += 1
        end
        return outT
    end

    override func backward(Tensor gradOutput) as Tensor
        int n = self.cachedIdx.shape[0]
        int i = 0
        while i < n do
            int idx = int(self.cachedIdx.data[i])
            if idx < 0 then
                idx = 0
            end
            if idx >= self.vocabSize then
                idx = self.vocabSize - 1
            end
            int j = 0
            while j < self.embedDim do
                self.gradW.data[idx * self.embedDim + j] = self.gradW.data[idx * self.embedDim + j] + gradOutput.data[i * self.embedDim + j]
                j += 1
            end
            i += 1
        end
        return gradOutput
    end

    override func params() as array<Tensor>
        array<Tensor> p = array[]
        p.append(self.W)
        return p
    end

    override func paramGrads() as array<Tensor>
        array<Tensor> p = array[]
        p.append(self.gradW)
        return p
    end

    override func resetState()
        int i = 0
        while i < self.gradW.numel do
            self.gradW.data[i] = 0.0
            i += 1
        end
        self.cachedIdx = null
    end
end

// ============================================================================
// Sequential - 层容器
// ============================================================================

class Sequential
    derive value

    array<var> layers = array[]

    create()
        self.layers = array[]
    end

    func add(Layer lyr)
        self.layers.append(lyr)
    end

    func forward(Tensor x) as Tensor
        Tensor cur = x
        int i = 0
        while i < self.layers.length do
            var v = self.layers[i]
            Layer lyr = v as Layer
            cur = lyr.forward(cur)
            i += 1
        end
        return cur
    end

    func backward(Tensor grad) as Tensor
        Tensor cur = grad
        int i = self.layers.length - 1
        while i >= 0 do
            var v = self.layers[i]
            Layer lyr = v as Layer
            cur = lyr.backward(cur)
            i -= 1
        end
        return cur
    end

    func params() as array<Tensor>
        array<Tensor> all = array[]
        int i = 0
        while i < self.layers.length do
            var v = self.layers[i]
            Layer lyr = v as Layer
            array<Tensor> ps = lyr.params()
            int j = 0
            while j < ps.length do
                all.append(ps[j])
                j += 1
            end
            i += 1
        end
        return all
    end

    func paramGrads() as array<Tensor>
        array<Tensor> all = array[]
        int i = 0
        while i < self.layers.length do
            var v = self.layers[i]
            Layer lyr = v as Layer
            array<Tensor> ps = lyr.paramGrads()
            int j = 0
            while j < ps.length do
                all.append(ps[j])
                j += 1
            end
            i += 1
        end
        return all
    end

    func resetGrads()
        int i = 0
        while i < self.layers.length do
            var v = self.layers[i]
            Layer lyr = v as Layer
            lyr.resetState()
            i += 1
        end
    end

    func setTraining(bool mode)
        int i = 0
        while i < self.layers.length do
            var v = self.layers[i]
            Layer lyr = v as Layer
            lyr.setTraining(mode)
            i += 1
        end
    end

    func layerCount() as int
        return self.layers.length
    end

    func layerAt(int i) as Layer
        var v = self.layers[i]
        return v as Layer
    end

    func describe() as string
        string s = "Sequential (" + string(self.layers.length) + " layers):\n"
        int i = 0
        while i < self.layers.length do
            var v = self.layers[i]
            Layer lyr = v as Layer
            s = s + "  [" + string(i) + "] " + lyr.name + "\n"
            i += 1
        end
        return s
    end
end

// ============================================================================
// 损失函数
// ============================================================================
// 损失以 class 实现：forward(pred, target) -> float；backward() -> Tensor。
// ============================================================================

class Loss
    derive value

    string name = "Loss"
    Tensor cachedPred
    Tensor cachedTarget

    virtual func forward(Tensor pred, Tensor target) as float
        return 0.0
    end

    virtual func backward() as Tensor
        return zerosLike(self.cachedPred)
    end

    func compute(Tensor pred, Tensor target) as float
        self.cachedPred = pred
        self.cachedTarget = target
        return self.forward(pred, target)
    end
end

class MSELoss extends Loss
    derive value

    create()
        self.name = "MSELoss"
    end

    override func forward(Tensor pred, Tensor target) as float
        if pred.numel != target.numel then
            throw "MSELoss: shape mismatch"
        end
        float s = 0.0
        int i = 0
        while i < pred.numel do
            float d = pred.data[i] - target.data[i]
            s = s + d * d
            i += 1
        end
        return s / float(pred.numel)
    end

    override func backward() as Tensor
        Tensor r = Tensor(self.cachedPred.shape)
        int n = self.cachedPred.numel
        int i = 0
        while i < n do
            r.data[i] = 2.0 * (self.cachedPred.data[i] - self.cachedTarget.data[i]) / float(n)
            i += 1
        end
        return r
    end
end

class BCELoss extends Loss
    derive value

    create()
        self.name = "BCELoss"
    end

    override func forward(Tensor pred, Tensor target) as float
        float s = 0.0
        int n = pred.numel
        int i = 0
        while i < n do
            float p = clampF(pred.data[i], MLP_EPS, 1.0 - MLP_EPS)
            float t = target.data[i]
            float v = -(t * safeLog(p) + (1.0 - t) * safeLog(1.0 - p))
            s = s + v
            i += 1
        end
        return s / float(n)
    end

    override func backward() as Tensor
        Tensor r = Tensor(self.cachedPred.shape)
        int n = self.cachedPred.numel
        int i = 0
        while i < n do
            float p = clampF(self.cachedPred.data[i], MLP_EPS, 1.0 - MLP_EPS)
            float t = self.cachedTarget.data[i]
            r.data[i] = (p - t) / (p * (1.0 - p)) / float(n)
            i += 1
        end
        return r
    end
end

class CrossEntropyLoss extends Loss
    derive value

    Tensor cachedProbs

    create()
        self.name = "CrossEntropyLoss"
    end

    override func forward(Tensor pred, Tensor target) as float
        int batch = pred.shape[0]
        int C = pred.shape[1]
        Tensor probs = tensorSoftmax(pred)
        self.cachedProbs = probs
        float s = 0.0
        int i = 0
        while i < batch do
            int label = int(target.data[i])
            // 如果 target 是 (batch, C) one-hot，找最大值位置
            // 如果 target 是 (batch, 1) 或 (batch,)，直接用值作为 label
            if target.ndim == 2 and target.shape[1] == C then
                label = 0
                float m = target.data[i * C]
                int k = 1
                while k < C do
                    if target.data[i * C + k] > m then
                        m = target.data[i * C + k]
                        label = k
                    end
                    k += 1
                end
            else
                label = int(target.data[i])
            end
            if label < 0 then
                label = 0
            end
            if label >= C then
                label = C - 1
            end
            s = s - safeLog(probs.data[i * C + label])
            i += 1
        end
        return s / float(batch)
    end

    override func backward() as Tensor
        Tensor r = Tensor(self.cachedPred.shape)
        int batch = self.cachedPred.shape[0]
        int C = self.cachedPred.shape[1]
        Tensor probs = self.cachedProbs
        Tensor target = self.cachedTarget
        int i = 0
        while i < batch do
            int label = int(target.data[i])
            if target.ndim == 2 and target.shape[1] == C then
                label = 0
                float m = target.data[i * C]
                int k = 1
                while k < C do
                    if target.data[i * C + k] > m then
                        m = target.data[i * C + k]
                        label = k
                    end
                    k += 1
                end
            else
                label = int(target.data[i])
            end
            int j = 0
            while j < C do
                float one = 0.0
                if j == label then
                    one = 1.0
                end
                r.data[i * C + j] = (probs.data[i * C + j] - one) / float(batch)
                j += 1
            end
            i += 1
        end
        return r
    end
end

class FocalLoss extends Loss
    derive value

    float alpha = 0.25
    float gamma = 2.0
    Tensor cachedProbs

    create()
        self.name = "FocalLoss"
        self.alpha = 0.25
        self.gamma = 2.0
    end

    create(float a, float g)
        self.name = "FocalLoss"
        self.alpha = a
        self.gamma = g
    end

    override func forward(Tensor pred, Tensor target) as float
        int batch = pred.shape[0]
        int C = pred.shape[1]
        Tensor probs = tensorSoftmax(pred)
        self.cachedProbs = probs
        float s = 0.0
        int i = 0
        while i < batch do
            int label = int(target.data[i])
            if label < 0 then
                label = 0
            end
            if label >= C then
                label = C - 1
            end
            float p = probs.data[i * C + label]
            s = s - self.alpha * math.pow(1.0 - p, self.gamma) * safeLog(p)
            i += 1
        end
        return s / float(batch)
    end

    override func backward() as Tensor
        Tensor r = Tensor(self.cachedPred.shape)
        int batch = self.cachedPred.shape[0]
        int C = self.cachedPred.shape[1]
        Tensor probs = self.cachedProbs
        Tensor target = self.cachedTarget
        int i = 0
        while i < batch do
            int label = int(target.data[i])
            if label < 0 then
                label = 0
            end
            if label >= C then
                label = C - 1
            end
            float pLab = probs.data[i * C + label]
            float mod = self.alpha * math.pow(1.0 - pLab, self.gamma - 1.0)
            int j = 0
            while j < C do
                float one = 0.0
                if j == label then
                    one = 1.0
                end
                r.data[i * C + j] = mod * (probs.data[i * C + j] - one) / float(batch)
                j += 1
            end
            i += 1
        end
        return r
    end
end

// ============================================================================
// 优化器
// ============================================================================

class Optimizer
    derive value

    string name = "Optimizer"
    float lr = 0.01

    virtual func step(array<Tensor> params, array<Tensor> grads)
    end

    virtual func resetState()
    end
end

class SGD extends Optimizer
    derive value

    create(float learningRate)
        self.name = "SGD"
        self.lr = learningRate
    end

    override func step(array<Tensor> params, array<Tensor> grads)
        int i = 0
        while i < params.length do
            Tensor p = params[i]
            Tensor g = grads[i]
            int j = 0
            while j < p.numel do
                p.data[j] = p.data[j] - self.lr * g.data[j]
                j += 1
            end
            i += 1
        end
    end
end

class Momentum extends Optimizer
    derive value

    float momentum = 0.9
    array<Tensor> velocities = array[]

    create(float learningRate, float mom)
        self.name = "Momentum"
        self.lr = learningRate
        self.momentum = mom
    end

    override func step(array<Tensor> params, array<Tensor> grads)
        if self.velocities.length != params.length then
            self.velocities = array[]
            int k = 0
            while k < params.length do
                self.velocities.append(zerosLike(params[k]))
                k += 1
            end
        end
        int i = 0
        while i < params.length do
            Tensor p = params[i]
            Tensor g = grads[i]
            Tensor v = self.velocities[i]
            int j = 0
            while j < p.numel do
                v.data[j] = self.momentum * v.data[j] + g.data[j]
                p.data[j] = p.data[j] - self.lr * v.data[j]
                j += 1
            end
            i += 1
        end
    end

    override func resetState()
        int i = 0
        while i < self.velocities.length do
            Tensor v = self.velocities[i]
            int j = 0
            while j < v.numel do
                v.data[j] = 0.0
                j += 1
            end
            i += 1
        end
    end
end

class RMSprop extends Optimizer
    derive value

    float decay = 0.99
    float eps = 1e-8
    array<Tensor> sqAvg = array[]

    create(float learningRate, float dec)
        self.name = "RMSprop"
        self.lr = learningRate
        self.decay = dec
        self.eps = 1e-8
    end

    create(float learningRate)
        self.name = "RMSprop"
        self.lr = learningRate
        self.decay = 0.99
        self.eps = 1e-8
    end

    override func step(array<Tensor> params, array<Tensor> grads)
        if self.sqAvg.length != params.length then
            self.sqAvg = array[]
            int k = 0
            while k < params.length do
                self.sqAvg.append(zerosLike(params[k]))
                k += 1
            end
        end
        int i = 0
        while i < params.length do
            Tensor p = params[i]
            Tensor g = grads[i]
            Tensor s = self.sqAvg[i]
            int j = 0
            while j < p.numel do
                s.data[j] = self.decay * s.data[j] + (1.0 - self.decay) * g.data[j] * g.data[j]
                float denom = math.sqrt(s.data[j]) + self.eps
                p.data[j] = p.data[j] - self.lr * g.data[j] / denom
                j += 1
            end
            i += 1
        end
    end

    override func resetState()
        int i = 0
        while i < self.sqAvg.length do
            Tensor s = self.sqAvg[i]
            int j = 0
            while j < s.numel do
                s.data[j] = 0.0
                j += 1
            end
            i += 1
        end
    end
end

class Adam extends Optimizer
    derive value

    float beta1 = 0.9
    float beta2 = 0.999
    float eps = 1e-8
    array<Tensor> m = array[]
    array<Tensor> v = array[]
    int t = 0

    create(float learningRate)
        self.name = "Adam"
        self.lr = learningRate
        self.beta1 = 0.9
        self.beta2 = 0.999
        self.eps = 1e-8
    end

    create(float learningRate, float b1, float b2)
        self.name = "Adam"
        self.lr = learningRate
        self.beta1 = b1
        self.beta2 = b2
        self.eps = 1e-8
    end

    override func step(array<Tensor> params, array<Tensor> grads)
        if self.m.length != params.length then
            self.m = array[]
            self.v = array[]
            int k = 0
            while k < params.length do
                self.m.append(zerosLike(params[k]))
                self.v.append(zerosLike(params[k]))
                k += 1
            end
        end
        self.t += 1
        float bc1 = 1.0 - math.pow(self.beta1, float(self.t))
        float bc2 = 1.0 - math.pow(self.beta2, float(self.t))
        int i = 0
        while i < params.length do
            Tensor p = params[i]
            Tensor g = grads[i]
            Tensor m = self.m[i]
            Tensor v = self.v[i]
            int j = 0
            while j < p.numel do
                m.data[j] = self.beta1 * m.data[j] + (1.0 - self.beta1) * g.data[j]
                v.data[j] = self.beta2 * v.data[j] + (1.0 - self.beta2) * g.data[j] * g.data[j]
                float mHat = m.data[j] / bc1
                float vHat = v.data[j] / bc2
                p.data[j] = p.data[j] - self.lr * mHat / (math.sqrt(vHat) + self.eps)
                j += 1
            end
            i += 1
        end
    end

    override func resetState()
        int i = 0
        while i < self.m.length do
            Tensor mm = self.m[i]
            int j = 0
            while j < mm.numel do
                mm.data[j] = 0.0
                j += 1
            end
            Tensor vv = self.v[i]
            int k = 0
            while k < vv.numel do
                vv.data[k] = 0.0
                k += 1
            end
            i += 1
        end
        self.t = 0
    end
end

class AdamW extends Optimizer
    derive value

    float beta1 = 0.9
    float beta2 = 0.999
    float eps = 1e-8
    float weightDecay = 0.01
    array<Tensor> m = array[]
    array<Tensor> v = array[]
    int t = 0

    create(float learningRate, float wd)
        self.name = "AdamW"
        self.lr = learningRate
        self.beta1 = 0.9
        self.beta2 = 0.999
        self.eps = 1e-8
        self.weightDecay = wd
    end

    override func step(array<Tensor> params, array<Tensor> grads)
        if self.m.length != params.length then
            self.m = array[]
            self.v = array[]
            int k = 0
            while k < params.length do
                self.m.append(zerosLike(params[k]))
                self.v.append(zerosLike(params[k]))
                k += 1
            end
        end
        self.t += 1
        float bc1 = 1.0 - math.pow(self.beta1, float(self.t))
        float bc2 = 1.0 - math.pow(self.beta2, float(self.t))
        int i = 0
        while i < params.length do
            Tensor p = params[i]
            Tensor g = grads[i]
            Tensor m = self.m[i]
            Tensor v = self.v[i]
            int j = 0
            while j < p.numel do
                p.data[j] = p.data[j] * (1.0 - self.lr * self.weightDecay)
                m.data[j] = self.beta1 * m.data[j] + (1.0 - self.beta1) * g.data[j]
                v.data[j] = self.beta2 * v.data[j] + (1.0 - self.beta2) * g.data[j] * g.data[j]
                float mHat = m.data[j] / bc1
                float vHat = v.data[j] / bc2
                p.data[j] = p.data[j] - self.lr * mHat / (math.sqrt(vHat) + self.eps)
                j += 1
            end
            i += 1
        end
    end

    override func resetState()
        int i = 0
        while i < self.m.length do
            Tensor mm = self.m[i]
            int j = 0
            while j < mm.numel do
                mm.data[j] = 0.0
                j += 1
            end
            Tensor vv = self.v[i]
            int k = 0
            while k < vv.numel do
                vv.data[k] = 0.0
                k += 1
            end
            i += 1
        end
        self.t = 0
    end
end

// ============================================================================
// 学习率调度器
// ============================================================================

class Scheduler
    derive value

    string name = "Scheduler"

    virtual func getLR(int epoch, float curLoss) as float
        return 0.01
    end

    virtual func step(int epoch, float curLoss)
    end
end
class StepLR extends Scheduler
    derive value

    float baseLR = 0.01
    float gamma = 0.1
    int stepSize = 10

    create(float lr, int ss, float g)
        self.name = "StepLR"
        self.baseLR = lr
        self.stepSize = ss
        self.gamma = g
    end

    override func getLR(int epoch, float curLoss) as float
        int n = epoch / self.stepSize
        float factor = math.pow(self.gamma, float(n))
        return self.baseLR * factor
    end
end

class CosineAnnealingLR extends Scheduler
    derive value

    float baseLR = 0.01
    float minLR = 0.0
    int totalEpochs = 100

    create(float lr, float minlr, int te)
        self.name = "CosineAnnealingLR"
        self.baseLR = lr
        self.minLR = minlr
        self.totalEpochs = te
    end

    override func getLR(int epoch, float curLoss) as float
        if self.totalEpochs <= 0 then
            return self.baseLR
        end
        float t = float(epoch) / float(self.totalEpochs)
        if t > 1.0 then
            t = 1.0
        end
        float cosVal = math.cos(math.pi * t)
        return self.minLR + 0.5 * (self.baseLR - self.minLR) * (1.0 + cosVal)
    end
end

class ReduceOnPlateau extends Scheduler
    derive value

    float baseLR = 0.01
    float minLR = 1e-6
    float factor = 0.5
    float patience = 5.0
    float threshold = 1e-4
    float bestLoss = MLP_INF
    int badEpochs = 0
    float curLR = 0.01

    create(float lr, float f, int p)
        self.name = "ReduceOnPlateau"
        self.baseLR = lr
        self.minLR = 1e-6
        self.factor = f
        self.patience = float(p)
        self.threshold = 1e-4
        self.bestLoss = MLP_INF
        self.badEpochs = 0
        self.curLR = lr
    end

    override func getLR(int epoch, float curLoss) as float
        return self.curLR
    end

    override func step(int epoch, float curLoss)
        if curLoss < self.bestLoss - self.threshold then
            self.bestLoss = curLoss
            self.badEpochs = 0
        else
            self.badEpochs += 1
            if float(self.badEpochs) >= self.patience then
                self.curLR = self.curLR * self.factor
                if self.curLR < self.minLR then
                    self.curLR = self.minLR
                end
                self.badEpochs = 0
            end
        end
    end
end

// ============================================================================
// 梯度裁剪（按全局 L2 范数）
// ============================================================================

func clipGradientsGlobalNorm(array<Tensor> grads, float maxNorm)
    float totalSq = 0.0
    int i = 0
    while i < grads.length do
        Tensor g = grads[i]
        int j = 0
        while j < g.numel do
            totalSq = totalSq + g.data[j] * g.data[j]
            j += 1
        end
        i += 1
    end
    float total = math.sqrt(totalSq)
    if total <= maxNorm then
        return
    end
    float scale = maxNorm / (total + MLP_EPS)
    int i2 = 0
    while i2 < grads.length do
        Tensor g = grads[i2]
        int j2 = 0
        while j2 < g.numel do
            g.data[j2] = g.data[j2] * scale
            j2 += 1
        end
        i2 += 1
    end
end

func clipGradientsByValue(array<Tensor> grads, float minVal, float maxVal)
    int i = 0
    while i < grads.length do
        Tensor g = grads[i]
        int j = 0
        while j < g.numel do
            float v = g.data[j]
            if v < minVal then
                v = minVal
            end
            if v > maxVal then
                v = maxVal
            end
            g.data[j] = v
            j += 1
        end
        i += 1
    end
end

// ============================================================================
// 训练循环
// ============================================================================
// 提供 train() 与 evaluate() 高层 API。mini-batch + epoch + early stopping +
// 梯度裁剪 + 学习率调度。
// ============================================================================

class TrainConfig
    derive value

    int epochs = 100
    int batchSize = 16
    float lr = 0.01
    float clipNorm = 0.0
    int earlyStopPatience = 0
    bool verbose = true
    int logEvery = 10
end

class TrainHistory
    derive value

    array<float> losses = array[]
    array<float> lrs = array[]
    array<float> valAccs = array[]
end

// 把多个 1D 样本堆叠成 2D batch：(N, F)
func stackBatch2d(array<Tensor> samples) as Tensor
    int n = samples.length
    if n == 0 then
        return Tensor(0, 0)
    end
    int f = samples[0].shape[0]
    array<int> shp = array[]
    shp.append(n)
    shp.append(f)
    Tensor r = Tensor(shp)
    int i = 0
    while i < n do
        int j = 0
        while j < f do
            r.data[i * f + j] = samples[i].data[j]
            j += 1
        end
        i += 1
    end
    return r
end

// 通用 mini-batch 拼接：1D 样本 -> 2D batch；2D 样本 -> 沿第 0 维拼接
func makeBatch(array<Tensor> samples) as Tensor
    if samples.length == 0 then
        return Tensor(0, 0)
    end
    if samples[0].ndim == 1 then
        return stackBatch2d(samples)
    end
    return concatAxis0(samples)
end

func trainEpoch(Sequential model, Optimizer opt, array<Tensor> xs, array<Tensor> ys, Loss lossFn, TrainConfig cfg, int epochIdx) as float
    int n = xs.length
    int bs = cfg.batchSize
    if bs <= 0 then
        bs = 16
    end
    float totalLoss = 0.0
    int numBatches = 0
    int i = 0
    while i < n do
        int endIdx = i + bs
        if endIdx > n then
            endIdx = n
        end
        array<Tensor> batchXs = array[]
        array<Tensor> batchYs = array[]
        int j = i
        while j < endIdx do
            batchXs.append(xs[j])
            batchYs.append(ys[j])
            j += 1
        end
        Tensor bx = makeBatch(batchXs)
        Tensor by = makeBatch(batchYs)
        // 清空梯度（必须在 forward 之前，避免清掉 forward 缓存的中间值）
        model.resetGrads()
        // forward
        Tensor pred = model.forward(bx)
        float loss = lossFn.compute(pred, by)
        // backward
        Tensor gradLoss = lossFn.backward()
        model.backward(gradLoss)
        // 梯度裁剪
        if cfg.clipNorm > 0.0 then
            array<Tensor> grads = model.paramGrads()
            clipGradientsGlobalNorm(grads, cfg.clipNorm)
        end
        // 更新参数
        array<Tensor> params = model.params()
        array<Tensor> grads = model.paramGrads()
        opt.step(params, grads)
        totalLoss = totalLoss + loss
        numBatches += 1
        i = endIdx
    end
    if numBatches == 0 then
        return 0.0
    end
    return totalLoss / float(numBatches)
end

func evaluateAccuracy(Sequential model, array<Tensor> xs, array<Tensor> ys) as float
    int n = xs.length
    if n == 0 then
        return 0.0
    end
    int correct = 0
    int i = 0
    while i < n do
        Tensor pred = model.forward(xs[i])
        int c = pred.shape[pred.ndim - 1]
        int mi = 0
        float m = pred.data[0]
        int k = 1
        while k < c do
            if pred.data[k] > m then
                m = pred.data[k]
                mi = k
            end
            k += 1
        end
        int label = int(ys[i].data[0])
        if mi == label then
            correct += 1
        end
        i += 1
    end
    return float(correct) / float(n)
end

func evaluateMSE(Sequential model, array<Tensor> xs, array<Tensor> ys) as float
    int n = xs.length
    if n == 0 then
        return 0.0
    end
    float s = 0.0
    int i = 0
    while i < n do
        Tensor pred = model.forward(xs[i])
        Tensor y = ys[i]
        int j = 0
        while j < pred.numel do
            float d = pred.data[j] - y.data[j]
            s = s + d * d
            j += 1
        end
        i += 1
    end
    return s / float(n)
end

// 通用训练入口
func runTraining(Sequential model, Optimizer opt, Scheduler sched, Loss lossFn, array<Tensor> xs, array<Tensor> ys, TrainConfig cfg) as TrainHistory
    TrainHistory h = TrainHistory()
    h.losses = array[]
    h.lrs = array[]
    h.valAccs = array[]
    float bestLoss = MLP_INF
    int badEpochs = 0
    model.setTraining(true)
    int epoch = 0
    while epoch < cfg.epochs do
        float lr = sched.getLR(epoch, 0.0)
        opt.lr = lr
        float loss = trainEpoch(model, opt, xs, ys, lossFn, cfg, epoch)
        h.losses.append(loss)
        h.lrs.append(lr)
        sched.step(epoch, loss)
        if cfg.verbose then
            if epoch % cfg.logEvery == 0 or epoch == cfg.epochs - 1 then
                println("  epoch " + string(epoch) + "  loss=" + fmtN(loss, 6) + "  lr=" + fmtN(lr, 6))
            end
        end
        if cfg.earlyStopPatience > 0 then
            if loss < bestLoss then
                bestLoss = loss
                badEpochs = 0
            else
                badEpochs += 1
                if badEpochs >= cfg.earlyStopPatience then
                    if cfg.verbose then
                        println("  early stopping at epoch " + string(epoch))
                    end
                    break
                end
            end
        end
        epoch += 1
    end
    model.setTraining(false)
    return h
end

// ============================================================================
// 数据集
// ============================================================================
// 提供 XOR / 螺旋分类 / sin 回归 / MNIST-style 简化数据。
// 每个数据集函数返回 (xs, ys) 两个 array<Tensor>。
// ============================================================================

class Dataset
    derive value

    string name = "?"
    array<Tensor> xs = array[]
    array<Tensor> ys = array[]
    int nSamples = 0
    int nFeatures = 0
    int nClasses = 0
end

// XOR 数据集（4 样本，2 输入 1 输出）
func makeXOR() as Dataset
    Dataset d = Dataset()
    d.name = "XOR"
    d.nSamples = 4
    d.nFeatures = 2
    d.nClasses = 1
    array<float> x0 = [0.0, 0.0]
    array<float> x1 = [0.0, 1.0]
    array<float> x2 = [1.0, 0.0]
    array<float> x3 = [1.0, 1.0]
    d.xs.append(tensor1d(x0))
    d.xs.append(tensor1d(x1))
    d.xs.append(tensor1d(x2))
    d.xs.append(tensor1d(x3))
    array<float> y0 = [0.0]
    array<float> y1 = [1.0]
    array<float> y2 = [1.0]
    array<float> y3 = [0.0]
    d.ys.append(tensor1d(y0))
    d.ys.append(tensor1d(y1))
    d.ys.append(tensor1d(y2))
    d.ys.append(tensor1d(y3))
    return d
end

// 螺旋分类数据集（3 类，每类 N 个样本）
func makeSpiral(int pointsPerClass) as Dataset
    Dataset d = Dataset()
    d.name = "Spiral"
    d.nClasses = 3
    d.nFeatures = 2
    seedRandom(42)
    int c = 0
    while c < 3 do
        float rStart = float(c) * 0.5
        int i = 0
        while i < pointsPerClass do
            float t = float(i) / float(pointsPerClass - 1)
            float r = rStart + t * 2.5
            float theta = t * 4.0 * math.pi + float(c) * 2.0 * math.pi / 3.0
            float noise = (randF() - 0.5) * 0.15
            float x0 = r * math.sin(theta) + noise
            float x1 = r * math.cos(theta) + noise
            array<float> xx = [x0, x1]
            d.xs.append(tensor1d(xx))
            array<float> yy = [float(c)]
            d.ys.append(tensor1d(yy))
            i += 1
        end
        c += 1
    end
    d.nSamples = d.xs.length
    return d
end

// sin 回归数据集（一维输入 x，目标 sin(x)）
func makeSinRegression(int nPoints, float xMin, float xMax) as Dataset
    Dataset d = Dataset()
    d.name = "SinRegression"
    d.nFeatures = 1
    d.nClasses = 1
    seedRandom(7)
    int i = 0
    while i < nPoints do
        float t = float(i) / float(nPoints - 1)
        float x = xMin + t * (xMax - xMin)
        float y = math.sin(x)
        array<float> xx = [x]
        array<float> yy = [y]
        d.xs.append(tensor1d(xx))
        d.ys.append(tensor1d(yy))
        i += 1
    end
    d.nSamples = d.xs.length
    return d
end

// MNIST-style 简化数据集：8x8 二值图案，识别数字 0..9
// 每类用程序生成的简单图案，便于不依赖外部数据。
func makeMnistStyle(int perClass) as Dataset
    Dataset d = Dataset()
    d.name = "MnistStyle"
    d.nFeatures = 64
    d.nClasses = 10
    seedRandom(123)
    int c = 0
    while c < 10 do
        int i = 0
        while i < perClass do
            // 生成 8x8 图案：以模板为基础加噪声
            array<float> img = array[]
            int p = 0
            while p < 64 do
                img.append(0.0)
                p += 1
            end
            // 用 c 作为种子构造简单图案：c 的笔画位置
            int cy = c / 2
            int cx = c - cy * 2
            int py = 0
            while py < 8 do
                int px = 0
                while px < 8 do
                    // 在中心 + (cy-4, cx-4) 偏移处填充
                    float dy = float(py - 4) - float(cy - 4) * 0.5
                    float dx = float(px - 4) - float(cx - 4) * 0.5
                    float dist = math.sqrt(dy * dy + dx * dx)
                    float v = 0.0
                    if dist < 2.5 then
                        v = 1.0
                    end
                    // 加噪声
                    if randF() < 0.1 then
                        v = 1.0 - v
                    end
                    img[py * 8 + px] = v
                    px += 1
                end
                py += 1
            end
            array<int> shp = array[]
            shp.append(64)
            d.xs.append(tensorFrom(img, shp))
            array<float> yy = [float(c)]
            d.ys.append(tensor1d(yy))
            i += 1
        end
        c += 1
    end
    d.nSamples = d.xs.length
    return d
end

// 把数据集展开为 (N, F) 输入和 one-hot 标签
func datasetToBatchXY(Dataset d) as var
    // 输入拼为 (N, F)
    Tensor bigX = concatAxis0(d.xs)
    // 输出（one-hot 或回归值）
    Tensor bigY = concatAxis0(d.ys)
    var r = dict{}
    r["X"] = bigX
    r["Y"] = bigY
    return r
end

// 转 one-hot 标签
func toOneHot(array<Tensor> labels, int numClasses) as array<Tensor>
    array<Tensor> r = array[]
    int i = 0
    while i < labels.length do
        int label = int(labels[i].data[0])
        if label < 0 then
            label = 0
        end
        if label >= numClasses then
            label = numClasses - 1
        end
        array<float> v = array[]
        int j = 0
        while j < numClasses do
            if j == label then
                v.append(1.0)
            else
                v.append(0.0)
            end
            j += 1
        end
        r.append(tensor1d(v))
        i += 1
    end
    return r
end

// ============================================================================
// 序列化（save/load 权重为 JSON）
// ============================================================================

func tensorToVar(Tensor t) as var
    var d = dict{}
    d["shape"] = t.shape
    d["data"] = t.data
    return d
end

func tensorFromVar(var v) as Tensor
    var shapeVar = v["shape"]
    var dataVar = v["data"]
    int sn = shapeVar.length
    array<int> shp = array[]
    int i = 0
    while i < sn do
        shp.append(int(shapeVar[i]))
        i += 1
    end
    int dn = dataVar.length
    array<float> data = array[]
    int j = 0
    while j < dn do
        data.append(float(dataVar[j]))
        j += 1
    end
    return tensorFrom(data, shp)
end

func saveModel(Sequential model, string path) as bool
    array<Tensor> params = model.params()
    var root = dict{}
    var layersList = array[]
    int i = 0
    while i < model.layers.length do
        var v = model.layers[i]
        Layer lyr = v as Layer
        var info = dict{}
        info["name"] = lyr.name
        var paramList = array[]
        array<Tensor> ps = lyr.params()
        int j = 0
        while j < ps.length do
            paramList.append(tensorToVar(ps[j]))
            j += 1
        end
        info["params"] = paramList
        layersList.append(info)
        i += 1
    end
    root["layers"] = layersList
    string js = json.stringify(root, pretty = true)
    // JSON pretty 用 TAB 缩进，转 2 空格
    js = string.replace(js, "\t", "  ")
    bool ok = file.writeText(path, js)
    return ok
end

func loadModel(Sequential model, string path) as bool
    if not file.exists(path) then
        return false
    end
    string text = file.readText(path)
    if not json.valid(text) then
        return false
    end
    var root = json.parse(text)
    var layersList = root["layers"]
    int n = layersList.length
    int i = 0
    while i < n do
        var info = layersList[i]
        var paramList = info["params"]
        Layer lyr = model.layerAt(i)
        array<Tensor> ps = lyr.params()
        int j = 0
        while j < ps.length do
            var pv = paramList[j]
            Tensor loaded = tensorFromVar(pv)
            Tensor dst = ps[j]
            int k = 0
            while k < dst.numel do
                if k < loaded.numel then
                    dst.data[k] = loaded.data[k]
                end
                k += 1
            end
            j += 1
        end
        i += 1
    end
    return true
end

// ============================================================================
// 命令：xor 训练
// ============================================================================

func cmdXor() as int
    println("============================================================")
    println("ML Platform - XOR 分类训练")
    println("============================================================")
    seedRandom(20260713)
    Dataset d = makeXOR()
    println("dataset: " + d.name + " samples=" + string(d.nSamples))

    // 模型：2 -> 8 (tanh) -> 1 (sigmoid)
    Sequential model = Sequential()
    Dense d1 = Dense()
    d1.init(2, 8)
    Tanh a1 = Tanh()
    Dense d2 = Dense()
    d2.init(8, 1)
    Sigmoid a2 = Sigmoid()
    model.add(d1)
    model.add(a1)
    model.add(d2)
    model.add(a2)
    print(model.describe())

    TrainConfig cfg = TrainConfig()
    cfg.epochs = 600
    cfg.batchSize = 4
    cfg.lr = 0.5
    cfg.verbose = true
    cfg.logEvery = 50
    cfg.earlyStopPatience = 100

    Adam opt = Adam(0.05)
    MSELoss lossFn = MSELoss()
    CosineAnnealingLR sched = CosineAnnealingLR(0.5, 0.001, 600)

    TrainHistory h = runTraining(model, opt, sched, lossFn, d.xs, d.ys, cfg)

    // 评估
    println("")
    println("Final predictions:")
    int i = 0
    while i < d.nSamples do
        Tensor p = model.forward(d.xs[i])
        float v = tensorItem(p)
        float tgt = tensorItem(d.ys[i])
        println("  x=[" + fmtN(d.xs[i].data[0], 1) + "," + fmtN(d.xs[i].data[1], 1) +
                "]  pred=" + fmtN(v, 4) + "  target=" + fmtN(tgt, 1))
        i += 1
    end
    float acc = 0.0
    int correct = 0
    int j = 0
    while j < d.nSamples do
        Tensor p = model.forward(d.xs[j])
        float v = tensorItem(p)
        float tgt = tensorItem(d.ys[j])
        int pl = 0
        if v > 0.5 then
            pl = 1
        end
        if pl == int(tgt) then
            correct += 1
        end
        j += 1
    end
    acc = float(correct) / float(d.nSamples)
    println("")
    println("accuracy=" + fmtN(acc, 4) + "  final_loss=" + fmtN(h.losses[h.losses.length - 1], 6))
    if acc >= 0.75 then
        println("RESULT: PASS (XOR learned)")
        return 0
    end
    println("RESULT: FAIL (XOR not learned)")
    return 1
end

// ============================================================================
// 命令：spiral 训练
// ============================================================================

func cmdSpiral() as int
    println("============================================================")
    println("ML Platform - 螺旋分类训练")
    println("============================================================")
    seedRandom(20260713)
    Dataset d = makeSpiral(40)
    println("dataset: " + d.name + " samples=" + string(d.nSamples) + " classes=" + string(d.nClasses))

    // 模型：2 -> 32 (tanh) -> 32 (tanh) -> 3
    Sequential model = Sequential()
    Dense d1 = Dense()
    d1.init(2, 32, true, "xavier")
    Tanh a1 = Tanh()
    Dense d2 = Dense()
    d2.init(32, 32, true, "xavier")
    Tanh a2 = Tanh()
    Dense d3 = Dense()
    d3.init(32, 3, true, "xavier")
    model.add(d1)
    model.add(a1)
    model.add(d2)
    model.add(a2)
    model.add(d3)
    print(model.describe())

    TrainConfig cfg = TrainConfig()
    cfg.epochs = 400
    cfg.batchSize = 16
    cfg.lr = 0.1
    cfg.verbose = true
    cfg.logEvery = 50
    cfg.earlyStopPatience = 0
    cfg.clipNorm = 5.0

    Adam opt = Adam(0.1)
    CrossEntropyLoss lossFn = CrossEntropyLoss()
    CosineAnnealingLR sched = CosineAnnealingLR(0.1, 0.005, 400)

    TrainHistory h = runTraining(model, opt, sched, lossFn, d.xs, d.ys, cfg)

    float acc = evaluateAccuracy(model, d.xs, d.ys)
    println("")
    println("accuracy=" + fmtN(acc, 4) + "  final_loss=" + fmtN(h.losses[h.losses.length - 1], 6))
    if acc >= 0.7 then
        println("RESULT: PASS (spiral learned)")
        return 0
    end
    println("RESULT: WARN (spiral accuracy low, but training completed)")
    return 0
end

// ============================================================================
// 命令：regression sin
// ============================================================================

func cmdRegression() as int
    println("============================================================")
    println("ML Platform - sin 回归训练")
    println("============================================================")
    seedRandom(20260713)
    Dataset d = makeSinRegression(60, -3.0, 3.0)
    println("dataset: " + d.name + " samples=" + string(d.nSamples))

    // 模型：1 -> 16 (tanh) -> 16 (tanh) -> 1
    Sequential model = Sequential()
    Dense d1 = Dense()
    d1.init(1, 16)
    Tanh a1 = Tanh()
    Dense d2 = Dense()
    d2.init(16, 16)
    Tanh a2 = Tanh()
    Dense d3 = Dense()
    d3.init(16, 1)
    model.add(d1)
    model.add(a1)
    model.add(d2)
    model.add(a2)
    model.add(d3)
    print(model.describe())

    TrainConfig cfg = TrainConfig()
    cfg.epochs = 500
    cfg.batchSize = 16
    cfg.lr = 0.01
    cfg.verbose = true
    cfg.logEvery = 50
    cfg.earlyStopPatience = 80

    Adam opt = Adam(0.01)
    MSELoss lossFn = MSELoss()
    CosineAnnealingLR sched = CosineAnnealingLR(0.01, 0.0001, 500)

    TrainHistory h = runTraining(model, opt, sched, lossFn, d.xs, d.ys, cfg)

    float mse = evaluateMSE(model, d.xs, d.ys)
    println("")
    println("Final predictions (first 8 samples):")
    int i = 0
    while i < 8 and i < d.nSamples do
        Tensor p = model.forward(d.xs[i])
        float v = tensorItem(p)
        float tgt = tensorItem(d.ys[i])
        float x = d.xs[i].data[0]
        println("  x=" + fmtN(x, 3) + "  pred=" + fmtN(v, 4) + "  target=" + fmtN(tgt, 4))
        i += 1
    end
    println("")
    println("mse=" + fmtN(mse, 6) + "  final_loss=" + fmtN(h.losses[h.losses.length - 1], 6))
    if mse < 0.05 then
        println("RESULT: PASS (sin regression learned)")
        return 0
    end
    println("RESULT: WARN (mse higher than threshold, but training completed)")
    return 0
end

