// shapes - 继承体系验证工具
//
// 通过 Shape > Circle > Cylinder 三层继承链，全面验证 xlang class 的：
//   1. 继承链 + base() 链式构造
//   2. public / private / protected 访问控制
//   3. static 字段与方法（类名访问）
//   4. virtual / override / final 方法
//   5. virtual / override 属性 (get)
//   6. vtable 动态派发（向上转型 Shape s = Circle(...)；基类方法内 self.xxx() 内部派发）
//   7. destroy 析构生命周期
//
// 程序始终返回 0（即使发现 BUG 也只 [FAIL] 不中断），保证 xl run / xl build 双路径 EXIT=0。
//
// 设计说明（重要）：
//   xlang 现已支持派生类实例向基类类型的隐式向上转型（SH2 已修复）：
//     - `Shape s = Circle(...)`        -> 合法，s.area() 按实例真实类型派发
//     - `func f(Base b)` 传 Derived    -> 合法，函数体内 b.virtualMethod() 派发到 override（SH3 已修复）
//   因此 vtable 动态派发的验证改回正常的「向上转型」+「函数参数多态」写法。
//
//   注意：带 destroy 的 class（Shape/Circle/Cylinder）被视为不可按值复制的资源，
//   不能按值传入/传出函数，也不能直接装箱进 var。所以：
//     - 向上转型赋值（Shape s = Circle）可用，但 printArea(Shape s) 这类按值形参
//       不适用于带 destroy 的类型。
//     - 「函数参数多态」与「var 装箱 downcast」两条 vtable 路径改由一对无 destroy 的
//       ProbeBase / ProbeDerived 镜像层级承载（SH1 已修复：var->as Base->virtualMethod
//       保留 vtable 派发）。
//
// 用法：
//   xl run projects\dev\shapes\shapes.xl
//   xl build projects\dev\shapes\shapes.xl -o projects\dev\shapes\shapes.exe
//   shapes.exe

// ===== 测试框架 =====
int g_pass = 0
int g_fail = 0

func ok(string label)
    g_pass += 1
    println("  [PASS] " + label)
end

func bad(string label, string detail)
    g_fail += 1
    println("  [FAIL] " + label + " :: " + detail)
end

func expectI(int got, int want, string label)
    if got == want then
        ok(label)
    else
        bad(label, "got " + string(got) + " want " + string(want))
    end
end

func expectF(float got, float want, string label)
    if math.abs(got - want) < 0.001 then
        ok(label)
    else
        bad(label, "got " + string.formatFloat(got, ".4") + " want " + string.formatFloat(want, ".4"))
    end
end

func expectS(string got, string want, string label)
    if got == want then
        ok(label)
    else
        bad(label, "got '" + got + "' want '" + want + "'")
    end
end

// ============================================================
// 1. Shape：基类
//    - static 计数（live/made/destroyed）
//    - protected name、private id
//    - virtual area()、virtual get type
//    - destroy 析构
//    - describe()：基类方法，内部通过 self.type / self.area() 触发 vtable 派发
// ============================================================
class Shape
    static int live = 0
    static int made = 0
    static int destroyed = 0

    public string tag = "shape-tag"
    protected string name = "shape"
    private int id = 0

    create(string name)
        Shape.live += 1
        Shape.made += 1
        self.id = Shape.made
        self.name = name
    end

    destroy()
        Shape.live -= 1
        Shape.destroyed += 1
    end

    virtual func area() as float
        return 0.0
    end

    virtual get type() as string
        return "shape:" + self.name
    end

    // 基类方法：内部通过 self.type / self.area() 调用，
    // 实际运行时按实例真实类型派发到 override。
    func describe() as string
        return self.type + " area=" + string.formatFloat(self.area(), ".4")
    end

    func idOf() as int
        return self.id
    end

    func nameOf() as string
        return self.name
    end

    static func total() as int
        return Shape.live
    end

    static func madeCount() as int
        return Shape.made
    end

    static func destroyedCount() as int
        return Shape.destroyed
    end
end

// ============================================================
// 2. Circle extends Shape
//    - base(name) 调用父类构造
//    - override area()、override get type
//    - final density()：子类不可再 override
// ============================================================
class Circle extends Shape
    public float radius = 1.0

    create(string name, float r)
        base(name)
        self.radius = r
    end

    override func area() as float
        return 3.14159 * self.radius * self.radius
    end

    override get type() as string
        return "circle:" + self.name
    end

    final func density() as float
        return 1.0
    end

    // 访问从 Shape 继承的 protected 字段 name（验证 protected 跨层可见）
    func protectedName() as string
        return self.name
    end

    func radiusOf() as float
        return self.radius
    end
end

// ============================================================
// 3. Cylinder extends Circle
//    - base(name, r) 链式调用 Circle 构造（验证 base 跨多层）
//    - override area()、override get type
//    - final density() 继承自 Circle，不可 override（验证可继承调用）
// ============================================================
class Cylinder extends Circle
    public float height = 1.0

    create(string name, float r, float h)
        base(name, r)
        self.height = h
    end

    override func area() as float
        float base2 = 2.0 * 3.14159 * self.radius * self.radius
        float side = 2.0 * 3.14159 * self.radius * self.height
        return base2 + side
    end

    override get type() as string
        return "cylinder:" + self.name
    end

    func heightOf() as float
        return self.height
    end
end

// ============================================================
// 用例 1：继承链 + base() 链式构造
// ============================================================
func testInheritanceChain()
    println("[1] inheritance chain + base() ctor chaining")
    try
        Circle c = Circle("alpha", 2.0)
        Cylinder cy = Cylinder("beta", 2.0, 3.0)

        // name 经 base(name) 一路传到 Shape，protected 字段可经子类方法读出
        expectS(c.protectedName(), "alpha", "Circle base(name) -> Shape.name")
        expectS(cy.protectedName(), "beta",  "Cylinder base(name,r) -> Circle -> Shape.name")

        // 默认初始化字段
        expectF(c.radiusOf(), 2.0, "Circle.radius default from ctor arg")
        expectF(cy.radiusOf(), 2.0, "Cylinder inherits Circle.radius")
        expectF(cy.heightOf(), 3.0, "Cylinder.height default from ctor arg")

        // private id 由 Shape 内部分配，每个实例唯一
        int idC = c.idOf()
        int idCy = cy.idOf()
        if idC != idCy then
            ok("private id unique per instance (" + string(idC) + " != " + string(idCy) + ")")
        else
            bad("private id unique", "both id=" + string(idC))
        end
    catch e
        bad("inheritance chain", e.message)
    end
end

// ============================================================
// 用例 2：public / private / protected 访问控制
// ============================================================
func testAccessControl()
    println("[2] access control: public / private / protected")
    try
        Circle c = Circle("acc", 1.0)
        Cylinder cy = Cylinder("acc2", 1.0, 1.0)

        // public 字段：外部可直接读写
        c.radius = 5.0
        expectF(c.radius, 5.0, "public field Circle.radius read/write")
        cy.height = 9.0
        expectF(cy.height, 9.0, "public field Cylinder.height read/write")
        expectS(c.tag, "shape-tag", "public field Shape.tag inherited default")
        c.tag = "T"
        expectS(c.tag, "T", "public field Shape.tag write via subclass instance")

        // private 字段：只能在声明它的 Shape 内访问；外部经 Shape 内方法读出
        expectI(c.idOf(), c.idOf(), "private id accessible via Shape method (idOf)")

        // protected 字段：声明在 Shape，子类方法可访问
        expectS(c.protectedName(), "acc",  "protected name read in Circle method")
        expectS(cy.protectedName(), "acc2", "protected name read in Cylinder method (2 levels)")
    catch e
        bad("access control", e.message)
    end
end

// ============================================================
// 用例 3：static 字段与方法（类名访问）
// ============================================================
func testStaticMembers()
    println("[3] static field / method (via class name)")
    try
        int madeBefore = Shape.madeCount()

        // static 字段经类名读写
        Shape.live = Shape.live + 0
        // static 方法经类名调用
        int liveSnap = Shape.total()

        // 新建实例 -> live/made 同步 +1
        Cylinder cy = Cylinder("static-probe", 1.0, 1.0)
        expectI(Shape.madeCount(), madeBefore + 1, "static made++ on new instance")
        expectI(Shape.total(), liveSnap + 1,     "static live++ on new instance")
        expectI(Shape.total(), Shape.live,       "Shape.total() == Shape.live")

        // static 字段直接经类名写
        Shape.live = Shape.live
        expectI(Shape.total(), Shape.live, "static field stays consistent after class-name write")
    catch e
        bad("static members", e.message)
    end
end

// ============================================================
// 用例 4 + 5：virtual/override 方法与属性（直接调用）
// ============================================================
func testVirtualOverrideDirect()
    println("[4] virtual / override method (direct call)")
    try
        Shape sh = Shape("plain")
        Circle c = Circle("ring", 2.0)
        Cylinder cy = Cylinder("drum", 2.0, 3.0)

        // area() 直接调用，按各自实现
        expectF(sh.area(), 0.0, "Shape.area() base returns 0.0")
        expectF(c.area(), 12.5664, "Circle.area() override = pi*r^2")
        expectF(cy.area(), 62.8318, "Cylinder.area() override = 2*pi*r*(r+h)")
    catch e
        bad("virtual override direct", e.message)
    end

    println("[5] virtual / override property get (direct call)")
    try
        Shape sh = Shape("plain")
        Circle c = Circle("ring", 2.0)
        Cylinder cy = Cylinder("drum", 2.0, 3.0)

        expectS(sh.type, "shape:plain",   "Shape.type virtual get base")
        expectS(c.type,  "circle:ring",   "Circle.type override get")
        expectS(cy.type, "cylinder:drum", "Cylinder.type override get")
    catch e
        bad("virtual property direct", e.message)
    end
end

// ============================================================
// 用例 6：vtable 动态派发
//   正常写法：向上转型 Shape s = Circle(...)，通过基类变量调用 virtual 方法/属性，
//   必须按实例真实类型派发到 Circle / Cylinder 的 override（而不是 Shape 的 base）。
//   另保留 describe()（基类方法内 self.xxx()）作为「内部派发」路径的补充验证。
// ============================================================
func testVtableDispatch()
    println("[6] vtable dispatch via upcast (Shape s = Circle(...))")
    try
        // 向上转型：派生类实例赋值给基类类型变量
        Shape sh = Shape("plain")
        Shape c = Circle("ring", 2.0)
        Shape cy = Cylinder("drum", 2.0, 3.0)

        // virtual 方法 area()：经基类变量调用，按实例真实类型派发
        expectF(sh.area(), 0.0, "Shape.area() base (Shape s = Shape)")
        expectF(c.area(), 12.5664, "Shape s = Circle; s.area() -> Circle override")
        expectF(cy.area(), 62.8318, "Shape s = Cylinder; s.area() -> Cylinder override (2 levels)")

        // virtual 属性 get type：同样按实例真实类型派发
        expectS(sh.type, "shape:plain", "Shape s = Shape; s.type base")
        expectS(c.type, "circle:ring", "Shape s = Circle; s.type -> Circle override")
        expectS(cy.type, "cylinder:drum", "Shape s = Cylinder; s.type -> Cylinder override")

        // 补充：基类方法 describe() 内部经 self.xxx() 派发（内部派发路径）
        expectS(sh.describe(), "shape:plain area=0.0000", "Shape.describe() -> base")
        expectS(c.describe(), "circle:ring area=12.5664", "Circle via describe() internal dispatch")
        expectS(cy.describe(), "cylinder:drum area=62.8318", "Cylinder via describe() internal dispatch (2 levels)")

        // 同一个基类方法 describe()（基类定义），三种实例三种结果 -> 证明动态派发
        string a = sh.describe()
        string b = c.describe()
        string d = cy.describe()
        if a != b and b != d and a != d then
            ok("single base method describe() yields 3 distinct results -> vtable works")
        else
            bad("vtable distinct", "results collided")
        end
    catch e
        bad("vtable dispatch", e.message)
    end
end

// ============================================================
// 用例 7：final 方法（继承并可调用，不可再 override）
// ============================================================
func testFinalMethod()
    println("[7] final method: inherited and callable, not overridable")
    try
        Circle c = Circle("fin", 4.0)
        Cylinder cy = Cylinder("fin2", 4.0, 5.0)

        // density 定义在 Circle 为 final；Cylinder 继承后可调用
        expectF(c.density(), 1.0,  "Circle.density() final method")
        expectF(cy.density(), 1.0, "Cylinder inherits final density() (not re-overridden)")

        // NOTE: final 不可 override 是编译期约束。本工具为保 EXIT=0 不能写
        // 「故意 override density」的负面用例（会编译失败）；详见 README.md。
        println("  [NOTE] final non-override rule is compile-time enforced (not testable here)")
    catch e
        bad("final method", e.message)
    end
end

// ============================================================
// 用例 8：destroy 析构生命周期
//   在子函数作用域内创建实例，函数返回时实例应被 destroy。
// ============================================================
func makeAndDrop(int n)
    if n > 0 then
        Cylinder tmp = Cylinder("tmp-" + string(n), 1.0, 1.0)
        // 递归构造一层，验证多实例析构
        makeAndDrop(n - 1)
    end
end

func testDestroyLifecycle()
    println("[8] destroy lifecycle")
    try
        int made0 = Shape.madeCount()
        int dest0 = Shape.destroyedCount()
        int live0 = Shape.total()

        makeAndDrop(3)

        int made1 = Shape.madeCount()
        int dest1 = Shape.destroyedCount()
        int live1 = Shape.total()

        expectI(made1, made0 + 3, "3 instances created inside scope")
        expectI(dest1, dest0 + 3, "3 instances destroyed on scope exit")
        expectI(live1, live0,     "live count returns to baseline after scope exit")
    catch e
        bad("destroy lifecycle", e.message)
    end
end

// ============================================================
// 镜像层级（无 destroy）：用于 vtable 的「函数参数多态」与「var 装箱 downcast」探针。
//   带 destroy 的 class（Shape/Circle/Cylinder）被视为不可复制资源，既不能按值
//   传入函数（func f(Shape s) 非法），也不能装箱进 var；故另建一对无 destroy 的
//   ProbeBase / ProbeDerived 来承载这两条 vtable 派发路径。
// ============================================================
class ProbeBase
    virtual func area() as float
        return 0.0
    end
end

class ProbeDerived extends ProbeBase
    float radius = 2.0
    override func area() as float
        return 3.14159 * self.radius * self.radius
    end
end

// 函数参数多态：形参为基类 ProbeBase，可接收 ProbeDerived 实参并保留 vtable 派发。
func probeArea(ProbeBase b) as float
    return b.area()
end

// ============================================================
// 用例 9：函数参数多态 + var 装箱 downcast 的派发验证
//   (a) func probeArea(ProbeBase b) 传 ProbeDerived -> b.area() 派发到 override
//   (b) ProbeDerived 装入 var 后 is ProbeBase 成立、as ProbeBase 成功，
//       并且通过 ProbeBase 类型变量调用 virtual area() 仍派发到派生类实现。
// ============================================================
func testPolymorphismDispatch()
    println("[9] function-param polymorphism + var-box downcast dispatch")
    try
        ProbeBase base = ProbeBase()
        ProbeDerived d = ProbeDerived()

        // 直接类型化调用：派发正确（控制组）
        float direct = d.area()
        expectF(direct, 12.5664, "typed ProbeDerived.area() direct dispatch (control)")

        // (a) 函数参数多态：传派生类实参给基类形参，调用 override
        expectF(probeArea(base), 0.0, "probeArea(ProbeBase) -> base area")
        expectF(probeArea(d), 12.5664, "probeArea(ProbeDerived) -> override area (param polymorphism)")

        // (b) 装入 var（无 destroy 的 class 允许装箱）
        var boxed = d
        bool isBase = false
        if boxed is ProbeBase then
            isBase = true
            ProbeBase b = boxed as ProbeBase
            float viaBase = b.area()
            // SH1 已修复：经 var 往返后 vtable 派发仍保留，返回 override 值
            expectF(viaBase, 12.5664, "var -> as ProbeBase -> b.area() preserves override (SH1 fixed)")
        else
            bad("boxed is ProbeBase", "downcast precondition failed")
        end
        if isBase then
            println("  [PASS] var->ProbeBase downcast preserves vtable dispatch")
        end
    catch e
        bad("polymorphism dispatch", e.message)
    end
end

// ============================================================
// 入口
// ============================================================
func main(...) as int
    println("=== shapes: inheritance hierarchy verification suite ===")
    println("(Shape > Circle > Cylinder : public/private/protected, static, virtual/override/final, base, destroy)")
    println("")

    testInheritanceChain()
    testAccessControl()
    testStaticMembers()
    testVirtualOverrideDirect()
    testVtableDispatch()
    testFinalMethod()
    testDestroyLifecycle()
    testPolymorphismDispatch()

    println("")
    println("--- polymorphism paths ---")
    println("upcast:        Shape s = Circle(...) -> s.area() dispatches to override")
    println("func param:    func f(ProbeBase b); f(ProbeDerived) -> dispatches to override")
    println("var downcast:  var -> as ProbeBase -> b.virtualMethod() preserves override")
    println("")
    println("total passed=" + string(g_pass) + " failed=" + string(g_fail))
    return 0
end
