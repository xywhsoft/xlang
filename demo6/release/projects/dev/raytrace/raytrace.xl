// raytrace - 光线追踪渲染器（Ray Tracer）
//
// "Ray Tracing in One Weekend" 教程的 xlang 实现，综合验证：
//   * float 浮点运算（数百万次光线-物体求交、反射/折射计算）
//   * class 运算符协议（Vec3 / Color 全套 __add__/__sub__/__mul__/__div__/__neg__）
//   * class 继承 + virtual/override（Material / Shape 抽象基类）
//   * 递归性能（traceRay 每像素递归 MAX_DEPTH 层）
//   * 多态容器的运行时派发（见下文「多态存储说明」）
//
// 多态存储说明：
//   class 使用受管理引用语义。World 通过 array<Shape> 保存几何体，命中记录和
//   几何体通过 Material 基类引用保存材质；向上转型不会复制或切片派生对象。
//
// 用法：
//   raytrace                              打印用法
//   raytrace render [w] [h] [s] [out]     渲染预设场景到 PPM 文件
//                                          w=宽度 h=高度 s=每像素采样数 out=输出文件
//                                          默认 200 150 10 raytrace_out.ppm
//   raytrace demo                         渲染默认场景 (200x150x10 -> demo.ppm)
//   raytrace bench [w] [h] [s]            性能测试，输出耗时与吞吐
//                                          默认 100 75 5
//   raytrace test                         运行几何、材质和多态自测
//
// 验证：
//   cd /d D:\GIT\x-lang\demo6\release
//   xl run projects\dev\raytrace\raytrace.xl render 100 75 5
//   xl build projects\dev\raytrace\raytrace.xl -o projects\dev\raytrace\raytrace.exe
//
// PPM 文件格式：ASCII (P3)，可用 GIMP / ImageMagick / 在线查看器打开。

// ========================================================================
// 全局常量
// ========================================================================
float INF = 1.0e30
int MAX_DEPTH = 25
float PI = 3.14159265358979323846

// ========================================================================
// 随机数辅助：xlang 的 random 模块只提供 u32/u64/range（整数），
// 这里包装出 [0,1) 与区间均匀随机 float。
// ========================================================================
func randF() as float
    return float(random.u32()) / 4294967296.0
end

func randRange(float lo, float hi) as float
    return lo + (hi - lo) * randF()
end

// 单位球内随机向量（用于 Lambertian 漫反射和 Metal fuzz）
func randInUnitSphere() as Vec3
    int guard = 0
    while guard < 64 do
        Vec3 p = Vec3(randRange(-1.0, 1.0), randRange(-1.0, 1.0), randRange(-1.0, 1.0))
        if p.lengthSquared() < 1.0 then
            return p
        end
        guard = guard + 1
    end
    // fallback：用单位球面上的点
    return randUnitVector()
end

// 单位球面随机向量（均匀分布）
func randUnitVector() as Vec3
    float a = randRange(0.0, PI * 2.0)
    float z = randRange(-1.0, 1.0)
    float r = math.sqrt(1.0 - z * z)
    Vec3 v = Vec3(r * math.cos(a), r * math.sin(a), z)
    return v
end

// 单位圆盘随机向量（用于景深 jitter）
func randInUnitDisk() as Vec3
    int guard = 0
    while guard < 64 do
        Vec3 p = Vec3(randRange(-1.0, 1.0), randRange(-1.0, 1.0), 0.0)
        if p.lengthSquared() < 1.0 then
            return p
        end
        guard = guard + 1
    end
    return Vec3(0.0, 0.0, 0.0)
end

func clampF(float v, float lo, float hi) as float
    return math.clamp(v, lo, hi)
end

func degToRad(float deg) as float
    return deg * PI / 180.0
end

// ========================================================================
// Vec3：三维向量，完整运算符协议
// ========================================================================
class Vec3
    derive value
    float x = 0.0
    float y = 0.0
    float z = 0.0

    create(float x, float y, float z)
        self.x = x
        self.y = y
        self.z = z
    end

    func __add__(Vec3 o) as Vec3
        Vec3 r = Vec3(self.x + o.x, self.y + o.y, self.z + o.z)
        return r
    end

    func __sub__(Vec3 o) as Vec3
        Vec3 r = Vec3(self.x - o.x, self.y - o.y, self.z - o.z)
        return r
    end

    func __neg__() as Vec3
        Vec3 r = Vec3(0.0 - self.x, 0.0 - self.y, 0.0 - self.z)
        return r
    end

    func __mul__(float s) as Vec3
        Vec3 r = Vec3(self.x * s, self.y * s, self.z * s)
        return r
    end

    func __mul__(Vec3 o) as Vec3
        Vec3 r = Vec3(self.x * o.x, self.y * o.y, self.z * o.z)
        return r
    end

    func __div__(float s) as Vec3
        Vec3 r = Vec3(self.x / s, self.y / s, self.z / s)
        return r
    end

    func dot(Vec3 o) as float
        return self.x * o.x + self.y * o.y + self.z * o.z
    end

    func cross(Vec3 o) as Vec3
        Vec3 r = Vec3(
            self.y * o.z - self.z * o.y,
            self.z * o.x - self.x * o.z,
            self.x * o.y - self.y * o.x
        )
        return r
    end

    func lengthSquared() as float
        return self.x * self.x + self.y * self.y + self.z * self.z
    end

    func length() as float
        return math.sqrt(self.lengthSquared())
    end

    func normalize() as Vec3
        float len = self.length()
        if len <= 0.0 then
            Vec3 z = Vec3(0.0, 0.0, 0.0)
            return z
        end
        Vec3 r = self * (1.0 / len)
        return r
    end

    // 反射：v - 2 * dot(v,n) * n
    func reflect(Vec3 n) as Vec3
        float d = self.dot(n)
        Vec3 r = self - n * (2.0 * d)
        return r
    end

    // 折射（Snell 定律向量化形式）
    func refract(Vec3 n, float etaiOverEtat) as Vec3
        Vec3 negSelf = -self
        float cosTheta = math.min(negSelf.dot(n), 1.0)
        Vec3 rOutPerp = (self + n * cosTheta) * etaiOverEtat
        float perpLen2 = rOutPerp.lengthSquared()
        float disc = 1.0 - perpLen2
        if disc < 0.0 then
            // 内部全反射回退：返回反射方向
            return self.reflect(n)
        end
        Vec3 rOutParallel = n * (0.0 - math.sqrt(disc))
        Vec3 r = rOutPerp + rOutParallel
        return r
    end

    // 用于判断反射方向是否近似零向量
    func nearZero() as bool
        float eps = 1e-8
        bool bx = math.abs(self.x) < eps
        bool by = math.abs(self.y) < eps
        bool bz = math.abs(self.z) < eps
        return bx and by and bz
    end
end

// ========================================================================
// Color：RGB 颜色（基于 Vec3 的同构类型，独立 class 携带 gamma/字节转换）
// ========================================================================
class Color
    derive value
    float r = 0.0
    float g = 0.0
    float b = 0.0

    create(float r, float g, float b)
        self.r = r
        self.g = g
        self.b = b
    end

    func __add__(Color o) as Color
        Color c = Color(self.r + o.r, self.g + o.g, self.b + o.b)
        return c
    end

    // 颜色乘颜色（Hadamard 积，用于光照衰减）
    func __mul__(Color o) as Color
        Color c = Color(self.r * o.r, self.g * o.g, self.b * o.b)
        return c
    end

    // 颜色乘标量
    func __mul__(float s) as Color
        Color c = Color(self.r * s, self.g * s, self.b * s)
        return c
    end

    func __div__(float s) as Color
        Color c = Color(self.r / s, self.g / s, self.b / s)
        return c
    end

    // 应用 gamma 校正后转换为 [0,255] 字节三元组（gamma=2 时用 sqrt 快速路径）
    func toBytes(float invGamma) as (int, int, int)
        float rr = clampF(self.r, 0.0, 1.0)
        float gg = clampF(self.g, 0.0, 1.0)
        float bb = clampF(self.b, 0.0, 1.0)
        if invGamma == 0.5 then
            rr = math.sqrt(rr)
            gg = math.sqrt(gg)
            bb = math.sqrt(bb)
        else
            rr = math.pow(rr, invGamma)
            gg = math.pow(gg, invGamma)
            bb = math.pow(bb, invGamma)
        end
        int ir = int(rr * 255.999)
        int ig = int(gg * 255.999)
        int ib = int(bb * 255.999)
        if ir > 255 then ir = 255 end
        if ig > 255 then ig = 255 end
        if ib > 255 then ib = 255 end
        if ir < 0 then ir = 0 end
        if ig < 0 then ig = 0 end
        if ib < 0 then ib = 0 end
        return ir, ig, ib
    end
end

// 常用颜色快捷构造
func colorWhite() as Color
    Color c = Color(1.0, 1.0, 1.0)
    return c
end
func colorBlack() as Color
    Color c = Color(0.0, 0.0, 0.0)
    return c
end
func colorSky(float t) as Color
    // 上蓝下白的天空渐变
    Color c = Color((1.0 - t) * 1.0 + t * 0.5, (1.0 - t) * 1.0 + t * 0.7, 1.0)
    return c
end

// ========================================================================
// Ray：光线（origin + direction）
// ========================================================================
class Ray
    Vec3 origin = Vec3(0.0, 0.0, 0.0)
    Vec3 dir = Vec3(0.0, 0.0, 0.0)

    create(Vec3 origin, Vec3 direction)
        self.origin = origin
        self.dir = direction
    end

    func at(float t) as Vec3
        Vec3 p = self.origin + self.dir * t
        return p
    end
end

// ========================================================================
// HitRecord：光线-物体相交记录，mat 保留实际材质对象的动态类型。
// ========================================================================
class HitRecord
    float t = 0.0
    Vec3 p = Vec3(0.0, 0.0, 0.0)
    Vec3 normal = Vec3(0.0, 0.0, 0.0)
    bool frontFace = false
    Material mat = null

    // 根据光线方向决定法线朝外（始终指向入射侧）
    func setFaceNormal(Ray r, Vec3 outwardNormal)
        self.frontFace = r.dir.dot(outwardNormal) < 0.0
        if self.frontFace then
            self.normal = outwardNormal
        else
            self.normal = -outwardNormal
        end
    end
end

// ========================================================================
// Material 抽象基类 + 三种材质
//   注意：scatter 经 vtable 派发到子类 override。Material 实例不直接使用。
// ========================================================================
class Material
    virtual func scatter(Ray r, HitRecord rec) as (bool, Ray, Color)
        Vec3 zeroV = Vec3(0.0, 0.0, 0.0)
        Ray zero = Ray(zeroV, zeroV)
        return false, zero, colorBlack()
    end

    virtual func emissive() as Color
        return colorBlack()
    end
end

// Lambertian 漫反射：随机方向散射
class Lambertian extends Material
    Color albedo = Color(0.0, 0.0, 0.0)

    create(Color albedo)
        self.albedo = albedo
    end

    override func scatter(Ray r, HitRecord rec) as (bool, Ray, Color)
        Vec3 scatterDir = rec.normal + randUnitVector()
        if scatterDir.nearZero() then
            scatterDir = rec.normal
        end
        Ray scattered = Ray(rec.p, scatterDir.normalize())
        return true, scattered, self.albedo
    end
end

// Metal 金属反射：理想反射 + 模糊球（fuzz）
class Metal extends Material
    Color albedo = Color(0.0, 0.0, 0.0)
    float fuzz = 0.0

    create(Color albedo, float fuzz)
        self.albedo = albedo
        self.fuzz = clampF(fuzz, 0.0, 1.0)
    end

    override func scatter(Ray r, HitRecord rec) as (bool, Ray, Color)
        Vec3 d = r.dir.normalize()
        Vec3 reflected = d.reflect(rec.normal)
        Vec3 jitter = randInUnitSphere() * self.fuzz
        Vec3 sum = reflected + jitter
        Vec3 outDir = sum.normalize()
        Ray scattered = Ray(rec.p, outDir)
        bool ok = scattered.dir.dot(rec.normal) > 0.0
        return ok, scattered, self.albedo
    end
end

// Dielectric 电介质（玻璃）：Schlick 近似反射率 + Snell 折射
class Dielectric extends Material
    float ir = 1.5

    create(float ir)
        self.ir = ir
    end

    func reflectance(float cosTheta, float refIdx) as float
        float r0 = (1.0 - refIdx) / (1.0 + refIdx)
        r0 = r0 * r0
        float m = 1.0 - cosTheta
        float m2 = m * m
        float m4 = m2 * m2
        float m5 = m4 * m
        return r0 + (1.0 - r0) * m5
    end

    override func scatter(Ray r, HitRecord rec) as (bool, Ray, Color)
        float refractionRatio = self.ir
        if rec.frontFace then
            refractionRatio = 1.0 / self.ir
        end
        Vec3 unitDir = r.dir.normalize()
        Vec3 negUnit = -unitDir
        float cosTheta = math.min(negUnit.dot(rec.normal), 1.0)
        float sinTheta = math.sqrt(1.0 - cosTheta * cosTheta)
        bool cannotRefract = refractionRatio * sinTheta > 1.0
        bool schlickReflect = self.reflectance(cosTheta, refractionRatio) > randF()
        Vec3 direction = Vec3(0.0, 0.0, 0.0)
        if cannotRefract or schlickReflect then
            direction = unitDir.reflect(rec.normal)
        else
            direction = unitDir.refract(rec.normal, refractionRatio)
        end
        Ray scattered = Ray(rec.p, direction.normalize())
        return true, scattered, colorWhite()
    end
end

// ========================================================================
// Shape 抽象基类 + Sphere / Plane
//   hit 返回 (bool, HitRecord)；不命中返回 (false, HitRecord())。
// ========================================================================
class Shape
    virtual func hit(Ray r, float tMin, float tMax) as (bool, HitRecord)
        HitRecord empty = HitRecord()
        return false, empty
    end
end

// Sphere 球体（含中心、半径、材质）
class Sphere extends Shape
    Vec3 center = Vec3(0.0, 0.0, 0.0)
    float radius = 1.0
    Material mat = null

    create(Vec3 center, float radius, Material mat)
        self.center = center
        self.radius = radius
        self.mat = mat
    end

    override func hit(Ray r, float tMin, float tMax) as (bool, HitRecord)
        Vec3 oc = r.origin - self.center
        float a = r.dir.lengthSquared()
        float halfB = oc.dot(r.dir)
        float c = oc.lengthSquared() - self.radius * self.radius
        float disc = halfB * halfB - a * c
        HitRecord miss = HitRecord()
        if disc < 0.0 then
            return false, miss
        end
        float sqrtD = math.sqrt(disc)
        float root = (0.0 - halfB - sqrtD) / a
        bool found = false
        if root > tMin and root < tMax then
            found = true
        else
            root = (0.0 - halfB + sqrtD) / a
            if root > tMin and root < tMax then
                found = true
            end
        end
        if not found then
            return false, miss
        end
        HitRecord rec = HitRecord()
        rec.t = root
        rec.p = r.at(root)
        Vec3 delta = rec.p - self.center
        Vec3 outward = delta / self.radius
        rec.setFaceNormal(r, outward)
        rec.mat = self.mat
        return true, rec
    end
end

// Plane 平面：点 + 法线定义的无限平面
class Plane extends Shape
    Vec3 point = Vec3(0.0, 0.0, 0.0)
    Vec3 normal = Vec3(0.0, 1.0, 0.0)
    Material mat = null

    create(Vec3 point, Vec3 normal, Material mat)
        self.point = point
        self.normal = normal.normalize()
        self.mat = mat
    end

    override func hit(Ray r, float tMin, float tMax) as (bool, HitRecord)
        float denom = r.dir.dot(self.normal)
        HitRecord miss = HitRecord()
        if math.abs(denom) < 1e-9 then
            return false, miss
        end
        Vec3 diff = self.point - r.origin
        float t = diff.dot(self.normal) / denom
        if t <= tMin or t >= tMax then
            return false, miss
        end
        HitRecord rec = HitRecord()
        rec.t = t
        rec.p = r.at(t)
        rec.setFaceNormal(r, self.normal)
        rec.mat = self.mat
        return true, rec
    end
end

// ========================================================================
// World：场景，封装 array<Shape> + 最近相交查找。
// ========================================================================
class World
    array<Shape> shapes = array<Shape>[]

    func add(Shape s)
        self.shapes.append(s)
    end

    func size() as int
        return self.shapes.length
    end

    // 查找最近相交；返回 (bool, HitRecord)
    func hit(Ray r, float tMin, float tMax) as (bool, HitRecord)
        bool anyHit = false
        float closest = tMax
        HitRecord closestRec = HitRecord()
        int n = self.shapes.length
        int i = 0
        while i < n do
            Shape s = self.shapes[i]
            bool hit
            HitRecord rec
            hit, rec = s.hit(r, tMin, closest)
            if hit then
                anyHit = true
                closest = rec.t
                closestRec = rec
            end
            i = i + 1
        end
        return anyHit, closestRec
    end
end

// ========================================================================
// Camera：透视相机（视场、光圈/景深、抗锯齿采样）
// ========================================================================
class Camera
    Vec3 origin = Vec3(0.0, 0.0, 0.0)
    Vec3 lowerLeftCorner = Vec3(0.0, 0.0, 0.0)
    Vec3 horizontal = Vec3(0.0, 0.0, 0.0)
    Vec3 vertical = Vec3(0.0, 0.0, 0.0)
    Vec3 u = Vec3(1.0, 0.0, 0.0)
    Vec3 v = Vec3(0.0, 1.0, 0.0)
    Vec3 w = Vec3(0.0, 0.0, 1.0)
    float lensRadius = 0.0

    create(Vec3 lookFrom, Vec3 lookAt, Vec3 vup, float vfovDeg, float aspect, float aperture, float focusDist)
        float theta = degToRad(vfovDeg)
        float h = math.tan(theta * 0.5)
        float viewportH = 2.0 * h
        float viewportW = aspect * viewportH
        self.origin = lookFrom
        self.lensRadius = aperture * 0.5
        Vec3 forward = lookFrom - lookAt
        self.w = forward.normalize()
        Vec3 crossU = vup.cross(self.w)
        self.u = crossU.normalize()
        self.v = self.w.cross(self.u)
        Vec3 hu = self.u * viewportW
        Vec3 hv = self.v * viewportH
        self.horizontal = hu * focusDist
        self.vertical = hv * focusDist
        Vec3 scaledW = self.w * focusDist
        Vec3 originMinusW = self.origin - scaledW
        Vec3 halfH = self.horizontal * 0.5
        Vec3 halfV = self.vertical * 0.5
        Vec3 corner = originMinusW - halfH
        self.lowerLeftCorner = corner - halfV
    end

    // 根据 (s, t) ∈ [0,1]² 生成一条带景深抖动的光线
    func getRay(float s, float t) as Ray
        Vec3 rd = randInUnitDisk() * self.lensRadius
        Vec3 ux = self.u * rd.x
        Vec3 vy = self.v * rd.y
        Vec3 offset = ux + vy
        Vec3 originOff = self.origin + offset
        Vec3 hs = self.horizontal * s
        Vec3 vt = self.vertical * t
        Vec3 target = self.lowerLeftCorner + hs
        target = target + vt
        Vec3 rayDir = target - originOff
        Ray r = Ray(originOff, rayDir)
        return r
    end
end

// ========================================================================
// 着色：递归追踪光线
// ========================================================================

// 未命中时返回天空背景色（按 y 方向线性插值）
func skyColor(Vec3 direction) as Color
    float t = 0.5 * (direction.y + 1.0)
    return colorSky(t)
end

// 递归追踪单条光线
func traceRay(Ray r, World world, int depth) as Color
    if depth <= 0 then
        return colorBlack()
    end
    bool hit
    HitRecord rec
    hit, rec = world.hit(r, 0.001, INF)
    if not hit then
        return skyColor(r.dir.normalize())
    end
    Material mat = rec.mat
    bool scattered = false
    Vec3 zeroV = Vec3(0.0, 0.0, 0.0)
    Ray scatteredRay = Ray(zeroV, zeroV)
    Color attenuation = Color(0.0, 0.0, 0.0)
    scattered, scatteredRay, attenuation = mat.scatter(r, rec)
    if not scattered then
        return colorBlack()
    end
    Color deeper = traceRay(scatteredRay, world, depth - 1)
    Color result = attenuation * deeper
    return result
end

// ========================================================================
// 场景构造
//
// 场景构造函数返回 World 受管理引用；其中的 Shape / Material 动态类型保持不变。
// 中间对象使用具名变量，让场景配置更易读，也便于逐项调整材质参数。
// ========================================================================

// 经典三球 + 地面场景（"Ray Tracing in One Weekend"）
func buildClassicScene() as World
    World w = World()
    // 地面：超大球作为地板
    Color groundC = Color(0.5, 0.5, 0.5)
    Lambertian ground = Lambertian(groundC)
    Vec3 groundP = Vec3(0.0, -1000.0, 0.0)
    Sphere groundSphere = Sphere(groundP, 1000.0, ground)
    w.add(groundSphere)

    // 中央三个主球
    Color centerC = Color(0.1, 0.2, 0.5)
    Lambertian center = Lambertian(centerC)
    Dielectric glass = Dielectric(1.5)
    Color metalC = Color(0.8, 0.6, 0.2)
    Metal rightMetal = Metal(metalC, 0.0)

    Vec3 p1 = Vec3(0.0, 1.0, 0.0)
    Sphere s1 = Sphere(p1, 1.0, glass)
    w.add(s1)
    Vec3 p2 = Vec3(-2.0, 1.0, 0.0)
    Sphere s2 = Sphere(p2, 1.0, center)
    w.add(s2)
    Vec3 p3 = Vec3(2.0, 1.0, 0.0)
    Sphere s3 = Sphere(p3, 1.0, rightMetal)
    w.add(s3)

    // 玻璃球内的气泡（负半径）
    Dielectric bubble = Dielectric(1.5)
    Vec3 p4 = Vec3(0.0, 1.0, 0.0)
    Sphere s4 = Sphere(p4, 0.0 - 0.4, bubble)
    w.add(s4)
    return w
end

// 随机小球场景：左右两侧大量随机材质小球
func buildRandomScene() as World
    World w = World()
    Color groundC = Color(0.5, 0.5, 0.5)
    Lambertian ground = Lambertian(groundC)
    Vec3 groundP = Vec3(0.0, -1000.0, 0.0)
    Sphere groundSphere = Sphere(groundP, 1000.0, ground)
    w.add(groundSphere)

    int a = -4
    while a <= 4 do
        int b = -4
        while b <= 4 do
            float cx = float(a) + 0.9 * randF()
            float cz = float(b) + 0.9 * randF()
            // 距离 (4, 0.2, 0) 太近就跳过，给中央大球让位
            float dx = cx - 4.0
            float dz = cz - 0.0
            float dist2 = dx * dx + dz * dz + 0.04
            if dist2 > 0.81 then
                float chooseMat = randF()
                if chooseMat < 0.8 then
                    // 漫反射
                    float rr = randF() * randF()
                    float gg = randF() * randF()
                    float bb = randF() * randF()
                    Color c = Color(rr, gg, bb)
                    Lambertian lam = Lambertian(c)
                    Vec3 center = Vec3(cx, 0.2, cz)
                    Sphere s = Sphere(center, 0.2, lam)
                    w.add(s)
                elseif chooseMat < 0.95 then
                    // 金属
                    Color c = Color(randRange(0.5, 1.0), randRange(0.5, 1.0), randRange(0.5, 1.0))
                    Metal m = Metal(c, randRange(0.0, 0.5))
                    Vec3 center = Vec3(cx, 0.2, cz)
                    Sphere s = Sphere(center, 0.2, m)
                    w.add(s)
                else
                    // 玻璃
                    Dielectric d = Dielectric(1.5)
                    Vec3 center = Vec3(cx, 0.2, cz)
                    Sphere s = Sphere(center, 0.2, d)
                    w.add(s)
                end
            end
            b = b + 1
        end
        a = a + 1
    end

    // 中央三个大球
    Dielectric glass = Dielectric(1.5)
    Vec3 p1 = Vec3(0.0, 1.0, 0.0)
    Sphere s1 = Sphere(p1, 1.0, glass)
    w.add(s1)
    Color lamC = Color(0.4, 0.2, 0.1)
    Lambertian lam = Lambertian(lamC)
    Vec3 p2 = Vec3(-4.0, 1.0, 0.0)
    Sphere s2 = Sphere(p2, 1.0, lam)
    w.add(s2)
    Color metalC = Color(0.7, 0.6, 0.5)
    Metal m = Metal(metalC, 0.0)
    Vec3 p3 = Vec3(4.0, 1.0, 0.0)
    Sphere s3 = Sphere(p3, 1.0, m)
    w.add(s3)
    return w
end

// 简化场景：5 个球 + 平面（速度更快，用于默认 render）
func buildSimpleScene() as World
    World w = World()
    Color groundC = Color(0.4, 0.4, 0.4)
    Lambertian ground = Lambertian(groundC)
    Vec3 planePoint = Vec3(0.0, -1.0, 0.0)
    Vec3 planeNormal = Vec3(0.0, 1.0, 0.0)
    Plane floor = Plane(planePoint, planeNormal, ground)
    w.add(floor)

    Color redC = Color(0.7, 0.3, 0.3)
    Lambertian red = Lambertian(redC)
    Vec3 p1 = Vec3(-1.2, 0.0, -1.0)
    Sphere s1 = Sphere(p1, 1.0, red)
    w.add(s1)

    Color greenC = Color(0.2, 0.7, 0.3)
    Lambertian green = Lambertian(greenC)
    Vec3 p2 = Vec3(0.0, 0.0, -2.5)
    Sphere s2 = Sphere(p2, 1.0, green)
    w.add(s2)

    Color shinyC = Color(0.8, 0.8, 0.8)
    Metal shiny = Metal(shinyC, 0.05)
    Vec3 p3 = Vec3(1.2, 0.0, -1.0)
    Sphere s3 = Sphere(p3, 1.0, shiny)
    w.add(s3)

    Dielectric glass = Dielectric(1.5)
    Vec3 p4 = Vec3(0.0, 1.5, -3.0)
    Sphere s4 = Sphere(p4, 1.0, glass)
    w.add(s4)

    Color goldC = Color(0.9, 0.7, 0.2)
    Metal gold = Metal(goldC, 0.2)
    Vec3 p5 = Vec3(0.4, 0.2, 0.5)
    Sphere s5 = Sphere(p5, 0.2, gold)
    w.add(s5)

    return w
end

// ========================================================================
// 渲染入口
// ========================================================================

// 把一张图像渲染为 PPM 文本（按行存入 array<string>）
func renderImage(World world, Camera cam, int width, int height, int samples) as array<string>
    array<string> lines = array[]
    // PPM 头
    lines.append("P3")
    lines.append(string(width) + " " + string(height))
    lines.append("255")

    float invSamples = 1.0 / float(samples)
    float invGamma = 0.5

    int j = height - 1
    while j >= 0 do
        int i = 0
        string line = ""
        while i < width do
            float cr = 0.0
            float cg = 0.0
            float cb = 0.0
            int s = 0
            while s < samples do
                float u = (float(i) + randF()) / float(width - 1)
                float v = (float(j) + randF()) / float(height - 1)
                Ray r = cam.getRay(u, v)
                Color c = traceRay(r, world, MAX_DEPTH)
                cr = cr + c.r
                cg = cg + c.g
                cb = cb + c.b
                s = s + 1
            end
            Color sum = Color(cr * invSamples, cg * invSamples, cb * invSamples)
            int ir = 0
            int ig = 0
            int ib = 0
            ir, ig, ib = sum.toBytes(invGamma)
            if i > 0 then
                line = line + " "
            end
            line = line + string(ir) + " " + string(ig) + " " + string(ib)
            i = i + 1
        end
        lines.append(line)
        // 进度打印（每 10 行）
        if (height - 1 - j) % 10 == 0 then
            int done = height - 1 - j + 1
            println("[render] " + string(done) + "/" + string(height) + " rows")
        end
        j = j - 1
    end
    return lines
end

// 把行数组写入 PPM 文件
func writePpm(string path, array<string> lines)
    string body = string.join(lines, "\n")
    body = body + "\n"
    bool ok = file.writeText(path, body)
    if not ok then
        throw "failed to write PPM file: " + path
    end
end

// 解析整数参数（带默认值），非数字返回默认值
func parseArgInt(string s, int defValue) as int
    s = string.trim(s)
    if string.len(s) == 0 then
        return defValue
    end
    // 必须全部是数字（首位可以是 +/-）；逐字符校验避免 int("abc") 静默返回 0
    int start = 0
    string first = string.slice(s, 0, 1)
    if first == "-" or first == "+" then
        start = 1
        if string.len(s) == 1 then
            return defValue
        end
    end
    int i = start
    while i < string.len(s) do
        string ch = string.slice(s, i, 1)
        if string.indexOf("0123456789", ch) < 0 then
            return defValue
        end
        i = i + 1
    end
    return int(s)
end

// ========================================================================
// 命令处理
// ========================================================================

func printUsage()
    println("raytrace - xlang ray tracing renderer")
    println("usage:")
    println("  raytrace                                  show this help")
    println("  raytrace render [w] [h] [s] [out]         render simple scene to PPM")
    println("                                            w=width h=height s=samples out=output")
    println("                                            defaults: 200 150 10 raytrace_out.ppm")
    println("  raytrace demo                             render 200x150x10 -> demo.ppm")
    println("  raytrace bench [w] [h] [s]                benchmark, default 100 75 5")
    println("  raytrace test                             run geometry/material self-tests")
    println("algorithm: ray tracing with reflection/refraction, anti-aliasing, depth of field")
end

int g_rayPass = 0
int g_rayFail = 0

func rayCheck(string label, bool condition)
    if condition then
        g_rayPass += 1
        println("  [PASS] " + label)
    else
        g_rayFail += 1
        println("  [FAIL] " + label)
    end
end

func cmdTest() as int
    println("raytrace self-test")
    println("================================================================")
    random.seed(uint64(20260709), uint64(1))

    Color redColor = Color(0.7, 0.2, 0.1)
    Lambertian red = Lambertian(redColor)
    Vec3 center = Vec3(0.0, 0.0, -3.0)
    Sphere sphere = Sphere(center, 1.0, red)
    World world = World()
    world.add(sphere)

    rayCheck("typed world stores one Shape", world.size() == 1)
    Vec3 origin = Vec3(0.0, 0.0, 0.0)
    Vec3 forward = Vec3(0.0, 0.0, -1.0)
    Ray ray = Ray(origin, forward)
    bool hit = false
    HitRecord rec
    hit, rec = world.hit(ray, 0.001, INF)
    rayCheck("ray hits sphere through Shape vtable", hit)
    if hit then
        rayCheck("nearest sphere hit t is 2", math.abs(rec.t - 2.0) < 0.000001)
        rayCheck("hit record preserves Lambertian dynamic type", rec.mat is Lambertian)
        Lambertian actual = rec.mat as Lambertian
        rayCheck("material object preserves albedo", math.abs(actual.albedo.r - 0.7) < 0.000001)

        bool scattered = false
        Vec3 zero = Vec3(0.0, 0.0, 0.0)
        Ray scatteredRay = Ray(zero, zero)
        Color attenuation = colorBlack()
        Material material = rec.mat
        scattered, scatteredRay, attenuation = material.scatter(ray, rec)
        rayCheck("Lambertian scatter dispatch succeeds", scattered)
        rayCheck("scatter attenuation uses concrete material", math.abs(attenuation.r - 0.7) < 0.000001)
    end

    Vec3 upward = Vec3(0.0, 1.0, 0.0)
    Ray missRay = Ray(origin, upward)
    bool missed = false
    HitRecord missRec
    missed, missRec = world.hit(missRay, 0.001, INF)
    rayCheck("non-intersecting ray misses", not missed)

    World built = buildSimpleScene()
    rayCheck("scene factory returns complete typed world", built.size() == 6)

    println("----------------------------------------------------------------")
    println("passed=" + string(g_rayPass) + " failed=" + string(g_rayFail))
    if g_rayFail > 0 then
        return 1
    end
    return 0
end

func cmdRender(int width, int height, int samples, string outPath, int sceneChoice) as int
    if width < 2 or height < 2 then
        println("error: width and height must be >= 2")
        return 1
    end
    if samples < 1 then
        samples = 1
    end
    // 固定随机种子保证可复现
    random.seed(uint64(20260709), uint64(1))

    World world
    if sceneChoice == 1 then
        world = buildClassicScene()
    elseif sceneChoice == 2 then
        world = buildRandomScene()
    else
        world = buildSimpleScene()
    end

    float aspect = float(width) / float(height)
    Vec3 lookFrom = Vec3(8.0, 2.5, 5.0)
    Vec3 lookAt = Vec3(0.0, 0.5, 0.0)
    Vec3 vup = Vec3(0.0, 1.0, 0.0)
    float vfov = 35.0
    float aperture = 0.15
    float focusDist = 7.0
    if sceneChoice == 0 then
        // simple scene 用更近的相机
        Vec3 fromV = Vec3(0.0, 1.5, 4.0)
        Vec3 atV = Vec3(0.0, 0.2, -1.5)
        lookFrom = fromV
        lookAt = atV
        aperture = 0.05
        focusDist = 5.0
        vfov = 50.0
    end
    Camera cam = Camera(lookFrom, lookAt, vup, vfov, aspect, aperture, focusDist)

    println("[render] scene=" + string(sceneChoice) + " shapes=" + string(world.size()))
    println("[render] " + string(width) + "x" + string(height) + " samples=" + string(samples) + " -> " + outPath)
    float t0 = time.timer()
    array<string> lines = renderImage(world, cam, width, height, samples)
    float t1 = time.timer()
    writePpm(outPath, lines)
    float elapsed = t1 - t0
    int pixels = width * height
    int totalRays = pixels * samples
    println("[render] done in " + float.format(elapsed, ".3") + "s")
    println("[render] " + int.format(totalRays, ",") + " primary rays, " + float.format(float(totalRays) / elapsed, ",.0") + " rays/sec")
    println("[render] wrote " + int.format(string.len(string.join(lines, "")), ",") + " chars to " + outPath)
    return 0
end

func cmdBench(int width, int height, int samples) as int
    if width < 2 or height < 2 then
        width = 100
        height = 75
    end
    if samples < 1 then
        samples = 5
    end
    println("raytrace benchmark")
    println("================================================================")
    println("config: " + string(width) + "x" + string(height) + " samples=" + string(samples))
    println("================================================================")

    // 跑两轮：第一轮预热，第二轮计时
    int sceneChoice = 0
    int which = 0
    while which < 2 do
        random.seed(uint64(20260709), uint64(1))
        World world = buildSimpleScene()
        float aspect = float(width) / float(height)
        Vec3 lookFrom = Vec3(0.0, 1.5, 4.0)
        Vec3 lookAt = Vec3(0.0, 0.2, -1.5)
        Vec3 vup = Vec3(0.0, 1.0, 0.0)
        Camera cam = Camera(lookFrom, lookAt, vup, 50.0, aspect, 0.05, 5.0)

        string label = "run #" + string(which + 1)
        if which == 0 then
            label = label + " (warmup)"
        end
        float t0 = time.timer()
        array<string> lines = renderImage(world, cam, width, height, samples)
        float t1 = time.timer()
        float elapsed = t1 - t0
        int pixels = width * height
        int totalRays = pixels * samples
        float rps = 0.0
        if elapsed > 0.0 then
            rps = float(totalRays) / elapsed
        end
        float usPerRay = 0.0
        if totalRays > 0 then
            usPerRay = elapsed * 1000000.0 / float(totalRays)
        end
        string line = "  "
        line = line + string.padRight(label, 18)
        line = line + "time=" + float.format(elapsed, ".3") + "s"
        line = line + "  " + int.format(totalRays, ",") + " rays"
        line = line + "  " + float.format(usPerRay, ".3") + " us/ray"
        line = line + "  " + int.format(int(rps), ",") + " rays/sec"
        println(line)

        // 第一次跑把结果写出来作为功能校验
        if which == 0 then
            string outPath = "bench_" + string(width) + "x" + string(height) + "x" + string(samples) + ".ppm"
            writePpm(outPath, lines)
            println("  wrote " + outPath)
        end
        which = which + 1
    end
    println("================================================================")
    return 0
end

func main(...) as int
    if arg.length < 2 then
        printUsage()
        return 1
    end
    string cmd = string(arg[1])
    try
        if cmd == "-h" or cmd == "--help" or cmd == "help" then
            printUsage()
            return 0
        elseif cmd == "render" then
            int width = 200
            int height = 150
            int samples = 10
            if arg.length >= 3 then width = parseArgInt(string(arg[2]), 200) end
            if arg.length >= 4 then height = parseArgInt(string(arg[3]), 150) end
            if arg.length >= 5 then samples = parseArgInt(string(arg[4]), 10) end
            string outPath = "raytrace_out.ppm"
            if arg.length >= 6 then
                outPath = string(arg[5])
            end
            int sceneChoice = 0
            if arg.length >= 7 then
                sceneChoice = parseArgInt(string(arg[6]), 0)
            end
            return cmdRender(width, height, samples, outPath, sceneChoice)
        elseif cmd == "demo" then
            return cmdRender(200, 150, 10, "demo.ppm", 1)
        elseif cmd == "bench" then
            int width = 100
            int height = 75
            int samples = 5
            if arg.length >= 3 then width = parseArgInt(string(arg[2]), 100) end
            if arg.length >= 4 then height = parseArgInt(string(arg[3]), 75) end
            if arg.length >= 5 then samples = parseArgInt(string(arg[4]), 5) end
            return cmdBench(width, height, samples)
        elseif cmd == "test" then
            return cmdTest()
        else
            println("error: unknown command '" + cmd + "'")
            printUsage()
            return 1
        end
    catch e
        println("error: " + e.message)
        return 1
    end
    return 0
end
