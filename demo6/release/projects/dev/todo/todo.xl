// todo - 待办事项管理器
//
// 用法：
//   todo add "任务描述"   添加待办
//   todo list             列出所有待办（带编号、状态）
//   todo done <id>        标记指定 id 完成
//   todo remove <id>      删除指定 id
//   todo clear            清空所有已完成项
//
// 数据持久化到脚本同目录的 todos.json。
//
// 设计说明：
//   - TodoItem 用 class + derive value + derive json 定义。
//   - 集合直接用 array<TodoItem> + json.stringify(items, pretty=true) 整体落盘。
//   - 读回时用 json.parse 解析成 var 数组，逐项 json.parse::<TodoItem> 还原。
//   - array<TodoItem> 作为函数参数与返回值正常传递；.append / .remove(idx) 正常。
//   - json pretty 默认用 TAB 缩进，保存时统一替换成 2 空格。

class TodoItem
    derive value
    derive json

    int id = 0
    string text = ""
    bool done = false
    string createdAt = ""
end


// 数据文件路径：脚本/exe 同目录下的 todos.json。
func dataPath(string scriptPath) as string
    return path.join(path.dir(scriptPath), "todos.json")
end


// 从磁盘读取并还原成 array<TodoItem>；文件不存在/为空时返回空数组。
func loadItems(string path_) as array<TodoItem>
    array<TodoItem> result = array[]
    if not file.exists(path_) then
        return result
    end
    string text = file.readText(path_)
    if string.isEmpty(text) then
        return result
    end
    var items = json.parse(text)
    if items == null then
        return result
    end
    int n = items.length
    int i = 0
    while i < n
        var elem = items[i]
        TodoItem item = json.parse::<TodoItem>(json.stringify(elem))
        result.append(item)
        i += 1
    end
    return result
end


// 把 array<TodoItem> 整体序列化落盘。
func saveItems(string path_, array<TodoItem> items)
    string jsonText = json.stringify(items, pretty = true)
    // json pretty 默认用 TAB 缩进，统一替换成 2 空格。
    jsonText = string.replace(jsonText, "\t", "  ")
    bool ok = file.writeText(path_, jsonText)
    if not ok then
        println("Error: failed to write " + path_)
    end
end


// 生成下一个自增 id。
func nextId(array<TodoItem> items) as int
    int maxId = 0
    int i = 0
    int n = items.length
    while i < n
        TodoItem item = items[i]
        if item.id > maxId then
            maxId = item.id
        end
        i += 1
    end
    return maxId + 1
end


// 按 id 查找下标，找不到返回 -1。
func findById(array<TodoItem> items, int id) as int
    int i = 0
    int n = items.length
    while i < n
        TodoItem item = items[i]
        if item.id == id then
            return i
        end
        i += 1
    end
    return -1
end


func cmdAdd(string scriptPath, string text)
    string path_ = dataPath(scriptPath)
    array<TodoItem> items = loadItems(path_)
    int newId = nextId(items)

    TodoItem item = TodoItem()
    item.id = newId
    item.text = text
    item.done = false
    item.createdAt = time.format(time.now())

    items.append(item)
    saveItems(path_, items)
    println("Added #" + string(item.id) + ": " + item.text)
end


func cmdList(string scriptPath)
    string path_ = dataPath(scriptPath)
    array<TodoItem> items = loadItems(path_)

    if items.length == 0 then
        println("(no todos)")
        return
    end

    int i = 0
    int n = items.length
    while i < n
        TodoItem item = items[i]
        string mark = item.done ? "[x]" : "[ ]"
        println("[" + string(item.id) + "] " + mark + " " + item.text)
        i += 1
    end
    println("Total: " + string(items.length))
end


func cmdDone(string scriptPath, int id)
    string path_ = dataPath(scriptPath)
    array<TodoItem> items = loadItems(path_)

    int idx = findById(items, id)
    if idx < 0 then
        println("Error: no todo with id " + string(id))
        return
    end

    TodoItem item = items[idx]
    item.done = true
    saveItems(path_, items)
    println("Marked #" + string(id) + " done.")
end


// 使用独立临时目录验证新增、完成、清理和持久化，不触碰用户数据。
func runSelftest() as int
    string root = path.join(path.temp(), path.random("todo_", ""))
    string scriptPath = path.join(root, "todo.xl")
    string storePath = dataPath(scriptPath)
    int failed = 0
    dir.createAll(root)

    cmdAdd(scriptPath, "write examples")
    cmdAdd(scriptPath, "run tests")
    array<TodoItem> items = loadItems(storePath)
    if items.length != 2 or items[0].id != 1 or items[1].text != "run tests" then
        println("FAIL add/load roundtrip")
        failed += 1
    end

    cmdDone(scriptPath, 1)
    items = loadItems(storePath)
    if not items[0].done then
        println("FAIL done persistence")
        failed += 1
    end

    cmdClear(scriptPath)
    items = loadItems(storePath)
    if items.length != 1 or items[0].id != 2 then
        println("FAIL clear completed")
        failed += 1
    end

    cmdRemove(scriptPath, 2)
    items = loadItems(storePath)
    if items.length != 0 then
        println("FAIL remove persistence")
        failed += 1
    end

    if file.exists(storePath) then
        file.delete(storePath)
    end
    dir.delete(root)
    if failed == 0 then
        println("todo self-test: PASS")
        return 0
    end
    println("todo self-test: FAIL (" + string(failed) + ")")
    return 1
end


func cmdRemove(string scriptPath, int id)
    string path_ = dataPath(scriptPath)
    array<TodoItem> items = loadItems(path_)

    int idx = findById(items, id)
    if idx < 0 then
        println("Error: no todo with id " + string(id))
        return
    end

    items.remove(idx)
    saveItems(path_, items)
    println("Removed #" + string(id) + ".")
end


func cmdClear(string scriptPath)
    string path_ = dataPath(scriptPath)
    array<TodoItem> items = loadItems(path_)

    int removed = 0
    array<TodoItem> kept = array[]
    int i = 0
    int n = items.length
    while i < n
        TodoItem item = items[i]
        if item.done then
            removed += 1
        else
            kept.append(item)
        end
        i += 1
    end

    saveItems(path_, kept)
    println("Cleared " + string(removed) + " completed item(s).")
end


func printUsage()
    println("Usage:")
    println("  todo add \"<text>\"   add a new todo")
    println("  todo list            list all todos")
    println("  todo done <id>       mark todo <id> as done")
    println("  todo remove <id>     remove todo <id>")
    println("  todo clear           remove all completed todos")
    println("  todo test            run isolated self-test")
end


func main(...) as int
    if arg.length < 2 then
        printUsage()
        return 1
    end

    string scriptPath = string(arg[0])
    string command = string(arg[1])

    if command == "test" then
        return runSelftest()
    end

    if command == "add" then
        if arg.length < 3 then
            println("Error: 'add' needs a text argument")
            return 1
        end
        cmdAdd(scriptPath, string(arg[2]))
        return 0
    end

    if command == "list" then
        cmdList(scriptPath)
        return 0
    end

    if command == "done" then
        if arg.length < 3 then
            println("Error: 'done' needs an id argument")
            return 1
        end
        cmdDone(scriptPath, int(arg[2]))
        return 0
    end

    if command == "remove" then
        if arg.length < 3 then
            println("Error: 'remove' needs an id argument")
            return 1
        end
        cmdRemove(scriptPath, int(arg[2]))
        return 0
    end

    if command == "clear" then
        cmdClear(scriptPath)
        return 0
    end

    println("Error: unknown command '" + command + "'")
    printUsage()
    return 1
end
