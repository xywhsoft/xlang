    int completionTime = 0
    int responseTime = -1
    int pc = 0               // 缂傚倷绀侀鍛搭敄閸涱垵濮虫い鎾跺У婵ジ鏌嶉埡浣告殲婵炲牆鐖奸弻?(闂備礁婀遍…鍫澝洪妶澶婄畺?program 闂備浇妗ㄩ悞锔界珶閸℃瑥鍨濈€广儱妫涢埢鏃堟倵閿濆倹娅囨い蹇涗憾閺?
    int ptDirId = NIL        // 闂佽崵濮村ú銏ゅ磿鐎靛憡宕叉俊顖濆亹閻瑩鎮楅敐搴″闁伙絽宕—鍐Χ閸ャ劍姣勫┑鐐跺紦閸楁娊寮?id (闂備礁鎲￠崝鏇㈠箠鎼淬劍鍋ら柕濞р偓閸嬫挸鈽夊▎蹇擃潕闂備緡鍠楅幐鎶藉极?
    int sleepUntil = -1      // WAITING 闂備胶绮…鍫ュ春閺嶎厼鐒垫い鎴ｆ硶閸斿秴霉閻欌偓閸ｏ綁寮?tick (-1 = 濠电偞鍨堕幐鍝ョ矓鐠轰警鐒芥い鏍仦閺?
    int exitCode = 0
    array<string> program = array[]   // 闁诲骸鐏氬姗€骞婅箛鏃€娅犻柣锝呮湰閸嬫鈧厜鍋撻柍褜鍓欓埢鎾诲箣閿曗偓缁犺偐鈧箍鍎辩€氼喚绮欐繝鍥х闁哄鍨圭粻浼存煕?
    array<int> fdMap = array[]
    int computeLeft = 0               // 闁荤喐绮庢晶妤呭箰閸涘﹥娅犻柣妯款嚙鐎氬銇勮箛鎾愁伀闁哄棙宀搁弻鐔衡偓娑櫭慨澶嬬箾?compute 闂備礁鎲￠幐鎾疾濞嗘垹绀?tick (闂備浇銆€閸嬫挻銇勯弽銊р槈闁?quantum 闂備胶顢婄紙浼村垂閻熸壆鏆?
end

func procStateName(int s) as string
    if s == PROC_NEW        then return "new"        end
    if s == PROC_READY      then return "ready"      end
    if s == PROC_RUNNING    then return "running"    end
    if s == PROC_WAITING    then return "waiting"    end
    if s == PROC_TERMINATED then return "terminated" end
    return "unknown"
end

func procCreate(string name, int arrival, int burst, int level, array<string> program) as int
    PCB p = PCB()
    p.pid = g_nextPid
    p.name = name
    p.state = PROC_NEW
    p.level = level
    p.burstTime = burst
    p.arrivalTime = arrival
    p.remaining = burst
    p.usedInLevel = 0
    p.parentPid = g_currentPid
    p.pc = 0
    p.program = program
    // 濠电偞鍨堕幑鍥╃磽濮樿鲸宕叉俊顖濆亹閻瑩鎮楅敐搴濈盎闁诲骸顭峰娲级鐠恒剱褔鏌曢崱妤婃█闁诡垰瀚伴、娆撴嚃閳哄唭?(闂備礁鎲￠崝鏇㈠箠鎼淬劍鍋ら柕濞р偓閸嬫挸鈽夊▎蹇擃潕闂備緡鍠楅幐鎶藉极?
    p.ptDirId = memAllocDir()
    g_pcb.append(p)
    int pid = g_nextPid
    g_nextPid = g_nextPid + 1
    trace("procCreate pid=" + i2s(pid) + " name=" + name + " burst=" + i2s(burst))
    return pid
end

// 闂備胶顢婂▔娑㈡晝閵娧勫床婵☆垵鍋愰惌娆撴倵閿濆骸澧伴柡瀣€块弻?TERMINATED, 闂傚倷鐒﹁ぐ鍐晝閵夆晛妫樺〒姘ｅ亾鐎规洘顨堥幑鍕传閸曨剚娈介梺璇插缁嬫帡鏁冮姀銈呂?
func procTerminate(int pid, int code)
    if pid < 0 or pid >= g_pcb.length then
        return
    end
    if g_pcb[pid].state == PROC_TERMINATED then
        return
    end
    g_pcb[pid].state = PROC_TERMINATED
    g_pcb[pid].completionTime = g_totalTick
    g_pcb[pid].exitCode = code
    g_pcb[pid].remaining = 0
    procCloseAllFd(pid)
    memReleaseProc(pid)
    if g_currentPid == pid then
        g_currentPid = NIL
    end
    trace("procTerminate pid=" + i2s(pid) + " code=" + i2s(code))
end

// ---- 闂佸搫顦弲婊呯矙閹捐鐓濋柤娴嬫櫇閻挸霉閿濆牜娼愮紒?fd 闂?(婵犳鍣徊鐣屾崲鐎ｎ喗鐓傛繝濠傚娴溿倖绻涢幋鐐茬劰闁哄被鍊濋弻锝呪枎濡搫顫梺?fd 缂傚倷绀侀張顒€顪冮挊澹? 闂備礁鎼€氼喗鎱ㄩ幘顔藉剭闁绘顕х粈鍡涙煛婢跺﹦浠㈢€殿喖娼￠幃姗€鎮欓埡浣峰闂備胶鎳撻悘姘跺箰閸濄儲顫曢柟瀵稿У閸嬫﹢鏌曟繛銈傚亾妞ゆ劧绲炬刊? ----

// 闂備胶鎳撻悘姘跺箰閸濄儲顫曢柟杈剧畱濡﹢鏌涢妷顖炴妞ゆ劘濮ら〃銉╂倷閺夋垵濮稿銈冨劚閿曨亜鐣峰Δ鍛ㄩ柕濞у拋鍟嬬紓鍌欑椤戝懘顢栭崶顒婄稏闁糕剝绋戠€?fd 闂? 闂佸搫顦弲婊堝蓟閵娿儍?local fd (濠电姰鍨洪崕鑲╁垝閸撗勫枂?NIL).
func procOpen(int pid, string path, string mode) as int
    int gslot = fsOpen(path, mode)
    if gslot == NIL then return NIL end
    PCB p = g_pcb[pid]
    int localFd = NIL
    int i = 0
    int m = p.fdMap.length
    while i < m do
        if p.fdMap[i] == NIL then
            localFd = i
            i = m
        end
        i += 1
    end
    if localFd == NIL then
        p.fdMap.append(gslot)
        localFd = p.fdMap.length - 1
    else
        p.fdMap[localFd] = gslot
    end
    g_pcb[pid] = p
    return localFd
end

// local fd -> 闂備胶顭堢换鍫ュ礉瀹€鍕剳妞ゆ帒瀚粻銉╂煙閹咃紞缁炬儳顭烽幃璺衡槈閺嵮冾瀴闁撅箑楠搁湁?(闂備礁鎼崯鐗堟叏閻㈢鐤鹃柕澶涢檮娴溿倝鏌￠崒娑橆嚋缂佲偓閳?NIL).
func procLocalToGlobal(int pid, int localFd) as int
    PCB p = g_pcb[pid]
    if localFd < 0 or localFd >= p.fdMap.length then return NIL end
    return p.fdMap[localFd]
end

// 闂備胶顭堢换鎴炵箾婵犲伣娑氣偓娑櫳戞禍銈嗙箾閹寸偛鐒归柡灞诲€濋弻锝夊Ω閵夈儺浠鹃梺缁樻尭濞诧妇绮?local fd.
func procCloseLocal(int pid, int localFd) as bool
    PCB p = g_pcb[pid]
    if localFd < 0 or localFd >= p.fdMap.length then return false end
    int gslot = p.fdMap[localFd]
    if gslot == NIL then return false end
    fsClose(gslot)
    p.fdMap[localFd] = NIL
    g_pcb[pid] = p
    return true
end

// 闂備胶顭堢换鎴炵箾婵犲伣娑氣偓娑櫳戞禍銈嗙箾閹寸偛鐒归柡灞诲€濋弻鐔哄枈濡桨澹曢梻浣告惈閻楀棝藝閻楀牊娅犻柨鏇楀亾妞ゆ洩缍侀崺鈧い鎺戝閸?fd (闂傚倷绶￠崑鈧柛瀣崌閺屾盯骞嬮悩鎻掑濠碉紕鍋涢崐鎼佸Υ閹烘宸濇い鏍ㄧ☉閳?.
func procCloseAllFd(int pid)
    PCB p = g_pcb[pid]
    int i = 0
    int m = p.fdMap.length
    while i < m do
        if p.fdMap[i] != NIL then
            fsClose(p.fdMap[i])
            p.fdMap[i] = NIL
        end
        i += 1
    end
    g_pcb[pid] = p
end

// 闂備胶顢婂▔娑㈡晝閵娧勫床婵☆垵鍋愰惌娆撴倵閿濆倹娅囬柣顓滃€濆濠氬礃椤忓嫭鐎婚梺鍓茬厛娴滄繄绮欐径鎰垫晣闁绘ɑ菤閺呯娀寮?(闂?pid 闂備線娼荤拹鐔煎礉鐎ｎ剛绠斿ù锝呮贡閳绘梹銇勮箛鎾跺鐞氭繈姊洪崨濠傜瑲妞ゃ劌锕畷铏槹鎼达絾锛忛梺鍦焾缁ㄥ爼宕戦幘璇℃Ъ闂佺粯鎼换婵嬪极?.
func mlfqRemove(int pid)
    procRemoveFromQueue(g_mlfq0, pid)
    procRemoveFromQueue(g_mlfq1, pid)
    procRemoveFromQueue(g_mlfq2, pid)
end

func procRemoveFromQueue(array<int> q, int pid)
    int i = 0
    int n = q.length
    bool done = false
    while i < n and not done do
        if q[i] == pid then
            q.remove(i)
            done = true
        end
        i += 1
    end
end

// 闂備礁鎲″缁樻叏閹绢喖鐭楅柛鈩冪懁閻掑﹪寮堕崼姘珔鐎规洘娲熷濠氬礃椤忓嫭鐎婚梺?(闂?level 闂傚倷绶￠崑鍕囬幍顔瑰亾?, 闂備礁鎲￠懝楣冨嫉椤掆偓椤啴宕掗悙瀵稿帓閻庡箍鍎卞ú銊╁几?usedInLevel.
func mlfqEnqueue(int pid, int level)
    if pid < 0 or pid >= g_pcb.length then return end
    g_pcb[pid].level = clamp(level, 0, MLFQ_LEVELS - 1)
    g_pcb[pid].usedInLevel = 0
    g_pcb[pid].state = PROC_READY
    if g_pcb[pid].level == 0 then
        g_mlfq0.append(pid)
    elseif g_pcb[pid].level == 1 then
        g_mlfq1.append(pid)
    else
        g_mlfq2.append(pid)
    end
end

// 闂備礁鎲＄敮妤佸垔娴犲绠垫い蹇撴噽椤╂煡鎮楅敐鍌涙珕妞? NEW -> READY (闂佸搫顦弲婊呯矙閹达箑鐭楅柛鈩冪憿閸嬫捇鎮介崹顐㈡畬缂備降鍔忕亸娆撴儉椤忓浂妲婚梺?.
func procArrive(int pid)
    if pid < 0 or pid >= g_pcb.length then return end
    PCB p = g_pcb[pid]
    if p.state != PROC_NEW then return end
    mlfqEnqueue(pid, p.level)
    trace("procArrive pid=" + i2s(pid) + " at tick " + i2s(g_totalTick))
end

// 闂傚倷绶￠崑鍕囬棃娴筹綁鏁冮崒姘鳖槴濠德板€愰崑鎾绘煏? 闂佸搫顦弲婊堝蓟閵娿儍?pid, 缂傚倷绀侀惌鍌滅磽濮樿鲸宕查柟杈鹃檮閺?NIL.
func mlfqPopHead() as int
    if g_mlfq0.length > 0 then
        int pid = g_mlfq0[0]
        g_mlfq0.remove(0)
        return pid
    end
    if g_mlfq1.length > 0 then
        int pid = g_mlfq1[0]
        g_mlfq1.remove(0)
        return pid
    end
    if g_mlfq2.length > 0 then
        int pid = g_mlfq2[0]
        g_mlfq2.remove(0)
        return pid
    end
    return NIL
end

func levelQuantum(int level) as int
    if level == 0 then return MLFQ_Q0 end
    if level == 1 then return MLFQ_Q1 end
    return MLFQ_Q2
end

// 濠电偞娼欓崥瀣晪闂佸憡蓱缁嬫捇鎯€椤忓浂妲奸悷婊堫暒缁舵岸寮? 闂備胶顢婂▔娑㈡晝閵夛附娅犵€广儱顦€氬顭跨捄鐚存敾闁汇劍鍨圭槐鎾寸瑹閸ワ附鎹ｇ紓浣虹帛椤洨鍒掑▎鎴斿亾閿濆骸鏋涙繛鍛灲閺岋繝宕掑鍐炬毉闂佸搫鍊风欢姘跺极?Q0 (闂傚倸鍊搁崯顐㈩嚕閸洦鏁嗘繛鎴炵懄婵挳骞栫€涙绠橀柛鐘筹耿閺屾稖绠涢幘璺衡叡婵°倗濮村ú锕傘€冨鍫澪ㄩ柍鐟扮仢娴?.
func mlfqBoost()
    while g_mlfq1.length > 0 do
        int pid = g_mlfq1[0]
        g_mlfq1.remove(0)
        mlfqEnqueue(pid, 0)
    end
    while g_mlfq2.length > 0 do
        int pid = g_mlfq2[0]
        g_mlfq2.remove(0)
        mlfqEnqueue(pid, 0)
    end
    g_lastBoost = g_totalTick
    trace("mlfqBoost @tick " + i2s(g_totalTick))
end

// 濠电偞鍨堕幐鎼佹晝閿濆洨绠旈柛娑欐綑濡﹢鏌涢妷鎴濆暟閳ь剙銈搁弻? 濠电儑绲藉ú锔炬崲閸岀偞鍋ら柕濞炬櫅缁秶鎲搁幋鐘冲床婵☆垵鍋愰惌娆撴倵閿濆倹娅囬柣鐔稿姇閳藉骞橀幇浣稿壉闂?(闂備胶绮…鍫ヮ敊閹版澘绠?, 闂佽崵鍠嶇粈渚€骞婇幘瓒佸綊宕堕鈧Λ姗€鏌熷畡鎵伇缂佺姴顭烽弻? 闂佽崵濮抽悞锕€顭垮Ο鑲╃鐎广儱顦粈鍡涙煕閵夛絽濡奸幖鏉戯攻缁绘盯宕辫箛鎾斥拤闂? 闂備礁鎲＄敮锟犲绩闁秴钃?TLB.
func contextSwitch(int newPid)
    if g_currentPid == newPid then
        return
    end
    if g_currentPid != NIL and g_currentPid >= 0 and g_currentPid < g_pcb.length then
        if g_pcb[g_currentPid].state == PROC_RUNNING then
            g_pcb[g_currentPid].state = PROC_READY
        end
            // 闂佸搫顦弲婊堟晪濠电姭鍋撴い蹇撴噺娴溿倝鏌熼柇锕€鐏遍柡鈧?-> 闂備焦鎮堕崕鎶藉磻濞戙垹鏄ョ€光偓閳ь剚绂嶉崨濠冪秶闁宠桨绀佺壕鍧楁⒑? 闂備焦鐪归崹鑲╁垝妤ｅ啯鍎嶉柣鏂垮悑閸嬨劑鏌曟繝蹇涙闁绘挻鐟╅弻娑㈠箛椤掆偓閺嗛亶鏌ｉ敐澶岀暫鐎殿喓鍔戦獮鍡氼槼缂佲偓閳ь剟姊洪崨濠勭濞存粎鍋為〃銉╁炊椤掍讲鎸€闂佺粯鏌ㄩ崲鏌ユ倶?
    end
    g_currentPid = newPid
    g_contextSwitches = g_contextSwitches + 1
    memFlushTlb()
    if newPid != NIL and newPid >= 0 and newPid < g_pcb.length then
        g_pcb[newPid].state = PROC_RUNNING
        if g_pcb[newPid].responseTime < 0 then
            g_pcb[newPid].responseTime = g_totalTick - g_pcb[newPid].arrivalTime
            g_pcb[newPid].startTime = g_totalTick
        end
        trace("contextSwitch -> pid=" + i2s(newPid) + " (level " + i2s(g_pcb[newPid].level) + ")")
    end
end

// 闂佽崵濮崇拋鏌ュ疾濠婂牊鍋傞柛銉ｅ妽娴溿倖绻涢幋鐐茬劰闁哄被鍊濋弻鐔虹箔濞戞ɑ锛嶉柡鈧禒瀣厸闁割偅鑹炬禍楣冩⒑?quantum 闂?CPU 闂備礁鎲￠〃鍡椕洪幋鐘电? 闂佸搫顦弲婊堝蓟閵娿儍娲冀椤愮喎浜鹃柛锔诲幖娴犺鲸淇婄紒銏犵仩闁宠棄顦靛畷濂告晲閸屾矮澹曞┑掳鍊曢崯顖炴偩闁秵鐓曟俊銈勭劍绾捐崵绱撳鍛殗闁?
// 闂備礁鍚嬮惇褰掑磿閹惰棄鐓濋柛蹇撳悑閸庣喖鐓崶銊ュ毈闁告埃鍋撻梻浣芥〃閻掞箑顭垮Ο琛℃瀺闁圭儤姊圭亸搴ㄦ煛婢跺孩纭堕柡鍡樺哺閺岀喓鈧稒顭囨晶宕囩磼缂佹﹫鑰块柡?WAITING/TERMINATED, 闂備礁婀辩划顖炲礉閺囩喐娅犻柣妯挎珪娴溿倝鏌￠崒娑橆嚋缂佲偓閳?
func procRunQuantum(int pid, int quantum) as int
    int used = 0
    while used < quantum do
        if g_pcb[pid].state == PROC_TERMINATED then
            return used
        end
        if g_pcb[pid].state == PROC_WAITING then
            return used
        end
        // 缂傚倸鍊风紞鈧柛娑卞灡閺嗕即姊洪崫鍕⒈濞存粍绮撻幃楣冾敆閸曨偆顓洪梺褰掑亰閸犳鎮?compute (闂?tick 婵犵數鍋為崹鐢告偋閹版澘鐒? 闂備浇銆€閸嬫挻銇勯弽銊р槈闁伙富鍣ｅ娲箵閹烘梻顔囬梺鐑╁墲閻熲晠鐛惔銊ヮ潊闁绘灏欓悰?
        if g_pcb[pid].computeLeft > 0 then
            g_pcb[pid].computeLeft = g_pcb[pid].computeLeft - 1
            procDecRemaining(pid, 1)
            used = used + 1
        else
            int progLen = g_pcb[pid].program.length
            if g_pcb[pid].pc >= progLen then
                // 缂傚倷绀侀鍛搭敄閸涱垵濮虫い鎾跺Х绾惧ジ鏌熼幆褏鎽犻悘?-> 缂傚倸鍊风粈渚€鎮ф繝鍥舵晢?
                procTerminate(pid, EXIT_OK)
                return used
            end
            string line = g_pcb[pid].program[g_pcb[pid].pc]
            g_pcb[pid].pc = g_pcb[pid].pc + 1
            // execOp 闂備礁婀遍悷鎶藉幢閳哄倹鏉稿┑鐐村灦閹告挳宕戦幘鏂ユ闁瑰灝鍟╃花濂告煙婵傚憡鏁遍柟?(compute 濠电偞娼欓崥瀣┍濞差亶鏁婇柡鍥╁Х绾?computeLeft 婵°倗濮烽崑鐘诲春閺嶃劍娅?1; 闂備胶顭堢换鎴濓耿閸︻厼鍨濇い鎺戝缁犺偐鈧箍鍎辩€氼喚绮欐繝鍥ㄧ厵?1 tick)
            int cost = execOp(pid, line)
            if cost < 1 then cost = 1 end
            used = used + 1
        end
        if g_pcb[pid].state == PROC_WAITING then
            return used
        end
        if g_pcb[pid].state == PROC_TERMINATED then
            return used
        end
    end
    return used
end
        // execOp 闂備礁鎲￠悷顖炲垂閻㈢绀傛慨妞诲亾鐎殿喓鍔戦幃鐑藉级鐠恒劎袦 p.state (WAITING/TERMINATED); 闂傚倷鐒﹁ぐ鍐矓閻㈢钃熷┑鐘叉处閺?        PCB p2 = g_pcb[pid]
// 闂佽崵濮崇拋鏌ュ疾濠婂嫭娅犵€广儱顦€氬顭跨捄鐑樻拱闁藉倸顑夐弻锝夘敂閸℃ぅ銏ゆ煕閳轰胶鐒哥€殿喚鏁婚幃銏ゆ倻濡吋娈搁梺鍝勵槴閺呮粎绮欓幘璇茬厺濠靛倻顭堥懜褰掓煏閸繍妲搁柡?
func procWakeSleepers()
    int i = 1
    int n = g_pcb.length
    while i < n do
        if g_pcb[i].state == PROC_WAITING then
            if g_pcb[i].sleepUntil >= 0 and g_totalTick >= g_pcb[i].sleepUntil then
                int lvl = g_pcb[i].level
                g_pcb[i].sleepUntil = -1
                mlfqEnqueue(i, lvl)
                trace("procWake pid=" + i2s(i) + " @tick " + i2s(g_totalTick))
            end
        end
        i += 1
    end
end

// 闂佽崵濮崇拋鏌ュ疾濞戙垹鏄ラ悘鐐靛亾缂嶅洭鏌ｉ幇闈涘妞は佸洦鈷掗柛灞剧⊕缂嶆垿鏌涢幋顖滅瘈鐎规洘宀搁獮宥夘敊閻ｅ本娈?NEW 闂佸搫顦弲婊呯矙閹捐鐓濆┑鍌滎焾缁€鍌炴煏婢跺牆鍔滈柣銊﹀灩缁辨挻绗熼崶锕傚仐濠德ゎ嚋缁犳捇寮?
func procAdmitArrivals()
    int i = 1
    int n = g_pcb.length
    while i < n do
        PCB p = g_pcb[i]
        if p.state == PROC_NEW and p.arrivalTime <= g_totalTick then
            procArrive(i)
        end
        i += 1
    end
end

func procHasAlive() as bool
    int i = 1
    int n = g_pcb.length
    while i < n do
        PCB p = g_pcb[i]
        if p.state != PROC_TERMINATED then
            return true
        end
        i += 1
    end
    return false
end

// 缂傚倸鍊烽懗鍫曞窗閺囥埄鏁囬柛婵勫劙閻掑﹪寮堕崼姘珔鐎规洘娲熷鍫曞煛閸屾嚎鈧帡鏌嶇拠灞傚仮闁?
func procReadyCount() as int
    int c = 0
    c = c + g_mlfq0.length
    c = c + g_mlfq1.length
    c = c + g_mlfq2.length
    int i = 1
    int n = g_pcb.length
    while i < n do
        PCB p = g_pcb[i]
        if p.state == PROC_RUNNING or p.state == PROC_WAITING then
            c = c + 1
        end
        i += 1
    end
    return c
end

// 缂傚倷鐒︾粙鎴λ囬婊勵偨闁绘梻鍘х猾宥夋煕椤愶絾绀冮柨娑氬枔缁辨帗顫戦弽褏浠村?(闂佽娴烽弫鎼佸箠閹惧嚢鍥煛閸涱喗娅?READY/WAITING 闂備焦鐪归崝宀€鈧碍婢橀…鍥敂閸℃瑧锛滈梺鍓插亞閸ｃ儵宕滄ィ鍐ㄧ骇闁冲搫鍊婚妴鎺楁煃?.
func procTickWait()
    int i = 1
    int n = g_pcb.length
    while i < n do
        if g_pcb[i].state == PROC_READY or g_pcb[i].state == PROC_WAITING then
            g_pcb[i].waitTime = g_pcb[i].waitTime + 1
        end
        i += 1
    end
end

// 濠电偞鍨堕幐璇参ｉ幒妤佸剭闁绘柨鎲￠崕鐔兼煥閺囨浜鹃梺璇″灠閿曨亪寮? 婵犳鍣徊鐣屾崲濡ゅ懏鍋柛鈩冪⊕閻掕顭跨捄渚Ш妞ゅ繐宕埥澶愬箼閸愌呯泿濠殿喗菧閸斿海妲愰幒妤婃晜闁搞儮鏅濋鎺旂磽娴ｅ壊鍎忔い鎴濈墢閹广垹顓奸崶銊ヤ粧闁诲繒鍋犻崑鎰邦敂闁秵鐓?quantum, 闂備胶顭堢换鍫ュ礉閹达箑纾块悗闈涙憸绾惧ジ鏌涢銈呮珡闁告捇绠栭弻娑橆潩椤掍礁鏀紓浣虹帛閸ㄥ潡寮?
func schedulerLoop(int maxTicks)
    bool stop = false
    int guard = 0
    while not stop do
        guard = guard + 1
        if guard > maxTicks then
            println("xos: scheduler maxTicks reached, stopping")
            stop = true
        end
        procAdmitArrivals()
        procWakeSleepers()
        if g_totalTick - g_lastBoost >= MLFQ_BOOST then
            mlfqBoost()
        end
        int pid = mlfqPopHead()
        if pid == NIL then
            // 婵犵數鍋涙径鍥礈濠靛棴鑰垮ù锝堟〃閻掑﹪寮堕崼姘珔鐎规洘娲熷鍫曞煛閸屾嚎鈧帡鏌?
            if procHasAlive() then
                // 闂備礁鎼悧鍡浰囬柆宥嗗仱闁硅揪闄勯弲?闂備礁鎼悧婊勭濠婂牆鏄ョ€光偓閸曨剚娅?-> 闂備浇顫夋禍浠嬪礉韫囨洘宕叉慨妞诲亾鐎殿噮鍣ｅ畷濂稿即閻曞倻鍚?
                g_totalTick = g_totalTick + 1
                g_idleTicks = g_idleTicks + 1
                procTickWait()
            else
                stop = true
            end
        else
            contextSwitch(pid)
    PCB p = g_pcb[pid]
            int q = levelQuantum(p.level)
            int used = procRunQuantum(pid, q)
            // 闂備礁鎼崯顐︽偉閻撳宫娑㈠锤濡も偓缁犳娊鏌曟繛鍨缂佺姴顭烽弻?used
            g_totalTick = g_totalTick + used
            // 闂備胶顭堢换鎴濓耿閸︻厾绀婇柟瀵稿仦娴溿倖绻涢幋鐐茬劰闁哄被鍊楃槐鎺戔槈濮楀棙笑缂備礁澧庨崰鏍ь嚕椤曗偓瀹曞ジ寮撮悤鍌滃惞缂傚倷绶氱涵鎼佸垂閻㈠壊鏁?
            int i = 1
            int n = g_pcb.length
            while i < n do
                if i != pid then
                    if g_pcb[i].state == PROC_READY or g_pcb[i].state == PROC_WAITING then
                        g_pcb[i].waitTime = g_pcb[i].waitTime + used
                    end
                end
                i += 1
            end
            // 濠电姰鍨煎▔娑氣偓姘煎櫍楠炲啯绻濋崶褍鐝?quantum 闂備礁鎲￠懝鎯瑰畡鎵虫灁闁瑰濮电€氼剟鏌涢幇鈺佸妞ゆ柨锕弻娑㈠箛椤掑偊绱為梺?
            if g_pcb[pid].state == PROC_TERMINATED then
                // 闁诲海鎳撻幉锟犳偂閿熺姴鐒垫い鎴ｆ娴滈箖姊? 闂備礁鎼崯鐗堢箾閳ь剚绻涢幘宕囧煟闁哄苯鑻濂稿幢濡ゅ啰鎳?
            elseif g_pcb[pid].state == PROC_WAITING then
                // 缂傚倷鐒︾粙鎴λ囬婊勵偨? 闁诲氦顫夐悺鏇犱焊濞嗘挸鏋?sleep 闂佽崵濮崇粈浣规櫠娴犲鍋? 濠电偞鍨堕幐鍝ョ矓閺夋嚚娲冀椤撶啿鎸€闂佺粯鏌ㄩ崲鏌ユ倶?
            else
                // 濠电偛顕慨瀵哥矓閺夋埊鑰?READY/RUNNING -> 闂備焦妞垮鍧楀礉瀹€鍕瀬?quantum 闂備礁鎲￠懝楣冩煀閿濆拋鐎跺瀣捣濡?
                g_pcb[pid].usedInLevel = g_pcb[pid].usedInLevel + used
                if g_pcb[pid].remaining <= 0 then
                    procTerminate(pid, EXIT_OK)
                else
                    int newLevel = g_pcb[pid].level
                    if g_pcb[pid].usedInLevel >= levelQuantum(g_pcb[pid].level) then
                        newLevel = g_pcb[pid].level + 1
                        if newLevel > MLFQ_LEVELS - 1 then
                            newLevel = MLFQ_LEVELS - 1
                        end
                    end
                    g_pcb[pid].state = PROC_READY
                    mlfqEnqueue(pid, newLevel)
                end
            end
            g_currentPid = NIL
        end
        if not procHasAlive() then
            stop = true
        end
    end
end

// 缂傚倷绶氱涵鎼佸垂閻㈠壊鏁?remaining (execOp 闂?COMPUTE 濠电偞娼欓崥瀣暆閹间礁鐒垫い鎺嶇缁楁帡鏌?.
func procDecRemaining(int pid, int n)
    g_pcb[pid].remaining = g_pcb[pid].remaining - n
    if g_pcb[pid].remaining < 0 then
        g_pcb[pid].remaining = 0
    end
end


// ===============================================================
//  Part 2: 闂備礁鎲￠崝鏇㈠箠鎼淬劍鍋ら柕濞у懍绗夐梺鎸庣☉鐎氼參宕?
// ===============================================================

// ---- TLB 闂備礁鎼¨鈧紒杈ㄦ礀鐓?----
class TlbEntry
    derive value
    int vpn = -1
    int frame = -1
    bool valid = false
    int pid = -1
    int tick = 0
end

// 闂備礁鎲＄敮妤冩崲閸岀儑缍栭柟鐗堟緲缁€宀勬煛瀹擃喖鍟弳銉╂煟鎼淬垻鈯曢柨姘舵煟閳╁啰鎳呴柛鏍ㄧ墵閹筹繝濡堕崶褏鍘?
func memInit()
    g_frameOwner = array[]
    g_frameTick = array[]
    g_ptDir = array[]
    g_ptDirUsed = array[]
    g_ptTab = array[]
    g_ptTabUsed = array[]
    g_tlb = array[]
    int i = 0
    while i < NUM_FRAMES do
        g_frameOwner.append(NIL)
        g_frameTick.append(0)
        i += 1
    end
    i = 0
    while i < NUM_DIR_SLOTS * PAGE_DIR_SIZE do
        g_ptDir.append(NIL)
        i += 1
    end
    i = 0
    while i < NUM_DIR_SLOTS do
        g_ptDirUsed.append(false)
        i += 1
    end
    i = 0
    while i < NUM_TAB_SLOTS * PAGE_TABLE_SIZE do
        g_ptTab.append(NIL)
        i += 1
    end
    i = 0
    while i < NUM_TAB_SLOTS do
        g_ptTabUsed.append(false)
        i += 1
    end
    i = 0
    while i < TLB_SIZE do
        g_tlb.append(TlbEntry())
        i += 1
    end
end

func memAllocDir() as int
    int i = 0
    while i < NUM_DIR_SLOTS do
        if not g_ptDirUsed[i] then
            g_ptDirUsed[i] = true
            int j = 0
            while j < PAGE_DIR_SIZE do
                g_ptDir[i * PAGE_DIR_SIZE + j] = NIL
                j += 1
            end
            return i
        end
        i += 1
    end
    return NIL
end

func memAllocTab() as int
    int i = 0
    while i < NUM_TAB_SLOTS do
        if not g_ptTabUsed[i] then
            g_ptTabUsed[i] = true
            int j = 0
            while j < PAGE_TABLE_SIZE do
                g_ptTab[i * PAGE_TABLE_SIZE + j] = NIL
                j += 1
            end
            return i
        end
        i += 1
    end
    return NIL
end

func memFreeDir(int dirId)
    if dirId < 0 or dirId >= NUM_DIR_SLOTS then return end
    g_ptDirUsed[dirId] = false
end

func memFreeTab(int tabId)
    if tabId < 0 or tabId >= NUM_TAB_SLOTS then return end
    g_ptTabUsed[tabId] = false
end

// 闂備礁鎲＄敮鎺懳涘┑瀣偍闁靛牆妫涢埢鏃堟煃瑜滈崜姘辩矙婢舵劦鏁傞柛鈥崇箲閺呯偤姊婚崒姘偓纭呫亹閸愵喖绠? 婵犵數鍋涙径鍥礈濠靛棴鑰垮〒姘ｅ亾鐎规洘鑹鹃埢搴ㄥ箛椤掑倹鈻?LRU 婵犵數鍎戠徊鎹愭懌闂佸憡顨嗛崹鍓佺矙婢舵劕鐒垫い鎺嶈兌閳绘梹銇勮箛鎾愁伂閻庢碍鐟╁鍫曞煛閸屾稓鍙嗗┑鐐插级閻楃娀寮? 濠电姰鍨洪崕鑲╁垝閸撗勫枂闁挎棁濮ゆ禍銈夋煛閸屾稑顕滅紒鈧埀?NIL.
func memAllocFrame(int pid) as int
    int i = 0
    while i < NUM_FRAMES do
        if g_frameOwner[i] == NIL then
            g_frameOwner[i] = pid
            g_frameTick[i] = g_totalTick
            g_memAlloc = g_memAlloc + 1
            return i
        end
        i += 1
    end
    // 闂備礁鎼崯鐗堟叏閻戣棄鐓橀柡宥庡幗閺?-> LRU 婵犵數鍎戠徊鎹愭懌闂?
    int victim = memLruVictim()
    if victim == NIL then
        return NIL
    end
    memEvictFrame(victim)
    g_frameOwner[victim] = pid
    g_frameTick[victim] = g_totalTick
    g_memAlloc = g_memAlloc + 1
    return victim
end

// 闂備礁婀遍弫鎼佸磻閹剧偨鈧帡鎳滈悽纰樻灆闂佸憡渚楅崰妤€顕ｉ幘缁樼厽妞ゎ偒鍓欐俊鎸庣箾閸喎鐏ユい鏂跨箻楠炴捇骞掗幋鐘亾婵犳碍鈷戦柡澶庢硶瀛濋梺?
func memLruVictim() as int
    int best = NIL
    int bestTick = -1
    int i = 0
    while i < NUM_FRAMES do
        if g_frameOwner[i] != NIL then
            if bestTick < 0 or g_frameTick[i] < bestTick then
                bestTick = g_frameTick[i]
                best = i
            end
        end
        i += 1
    end
    return best
end

// 婵犵數鍎戠徊鎹愭懌闂佸憡顨嗛崹鍧楀极? 婵犵數鍋為幐鎼佸箠濡　鏋嶉幖娣€戞禍褰掓煙閻戞ê鐏╂繛?+ 闂備線娼荤拹鐔煎礉瀹ュ棙娅犵€广儱顦€氬顭块懜闈涘闁逞屽墮椤﹂亶骞冩导鏉懳╅柕鍫濈墕楠炩偓闂備胶顢婂▔娑㈡晝閵壯€鍋撻崹顐㈠摵鐎规洏鍎甸獮瀣晲鎼粹剝鐣介梺姹囧焺閸ㄥ酣宕ㄩ鐐濠碉紕鍋戦崐鏇烇耿闁秵鍋?NIL + TLB 濠电姰鍨洪崕鍏笺仈閹间礁鐤?
func memEvictFrame(int frame)
    g_memEvict = g_memEvict + 1
    int owner = g_frameOwner[frame]
    g_frameOwner[frame] = NIL
    trace("memEvict frame=" + i2s(frame) + " owner=" + i2s(owner))
    int i = 0
    while i < NUM_TAB_SLOTS do
        if g_ptTabUsed[i] then
            int j = 0
            while j < PAGE_TABLE_SIZE do
                if g_ptTab[i * PAGE_TABLE_SIZE + j] == frame then
                    g_ptTab[i * PAGE_TABLE_SIZE + j] = NIL
                end
                j += 1
            end
        end
        i += 1
    end
    int t = 0
    while t < TLB_SIZE do
        if g_tlb[t].valid and g_tlb[t].frame == frame then
            g_tlb[t].valid = false
            g_tlb[t].vpn = -1
            g_tlb[t].frame = -1
        end
        t += 1
    end
end

// 闂傚倷鐒﹁ぐ鍐晝閵夆晛妫樺〒姘ｅ亾鐎殿喖顭烽獮鍥敍濠婂拋鍟嬬紓鍌欑椤戝懘顢栭崶褉鏋旈柟杈剧畱缁犮儵鏌嶈閸撶喎顕ｉ崹顐㈢窞濠电姴鍟～?+ 濠碉紕鍋戦崐鎾跺緤婵犳艾违?濠碉紕鍋戦崐妤呭极缁嬫５鐑樺鐎涙ɑ娅?
func memReleaseProc(int pid)
    int i = 0
    while i < NUM_FRAMES do
        if g_frameOwner[i] == pid then
            g_frameOwner[i] = NIL
        end
        i += 1
    end
    // 濠电姰鍨洪崕鍏笺仈閹间礁鐤?TLB 濠电偞鍨堕幖鈺呭矗閳ь剚銇勯弴鐔侯暡婵炶壈顕ч埥澶婎潩閿濆棛鍘鹃梻浣圭湽閸斿瞼鈧矮鍗虫俊?
    int t = 0
    while t < TLB_SIZE do
        if g_tlb[t].valid and g_tlb[t].pid == pid then
            g_tlb[t].valid = false
            g_tlb[t].vpn = -1
            g_tlb[t].frame = -1
        end
        t += 1
    end
    if pid < 0 or pid >= g_pcb.length then return end
    int dirId = g_pcb[pid].ptDirId
    if dirId == NIL then return end
    int j = 0
    while j < PAGE_DIR_SIZE do
        int tabId = g_ptDir[dirId * PAGE_DIR_SIZE + j]
        if tabId != NIL then
            memFreeTab(tabId)
            g_ptDir[dirId * PAGE_DIR_SIZE + j] = NIL
        end
        j += 1
    end
    memFreeDir(dirId)
    g_pcb[pid].ptDirId = NIL
end
    // 闂傚倷鐒﹁ぐ鍐晝閵夆晛妫樺ù锝囧劋鐎氭岸鏌曟径鍫濆缂佺姾宕电槐鎺斺偓锝庝憾閸庢垶绻涢崼鐔风仸闁靛洤瀚伴幃浠嬪垂椤愩倗宕堕梻?(闂備礁鎲￠悷銉╂晝閵堝鍋╅柣妯肩帛閸嬫垶銇勯幒鍡椾壕閻庤娲戦崡鎶藉箚閸愵喖绀嬫い鏍ㄇ氶崑鎾村緞閹邦厽娅?
// TLB 闂備礁鎼悮顐﹀磿閸欏鐝?
func memTlbLookup(int pid, int vpn) as int
    int i = 0
    while i < TLB_SIZE do
        if g_tlb[i].valid and g_tlb[i].pid == pid and g_tlb[i].vpn == vpn then
            g_tlb[i].tick = g_totalTick
            return g_tlb[i].frame
        end
        i += 1
    end
    return NIL
end

// TLB 闂備礁婀辩划顖滄暜閹烘鐭?(LRU 闂備礁鎼ú锔锯偓绗涘啰鏆﹂柡灞诲劚鐎氬鏌嶈閸撴氨绮欐繝鍥у窛妞ゆ棁妫勭槐锕傛⒑濞茬粯濞囬柛鏂块閳绘捇骞嬮敂鑺ユ?.
func memTlbInsert(int pid, int vpn, int frame)
    // 闂備胶顭堢换鎰版偋婵犲啰鐝舵慨妞诲亾鐎殿噮鍣ｉ幃鈺呮惞椤愶絿褰欓梻?
    int victimSlot = NIL
    int oldestTick = -1
    int i = 0
    while i < TLB_SIZE do
        if not g_tlb[i].valid then
            victimSlot = i
            oldestTick = -1
            i = TLB_SIZE
        else
            if oldestTick < 0 or g_tlb[i].tick < oldestTick then
                oldestTick = g_tlb[i].tick
                victimSlot = i
            end
        end
        i += 1
    end
    if victimSlot == NIL then return end
    g_tlb[victimSlot].valid = true
    g_tlb[victimSlot].pid = pid
    g_tlb[victimSlot].vpn = vpn
    g_tlb[victimSlot].frame = frame
    g_tlb[victimSlot].tick = g_totalTick
end

// 濠电偞鍨堕幐鎼佹晝閿濆洨绠旈柛娑欐綑濡﹢鏌涢妷鎴濆暟閳ь剙銈搁弻鐔肩嵁閸喚浠惧┑锛勫仜閸婂灝鐣峰鑸电叆閻庯綆鍋嗛崢?TLB (缂傚倷鑳舵慨顓㈠磻閹剧粯鐓曢柡宥冨妿婢ь剟鎳氶埡鍛叆? 闂備胶顭堢换鍫ュ礉閹达箑纾块悗娑櫭欢鐐哄级閸稑濡芥繛?.
func memFlushTlb()
    int i = 0
    while i < TLB_SIZE do
        g_tlb[i].valid = false
        g_tlb[i].vpn = -1
        g_tlb[i].frame = -1
        g_tlb[i].pid = -1
        i += 1
    end
end

// 濠电姰鍨煎▔娑氣偓姘煎櫍楠炲啯绻濋崟顓狅紳濠电偛妯婃禍妤呭焵? 闂?(pid, vpn) 闂備礁鎲＄敮鎺懳涘┑瀣偍闁靛牆妫庢禍婊兠归敐鍛殧闁逞屽墮閸熸挳寮?+ 闂?
// dirIdx/tabIdx 闁诲氦顫夐悺鏇犱焊椤忓牜鏁囬柛婵勫劤娑撳秵淇婇妶鍌氫壕闂? 闂佸搫顦弲婊堝蓟閵娿儍娲冀椤愶絾娈伴悷婊冪Х閵?
func memHandleFault(int pid, int dirIdx, int tabIdx, int vpn) as int
    g_memPageFault = g_memPageFault + 1
    int dirId = g_pcb[pid].ptDirId
    if dirId == NIL then
        dirId = memAllocDir()
        g_pcb[pid].ptDirId = dirId
    end
    int tabId = g_ptDir[dirId * PAGE_DIR_SIZE + dirIdx]
    if tabId == NIL then
        tabId = memAllocTab()
        g_ptDir[dirId * PAGE_DIR_SIZE + dirIdx] = tabId
    end
    int frame = memAllocFrame(pid)
    if frame == NIL then
        return NIL
    end
    g_ptTab[tabId * PAGE_TABLE_SIZE + tabIdx] = frame
    trace("pageFault pid=" + i2s(pid) + " vpn=" + i2s(vpn) + " frame=" + i2s(frame))
    return frame
end

// 闂備焦鍎崇换鎴犲枈瀹ュ洠鍋撳顓犳噰鐎规洜鍏樺鍫曞箰鎼达絿銈?-> 闂備胶绮妵娑㈠疾濠靛绠栧┑鐘叉搐閹瑰爼鏌℃径瀣嚋缂? 闂佸搫顦弲婊堝蓟閵娿儍娲冀椤撶喎浜遍梺鍐叉惈閸燁垶宕愰悙鐑樼厱闁挎棁濮ょ欢鍙夌箾?(frame*FRAME_SIZE+offset), 濠电姰鍨洪崕鑲╁垝閸撗勫枂闁挎棁濮ゆ禍銈夋煛閸屾稑顕滅紒鈧埀?NIL.
// 闂備礁鎲￠懝楣冨嫉椤掆偓椤啴宕掗悙鎻掑祮闁诲孩绋掕摫闁绘挴鍋?TLB / LRU 闂備礁鎼崯顐︽偉閻撳宫娑㈠锤濡も偓缁狅綁鏌涜箛鎾村櫧闁荤喆鍨荤槐鎾存媴閸濆嫭鐏嗗銈嗘尭閹芥粓骞忕€ｎ喖鐒洪柛鎰ㄦ櫆椤?
func memTranslate(int pid, int vaddr) as int
    if pid < 0 or pid >= g_pcb.length then return NIL end
    g_memTranslate = g_memTranslate + 1
    int offset = vaddr & OFF_MASK
    int vpn = vaddr >> OFF_BITS
    int dirIdx = (vpn >> TAB_BITS) & DIR_MASK
    int tabIdx = vpn & TAB_MASK
    // 闂備胶顭堢换鎰版偋婵犲洦鍋?TLB
    int frame = memTlbLookup(pid, vpn)
    if frame != NIL then
        g_memTlbHit = g_memTlbHit + 1
        g_frameTick[frame] = g_totalTick
        return frame * FRAME_SIZE + offset
    end
    g_memTlbMiss = g_memTlbMiss + 1
    // 闂佽崵濮嶉崶鑸垫缂備降鍔夐弲婵嬫儉椤忓浂妯勯梺闈涙椤︾敻寮?
    PCB p = g_pcb[pid]
    int dirId = p.ptDirId
    if dirId != NIL then
        int tabId = g_ptDir[dirId * PAGE_DIR_SIZE + dirIdx]
        if tabId != NIL then
            int fr = g_ptTab[tabId * PAGE_TABLE_SIZE + tabIdx]
            if fr != NIL then
                frame = fr
            end
        end
    end
    // 婵犵數鍋涙径鍥礈濠靛洨鐝舵慨妞诲亾闁?-> 缂傚倸鍊搁崐鐟邦渻娴犲违?
    if frame == NIL then
        frame = memHandleFault(pid, dirIdx, tabIdx, vpn)
        if frame == NIL then
            return NIL
        end
    end
    // 闂佽崵鍠嶇粈渚€骞婃惔銊ョ煑?TLB
    memTlbInsert(pid, vpn, frame)
    g_frameTick[frame] = g_totalTick
    return frame * FRAME_SIZE + offset
end

// 闂備礁鎲￠崝鏇㈠箠鎼淬劍鍋ら柕濞у懐锛滈梺缁樻⒐濡炲潡宕ラ埀顒勬⒑绾懐鍫柛搴ㄤ憾楠?
func memReport()
    int used = 0
    int i = 0
    while i < NUM_FRAMES do
        if g_frameOwner[i] != NIL then
            used = used + 1
        end
        i += 1
    end
    int hitRate = 0
    if g_memTranslate > 0 then
        hitRate = (g_memTlbHit * 100) / g_memTranslate
    end
    println(rep("=", 60))
    println("Memory Report")
    println(rep("=", 60))
    println("Frames: " + i2s(used) + "/" + i2s(NUM_FRAMES) + " used")
    println("Translates: " + i2s(g_memTranslate))
    println("TLB hits   : " + i2s(g_memTlbHit) + "  misses: " + i2s(g_memTlbMiss) + "  hitRate=" + i2s(hitRate) + "%")
    println("Page faults: " + i2s(g_memPageFault))
    println("Evictions  : " + i2s(g_memEvict))
    println("Alloc frames: " + i2s(g_memAlloc))
end

// 闂備胶鎳撻悘姘跺箰缁嬭法鏆ら柛鎰靛枛閽冪喖鏌熼柇锕€鐏ｇ紒鐘哄吹缁辨帞鈧綆浜堕崕鎴炵箾閸喎鐏﹂柕鍥у閹峰懘宕橀敂鐟颁壕?
func memDumpProc(int pid) as string
    if pid < 0 or pid >= g_pcb.length then return "" end
    PCB p = g_pcb[pid]
    string s = "PID " + i2s(pid) + " page table:\n"
    int dirId = p.ptDirId
    if dirId == NIL then
        return s + "  (no page directory)\n"
    end
    int d = 0
    while d < PAGE_DIR_SIZE do
        int tabId = g_ptDir[dirId * PAGE_DIR_SIZE + d]
        if tabId != NIL then
            int t = 0
            while t < PAGE_TABLE_SIZE do
                int fr = g_ptTab[tabId * PAGE_TABLE_SIZE + t]
                if fr != NIL then
                    int vpn = (d << TAB_BITS) | t
                    s = s + "  vpn=" + i2s(vpn) + " -> frame=" + i2s(fr) + "\n"
                end
                t += 1
            end
        end
        d += 1
    end
    return s
end


// ===============================================================
//  Part 3: 闂備礁鎼崐绋棵洪敐鍛瀻闁靛繈鍨圭€垫煡鏌ゆ慨鎰偓妤呭春?(inode + 闂備胶鍎甸弲鈺呭窗閺嶎偆绀婄€广儱顦伴弲?
// ===============================================================

// ---- Inode ----
class Inode
    derive value
    string name = ""
    int type = 1              // FT_FILE / FT_DIR
    array<int> children = array[]
    int parent = NIL
    int perm = 7
    string content = ""
    int size = 0
    int ino = 0
end

// ---- 闂備胶鎳撻悘姘跺箰閸濄儲顫曢柟杈剧畱濡﹢鏌涢妷顖炴妞ゆ劒绮欓幃璺衡槈閺嵮冾潎闂?----
class OpenFile
    derive value
    int ino = NIL
    int pos = 0               // lseek 婵犵數鍋為幐鎼佸箟閿熺姵鍋?
    int mode = 0              // 0=read 1=write 2=rw
    bool used = false
end

func fsInit()
    g_inodes = array[]
    g_open = array[]
    g_openUsed = array[]
    g_openCount = 0
    g_nextIno = 1
    // 闂備礁鎲＄敮妤冪矙閹寸姷纾介柟鍓х帛閺?inode "/"
    Inode root = Inode()
    root.name = "/"
    root.type = FT_DIR
    root.parent = NIL
    root.perm = PERM_RWX
    root.ino = fsAllocIno()
    g_inodes.append(root)
    g_rootIno = 0
    g_cwdIno = 0
    int i = 0
    while i < MAX_OPEN_FILES do
        g_open.append(OpenFile())
        g_openUsed.append(false)
        i += 1
    end
end

func fsAllocIno() as int
    int v = g_nextIno
    g_nextIno = g_nextIno + 1
    return v
end

func fsGet(int ino) as Inode
    return g_inodes[ino]
end

func fsSet(int ino, Inode n)
    g_inodes[ino] = n
end

func fsCheckPerm(int ino, int need) as bool
    Inode n = g_inodes[ino]
    if (n.perm & need) == need then
        return true
    end
    return false
end

// 闂佽崵濮崇拃锕傚垂閹殿喗顐介柣鎰惈閸欏﹥銇勯弽銊ь暡闁稿骸锕︾槐鎾存媴閸︻厾鐣靛?
func fsIsAbsolute(string p) as bool
    if string.len(p) > 0 then
        if string.byteAt(p, 0) == SLASH_BYTE then
            return true
        end
    end
    return false
end

// 闂備胶顢婂▔娑㈡晝閵娾晜鍎楅柟顖嗗苯娈梺鍛婃处閸撴瑩顢撻弴銏＄叆?[闂備胶绮悧妤呭磿婵傚憡鍎楀Δ锝呭暞閺? 闂備礁鎼悧婊堝磻閸涙惌鏁婄€光偓閸曨偉袝閻?
func fsSplitParent(string p) as var
    int last = -1
    int n = string.len(p)
    int i = 0
    while i < n do
        if string.byteAt(p, i) == SLASH_BYTE then
            last = i
        end
        i += 1
    end
    string parent = ""
    string fname = ""
    if last < 0 then
        parent = ""
        fname = p
    else
        parent = string.mid(p, 0, last)
        fname = string.mid(p, last + 1, n - last - 1)
    end
    var result = [parent, fname]
    return result
end

// 闂佽崵濮崇拃锕傚垂閹殿喗顐介柣鎰仛閸犲棝鏌ㄥ┑鍡橆棤闁?-> inode 闂? 闂備礁缍婂褑銇愰悙鐢电當濠㈣埖鍔曠粈鍡涙煙瀹勬壆鐏辩紒鐘崇叀閺?NIL.
func fsResolve(string p) as int
    if string.len(p) == 0 then
        return g_cwdIno
    end
    int cur = g_cwdIno
    if fsIsAbsolute(p) then
        cur = g_rootIno
    end
    var segs = string.split(p, "/")
    int n = segs.length
    int i = 0
    while i < n do
        string seg = string(segs[i])
        if seg == "" or seg == "." then
            // skip
        elseif seg == ".." then
            Inode c = g_inodes[cur]
            if c.parent != NIL then
                cur = c.parent
            end
        else
            Inode dir = g_inodes[cur]
            if dir.type != FT_DIR then
                return NIL
            end
            int found = NIL
            int cn = dir.children.length
            int j = 0
            while j < cn do
                Inode ch = g_inodes[dir.children[j]]
                if ch.name == seg then
                    found = dir.children[j]
                    j = cn
                end
                j += 1
            end
            if found == NIL then
                return NIL
            end
            cur = found
        end
        i += 1
    end
    return cur
end

// 闂?inode 闂備礁鎲￠悷銉х矓閻㈠灚鏆滈柛锔诲幘绾惧吋绻濋棃娑欙紞闁搞倗濞€閹绗熼姘变哗缂?
func fsAbsPath(int ino) as string
    if ino == g_rootIno then return "/" end
    var parts = []
    int cur = ino
    bool stop = false
    while not stop do
        if cur == NIL or cur == g_rootIno then
            stop = true
        else
            Inode n = g_inodes[cur]
            parts.append(n.name)
            cur = n.parent
        end
    end
    string result = ""
    int n = parts.length
    int i = n - 1
    while i >= 0 do
        result = result + "/" + parts[i]
        i -= 1
    end
    if string.len(result) == 0 then
        return "/"
    end
    return result
end

func fsPwd() as string
    return fsAbsPath(g_cwdIno)
end

func fsExists(string p) as bool
    int id = fsResolve(p)
    if id == NIL then return false end
    return true
end

func fsFindChild(int dirIno, string name) as int
    Inode d = g_inodes[dirIno]
    int n = d.children.length
    int i = 0
    while i < n do
        Inode ch = g_inodes[d.children[i]]
        if ch.name == name then
            return d.children[i]
        end
        i += 1
    end
    return NIL
end

func fsAppendChild(int dirIno, int childIno)
    Inode d = g_inodes[dirIno]
    d.children.append(childIno)
    g_inodes[dirIno] = d
end

func fsDropChild(int dirIno, int childIno)
    Inode d = g_inodes[dirIno]
    int n = d.children.length
    int i = 0
    bool done = false
    while i < n and not done do
        if d.children[i] == childIno then
            d.children.remove(i)
            done = true
        end
        i += 1
    end
    g_inodes[dirIno] = d
end

// 闂備礁鎲＄敮妤冪矙閹寸姷纾介柟鍓х帛閸庡孩銇勯弮鍥т汗缂? 闂佸搫顦弲婊堝蓟閵娿儍?inode 闂? 濠电姰鍨洪崕鑲╁垝閸撗勫枂闁挎棁濮ゆ禍銈夋煛閸屾稑顕滅紒鈧埀?NIL.
func fsMkdir(string p, int perm) as int
    var parts = fsSplitParent(p)
    string parentP = string(parts[0])
    string fname = string(parts[1])
    if string.len(fname) == 0 then return NIL end
    int parentId = fsResolve(parentP)
    if parentId == NIL then return NIL end
    Inode parent = g_inodes[parentId]
    if parent.type != FT_DIR then return NIL end
    if not fsCheckPerm(parentId, PERM_W) then return NIL end
    if fsFindChild(parentId, fname) != NIL then return NIL end
    Inode d = Inode()
    d.name = fname
    d.type = FT_DIR
    d.perm = perm
    d.parent = parentId
    d.ino = fsAllocIno()
    g_inodes.append(d)
    int newIno = g_inodes.length - 1
    fsAppendChild(parentId, newIno)
    return newIno
end

// 闂備礁鎲＄敮妤冪矙閹寸姷纾介柟鎯у閻岸鏌ｉ幋鐐嗘垿鎮楅鈧弻? 闁诲海鎳撻幉陇銇愰崘顔藉仱闁靛ň鏅涢幑鍫曟煏婵炲灝濡跨紒鐘崇叀閺?NIL.
func fsCreate(string p, int perm) as int
    var parts = fsSplitParent(p)
    string parentP = string(parts[0])
    string fname = string(parts[1])
    if string.len(fname) == 0 then return NIL end
    int parentId = fsResolve(parentP)
    if parentId == NIL then return NIL end
    Inode parent = g_inodes[parentId]
    if parent.type != FT_DIR then return NIL end
    if not fsCheckPerm(parentId, PERM_W) then return NIL end
    if fsFindChild(parentId, fname) != NIL then return NIL end
    Inode f = Inode()
    f.name = fname
    f.type = FT_FILE
    f.perm = perm
    f.parent = parentId
    f.ino = fsAllocIno()
    g_inodes.append(f)
    int newIno = g_inodes.length - 1
    fsAppendChild(parentId, newIno)
    return newIno
end

// 闂佽崵濮村ú銊у垝椤栫偛鍑犻柛鎰ㄦ櫇椤╃兘鎮归崫鍕儓闁轰礁鐖奸弻?
func fsReadFile(string p) as string
    int id = fsResolve(p)
    if id == NIL then return "" end
    if not fsCheckPerm(id, PERM_R) then return "" end
    Inode n = g_inodes[id]
    if n.type != FT_FILE then return "" end
    return n.content
end

// 闂備礁鎲￠崝鏍偡閿曞倸鍑犻柛鎰靛枟閺?(闂佽瀛╃粙鎺楁晪濠电姭鍋撴い蹇撴閸熸椽鏌涢埄鍐噭缁? 濠电偞鍨堕幐鍝ョ矓閹绢喗鍋ら柕濞炬櫅閹瑰爼鏌曟繛鍨姎闁诲骏绻濋弻?.
func fsWriteFile(string p, string content) as bool
    int id = fsResolve(p)
    if id != NIL then
        if not fsCheckPerm(id, PERM_W) then return false end
        Inode n = g_inodes[id]
        if n.type != FT_FILE then return false end
        n.content = content
        n.size = string.len(content)
        g_inodes[id] = n
        return true
    end
    var parts = fsSplitParent(p)
    string parentP = string(parts[0])
    string fname = string(parts[1])
    if string.len(fname) == 0 then return false end
    int parentId = fsResolve(parentP)
    if parentId == NIL then return false end
    Inode parent = g_inodes[parentId]
    if parent.type != FT_DIR then return false end
    if not fsCheckPerm(parentId, PERM_W) then return false end
    Inode f = Inode()
    f.name = fname
    f.type = FT_FILE
    f.perm = PERM_RW
    f.parent = parentId
    f.ino = fsAllocIno()
    f.content = content
    f.size = string.len(content)
    g_inodes.append(f)
    int newIno = g_inodes.length - 1
    fsAppendChild(parentId, newIno)
    return true
end

// 闂備礁鎲＄敮鐐寸箾閳ь剚绻涢崨顓㈠弰鐎殿噮鍓熷畷鍫曟晜缁涘浠?/ 缂傚倷绀侀惌浣糕枍閿濆悿鐑樺鐎涙ɑ娅?
func fsRemove(string p) as bool
    int id = fsResolve(p)
    if id == NIL then return false end
    if id == g_rootIno then return false end
    Inode n = g_inodes[id]
    if n.type == FT_DIR then
        if n.children.length > 0 then return false end
    end
    if not fsCheckPerm(n.parent, PERM_W) then return false end
    fsDropChild(n.parent, id)
    Inode orphan = g_inodes[id]
    orphan.parent = NIL
    g_inodes[id] = orphan
    return true
end

// 闂備礁鎲＄敮妤呫€冮崼婢濈儤瀵肩€涙ɑ娅? 闂佸搫顦弲婊堝蓟閵娿儍娲冀椤撶偠袝閻庡箍鍎卞▔锕傛倷閸濆嫭鐎梺瑙勵問閸犳岸鎯?(var).
func fsListDir(string p) as var
    var result = []
    int id = fsResolve(p)
    if id == NIL then return result end
    Inode n = g_inodes[id]
    if n.type != FT_DIR then return result end
    if not fsCheckPerm(id, PERM_R) then return result end
    int cn = n.children.length
    int i = 0
    while i < cn do
        Inode ch = g_inodes[n.children[i]]
        string nm = ch.name
        if ch.type == FT_DIR then
            nm = nm + "/"
        end
        result.append(nm)
        i += 1
    end
    return result
end

// 闂備礁鎲＄敮鎺懨洪敃鈧悾鐑藉箵閹烘繂鏅犻梺闈涱槶閸婃绮欐繝鍥ㄧ厽闁冲搫锕ら弸娑氱磽?
func fsCd(string p) as bool
    int id = fsResolve(p)
    if id == NIL then return false end
    Inode n = g_inodes[id]
    if n.type != FT_DIR then return false end
    if not fsCheckPerm(id, PERM_X) then return false end
    g_cwdIno = id
    return true
end

// ---- 闂備胶鎳撻悘姘跺箰閸濄儲顫曢柟杈剧畱濡﹢鏌涢妷顖炴妞ゆ劒绮欓弻?(fd) ----

func fsAllocFd() as int
    int i = 0
    while i < MAX_OPEN_FILES do
        if not g_openUsed[i] then
            g_openUsed[i] = true
            g_openCount = g_openCount + 1
            return i
        end
        i += 1
    end
    return NIL
end

func fsFreeFd(int fd)
    if fd < 0 or fd >= MAX_OPEN_FILES then return end
    g_openUsed[fd] = false
    OpenFile of = g_open[fd]
    of.used = false
    of.ino = NIL
    of.pos = 0
    g_open[fd] = of
    if g_openCount > 0 then
        g_openCount = g_openCount - 1
    end
end

// open(path, mode): 闂佸搫顦弲婊堝蓟閵娿儍?fd, 濠电姰鍨洪崕鑲╁垝閸撗勫枂?NIL. mode: "r"/"w"/"rw".
func fsOpen(string p, string mode) as int
    int id = fsResolve(p)
    if id == NIL then
        // w/rw 婵犵妲呴崹顏堝焵椤掆偓绾绢厾娑甸埀顒勬⒑閸涘﹦鎳愰柛顭戝灡缁傚秹骞掑Δ浣告疁濡炪倕绻愮€氼剝顤勯梻浣告啞鐢绮欓幋鐘电＝?
        if mode == "w" or mode == "rw" then
            int created = fsCreate(p, PERM_RW)
            if created == NIL then return NIL end
            id = created
        else
            return NIL
        end
    end
    Inode n = g_inodes[id]
    if n.type != FT_FILE then return NIL end
    int modeVal = 0
    if mode == "r" then
        if not fsCheckPerm(id, PERM_R) then return NIL end
        modeVal = 0
    elseif mode == "w" then
        if not fsCheckPerm(id, PERM_W) then return NIL end
        modeVal = 1
    else
        if not fsCheckPerm(id, PERM_RW) then return NIL end
        modeVal = 2
    end
    int fd = fsAllocFd()
    if fd == NIL then return NIL end
    OpenFile of = g_open[fd]
    of.used = true
    of.ino = id
    of.mode = modeVal
    of.pos = 0
    g_open[fd] = of
    return fd
end

func fsClose(int fd) as bool
    if fd < 0 or fd >= MAX_OPEN_FILES then return false end
    if not g_openUsed[fd] then return false end
    fsFreeFd(fd)
    return true
end

// 闂?fd 闁荤喐绮庢晶妤呭箰閸涘﹥娅?pos 闂佽崵濮村ú鈺咁敋瑜戦妵?n 闂佽瀛╃粙鎺椼€冩径瀣╃箚? 闂佸搫顦弲婊堝蓟閵娿儍娲冀椤愮喎浜炬繛鎴炵懐濞堟ɑ銇勯幋婊呯獢闁? 闂備礁鎲＄敮鐐存櫠濡も偓閿曘垽顢涘鈧悞濠囨煙鐟欏嫬濮夌紒鐘崇叀閺屾盯濡疯娴犳粌顭胯濞硷繝寮?
func fsRead(int fd, int n) as string
    if fd < 0 or fd >= MAX_OPEN_FILES then return "" end
    if not g_openUsed[fd] then return "" end
    OpenFile of = g_open[fd]
    if of.mode == 1 then return "" end     // write-only
    Inode node = g_inodes[of.ino]
    int total = string.len(node.content)
    if of.pos >= total then return "" end
    int remain = total - of.pos
    int take = n
    if take > remain then take = remain end
    if take < 0 then take = 0 end
    string s = string.mid(node.content, of.pos, take)
    of.pos = of.pos + take
    g_open[fd] = of
    return s
end

// 闂?fd 闁荤喐绮庢晶妤呭箰閸涘﹥娅?pos 闂備礁鎲￠崝鏍偡閵夆晛鐭?(闂備礁婀辩划顖滄暜閹烘鐭?闂佽崵鍠愬ú鏍涘☉妯?.
func fsWrite(int fd, string data) as int
    if fd < 0 or fd >= MAX_OPEN_FILES then return 0 end
    if not g_openUsed[fd] then return 0 end
    OpenFile of = g_open[fd]
    if of.mode == 0 then return 0 end     // read-only
    Inode node = g_inodes[of.ino]
    int dataLen = string.len(data)
    if dataLen == 0 then return 0 end
    int pos = of.pos
    string before = ""
    string after = ""
    int total = string.len(node.content)
    if pos <= 0 then
        before = ""
        after = node.content
    elseif pos >= total then
        before = node.content
        // 濠电偞鍨堕幖鈺呭矗閸愩剮娑氭崉閵婏箑浠掗梺闈涳紡閳ь剟寮崟顖涚厸鐎广儱鎳庨幃鎴︽嚉閳哄懏鐓欏瀣閺嬫棃鏌嶇拠鑼ⅵ闁?
        int gap = pos - total
        int g = 0
        while g < gap do
            before = before + " "
            g += 1
        end
        after = ""
    else
        before = string.mid(node.content, 0, pos)
        after = string.mid(node.content, pos, total - pos)
    end
    node.content = before + data + after
    node.size = string.len(node.content)
    g_inodes[of.ino] = node
    of.pos = pos + dataLen
    g_open[fd] = of
    return dataLen
end

// lseek: 0=SEEK_SET 1=SEEK_CUR 2=SEEK_END. 闂佸搫顦弲婊堝蓟閵娿儍娲冀椤撶喐娅?pos.
func fsLseek(int fd, int offset, int whence) as int
    if fd < 0 or fd >= MAX_OPEN_FILES then return NIL end
    if not g_openUsed[fd] then return NIL end
    OpenFile of = g_open[fd]
    Inode node = g_inodes[of.ino]
    int total = string.len(node.content)
    int newPos = of.pos
    if whence == 0 then
        newPos = offset
    elseif whence == 1 then
        newPos = of.pos + offset
    else
        newPos = total + offset
    end
    if newPos < 0 then newPos = 0 end
    of.pos = newPos
    g_open[fd] = of
    return newPos
end

// 闂備胶鎳撻悘姘跺箰缁嬭法鏆ら柛鎰靛枟閸庡孩銇勯弮鍥т汗缂佸娼￠弻?
func fsDumpTree()
    println("Filesystem tree (inodes=" + i2s(g_inodes.length) + ", nextIno=" + i2s(g_nextIno) + "):")
    fsDumpNode(g_rootIno, 0)
end

func fsDumpNode(int ino, int depth)
    Inode n = g_inodes[ino]
    string pad = ""
    int d = 0
    while d < depth do
        pad = pad + "  "
        d += 1
    end
    string typ = "DIR "
    if n.type == FT_FILE then
        typ = "FILE"
    end
    string line = pad + "[" + i2s(ino) + "] " + typ + " " + n.name + "  perm=" + i2s(n.perm) + " ino=" + i2s(n.ino)
    if n.type == FT_FILE then
        line = line + " size=" + i2s(n.size)
    end
    println(line)
    int cn = n.children.length
    int i = 0
    while i < cn do
        fsDumpNode(n.children[i], depth + 1)
        i += 1
    end
end


// ===============================================================
//  Part 4: Shell (闂佽崵鍠愰悷杈╁緤妤ｅ啯鍊?+ 闂備礁鎲￠崝鏇㈠箠閹扮増鍋柛鈩冪☉瀹告繈鏌熺€涙ê绗氬┑?
// ===============================================================

// 闂佽崵鍠愰悷杈╁緤妤ｅ啯鍊甸柤鎭掑劤閳绘棃鏌嶈閸撶喖寮?shell: 闂佸搫顦弲婊堝蓟閵娿儍?var 缂傚倸鍊烽悞锕傚箰婵犳碍鍊?{pipeline:[cmds], redirect_out, redirect_in, bg}.
// 婵犳鍣徊鐣屾崲鐎ｎ喗鐓?cmd = {args:[...], stdin:?, stdout:?} (stdout/stdin 闂?runPipeline 闂傚倷鐒﹁ぐ鍐嫉椤掑倹鏆滈柟缁㈠枟閺?.
func shParse(string line) as var
    var cmd = {}
    string s = trimP(line)
    if string.len(s) == 0 then
        cmd["empty"] = true
        return cmd
    end
    // 闂備礁鎲￠懝鐐殽濮濆被浜?&
    cmd["bg"] = false
    if string.byteAt(s, string.len(s) - 1) == 38 then
        cmd["bg"] = true
        s = trimP(string.mid(s, 0, string.len(s) - 1))
    end
    // 闂佸搫顦悧濠囧箰閹间礁鍚规い鎾卞灪閻撳倻鈧箍鍎遍幊鎰板汲娴煎瓨鐓?> (闂備礁鎲￠悷锕傛偋濡も偓閵嗘帡宕奸弴鐐缎曢柟鐓庣摠缁诲嫰顢旈柆宥嗙叆?
    string redirOut = ""
    int gt = findByte(s, 62)
    if gt >= 0 then
        redirOut = trimP(string.mid(s, gt + 1, string.len(s) - gt - 1))
        s = trimP(string.mid(s, 0, gt))
    end
    // 闂佸搫顦悧濠囧箰閹间礁鐭楅柛鈩冪⊕閻撳倻鈧箍鍎遍幊鎰板汲娴煎瓨鐓?<
    string redirIn = ""
    int lt = findByte(s, 60)
    if lt >= 0 then
        redirIn = trimP(string.mid(s, lt + 1, string.len(s) - lt - 1))
        s = trimP(string.mid(s, 0, lt))
    end
    cmd["redirOut"] = redirOut
    cmd["redirIn"] = redirIn
    // 缂傚倷鑳舵刊瀵告崲濠靛洨顩插Δ锝呭暙缁€鍡涙煕閵夋垵鍟伴埀?
    var segs = string.split(s, "|")
    var pipeline = []
    int n = segs.length
    int i = 0
    while i < n do
        string seg = trimP(string(segs[i]))
        if string.len(seg) > 0 then
            var tokens = shTokenize(seg)
            if tokens.length > 0 then
                pipeline.append(tokens)
            end
        end
        i += 1
    end
    cmd["pipeline"] = pipeline
    return cmd
end

// 缂傚倷鑳舵慨顓㈠磻閹剧粯鐓曟俊銈勭劍缁€澶愭煟閿旂晫绠為柡? 闂備礁婀遍…鍫ニ囬柆宥呯厴闁哄稁鍘介崕宀勬煠閹帒鍔氭い搴㈡礋閺?(闂備浇銆€閸嬫挻銇勯弽銊р槈闁伙富鍣ｉ弻?闂備礁鎲￠悷銉╂嚐椤栨粍顫曢柍鍝勬噹閻鏌у顒€鈧崵绮绘禒瀣厽闁挎繂妫涢幊鍐煕閻愬瓨灏﹂柡灞界墦婵℃瓕顦柡浣稿閺?.
// 闂佽瀛╃粙鎺椼€冮崼銉晞濞撴埃鍋撶€殿喗鎮傚畷鐔碱敍濡も偓娴滈箖鏌ｅΟ铏逛粵闁?string.charAt(s, i) 闂備礁鎲￠悷锕傛偋濠婂牜鏁?i 濠电偞鍨堕幖鈺傜濠婂牊鍋ょ憸鏃堝极?(byteAt 闂佸搫顦弲婊堝蓟閵娿儍娲冀椤愮喎浜炬繛鎴炵懐濞堟瑥鈹戦埥鍡楀籍闁? 濠电偞鍨堕幐鍝ョ矓閻戣棄绀傛慨妞诲亾闁诡垰瀚埀顒佺⊕閿氬璺虹Ч閺?.
func shTokenize(string s) as var
    return shTokenize2(s)
end

func shTokenize2(string s) as var
    var tokens = []
    int n = string.len(s)
    int i = 0
    while i < n do
        int b = string.byteAt(s, i)
        if b == 32 or b == 9 then
            // 缂傚倷绀侀惌浣糕枍閿濆應鏋? 闂佽崵濮撮幖顐︽偪閸モ晜宕?
            i += 1
        else
            string cur = ""
            bool quoted = false
            bool done = false
            if b == 34 or b == 39 then
                // 闁诲孩顔栭崰妤€煤閺嶎兙浜归柛褎顨嗛弲? 闂佽崵濮村ú鈺咁敋瑜戦妵鎰板炊椤掆偓缁€鍡涙煛婢跺﹦浠㈤柣鏍憾濮婃椽寮剁捄銊愩垻绱掗幍浣规珚鐎规洩缍侀幗搴ㄥ磼濠靛牜妲归梻? 闂備礁鎲￠崝鏇㈠箠濮椻偓瀹曟洜鈧潧鎽滈惌姘舵煟閹寸儐鐒藉瑙勫姇鑿愰柛銉ｅ妿缁犳﹢鏌￠崱蹇撲壕
                quoted = true
                int quote = b
                i += 1
                bool closed = false
                while i < n and not closed do
                    int c = string.byteAt(s, i)
                    if c == quote then
                        i += 1
                        closed = true
                    else
                        cur = cur + string.charAt(s, i)
                        i += 1
                    end
                end
                done = true
            end
            if not done then
                // 闂備礁鎼幏瀣闯閿濆鐒垫い鎺嶈兌椤ｅ弶銇? 闂佽崵濮村ú鈺咁敋瑜斿畷铏逛沪閸撗€鏋栭柣搴岛閺呮繈顢旈崡鐐╂闁瑰灝鍟╃花浠嬫煃鐟欏嫮澧甸柡?
                bool stop2 = false
                while i < n and not stop2 do
                    int c = string.byteAt(s, i)
                    if c == 32 or c == 9 then
                        stop2 = true
                    else
                        cur = cur + string.charAt(s, i)
                        i += 1
                    end
                end
            end
            if string.len(cur) > 0 then
                tokens.append(cur)
            end
        end
    end
    return tokens
end

// 闂備礁婀遍悷鎶藉幢閳哄倹鏉稿┑鐐村灦閹告挳宕戦幘缁樼厸濠㈣鍤庢导鍡涘箳濡も偓閸戠娀鏌熼柇锕€澧柛濠勬暬閺岋綁濡搁妷銉患闂佸湱顒茬换婵嬪极? 闂佸搫顦弲婊堝蓟閵娿儍娲冀閵婏妇绉堕梺瑙勫劤閸熷灝袙婢舵劖鍊垫繛鎴炵懐濞堟ɑ銇勯幋婊呯獢闁?(闂備焦妞垮鍧楀礉鐎ｎ剝濮虫い鎺戝閸ゅ洦鎱ㄥ鍡楀箺闁圭兘浜堕弻鐔烘喆閸曨剛顦Δ?闂傚倷鐒﹁ぐ鍐矓閹绢喗鍋╁Δ锝呭暞閺?.
// 闂備焦鐪归崹纭呫亹婢跺矁濮虫い鎺戝閸欏﹥銇勯弽銊よ吂濞撴埃鍋撻柡? "闂備礁鎲￠懝鐐殽濮濆被浜? 闂備礁鎲＄粙鎺楀垂濠靛绠柕鍫濇川閸楁岸鎮楅敐搴濈盎缂佷緡鍣ｉ弻鐔虹箔濞戞ɑ锛嶉柡鈧? 缂傚倸鍊烽悞锕傚箰婵犳碍鍊跺璺侯儑閳绘棃骞栫划鍏夊亾閹颁焦鐎梻浣告啞閻熲晠銆傞敂鍓у崥閻庨潧鎲＄亸搴ㄦ⒑閸噮鍎愰柡鍡╀邯閺?
func shExecParsed(var parsed) as string
    if parsed["empty"] != null then
        if bool(parsed["empty"]) then
            return ""
        end
    end
    var pipeline = parsed["pipeline"]
    int n = pipeline.length
    if n == 0 then return "" end
    // 缂傚倷鑳舵刊瀵告崲濠靛洨顩? 闂備礁鎲￠幐鍝ョ矓瀹曞洨鍗氶悗娑欘焽閳绘梹銇勮箛鎾搭棡闁伙綁浜跺鍫曞醇閻旂纰嶉梺鎼炲€ら崢浠嬪箯閸涱収鐓ラ柍褜鍓涢幏褰掓偄閻撳氦袝闁圭厧鐡ㄧ换鍕敂閸楃偐妲堥柟鍨暕缁ㄨ姤绻涢崼鐔风仸婵炵厧绻橀獮姗€宕橀幓鎺撹緢
    string flow = ""
    if parsed["redirIn"] != null then
        string rin = string(parsed["redirIn"])
        if string.len(rin) > 0 then
            flow = fsReadFile(rin)
        end
    end
    int i = 0
    while i < n do
        var tokens = pipeline[i]
        bool last = (i == n - 1)
        var res = shRunOne(tokens, flow, last, parsed)
        flow = string(res["out"])
        i += 1
    end
    // output redirect
    if parsed["redirOut"] != null then
        string rout = string(parsed["redirOut"])
        if string.len(rout) > 0 then
            if string.len(flow) > 0 and string.byteAt(flow, string.len(flow) - 1) == 10 then
                flow = string.mid(flow, 0, string.len(flow) - 1)
            end
            fsWriteFile(rout, flow)
            return ""
        end
    end
    return flow
end

// 闂備礁婀遍悷鎶藉幢閳哄倹鏉搁梻浣告啞椤ㄥ棗煤閹达附鐓傛繝濠傜墕瀹告繈鏌熺€涙ê绗氬┑?(token 闂備浇妗ㄩ悞锔界珶閸℃瑥鍨?+ stdin). 闂佸搫顦弲婊堝蓟閵娿儍?{out:..., code:...}.
// isLast 闂備礁鎼粔鏉懨洪埡鍜佹晩闁搞儺鍓欓崣濠冦亜閺嶃劎顣查柛搴★功缁辨帡鎮崨顖滅槇婵炲瓨绮撶粻鏍ь嚕閻㈠壊鏁冮柨婵嗛閺傗偓 (闂備礁鎲￠崝鏇㈠疮閸ф鍋╁Δ锝呭暙閸欏﹥銇勯弽銊ь暡闁稿骸锕濠氬炊閿濆懍澹曢梺鑽ゅ枑濞叉垿鎮為敂鑺ユ珷闁挎洖鍊归弲?.
func shRunOne(var tokens, string stdin, bool isLast, var parsed) as var
    var res = {}
    res["out"] = ""
    res["code"] = 0
    int tn = tokens.length
    if tn == 0 then return res end
    string name = string(tokens[0])
    // 闂備浇銆€閸嬫捇鏌涢锝嗙闁艰尙濞€閺屾稑鈻庤箛鎾亾瑜版帒姹?
    var args = []
    int i = 1
    while i < tn do
        args.append(tokens[i])
        i += 1
    end
    string out = shDispatch(name, args, stdin)
    res["out"] = out
    // 闂備礁鎼悧婊堝磻閸涙惌鏁婄€光偓閸曨偅宓嶉梺闈涱焾閸婃牠宕径鎰叆?闂備胶鍘ч悺銊у枈瀹ュ拑鑰块柣妤€鐗忛埢鏃堟倵閿濆骸浜滈柍顏嗘暬閺?(闂傚倸鍊哥€氥劑宕愬┑鍡╃劷妞ゅ繐鐗嗙€氬顭块懜闈涘婵炲懌鍨介幃妤冩喆閸曨喖顥濋梺?
    if isLast then
        if parsed["redirOut"] != null then
            string rout = string(parsed["redirOut"])
            if string.len(rout) == 0 then
                if string.len(out) > 0 then
                    print(out)
                    if not string.contains(out, "\n") then
                        println("")
                    end
                end
            end
        else
            if string.len(out) > 0 then
                print(out)
                if string.len(out) > 0 then
                    int lastByte = string.byteAt(out, string.len(out) - 1)
                    if lastByte != 10 then
                        println("")
                    end
                end
            end
        end
    end
    return res
end

// 闂備礁鎲＄粙鎺楀垂濠靛绠柕鍫濐槸缁€鍡涙煕閳╁喚娈旂紒?
func shDispatch(string name, var args, string stdin) as string
    if name == "echo" then return shEcho(args) end
    if name == "ls" then return shLs(args) end
    if name == "cat" then return shCat(args, stdin) end
    if name == "ps" then return shPs() end
    if name == "mem" then return shMem() end
    if name == "kill" then return shKill(args) end
    if name == "exec" then return shExec(args) end
    if name == "cd" then return shCd(args) end
    if name == "pwd" then return shPwd() end
    if name == "mkdir" then return shMkdir(args) end
    if name == "touch" then return shTouch(args) end
    if name == "rm" then return shRm(args) end
    if name == "write" then return shWrite(args) end
    if name == "alloc" then return shAlloc(args) end
    if name == "free" then return shFree(args) end
    if name == "help" then return shHelp() end
    if name == "tree" then return shTree() end
    if name == "true" then return "" end
    if name == "false" then return "" end
    return "xos: unknown command: " + name + "\n"
end

// ---- 闂備礁鎲￠崝鏇㈠箠閹扮増鍋柛鈩冪☉瀹告繈鏌熺€涙ê绗氬┑顔哄灲閹宕烽鐐版埛濡?----

func shEcho(var args) as string
    string s = ""
    int n = args.length
    int i = 0
    while i < n do
        if i > 0 then s = s + " " end
        s = s + args[i]
        i += 1
    end
    return s + "\n"
end

func shLs(var args) as string
    string target = "."
    if args.length > 0 then
        target = string(args[0])
    end
    int id = fsResolve(target)
    if id == NIL then
        return "ls: cannot access '" + target + "'\n"
    end
    Inode n = g_inodes[id]
    if n.type == FT_FILE then
        return n.name + "\n"
    end
    var items = fsListDir(target)
    string s = ""
    int i = 0
    while i < items.length do
        s = s + items[i] + "\n"
        i += 1
    end
    return s
end

func shCat(var args, string stdin) as string
    if args.length == 0 then
        return stdin
    end
    string s = ""
    int i = 0
    while i < args.length do
        string p = string(args[i])
        int id = fsResolve(p)
        if id == NIL then
            s = s + "cat: " + p + ": no such file\n"
        else
            Inode n = g_inodes[id]
            if n.type == FT_DIR then
                s = s + "cat: " + p + ": is a directory\n"
            else
                s = s + n.content
            end
        end
        i += 1
    end
    return s
end

func shPs() as string
    string s = ""
    s = padR("PID", 6) + padR("NAME", 14) + padR("STATE", 12) + padR("LEVEL", 7) + padR("BURST", 7) + padR("REMAIN", 7) + padR("ARR", 6) + padR("WAIT", 7) + "\n"
    int i = 1
    int n = g_pcb.length
    while i < n do
        PCB p = g_pcb[i]
        s = s + padR(i2s(p.pid), 6) + padR(p.name, 14) + padR(procStateName(p.state), 12) + padR(i2s(p.level), 7) + padR(i2s(p.burstTime), 7) + padR(i2s(p.remaining), 7) + padR(i2s(p.arrivalTime), 6) + padR(i2s(p.waitTime), 7) + "\n"
        i += 1
    end
    return s
end

func shMem() as string
    int used = 0
    int i = 0
    while i < NUM_FRAMES do
        if g_frameOwner[i] != NIL then
            used = used + 1
        end
        i += 1
    end
    int hitRate = 0
    if g_memTranslate > 0 then
        hitRate = (g_memTlbHit * 100) / g_memTranslate
    end
    string s = ""
    s = s + "frames: " + i2s(used) + "/" + i2s(NUM_FRAMES) + "\n"
    s = s + "translates: " + i2s(g_memTranslate) + "\n"
    s = s + "tlb hit/miss: " + i2s(g_memTlbHit) + "/" + i2s(g_memTlbMiss) + " (" + i2s(hitRate) + "%)\n"
    s = s + "page faults: " + i2s(g_memPageFault) + " evictions: " + i2s(g_memEvict) + "\n"
    return s
end

func shKill(var args) as string
    if args.length == 0 then
        return "kill: usage: kill <pid>\n"
    end
    int pid = parseIntSafe(string(args[0]), -1)
    if pid < 1 or pid >= g_pcb.length then
        return "kill: no such process: " + args[0] + "\n"
    end
    procTerminate(pid, 9)
    mlfqRemove(pid)
    return "killed pid " + i2s(pid) + "\n"
end

// exec <name> <burst> <level>  -> 闂?OS 闂傚倷鐒﹁ぐ鍐嚐椤栫偛鍨傞柛妤冨剱閸ゅ牓寮堕悙鏉戭棆妞ゅ繐宕埥澶愬箼閸愌勬崳缂備胶绮敃銏ゅ极?(濠电偛鐡ㄩ崵搴ㄥ磹閹炬儼濮抽柡澶嬵儥閸ゆ洟鐓崶銊︹拹闁哄棗鐗撻弻?.
func shExec(var args) as string
    if args.length < 2 then
        return "exec: usage: exec <name> <burst> [level] [program...]\n"
    end
    string pname = string(args[0])
    int burst = parseIntSafe(string(args[1]), 5)
    int level = 0
    if args.length >= 3 then
        level = parseIntSafe(string(args[2]), 0)
    end
    array<string> prog = array[]
    int i = 3
    while i < args.length do
        prog.append(string(args[i]))
        i += 1
    end
    if prog.length == 0 then
        prog.append("compute " + i2s(burst))
    end
    int pid = procCreate(pname, g_totalTick, burst, level, prog)
    procArrive(pid)
    return "executed pid=" + i2s(pid) + " name=" + pname + "\n"
end

func shCd(var args) as string
    string target = "/"
    if args.length > 0 then
        target = string(args[0])
    end
    if not fsCd(target) then
        return "cd: " + target + ": no such directory\n"
    end
    return ""
end

func shPwd() as string
    return fsPwd() + "\n"
end

func shMkdir(var args) as string
    if args.length == 0 then
        return "mkdir: usage: mkdir <path> [path...]\n"
    end
    string s = ""
    int i = 0
    while i < args.length do
        string p = string(args[i])
        if fsMkdir(p, PERM_RWX) == NIL then
            s = s + "mkdir: cannot create '" + p + "'\n"
        end
        i += 1
    end
    return s
end

func shTouch(var args) as string
    if args.length == 0 then
        return "touch: usage: touch <path>\n"
    end
    string p = string(args[0])
    if not fsExists(p) then
        if fsCreate(p, PERM_RW) == NIL then
            return "touch: cannot create '" + p + "'\n"
        end
    end
    return ""
end

func shRm(var args) as string
    if args.length == 0 then
        return "rm: usage: rm <path>\n"
    end
    string p = string(args[0])
    if not fsRemove(p) then
        return "rm: cannot remove '" + p + "'\n"
    end
    return ""
end

// write <path> <text...>
func shWrite(var args) as string
    if args.length < 2 then
        return "write: usage: write <path> <text>\n"
    end
    string p = string(args[0])
    string txt = ""
    int i = 1
    while i < args.length do
        if i > 1 then txt = txt + " " end
        txt = txt + args[i]
        i += 1
    end
    if not fsWriteFile(p, txt) then
        return "write: cannot write '" + p + "'\n"
    end
    return ""
end

// alloc <pid> <vaddr>  -> 闂佽崵鍠愰悷杈╃不閹达絻浜归柛宀€鍋涚粈鍐煕濞戝崬骞橀柟鐣屽Х缁辨捇宕奸悢鍓叉健闂?
func shAlloc(var args) as string
    if args.length < 2 then
        return "alloc: usage: alloc <pid> <vaddr>\n"
    end
    int pid = parseIntSafe(string(args[0]), -1)
    int vaddr = parseIntSafe(string(args[1]), 0)
    if pid < 1 or pid >= g_pcb.length then
        return "alloc: invalid pid\n"
    end
    int paddr = memTranslate(pid, vaddr)
    if paddr == NIL then
        return "alloc: translation failed\n"
    end
    return "vaddr " + i2s(vaddr) + " -> paddr " + i2s(paddr) + "\n"
end

// free <pid>  -> 闂傚倷鐒﹁ぐ鍐晝閵夆晛妫樺ù锝囧劋鐎氭岸鏌曟径鍫濆缂佺姾宕电槐鎺斺偓锝庝憾閸庢垶绻涢崼鐔风伌鐎规洘锕㈠畷銊╊敇閻樿櫕鍠?
func shFree(var args) as string
    if args.length < 1 then
        return "free: usage: free <pid>\n"
    end
    int pid = parseIntSafe(string(args[0]), -1)
    if pid < 1 or pid >= g_pcb.length then
        return "free: invalid pid\n"
    end
    memReleaseProc(pid)
    PCB p = g_pcb[pid]
    p.ptDirId = memAllocDir()
    g_pcb[pid] = p
    return "freed memory of pid " + i2s(pid) + "\n"
end

func shHelp() as string
    string s = ""
    s = s + "xos shell built-in commands:\n"
    s = s + "  echo <text>            print text\n"
    s = s + "  ls [path]              list directory\n"
    s = s + "  cat <file>             print file contents (reads stdin if no arg)\n"
    s = s + "  pwd                    print working directory\n"
    s = s + "  cd <path>              change directory\n"
    s = s + "  mkdir <path>           create directory\n"
    s = s + "  touch <path>           create empty file\n"
    s = s + "  rm <path>              remove file/empty dir\n"
    s = s + "  write <path> <text>    write text to file\n"
    s = s + "  ps                     list processes\n"
    s = s + "  mem                    show memory stats\n"
    s = s + "  kill <pid>             terminate process\n"
    s = s + "  exec <name> <burst> [level] [program...]  create a process\n"
    s = s + "  alloc <pid> <vaddr>    translate virtual address\n"
    s = s + "  free <pid>             release process memory\n"
    s = s + "  tree                   dump filesystem tree\n"
    s = s + "  help                   this message\n"
    s = s + "syntax: cmd1 | cmd2   > file   < file   &\n"
    return s
end

func shTree() as string
    string s = ""
    int i = 0
    while i < g_inodes.length do
        Inode n = g_inodes[i]
        if n.parent == NIL and i != g_rootIno then
            // orphan, skip
        else
            string pad = ""
            int d = 0
            int cur = i
            int depth = 0
            // calc depth by climbing
            while cur != g_rootIno and cur != NIL do
                Inode c = g_inodes[cur]
                cur = c.parent
                depth += 1
                if depth > 64 then cur = g_rootIno end
            end
            d = 0
            while d < depth do
                pad = pad + "  "
                d += 1
            end
            string typ = "D"
            if n.type == FT_FILE then typ = "F" end
            s = s + pad + typ + " " + n.name
            if n.parent == NIL and i == g_rootIno then
                // root
            end
            s = s + "\n"
        end
        i += 1
    end
    return s
end

// 闂備礁婀遍悷鎶藉幢閳哄倹鏉稿┑鐐村灦閹告挳宕戦幘缁樼叆?shell 闂備胶鍘ч悺銊у枈瀹ュ拑鑰垮ù鍏兼綑濡﹢鏌涢妷顖炴妞?
func shRunScript(string path) as int
    if not file.exists(path) then
        println("xos: script not found: " + path)
        return 1
    end
    string text = file.readText(path)
    var lines = string.splitLines(text)
    int n = lines.length
    int i = 0
    int errors = 0
    while i < n do
        string line = string(lines[i])
        i += 1
        string t = trimP(line)
        if string.len(t) == 0 then
            // 缂傚倷绀侀惌鍌滅磽濮樿翰鈧線骞嬮悩鍐茬／闁诲骸婀辨慨椋庣不?
        else
            int hb = string.byteAt(t, 0)
                // '#' 婵炴垶鎸哥粔闈浳?xlang 濠电偛顦崝鎴﹀闯閹绢喖绀堢€广儱娲ㄧ壕? 闁荤喐鐟ュΛ鏃傛嫻閻旂厧鐤炬い鏇楀亾闁逞屽墯閼归箖骞婇埄鍐浄闁靛牆鎳愰幗鐔虹磼?
            if hb == 47 and string.len(t) >= 2 and string.byteAt(t, 1) == 47 then
                // 闂佽崵鍋炵粙鎴﹀嫉椤掑嫬鏋侀柣鎰劋閺?//
            else
                var parsed = shParse(line)
                shExecParsed(parsed)
            end
        end
    end
    return errors
end


