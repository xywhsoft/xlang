// xos - 集成式操作系统模拟器
//
// 用法：
//   xos test                 运行进程、内存、文件系统、Shell 和 syscall 自测
//   xos shell <script.xsh>   执行 Shell 脚本
//   xos demo                 运行完整的系统启动与调度演示
//   xos help                 显示帮助
//
// 功能组成：
//   1. 进程管理：PCB 生命周期、三级 MLFQ、时间片、优先级提升和睡眠唤醒。
//   2. 虚拟内存：二级页表、TLB、缺页处理、LRU 页面置换和进程地址空间释放。
//   3. 文件系统：inode、目录树、权限、文件描述符及 open/read/write/lseek。
//   4. Shell：命令解析、管道、重定向以及进程、内存、文件系统管理命令。
//   5. syscall：用统一分派入口连接进程、内存和文件系统子系统。
//
// 该项目故意使用固定大小的数组和整数句柄模拟内核表，保持状态布局可观察、
// 测试可重复；它不是宿主操作系统 API 的薄包装。

// ===============================================================
// 全局常量与运行状态
// ===============================================================

int PROC_NEW        = 0
int PROC_READY      = 1
int PROC_RUNNING    = 2
int PROC_WAITING    = 3
int PROC_TERMINATED = 4

int MLFQ_LEVELS = 3
int MLFQ_Q0     = 2
int MLFQ_Q1     = 4
int MLFQ_Q2     = 8
int MLFQ_BOOST  = 50

int FRAME_SIZE      = 16
int NUM_FRAMES      = 32
int PAGE_DIR_SIZE   = 8
int PAGE_TABLE_SIZE = 8
int NUM_DIR_SLOTS   = 64
int NUM_TAB_SLOTS   = 512
int TLB_SIZE        = 8
int PAGE_INVALID    = -1

int OFF_BITS = 4
int OFF_MASK = 15     // 0xF
int TAB_BITS = 3
int TAB_MASK = 7      // 0x7
int DIR_MASK = 7

int FT_FILE = 0
int FT_DIR  = 1
int NIL     = -1
int PERM_R    = 4
int PERM_W    = 2
int PERM_X    = 1
int PERM_RWX  = 7
int PERM_RW   = 6
int PERM_RX   = 5
int PERM_NONE = 0
int MAX_OPEN_FILES = 64
int MAX_INODES = 1024

int SYS_FORK  = 1
int SYS_EXEC  = 2
int SYS_EXIT  = 3
int SYSOPEN  = 4
int SYS_READ  = 5
int SYS_WRITE = 6
int SYS_CLOSE = 7
int SYS_LSEEK = 8
int SYS_MKDIR = 9
int SYS_LS    = 10
int SYS_RM    = 11
int SYS_PS    = 12
int SYS_MEM   = 13
int SYS_KILL  = 14
int SYS_CAT   = 15
int SYS_TOUCH = 16
int SYS_ALLOC = 17
int SYS_ACCESS = 18
int SYS_HELP  = 19

int EXIT_OK = 0
int SLASH_BYTE = 47   // '/'


// ===============================================================

array<PCB> g_pcb = array[]
array<int> g_mlfq0 = array[]
array<int> g_mlfq1 = array[]
array<int> g_mlfq2 = array[]
int g_currentPid   = NIL
int g_nextPid      = 1
int g_contextSwitches = 0
int g_totalTick    = 0
int g_lastBoost    = 0
bool g_trace       = false

int g_idleTicks    = 0


// ===============================================================

array<int> g_frameOwner = array[]
array<int> g_frameTick  = array[]
array<int> g_ptDir      = array[]
array<bool> g_ptDirUsed = array[]
array<int> g_ptTab      = array[]
array<bool> g_ptTabUsed = array[]
array<TlbEntry> g_tlb   = array[]

int g_memTranslate = 0
int g_memTlbHit    = 0
int g_memTlbMiss   = 0
int g_memPageFault = 0
int g_memEvict     = 0
int g_memAlloc     = 0

// ===============================================================

array<Inode> g_inodes = array[]
int g_rootIno  = 0
int g_cwdIno   = 0
int g_nextIno  = 1

array<OpenFile> g_open = array[]
array<bool> g_openUsed = array[]
int g_openCount = 0


