// ===============================================================
// 进程与 MLFQ 调度器
// ===============================================================
class PCB
    derive value
    int pid = 0
    string name = ""
    int state = 0
    int level = 0
    int burstTime = 0
    int arrivalTime = 0
    int remaining = 0
    int usedInLevel = 0
    int parentPid = NIL
    int waitTime = 0
    int startTime = -1
    int completionTime = 0
    int responseTime = -1
    int pc = 0
    int ptDirId = NIL
    int sleepUntil = -1
    int exitCode = 0
    array<string> program = array[]
    array<int> fdMap = array[]
    int computeLeft = 0
end

func procStateName(int s) as string
    if s == PROC_NEW        then return "new"        end
    if s == PROC_READY      then return "ready"      end
    if s == PROC_RUNNING    then return "running"    end
    if s == PROC_WAITING    then return "waiting"    end
    if s == PROC_TERMINATED then return "terminated" end
    return "unknown"
end

func procCreate(string name, int arrival, int burst, int level, array<string> program) as int
    PCB p = PCB()
    p.pid = g_nextPid
    p.name = name
    p.state = PROC_NEW
    p.level = level
    p.burstTime = burst
    p.arrivalTime = arrival
    p.remaining = burst
    p.usedInLevel = 0
    p.parentPid = g_currentPid
    p.pc = 0
    p.program = program
    p.ptDirId = memAllocDir()
    g_pcb.append(p)
    int pid = g_nextPid
    g_nextPid = g_nextPid + 1
    trace("procCreate pid=" + i2s(pid) + " name=" + name + " burst=" + i2s(burst))
    return pid
end

func procTerminate(int pid, int code)
    if pid < 0 or pid >= g_pcb.length then
        return
    end
    if g_pcb[pid].state == PROC_TERMINATED then
        return
    end
    g_pcb[pid].state = PROC_TERMINATED
    g_pcb[pid].completionTime = g_totalTick
    g_pcb[pid].exitCode = code
    g_pcb[pid].remaining = 0
    procCloseAllFd(pid)
    memReleaseProc(pid)
    if g_currentPid == pid then
        g_currentPid = NIL
    end
    trace("procTerminate pid=" + i2s(pid) + " code=" + i2s(code))
end


func procOpen(int pid, string path, string mode) as int
    int gslot = fsOpen(path, mode)
    if gslot == NIL then return NIL end
    PCB p = g_pcb[pid]
    int localFd = NIL
    int i = 0
    int m = p.fdMap.length
    while i < m
        if p.fdMap[i] == NIL then
            localFd = i
            i = m
        end
        i += 1
    end
    if localFd == NIL then
        p.fdMap.append(gslot)
        localFd = p.fdMap.length - 1
    else
        p.fdMap[localFd] = gslot
    end
    g_pcb[pid] = p
    return localFd
end

func procLocalToGlobal(int pid, int localFd) as int
    PCB p = g_pcb[pid]
    if localFd < 0 or localFd >= p.fdMap.length then return NIL end
    return p.fdMap[localFd]
end

func procCloseLocal(int pid, int localFd) as bool
    PCB p = g_pcb[pid]
    if localFd < 0 or localFd >= p.fdMap.length then return false end
    int gslot = p.fdMap[localFd]
    if gslot == NIL then return false end
    fsClose(gslot)
    p.fdMap[localFd] = NIL
    g_pcb[pid] = p
    return true
end

func procCloseAllFd(int pid)
    PCB p = g_pcb[pid]
    int i = 0
    int m = p.fdMap.length
    while i < m
        if p.fdMap[i] != NIL then
            fsClose(p.fdMap[i])
            p.fdMap[i] = NIL
        end
        i += 1
    end
    g_pcb[pid] = p
end

func mlfqRemove(int pid)
    procRemoveFromQueue(g_mlfq0, pid)
    procRemoveFromQueue(g_mlfq1, pid)
    procRemoveFromQueue(g_mlfq2, pid)
end

func procRemoveFromQueue(array<int> q, int pid)
    int i = 0
    int n = q.length
    bool done = false
    while i < n and not done
        if q[i] == pid then
            q.remove(i)
            done = true
        end
        i += 1
    end
end

func mlfqEnqueue(int pid, int level)
    if pid < 0 or pid >= g_pcb.length then return end
    g_pcb[pid].level = clamp(level, 0, MLFQ_LEVELS - 1)
    g_pcb[pid].usedInLevel = 0
    g_pcb[pid].state = PROC_READY
    if g_pcb[pid].level == 0 then
        g_mlfq0.append(pid)
    elseif g_pcb[pid].level == 1 then
        g_mlfq1.append(pid)
    else
        g_mlfq2.append(pid)
    end
end

func procArrive(int pid)
    if pid < 0 or pid >= g_pcb.length then return end
    PCB p = g_pcb[pid]
    if p.state != PROC_NEW then return end
    mlfqEnqueue(pid, p.level)
    trace("procArrive pid=" + i2s(pid) + " at tick " + i2s(g_totalTick))
end

func mlfqPopHead() as int
    if g_mlfq0.length > 0 then
        int pid = g_mlfq0[0]
        g_mlfq0.remove(0)
        return pid
    end
    if g_mlfq1.length > 0 then
        int pid = g_mlfq1[0]
        g_mlfq1.remove(0)
        return pid
    end
    if g_mlfq2.length > 0 then
        int pid = g_mlfq2[0]
        g_mlfq2.remove(0)
        return pid
    end
    return NIL
end

func levelQuantum(int level) as int
    if level == 0 then return MLFQ_Q0 end
    if level == 1 then return MLFQ_Q1 end
    return MLFQ_Q2
end

func mlfqBoost()
    while g_mlfq1.length > 0
        int pid = g_mlfq1[0]
        g_mlfq1.remove(0)
        mlfqEnqueue(pid, 0)
    end
    while g_mlfq2.length > 0
        int pid = g_mlfq2[0]
        g_mlfq2.remove(0)
        mlfqEnqueue(pid, 0)
    end
    g_lastBoost = g_totalTick
    trace("mlfqBoost @tick " + i2s(g_totalTick))
end

func contextSwitch(int newPid)
    if g_currentPid == newPid then
        return
    end
    if g_currentPid != NIL and g_currentPid >= 0 and g_currentPid < g_pcb.length then
        if g_pcb[g_currentPid].state == PROC_RUNNING then
            g_pcb[g_currentPid].state = PROC_READY
        end
    end
    g_currentPid = newPid
    g_contextSwitches = g_contextSwitches + 1
    memFlushTlb()
    if newPid != NIL and newPid >= 0 and newPid < g_pcb.length then
        g_pcb[newPid].state = PROC_RUNNING
        if g_pcb[newPid].responseTime < 0 then
            g_pcb[newPid].responseTime = g_totalTick - g_pcb[newPid].arrivalTime
            g_pcb[newPid].startTime = g_totalTick
        end
        trace("contextSwitch -> pid=" + i2s(newPid) + " (level " + i2s(g_pcb[newPid].level) + ")")
    end
end

func procRunQuantum(int pid, int quantum) as int
    int used = 0
    while used < quantum
        if g_pcb[pid].state == PROC_TERMINATED then
            return used
        end
        if g_pcb[pid].state == PROC_WAITING then
            return used
        end
        if g_pcb[pid].computeLeft > 0 then
            g_pcb[pid].computeLeft = g_pcb[pid].computeLeft - 1
            procDecRemaining(pid, 1)
            used = used + 1
        else
            int progLen = g_pcb[pid].program.length
            if g_pcb[pid].pc >= progLen then
                procTerminate(pid, EXIT_OK)
                return used
            end
            string line = g_pcb[pid].program[g_pcb[pid].pc]
            g_pcb[pid].pc = g_pcb[pid].pc + 1
            int cost = execOp(pid, line)
            if cost < 1 then cost = 1 end
            used = used + 1
        end
        if g_pcb[pid].state == PROC_WAITING then
            return used
        end
        if g_pcb[pid].state == PROC_TERMINATED then
            return used
        end
    end
    return used
end
func procWakeSleepers()
    int i = 1
    int n = g_pcb.length
    while i < n
        if g_pcb[i].state == PROC_WAITING then
            if g_pcb[i].sleepUntil >= 0 and g_totalTick >= g_pcb[i].sleepUntil then
                int lvl = g_pcb[i].level
                g_pcb[i].sleepUntil = -1
                mlfqEnqueue(i, lvl)
                trace("procWake pid=" + i2s(i) + " @tick " + i2s(g_totalTick))
            end
        end
        i += 1
    end
end

func procAdmitArrivals()
    int i = 1
    int n = g_pcb.length
    while i < n
        PCB p = g_pcb[i]
        if p.state == PROC_NEW and p.arrivalTime <= g_totalTick then
            procArrive(i)
        end
        i += 1
    end
end

func procHasAlive() as bool
    int i = 1
    int n = g_pcb.length
    while i < n
        PCB p = g_pcb[i]
        if p.state != PROC_TERMINATED then
            return true
        end
        i += 1
    end
    return false
end

func procReadyCount() as int
    int c = 0
    c = c + g_mlfq0.length
    c = c + g_mlfq1.length
    c = c + g_mlfq2.length
    int i = 1
    int n = g_pcb.length
    while i < n
        PCB p = g_pcb[i]
        if p.state == PROC_RUNNING or p.state == PROC_WAITING then
            c = c + 1
        end
        i += 1
    end
    return c
end

func procTickWait()
    int i = 1
    int n = g_pcb.length
    while i < n
        if g_pcb[i].state == PROC_READY or g_pcb[i].state == PROC_WAITING then
            g_pcb[i].waitTime = g_pcb[i].waitTime + 1
        end
        i += 1
    end
end

func schedulerLoop(int maxTicks)
    bool stop = false
    int guard = 0
    while not stop
        guard = guard + 1
        if guard > maxTicks then
            println("xos: scheduler maxTicks reached, stopping")
            stop = true
        end
        procAdmitArrivals()
        procWakeSleepers()
        if g_totalTick - g_lastBoost >= MLFQ_BOOST then
            mlfqBoost()
        end
        int pid = mlfqPopHead()
        if pid == NIL then
            if procHasAlive() then
                g_totalTick = g_totalTick + 1
                g_idleTicks = g_idleTicks + 1
                procTickWait()
            else
                stop = true
            end
        else
            contextSwitch(pid)
    PCB p = g_pcb[pid]
            int q = levelQuantum(p.level)
            int used = procRunQuantum(pid, q)
            g_totalTick = g_totalTick + used
            int i = 1
            int n = g_pcb.length
            while i < n
                if i != pid then
                    if g_pcb[i].state == PROC_READY or g_pcb[i].state == PROC_WAITING then
                        g_pcb[i].waitTime = g_pcb[i].waitTime + used
                    end
                end
                i += 1
            end
            if g_pcb[pid].state == PROC_TERMINATED then
            elseif g_pcb[pid].state == PROC_WAITING then
            else
                g_pcb[pid].usedInLevel = g_pcb[pid].usedInLevel + used
                if g_pcb[pid].remaining <= 0 then
                    procTerminate(pid, EXIT_OK)
                else
                    int newLevel = g_pcb[pid].level
                    if g_pcb[pid].usedInLevel >= levelQuantum(g_pcb[pid].level) then
                        newLevel = g_pcb[pid].level + 1
                        if newLevel > MLFQ_LEVELS - 1 then
                            newLevel = MLFQ_LEVELS - 1
                        end
                    end
                    g_pcb[pid].state = PROC_READY
                    mlfqEnqueue(pid, newLevel)
                end
            end
            g_currentPid = NIL
        end
        if not procHasAlive() then
            stop = true
        end
    end
end

func procDecRemaining(int pid, int n)
    g_pcb[pid].remaining = g_pcb[pid].remaining - n
    if g_pcb[pid].remaining < 0 then
        g_pcb[pid].remaining = 0
    end
end


// ===============================================================
// ===============================================================

// ===============================================================
// 虚拟内存、页表与 TLB
// ===============================================================
class TlbEntry
    derive value
    int vpn = -1
    int frame = -1
    bool valid = false
    int pid = -1
    int tick = 0
end

func memInit()
    g_frameOwner = array[]
    g_frameTick = array[]
    g_ptDir = array[]
    g_ptDirUsed = array[]
    g_ptTab = array[]
    g_ptTabUsed = array[]
    g_tlb = array[]
    int i = 0
    while i < NUM_FRAMES
        g_frameOwner.append(NIL)
        g_frameTick.append(0)
        i += 1
    end
    i = 0
    while i < NUM_DIR_SLOTS * PAGE_DIR_SIZE
        g_ptDir.append(NIL)
        i += 1
    end
    i = 0
    while i < NUM_DIR_SLOTS
        g_ptDirUsed.append(false)
        i += 1
    end
    i = 0
    while i < NUM_TAB_SLOTS * PAGE_TABLE_SIZE
        g_ptTab.append(NIL)
        i += 1
    end
    i = 0
    while i < NUM_TAB_SLOTS
        g_ptTabUsed.append(false)
        i += 1
    end
    i = 0
    while i < TLB_SIZE
        g_tlb.append(TlbEntry())
        i += 1
    end
end

func memAllocDir() as int
    int i = 0
    while i < NUM_DIR_SLOTS
        if not g_ptDirUsed[i] then
            g_ptDirUsed[i] = true
            int j = 0
            while j < PAGE_DIR_SIZE
                g_ptDir[i * PAGE_DIR_SIZE + j] = NIL
                j += 1
            end
            return i
        end
        i += 1
    end
    return NIL
end

func memAllocTab() as int
    int i = 0
    while i < NUM_TAB_SLOTS
        if not g_ptTabUsed[i] then
            g_ptTabUsed[i] = true
            int j = 0
            while j < PAGE_TABLE_SIZE
                g_ptTab[i * PAGE_TABLE_SIZE + j] = NIL
                j += 1
            end
            return i
        end
        i += 1
    end
    return NIL
end

func memFreeDir(int dirId)
    if dirId < 0 or dirId >= NUM_DIR_SLOTS then return end
    g_ptDirUsed[dirId] = false
end

func memFreeTab(int tabId)
    if tabId < 0 or tabId >= NUM_TAB_SLOTS then return end
    g_ptTabUsed[tabId] = false
end

func memAllocFrame(int pid) as int
    int i = 0
    while i < NUM_FRAMES
        if g_frameOwner[i] == NIL then
            g_frameOwner[i] = pid
            g_frameTick[i] = g_totalTick
            g_memAlloc = g_memAlloc + 1
            return i
        end
        i += 1
    end
    int victim = memLruVictim()
    if victim == NIL then
        return NIL
    end
    memEvictFrame(victim)
    g_frameOwner[victim] = pid
    g_frameTick[victim] = g_totalTick
    g_memAlloc = g_memAlloc + 1
    return victim
end

func memLruVictim() as int
    int best = NIL
    int bestTick = -1
    int i = 0
    while i < NUM_FRAMES
        if g_frameOwner[i] != NIL then
            if bestTick < 0 or g_frameTick[i] < bestTick then
                bestTick = g_frameTick[i]
                best = i
            end
        end
        i += 1
    end
    return best
end

func memEvictFrame(int frame)
    g_memEvict = g_memEvict + 1
    int owner = g_frameOwner[frame]
    g_frameOwner[frame] = NIL
    trace("memEvict frame=" + i2s(frame) + " owner=" + i2s(owner))
    int i = 0
    while i < NUM_TAB_SLOTS
        if g_ptTabUsed[i] then
            int j = 0
            while j < PAGE_TABLE_SIZE
                if g_ptTab[i * PAGE_TABLE_SIZE + j] == frame then
                    g_ptTab[i * PAGE_TABLE_SIZE + j] = NIL
                end
                j += 1
            end
        end
        i += 1
    end
    int t = 0
    while t < TLB_SIZE
        if g_tlb[t].valid and g_tlb[t].frame == frame then
            g_tlb[t].valid = false
            g_tlb[t].vpn = -1
            g_tlb[t].frame = -1
        end
        t += 1
    end
end

func memReleaseProc(int pid)
    int i = 0
    while i < NUM_FRAMES
        if g_frameOwner[i] == pid then
            g_frameOwner[i] = NIL
        end
        i += 1
    end
    int t = 0
    while t < TLB_SIZE
        if g_tlb[t].valid and g_tlb[t].pid == pid then
            g_tlb[t].valid = false
            g_tlb[t].vpn = -1
            g_tlb[t].frame = -1
        end
        t += 1
    end
    if pid < 0 or pid >= g_pcb.length then return end
    int dirId = g_pcb[pid].ptDirId
    if dirId == NIL then return end
    int j = 0
    while j < PAGE_DIR_SIZE
        int tabId = g_ptDir[dirId * PAGE_DIR_SIZE + j]
        if tabId != NIL then
            memFreeTab(tabId)
            g_ptDir[dirId * PAGE_DIR_SIZE + j] = NIL
        end
        j += 1
    end
    memFreeDir(dirId)
    g_pcb[pid].ptDirId = NIL
end
func memTlbLookup(int pid, int vpn) as int
    int i = 0
    while i < TLB_SIZE
        if g_tlb[i].valid and g_tlb[i].pid == pid and g_tlb[i].vpn == vpn then
            g_tlb[i].tick = g_totalTick
            return g_tlb[i].frame
        end
        i += 1
    end
    return NIL
end

func memTlbInsert(int pid, int vpn, int frame)
    int victimSlot = NIL
    int oldestTick = -1
    int i = 0
    while i < TLB_SIZE
        if not g_tlb[i].valid then
            victimSlot = i
            oldestTick = -1
            i = TLB_SIZE
        else
            if oldestTick < 0 or g_tlb[i].tick < oldestTick then
                oldestTick = g_tlb[i].tick
                victimSlot = i
            end
        end
        i += 1
    end
    if victimSlot == NIL then return end
    g_tlb[victimSlot].valid = true
    g_tlb[victimSlot].pid = pid
    g_tlb[victimSlot].vpn = vpn
    g_tlb[victimSlot].frame = frame
    g_tlb[victimSlot].tick = g_totalTick
end

func memFlushTlb()
    int i = 0
    while i < TLB_SIZE
        g_tlb[i].valid = false
        g_tlb[i].vpn = -1
        g_tlb[i].frame = -1
        g_tlb[i].pid = -1
        i += 1
    end
end

func memHandleFault(int pid, int dirIdx, int tabIdx, int vpn) as int
    g_memPageFault = g_memPageFault + 1
    int dirId = g_pcb[pid].ptDirId
    if dirId == NIL then
        dirId = memAllocDir()
        g_pcb[pid].ptDirId = dirId
    end
    int tabId = g_ptDir[dirId * PAGE_DIR_SIZE + dirIdx]
    if tabId == NIL then
        tabId = memAllocTab()
        g_ptDir[dirId * PAGE_DIR_SIZE + dirIdx] = tabId
    end
    int frame = memAllocFrame(pid)
    if frame == NIL then
        return NIL
    end
    g_ptTab[tabId * PAGE_TABLE_SIZE + tabIdx] = frame
    trace("pageFault pid=" + i2s(pid) + " vpn=" + i2s(vpn) + " frame=" + i2s(frame))
    return frame
end

func memTranslate(int pid, int vaddr) as int
    if pid < 0 or pid >= g_pcb.length then return NIL end
    g_memTranslate = g_memTranslate + 1
    int offset = vaddr & OFF_MASK
    int vpn = vaddr >> OFF_BITS
    int dirIdx = (vpn >> TAB_BITS) & DIR_MASK
    int tabIdx = vpn & TAB_MASK
    int frame = memTlbLookup(pid, vpn)
    if frame != NIL then
        g_memTlbHit = g_memTlbHit + 1
        g_frameTick[frame] = g_totalTick
        return frame * FRAME_SIZE + offset
    end
    g_memTlbMiss = g_memTlbMiss + 1
    PCB p = g_pcb[pid]
    int dirId = p.ptDirId
    if dirId != NIL then
        int tabId = g_ptDir[dirId * PAGE_DIR_SIZE + dirIdx]
        if tabId != NIL then
            int fr = g_ptTab[tabId * PAGE_TABLE_SIZE + tabIdx]
            if fr != NIL then
                frame = fr
            end
        end
    end
    if frame == NIL then
        frame = memHandleFault(pid, dirIdx, tabIdx, vpn)
        if frame == NIL then
            return NIL
        end
    end
    memTlbInsert(pid, vpn, frame)
    g_frameTick[frame] = g_totalTick
    return frame * FRAME_SIZE + offset
end

func memReport()
    int used = 0
    int i = 0
    while i < NUM_FRAMES
        if g_frameOwner[i] != NIL then
            used = used + 1
        end
        i += 1
    end
    int hitRate = 0
    if g_memTranslate > 0 then
        hitRate = (g_memTlbHit * 100) / g_memTranslate
    end
    println(rep("=", 60))
    println("Memory Report")
    println(rep("=", 60))
    println("Frames: " + i2s(used) + "/" + i2s(NUM_FRAMES) + " used")
    println("Translates: " + i2s(g_memTranslate))
    println("TLB hits   : " + i2s(g_memTlbHit) + "  misses: " + i2s(g_memTlbMiss) + "  hitRate=" + i2s(hitRate) + "%")
    println("Page faults: " + i2s(g_memPageFault))
    println("Evictions  : " + i2s(g_memEvict))
    println("Alloc frames: " + i2s(g_memAlloc))
end

func memDumpProc(int pid) as string
    if pid < 0 or pid >= g_pcb.length then return "" end
    PCB p = g_pcb[pid]
    string s = "PID " + i2s(pid) + " page table:\n"
    int dirId = p.ptDirId
    if dirId == NIL then
        return s + "  (no page directory)\n"
    end
    int d = 0
    while d < PAGE_DIR_SIZE
        int tabId = g_ptDir[dirId * PAGE_DIR_SIZE + d]
        if tabId != NIL then
            int t = 0
            while t < PAGE_TABLE_SIZE
                int fr = g_ptTab[tabId * PAGE_TABLE_SIZE + t]
                if fr != NIL then
                    int vpn = (d << TAB_BITS) | t
                    s = s + "  vpn=" + i2s(vpn) + " -> frame=" + i2s(fr) + "\n"
                end
                t += 1
            end
        end
        d += 1
    end
    return s
end


// ===============================================================
// ===============================================================

// ---- Inode ----
// ===============================================================
// 内存文件系统与文件描述符
// ===============================================================
class Inode
    derive value
    string name = ""
    int type = 1              // FT_FILE / FT_DIR
    array<int> children = array[]
    int parent = NIL
    int perm = 7
    string content = ""
    int size = 0
    int ino = 0
end

class OpenFile
    derive value
    int ino = NIL
    int pos = 0
    int mode = 0              // 0=read 1=write 2=rw
    bool used = false
end

func fsInit()
    g_inodes = array[]
    g_open = array[]
    g_openUsed = array[]
    g_openCount = 0
    g_nextIno = 1
    Inode root = Inode()
    root.name = "/"
    root.type = FT_DIR
    root.parent = NIL
    root.perm = PERM_RWX
    root.ino = fsAllocIno()
    g_inodes.append(root)
    g_rootIno = 0
    g_cwdIno = 0
    int i = 0
    while i < MAX_OPEN_FILES
        g_open.append(OpenFile())
        g_openUsed.append(false)
        i += 1
    end
end

func fsAllocIno() as int
    int v = g_nextIno
    g_nextIno = g_nextIno + 1
    return v
end

func fsGet(int ino) as Inode
    return g_inodes[ino]
end

func fsSet(int ino, Inode n)
    g_inodes[ino] = n
end

func fsCheckPerm(int ino, int need) as bool
    Inode n = g_inodes[ino]
    if (n.perm & need) == need then
        return true
    end
    return false
end

func fsIsAbsolute(string p) as bool
    if string.len(p) > 0 then
        if string.byteAt(p, 0) == SLASH_BYTE then
            return true
        end
    end
    return false
end

func fsSplitParent(string p) as var
    int last = -1
    int n = string.len(p)
    int i = 0
    while i < n
        if string.byteAt(p, i) == SLASH_BYTE then
            last = i
        end
        i += 1
    end
    string parent = ""
    string fname = ""
    if last < 0 then
        parent = ""
        fname = p
    else
        parent = string.mid(p, 0, last)
        fname = string.mid(p, last + 1, n - last - 1)
    end
    var result = [parent, fname]
    return result
end

func fsResolve(string p) as int
    if string.len(p) == 0 then
        return g_cwdIno
    end
    int cur = g_cwdIno
    if fsIsAbsolute(p) then
        cur = g_rootIno
    end
    var segs = string.split(p, "/")
    int n = segs.length
    int i = 0
    while i < n
        string seg = string(segs[i])
        if seg == "" or seg == "." then
            // skip
        elseif seg == ".." then
            Inode c = g_inodes[cur]
            if c.parent != NIL then
                cur = c.parent
            end
        else
            Inode dir = g_inodes[cur]
            if dir.type != FT_DIR then
                return NIL
            end
            int found = NIL
            int cn = dir.children.length
            int j = 0
            while j < cn
                Inode ch = g_inodes[dir.children[j]]
                if ch.name == seg then
                    found = dir.children[j]
                    j = cn
                end
                j += 1
            end
            if found == NIL then
                return NIL
            end
            cur = found
        end
        i += 1
    end
    return cur
end

func fsAbsPath(int ino) as string
    if ino == g_rootIno then return "/" end
    var parts = []
    int cur = ino
    bool stop = false
    while not stop
        if cur == NIL or cur == g_rootIno then
            stop = true
        else
            Inode n = g_inodes[cur]
            parts.append(n.name)
            cur = n.parent
        end
    end
    string result = ""
    int n = parts.length
    int i = n - 1
    while i >= 0
        result = result + "/" + parts[i]
        i -= 1
    end
    if string.len(result) == 0 then
        return "/"
    end
    return result
end

func fsPwd() as string
    return fsAbsPath(g_cwdIno)
end

func fsExists(string p) as bool
    int id = fsResolve(p)
    if id == NIL then return false end
    return true
end

func fsFindChild(int dirIno, string name) as int
    Inode d = g_inodes[dirIno]
    int n = d.children.length
    int i = 0
    while i < n
        Inode ch = g_inodes[d.children[i]]
        if ch.name == name then
            return d.children[i]
        end
        i += 1
    end
    return NIL
end

func fsAppendChild(int dirIno, int childIno)
    Inode d = g_inodes[dirIno]
    d.children.append(childIno)
    g_inodes[dirIno] = d
end

func fsDropChild(int dirIno, int childIno)
    Inode d = g_inodes[dirIno]
    int n = d.children.length
    int i = 0
    bool done = false
    while i < n and not done
        if d.children[i] == childIno then
            d.children.remove(i)
            done = true
        end
        i += 1
    end
    g_inodes[dirIno] = d
end

func fsMkdir(string p, int perm) as int
    var parts = fsSplitParent(p)
    string parentP = string(parts[0])
    string fname = string(parts[1])
    if string.len(fname) == 0 then return NIL end
    int parentId = fsResolve(parentP)
    if parentId == NIL then return NIL end
    Inode parent = g_inodes[parentId]
    if parent.type != FT_DIR then return NIL end
    if not fsCheckPerm(parentId, PERM_W) then return NIL end
    if fsFindChild(parentId, fname) != NIL then return NIL end
    Inode d = Inode()
    d.name = fname
    d.type = FT_DIR
    d.perm = perm
    d.parent = parentId
    d.ino = fsAllocIno()
    g_inodes.append(d)
    int newIno = g_inodes.length - 1
    fsAppendChild(parentId, newIno)
    return newIno
end

func fsCreate(string p, int perm) as int
    var parts = fsSplitParent(p)
    string parentP = string(parts[0])
    string fname = string(parts[1])
    if string.len(fname) == 0 then return NIL end
    int parentId = fsResolve(parentP)
    if parentId == NIL then return NIL end
    Inode parent = g_inodes[parentId]
    if parent.type != FT_DIR then return NIL end
    if not fsCheckPerm(parentId, PERM_W) then return NIL end
    if fsFindChild(parentId, fname) != NIL then return NIL end
    Inode f = Inode()
    f.name = fname
    f.type = FT_FILE
    f.perm = perm
    f.parent = parentId
    f.ino = fsAllocIno()
    g_inodes.append(f)
    int newIno = g_inodes.length - 1
    fsAppendChild(parentId, newIno)
    return newIno
end

func fsReadFile(string p) as string
    int id = fsResolve(p)
    if id == NIL then return "" end
    if not fsCheckPerm(id, PERM_R) then return "" end
    Inode n = g_inodes[id]
    if n.type != FT_FILE then return "" end
    return n.content
end

func fsWriteFile(string p, string content) as bool
    int id = fsResolve(p)
    if id != NIL then
        if not fsCheckPerm(id, PERM_W) then return false end
        Inode n = g_inodes[id]
        if n.type != FT_FILE then return false end
        n.content = content
        n.size = string.len(content)
        g_inodes[id] = n
        return true
    end
    var parts = fsSplitParent(p)
    string parentP = string(parts[0])
    string fname = string(parts[1])
    if string.len(fname) == 0 then return false end
    int parentId = fsResolve(parentP)
    if parentId == NIL then return false end
    Inode parent = g_inodes[parentId]
    if parent.type != FT_DIR then return false end
    if not fsCheckPerm(parentId, PERM_W) then return false end
    Inode f = Inode()
    f.name = fname
    f.type = FT_FILE
    f.perm = PERM_RW
    f.parent = parentId
    f.ino = fsAllocIno()
    f.content = content
    f.size = string.len(content)
    g_inodes.append(f)
    int newIno = g_inodes.length - 1
    fsAppendChild(parentId, newIno)
    return true
end

func fsRemove(string p) as bool
    int id = fsResolve(p)
    if id == NIL then return false end
    if id == g_rootIno then return false end
    Inode n = g_inodes[id]
    if n.type == FT_DIR then
        if n.children.length > 0 then return false end
    end
    if not fsCheckPerm(n.parent, PERM_W) then return false end
    fsDropChild(n.parent, id)
    Inode orphan = g_inodes[id]
    orphan.parent = NIL
    g_inodes[id] = orphan
    return true
end

func fsListDir(string p) as var
    var result = []
    int id = fsResolve(p)
    if id == NIL then return result end
    Inode n = g_inodes[id]
    if n.type != FT_DIR then return result end
    if not fsCheckPerm(id, PERM_R) then return result end
    int cn = n.children.length
    int i = 0
    while i < cn
        Inode ch = g_inodes[n.children[i]]
        string nm = ch.name
        if ch.type == FT_DIR then
            nm = nm + "/"
        end
        result.append(nm)
        i += 1
    end
    return result
end

func fsCd(string p) as bool
    int id = fsResolve(p)
    if id == NIL then return false end
    Inode n = g_inodes[id]
    if n.type != FT_DIR then return false end
    if not fsCheckPerm(id, PERM_X) then return false end
    g_cwdIno = id
    return true
end


func fsAllocFd() as int
    int i = 0
    while i < MAX_OPEN_FILES
        if not g_openUsed[i] then
            g_openUsed[i] = true
            g_openCount = g_openCount + 1
            return i
        end
        i += 1
    end
    return NIL
end

func fsFreeFd(int fd)
    if fd < 0 or fd >= MAX_OPEN_FILES then return end
    g_openUsed[fd] = false
    OpenFile of = g_open[fd]
    of.used = false
    of.ino = NIL
    of.pos = 0
    g_open[fd] = of
    if g_openCount > 0 then
        g_openCount = g_openCount - 1
    end
end

func fsOpen(string p, string mode) as int
    int id = fsResolve(p)
    if id == NIL then
        if mode == "w" or mode == "rw" then
            int created = fsCreate(p, PERM_RW)
            if created == NIL then return NIL end
            id = created
        else
            return NIL
        end
    end
    Inode n = g_inodes[id]
    if n.type != FT_FILE then return NIL end
    int modeVal = 0
    if mode == "r" then
        if not fsCheckPerm(id, PERM_R) then return NIL end
        modeVal = 0
    elseif mode == "w" then
        if not fsCheckPerm(id, PERM_W) then return NIL end
        modeVal = 1
    else
        if not fsCheckPerm(id, PERM_RW) then return NIL end
        modeVal = 2
    end
    int fd = fsAllocFd()
    if fd == NIL then return NIL end
    OpenFile of = g_open[fd]
    of.used = true
    of.ino = id
    of.mode = modeVal
    of.pos = 0
    g_open[fd] = of
    return fd
end

func fsClose(int fd) as bool
    if fd < 0 or fd >= MAX_OPEN_FILES then return false end
    if not g_openUsed[fd] then return false end
    fsFreeFd(fd)
    return true
end

func fsRead(int fd, int n) as string
    if fd < 0 or fd >= MAX_OPEN_FILES then return "" end
    if not g_openUsed[fd] then return "" end
    OpenFile of = g_open[fd]
    if of.mode == 1 then return "" end     // write-only
    Inode node = g_inodes[of.ino]
    int total = string.len(node.content)
    if of.pos >= total then return "" end
    int remain = total - of.pos
    int take = n
    if take > remain then take = remain end
    if take < 0 then take = 0 end
    string s = string.mid(node.content, of.pos, take)
    of.pos = of.pos + take
    g_open[fd] = of
    return s
end

func fsWrite(int fd, string data) as int
    if fd < 0 or fd >= MAX_OPEN_FILES then return 0 end
    if not g_openUsed[fd] then return 0 end
    OpenFile of = g_open[fd]
    if of.mode == 0 then return 0 end     // read-only
    Inode node = g_inodes[of.ino]
    int dataLen = string.len(data)
    if dataLen == 0 then return 0 end
    int pos = of.pos
    string before = ""
    string after = ""
    int total = string.len(node.content)
    if pos <= 0 then
        before = ""
        after = node.content
    elseif pos >= total then
        before = node.content
        int gap = pos - total
        int g = 0
        while g < gap
            before = before + " "
            g += 1
        end
        after = ""
    else
        before = string.mid(node.content, 0, pos)
        after = string.mid(node.content, pos, total - pos)
    end
    node.content = before + data + after
    node.size = string.len(node.content)
    g_inodes[of.ino] = node
    of.pos = pos + dataLen
    g_open[fd] = of
    return dataLen
end

func fsLseek(int fd, int offset, int whence) as int
    if fd < 0 or fd >= MAX_OPEN_FILES then return NIL end
    if not g_openUsed[fd] then return NIL end
    OpenFile of = g_open[fd]
    Inode node = g_inodes[of.ino]
    int total = string.len(node.content)
    int newPos = of.pos
    if whence == 0 then
        newPos = offset
    elseif whence == 1 then
        newPos = of.pos + offset
    else
        newPos = total + offset
    end
    if newPos < 0 then newPos = 0 end
    of.pos = newPos
    g_open[fd] = of
    return newPos
end

func fsDumpTree()
    println("Filesystem tree (inodes=" + i2s(g_inodes.length) + ", nextIno=" + i2s(g_nextIno) + "):")
    fsDumpNode(g_rootIno, 0)
end

func fsDumpNode(int ino, int depth)
    Inode n = g_inodes[ino]
    string pad = ""
    int d = 0
    while d < depth
        pad = pad + "  "
        d += 1
    end
    string typ = "DIR "
    if n.type == FT_FILE then
        typ = "FILE"
    end
    string line = pad + "[" + i2s(ino) + "] " + typ + " " + n.name + "  perm=" + i2s(n.perm) + " ino=" + i2s(n.ino)
    if n.type == FT_FILE then
        line = line + " size=" + i2s(n.size)
    end
    println(line)
    int cn = n.children.length
    int i = 0
    while i < cn
        fsDumpNode(n.children[i], depth + 1)
        i += 1
    end
end


// ===============================================================
// ===============================================================

// ===============================================================
// Shell 解析与命令执行
// ===============================================================
func shParse(string line) as var
    var cmd = {}
    string s = trimP(line)
    if string.len(s) == 0 then
        cmd["empty"] = true
        return cmd
    end
    cmd["bg"] = false
    if string.byteAt(s, string.len(s) - 1) == 38 then
        cmd["bg"] = true
        s = trimP(string.mid(s, 0, string.len(s) - 1))
    end
    string redirOut = ""
    int gt = findByte(s, 62)
    if gt >= 0 then
        redirOut = trimP(string.mid(s, gt + 1, string.len(s) - gt - 1))
        s = trimP(string.mid(s, 0, gt))
    end
    string redirIn = ""
    int lt = findByte(s, 60)
    if lt >= 0 then
        redirIn = trimP(string.mid(s, lt + 1, string.len(s) - lt - 1))
        s = trimP(string.mid(s, 0, lt))
    end
    cmd["redirOut"] = redirOut
    cmd["redirIn"] = redirIn
    var segs = string.split(s, "|")
    var pipeline = []
    int n = segs.length
    int i = 0
    while i < n
        string seg = trimP(string(segs[i]))
        if string.len(seg) > 0 then
            var tokens = shTokenize(seg)
            if tokens.length > 0 then
                pipeline.append(tokens)
            end
        end
        i += 1
    end
    cmd["pipeline"] = pipeline
    return cmd
end

func shTokenize(string s) as var
    return shTokenize2(s)
end

func shTokenize2(string s) as var
    var tokens = []
    int n = string.len(s)
    int i = 0
    while i < n
        int b = string.byteAt(s, i)
        if b == 32 or b == 9 then
            i += 1
        else
            string cur = ""
            bool quoted = false
            bool done = false
            if b == 34 or b == 39 then
                quoted = true
                int quote = b
                i += 1
                bool closed = false
                while i < n and not closed
                    int c = string.byteAt(s, i)
                    if c == quote then
                        i += 1
                        closed = true
                    else
                        cur = cur + string.charAt(s, i)
                        i += 1
                    end
                end
                done = true
            end
            if not done then
                bool stop2 = false
                while i < n and not stop2
                    int c = string.byteAt(s, i)
                    if c == 32 or c == 9 then
                        stop2 = true
                    else
                        cur = cur + string.charAt(s, i)
                        i += 1
                    end
                end
            end
            if string.len(cur) > 0 then
                tokens.append(cur)
            end
        end
    end
    return tokens
end

func shExecParsed(var parsed) as string
    if parsed["empty"] != null then
        if bool(parsed["empty"]) then
            return ""
        end
    end
    var pipeline = parsed["pipeline"]
    int n = pipeline.length
    if n == 0 then return "" end
    string flow = ""
    if parsed["redirIn"] != null then
        string rin = string(parsed["redirIn"])
        if string.len(rin) > 0 then
            flow = fsReadFile(rin)
        end
    end
    int i = 0
    while i < n
        var tokens = pipeline[i]
        bool last = (i == n - 1)
        var res = shRunOne(tokens, flow, last, parsed)
        flow = string(res["out"])
        i += 1
    end
    // output redirect
    if parsed["redirOut"] != null then
        string rout = string(parsed["redirOut"])
        if string.len(rout) > 0 then
            if string.len(flow) > 0 and string.byteAt(flow, string.len(flow) - 1) == 10 then
                flow = string.mid(flow, 0, string.len(flow) - 1)
            end
            fsWriteFile(rout, flow)
            return ""
        end
    end
    return flow
end

func shRunOne(var tokens, string stdin, bool isLast, var parsed) as var
    var res = {}
    res["out"] = ""
    res["code"] = 0
    int tn = tokens.length
    if tn == 0 then return res end
    string name = string(tokens[0])
    var args = []
    int i = 1
    while i < tn
        args.append(tokens[i])
        i += 1
    end
    string outputValue = shDispatch(name, args, stdin)
    res["out"] = outputValue
    if isLast then
        if parsed["redirOut"] != null then
            string rout = string(parsed["redirOut"])
            if string.len(rout) == 0 then
                if string.len(outputValue) > 0 then
                    print(outputValue)
                    if not string.contains(outputValue, "\n") then
                        println("")
                    end
                end
            end
        else
            if string.len(outputValue) > 0 then
                print(outputValue)
                if string.len(outputValue) > 0 then
                    int lastByte = string.byteAt(outputValue, string.len(outputValue) - 1)
                    if lastByte != 10 then
                        println("")
                    end
                end
            end
        end
    end
    return res
end

func shDispatch(string name, var args, string stdin) as string
    if name == "echo" then return shEcho(args) end
    if name == "ls" then return shLs(args) end
    if name == "cat" then return shCat(args, stdin) end
    if name == "ps" then return shPs() end
    if name == "mem" then return shMem() end
    if name == "kill" then return shKill(args) end
    if name == "exec" then return shExec(args) end
    if name == "cd" then return shCd(args) end
    if name == "pwd" then return shPwd() end
    if name == "mkdir" then return shMkdir(args) end
    if name == "touch" then return shTouch(args) end
    if name == "rm" then return shRm(args) end
    if name == "write" then return shWrite(args) end
    if name == "alloc" then return shAlloc(args) end
    if name == "free" then return shFree(args) end
    if name == "help" then return shHelp() end
    if name == "tree" then return shTree() end
    if name == "true" then return "" end
    if name == "false" then return "" end
    return "xos: unknown command: " + name + "\n"
end


func shEcho(var args) as string
    string s = ""
    int n = args.length
    int i = 0
    while i < n
        if i > 0 then s = s + " " end
        s = s + args[i]
        i += 1
    end
    return s + "\n"
end

func shLs(var args) as string
    string target = "."
    if args.length > 0 then
        target = string(args[0])
    end
    int id = fsResolve(target)
    if id == NIL then
        return "ls: cannot access '" + target + "'\n"
    end
    Inode n = g_inodes[id]
    if n.type == FT_FILE then
        return n.name + "\n"
    end
    var items = fsListDir(target)
    string s = ""
    int i = 0
    while i < items.length
        s = s + items[i] + "\n"
        i += 1
    end
    return s
end

func shCat(var args, string stdin) as string
    if args.length == 0 then
        return stdin
    end
    string s = ""
    int i = 0
    while i < args.length
        string p = string(args[i])
        int id = fsResolve(p)
        if id == NIL then
            s = s + "cat: " + p + ": no such file\n"
        else
            Inode n = g_inodes[id]
            if n.type == FT_DIR then
                s = s + "cat: " + p + ": is a directory\n"
            else
                s = s + n.content
            end
        end
        i += 1
    end
    return s
end

func shPs() as string
    string s = ""
    s = padR("PID", 6) + padR("NAME", 14) + padR("STATE", 12) + padR("LEVEL", 7) + padR("BURST", 7) + padR("REMAIN", 7) + padR("ARR", 6) + padR("WAIT", 7) + "\n"
    int i = 1
    int n = g_pcb.length
    while i < n
        PCB p = g_pcb[i]
        s = s + padR(i2s(p.pid), 6) + padR(p.name, 14) + padR(procStateName(p.state), 12) + padR(i2s(p.level), 7) + padR(i2s(p.burstTime), 7) + padR(i2s(p.remaining), 7) + padR(i2s(p.arrivalTime), 6) + padR(i2s(p.waitTime), 7) + "\n"
        i += 1
    end
    return s
end

func shMem() as string
    int used = 0
    int i = 0
    while i < NUM_FRAMES
        if g_frameOwner[i] != NIL then
            used = used + 1
        end
        i += 1
    end
    int hitRate = 0
    if g_memTranslate > 0 then
        hitRate = (g_memTlbHit * 100) / g_memTranslate
    end
    string s = ""
    s = s + "frames: " + i2s(used) + "/" + i2s(NUM_FRAMES) + "\n"
    s = s + "translates: " + i2s(g_memTranslate) + "\n"
    s = s + "tlb hit/miss: " + i2s(g_memTlbHit) + "/" + i2s(g_memTlbMiss) + " (" + i2s(hitRate) + "%)\n"
    s = s + "page faults: " + i2s(g_memPageFault) + " evictions: " + i2s(g_memEvict) + "\n"
    return s
end

func shKill(var args) as string
    if args.length == 0 then
        return "kill: usage: kill <pid>\n"
    end
    int pid = parseIntSafe(string(args[0]), -1)
    if pid < 1 or pid >= g_pcb.length then
        return "kill: no such process: " + args[0] + "\n"
    end
    procTerminate(pid, 9)
    mlfqRemove(pid)
    return "killed pid " + i2s(pid) + "\n"
end

func shExec(var args) as string
    if args.length < 2 then
        return "exec: usage: exec <name> <burst> [level] [program...]\n"
    end
    string pname = string(args[0])
    int burst = parseIntSafe(string(args[1]), 5)
    int level = 0
    if args.length >= 3 then
        level = parseIntSafe(string(args[2]), 0)
    end
    array<string> prog = array[]
    int i = 3
    while i < args.length
        prog.append(string(args[i]))
        i += 1
    end
    if prog.length == 0 then
        prog.append("compute " + i2s(burst))
    end
    int pid = procCreate(pname, g_totalTick, burst, level, prog)
    procArrive(pid)
    return "executed pid=" + i2s(pid) + " name=" + pname + "\n"
end

func shCd(var args) as string
    string target = "/"
    if args.length > 0 then
        target = string(args[0])
    end
    if not fsCd(target) then
        return "cd: " + target + ": no such directory\n"
    end
    return ""
end

func shPwd() as string
    return fsPwd() + "\n"
end

func shMkdir(var args) as string
    if args.length == 0 then
        return "mkdir: usage: mkdir <path> [path...]\n"
    end
    string s = ""
    int i = 0
    while i < args.length
        string p = string(args[i])
        if fsMkdir(p, PERM_RWX) == NIL then
            s = s + "mkdir: cannot create '" + p + "'\n"
        end
        i += 1
    end
    return s
end

func shTouch(var args) as string
    if args.length == 0 then
        return "touch: usage: touch <path>\n"
    end
    string p = string(args[0])
    if not fsExists(p) then
        if fsCreate(p, PERM_RW) == NIL then
            return "touch: cannot create '" + p + "'\n"
        end
    end
    return ""
end

func shRm(var args) as string
    if args.length == 0 then
        return "rm: usage: rm <path>\n"
    end
    string p = string(args[0])
    if not fsRemove(p) then
        return "rm: cannot remove '" + p + "'\n"
    end
    return ""
end

// write <path> <text...>
func shWrite(var args) as string
    if args.length < 2 then
        return "write: usage: write <path> <text>\n"
    end
    string p = string(args[0])
    string txt = ""
    int i = 1
    while i < args.length
        if i > 1 then txt = txt + " " end
        txt = txt + args[i]
        i += 1
    end
    if not fsWriteFile(p, txt) then
        return "write: cannot write '" + p + "'\n"
    end
    return ""
end

func shAlloc(var args) as string
    if args.length < 2 then
        return "alloc: usage: alloc <pid> <vaddr>\n"
    end
    int pid = parseIntSafe(string(args[0]), -1)
    int vaddr = parseIntSafe(string(args[1]), 0)
    if pid < 1 or pid >= g_pcb.length then
        return "alloc: invalid pid\n"
    end
    int paddr = memTranslate(pid, vaddr)
    if paddr == NIL then
        return "alloc: translation failed\n"
    end
    return "vaddr " + i2s(vaddr) + " -> paddr " + i2s(paddr) + "\n"
end

func shFree(var args) as string
    if args.length < 1 then
        return "free: usage: free <pid>\n"
    end
    int pid = parseIntSafe(string(args[0]), -1)
    if pid < 1 or pid >= g_pcb.length then
        return "free: invalid pid\n"
    end
    memReleaseProc(pid)
    PCB p = g_pcb[pid]
    p.ptDirId = memAllocDir()
    g_pcb[pid] = p
    return "freed memory of pid " + i2s(pid) + "\n"
end

func shHelp() as string
    string s = ""
    s = s + "xos shell built-in commands:\n"
    s = s + "  echo <text>            print text\n"
    s = s + "  ls [path]              list directory\n"
    s = s + "  cat <file>             print file contents (reads stdin if no arg)\n"
    s = s + "  pwd                    print working directory\n"
    s = s + "  cd <path>              change directory\n"
    s = s + "  mkdir <path>           create directory\n"
    s = s + "  touch <path>           create empty file\n"
    s = s + "  rm <path>              remove file/empty dir\n"
    s = s + "  write <path> <text>    write text to file\n"
    s = s + "  ps                     list processes\n"
    s = s + "  mem                    show memory stats\n"
    s = s + "  kill <pid>             terminate process\n"
    s = s + "  exec <name> <burst> [level] [program...]  create a process\n"
    s = s + "  alloc <pid> <vaddr>    translate virtual address\n"
    s = s + "  free <pid>             release process memory\n"
    s = s + "  tree                   dump filesystem tree\n"
    s = s + "  help                   this message\n"
    s = s + "syntax: cmd1 | cmd2   > file   < file   &\n"
    return s
end

func shTree() as string
    string s = ""
    int i = 0
    while i < g_inodes.length
        Inode n = g_inodes[i]
        if n.parent == NIL and i != g_rootIno then
            // orphan, skip
        else
            string pad = ""
            int d = 0
            int cur = i
            int depth = 0
            // calc depth by climbing
            while cur != g_rootIno and cur != NIL
                Inode c = g_inodes[cur]
                cur = c.parent
                depth += 1
                if depth > 64 then cur = g_rootIno end
            end
            d = 0
            while d < depth
                pad = pad + "  "
                d += 1
            end
            string typ = "D"
            if n.type == FT_FILE then typ = "F" end
            s = s + pad + typ + " " + n.name
            if n.parent == NIL and i == g_rootIno then
                // root
            end
            s = s + "\n"
        end
        i += 1
    end
    return s
end

func shRunScript(string path) as int
    if not file.exists(path) then
        println("xos: script not found: " + path)
        return 1
    end
    string text = file.readText(path)
    var lines = string.splitLines(text)
    int n = lines.length
    int i = 0
    int errors = 0
    while i < n
        string line = string(lines[i])
        i += 1
        string t = trimP(line)
        if string.len(t) == 0 then
        else
            int hb = string.byteAt(t, 0)
            if hb == 47 and string.len(t) >= 2 and string.byteAt(t, 1) == 47 then
            else
                var parsed = shParse(line)
                shExecParsed(parsed)
            end
        end
    end
    return errors
end


// ===============================================================
// ===============================================================

// ===============================================================
// 系统调用分派
// ===============================================================
func syscall(int op, var args) as var
    var res = {}
    res["ret"] = NIL
    res["msg"] = ""
    if op == SYSOPEN then
        string p = string(args[0])
        string mode = "r"
        if args.length > 1 then mode = string(args[1]) end
        int fd = fsOpen(p, mode)
        res["ret"] = fd
        if fd == NIL then res["msg"] = "open failed" end
        return res
    end
    if op == SYS_READ then
        int fd = int(args[0])
        int n = 0
        if args.length > 1 then n = int(args[1]) else n = 4096 end
        string s = fsRead(fd, n)
        res["ret"] = s
        return res
    end
    if op == SYS_WRITE then
        int fd = int(args[0])
        string data = string(args[1])
        int w = fsWrite(fd, data)
        res["ret"] = w
        return res
    end
    if op == SYS_CLOSE then
        int fd = int(args[0])
        bool ok = fsClose(fd)
        res["ret"] = ok
        return res
    end
    if op == SYS_LSEEK then
        int fd = int(args[0])
        int off = int(args[1])
        int whence = 0
        if args.length > 2 then whence = int(args[2]) end
        int pos = fsLseek(fd, off, whence)
        res["ret"] = pos
        return res
    end
    if op == SYS_MKDIR then
        string p = string(args[0])
        int perm = PERM_RWX
        if args.length > 1 then perm = int(args[1]) end
        int ino = fsMkdir(p, perm)
        res["ret"] = ino
        return res
    end
    if op == SYS_LS then
        string p = string(args[0])
        var items = fsListDir(p)
        res["ret"] = items
        return res
    end
    if op == SYS_RM then
        string p = string(args[0])
        bool ok = fsRemove(p)
        res["ret"] = ok
        return res
    end
    if op == SYS_CAT then
        string p = string(args[0])
        res["ret"] = fsReadFile(p)
        return res
    end
    if op == SYS_TOUCH then
        string p = string(args[0])
        int perm = PERM_RW
        if args.length > 1 then perm = int(args[1]) end
        res["ret"] = fsCreate(p, perm)
        return res
    end
    if op == SYS_PS then
        res["ret"] = shPs()
        return res
    end
    if op == SYS_MEM then
        res["ret"] = shMem()
        return res
    end
    if op == SYS_KILL then
        int pid = int(args[0])
        procTerminate(pid, 9)
        mlfqRemove(pid)
        res["ret"] = true
        return res
    end
    if op == SYS_FORK then
        int pid = procForkOp()
        res["ret"] = pid
        return res
    end
    if op == SYS_EXEC then
        string name = string(args[0])
        int burst = int(args[1])
        var progArr = args[2]
        array<string> prog = array[]
        int j = 0
        while j < progArr.length
            prog.append(string(progArr[j]))
            j += 1
        end
        int pid = procCreate(name, g_totalTick, burst, 0, prog)
        procArrive(pid)
        res["ret"] = pid
        return res
    end
    if op == SYS_EXIT then
        int code = 0
        if args.length > 0 then code = int(args[0]) end
        procTerminate(g_currentPid, code)
        res["ret"] = true
        return res
    end
    if op == SYS_ALLOC then
        int pid = int(args[0])
        int vaddr = int(args[1])
        res["ret"] = memTranslate(pid, vaddr)
        return res
    end
    if op == SYS_ACCESS then
        int pid = int(args[0])
        int vaddr = int(args[1])
        res["ret"] = memTranslate(pid, vaddr)
        return res
    end
    if op == SYS_HELP then
        res["ret"] = shHelp()
        return res
    end
    res["msg"] = "unknown syscall " + i2s(op)
    return res
end

func procForkOp() as int
    if g_currentPid == NIL then return NIL end
    PCB par = g_pcb[g_currentPid]
    array<string> childProg = array[]
    int i = par.pc
    while i < par.program.length
        childProg.append(par.program[i])
        i += 1
    end
    int burst = par.remaining
    if burst < 1 then burst = 1 end
    int pid = procCreate(par.name + ".child", g_totalTick, burst, par.level, childProg)
    procArrive(pid)
    return pid
end


// ===============================================================
// ===============================================================

//   mkdir <path>
//   create <path>
//   exit <code>
//   fork
func execOp(int pid, string line) as int
    string t = trimP(line)
    if string.len(t) == 0 then return 1 end
    var tokens = shTokenize2(t)
    if tokens.length == 0 then return 1 end
    string op = string.lower(string(tokens[0]))
    if op == "compute" then
        int n = 1
        if tokens.length > 1 then n = parseIntSafe(string(tokens[1]), 1) end
        if n < 1 then n = 1 end
        g_pcb[pid].computeLeft = n - 1
        procDecRemaining(pid, 1)
        return 1
    end
    if op == "open" then
        if tokens.length < 2 then return 1 end
        string mode = "r"
        if tokens.length > 2 then mode = string(tokens[2]) end
        procOpen(pid, string(tokens[1]), mode)
        return 1
    end
    if op == "read" then
        int localFd = 0
        if tokens.length > 1 then localFd = parseIntSafe(string(tokens[1]), 0) end
        int n = 32
        if tokens.length > 2 then n = parseIntSafe(string(tokens[2]), 32) end
        int gslot = procLocalToGlobal(pid, localFd)
        if gslot != NIL then
            syscall(SYS_READ, [gslot, n])
        end
        return 1
    end
    if op == "write" then
        int localFd = 0
        if tokens.length > 1 then localFd = parseIntSafe(string(tokens[1]), 0) end
        string data = ""
        int ti = 2
        while ti < tokens.length
            if ti > 2 then data = data + " " end
            data = data + tokens[ti]
            ti += 1
        end
        int gslot = procLocalToGlobal(pid, localFd)
        if gslot != NIL then
            var wargs = []
            wargs.append(gslot)
            wargs.append(data)
            syscall(SYS_WRITE, wargs)
        end
        return 1
    end
    if op == "close" then
        int localFd = 0
        if tokens.length > 1 then localFd = parseIntSafe(string(tokens[1]), 0) end
        procCloseLocal(pid, localFd)
        return 1
    end
    if op == "mkdir" then
        if tokens.length > 1 then
            var args = [string(tokens[1])]
            syscall(SYS_MKDIR, args)
        end
        return 1
    end
    if op == "create" then
        if tokens.length > 1 then
            var args = [string(tokens[1])]
            syscall(SYS_TOUCH, args)
        end
        return 1
    end
    if op == "ls" then
        if tokens.length > 1 then
            var args = [string(tokens[1])]
            syscall(SYS_LS, args)
        end
        return 1
    end
    if op == "access" then
        int vaddr = 0
        if tokens.length > 1 then vaddr = parseIntSafe(string(tokens[1]), 0) end
        var args = [pid, vaddr]
        syscall(SYS_ACCESS, args)
        return 1
    end
    if op == "sleep" then
        int n = 1
        if tokens.length > 1 then n = parseIntSafe(string(tokens[1]), 1) end
        g_pcb[pid].state = PROC_WAITING
        g_pcb[pid].sleepUntil = g_totalTick + n
        return 1
    end
    if op == "fork" then
        var args = []
        syscall(SYS_FORK, args)
        return 1
    end
    if op == "exit" then
        int code = 0
        if tokens.length > 1 then code = parseIntSafe(string(tokens[1]), 0) end
        procTerminate(pid, code)
        return 1
    end
    procDecRemaining(pid, 1)
    return 1
end


// ===============================================================
// ===============================================================

// ===============================================================
// 系统启动、演示与测试
// ===============================================================
func osReset()
    g_pcb = array[]
    PCB dummy = PCB()
    dummy.pid = 0
    dummy.name = "idle"
    dummy.state = PROC_TERMINATED
    g_pcb.append(dummy)
    g_mlfq0 = array[]
    g_mlfq1 = array[]
    g_mlfq2 = array[]
    g_currentPid = NIL
    g_nextPid = 1
    g_contextSwitches = 0
    g_totalTick = 0
    g_lastBoost = 0
    g_idleTicks = 0

    g_memTranslate = 0
    g_memTlbHit = 0
    g_memTlbMiss = 0
    g_memPageFault = 0
    g_memEvict = 0
    g_memAlloc = 0

    memInit()
    fsInit()
end

func osBoot()
    osReset()
    fsMkdir("/etc", PERM_RWX)
    fsMkdir("/bin", PERM_RWX)
    fsMkdir("/home", PERM_RWX)
    fsMkdir("/home/user", PERM_RWX)
    fsMkdir("/tmp", PERM_RWX)
    fsMkdir("/var", PERM_RWX)
    fsMkdir("/var/log", PERM_RWX)
    fsWriteFile("/etc/passwd", "root:x:0:0:root:/root:/bin/sh\nuser:x:1:1:user:/home/user:/bin/sh\n")
    fsWriteFile("/etc/motd", "Welcome to xos 1.0\n")
    fsWriteFile("/etc/hostname", "xlang-host\n")
    fsWriteFile("/var/log/messages", "boot: kernel started\nboot: mounts ready\n")
end

func buildPrograms() as var
    var progs = {}
    progs["init"] = array[
        "open /var/log/boot.log w",
        "write 0 boot sequence start",
        "close 0",
        "mkdir /srv",
        "compute 2",
        "fork",
        "compute 1",
        "exit 0"
    ]
    progs["writer"] = array[
        "open /tmp/out.log w",
        "write 0 line-one",
        "write 0 line-two",
        "close 0",
        "compute 3",
        "exit 0"
    ]
    progs["reader"] = array[
        "open /etc/passwd r",
        "read 0 16",
        "close 0",
        "access 32",
        "access 48",
        "access 32",
        "compute 2",
        "exit 0"
    ]
    progs["memhog"] = array[
        "access 0",
        "access 16",
        "access 32",
        "access 48",
        "access 64",
        "access 0",
        "access 16",
        "compute 2",
        "exit 0"
    ]
    progs["sleeper"] = array[
        "compute 1",
        "sleep 3",
        "compute 1",
        "exit 0"
    ]
    progs["cpu"] = array[
        "compute 10",
        "exit 0"
    ]
    return progs
end

func copyStrArray(var src) as array<string>
    array<string> outputValue = array[]
    int n = src.length
    int i = 0
    while i < n
        outputValue.append(string(src[i]))
        i += 1
    end
    return outputValue
end

func runDemo() as int
    println(rep("=", 64))
    println("xos integrated simulation demo")
    println(rep("=", 64))
    osBoot()
    g_trace = true
    println("-- phase 1: boot filesystem --")
    fsDumpTree()

    println("")
    println("-- phase 2: load programs (create PCBs) --")
    var progs = buildPrograms()
    int pInit   = procCreate("init",   0, 6,  0, copyStrArray(progs["init"]))
    int pWriter = procCreate("writer", 1, 8,  0, copyStrArray(progs["writer"]))
    int pReader = procCreate("reader", 2, 6,  0, copyStrArray(progs["reader"]))
    int pMem    = procCreate("memhog", 3, 9,  1, copyStrArray(progs["memhog"]))
    int pSleep  = procCreate("sleeper",4, 5,  2, copyStrArray(progs["sleeper"]))
    int pCpu    = procCreate("cpu",    5, 10, 0, copyStrArray(progs["cpu"]))

    println("")
    println("-- phase 3: MLFQ scheduling loop --")
    schedulerLoop(2000)
    g_trace = false

    println("")
    println("-- phase 4: post-run filesystem --")
    fsDumpTree()

    println("")
    printProcSummary()
    memReport()
    println("")
    println("Context switches: " + i2s(g_contextSwitches))
    println("Total ticks     : " + i2s(g_totalTick) + " (idle " + i2s(g_idleTicks) + ")")
    return 0
end

func printProcSummary()
    println(rep("=", 60))
    println("Process Summary")
    println(rep("=", 60))
    println(padR("PID", 6) + padR("NAME", 14) + padR("STATE", 12) + padR("BURST", 7) + padR("ARR", 6) + padR("START", 7) + padR("END", 6) + padR("RESP", 6) + padR("WAIT", 6))
    int n = g_pcb.length
    int i = 1
    while i < n
        PCB p = g_pcb[i]
        string st = procStateName(p.state)
        println(padR(i2s(p.pid), 6) + padR(p.name, 14) + padR(st, 12) + padR(i2s(p.burstTime), 7) + padR(i2s(p.arrivalTime), 6) + padR(i2s(p.startTime), 7) + padR(i2s(p.completionTime), 6) + padR(i2s(p.responseTime), 6) + padR(i2s(p.waitTime), 6))
        i += 1
    end
end


// ===============================================================
// ===============================================================

int g_pass = 0
int g_fail = 0

func okMsg(string label)
    g_pass = g_pass + 1
    println("  [PASS] " + label)
end

func badMsg(string label, string detail)
    g_fail = g_fail + 1
    println("  [FAIL] " + label + " :: " + detail)
end

func expectTrue(bool got, string label)
    if got then okMsg(label) else badMsg(label, "expected true got false") end
end

func expectFalse(bool got, string label)
    if got then badMsg(label, "expected false got true") else okMsg(label) end
end

func expectI(int got, int want, string label)
    if got == want then
        okMsg(label)
    else
        badMsg(label, "got " + i2s(got) + " want " + i2s(want))
    end
end

func expectS(string got, string want, string label)
    if got == want then
        okMsg(label)
    else
        badMsg(label, "got '" + got + "' want '" + want + "'")
    end
end


func testFS()
    println("[testFS] file system CRUD + path + perms")
    fsMkdir("/proj", PERM_RWX)
    fsMkdir("/proj/sub", PERM_RWX)
    expectTrue(fsExists("/proj"), "mkdir /proj exists")
    expectTrue(fsExists("/proj/sub"), "nested mkdir exists")
    expectTrue(fsWriteFile("/proj/a.txt", "alpha"), "writeFile create a.txt")
    expectS(fsReadFile("/proj/a.txt"), "alpha", "readFile a.txt")
    expectTrue(fsWriteFile("/proj/a.txt", "ALPHA"), "overwrite a.txt")
    expectS(fsReadFile("/proj/a.txt"), "ALPHA", "overwritten content")
    int fd = fsOpen("/proj/b.txt", "w")
    expectTrue(fd >= 0, "open b.txt w returns fd")
    int w1 = fsWrite(fd, "hello ")
    int w2 = fsWrite(fd, "world")
    expectI(w1, 6, "write 'hello ' returns 6")
    expectI(w2, 5, "write 'world' returns 5")
    fsClose(fd)
    expectS(fsReadFile("/proj/b.txt"), "hello world", "two writes concatenated")
    int fd2 = fsOpen("/proj/b.txt", "r")
    expectI(fsLseek(fd2, 6, 0), 6, "lseek to 6")
    expectS(fsRead(fd2, 5), "world", "read after lseek")
    expectI(fsLseek(fd2, 0, 2), 11, "lseek SEEK_END -> size")
    fsClose(fd2)
    int roId = fsCreate("/proj/ro.txt", PERM_R)
    expectTrue(roId >= 0, "create read-only file")
    expectFalse(fsWriteFile("/proj/ro.txt", "x"), "write to read-only denied")
    fsMkdir("/proj/locked", PERM_RW)
    expectFalse(fsCd("/proj/locked"), "cd dir without x denied")
    fsCd("/")
    // ls
    var items = fsListDir("/proj")
    expectTrue(items.length >= 4, "ls /proj has >=4 entries")
    expectTrue(fsRemove("/proj/a.txt"), "remove a.txt")
    expectFalse(fsExists("/proj/a.txt"), "removed gone")
    expectFalse(fsRemove("/proj"), "remove non-empty dir fails")
    // abs path
    fsCd("/proj/sub")
    expectS(fsPwd(), "/proj/sub", "pwd /proj/sub")
    fsCd("/")
    expectS(fsAbsPath(g_cwdIno), "/", "pwd root = /")
end


func testMem()
    println("[testMem] paging + TLB + LRU")
    array<string> prog = array["compute 1"]
    int pid = procCreate("tester", 0, 1, 0, prog)
    procArrive(pid)
    int baseTranslate = g_memTranslate
    int baseFault = g_memPageFault
    int p1 = memTranslate(pid, 0)
    int p2 = memTranslate(pid, 16)
    int p3 = memTranslate(pid, 32)
    expectTrue(p1 >= 0 and p2 >= 0 and p3 >= 0, "three translates succeed")
    expectI(g_memPageFault, baseFault + 3, "3 page faults for 3 new pages")
    int baseHit = g_memTlbHit
    int p1b = memTranslate(pid, 0)
    expectI(p1b, p1, "repeat translate same paddr")
    expectTrue(g_memTlbHit > baseHit, "TLB hit increased on repeat")
    int p5 = memTranslate(pid, 128)    // dirIdx=1
    expectTrue(p5 >= 0, "translate across dir boundary")
    int i = 0
    while i < NUM_FRAMES + 4
        memTranslate(pid, 64 + i * 16)
        i += 1
    end
    expectTrue(g_memEvict > 0, "eviction occurred under pressure")
end


func testSched()
    println("[testSched] MLFQ + context switch + states")
    osBoot()
    array<string> progA = array["compute 4", "exit 0"]
    array<string> progB = array["compute 6", "exit 0"]
    array<string> progC = array["compute 2", "exit 0"]
    procCreate("A", 0, 4, 0, progA)
    procCreate("B", 0, 6, 0, progB)
    procCreate("C", 0, 2, 0, progC)
    schedulerLoop(500)
    int i = 1
    int n = g_pcb.length
    bool allTerm = true
    while i < n
        PCB p = g_pcb[i]
        if p.state != PROC_TERMINATED then
            allTerm = false
        end
        i += 1
    end
    expectTrue(allTerm, "all test processes terminated")
    expectTrue(g_contextSwitches > 0, "context switches happened")
    osBoot()
    array<string> progS = array["compute 1", "sleep 3", "compute 1", "exit 0"]
    int pidS = procCreate("sleeper", 0, 4, 0, progS)
    procArrive(pidS)
    int beforeSwitch = g_contextSwitches
    schedulerLoop(500)
    PCB ps = g_pcb[pidS]
    expectI(ps.state, PROC_TERMINATED, "sleeper eventually terminates")
    expectTrue(g_contextSwitches > beforeSwitch, "sleeper caused context switches")
end


func testShellParse()
    println("[testShellParse] pipe/redirect/bg tokenizing")
    var c1 = shParse("echo hello")
    expectI(c1["pipeline"].length, 1, "simple cmd 1 stage")
    var c2 = shParse("echo hi | cat")
    expectI(c2["pipeline"].length, 2, "pipe 2 stages")
    var c3 = shParse("ls > /tmp/out.txt")
    expectTrue(c3["redirOut"] != null, "redirect out parsed")
    expectS(string(c3["redirOut"]), "/tmp/out.txt", "redirect target")
    var c4 = shParse("sleep 1 &")
    expectTrue(bool(c4["bg"]), "background flag set")
    // 闁诲孩顔栭崰妤€煤閺嶎兙浜?
    var toks = shTokenize2("echo \"hello world\" foo")
    expectI(toks.length, 3, "quoted tokenize 3 tokens")
    expectS(string(toks[0]), "echo", "tok0 = echo")
    expectS(string(toks[1]), "hello world", "tok1 preserves space")
    expectS(string(toks[2]), "foo", "tok2 = foo")
end


func testShellExec()
    println("[testShellExec] builtin commands + pipe + redirect")
    // echo
    var p = shParse("echo hello world")
    string outputValue = shExecParsed(p)
    expectS(trimP(outputValue), "hello world", "echo outputs text")
    // mkdir + ls
    shExecParsed(shParse("mkdir /xtest"))
    shExecParsed(shParse("write /xtest/f.txt the-data"))
    expectS(fsReadFile("/xtest/f.txt"), "the-data", "shell write stored")
    var pLs = shParse("ls /xtest")
    string lsOut = shExecParsed(pLs)
    expectTrue(containsP(lsOut, "f.txt"), "ls lists created file")
    var pPipe = shParse("echo piped-data | cat")
    string pipeOut = shExecParsed(pPipe)
    expectTrue(containsP(pipeOut, "piped-data"), "pipe echo|cat forwards data")
    fsWriteFile("/tmp/redir.txt", "")
    var pRed = shParse("echo redir-content > /tmp/redir.txt")
    shExecParsed(pRed)
    expectS(fsReadFile("/tmp/redir.txt"), "redir-content", "redirect writes to file")
    // input redirect: cat < file
    var pRedIn = shParse("cat < /tmp/redir.txt")
    string rinOut = shExecParsed(pRedIn)
    expectS(trimP(rinOut), "redir-content", "input redirect reads file")
    // pwd / cd
    shExecParsed(shParse("cd /xtest"))
    expectS(fsPwd(), "/xtest", "cd changes cwd")
    shExecParsed(shParse("cd /"))
    string psOut = shExecParsed(shParse("ps"))
    expectTrue(containsP(psOut, "PID"), "ps prints header")
    string memOut = shExecParsed(shParse("mem"))
    expectTrue(containsP(memOut, "frames"), "mem prints stats")
    // unknown
    string unkOut = shExecParsed(shParse("nosuchcmd"))
    expectTrue(containsP(unkOut, "unknown command"), "unknown command reported")
end


func testSyscall()
    println("[testSyscall] unified syscall entry")
    fsWriteFile("/etc/sc.txt", "syscall-data")
    var r1 = syscall(SYS_CAT, ["/etc/sc.txt"])
    expectS(string(r1["ret"]), "syscall-data", "SYS_CAT returns content")
    var r2 = syscall(SYSOPEN, ["/etc/sc.txt", "r"])
    int fd = int(r2["ret"])
    expectTrue(fd >= 0, "SYSOPEN returns fd")
    var r3 = syscall(SYS_READ, [fd, 8])
    expectS(string(r3["ret"]), "syscall-", "SYS_READ first 8 bytes")
    var r4 = syscall(SYS_CLOSE, [fd])
    expectTrue(bool(r4["ret"]), "SYS_CLOSE ok")
    var r5 = syscall(SYS_LS, ["/etc"])
    expectTrue(r5["ret"].length > 0, "SYS_LS returns entries")
    int beforeIno = g_nextIno
    var r6 = syscall(SYS_MKDIR, ["/scdir"])
    expectTrue(int(r6["ret"]) >= 0, "SYS_MKDIR returns ino")
    expectTrue(g_nextIno > beforeIno, "nextIno advanced after mkdir")
    var r7 = syscall(9999, [])
    expectTrue(containsP(string(r7["msg"]), "unknown syscall"), "unknown syscall reported")
end


func testIntegration()
    println("[testIntegration] boot -> schedule -> memory -> fs -> terminate")
    osBoot()
    var progs = buildPrograms()
    procCreate("init",   0, 6,  0, copyStrArray(progs["init"]))
    procCreate("writer", 1, 8,  0, copyStrArray(progs["writer"]))
    procCreate("reader", 2, 6,  0, copyStrArray(progs["reader"]))
    procCreate("memhog", 3, 9,  1, copyStrArray(progs["memhog"]))
    procCreate("sleeper",4, 5,  2, copyStrArray(progs["sleeper"]))
    procCreate("cpu",    5, 10, 0, copyStrArray(progs["cpu"]))
    schedulerLoop(3000)
    int i = 1
    int n = g_pcb.length
    bool allTerm = true
    while i < n
        PCB p = g_pcb[i]
        if p.state != PROC_TERMINATED then
            allTerm = false
        end
        i += 1
    end
    expectTrue(allTerm, "integration: all 6 processes terminated")
    expectTrue(g_contextSwitches >= 5, "integration: multiple context switches")
    expectTrue(g_memTranslate > 0, "integration: memory translates occurred")
    expectTrue(g_memPageFault > 0, "integration: page faults occurred")
    expectTrue(g_memTlbHit > 0, "integration: TLB hits occurred")
    expectTrue(fsExists("/tmp/out.log"), "integration: writer created /tmp/out.log")
    expectTrue(fsExists("/srv"), "integration: init created /srv")
    expectTrue(fsExists("/var/log/boot.log"), "integration: init created boot.log")
end


func cmdTest() as int
    println("=== xos self-test ===")
    println("")
    osBoot()
    testFS()
    println("")
    osBoot()
    testMem()
    println("")
    testSched()
    println("")
    osBoot()
    testShellParse()
    println("")
    testShellExec()
    println("")
    osBoot()
    testSyscall()
    println("")
    testIntegration()
    println("")
    println("=== results: " + i2s(g_pass) + " passed, " + i2s(g_fail) + " failed ===")
    if g_fail == 0 then
        return 0
    end
    return 1
end


// ===============================================================
// ===============================================================

func printUsage()
    println("xos - Integrated Operating System Simulator")
    println("")
    println("usage:")
    println("  xos test                 run built-in self-test (process/mem/fs/shell/syscall)")
    println("  xos shell <script.xsh>   execute a shell script")
    println("  xos demo                 run integrated simulation demo")
    println("  xos help                 show this help")
end

func main(...) as int
    if arg.length < 2 then
        printUsage()
        return 1
    end
    string cmd = string(arg[1])
    if cmd == "help" or cmd == "-h" or cmd == "--help" then
        printUsage()
        return 0
    end
    if cmd == "test" then
        return cmdTest()
    end
    if cmd == "demo" then
        return runDemo()
    end
    if cmd == "shell" then
        if arg.length < 3 then
            println("xos: 'shell' needs <script.xsh>")
            return 1
        end
    osBoot()
        array<string> idleProg = array["compute 999"]
        int idle = procCreate("shell", 0, 999, 0, idleProg)
        procArrive(idle)
        g_currentPid = idle
        string script = string(arg[2])
        return shRunScript(script)
    end
    println("xos: unknown command: " + cmd)
    println("")
    printUsage()
    return 1
end
