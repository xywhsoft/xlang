func padR(string s, int w) as string
    return string.padRight(s, w)
end

func padL(string s, int w) as string
    return string.padLeft(s, w)
end

func rep(string s, int n) as string
    return string.repeat(s, n)
end

func clamp(int v, int lo, int hi) as int
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

func mini(int a, int b) as int
    if a < b then return a end
    return b
end

func maxi(int a, int b) as int
    if a > b then return a end
    return b
end

// 闂備胶顢婂▔娑㈡晝閵堝鍋ょ憸鏃堝箠閻愬搫纾兼繝濠傛噹閻忥綁姊?2 闂?hex 闂佸搫顦悧濠囧箰閹间礁鍚?(闂備焦妞垮鍧楀礉鐎ｎ剝濮虫い鎺戝缁€鍐煕濞戝崬骞橀柟?dump).
func hex2(int b) as string
    return string.formatInt(b & 0xFF, "x2")
end

// 闂備浇妗ㄧ粈渚€鎮洪妸鈺佹辈闁绘柨鎲℃慨婊勩亜閹哄棗浜鹃梺鐑╁閸涱垳鐣堕梺鎸庢閸庡銆?
func i2s(int v) as string
    return string(v)
end

// 闂佽瀛╃粙鎺椼€冮崼銉晞濞达絽婀遍埢鏃堟煕濞嗗浚妲圭粭鎴︽⒑閸涘﹦鍟茬紓鍌涚缁傚秹骞掑Δ鈧拑鐔兼煙闁箑澧い銈呮噽缁辨捇宕掑Δ鈧禍楣冩倵濞堝灝鏋撻柛瀣崌閺?(闂佽崵鍠愰悷銉р偓姘卞鐎?stdlib 闂備礁鎲＄粙鏍涢崟顖氱畺闁哄洨濮烽惌姘箾瀹割喕绨奸柨娑氬枛閺屾盯骞囬姘辨闂佺粯绋戦敃顏堝箖娴犲惟闁挎棁濮ょ€氭娊姊洪棃鈺呮婵犮垺锕㈤幆鍐ㄢ攽鐎ｎ偅娅?.
func startsWithP(string s, string pre) as bool
    return string.startsWith(s, pre)
end

func containsP(string s, string sub) as bool
    return string.contains(s, sub)
end

func splitP(string s, string sep) as var
    return string.split(s, sep)
end

// 闂備礁鎲￠…鍥╁垝椤栨粍鏆滈柍褜鍓欒灋闁挎繂妫涙晶顏堟煟閺冩垵澧扮紒顔藉哺閹煎湱鎲撮崟鍏告.
func trimP(string s) as string
    return string.trim(s)
end

// 闂備線娼荤拹鐔煎礉瀹€鍕仱鐟滃繒鍒掗銏℃櫆闁兼剚鍨煎ú?s 濠电偞鍨堕幖鈺呭储閾忕懓鍨濋柣妯烘▕閸熷懘鏌ㄩ弮鍥棄妞ゃ儲绻勭槐鎺懳旀繝鍌氬箰缂備焦姊归幐鎶藉极?ch(byte) 闂備焦鐪归崝宀€鈧凹浜炵划顓㈠川鐎涙ɑ娅? 婵犵數鍋涙径鍥礈濠靛棴鑰垮ù锝堫潐娴溿倝鏌￠崒娑橆嚋缂佲偓閳?-1.
func findByte(string s, int ch) as int
    int n = string.len(s)
    int i = 0
    while i < n do
        if string.byteAt(s, i) == ch then
            return i
        end
        i += 1
    end
    return -1
end

// 闂備礁鎲＄敮鍥磹閺嶎厼钃熼柛銉㈡杹閸嬫挸鈽夊▎妯荤暭濡炪倖鍨抽悞锔剧矙婢舵劕鐭楀璺虹懇閿曞倹鐓曟慨妯哄⒔閻ｉ亶鏌涘▎蹇曠缂佸顦甸幃婊兾熺紒姗嗗晙闂?
func isDigits(string s) as bool
    int n = string.len(s)
    if n == 0 then return false end
    int i = 0
    while i < n do
        int b = string.byteAt(s, i)
        if b < 48 or b > 57 then
            return false
        end
        i += 1
    end
    return true
end

// 闂佽娴烽幊鎾凰囬鐐茬煑?int 闂佽崵鍠愰悷杈╁緤妤ｅ啯鍊? 濠电姰鍨洪崕鑲╁垝閸撗勫枂闁挎棁濮ゆ禍銈夋煛閸屾稑顕滅紒鈧埀?def.
func parseIntSafe(string s, int def) as int
    if not isDigits(s) then
        // 闂備胶顭堢换瀣归崶顒夋晩闊洦绋戠粈鍫⑩偓骞垮劚濞层劑寮?'-'
        int n = string.len(s)
        if n > 1 and string.byteAt(s, 0) == 45 then
            if isDigits(string.mid(s, 1, n - 1)) then
                return int(s)
            end
        end
        return def
    end
    return int(s)
end

func trace(string s)
    if g_trace then
        println("    [trace] " + s)
    end
end


