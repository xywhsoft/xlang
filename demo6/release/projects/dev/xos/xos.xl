func padR(string s, int w) as string
    return string.padRight(s, w)
end

func padL(string s, int w) as string
    return string.padLeft(s, w)
end

func rep(string s, int n) as string
    return string.repeat(s, n)
end

func clamp(int v, int lo, int hi) as int
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

func mini(int a, int b) as int
    if a < b then return a end
    return b
end

func maxi(int a, int b) as int
    if a > b then return a end
    return b
end

func hex2(int b) as string
    return int.format(b & 0xFF, "x2")
end

func i2s(int v) as string
    return string(v)
end

func startsWithP(string s, string pre) as bool
    return string.startsWith(s, pre)
end

func containsP(string s, string sub) as bool
    return string.contains(s, sub)
end

func splitP(string s, string sep) as var
    return string.split(s, sep)
end

func trimP(string s) as string
    return string.trim(s)
end

func findByte(string s, int ch) as int
    int n = string.len(s)
    int i = 0
    while i < n
        if string.byteAt(s, i) == ch then
            return i
        end
        i += 1
    end
    return -1
end

func isDigits(string s) as bool
    int n = string.len(s)
    if n == 0 then return false end
    int i = 0
    while i < n
        int b = string.byteAt(s, i)
        if b < 48 or b > 57 then
            return false
        end
        i += 1
    end
    return true
end

func parseIntSafe(string s, int def) as int
    if not isDigits(s) then
        int n = string.len(s)
        if n > 1 and string.byteAt(s, 0) == 45 then
            if isDigits(string.mid(s, 1, n - 1)) then
                return int(s)
            end
        end
        return def
    end
    return int(s)
end

func trace(string s)
    if g_trace then
        println("    [trace] " + s)
    end
end


