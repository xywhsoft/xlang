// docgen - 文档注释 (#doc ... #end) 验证工具
//
// 全面验证 xlang 的 #doc 文档块系统：
//   1.  doc 五字段             desc / param name / return name / note / example
//   2.  doc 附加到各种声明       func / class / class method / var / const
//   3.  多行文本按缩进收集       （字段体的多行）
//   4.  example 代码围栏         ```xlang ... ``` 只作为文本，不参与语法解析
//   5.  doc 进入语义校验         xl check 通过
//   6.  doc 不影响编译与运行      实际调用每个被文档化的函数/类/字段验证行为
//   7.  错误情况都被拒           10 个 negative case 通过 xl check 子进程验证
//
// 工具自身只含合法 #doc 块；非法用例放在 cases/ 子目录，由 main 通过
// process.run("xl check ...") 调用，验证编译器正确拒绝。
//
// 用法：
//   cd /d D:\GIT\x-lang\demo6\release
//   xl run  projects\dev\docgen\docgen.xl
//   xl build projects\dev\docgen\docgen.xl -o projects\dev\docgen\docgen.exe
//   docgen.exe
//
// 三条路径都必须 EXIT=0。
// ---------------------------------------------------------------------------

// ====================================================================
// 测试框架
// ====================================================================
int g_pass = 0
int g_fail = 0
string g_xl = ""

func ok(string label)
    g_pass += 1
    println("  [PASS] " + label)
end

func bad(string label, string detail)
    g_fail += 1
    println("  [FAIL] " + label + " :: " + detail)
end

func expectI(int got, int want, string label)
    if got == want then
        ok(label)
    else
        bad(label, "got " + string(got) + " want " + string(want))
    end
end

func expectS(string got, string want, string label)
    if got == want then
        ok(label)
    else
        bad(label, "got '" + got + "' want '" + want + "'")
    end
end

func expectB(bool got, bool want, string label)
    if got == want then
        ok(label)
    else
        bad(label, "got " + string(got) + " want " + string(want))
    end
end

// 定位 xl.exe：优先 cwd (xl run 调用目录)，其次 appDir (build exe 同目录)
func findXl() as string
    string c1 = path.join(path.cwd(), "xl.exe")
    if file.exists(c1) then
        return c1
    end
    string c2 = path.join(path.appDir(), "xl.exe")
    if file.exists(c2) then
        return c2
    end
    string c3 = path.join(path.appDir(), "..", "..", "..")
    c3 = path.join(c3, "xl.exe")
    if file.exists(c3) then
        return c3
    end
    return ""
end

// ====================================================================
// 被文档化的全局声明 (合法 #doc 块)
// ====================================================================

#doc
desc:
    Initial seed for the generator. Used as the starting counter.
note:
    This is a documented global var.
example:
    ```xlang
    print(g_seed)
    ```
#end
int g_seed = 100

#doc
desc:
    Hard ceiling shared by all limiters.
#end
const int G_LIMIT = 1024

#doc
desc:
    Adds two integers and returns the sum.

    Multi-line description: second paragraph still belongs to desc
    because it is indented under the field.
param a:
    First value.
param b:
    Second value.
return value:
    Sum result.
note:
    This routine does not overflow-check; callers must stay in range.
example:
    ```xlang
    int s = add(1, 2)
    print(s)
    ```
#end
func add(int a, int b) as int
    return a + b
end

#doc
desc:
    Subtracts second from first.
param a:
    Minuend.
param b:
    Subtrahend.
return result:
    Difference.
#end
func sub(int a, int b) as int
    return a - b
end

#doc
desc:
    Prints a greeting. No return value, so no return field.
param name:
    Whom to greet.
note:
    Uses println so a newline is appended.
example:
    ```xlang
    greet("xlang")
    ```
#end
func greet(string name)
    println("hello, " + name)
end

#doc
desc:
    Picks the larger of two integers. Same name as the class method
    below, but in module scope.
return value:
    The larger input.
#end
func pickMax(int x, int y) as int
    if x >= y then
        return x
    end
    return y
end

#doc
desc:
    Generic clamp: forces v into [lo, hi].
param v:
    Value to clamp.
param lo:
    Lower bound (inclusive).
param hi:
    Upper bound (inclusive).
return clamped:
    v if in range, else the nearest bound.
example:
    ```xlang
    int z = clamp::<int>(5, 0, 10)
    ```
#end
func clamp<T>(T v, T lo, T hi) as T
    if v < lo then
        return lo
    end
    if v > hi then
        return hi
    end
    return v
end

// ====================================================================
// 被文档化的 class
// ====================================================================

#doc
desc:
    A 2D point with integer coordinates.
note:
    Class-level doc supports desc/note/example but NOT param or return.
example:
    ```xlang
    Point p = Point(3, 4)
    print(p.length2())
    ```
#end
class Point
    int x = 0
    int y = 0

    create(int x, int y)
        self.x = x
        self.y = y
    end

    #doc
    desc:
        Squared distance from origin.
    return value:
        x*x + y*y.
    note:
        Method doc fully supports return and note fields.
    example:
        ```xlang
        Point p = Point(3, 4)
        print(p.length2())
        ```
    #end
    func length2() as int
        return self.x * self.x + self.y * self.y
    end

    #doc
    desc:
        Scales both coordinates by the given factor.
    param k:
        Scale factor.
    #end
    func scale(int k)
        self.x = self.x * k
        self.y = self.y * k
    end
end

#doc
desc:
    A simple counter with derive value support.
example:
    ```xlang
    Counter c = Counter()
    c.bump()
    print(c.value())
    ```
#end
class Counter
    derive value

    int n = 0

    create()
    end

    create(int initial)
        self.n = initial
    end

    #doc
    desc:
        Increments the counter by one.
    #end
    func bump()
        self.n += 1
    end

    #doc
    desc:
        Reads the current count.
    return value:
        Current counter value.
    #end
    func value() as int
        return self.n
    end
end

// ====================================================================
// 验证：合法 #doc 块不影响运行行为
// ====================================================================

func testVarConst()
    println("[1] documented global var/const")
    expectI(g_seed, 100, "g_seed           // documented var defaults to 100")
    expectI(G_LIMIT, 1024, "G_LIMIT          // documented const is 1024")
end

func testFuncDoc()
    println("[2] documented functions (desc/param/return/note/example)")
    expectI(add(1, 2), 3, "add(1, 2)        // full 5-field doc")
    expectI(add(100, 23), 123, "add(100, 23)     // doc with multi-line desc")
    expectI(sub(10, 4), 6, "sub(10, 4)       // desc + param + return")
    expectI(pickMax(3, 9), 9, "pickMax(3, 9)    // desc + return only")
end

func testVoidFuncDoc()
    println("[3] documented void function (desc/param/note/example, no return)")
    greet("docgen")
    ok("greet(name)      // void function doc accepts no return field")
end

func testGenericDoc()
    println("[4] documented generic function (param + return)")
    int z = clamp::<int>(5, 0, 10)
    expectI(z, 5, "clamp(5, 0, 10)  // generic with full doc")
    int w = clamp::<int>(-3, 0, 10)
    expectI(w, 0, "clamp(-3, 0, 10) // clamps below to lo")
end

func testClassDoc()
    println("[5] documented class + class methods")
    Point p = Point(3, 4)
    expectI(p.x, 3, "Point(3,4).x     // class with class-level doc")
    expectI(p.y, 4, "Point(3,4).y")
    expectI(p.length2(), 25, "p.length2()      // method with full doc")
    p.scale(2)
    expectI(p.x, 6, "p.scale(2).x     // method with desc + param only")
    expectI(p.y, 8, "p.scale(2).y")
end

func testCounterDoc()
    println("[6] documented class with derive value + 2 ctors + 2 methods")
    Counter c = Counter()
    c.bump()
    c.bump()
    expectI(c.value(), 2, "c.value()        // after 2 bumps via Counter()")
    Counter seeded = Counter(50)
    expectI(seeded.value(), 50, "seeded.value()   // ctor with initial value")
end

func testSerializeStillWorks()
    println("[7] documented class with derive value serializes normally")
    Counter c = Counter(7)
    string text = json.stringify(c)
    expectB(string.contains(text, "n"), true, "json.stringify(c) // contains 'n' field")
    Counter back = json.parse::<Counter>(text)
    expectI(back.value(), 7, "json.parse round-trip preserves count")
end

// ====================================================================
// 非法用例：cases/ 子目录下的 .xl 文件应被 xl check 拒绝
// ====================================================================

// 用 xl check 子进程验证 cases/<name>.xl 编译失败且诊断含 expectedDiag。
// 若找不到 xl.exe，跳过且不计入 fail。
func negativeCheck(string fileName, string expectedDiag)
    if string.len(g_xl) == 0 then
        println("  [SKIP] " + fileName + " (xl.exe not found)")
        return
    end

    string casesDir = path.join(path.cwd(), "projects", "dev", "docgen")
    casesDir = path.join(casesDir, "cases")
    if not dir.exists(casesDir) then
        casesDir = path.join(path.appDir(), "cases")
    end
    string filePath = path.join(casesDir, fileName)
    if not file.exists(filePath) then
        bad(fileName, "case file not found at " + filePath)
        return
    end

    string cmd = g_xl + " check " + filePath
    ProcessResult r = process.run(cmd, 15000)

    if r.exitCode == 0 then
        bad(fileName, "expected compile error but xl check succeeded")
    elseif string.contains(r.stderr, expectedDiag) then
        ok(fileName + " (rejected with expected diagnostic)")
    else
        bad(fileName, "rejected but diagnostic mismatch; want '" + expectedDiag + "'")
    end
end

func testNegatives()
    println("[8] invalid #doc cases (must be rejected by xl check)")
    negativeCheck("bad_unknown_field.xl",   "[sem] #doc")
    negativeCheck("bad_naked_text.xl",      "[sem]")
    negativeCheck("bad_dup_param.xl",       "[sem] #doc")
    negativeCheck("bad_dup_return.xl",      "[sem] #doc")
    negativeCheck("bad_param_mismatch.xl",  "[sem] #doc param")
    negativeCheck("bad_return_on_void.xl",  "[sem] #doc return")
    negativeCheck("bad_param_on_class.xl",  "[sem] #doc param")
    negativeCheck("bad_return_on_class.xl", "[sem] #doc return")
    negativeCheck("bad_unclosed.xl",        "[parse]")
    negativeCheck("bad_orphan.xl",          "[parse]")
end

// ====================================================================
// 入口
// ====================================================================

func main(...) as int
    println("=== docgen: #doc documentation comment verification ===")
    println("(valid doc on func/class/var/const + 10 negative cases)")
    println("")

    g_xl = findXl()
    if string.len(g_xl) > 0 then
        println("(xl.exe found at " + g_xl + ")")
    else
        println("(xl.exe not found; negative checks will be skipped)")
    end
    println("")

    testVarConst()
    testFuncDoc()
    testVoidFuncDoc()
    testGenericDoc()
    testClassDoc()
    testCounterDoc()
    testSerializeStillWorks()
    testNegatives()

    println("")
    println("total passed=" + string(g_pass) + " failed=" + string(g_fail))
    return 0
end
