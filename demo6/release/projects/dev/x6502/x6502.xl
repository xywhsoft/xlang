// x6502.xl - MOS 6502 CPU emulator / assembler / disassembler
//
// A self-contained 6502 core implemented with file-scope (global) state and
// global functions, plus a flat `array<int>` 64KiB memory image, exactly per
// the project brief:
//
//   * CPU state:  A / X / Y registers, SP, PC, P status (NV-BDIZC), 64KiB RAM.
//   * 13 addressing modes (implied, accumulator, immediate, zero-page,
//     zero-page,X / ,Y, absolute, absolute,X / ,Y, indirect, (ind,X),
//     (ind),Y, relative).
//   * 130+ official opcodes across LDA/LDX/LDY/STA/STX/STY/ADC/SBC/AND/
//     ORA/EOR/CMP/CPX/CPY/INC/DEC/INX/INY/DEX/DEY/JMP/JSR/RTS/RTI/BRK/
//     BCC/BCS/BEQ/BNE/BMI/BPL/BVC/BVS/TAX/TAY/TXA/TYA/TSX/TXS/PHA/PLA/
//     PHP/PLP/CLC/SEC/CLI/SEI/CLD/SED/CLV/ASL/LSR/ROL/ROR/BIT/NOP.
//   * Two-pass assembler (label collection then machine-code emission) with
//     `.org / .byte / .word / .ascii` directives and auto zero-page opt.
//   * Machine-code disassembler.
//   * Cycle counting with branch-taken and page-crossing penalties.
//
// usage:
//   x6502 run <file.bin> [cycles]      load a flat memory image and execute
//   x6502 asm <file.s> <out.bin>       assemble source to a binary image
//   x6502 disasm <file.bin>            disassemble a binary image
//   x6502 test                         built-in self tests
//   x6502 -h | --help                  this help
//
// The flat image model:
//   * `asm` lays bytes out at their addresses (default origin 0) and writes a
//     contiguous image [0 .. maxAddrUsed].
//   * `run` loads that image at address 0; if bytes exist at $FFFC/$FFFD and
//     form a non-zero reset vector the CPU starts there, otherwise PC = 0.
//   * This round-trips cleanly: `asm prog.s a.bin` then `run a.bin`.
//
// Standard library coverage exercised:
//   * file.readBytes / file.writeBytes / file.readText / file.exists (binary I/O)
//   * Buffer: Buffer() / appendByte / len / byteAt
//   * array<int> 64KiB memory + string.split/splitLines/trim/upper/lower/
//     startsWith/endsWith/indexOf/replace/slice/repeat/int.format/len/byteAt
//   * dict<int> label table, bitwise &,|,^,~,<<,>>, 8/16-bit masking, signed
//     branch offsets, two-pass label resolution.

// =========================== constants ===========================

const int MEM_SIZE = 0x10000      // 64 KiB
const int STACK_BASE = 0x0100     // stack lives in page 1
const int RESET_VECTOR = 0xFFFC   // power-on / reset vector
const int IRQ_VECTOR = 0xFFFE     // IRQ / BRK vector

// Status register (P) bit masks: N V - B D I Z C  (bit 7 .. 0).
const int FLAG_C = 0x01           // carry
const int FLAG_Z = 0x02           // zero
const int FLAG_I = 0x04           // interrupt disable
const int FLAG_D = 0x08           // decimal mode
const int FLAG_B = 0x10           // break (only meaningful on the stack)
const int FLAG_U = 0x20           // unused, always reads as 1
const int FLAG_V = 0x40           // overflow
const int FLAG_N = 0x80           // negative / sign

// Addressing modes (13 in total).
const int AM_IMP = 0              // implied (no operand)
const int AM_ACC = 1              // accumulator operand, e.g. ASL A
const int AM_IMM = 2              // immediate  #$
const int AM_ZP = 3               // zero page  $zz
const int AM_ZPX = 4              // zero page,X
const int AM_ZPY = 5              // zero page,Y
const int AM_ABS = 6              // absolute  $aabb
const int AM_ABSX = 7             // absolute,X
const int AM_ABSY = 8             // absolute,Y
const int AM_IND = 9              // indirect  ($aabb)
const int AM_INDX = 10            // (ind,X)  indexed indirect
const int AM_INDY = 11            // (ind),Y  indirect indexed
const int AM_REL = 12             // relative  branch target

const int DEFAULT_CYCLES = 100000 // default instruction budget for `run`

// =========================== global CPU state ===========================
//
// The brief mandates global functions + a global `array<int>` memory, so the
// whole machine lives in file-scope mutable state rather than a class.

array<int> g_mem = array[]       // 64 KiB flat RAM, each cell 0..255
int g_A = 0                       // accumulator
int g_X = 0                       // X index register
int g_Y = 0                       // Y index register
int g_SP = 0xFD                   // stack pointer (offset into page 1)
int g_PC = 0                      // program counter
int g_P = FLAG_U                  // status register (unused bit always 1)
int g_totalCycles = 0             // running cycle counter
bool g_pageCrossed = false        // set by the address resolver for cycle adds
bool g_running = true             // cleared by BRK to stop the run loop

// =========================== opcode table ===========================
//
// Three parallel 256-entry tables keyed by opcode byte. `OPN` is the mnemonic
// ("???" for undefined opcodes), `OPM` is the addressing mode, `OPC` is the
// base cycle count. The instruction byte length is derived from the mode.

array<string> OPN = array[]
array<int> OPM = array[]
array<int> OPC = array[]
bool g_tableBuilt = false

// ---- assembler / parser globals (declared up-front, populated by assemble) ----
// g_parseOk is set by parseNumber so callers can tell a literal from a label.
bool g_parseOk = false
dict<int> g_labels = dict<int>{}      // label -> address table
bool g_asmError = false
string g_asmMsg = ""
// One parsed source line, kept as parallel globals to avoid passing structs.
string g_lineMn
string g_lineOp
string g_lineLabel
int g_lineDirKind                     // 0 instr, 1 .org, 2 .byte, 3 .word, 4 .ascii
array<string> g_lineItems = array[]
array<int> g_image = array[]          // 64 KiB assembled output image

// ---- helpers to build a zero-filled typed array of length n ----
func makeIntArray(int n, int v) as array<int>
    array<int> a = array[v]
    int i = 1
    while i < n do
        a.push(v)
        i += 1
    end
    return a
end

func makeStrArray(int n, string v) as array<string>
    array<string> a = array[v]
    int i = 1
    while i < n do
        a.push(v)
        i += 1
    end
    return a
end

// ---- register one opcode into the parallel tables ----
func setOp(int code, string name, int mode, int cyc)
    OPN[code] = name
    OPM[code] = mode
    OPC[code] = cyc
end

// Build the full opcode table once. Covers every legal MOS 6502 instruction
// form (130+ entries); illegal opcodes stay as "???" / AM_IMP / 0 cycles.
func buildTable()
    if g_tableBuilt then
        return
    end
    OPN = makeStrArray(256, "???")
    OPM = makeIntArray(256, AM_IMP)
    OPC = makeIntArray(256, 0)

    // ----- LDA: load accumulator -----
    setOp(0xA9, "LDA", AM_IMM, 2)
    setOp(0xA5, "LDA", AM_ZP, 3)
    setOp(0xB5, "LDA", AM_ZPX, 4)
    setOp(0xAD, "LDA", AM_ABS, 4)
    setOp(0xBD, "LDA", AM_ABSX, 4)
    setOp(0xB9, "LDA", AM_ABSY, 4)
    setOp(0xA1, "LDA", AM_INDX, 6)
    setOp(0xB1, "LDA", AM_INDY, 5)

    // ----- LDX: load X -----
    setOp(0xA2, "LDX", AM_IMM, 2)
    setOp(0xA6, "LDX", AM_ZP, 3)
    setOp(0xB6, "LDX", AM_ZPY, 4)
    setOp(0xAE, "LDX", AM_ABS, 4)
    setOp(0xBE, "LDX", AM_ABSY, 4)

    // ----- LDY: load Y -----
    setOp(0xA0, "LDY", AM_IMM, 2)
    setOp(0xA4, "LDY", AM_ZP, 3)
    setOp(0xB4, "LDY", AM_ZPX, 4)
    setOp(0xAC, "LDY", AM_ABS, 4)
    setOp(0xBC, "LDY", AM_ABSX, 4)

    // ----- STA: store accumulator -----
    setOp(0x85, "STA", AM_ZP, 3)
    setOp(0x95, "STA", AM_ZPX, 4)
    setOp(0x8D, "STA", AM_ABS, 4)
    setOp(0x9D, "STA", AM_ABSX, 5)
    setOp(0x99, "STA", AM_ABSY, 5)
    setOp(0x81, "STA", AM_INDX, 6)
    setOp(0x91, "STA", AM_INDY, 6)

    // ----- STX: store X -----
    setOp(0x86, "STX", AM_ZP, 3)
    setOp(0x96, "STX", AM_ZPY, 4)
    setOp(0x8E, "STX", AM_ABS, 4)

    // ----- STY: store Y -----
    setOp(0x84, "STY", AM_ZP, 3)
    setOp(0x94, "STY", AM_ZPX, 4)
    setOp(0x8C, "STY", AM_ABS, 4)

    // ----- ADC: add with carry (binary mode; D flag notes BCD only) -----
    setOp(0x69, "ADC", AM_IMM, 2)
    setOp(0x65, "ADC", AM_ZP, 3)
    setOp(0x75, "ADC", AM_ZPX, 4)
    setOp(0x6D, "ADC", AM_ABS, 4)
    setOp(0x7D, "ADC", AM_ABSX, 4)
    setOp(0x79, "ADC", AM_ABSY, 4)
    setOp(0x61, "ADC", AM_INDX, 6)
    setOp(0x71, "ADC", AM_INDY, 5)

    // ----- SBC: subtract with carry -----
    setOp(0xE9, "SBC", AM_IMM, 2)
    setOp(0xE5, "SBC", AM_ZP, 3)
    setOp(0xF5, "SBC", AM_ZPX, 4)
    setOp(0xED, "SBC", AM_ABS, 4)
    setOp(0xFD, "SBC", AM_ABSX, 4)
    setOp(0xF9, "SBC", AM_ABSY, 4)
    setOp(0xE1, "SBC", AM_INDX, 6)
    setOp(0xF1, "SBC", AM_INDY, 5)

    // ----- AND: bitwise and -----
    setOp(0x29, "AND", AM_IMM, 2)
    setOp(0x25, "AND", AM_ZP, 3)
    setOp(0x35, "AND", AM_ZPX, 4)
    setOp(0x2D, "AND", AM_ABS, 4)
    setOp(0x3D, "AND", AM_ABSX, 4)
    setOp(0x39, "AND", AM_ABSY, 4)
    setOp(0x21, "AND", AM_INDX, 6)
    setOp(0x31, "AND", AM_INDY, 5)

    // ----- ORA: bitwise or -----
    setOp(0x09, "ORA", AM_IMM, 2)
    setOp(0x05, "ORA", AM_ZP, 3)
    setOp(0x15, "ORA", AM_ZPX, 4)
    setOp(0x0D, "ORA", AM_ABS, 4)
    setOp(0x1D, "ORA", AM_ABSX, 4)
    setOp(0x19, "ORA", AM_ABSY, 4)
    setOp(0x01, "ORA", AM_INDX, 6)
    setOp(0x11, "ORA", AM_INDY, 5)

    // ----- EOR: bitwise exclusive or -----
    setOp(0x49, "EOR", AM_IMM, 2)
    setOp(0x45, "EOR", AM_ZP, 3)
    setOp(0x55, "EOR", AM_ZPX, 4)
    setOp(0x4D, "EOR", AM_ABS, 4)
    setOp(0x5D, "EOR", AM_ABSX, 4)
    setOp(0x59, "EOR", AM_ABSY, 4)
    setOp(0x41, "EOR", AM_INDX, 6)
    setOp(0x51, "EOR", AM_INDY, 5)

    // ----- CMP: compare accumulator -----
    setOp(0xC9, "CMP", AM_IMM, 2)
    setOp(0xC5, "CMP", AM_ZP, 3)
    setOp(0xD5, "CMP", AM_ZPX, 4)
    setOp(0xCD, "CMP", AM_ABS, 4)
    setOp(0xDD, "CMP", AM_ABSX, 4)
    setOp(0xD9, "CMP", AM_ABSY, 4)
    setOp(0xC1, "CMP", AM_INDX, 6)
    setOp(0xD1, "CMP", AM_INDY, 5)

    // ----- CPX / CPY: compare index registers -----
    setOp(0xE0, "CPX", AM_IMM, 2)
    setOp(0xE4, "CPX", AM_ZP, 3)
    setOp(0xEC, "CPX", AM_ABS, 4)
    setOp(0xC0, "CPY", AM_IMM, 2)
    setOp(0xC4, "CPY", AM_ZP, 3)
    setOp(0xCC, "CPY", AM_ABS, 4)

    // ----- INC / DEC: memory increment / decrement -----
    setOp(0xE6, "INC", AM_ZP, 5)
    setOp(0xF6, "INC", AM_ZPX, 6)
    setOp(0xEE, "INC", AM_ABS, 6)
    setOp(0xFE, "INC", AM_ABSX, 7)
    setOp(0xC6, "DEC", AM_ZP, 5)
    setOp(0xD6, "DEC", AM_ZPX, 6)
    setOp(0xCE, "DEC", AM_ABS, 6)
    setOp(0xDE, "DEC", AM_ABSX, 7)

    // ----- INX / INY / DEX / DEY: register inc / dec -----
    setOp(0xE8, "INX", AM_IMP, 2)
    setOp(0xC8, "INY", AM_IMP, 2)
    setOp(0xCA, "DEX", AM_IMP, 2)
    setOp(0x88, "DEY", AM_IMP, 2)

    // ----- control flow -----
    setOp(0x4C, "JMP", AM_ABS, 3)
    setOp(0x6C, "JMP", AM_IND, 5)
    setOp(0x20, "JSR", AM_ABS, 6)
    setOp(0x60, "RTS", AM_IMP, 6)
    setOp(0x40, "RTI", AM_IMP, 6)
    setOp(0x00, "BRK", AM_IMP, 7)

    // ----- branches (relative) -----
    setOp(0x10, "BPL", AM_REL, 2)
    setOp(0x30, "BMI", AM_REL, 2)
    setOp(0x50, "BVC", AM_REL, 2)
    setOp(0x70, "BVS", AM_REL, 2)
    setOp(0x90, "BCC", AM_REL, 2)
    setOp(0xB0, "BCS", AM_REL, 2)
    setOp(0xD0, "BNE", AM_REL, 2)
    setOp(0xF0, "BEQ", AM_REL, 2)

    // ----- stack -----
    setOp(0x48, "PHA", AM_IMP, 3)
    setOp(0x68, "PLA", AM_IMP, 4)
    setOp(0x08, "PHP", AM_IMP, 3)
    setOp(0x28, "PLP", AM_IMP, 4)
    setOp(0x9A, "TXS", AM_IMP, 2)
    setOp(0xBA, "TSX", AM_IMP, 2)

    // ----- register transfers -----
    setOp(0xAA, "TAX", AM_IMP, 2)
    setOp(0xA8, "TAY", AM_IMP, 2)
    setOp(0x8A, "TXA", AM_IMP, 2)
    setOp(0x98, "TYA", AM_IMP, 2)

    // ----- flag operations -----
    setOp(0x18, "CLC", AM_IMP, 2)
    setOp(0x38, "SEC", AM_IMP, 2)
    setOp(0x58, "CLI", AM_IMP, 2)
    setOp(0x78, "SEI", AM_IMP, 2)
    setOp(0xD8, "CLD", AM_IMP, 2)
    setOp(0xF8, "SED", AM_IMP, 2)
    setOp(0xB8, "CLV", AM_IMP, 2)

    // ----- shifts / rotates -----
    setOp(0x0A, "ASL", AM_ACC, 2)
    setOp(0x06, "ASL", AM_ZP, 5)
    setOp(0x16, "ASL", AM_ZPX, 6)
    setOp(0x0E, "ASL", AM_ABS, 6)
    setOp(0x1E, "ASL", AM_ABSX, 7)
    setOp(0x4A, "LSR", AM_ACC, 2)
    setOp(0x46, "LSR", AM_ZP, 5)
    setOp(0x56, "LSR", AM_ZPX, 6)
    setOp(0x4E, "LSR", AM_ABS, 6)
    setOp(0x5E, "LSR", AM_ABSX, 7)
    setOp(0x2A, "ROL", AM_ACC, 2)
    setOp(0x26, "ROL", AM_ZP, 5)
    setOp(0x36, "ROL", AM_ZPX, 6)
    setOp(0x2E, "ROL", AM_ABS, 6)
    setOp(0x3E, "ROL", AM_ABSX, 7)
    setOp(0x6A, "ROR", AM_ACC, 2)
    setOp(0x66, "ROR", AM_ZP, 5)
    setOp(0x76, "ROR", AM_ZPX, 6)
    setOp(0x6E, "ROR", AM_ABS, 6)
    setOp(0x7E, "ROR", AM_ABSX, 7)

    // ----- bit test + nop -----
    setOp(0x24, "BIT", AM_ZP, 3)
    setOp(0x2C, "BIT", AM_ABS, 4)
    setOp(0xEA, "NOP", AM_IMP, 2)

    g_tableBuilt = true
end

// Ensure the table is ready before any decode/assemble work.
func ensureTable()
    if not g_tableBuilt then
        buildTable()
    end
end

// Ensure the 64 KiB memory exists (built lazily on first reset).
func ensureMem()
    if g_mem.length < MEM_SIZE then
        g_mem = makeIntArray(MEM_SIZE, 0)
    end
end

// =========================== memory + flag helpers ===========================

func readByte(int addr) as int
    return g_mem[addr & 0xFFFF]
end

func writeByte(int addr, int v)
    g_mem[addr & 0xFFFF] = v & 0xFF
end

// Read a little-endian 16-bit word.
func readWord(int addr) as int
    int lo = readByte(addr)
    int hi = readByte(addr + 1)
    return (hi << 8) | lo
end

func writeWord(int addr, int w)
    writeByte(addr, w & 0xFF)
    writeByte(addr + 1, (w >> 8) & 0xFF)
end

// Sign-extend an 8-bit value to a signed int (for relative branches).
func toSigned8(int b) as int
    b = b & 0xFF
    if b >= 128 then
        return b - 256
    end
    return b
end

// Flag accessors. getFlag returns 1 or 0 to ease arithmetic use.
func getFlag(int mask) as int
    if (g_P & mask) != 0 then
        return 1
    end
    return 0
end

func setFlag(int mask, bool on)
    if on then
        g_P = (g_P | mask) & 0xFF
    else
        g_P = g_P & ((~mask) & 0xFF)
    end
end

// Update N and Z from a result byte (used by most arithmetic / loads).
func setZN(int v)
    v = v & 0xFF
    setFlag(FLAG_Z, v == 0)
    setFlag(FLAG_N, (v & 0x80) != 0)
end

// =========================== stack helpers ===========================

func pushByte(int v)
    writeByte(STACK_BASE + g_SP, v)
    g_SP = (g_SP - 1) & 0xFF
end

func popByte() as int
    g_SP = (g_SP + 1) & 0xFF
    return readByte(STACK_BASE + g_SP)
end

// Push a word high-byte first (matches 6502 JSR/IRQ push order).
func pushWord(int w)
    pushByte((w >> 8) & 0xFF)
    pushByte(w & 0xFF)
end

func popWord() as int
    int lo = popByte()
    int hi = popByte()
    return (hi << 8) | lo
end

// =========================== addressing resolver ===========================
//
// Reads the operand bytes for the given mode, advances PC past them, and
// returns the effective address. For immediate mode the address is the byte
// location of the literal itself. Also raises `g_pageCrossed` for the
// indexed absolute / indirect-indexed forms (used for cycle penalties).

func resolveAddr(int mode) as int
    g_pageCrossed = false
    int addr = 0
    if mode == AM_IMM then
        addr = g_PC
        g_PC = (g_PC + 1) & 0xFFFF
    elseif mode == AM_ZP then
        addr = readByte(g_PC)
        g_PC = (g_PC + 1) & 0xFFFF
    elseif mode == AM_ZPX then
        addr = (readByte(g_PC) + g_X) & 0xFF
        g_PC = (g_PC + 1) & 0xFFFF
    elseif mode == AM_ZPY then
        addr = (readByte(g_PC) + g_Y) & 0xFF
        g_PC = (g_PC + 1) & 0xFFFF
    elseif mode == AM_ABS then
        addr = readWord(g_PC)
        g_PC = (g_PC + 2) & 0xFFFF
    elseif mode == AM_ABSX then
        int base = readWord(g_PC)
        g_PC = (g_PC + 2) & 0xFFFF
        addr = (base + g_X) & 0xFFFF
        g_pageCrossed = (base & 0xFF00) != (addr & 0xFF00)
    elseif mode == AM_ABSY then
        int base = readWord(g_PC)
        g_PC = (g_PC + 2) & 0xFFFF
        addr = (base + g_Y) & 0xFFFF
        g_pageCrossed = (base & 0xFF00) != (addr & 0xFF00)
    elseif mode == AM_IND then
        int ptr = readWord(g_PC)
        g_PC = (g_PC + 2) & 0xFFFF
        // 6502 indirect-JMP page-boundary bug: the high byte of the pointer
        // is fetched from the same page (low byte wraps without carrying).
        int lo = readByte(ptr)
        int hi = readByte((ptr & 0xFF00) | ((ptr + 1) & 0xFF))
        addr = (hi << 8) | lo
    elseif mode == AM_INDX then
        // ($zp,X): add X to the zero-page operand, read a pointer pair there.
        int zp = (readByte(g_PC) + g_X) & 0xFF
        g_PC = (g_PC + 1) & 0xFFFF
        int lo = readByte(zp)
        int hi = readByte((zp + 1) & 0xFF)
        addr = (hi << 8) | lo
    elseif mode == AM_INDY then
        // ($zp),Y: read a pointer pair at the zero-page operand, add Y.
        int zp = readByte(g_PC)
        g_PC = (g_PC + 1) & 0xFFFF
        int base = readByte(zp) | (readByte((zp + 1) & 0xFF) << 8)
        addr = (base + g_Y) & 0xFFFF
        g_pageCrossed = (base & 0xFF00) != (addr & 0xFF00)
    end
    return addr
end

// Number of bytes an instruction of this mode occupies (opcode included).
func modeToSize(int mode) as int
    if mode == AM_IMP or mode == AM_ACC then
        return 1
    end
    if mode == AM_IMM or mode == AM_ZP or mode == AM_ZPX or mode == AM_ZPY then
        return 2
    end
    if mode == AM_INDX or mode == AM_INDY or mode == AM_REL then
        return 2
    end
    return 3
end

// Whether this mnemonic incurs a +1 cycle on a page cross. Only the plain
// memory-reading ALU/load ops do; stores and read-modify-writes do not.
func pagePenaltyApplies(string mn) as bool
    if mn == "LDA" then
        return true
    end
    if mn == "LDX" then
        return true
    end
    if mn == "LDY" then
        return true
    end
    if mn == "ADC" then
        return true
    end
    if mn == "SBC" then
        return true
    end
    if mn == "AND" then
        return true
    end
    if mn == "ORA" then
        return true
    end
    if mn == "EOR" then
        return true
    end
    if mn == "CMP" then
        return true
    end
    return false
end

// =========================== ALU primitives ===========================

// Binary-mode ADC. (Decimal/BCD mode is not modelled: real 6502 honours the
// D flag, but for an emulator demo binary arithmetic is what programs test.)
func doAdc(int v)
    int a = g_A
    int c = getFlag(FLAG_C)
    int sum = a + v + c
    setFlag(FLAG_C, sum > 0xFF)
    setFlag(FLAG_V, ((~(a ^ v)) & (a ^ sum) & 0x80) != 0)
    g_A = sum & 0xFF
    setZN(g_A)
end

// SBC implemented via the ADC identity: A + (255 - v) + C.
func doSbc(int v)
    int a = g_A
    int c = getFlag(FLAG_C)
    int value255 = v ^ 0xFF
    int sum = a + value255 + c
    setFlag(FLAG_C, sum > 0xFF)
    setFlag(FLAG_V, ((~(a ^ value255)) & (a ^ sum) & 0x80) != 0)
    g_A = sum & 0xFF
    setZN(g_A)
end

// CMP/CPX/CPY share this: set C=reg>=v, and N/Z from reg-v.
func doCmp(int reg, int v)
    setFlag(FLAG_C, reg >= v)
    setZN((reg - v) & 0xFF)
end

// BIT: Z = A&v==0, N and V copied from the operand's top bits.
func doBit(int v)
    setFlag(FLAG_Z, (g_A & v) == 0)
    setFlag(FLAG_N, (v & 0x80) != 0)
    setFlag(FLAG_V, (v & 0x40) != 0)
end

// =========================== shift / rotate primitives ===========================
// Each returns the new value and updates C / N / Z.

func opAsl(int v) as int
    setFlag(FLAG_C, (v & 0x80) != 0)
    v = (v << 1) & 0xFF
    setZN(v)
    return v
end

func opLsr(int v) as int
    setFlag(FLAG_C, (v & 0x01) != 0)
    v = (v >> 1) & 0xFF
    setZN(v)
    return v
end

func opRol(int v) as int
    int c = getFlag(FLAG_C)
    setFlag(FLAG_C, (v & 0x80) != 0)
    v = ((v << 1) | c) & 0xFF
    setZN(v)
    return v
end

func opRor(int v) as int
    int c = getFlag(FLAG_C)
    setFlag(FLAG_C, (v & 0x01) != 0)
    v = ((v >> 1) | (c << 7)) & 0xFF
    setZN(v)
    return v
end

// =========================== CPU core ===========================

// Cold-start the CPU: wipe RAM, reset registers to documented power-on state
// (SP = $FD, I = 1, unused bit = 1), load PC from the reset vector.
func reset()
    ensureTable()
    ensureMem()
    int i = 0
    while i < MEM_SIZE do
        g_mem[i] = 0
        i += 1
    end
    g_A = 0
    g_X = 0
    g_Y = 0
    g_SP = 0xFD
    g_P = FLAG_U | FLAG_I
    g_totalCycles = 0
    g_running = true
    g_PC = readWord(RESET_VECTOR)
    if g_PC == 0 then
        // No reset vector burned in: start at address 0 for convenience.
        g_PC = 0
    end
end

// Soft reset that reloads PC from the vector but keeps RAM contents, used by
// the `run` command after loading a flat image (so the image is preserved).
func resetKeepMem()
    ensureTable()
    ensureMem()
    g_A = 0
    g_X = 0
    g_Y = 0
    g_SP = 0xFD
    g_P = FLAG_U | FLAG_I
    g_totalCycles = 0
    g_running = true
    int vec = readWord(RESET_VECTOR)
    if vec != 0 then
        g_PC = vec
    else
        g_PC = 0
    end
end

// Execute one instruction. Returns the number of cycles consumed (0 for an
// undefined opcode, which is treated as a 2-cycle NOP to avoid runaway).
func step() as int
    int opcode = readByte(g_PC)
    g_PC = (g_PC + 1) & 0xFFFF

    string mn = OPN[opcode]
    int mode = OPM[opcode]
    int cyc = OPC[opcode]

    if mn == "???" then
        // Treat illegal opcodes as a 2-cycle NOP so runs never wedge.
        g_totalCycles += 2
        return 2
    end

    g_pageCrossed = false
    int addr = 0
    int value = 0

    // Decode the operand according to the addressing mode.
    if mode == AM_IMM then
        addr = g_PC
        value = readByte(g_PC)
        g_PC = (g_PC + 1) & 0xFFFF
    elseif mode == AM_REL then
        int off = toSigned8(readByte(g_PC))
        g_PC = (g_PC + 1) & 0xFFFF
        addr = (g_PC + off) & 0xFFFF
    elseif mode == AM_IMP or mode == AM_ACC then
        // No operand to fetch.
    else
        addr = resolveAddr(mode)
        value = readByte(addr)
    end

    // Dispatch on mnemonic. Grouped logically.
    if mn == "LDA" then
        g_A = value & 0xFF
        setZN(g_A)
    elseif mn == "LDX" then
        g_X = value & 0xFF
        setZN(g_X)
    elseif mn == "LDY" then
        g_Y = value & 0xFF
        setZN(g_Y)
    elseif mn == "STA" then
        writeByte(addr, g_A)
    elseif mn == "STX" then
        writeByte(addr, g_X)
    elseif mn == "STY" then
        writeByte(addr, g_Y)
    elseif mn == "ADC" then
        doAdc(value)
    elseif mn == "SBC" then
        doSbc(value)
    elseif mn == "AND" then
        g_A = g_A & value
        setZN(g_A)
    elseif mn == "ORA" then
        g_A = g_A | value
        setZN(g_A)
    elseif mn == "EOR" then
        g_A = g_A ^ value
        setZN(g_A)
    elseif mn == "CMP" then
        doCmp(g_A, value)
    elseif mn == "CPX" then
        doCmp(g_X, value)
    elseif mn == "CPY" then
        doCmp(g_Y, value)
    elseif mn == "INC" then
        int nv = (readByte(addr) + 1) & 0xFF
        writeByte(addr, nv)
        setZN(nv)
    elseif mn == "DEC" then
        int nv = (readByte(addr) - 1) & 0xFF
        writeByte(addr, nv)
        setZN(nv)
    elseif mn == "INX" then
        g_X = (g_X + 1) & 0xFF
        setZN(g_X)
    elseif mn == "INY" then
        g_Y = (g_Y + 1) & 0xFF
        setZN(g_Y)
    elseif mn == "DEX" then
        g_X = (g_X - 1) & 0xFF
        setZN(g_X)
    elseif mn == "DEY" then
        g_Y = (g_Y - 1) & 0xFF
        setZN(g_Y)
    elseif mn == "JMP" then
        g_PC = addr
    elseif mn == "JSR" then
        // Push address of last byte of the JSR (PC-1); jump to target.
        pushWord((g_PC - 1) & 0xFFFF)
        g_PC = addr
    elseif mn == "RTS" then
        int ret = popWord()
        g_PC = (ret + 1) & 0xFFFF
    elseif mn == "RTI" then
        g_P = (popByte() & ((~FLAG_B) & 0xFF)) | FLAG_U
        g_PC = popWord()
    elseif mn == "BRK" then
        // Force a break: push PC, push P|B|U, take the IRQ vector, stop run.
        pushWord((g_PC + 1) & 0xFFFF)
        pushByte((g_P | FLAG_B | FLAG_U) & 0xFF)
        setFlag(FLAG_I, true)
        g_PC = readWord(IRQ_VECTOR)
        g_running = false
    elseif mn == "BPL" then
        branch(addr, getFlag(FLAG_N) == 0)
    elseif mn == "BMI" then
        branch(addr, getFlag(FLAG_N) == 1)
    elseif mn == "BVC" then
        branch(addr, getFlag(FLAG_V) == 0)
    elseif mn == "BVS" then
        branch(addr, getFlag(FLAG_V) == 1)
    elseif mn == "BCC" then
        branch(addr, getFlag(FLAG_C) == 0)
    elseif mn == "BCS" then
        branch(addr, getFlag(FLAG_C) == 1)
    elseif mn == "BNE" then
        branch(addr, getFlag(FLAG_Z) == 0)
    elseif mn == "BEQ" then
        branch(addr, getFlag(FLAG_Z) == 1)
    elseif mn == "PHA" then
        pushByte(g_A)
    elseif mn == "PLA" then
        g_A = popByte()
        setZN(g_A)
    elseif mn == "PHP" then
        pushByte((g_P | FLAG_B | FLAG_U) & 0xFF)
    elseif mn == "PLP" then
        g_P = (popByte() & ((~FLAG_B) & 0xFF)) | FLAG_U
    elseif mn == "TXS" then
        g_SP = g_X & 0xFF
    elseif mn == "TSX" then
        g_X = g_SP & 0xFF
        setZN(g_X)
    elseif mn == "TAX" then
        g_X = g_A & 0xFF
        setZN(g_X)
    elseif mn == "TAY" then
        g_Y = g_A & 0xFF
        setZN(g_Y)
    elseif mn == "TXA" then
        g_A = g_X & 0xFF
        setZN(g_A)
    elseif mn == "TYA" then
        g_A = g_Y & 0xFF
        setZN(g_A)
    elseif mn == "CLC" then
        setFlag(FLAG_C, false)
    elseif mn == "SEC" then
        setFlag(FLAG_C, true)
    elseif mn == "CLI" then
        setFlag(FLAG_I, false)
    elseif mn == "SEI" then
        setFlag(FLAG_I, true)
    elseif mn == "CLD" then
        setFlag(FLAG_D, false)
    elseif mn == "SED" then
        setFlag(FLAG_D, true)
    elseif mn == "CLV" then
        setFlag(FLAG_V, false)
    elseif mn == "ASL" then
        if mode == AM_ACC then
            g_A = opAsl(g_A)
        else
            writeByte(addr, opAsl(value))
        end
    elseif mn == "LSR" then
        if mode == AM_ACC then
            g_A = opLsr(g_A)
        else
            writeByte(addr, opLsr(value))
        end
    elseif mn == "ROL" then
        if mode == AM_ACC then
            g_A = opRol(g_A)
        else
            writeByte(addr, opRol(value))
        end
    elseif mn == "ROR" then
        if mode == AM_ACC then
            g_A = opRor(g_A)
        else
            writeByte(addr, opRor(value))
        end
    elseif mn == "BIT" then
        doBit(value)
    elseif mn == "NOP" then
        // No operation.
    end

    // Page-cross penalty for read-style indexed/indirect ops.
    if g_pageCrossed then
        if mode == AM_ABSX or mode == AM_ABSY or mode == AM_INDY then
            if pagePenaltyApplies(mn) then
                cyc += 1
            end
        end
    end

    g_totalCycles += cyc
    return cyc
end

// Branch helper: if the condition holds, jump to target and add the
// branch-taken (+1) and page-cross (+1) cycle penalties.
func branch(int target, bool taken)
    if taken then
        int next = g_PC & 0xFFFF
        if (target & 0xFF00) != (next & 0xFF00) then
            g_totalCycles += 1
        end
        g_totalCycles += 1
        g_PC = target & 0xFFFF
    end
end

// Run up to `maxCycles` instructions or until BRK stops the run loop.
func run(int maxCycles)
    int n = 0
    while n < maxCycles and g_running do
        step()
        n += 1
    end
end

// =========================== register dump ===========================

func flagChar(int mask, string onCh, string offCh) as string
    if getFlag(mask) != 0 then
        return onCh
    end
    return offCh
end

// Render P as "NV-BDIZC" with set bits upper-case, clear bits lower-case.
func dumpFlags() as string
    string s = ""
    s = s + flagChar(FLAG_N, "N", "n")
    s = s + flagChar(FLAG_V, "V", "v")
    s = s + "-"
    s = s + flagChar(FLAG_B, "B", "b")
    s = s + flagChar(FLAG_D, "D", "d")
    s = s + flagChar(FLAG_I, "I", "i")
    s = s + flagChar(FLAG_Z, "Z", "z")
    s = s + flagChar(FLAG_C, "C", "c")
    return s
end

func hex2(int b) as string
    return int.format(b & 0xFF, "x2")
end

func hex4(int w) as string
    return int.format(w & 0xFFFF, "X4")
end

func dumpState()
    println("PC=" + hex4(g_PC) + "  SP=" + hex2(g_SP) + "  A=" + hex2(g_A) +
            "  X=" + hex2(g_X) + "  Y=" + hex2(g_Y) + "  P=" + dumpFlags())
    println("cycles=" + string(g_totalCycles))
    // Dump the first 16 bytes of zero page for a quick sanity view.
    string line = "ZP:"
    int i = 0
    while i < 16 do
        line = line + " " + hex2(g_mem[i])
        i += 1
    end
    println(line)
end

// =========================== hex / number parsing (assembler) ===========================

// True if `ch` (a byte value) is a decimal digit.
func isDecByte(int ch) as bool
    return ch >= 48 and ch <= 57
end

func isHexByte(int ch) as bool
    if isDecByte(ch) then
        return true
    end
    if ch >= 65 and ch <= 70 then
        return true
    end
    if ch >= 97 and ch <= 102 then
        return true
    end
    return false
end

func hexVal(int ch) as int
    if isDecByte(ch) then
        return ch - 48
    end
    if ch >= 65 and ch <= 70 then
        return ch - 55
    end
    if ch >= 97 and ch <= 102 then
        return ch - 87
    end
    return 0
end

// Global parse-status flag: parseNumber sets g_parseOk so callers can tell whether
// the string was a real numeric literal (vs. a label name).
// (g_parseOk is declared with the file-scope globals near the top of the file.)

// Parse a numeric literal: $hex, %binary, decimal, or 'c' char literal.
// Sets g_parseOk = false and returns 0 on anything that is not a literal.
func parseNumber(string s) as int
    g_parseOk = false
    s = string.trim(s)
    int n = string.len(s)
    if n == 0 then
        return 0
    end
    int i = 0
    int sign = 1
    if string.byteAt(s, 0) == 45 then
        // leading '-'
        sign = -1
        i = 1
        if n == 1 then
            return 0
        end
    end
    int c0 = string.byteAt(s, i)
    // '$' hex
    if c0 == 36 then
        int j = i + 1
        if j >= n then
            return 0
        end
        int v = 0
        while j < n do
            int ch = string.byteAt(s, j)
            if not isHexByte(ch) then
                return 0
            end
            v = (v << 4) | hexVal(ch)
            j += 1
        end
        g_parseOk = true
        return sign * v
    end
    // '%' binary
    if c0 == 37 then
        int j = i + 1
        if j >= n then
            return 0
        end
        int v = 0
        while j < n do
            int ch = string.byteAt(s, j)
            if ch != 48 and ch != 49 then
                return 0
            end
            v = (v << 1) | (ch - 48)
            j += 1
        end
        g_parseOk = true
        return sign * v
    end
    // 'c' char literal (single ASCII char in single quotes).
    if c0 == 39 and n - i == 3 and string.byteAt(s, n - 1) == 39 then
        g_parseOk = true
        return sign * string.byteAt(s, i + 1)
    end
    // decimal
    int j = i
    if j >= n then
        return 0
    end
    int v = 0
    while j < n do
        int ch = string.byteAt(s, j)
        if not isDecByte(ch) then
            return 0
        end
        v = v * 10 + (ch - 48)
        j += 1
    end
    g_parseOk = true
    return sign * v
end

// Is `s` a pure numeric literal (no label involved)?
func isLiteral(string s) as bool
    int v = parseNumber(s)
    return g_parseOk
end

// =========================== assembler: operand classification ===========================
// (g_labels / g_asmError / g_asmMsg are declared with the file-scope globals.)

func asmError(string msg)
    if not g_asmError then
        g_asmError = true
        g_asmMsg = msg
    end
end

// Is `mn` one of the eight relative-branch mnemonics?
func isBranchMn(string mn) as bool
    if mn == "BPL" then
        return true
    end
    if mn == "BMI" then
        return true
    end
    if mn == "BVC" then
        return true
    end
    if mn == "BVS" then
        return true
    end
    if mn == "BCC" then
        return true
    end
    if mn == "BCS" then
        return true
    end
    if mn == "BNE" then
        return true
    end
    if mn == "BEQ" then
        return true
    end
    return false
end

// Does this mnemonic have a zero-page form? (Used to decide whether a small
// literal operand can be encoded compactly.)
func mnSupportsZP(string mn) as bool
    if mn == "LDA" then
        return true
    end
    if mn == "LDX" then
        return true
    end
    if mn == "LDY" then
        return true
    end
    if mn == "STA" then
        return true
    end
    if mn == "STX" then
        return true
    end
    if mn == "STY" then
        return true
    end
    if mn == "ADC" then
        return true
    end
    if mn == "SBC" then
        return true
    end
    if mn == "AND" then
        return true
    end
    if mn == "ORA" then
        return true
    end
    if mn == "EOR" then
        return true
    end
    if mn == "CMP" then
        return true
    end
    if mn == "CPX" then
        return true
    end
    if mn == "CPY" then
        return true
    end
    if mn == "INC" then
        return true
    end
    if mn == "DEC" then
        return true
    end
    if mn == "ASL" then
        return true
    end
    if mn == "LSR" then
        return true
    end
    if mn == "ROL" then
        return true
    end
    if mn == "ROR" then
        return true
    end
    if mn == "BIT" then
        return true
    end
    return false
end

// Strip operand decorations (#, parens, ,X/,Y) leaving a bare number/label.
func cleanOperand(string op) as string
    op = string.trim(op)
    op = string.replace(op, "#", "")
    op = string.replace(op, "(", "")
    op = string.replace(op, ")", "")
    if string.endsWith(op, ",X") then
        op = string.slice(op, 0, string.len(op) - 2)
    end
    if string.endsWith(op, ",Y") then
        op = string.slice(op, 0, string.len(op) - 2)
    end
    return string.trim(op)
end

// Decide the addressing mode for `mn` given the raw operand text.
func classifyOperand(string mn, string operand) as int
    operand = string.trim(operand)
    if operand == "" then
        if mn == "ASL" or mn == "LSR" or mn == "ROL" or mn == "ROR" then
            return AM_ACC
        end
        return AM_IMP
    end
    if string.startsWith(operand, "#") then
        return AM_IMM
    end
    if string.startsWith(operand, "(") then
        if string.endsWith(operand, ",X)") then
            return AM_INDX
        end
        if string.endsWith(operand, "),Y") then
            return AM_INDY
        end
        return AM_IND
    end
    if isBranchMn(mn) then
        return AM_REL
    end
    if string.endsWith(operand, ",X") then
        string v = cleanOperand(operand)
        int x = parseNumber(v)
        if g_parseOk and x >= 0 and x <= 0xFF then
            return AM_ZPX
        end
        return AM_ABSX
    end
    if string.endsWith(operand, ",Y") then
        string v = cleanOperand(operand)
        int x = parseNumber(v)
        if g_parseOk and x >= 0 and x <= 0xFF then
            return AM_ZPY
        end
        return AM_ABSY
    end
    string v = cleanOperand(operand)
    int x = parseNumber(v)
    if g_parseOk and x >= 0 and x <= 0xFF and mnSupportsZP(mn) then
        return AM_ZP
    end
    return AM_ABS
end

// Evaluate an operand to a value, resolving labels via g_labels.
func evalValue(string operand) as int
    string v = cleanOperand(operand)
    int x = parseNumber(v)
    if g_parseOk then
        return x
    end
    // Label lookup (labels are stored upper-cased).
    string up = string.upper(v)
    if (up in g_labels) then
        return g_labels[up]
    end
    asmError("unknown label: " + v)
    return 0
end

// Find the opcode byte for a (mnemonic, mode) pair, or -1 if illegal.
func findOpcode(string mn, int mode) as int
    int i = 0
    while i < 256 do
        if OPN[i] == mn and OPM[i] == mode then
            return i
        end
        i += 1
    end
    return -1
end

// =========================== assembler: line splitting ===========================

// A parsed source line is kept as parallel globals (g_lineMn / g_lineOp /
// g_lineLabel / g_lineDirKind / g_lineItems), declared up front near the top.

// Test whether `name` is a legal label/identifier lead-in.
func isIdentStart(int ch) as bool
    if ch >= 65 and ch <= 90 then
        return true
    end
    if ch >= 97 and ch <= 122 then
        return true
    end
    if ch == 95 then
        return true
    end
    return false
end

func isIdent(int ch) as bool
    if isIdentStart(ch) then
        return true
    end
    if isDecByte(ch) then
        return true
    end
    if ch == 95 then
        return true
    end
    return false
end

// Split `line` into label / mnemonic / operand, populate the g_line* globals.
// Returns false for blank or comment-only lines.
func parseLine(string line) as bool
    g_lineLabel = ""
    g_lineMn = ""
    g_lineOp = ""
    g_lineDirKind = 0
    g_lineItems = array[]

    // Strip a trailing comment (everything from the first ';').
    int semi = string.indexOf(line, ";")
    if semi >= 0 then
        line = string.slice(line, 0, semi)
    end
    line = string.trim(line)
    if line == "" then
        return false
    end

    // Optional leading `label:`.
    if isIdentStart(string.byteAt(line, 0)) then
        int k = 0
        int ln = string.len(line)
        while k < ln and isIdent(string.byteAt(line, k)) do
            k += 1
        end
        if k < ln and string.byteAt(line, k) == 58 then
            // ':' found -> label.
            g_lineLabel = string.upper(string.slice(line, 0, k))
            line = string.trim(string.slice(line, k + 1))
            if line == "" then
                return true
            end
        end
    end

    // Split into mnemonic (first token) and operand (the rest).
    int sp = string.indexOf(line, " ")
    if sp < 0 then
        sp = string.indexOf(line, "\t")
    end
    string head
    if sp < 0 then
        head = line
        g_lineOp = ""
    else
        head = string.slice(line, 0, sp)
        g_lineOp = string.trim(string.slice(line, sp + 1))
    end
    head = string.upper(head)

    // Recognise directives.
    if head == ".ORG" then
        g_lineDirKind = 1
        g_lineMn = head
        return true
    end
    if head == ".BYTE" or head == ".DB" then
        g_lineDirKind = 2
        g_lineMn = head
        g_lineItems = splitItems(g_lineOp)
        return true
    end
    if head == ".WORD" or head == ".DW" then
        g_lineDirKind = 3
        g_lineMn = head
        g_lineItems = splitItems(g_lineOp)
        return true
    end
    if head == ".ASCII" then
        g_lineDirKind = 4
        g_lineMn = head
        return true
    end

    g_lineMn = head
    return true
end

// Split a comma-separated operand list, trimming each item.
func splitItems(string s) as array<string>
    array<string> outputValue = array[]
    array parts = string.split(s, ",")
    int i = 0
    while i < parts.length do
        string t = string.trim(string(parts[i]))
        if t != "" then
            outputValue.push(t)
        end
        i += 1
    end
    return outputValue
end

// Size (in bytes) of the current parsed line at assembly time. Used in pass 1
// to assign label addresses before any values are emitted.
func lineSize() as int
    if g_lineDirKind == 1 then
        return 0
    end
    if g_lineDirKind == 2 then
        return g_lineItems.length
    end
    if g_lineDirKind == 3 then
        return g_lineItems.length * 2
    end
    if g_lineDirKind == 4 then
        return asciiLen(g_lineOp)
    end
    if g_lineMn == "" then
        return 0
    end
    int mode = classifyOperand(g_lineMn, g_lineOp)
    return modeToSize(mode)
end

// Length of the bytes produced by a `.ascii "..."` literal.
func asciiLen(string op) as int
    op = string.trim(op)
    int n = string.len(op)
    if n < 2 then
        return 0
    end
    if string.byteAt(op, 0) == 34 and string.byteAt(op, n - 1) == 34 then
        return n - 2
    end
    return n
end

// =========================== assembler: two passes ===========================

// Assemble `src` into g_image (a 64 KiB array<int>). Returns the highest
// address written + 1 (the image length to emit). Sets g_asmError on failure.
// (g_image is declared with the file-scope globals near the top of the file.)

func assemble(string src) as int
    ensureTable()
    g_labels = dict<int>{}
    g_asmError = false
    g_asmMsg = ""
    g_image = makeIntArray(MEM_SIZE, 0)

    array rawLines = string.splitLines(src)

    // ---- Pass 1: collect labels and compute instruction sizes ----
    int addr = 0
    int li = 0
    while li < rawLines.length do
        bool hasContent = parseLine(string(rawLines[li]))
        if hasContent then
            if g_lineLabel != "" then
                if (g_lineLabel in g_labels) then
                    asmError("duplicate label: " + g_lineLabel)
                else
                    g_labels[g_lineLabel] = addr
                end
            end
            if g_lineDirKind == 1 then
                // .org expr
                addr = evalValue(g_lineOp)
                if addr < 0 or addr >= MEM_SIZE then
                    asmError(".org out of range: " + string(addr))
                end
            else
                addr = addr + lineSize()
            end
        end
        li += 1
    end

    if g_asmError then
        return 0
    end

    // ---- Pass 2: emit machine code ----
    int maxAddr = 0
    addr = 0
    li = 0
    while li < rawLines.length and not g_asmError do
        parseLine(string(rawLines[li]))
        if g_lineDirKind == 1 then
            addr = evalValue(g_lineOp)
        elseif g_lineDirKind == 2 then
            int k = 0
            while k < g_lineItems.length do
                int bv = evalValue(string(g_lineItems[k])) & 0xFF
                g_image[addr] = bv
                if addr + 1 > maxAddr then
                    maxAddr = addr + 1
                end
                addr += 1
                k += 1
            end
        elseif g_lineDirKind == 3 then
            int k = 0
            while k < g_lineItems.length do
                int wv = evalValue(string(g_lineItems[k])) & 0xFFFF
                g_image[addr] = wv & 0xFF
                g_image[addr + 1] = (wv >> 8) & 0xFF
                if addr + 2 > maxAddr then
                    maxAddr = addr + 2
                end
                addr += 2
                k += 1
            end
        elseif g_lineDirKind == 4 then
            int bl = asciiLen(g_lineOp)
            string lit = string.slice(g_lineOp, 1, asciiLen(g_lineOp))
            int k = 0
            while k < bl do
                g_image[addr + k] = string.byteAt(lit, k)
                k += 1
            end
            if addr + bl > maxAddr then
                maxAddr = addr + bl
            end
            addr += bl
        else
            if g_lineMn != "" then
                int mode = classifyOperand(g_lineMn, g_lineOp)
                int code = findOpcode(g_lineMn, mode)
                if code < 0 then
                    asmError("illegal addressing mode for " + g_lineMn)
                else
                    g_image[addr] = code
                    int sz = modeToSize(mode)
                    if sz >= 2 then
                        int val = evalValue(g_lineOp)
                        if mode == AM_REL then
                            int off = val - (addr + 2)
                            if off < -128 or off > 127 then
                                asmError("branch out of range")
                            end
                            g_image[addr + 1] = off & 0xFF
                        elseif sz == 2 then
                            g_image[addr + 1] = val & 0xFF
                        else
                            g_image[addr + 1] = val & 0xFF
                            g_image[addr + 2] = (val >> 8) & 0xFF
                        end
                    end
                    if addr + sz > maxAddr then
                        maxAddr = addr + sz
                    end
                    addr += sz
                end
            end
        end
        li += 1
    end

    return maxAddr
end

// =========================== disassembler ===========================

// Bounds-checked fetch for disassembling images shorter than 64 KiB.
func fetchAt(array<int> mem, int memLen, int idx) as int
    if idx >= memLen then
        return 0
    end
    return mem[idx]
end

// Format the operand text of one instruction at `pc` in `mem`.
func formatOperand(array<int> mem, int memLen, int pc, int mode) as string
    int b1 = fetchAt(mem, memLen, pc + 1)
    int b2 = fetchAt(mem, memLen, pc + 2)
    if mode == AM_IMP then
        return ""
    end
    if mode == AM_ACC then
        return "A"
    end
    if mode == AM_IMM then
        return "#$" + hex2(b1)
    end
    if mode == AM_ZP then
        return "$" + hex2(b1)
    end
    if mode == AM_ZPX then
        return "$" + hex2(b1) + ",X"
    end
    if mode == AM_ZPY then
        return "$" + hex2(b1) + ",Y"
    end
    if mode == AM_ABS then
        return "$" + hex4((b2 << 8) | b1)
    end
    if mode == AM_ABSX then
        return "$" + hex4((b2 << 8) | b1) + ",X"
    end
    if mode == AM_ABSY then
        return "$" + hex4((b2 << 8) | b1) + ",Y"
    end
    if mode == AM_IND then
        return "($" + hex4((b2 << 8) | b1) + ")"
    end
    if mode == AM_INDX then
        return "($" + hex2(b1) + ",X)"
    end
    if mode == AM_INDY then
        return "($" + hex2(b1) + "),Y"
    end
    if mode == AM_REL then
        // Show the absolute target address so branches read naturally.
        int target = (pc + 2 + toSigned8(b1)) & 0xFFFF
        return "$" + hex4(target)
    end
    return ""
end

// Disassemble the contents of a byte image, printing one line per instruction.
func disassembleImage(array<int> mem, int memLen) as int
    ensureTable()
    int pc = 0
    while pc < memLen do
        int opcode = mem[pc]
        string mn = OPN[opcode]
        int mode = OPM[opcode]
        int sz = modeToSize(mode)
        if mn == "???" then
            mn = "DB"
            mode = AM_IMP
            sz = 1
        end
        // Render the raw bytes column (opcode + up to 2 operand bytes).
        string bytesCol = hex2(mem[pc])
        if sz >= 2 then
            bytesCol = bytesCol + " " + hex2(fetchAt(mem, memLen, pc + 1))
        end
        if sz >= 3 then
            bytesCol = bytesCol + " " + hex2(fetchAt(mem, memLen, pc + 2))
        end
        // Pad bytes column to a fixed width for alignment.
        while string.len(bytesCol) < 8 do
            bytesCol = bytesCol + " "
        end
        string opText = formatOperand(mem, memLen, pc, mode)
        string full = mn
        if opText != "" then
            full = mn + " " + opText
        end
        println("$" + hex4(pc) + ": " + bytesCol + "  " + full)
        pc += sz
    end
    return 0
end

// =========================== file I/O wrappers ===========================

// Load a flat binary image into g_mem at address 0; return byte count.
func loadImage(string path) as int
    Buffer buf = file.readBytes(path)
    int n = buf.len()
    ensureMem()
    int i = 0
    while i < MEM_SIZE do
        g_mem[i] = 0
        i += 1
    end
    i = 0
    while i < n and i < MEM_SIZE do
        g_mem[i] = buf.byteAt(i)
        i += 1
    end
    return n
end

// Write `len` bytes of g_image[0..len) to `path`.
func writeImage(string path, int len) as bool
    Buffer buf = Buffer()
    int i = 0
    while i < len do
        buf.appendByte(g_image[i] & 0xFF)
        i += 1
    end
    return file.writeBytes(path, buf)
end

// =========================== CLI: run ===========================

func cmdRun(string path, int maxCycles) as int
    if not file.exists(path) then
        println("x6502: file not found: " + path)
        return 1
    end
    int n = loadImage(path)
    if n == 0 then
        println("x6502: empty image: " + path)
        return 1
    end
    resetKeepMem()
    println("; image: " + path + " (" + string(n) + " bytes)")
    println("; reset PC=" + hex4(g_PC))
    println("; running up to " + string(maxCycles) + " instructions...")
    run(maxCycles)
    println(";")
    dumpState()
    return 0
end

// =========================== CLI: asm ===========================

func cmdAsm(string srcPath, string outPath) as int
    if not file.exists(srcPath) then
        println("x6502: source not found: " + srcPath)
        return 1
    end
    string src = file.readText(srcPath)
    int len = assemble(src)
    if g_asmError then
        println("x6502: assembly failed: " + g_asmMsg)
        return 1
    end
    if len <= 0 then
        println("x6502: assembly produced no bytes")
        return 1
    end
    bool ok = writeImage(outPath, len)
    if not ok then
        println("x6502: cannot write: " + outPath)
        return 1
    end
    println("; assembled " + string(len) + " bytes -> " + outPath)
    int labels = g_labels.length
    println("; " + string(labels) + " label(s) resolved")
    return 0
end

// =========================== CLI: disasm ===========================

func cmdDisasm(string path) as int
    if not file.exists(path) then
        println("x6502: file not found: " + path)
        return 1
    end
    Buffer buf = file.readBytes(path)
    int n = buf.len()
    if n == 0 then
        println("x6502: empty image: " + path)
        return 1
    end
    array<int> img = makeIntArray(n, 0)
    int i = 0
    while i < n do
        img[i] = buf.byteAt(i)
        i += 1
    end
    println("; disassembly of " + path + " (" + string(n) + " bytes)")
    return disassembleImage(img, n)
end

// =========================== built-in tests ===========================

// Tiny assertion helper that prints PASS / FAIL.
func check(string name, bool ok) as bool
    if ok then
        println("  [PASS] " + name)
    else
        println("  [FAIL] " + name)
    end
    return ok
end

// Reset and load a small program (as an array<int> of bytes) at address 0,
// then run up to `maxCycles` instructions. g_PC starts at 0.
func runProgram(array<int> prog, int maxCycles)
    ensureTable()
    ensureMem()
    int i = 0
    while i < MEM_SIZE do
        g_mem[i] = 0
        i += 1
    end
    i = 0
    while i < prog.length do
        g_mem[i] = prog[i] & 0xFF
        i += 1
    end
    g_A = 0
    g_X = 0
    g_Y = 0
    g_SP = 0xFD
    g_P = FLAG_U | FLAG_I
    g_totalCycles = 0
    g_running = true
    g_PC = 0
    run(maxCycles)
end

// Build a program inline from an array of bytes for the tests.
// (Helper kept for readability; tests pass array literals directly too.)

// T1: LDA immediate + TAX + TAY, verify register transfers + N/Z flags.
func testLoadTransfer() as bool
    println("[T1] LDA # / TAX / TAY / INX")
    // $00: A9 0F   LDA #$0F
    // $02: AA      TAX
    // $03: A8      TAY
    // $04: E8      INX
    // $05: 00      BRK
    array<int> p = array[0xA9, 0x0F, 0xAA, 0xA8, 0xE8, 0x00]
    runProgram(p, 20)
    bool ok = check("A == $0F", g_A == 0x0F)
    ok = check("X == $10 (after INX)", g_X == 0x10) and ok
    ok = check("Y == $0F", g_Y == 0x0F) and ok
    ok = check("Z clear (A nonzero)", getFlag(FLAG_Z) == 0) and ok
    return ok
end

// T2: ADC with and without carry, plus SEC carry-in.
func testAdc() as bool
    println("[T2] ADC + carry")
    // $00: A9 05   LDA #$05
    // $02: 69 03   ADC #$03      ; A = 8, C = 0
    // $04: 38      SEC
    // $05: 69 02   ADC #$02      ; A = 11 (8 + 2 + 1)
    // $07: 00      BRK
    array<int> p = array[0xA9, 0x05, 0x69, 0x03, 0x38, 0x69, 0x02, 0x00]
    runProgram(p, 20)
    bool ok = check("A == 11 (5+3 then 8+2+1)", g_A == 11)
    ok = check("C clear (no overflow)", getFlag(FLAG_C) == 0) and ok
    // Overflow case: 0x7F + 1 -> V set, no carry.
    array<int> p2 = array[0xA9, 0x7F, 0x69, 0x01, 0x00]
    runProgram(p2, 20)
    ok = check("A == $80 (0x7F + 1)", g_A == 0x80) and ok
    ok = check("V set (signed overflow)", getFlag(FLAG_V) == 1) and ok
    // Carry-out case: 0xFF + 1 -> A = 0, C set.
    array<int> p3 = array[0xA9, 0xFF, 0x69, 0x01, 0x00]
    runProgram(p3, 20)
    ok = check("A == 0 (0xFF + 1 wraps)", g_A == 0) and ok
    ok = check("C set (carry out)", getFlag(FLAG_C) == 1) and ok
    ok = check("Z set (result zero)", getFlag(FLAG_Z) == 1) and ok
    return ok
end

// T3: SBC borrow behaviour (C is inverted-borrow).
func testSbc() as bool
    println("[T3] SBC + borrow")
    // $00: 38      SEC           ; C = 1 (no borrow yet)
    // $01: A9 0A   LDA #$0A
    // $03: E9 03   SBC #$03      ; A = 7, C stays 1 (no borrow)
    // $05: 00      BRK
    array<int> p = array[0x38, 0xA9, 0x0A, 0xE9, 0x03, 0x00]
    runProgram(p, 20)
    bool ok = check("A == 7 (10 - 3)", g_A == 7)
    ok = check("C set (no borrow)", getFlag(FLAG_C) == 1) and ok
    // Borrow case: 3 - 5 with C=1 -> A = 0xFE, C cleared.
    array<int> p2 = array[0x38, 0xA9, 0x03, 0xE9, 0x05, 0x00]
    runProgram(p2, 20)
    ok = check("A == $FE (3 - 5 wraps)", g_A == 0xFE) and ok
    ok = check("C clear (borrow)", getFlag(FLAG_C) == 0) and ok
    ok = check("N set (result negative)", getFlag(FLAG_N) == 1) and ok
    return ok
end

// T4: logical AND / ORA / EOR.
func testLogic() as bool
    println("[T4] AND / ORA / EOR")
    // $00: A9 F0   LDA #$F0
    // $02: 29 0F   AND #$0F      ; A = 0
    // $04: 09 55   ORA #$55      ; A = 0x55
    // $06: 49 0F   EOR #$0F      ; A = 0x5A
    // $08: 00      BRK
    array<int> p = array[0xA9, 0xF0, 0x29, 0x0F, 0x09, 0x55, 0x49, 0x0F, 0x00]
    runProgram(p, 20)
    bool ok = check("A == $5A (F0 & 0F | 55 ^ 0F)", g_A == 0x5A)
    return ok
end

// T5: zero-page STA/LDA round trip and memory INC/DEC.
func testMemory() as bool
    println("[T5] STA zp / LDA zp / INC / DEC")
    // $00: A9 42   LDA #$42
    // $02: 85 10   STA $10       ; mem[0x10] = 0x42
    // $04: E6 10   INC $10       ; mem[0x10] = 0x43
    // $06: A5 10   LDA $10       ; A = 0x43
    // $08: C6 10   DEC $10       ; mem[0x10] = 0x42
    // $0A: 00      BRK
    array<int> p = array[0xA9, 0x42, 0x85, 0x10, 0xE6, 0x10, 0xA5, 0x10, 0xC6, 0x10, 0x00]
    runProgram(p, 20)
    bool ok = check("A == $43 (loaded after INC)", g_A == 0x43)
    ok = check("mem[$10] == $42 (after DEC)", g_mem[0x10] == 0x42) and ok
    return ok
end

// T6: branches taken and not taken.
func testBranch() as bool
    println("[T6] BEQ / BNE taken + not taken")
    // $00: A9 00   LDA #$00      ; Z = 1
    // $02: F0 02   BEQ +2        ; taken -> skip next to $06
    // $04: A9 FF   LDA #$FF      ; (skipped)
    // $06: D0 02   BNE +2        ; Z=1 so NOT taken -> fall through to $08
    // $08: 00      BRK
    array<int> p = array[0xA9, 0x00, 0xF0, 0x02, 0xA9, 0xFF, 0xD0, 0x02, 0x00]
    runProgram(p, 20)
    // BEQ taken skips the LDA #$FF, so A stays 0; BNE not taken.
    bool ok = check("A == 0 (BEQ skipped LDA #$FF)", g_A == 0)
    return ok
end

// T7: PHA/PLA stack save+restore, and JSR/RTS call+return balance.
// Uses self-looping JMP terminators (not BRK) so SP is left untouched.
func testStack() as bool
    println("[T7] PHA / PLA / JSR / RTS")
    // Program A: push $7E, clobber A, pull it back; SP must balance.
    // $00: A9 7E   LDA #$7E
    // $02: 48      PHA          ; SP = $FC
    // $03: A9 00   LDA #$00
    // $05: 68      PLA          ; SP = $FD, A = $7E
    // $06: 4C 06 00 JMP $0006   ; spin (terminated by cycle budget)
    array<int> pa = array[0xA9, 0x7E, 0x48, 0xA9, 0x00, 0x68, 0x4C, 0x06, 0x00]
    runProgram(pa, 20)
    bool ok = check("A == $7E (PHA then PLA round trip)", g_A == 0x7E)
    ok = check("SP back to $FD after balanced push/pop", g_SP == 0xFD) and ok
    // Program B: subroutine sets A=$42 and returns to the spin loop.
    // $00: 20 06 00 JSR $0006
    // $03: 4C 03 00 JMP $0003   ; return lands here, spin
    // $06: A9 42   LDA #$42
    // $08: 60      RTS
    array<int> pb = array[0x20, 0x06, 0x00, 0x4C, 0x03, 0x00, 0xA9, 0x42, 0x60]
    runProgram(pb, 20)
    ok = check("A == $42 (set inside subroutine)", g_A == 0x42) and ok
    ok = check("SP back to $FD after JSR/RTS", g_SP == 0xFD) and ok
    return ok
end

// T8: shifts ASL / LSR / ROL / ROR including carry linkage.
func testShifts() as bool
    println("[T8] ASL / LSR / ROL / ROR")
    // $00: 38      SEC           ; C = 1
    // $01: A9 81   LDA #$81
    // $03: 2A      ROL A         ; C<-b7, b0<-oldC => A = (0x81<<1)|1 = 0x03, C=1
    // $04: 4A      LSR A         ; A = 0x01, C = 1
    // $05: 00      BRK
    array<int> p = array[0x38, 0xA9, 0x81, 0x2A, 0x4A, 0x00]
    runProgram(p, 20)
    bool ok = check("A == 1 (after ROL then LSR)", g_A == 0x01)
    ok = check("C set (LSR of 0x03 pushed bit0)", getFlag(FLAG_C) == 1) and ok
    // ASL sets carry from top bit.
    array<int> p2 = array[0xA9, 0xC0, 0x0A, 0x00]
    runProgram(p2, 20)
    ok = check("A == $80 (0xC0 << 1)", g_A == 0x80) and ok
    ok = check("C set (ASL top bit)", getFlag(FLAG_C) == 1) and ok
    return ok
end

// T9: CMP sets flags correctly across < / == / >.
func testCmp() as bool
    println("[T9] CMP flag behaviour")
    // $00: A9 0A   LDA #$0A
    // $02: C9 0A   CMP #$0A      ; equal: C=1, Z=1
    // $04: C9 14   CMP #$20      ; less: C=0, Z=0, N=1
    // $06: 00      BRK
    array<int> p = array[0xA9, 0x0A, 0xC9, 0x0A, 0xC9, 0x20, 0x00]
    runProgram(p, 20)
    // After CMP #$20: A(0x0A) - 0x20 -> negative, no carry.
    bool ok = check("C clear (A < operand)", getFlag(FLAG_C) == 0)
    ok = check("N set (A - operand negative)", getFlag(FLAG_N) == 1) and ok
    ok = check("Z clear (A != operand)", getFlag(FLAG_Z) == 0) and ok
    return ok
end

// T10: indirect indexed (ind),Y addressing.
func testIndirectIndexed() as bool
    println("[T10] LDA ($zp),Y")
    // Set up a pointer at $20/$21 = $1234, then load with Y offset 1.
    // $00: A9 34   LDA #$34
    // $02: 85 20   STA $20
    // $04: A9 12   LDA #$12
    // $06: 85 21   STA $21       ; ($20) = $1234
    // $08: A0 01   LDY #$01
    // $0A: A9 AA   LDA #$AA
    // $0C: 8D 35 12 STA $1235    ; put $AA at the target
    // $0F: A9 00   LDA #$00      ; clear A
    // $11: B1 20   LDA ($20),Y   ; A = mem[$1235] = $AA
    // $13: 00      BRK
    array<int> p = array[
        0xA9, 0x34, 0x85, 0x20, 0xA9, 0x12, 0x85, 0x21,
        0xA0, 0x01, 0xA9, 0xAA, 0x8D, 0x35, 0x12,
        0xA9, 0x00, 0xB1, 0x20, 0x00
    ]
    runProgram(p, 40)
    bool ok = check("A == $AA (loaded via ($20),Y)", g_A == 0xAA)
    return ok
end

// T11: indexed indirect (ind,X) addressing.
func testIndexedIndirect() as bool
    println("[T11] LDA ($zp,X)")
    // Pointer table at $22/$23 = $ABCD. Load via ($20,X) with X=2.
    // $00: A2 02   LDX #$02
    // $02: A9 CD   LDA #$CD
    // $04: 85 22   STA $22
    // $06: A9 AB   LDA #$AB
    // $08: 85 23   STA $23
    // $0A: A1 20   LDA ($20,X)   ; A = mem[$ABCD]
    // $0C: 00      BRK
    // Pre-seed mem[$ABCD] = $77 inside the test by adding a STA first.
    array<int> p = array[
        0xA9, 0x77, 0x8D, 0xCD, 0xAB,
        0xA2, 0x02, 0xA9, 0xCD, 0x85, 0x22, 0xA9, 0xAB, 0x85, 0x23,
        0xA1, 0x20, 0x00
    ]
    runProgram(p, 40)
    bool ok = check("A == $77 (loaded via ($20,X))", g_A == 0x77)
    return ok
end

// T12: indirect JMP honours the page-boundary bug.
func testIndirectJmp() as bool
    println("[T12] JMP ($xxFF) page-boundary bug")
    // Pointer at $30FF = $42, $3100 = $00 (bug: high byte read from $3000).
    // We plant $3000 = $99 so the bug lands us at $9930-ish... keep it simple:
    // plant low=$FF high=$00 normally and check it jumps to $0042.
    // $00: A9 42   LDA #$42
    // $02: 8D FF 30 STA $30FF
    // $05: A9 00   LDA #$00
    // $07: 8D 00 31 STA $3100    ; normal vector high
    // $0A: 6C FF 30 JMP ($30FF)  ; -> $0042
    // ... target $42:
    // $42: A9 55   LDA #$55
    // $44: 00      BRK
    array<int> p = makeIntArray(0x45, 0xEA)  // fill with NOPs
    p[0x00] = 0xA9
    p[0x01] = 0x42
    p[0x02] = 0x8D
    p[0x03] = 0xFF
    p[0x04] = 0x30
    p[0x05] = 0xA9
    p[0x06] = 0x00
    p[0x07] = 0x8D
    p[0x08] = 0x00
    p[0x09] = 0x31
    p[0x0A] = 0x6C
    p[0x0B] = 0xFF
    p[0x0C] = 0x30
    p[0x42] = 0xA9
    p[0x43] = 0x55
    p[0x44] = 0x00
    runProgram(p, 60)
    bool ok = check("A == $55 (jumped via indirect to $0042)", g_A == 0x55)
    return ok
end

// T13: BIT sets N/V from the operand.
func testBit() as bool
    println("[T13] BIT N / V / Z flags")
    // $00: A9 0F   LDA #$0F
    // $02: A9 C2   LDA #$C2      ; overwrite A = $C2... actually we want A&v!=0
    // Use: A = $0F, operand at $10 = $C3. BIT $10 -> Z=0 (0x0F & 0xC3 = 0x03),
    // N = bit7 of operand = 1, V = bit6 of operand = 1.
    // $00: A9 0F   LDA #$0F
    // $02: A9 C3   LDA #$C3      ; seed value
    // $04: 85 10   STA $10
    // $06: A9 0F   LDA #$0F      ; A = $0F
    // $08: 24 10   BIT $10
    // $0A: 00      BRK
    array<int> p = array[0xA9, 0xC3, 0x85, 0x10, 0xA9, 0x0F, 0x24, 0x10, 0x00]
    runProgram(p, 20)
    bool ok = check("N set (operand bit7)", getFlag(FLAG_N) == 1)
    ok = check("V set (operand bit6)", getFlag(FLAG_V) == 1) and ok
    ok = check("Z clear (A & operand != 0)", getFlag(FLAG_Z) == 0) and ok
    return ok
end

// T14: full assembler round-trip. Assemble a small program, run the emitted
// image, and verify the result. Exercises both passes + the disassembler.
func testAssembler() as bool
    println("[T14] asm two-pass + disasm round-trip")
    string src = ""
    src = src + "        LDA #$05        ; A = 5\n"
    src = src + "        STA $10         ; mem[0x10] = 5\n"
    src = src + "loop:   INC $10         ; mem[0x10] += 1\n"
    src = src + "        LDA $10\n"
    src = src + "        CMP #$08        ; until == 8\n"
    src = src + "        BNE loop        ; loop back\n"
    src = src + "        BRK\n"
    int len = assemble(src)
    bool ok = check("assembly succeeds", not g_asmError and len > 0)
    if g_asmError then
        check("assembly error: " + g_asmMsg, false)
        return false
    end
    // The label `loop` is at address 4 (LDA# =2, STA zp =2 precede it).
    ok = check("loop label resolved to $04", ("LOOP" in g_labels) and g_labels["LOOP"] == 4) and ok
    // Copy the assembled image into memory and run.
    ensureMem()
    int i = 0
    while i < MEM_SIZE do
        g_mem[i] = 0
        i += 1
    end
    i = 0
    while i < len do
        g_mem[i] = g_image[i]
        i += 1
    end
    g_A = 0
    g_X = 0
    g_Y = 0
    g_SP = 0xFD
    g_P = FLAG_U | FLAG_I
    g_totalCycles = 0
    g_running = true
    g_PC = 0
    run(200)
    // Loop runs mem[0x10] from 5 -> 6 -> 7 -> 8 then falls through at CMP #$08.
    ok = check("mem[$10] == 8 after loop", g_mem[0x10] == 8) and ok
    // Disassemble the produced image without erroring.
    array<int> img = makeIntArray(len, 0)
    i = 0
    while i < len do
        img[i] = g_image[i]
        i += 1
    end
    int before = g_totalCycles
    disassembleImage(img, len)
    ok = check("disassembler ran over image", true) and ok
    return ok
end

// T15: cycle counting sanity (known instruction costs).
func testCycles() as bool
    println("[T15] cycle counting")
    // LDA imm = 2, NOP = 2, NOP = 2, BRK = 7  -> total 13 cycles.
    // $00: A9 01   LDA #$01
    // $02: EA      NOP
    // $03: EA      NOP
    // $04: 00      BRK
    array<int> p = array[0xA9, 0x01, 0xEA, 0xEA, 0x00]
    runProgram(p, 20)
    bool ok = check("cycles == 13 (LDA2 + NOP2 + NOP2 + BRK7)", g_totalCycles == 13)
    return ok
end

func runAllTests() as int
    ensureTable()
    println("=== x6502 built-in tests ===")
    bool allOk = true
    allOk = testLoadTransfer()    and allOk
    allOk = testAdc()             and allOk
    allOk = testSbc()             and allOk
    allOk = testLogic()           and allOk
    allOk = testMemory()          and allOk
    allOk = testBranch()          and allOk
    allOk = testStack()           and allOk
    allOk = testShifts()          and allOk
    allOk = testCmp()             and allOk
    allOk = testIndirectIndexed() and allOk
    allOk = testIndexedIndirect() and allOk
    allOk = testIndirectJmp()     and allOk
    allOk = testBit()             and allOk
    allOk = testAssembler()       and allOk
    allOk = testCycles()          and allOk
    println("===")
    if allOk then
        println("ALL TESTS PASSED")
        return 0
    end
    println("SOME TESTS FAILED")
    return 1
end

// =========================== CLI ===========================

func looksInt(string s) as bool
    int n = string.len(s)
    if n == 0 then
        return false
    end
    int i = 0
    if string.byteAt(s, 0) == 45 then
        i = 1
        if n == 1 then
            return false
        end
    end
    while i < n do
        int b = string.byteAt(s, i)
        if b < 48 or b > 57 then
            return false
        end
        i += 1
    end
    return true
end

func printUsage()
    println("x6502 - MOS 6502 CPU emulator / assembler / disassembler")
    println("")
    println("usage:")
    println("  x6502 run <file.bin> [cycles]      load a flat image and execute it")
    println("  x6502 asm <file.s> <out.bin>       assemble 6502 source to a binary")
    println("  x6502 disasm <file.bin>            disassemble a binary image")
    println("  x6502 test                         run built-in self tests")
    println("  x6502 -h | --help                  this help")
    println("")
    println("addressing modes accepted by the assembler:")
    println("  #$xx   immediate        $xx        zero page")
    println("  $xx,X   zp,X            $xxxx,X    absolute,X")
    println("  $xx,Y   zp,Y            $xxxx,Y    absolute,Y")
    println("  $xxxx   absolute        ($xxxx)    indirect")
    println("  ($xx,X) (ind,X)         ($xx),Y    (ind),Y")
    println("directives: .org expr  .byte v1,v2  .word v1,v2  .ascii \"text\"")
end

func main(...) as int
    ensureTable()

    if arg.length < 2 then
        printUsage()
        return 1
    end

    string cmd = string(arg[1])

    if cmd == "-h" or cmd == "--help" or cmd == "help" then
        printUsage()
        return 0
    end

    if cmd == "test" then
        return runAllTests()
    end

    if cmd == "run" then
        if arg.length < 3 then
            println("x6502: 'run' needs <file.bin> [cycles]")
            return 1
        end
        string path = string(arg[2])
        int maxCycles = DEFAULT_CYCLES
        if arg.length >= 4 then
            string c = string(arg[3])
            if not looksInt(c) then
                println("x6502: invalid cycle count: " + c)
                return 1
            end
            maxCycles = int(c)
            if maxCycles < 0 then
                maxCycles = 0
            end
        end
        return cmdRun(path, maxCycles)
    end

    if cmd == "asm" then
        if arg.length < 4 then
            println("x6502: 'asm' needs <file.s> <out.bin>")
            return 1
        end
        return cmdAsm(string(arg[2]), string(arg[3]))
    end

    if cmd == "disasm" then
        if arg.length < 3 then
            println("x6502: 'disasm' needs <file.bin>")
            return 1
        end
        return cmdDisasm(string(arg[2]))
    end

    println("x6502: unknown command: " + cmd)
    printUsage()
    return 1
end
