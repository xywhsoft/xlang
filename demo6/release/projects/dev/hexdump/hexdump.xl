// hexdump.xl - hex + ASCII file viewer (hexdump -C / xxd style)
//
// usage:
//   hexdump <file>                 dump first 512 bytes
//   hexdump <file> <bytes>         dump first <bytes> bytes
//   hexdump <file> -s <offset>     start at <offset>
//   hexdump <file> -n <count>      dump <count> bytes (-1 = to EOF)
//   hexdump <file> -s <off> -n <n> combine skip + length
//   hexdump --help | -h            show this help
//
// Output format (matches `hexdump -C`):
//   00000000  23 20 78 6c 61 6e 67 20  44 45 4d 4f 36 0a 0a 23  |# xlang DEMO6..#|
//
// ---------------------------------------------------------------------------
// Implementation / API coverage:
//   * file.readBytes(path)      -> Buffer   (full binary read)
//   * Buffer: len / capacity / byteAt / [] / setByte / []= / append /
//             appendByte / appendBytes / text / data / reserve / clear
//   * File stream (read-only):  open(path,true), pos / size / eof,
//             seek(seekSet/seekCur/seekEnd), readText(size)
//   * File stream (writable):   open(path,false), writeText, setEOF, seek, readText
//
// Buffer/File 是受管理的 native-backed class，可安全作为参数和返回值传递。
// 本例按职责把 Buffer 交给 dumpBytes / verifyStreamReadOnly 读取，不复制数据。
// ---------------------------------------------------------------------------

const int BYTES_PER_LINE = 16
const int DEFAULT_COUNT = 512

// ---- byte -> 2-digit lowercase hex ----
func hexByte(int b) as string
    return int.format(b, "x2")
end

// ---- 95-char printable ASCII table (0x20..0x7e), built once via Buffer ----
// int.format(n,"c") does NOT produce a char (returns the decimal text),
// so we materialize the table with appendByte and index it with charAt.
func buildPrintable() as string
    Buffer t = Buffer()
    int c = 0x20
    while c <= 0x7e do
        t.appendByte(c)
        c += 1
    end
    return t.text()
end

func asciiOf(int b, string printable) as string
    if b >= 0x20 and b <= 0x7e then
        return string.charAt(printable, b - 0x20)
    end
    return "."
end

func looksInt(string s) as bool
    int n = string.len(s)
    if n == 0 then
        return false
    end
    int i = 0
    if string.byteAt(s, 0) == 45 then
        i = 1
        if n == 1 then
            return false
        end
    end
    while i < n do
        int b = string.byteAt(s, i)
        if b < 48 or b > 57 then
            return false
        end
        i += 1
    end
    return true
end

// ---- main dump: 16 bytes/line, hex + ASCII ----
func dumpBytes(Buffer buf, int start, int count, string printable) as int
    int total = buf.len()
    int s = start
    if s < 0 then
        s = 0
    end
    if s > total then
        s = total
    end
    int endAt = total
    if count >= 0 then
        int candidate = s + count
        if candidate < endAt then
            endAt = candidate
        end
    end
    int off = s
    while off < endAt do
        int lineLen = BYTES_PER_LINE
        if off + lineLen > endAt then
            lineLen = endAt - off
        end

        string hexStr = ""
        string asciiStr = ""
        int j = 0
        while j < BYTES_PER_LINE do
            if j == 8 then
                hexStr = hexStr + " "
            end
            if j < lineLen then
                int bv = buf.byteAt(off + j)
                hexStr = hexStr + hexByte(bv) + " "
                asciiStr = asciiStr + asciiOf(bv, printable)
            else
                hexStr = hexStr + "   "
            end
            j += 1
        end

        println(int.format(off, "x8") + "  " + hexStr + " " + "|" + asciiStr + "|")
        off += lineLen
    end
    return off - s
end

// ---- Buffer complete-API self-test on a scratch buffer ----
func bufferSelfTest() as bool
    Buffer b = Buffer()

    // len / capacity of empty buffer
    if b.len() != 0 then
        return false
    end
    int cap0 = b.capacity()

    // append(text) + text()
    b.append("abc")
    if b.len() != 3 then
        return false
    end
    if b.text() != "abc" then
        return false
    end

    // appendByte(val)
    b.appendByte(100)
    if b.len() != 4 then
        return false
    end
    if b.byteAt(3) != 100 then
        return false
    end
    if b.text() != "abcd" then
        return false
    end

    // byteAt / __item__
    if b.byteAt(0) != 97 then
        return false
    end
    if b[1] != 98 then
        return false
    end

    // setByte / __setItem__
    b.setByte(1, 66)
    if b[1] != 66 then
        return false
    end
    b[2] = 90
    if b.byteAt(2) != 90 then
        return false
    end
    if b.text() != "aBZd" then
        return false
    end

    // appendBytes(data, size) - only first `size` bytes of data are appended
    b.appendBytes("XYZW", c_size(2))
    if b.len() != 6 then
        return false
    end
    if b.byteAt(4) != 88 or b.byteAt(5) != 89 then
        return false
    end
    b.setByte(1, 98)
    b.setByte(2, 99)

    // reserve / capacity (capacity must grow to at least the request)
    b.reserve(256)
    if b.capacity() < 256 then
        return false
    end
    if b.capacity() < cap0 then
        return false
    end

    // data() byte view is usable through codec.hexEncodeBytes
    string hex = codec.hexEncodeBytes(b.data(), c_size(b.len()))
    if string.len(hex) != b.len() * 2 then
        return false
    end

    // clear
    b.clear()
    if b.len() != 0 then
        return false
    end
    if b.text() != "" then
        return false
    end

    return true
end

// ---- File stream verification on the user's file (read-only) ----
// Cross-checks seek/pos/size/eof/readText against the buffer loaded by
// file.readBytes. The seek/pos/size mechanics are required to pass.
// readText is only valid for UTF-8 regions: on binary data it legitimately
// throws, so it is exercised best-effort (tried, and byte-compared when it
// succeeds) but never fails the whole check.
func verifyStreamReadOnly(string path, Buffer buf, string printable) as bool
    File f = file.open(path, true)
    int total = buf.len()

    // size must match the full buffer length
    if f.size != total then
        return false
    end

    // seekSet returns the new absolute position; pos tracks the cursor
    if f.seek(0, file.seekSet) != 0 then
        return false
    end
    if f.pos != 0 then
        return false
    end

    // readText(size) on a leading UTF-8 region must match buffer bytes
    int probeN = 16
    if total < probeN then
        probeN = total
    end
    try
        string head = f.readText(probeN)
        int k = 0
        while k < probeN do
            if string.byteAt(head, k) != buf.byteAt(k) then
                return false
            end
            k += 1
        end
        if f.pos != probeN then
            return false
        end
    catch e
    end

    // seek arithmetic: seekEnd then seekCur back/forward
    if f.seek(0, file.seekEnd) != total then
        return false
    end
    if total >= 3 then
        if f.seek(-3, file.seekCur) != total - 3 then
            return false
        end
        if f.seek(2, file.seekCur) != total - 1 then
            return false
        end
        // read last byte -> cursor reaches end -> eof becomes true
        try
            string last = f.readText(1)
            if string.byteLen(last) == 1 then
                if string.byteAt(last, 0) != buf.byteAt(total - 1) then
                    return false
                end
                if not f.eof then
                    return false
                end
            end
        catch e
        end
    end

    return true
end

// ---- File stream verification on a writable scratch file ----
// Exercises writeText / setEOF / seek / readText / size without touching the
// user's input file.
func verifyStreamWritable() as bool
    string tmp = path.join(path.temp(), path.random("hexdump_", ".txt"))
    file.delete(tmp)
    if not file.writeText(tmp, "0123456789ABCDEF") then
        return false
    end

    File f = file.open(tmp, false)
    if f.size != 16 then
        return false
    end

    // seek + setEOF truncates to 4 bytes
    if f.seek(4, file.seekSet) != 4 then
        return false
    end
    if not f.setEOF() then
        return false
    end
    if f.size != 4 then
        return false
    end
    if f.seek(0, file.seekSet) != 0 then
        return false
    end
    if f.readText(-1) != "0123" then
        return false
    end

    // overwrite leading bytes
    if f.seek(0, file.seekSet) != 0 then
        return false
    end
    if f.writeText("XY") != 2 then
        return false
    end
    if f.seek(0, file.seekSet) != 0 then
        return false
    end
    if f.readText(-1) != "XY23" then
        return false
    end

    file.delete(tmp)
    return true
end

func printUsage()
    println("hexdump - hex + ASCII file viewer")
    println("")
    println("usage:")
    println("  hexdump <file>                 dump first 512 bytes")
    println("  hexdump <file> <bytes>         dump first <bytes> bytes")
    println("  hexdump <file> -s <offset>     start at <offset>")
    println("  hexdump <file> -n <count>      dump <count> bytes (-1 = to EOF)")
    println("  hexdump <file> -s <off> -n <n> combine skip + length")
    println("  hexdump --help | -h            show this help")
end

func main(...) as int
    string target = ""
    bool hasFile = false
    int skip = 0
    int count = DEFAULT_COUNT

    int i = 1
    while i < arg.length do
        string a = string(arg[i])
        if a == "--help" or a == "-h" then
            printUsage()
            return 0
        elseif a == "-s" or a == "--skip" then
            if i + 1 >= arg.length then
                println("hexdump: " + a + " requires an offset")
                return 1
            end
            string v = string(arg[i + 1])
            if not looksInt(v) then
                println("hexdump: invalid offset: " + v)
                return 1
            end
            skip = int(v)
            if skip < 0 then
                skip = 0
            end
            i += 2
            continue
        elseif a == "-n" or a == "--length" then
            if i + 1 >= arg.length then
                println("hexdump: " + a + " requires a count")
                return 1
            end
            string v = string(arg[i + 1])
            if not looksInt(v) then
                println("hexdump: invalid count: " + v)
                return 1
            end
            count = int(v)
            i += 2
            continue
        elseif string.startsWith(a, "-") and a != "-" then
            println("hexdump: unknown option: " + a)
            return 1
        else
            if not hasFile then
                target = a
                hasFile = true
            elseif looksInt(a) then
                count = int(a)
            else
                println("hexdump: unexpected argument: " + a)
                return 1
            end
        end
        i += 1
    end

    if not hasFile then
        printUsage()
        return 1
    end

    if not file.exists(target) then
        println("hexdump: file not found: " + target)
        return 1
    end

    // ---- primary path: file.readBytes -> Buffer ----
    Buffer buf = file.readBytes(target)

    string printable = buildPrintable()

    // header: file + region summary
    println("; file: " + target + "  (" + string(buf.len()) + " bytes)")
    if count < 0 then
        println("; region: offset=" + int.format(skip, "x8") + " .. EOF")
    else
        println("; region: offset=" + int.format(skip, "x8") + " length=" + string(count))
    end
    println(";")

    int dumped = dumpBytes(buf, skip, count, printable)
    println(int.format(skip + dumped, "x8"))

    // ---- Buffer complete-API self-test ----
    println(";")
    println("; buffer self-test: " + string(bufferSelfTest()))

    // ---- File stream verification (read-only on user file) ----
    bool ro = false
    try
        ro = verifyStreamReadOnly(target, buf, printable)
    catch e
        ro = false
    end
    println("; file-stream read-only (seek/pos/size/eof/readText): " + string(ro))

    // ---- File stream verification (writable scratch) ----
    bool wr = false
    try
        wr = verifyStreamWritable()
    catch e
        wr = false
    end
    println("; file-stream writable (writeText/setEOF/seek/readText): " + string(wr))

    if not ro or not wr then
        return 2
    end
    return 0
end
