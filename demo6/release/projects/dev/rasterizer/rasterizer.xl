// rasterizer - 软件三角形光栅化器（Software Triangle Rasterizer）
//
// 完整 3D 渲染管线，验证 xlang 的：
//   * float 密集运算（每像素重心坐标 / 深度插值 / 着色）
//   * array<float> 大循环（320x240=76800 像素的 z-buffer / framebuffer 读写）
//   * 4x4 矩阵运算（model/view/projection/viewport 变换链）
//   * class 运算符协议（Vec3 全套 __add__/__sub__/__mul__/__neg__/__cross__）
//
// 管线：
//   顶点(模型空间)
//     -> model 矩阵  -> 世界空间
//     -> view  矩阵  -> 观察空间
//     -> proj  矩阵  -> 裁剪空间 (含 w)
//     -> 透视除法     -> NDC ([-1,1]^3)
//     -> 视口变换     -> 屏幕坐标 (px,py) + ndc.z
//     -> 重心坐标光栅化 + Z-buffer 深度测试 + flat shading
//     -> PPM 图像
//
// 用法：
//   rasterizer                                  打印用法
//   rasterizer render [w] [h] [out] [scene]     渲染场景到 PPM
//                                                w=宽 h=高 out=输出 scene=0(cube) 1(octa) 2(both)
//                                                默认 320 240 out.ppm 0
//   rasterizer test                             自检（矩阵/投影/光栅化正确性）
//   rasterizer bench [w] [h]                    性能测试
//                                                默认 320 240
//
// 验证：
//   cd /d D:\GIT\x-lang\demo6\release
//   xl run projects\dev\rasterizer\rasterizer.xl render
//   xl build projects\dev\rasterizer\rasterizer.xl -o projects\dev\rasterizer\rasterizer.exe
//
// PPM 格式：ASCII (P3)，可用 GIMP / ImageMagick / 在线查看器打开。

// ========================================================================
// 全局常量
// ========================================================================
float PI = 3.14159265358979323846
float DEPTH_INF = 1.0e30

// ========================================================================
// 辅助函数
// ========================================================================
func degToRad(float deg) as float
    return deg * PI / 180.0
end

func clampF(float v, float lo, float hi) as float
    return math.clamp(v, lo, hi)
end

// 浮点绝对值统一走标准库。
func absF(float v) as float
    return math.abs(v)
end

func minF(float a, float b) as float
    if a < b then
        return a
    end
    return b
end

func maxF(float a, float b) as float
    if a > b then
        return a
    end
    return b
end

func minI(int a, int b) as int
    if a < b then
        return a
    end
    return b
end

func maxI(int a, int b) as int
    if a > b then
        return a
    end
    return b
end

// ========================================================================
// Vec3：三维向量，完整运算符协议（class 运算符压测点）
// ========================================================================
class Vec3
    derive value
    float x = 0.0
    float y = 0.0
    float z = 0.0

    create(float x, float y, float z)
        self.x = x
        self.y = y
        self.z = z
    end

    func __add__(Vec3 o) as Vec3
        Vec3 r = Vec3(self.x + o.x, self.y + o.y, self.z + o.z)
        return r
    end

    func __sub__(Vec3 o) as Vec3
        Vec3 r = Vec3(self.x - o.x, self.y - o.y, self.z - o.z)
        return r
    end

    func __neg__() as Vec3
        Vec3 r = Vec3(0.0 - self.x, 0.0 - self.y, 0.0 - self.z)
        return r
    end

    func __mul__(float s) as Vec3
        Vec3 r = Vec3(self.x * s, self.y * s, self.z * s)
        return r
    end

    func __div__(float s) as Vec3
        Vec3 r = Vec3(self.x / s, self.y / s, self.z / s)
        return r
    end

    func dot(Vec3 o) as float
        return self.x * o.x + self.y * o.y + self.z * o.z
    end

    func cross(Vec3 o) as Vec3
        Vec3 r = Vec3(
            self.y * o.z - self.z * o.y,
            self.z * o.x - self.x * o.z,
            self.x * o.y - self.y * o.x
        )
        return r
    end

    func lengthSquared() as float
        return self.x * self.x + self.y * self.y + self.z * self.z
    end

    func length() as float
        return math.sqrt(self.lengthSquared())
    end

    func normalize() as Vec3
        float len = self.length()
        if len <= 0.0 then
            Vec3 z = Vec3(0.0, 0.0, 0.0)
            return z
        end
        Vec3 r = self * (1.0 / len)
        return r
    end
end

// ========================================================================
// Mat4：4x4 矩阵，内部用 array<float>（16 元素，行主序）。
//   p' = M * p（p 为列向量）：
//     x' = m[0]*x + m[1]*y + m[2]*z + m[3]
//     y' = m[4]*x + m[5]*y + m[6]*z + m[7]
//     z' = m[8]*x + m[9]*y + m[10]*z + m[11]
//     w' = m[12]*x + m[13]*y + m[14]*z + m[15]
//
// 重要：所有对 array<float> 的读写都在 self.m（class 字段）
//   或全局函数读取参数 Mat4 的 m 字段上进行——这两种路径经实战验证正常。
//   绝不让 class 方法接收裸 array<float> 形参。
// ========================================================================
class Mat4
    derive value
    array<float> m = array[]

    create()
        int i = 0
        while i < 16 do
            self.m.append(0.0)
            i = i + 1
        end
    end

    func setCell(int row, int col, float val)
        int p = row * 4 + col
        self.m[p] = val
    end

    func at(int row, int col) as float
        int p = row * 4 + col
        return self.m[p]
    end

    // 返回单位矩阵的副本（用于 builder 起点）
    func identity() as Mat4
        Mat4 r = Mat4()
        r.m[0] = 1.0
        r.m[5] = 1.0
        r.m[10] = 1.0
        r.m[15] = 1.0
        return r
    end

    // self * other（矩阵乘法）
    func mul(Mat4 other) as Mat4
        Mat4 result = Mat4()
        int r = 0
        while r < 4 do
            int c = 0
            while c < 4 do
                float sum = 0.0
                int k = 0
                while k < 4 do
                    float a = self.m[r * 4 + k]
                    float b = other.m[k * 4 + c]
                    sum = sum + a * b
                    k = k + 1
                end
                result.m[r * 4 + c] = sum
                c = c + 1
            end
            r = r + 1
        end
        return result
    end

    // 变换一个点（w=1），返回 (x, y, z, w) 四元组（用于后续透视除法）
    func transformPoint(Vec3 p) as (float, float, float, float)
        float x = self.m[0] * p.x + self.m[1] * p.y + self.m[2] * p.z + self.m[3]
        float y = self.m[4] * p.x + self.m[5] * p.y + self.m[6] * p.z + self.m[7]
        float z = self.m[8] * p.x + self.m[9] * p.y + self.m[10] * p.z + self.m[11]
        float w = self.m[12] * p.x + self.m[13] * p.y + self.m[14] * p.z + self.m[15]
        return x, y, z, w
    end

    // 变换一个方向（w=0，忽略平移）
    func transformDir(Vec3 d) as Vec3
        float x = self.m[0] * d.x + self.m[1] * d.y + self.m[2] * d.z
        float y = self.m[4] * d.x + self.m[5] * d.y + self.m[6] * d.z
        float z = self.m[8] * d.x + self.m[9] * d.y + self.m[10] * d.z
        Vec3 r = Vec3(x, y, z)
        return r
    end
end

// ========================================================================
// 矩阵构造器（全局函数，返回 Mat4 实例）
//   注意：Mat4 没有 virtual 方法，从函数 return 安全。
// ========================================================================
func matIdentity() as Mat4
    Mat4 r = Mat4()
    r.m[0] = 1.0
    r.m[5] = 1.0
    r.m[10] = 1.0
    r.m[15] = 1.0
    return r
end

func matTranslate(float tx, float ty, float tz) as Mat4
    Mat4 r = matIdentity()
    r.m[3] = tx
    r.m[7] = ty
    r.m[11] = tz
    return r
end

func matScale(float sx, float sy, float sz) as Mat4
    Mat4 r = matIdentity()
    r.m[0] = sx
    r.m[5] = sy
    r.m[10] = sz
    return r
end

func matRotateX(float rad) as Mat4
    float c = math.cos(rad)
    float s = math.sin(rad)
    Mat4 r = matIdentity()
    r.m[5] = c
    r.m[6] = 0.0 - s
    r.m[9] = s
    r.m[10] = c
    return r
end

func matRotateY(float rad) as Mat4
    float c = math.cos(rad)
    float s = math.sin(rad)
    Mat4 r = matIdentity()
    r.m[0] = c
    r.m[2] = s
    r.m[8] = 0.0 - s
    r.m[10] = c
    return r
end

func matRotateZ(float rad) as Mat4
    float c = math.cos(rad)
    float s = math.sin(rad)
    Mat4 r = matIdentity()
    r.m[0] = c
    r.m[1] = 0.0 - s
    r.m[4] = s
    r.m[5] = c
    return r
end

// 透视投影矩阵（OpenGL 风格，fovy 为竖直视野角度，单位度）
func matPerspective(float fovyDeg, float aspect, float zNear, float zFar) as Mat4
    float f = 1.0 / math.tan(degToRad(fovyDeg) * 0.5)
    Mat4 r = Mat4()
    r.m[0] = f / aspect
    r.m[5] = f
    r.m[10] = (zFar + zNear) / (zNear - zFar)
    r.m[11] = (2.0 * zFar * zNear) / (zNear - zFar)
    r.m[14] = -1.0
    return r
end

// LookAt 视图矩阵（eye 看向 target，up 为向上方向）
func matLookAt(Vec3 eye, Vec3 target, Vec3 up) as Mat4
    Vec3 fRaw = eye - target
    Vec3 f = fRaw.normalize()
    Vec3 sRaw = up.cross(f)
    Vec3 s = sRaw.normalize()
    Vec3 u = f.cross(s)
    Mat4 r = matIdentity()
    r.m[0] = s.x
    r.m[1] = s.y
    r.m[2] = s.z
    r.m[3] = 0.0 - s.dot(eye)
    r.m[4] = u.x
    r.m[5] = u.y
    r.m[6] = u.z
    r.m[7] = 0.0 - u.dot(eye)
    r.m[8] = f.x
    r.m[9] = f.y
    r.m[10] = f.z
    r.m[11] = 0.0 - f.dot(eye)
    return r
end

// ========================================================================
// Mesh：三角形网格
//   verts : array<float>  顶点位置，每 3 个一组 (x,y,z)
//   tris  : array<int>    三角形索引，每 3 个一组 (i0,i1,i2)
//   colors: array<float>  每个三角形的基色 (r,g,b)，与 tris 同序
//
//   顶点和三角形采用扁平 SoA 存储，便于连续遍历并直接写入光栅化热路径。
// ========================================================================
class Mesh
    derive value
    array<float> verts = array[]
    array<int> tris = array[]
    array<float> colors = array[]

    func addVert(float x, float y, float z)
        self.verts.append(x)
        self.verts.append(y)
        self.verts.append(z)
    end

    func addTri(int i0, int i1, int i2, float r, float g, float b)
        self.tris.append(i0)
        self.tris.append(i1)
        self.tris.append(i2)
        self.colors.append(r)
        self.colors.append(g)
        self.colors.append(b)
    end

    func triCount() as int
        int n = self.tris.length
        return n / 3
    end

    func vertCount() as int
        int n = self.verts.length
        return n / 3
    end

    // 读取第 i 个顶点位置
    func getVert(int i) as Vec3
        int p = i * 3
        Vec3 v = Vec3(self.verts[p], self.verts[p + 1], self.verts[p + 2])
        return v
    end
end

// ========================================================================
// 网格构造器
// ========================================================================

// 立方体（8 顶点 12 三角形），边长 2，中心在原点
func buildCube() as Mesh
    Mesh m = Mesh()
    m.addVert(-1.0, -1.0, -1.0)  // 0
    m.addVert( 1.0, -1.0, -1.0)  // 1
    m.addVert( 1.0,  1.0, -1.0)  // 2
    m.addVert(-1.0,  1.0, -1.0)  // 3
    m.addVert(-1.0, -1.0,  1.0)  // 4
    m.addVert( 1.0, -1.0,  1.0)  // 5
    m.addVert( 1.0,  1.0,  1.0)  // 6
    m.addVert(-1.0,  1.0,  1.0)  // 7

    // 每面一种基色（flat shading 下同面同色）
    float rR = 0.85
    float rG = 0.25
    float rB = 0.25
    float gR = 0.25
    float gG = 0.75
    float gB = 0.30
    float bR = 0.30
    float bG = 0.45
    float bB = 0.90
    float yR = 0.95
    float yG = 0.80
    float yB = 0.25
    float cR = 0.85
    float cG = 0.55
    float cB = 0.85
    float wR = 0.75
    float wG = 0.75
    float wB = 0.78

    // front (+z)  红
    m.addTri(4, 5, 6, rR, rG, rB)
    m.addTri(4, 6, 7, rR, rG, rB)
    // back (-z)   青
    m.addTri(1, 0, 3, cR, cG, cB)
    m.addTri(1, 3, 2, cR, cG, cB)
    // left (-x)   绿
    m.addTri(0, 4, 7, gR, gG, gB)
    m.addTri(0, 7, 3, gR, gG, gB)
    // right (+x)  蓝
    m.addTri(5, 1, 2, bR, bG, bB)
    m.addTri(5, 2, 6, bR, bG, bB)
    // bottom (-y) 黄
    m.addTri(0, 1, 5, yR, yG, yB)
    m.addTri(0, 5, 4, yR, yG, yB)
    // top (+y)    白
    m.addTri(7, 6, 2, wR, wG, wB)
    m.addTri(7, 2, 3, wR, wG, wB)
    return m
end

// 八面体（6 顶点 8 三角形），半径 1，中心在原点
func buildOctahedron() as Mesh
    Mesh m = Mesh()
    m.addVert( 1.0,  0.0,  0.0)  // 0 +x
    m.addVert( 0.0,  0.0,  1.0)  // 1 +z
    m.addVert(-1.0,  0.0,  0.0)  // 2 -x
    m.addVert( 0.0,  0.0, -1.0)  // 3 -z
    m.addVert( 0.0,  1.0,  0.0)  // 4 +y (top)
    m.addVert( 0.0, -1.0,  0.0)  // 5 -y (bottom)

    // 上半球 4 面（交替色）
    m.addTri(0, 1, 4, 0.95, 0.45, 0.30)
    m.addTri(1, 2, 4, 0.95, 0.75, 0.25)
    m.addTri(2, 3, 4, 0.40, 0.80, 0.45)
    m.addTri(3, 0, 4, 0.30, 0.55, 0.95)
    // 下半球 4 面
    m.addTri(1, 0, 5, 0.85, 0.40, 0.70)
    m.addTri(2, 1, 5, 0.55, 0.60, 0.95)
    m.addTri(3, 2, 5, 0.45, 0.85, 0.85)
    m.addTri(0, 3, 5, 0.90, 0.65, 0.30)
    return m
end

// 拼接两个 Mesh（用于「both」场景）
func mergeMesh(Mesh a, Mesh b) as Mesh
    Mesh outputValue = Mesh()
    int av = a.vertCount()
    int i = 0
    while i < a.verts.length do
        outputValue.verts.append(a.verts[i])
        i = i + 1
    end
    i = 0
    while i < b.verts.length do
        outputValue.verts.append(b.verts[i])
        i = i + 1
    end
    i = 0
    while i < a.tris.length do
        outputValue.tris.append(a.tris[i])
        i = i + 1
    end
    i = 0
    while i < b.tris.length do
        outputValue.tris.append(b.tris[i] + av)
        i = i + 1
    end
    i = 0
    while i < a.colors.length do
        outputValue.colors.append(a.colors[i])
        i = i + 1
    end
    i = 0
    while i < b.colors.length do
        outputValue.colors.append(b.colors[i])
        i = i + 1
    end
    return outputValue
end

// ========================================================================
// 渲染目标：framebuffer + z-buffer
//   framebuffer : array<int>  每 3 个一组 (r,g,b)，范围 [0,255]
//   zbuffer     : array<float> 每像素 NDC 深度，初始 DEPTH_INF
// ========================================================================
class RenderTarget
    int width = 0
    int height = 0
    array<int> fb = array[]
    array<float> zb = array[]

    create(int width, int height)
        self.width = width
        self.height = height
        int total = width * height
        int i = 0
        while i < total * 3 do
            self.fb.append(0)
            i = i + 1
        end
        i = 0
        while i < total do
            self.zb.append(DEPTH_INF)
            i = i + 1
        end
    end

    // 清屏到指定背景色
    func clear(int r, int g, int b)
        int total = self.width * self.height
        int i = 0
        while i < total do
            self.fb[i * 3] = r
            self.fb[i * 3 + 1] = g
            self.fb[i * 3 + 2] = b
            self.zb[i] = DEPTH_INF
            i = i + 1
        end
    end
end

// ========================================================================
// 光栅化核心
//
// 对 mesh 的每个三角形：
//   1. 三个顶点经 mvp 变换到裁剪空间
//   2. 透视除法到 NDC
//   3. 视口变换到屏幕坐标 (sx, sy)，保留 ndc.z 作深度
//   4. 计算屏幕空间三角形包围盒（裁剪到屏幕内）
//   5. 逐像素重心坐标测试 + Z-buffer 深度测试 + flat shading 写入 framebuffer
//
// 输入：
//   mesh      : 待渲染网格
//   mvp       : model * view * projection 组合矩阵
//   modelMat  : model 矩阵（用于世界空间法线计算，flat shading）
//   rt        : 渲染目标（fb + zb）
//   lightDir  : 光照方向（世界空间，指向光源，需归一化）
// ========================================================================
func rasterizeMesh(Mesh mesh, Mat4 mvp, Mat4 modelMat, RenderTarget rt, Vec3 lightDir)
    int width = rt.width
    int height = rt.height
    int triCount = mesh.triCount()
    int t = 0
    while t < triCount do
        int base = t * 3
        int i0 = mesh.tris[base]
        int i1 = mesh.tris[base + 1]
        int i2 = mesh.tris[base + 2]

        Vec3 w0 = mesh.getVert(i0)
        Vec3 w1 = mesh.getVert(i1)
        Vec3 w2 = mesh.getVert(i2)

        // 世界空间法线（flat shading）：用 model 矩阵变换方向
        Vec3 edge1 = w1 - w0
        Vec3 edge2 = w2 - w0
        Vec3 localN = edge1.cross(edge2)
        Vec3 worldNRaw = modelMat.transformDir(localN)
        Vec3 worldN = worldNRaw.normalize()

        // 光照强度：ambient + diffuse，用 abs 兼容双面（不依赖绕序）
        float diff = worldN.dot(lightDir)
        float ndl = absF(diff)
        float intensity = 0.20 + 0.80 * ndl
        if intensity > 1.0 then
            intensity = 1.0
        end

        // 基色
        float baseR = mesh.colors[base]
        float baseG = mesh.colors[base + 1]
        float baseB = mesh.colors[base + 2]
        int cr = int(clampF(baseR * intensity, 0.0, 1.0) * 255.0)
        int cg = int(clampF(baseG * intensity, 0.0, 1.0) * 255.0)
        int cb = int(clampF(baseB * intensity, 0.0, 1.0) * 255.0)

        // 裁剪空间坐标
        float cx0
        float cy0
        float cz0
        float cw0
        cx0, cy0, cz0, cw0 = mvp.transformPoint(w0)
        float cx1
        float cy1
        float cz1
        float cw1
        cx1, cy1, cz1, cw1 = mvp.transformPoint(w1)
        float cx2
        float cy2
        float cz2
        float cw2
        cx2, cy2, cz2, cw2 = mvp.transformPoint(w2)

        // 近裁剪面剔除：任一顶点在相机后方（w<=0）直接跳过该三角形
        if cw0 <= 0.0001 then
            t = t + 1
            continue
        end
        if cw1 <= 0.0001 then
            t = t + 1
            continue
        end
        if cw2 <= 0.0001 then
            t = t + 1
            continue
        end

        // 透视除法 -> NDC
        float invW0 = 1.0 / cw0
        float invW1 = 1.0 / cw1
        float invW2 = 1.0 / cw2
        float nx0 = cx0 * invW0
        float ny0 = cy0 * invW0
        float nz0 = cz0 * invW0
        float nx1 = cx1 * invW1
        float ny1 = cy1 * invW1
        float nz1 = cz1 * invW1
        float nx2 = cx2 * invW2
        float ny2 = cy2 * invW2
        float nz2 = cz2 * invW2

        // 视口变换 -> 屏幕坐标（Y 翻转，屏幕 Y 向下）
        float sx0f = (nx0 + 1.0) * 0.5 * float(width)
        float sy0f = (1.0 - ny0) * 0.5 * float(height)
        float sx1f = (nx1 + 1.0) * 0.5 * float(width)
        float sy1f = (1.0 - ny1) * 0.5 * float(height)
        float sx2f = (nx2 + 1.0) * 0.5 * float(width)
        float sy2f = (1.0 - ny2) * 0.5 * float(height)

        // 屏幕空间包围盒（裁剪到屏幕边界）
        float minXf = minF(sx0f, minF(sx1f, sx2f))
        float maxXf = maxF(sx0f, maxF(sx1f, sx2f))
        float minYf = minF(sy0f, minF(sy1f, sy2f))
        float maxYf = maxF(sy0f, maxF(sy1f, sy2f))
        int minX = maxI(0, int(minXf))
        int maxX = minI(width - 1, int(maxXf))
        int minY = maxI(0, int(minYf))
        int maxY = minI(height - 1, int(maxYf))

        if minX > maxX or minY > maxY then
            t = t + 1
            continue
        end

        // 三角形面积（屏幕空间，带符号）
        float area = (sx1f - sx0f) * (sy2f - sy0f) - (sy1f - sy0f) * (sx2f - sx0f)
        float absArea = absF(area)
        if absArea < 0.0001 then
            t = t + 1
            continue
        end
        float invArea = 1.0 / area

        // 逐像素光栅化（重心坐标）
        int py = minY
        while py <= maxY do
            float pyc = float(py) + 0.5
            int px = minX
            while px <= maxX do
                float pxc = float(px) + 0.5
                // 重心坐标（边函数）
                float w0c = ((sx1f - pxc) * (sy2f - pyc) - (sy1f - pyc) * (sx2f - pxc)) * invArea
                float w1c = ((sx2f - pxc) * (sy0f - pyc) - (sy2f - pyc) * (sx0f - pxc)) * invArea
                float w2c = 1.0 - w0c - w1c
                // 三角形内部测试（含边界，允许微小容差避免接缝）
                if w0c >= -0.0001 and w1c >= -0.0001 and w2c >= -0.0001 then
                    // 深度插值（NDC z 线性插值，对透视正确性足够本场景）
                    float z = w0c * nz0 + w1c * nz1 + w2c * nz2
                    int zidx = py * width + px
                    if z < rt.zb[zidx] then
                        rt.zb[zidx] = z
                        int fbidx = zidx * 3
                        rt.fb[fbidx] = cr
                        rt.fb[fbidx + 1] = cg
                        rt.fb[fbidx + 2] = cb
                    end
                end
                px = px + 1
            end
            py = py + 1
        end
        t = t + 1
    end
end

// ========================================================================
// PPM 输出
// ========================================================================
func writePpm(string path, RenderTarget rt)
    array<string> lines = array[]
    lines.append("P3")
    lines.append(string(rt.width) + " " + string(rt.height))
    lines.append("255")
    int total = rt.width * rt.height
    int i = 0
    while i < total do
        string rowLine = ""
        int x = 0
        while x < rt.width do
            int idx = (i + x) * 3
            int r = rt.fb[idx]
            int g = rt.fb[idx + 1]
            int b = rt.fb[idx + 2]
            if x > 0 then
                rowLine = rowLine + " "
            end
            rowLine = rowLine + string(r) + " " + string(g) + " " + string(b)
            x = x + 1
        end
        lines.append(rowLine)
        i = i + rt.width
    end
    string body = string.join(lines, "\n")
    body = body + "\n"
    bool ok = file.writeText(path, body)
    if not ok then
        throw "failed to write PPM file: " + path
    end
end

// 统计 framebuffer 中非背景像素数（用于自检）
func countNonBg(RenderTarget rt, int bgR, int bgG, int bgB) as int
    int total = rt.width * rt.height
    int count = 0
    int i = 0
    while i < total do
        int r = rt.fb[i * 3]
        int g = rt.fb[i * 3 + 1]
        int b = rt.fb[i * 3 + 2]
        if r != bgR or g != bgG or b != bgB then
            count = count + 1
        end
        i = i + 1
    end
    return count
end

// ========================================================================
// 参数解析
// ========================================================================
func parseArgInt(string s, int defValue) as int
    s = string.trim(s)
    if string.len(s) == 0 then
        return defValue
    end
    int start = 0
    string first = string.slice(s, 0, 1)
    if first == "-" or first == "+" then
        start = 1
        if string.len(s) == 1 then
            return defValue
        end
    end
    int i = start
    while i < string.len(s) do
        string ch = string.slice(s, i, 1)
        if string.indexOf("0123456789", ch) < 0 then
            return defValue
        end
        i = i + 1
    end
    return int(s)
end

// ========================================================================
// 渲染入口
// ========================================================================

// 构建场景 mesh（按 sceneChoice 选择，并应用 model 变换）
func buildScene(int sceneChoice) as (Mesh, Mat4)
    Mesh mesh
    if sceneChoice == 1 then
        mesh = buildOctahedron()
    elseif sceneChoice == 2 then
        Mesh cube = buildCube()
        Mesh octa = buildOctahedron()
        mesh = mergeMesh(cube, octa)
    else
        mesh = buildCube()
    end

    // model 变换：旋转 + 缩放 + 平移
    Mat4 rotY = matRotateY(degToRad(25.0))
    Mat4 rotX = matRotateX(degToRad(-15.0))
    Mat4 scl = matScale(1.0, 1.0, 1.0)
    Mat4 tr
    if sceneChoice == 2 then
        // both 场景：缩小并放在偏左
        scl = matScale(0.75, 0.75, 0.75)
        tr = matTranslate(-1.6, 0.0, 0.0)
    else
        tr = matTranslate(0.0, 0.0, 0.0)
    end
    Mat4 step1 = tr.mul(scl)
    Mat4 step2 = step1.mul(rotX)
    Mat4 model = step2.mul(rotY)
    return mesh, model
end

func cmdRender(int width, int height, string outPath, int sceneChoice) as int
    if width < 2 or height < 2 then
        println("error: width and height must be >= 2")
        return 1
    end

    Mesh mesh
    Mat4 model
    mesh, model = buildScene(sceneChoice)

    // 视图矩阵
    Vec3 eye = Vec3(0.0, 1.8, 5.5)
    Vec3 target = Vec3(0.0, 0.0, 0.0)
    Vec3 up = Vec3(0.0, 1.0, 0.0)
    Mat4 view = matLookAt(eye, target, up)

    // 投影矩阵
    float aspect = float(width) / float(height)
    Mat4 proj = matPerspective(45.0, aspect, 0.1, 100.0)

    // mvp = proj * view * model
    Mat4 vp = proj.mul(view)
    Mat4 mvp = vp.mul(model)

    // 光照方向（世界空间，指向光源）
    Vec3 ldirRaw = Vec3(0.5, 0.8, 0.6)
    Vec3 lightDir = ldirRaw.normalize()

    RenderTarget rt = RenderTarget(width, height)
    // 深蓝渐变背景（用纯色简化）
    rt.clear(15, 20, 40)

    println("[render] scene=" + string(sceneChoice) + " tris=" + string(mesh.triCount()) + " verts=" + string(mesh.vertCount()))
    println("[render] " + string(width) + "x" + string(height) + " -> " + outPath)

    float t0 = time.timer()
    rasterizeMesh(mesh, mvp, model, rt, lightDir)
    float t1 = time.timer()

    writePpm(outPath, rt)

    float elapsed = t1 - t0
    int pixels = width * height
    float pps = 0.0
    if elapsed > 0.0 then
        pps = float(pixels) / elapsed
    end
    int drawn = countNonBg(rt, 15, 20, 40)

    println("[render] done in " + float.format(elapsed, ".3") + "s")
    println("[render] " + int.format(pixels, ",") + " pixels, " + int.format(int(pps), ",") + " pix/sec")
    println("[render] " + int.format(drawn, ",") + " shaded pixels (" + float.format(float(drawn) / float(pixels) * 100.0, ".1") + "% coverage)")
    println("[render] wrote " + outPath)
    return 0
end

func cmdBench(int width, int height) as int
    if width < 2 or height < 2 then
        width = 320
        height = 240
    end
    println("rasterizer benchmark")
    println("================================================================")
    println("config: " + string(width) + "x" + string(height) + " scene=both(tris=20)")
    println("================================================================")

    // 两轮：预热 + 计时
    int which = 0
    while which < 2 do
        Mesh mesh
        Mat4 model
        mesh, model = buildScene(2)
        Vec3 eye = Vec3(0.0, 1.8, 5.5)
        Vec3 targetV = Vec3(0.0, 0.0, 0.0)
        Vec3 upV = Vec3(0.0, 1.0, 0.0)
        Mat4 view = matLookAt(eye, targetV, upV)
        float aspect = float(width) / float(height)
        Mat4 proj = matPerspective(45.0, aspect, 0.1, 100.0)
        Mat4 vp = proj.mul(view)
        Mat4 mvp = vp.mul(model)
        Vec3 ldirRaw = Vec3(0.5, 0.8, 0.6)
        Vec3 lightDir = ldirRaw.normalize()

        RenderTarget rt = RenderTarget(width, height)
        rt.clear(15, 20, 40)

        string label = "run #" + string(which + 1)
        if which == 0 then
            label = label + " (warmup)"
        end
        float t0 = time.timer()
        rasterizeMesh(mesh, mvp, model, rt, lightDir)
        float t1 = time.timer()
        float elapsed = t1 - t0
        int pixels = width * height
        float pps = 0.0
        if elapsed > 0.0 then
            pps = float(pixels) / elapsed
        end
        float usPerPix = 0.0
        if pixels > 0 then
            usPerPix = elapsed * 1000000.0 / float(pixels)
        end
        string line = "  "
        line = line + string.padRight(label, 18)
        line = line + "time=" + float.format(elapsed, ".3") + "s"
        line = line + "  " + int.format(pixels, ",") + " px"
        line = line + "  " + float.format(usPerPix, ".3") + " us/px"
        line = line + "  " + int.format(int(pps), ",") + " pix/sec"
        println(line)

        if which == 0 then
            string outPath = "bench_" + string(width) + "x" + string(height) + ".ppm"
            writePpm(outPath, rt)
            println("  wrote " + outPath)
        end
        which = which + 1
    end
    println("================================================================")
    return 0
end

// ========================================================================
// 自检：矩阵 / 投影 / 光栅化正确性
// ========================================================================

func approxEq(float a, float b, float eps) as bool
    float d = a - b
    if d < 0.0 then
        d = 0.0 - d
    end
    return d < eps
end

// 简单测试框架（无依赖，自包含）
int g_pass = 0
int g_fail = 0

func check(bool cond, string name)
    if cond then
        g_pass = g_pass + 1
        println("  [PASS] " + name)
    else
        g_fail = g_fail + 1
        println("  [FAIL] " + name)
    end
end

func cmdTest() as int
    println("rasterizer self-test")
    println("================================================================")

    // ---- 1. Vec3 运算符 ----
    println("[1] Vec3 operators")
    Vec3 a = Vec3(1.0, 2.0, 3.0)
    Vec3 b = Vec3(4.0, 5.0, 6.0)
    Vec3 sum = a + b
    check(approxEq(sum.x, 5.0, 1e-5) and approxEq(sum.y, 7.0, 1e-5) and approxEq(sum.z, 9.0, 1e-5), "Vec3 __add__")
    Vec3 diff = b - a
    check(approxEq(diff.x, 3.0, 1e-5) and approxEq(diff.y, 3.0, 1e-5) and approxEq(diff.z, 3.0, 1e-5), "Vec3 __sub__")
    Vec3 scaled = a * 2.0
    check(approxEq(scaled.x, 2.0, 1e-5) and approxEq(scaled.y, 4.0, 1e-5) and approxEq(scaled.z, 6.0, 1e-5), "Vec3 __mul__ scalar")
    check(approxEq(a.dot(b), 32.0, 1e-5), "Vec3 dot (1*4+2*5+3*6=32)")
    Vec3 cr = a.cross(b)
    // (1,2,3)x(4,5,6) = (2*6-3*5, 3*4-1*6, 1*5-2*4) = (-3, 6, -3)
    check(approxEq(cr.x, -3.0, 1e-5) and approxEq(cr.y, 6.0, 1e-5) and approxEq(cr.z, -3.0, 1e-5), "Vec3 cross")
    Vec3 nrmSrc = Vec3(0.0, 0.0, 5.0)
    Vec3 nrm = nrmSrc.normalize()
    check(approxEq(nrm.z, 1.0, 1e-5), "Vec3 normalize")

    // ---- 2. Mat4 ----
    println("[2] Mat4 matrix ops")
    Mat4 ident = matIdentity()
    Mat4 produced = ident.mul(ident)
    bool identOk = true
    int i = 0
    while i < 16 do
        float expect = 0.0
        if i == 0 or i == 5 or i == 10 or i == 15 then
            expect = 1.0
        end
        if approxEq(produced.m[i], expect, 1e-5) == false then
            identOk = false
        end
        i = i + 1
    end
    check(identOk, "identity * identity == identity")

    Mat4 t1 = matTranslate(3.0, 4.0, 5.0)
    Vec3 origin = Vec3(0.0, 0.0, 0.0)
    float tx
    float ty
    float tz
    float tw
    tx, ty, tz, tw = t1.transformPoint(origin)
    check(approxEq(tx, 3.0, 1e-5) and approxEq(ty, 4.0, 1e-5) and approxEq(tz, 5.0, 1e-5) and approxEq(tw, 1.0, 1e-5), "translate moves origin")

    Mat4 s1 = matScale(2.0, 3.0, 4.0)
    Vec3 s1p = Vec3(1.0, 1.0, 1.0)
    float sx
    float sy
    float sz
    float sw
    sx, sy, sz, sw = s1.transformPoint(s1p)
    check(approxEq(sx, 2.0, 1e-5) and approxEq(sy, 3.0, 1e-5) and approxEq(sz, 4.0, 1e-5), "scale multiplies")

    Mat4 rot = matRotateY(degToRad(90.0))
    Vec3 rotP = Vec3(1.0, 0.0, 0.0)
    float rx
    float ry
    float rz
    float rw
    rx, ry, rz, rw = rot.transformPoint(rotP)
    // 绕 Y 转 90°：(1,0,0) -> (0,0,-1)
    check(approxEq(rx, 0.0, 1e-4) and approxEq(rz, -1.0, 1e-4), "rotateY 90deg maps +x to -z")

    // 组合：translate * scale
    Mat4 trTmp = matTranslate(10.0, 0.0, 0.0)
    Mat4 scTmp = matScale(2.0, 2.0, 2.0)
    Mat4 combo = trTmp.mul(scTmp)
    Vec3 comboP = Vec3(1.0, 1.0, 1.0)
    float cxc
    float cyc
    float czc
    float cwc
    cxc, cyc, czc, cwc = combo.transformPoint(comboP)
    // 先 scale -> (2,2,2)，再 translate -> (12,2,2)
    check(approxEq(cxc, 12.0, 1e-5) and approxEq(cyc, 2.0, 1e-5) and approxEq(czc, 2.0, 1e-5), "translate*scale composite")

    // ---- 3. 投影 ----
    println("[3] projection")
    Mat4 proj = matPerspective(90.0, 1.0, 0.1, 100.0)
    // 视野 90°、正方形：原点在 z=-1 处的点，x/y 经过 f=1/tan(45)=1 缩放后保持
    Vec3 projP = Vec3(0.0, 0.0, -1.0)
    float px
    float py
    float pzz
    float pww
    px, py, pzz, pww = proj.transformPoint(projP)
    // w = -z_world；点在相机前方（z=-1）=> w=1 > 0（可见）
    check(pww > 0.0, "perspective w>0 for point in front of camera (z=-1)")

    // ---- 4. 光栅化最小场景 ----
    println("[4] rasterization")
    Mesh cube = buildCube()
    check(cube.vertCount() == 8, "cube has 8 verts")
    check(cube.triCount() == 12, "cube has 12 tris")
    Mesh octa = buildOctahedron()
    check(octa.vertCount() == 6, "octahedron has 6 verts")
    check(octa.triCount() == 8, "octahedron has 8 tris")

    // 渲染一个小图，确认有像素被写入
    Mesh mesh
    Mat4 modelM
    mesh, modelM = buildScene(0)
    Vec3 eyeT = Vec3(0.0, 1.8, 5.5)
    Vec3 tgtT = Vec3(0.0, 0.0, 0.0)
    Vec3 upT = Vec3(0.0, 1.0, 0.0)
    Mat4 viewT = matLookAt(eyeT, tgtT, upT)
    Mat4 projT = matPerspective(45.0, 1.0, 0.1, 100.0)
    Mat4 vpT = projT.mul(viewT)
    Mat4 mvpT = vpT.mul(modelM)
    Vec3 ldirTRaw = Vec3(0.5, 0.8, 0.6)
    Vec3 ldirT = ldirTRaw.normalize()
    RenderTarget rt = RenderTarget(64, 64)
    rt.clear(15, 20, 40)
    rasterizeMesh(mesh, mvpT, modelM, rt, ldirT)
    int drawn = countNonBg(rt, 15, 20, 40)
    check(drawn > 200, "cube renders > 200 shaded pixels on 64x64 (got " + string(drawn) + ")")
    check(drawn < 64 * 64, "cube does not fill entire 64x64 (got " + string(drawn) + ")")

    // ---- 5. Z-buffer 验证：前后两个面，前面的应遮挡后面 ----
    println("[5] z-buffer")
    RenderTarget rt2 = RenderTarget(32, 32)
    rt2.clear(0, 0, 0)
    // 构造两个正对相机的三角形（简化为单个三角形 mesh）
    Mesh nearTri = Mesh()
    nearTri.addVert(-0.3, -0.3, 0.0)   // 0
    nearTri.addVert( 0.3, -0.3, 0.0)   // 1
    nearTri.addVert( 0.0,  0.3, 0.0)   // 2
    nearTri.addTri(0, 1, 2, 1.0, 0.0, 0.0)  // 红，近
    Mesh farTri = Mesh()
    farTri.addVert(-0.5, -0.5, 0.0)
    farTri.addVert( 0.5, -0.5, 0.0)
    farTri.addVert( 0.0,  0.5, 0.0)
    farTri.addTri(0, 1, 2, 0.0, 1.0, 0.0)   // 绿，远
    // 近三角形放在 z=-2，远三角形放在 z=-4（世界空间）
    Vec3 zEye = Vec3(0.0, 0.0, 0.0)
    Vec3 zTgt = Vec3(0.0, 0.0, -1.0)
    Vec3 zUp = Vec3(0.0, 1.0, 0.0)
    Mat4 viewZ = matLookAt(zEye, zTgt, zUp)
    Mat4 projZ = matPerspective(90.0, 1.0, 0.1, 100.0)
    Mat4 vpZ = projZ.mul(viewZ)
    Mat4 nearM = matTranslate(0.0, 0.0, -2.0)
    Mat4 farM = matTranslate(0.0, 0.0, -4.0)
    Vec3 ldirZRaw = Vec3(0.0, 0.0, 1.0)
    Vec3 ldirZ = ldirZRaw.normalize()
    // 先画远的，再画近的：中心应为红
    Mat4 mvpFar = vpZ.mul(farM)
    Mat4 mvpNear = vpZ.mul(nearM)
    rasterizeMesh(farTri, mvpFar, farM, rt2, ldirZ)
    rasterizeMesh(nearTri, mvpNear, nearM, rt2, ldirZ)
    int centerX = 16
    int centerY = 16
    int centerR = rt2.fb[(centerY * 32 + centerX) * 3]
    int centerG = rt2.fb[(centerY * 32 + centerX) * 3 + 1]
    check(centerR > 200 and centerG < 60, "z-buffer: near(red) occludes far(green) at center")

    println("================================================================")
    println("result: " + string(g_pass) + " passed, " + string(g_fail) + " failed")
    if g_fail > 0 then
        return 1
    end
    return 0
end

// ========================================================================
// 用法
// ========================================================================
func printUsage()
    println("rasterizer - xlang software triangle rasterizer (3D pipeline + Z-buffer)")
    println("usage:")
    println("  rasterizer                                  show this help")
    println("  rasterizer render [w] [h] [out] [scene]     render scene to PPM")
    println("                                              w=width h=height out=output scene=mesh")
    println("                                              defaults: 320 240 out.ppm 0")
    println("                                              scene: 0=cube 1=octahedron 2=both")
    println("  rasterizer test                             run self-test")
    println("  rasterizer bench [w] [h]                    benchmark, default 320 240")
    println("pipeline: model->view->projection->viewport, barycentric raster, z-buffer, flat shading")
end

func main(...) as int
    if arg.length < 2 then
        printUsage()
        return 1
    end
    string cmd = string(arg[1])
    try
        if cmd == "-h" or cmd == "--help" or cmd == "help" then
            printUsage()
            return 0
        elseif cmd == "render" then
            int width = 320
            int height = 240
            string outPath = "out.ppm"
            int sceneChoice = 0
            if arg.length >= 3 then width = parseArgInt(string(arg[2]), 320) end
            if arg.length >= 4 then height = parseArgInt(string(arg[3]), 240) end
            if arg.length >= 5 then outPath = string(arg[4]) end
            if arg.length >= 6 then sceneChoice = parseArgInt(string(arg[5]), 0) end
            return cmdRender(width, height, outPath, sceneChoice)
        elseif cmd == "test" then
            return cmdTest()
        elseif cmd == "bench" then
            int width = 320
            int height = 240
            if arg.length >= 3 then width = parseArgInt(string(arg[2]), 320) end
            if arg.length >= 4 then height = parseArgInt(string(arg[3]), 240) end
            return cmdBench(width, height)
        else
            println("error: unknown command '" + cmd + "'")
            printUsage()
            return 1
        end
    catch e
        println("error: " + e.message)
        return 1
    end
    return 0
end
