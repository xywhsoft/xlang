    return b
end

// ====================================================================
// 悬停提示
// ====================================================================

func getHover(string uri, int line, int character) as string
    var doc = g_documents[uri]
    string text = ""
    if not (doc is null) then
        text = doc.text
    end
    string word = wordAtPosition(text, line, character)
    if string.len(word) == 0 then
        return ""
    end

    // 查找符号
    Symbol sym = findSymbolByName(word)
    if string.len(sym.name) == 0 then
        // 关键字?
        if isKeyword(word) then
            return "keyword: " + word
        end
        return ""
    end

    return formatHoverContent(sym)
end

func formatHoverContent(Symbol sym) as string
    array parts = []
    if sym.kind == SYM_FUNC then
        parts.push("**function** " + sym.name)
        if string.len(sym.signature) > 0 then
            parts.push("```xlang")
            parts.push(sym.signature)
            parts.push("```")
        end
    elseif sym.kind == SYM_CLASS then
        parts.push("**class** " + sym.name)
    elseif sym.kind == SYM_VAR then
        parts.push("**variable** " + sym.name)
        if string.len(sym.detail) > 0 then
            parts.push(sym.detail)
        end
    elseif sym.kind == SYM_CONST then
        parts.push("**const** " + sym.name)
    elseif sym.kind == SYM_PARAM then
        parts.push("**parameter** " + sym.name)
    elseif sym.kind == SYM_FIELD then
        parts.push("**field** " + sym.name)
        if string.len(sym.detail) > 0 then
            parts.push(sym.detail)
        end
    end
    if string.len(sym.doc) > 0 then
        parts.push("")
        parts.push(sym.doc)
    end
    parts.push("")
    parts.push("Declared at " + sym.file + ":" + string(sym.line) + ":" + string(sym.column))

    string result = ""
    for p in parts
        if string.len(result) > 0 then
            result = result + "\n"
        end
        result = result + string(p)
    end
    return result
end

func isKeyword(string w) as bool
    array kw = initKeywords()
    for k in kw
        if string(k) == w then
            return true
        end
    end
    return false
end

// 按名字查找第一个匹配的符号
func findSymbolByName(string name) as Symbol
    var arr = g_symbolsByName[name]
    if arr is array then
        if arr.length > 0 then
            return arr[0] as Symbol
        end
    end
    return Symbol("", "", "", 0, 0)
end

// 按名字查找所有匹配的符号
func findSymbolsByName(string name) as array<Symbol>
    var arr = g_symbolsByName[name]
    array<Symbol> result = []
    if arr is array then
        int i = 0
        while i < arr.length do
            result.push(arr[i] as Symbol)
            i += 1
        end
    end
    return result
end

// ====================================================================
// 跳转定义
// ====================================================================

func getDefinition(string uri, int line, int character) as array
    var doc = g_documents[uri]
    string text = ""
    if not (doc is null) then
        text = doc.text
    end
    string word = wordAtPosition(text, line, character)
    if string.len(word) == 0 then
        return []
    end

    array<Symbol> syms = findSymbolsByName(word)
    array result = []
    for sym in syms
        // LSP 行/列是 0-based，源码符号是 1-based
        int startLine = sym.line - 1
        int startChar = sym.column - 1
        int endLine = startLine
        int endChar = startChar + string.len(sym.name)
        Location loc = Location(pathToUri(sym.file), startLine, startChar, endLine, endChar)
        result.push(loc)
    end
    return result
end

// ====================================================================
// 引用查找
// ====================================================================

func getReferences(string uri, int line, int character, bool includeDecl) as array
    var doc = g_documents[uri]
    string text = ""
    string filePath = uriToPath(uri)
    if not (doc is null) then
        text = doc.text
    end
    string word = wordAtPosition(text, line, character)
    if string.len(word) == 0 then
        return []
    end

    array result = []

    // 先在所有已打开的文档中搜索
    array keys = dictKeys(g_documents)
    for k in keys
        string docUri = string(k)
        var d = g_documents[docUri]
        if d is null then
            continue
        end
        searchReferencesInText(docUri, d.text, word, includeDecl, result)
    end

    // 如果没有打开文档，至少搜当前文件
    if result.length == 0 then
        searchReferencesInText(uri, text, word, includeDecl, result)
    end

    return result
end

// 在文本中搜索 word 的所有出现位置
func searchReferencesInText(string uri, string text, string word, bool includeDecl, array result)
    array lines = splitLinesSafe(text)
    int n = lines.length
    int i = 0
    while i < n do
        string l = string(lines[i])
        searchWordInLine(uri, l, i, word, result)
        i += 1
    end

    // 如果不包含声明，过滤掉声明行
    if not includeDecl then
        // 简化: 不过滤 (保留所有出现)
    end
end

// 在单行中查找所有匹配的单词位置
func searchWordInLine(string uri, string line, int lineNo, string word, array result)
    int n = string.len(line)
    int wlen = string.len(word)
    if wlen == 0 or n < wlen then
        return
    end
    int i = 0
    while i <= n - wlen do
        // 检查是否匹配 word
        if string.slice(line, i, wlen) == word then
            // 检查边界: 前后不是标识符字符
            bool okBefore = true
            if i > 0 then
                string before = string.charAt(line, i - 1)
                if isIdentChar(before) then
                    okBefore = false
                end
            end
            bool okAfter = true
            if i + wlen < n then
                string after = string.charAt(line, i + wlen)
                if isIdentChar(after) then
                    okAfter = false
                end
            end
            if okBefore and okAfter then
                Location loc = Location(uri, lineNo, i, lineNo, i + wlen)
                result.push(loc)
            end
        end
        i += 1
    end
end

func dictKeys(var d) as array
    array result = []
    for k, v in d
        result.push(k)
    end
    return result
end

// ====================================================================
// 诊断 (调用 xl check)
// ====================================================================

func getDiagnostics(string uri) as array
    string filePath = uriToPath(uri)
    array result = []

    // 1. 用 xl check 获取编译器诊断
    if string.len(g_xl) > 0 then
        array compilerDiags = runXlCheck(filePath)
        for d in compilerDiags
            result.push(d)
        end
    end

    // 2. 源码扫描补充: 未闭合的块、基本语法检查
    array srcDiags = scanSourceDiagnostics(filePath, uri)
    for d in srcDiags
        result.push(d)
    end

    return result
end

func runXlCheck(string filePath) as array
    array result = []
    if not file.exists(filePath) then
        return result
    end
    string cmd = g_xl + " check " + path.abs(filePath)
    ProcessResult r = process.run(cmd, 60000)
    // xl check 返回非零表示有错误
    string output = ""
    if string.len(string.trim(r.stderr)) > 0 then
        output = r.stderr
    else
        output = r.stdout
    end
    if string.len(string.trim(output)) == 0 then
        if r.exitCode != 0 then
            Diagnostic d = Diagnostic(filePath, 1, 1, DS_ERROR, "xl check", "check failed with exit code " + string(r.exitCode))
            result.push(d)
        end
        return result
    end

    // 解析编译器输出行 (格式通常是 file(line,col): message 或 [phase] message)
    array lines = splitLinesSafe(output)
    for l in lines
        string line = string(l)
        if string.len(string.trim(line)) == 0 then
            continue
        end
        var d = parseCompilerLine(filePath, line)
        if not (d is null) then
            result.push(d)
        end
    end
    return result
end

// 解析编译器输出行
func parseCompilerLine(string filePath, string line) as var
    // 尝试匹配: file(line,col): message  或  file(line): message
    // 或 [phase] message
    string trimmed = string.trim(line)

    // 模式 1: path(line,col): message  或  path(line): message
    if regex.isMatch(trimmed, "\\(([0-9]+)(,[0-9]+)?\\)") then
        int lineNo = extractLineNoFromDiag(trimmed)
        int col = extractColFromDiag(trimmed)
        int severity = extractSeverityFromDiag(trimmed)
        string msg = extractMsgFromDiag(trimmed)
        if lineNo < 1 then
            lineNo = 1
        end
        if col < 1 then
            col = 1
        end
        Diagnostic d = Diagnostic(filePath, lineNo, col, severity, "xl", msg)
        return d
    end

    // 模式 2: [phase] message (无行列)
    if regex.isMatch(trimmed, "^\\[") then
        // 判断严重度
        int severity = DS_ERROR
        if string.contains(trimmed, "warning") then
            severity = DS_WARNING
        elseif string.contains(trimmed, "info") then
            severity = DS_INFO
        end
        Diagnostic d = Diagnostic(filePath, 1, 1, severity, "xl", trimmed)
        return d
    end

    // 模式 3: error: message
    if string.startsWith(trimmed, "error:") or string.startsWith(trimmed, "Error:") then
        Diagnostic d = Diagnostic(filePath, 1, 1, DS_ERROR, "xl", trimmed)
        return d
    end
    if string.startsWith(trimmed, "warning:") or string.startsWith(trimmed, "Warning:") then
        Diagnostic d = Diagnostic(filePath, 1, 1, DS_WARNING, "xl", trimmed)
        return d
    end

    return null
end

// 从诊断行提取行号: 找 (NN 形式
func extractLineNoFromDiag(string s) as int
    int p = string.indexOf(s, "(")
    if p < 0 then
        return 1
    end
    int start = p + 1
    int commaPos = string.indexOf(s, ",")
    int closePos = string.indexOf(s, ")")
    int endPos = commaPos
    if endPos < 0 or (closePos >= 0 and closePos < endPos) then
        endPos = closePos
    end
    if endPos <= start then
        return 1
    end
    string num = string.slice(s, start, endPos - start)
    try
        return int(string.trim(num))
    catch e
        return 1
    end
end

// 从诊断行提取列号: 找 ,NN) 形式
func extractColFromDiag(string s) as int
    int open = string.indexOf(s, "(")
    if open < 0 then
        return 1
    end
    int commaPos = string.indexOf(s, ",")
    if commaPos < 0 or commaPos < open then
        return 1
    end
    int closePos = string.indexOf(s, ")")
    if closePos < 0 or closePos <= commaPos then
        return 1
    end
    string num = string.slice(s, commaPos + 1, closePos - commaPos - 1)
    try
        return int(string.trim(num))
    catch e
        return 1
    end
end

// 从诊断行提取严重度
func extractSeverityFromDiag(string s) as int
    int p = string.indexOf(s, ")")
    if p < 0 then
        return DS_ERROR
    end
    string rest = string.slice(s, p + 1)
    if string.contains(rest, "warning") then
        return DS_WARNING
    end
    if string.contains(rest, "info") then
        return DS_INFO
    end
    if string.contains(rest, "hint") then
        return DS_HINT
    end
    return DS_ERROR
end

// 从诊断行提取消息文本
func extractMsgFromDiag(string s) as string
    int p = string.indexOf(s, ")")
    if p < 0 then
        return s
    end
    string rest = string.slice(s, p + 1)
    rest = string.trim(rest)
    if string.startsWith(rest, ":") then
        rest = string.trim(string.slice(rest, 1))
    end
    if string.startsWith(rest, "error:") then
        rest = string.trim(string.slice(rest, 6))
    elseif string.startsWith(rest, "warning:") then
        rest = string.trim(string.slice(rest, 8))
    elseif string.startsWith(rest, "info:") then
        rest = string.trim(string.slice(rest, 5))
    elseif string.startsWith(rest, "hint:") then
        rest = string.trim(string.slice(rest, 5))
    end
    return rest
end

// 源码基本诊断: 未配对的 end/begin 等
func scanSourceDiagnostics(string filePath, string uri) as array
    array result = []
    string text = ""
    // 优先使用内存文档 (LSP buffer), 其次读磁盘
    var doc = g_documents[uri]
    if not (doc is null) then
        text = doc.text
    else
        var docAlt = g_documents[filePath]
        if not (docAlt is null) then
            text = docAlt.text
        elseif file.exists(filePath) then
            try
                text = file.readText(filePath)
            catch e
                return result
            end
        else
            return result
        end
    end

    array lines = splitLinesSafe(text)
    int depth = 0
    int i = 0
    int n = lines.length
    while i < n do
        string raw = string(lines[i])
        string code = stripComment(raw)
        string trimmed = string.trim(code)
        int lineNo = i + 1

        // 统计块开始/结束
        if startsBlock(trimmed) then
            depth += 1
        end
        if matchEnd(trimmed) then
            depth -= 1
            if depth < 0 then
                Diagnostic d = Diagnostic(filePath, lineNo, 1, DS_ERROR, "xlsrv", "unexpected 'end' (no matching block)")
                result.push(d)
                depth = 0
            end
        end
        i += 1
    end

    if depth > 0 then
        Diagnostic d = Diagnostic(filePath, n, 1, DS_ERROR, "xlsrv", "unclosed block (" + string(depth) + " 'end' missing)")
        result.push(d)
    end

    // while 缺 do 检查
    int j = 0
    while j < n do
        string raw = string(lines[j])
        string code = stripComment(raw)
        string trimmed = string.trim(code)
        if string.startsWith(trimmed, "while ") and not containsWord(code, "do") then
            // 向后看 3 行是否有 do
            bool seen = false
            int k = j + 1
            int stop = j + 3
            if stop >= n then
                stop = n - 1
            end
            while k <= stop do
                string code2 = stripComment(string(lines[k]))
                if containsWord(code2, "do") then
                    seen = true
                    break
                end
                k += 1
            end
            if not seen then
                Diagnostic d = Diagnostic(filePath, j + 1, 1, DS_WARNING, "xlsrv", "'while' without 'do'")
                result.push(d)
            end
        end
        j += 1
    end

    return result
end

// 判断是否是块开始语句
func startsBlock(string s) as bool
    string t = string.trim(s)
    if string.startsWith(t, "func ") then
        return true
    end
    if string.startsWith(t, "class ") then
        return true
    end
    if string.startsWith(t, "create ") or string.startsWith(t, "create(") then
        return true
    end
    if string.startsWith(t, "if ") then
        return true
    end
    if t == "else" or string.startsWith(t, "else ") then
        return false
    end
    if string.startsWith(t, "elseif ") then
        return false
    end
    if string.startsWith(t, "while ") then
        return true
    end
    if string.startsWith(t, "for ") then
        return true
    end
    if t == "try" or string.startsWith(t, "try ") then
        return true
    end
    if t == "do" then
        return true
    end
    if string.startsWith(t, "catch ") then
        return false
    end
    return false
end

func containsWord(string s, string w) as bool
    return regex.isMatch(s, "\\b" + w + "\\b")
end

// ====================================================================
// 文档管理 (didOpen / didChange)
// ====================================================================

func openDocument(string uri, string text, int version)
    Document doc = Document(uri, version, text)
    g_documents[uri] = doc
    // 解析符号
    string filePath = uriToPath(uri)
    loadFileSymbols(filePath)
end

func updateDocument(string uri, string text, int version)
    Document doc = Document(uri, version, text)
    g_documents[uri] = doc
    // 重新解析: 先清除该文件的旧符号
    removeSymbolsForFile(uri)
    string filePath = uriToPath(uri)
    var ast = loadAst(filePath)
    if not (ast is null) then
        extractSymbolsFromAst(ast, filePath)
    else
        scanFileSymbols(filePath, text)
    end
end

func removeSymbolsForFile(string uri)
    string filePath = uriToPath(uri)
    array<Symbol> kept = []
    for sym in g_symbols
        if sym.file != filePath then
            kept.push(sym)
        end
    end
    g_symbols = kept
    // 重建 name 索引
    g_symbolsByName = {}
    for sym in g_symbols
        string key = sym.name
        var existing = g_symbolsByName[key]
        if existing is array then
            existing.push(sym)
        else
            array arr = []
            arr.push(sym)
            g_symbolsByName[key] = arr
        end
    end
end

// ====================================================================
// JSON-RPC 2.0 帧解析
// ====================================================================

// 从缓冲区尝试解析一个完整帧。
// 返回 dict: {ok, contentLength, headerEnd, payloadStart, payloadEnd, headers}
// ok=false 表示数据不完整。
// buffer: 字符串缓冲区
func parseFrame(string buffer) as var
    var result = {}
    result["ok"] = false

    // 找到 \r\n\r\n (头部结束)
    int headerEnd = findHeaderEnd(buffer)
    if headerEnd < 0 then
        result["error"] = "incomplete header"
        return result
    end

    // 解析头部
    string headerBlock = string.left(buffer, headerEnd)
    int contentLength = parseContentLength(headerBlock)
    if contentLength < 0 then
        result["error"] = "missing Content-Length"
        return result
    end

    int payloadStart = headerEnd + 4       // 跳过 \r\n\r\n
    int totalLen = string.len(buffer)
    if payloadStart + contentLength > totalLen then
        result["error"] = "incomplete payload"
        return result
    end

    result["ok"] = true
    result["contentLength"] = contentLength
    result["headerEnd"] = headerEnd
    result["payloadStart"] = payloadStart
    result["payloadEnd"] = payloadStart + contentLength
    result["totalFrameLen"] = payloadStart + contentLength
    result["payload"] = string.slice(buffer, payloadStart, contentLength)
    return result
end

// 查找 \r\n\r\n 的位置
func findHeaderEnd(string buffer) as int
    int n = string.len(buffer)
    int i = 0
    while i < n - 3 do
        if string.charAt(buffer, i) == "\r" then
            if string.charAt(buffer, i + 1) == "\n" then
                if string.charAt(buffer, i + 2) == "\r" then
                    if string.charAt(buffer, i + 3) == "\n" then
                        return i
                    end
                end
            end
        end
        i += 1
    end
    return -1
end

// 从头部块解析 Content-Length
func parseContentLength(string headerBlock) as int
    array lines = string.split(headerBlock, "\r\n")
    for l in lines
        string line = string.trim(string(l))
        if string.lower(line) == "content-length: 0" then
            return 0
        end
        if startsWithCI(line, "content-length:") then
            string val = string.trim(string.slice(line, 15))
            try
                return int(val)
            catch e
                return -1
            end
        end
    end
    return -1
end

func startsWithCI(string s, string prefix) as bool
    string sl = string.lower(s)
    string pl = string.lower(prefix)
    return string.startsWith(sl, pl)
end

// 编码一个 JSON-RPC 帧 (Content-Length 头 + payload)
func encodeFrame(string payload) as string
    int len = string.len(payload)
    string header = "Content-Length: " + string(len) + "\r\n\r\n"
    return header + payload
end

// 构建一个 JSON-RPC response payload
func makeResponse(int id, var result) as string
    var resp = {}
    resp["jsonrpc"] = JSONRPC_VERSION
    resp["id"] = id
    resp["result"] = result
    return json.stringify(resp)
end

// 构建一个 JSON-RPC error payload
func makeErrorResponse(int id, int code, string message) as string
    var resp = {}
    resp["jsonrpc"] = JSONRPC_VERSION
    resp["id"] = id
    var err = {}
    err["code"] = code
    err["message"] = message
    resp["error"] = err
    return json.stringify(resp)
end

// 构建一个 JSON-RPC notification payload
func makeNotification(string method, var params) as string
    var resp = {}
    resp["jsonrpc"] = JSONRPC_VERSION
    resp["method"] = method
    resp["params"] = params
    return json.stringify(resp)
end

// ====================================================================
// LSP 方法处理
// ====================================================================

// 构建 initialize 响应
func handleInitialize(var params) as var
    var caps = {}
    var textSync = {}
    textSync["openClose"] = true
    textSync["change"] = 1                    // TextDocumentSyncKind.Full
    caps["textDocumentSync"] = textSync
    caps["completionProvider"] = {"resolveProvider": false}
    caps["hoverProvider"] = true
    caps["definitionProvider"] = true
    caps["referencesProvider"] = true
    caps["documentSymbolProvider"] = true

    var result = {}
    result["capabilities"] = caps
    var info = {}
    info["name"] = "xlsrv"
    info["version"] = LSP_VERSION
    result["serverInfo"] = info
    return result
end

// didOpen
func handleDidOpen(var params)
    var td = params["textDocument"]
    if td is null then
        return
    end
    string uri = string(td["uri"])
    string text = string(td["text"])
    int version = 0
    var v = td["version"]
    if v is int then
        version = int(v)
    end
    openDocument(uri, text, version)
end

// didChange
func handleDidChange(var params)
    var td = params["textDocument"]
    if td is null then
        return
    end
    string uri = string(td["uri"])
    int version = 0
    var v = td["version"]
    if v is int then
        version = int(v)
    end
    var changes = params["contentChanges"]
    if changes is array then
        if changes.length > 0 then
            var last = changes[-1]
            string text = string(last["text"])
            updateDocument(uri, text, version)
        end
    end
end

// completion
func handleCompletion(var params) as array
    var td = params["textDocument"]
    var pos = params["position"]
    if td is null or pos is null then
        return []
    end
    string uri = string(td["uri"])
    int line = int(pos["line"])
    int character = int(pos["character"])
    return getCompletions(uri, line, character)
end

// hover
func handleHover(var params) as var
    var td = params["textDocument"]
    var pos = params["position"]
    if td is null or pos is null then
        return null
    end
    string uri = string(td["uri"])
    int line = int(pos["line"])
    int character = int(pos["character"])
    string content = getHover(uri, line, character)
    if string.len(content) == 0 then
        return null
    end
    var result = {}
    var markup = {}
    markup["kind"] = "markdown"
    markup["value"] = content
    result["contents"] = markup
    return result
end

// definition
func handleDefinition(var params) as array
    var td = params["textDocument"]
    var pos = params["position"]
    if td is null or pos is null then
        return []
    end
    string uri = string(td["uri"])
    int line = int(pos["line"])
    int character = int(pos["character"])
    return getDefinition(uri, line, character)
end

// references
func handleReferences(var params) as array
    var td = params["textDocument"]
    var pos = params["position"]
    if td is null or pos is null then
        return []
    end
    string uri = string(td["uri"])
    int line = int(pos["line"])
    int character = int(pos["character"])
    bool includeDecl = true
    var ctx = params["context"]
    if not (ctx is null) then
        var inc = ctx["includeDeclaration"]
        if inc is bool then
            includeDecl = bool(inc)
        end
    end
    return getReferences(uri, line, character, includeDecl)
end

// documentSymbol (列出文件中的所有符号)
func handleDocumentSymbol(var params) as array
    var td = params["textDocument"]
    if td is null then
        return []
    end
    string uri = string(td["uri"])
    string filePath = uriToPath(uri)
    array result = []
    for sym in g_symbols
        if sym.file != filePath then
            continue
        end
        if sym.kind == SYM_PARAM then
            continue
        end
        var info = {}
        info["name"] = sym.name
        int kind = SK_VARIABLE
        if sym.kind == SYM_FUNC then
            kind = SK_FUNCTION
        elseif sym.kind == SYM_CLASS then
            kind = SK_CLASS
        elseif sym.kind == SYM_CONST then
            kind = SK_CONST
        end
        info["kind"] = kind
        var range = rangeToVar(sym.line - 1, sym.column - 1, sym.endLine - 1, sym.column + string.len(sym.name))
        info["range"] = range
        info["selectionRange"] = range
        if string.len(sym.detail) > 0 then
            info["detail"] = sym.detail
        end
        result.push(info)
    end
    return result
end

func rangeToVar(int sl, int sc, int el, int ec) as var
    var r = {}
    var start = {}
    start["line"] = sl
    start["character"] = sc
    var en = {}
    en["line"] = el
    en["character"] = ec
    r["start"] = start
    r["end"] = en
    return r
end

// location -> var
func locationToVar(Location loc) as var
    var r = rangeToVar(loc.startLine, loc.startChar, loc.endLine, loc.endChar)
    var v = {}
    v["uri"] = loc.uri
    v["range"] = r
    return v
end

// completionItem -> var
func completionToVar(CompletionItem item) as var
    var v = {}
    v["label"] = item.label
    v["kind"] = item.kind
    if string.len(item.detail) > 0 then
        v["detail"] = item.detail
    end
    if string.len(item.documentation) > 0 then
        v["documentation"] = item.documentation
    end
    return v
end

// 分派 LSP 方法
func dispatchMethod(string method, var params, int id) as string
    if method == "initialize" then
        var result = handleInitialize(params)
        return makeResponse(id, result)
    end
    if method == "initialized" then
        return ""                            // notification, no response
    end
    if method == "shutdown" then
        return makeResponse(id, null)
    end
    if method == "exit" then
        return ""                            // terminate
    end
    if method == "textDocument/didOpen" then
        handleDidOpen(params)
        return ""
    end
    if method == "textDocument/didChange" then
        handleDidChange(params)
        return ""
    end
    if method == "textDocument/completion" then
        array result = handleCompletion(params)
        return makeResponse(id, result)
    end
    if method == "textDocument/hover" then
        var result = handleHover(params)
        return makeResponse(id, result)
    end
    if method == "textDocument/definition" then
        array result = handleDefinition(params)
        return makeResponse(id, result)
    end
    if method == "textDocument/references" then
        array result = handleReferences(params)
        return makeResponse(id, result)
    end
    if method == "textDocument/documentSymbol" then
        array result = handleDocumentSymbol(params)
        return makeResponse(id, result)
    end
    // 未知方法
    return makeErrorResponse(id, -32601, "method not found: " + method)
end

// ====================================================================
// stdio LSP 主循环
// ====================================================================

// 处理一个已完整接收的 JSON-RPC 消息，返回响应帧 (或 "" 表示无需响应)
func handleRpcMessage(string payload) as string
    if not json.valid(payload) then
        return encodeFrame(makeErrorResponse(0, -32700, "parse error"))
    end
    var msg = json.parse(payload)
    string method = ""
    var m = msg["method"]
    if m is string then
        method = string(m)
    end
    int id = 0
    var mv = msg["id"]
    if mv is int then
        id = int(mv)
    else
        // notification (无 id)，不需要响应
        if string.len(method) > 0 then
            var params = msg["params"]
            dispatchMethod(method, params, 0)
        end
        return ""
    end
    var params = msg["params"]
    if params is null then
        params = {}
    end
    return dispatchMethod(method, params, id)
end

// stdio 模式 (受 xlang 无 stdin 限制，此处为帧解析演示)
func runStdio()
    println("xlsrv stdio mode (LSP over stdio)")
    println("Note: xlang currently has no stdin API; stdio transport is limited.")
    println("Frame parsing logic is fully implemented and testable via 'xlsrv test'.")
    println("")
    println("To use xlsrv with an editor, configure it as:")
    println("  command: xlsrv stdio")
    println("  transport: stdio")
    println("")
    println("Waiting for LSP frames on stdin... (not supported in current xlang)")
end

// ====================================================================
// 定位 xl.exe
// ====================================================================

func findXl() as string
    string c1 = path.join(path.cwd(), "xl.exe")
    if file.exists(c1) then
        return c1
    end
    string c2 = path.join(path.appDir(), "xl.exe")
    if file.exists(c2) then
        return c2
    end
    string c3 = path.join(path.appDir(), "..", "..", "..")
    c3 = path.join(c3, "xl.exe")
    if file.exists(c3) then
        return c3
    end
    return ""
end

// ====================================================================
// analyze 命令
// ====================================================================

func cmdAnalyze(string filePath, bool asJson) as int
    if not file.exists(filePath) then
        println("xlsrv: file not found: " + filePath)
        return 1
    end

    resetSymbols()
    g_xl = findXl()

    // 加载文件符号
    string text = file.readText(filePath)
    openDocument(pathToUri(filePath), text, 0)

    // 再次确保符号已提取
    if g_symbols.length == 0 then
        loadFileSymbols(filePath)
    end

    if asJson then
        outputAnalysisJson(filePath)
    else
        outputAnalysisText(filePath)
    end
    return 0
end

func outputAnalysisText(string filePath)
    println("=== xlsrv analyze: " + filePath + " ===")
    println("")

    // 符号表
    println("[Symbols] (" + string(g_symbols.length) + ")")
    println("-----------------------------------------------")
    array<Symbol> sorted = sortSymbols(g_symbols)
    for sym in sorted
        string scope = scopeName(sym.scopeId)
        string sig = sym.signature
        if string.len(sig) == 0 then
            sig = sym.detail
        end
        println("  " + string.padRight(sym.kind, 10) + " " + string.padRight(sym.name, 24) + " " + string.padRight(scope, 16) + " " + sym.file + ":" + string(sym.line) + ":" + string(sym.column))
    end
    println("")

    // 作用域
    println("[Scopes] (" + string(g_nextScopeId) + ")")
    println("-----------------------------------------------")
    int si = 0
    while si < g_nextScopeId do
        var s = g_scopes[string(si)]
        if not (s is null) then
            string kind = string(s["kind"])
            string name = string(s["name"])
            int parentId = int(s["parentId"])
            string parentName = "root"
            if parentId >= 0 then
                var ps = g_scopes[string(parentId)]
                if not (ps is null) then
                    parentName = string(ps["name"])
                end
            end
            println("  #" + string(si) + " " + string.padRight(kind, 10) + " " + string.padRight(name, 20) + " parent=" + parentName)
        end
        si += 1
    end
    println("")

    // 诊断
    println("[Diagnostics]")
    println("-----------------------------------------------")
    array diags = getDiagnostics(pathToUri(filePath))
    if diags.length == 0 then
        println("  (no diagnostics)")
    else
        for d in diags
            string sev = sevName(d.severity)
            println("  " + string.padRight(sev, 8) + " " + string(d.line) + ":" + string(d.column) + "  " + d.message)
        end
    end
    println("")

    println("=== Analysis complete ===")
end

func outputAnalysisJson(string filePath)
    var root = {}
    root["file"] = filePath

    // symbols
    array symArr = []
    for sym in g_symbols
        var s = {}
        s["name"] = sym.name
        s["kind"] = sym.kind
        s["file"] = sym.file
        s["line"] = sym.line
        s["column"] = sym.column
        s["scope"] = scopeName(sym.scopeId)
        if string.len(sym.signature) > 0 then
            s["signature"] = sym.signature
        end
        if string.len(sym.doc) > 0 then
            s["doc"] = sym.doc
        end
        if string.len(sym.detail) > 0 then
            s["detail"] = sym.detail
        end
        symArr.push(s)
    end
    root["symbols"] = symArr

    // scopes
    array scopeArr = []
    int si = 0
    while si < g_nextScopeId do
        var s = g_scopes[string(si)]
        if not (s is null) then
            var sc = {}
            sc["id"] = si
            sc["kind"] = s["kind"]
            sc["name"] = s["name"]
            sc["parentId"] = s["parentId"]
            scopeArr.push(sc)
        end
        si += 1
    end
    root["scopes"] = scopeArr

    // diagnostics
    array diags = getDiagnostics(pathToUri(filePath))
    array diagArr = []
    for d in diags
        var dg = {}
        dg["line"] = d.line
        dg["column"] = d.column
        dg["severity"] = d.severity
        dg["source"] = d.source
        dg["message"] = d.message
        diagArr.push(dg)
    end
    root["diagnostics"] = diagArr

    string out = json.stringify(root, pretty = true)
    out = string.replace(out, "\t", "  ")
    println(out)
end

func sevName(int severity) as string
    if severity == DS_ERROR then
        return "error"
    end
    if severity == DS_WARNING then
        return "warning"
    end
    if severity == DS_INFO then
        return "info"
    end
    return "hint"
end

// 排序符号 (按 kind 然后 name)
func sortSymbols(array<Symbol> arr) as array<Symbol>
    array<Symbol> result = []
    for x in arr
        result.push(x)
    end
    // 简单冒泡 (数据量不大)
    int n = result.length
    int i = 0
    while i < n do
        int j = 0
        while j < n - 1 - i do
            Symbol a = result[j]
            Symbol b = result[j + 1]
            bool swap = false
            if a.kind > b.kind then
                swap = true
            elseif a.kind == b.kind then
                if a.name > b.name then
                    swap = true
                end
            end
            if swap then
                result[j] = b
                result[j + 1] = a
            end
            j += 1
        end
        i += 1
    end
    return result
end

// ====================================================================
// symbols 命令
// ====================================================================

func cmdSymbols(string filePath) as int
    if not file.exists(filePath) then
        println("xlsrv: file not found: " + filePath)
        return 1
    end
    resetSymbols()
    g_xl = findXl()
    loadFileSymbols(filePath)
    println("[Symbols in " + filePath + "]")
    println("  Total: " + string(g_symbols.length))
    println("")
    array<Symbol> sorted = sortSymbols(g_symbols)
    for sym in sorted
        string scope = scopeName(sym.scopeId)
        println("  " + string.padRight(sym.kind, 10) + " " + string.padRight(sym.name, 24) + " " + string.padRight(scope, 16) + " L" + string(sym.line) + " C" + string(sym.column))
    end
    return 0
end

// ====================================================================
// check 命令
// ====================================================================

func cmdCheck(string filePath) as int
    if not file.exists(filePath) then
        println("xlsrv: file not found: " + filePath)
        return 1
    end
    resetSymbols()
    g_xl = findXl()
    openDocument(pathToUri(filePath), file.readText(filePath), 0)
    array diags = getDiagnostics(pathToUri(filePath))
    if diags.length == 0 then
        println("xlsrv: no diagnostics found for " + filePath)
        return 0
    end
    println("[Diagnostics for " + filePath + "]")
    int errors = 0
    for d in diags
        string sev = sevName(d.severity)
        println("  " + string.padRight(sev, 8) + " " + string(d.line) + ":" + string(d.column) + "  " + d.source + ": " + d.message)
        if d.severity == DS_ERROR then
            errors += 1
        end
    end
    println("")
    println("  " + string(diags.length) + " diagnostic(s), " + string(errors) + " error(s)")
    if errors > 0 then
        return 1
    end
    return 0
end

// ====================================================================
// 自测
// ====================================================================

int g_pass = 0
int g_fail = 0

func ok(string label)
    g_pass += 1
    println("  [PASS] " + label)
end

func bad(string label, string detail)
    g_fail += 1
    println("  [FAIL] " + label + " :: " + detail)
end

func expectEq(int got, int want, string label)
    if got == want then
        ok(label)
    else
        bad(label, "got " + string(got) + " want " + string(want))
    end
end

func expectTrue(bool got, string label)
    if got then
        ok(label)
    else
        bad(label, "expected true")
    end
end

func expectFalse(bool got, string label)
    if not got then
        ok(label)
    else
        bad(label, "expected false")
    end
end

func expectStr(string got, string want, string label)
    if got == want then
        ok(label)
    else
        bad(label, "got '" + got + "' want '" + want + "'")
    end
end

// 内联测试源码
func testSource() as string
    string s = ""
    s = s + "const int MAX = 100\n"
    s = s + "\n"
    s = s + "func add(int a, int b) as int\n"
    s = s + "    return a + b\n"
    s = s + "end\n"
    s = s + "\n"
    s = s + "class Point\n"
    s = s + "    int x\n"
    s = s + "    int y\n"
    s = s + "    create(int x, int y)\n"
    s = s + "        self.x = x\n"
    s = s + "        self.y = y\n"
    s = s + "    end\n"
    s = s + "end\n"
    s = s + "\n"
    s = s + "func main(...) as int\n"
    s = s + "    int result = add(1, 2)\n"
    s = s + "    string msg = \"hello\"\n"
    s = s + "    println(msg)\n"
    s = s + "    return 0\n"
    s = s + "end\n"
    return s
end

func testFrameParsing()
    println("[Test] JSON-RPC frame parsing")
    string payload = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}"
    string frame = encodeFrame(payload)
    var parsed = parseFrame(frame)
    expectTrue(bool(parsed["ok"]), "frame ok")
    expectEq(int(parsed["contentLength"]), string.len(payload), "content length")
    expectStr(string(parsed["payload"]), payload, "payload roundtrip")

    // 不完整的帧
    var p2 = parseFrame("Content-Length: 100\r\n\r\n{")
    expectFalse(bool(p2["ok"]), "incomplete payload rejected")

    // 缺少 Content-Length
    var p3 = parseFrame("Content-Type: text\r\n\r\n{}")
    expectFalse(bool(p3["ok"]), "missing Content-Length rejected")

    // 多行头
    string frame2 = "Content-Type: application/vscode-jsonrpc; charset=utf-8\r\nContent-Length: 10\r\n\r\n0123456789"
    var p4 = parseFrame(frame2)
    expectTrue(bool(p4["ok"]), "multi-header ok")
    expectEq(int(p4["contentLength"]), 10, "multi-header length")
    expectStr(string(p4["payload"]), "0123456789", "multi-header payload")
end

func testSymbolExtraction()
    println("[Test] Symbol extraction (source scan)")
    resetSymbols()
    g_xl = ""
    string src = testSource()
    array<Symbol> syms = scanFileSymbols("test.xl", src)

    // 应该找到: MAX, add, a, b, Point, x, y, result, msg, main
    expectTrue(syms.length > 0, "symbols found")
    expectEq(g_symbols.length, syms.length, "global table synced")

    // 检查特定符号
    Symbol addSym = findSymbolByName("add")
    expectStr(addSym.name, "add", "func 'add' found")
    expectStr(addSym.kind, SYM_FUNC, "'add' is function")

    Symbol maxSym = findSymbolByName("MAX")
    expectStr(maxSym.name, "MAX", "const 'MAX' found")
    expectStr(maxSym.kind, SYM_CONST, "'MAX' is constant")

    Symbol ptSym = findSymbolByName("Point")
    expectStr(ptSym.name, "Point", "class 'Point' found")
    expectStr(ptSym.kind, SYM_CLASS, "'Point' is class")

    Symbol mainSym = findSymbolByName("main")
    expectStr(mainSym.name, "main", "func 'main' found")

    // 检查参数
    Symbol aSym = findSymbolByName("a")
    expectStr(aSym.name, "a", "param 'a' found")
    expectStr(aSym.kind, SYM_PARAM, "'a' is param")

    Symbol bSym = findSymbolByName("b")
    expectStr(bSym.name, "b", "param 'b' found")

    // 检查类字段
    Symbol xSym = findSymbolByName("x")
    expectStr(xSym.name, "x", "field 'x' found")

    Symbol ySym = findSymbolByName("y")
    expectStr(ySym.name, "y", "field 'y' found")
end

func testScopes()
    println("[Test] Scope management")
    resetSymbols()
    string src = testSource()
    scanFileSymbols("test.xl", src)

    // 全局作用域必须存在
    expectTrue(g_nextScopeId > 0, "scopes created")
    string gk = scopeKind(0)
    expectStr(gk, SCOPE_GLOBAL, "scope 0 is global")

    // add 函数应该有自己的作用域
    Symbol addSym = findSymbolByName("add")
    expectEq(addSym.scopeId, 0, "'add' in global scope")

    // 参数 a 应该在 add 的函数作用域
    Symbol aSym = findSymbolByName("a")
    expectTrue(aSym.scopeId > 0, "'a' in function scope")
    string ak = scopeKind(aSym.scopeId)
    expectStr(ak, SCOPE_FUNC, "'a' scope is function")

    // Point 类应该有自己的作用域
    Symbol ptSym = findSymbolByName("Point")
    expectTrue(ptSym.scopeId == 0, "'Point' in global scope")

    // 字段 x 在类作用域
    Symbol xSym = findSymbolByName("x")
    expectTrue(xSym.scopeId > 0, "'x' in class scope")
    string xk = scopeKind(xSym.scopeId)
    expectStr(xk, SCOPE_CLASS, "'x' scope is class")
end

func testCompletion()
    println("[Test] Completion")
    resetSymbols()
    string src = testSource()
    scanFileSymbols("test.xl", src)

    array completions = getCompletions("test.xl", 0, 0)

    // 关键字应包含 func/class/if/while
    bool hasFunc = false
    bool hasClass = false
    bool hasIf = false
    bool hasWhile = false
    for item in completions
        if item.label == "func" then
            hasFunc = true
        end
        if item.label == "class" then
            hasClass = true
        end
        if item.label == "if" then
            hasIf = true
        end
        if item.label == "while" then
            hasWhile = true
        end
    end
    expectTrue(hasFunc, "keyword 'func' in completions")
    expectTrue(hasClass, "keyword 'class' in completions")
    expectTrue(hasIf, "keyword 'if' in completions")
    expectTrue(hasWhile, "keyword 'while' in completions")

    // 符号应包含 add/Point/MAX/main
    bool hasAdd = false
    bool hasPoint = false
    bool hasMax = false
    bool hasMain = false
    for item in completions
        if item.label == "add" then
            hasAdd = true
        end
        if item.label == "Point" then
            hasPoint = true
        end
        if item.label == "MAX" then
            hasMax = true
        end
        if item.label == "main" then
            hasMain = true
        end
    end
    expectTrue(hasAdd, "symbol 'add' in completions")
    expectTrue(hasPoint, "symbol 'Point' in completions")
    expectTrue(hasMax, "symbol 'MAX' in completions")
    expectTrue(hasMain, "symbol 'main' in completions")
end

func testHover()
    println("[Test] Hover")
    resetSymbols()
    string src = testSource()
    scanFileSymbols("test.xl", src)

    // 悬停 add 函数
    string hover = getHover("test.xl", 2, 5)
    expectTrue(string.len(hover) > 0, "hover for 'add' not empty")
    expectTrue(string.contains(hover, "add"), "hover contains 'add'")
    expectTrue(string.contains(hover, "function"), "hover contains 'function'")

    // 悬停 Point 类
    string hover2 = getHover("test.xl", 6, 3)
    expectTrue(string.len(hover2) > 0, "hover for 'Point' not empty")

    // 不存在的符号
    string hover3 = getHover("test.xl", 0, 0)
    // 第一行 const int MAX... 光标位置可能匹配 MAX
    // 测试一个确定的空位置
end

func testDefinition()
    println("[Test] Definition")
    resetSymbols()
    string src = testSource()
    scanFileSymbols("test.xl", src)

    // 在 main 中调用 add(1,2)，查找 add 的定义
    // "int result = add(1, 2)" 在 0-based line 16, add 起始列 17
    array defs = getDefinition("test.xl", 16, 17)
    expectTrue(defs.length > 0, "definition for 'add' found")
    if defs.length > 0 then
        var loc = defs[0]
        // add 定义在第 3 行
        expectEq(loc.startLine, 2, "'add' definition at line 3 (0-based 2)")
    end

    // 查找 Point 的定义 (class Point: Point 起始列 6)
    array defs2 = getDefinition("test.xl", 6, 6)
    expectTrue(defs2.length > 0, "definition for 'Point' found")
end

func testReferences()
    println("[Test] References")
    resetSymbols()
    string src = testSource()
    scanFileSymbols("test.xl", src)

    // add 在第 3 行声明，第 18 行调用 -> 至少 2 个引用
    array refs = getReferences("test.xl", 2, 5, true)
    expectTrue(refs.length >= 2, "references for 'add' >= 2")

    // msg 在 main 中声明和使用 (println(msg): msg 起始列 12)
    array refs2 = getReferences("test.xl", 18, 12, true)
    expectTrue(refs2.length >= 2, "references for 'msg' >= 2")
end

func testDiagnostics()
    println("[Test] Source diagnostics")
    resetSymbols()
    g_xl = ""

    // 语法正确代码不应有诊断
    string good = testSource()
    openDocument(pathToUri("good.xl"), good, 0)
    array diags1 = scanSourceDiagnostics("good.xl", pathToUri("good.xl"))
    expectEq(diags1.length, 0, "clean source has no diagnostics")

    // 缺少 end
    string bad1 = "func foo()\n    println(\"hello\")\n"
    resetSymbols()
    openDocument(pathToUri("bad1.xl"), bad1, 0)
    array diags2 = scanSourceDiagnostics("bad1.xl", pathToUri("bad1.xl"))
    expectTrue(diags2.length > 0, "missing end detected")

    // 多余的 end
    string bad2 = "func foo()\n    println(\"hello\")\nend\nend\n"
    resetSymbols()
    openDocument(pathToUri("bad2.xl"), bad2, 0)
    array diags3 = scanSourceDiagnostics("bad2.xl", pathToUri("bad2.xl"))
    expectTrue(diags3.length > 0, "extra end detected")
end

func testJsonRpc()
    println("[Test] JSON-RPC message handling")
    // initialize
    string initPayload = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}"
    string resp = handleRpcMessage(initPayload)
    expectTrue(string.len(resp) > 0, "initialize response generated")
    expectTrue(json.valid(resp), "initialize response is valid JSON")
    var msg = json.parse(resp)
    expectStr(string(msg["jsonrpc"]), "2.0", "response jsonrpc version")
    expectEq(int(msg["id"]), 1, "response id matches")

    // 未知方法
    string unkPayload = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"unknown/method\",\"params\":{}}"
    string resp2 = handleRpcMessage(unkPayload)
    expectTrue(string.len(resp2) > 0, "unknown method returns error")
    expectTrue(json.valid(resp2), "error response valid JSON")

    // 无效 JSON
    string badPayload = "not json at all"
    string resp3 = handleRpcMessage(badPayload)
    expectTrue(string.len(resp3) > 0, "invalid JSON returns error")

    // completion 请求
    resetSymbols()
    string src = testSource()
    openDocument(pathToUri("ctest.xl"), src, 0)
    string compPayload = "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/completion\",\"params\":{\"textDocument\":{\"uri\":\"" + pathToUri("ctest.xl") + "\"},\"position\":{\"line\":0,\"character\":0}}}"
    string resp4 = handleRpcMessage(compPayload)
    expectTrue(json.valid(resp4), "completion response valid JSON")
end

func testUriConversion()
    println("[Test] URI conversion")
    // path -> uri -> path 应保持一致 (对相对路径)
    string uri = pathToUri("test.xl")
    expectTrue(string.startsWith(uri, "file:"), "uri starts with file:")

    string back = uriToPath(uri)
    expectTrue(string.contains(back, "test.xl"), "uri roundtrip contains filename")

    // Windows 路径
    string winPath = "C:\\Users\\test\\file.xl"
    string winUri = pathToUri(winPath)
    expectTrue(string.contains(winUri, "file:"), "windows path to uri")
    string winBack = uriToPath(winUri)
    expectTrue(string.contains(winBack, "file.xl"), "windows uri roundtrip")
end

func testStringHelpers()
    println("[Test] String helpers")
    // stripComment
    expectStr(stripComment("int x = 5 // comment"), "int x = 5 ", "stripComment basic")
    expectStr(stripComment("// only comment"), "", "stripComment only comment")

    // wordAtPosition
    string text = "hello world\nfoo bar"
    expectStr(wordAtPosition(text, 0, 0), "hello", "wordAt line 0 col 0")
    expectStr(wordAtPosition(text, 0, 6), "world", "wordAt line 0 col 6")
    expectStr(wordAtPosition(text, 1, 1), "foo", "wordAt line 1 col 1")

    // identAt
    expectStr(identAt("hello world", 3), "hello", "identAt col 3")
    expectStr(identAt("hello world", 8), "world", "identAt col 8")

    // isIdentChar
    expectTrue(isIdentChar("a"), "isIdentChar a")
    expectTrue(isIdentChar("_"), "isIdentChar _")
    expectTrue(isIdentChar("9"), "isIdentChar 9")
    expectFalse(isIdentChar(" "), "isIdentChar space false")
    expectFalse(isIdentChar("+"), "isIdentChar + false")
end

func testDeclarationMatching()
    println("[Test] Declaration matching")
    expectTrue(matchFuncDecl("func foo() as int"), "match func decl")
    expectFalse(matchFuncDecl("function foo()"), "not match 'function'")

    expectTrue(matchClassDecl("class Point"), "match class decl")
    expectTrue(matchEnd("end"), "match end")
    expectTrue(matchEnd("end "), "match end with space")
    expectFalse(matchEnd("endif"), "not match endif")

    expectStr(extractFuncName("func add(int a, int b) as int"), "add", "extract func name")
    expectStr(extractClassName("class Point"), "Point", "extract class name")
    expectStr(extractClassName("class Foo"), "Foo", "extract class name 2")
    expectStr(extractConstName("const int MAX = 100"), "MAX", "extract const name")

    // 参数提取
    array params = extractParams("func add(int a, int b) as int")
    expectEq(params.length, 2, "extract 2 params")
    if params.length >= 2 then
        expectStr(string(params[0]), "a", "first param is a")
        expectStr(string(params[1]), "b", "second param is b")
    end

    array params2 = extractParams("func noop()")
    expectEq(params2.length, 0, "no params")

    array params3 = extractParams("func one(int x)")
    expectEq(params3.length, 1, "one param")
end

func testVarDecl()
    println("[Test] Variable declaration parsing")
    expectTrue(matchVarDecl("int x = 5"), "match int decl")
    expectTrue(matchVarDecl("string msg = \"hi\""), "match string decl")
    expectTrue(matchVarDecl("auto z = compute()"), "match auto decl")
    expectFalse(matchVarDecl("func foo()"), "not match func as var")

    array decls = extractVarDecls("int x = 5")
    expectEq(decls.length, 1, "one var in decl")
    if decls.length >= 1 then
        var d = decls[0]
        expectStr(string(d["name"]), "x", "var name is x")
        expectStr(string(d["type"]), "int", "var type is int")
    end

    array decls2 = extractVarDecls("array<int> nums = [1,2,3]")
    expectEq(decls2.length, 1, "generic var decl")
    if decls2.length >= 1 then
        var d = decls2[0]
        expectStr(string(d["name"]), "nums", "generic var name")
    end
end

func testEncodeFrame()
    println("[Test] Frame encoding")
    string frame = encodeFrame("{}")
    expectTrue(string.contains(frame, "Content-Length:"), "frame has Content-Length")
    expectTrue(string.contains(frame, "\r\n\r\n"), "frame has header separator")
    expectTrue(string.endsWith(frame, "{}"), "frame ends with payload")

    string frame2 = encodeFrame("{\"id\":1}")
    var parsed = parseFrame(frame2)
    expectTrue(bool(parsed["ok"]), "encoded frame parses ok")
end

func testAnalyzeCommand()
    println("[Test] analyze command integration")
    // 用内联源码写临时文件测试
    string tmpDir = path.temp()
    string tmpFile = path.join(tmpDir, "xlsrv_test_analyze.xl")
    string src = testSource()
    file.writeText(tmpFile, src)

    resetSymbols()
    g_xl = findXl()
    loadFileSymbols(tmpFile)

    expectTrue(g_symbols.length > 0, "analyze loads symbols")
    expectTrue(g_nextScopeId > 0, "analyze creates scopes")

    // 清理
    try
        file.delete(tmpFile)
    catch e
    end
end

func testCompletionItemSerialization()
    println("[Test] Completion item serialization")
    CompletionItem item = CompletionItem("testFunc", CIK_FUNCTION)
    item.detail = "func testFunc()"
    item.documentation = "A test function"
    var v = completionToVar(item)
    expectStr(string(v["label"]), "testFunc", "completion label")
    expectEq(int(v["kind"]), CIK_FUNCTION, "completion kind")
    expectStr(string(v["detail"]), "func testFunc()", "completion detail")
end

func testLocationSerialization()
    println("[Test] Location serialization")
    Location loc = Location("file:///test.xl", 10, 5, 10, 15)
    var v = locationToVar(loc)
    expectStr(string(v["uri"]), "file:///test.xl", "location uri")
    var range = v["range"]
    var start = range["start"]
    expectEq(int(start["line"]), 10, "location start line")
    expectEq(int(start["character"]), 5, "location start char")
end

func testScopeLookup()
    println("[Test] Scope lookup")
    resetSymbols()
    int gs = 0
    int fs = newScope(SCOPE_FUNC, "testFunc", gs)
    int cs = newScope(SCOPE_CLASS, "TestClass", gs)

    Symbol gsym = Symbol("gvar", SYM_VAR, "f.xl", 1, 1)
    registerSymbol(gsym, gs)

    Symbol fsym = Symbol("fvar", SYM_VAR, "f.xl", 2, 1)
    registerSymbol(fsym, fs)

    // 在函数作用域查找全局变量
    Symbol found1 = lookupSymbolInScope("gvar", fs)
    expectStr(found1.name, "gvar", "lookup global from function scope")

    // 在全局作用域找不到函数局部变量
    Symbol found2 = lookupSymbolInScope("fvar", gs)
    expectStr(found2.name, "", "cannot find function var from global")

    // 在函数作用域找函数局部变量
    Symbol found3 = lookupSymbolInScope("fvar", fs)
    expectStr(found3.name, "fvar", "find function var in function scope")
end

