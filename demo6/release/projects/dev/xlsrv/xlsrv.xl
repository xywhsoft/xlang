    return kw
end

// 提供补全列表
func getCompletions(string uri, int line, int character) as array
    array result = []

    // 1. 关键字
    array keywords = initKeywords()
    for kw in keywords
        string k = string(kw)
        CompletionItem item = CompletionItem(k, CIK_KEYWORD)
        item.detail = "keyword"
        result.push(item)
    end

    // 2. 内置函数和类型
    array builtins = initBuiltinsList()
    for b in builtins
        string bn = string(b)
        CompletionItem item = CompletionItem(bn, CIK_TEXT)
        item.detail = "builtin"
        result.push(item)
    end

    // 3. 已声明符号: 函数、变量、类
    // 收集当前文件可见的所有符号
    var seen = {}
    for sym in g_symbols
        if not (seen[sym.name] is null) then
            continue
        end
        seen[sym.name] = true
        int kind = CIK_VARIABLE
        if sym.kind == SYM_FUNC then
            kind = CIK_FUNCTION
        elseif sym.kind == SYM_CLASS then
            kind = CIK_CLASS
        elseif sym.kind == SYM_CONST then
            kind = CIK_VARIABLE
        end
        CompletionItem item = CompletionItem(sym.name, kind)
        if string.len(sym.signature) > 0 then
            item.detail = sym.signature
        else
            item.detail = sym.kind
        end
        if string.len(sym.doc) > 0 then
            item.documentation = sym.doc
        end
        result.push(item)
    end

    return result
end

func initBuiltinsList() as array
    array b = []
    b.push("print")
    b.push("println")
    b.push("int")
