// xlsrv - xlang Language Server (LSP 子集实现)
//
// 用 xlang 编写的 xlang 语言服务器，实现 LSP (Language Server Protocol) 子集：
//   1. JSON-RPC 2.0 帧解析: Content-Length: N\r\n\r\n{json}
//   2. LSP 方法: initialize / didOpen / didChange / completion / hover
//                 / definition / references / diagnostics
//   3. 符号表: 全局/函数/类作用域，符号位置 (文件+行+列)
//   4. 自动补全: 关键字 + 已声明变量 + 函数名
//   5. 悬停提示: 函数签名 + 文档注释
//   6. 跳转定义: 函数/变量声明位置
//   7. 引用查找: 全文件搜索符号
//   8. 诊断: 调用 process.run("xl check") 获取错误
//
// 用法:
//   xlsrv analyze <file.xl>          分析单个文件，输出符号表 + 诊断
//   xlsrv analyze <file.xl> --json   JSON 格式输出
//   xlsrv test                       自测 (符号提取/补全/悬停/定义/引用/帧解析)
//   xlsrv stdio                      LSP stdio 模式 (帧解析已实现)
//   xlsrv symbols <file.xl>          只输出符号表
//   xlsrv check   <file.xl>          只输出诊断
//
// 设计说明:
//   - 符号管理用全局函数 + 全局 dict/array，无复杂对象图。
//   - AST 提取优先用 `xl parse --format json`；xl.exe 不可用时降级到源码扫描。
//   - 源码扫描基于逐行 regex，提取 func/class/var/const/param/field 声明。
//   - JSON-RPC 帧解析完整实现 Content-Length 头部解析 + payload 切分。
//   - stdio 传输受 xlang 当前无 stdin API 限制，stdio 命令只做帧解析演示。

// ====================================================================
// 常量
// ====================================================================

const string LSP_VERSION = "0.1.0"
const string JSONRPC_VERSION = "2.0"

// LSP CompletionItemKind (子集)
const int CIK_TEXT = 1
const int CIK_METHOD = 2
const int CIK_FUNCTION = 3
const int CIK_VARIABLE = 6
const int CIK_CLASS = 7
const int CIK_KEYWORD = 14

// LSP SymbolKind (子集)
const int SK_FILE = 1
const int SK_CLASS = 5
const int SK_FUNCTION = 12
const int SK_VARIABLE = 13
const int SK_CONST = 14

// LSP DiagnosticSeverity
const int DS_ERROR = 1
const int DS_WARNING = 2
const int DS_INFO = 3
const int DS_HINT = 4

// 符号种类 (内部)
const string SYM_FUNC = "function"
const string SYM_VAR = "variable"
const string SYM_CONST = "constant"
const string SYM_CLASS = "class"
const string SYM_PARAM = "param"
const string SYM_FIELD = "field"
const string SYM_KEYWORD = "keyword"

// 作用域种类 (内部)
const string SCOPE_GLOBAL = "global"
const string SCOPE_FUNC = "function"
const string SCOPE_CLASS = "class"
const string SCOPE_BLOCK = "block"

// ====================================================================
// 全局状态
// ====================================================================

string g_xl                               // xl.exe 路径
var g_documents = {}                     // uri -> Document dict
array<Symbol> g_symbols = []             // 所有 Symbol
var g_symbolsByName = {}                 // name -> array<Symbol>
var g_scopes = {}                        // scopeId -> Scope dict
int g_nextScopeId = 0                     // 下一个作用域 id
string g_rootUri = ""                     // workspace root

// ====================================================================
// 数据类
// ====================================================================

// 源码位置 (0-based line, 0-based column)
class Position
    int line
    int character
    create(int line, int character)
        self.line = line
        self.character = character
    end
end

// 文本范围
class Range
    int startLine
    int startChar
    int endLine
    int endChar
    create(int sl, int sc, int el, int ec)
        self.startLine = sl
        self.startChar = sc
        self.endLine = el
        self.endChar = ec
    end
end

// 位置 (文件 + 范围)
class Location
    string uri
    int startLine
    int startChar
    int endLine
    int endChar
    create(string uri, int sl, int sc, int el, int ec)
        self.uri = uri
        self.startLine = sl
        self.startChar = sc
        self.endLine = el
        self.endChar = ec
    end
end

// 符号定义
class Symbol
    string name                           // 符号名
    string kind                           // SYM_FUNC / SYM_VAR / ...
    string file                           // 文件路径
    int line                              // 1-based 行号
    int column                            // 1-based 列号
    int endLine                           // 结束行 (估算)
    string signature                      // 函数签名 / 变量类型
    string doc                            // 文档注释
    int scopeId                           // 所属作用域 id
    string detail                         // 附加详情
    create(string name, string kind, string file, int line, int column)
        self.name = name
        self.kind = kind
        self.file = file
        self.line = line
        self.column = column
        self.endLine = line
        self.signature = ""
        self.doc = ""
        self.scopeId = 0
        self.detail = ""
    end
end

// 已打开的文档
class Document
    string uri
    int version
    string text
    array lines
    create(string uri, int version, string text)
        self.uri = uri
        self.version = version
        self.text = text
        self.lines = splitLinesSafe(text)
    end
end

// 诊断信息
class Diagnostic
    string file
    int line
    int column
    int severity
    string source
    string message
    int code
    create(string file, int line, int column, int severity, string source, string message)
        self.file = file
        self.line = line
        self.column = column
        self.severity = severity
        self.source = source
        self.message = message
        self.code = 0
    end
end

// 补全项
class CompletionItem
    string label
    int kind
    string detail
    string documentation
    string insertText
    create(string label, int kind)
        self.label = label
        self.kind = kind
        self.detail = ""
        self.documentation = ""
        self.insertText = label
    end
end

// ====================================================================
// 字符串/行处理工具
// ====================================================================

// 按行拆分成动态 array（splitLines 返回值转 string 元素）.
func splitLinesSafe(string s) as array
    var tmp = string.splitLines(s)
    array ls = []
    for line in tmp
        ls.push(string(line))
    end
    return ls
end

// 移除行内注释 (// 之后)，但保留字符串内的 //
func stripComment(string line) as string
    bool inString = false
    string sep = ""
    int i = 0
    int n = string.len(line)
    while i < n do
        string ch = string.charAt(line, i)
        if inString then
            if ch == "\\" then
                i += 2
                continue
            end
            if ch == sep then
                inString = false
            end
        else
            if ch == "\"" then
                inString = true
                sep = "\""
            elseif ch == "'" then
                inString = true
                sep = "'"
            elseif ch == "/" then
                if i + 1 < n then
                    if string.charAt(line, i + 1) == "/" then
                        return string.left(line, i)
                    end
                end
            end
        end
        i += 1
    end
    return line
end

// 提取标识符: 从指定位置开始向左/右扫描
func identAt(string line, int col) as string
    int n = string.len(line)
    int start = col
    while start > 0 do
        string c = string.charAt(line, start - 1)
        if isIdentChar(c) then
            start -= 1
        else
            break
        end
    end
    int endPos = col
    while endPos < n do
        string c = string.charAt(line, endPos)
        if isIdentChar(c) then
            endPos += 1
        else
            break
        end
    end
    if endPos <= start then
        return ""
    end
    return string.slice(line, start, endPos - start)
end

// 取光标处的完整单词
func wordAtPosition(string text, int line, int character) as string
    array ls = splitLinesSafe(text)
    if line < 0 or line >= ls.length then
        return ""
    end
    string l = string(ls[line])
    int n = string.len(l)
    if character < 0 then
        character = 0
    end
    if character >= n then
        character = n - 1
    end
    if character < 0 then
        return ""
    end
    // 向左找单词起点
    int start = character
    while start > 0 do
        string c = string.charAt(l, start - 1)
        if isIdentChar(c) then
            start -= 1
        else
            break
        end
    end
    // 向右找单词终点
    int endPos = character
    while endPos < n do
        string c = string.charAt(l, endPos)
        if isIdentChar(c) then
            endPos += 1
        else
            break
        end
    end
    if endPos <= start then
        return ""
    end
    return string.slice(l, start, endPos - start)
end

func isIdentChar(string c) as bool
    if c == "_" then
        return true
    end
    if c >= "a" and c <= "z" then
        return true
    end
    if c >= "A" and c <= "Z" then
        return true
    end
    if c >= "0" and c <= "9" then
        return true
    end
    return false
end

func isIdentStart(string c) as bool
    if c == "_" then
        return true
    end
    if c >= "a" and c <= "z" then
        return true
    end
    if c >= "A" and c <= "Z" then
        return true
    end
    return false
end

// 缩进空格数
func indentLevel(string line) as int
    int n = 0
    int i = 0
    int len = string.len(line)
    while i < len do
        string c = string.charAt(line, i)
        if c == " " then
            n += 1
        elseif c == "\t" then
            n += 4
        else
            break
        end
        i += 1
    end
    return n
end

// ====================================================================
// 作用域管理
// ====================================================================

func newScope(string kind, string name, int parentId) as int
    int id = g_nextScopeId
    g_nextScopeId += 1
    var s = {}
    s["id"] = id
    s["kind"] = kind
    s["name"] = name
    s["parentId"] = parentId
    s["symbols"] = []
    g_scopes[string(id)] = s
    return id
end

func initScopes()
    g_scopes = {}
    g_nextScopeId = 0
    newScope(SCOPE_GLOBAL, "global", -1)
end

func scopeKind(int scopeId) as string
    var s = g_scopes[string(scopeId)]
    if s is null then
        return SCOPE_GLOBAL
    end
    return string(s["kind"])
end

func scopeName(int scopeId) as string
    var s = g_scopes[string(scopeId)]
    if s is null then
        return "global"
    end
    return string(s["name"])
end

func scopeParent(int scopeId) as int
    var s = g_scopes[string(scopeId)]
    if s is null then
        return -1
    end
    return int(s["parentId"])
end

// 从作用域向上查找符号 (局部 -> 父作用域 -> ... -> 全局)
func lookupSymbolInScope(string name, int scopeId) as Symbol
    int cur = scopeId
    while cur >= 0 do
        var s = g_scopes[string(cur)]
        if not (s is null) then
            var syms = s["symbols"]
            if syms is array then
                int i = syms.length - 1
                while i >= 0 do
                    Symbol sym = syms[i] as Symbol
                    if sym.name == name then
                        return sym
                    end
                    i -= 1
                end
            end
        end
        cur = scopeParent(cur)
    end
    return Symbol("", "", "", 0, 0)
end

// 注册符号到作用域
func registerSymbol(Symbol sym, int scopeId)
    sym.scopeId = scopeId
    var s = g_scopes[string(scopeId)]
    if not (s is null) then
        var syms = s["symbols"]
        if syms is array then
            syms.push(sym)
        else
            array ns = []
            ns.push(sym)
            s["symbols"] = ns
        end
    end
    addGlobalSymbol(sym)
end

// 注册到全局符号表
func addGlobalSymbol(Symbol sym)
    g_symbols.push(sym)
    string key = sym.name
    var existing = g_symbolsByName[key]
    if existing is array then
        existing.push(sym)
    else
        array arr = []
        arr.push(sym)
        g_symbolsByName[key] = arr
    end
end

func resetSymbols()
    g_symbols = array<Symbol>[]
    g_symbolsByName = {}
    initScopes()
end

// ====================================================================
// 源码扫描: 提取符号 (降级模式，不依赖 xl.exe)
// ====================================================================

// 用 regex 从源码行提取声明，构造 Symbol。
// 这不是完整解析器，但覆盖最常见的声明形态。
func scanFileSymbols(string filePath, string text) as array<Symbol>
    // 缓存文本到 g_documents, 使后续 hover/definition/references 能取到 (按 filePath 索引).
    Document cached = Document(filePath, 1, text)
    g_documents[filePath] = cached
    array<Symbol> result = []
    array lines = splitLinesSafe(text)
    int n = lines.length

    // 作用域栈: 每项是 scopeId
    array scopeStack = []
    scopeStack.push(0)                     // global scope

    int i = 0
    while i < n do
        string raw = string(lines[i])
        string code = stripComment(raw)
        string trimmed = string.trim(code)
        int lineNo = i + 1
        int col = string.indexOf(raw, trimmed)
        if col < 0 then
            col = 0
        end

        // 空行跳过
        if string.len(trimmed) == 0 then
            i += 1
            continue
        end

        // func 声明: func name(params) as Type  /  func name(params)
        if matchFuncDecl(trimmed) then
            string fname = extractFuncName(trimmed)
            string sig = extractFuncSignature(trimmed)
            if string.len(fname) > 0 then
                Symbol sym = Symbol(fname, SYM_FUNC, filePath, lineNo, col + 1)
                sym.signature = sig
                int curScope = int(scopeStack[scopeStack.length - 1])
                int funcScope = newScope(SCOPE_FUNC, fname, curScope)
                registerSymbol(sym, curScope)
                scopeStack.push(funcScope)
                result.push(sym)
                // 提取参数
                array params = extractParams(trimmed)
                for p in params
                    string pname = string(p)
                    Symbol psym = Symbol(pname, SYM_PARAM, filePath, lineNo, col + 1)
                    psym.detail = "param of " + fname
                    registerSymbol(psym, funcScope)
                    result.push(psym)
                end
            end
        elseif matchClassDecl(trimmed) then
            string cname = extractClassName(trimmed)
            if string.len(cname) > 0 then
                Symbol sym = Symbol(cname, SYM_CLASS, filePath, lineNo, col + 1)
                int curScope = int(scopeStack[scopeStack.length - 1])
                int classScope = newScope(SCOPE_CLASS, cname, curScope)
                registerSymbol(sym, curScope)
                scopeStack.push(classScope)
                result.push(sym)
            end
        elseif matchEnd(trimmed) then
            // 块结束: 弹出作用域
            if scopeStack.length > 1 then
                scopeStack.remove(scopeStack.length - 1)
            end
        elseif matchVarDecl(trimmed) then
            // var/typed 变量声明: int x = ..., string y, auto z = ... 或裸声明 int x
            array decls = extractVarDecls(trimmed)
            int curScope = int(scopeStack[scopeStack.length - 1])
            bool inClass = (scopeKind(curScope) == SCOPE_CLASS)
            for d in decls
                var vd = d
                string vname = string(vd["name"])
                string vtype = string(vd["type"])
                string kind = SYM_VAR
                if isConstType(vtype) then
                    kind = SYM_CONST
                end
                if inClass then
                    kind = SYM_FIELD
                end
                Symbol sym = Symbol(vname, kind, filePath, lineNo, col + 1)
                sym.signature = vtype
                if inClass then
                    sym.detail = "field " + vtype + " " + vname
                else
                    sym.detail = vtype + " " + vname
                end
                registerSymbol(sym, curScope)
                result.push(sym)
            end
        elseif matchFieldDecl(trimmed) then
            // 类字段声明 (在 class 作用域内)
            array decls = extractVarDecls(trimmed)
            int curScope = int(scopeStack[scopeStack.length - 1])
            for d in decls
                var vd = d
                string vname = string(vd["name"])
                string vtype = string(vd["type"])
                Symbol sym = Symbol(vname, SYM_FIELD, filePath, lineNo, col + 1)
                sym.signature = vtype
                sym.detail = "field " + vtype + " " + vname
                registerSymbol(sym, curScope)
                result.push(sym)
            end
        elseif matchConstDecl(trimmed) then
            string cname = extractConstName(trimmed)
            if string.len(cname) > 0 then
                Symbol sym = Symbol(cname, SYM_CONST, filePath, lineNo, col + 1)
                int curScope = int(scopeStack[scopeStack.length - 1])
                sym.detail = "const"
                registerSymbol(sym, curScope)
                result.push(sym)
            end
        end

        i += 1
    end

    return result
end

// ---- 声明匹配辅助 ----

func matchFuncDecl(string s) as bool
    // 行以 "func " 开头
    if not string.startsWith(s, "func ") then
        return false
    end
    return true
end

func matchClassDecl(string s) as bool
    if not string.startsWith(s, "class ") then
        return false
    end
    return true
end

func matchEnd(string s) as bool
    string t = string.trim(s)
    if t == "end" then
        return true
    end
    // end 后跟注释/多余空白
    if string.startsWith(t, "end ") then
        return true
    end
    return false
end

func matchVarDecl(string s) as bool
    // 匹配 "Type name = ..." 或 "Type name" (不是 func/class/if/while/for 等关键字)
    if string.startsWith(s, "func ") then
        return false
    end
    if string.startsWith(s, "class ") then
        return false
    end
    if string.startsWith(s, "if ") or s == "if" then
        return false
    end
    if string.startsWith(s, "elseif ") then
        return false
    end
    if string.startsWith(s, "else") then
        return false
    end
    if string.startsWith(s, "while ") then
        return false
    end
    if string.startsWith(s, "for ") then
        return false
    end
    if string.startsWith(s, "do") then
        return false
    end
    if string.startsWith(s, "try") then
        return false
    end
    if string.startsWith(s, "catch ") then
        return false
    end
    if string.startsWith(s, "end") then
        return false
    end
    if string.startsWith(s, "return") then
        return false
    end
    if string.startsWith(s, "const ") then
        return false
    end
    if string.startsWith(s, "print") then
        return false
    end
    if string.startsWith(s, "//") then
        return false
    end
    // 尝试匹配: <Type> <name> [= ...] 或裸声明 <Type> <name> (行尾)
    return regex.isMatch(s, "^[A-Za-z_][A-Za-z0-9_<>, ]+\\s+[A-Za-z_][A-Za-z0-9_]*($|\\s*[=;])")
end

func matchFieldDecl(string s) as bool
    // 在 class 体内、非 create 方法的行: 类似 var 声明但不带类型前缀的赋值给 self.xxx
    if string.startsWith(s, "self.") then
        return regex.isMatch(s, "^self\\.[A-Za-z_][A-Za-z0-9_]*\\s*=")
    end
    return false
end

func matchConstDecl(string s) as bool
    return string.startsWith(s, "const ")
end

func isConstType(string t) as bool
    return t == "const"
end

// ---- 提取声明名字/签名 ----

func extractFuncName(string line) as string
    // func name(...) -> name
    string s = string.trim(string.slice(line, 5))
    int paren = string.indexOf(s, "(")
    if paren < 0 then
        return ""
    end
    return string.trim(string.left(s, paren))
end

func extractFuncSignature(string line) as string
    // 返回 "func name(params) as Type" 或 "func name(params)"
    string sig = string.trim(line)
    // 移除尾部注释已由 stripComment 处理
    return sig
end

func extractClassName(string line) as string
    // class Name ... -> Name
    string s = string.trim(string.slice(line, 6))
    int sp = string.indexOf(s, " ")
    int nl = string.indexOf(s, "\n")
    int endIdx = sp
    if nl >= 0 and (nl < endIdx or endIdx < 0) then
        endIdx = nl
    end
    if endIdx < 0 then
        return s
    end
    return string.trim(string.left(s, endIdx))
end

func extractConstName(string line) as string
    // const int NAME = ... / const string FOO = ...
    string s = string.trim(string.slice(line, 6))
    // 跳过类型
    int sp = string.indexOf(s, " ")
    if sp < 0 then
        return ""
    end
    string rest = string.trim(string.slice(s, sp + 1))
    int eq = string.indexOf(rest, "=")
    if eq < 0 then
        return rest
    end
    return string.trim(string.left(rest, eq))
end

// 从 func 声明行提取参数名列表
func extractParams(string line) as array
    array result = []
    int open = string.indexOf(line, "(")
    if open < 0 then
        return result
    end
    int close = string.indexOf(line, ")")
    if close < 0 or close <= open then
        return result
    end
    string inner = string.slice(line, open + 1, close - open - 1)
    if string.len(string.trim(inner)) == 0 then
        return result
    end
    array parts = string.split(inner, ",")
    for p in parts
        string pt = string.trim(string(p))
        if string.len(pt) == 0 then
            continue
        end
        // "Type name" 或 "..." 可变参数
        if string.startsWith(pt, "...") then
            continue
        end
        // 最后一个 token 是参数名
        int lastSp = string.lastIndexOf(pt, " ")
        if lastSp >= 0 then
            string name = string.trim(string.slice(pt, lastSp + 1))
            if string.len(name) > 0 then
                result.push(name)
            end
        else
            result.push(pt)
        end
    end
    return result
end

// 从变量声明行提取 {name, type} 列表
func extractVarDecls(string line) as array
    array result = []
    // 移除 "end" 尾部
    string code = string.trim(line)
    // 找到第一个 "=" 或行尾
    int eq = string.indexOf(code, "=")
    string lhs = code
    if eq >= 0 then
        lhs = string.left(code, eq)
    end
    lhs = string.trim(lhs)
    // 去掉行尾 "end"
    if string.endsWith(lhs, "end") then
        lhs = string.trim(string.left(lhs, string.len(lhs) - 3))
    end
    // "Type name" -> 第一个 token 是类型
    int sp = string.indexOf(lhs, " ")
    if sp < 0 then
        return result
    end
    string vtype = string.trim(string.left(lhs, sp))
    string rest = string.trim(string.slice(lhs, sp + 1))
    // 支持多声明: "int a, b, c"
    array names = string.split(rest, ",")
    for nm in names
        string name = string.trim(string(nm))
        if string.len(name) == 0 then
            continue
        end
        // 去掉数组括号等
        int bracket = string.indexOf(name, "[")
        if bracket >= 0 then
            name = string.left(name, bracket)
            name = string.trim(name)
        end
        if isIdentStart(string.charAt(name, 0)) then
            var d = {}
            d["name"] = name
            d["type"] = vtype
            result.push(d)
        end
    end
    return result
end

// ====================================================================
// AST 提取: 用 xl parse --format json (优先)
// ====================================================================

func nodeKind(var n) as string
    var k = n["kind"]
    if k is string then
        return string(k)
    end
    return ""
end

func nodeText(var n) as string
    var t = n["text"]
    if t is string then
        return string(t)
    end
    return ""
end

func nodeLine(var n) as int
    var l = n["line"]
    if l is int then
        return int(l)
    end
    return 0
end

func nodeColumn(var n) as int
    var c = n["column"]
    if c is int then
        return int(c)
    end
    return 0
end

func childrenOf(var n) as var
    var ch = n["children"]
    if ch is array then
        return ch
    end
    return []
end

func getChild(var n, string kind) as var
    var ch = n["children"]
    if ch is array then
        for c in ch
            var ck = c["kind"]
            if ck is string then
                if string(ck) == kind then
                    return c
                end
            end
        end
    end
    return null
end

func funcNameFromAst(var node) as string
    var nm = getChild(node, "name")
    if nm is null then
        return ""
    end
    return nodeText(nm)
end

func docOfNode(var n) as string
    var doc = n["doc"]
    if doc is string then
        return string(doc)
    end
    return ""
end

// 从 AST root 递归(迭代)提取符号
func extractSymbolsFromAst(var root, string filePath)
    int globalScope = 0
    // 栈元素: {node, scopeId, inClass}
    array nodeStack = []
    array scopeStack = []
    array inClassStack = []

    // 初始化: root 的直接子节点
    var rootChildren = childrenOf(root)
    for c in rootChildren
        nodeStack.push(c)
        scopeStack.push(globalScope)
        inClassStack.push(false)
    end

    while nodeStack.length > 0 do
        int last = nodeStack.length - 1
        var node = nodeStack[last]
        int curScope = int(scopeStack[last])
        bool inClass = bool(inClassStack[last])
        nodeStack.remove(last)
        scopeStack.remove(last)
        inClassStack.remove(last)

        string k = nodeKind(node)
        int ln = nodeLine(node)
        int col = nodeColumn(node)

        if k == "func" or k == "export_func" then
            string fname = funcNameFromAst(node)
            if string.len(fname) > 0 then
                Symbol sym = Symbol(fname, SYM_FUNC, filePath, ln, col)
                sym.signature = buildFuncSignature(node)
                sym.doc = docOfNode(node)
                int funcScope = newScope(SCOPE_FUNC, fname, curScope)
                registerSymbol(sym, curScope)
                // 处理参数
                var ch = childrenOf(node)
                for c in ch
                    string ck = nodeKind(c)
                    if ck == "param" then
                        string pname = nodeText(c)
                        if string.len(pname) > 0 then
                            Symbol psym = Symbol(pname, SYM_PARAM, filePath, nodeLine(c), nodeColumn(c))
                            psym.detail = "param of " + fname
                            registerSymbol(psym, funcScope)
                        end
                    end
                end
                // 不向下遍历函数体的局部变量 (简化)
            end
        elseif k == "class" then
            string cname = nodeText(node)
            if string.len(cname) > 0 then
                Symbol sym = Symbol(cname, SYM_CLASS, filePath, ln, col)
                sym.doc = docOfNode(node)
                int classScope = newScope(SCOPE_CLASS, cname, curScope)
                registerSymbol(sym, curScope)
                // 遍历 class 子节点: field / create / method
                var ch = childrenOf(node)
                for c in ch
                    string ck = nodeKind(c)
                    if ck == "field" then
                        string fname = nodeText(c)
                        if string.len(fname) > 0 then
                            Symbol fsym = Symbol(fname, SYM_FIELD, filePath, nodeLine(c), nodeColumn(c))
                            fsym.doc = docOfNode(c)
                            registerSymbol(fsym, classScope)
                        end
                    elseif ck == "func" or ck == "export_func" then
                        string mname = funcNameFromAst(c)
                        if string.len(mname) > 0 then
                            Symbol msym = Symbol(mname, SYM_FUNC, filePath, nodeLine(c), nodeColumn(c))
                            msym.signature = buildFuncSignature(c)
                            msym.detail = "method of " + cname
                            msym.doc = docOfNode(c)
                            registerSymbol(msym, classScope)
                        end
                    end
                end
            end
        elseif k == "var_decl" or k == "const_decl" then
            string vname = nodeText(node)
            if string.len(vname) > 0 then
                string kind = SYM_VAR
                if k == "const_decl" then
                    kind = SYM_CONST
                end
                Symbol sym = Symbol(vname, kind, filePath, ln, col)
                sym.doc = docOfNode(node)
                registerSymbol(sym, curScope)
            end
        end

        // 继续遍历子节点 (但不再进入已处理的 func/class 体内)
        if k != "func" and k != "export_func" and k != "class" then
            var ch = childrenOf(node)
            for c in ch
                nodeStack.push(c)
                scopeStack.push(curScope)
                inClassStack.push(inClass)
            end
        end
    end
end

// 从 AST func 节点构造签名 "func name(params)"
func buildFuncSignature(var node) as string
    string name = funcNameFromAst(node)
    string result = "func " + name + "("
    var ch = childrenOf(node)
    bool first = true
    for c in ch
        if nodeKind(c) == "param" then
            if not first then
                result = result + ", "
            end
            result = result + nodeText(c)
            first = false
        end
    end
    result = result + ")"
    // 返回类型
    for c in ch
        if nodeKind(c) == "return_type" then
            result = result + " as " + nodeText(c)
        end
    end
    return result
end

// 尝试用 xl parse 获取 AST，失败返回 null
func loadAst(string filePath) as var
    if string.len(g_xl) == 0 then
        return null
    end
    string absFile = path.abs(filePath)
    string cmd = g_xl + " parse " + absFile + " --format json"
    ProcessResult r = process.run(cmd, 60000)
    if not r.success then
        return null
    end
    string out = string.trim(r.stdout)
    if string.len(out) == 0 then
        return null
    end
    if not json.valid(out) then
        return null
    end
    try
        return json.parse(out)
    catch e
        return null
    end
end

// 加载文件并提取符号 (AST 优先，降级源码扫描)
func loadFileSymbols(string filePath)
    string text = ""
    try
        text = file.readText(filePath)
    catch e
        return
    end
    Document doc = Document(pathToUri(filePath), 0, text)
    g_documents[doc.uri] = doc

    var ast = loadAst(filePath)
    if not (ast is null) then
        extractSymbolsFromAst(ast, filePath)
    else
        scanFileSymbols(filePath, text)
    end
end

// ====================================================================
// URI 工具
// ====================================================================

func pathToUri(string p) as string
    string abs = path.abs(p)
    // Windows: file:///C:/...
    abs = string.replace(abs, "\\", "/")
    if string.startsWith(abs, "/") then
        return "file://" + abs
    end
    return "file:///" + abs
end

func uriToPath(string uri) as string
    if string.startsWith(uri, "file:///") then
        string p = string.slice(uri, 8)
        p = string.replace(p, "/", "\\")
        if string.len(p) >= 2 then
            if string.charAt(p, 1) == ":" then
                return p
            end
        end
        return "\\" + p
    end
    if string.startsWith(uri, "file://") then
        string p = string.slice(uri, 7)
        return string.replace(p, "/", "\\")
    end
    return uri
end

// ====================================================================
// 补全
// ====================================================================

func initKeywords() as array
    array kw = []
    kw.push("func")
    kw.push("class")
    kw.push("if")
    kw.push("then")
    kw.push("elseif")
    kw.push("else")
    kw.push("end")
    kw.push("while")
    kw.push("do")
    kw.push("for")
    kw.push("in")
    kw.push("return")
    kw.push("break")
    kw.push("continue")
    kw.push("try")
    kw.push("catch")
    kw.push("finally")
    kw.push("throw")
    kw.push("var")
    kw.push("auto")
    kw.push("const")
    kw.push("true")
    kw.push("false")
    kw.push("null")
    kw.push("self")
    kw.push("base")
    kw.push("create")
    kw.push("destroy")
    kw.push("as")
    kw.push("is")
    kw.push("new")
    kw.push("this")
    kw.push("super")
    kw.push("and")
    kw.push("or")
    kw.push("not")
    kw.push("public")
    kw.push("private")
    kw.push("protected")
    kw.push("static")
    kw.push("virtual")
    kw.push("override")
    kw.push("final")
