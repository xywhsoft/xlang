    end
    return 0
end

// ====================================================================
// 用法
// ====================================================================

func printUsage()
    println("xlsrv - xlang Language Server (LSP subset) v" + LSP_VERSION)
    println("")
    println("Usage:")
    println("  xlsrv analyze <file.xl> [--json]   Analyze file: symbols + scopes + diagnostics")
    println("  xlsrv symbols <file.xl>            List all symbols in file")
    println("  xlsrv check   <file.xl>            Run diagnostics only")
    println("  xlsrv stdio                        LSP stdio mode (frame parsing implemented)")
    println("  xlsrv test                         Run self-test")
    println("  xlsrv help                         Show this help")
    println("")
    println("LSP Methods:")
    println("  initialize, didOpen, didChange, completion, hover")
    println("  definition, references, diagnostics, documentSymbol")
    println("")
    println("Features:")
    println("  - JSON-RPC 2.0 frame parsing (Content-Length header)")
    println("  - Symbol table with global/function/class scopes")
    println("  - Auto-complete: keywords + variables + function names")
    println("  - Hover: function signature + doc comments")
    println("  - Go-to-definition: function/variable declaration")
    println("  - Find references: full-text symbol search")
    println("  - Diagnostics via 'xl check' + source scanning")
end

// ====================================================================
// 入口
// ====================================================================

func main(...) as int
    resetSymbols()

    if arg.length < 2 then
        printUsage()
        return 0
    end

    string cmd = string.lower(string(arg[1]))

    if cmd == "help" or cmd == "-h" or cmd == "--help" then
        printUsage()
        return 0
    end

    if cmd == "test" then
        return cmdTest()
    end

    if cmd == "stdio" then
        runStdio()
        return 0
    end

    if cmd == "analyze" then
        if arg.length < 3 then
            println("xlsrv: analyze requires a file path")
            println("  usage: xlsrv analyze <file.xl> [--json]")
            return 1
        end
        string filePath = string(arg[2])
        bool asJson = false
        int ai = 3
        while ai < arg.length do
            string a = string(arg[ai])
            if a == "--json" then
                asJson = true
            end
            ai += 1
        end
        return cmdAnalyze(filePath, asJson)
    end

    if cmd == "symbols" then
        if arg.length < 3 then
            println("xlsrv: symbols requires a file path")
            return 1
        end
        return cmdSymbols(string(arg[2]))
    end

    if cmd == "check" then
        if arg.length < 3 then
            println("xlsrv: check requires a file path")
            return 1
        end
        return cmdCheck(string(arg[2]))
    end

    println("xlsrv: unknown command '" + cmd + "'")
    println("")
    printUsage()
    return 1
end
