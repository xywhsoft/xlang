func   messy(  int a ,int b)as int
    if a>b then
    return  a-b
    else
    return a+b
    end
end

class   Point
int x=0
int y=0
create(int x,int y)
self.x=x
self.y=y
end
func   len( )as int
return self.x*self.x+self.y*self.y
end
end

