// xrobot - 2D 机器人模拟器（Robot Simulator）
//
// 一个完整的 2D 移动机器人仿真平台，综合验证 xlang 的：
//   * class 运算符协议（Vec2 / Pose 全套 __add__/__sub__/__mul__/__div__）
//   * class 继承（ControllerBase → VFHController / PotentialController）
//   * 泛型/数值计算（差速运动学、Bresenham、A*、RRT、势场）
//   * 2D 数组（占据栅格地图 array<float>）
//   * 二叉堆优先队列（A* 的 open set）
//   * 多态存储（array<var> 承载派生 Controller 实例 + as 还原 vtable）
//   * 完整命令行子命令、统计输出、ASCII 渲染
//
// 功能模块：
//   1. 2D 运动学：差速驱动模型 / 正运动学（编码器→位姿）/ 逆运动学（目标→轮速）
//   2. 传感器：激光雷达（ray casting）/ 碰撞（保险杠）/ 编码器（里程计）
//   3. 占据栅格地图：Bresenham 线扫空、端点占据、0=未知 / 0.5=空 / 1=占据
//   4. 路径规划：A*（栅格 + 二叉堆）+ RRT（快速随机树）
//   5. SLAM（简化）：里程计位姿估计 + 激光扫描地图构建
//   6. 避障：VFH（向量场直方图）+ 势场法（引力+斥力）
//
// 用法：
//   xrobot                                  打印用法
//   xrobot help                             打印用法
//   xrobot test                             运行全部单元测试
//   xrobot explore [steps]                  模拟机器人探索房间并建图
//                                           steps=默认 250 步
//   xrobot navigate [planner]               从 S 到 G 做 A*/RRT 导航
//                                           planner=astar(默认) 或 rrt
//   xrobot benchmark                        各模块耗时与吞吐基准
//
// 验证：
//   cd /d D:\GIT\x-lang\demo6\release
//   xl run projects\dev\xrobot\xrobot.xl test
//   xl run projects\dev\xrobot\xrobot.xl explore
//   xl run projects\dev\xrobot\xrobot.xl navigate astar
//   xl build projects\dev\xrobot\xrobot.xl -o projects\dev\xrobot\xrobot.exe
//
// 设计要点（结合 dev/README.md 与 BUGS.md）：
//   * 多态控制器：ControllerBase (virtual computeCommand) + 两个 override 子类，
//     始终以具体子类实例调用，array<var> 承载（见 BUG-RT1/RT2/RT3 说明）。
//   * 栅格地图用 1D array<float> 模拟 2D：cells[row * width + col]。
//   * A* 的开放集用自定义二叉堆 MinHeap（O(log n) push/pop）。
//   * 随机浮点用 random.u32()/2^32 包装，random.range 提供整数区间。
//   * 输出统一 ASCII 渲染：? 未知 / . 空地 / # 占据 / R 机器人 / * 路径 / S 起点 / G 终点。

// ============================================================================
// 全局常量
// ============================================================================

float PI = 3.14159265358979323846
float TWO_PI = 6.28318530717958647692
float HALF_PI = 1.57079632679489661923
float INF = 1.0e30
float EPS = 1.0e-9

// 占据栅格约定（README 要求）：0=未知 / 0.5=空 / 1=占据
float CELL_UNKNOWN = 0.0
float CELL_FREE = 0.5
float CELL_OCCUPIED = 1.0

// 占据更新阈值（用于规划时二值化栅格）
float OCC_THRESHOLD = 0.6
float FREE_THRESHOLD = 0.15

// ============================================================================
// 数学/随机辅助函数
// ============================================================================

func randF() as float
    return float(random.u32()) / 4294967296.0
end

func randRange(float lo, float hi) as float
    return lo + (hi - lo) * randF()
end

func clampF(float v, float lo, float hi) as float
    if v < lo then
        return lo
    end
    if v > hi then
        return hi
    end
    return v
end

func clampI(int v, int lo, int hi) as int
    if v < lo then
        return lo
    end
    if v > hi then
        return hi
    end
    return v
end

func degToRad(float deg) as float
    return deg * PI / 180.0
end

func radToDeg(float rad) as float
    return rad * 180.0 / PI
end

// 把角度规范化到 [-pi, pi)
func normalizeAngle(float a) as float
    float r = a
    while r >= PI do
        r = r - TWO_PI
    end
    while r < 0.0 - PI do
        r = r + TWO_PI
    end
    return r
end

func angleDiff(float a, float b) as float
    return normalizeAngle(a - b)
end

func squareF(float x) as float
    return x * x
end

func minF(float a, float b) as float
    if a < b then
        return a
    end
    return b
end

func maxF(float a, float b) as float
    if a > b then
        return a
    end
    return b
end

func minI(int a, int b) as int
    if a < b then
        return a
    end
    return b
end

func maxI(int a, int b) as int
    if a > b then
        return a
    end
    return b
end

func signF(float x) as float
    if x > 0.0 then
        return 1.0
    end
    if x < 0.0 then
        return 0.0 - 1.0
    end
    return 0.0
end

func approxEq(float a, float b, float tol) as bool
    float d = a - b
    if d < 0.0 then
        d = 0.0 - d
    end
    return d < tol
end

// 构造一个 length 长度、初始值为 init 的 int 数组
func makeIntArray(int length, int initVal) as array<int>
    array<int> a = array[initVal]
    int i = 1
    while i < length do
        a.push(initVal)
        i = i + 1
    end
    return a
end

// 构造一个 length 长度、初始值为 init 的 float 数组
func makeFloatArray(int length, float initVal) as array<float>
    array<float> a = array[initVal]
    int i = 1
    while i < length do
        a.push(initVal)
        i = i + 1
    end
    return a
end

// 构造一个 length 长度的空字符串数组
func makeStrArray(int length) as array<string>
    if length <= 0 then
        array<string> e = array[]
        return e
    end
    array<string> a = array[""]
    int i = 1
    while i < length do
        a.push("")
        i = i + 1
    end
    return a
end

// ============================================================================
// Vec2：二维向量，运算符协议
// ============================================================================

class Vec2
    derive value
    float x = 0.0
    float y = 0.0

    create()
        self.x = 0.0
        self.y = 0.0
    end

    create(float x, float y)
        self.x = x
        self.y = y
    end

    func __add__(Vec2 o) as Vec2
        Vec2 r = Vec2(self.x + o.x, self.y + o.y)
        return r
    end

    func __sub__(Vec2 o) as Vec2
        Vec2 r = Vec2(self.x - o.x, self.y - o.y)
        return r
    end

    func __neg__() as Vec2
        Vec2 r = Vec2(0.0 - self.x, 0.0 - self.y)
        return r
    end

    func __mul__(float s) as Vec2
        Vec2 r = Vec2(self.x * s, self.y * s)
        return r
    end

    func __div__(float s) as Vec2
        Vec2 r = Vec2(self.x / s, self.y / s)
        return r
    end

    func dot(Vec2 o) as float
        return self.x * o.x + self.y * o.y
    end

    func cross(Vec2 o) as float
        return self.x * o.y - self.y * o.x
    end

    func lengthSquared() as float
        return self.x * self.x + self.y * self.y
    end

    func length() as float
        return math.sqrt(self.lengthSquared())
    end

    func normalize() as Vec2
        float len = self.length()
        if len <= EPS then
            Vec2 z = Vec2(0.0, 0.0)
            return z
        end
        Vec2 r = self * (1.0 / len)
        return r
    end

    func distanceTo(Vec2 o) as float
        Vec2 d = self - o
        return d.length()
    end

    func angle() as float
        return math.atan2(self.y, self.x)
    end

    func __toString() as string
        return "(" + string.formatFloat(self.x, ".2") + "," + string.formatFloat(self.y, ".2") + ")"
    end
end

// 由角度直接构造单位向量
func vec2FromAngle(float a) as Vec2
    Vec2 v = Vec2(math.cos(a), math.sin(a))
    return v
end

// ============================================================================
// Pose：2D 位姿 (x, y, theta)
// ============================================================================

class Pose
    derive value
    float x = 0.0
    float y = 0.0
    float theta = 0.0

    create()
        self.x = 0.0
        self.y = 0.0
        self.theta = 0.0
    end

    create(float x, float y, float theta)
        self.x = x
        self.y = y
        self.theta = theta
    end

    func pos() as Vec2
        Vec2 v = Vec2(self.x, self.y)
        return v
    end

    func clone() as Pose
        Pose p = Pose(self.x, self.y, self.theta)
        return p
    end

    // 由弧形运动模型推进：v=线速度, w=角速度, dt=时间
    // 使用精确圆弧积分（曲率中心转动），与差速正运动学一致
    func arc(float v, float w, float dt)
        if math.abs(w) < EPS then
            self.x = self.x + v * math.cos(self.theta) * dt
            self.y = self.y + v * math.sin(self.theta) * dt
        else
            float rC = v / w
            self.x = self.x + rC * (math.sin(self.theta + w * dt) - math.sin(self.theta))
            self.y = self.y - rC * (math.cos(self.theta + w * dt) - math.cos(self.theta))
            self.theta = normalizeAngle(self.theta + w * dt)
        end
    end

    func distanceTo(Pose o) as float
        float dx = self.x - o.x
        float dy = self.y - o.y
        return math.sqrt(dx * dx + dy * dy)
    end

    func headingTo(Pose o) as float
        float dx = o.x - self.x
        float dy = o.y - self.y
        return math.atan2(dy, dx)
    end

    func __toString() as string
        return "(" + string.formatFloat(self.x, ".2") + "," + string.formatFloat(self.y, ".2") + "," + string.formatFloat(radToDeg(self.theta), ".1") + ")"
    end
end

// ============================================================================
// LineSeg：线段（墙壁）
// ============================================================================

class LineSeg
    derive value
    float x1 = 0.0
    float y1 = 0.0
    float x2 = 0.0
    float y2 = 0.0

    create(float x1, float y1, float x2, float y2)
        self.x1 = x1
        self.y1 = y1
        self.x2 = x2
        self.y2 = y2
    end
end

// ============================================================================
// Circle：圆形障碍物
// ============================================================================

class Circle
    derive value
    float cx = 0.0
    float cy = 0.0
    float radius = 1.0

    create(float cx, float cy, float radius)
        self.cx = cx
        self.cy = cy
        self.radius = radius
    end
end

// ============================================================================
// 射线相交计算（自由函数：避免 class 方法大数组参数）
// ============================================================================

// 射线 O + t*D（D 已归一化）与线段 (A,B) 求交。
// 命中返回 (true, t)；否则 (false, 0)。
func rayVsSegment(float ox, float oy, float dx, float dy,
                  float ax, float ay, float bx, float by) as (bool, float)
    float ex = bx - ax
    float ey = by - ay
    float fx = ax - ox
    float fy = ay - oy
    float det = dy * ex - dx * ey
    if math.abs(det) < 1.0e-12 then
        return false, 0.0
    end
    float t = (0.0 - fx * ey + ex * fy) / det
    float s = (dx * fy - dy * fx) / det
    if t > EPS and s >= 0.0 and s <= 1.0 then
        return true, t
    end
    return false, 0.0
end

// 射线 O + t*D（D 已归一化）与圆 (C,r) 求交，取最近正 t。
func rayVsCircle(float ox, float oy, float dx, float dy,
                 float cx, float cy, float r) as (bool, float)
    float ocx = ox - cx
    float ocy = oy - cy
    float b = ocx * dx + ocy * dy
    float c = ocx * ocx + ocy * ocy - r * r
    if c > 0.0 and b > 0.0 then
        return false, 0.0
    end
    float disc = b * b - c
    if disc < 0.0 then
        return false, 0.0
    end
    float sq = math.sqrt(disc)
    float t = 0.0 - b - sq
    if t > EPS then
        return true, t
    end
    t = 0.0 - b + sq
    if t > EPS then
        return true, t
    end
    return false, 0.0
end

// ============================================================================
// World：场景（线段墙 + 圆形障碍 + 边界）
// ============================================================================

class World
    array<var> walls = array[]
    array<var> circles = array[]
    float minX = 0.0
    float minY = 0.0
    float maxX = 10.0
    float maxY = 10.0

    create()
        self.walls = array[]
        self.circles = array[]
        self.minX = 0.0
        self.minY = 0.0
        self.maxX = 10.0
        self.maxY = 10.0
    end

    create(float minX, float minY, float maxX, float maxY)
        self.walls = array[]
        self.circles = array[]
        self.minX = minX
        self.minY = minY
        self.maxX = maxX
        self.maxY = maxY
    end

    func addWall(float x1, float y1, float x2, float y2)
        LineSeg s = LineSeg(x1, y1, x2, y2)
        self.walls.append(s)
    end

    func addCircle(float cx, float cy, float r)
        Circle c = Circle(cx, cy, r)
        self.circles.append(c)
    end

    func wallCount() as int
        return self.walls.length
    end

    func circleCount() as int
        return self.circles.length
    end

    // 添加矩形障碍的四条墙
    func addBox(float x1, float y1, float x2, float y2)
        self.addWall(x1, y1, x2, y1)
        self.addWall(x2, y1, x2, y2)
        self.addWall(x2, y2, x1, y2)
        self.addWall(x1, y2, x1, y1)
    end

    // 用边界四堵墙围住整个场景
    func addBoundaryWalls()
        self.addWall(self.minX, self.minY, self.maxX, self.minY)
        self.addWall(self.maxX, self.minY, self.maxX, self.maxY)
        self.addWall(self.maxX, self.maxY, self.minX, self.maxY)
        self.addWall(self.minX, self.maxY, self.minX, self.minY)
    end

    // 射线从 (ox,oy) 方向 (dx,dy)（单位向量）求最近障碍距离
    // 返回 (bool, dist, hitX, hitY)
    func castRay(float ox, float oy, float dx, float dy, float maxRange) as (bool, float, float, float)
        float bestT = maxRange
        bool hit = false
        int i = 0
        int n = self.walls.length
        while i < n do
            var wv = self.walls[i]
            LineSeg w = wv as LineSeg
            bool h
            float t
            h, t = rayVsSegment(ox, oy, dx, dy, w.x1, w.y1, w.x2, w.y2)
            if h and t < bestT then
                bestT = t
                hit = true
            end
            i = i + 1
        end
        int j = 0
        int m = self.circles.length
        while j < m do
            var cv = self.circles[j]
            Circle c = cv as Circle
            bool h
            float t
            h, t = rayVsCircle(ox, oy, dx, dy, c.cx, c.cy, c.radius)
            if h and t < bestT then
                bestT = t
                hit = true
            end
            j = j + 1
        end
        if hit then
            return true, bestT, ox + dx * bestT, oy + dy * bestT
        end
        return false, maxRange, ox + dx * maxRange, oy + dy * maxRange
    end

    // 点 (px,py) 到最近障碍的有符号距离（负=穿透），用于碰撞检测
    func clearanceAt(float px, float py) as float
        float best = INF
        int i = 0
        int n = self.walls.length
        while i < n do
            var wv = self.walls[i]
            LineSeg w = wv as LineSeg
            float d = pointSegDist(px, py, w.x1, w.y1, w.x2, w.y2)
            if d < best then
                best = d
            end
            i = i + 1
        end
        int j = 0
        int m = self.circles.length
        while j < m do
            var cv = self.circles[j]
            Circle c = cv as Circle
            float dx = px - c.cx
            float dy = py - c.cy
            float d = math.sqrt(dx * dx + dy * dy) - c.radius
            if d < best then
                best = d
            end
            j = j + 1
        end
        return best
    end
end

// 点到线段距离
func pointSegDist(float px, float py, float ax, float ay, float bx, float by) as float
    float ex = bx - ax
    float ey = by - ay
    float len2 = ex * ex + ey * ey
    if len2 < EPS then
        float ddx = px - ax
        float ddy = py - ay
        return math.sqrt(ddx * ddx + ddy * ddy)
    end
    float t = ((px - ax) * ex + (py - ay) * ey) / len2
    if t < 0.0 then
        t = 0.0
    end
    if t > 1.0 then
        t = 1.0
    end
    float cx = ax + t * ex
    float cy = ay + t * ey
    float dx = px - cx
    float dy = py - cy
    return math.sqrt(dx * dx + dy * dy)
end

// 线段 (a1,a2)-(b1,b2) 与世界所有障碍相交性测试（用于 RRT 碰撞）
func worldSegmentFree(World w, float ax, float ay, float bx, float by, float robotRadius) as bool
    float ex = bx - ax
    float ey = by - ay
    float len2 = ex * ex + ey * ey
    if len2 < EPS then
        float cl = w.clearanceAt(ax, ay)
        return cl > robotRadius
    end
    float segLen = math.sqrt(len2)
    int steps = int(segLen / 0.05)
    if steps < 2 then
        steps = 2
    end
    if steps > 400 then
        steps = 400
    end
    int i = 0
    while i <= steps do
        float t = float(i) / float(steps)
        float px = ax + ex * t
        float py = ay + ey * t
        float cl = w.clearanceAt(px, py)
        if cl <= robotRadius then
            return false
        end
        i = i + 1
    end
    return true
end

// ============================================================================
// GridMap：占据栅格地图
//   cells[row * width + col]，约定：0=未知 / 0.5=空 / 1=占据
// ============================================================================

class GridMap
    int width = 50
    int height = 50
    float resolution = 0.2     // 米/格
    float originX = 0.0        // cell(0,0) 对应世界坐标
    float originY = 0.0
    array<float> cells = array[]
    int knownCount = 0         // 已知（!= 0）格数
    int freeCount = 0
    int occupiedCount = 0

    create(int width, int height, float resolution, float originX, float originY)
        self.width = width
        self.height = height
        self.resolution = resolution
        self.originX = originX
        self.originY = originY
        int total = width * height
        self.cells = makeFloatArray(total, CELL_UNKNOWN)
        self.knownCount = 0
        self.freeCount = 0
        self.occupiedCount = 0
    end

    func sizeCells() as int
        return self.width * self.height
    end

    func worldWidth() as float
        return float(self.width) * self.resolution
    end

    func worldHeight() as float
        return float(self.height) * self.resolution
    end

    // 世界坐标 → 栅格下标 (cx, cy)，越界返回 false
    func worldToCell(float x, float y) as (bool, int, int)
        int cx = int((x - self.originX) / self.resolution)
        int cy = int((y - self.originY) / self.resolution)
        if cx < 0 or cx >= self.width then
            return false, 0, 0
        end
        if cy < 0 or cy >= self.height then
            return false, 0, 0
        end
        return true, cx, cy
    end

    // 栅格下标 → 世界坐标（cell 中心）
    func cellToWorld(int cx, int cy) as (float, float)
        float x = self.originX + (float(cx) + 0.5) * self.resolution
        float y = self.originY + (float(cy) + 0.5) * self.resolution
        return x, y
    end

    func inBounds(int cx, int cy) as bool
        if cx < 0 or cx >= self.width then
            return false
        end
        if cy < 0 or cy >= self.height then
            return false
        end
        return true
    end

    func getCell(int cx, int cy) as float
        if not self.inBounds(cx, cy) then
            return CELL_UNKNOWN
        end
        return self.cells[cy * self.width + cx]
    end

    // 直接覆盖某格的占据值（不增量更新），用于直接构造已知地图
    func setCell(int cx, int cy, float val)
        if not self.inBounds(cx, cy) then
            return
        end
        float clamped = clampF(val, 0.0, 1.0)
        self.cells[cy * self.width + cx] = clamped
    end

    // 用对数概率增量更新：occupied=true 加 logHit，false 加 logMiss
    // 用概率式增量更新：占据累加（封顶 0.97），空闲下拉（下限 0.2）。
    // 首次观测从未知起跳，保证单次占据观测即超过 OCC_THRESHOLD=0.6。
    func updateCell(int cx, int cy, bool occupied)
        if not self.inBounds(cx, cy) then
            return
        end
        int idx = cy * self.width + cx
        float p = self.cells[idx]
        if occupied then
            if p < EPS then
                p = 0.85
            else
                p = p + 0.15
            end
            if p > 0.97 then
                p = 0.97
            end
        else
            if p < EPS then
                p = 0.3
            else
                p = p - 0.05
            end
            if p < 0.2 then
                p = 0.2
            end
        end
        self.cells[idx] = p
    end

    func isOccupied(int cx, int cy) as bool
        return self.getCell(cx, cy) > OCC_THRESHOLD
    end

    func isFree(int cx, int cy) as bool
        float v = self.getCell(cx, cy)
        return v > FREE_THRESHOLD and v < OCC_THRESHOLD
    end

    func isUnknown(int cx, int cy) as bool
        float v = self.getCell(cx, cy)
        return v <= EPS or v == CELL_UNKNOWN
    end

    // 统计：未知/空/占据格数
    func recount()
        int unknown = 0
        int freeC = 0
        int occ = 0
        int n = self.cells.length
        int i = 0
        while i < n do
            float v = self.cells[i]
            if v <= EPS then
                unknown = unknown + 1
            elseif v < OCC_THRESHOLD then
                freeC = freeC + 1
            else
                occ = occ + 1
            end
            i = i + 1
        end
        self.knownCount = n - unknown
        self.freeCount = freeC
        self.occupiedCount = occ
    end

    // 用 Bresenham 把 (x0,y0)→(x1,y1) 沿途标记为 FREE，端点标记为 OCCUPIED。
    // (endIsHit=false 表示射线没命中，只标 FREE，不标端点)
    func raycastUpdate(int x0, int y0, int x1, int y1, bool endIsHit)
        int dx = int(math.abs(float(x1 - x0)))
        int dy = int(math.abs(float(y1 - y0)))
        int sx = 0
        if x1 > x0 then
            sx = 1
        elseif x1 < x0 then
            sx = -1
        end
        int sy = 0
        if y1 > y0 then
            sy = 1
        elseif y1 < y0 then
            sy = -1
        end
        int err = dx - dy
        int cx = x0
        int cy = y0
        bool done = false
        while not done do
            bool reachedEnd = (cx == x1) and (cy == y1)
            if reachedEnd then
                if endIsHit and self.inBounds(cx, cy) then
                    self.updateCell(cx, cy, true)
                end
                done = true
            else
                if self.inBounds(cx, cy) then
                    self.updateCell(cx, cy, false)
                end
                int e2 = 2 * err
                if e2 > 0 - dy then
                    err = err - dy
                    cx = cx + sx
                end
                if e2 < dx then
                    err = err + dx
                    cy = cy + sy
                end
            end
        end
    end

    // 用一次激光扫描更新地图
    //   ranges[i] 对应角度 angleMin + i*angleStep，range < maxRange 视为命中
    func integrateScan(Pose pose, array<float> ranges, float angleMin, float angleStep, float maxRange)
        bool originOk
        int ox
        int oy
        originOk, ox, oy = self.worldToCell(pose.x, pose.y)
        if not originOk then
            return
        end
        int n = ranges.length
        int i = 0
        while i < n do
            float rng = ranges[i]
            if rng > 0.0 then
                float ang = pose.theta + angleMin + float(i) * angleStep
                bool hit = rng < maxRange - EPS
                float r = rng
                if not hit then
                    r = maxRange
                end
                float ex = pose.x + r * math.cos(ang)
                float ey = pose.y + r * math.sin(ang)
                bool ok
                int cx
                int cy
                ok, cx, cy = self.worldToCell(ex, ey)
                if ok then
                    self.raycastUpdate(ox, oy, cx, cy, hit)
                end
            end
            i = i + 1
        end
    end

    // 把世界中的几何直接烘焙到地图（用于构造 ground-truth 已知地图）
    func bakeWorld(World w)
        // 边界与墙：把每条墙栅格化成占据
        int i = 0
        int n = w.walls.length
        while i < n do
            var wv = w.walls[i]
            LineSeg seg = wv as LineSeg
            self.bakeSegment(seg.x1, seg.y1, seg.x2, seg.y2)
            i = i + 1
        end
        // 圆形：扫描其外接圆周并填充
        int j = 0
        int m = w.circles.length
        while j < m do
            var cv = w.circles[j]
            Circle c = cv as Circle
            self.bakeCircle(c.cx, c.cy, c.radius)
            j = j + 1
        end
        // 烘焙之后未知格周围一圈改成空地（膨胀 free 区域使 A* 不卡在墙边）
        self.inflateFree()
        self.recount()
    end

    func bakeSegment(float ax, float ay, float bx, float by)
        bool oa
        int axc
        int ayc
        oa, axc, ayc = self.worldToCell(ax, ay)
        bool ob
        int bxc
        int byc
        ob, bxc, byc = self.worldToCell(bx, by)
        if not oa then
            oa, axc, ayc = self.clampCell(ax, ay)
        end
        if not ob then
            ob, bxc, byc = self.clampCell(bx, by)
        end
        int dx = int(math.abs(float(bxc - axc)))
        int dy = int(math.abs(float(byc - ayc)))
        int sx = 0
        if bxc > axc then
            sx = 1
        elseif bxc < axc then
            sx = -1
        end
        int sy = 0
        if byc > ayc then
            sy = 1
        elseif byc < ayc then
            sy = -1
        end
        int err = dx - dy
        int cx = axc
        int cy = ayc
        bool done = false
        while not done do
            // 在每个 Bresenham 步进点周围标记 3x3 块为占据（加粗墙体，便于规划避让）
            if self.inBounds(cx, cy) then
                int ddx = -1
                while ddx <= 1 do
                    int ddy = -1
                    while ddy <= 1 do
                        int tx = cx + ddx
                        int ty = cy + ddy
                        if self.inBounds(tx, ty) then
                            self.cells[ty * self.width + tx] = CELL_OCCUPIED
                        end
                        ddy = ddy + 1
                    end
                    ddx = ddx + 1
                end
            end
            if cx == bxc and cy == byc then
                done = true
            else
                int e2 = 2 * err
                if e2 > 0 - dy then
                    err = err - dy
                    cx = cx + sx
                end
                if e2 < dx then
                    err = err + dx
                    cy = cy + sy
                end
            end
        end
    end

    func bakeCircle(float cx, float cy, float r)
        int rad = int(r / self.resolution) + 1
        bool ok
        int ccx
        int ccy
        ok, ccx, ccy = self.worldToCell(cx, cy)
        if not ok then
            return
        end
        int i = 0 - rad
        while i <= rad do
            int j = 0 - rad
            while j <= rad do
                float d2 = float(i * i + j * j)
                float dist = math.sqrt(d2)
                if dist <= float(rad) then
                    int tx = ccx + i
                    int ty = ccy + j
                    if self.inBounds(tx, ty) then
                        self.cells[ty * self.width + tx] = CELL_OCCUPIED
                    end
                end
                j = j + 1
            end
            i = i + 1
        end
    end

    // 把靠近占据格的未知格保持未知，其余未知格设为 free（加速规划）
    func inflateFree()
        int n = self.cells.length
        int i = 0
        while i < n do
            if self.cells[i] < EPS then
                self.cells[i] = CELL_FREE
            end
            i = i + 1
        end
    end

    func clampCell(float x, float y) as (bool, int, int)
        int cx = int((x - self.originX) / self.resolution)
        int cy = int((y - self.originY) / self.resolution)
        cx = clampI(cx, 0, self.width - 1)
        cy = clampI(cy, 0, self.height - 1)
        return true, cx, cy
    end

    // 计算前沿（free-unknown 边界的 unknown 格）作为探索目标候选
    func computeFrontiers() as array<int>
        array<int> out = array[]
        int cy = 1
        while cy < self.height - 1 do
            int cx = 1
            while cx < self.width - 1 do
                float v = self.cells[cy * self.width + cx]
                if v > FREE_THRESHOLD and v < OCC_THRESHOLD then
                    // 4 邻居中有未知格则把未知格加入
                    int k = 0
                    while k < 4 do
                        int nx = cx
                        int ny = cy
                        if k == 0 then
                            nx = cx + 1
                        elseif k == 1 then
                            nx = cx - 1
                        elseif k == 2 then
                            ny = cy + 1
                        else
                            ny = cy - 1
                        end
                        float nv = self.cells[ny * self.width + nx]
                        if nv < EPS then
                            out.push(nx)
                            out.push(ny)
                        end
                        k = k + 1
                    end
                end
                cx = cx + 1
            end
            cy = cy + 1
        end
        return out
    end

    // 渲染整张地图为多行字符串。marks 为长度=width*height 的 array<string>，
    // 空串表示无标记，否则用该字符覆盖该格（用于叠加机器人/路径/起终点）。
    func render(array<string> marks) as array<string>
        array<string> rows = array[]
        int cy = self.height - 1
        while cy >= 0 do
            string line = ""
            int cx = 0
            while cx < self.width do
                int idx = cy * self.width + cx
                string mk = marks[idx]
                if string.len(mk) > 0 then
                    line = line + mk
                else
                    float v = self.cells[idx]
                    if v < EPS then
                        line = line + "?"
                    elseif v > OCC_THRESHOLD then
                        line = line + "#"
                    elseif v > FREE_THRESHOLD then
                        line = line + "."
                    else
                        line = line + "?"
                    end
                end
                cx = cx + 1
            end
            rows.append(line)
            cy = cy - 1
        end
        return rows
    end

    func renderNoMarks() as array<string>
        array<string> empty = makeStrArray(self.width * self.height)
        return self.render(empty)
    end
end

// ============================================================================
// 二叉堆优先队列（A* 用）
// ============================================================================

class HeapItem
    derive value
    float priority = 0.0
    int cellId = 0

    create()
        self.priority = 0.0
        self.cellId = 0
    end

    create(float priority, int cellId)
        self.priority = priority
        self.cellId = cellId
    end
end

class MinHeap
    array<var> data = array[]

    create()
        self.data = array[]
    end

    func size() as int
        return self.data.length
    end

    func empty() as bool
        return self.data.length == 0
    end

    func push(float priority, int cellId)
        HeapItem it = HeapItem(priority, cellId)
        self.data.append(it)
        self.siftUp(self.data.length - 1)
    end

    // 弹出 priority 最小项；空返回 (false, 0.0, 0)
    func pop() as (bool, float, int)
        int n = self.data.length
        if n == 0 then
            return false, 0.0, 0
        end
        var topVar = self.data[0]
        HeapItem top = topVar as HeapItem
        float pr = top.priority
        int cid = top.cellId
        var lastVar = self.data.pop()
        if self.data.length > 0 then
            self.data[0] = lastVar
            self.siftDown(0)
        end
        return true, pr, cid
    end

    func siftUp(int i)
        while i > 0 do
            int parent = (i - 1) / 2
            var iv = self.data[i]
            var pv = self.data[parent]
            HeapItem ii = iv as HeapItem
            HeapItem pp = pv as HeapItem
            if ii.priority < pp.priority then
                self.data[i] = pv
                self.data[parent] = iv
                i = parent
            else
                return
            end
        end
    end

    func siftDown(int i)
        int n = self.data.length
        bool done = false
        while not done do
            int left = 2 * i + 1
            int right = 2 * i + 2
            int smallest = i
            if left < n then
                var sv = self.data[smallest]
                var lv = self.data[left]
                HeapItem si = sv as HeapItem
                HeapItem li = lv as HeapItem
                if li.priority < si.priority then
                    smallest = left
                end
            end
            if right < n then
                var sv = self.data[smallest]
                var rv = self.data[right]
                HeapItem si = sv as HeapItem
                HeapItem ri = rv as HeapItem
                if ri.priority < si.priority then
                    smallest = right
                end
            end
            if smallest == i then
                done = true
            else
                var tmp = self.data[i]
                self.data[i] = self.data[smallest]
                self.data[smallest] = tmp
                i = smallest
            end
        end
    end

    func clear()
        self.data = array[]
    end
end

// ============================================================================
// A* 路径规划（栅格 + 8 连通 + 二叉堆开放集）
// ============================================================================

class AStarResult
    derive value
    bool found = false
    array<int> pathX = array[]
    array<int> pathY = array[]
    float cost = 0.0
    int visited = 0     // 扩展的节点数
    float elapsed = 0.0

    create()
        self.found = false
        self.pathX = array[]
        self.pathY = array[]
        self.cost = 0.0
        self.visited = 0
        self.elapsed = 0.0
    end
end

class AStarPlanner
    GridMap map = GridMap(1, 1, 1.0, 0.0, 0.0)
    // 8 连通偏移（dx, dy），在 create 中初始化
    array<int> neighborDx = array[]
    array<int> neighborDy = array[]

    create(GridMap m)
        self.map = m
        self.neighborDx = array[1, -1, 0, 0, 1, 1, -1, -1]
        self.neighborDy = array[0, 0, 1, -1, 1, -1, 1, -1]
    end

    // 两点（cell 坐标）间的 octile 距离
    func heuristic(int x1, int y1, int x2, int y2) as float
        int dx = int(math.abs(float(x1 - x2)))
        int dy = int(math.abs(float(y1 - y2)))
        int dmin = minI(dx, dy)
        int dmax = maxI(dx, dy)
        // sqrt(2)*dmin + (dmax - dmin)
        return 1.41421356 * float(dmin) + float(dmax - dmin)
    end

    func passable(int cx, int cy) as bool
        if not self.map.inBounds(cx, cy) then
            return false
        end
        // 占据格不可通行；未知格也不通行（保守规划）
        float v = self.map.cells[cy * self.map.width + cx]
        if v >= OCC_THRESHOLD then
            return false
        end
        if v < EPS then
            return false
        end
        return true
    end

    func plan(int sx, int sy, int gx, int gy) as AStarResult
        AStarResult result = AStarResult()
        int w = self.map.width
        int h = self.map.height
        int total = w * h
        float t0 = time.timer()

        if not self.passable(sx, sy) then
            result.elapsed = time.timer() - t0
            return result
        end
        if not self.passable(gx, gy) then
            result.elapsed = time.timer() - t0
            return result
        end
        int startId = sy * w + sx
        int goalId = gy * w + gx

        // gScore / fScore 用大数组；-1 表示未访问（INF）
        array<float> gScore = makeFloatArray(total, 0.0 - 1.0)
        array<int> cameFrom = makeIntArray(total, -1)
        // closed 用 int 数组模拟（0=未关闭 1=已关闭）
        array<int> closed = makeIntArray(total, 0)

        MinHeap open = MinHeap()
        gScore[startId] = 0.0
        float f0 = self.heuristic(sx, sy, gx, gy)
        open.push(f0, startId)

        int visited = 0
        bool reached = false

        bool done = false
        while not done do
            bool ok
            float pr
            int cur
            ok, pr, cur = open.pop()
            if not ok then
                done = true
            else
                if cur == goalId then
                    reached = true
                    done = true
                else
                    if closed[cur] == 0 then
                        closed[cur] = 1
                        visited = visited + 1
                        int cx = cur % w
                        int cy = cur / w
                        int k = 0
                        while k < 8 do
                            int nx = cx + self.neighborDx[k]
                            int ny = cy + self.neighborDy[k]
                            if self.passable(nx, ny) then
                                int nid = ny * w + nx
                                if closed[nid] == 0 then
                                    float step = 1.0
                                    if k >= 4 then
                                        step = 1.41421356
                                    end
                                    float tentative = gScore[cur] + step
                                    if gScore[nid] < 0.0 or tentative < gScore[nid] then
                                        gScore[nid] = tentative
                                        cameFrom[nid] = cur
                                        float f = tentative + self.heuristic(nx, ny, gx, gy)
                                        open.push(f, nid)
                                    end
                                end
                            end
                            k = k + 1
                        end
                    end
                end
            end
        end

        result.visited = visited
        if reached then
            // 回溯路径
            array<int> revX = array[]
            array<int> revY = array[]
            int cur = goalId
            bool traceDone = false
            while not traceDone do
                int cx = cur % w
                int cy = cur / w
                revX.push(cx)
                revY.push(cy)
                if cur == startId then
                    traceDone = true
                else
                    int p = cameFrom[cur]
                    if p < 0 then
                        traceDone = true
                    else
                        cur = p
                    end
                end
            end
            // 反转
            int len = revX.length
            int i = len - 1
            while i >= 0 do
                result.pathX.push(revX[i])
                result.pathY.push(revY[i])
                i = i - 1
            end
            result.found = true
            result.cost = gScore[goalId]
        end
        result.elapsed = time.timer() - t0
        return result
    end
end

// ============================================================================
// RRT 路径规划（快速随机树，连续空间 + 离散碰撞检查）
// ============================================================================

class RRTNode
    derive value
    float x = 0.0
    float y = 0.0
    int parentId = -1

    create()
        self.x = 0.0
        self.y = 0.0
        self.parentId = -1
    end

    create(float x, float y, int parentId)
        self.x = x
        self.y = y
        self.parentId = parentId
    end
end

class RRTResult
    derive value
    bool found = false
    array<float> pathX = array[]
    array<float> pathY = array[]
    int nodeCount = 0
    int iterations = 0
    float elapsed = 0.0

    create()
        self.found = false
        self.pathX = array[]
        self.pathY = array[]
        self.nodeCount = 0
        self.iterations = 0
        self.elapsed = 0.0
    end
end

class RRTPlanner
    World world = World()
    float minX = 0.0
    float minY = 0.0
    float maxX = 10.0
    float maxY = 10.0
    float robotRadius = 0.2
    float stepSize = 0.4
    float goalBias = 0.1
    float goalTolerance = 0.4

    create(World w)
        self.world = w
        self.minX = w.minX
        self.minY = w.minY
        self.maxX = w.maxX
        self.maxY = w.maxY
    end

    func nearestNode(array<var> nodes, float x, float y) as int
        int best = 0
        float bestD2 = INF
        int n = nodes.length
        int i = 0
        while i < n do
            var nv = nodes[i]
            RRTNode nn = nv as RRTNode
            float dx = nn.x - x
            float dy = nn.y - y
            float d2 = dx * dx + dy * dy
            if d2 < bestD2 then
                bestD2 = d2
                best = i
            end
            i = i + 1
        end
        return best
    end

    func plan(float sx, float sy, float gx, float gy, int maxIter) as RRTResult
        RRTResult result = RRTResult()
        float t0 = time.timer()
        array<var> nodes = array[]

        if not worldSegmentFree(self.world, sx, sy, sx, sy, self.robotRadius) then
            result.elapsed = time.timer() - t0
            return result
        end
        RRTNode root = RRTNode(sx, sy, -1)
        nodes.append(root)

        int iter = 0
        bool reached = false
        bool done = false
        while not done do
            iter = iter + 1
            if iter > maxIter then
                done = true
            else
                float rx
                float ry
                if randF() < self.goalBias then
                    rx = gx
                    ry = gy
                else
                    rx = randRange(self.minX, self.maxX)
                    ry = randRange(self.minY, self.maxY)
                end
                int nearId = self.nearestNode(nodes, rx, ry)
                var nv = nodes[nearId]
                RRTNode nearNode = nv as RRTNode
                float dx = rx - nearNode.x
                float dy = ry - nearNode.y
                float dlen = math.sqrt(dx * dx + dy * dy)
                if dlen < EPS then
                    // 重采样
                else
                    float ux = dx / dlen
                    float uy = dy / dlen
                    float step = self.stepSize
                    if dlen < step then
                        step = dlen
                    end
                    float newX = nearNode.x + ux * step
                    float newY = nearNode.y + uy * step
                    if worldSegmentFree(self.world, nearNode.x, nearNode.y, newX, newY, self.robotRadius) then
                        RRTNode newNode = RRTNode(newX, newY, nearId)
                        nodes.append(newNode)
                        // 检查是否到达目标
                        float gdx = newX - gx
                        float gdy = newY - gy
                        float gd = math.sqrt(gdx * gdx + gdy * gdy)
                        if gd < self.goalTolerance then
                            if worldSegmentFree(self.world, newX, newY, gx, gy, self.robotRadius) then
                                RRTNode goalNode = RRTNode(gx, gy, nodes.length - 1)
                                nodes.append(goalNode)
                                reached = true
                                done = true
                            end
                        end
                    end
                end
            end
        end

        result.iterations = iter
        result.nodeCount = nodes.length
        if reached then
            // 从最后一个节点回溯
            array<float> revX = array[]
            array<float> revY = array[]
            int cur = nodes.length - 1
            bool backDone = false
            while not backDone do
                var cv = nodes[cur]
                RRTNode cn = cv as RRTNode
                revX.push(cn.x)
                revY.push(cn.y)
                if cn.parentId < 0 then
                    backDone = true
                else
                    cur = cn.parentId
                end
            end
            int len = revX.length
            int i = len - 1
            while i >= 0 do
                result.pathX.push(revX[i])
                result.pathY.push(revY[i])
                i = i - 1
            end
            result.found = true
        end
        result.elapsed = time.timer() - t0
        return result
    end
end

// ============================================================================
// 避障控制器基类（virtual computeCommand）
//   多态存储说明：与 raytrace 同样，子类实例统一通过 array<var> 承载，
//   取出后用 as ControllerBase 还原以触发 vtable 派发。
// ============================================================================

class ControllerBase
    float maxLin = 0.5     // 最大线速度
    float maxAng = 1.2     // 最大角速度

    create()
        self.maxLin = 0.5
        self.maxAng = 1.2
    end

    create(float maxLin, float maxAng)
        self.maxLin = maxLin
        self.maxAng = maxAng
    end

    // 子类 override：根据当前位姿/目标/雷达返回 (v, w)
    virtual func computeCommand(Pose pose, Vec2 goal, array<float> ranges, float angleMin, float angleStep) as (float, float)
        return 0.0, 0.0
    end

    virtual func describe() as string
        return "base"
    end
end

// ============================================================================
// VFH 控制器：向量场直方图
//   1) 把雷达扇形 bins 化成极坐标直方图（高=近障碍）
//   2) 选取朝目标方向且代价最低的扇区
//   3) 输出 (v, w)
// ============================================================================

class VFHController extends ControllerBase
    int sectors = 36            // 360°/36 = 10°/扇区
    float safeDist = 1.0        // 小于此距离开始排斥
    float stopDist = 0.4        // 小于此距离强制停止
    float sectorThreshold = 5.0 // 直方图阈值

    create(float maxLin, float maxAng)
        base(maxLin, maxAng)
        self.sectors = 36
        self.safeDist = 1.0
        self.stopDist = 0.4
        self.sectorThreshold = 5.0
    end

    override func describe() as string
        return "VFH"
    end

    override func computeCommand(Pose pose, Vec2 goal, array<float> ranges, float angleMin, float angleStep) as (float, float)
        int numSect = self.sectors
        array<float> hist = makeFloatArray(numSect, 0.0)

        // 构建直方图
        int n = ranges.length
        int i = 0
        bool tooClose = false
        while i < n do
            float r = ranges[i]
            if r < self.safeDist then
                float ang = angleMin + float(i) * angleStep
                int bin = int((normalizeAngle(ang) + PI) / TWO_PI * float(numSect))
                if bin < 0 then
                    bin = 0
                end
                if bin >= numSect then
                    bin = numSect - 1
                end
                float certainty = 1.0
                if r > EPS then
                    certainty = (self.safeDist - r) / self.safeDist
                end
                float mag = certainty * certainty * (self.safeDist - r)
                hist[bin] = hist[bin] + mag
                // 扩散到邻居
                if bin > 0 then
                    hist[bin - 1] = hist[bin - 1] + mag * 0.5
                end
                if bin < numSect - 1 then
                    hist[bin + 1] = hist[bin + 1] + mag * 0.5
                end
                if r < self.stopDist then
                    tooClose = true
                end
            end
            i = i + 1
        end

        // 目标方向（机器人坐标系）
        float gx = goal.x - pose.x
        float gy = goal.y - pose.y
        float goalAng = math.atan2(gy, gx)
        float rel = normalizeAngle(goalAng - pose.theta)
        int goalBin = int((rel + PI) / TWO_PI * float(numSect))
        if goalBin < 0 then
            goalBin = 0
        end
        if goalBin >= numSect then
            goalBin = numSect - 1
        end

        // 找到候选扇区（hist < threshold），按与 goalBin 的距离选择
        int bestBin = -1
        float bestCost = INF
        int k = 0
        while k < numSect do
            if hist[k] < self.sectorThreshold then
                int diff = int(math.abs(float(k - goalBin)))
                int wrap = numSect - diff
                if wrap < diff then
                    diff = wrap
                end
                float cost = float(diff) * 1.0 + hist[k] * 0.5
                if cost < bestCost then
                    bestCost = cost
                    bestBin = k
                end
            end
            k = k + 1
        end

        if bestBin < 0 then
            // 无可走扇区，原地旋转
            return 0.0, self.maxAng * 0.5
        end

        // 计算目标角速度
        float sectorMid = (float(bestBin) + 0.5) * TWO_PI / float(numSect) - PI
        float w = clampF(sectorMid * 2.0, 0.0 - self.maxAng, self.maxAng)
        if tooClose then
            return 0.0, w
        end
        // 角速度大就慢走
        float vScale = 1.0 - math.abs(sectorMid) / PI
        vScale = clampF(vScale, 0.0, 1.0)
        float v = self.maxLin * (0.3 + 0.7 * vScale)
        return v, w
    end
end

// ============================================================================
// 势场法控制器：引力（朝目标）+ 斥力（远离障碍）
// ============================================================================

class PotentialController extends ControllerBase
    float kAtt = 1.5
    float kRep = 2.5
    float repRange = 1.2

    create(float maxLin, float maxAng)
        base(maxLin, maxAng)
        self.kAtt = 1.5
        self.kRep = 2.5
        self.repRange = 1.2
    end

    override func describe() as string
        return "Potential"
    end

    override func computeCommand(Pose pose, Vec2 goal, array<float> ranges, float angleMin, float angleStep) as (float, float)
        // 引力
        float dx = goal.x - pose.x
        float dy = goal.y - pose.y
        float dGoal = math.sqrt(dx * dx + dy * dy)
        float attX = 0.0
        float attY = 0.0
        if dGoal > EPS then
            // 当目标较远用线性增长，近处用 1/r 收敛避免抖动
            if dGoal > 1.0 then
                attX = self.kAtt * dx / dGoal
                attY = self.kAtt * dy / dGoal
            else
                attX = self.kAtt * dx
                attY = self.kAtt * dy
            end
        end

        // 斥力：从每个雷达命中点向机器人推
        float repX = 0.0
        float repY = 0.0
        int n = ranges.length
        int i = 0
        while i < n do
            float r = ranges[i]
            if r < self.repRange and r > EPS then
                float ang = angleMin + float(i) * angleStep
                // 命中点相对机器人的世界方向
                float angW = pose.theta + ang
                float ox = pose.x + r * math.cos(angW)
                float oy = pose.y + r * math.sin(angW)
                float vx = pose.x - ox
                float vy = pose.y - oy
                float dist = math.sqrt(vx * vx + vy * vy)
                if dist > EPS then
                    float diff = self.repRange - r
                    float mag = self.kRep * diff * diff
                    repX = repX + mag * vx / (dist * r)
                    repY = repY + mag * vy / (dist * r)
                end
            end
            i = i + 1
        end

        float fx = attX + repX
        float fy = attY + repY
        float fmag = math.sqrt(fx * fx + fy * fy)
        if fmag < EPS then
            return 0.0, 0.0
        end

        float desiredAng = math.atan2(fy, fx)
        float err = normalizeAngle(desiredAng - pose.theta)
        float w = clampF(2.0 * err, 0.0 - self.maxAng, self.maxAng)
        // 角误差越大走得越慢
        float vScale = 1.0 - math.abs(err) / PI
        vScale = clampF(vScale, 0.0, 1.0)
        float v = self.maxLin * (0.3 + 0.7 * vScale)
        return v, w
    end
end

// ============================================================================
// Robot：差速驱动机器人
//   状态：位姿、速度、轮速、累计编码器、保险杠
// ============================================================================

class Robot
    derive value
    // 位姿与速度
    float x = 0.0
    float y = 0.0
    float theta = 0.0
    float v = 0.0       // 当前线速度
    float w = 0.0       // 当前角速度

    // 几何与机械
    float wheelBase = 0.4      // 左右轮间距
    float wheelRadius = 0.05   // 轮半径
    float radius = 0.18        // 车体半径（碰撞）
    float maxLin = 0.5
    float maxAng = 1.2

    // 轮速（内部）
    float vLeft = 0.0
    float vRight = 0.0

    // 编码器：累计行进距离（每轮）
    float encLeft = 0.0
    float encRight = 0.0

    // 保险杠
    bool bumper = false

    // 激光雷达参数
    int lidarCount = 72
    float lidarMin = 0.0 - PI
    float lidarMax = PI
    float lidarStep = 0.0
    float lidarMaxRange = 6.0
    array<float> ranges = array[]

    create()
        self.x = 0.0
        self.y = 0.0
        self.theta = 0.0
        self.v = 0.0
        self.w = 0.0
        self.wheelBase = 0.4
        self.wheelRadius = 0.05
        self.radius = 0.18
        self.maxLin = 0.5
        self.maxAng = 1.2
        self.vLeft = 0.0
        self.vRight = 0.0
        self.encLeft = 0.0
        self.encRight = 0.0
        self.bumper = false
        self.lidarCount = 72
        self.lidarMin = 0.0 - PI
        self.lidarMax = PI
        self.lidarStep = (self.lidarMax - self.lidarMin) / float(self.lidarCount)
        self.lidarMaxRange = 6.0
        self.ranges = makeFloatArray(self.lidarCount, self.lidarMaxRange)
    end

    create(float x, float y, float theta)
        self.x = x
        self.y = y
        self.theta = theta
        self.v = 0.0
        self.w = 0.0
        self.wheelBase = 0.4
        self.wheelRadius = 0.05
        self.radius = 0.18
        self.maxLin = 0.5
        self.maxAng = 1.2
        self.vLeft = 0.0
        self.vRight = 0.0
        self.encLeft = 0.0
        self.encRight = 0.0
        self.bumper = false
        self.lidarCount = 72
        self.lidarMin = 0.0 - PI
        self.lidarMax = PI
        self.lidarStep = (self.lidarMax - self.lidarMin) / float(self.lidarCount)
        self.lidarMaxRange = 6.0
        self.ranges = makeFloatArray(self.lidarCount, self.lidarMaxRange)
    end

    func pose() as Pose
        Pose p = Pose(self.x, self.y, self.theta)
        return p
    end

    func setPose(float x, float y, float theta)
        self.x = x
        self.y = y
        self.theta = theta
    end

    // ===== 运动学：差速驱动 =====

    // 由目标 (v,w) 反解轮速（逆运动学）
    func inverseKinematics(float targetV, float targetW) as (float, float)
        float vL = targetV - 0.5 * self.wheelBase * targetW
        float vR = targetV + 0.5 * self.wheelBase * targetW
        return vL, vR
    end

    // 由轮速正解 (v,w)（正运动学）
    func forwardKinematics(float vL, float vR) as (float, float)
        float v = (vL + vR) * 0.5
        float w = (vR - vL) / self.wheelBase
        return v, w
    end

    // 由编码器累计行程差直接得位姿增量（用于 SLAM 估计）
    //   dEncL/dEncR 为本次 dt 内左右轮增量（米）
    //   返回新位姿 (x, y, theta)
    func poseFromEncoders(float dEncL, float dEncR) as (float, float, float)
        float dL = dEncL
        float dR = dEncR
        float dCenter = (dR + dL) * 0.5
        float dTheta = (dR - dL) / self.wheelBase
        float nx = 0.0
        float ny = 0.0
        if math.abs(dTheta) < EPS then
            nx = self.x + dCenter * math.cos(self.theta)
            ny = self.y + dCenter * math.sin(self.theta)
        else
            float rC = dCenter / dTheta
            nx = self.x + rC * (math.sin(self.theta + dTheta) - math.sin(self.theta))
            ny = self.y - rC * (math.cos(self.theta + dTheta) - math.cos(self.theta))
        end
        float nTheta = normalizeAngle(self.theta + dTheta)
        return nx, ny, nTheta
    end

    // 设置轮速（同时更新编码器）
    func setWheelSpeeds(float vL, float vR, float dt)
        self.vLeft = vL
        self.vRight = vR
        // 计算合成 (v,w)
        float v
        float w
        v, w = self.forwardKinematics(vL, vR)
        v = clampF(v, 0.0 - self.maxLin, self.maxLin)
        w = clampF(w, 0.0 - self.maxAng, self.maxAng)
        self.v = v
        self.w = w
        // 弧形更新
        float oldX = self.x
        float oldY = self.y
        if math.abs(w) < EPS then
            self.x = self.x + v * math.cos(self.theta) * dt
            self.y = self.y + v * math.sin(self.theta) * dt
        else
            float rC = v / w
            self.x = self.x + rC * (math.sin(self.theta + w * dt) - math.sin(self.theta))
            self.y = self.y - rC * (math.cos(self.theta + w * dt) - math.cos(self.theta))
            self.theta = normalizeAngle(self.theta + w * dt)
        end
        // 编码器累计
        float dx = self.x - oldX
        float dy = self.y - oldY
        float dist = math.sqrt(dx * dx + dy * dy)
        if dist > EPS then
            // 由合成位移与角速度反推左右轮增量
            float dL = dist - 0.5 * self.wheelBase * w * dt
            float dR = dist + 0.5 * self.wheelBase * w * dt
            self.encLeft = self.encLeft + dL
            self.encRight = self.encRight + dR
        end
    end

    // 直接设置目标 (v,w)（内部转换为轮速）
    func setCommand(float targetV, float targetW, float dt)
        float tv = clampF(targetV, 0.0 - self.maxLin, self.maxLin)
        float tw = clampF(targetW, 0.0 - self.maxAng, self.maxAng)
        float vL
        float vR
        vL, vR = self.inverseKinematics(tv, tw)
        self.setWheelSpeeds(vL, vR, dt)
    end

    // ===== 传感器 =====

    // 执行一次激光扫描（ray casting），结果存 self.ranges
    func senseLidar(World w)
        int i = 0
        int n = self.lidarCount
        while i < n do
            float ang = self.theta + self.lidarMin + float(i) * self.lidarStep
            float dx = math.cos(ang)
            float dy = math.sin(ang)
            bool hit
            float dist
            float hx
            float hy
            hit, dist, hx, hy = w.castRay(self.x, self.y, dx, dy, self.lidarMaxRange)
            self.ranges[i] = dist
            i = i + 1
        end
    end

    // 保险杠：车体半径内是否有障碍
    func senseBumper(World w) as bool
        float cl = w.clearanceAt(self.x, self.y)
        if cl < self.radius then
            self.bumper = true
            return true
        end
        self.bumper = false
        return false
    end

    // 累计里程计距离
    func odometry() as float
        return (self.encLeft + self.encRight) * 0.5
    end

    // 返回当前激光扫描的副本
    func rangesCopy() as array<float>
        array<float> out = array[]
        int n = self.ranges.length
        int i = 0
        while i < n do
            out.push(self.ranges[i])
            i = i + 1
        end
        return out
    end

    // 取最小前方距离（前向 ±30° 范围）
    func frontClearance() as float
        float best = self.lidarMaxRange
        int n = self.lidarCount
        int i = 0
        while i < n do
            float ang = self.lidarMin + float(i) * self.lidarStep
            if math.abs(ang) < degToRad(30.0) then
                if self.ranges[i] < best then
                    best = self.ranges[i]
                end
            end
            i = i + 1
        end
        return best
    end
end

// ============================================================================
// SLAM 系统集成：里程计位姿估计 + 激光栅格地图构建
// ============================================================================

class SlamSystem
    Pose estPose = Pose(0.0, 0.0, 0.0)
    GridMap map = GridMap(1, 1, 1.0, 0.0, 0.0)
    float lastEncL = 0.0
    float lastEncR = 0.0
    bool firstFrame = true
    int scanCount = 0
    float mappedCells = 0.0

    create(GridMap m, Pose initial)
        self.map = m
        Pose p = initial.clone()
        self.estPose = p
        self.lastEncL = 0.0
        self.lastEncR = 0.0
        self.firstFrame = true
        self.scanCount = 0
        self.mappedCells = 0.0
    end

    // 用机器人编码器+激光更新估计位姿与地图
    func update(Robot r)
        if self.firstFrame then
            self.lastEncL = r.encLeft
            self.lastEncR = r.encRight
            self.firstFrame = false
        end
        float dEncL = r.encLeft - self.lastEncL
        float dEncR = r.encRight - self.lastEncR
        self.lastEncL = r.encLeft
        self.lastEncR = r.encRight

        // 1) 里程计预测位姿
        float nx
        float ny
        float ntheta
        // 用 SLAM 估计位姿继续推进，而不是 Robot.x/y（演示独立位姿链）
        Pose p = self.estPose
        float dCenter = (dEncR + dEncL) * 0.5
        float dTheta = (dEncR - dEncL) / r.wheelBase
        if math.abs(dTheta) < EPS then
            nx = p.x + dCenter * math.cos(p.theta)
            ny = p.y + dCenter * math.sin(p.theta)
            ntheta = p.theta
        else
            float rC = dCenter / dTheta
            nx = p.x + rC * (math.sin(p.theta + dTheta) - math.sin(p.theta))
            ny = p.y - rC * (math.cos(p.theta + dTheta) - math.cos(p.theta))
            ntheta = normalizeAngle(p.theta + dTheta)
        end
        self.estPose.x = nx
        self.estPose.y = ny
        self.estPose.theta = ntheta

        // 2) 用激光扫描更新地图
        self.map.integrateScan(self.estPose, r.ranges, r.lidarMin, r.lidarStep, r.lidarMaxRange)
        self.scanCount = self.scanCount + 1
    end

    func describe() as string
        return "SLAM scans=" + string(self.scanCount) + " pose=" + self.estPose.__toString()
    end
end

// ============================================================================
// 世界构造：标准测试房间
// ============================================================================

// 10m x 10m 房间，含边界 + 几个内墙/障碍
func buildStandardWorld() as World
    World w = World(0.0, 0.0, 10.0, 10.0)
    w.addBoundaryWalls()
    // 内部障碍：两个矩形箱
    w.addBox(3.0, 3.0, 4.0, 4.5)
    w.addBox(6.0, 5.5, 7.5, 7.0)
    // 圆形障碍
    w.addCircle(2.5, 7.5, 0.5)
    w.addCircle(7.0, 2.5, 0.6)
    // 一段隔墙
    w.addWall(5.0, 1.0, 5.0, 3.0)
    return w
end

// 较简单房间（test 命令用）
func buildSimpleWorld() as World
    World w = World(0.0, 0.0, 6.0, 6.0)
    w.addBoundaryWalls()
    w.addBox(2.0, 2.0, 3.0, 3.5)
    w.addCircle(4.5, 4.5, 0.4)
    return w
end

// 由世界边界生成对应 GridMap
func worldToMap(World w, float resolution) as GridMap
    float wW = w.maxX - w.minX
    float wH = w.maxY - w.minY
    int cols = int(wW / resolution)
    int rows = int(wH / resolution)
    if cols < 5 then
        cols = 5
    end
    if rows < 5 then
        rows = 5
    end
    GridMap m = GridMap(cols, rows, resolution, w.minX, w.minY)
    return m
end

// ============================================================================
// 简单的位置控制器：跟随路径（cell 列表）
//   每帧朝下一个 waypoint 行进，到达后弹出。
// ============================================================================

func pathFollowCommand(Robot r, GridMap m, array<int> pathX, array<int> pathY, int cursorIdx) as (int, float, float)
    int n = pathX.length
    if cursorIdx >= n then
        return cursorIdx, 0.0, 0.0
    end
    int cx = pathX[cursorIdx]
    int cy = pathY[cursorIdx]
    float wx
    float wy
    wx, wy = m.cellToWorld(cx, cy)
    float dx = wx - r.x
    float dy = wy - r.y
    float dist = math.sqrt(dx * dx + dy * dy)
    float reachTol = m.resolution * 1.2
    if dist < reachTol then
        // 进入下一个 waypoint
        int next = cursorIdx + 1
        if next >= n then
            return cursorIdx, 0.0, 0.0
        end
        return next, 0.0, 0.0
    end
    float desiredAng = math.atan2(dy, dx)
    float err = normalizeAngle(desiredAng - r.theta)
    float w = clampF(1.5 * err, 0.0 - r.maxAng, r.maxAng)
    float vScale = 1.0 - math.abs(err) / PI
    vScale = clampF(vScale, 0.0, 1.0)
    float v = r.maxLin * (0.4 + 0.6 * vScale)
    return cursorIdx, v, w
end

// ============================================================================
// 渲染辅助：在 GridMap 上叠加机器人/路径标记
// ============================================================================

func buildMarksForMap(GridMap m, Robot r, array<int> pathX, array<int> pathY,
                       int sx, int sy, int gx, int gy, bool showPath) as array<string>
    int total = m.width * m.height
    array<string> marks = makeStrArray(total)
    // 机器人位姿
    bool ok
    int rx
    int ry
    ok, rx, ry = m.worldToCell(r.x, r.y)
    if ok then
        int idx = ry * m.width + rx
        marks[idx] = "R"
    end
    // 起点/终点
    if m.inBounds(sx, sy) then
        marks[sy * m.width + sx] = "S"
    end
    if m.inBounds(gx, gy) then
        marks[gy * m.width + gx] = "G"
    end
    // 路径
    if showPath then
        int n = pathX.length
        int i = 0
        while i < n do
            int cx = pathX[i]
            int cy = pathY[i]
            if m.inBounds(cx, cy) then
                int idx = cy * m.width + cx
                // 不覆盖 R/S/G
                if string.len(marks[idx]) == 0 then
                    marks[idx] = "*"
                end
            end
            i = i + 1
        end
    end
    return marks
end

// 在地图上叠加机器人的雷达命中点（占据格已有，这里不再重复）
func printMapRows(array<string> rows, string title)
    string bar = string.repeat("=", 70)
    println(bar)
    println(title)
    println(bar)
    int i = 0
    int n = rows.length
    while i < n do
        println(rows[i])
        i = i + 1
    end
    println(bar)
end

// ============================================================================
// 命令：explore
//   机器人在房间内自主探索，VFH/Potential 控制器 + 里程计 SLAM + 占据栅格
// ============================================================================

func pickFrontierGoal(GridMap m, Pose cur) as (bool, float, float)
    array<int> fr = m.computeFrontiers()
    int n = fr.length
    if n == 0 then
        return false, 0.0, 0.0
    end
    // 选最近的前沿（每两个元素为一组 (x, y)）
    float bestX = 0.0
    float bestY = 0.0
    float bestD = INF
    int i = 0
    while i + 1 < n do
        int cx = fr[i]
        int cy = fr[i + 1]
        float wx
        float wy
        wx, wy = m.cellToWorld(cx, cy)
        float dx = wx - cur.x
        float dy = wy - cur.y
        float d2 = dx * dx + dy * dy
        if d2 < bestD then
            bestD = d2
            bestX = wx
            bestY = wy
        end
        i = i + 2
    end
    if bestD >= INF then
        return false, 0.0, 0.0
    end
    return true, bestX, bestY
end

func cmdExplore(int maxSteps, string controllerName) as int
    if maxSteps < 1 then
        maxSteps = 250
    end
    random.seed(uint64(20260711), uint64(7))
    World w = buildStandardWorld()
    float res = 0.2
    GridMap m = worldToMap(w, res)

    Robot r = Robot(1.0, 1.0, 0.0)
    r.maxLin = 0.5
    r.maxAng = 1.0

    // 选控制器：用 var 承载多态实例再 as Base 还原 vtable（参考 raytrace BUG-RT1/RT2 处理）
    var ctrlVar = null
    if controllerName == "potential" then
        PotentialController pc = PotentialController(0.5, 1.0)
        ctrlVar = pc
    else
        VFHController vc = VFHController(0.5, 1.0)
        ctrlVar = vc
    end
    ControllerBase ctrl = ctrlVar as ControllerBase

    Pose init = r.pose()
    SlamSystem slam = SlamSystem(m, init)

    // 第一次扫描建初图
    r.senseLidar(w)
    slam.update(r)
    r.senseBumper(w)

    Vec2 goal = Vec2(5.0, 5.0)
    bool hasGoal = false

    float dt = 0.2
    int step = 0
    int bumpCount = 0
    float totalDist = 0.0
    float startX = r.x
    float startY = r.y

    println("[explore] world=" + string(w.wallCount()) + " walls, " + string(w.circleCount()) + " circles")
    println("[explore] controller=" + ctrl.describe() + " steps=" + string(maxSteps) + " dt=" + string.formatFloat(dt, ".2") + "s")

    while step < maxSteps do
        // 选前沿目标
        if not hasGoal then
            bool ok
            float gx
            float gy
            ok, gx, gy = pickFrontierGoal(m, slam.estPose)
            if ok then
                Vec2 g = Vec2(gx, gy)
                goal = g
                hasGoal = true
            else
                // 没有前沿了：用随机点
                Vec2 rg = Vec2(randRange(1.0, 9.0), randRange(1.0, 9.0))
                goal = rg
                hasGoal = true
            end
        end

        // 到达目标？
        float dgx = goal.x - slam.estPose.x
        float dgy = goal.y - slam.estPose.y
        float dgoal = math.sqrt(dgx * dgx + dgy * dgy)
        if dgoal < 0.5 then
            hasGoal = false
        end

        // 控制器计算命令（使用 SLAM 估计位姿）
        Pose estPose = slam.estPose.clone()
        float v
        float wcmd
        v, wcmd = ctrl.computeCommand(estPose, goal, r.ranges, r.lidarMin, r.lidarStep)

        // 执行
        r.setCommand(v, wcmd, dt)

        // 碰撞回退：如果撞墙，向反方向退一点
        if r.senseBumper(w) then
            bumpCount = bumpCount + 1
            // 简单回退 0.1 米
            r.x = r.x - 0.1 * math.cos(r.theta)
            r.y = r.y - 0.1 * math.sin(r.theta)
            // 强制旋转
            r.theta = normalizeAngle(r.theta + 0.8)
            hasGoal = false
        end

        // 感知 + SLAM
        r.senseLidar(w)
        slam.update(r)

        totalDist = totalDist + math.abs(r.v) * dt

        step = step + 1
        if step % 50 == 0 then
            m.recount()
            float knownPct = float(m.knownCount) / float(m.sizeCells()) * 100.0
            println("  step " + string(step) + "/" + string(maxSteps) +
                    "  pose=" + slam.estPose.__toString() +
                    "  known=" + string.formatFloat(knownPct, ".1") + "%" +
                    "  bumps=" + string(bumpCount))
        end
    end

    m.recount()
    float pathLen = math.sqrt(squareF(r.x - startX) + squareF(r.y - startY))

    // 渲染地图 + 机器人位置
    int sxCell = 0
    int syCell = 0
    bool okS
    okS, sxCell, syCell = m.worldToCell(startX, startY)
    int gxCell = 0
    int gyCell = 0
    // 终点 = 当前位置
    bool okG
    okG, gxCell, gyCell = m.worldToCell(r.x, r.y)

    array<int> emptyX = array[]
    array<int> emptyY = array[]
    array<string> marks = buildMarksForMap(m, r, emptyX, emptyY, sxCell, syCell, gxCell, gyCell, false)
    array<string> rows = m.render(marks)

    string title = "[explore] final map  S=起点  R=机器人  ?=未知  .=空  #=占据"
    printMapRows(rows, title)

    println("[explore] summary:")
    println("  steps           = " + string(step))
    println("  scans           = " + string(slam.scanCount))
    println("  distance driven = " + string.formatFloat(totalDist, ".2") + " m")
    println("  displacement    = " + string.formatFloat(pathLen, ".2") + " m")
    println("  bumps           = " + string(bumpCount))
    println("  map known       = " + string(m.knownCount) + "/" + string(m.sizeCells()) + " cells (" + string.formatFloat(float(m.knownCount) / float(m.sizeCells()) * 100.0, ".1") + "%)")
    println("  map free        = " + string(m.freeCount))
    println("  map occupied    = " + string(m.occupiedCount))
    println("  est pose drift  = " + string.formatFloat(math.sqrt(squareF(slam.estPose.x - r.x) + squareF(slam.estPose.y - r.y)), ".3") + " m")
    return 0
end

// ============================================================================
// 命令：navigate
//   用 ground-truth 地图，A* / RRT 规划路径，机器人沿路径行进
// ============================================================================

func cmdNavigate(string plannerName) as int
    random.seed(uint64(20260711), uint64(11))
    World w = buildStandardWorld()
    float res = 0.2
    GridMap m = worldToMap(w, res)
    m.bakeWorld(w)
    m.recount()

    println("[navigate] planner=" + plannerName + " map=" + string(m.width) + "x" + string(m.height) + "@" + string.formatFloat(res, ".2") + "m")
    println("[navigate] world walls=" + string(w.wallCount()) + " circles=" + string(w.circleCount()))

    // 起点 / 终点（世界坐标）
    float sx = 0.7
    float sy = 0.7
    float gx = 9.3
    float gy = 9.3
    bool okS
    int sxCell
    int syCell
    okS, sxCell, syCell = m.worldToCell(sx, sy)
    bool okG
    int gxCell
    int gyCell
    okG, gxCell, gyCell = m.worldToCell(gx, gy)

    if not okS or not okG then
        println("error: start/goal outside map")
        return 1
    end
    // 若起终点占据（碰到墙膨胀），就近找空格
    if not m.isFree(sxCell, syCell) then
        m.setCell(sxCell, syCell, CELL_FREE)
    end
    if not m.isFree(gxCell, gyCell) then
        m.setCell(gxCell, gyCell, CELL_FREE)
    end

    array<int> pathX = array[]
    array<int> pathY = array[]
    bool found = false
    float planCost = 0.0
    int planVisited = 0
    float planTime = 0.0
    int planNodes = 0

    if plannerName == "rrt" then
        RRTPlanner rrt = RRTPlanner(w)
        rrt.robotRadius = 0.25
        rrt.stepSize = 0.5
        rrt.goalTolerance = 0.5
        RRTResult res2 = rrt.plan(sx, sy, gx, gy, 4000)
        found = res2.found
        planNodes = res2.nodeCount
        planTime = res2.elapsed
        if found then
            // 把连续路径采样到栅格上，便于渲染
            int n = res2.pathX.length
            int i = 0
            int prevCx = -1
            int prevCy = -1
            while i < n do
                bool ok
                int cx
                int cy
                ok, cx, cy = m.worldToCell(res2.pathX[i], res2.pathY[i])
                if ok then
                    if not (cx == prevCx and cy == prevCy) then
                        pathX.push(cx)
                        pathY.push(cy)
                        prevCx = cx
                        prevCy = cy
                    end
                end
                i = i + 1
            end
            planCost = float(n)
        end
    else
        // 默认 A*
        AStarPlanner astar = AStarPlanner(m)
        AStarResult res2 = astar.plan(sxCell, syCell, gxCell, gyCell)
        found = res2.found
        planCost = res2.cost
        planVisited = res2.visited
        planTime = res2.elapsed
        if found then
            int n = res2.pathX.length
            int i = 0
            while i < n do
                pathX.push(res2.pathX[i])
                pathY.push(res2.pathY[i])
                i = i + 1
            end
        end
    end

    if not found then
        println("[navigate] " + plannerName + " failed to find a path.")
        array<string> rows = m.renderNoMarks()
        printMapRows(rows, "[navigate] no path")
        return 1
    end

    int pathLen = pathX.length
    float cellsToMeters = float(pathLen) * res
    if plannerName == "astar" then
        println("[navigate] A* found path: " + string(pathLen) + " cells, cost=" + string.formatFloat(planCost, ".2") + ", visited=" + string(planVisited) + " in " + string.formatFloat(planTime * 1000.0, ".1") + "ms")
    else
        println("[navigate] RRT found path: " + string(pathLen) + " waypoints, nodes=" + string(planNodes) + " in " + string.formatFloat(planTime * 1000.0, ".1") + "ms")
    end
    println("[navigate] approx path length = " + string.formatFloat(cellsToMeters, ".2") + " m")

    // 沿路径行进
    Robot r = Robot(sx, sy, 0.0)
    r.maxLin = 0.6
    r.maxAng = 1.2
    float dt = 0.1
    int cursor = 0
    int maxSimSteps = 2000
    int simStep = 0
    bool reached = false
    float totalDriven = 0.0
    int bumpCount = 0

    while simStep < maxSimSteps and not reached do
        int newCursor
        float v
        float wcmd
        newCursor, v, wcmd = pathFollowCommand(r, m, pathX, pathY, cursor)
        cursor = newCursor
        r.setCommand(v, wcmd, dt)
        if r.senseBumper(w) then
            bumpCount = bumpCount + 1
        end
        totalDriven = totalDriven + math.abs(r.v) * dt
        simStep = simStep + 1
        if cursor >= pathLen - 1 and math.abs(v) < EPS then
            reached = true
        end
    end

    float finalErr = math.sqrt(squareF(r.x - gx) + squareF(r.y - gy))
    println("[navigate] simulation steps=" + string(simStep) + " driven=" + string.formatFloat(totalDriven, ".2") + "m bumps=" + string(bumpCount) + " final_error=" + string.formatFloat(finalErr, ".2") + "m")

    // 渲染地图 + 路径 + 机器人
    array<string> marks = buildMarksForMap(m, r, pathX, pathY, sxCell, syCell, gxCell, gyCell, true)
    array<string> rows = m.render(marks)
    string title = "[navigate] " + plannerName + " path  S=起点 G=终点 *=路径 R=机器人"
    printMapRows(rows, title)
    return 0
end

// ============================================================================
// 命令：test  —— 各模块单元测试
// ============================================================================

int g_testPass = 0
int g_testFail = 0

func checkTrue(bool cond, string name)
    if cond then
        g_testPass = g_testPass + 1
        println("  [PASS] " + name)
    else
        g_testFail = g_testFail + 1
        println("  [FAIL] " + name)
    end
end

func checkApproxFloat(float actual, float expected, float tol, string name)
    float d = actual - expected
    if d < 0.0 then
        d = 0.0 - d
    end
    if d < tol then
        g_testPass = g_testPass + 1
        println("  [PASS] " + name + " (got=" + string.formatFloat(actual, ".4") + ")")
    else
        g_testFail = g_testFail + 1
        println("  [FAIL] " + name + " got=" + string.formatFloat(actual, ".4") + " expected=" + string.formatFloat(expected, ".4"))
    end
end

func testVec2()
    println("[test] Vec2")
    Vec2 a = Vec2(1.0, 2.0)
    Vec2 b = Vec2(3.0, 4.0)
    Vec2 s = a + b
    checkApproxFloat(s.x, 4.0, 0.0001, "Vec2 __add__ x")
    checkApproxFloat(s.y, 6.0, 0.0001, "Vec2 __add__ y")
    Vec2 d = b - a
    checkApproxFloat(d.x, 2.0, 0.0001, "Vec2 __sub__ x")
    Vec2 m = a * 2.0
    checkApproxFloat(m.x, 2.0, 0.0001, "Vec2 __mul__ x")
    checkApproxFloat(m.y, 4.0, 0.0001, "Vec2 __mul__ y")
    checkApproxFloat(a.dot(b), 11.0, 0.0001, "Vec2 dot")
    checkApproxFloat(a.length(), 2.2361, 0.001, "Vec2 length")
    Vec2 u = a.normalize()
    checkApproxFloat(u.length(), 1.0, 0.0001, "Vec2 normalize unit")
    checkApproxFloat(a.cross(b), 0.0 - 2.0, 0.0001, "Vec2 cross")
end

func testPose()
    println("[test] Pose")
    Pose p = Pose(0.0, 0.0, 0.0)
    p.arc(1.0, 0.0, 1.0)
    checkApproxFloat(p.x, 1.0, 0.0001, "Pose arc straight x")
    checkApproxFloat(p.y, 0.0, 0.0001, "Pose arc straight y")
    Pose p2 = Pose(0.0, 0.0, 0.0)
    p2.arc(1.0, PI / 2.0, 1.0)
    // 走 1/4 圆，半径=1/(pi/2)=2/pi；终点 y≈r(1-cos(pi/2))=r
    checkApproxFloat(p2.y, 2.0 / PI, 0.01, "Pose arc quarter y")
    checkApproxFloat(p2.theta, HALF_PI, 0.0001, "Pose arc quarter theta")
    checkTrue(normalizeAngle(3.0 * PI) < PI, "normalizeAngle wraps 3pi")
    checkTrue(normalizeAngle(0.0 - 3.0 * PI) >= 0.0 - PI, "normalizeAngle wraps -3pi")
end

func testKinematics()
    println("[test] differential kinematics")
    Robot r = Robot(0.0, 0.0, 0.0)
    // 逆运动学
    float vL
    float vR
    vL, vR = r.inverseKinematics(0.5, 0.0)
    checkApproxFloat(vL, 0.5, 0.0001, "inverse w=0 vL")
    checkApproxFloat(vR, 0.5, 0.0001, "inverse w=0 vR")
    vL, vR = r.inverseKinematics(1.0, 2.0)
    // vL=v-0.5*L*w=1-0.5*0.4*2=0.6 ; vR=v+0.5*L*w=1.4
    checkApproxFloat(vL, 0.6, 0.0001, "inverse vL nonzero w")
    checkApproxFloat(vR, 1.4, 0.0001, "inverse vR nonzero w")
    // 正运动学（逆的逆）
    float v
    float w
    v, w = r.forwardKinematics(0.6, 1.4)
    checkApproxFloat(v, 1.0, 0.0001, "forward v roundtrip")
    checkApproxFloat(w, 2.0, 0.0001, "forward w roundtrip")
    // 直行 1 秒应前进 maxLin
    r.setCommand(0.5, 0.0, 1.0)
    checkApproxFloat(r.x, 0.5, 0.001, "drive forward x")
    checkApproxFloat(r.y, 0.0, 0.001, "drive forward y")
    // 原地旋转：v=0, w=1.0（在 maxAng=1.2 限速内），dt=1 -> theta=1.0
    Robot r2 = Robot(0.0, 0.0, 0.0)
    r2.setCommand(0.0, 1.0, 1.0)
    checkApproxFloat(r2.theta, 1.0, 0.001, "spin in place theta")
    // 编码器累计
    Robot r3 = Robot(0.0, 0.0, 0.0)
    r3.setCommand(0.5, 0.0, 2.0)
    checkApproxFloat(r3.encLeft, 1.0, 0.001, "encoder left straight")
    checkApproxFloat(r3.encRight, 1.0, 0.001, "encoder right straight")
end

func testForwardKinematicsFromEncoders()
    println("[test] encoder forward kinematics")
    Robot r = Robot(1.0, 2.0, 0.0)
    float nx
    float ny
    float nt
    nx, ny, nt = r.poseFromEncoders(1.0, 1.0)
    checkApproxFloat(nx, 2.0, 0.001, "encoder FK straight x")
    checkApproxFloat(ny, 2.0, 0.001, "encoder FK straight y")
    checkApproxFloat(nt, 0.0, 0.001, "encoder FK straight theta")
    // 弧线：左右轮差产生旋转
    Robot r2 = Robot(0.0, 0.0, 0.0)
    float nx2
    float ny2
    float nt2
    nx2, ny2, nt2 = r2.poseFromEncoders(0.0, 1.0)
    // dTheta = (1-0)/0.4 = 2.5 ; dCenter=0.5; rC=0.2
    checkApproxFloat(nt2, 2.5, 0.001, "encoder FK arc theta")
end

func testRayCast()
    println("[test] ray casting")
    World w = buildSimpleWorld()
    // 朝 +x 方向从 (0.5, 0.5) 射击，应被 x=6 边界挡住
    bool hit
    float dist
    float hx
    float hy
    hit, dist, hx, hy = w.castRay(0.5, 0.5, 1.0, 0.0, 10.0)
    checkTrue(hit, "ray +x hits wall")
    checkApproxFloat(dist, 5.5, 0.001, "ray +x distance")
    checkApproxFloat(hx, 6.0, 0.001, "ray +x hit x")
    // 朝 +y 方向应被 y=6 挡住
    hit, dist, hx, hy = w.castRay(0.5, 0.5, 0.0, 1.0, 10.0)
    checkApproxFloat(dist, 5.5, 0.001, "ray +y distance")
    // 朝箱子（2..3, 2..3.5）方向：从 (0.5,0.5) 沿 (1,1)/sqrt2 到 (2,2) 距离=1.5*sqrt2
    float inv = 1.0 / 1.41421356
    hit, dist, hx, hy = w.castRay(0.5, 0.5, inv, inv, 10.0)
    checkTrue(hit, "ray diag hits box")
    checkApproxFloat(dist, 1.5 * 1.41421356, 0.01, "ray diag distance")
    // 与圆相交
    hit, dist, hx, hy = w.castRay(4.5, 3.0, 0.0, 1.0, 10.0)
    checkTrue(hit, "ray to circle hits")
    // clearAt
    float cl = w.clearanceAt(0.5, 0.5)
    checkTrue(cl > 0.0, "clearance in open space positive")
    // 点正好在边界墙上：距离最近墙为 0
    float cl2 = w.clearanceAt(0.0, 3.0)
    checkTrue(cl2 < 0.001, "clearance on wall ~0")
    // 点在盒子中心：距离最近墙为正（未穿透语义下）
    float cl3 = w.clearanceAt(2.5, 2.75)
    checkTrue(cl3 > 0.0 and cl3 < 0.6, "clearance inside box is small positive")
end

func testGridMap()
    println("[test] grid map")
    GridMap m = GridMap(10, 10, 0.5, 0.0, 0.0)
    bool ok
    int cx
    int cy
    ok, cx, cy = m.worldToCell(1.2, 2.7)
    checkTrue(ok, "worldToCell in bounds")
    checkTrue(cx == 2, "worldToCell x (1.2/0.5=2)")
    checkTrue(cy == 5, "worldToCell y (2.7/0.5=5)")
    float wx
    float wy
    wx, wy = m.cellToWorld(2, 5)
    checkApproxFloat(wx, 1.25, 0.0001, "cellToWorld x center")
    checkApproxFloat(wy, 2.75, 0.0001, "cellToWorld y center")
    // raycastUpdate: 一直线，端点占据
    m.raycastUpdate(0, 0, 9, 0, true)
    checkTrue(m.cells[0 * 10 + 9] > OCC_THRESHOLD, "raycast end occupied")
    checkTrue(m.cells[0 * 10 + 4] > FREE_THRESHOLD and m.cells[0 * 10 + 4] < OCC_THRESHOLD, "raycast mid free")
    // bakeWorld
    World w = buildSimpleWorld()
    GridMap m2 = worldToMap(w, 0.2)
    m2.bakeWorld(w)
    checkTrue(m2.occupiedCount > 0, "baked world has occupied cells")
    checkTrue(m2.freeCount > 0, "baked world has free cells")
end

func testMinHeap()
    println("[test] min heap")
    MinHeap h = MinHeap()
    h.push(5.0, 50)
    h.push(1.0, 10)
    h.push(3.0, 30)
    h.push(2.0, 20)
    h.push(4.0, 40)
    checkTrue(h.size() == 5, "heap size after push")
    bool ok
    float pr
    int cid
    ok, pr, cid = h.pop()
    checkTrue(ok, "heap pop ok")
    checkApproxFloat(pr, 1.0, 0.0001, "heap pop min priority 1")
    checkTrue(cid == 10, "heap pop min data 10")
    ok, pr, cid = h.pop()
    checkApproxFloat(pr, 2.0, 0.0001, "heap pop min priority 2")
    ok, pr, cid = h.pop()
    checkApproxFloat(pr, 3.0, 0.0001, "heap pop min priority 3")
    ok, pr, cid = h.pop()
    checkApproxFloat(pr, 4.0, 0.0001, "heap pop min priority 4")
    ok, pr, cid = h.pop()
    checkApproxFloat(pr, 5.0, 0.0001, "heap pop min priority 5")
    checkTrue(h.empty(), "heap empty after all pop")
end

func testAStar()
    println("[test] A* planner")
    World w = buildSimpleWorld()
    GridMap m = worldToMap(w, 0.2)
    m.bakeWorld(w)
    bool okS
    int sx
    int sy
    okS, sx, sy = m.worldToCell(0.5, 0.5)
    bool okG
    int gx
    int gy
    okG, gx, gy = m.worldToCell(5.5, 5.5)
    if not m.isFree(sx, sy) then
        m.setCell(sx, sy, CELL_FREE)
    end
    if not m.isFree(gx, gy) then
        m.setCell(gx, gy, CELL_FREE)
    end
    AStarPlanner astar = AStarPlanner(m)
    AStarResult res = astar.plan(sx, sy, gx, gy)
    checkTrue(res.found, "A* finds path in simple world")
    checkTrue(res.pathX.length > 1, "A* path has multiple steps")
    checkTrue(res.visited > 0, "A* visited nodes > 0")
    checkApproxFloat(float(res.pathX[0]), float(sx), 0.0001, "A* path starts at start")
    checkApproxFloat(float(res.pathX[res.pathX.length - 1]), float(gx), 0.0001, "A* path ends at goal")
    // 直线无障碍场景：先把全图置为 free（默认 unknown 不可通行）
    GridMap m2 = GridMap(20, 20, 0.5, 0.0, 0.0)
    int ci = 0
    while ci < m2.sizeCells() do
        m2.cells[ci] = CELL_FREE
        ci = ci + 1
    end
    AStarPlanner a2 = AStarPlanner(m2)
    AStarResult r2 = a2.plan(0, 0, 19, 19)
    checkTrue(r2.found, "A* empty map straight diagonal")
    checkApproxFloat(r2.cost, 19.0 * 1.41421356, 0.01, "A* empty map cost = 19*sqrt(2)")
    // 起终点相同
    AStarResult r3 = a2.plan(5, 5, 5, 5)
    checkTrue(r3.found, "A* start==goal")
    checkTrue(r3.pathX.length == 1, "A* start==goal path len 1")
end

func testRRT()
    println("[test] RRT planner")
    random.seed(uint64(1), uint64(2))
    World w = buildSimpleWorld()
    RRTPlanner rrt = RRTPlanner(w)
    rrt.robotRadius = 0.15
    rrt.stepSize = 0.3
    rrt.goalTolerance = 0.4
    RRTResult res = rrt.plan(0.5, 0.5, 5.5, 5.5, 3000)
    checkTrue(res.found, "RRT finds path in simple world")
    if res.found then
        checkTrue(res.pathX.length > 1, "RRT path has waypoints")
        checkApproxFloat(res.pathX[0], 0.5, 0.001, "RRT path starts at start")
        checkApproxFloat(res.pathX[res.pathX.length - 1], 5.5, 0.001, "RRT path ends at goal")
    end
end

func testControllers()
    println("[test] obstacle avoidance controllers")
    World w = buildSimpleWorld()
    Robot r = Robot(0.5, 0.5, 0.0)
    r.senseLidar(w)
    // 朝墙开：前方近距离障碍，VFH 应给出非零角速度
    VFHController vh = VFHController(0.5, 1.0)
    Vec2 goal = Vec2(5.5, 0.5)
    float v
    float wcmd
    v, wcmd = vh.computeCommand(r.pose(), goal, r.ranges, r.lidarMin, r.lidarStep)
    checkTrue(math.abs(wcmd) > 0.01, "VFH turns when obstacle ahead")
    // 朝空地开：右下角→右上角，应几乎直行
    Robot r2 = Robot(0.5, 0.5, 0.0)
    Vec2 goal2 = Vec2(0.5, 5.5)
    // 把机器人朝向 +y
    r2.theta = HALF_PI
    r2.senseLidar(w)
    float v2
    float w2
    v2, w2 = vh.computeCommand(r2.pose(), goal2, r2.ranges, r2.lidarMin, r2.lidarStep)
    checkTrue(v2 > 0.0, "VFH moves forward in clear direction")
    // 势场法
    PotentialController pc = PotentialController(0.5, 1.0)
    float v3
    float w3
    v3, w3 = pc.computeCommand(r.pose(), goal, r.ranges, r.lidarMin, r.lidarStep)
    checkTrue(math.abs(v3) > 0.0 or math.abs(w3) > 0.0, "Potential returns nonzero command")
end

func testSlam()
    println("[test] SLAM system")
    World w = buildSimpleWorld()
    GridMap m = worldToMap(w, 0.2)
    Robot r = Robot(0.5, 0.5, 0.0)
    Pose init = r.pose()
    SlamSystem slam = SlamSystem(m, init)
    r.senseLidar(w)
    slam.update(r)
    checkTrue(slam.scanCount == 1, "SLAM scanCount after 1 update")
    // 走几步再更新
    int i = 0
    while i < 5 do
        r.setCommand(0.3, 0.0, 0.5)
        r.senseLidar(w)
        slam.update(r)
        i = i + 1
    end
    checkTrue(slam.scanCount == 6, "SLAM scanCount after 6 updates")
    slam.map.recount()
    checkTrue(slam.map.knownCount > 0, "SLAM mapped some cells")
    float drift = math.sqrt(squareF(slam.estPose.x - r.x) + squareF(slam.estPose.y - r.y))
    checkTrue(drift < 0.01, "SLAM odometry tracks robot (drift small in this scenario)")
end

func testSensors()
    println("[test] sensors")
    World w = buildSimpleWorld()
    Robot r = Robot(0.5, 0.5, 0.0)
    r.senseLidar(w)
    checkTrue(r.ranges.length == r.lidarCount, "lidar ranges count")
    // 最小距离应该小于最大量程（房间内必有障碍）
    float minR = INF
    int i = 0
    int n = r.ranges.length
    while i < n do
        if r.ranges[i] < minR then
            minR = r.ranges[i]
        end
        i = i + 1
    end
    checkTrue(minR < r.lidarMaxRange, "lidar min range < max range")
    // 保险杠：远离墙时为 false
    bool bump = r.senseBumper(w)
    checkTrue(not bump, "bumper false in open space")
    // 保险杠：紧贴墙时为 true
    Robot r2 = Robot(5.9, 5.9, 0.0)
    bool bump2 = r2.senseBumper(w)
    checkTrue(bump2, "bumper true against wall")
    // 里程计
    Robot r3 = Robot(0.0, 0.0, 0.0)
    r3.setCommand(0.5, 0.0, 2.0)
    checkApproxFloat(r3.odometry(), 1.0, 0.001, "odometry distance after 2s @0.5")
end

func cmdTest() as int
    println("================================================================")
    println("xrobot self-test")
    println("================================================================")
    g_testPass = 0
    g_testFail = 0
    testVec2()
    testPose()
    testKinematics()
    testForwardKinematicsFromEncoders()
    testRayCast()
    testGridMap()
    testMinHeap()
    testAStar()
    testRRT()
    testControllers()
    testSlam()
    testSensors()
    println("================================================================")
    println("result: " + string(g_testPass) + " passed, " + string(g_testFail) + " failed")
    if g_testFail == 0 then
        println("ALL TESTS PASSED")
        return 0
    end
    return 1
end

// ============================================================================
// 命令：benchmark
//   量化各模块耗时
// ============================================================================

func cmdBenchmark() as int
    println("================================================================")
    println("xrobot benchmark")
    println("================================================================")
    random.seed(uint64(99), uint64(1))

    // 1) 射线投射吞吐
    World w = buildStandardWorld()
    Robot r = Robot(5.0, 5.0, 0.0)
    int rays = 0
    float t0 = time.timer()
    int iter = 0
    while iter < 200 do
        r.senseLidar(w)
        rays = rays + r.lidarCount
        iter = iter + 1
    end
    float dt1 = time.timer() - t0
    float rps = 0.0
    if dt1 > EPS then
        rps = float(rays) / dt1
    end
    println("ray cast:    " + string(rays) + " rays in " + string.formatFloat(dt1 * 1000.0, ".1") + "ms (" + string.formatFloat(rps, ",.0") + " rays/s)")

    // 2) 栅格更新吞吐
    GridMap m = worldToMap(w, 0.15)
    SlamSystem slam = SlamSystem(m, r.pose())
    int scans = 0
    float t1 = time.timer()
    int iter2 = 0
    while iter2 < 50 do
        r.senseLidar(w)
        slam.update(r)
        scans = scans + 1
        iter2 = iter2 + 1
    end
    float dt2 = time.timer() - t1
    println("map update:  " + string(scans) + " scans in " + string.formatFloat(dt2 * 1000.0, ".1") + "ms (" + string.formatFloat(float(scans) / dt2, ".1") + " scans/s)")
    m.recount()
    println("             map known=" + string(m.knownCount) + "/" + string(m.sizeCells()))

    // 3) A* 规划时间
    GridMap m2 = worldToMap(w, 0.2)
    m2.bakeWorld(w)
    bool okS
    int sx
    int sy
    okS, sx, sy = m2.worldToCell(0.7, 0.7)
    bool okG
    int gx
    int gy
    okG, gx, gy = m2.worldToCell(9.3, 9.3)
    if not m2.isFree(sx, sy) then
        m2.setCell(sx, sy, CELL_FREE)
    end
    if not m2.isFree(gx, gy) then
        m2.setCell(gx, gy, CELL_FREE)
    end
    AStarPlanner asp = AStarPlanner(m2)
    float bestT = INF
    float bestCost = 0.0
    int bestVisited = 0
    int bestLen = 0
    int k = 0
    while k < 5 do
        AStarResult rr = asp.plan(sx, sy, gx, gy)
        if rr.elapsed < bestT then
            bestT = rr.elapsed
            bestCost = rr.cost
            bestVisited = rr.visited
            bestLen = rr.pathX.length
        end
        k = k + 1
    end
    println("A*:          " + string.formatFloat(bestT * 1000.0, ".2") + "ms  path=" + string(bestLen) + " cells  cost=" + string.formatFloat(bestCost, ".2") + "  visited=" + string(bestVisited))

    // 4) RRT 规划时间
    RRTPlanner rrt = RRTPlanner(w)
    rrt.robotRadius = 0.2
    float rrtBestT = INF
    int rrtBestNodes = 0
    int rrtBestLen = 0
    int rrtBestIter = 0
    int k2 = 0
    while k2 < 5 do
        RRTResult rr = rrt.plan(0.7, 0.7, 9.3, 9.3, 5000)
        if rr.found and rr.elapsed < rrtBestT then
            rrtBestT = rr.elapsed
            rrtBestNodes = rr.nodeCount
            rrtBestLen = rr.pathX.length
            rrtBestIter = rr.iterations
        end
        k2 = k2 + 1
    end
    if rrtBestT < INF then
        println("RRT:         " + string.formatFloat(rrtBestT * 1000.0, ".2") + "ms  nodes=" + string(rrtBestNodes) + " iters=" + string(rrtBestIter) + " path=" + string(rrtBestLen))
    else
        println("RRT:         failed")
    end

    // 5) 控制器吞吐
    array<float> sampleRanges = makeFloatArray(180, 3.0)
    Pose pp = Pose(5.0, 5.0, 0.0)
    Vec2 g = Vec2(9.0, 9.0)
    VFHController vfc = VFHController(0.5, 1.0)
    float t2 = time.timer()
    int citer = 0
    while citer < 10000 do
        float va
        float wa
        va, wa = vfc.computeCommand(pp, g, sampleRanges, 0.0 - PI, TWO_PI / 180.0)
        citer = citer + 1
    end
    float dt3 = time.timer() - t2
    println("VFH cmd:     " + string(citer) + " calls in " + string.formatFloat(dt3 * 1000.0, ".1") + "ms (" + string.formatFloat(float(citer) / dt3, ",.0") + " calls/s)")
    println("================================================================")
    return 0
end

// 解析整数参数（带默认值），非数字或空串返回默认值
func parseArgInt(string s, int defValue) as int
    s = string.trim(s)
    if string.len(s) == 0 then
        return defValue
    end
    int start = 0
    string first = string.slice(s, 0, 1)
    if first == "-" or first == "+" then
        start = 1
        if string.len(s) == 1 then
            return defValue
        end
    end
    int i = start
    while i < string.len(s) do
        string ch = string.slice(s, i, 1)
        if string.indexOf("0123456789", ch) < 0 then
            return defValue
        end
        i = i + 1
    end
    return int(s)
end

// ============================================================================
// 命令行入口
// ============================================================================

func printUsage()
    println("xrobot - 2D robot simulator (xlang)")
    println("usage:")
    println("  xrobot                                  show this help")
    println("  xrobot help                             show this help")
    println("  xrobot test                             run all unit tests")
    println("  xrobot explore [steps] [controller]     simulate exploration & SLAM")
    println("                                          steps default 250")
    println("                                          controller: vfh(default) / potential")
    println("  xrobot navigate [planner]               navigate from S to G")
    println("                                          planner: astar(default) / rrt")
    println("  xrobot benchmark                        measure each module throughput")
    println("modules:")
    println("  * differential drive kinematics (fwd/inv)")
    println("  * lidar (ray casting) + bumper + wheel encoders")
    println("  * occupancy grid map (Bresenham update)")
    println("  * A* planner (binary heap open set) + RRT planner")
    println("  * simplified SLAM (odometry pose + lidar map building)")
    println("  * VFH + potential field obstacle avoidance")
    println("legend: ?=unknown  .=free  #=occupied  R=robot  *=path  S=start  G=goal")
end

func main(...) as int
    if arg.length < 2 then
        printUsage()
        return 1
    end
    string cmd = string(arg[1])
    try
        if cmd == "-h" or cmd == "--help" or cmd == "help" then
            printUsage()
            return 0
        elseif cmd == "test" then
            return cmdTest()
        elseif cmd == "explore" then
            int steps = 250
            string controllerName = "vfh"
            if arg.length >= 3 then
                steps = parseArgInt(string(arg[2]), 250)
            end
            if arg.length >= 4 then
                controllerName = string(arg[3])
            end
            return cmdExplore(steps, controllerName)
        elseif cmd == "navigate" then
            string plannerName = "astar"
            if arg.length >= 3 then
                plannerName = string(arg[2])
            end
            if not (plannerName == "astar" or plannerName == "rrt") then
                println("error: unknown planner '" + plannerName + "'")
                println("  choose 'astar' or 'rrt'")
                return 1
            end
            return cmdNavigate(plannerName)
        elseif cmd == "benchmark" then
            return cmdBenchmark()
        else
            println("error: unknown command '" + cmd + "'")
            printUsage()
            return 1
        end
    catch e
        println("error: " + e.message)
        return 1
    end
    return 0
end
