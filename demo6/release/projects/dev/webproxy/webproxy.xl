// webproxy - HTTP reverse proxy / load balancer
//
// Usage:
//   webproxy                 -> self-test: start mock backends + proxy, verify forwarding
//   webproxy selftest        -> same as above
//   webproxy <config.json>   -> start proxy with config file (serve mode)
//
// Features:
//   1. Reverse proxy: receive HTTP requests, forward to backend, return response
//   2. Load balancing: round-robin across multiple backend servers
//   3. Failover: retry next backend on connection failure (passive health check)
//   4. Active health check: background thread pings backends periodically (serve mode)
//   5. Path routing: longest-prefix match on patterns (/api/*, /static/*, /*)
//   6. Stats: request count, error count, error rate, uptime (/__stats)
//   7. Methods: GET / POST / PUT / DELETE / PATCH
//
// Design constraints:
//   * 请求与响应对象的生命周期限定在回调内，避免把服务端句柄带出所有者作用域。
//   * 配置在启动前解析一次，运行期间只读；统计、轮询游标和健康状态由 mutex 保护。


const int DEFAULT_TIMEOUT_MS = 10000


// ============================================================
// Global state
// ============================================================
var    gConfig = {}              // parsed, immutable after server start
int    gListenPort = 0
int    gReqTotal = 0            // total forwarded requests
int    gReqError = 0            // errors (5xx responses, all-backends-failed)
int    gRRCounter = 0           // round-robin counter (shared across groups)
int    gProxyTimeoutMs = DEFAULT_TIMEOUT_MS
int    gHealthInterval = 10     // seconds between active health checks
int    gHealthTimeout = 3       // seconds for health check HTTP timeout
string gHealthMap = ""          // "host:port=up,host:port=down"
int    gStartUnix = 0           // startup timestamp for uptime
mutex  gStateLock

// selftest counters
int gPassed = 0
int gFailed = 0


// ============================================================
// Test helpers
// ============================================================
func check(bool cond, string name, string detail)
    if cond then
        gPassed += 1
        println("[ PASS ] " + name)
    else
        gFailed += 1
        println("[ FAIL ] " + name + "  " + detail)
    end
end


func expectStatus(int got, int want, string name)
    check(got == want, name, "got status " + got.toString() + " want " + want.toString())
end


// ============================================================
// Concurrent runtime state
// ============================================================
func recordRequest()
    gStateLock.lock()
    gReqTotal += 1
    gStateLock.unlock()
end

func recordError()
    gStateLock.lock()
    gReqError += 1
    gStateLock.unlock()
end

func nextServerIndex(int count) as int
    gStateLock.lock()
    int index = gRRCounter % count
    gRRCounter += 1
    gStateLock.unlock()
    return index
end

func statsSnapshot() as (int, int, int)
    gStateLock.lock()
    int total = gReqTotal
    int errors = gReqError
    int roundRobin = gRRCounter
    gStateLock.unlock()
    return total, errors, roundRobin
end

func healthSnapshot() as string
    gStateLock.lock()
    string result = gHealthMap
    gStateLock.unlock()
    return result
end

func publishHealth(string status)
    gStateLock.lock()
    gHealthMap = status
    gStateLock.unlock()
end


// ============================================================
// Utility functions (string/int params only)
// ============================================================

// Match a proxy pattern against a request path.
//   "/api/*"  matches "/api", "/api/", "/api/anything"
//   "/*"      matches everything
//   "/exact"  matches only that exact path
func patternMatch(string pattern, string path) as bool
    if string.endsWith(pattern, "/*") then
        string prefix = string.slice(pattern, 0, string.len(pattern) - 2)
        if path == prefix then
            return true
        end
        return string.startsWith(path, prefix + "/")
    end
    return path == pattern
end


// Check if a header is hop-by-hop (must not be forwarded by proxies).
func isHopHeader(string name) as bool
    string h = string.lower(name)
    if h == "connection" or h == "keep-alive" or h == "proxy-authenticate" or h == "proxy-authorization" then
        return true
    end
    if h == "te" or h == "trailers" or h == "transfer-encoding" or h == "upgrade" then
        return true
    end
    if h == "host" or h == "content-length" then
        return true
    end
    return false
end


// Extract an int field from a JSON string (used in selftest only, not in callbacks).
func extractJsonInt(string jsonText, string key) as int
    if not json.valid(jsonText) then
        return 0
    end
    var v = json.parse(jsonText)
    if v == null then
        return 0
    end
    return int(v[key])
end


// ============================================================
// Backend echo handler (for selftest mock backends).
// Returns JSON identifying the backend by its local port so the
// test can verify which backend served each request.
// ============================================================
func backendEcho(point reqHandle, point respHandle) as bool
    HttpRequest req = HttpRequest(reqHandle)
    HttpResponse resp = HttpResponse(respHandle)

    int lp = req.localPort()
    resp.header("X-Backend-Port", lp.toString())

    var result = {}
    result["port"] = lp
    result["method"] = req.method()
    result["path"] = req.path()
    string q = req.query()
    if q != "" then
        result["query"] = q
    end
    if req.contentLength() > 0 then
        string requestBody = req.body()
        if json.valid(requestBody) then
            result["body"] = json.parse(requestBody)
        else
            result["body"] = requestBody
        end
    end
    return resp.jsonText(json.stringify(result))
end

func(point, point) as bool backendEchoHandler = backendEcho


// ============================================================
// Proxy handler -- the core reverse proxy logic.
//
// Request/response wrappers stay in the callback that owns their handles.
// The parsed config is immutable after startup and can be shared read-only.
// ============================================================
func proxyRoute(point reqHandle, point respHandle) as bool
    HttpRequest req = HttpRequest(reqHandle)
    HttpResponse resp = HttpResponse(respHandle)

    recordRequest()
    resp.header("X-Proxy", "xlang-webproxy")

    string method = req.method()
    string path = req.path()
    string query = req.query()

    // ---- internal endpoints (not forwarded) ----
    if path == "/__stats" then
        auto total, errors, roundRobin = statsSnapshot()
        int nowUnix = time.toUnix(time.now())
        int uptime = nowUnix - gStartUnix
        if uptime < 1 then
            uptime = 1
        end
        int rps = total / uptime
        int errRate = 0
        if total > 0 then
            errRate = errors * 100 / total
        end
        string s = "{\"total\":" + total.toString()
        s = s + ",\"errors\":" + errors.toString()
        s = s + ",\"errorRate\":" + errRate.toString()
        s = s + ",\"uptimeSec\":" + uptime.toString()
        s = s + ",\"reqPerSec\":" + rps.toString()
        s = s + ",\"roundRobin\":" + roundRobin.toString()
        s = s + "}"
        return resp.jsonText(s)
    end

    if path == "/__health" then
        var result = {}
        result["status"] = "ok"
        result["backends"] = healthSnapshot()
        return resp.jsonText(json.stringify(result))
    end

    // ---- read immutable routing config ----
    var backends = gConfig["backends"]
    if backends == null then
        recordError()
        resp.status(503)
        return resp.text("no backends configured", "text/plain; charset=utf-8")
    end

    // ---- find matching backend group (longest pattern wins) ----
    var matchedServers = null
    bool matched = false
    int bestLen = 0

    int bn = backends.length
    int bi = 0
    while bi < bn do
        var be = backends[bi]
        string pattern = string(be["pattern"])
        if patternMatch(pattern, path) then
            int plen = string.len(pattern)
            if not matched or plen > bestLen then
                var srvs = be["servers"]
                int sn = srvs.length
                if sn > 0 then
                    matchedServers = srvs
                    matched = true
                    bestLen = plen
                end
            end
        end
        bi += 1
    end

    if not matched then
        recordError()
        resp.status(503)
        return resp.text("no backend matched for path: " + path, "text/plain; charset=utf-8")
    end

    int scount = matchedServers.length
    if scount == 0 then
        recordError()
        resp.status(503)
        return resp.text("empty server list", "text/plain; charset=utf-8")
    end

    // ---- forward with failover ----
    string contentType = req.contentType()
    if contentType == "" then
        contentType = "text/plain; charset=utf-8"
    end

    int attempts = scount
    while attempts > 0 do
        attempts -= 1
        int pick = nextServerIndex(scount)
        string targetServer = string(matchedServers[pick])
        string targetUrl = "http://" + targetServer + path
        if query != "" then
            targetUrl = targetUrl + "?" + query
        end

        try
            HttpClientRequest breq = HttpClientRequest(targetUrl)
            breq.method(method)
            breq.timeout(gProxyTimeoutMs)

            // copy request headers (skip hop-by-hop)
            int hc = req.headerCount()
            int hi = 0
            while hi < hc do
                string hn = req.headerName(hi)
                if not isHopHeader(hn) then
                    breq.header(hn, req.headerValue(hi))
                end
                hi += 1
            end
            breq.header("X-Forwarded-For", req.remoteAddr())
            breq.header("X-Forwarded-Host", req.header("Host"))
            breq.header("X-Forwarded-Proto", "http")

            // copy body for methods that carry one
            if req.contentLength() > 0 then
                breq.text(req.body(), contentType)
            end

            HttpClientResponse bresp = breq.execute()
            int bkStatus = bresp.status()
            if bkStatus <= 0 then
                throw "backend connection failed (status " + bkStatus.toString() + ")"
            end
            resp.status(bkStatus)
            if bkStatus >= 500 then
                recordError()
            end
            string respCt = bresp.header("Content-Type")
            if respCt == "" then
                respCt = "application/octet-stream"
            end
            return resp.text(bresp.body(), respCt)
        catch e
            if attempts == 0 then
                recordError()
                resp.status(502)
                return resp.text("all backends failed for: " + targetUrl, "text/plain; charset=utf-8")
            end
        end
    end

    recordError()
    resp.status(502)
    return resp.text("no backend available", "text/plain; charset=utf-8")
end

func(point, point) as bool proxyHandler = proxyRoute


// ============================================================
// Error handler for the proxy server (diagnostics)
// ============================================================
func proxyError(int status, string message, point reqHandle, point respHandle) as bool
    HttpRequest req = HttpRequest(reqHandle)
    HttpResponse resp = HttpResponse(respHandle)
    println("[proxy-error] status=" + status.toString() + " path=" + req.path() + " msg=" + message)
    resp.status(status)
    resp.header("X-Proxy-Error", message)
    return resp.text("proxy error: " + message + " (path=" + req.path() + ")", "text/plain; charset=utf-8")
end

func(int, string, point, point) as bool proxyErrorHandler = proxyError


// ============================================================
// Health worker thread (serve mode only).
// Periodically pings each backend server and stores status in
// Health checks publish one immutable status string under the state lock.
// ============================================================
func healthWorker() as int
    while true do
        time.sleep(gHealthInterval * 1000)
        var cfg = gConfig
        if cfg == null then
            publishHealth("config-error")
        else
            var backends = cfg["backends"]
            if backends == null then
                publishHealth("no-backends")
            else
                string result = ""
                int bn = backends.length
                int bi = 0
                while bi < bn do
                    var be = backends[bi]
                    var srvs = be["servers"]
                    int sn = srvs.length
                    int si = 0
                    while si < sn do
                        string srv = string(srvs[si])
                        bool alive = false
                        try
                            HttpClientRequest hreq = HttpClientRequest("http://" + srv + "/")
                            hreq.method("GET")
                            hreq.timeout(gHealthTimeout * 1000)
                            HttpClientResponse hresp = hreq.execute()
                            int st = hresp.status()
                            alive = st > 0 and st < 500
                        catch e
                            alive = false
                        end
                        if result != "" then
                            result = result + ","
                        end
                        result = result + srv + "="
                        if alive then
                            result = result + "up"
                        else
                            result = result + "down"
                        end
                        si += 1
                    end
                    bi += 1
                end
                publishHealth(result)
                println("[health] " + result)
            end
        end
    end
    return 0
end


// ============================================================
// Config loading (serve mode)
// ============================================================
func loadConfig(string configPath) as bool
    if not file.exists(configPath) then
        println("ERROR: config file not found: " + configPath)
        return false
    end
    string raw = file.readText(configPath)
    if not json.valid(raw) then
        println("ERROR: invalid JSON in config file: " + configPath)
        return false
    end
    var cfg = json.parse(raw)
    gConfig = cfg
    gListenPort = int(cfg["listen"])
    var hc = cfg["healthCheck"]
    if hc != null then
        gHealthInterval = int(hc["interval"])
        gHealthTimeout = int(hc["timeout"])
    end
    return true
end


// ============================================================
// Self-test: start mock backends + proxy, verify forwarding.
// Uses if-true-then blocks to isolate native-backed class scopes
// (same pattern as fileserver.xl).
// ============================================================
func runSelfTest() as int
    println("")
    println("================ webproxy self-test ================")
    println("")

    // ---- 1. create and start mock backends ----
    point bk1 = http.server.create(0, "127.0.0.1", 128, 1048576, 1048576, 100, 65536, 1)
    point bk2 = http.server.create(0, "127.0.0.1", 128, 1048576, 1048576, 100, 65536, 1)
    point bk3 = http.server.create(0, "127.0.0.1", 128, 1048576, 1048576, 100, 65536, 1)
    point bk4 = http.server.create(0, "127.0.0.1", 128, 1048576, 1048576, 100, 65536, 1)

    http.server.anyRequest(bk1, "/", backendEchoHandler)
    http.server.anyRequest(bk1, "/*", backendEchoHandler)
    http.server.anyRequest(bk2, "/", backendEchoHandler)
    http.server.anyRequest(bk2, "/*", backendEchoHandler)
    http.server.anyRequest(bk3, "/", backendEchoHandler)
    http.server.anyRequest(bk3, "/*", backendEchoHandler)
    http.server.anyRequest(bk4, "/", backendEchoHandler)
    http.server.anyRequest(bk4, "/*", backendEchoHandler)

    http.server.start(bk1)
    http.server.start(bk2)
    http.server.start(bk3)
    http.server.start(bk4)

    int port1 = http.server.port(bk1)
    int port2 = http.server.port(bk2)
    int port3 = http.server.port(bk3)
    int port4 = http.server.port(bk4)

    println("backends started:")
    println("  api-A      127.0.0.1:" + port1.toString())
    println("  api-B      127.0.0.1:" + port2.toString())
    println("  static-C   127.0.0.1:" + port3.toString())
    println("  default-D  127.0.0.1:" + port4.toString())

    // ---- 2. build config JSON with actual ports ----
    string configText = "{\"listen\":0,\"backends\":[{\"name\":\"api\",\"pattern\":\"/api/*\",\"servers\":[\"127.0.0.1:" + port1.toString() + "\",\"127.0.0.1:" + port2.toString() + "\"]},{\"name\":\"static\",\"pattern\":\"/static/*\",\"servers\":[\"127.0.0.1:" + port3.toString() + "\"]},{\"name\":\"default\",\"pattern\":\"/*\",\"servers\":[\"127.0.0.1:" + port4.toString() + "\"]}],\"healthCheck\":{\"interval\":10,\"timeout\":3}}"
    gConfig = json.parse(configText)
    gProxyTimeoutMs = 5000
    gReqTotal = 0
    gReqError = 0
    gRRCounter = 0
    gStartUnix = time.toUnix(time.now())

    // ---- 3. create and start proxy ----
    point proxy = http.server.create(0, "127.0.0.1", 128, 1048576, 10485760, 100, 65536, 2)
    http.server.anyRequest(proxy, "/", proxyHandler)
    http.server.anyRequest(proxy, "/*", proxyHandler)
    http.server.error(proxy, proxyErrorHandler)
    http.server.start(proxy)
    int proxyPort = http.server.port(proxy)
    string base = "http://127.0.0.1:" + proxyPort.toString()

    println("proxy started on 127.0.0.1:" + proxyPort.toString())
    println("")

    time.sleep(200)

    // ---- 4. test cases ----

    // Test 1: GET /api/users -> routed to api group (port1 or port2)
    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/api/users")
        hreq.method("GET")
        hreq.timeout(5000)
        HttpClientResponse hresp = hreq.execute()
        expectStatus(hresp.status(), 200, "1. GET /api/users status")
        int p = extractJsonInt(hresp.body(), "port")
        check(p == port1 or p == port2, "1. routed to api backend", "port=" + p.toString())
        check(hresp.header("X-Proxy") == "xlang-webproxy", "1. X-Proxy header", "X-Proxy=" + hresp.header("X-Proxy"))
    end

    // Test 2: GET / -> routed to default group (port4)
    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/")
        hreq.method("GET")
        hreq.timeout(5000)
        HttpClientResponse hresp = hreq.execute()
        expectStatus(hresp.status(), 200, "2. GET / status")
        int p = extractJsonInt(hresp.body(), "port")
        check(p == port4, "2. routed to default backend", "port=" + p.toString())
    end

    // Test 3: GET /static/style.css -> routed to static group (port3)
    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/static/style.css")
        hreq.method("GET")
        hreq.timeout(5000)
        HttpClientResponse hresp = hreq.execute()
        expectStatus(hresp.status(), 200, "3. GET /static/style.css status")
        int p = extractJsonInt(hresp.body(), "port")
        check(p == port3, "3. routed to static backend", "port=" + p.toString())
    end

    // Test 4: POST /api/data with JSON body -> body forwarded
    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/api/data")
        hreq.method("POST")
        hreq.timeout(5000)
        hreq.text("{\"name\":\"gamma\"}", "application/json")
        HttpClientResponse hresp = hreq.execute()
        expectStatus(hresp.status(), 200, "4. POST /api/data status")
        check(string.contains(hresp.body(), "gamma"), "4. body forwarded to backend", "body=" + hresp.body())
        check(string.contains(hresp.body(), "\"method\":\"POST\""), "4. method POST forwarded", "body=" + hresp.body())
    end

    // Test 5: PUT /api/items/123 with body
    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/api/items/123")
        hreq.method("PUT")
        hreq.timeout(5000)
        hreq.text("{\"qty\":5}", "application/json")
        HttpClientResponse hresp = hreq.execute()
        expectStatus(hresp.status(), 200, "5. PUT /api/items/123 status")
        check(string.contains(hresp.body(), "\"method\":\"PUT\""), "5. PUT method forwarded", "body=" + hresp.body())
    end

    // Test 6: DELETE /api/items/123
    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/api/items/123")
        hreq.method("DELETE")
        hreq.timeout(5000)
        HttpClientResponse hresp = hreq.execute()
        expectStatus(hresp.status(), 200, "6. DELETE /api/items/123 status")
        check(string.contains(hresp.body(), "\"method\":\"DELETE\""), "6. DELETE method forwarded", "body=" + hresp.body())
    end

    // Test 7: GET with query string /api/search?q=hello
    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/api/search?q=hello")
        hreq.method("GET")
        hreq.timeout(5000)
        HttpClientResponse hresp = hreq.execute()
        expectStatus(hresp.status(), 200, "7. GET /api/search?q=hello status")
        check(string.contains(hresp.body(), "hello"), "7. query string forwarded", "body=" + hresp.body())
    end

    // Test 8: GET /__stats -> returns proxy statistics
    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/__stats")
        hreq.method("GET")
        hreq.timeout(5000)
        HttpClientResponse hresp = hreq.execute()
        expectStatus(hresp.status(), 200, "8. GET /__stats status")
        int total = extractJsonInt(hresp.body(), "total")
        check(total > 0, "8. stats total > 0", "total=" + total.toString())
    end

    // Test 9: Round-robin -- 4 requests to /api/* should hit both api-A and api-B
    // (separate if-blocks avoid native-backed class lifecycle in loops)
    string portsHit = ""

    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/api/rr1")
        hreq.method("GET")
        hreq.timeout(5000)
        HttpClientResponse hresp = hreq.execute()
        portsHit = portsHit + extractJsonInt(hresp.body(), "port").toString() + ","
    end
    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/api/rr2")
        hreq.method("GET")
        hreq.timeout(5000)
        HttpClientResponse hresp = hreq.execute()
        portsHit = portsHit + extractJsonInt(hresp.body(), "port").toString() + ","
    end
    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/api/rr3")
        hreq.method("GET")
        hreq.timeout(5000)
        HttpClientResponse hresp = hreq.execute()
        portsHit = portsHit + extractJsonInt(hresp.body(), "port").toString() + ","
    end
    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/api/rr4")
        hreq.method("GET")
        hreq.timeout(5000)
        HttpClientResponse hresp = hreq.execute()
        portsHit = portsHit + extractJsonInt(hresp.body(), "port").toString() + ","
    end

    check(string.contains(portsHit, port1.toString()), "9. round-robin hits api-A", "ports=" + portsHit)
    check(string.contains(portsHit, port2.toString()), "9. round-robin hits api-B", "ports=" + portsHit)

    // Test 10: Custom header forwarding
    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/api/hdr")
        hreq.method("GET")
        hreq.timeout(5000)
        hreq.header("X-Custom-Header", "proxy-test")
        HttpClientResponse hresp = hreq.execute()
        expectStatus(hresp.status(), 200, "10. GET /api/hdr status")
    end

    // Test 11: Failover -- stop api-A, verify requests still succeed via api-B
    println("")
    println("  [stopping api-A (port " + port1.toString() + ") to test failover...]")
    http.server.stop(bk1)
    time.sleep(300)

    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/api/fo1")
        hreq.method("GET")
        hreq.timeout(10000)
        HttpClientResponse hresp = hreq.execute()
        expectStatus(hresp.status(), 200, "11a. failover request 1 status")
        int p = extractJsonInt(hresp.body(), "port")
        check(p == port2, "11a. served by surviving api-B", "port=" + p.toString())
    end
    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/api/fo2")
        hreq.method("GET")
        hreq.timeout(10000)
        HttpClientResponse hresp = hreq.execute()
        expectStatus(hresp.status(), 200, "11b. failover request 2 status")
        int p = extractJsonInt(hresp.body(), "port")
        check(p == port2, "11b. served by surviving api-B", "port=" + p.toString())
    end

    // Test 12: /__health endpoint
    if true then
        HttpClientRequest hreq = HttpClientRequest(base + "/__health")
        hreq.method("GET")
        hreq.timeout(5000)
        HttpClientResponse hresp = hreq.execute()
        expectStatus(hresp.status(), 200, "12. GET /__health status")
    end

    // ---- 5. summary ----
    println("")
    println("------------------- summary -------------------")
    println("passed: " + gPassed.toString() + " / " + (gPassed + gFailed).toString())
    println("failed: " + gFailed.toString())
    auto total, errors, roundRobin = statsSnapshot()
    println("proxy stats: total=" + total.toString() + " errors=" + errors.toString() + " rr=" + roundRobin.toString())
    println("")

    // ---- 6. cleanup ----
    http.server.drain(proxy, 2000)
    http.server.stop(proxy)
    http.server.destroy(proxy)
    http.server.drain(bk2, 1000)
    http.server.stop(bk2)
    http.server.destroy(bk2)
    http.server.drain(bk3, 1000)
    http.server.stop(bk3)
    http.server.destroy(bk3)
    http.server.drain(bk4, 1000)
    http.server.stop(bk4)
    http.server.destroy(bk4)
    // bk1 already stopped earlier
    http.server.destroy(bk1)

    if gFailed > 0 then
        return 1
    end
    return 0
end


// ============================================================
// Serve mode: start proxy with config file
// ============================================================
func runServe() as int
    point server = http.server.create(gListenPort, "127.0.0.1", 128, 1048576, 10485760, 100, 65536, 2)
    if server == null then
        println("FATAL: http.server.create returned null")
        return 1
    end
    http.server.anyRequest(server, "/", proxyHandler)
    http.server.anyRequest(server, "/*", proxyHandler)
    http.server.error(server, proxyErrorHandler)

    if not http.server.start(server) then
        println("FATAL: http.server.start failed (port " + gListenPort.toString() + " busy?)")
        http.server.destroy(server)
        return 1
    end

    int boundPort = http.server.port(server)
    println("webproxy listening on http://127.0.0.1:" + boundPort.toString())

    // print config summary
    var cfg = gConfig
    var backends = cfg["backends"]
    if backends != null then
        int bn = backends.length
        int bi = 0
        while bi < bn do
            var be = backends[bi]
            string bname = string(be["name"])
            string bpattern = string(be["pattern"])
            var srvs = be["servers"]
            int sn = srvs.length
            println("  [" + bname + "] " + bpattern + " -> " + sn.toString() + " server(s)")
            int si = 0
            while si < sn do
                println("       " + string(srvs[si]))
                si += 1
            end
            bi += 1
        end
    end

    println("")
    println("endpoints:")
    println("  /__stats    request statistics")
    println("  /__health   backend health status")
    println("")
    println("press Ctrl+C to stop")

    // start health check background thread
    func() as int hfn = healthWorker
    thread hthread = thread(hfn)

    while true do
        time.sleep(5000)
        auto total, errors, roundRobin = statsSnapshot()
        println("[stats] total=" + total.toString() + " errors=" + errors.toString() + " rr=" + roundRobin.toString())
    end

    return 0
end


// ============================================================
// main
// ============================================================
func main(...) as int
    println("xlang webproxy - HTTP reverse proxy / load balancer")
    println("")

    gStateLock = mutex()
    gStartUnix = time.toUnix(time.now())

    if arg.length < 2 then
        return runSelfTest()
    end

    string a1 = string(arg[1])
    if a1 == "selftest" then
        return runSelfTest()
    end
    if a1 == "-h" or a1 == "--help" then
        println("Usage:")
        println("  webproxy                 run self-test (mock backends + proxy)")
        println("  webproxy selftest        same as above")
        println("  webproxy <config.json>   start proxy with config file")
        println("")
        println("Config format:")
        println("  {\"listen\":8080,\"backends\":[{\"name\":\"api\",\"pattern\":\"/api/*\",\"servers\":[\"host:port\",...]},{\"name\":\"default\",\"pattern\":\"/*\",\"servers\":[\"host:port\"]}],\"healthCheck\":{\"interval\":10,\"timeout\":3}}")
        return 0
    end

    // config file mode
    if not loadConfig(a1) then
        return 1
    end
    return runServe()
end
