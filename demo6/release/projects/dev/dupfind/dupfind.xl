// dupfind - duplicate file detector
//
// Usage:
//   dupfind <dir> [-r]      find content-identical files under <dir>
//   dupfind <dir>           scan only top level of <dir>
//   dupfind                 default to current directory
//   dupfind -h              show help
//
// Algorithm (two-level filter):
//   1. Collect every regular file via dir.entries(dir, recursive).
//   2. Level 1: count size collisions (file.info / entries.size). Files with a
//      unique size cannot be duplicates, so their hash is skipped entirely.
//   3. Level 2: stream files sharing a size into SHA-256, then group by
//      (size, digest). Same-size different-content files are split.
//   4. Emit every group with >= 2 members.

const int HASH_CHUNK_SIZE = 65536

// Format a byte count as B/KB/MB/GB with one decimal place.
func formatSize(int64 bytes) as string
    if bytes < 1024 then
        return string(int(bytes)) + " B"
    end
    float kb = float(bytes) / 1024.0
    if kb < 1024.0 then
        return float.format(kb, ".1") + " KB"
    end
    float mb = kb / 1024.0
    if mb < 1024.0 then
        return float.format(mb, ".1") + " MB"
    end
    float gb = mb / 1024.0
    return float.format(gb, ".1") + " GB"
end

// Render fullPath relative to root for display (e.g. calc\calc.xl).
func relName(string root, string fullPath) as string
    string rel = path.rel(root, fullPath)
    if string.len(rel) > 0 and rel != "." then
        if not path.isAbs(rel) then
            return rel
        end
    end
    // Fallback: normalize and strip the root + separator prefix by hand.
    string rootN = path.normalize(root)
    string fullN = path.normalize(fullPath)
    string prefix = rootN + path.sep()
    if string.startsWith(fullN, prefix) then
        int plen = string.len(prefix)
        int rest = string.len(fullN) - plen
        return string.mid(fullN, plen, rest)
    end
    return fullN
end

// 流式读取原始字节，内存占用不随文件大小增长。
func hashFile(string filePath) as string
    File stream = file.open(filePath, true, encoding.binary)
    Sha256 digest = crypto.sha256Stream()

    while not stream.eof do
        Buffer chunk = stream.readBytes(HASH_CHUNK_SIZE)
        if chunk.len() == 0 then
            break
        end
        if not digest.update(chunk) then
            throw "failed to hash file: " + filePath
        end
    end
    return string.lower(digest.hex())
end

func printUsage()
    println("dupfind - duplicate file detector")
    println("usage: dupfind [dir] [-r]")
    println("  -r   scan subdirectories recursively")
    println("examples:")
    println("  dupfind projects\\dev -r")
    println("  dupfind .")
end

func main(...) as int
    string target = "."
    bool recursive = false

    int i = 1
    while i < arg.length do
        string a = string(arg[i])
        if a == "-r" or a == "-R" or a == "--recursive" then
            recursive = true
        elseif a == "-h" or a == "--help" then
            printUsage()
            return 0
        else
            target = a
        end
        i += 1
    end

    if not dir.exists(target) then
        println("dupfind: path not found:", target)
        return 1
    end

    println("Scanning " + target + " for duplicates...")
    println("")

    // ---- Phase 1: collect every regular file (path + size). ----
    // B2 fixed: array<T> + append().
    array<string> paths = array[]
    array<int64> sizes = array[]

    array raw = dir.entries(target, recursive)
    int n = raw.length
    int k = 0
    while k < n do
        var e = raw[k]
        if bool(e["isFile"]) then
            paths.append(string(e["path"]))
            sizes.append(int64(e["size"]))
        end
        k += 1
    end

    int len = paths.length

    if len < 2 then
        println("Found 0 duplicate groups, 0 files can be deduplicated.")
        return 0
    end

    // ---- Phase 2: count size buckets in one pass (level-1 filter). ----
    dict<int> sizeCounts = dict{}
    int c = 0
    while c < len do
        string sizeKey = string(sizes[c])
        if sizeKey in sizeCounts then
            sizeCounts[sizeKey] += 1
        else
            sizeCounts[sizeKey] = 1
        end
        c += 1
    end

    // ---- Phase 3: compute sha256 only for size-collision files. ----
    // Unique-size or unreadable files get an empty digest and are skipped.
    array<string> hashes = array[]
    dict<int> groupCounts = dict{}
    int skipped = 0
    int h = 0
    while h < len do
        string hash = ""
        string sizeKey = string(sizes[h])
        if sizeCounts[sizeKey] >= 2 then
            try
                hash = hashFile(paths[h])
            catch e
                println("Warning: skipped unreadable file: " + paths[h])
                skipped += 1
            end
        end
        hashes.append(hash)

        if hash != "" then
            string groupKey = sizeKey + ":" + hash
            if groupKey in groupCounts then
                groupCounts[groupKey] += 1
            else
                groupCounts[groupKey] = 1
            end
        end
        h += 1
    end

    // ---- Phase 4: cluster by (size, sha) and emit groups with >= 2 members. ----
    dict<bool> emitted = dict{}
    int groupCount = 0
    int totalDupFiles = 0

    int a = 0
    while a < len do
        if hashes[a] == "" then
            a += 1
            continue
        end
        string groupKey = string(sizes[a]) + ":" + hashes[a]
        if groupCounts[groupKey] < 2 or groupKey in emitted then
            a += 1
            continue
        end
        emitted[groupKey] = true

        // Gather group members (same size AND same hash as a).
        array<int> gIdx = array[]
        int b = 0
        while b < len do
            if sizes[b] == sizes[a] and hashes[b] == hashes[a] then
                gIdx.append(b)
            end
            b += 1
        end

        int gLen = gIdx.length

        if gLen >= 2 then
            groupCount += 1

            // Compute max display-name width so columns line up.
            int maxName = 0
            int g = 0
            while g < gLen do
                string disp = relName(target, paths[gIdx[g]])
                int dl = string.len(disp)
                if dl > maxName then
                    maxName = dl
                end
                g += 1
            end

            string shortSha = string.slice(hashes[a], 0, 16) + "..."
            println("Group " + string(groupCount) + " (SHA: " + shortSha + "):")

            g = 0
            while g < gLen do
                int idx = gIdx[g]
                string disp = relName(target, paths[idx])
                string szStr = formatSize(sizes[idx])
                string padded = string.padRight(disp, maxName, " ")
                println("    " + padded + " " + szStr)
                g += 1
            end
            println("")

            totalDupFiles += gLen
        end
        a += 1
    end

    println("Found " + string(groupCount) + " duplicate groups, " + string(totalDupFiles) + " files can be deduplicated.")
    if skipped > 0 then
        println("Skipped " + string(skipped) + " unreadable files.")
    end
    return 0
end
