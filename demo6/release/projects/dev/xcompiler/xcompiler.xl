    try
        string src = "func f() as int\n    int x = (1 + 2) * 3 - 4 / 2\n    return x\nend"
        string c = compileSource(src)
        tCheckHas(c, "((1 + 2) * 3)", "mul over add")
        tCheckHas(c, "(4 / 2)", "div")
    catch e
        tCheck(false, "gen expr mixed threw: " + e.message)
    end
    tEnd("gen-expr-mixed")
end


// ----- 语义分析测试 -----

func testSemanticOk()
    println("[test] 语义分析 - 正确程序")
    tReset()
    try
        string src = "func f() as int\n    int x = 1\n    return x\nend"
        string err = analyzeOnly(src)
        tCheckEq(string(err), "", "no error")
    catch e
        tCheck(false, "sem ok threw: " + e.message)
    end
    tEnd("sem-ok")
end


func testSemanticDupVar()
    println("[test] 语义分析 - 重复声明")
    tReset()
    try
        string src = "func f() as int\n    int x = 1\n    int x = 2\n    return x\nend"
        string err = analyzeOnly(src)
        tCheck(string.len(err) > 0, "expected error")
        tCheck(string.contains(err, "x"), "error mentions x")
    catch e
        tCheck(false, "sem dup threw: " + e.message)
    end
    tEnd("sem-dup")
end


func testSemanticUndecl()
    println("[test] 语义分析 - 未声明赋值")
    tReset()
    try
        string src = "func f() as int\n    y = 2\n    return 0\nend"
        string err = analyzeOnly(src)
        tCheck(string.len(err) > 0, "expected error")
        tCheck(string.contains(err, "y"), "error mentions y")
    catch e
        tCheck(false, "sem undecl threw: " + e.message)
    end
    tEnd("sem-undecl")
end


func testSemanticScope()
    println("[test] 语义分析 - 作用域隔离")
    tReset()
    try
        // 内层声明的 x 不应与外层冲突。
        string src = "func f() as int\n    int x = 1\n    if x > 0 then\n        int x = 2\n    end\n    return x\nend"
        string err = analyzeOnly(src)
        tCheckEq(string(err), "", "no error in nested scope")
    catch e
        tCheck(false, "sem scope threw: " + e.message)
    end
    tEnd("sem-scope")
end


// 仅做语义分析（不生成代码），返回错误字符串。
func analyzeOnly(string src) as string
    array<var> toks = tokenize(src)
    var prog = parseTokens(toks)
    return analyzeProgram(prog)
end


// ----- 端到端集成测试 -----

func testEndToEnd()
    println("[test] 端到端 - 完整小程序")
    tReset()
    try
        string src = ""
        src = src + "func add(int a, int b) as int\n"
        src = src + "    return a + b\n"
        src = src + "end\n"
        src = src + "\n"
        src = src + "func main() as int\n"
        src = src + "    int x = add(3, 4)\n"
        src = src + "    print(x)\n"
        src = src + "    return 0\n"
        src = src + "end\n"
        string c = compileSource(src)
        tCheckHas(c, "int64_t add(int64_t a, int64_t b)", "add signature")
        tCheckHas(c, "int64_t add();", "add prototype")
        tCheckHas(c, "int64_t x = add(3, 4)", "call add")
        tCheckHas(c, "printf(\"%lld", "print x")
        tCheckHas(c, "return 0", "main return")
        tCheckHas(c, "int main", "has main")
    catch e
        tCheck(false, "e2e threw: " + e.message)
    end
    tEnd("e2e")
end


func testEndToEndLoop()
    println("[test] 端到端 - 循环累加")
    tReset()
    try
        string src = ""
        src = src + "func sum(int n) as int\n"
        src = src + "    int total = 0\n"
        src = src + "    int i = 1\n"
        src = src + "    while i <= n do\n"
        src = src + "        total = total + i\n"
        src = src + "        i = i + 1\n"
        src = src + "    end\n"
        src = src + "    return total\n"
        src = src + "end\n"
        string c = compileSource(src)
        tCheckHas(c, "int64_t sum(int64_t n)", "sum sig")
        tCheckHas(c, "int64_t total = 0", "total init")
        tCheckHas(c, "while ((i <= n))", "while cond")
        tCheckHas(c, "total = (total + i)", "accumulate")
        tCheckHas(c, "i = (i + 1)", "increment")
    catch e
        tCheck(false, "e2e loop threw: " + e.message)
    end
    tEnd("e2e-loop")
end


func testEndToEndIf()
    println("[test] 端到端 - 多分支")
    tReset()
    try
        string src = ""
        src = src + "func grade(int s) as int\n"
        src = src + "    if s >= 90 then\n"
        src = src + "        print(4)\n"
        src = src + "    elseif s >= 80 then\n"
        src = src + "        print(3)\n"
        src = src + "    elseif s >= 60 then\n"
        src = src + "        print(2)\n"
        src = src + "    else\n"
        src = src + "        print(0)\n"
        src = src + "    end\n"
        src = src + "    return 0\n"
        src = src + "end\n"
        string c = compileSource(src)
        tCheckHas(c, "if ((s >= 90))", "if 90")
        tCheckHas(c, "else if ((s >= 80))", "elseif 80")
        tCheckHas(c, "else if ((s >= 60))", "elseif 60")
        tCheckHas(c, "else {", "else")
    catch e
        tCheck(false, "e2e if threw: " + e.message)
    end
    tEnd("e2e-if")
end


func testMultipleFuncs()
    println("[test] 端到端 - 多函数互相调用")
    tReset()
    try
        string src = ""
        src = src + "func sq(int x) as int\n"
        src = src + "    return x * x\n"
        src = src + "end\n"
        src = src + "func sumsq(int a, int b) as int\n"
        src = src + "    return sq(a) + sq(b)\n"
        src = src + "end\n"
        string c = compileSource(src)
        tCheckHas(c, "int64_t sq(int64_t x)", "sq sig")
        tCheckHas(c, "int64_t sumsq(int64_t a, int64_t b)", "sumsq sig")
        tCheckHas(c, "(sq(a) + sq(b))", "nested calls")
    catch e
        tCheck(false, "multi func threw: " + e.message)
    end
    tEnd("multi-func")
end


// ----- 主测试入口 -----

func cmdTest() as int
    println("=== xcompiler built-in test suite ===")
    println("")
    testLexer()
    testLexerNumbers()
    testLexerStrings()
    testLexerOperators()
    testLexerComments()
    testParseFunc()
    testParseVarDecl()
    testParseIf()
    testParseWhile()
    testParseFor()
    testParseExpr()
    testSemanticOk()
    testSemanticDupVar()
    testSemanticUndecl()
    testSemanticScope()
    testGenFunc()
    testGenVarDecl()
    testGenPrint()
    testGenIf()
    testGenWhile()
    testGenFor()
    testGenReturn()
    testGenForwardDecl()
    testGenBreakContinue()
    testGenNested()
    testGenExprMixed()
    testEndToEnd()
    testEndToEndLoop()
    testEndToEndIf()
    testMultipleFuncs()
    println("")
    println("=== total pass=" + string(g_pass) + " fail=" + string(g_fail) + " ===")
    if g_fail > 0 then
        println("SOME TESTS FAILED")
        return 1
    end
    println("ALL TESTS PASSED")
    return 0
end


// =====================================================================
// 11. 入口
// =====================================================================

func main(...) as int
    initTables()
    if arg.length < 2 then
        printUsage()
        return 1
    end
    string cmd = string(arg[1])
    if cmd == "-h" or cmd == "--help" or cmd == "help" then
        printUsage()
        return 0
    end
    if cmd == "test" then
        return cmdTest()
    end
    if cmd == "compile" then
        if arg.length < 4 then
            println("xcompiler: 'compile' 需要 <input.xl> <output.c>")
            return 1
        end
        return cmdCompile(string(arg[2]), string(arg[3]))
    end
    if cmd == "ast" then
        if arg.length < 3 then
            println("xcompiler: 'ast' 需要 <input.xl>")
            return 1
        end
        return cmdAst(string(arg[2]))
    end
    if cmd == "tokens" then
        if arg.length < 3 then
            println("xcompiler: 'tokens' 需要 <input.xl>")
            return 1
        end
        return cmdTokens(string(arg[2]))
    end
    println("xcompiler: 未知命令: " + cmd)
    printUsage()
    return 1
end
