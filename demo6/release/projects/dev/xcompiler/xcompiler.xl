        string src = "func fib(int n) as int\n    if n < 2 then\n        return n\n    end\n    return fib(n - 1) + fib(n - 2)\nend"
        string c = compileSource(src)
        tCheckHas(c, "int64_t fib(int64_t n)", "fib sig")
        tCheckHas(c, "return n", "base case")
        tCheckHas(c, "fib(n - 1)", "recursive call")
        tCheckHas(c, "fib(n - 2)", "recursive call 2")
    catch e
        tCheck(false, "gen nested threw: " + e.message)
    end
    tEnd("gen-nested")
end


