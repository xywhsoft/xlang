        string src = "func f() as int\n    for i in range(10)\n        print(i)\n    end\n    return 0\nend"
        string c = compileSource(src)
        tCheckHas(c, "for (int64_t i = 0; i < 10; i++)", "for range")
        tCheckHas(c, "printf(\"%lld", "print in for")
    catch e
        tCheck(false, "gen for threw: " + e.message)
    end
    tEnd("gen-for")
end


