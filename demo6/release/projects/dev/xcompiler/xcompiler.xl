    try
        string src = "func f(int x) as int\n    if x > 10 then\n        return 1\n    else\n        return 0\n    end\nend"
        string c = compileSource(src)
        tCheckHas(c, "if ((x > 10))", "if cond")
        tCheckHas(c, "return 1", "then")
        tCheckHas(c, "else", "else")
        tCheckHas(c, "return 0", "else body")
    catch e
        tCheck(false, "gen if threw: " + e.message)
    end
    tEnd("gen-if")
end


func testGenWhile()
