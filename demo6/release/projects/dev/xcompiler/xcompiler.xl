        string src = "func f() as int\n    int x = 10\n    while x > 0 do\n        x = x - 1\n    end\n    return x\nend"
        string c = compileSource(src)
        tCheckHas(c, "while ((x > 0))", "while cond")
        tCheckHas(c, "x = (x - 1)", "assign in loop")
    catch e
        tCheck(false, "gen while threw: " + e.message)
    end
    tEnd("gen-while")
end


