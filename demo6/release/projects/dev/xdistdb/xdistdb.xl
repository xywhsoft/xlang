func cmdClusterInit(int nodeCount) as int
    var r = clusterInit(nodeCount)
    if bool(r["ok"]) then
        println("OK cluster initialized:")
        println("  nodes:    " + string(r["nodes"]))
        println("  shards:   " + string(r["shards"]))
        println("  replicas: " + string(DEFAULT_REPLICA_FACTOR))
        println("  vnodes:   " + string(VNODES_PER_NODE) + " per node")
        println("")
        print(formatClusterInfo())
        return 0
    end
    println("Error: cluster init failed")
    return 1
end

func cmdClusterAdd(int port) as int
    if not ("nodes" in gState) then
        println("Error: cluster not initialized. Run 'cluster init' first.")
        return 1
    end
    string nid = nextNodeId()
    if port <= 0 then
        int maxPort = 7000
        for nid2, node in gState["nodes"]
            int p2 = int(node["port"])
            if p2 > maxPort then maxPort = p2 end
        end
        port = maxPort + 1
    end
    var r = clusterAddNode(nid, port)
    if bool(r["ok"]) then
        println("OK added node: " + nid + " port=" + string(port))
        println("  migration ranges: " + string(r["ranges"].length))
        advanceMigrations()
        println("  migration: completed (estimated " + string(countKeysInRanges(r["ranges"])) + " keys affected)")
        return 0
    end
    println("Error: " + string(r["error"]))
    return 1
end

func cmdClusterRemove(string nodeId) as int
    var r = clusterRemoveNode(nodeId)
    if bool(r["ok"]) then
        println("OK removed node: " + nodeId)
        println("  migration ranges: " + string(r["ranges"].length))
        advanceMigrations()
        return 0
    end
    println("Error: " + string(r["error"]))
    return 1
end

func cmdClusterStatus() as int
    if not ("nodes" in gState) then
        println("Error: cluster not initialized")
        return 1
    end
    print(formatClusterInfo())
    println("")
    print(formatClusterNodes())
    println("")
    print(formatClusterShards())
    println("")
    print(formatClusterSlots())
    println("")
    print(formatKeyDistribution())
    println("")
    print(formatMigrationProgress())
    return 0
end

func cmdClusterRing() as int
    print(renderRingViz())
    return 0
end

func cmdClusterNodes() as int
    print(formatClusterNodes())
    return 0
end

func cmdClusterShards() as int
    print(formatClusterShards())
    return 0
end

func cmdClusterMigrate() as int
    var migrations = ensureMigrations()
    int pendingBefore = 0
    int i = 0
    while i < migrations.length do
        if string(migrations[i]["status"]) == "pending" then pendingBefore += 1 end
        i += 1
    end
    advanceMigrations()
    println("OK migration scan complete. Pending before: " + string(pendingBefore) + ", now: 0")
    print(formatMigrationProgress())
    return 0
end

func cmdClusterHealth() as int
    var nodes = ensureNodes()
    for nid, node in nodes
        if string(node["status"]) == "online" then
            heartbeatNode(string(nid))
        end
    end
    print(formatHealth())
    return 0
end

