// ============================================================================
// xdistdb.xl - Distributed Key-Value Database (5-star verification project)
// ============================================================================
// A complete distributed KV database simulation, covering:
//   1. Consistent hashing (150 vnodes per node, join/leave -> migration range)
//   2. Sharding (Key -> hash -> node, shard metadata, split/merge)
//   3. Raft consensus (Leader election / log replication / snapshot / members)
//   4. Replication (leader -> followers, linearizable read w/ lease, failover)
//   5. Data model (string/list/hash/set/zset + TTL + lazy/active expiry)
//   6. Query routing (coordinator + scatter-gather + cross-shard 2PC)
//   7. Client protocol (Redis-like text + HTTP API)
//   8. Ops (CLUSTER INFO/NODES, migration progress, health + heartbeat)
//
// CLI:
//   xdistdb cluster init [nodes=5]   initialize cluster
//   xdistdb cluster add              add a node (triggers migration)
//   xdistdb cluster remove <id>      remove a node
//   xdistdb cluster status           full status
//   xdistdb cluster ring             hash ring visualization
//   xdistdb cluster nodes/shards/slots/health/migrations/distribution
//   xdistdb set/get/del/exists/type/incr/expire/ttl/persist <key> ...
//   xdistdb lpush/rpush/lpop/rpop/lrange/llen <key> ...
//   xdistdb hset/hget/hgetall/hdel/hlen <key> ...
//   xdistdb sadd/srem/smembers/sismember/scard <key> ...
//   xdistdb zadd/zrange/zscore/zcard/zrem <key> ...
//   xdistdb keys <pattern>           scatter-gather KEYS
//   xdistdb count                    total key count
//   xdistdb fail <nodeId>            simulate node failure
//   xdistdb recover <nodeId>         recover failed node
//   xdistdb raft <shardId>           raft state of a shard
//   xdistdb eval <line>              Redis-like protocol line
//   xdistdb tx <c1> | <c2> | ...     cross-shard 2PC
//   xdistdb export/import <file>     state serialization
//   xdistdb reset                    clear all state
//   xdistdb test                     built-in test suite
//   xdistdb bench [ops=1000]         write+read+balance benchmark
//   xdistdb serve [port=18300]       HTTP API server
//   xdistdb help                     help
//
// Design:
//   * Cluster state persisted to xdistdb.state.json next to script/exe.
//     Each CLI call: load -> mutate -> save.
//   * Consistent hash ring: 2^32 hash space, VNODES_PER_NODE vnodes per node.
//   * SHARD_COUNT fixed logical shards; each shard has primary + replicas
//     determined by ringLookupN. Raft runs per-shard among replicas.
//   * Raft: full state machine (term/votedFor/log/commitIndex/lastApplied/
//     snapshot). Each write enters raft log -> AppendEntries -> majority
//     commit -> apply. Leader failure triggers re-election.
//   * Replication: leader writes then async syncs to followers; linearizable
//     read = leader read + lease freshness check.
//   * TTL: lazy (check on access) + active (sweep every N writes).
//   * Data types: string/list (array), hash (dict), set (dict-as-set),
//     zset (array<{member,score}>).
// ============================================================================


// ============================================================================
// Constants
// ============================================================================

const int VNODES_PER_NODE           = 150
const int DEFAULT_SHARD_COUNT       = 64
const int DEFAULT_REPLICA_FACTOR    = 3
const int DEFAULT_NODES             = 5
const int RAFT_ELECTION_TIMEOUT_MIN = 150
const int RAFT_ELECTION_TIMEOUT_MAX = 300
const int RAFT_HEARTBEAT_INTERVAL   = 50
const int RAFT_SNAPSHOT_THRESHOLD   = 50
const int RAFT_SNAPSHOT_KEEP_LOG    = 10
const int ACTIVE_SWEEP_EVERY        = 25
const int ACTIVE_SWEEP_BATCH        = 64
const int MIGRATION_BATCH_SIZE      = 100
const int DEFAULT_HTTP_PORT         = 18300
const int MAX_KEYS_LOG              = 50
const int BENCH_DEFAULT_OPS         = 1000
const int SHARD_SPLIT_THRESHOLD     = 200
const int SHARD_MERGE_THRESHOLD     = 20
const int LEASE_FRESHNESS_SEC       = 5
const string STATE_FILE_NAME        = "xdistdb.state.json"
const string STATE_VERSION          = "1.0"


// ============================================================================
// Global state
// ============================================================================

var gState = {}
string gStateFile = ""
mutex gLog = mutex()
int gPass = 0
int gFail = 0
bool gVerbose = false


// ============================================================================
// SECTION 1 - Utility functions
// ============================================================================

func nowSec() as int
    return time.toUnix(time.now())
end

func nowMs() as int
    return int(time.timer() * 1000.0)
end

func randInt(int lo, int hi) as int
    if hi <= lo then return lo end
    return lo + random.range(0, hi - lo)
end

func deepCopy(var d) as var
    if d == null then return null end
    return json.parse(json.stringify(d))
end

func hex8(int v) as string
    return string.formatInt(v, "x8")
end

func isEmpty(string s) as bool
    return string.len(s) == 0
end

func looksLikeInt(string s) as bool
    if isEmpty(s) then return false end
    int i = 0
    int fb = string.byteAt(s, 0)
    if fb == 45 or fb == 43 then i = 1 end
    if i >= string.len(s) then return false end
    while i < string.len(s) do
        int b = string.byteAt(s, i)
        if b < 48 or b > 57 then return false end
        i += 1
    end
    return true
end

func looksLikeFloat(string s) as bool
    bool hasDot = string.contains(s, ".")
    bool hasE = string.contains(s, "e") or string.contains(s, "E")
    if not hasDot and not hasE then return false end
    int i = 0
    int fb = string.byteAt(s, 0)
    if fb == 45 or fb == 43 then i = 1 end
    bool seenDigit = false
    while i < string.len(s) do
        int b = string.byteAt(s, i)
        if b >= 48 and b <= 57 then
            seenDigit = true
        elseif b == 46 or b == 101 or b == 69 or b == 45 or b == 43 then
            // allowed in float literal
        else
            return false
        end
        i += 1
    end
    return seenDigit
end

func parseScalar(string s) as var
    if s == "true" then return true end
    if s == "false" then return false end
    if s == "null" then return null end
    if looksLikeInt(s) then return int(s) end
    if looksLikeFloat(s) then return float(s) end
    return s
end

func typeName(var v) as string
    if v == null then return "none" end
    if v is bool then return "bool" end
    if v is int then return "int" end
    if v is float then return "float" end
    if v is string then return "string" end
    if type(v) == type([]) then return "list" end
    if type(v) == type({}) then return "dict" end
    return "unknown"
end

func valueToString(var v) as string
    if v == null then return "null" end
    if v is bool then
        if bool(v) then return "true" end
        return "false"
    end
    if v is int then return string(int(v)) end
    if v is float then return string(float(v)) end
    if v is string then return string(v) end
    return json.stringify(v)
end

func firstToken(string s) as (string, string)
    int sp = string.indexOf(s, " ")
    if sp < 0 then return string.trim(s), "" end
    string tok = string.trim(string.slice(s, 0, sp))
    string rem = string.ltrim(string.slice(s, sp + 1, string.len(s) - sp - 1))
    return tok, rem
end

func splitAll(string s, string sep) as var
    var arr = []
    if isEmpty(s) then return arr end
    string cur = ""
    int i = 0
    int seplen = string.len(sep)
    int n = string.len(s)
    while i < n do
        bool match = true
        int j = 0
        while j < seplen do
            if i + j >= n then
                match = false
                break
            end
            if string.byteAt(s, i + j) != string.byteAt(sep, j) then
                match = false
                break
            end
            j += 1
        end
        if match and seplen > 0 then
            arr.append(cur)
            cur = ""
            i += seplen
        else
            cur = cur + string.charAt(s, i)
            i += 1
        end
    end
    arr.append(cur)
    return arr
end

func splitFields(string s, string sep) as var
    var raw = splitAll(s, sep)
    var result = []
    int i = 0
    while i < raw.length do
        string t = string.trim(string(raw[i]))
        if not isEmpty(t) then result.append(t) end
        i += 1
    end
    return result
end

func joinStrings(var arr, string sep) as string
    string res = ""
    int i = 0
    while i < arr.length do
        if i > 0 then res = res + sep end
        res = res + string(arr[i])
        i += 1
    end
    return res
end

func joinLines(var arr) as string
    return joinStrings(arr, "\n")
end

func progressBar(float ratio, int width) as string
    if ratio < 0.0 then ratio = 0.0 end
    if ratio > 1.0 then ratio = 1.0 end
    int filled = int(ratio * float(width))
    if filled > width then filled = width end
    string bar = ""
    int i = 0
    while i < width do
        if i < filled then bar = bar + "#" else bar = bar + "-" end
        i += 1
    end
    return "[" + bar + "]"
end

func formatBytes(int n) as string
    if n < 1024 then return string(n) + " B" end
    float kb = float(n) / 1024.0
    if kb < 1024.0 then return string.formatFloat(kb, ".2") + " KB" end
    float mb = kb / 1024.0
    if mb < 1024.0 then return string.formatFloat(mb, ".2") + " MB" end
    float gb = mb / 1024.0
    return string.formatFloat(gb, ".2") + " GB"
end

func formatMs(int ms) as string
    if ms < 1000 then return string(ms) + " ms" end
    return string.formatFloat(float(ms) / 1000.0, ".3") + " s"
end

func electionTimeout(string shardId, int attempt) as int
    int seed = int(hash.u32(shardId + ":" + string(attempt)))
    int range = RAFT_ELECTION_TIMEOUT_MAX - RAFT_ELECTION_TIMEOUT_MIN
    return RAFT_ELECTION_TIMEOUT_MIN + (seed % range)
end

func padRight(string s, int width) as string
    return string.padRight(s, width)
end

// Sort var array by int field (insertion sort). Returns sorted copy.
func sortByHashField(var arr, string field) as var
    int n = arr.length
    int i = 1
    while i < n do
        var cur = arr[i]
        int j = i - 1
        while j >= 0 do
            if int(arr[j][field]) > int(cur[field]) then
                arr[j + 1] = arr[j]
                j -= 1
            else
                break
            end
        end
        arr[j + 1] = cur
        i += 1
    end
    return arr
end

func sortByFloatField(var arr, string field) as var
    int n = arr.length
    int i = 1
    while i < n do
        var cur = arr[i]
        int j = i - 1
        while j >= 0 do
            if float(arr[j][field]) > float(cur[field]) then
                arr[j + 1] = arr[j]
                j -= 1
            else
                break
            end
        end
        arr[j + 1] = cur
        i += 1
    end
    return arr
end

// Bubble sort array of strings ascending. Returns sorted copy.
func sortStringArray(var arr) as var
    int n = arr.length
    int i = 0
    while i < n do
        int j = 0
        while j < n - 1 - i do
            if string(arr[j]) > string(arr[j + 1]) then
                var t = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = t
            end
            j += 1
        end
        i += 1
    end
    return arr
end

func jsonEscapeStr(string s) as string
    string res = ""
    int i = 0
    int n = string.len(s)
    while i < n do
        string c = string.charAt(s, i)
        if c == "\"" then
            res = res + "\\\""
        elseif c == "\\" then
            res = res + "\\\\"
        elseif c == "\n" then
            res = res + "\\n"
        elseif c == "\r" then
            res = res + "\\r"
        elseif c == "\t" then
            res = res + "\\t"
        else
            res = res + c
        end
        i += 1
    end
    return res
end


// ============================================================================
// SECTION 2 - Consistent hash ring
// ============================================================================

func hashKey(string key) as int
    int h = int(hash.u32(key))
    if h < 0 then h = -h end
    return h
end

func hashVnode(string nodeId, int vnodeIdx) as int
    int h = int(hash.u32(nodeId + "-vn-" + string(vnodeIdx)))
    if h < 0 then h = -h end
    return h
end

func ensureRing() as var
    if not ("ring" in gState) then gState["ring"] = [] end
    return gState["ring"]
end

func rebuildRing()
    var ring = []
    var nodes = gState["nodes"]
    for nodeId, node in nodes
        int vi = 0
        while vi < VNODES_PER_NODE do
            int h = hashVnode(string(nodeId), vi)
            ring.append({"hash": h, "nodeId": string(nodeId), "vnodeId": vi})
            vi += 1
        end
    end
    ring = sortByHashField(ring, "hash")
    gState["ring"] = ring
end

func ringLookup(int h) as string
    var ring = ensureRing()
    int i = 0
    while i < ring.length do
        if int(ring[i]["hash"]) >= h then return string(ring[i]["nodeId"]) end
        i += 1
    end
    if ring.length > 0 then return string(ring[0]["nodeId"]) end
    return ""
end

func ringBinarySearch(int h) as int
    var ring = ensureRing()
    int lo = 0
    int hi = ring.length
    while lo < hi do
        int mid = (lo + hi) / 2
        if int(ring[mid]["hash"]) >= h then
            hi = mid
        else
            lo = mid + 1
        end
    end
    return lo
end

func ringLookupN(int h, int n) as var
    var ring = ensureRing()
    var res = []
    var seen = {}
    int count = ring.length
    if count == 0 then return res end
    int start = ringBinarySearch(h)
    if start >= count then start = 0 end
    int i = 0
    while i < count and res.length < n do
        int idx = (start + i) % count
        string nid = string(ring[idx]["nodeId"])
        if not (nid in seen) then
            seen[nid] = true
            res.append(nid)
        end
        i += 1
    end
    return res
end

func computeJoinMigration(string newNodeId) as var
    var ranges = []
    var ring = ensureRing()
    if ring.length == 0 then return ranges end
    var newVnodes = []
    int vi = 0
    while vi < VNODES_PER_NODE do
        int h = hashVnode(newNodeId, vi)
        newVnodes.append({"hash": h, "nodeId": newNodeId, "vnodeId": vi})
        vi += 1
    end
    newVnodes = sortByHashField(newVnodes, "hash")
    int i = 0
    while i < newVnodes.length do
        int nvHash = int(newVnodes[i]["hash"])
        string oldOwner = ringLookup(nvHash)
        int lastBefore = -1
        int k = 0
        while k < ring.length do
            if int(ring[k]["hash"]) < nvHash and int(ring[k]["hash"]) > lastBefore then
                lastBefore = int(ring[k]["hash"])
            end
            k += 1
        end
        int prevHash = 0
        if lastBefore >= 0 then prevHash = lastBefore end
        ranges.append({"fromHash": prevHash, "toHash": nvHash,
                       "oldOwner": oldOwner, "newOwner": newNodeId})
        i += 1
    end
    return ranges
end

func computeLeaveMigration(string leavingNodeId) as var
    var ranges = []
    var ring = ensureRing()
    if ring.length == 0 then return ranges end
    int i = 0
    while i < ring.length do
        if string(ring[i]["nodeId"]) == leavingNodeId then
            int leaveHash = int(ring[i]["hash"])
            string newOwner = ""
            int j = 1
            while j < ring.length do
                int idx = (i + j) % ring.length
                string cand = string(ring[idx]["nodeId"])
                if cand != leavingNodeId then
                    newOwner = cand
                    break
                end
                j += 1
            end
            int prevIdx = (i - 1 + ring.length) % ring.length
            int prevHash = int(ring[prevIdx]["hash"])
            ranges.append({"fromHash": prevHash, "toHash": leaveHash,
                           "oldOwner": leavingNodeId, "newOwner": newOwner})
        end
        i += 1
    end
    return ranges
end

func renderRingViz() as string
    var ring = ensureRing()
    if ring.length == 0 then return "(ring empty)" end
    var nodes = ensureNodes()
    string res = ""
    res = res + "=== Consistent Hash Ring Visualization ===\n"
    res = res + "vnodes: " + string(ring.length) + "  nodes: " + string(nodes.length) + "\n"
    res = res + "hash space: [0, 2^32) sampled into 32 segments\n"
    int step = 134217728
    int i = 0
    while i < 32 do
        int pos = i * step
        string owner = ringLookup(pos)
        var nodeCount = {}
        int j = 0
        while j < ring.length do
            int h = int(ring[j]["hash"])
            if h >= pos and h < pos + step then
                string nid = string(ring[j]["nodeId"])
                if not (nid in nodeCount) then nodeCount[nid] = 0 end
                nodeCount[nid] = int(nodeCount[nid]) + 1
            end
            j += 1
        end
        string line = hex8(pos) + " | owner=" + padRight(owner, 8) + " | "
        if nodeCount.length == 0 then
            line = line + "(no vnode)"
        else
            string parts = ""
            for nid, c in nodeCount
                if not isEmpty(parts) then parts = parts + ", " end
                parts = parts + string(nid) + ":" + string(c)
            end
            line = line + parts
        end
        res = res + line + "\n"
        i += 1
    end
    return res
end


// ============================================================================
// SECTION 3 - Cluster / Node management
// ============================================================================

func ensureNodes() as var
    if not ("nodes" in gState) then gState["nodes"] = {} end
    return gState["nodes"]
end

func ensureShards() as var
    if not ("shards" in gState) then gState["shards"] = {} end
    return gState["shards"]
end

func ensureRaft() as var
    if not ("raft" in gState) then gState["raft"] = {} end
    return gState["raft"]
end

func ensureData() as var
    if not ("data" in gState) then gState["data"] = {} end
    return gState["data"]
end

func ensureMigrations() as var
    if not ("migrations" in gState) then gState["migrations"] = [] end
    return gState["migrations"]
end

// Writeback helpers (xlang dict index returns by-value copy; must write back
// the whole parent dict after mutating a nested value).
func putNodes(var nodes)
    gState["nodes"] = nodes
end

func putShards(var shards)
    gState["shards"] = shards
end

func putRaftDict(var raft)
    gState["raft"] = raft
end

func putDataDict(var data)
    gState["data"] = data
end

func putMigrations(var migrations)
    gState["migrations"] = migrations
end

// Set node field (handles 2-level writeback).
func putNodeField(string nid, string field, var val)
    var nodes = gState["nodes"]
    var node = nodes[nid]
    node[field] = val
    nodes[nid] = node
    gState["nodes"] = nodes
end

// Remove a key from a node.
func removeNodeField(string nid, string field)
    var nodes = gState["nodes"]
    var node = nodes[nid]
    if field in node then
        node.remove(field)
    end
    nodes[nid] = node
    gState["nodes"] = nodes
end

// Set shard field (handles 2-level writeback).
func putShardField(string sid, string field, var val)
    var shards = gState["shards"]
    var sh = shards[sid]
    sh[field] = val
    shards[sid] = sh
    gState["shards"] = shards
end

// Set raft shard field (handles 2-level writeback).
func putRaftField(string sid, string field, var val)
    var raft = gState["raft"]
    var rs = raft[sid]
    rs[field] = val
    raft[sid] = rs
    gState["raft"] = raft
end

// Replace whole raft shard.
func putRaftShard(string sid, var rs)
    var raft = gState["raft"]
    raft[sid] = rs
    gState["raft"] = raft
end

// Replace whole shard.
func putShard(string sid, var sh)
    var shards = gState["shards"]
    shards[sid] = sh
    gState["shards"] = shards
end

// Replace whole shard data dict.
func putShardData(string sid, var sd)
    var data = gState["data"]
    data[sid] = sd
    gState["data"] = data
end

// Set data entry (handles 2-level writeback).
func putEntry(string sid, string key, var entry)
    var data = gState["data"]
    if not (sid in data) then
        data[sid] = {}
    end
    var sd = data[sid]
    sd[key] = entry
    data[sid] = sd
    gState["data"] = data
end

// Remove data entry.
func removeEntryKey(string sid, string key)
    var data = gState["data"]
    if not (sid in data) then return end
    var sd = data[sid]
    if key in sd then
        sd.remove(key)
    end
    data[sid] = sd
    gState["data"] = data
end

func ensureStats() as var
    if not ("stats" in gState) then gState["stats"] = {} end
    var s = gState["stats"]
    bool changed = false
    if not ("totalSets" in s) then
        s["totalSets"] = 0
        changed = true
    end
    if not ("totalGets" in s) then
        s["totalGets"] = 0
        changed = true
    end
    if not ("totalMisses" in s) then
        s["totalMisses"] = 0
        changed = true
    end
    if not ("totalDels" in s) then
        s["totalDels"] = 0
        changed = true
    end
    if not ("leaderChanges" in s) then
        s["leaderChanges"] = 0
        changed = true
    end
    if not ("migrationsCompleted" in s) then
        s["migrationsCompleted"] = 0
        changed = true
    end
    if not ("txCommits" in s) then
        s["txCommits"] = 0
        changed = true
    end
    if not ("txAborts" in s) then
        s["txAborts"] = 0
        changed = true
    end
    if not ("raftLogAppended" in s) then
        s["raftLogAppended"] = 0
        changed = true
    end
    if not ("raftLogCommitted" in s) then
        s["raftLogCommitted"] = 0
        changed = true
    end
    if not ("raftSnapshotsTaken" in s) then
        s["raftSnapshotsTaken"] = 0
        changed = true
    end
    if not ("sweepsActive" in s) then
        s["sweepsActive"] = 0
        changed = true
    end
    if not ("keysExpired" in s) then
        s["keysExpired"] = 0
        changed = true
    end
    if not ("opsSinceSweep" in s) then
        s["opsSinceSweep"] = 0
        changed = true
    end
    if not ("shardSplits" in s) then
        s["shardSplits"] = 0
        changed = true
    end
    if not ("shardMerges" in s) then
        s["shardMerges"] = 0
        changed = true
    end
    if changed then gState["stats"] = s end
    return s
end

func nextNodeId() as string
    var nodes = ensureNodes()
    int maxN = 0
    for nid, node in nodes
        string id = string(nid)
        if string.startsWith(id, "node-") then
            string suffix = string.slice(id, 5, string.len(id) - 5)
            if string.len(suffix) == 1 then
                int code = string.byteAt(suffix, 0)
                if code >= 97 and code <= 122 then
                    int num = code - 97 + 1
                    if num > maxN then maxN = num end
                end
            end
        end
    end
    int next = maxN + 1
    if next > 26 then return "node-" + string(next) end
    return "node-" + string.charAt("abcdefghijklmnopqrstuvwxyz", next - 1)
end

func makeNode(string nodeId, int port) as var
    return {"id": nodeId,
            "host": "127.0.0.1",
            "port": port,
            "status": "online",
            "joinTime": nowSec(),
            "lastHeartbeat": nowSec(),
            "heartbeatVersion": 0,
            "vnodes": VNODES_PER_NODE}
end

func clusterAddNode(string nodeId, int port) as var
    var nodes = gState["nodes"]
    if nodeId in nodes then return {"ok": false, "error": "node already exists"} end
    var node = makeNode(nodeId, port)
    nodes[nodeId] = node
    gState["nodes"] = nodes
    var ranges = computeJoinMigration(nodeId)
    rebuildRing()
    reassignShards()
    var migrations = gState["migrations"]
    migrations.append({"id": "mig-" + string(migrations.length + 1),
                       "type": "join",
                       "nodeId": nodeId,
                       "ranges": ranges,
                       "totalKeys": countKeysInRanges(ranges),
                       "movedKeys": 0,
                       "status": "pending",
                       "createdAt": nowSec()})
    gState["migrations"] = migrations
    return {"ok": true, "node": node, "ranges": ranges}
end

func clusterRemoveNode(string nodeId) as var
    var nodes = gState["nodes"]
    if not (nodeId in nodes) then return {"ok": false, "error": "node not found"} end
    var ranges = computeLeaveMigration(nodeId)
    var node = nodes[nodeId]
    node["status"] = "leaving"
    nodes[nodeId] = node
    nodes.remove(nodeId)
    gState["nodes"] = nodes
    rebuildRing()
    reassignShards()
    var migrations = gState["migrations"]
    migrations.append({"id": "mig-" + string(migrations.length + 1),
                       "type": "leave",
                       "nodeId": nodeId,
                       "ranges": ranges,
                       "totalKeys": countKeysInRanges(ranges),
                       "movedKeys": 0,
                       "status": "pending",
                       "createdAt": nowSec()})
    gState["migrations"] = migrations
    return {"ok": true, "ranges": ranges}
end

func clusterFailNode(string nodeId) as var
    var nodes = gState["nodes"]
    if not (nodeId in nodes) then return {"ok": false, "error": "node not found"} end
    var node = nodes[nodeId]
    node["status"] = "down"
    node["downAt"] = nowSec()
    nodes[nodeId] = node
    gState["nodes"] = nodes
    var shards = gState["shards"]
    var affected = []
    for sid, sh in shards
        if string(sh["leader"]) == nodeId then affected.append(sid) end
    end
    int relected = 0
    int i = 0
    while i < affected.length do
        var r = raftStartElection(string(affected[i]))
        if bool(r["ok"]) then relected += 1 end
        i += 1
    end
    return {"ok": true, "affectedShards": affected, "reelected": relected}
end

func clusterRecoverNode(string nodeId) as var
    var nodes = gState["nodes"]
    if not (nodeId in nodes) then return {"ok": false, "error": "node not found"} end
    var node = nodes[nodeId]
    node["status"] = "online"
    node["lastHeartbeat"] = nowSec()
    node["heartbeatVersion"] = int(node["heartbeatVersion"]) + 1
    if "downAt" in node then node.remove("downAt") end
    nodes[nodeId] = node
    gState["nodes"] = nodes
    return {"ok": true}
end

func heartbeatNode(string nodeId) as var
    var nodes = gState["nodes"]
    if not (nodeId in nodes) then return {"ok": false, "error": "node not found"} end
    var node = nodes[nodeId]
    node["lastHeartbeat"] = nowSec()
    node["heartbeatVersion"] = int(node["heartbeatVersion"]) + 1
    nodes[nodeId] = node
    gState["nodes"] = nodes
    return {"ok": true}
end

func clusterHealth() as var
    var nodes = gState["nodes"]
    var res = []
    int now = nowSec()
    for nid, node in nodes
        int last = int(node["lastHeartbeat"])
        int age = now - last
        string status = "healthy"
        if string(node["status"]) == "down" then
            status = "down"
        elseif age > 30 then
            status = "stale"
        end
        res.append({"id": string(nid),
                    "status": string(node["status"]),
                    "health": status,
                    "heartbeatAgeSec": age,
                    "heartbeatVersion": int(node["heartbeatVersion"])})
    end
    return res
end


// ============================================================================
// SECTION 4 - Sharding
// ============================================================================

func countKeysInRanges(var ranges) as int
    if ranges.length == 0 then return 0 end
    int totalKeys = 0
    var data = ensureData()
    for sid, shardData in data
        totalKeys += shardData.length
    end
    int rangeWidth = 0
    int i = 0
    while i < ranges.length do
        int from = int(ranges[i]["fromHash"])
        int to = int(ranges[i]["toHash"])
        if to >= from then rangeWidth += (to - from) end
        i += 1
    end
    if rangeWidth <= 0 then return 0 end
    int estimate = totalKeys * rangeWidth / 4294967296
    if estimate < 1 then estimate = 1 end
    return estimate
end

func shardOf(string key) as string
    int h = hashKey(key)
    return string(h % DEFAULT_SHARD_COUNT)
end

func ensureShard(string sid) as var
    var shards = ensureShards()
    if not (sid in shards) then
        shards[sid] = {"id": sid,
                       "primary": "",
                       "replicas": [],
                       "leader": "",
                       "leaderTerm": 0,
                       "keyCount": 0,
                       "splitCount": 0,
                       "mergeCount": 0}
    end
    return shards[sid]
end

func ensureShardData(string sid) as var
    var data = ensureData()
    if not (sid in data) then data[sid] = {} end
    return data[sid]
end

func reassignShards()
    var shards = gState["shards"]
    var onlineNodes = []
    var nodes = gState["nodes"]
    for nid, node in nodes
        if string(node["status"]) == "online" then onlineNodes.append(string(nid)) end
    end
    if onlineNodes.length == 0 then return end
    int i = 0
    while i < DEFAULT_SHARD_COUNT do
        string sid = string(i)
        if not (sid in shards) then
            shards[sid] = {"id": sid,
                           "primary": "",
                           "replicas": [],
                           "leader": "",
                           "leaderTerm": 0,
                           "keyCount": 0,
                           "splitCount": 0,
                           "mergeCount": 0}
        end
        var sh = shards[sid]
        int h = hashKey("shard-" + sid)
        int replicaCount = DEFAULT_REPLICA_FACTOR
        if onlineNodes.length < replicaCount then replicaCount = onlineNodes.length end
        var replicas = ringLookupN(h, replicaCount)
        if replicas.length > 0 then
            sh["primary"] = replicas[0]
            sh["replicas"] = replicas
            string cur = string(sh["leader"])
            bool leaderOk = false
            int r = 0
            while r < replicas.length do
                if string(replicas[r]) == cur then
                    leaderOk = true
                    break
                end
                r += 1
            end
            if not leaderOk then sh["leader"] = replicas[0] end
        end
        shards[sid] = sh
        i += 1
    end
    gState["shards"] = shards
end

func clusterInit(int nodeCount) as var
    if nodeCount < 1 then nodeCount = 1 end
    gState = {}
    gState["version"] = STATE_VERSION
    gState["createdAt"] = nowSec()
    gState["updatedAt"] = nowSec()
    gState["nodes"] = {}
    gState["shards"] = {}
    gState["raft"] = {}
    gState["data"] = {}
    gState["migrations"] = []
    gState["stats"] = {}
    var nodes = gState["nodes"]
    ensureStats()
    int i = 0
    while i < nodeCount do
        string nid = ""
        if i < 26 then
            nid = "node-" + string.charAt("abcdefghijklmnopqrstuvwxyz", i)
        else
            nid = "node-" + string(i + 1)
        end
        var node = makeNode(nid, 7000 + i + 1)
        nodes[nid] = node
        i += 1
    end
    gState["nodes"] = nodes
    rebuildRing()
    reassignShards()
    int s = 0
    while s < DEFAULT_SHARD_COUNT do
        raftInitShard(string(s))
        s += 1
    end
    gState["updatedAt"] = nowSec()
    return {"ok": true, "nodes": nodeCount, "shards": DEFAULT_SHARD_COUNT}
end

func shardSplit(string sid) as var
    var shards = gState["shards"]
    if not (sid in shards) then return {"ok": false, "error": "no shard"} end
    var sh = shards[sid]
    if int(sh["keyCount"]) < SHARD_SPLIT_THRESHOLD then
        return {"ok": false, "error": "below threshold"}
    end
    sh["splitCount"] = int(sh["splitCount"]) + 1
    shards[sid] = sh
    gState["shards"] = shards
    var stats = gState["stats"]
    stats["shardSplits"] = int(stats["shardSplits"]) + 1
    gState["stats"] = stats
    return {"ok": true, "splitCount": int(sh["splitCount"])}
end

func shardMerge(string sid) as var
    var shards = gState["shards"]
    if not (sid in shards) then return {"ok": false, "error": "no shard"} end
    var sh = shards[sid]
    if int(sh["keyCount"]) >= SHARD_MERGE_THRESHOLD then
        return {"ok": false, "error": "above threshold"}
    end
    sh["mergeCount"] = int(sh["mergeCount"]) + 1
    shards[sid] = sh
    gState["shards"] = shards
    var stats = gState["stats"]
    stats["shardMerges"] = int(stats["shardMerges"]) + 1
    gState["stats"] = stats
    return {"ok": true, "mergeCount": int(sh["mergeCount"])}
end

func advanceMigrations()
    var migrations = gState["migrations"]
    int i = 0
    while i < migrations.length do
        if string(migrations[i]["status"]) == "pending" then
            var m = migrations[i]
            m["status"] = "completed"
            m["movedKeys"] = int(m["totalKeys"])
            m["completedAt"] = nowSec()
            migrations[i] = m
            var stats = gState["stats"]
            stats["migrationsCompleted"] = int(stats["migrationsCompleted"]) + 1
            gState["stats"] = stats
        end
        i += 1
    end
    gState["migrations"] = migrations
end


// ============================================================================
// SECTION 5 - TTL + expiration
// ============================================================================

func getEntry(string sid, string key) as var
    var data = gState["data"]
    if not (sid in data) then return null end
    var sd = data[sid]
    if not (key in sd) then return null end
    return sd[key]
end

func isExpired(var entry) as bool
    if entry == null then return true end
    if not ("ttl" in entry) then return false end
    int ttl = int(entry["ttl"])
    if ttl <= 0 then return false end
    return ttl <= nowSec()
end

func lazyExpire(string sid, string key) as bool
    var entry = getEntry(sid, key)
    if entry == null then return false end
    if isExpired(entry) then
        removeEntryKey(sid, key)
        decrShardKeyCount(sid)
        var stats = ensureStats()
        stats["keysExpired"] = int(stats["keysExpired"]) + 1
        gState["stats"] = stats
        return true
    end
    return false
end

func decrShardKeyCount(string sid)
    var shards = gState["shards"]
    if not (sid in shards) then return end
    var sh = shards[sid]
    int c = int(sh["keyCount"])
    if c > 0 then sh["keyCount"] = c - 1 end
    shards[sid] = sh
    gState["shards"] = shards
end

func incrShardKeyCount(string sid)
    var shards = gState["shards"]
    if not (sid in shards) then
        shards[sid] = {"id": sid, "primary": "", "replicas": [], "leader": "",
                       "leaderTerm": 0, "keyCount": 0, "splitCount": 0, "mergeCount": 0}
    end
    var sh = shards[sid]
    sh["keyCount"] = int(sh["keyCount"]) + 1
    shards[sid] = sh
    gState["shards"] = shards
end

func activeSweepShard(string sid, int batch) as int
    var data = gState["data"]
    if not (sid in data) then return 0 end
    var sd = data[sid]
    var expired = []
    int now = nowSec()
    int scanned = 0
    for key, entry in sd
        if scanned >= batch then break end
        scanned += 1
        if "ttl" in entry then
            int ttl = int(entry["ttl"])
            if ttl > 0 and ttl <= now then expired.append(key) end
        end
    end
    int i = 0
    while i < expired.length do
        sd.remove(string(expired[i]))
        decrShardKeyCount(sid)
        i += 1
    end
    data[sid] = sd
    gState["data"] = data
    if expired.length > 0 then
        var stats = ensureStats()
        stats["keysExpired"] = int(stats["keysExpired"]) + expired.length
        gState["stats"] = stats
    end
    return expired.length
end

func maybeActiveSweep()
    var stats = gState["stats"]
    int ops = int(stats["opsSinceSweep"]) + 1
    stats["opsSinceSweep"] = ops
    if ops >= ACTIVE_SWEEP_EVERY then
        stats["opsSinceSweep"] = 0
        stats["sweepsActive"] = int(stats["sweepsActive"]) + 1
        int target = int(stats["sweepsActive"]) % DEFAULT_SHARD_COUNT
        activeSweepShard(string(target), ACTIVE_SWEEP_BATCH)
    end
    gState["stats"] = stats
end


// ============================================================================
// SECTION 6 - Data model (KVStore: string/list/hash/set/zset)
// ============================================================================

func makeEntry(string t, var value) as var
    return {"type": t,
            "value": value,
            "ttl": 0,
            "createdAt": nowSec(),
            "updatedAt": nowSec(),
            "version": 1}
end

// ----- string -----

func opSet(string sid, string key, var value) as string
    var entry = getEntry(sid, key)
    if entry != null then
        entry["type"] = "string"
        entry["value"] = value
        entry["updatedAt"] = nowSec()
        entry["version"] = int(entry["version"]) + 1
        putEntry(sid, key, entry)
    else
        putEntry(sid, key, makeEntry("string", value))
        incrShardKeyCount(sid)
    end
    return "OK"
end

func opGet(string sid, string key) as string
    if lazyExpire(sid, key) then return "(nil)" end
    var entry = getEntry(sid, key)
    if entry == null then return "(nil)" end
    if string(entry["type"]) != "string" then
        return "(error) WRONGTYPE Operation against a key holding the wrong kind of value"
    end
    return valueToString(entry["value"])
end

func opDel(string sid, string key) as int
    var entry = getEntry(sid, key)
    if entry == null then return 0 end
    removeEntryKey(sid, key)
    decrShardKeyCount(sid)
    return 1
end

func opExists(string sid, string key) as int
    if lazyExpire(sid, key) then return 0 end
    var entry = getEntry(sid, key)
    if entry == null then return 0 end
    return 1
end

func opType(string sid, string key) as string
    if lazyExpire(sid, key) then return "none" end
    var entry = getEntry(sid, key)
    if entry == null then return "none" end
    return string(entry["type"])
end

func opIncr(string sid, string key, int delta) as string
    var entry = getEntry(sid, key)
    int cur = 0
    if entry != null then
        if string(entry["type"]) != "string" and string(entry["type"]) != "int" then
            return "(error) WRONGTYPE"
        end
        cur = int(entry["value"])
        entry["value"] = cur + delta
        entry["updatedAt"] = nowSec()
        entry["version"] = int(entry["version"]) + 1
        putEntry(sid, key, entry)
    else
        putEntry(sid, key, makeEntry("string", cur + delta))
        incrShardKeyCount(sid)
    end
    return string(cur + delta)
end

func opExpire(string sid, string key, int secs) as int
    var entry = getEntry(sid, key)
    if entry == null then return 0 end
    entry["ttl"] = nowSec() + secs
    entry["updatedAt"] = nowSec()
    entry["version"] = int(entry["version"]) + 1
    putEntry(sid, key, entry)
    return 1
end

func opPersist(string sid, string key) as int
    var entry = getEntry(sid, key)
    if entry == null then return 0 end
    if "ttl" in entry then
        if int(entry["ttl"]) > 0 then
            entry["ttl"] = 0
            putEntry(sid, key, entry)
            return 1
        end
    end
    return 0
end

func opTtl(string sid, string key) as int
    if lazyExpire(sid, key) then return -2 end
    var entry = getEntry(sid, key)
    if entry == null then return -2 end
    if not ("ttl" in entry) then return -1 end
    int ttl = int(entry["ttl"])
    if ttl <= 0 then return -1 end
    int remain = ttl - nowSec()
    if remain <= 0 then return -2 end
    return remain
end

// ----- list -----

func opLpush(string sid, string key, var values) as string
    var entry = getEntry(sid, key)
    if entry == null then
        entry = makeEntry("list", [])
        incrShardKeyCount(sid)
    elseif string(entry["type"]) != "list" then
        return "(error) WRONGTYPE"
    end
    var lst = entry["value"]
    int i = values.length - 1
    while i >= 0 do
        lst.insert(0, values[i])
        i -= 1
    end
    entry["value"] = lst
    entry["updatedAt"] = nowSec()
    entry["version"] = int(entry["version"]) + 1
    putEntry(sid, key, entry)
    return string(lst.length)
end

func opRpush(string sid, string key, var values) as string
    var entry = getEntry(sid, key)
    if entry == null then
        entry = makeEntry("list", [])
        incrShardKeyCount(sid)
    elseif string(entry["type"]) != "list" then
        return "(error) WRONGTYPE"
    end
    var lst = entry["value"]
    int i = 0
    while i < values.length do
        lst.append(values[i])
        i += 1
    end
    entry["value"] = lst
    entry["updatedAt"] = nowSec()
    entry["version"] = int(entry["version"]) + 1
    putEntry(sid, key, entry)
    return string(lst.length)
end

func opLpop(string sid, string key, int count) as string
    if lazyExpire(sid, key) then return "(nil)" end
    var entry = getEntry(sid, key)
    if entry == null then return "(nil)" end
    if string(entry["type"]) != "list" then return "(error) WRONGTYPE" end
    var lst = entry["value"]
    if lst.length == 0 then return "(nil)" end
    if count <= 0 then count = 1 end
    if count > lst.length then count = lst.length end
    var popped = []
    int i = 0
    while i < count do
        popped.append(lst[0])
        lst.remove(0)
        i += 1
    end
    entry["value"] = lst
    entry["updatedAt"] = nowSec()
    entry["version"] = int(entry["version"]) + 1
    putEntry(sid, key, entry)
    if popped.length == 1 then return valueToString(popped[0]) end
    return json.stringify(popped)
end

func opRpop(string sid, string key, int count) as string
    if lazyExpire(sid, key) then return "(nil)" end
    var entry = getEntry(sid, key)
    if entry == null then return "(nil)" end
    if string(entry["type"]) != "list" then return "(error) WRONGTYPE" end
    var lst = entry["value"]
    if lst.length == 0 then return "(nil)" end
    if count <= 0 then count = 1 end
    if count > lst.length then count = lst.length end
    var popped = []
    int i = 0
    while i < count do
        int last = lst.length - 1
        popped.append(lst[last])
        lst.remove(last)
        i += 1
    end
    entry["value"] = lst
    entry["updatedAt"] = nowSec()
    entry["version"] = int(entry["version"]) + 1
    putEntry(sid, key, entry)
    if popped.length == 1 then return valueToString(popped[0]) end
    return json.stringify(popped)
end

func opLrange(string sid, string key, int start, int stop) as string
    if lazyExpire(sid, key) then return "[]" end
    var entry = getEntry(sid, key)
    if entry == null then return "[]" end
    if string(entry["type"]) != "list" then return "(error) WRONGTYPE" end
    var lst = entry["value"]
    int n = lst.length
    if n == 0 then return "[]" end
    if start < 0 then start = n + start end
    if stop < 0 then stop = n + stop end
    if start < 0 then start = 0 end
    if stop >= n then stop = n - 1 end
    if start > stop or start >= n then return "[]" end
    var res = []
    int i = start
    while i <= stop do
        res.append(lst[i])
        i += 1
    end
    return json.stringify(res)
end

func opLlen(string sid, string key) as string
    if lazyExpire(sid, key) then return "0" end
    var entry = getEntry(sid, key)
    if entry == null then return "0" end
    if string(entry["type"]) != "list" then return "(error) WRONGTYPE" end
    return string(entry["value"].length)
end

// ----- hash -----

func opHset(string sid, string key, string field, string val) as int
    var entry = getEntry(sid, key)
    if entry == null then
        entry = makeEntry("hash", {})
        incrShardKeyCount(sid)
    elseif string(entry["type"]) != "hash" then
        return -1
    end
    var h = entry["value"]
    bool isNew = not (field in h)
    h[field] = parseScalar(val)
    entry["value"] = h
    entry["updatedAt"] = nowSec()
    entry["version"] = int(entry["version"]) + 1
    putEntry(sid, key, entry)
    if isNew then return 1 end
    return 0
end

func opHget(string sid, string key, string field) as string
    if lazyExpire(sid, key) then return "(nil)" end
    var entry = getEntry(sid, key)
    if entry == null then return "(nil)" end
    if string(entry["type"]) != "hash" then return "(error) WRONGTYPE" end
    var h = entry["value"]
    if not (field in h) then return "(nil)" end
    return valueToString(h[field])
end

func opHgetall(string sid, string key) as string
    if lazyExpire(sid, key) then return "(empty)" end
    var entry = getEntry(sid, key)
    if entry == null then return "(empty)" end
    if string(entry["type"]) != "hash" then return "(error) WRONGTYPE" end
    var h = entry["value"]
    if h.length == 0 then return "(empty)" end
    var lines = []
    for f, v in h
        lines.append(string(f) + " = " + valueToString(v))
    end
    return joinLines(lines)
end

func opHdel(string sid, string key, string field) as int
    if lazyExpire(sid, key) then return 0 end
    var entry = getEntry(sid, key)
    if entry == null then return 0 end
    if string(entry["type"]) != "hash" then return -1 end
    var h = entry["value"]
    if not (field in h) then return 0 end
    h.remove(field)
    entry["value"] = h
    entry["updatedAt"] = nowSec()
    entry["version"] = int(entry["version"]) + 1
    putEntry(sid, key, entry)
    return 1
end

func opHlen(string sid, string key) as string
    if lazyExpire(sid, key) then return "0" end
    var entry = getEntry(sid, key)
    if entry == null then return "0" end
    if string(entry["type"]) != "hash" then return "(error) WRONGTYPE" end
    return string(entry["value"].length)
end

// ----- set -----

func opSadd(string sid, string key, var members) as int
    var entry = getEntry(sid, key)
    if entry == null then
        entry = makeEntry("set", {})
        incrShardKeyCount(sid)
    elseif string(entry["type"]) != "set" then
        return -1
    end
    var s = entry["value"]
    int added = 0
    int i = 0
    while i < members.length do
        string m = string(members[i])
        if not (m in s) then
            s[m] = true
            added += 1
        end
        i += 1
    end
    if added > 0 then
        entry["value"] = s
        entry["updatedAt"] = nowSec()
        entry["version"] = int(entry["version"]) + 1
        putEntry(sid, key, entry)
    end
    return added
end

func opSrem(string sid, string key, var members) as int
    if lazyExpire(sid, key) then return 0 end
    var entry = getEntry(sid, key)
    if entry == null then return 0 end
    if string(entry["type"]) != "set" then return -1 end
    var s = entry["value"]
    int removed = 0
    int i = 0
    while i < members.length do
        string m = string(members[i])
        if m in s then
            s.remove(m)
            removed += 1
        end
        i += 1
    end
    if removed > 0 then
        entry["value"] = s
        entry["updatedAt"] = nowSec()
        entry["version"] = int(entry["version"]) + 1
        putEntry(sid, key, entry)
    end
    return removed
end

func opSmembers(string sid, string key) as string
    if lazyExpire(sid, key) then return "(empty)" end
    var entry = getEntry(sid, key)
    if entry == null then return "(empty)" end
    if string(entry["type"]) != "set" then return "(error) WRONGTYPE" end
    var s = entry["value"]
    if s.length == 0 then return "(empty)" end
    var lines = []
    for m, flag in s
        lines.append(string(m))
    end
    return joinLines(lines)
end

func opSismember(string sid, string key, string member) as int
    if lazyExpire(sid, key) then return 0 end
    var entry = getEntry(sid, key)
    if entry == null then return 0 end
    if string(entry["type"]) != "set" then return -1 end
    var s = entry["value"]
    if member in s then return 1 end
    return 0
end

func opScard(string sid, string key) as string
    if lazyExpire(sid, key) then return "0" end
    var entry = getEntry(sid, key)
    if entry == null then return "0" end
    if string(entry["type"]) != "set" then return "(error) WRONGTYPE" end
    return string(entry["value"].length)
end

// ----- zset -----

func opZadd(string sid, string key, float score, string member) as int
    var entry = getEntry(sid, key)
    if entry == null then
        entry = makeEntry("zset", [])
        incrShardKeyCount(sid)
    elseif string(entry["type"]) != "zset" then
        return -1
    end
    var lst = entry["value"]
    int i = 0
    while i < lst.length do
        if string(lst[i]["member"]) == member then
            lst[i]["score"] = score
            entry["value"] = lst
            entry["updatedAt"] = nowSec()
            entry["version"] = int(entry["version"]) + 1
            putEntry(sid, key, entry)
            return 0
        end
        i += 1
    end
    lst.append({"member": member, "score": score})
    entry["value"] = lst
    entry["updatedAt"] = nowSec()
    entry["version"] = int(entry["version"]) + 1
    putEntry(sid, key, entry)
    return 1
end

func opZrem(string sid, string key, string member) as int
    if lazyExpire(sid, key) then return 0 end
    var entry = getEntry(sid, key)
    if entry == null then return 0 end
    if string(entry["type"]) != "zset" then return -1 end
    var lst = entry["value"]
    int i = 0
    while i < lst.length do
        if string(lst[i]["member"]) == member then
            lst.remove(i)
            entry["value"] = lst
            entry["updatedAt"] = nowSec()
            entry["version"] = int(entry["version"]) + 1
            putEntry(sid, key, entry)
            return 1
        end
        i += 1
    end
    return 0
end

func opZrange(string sid, string key, int start, int stop) as string
    if lazyExpire(sid, key) then return "(empty)" end
    var entry = getEntry(sid, key)
    if entry == null then return "(empty)" end
    if string(entry["type"]) != "zset" then return "(error) WRONGTYPE" end
    var sorted = deepCopy(entry["value"])
    sorted = sortByFloatField(sorted, "score")
    int n = sorted.length
    if n == 0 then return "(empty)" end
    if start < 0 then start = n + start end
    if stop < 0 then stop = n + stop end
    if start < 0 then start = 0 end
    if stop >= n then stop = n - 1 end
    if start > stop or start >= n then return "(empty)" end
    var lines = []
    int i = start
    while i <= stop do
        string m = string(sorted[i]["member"])
        float sc = float(sorted[i]["score"])
        lines.append(m + " : " + string.formatFloat(sc, ".4"))
        i += 1
    end
    return joinLines(lines)
end

func opZscore(string sid, string key, string member) as string
    if lazyExpire(sid, key) then return "(nil)" end
    var entry = getEntry(sid, key)
    if entry == null then return "(nil)" end
    if string(entry["type"]) != "zset" then return "(error) WRONGTYPE" end
    var lst = entry["value"]
    int i = 0
    while i < lst.length do
        if string(lst[i]["member"]) == member then
            return string.formatFloat(float(lst[i]["score"]), ".4")
        end
        i += 1
    end
    return "(nil)"
end

func opZcard(string sid, string key) as string
    if lazyExpire(sid, key) then return "0" end
    var entry = getEntry(sid, key)
    if entry == null then return "0" end
    if string(entry["type"]) != "zset" then return "(error) WRONGTYPE" end
    return string(entry["value"].length)
end


// ============================================================================
// SECTION 7 - Raft consensus (per shard)
// ============================================================================

func ensureRaftShard(string sid) as var
    var raft = gState["raft"]
    if not (sid in raft) then
        raft[sid] = {"currentTerm": 0,
                     "votedFor": "",
                     "leaderId": "",
                     "leaderTerm": 0,
                     "log": [],
                     "commitIndex": 0,
                     "lastApplied": 0,
                     "snapshot": null,
                     "snapshotIndex": 0,
                     "snapshotTerm": 0,
                     "votesReceived": [],
                     "status": "follower",
                     "matchIndex": {},
                     "nextIndex": {},
                     "electionAttempt": 0,
                     "lastHeartbeat": nowSec()}
        gState["raft"] = raft
    end
    var r2 = gState["raft"]
    return r2[sid]
end

func raftInitShard(string sid)
    var shards = gState["shards"]
    var sh = shards[sid]
    string primary = string(sh["primary"])
    var rs = {"currentTerm": 1,
              "votedFor": primary,
              "leaderId": primary,
              "leaderTerm": 1,
              "log": [{"term": 1, "index": 1, "op": "noop",
                       "key": "", "value": "", "type": "string"}],
              "commitIndex": 1,
              "lastApplied": 1,
              "snapshot": null,
              "snapshotIndex": 0,
              "snapshotTerm": 0,
              "votesReceived": [primary],
              "status": "leader",
              "matchIndex": {},
              "nextIndex": {},
              "electionAttempt": 0,
              "lastHeartbeat": nowSec()}
    var replicas = sh["replicas"]
    var matchIdx = {}
    var nextIdx = {}
    int i = 0
    while i < replicas.length do
        string rid = string(replicas[i])
        matchIdx[rid] = 1
        nextIdx[rid] = 2
        i += 1
    end
    rs["matchIndex"] = matchIdx
    rs["nextIndex"] = nextIdx
    putRaftShard(sid, rs)
end

func raftLeaderOf(string sid) as string
    var raft = gState["raft"]
    if not (sid in raft) then return "" end
    var rs = raft[sid]
    return string(rs["leaderId"])
end

func raftOnlineReplicas(string sid) as var
    var shards = gState["shards"]
    if not (sid in shards) then return [] end
    var sh = shards[sid]
    var replicas = sh["replicas"]
    var online = []
    var nodes = gState["nodes"]
    int i = 0
    while i < replicas.length do
        string rid = string(replicas[i])
        if rid in nodes then
            var n = nodes[rid]
            if string(n["status"]) == "online" then online.append(rid) end
        end
        i += 1
    end
    return online
end

func raftQuorum(int n) as int
    return n / 2 + 1
end

func raftAppendEntries(string sid, var entry) as int
    var raft = gState["raft"]
    if not (sid in raft) then return 0 end
    var rs = raft[sid]
    var online = raftOnlineReplicas(sid)
    int acks = 0
    int newIdx = int(entry["index"])
    string leader = string(rs["leaderId"])
    var matchIdx = rs["matchIndex"]
    var nextIdx = rs["nextIndex"]
    int i = 0
    while i < online.length do
        string rid = string(online[i])
        if rid == leader then
            acks += 1
        else
            acks += 1
            matchIdx[rid] = newIdx
            nextIdx[rid] = newIdx + 1
        end
        i += 1
    end
    rs["matchIndex"] = matchIdx
    rs["nextIndex"] = nextIdx
    raft[sid] = rs
    gState["raft"] = raft
    return acks
end

func raftRequestVote(string sid, int term, string candidateId) as int
    var raft = gState["raft"]
    if not (sid in raft) then return 0 end
    var rs = raft[sid]
    var online = raftOnlineReplicas(sid)
    int votes = 0
    int curTerm = int(rs["currentTerm"])
    string voted = string(rs["votedFor"])
    int i = 0
    while i < online.length do
        string rid = string(online[i])
        if rid == candidateId then
            votes += 1
        else
            if term > curTerm then
                curTerm = term
                voted = candidateId
                votes += 1
            elseif term == curTerm then
                if voted == "" or voted == candidateId then
                    voted = candidateId
                    votes += 1
                end
            end
        end
        i += 1
    end
    rs["currentTerm"] = curTerm
    rs["votedFor"] = voted
    raft[sid] = rs
    gState["raft"] = raft
    return votes
end

func raftStartElection(string sid) as var
    var raft = gState["raft"]
    if not (sid in raft) then return {"ok": false, "error": "no raft state"} end
    var rs = raft[sid]
    var online = raftOnlineReplicas(sid)
    if online.length == 0 then return {"ok": false, "error": "no online replicas"} end
    int attempt = int(rs["electionAttempt"]) + 1
    rs["electionAttempt"] = attempt
    int newTerm = int(rs["currentTerm"]) + 1
    rs["currentTerm"] = newTerm
    rs["status"] = "candidate"
    var sorted = deepCopy(online)
    sorted = sortStringArray(sorted)
    string candidate = string(sorted[0])
    rs["votedFor"] = candidate
    raft[sid] = rs
    gState["raft"] = raft
    int votes = raftRequestVote(sid, newTerm, candidate)
    int q = raftQuorum(online.length)
    var stats = gState["stats"]
    if votes >= q then
        putRaftField(sid, "leaderId", candidate)
        putRaftField(sid, "leaderTerm", newTerm)
        putRaftField(sid, "status", "leader")
        putRaftField(sid, "lastHeartbeat", nowSec())
        putRaftField(sid, "votesReceived", [candidate])
        putShardField(sid, "leader", candidate)
        putShardField(sid, "leaderTerm", newTerm)
        stats["leaderChanges"] = int(stats["leaderChanges"]) + 1
        gState["stats"] = stats
        return {"ok": true, "leader": candidate, "term": newTerm, "votes": votes}
    end
    putRaftField(sid, "status", "follower")
    stats["leaderChanges"] = int(stats["leaderChanges"])
    gState["stats"] = stats
    return {"ok": false, "votes": votes, "needed": q}
end

func raftAppendAndApply(string sid, var command) as int
    var raft = gState["raft"]
    if not (sid in raft) then return -1 end
    var rs = raft[sid]
    string leader = string(rs["leaderId"])
    if isEmpty(leader) then return -1 end
    var nodes = gState["nodes"]
    if not (leader in nodes) then return -1 end
    var leaderNode = nodes[leader]
    if string(leaderNode["status"]) != "online" then return -1 end
    var log = rs["log"]
    int newIdx = int(rs["commitIndex"]) + 1
    var entry = {"term": int(rs["currentTerm"]),
                 "index": newIdx,
                 "op": string(command["op"]),
                 "key": string(command["key"]),
                 "value": command["value"],
                 "type": string(command["type"])}
    log.append(entry)
    rs["log"] = log
    raft[sid] = rs
    gState["raft"] = raft
    var stats = gState["stats"]
    stats["raftLogAppended"] = int(stats["raftLogAppended"]) + 1
    gState["stats"] = stats
    int acks = raftAppendEntries(sid, entry)
    var online = raftOnlineReplicas(sid)
    int q = raftQuorum(online.length)
    if acks >= q then
        putRaftField(sid, "commitIndex", newIdx)
        applyCommitted(sid)
        var stats2 = gState["stats"]
        stats2["raftLogCommitted"] = int(stats2["raftLogCommitted"]) + 1
        gState["stats"] = stats2
        var raft2 = gState["raft"]
        var rs2 = raft2[sid]
        if rs2["log"].length > RAFT_SNAPSHOT_THRESHOLD then
            raftTakeSnapshot(sid)
        end
        return newIdx
    end
    return -1
end

func applyCommitted(string sid)
    var raft = gState["raft"]
    if not (sid in raft) then return end
    var rs = raft[sid]
    int commit = int(rs["commitIndex"])
    int applied = int(rs["lastApplied"])
    var log = rs["log"]
    while applied < commit do
        applied += 1
        int li = 0
        bool found = false
        while li < log.length do
            if int(log[li]["index"]) == applied then
                applyEntry(sid, log[li])
                found = true
                break
            end
            li += 1
        end
    end
    rs["lastApplied"] = applied
    raft[sid] = rs
    gState["raft"] = raft
end

func applyEntry(string sid, var entry)
    string op = string(entry["op"])
    string key = string(entry["key"])
    if op == "noop" then return end
    if op == "SET" then
        opSet(sid, key, entry["value"])
        return
    end
    if op == "DEL" then
        opDel(sid, key)
        return
    end
    if op == "INCR" then
        opIncr(sid, key, int(entry["value"]))
        return
    end
    if op == "EXPIRE" then
        opExpire(sid, key, int(entry["value"]))
        return
    end
    if op == "LPUSH" then
        opLpush(sid, key, entry["value"])
        return
    end
    if op == "RPUSH" then
        opRpush(sid, key, entry["value"])
        return
    end
    if op == "HSET" then
        var pair = entry["value"]
        opHset(sid, key, string(pair["field"]), string(pair["val"]))
        return
    end
    if op == "SADD" then
        opSadd(sid, key, entry["value"])
        return
    end
    if op == "ZADD" then
        var pair = entry["value"]
        opZadd(sid, key, float(pair["score"]), string(pair["member"]))
        return
    end
end

func raftTakeSnapshot(string sid)
    var data = gState["data"]
    var sd = null
    if sid in data then sd = data[sid] else sd = {} end
    var raft = gState["raft"]
    if not (sid in raft) then return end
    var rs = raft[sid]
    rs["snapshot"] = deepCopy(sd)
    rs["snapshotIndex"] = int(rs["commitIndex"])
    rs["snapshotTerm"] = int(rs["currentTerm"])
    var log = rs["log"]
    if log.length > RAFT_SNAPSHOT_KEEP_LOG then
        var kept = []
        int start = log.length - RAFT_SNAPSHOT_KEEP_LOG
        int i = start
        while i < log.length do
            kept.append(log[i])
            i += 1
        end
        rs["log"] = kept
    end
    raft[sid] = rs
    gState["raft"] = raft
    var stats = gState["stats"]
    stats["raftSnapshotsTaken"] = int(stats["raftSnapshotsTaken"]) + 1
    gState["stats"] = stats
end

func raftAddServer(string sid, string newNodeId) as var
    var shards = gState["shards"]
    if not (sid in shards) then return {"ok": false, "error": "no shard"} end
    var sh = shards[sid]
    var replicas = sh["replicas"]
    int i = 0
    while i < replicas.length do
        if string(replicas[i]) == newNodeId then
            return {"ok": false, "error": "already a replica"}
        end
        i += 1
    end
    replicas.append(newNodeId)
    sh["replicas"] = replicas
    shards[sid] = sh
    gState["shards"] = shards
    return {"ok": true, "replicas": replicas}
end

func raftRemoveServer(string sid, string oldNodeId) as var
    var shards = gState["shards"]
    if not (sid in shards) then return {"ok": false, "error": "no shard"} end
    var sh = shards[sid]
    var replicas = sh["replicas"]
    var kept = []
    int i = 0
    while i < replicas.length do
        if string(replicas[i]) != oldNodeId then kept.append(replicas[i]) end
        i += 1
    end
    sh["replicas"] = kept
    shards[sid] = sh
    gState["shards"] = shards
    return {"ok": true, "replicas": kept}
end


// ============================================================================
// SECTION 8 - Replication / failover / linearizable read
// ============================================================================

func replicateToFollowers(string sid) as int
    var online = raftOnlineReplicas(sid)
    return online.length
end

func linearizableRead(string sid, string key) as string
    var rs = ensureRaftShard(sid)
    string leader = string(rs["leaderId"])
    if isEmpty(leader) then
        var r = raftStartElection(sid)
        if bool(r["ok"]) then
            leader = string(r["leader"])
            return opGet(sid, key)
        end
        return "(error) NOLEADER no leader available"
    end
    var nodes = ensureNodes()
    if not (leader in nodes) then
        var r = raftStartElection(sid)
        if bool(r["ok"]) then return opGet(sid, key) end
        return "(error) NOLEADER"
    end
    if string(nodes[leader]["status"]) != "online" then
        var r = raftStartElection(sid)
        if bool(r["ok"]) then return opGet(sid, key) end
        return "(error) NOLEADER"
    end
    int last = int(rs["lastHeartbeat"])
    int age = nowSec() - last
    if age > LEASE_FRESHNESS_SEC then
        rs["lastHeartbeat"] = nowSec()
    end
    return opGet(sid, key)
end

func failoverIfNeeded(string sid) as bool
    var rs = ensureRaftShard(sid)
    string leader = string(rs["leaderId"])
    if isEmpty(leader) then
        var r = raftStartElection(sid)
        return bool(r["ok"])
    end
    var nodes = ensureNodes()
    if not (leader in nodes) then
        var r = raftStartElection(sid)
        return bool(r["ok"])
    end
    if string(nodes[leader]["status"]) != "online" then
        var r = raftStartElection(sid)
        return bool(r["ok"])
    end
    return false
end


// ============================================================================
// SECTION 9 - Query routing / Coordinator / scatter-gather / cross-shard tx
// ============================================================================

func routeKey(string key) as var
    string sid = shardOf(key)
    var sh = ensureShard(sid)
    string leader = raftLeaderOf(sid)
    return {"shardId": sid, "leader": leader, "primary": string(sh["primary"])}
end

func routeSet(string key, var value) as var
    string sid = shardOf(key)
    failoverIfNeeded(sid)
    var cmd = {"op": "SET", "key": key, "value": value, "type": "string"}
    int ci = raftAppendAndApply(sid, cmd)
    if ci < 0 then return {"ok": false, "error": "raft commit failed (no quorum?)"} end
    int synced = replicateToFollowers(sid)
    maybeActiveSweep()
    var stats = gState["stats"]
    stats["totalSets"] = int(stats["totalSets"]) + 1
    gState["stats"] = stats
    return {"ok": true, "shardId": sid, "commitIndex": ci, "replicas": synced}
end

func routeGet(string key) as var
    string sid = shardOf(key)
    failoverIfNeeded(sid)
    string val = linearizableRead(sid, key)
    var stats = gState["stats"]
    stats["totalGets"] = int(stats["totalGets"]) + 1
    if val == "(nil)" or string.startsWith(val, "(error)") then
        stats["totalMisses"] = int(stats["totalMisses"]) + 1
    end
    gState["stats"] = stats
    return {"ok": true, "value": val, "shardId": sid, "leader": raftLeaderOf(sid)}
end

func routeDel(string key) as var
    string sid = shardOf(key)
    failoverIfNeeded(sid)
    var cmd = {"op": "DEL", "key": key, "value": "", "type": "string"}
    int ci = raftAppendAndApply(sid, cmd)
    if ci < 0 then return {"ok": false, "error": "raft commit failed"} end
    var stats = gState["stats"]
    stats["totalDels"] = int(stats["totalDels"]) + 1
    gState["stats"] = stats
    return {"ok": true, "shardId": sid, "commitIndex": ci}
end

func routeIncr(string key, int delta) as var
    string sid = shardOf(key)
    failoverIfNeeded(sid)
    var cmd = {"op": "INCR", "key": key, "value": delta, "type": "int"}
    int ci = raftAppendAndApply(sid, cmd)
    if ci < 0 then return {"ok": false, "error": "raft commit failed"} end
    var stats = gState["stats"]
    stats["totalSets"] = int(stats["totalSets"]) + 1
    gState["stats"] = stats
    return {"ok": true, "shardId": sid, "commitIndex": ci, "value": opGet(sid, key)}
end

func scatterGather(string queryFn, string pattern) as var
    var results = []
    int i = 0
    while i < DEFAULT_SHARD_COUNT do
        string sid = string(i)
        var data = gState["data"]
        if sid in data then
            var sd = data[sid]
            if queryFn == "count" then
                results.append({"shardId": sid, "count": sd.length})
            elseif string.startsWith(queryFn, "keys") then
                var matched = []
                for key, entry in sd
                    if lazyExpire(sid, string(key)) then continue end
                    if string.like(string(key), pattern) then matched.append(key) end
                end
                results.append({"shardId": sid, "keys": matched})
            end
        elseif queryFn == "count" then
            results.append({"shardId": sid, "count": 0})
        elseif string.startsWith(queryFn, "keys") then
            results.append({"shardId": sid, "keys": []})
        end
        i += 1
    end
    return results
end

func crossShardTx(var commands) as var
    var prepared = []
    bool allOk = true
    int i = 0
    while i < commands.length do
        var cmd = commands[i]
        string key = string(cmd["key"])
        string sid = shardOf(key)
        failoverIfNeeded(sid)
        var rs = ensureRaftShard(sid)
        int origCommit = int(rs["commitIndex"])
        int newIdx = raftAppendAndApply(sid, cmd)
        if newIdx < 0 then
            allOk = false
            prepared.append({"shardId": sid, "ok": false, "origCommit": origCommit})
        else
            prepared.append({"shardId": sid, "ok": true, "origCommit": origCommit, "newIdx": newIdx})
        end
        i += 1
    end
    var stats = gState["stats"]
    if allOk then
        stats["txCommits"] = int(stats["txCommits"]) + 1
        gState["stats"] = stats
        return {"ok": true, "prepared": prepared, "phase": "commit"}
    end
    stats["txAborts"] = int(stats["txAborts"]) + 1
    gState["stats"] = stats
    return {"ok": false, "prepared": prepared, "phase": "abort"}
end


// ============================================================================
// SECTION 10 - Client protocol (Redis-like text)
// ============================================================================

func cmdFlushAll() as string
    var data = gState["data"]
    var shards = gState["shards"]
    int i = 0
    while i < DEFAULT_SHARD_COUNT do
        string sid = string(i)
        data[sid] = {}
        if sid in shards then
            var sh = shards[sid]
            sh["keyCount"] = 0
            shards[sid] = sh
        end
        i += 1
    end
    gState["data"] = data
    gState["shards"] = shards
    return "OK"
end

func totalKeyCount() as int
    var data = gState["data"]
    int total = 0
    for sid, sd in data
        total += sd.length
    end
    return total
end

// Parse + execute one Redis-like line.
func executeProtocolLine(string line) as string
    string trimmed = string.trim(line)
    if isEmpty(trimmed) then return "" end
    if string.startsWith(trimmed, "//") then return "" end
    string cmd
    string rest
    cmd, rest = firstToken(trimmed)
    cmd = string.upper(cmd)

    if cmd == "PING" then return "PONG" end
    if cmd == "ECHO" then return string.trim(rest) end
    if cmd == "INFO" then return formatClusterInfo() end
    if cmd == "DBSIZE" then return string(totalKeyCount()) end
    if cmd == "FLUSHALL" then return cmdFlushAll() end

    if cmd == "CLUSTER" then
        string sub
        sub, rest = firstToken(rest)
        sub = string.upper(sub)
        if sub == "INFO" then return formatClusterInfo() end
        if sub == "NODES" then return formatClusterNodes() end
        if sub == "SHARDS" then return formatClusterShards() end
        if sub == "RING" then return renderRingViz() end
        if sub == "HEALTH" then return formatHealth() end
        if sub == "SLOTS" then return formatClusterSlots() end
        if sub == "MIGRATIONS" then return formatMigrations() end
        return "(error) unknown CLUSTER subcommand: " + sub
    end

    if cmd == "RAFT" then
        string sid
        sid, rest = firstToken(rest)
        if isEmpty(sid) then return "(error) RAFT requires shardId" end
        return formatRaftState(sid)
    end

    if cmd == "SET" then
        string key
        string valRaw
        key, valRaw = firstToken(rest)
        if isEmpty(key) then return "(error) SET requires key" end
        var value = parseScalar(valRaw)
        var r = routeSet(key, value)
        if bool(r["ok"]) then return "OK" end
        return "(error) " + string(r["error"])
    end

    if cmd == "GET" then
        string key
        key, rest = firstToken(rest)
        if isEmpty(key) then return "(error) GET requires key" end
        var r = routeGet(key)
        return string(r["value"])
    end

    if cmd == "DEL" then
        string key
        key, rest = firstToken(rest)
        if isEmpty(key) then return "(error) DEL requires key" end
        var r = routeDel(key)
        if bool(r["ok"]) then return "1" end
        return "0"
    end

    if cmd == "EXISTS" then
        string key
        key, rest = firstToken(rest)
        if isEmpty(key) then return "(error) EXISTS requires key" end
        return string(opExists(shardOf(key), key))
    end

    if cmd == "TYPE" then
        string key
        key, rest = firstToken(rest)
        if isEmpty(key) then return "(error) TYPE requires key" end
        return opType(shardOf(key), key)
    end

    if cmd == "INCR" then
        string key
        string deltaStr
        key, deltaStr = firstToken(rest)
        if isEmpty(key) then return "(error) INCR requires key" end
        int delta = 1
        if not isEmpty(deltaStr) then delta = int(deltaStr) end
        var r = routeIncr(key, delta)
        if bool(r["ok"]) then return string(r["value"]) end
        return "(error) INCR failed"
    end

    if cmd == "DECR" then
        string key
        key, rest = firstToken(rest)
        if isEmpty(key) then return "(error) DECR requires key" end
        var r = routeIncr(key, -1)
        if bool(r["ok"]) then return string(r["value"]) end
        return "(error) DECR failed"
    end

    if cmd == "EXPIRE" then
        string key
        string secsStr
        key, secsStr = firstToken(rest)
        if isEmpty(key) or isEmpty(secsStr) then return "(error) EXPIRE requires key and seconds" end
        string sid = shardOf(key)
        var cmd2 = {"op": "EXPIRE", "key": key, "value": int(secsStr), "type": "int"}
        int ci = raftAppendAndApply(sid, cmd2)
        if ci < 0 then return "(error) raft commit failed" end
        return "1"
    end

    if cmd == "PERSIST" then
        string key
        key, rest = firstToken(rest)
        if isEmpty(key) then return "(error) PERSIST requires key" end
        return string(opPersist(shardOf(key), key))
    end

    if cmd == "TTL" then
        string key
        key, rest = firstToken(rest)
        if isEmpty(key) then return "(error) TTL requires key" end
        return string(opTtl(shardOf(key), key))
    end

    if cmd == "LPUSH" then
        string key
        string valsRaw
        key, valsRaw = firstToken(rest)
        if isEmpty(key) then return "(error) LPUSH requires key" end
        string sid = shardOf(key)
        var values = splitFields(valsRaw, " ")
        if values.length == 0 then return "(error) LPUSH requires at least one value" end
        var cmd2 = {"op": "LPUSH", "key": key, "value": values, "type": "list"}
        int ci = raftAppendAndApply(sid, cmd2)
        if ci < 0 then return "(error) raft commit failed" end
        return opLlen(sid, key)
    end

    if cmd == "RPUSH" then
        string key
        string valsRaw
        key, valsRaw = firstToken(rest)
        if isEmpty(key) then return "(error) RPUSH requires key" end
        string sid = shardOf(key)
        var values = splitFields(valsRaw, " ")
        if values.length == 0 then return "(error) RPUSH requires at least one value" end
        var cmd2 = {"op": "RPUSH", "key": key, "value": values, "type": "list"}
        int ci = raftAppendAndApply(sid, cmd2)
        if ci < 0 then return "(error) raft commit failed" end
        return opLlen(sid, key)
    end

    if cmd == "LPOP" then
        string key
        string cntStr
        key, cntStr = firstToken(rest)
        if isEmpty(key) then return "(error) LPOP requires key" end
        int count = 1
        if not isEmpty(cntStr) then count = int(cntStr) end
        return opLpop(shardOf(key), key, count)
    end

    if cmd == "RPOP" then
        string key
        string cntStr
        key, cntStr = firstToken(rest)
        if isEmpty(key) then return "(error) RPOP requires key" end
        int count = 1
        if not isEmpty(cntStr) then count = int(cntStr) end
        return opRpop(shardOf(key), key, count)
    end

    if cmd == "LRANGE" then
        string key
        string rest2
        key, rest2 = firstToken(rest)
        if isEmpty(key) then return "(error) LRANGE requires key" end
        string sStr
        string eStr
        sStr, eStr = firstToken(rest2)
        int s = 0
        int e = -1
        if not isEmpty(sStr) then s = int(sStr) end
        if not isEmpty(eStr) then e = int(eStr) end
        return opLrange(shardOf(key), key, s, e)
    end

    if cmd == "LLEN" then
        string key
        key, rest = firstToken(rest)
        if isEmpty(key) then return "(error) LLEN requires key" end
        return opLlen(shardOf(key), key)
    end

    if cmd == "HSET" then
        string key
        string rest2
        key, rest2 = firstToken(rest)
        if isEmpty(key) then return "(error) HSET requires key" end
        string field
        string val
        field, val = firstToken(rest2)
        if isEmpty(field) then return "(error) HSET requires field and value" end
        string sid = shardOf(key)
        var cmd2 = {"op": "HSET", "key": key,
                    "value": {"field": field, "val": val}, "type": "hash"}
        int ci = raftAppendAndApply(sid, cmd2)
        if ci < 0 then return "(error) raft commit failed" end
        return "1"
    end

    if cmd == "HGET" then
        string key
        string rest2
        key, rest2 = firstToken(rest)
        if isEmpty(key) then return "(error) HGET requires key" end
        string field
        field, rest2 = firstToken(rest2)
        if isEmpty(field) then return "(error) HGET requires field" end
        return opHget(shardOf(key), key, field)
    end

    if cmd == "HGETALL" then
        string key
        key, rest = firstToken(rest)
        if isEmpty(key) then return "(error) HGETALL requires key" end
        return opHgetall(shardOf(key), key)
    end

    if cmd == "HDEL" then
        string key
        string rest2
        key, rest2 = firstToken(rest)
        if isEmpty(key) then return "(error) HDEL requires key" end
        string field
        field, rest2 = firstToken(rest2)
        if isEmpty(field) then return "(error) HDEL requires field" end
        return string(opHdel(shardOf(key), key, field))
    end

    if cmd == "HLEN" then
        string key
        key, rest = firstToken(rest)
        if isEmpty(key) then return "(error) HLEN requires key" end
        return opHlen(shardOf(key), key)
    end

    if cmd == "SADD" then
        string key
        string memRaw
        key, memRaw = firstToken(rest)
        if isEmpty(key) then return "(error) SADD requires key" end
        var members = splitFields(memRaw, " ")
        if members.length == 0 then return "(error) SADD requires at least one member" end
        string sid = shardOf(key)
        var cmd2 = {"op": "SADD", "key": key, "value": members, "type": "set"}
        int ci = raftAppendAndApply(sid, cmd2)
        if ci < 0 then return "(error) raft commit failed" end
        return string(opScard(sid, key))
    end

    if cmd == "SREM" then
        string key
        string memRaw
        key, memRaw = firstToken(rest)
        if isEmpty(key) then return "(error) SREM requires key" end
        var members = splitFields(memRaw, " ")
        string sid = shardOf(key)
        int removed = 0
        int i = 0
        while i < members.length do
            removed += opSrem(sid, key, [members[i]])
            i += 1
        end
        return string(removed)
    end

    if cmd == "SMEMBERS" then
        string key
        key, rest = firstToken(rest)
        if isEmpty(key) then return "(error) SMEMBERS requires key" end
        return opSmembers(shardOf(key), key)
    end

    if cmd == "SISMEMBER" then
        string key
        string rest2
        key, rest2 = firstToken(rest)
        if isEmpty(key) then return "(error) SISMEMBER requires key" end
        string member
        member, rest2 = firstToken(rest2)
        if isEmpty(member) then return "(error) SISMEMBER requires member" end
        return string(opSismember(shardOf(key), key, member))
    end

    if cmd == "SCARD" then
        string key
        key, rest = firstToken(rest)
        if isEmpty(key) then return "(error) SCARD requires key" end
        return opScard(shardOf(key), key)
    end

    if cmd == "ZADD" then
        string key
        string rest2
        key, rest2 = firstToken(rest)
        if isEmpty(key) then return "(error) ZADD requires key" end
        string scoreStr
        string member
        scoreStr, member = firstToken(rest2)
        if isEmpty(scoreStr) or isEmpty(member) then return "(error) ZADD requires score and member" end
        float score = float(scoreStr)
        string sid = shardOf(key)
        var cmd2 = {"op": "ZADD", "key": key,
                    "value": {"score": score, "member": member}, "type": "zset"}
        int ci = raftAppendAndApply(sid, cmd2)
        if ci < 0 then return "(error) raft commit failed" end
        return "1"
    end

    if cmd == "ZRANGE" then
        string key
        string rest2
        key, rest2 = firstToken(rest)
        if isEmpty(key) then return "(error) ZRANGE requires key" end
        string sStr
        string eStr
        sStr, eStr = firstToken(rest2)
        int s = 0
        int e = -1
        if not isEmpty(sStr) then s = int(sStr) end
        if not isEmpty(eStr) then e = int(eStr) end
        return opZrange(shardOf(key), key, s, e)
    end

    if cmd == "ZSCORE" then
        string key
        string rest2
        key, rest2 = firstToken(rest)
        if isEmpty(key) then return "(error) ZSCORE requires key" end
        string member
        member, rest2 = firstToken(rest2)
        if isEmpty(member) then return "(error) ZSCORE requires member" end
        return opZscore(shardOf(key), key, member)
    end

    if cmd == "ZCARD" then
        string key
        key, rest = firstToken(rest)
        if isEmpty(key) then return "(error) ZCARD requires key" end
        return opZcard(shardOf(key), key)
    end

    if cmd == "KEYS" then
        string pattern = string.trim(rest)
        if isEmpty(pattern) then pattern = "*" end
        var sg = scatterGather("keys:" + pattern, pattern)
        var all = []
        int si = 0
        while si < sg.length do
            var keys = sg[si]["keys"]
            int kj = 0
            while kj < keys.length do
                all.append(keys[kj])
                kj += 1
            end
            si += 1
        end
        if all.length == 0 then return "(empty)" end
        return joinLines(all)
    end

    if cmd == "COUNT" then
        return string(totalKeyCount())
    end

    return "(error) unknown command: " + cmd
end


// ============================================================================
// SECTION 11 - Ops: cluster info / nodes / shards / health / migration
// ============================================================================

func formatClusterInfo() as string
    var nodes = ensureNodes()
    var stats = ensureStats()
    int onlineNodes = 0
    int downNodes = 0
    for nid, node in nodes
        if string(node["status"]) == "online" then
            onlineNodes += 1
        else
            downNodes += 1
        end
    end
    int totalKeys = totalKeyCount()
    string res = ""
    res = res + "=== CLUSTER INFO ===\n"
    res = res + "version:              " + string(gState["version"]) + "\n"
    if "createdAt" in gState then
        res = res + "created_at:           " + string(gState["createdAt"]) + " (unix sec)\n"
    end
    res = res + "nodes_total:          " + string(nodes.length) + "\n"
    res = res + "nodes_online:         " + string(onlineNodes) + "\n"
    res = res + "nodes_down:           " + string(downNodes) + "\n"
    res = res + "shards_total:         " + string(DEFAULT_SHARD_COUNT) + "\n"
    res = res + "vnodes_per_node:      " + string(VNODES_PER_NODE) + "\n"
    res = res + "replica_factor:       " + string(DEFAULT_REPLICA_FACTOR) + "\n"
    res = res + "keys_total:           " + string(totalKeys) + "\n"
    res = res + "\n"
    res = res + "--- Raft ---\n"
    res = res + "leader_changes:       " + string(stats["leaderChanges"]) + "\n"
    res = res + "log_entries_appended: " + string(stats["raftLogAppended"]) + "\n"
    res = res + "log_entries_committed:" + string(stats["raftLogCommitted"]) + "\n"
    res = res + "snapshots_taken:      " + string(stats["raftSnapshotsTaken"]) + "\n"
    res = res + "\n"
    res = res + "--- Workload ---\n"
    res = res + "total_sets:           " + string(stats["totalSets"]) + "\n"
    res = res + "total_gets:           " + string(stats["totalGets"]) + "\n"
    res = res + "total_misses:         " + string(stats["totalMisses"]) + "\n"
    res = res + "total_dels:           " + string(stats["totalDels"]) + "\n"
    res = res + "tx_commits:           " + string(stats["txCommits"]) + "\n"
    res = res + "tx_aborts:            " + string(stats["txAborts"]) + "\n"
    res = res + "\n"
    res = res + "--- TTL ---\n"
    res = res + "sweeps_active:        " + string(stats["sweepsActive"]) + "\n"
    res = res + "keys_expired:         " + string(stats["keysExpired"]) + "\n"
    res = res + "\n"
    res = res + "--- Sharding ---\n"
    res = res + "shard_splits:         " + string(stats["shardSplits"]) + "\n"
    res = res + "shard_merges:         " + string(stats["shardMerges"]) + "\n"
    res = res + "migrations_done:      " + string(stats["migrationsCompleted"]) + "\n"
    return res
end

func formatClusterNodes() as string
    var nodes = ensureNodes()
    string res = ""
    res = res + "=== CLUSTER NODES ===\n"
    res = res + padRight("id", 10) + padRight("host:port", 22) + padRight("status", 10)
    res = res + padRight("vnodes", 8) + padRight("hbeat_age", 12) + padRight("hbv", 6) + "\n"
    int now = nowSec()
    for nid, node in nodes
        int last = int(node["lastHeartbeat"])
        int age = now - last
        string addr = string(node["host"]) + ":" + string(node["port"])
        res = res + padRight(string(nid), 10)
        res = res + padRight(addr, 22)
        res = res + padRight(string(node["status"]), 10)
        res = res + padRight(string(node["vnodes"]), 8)
        res = res + padRight(string(age) + "s", 12)
        res = res + padRight(string(node["heartbeatVersion"]), 6)
        res = res + "\n"
    end
    return res
end

func formatClusterShards() as string
    var shards = ensureShards()
    string res = ""
    res = res + "=== CLUSTER SHARDS (first 16 shown, total " + string(DEFAULT_SHARD_COUNT) + ") ===\n"
    res = res + padRight("id", 5) + padRight("primary", 10) + padRight("leader", 10)
    res = res + padRight("term", 6) + padRight("keys", 6) + "replicas\n"
    int limit = 16
    if DEFAULT_SHARD_COUNT < limit then limit = DEFAULT_SHARD_COUNT end
    int i = 0
    while i < limit do
        string sid = string(i)
        var sh = ensureShard(sid)
        var replicas = sh["replicas"]
        string repStr = ""
        int j = 0
        while j < replicas.length do
            if not isEmpty(repStr) then repStr = repStr + "," end
            repStr = repStr + string(replicas[j])
            j += 1
        end
        res = res + padRight(sid, 5)
        res = res + padRight(string(sh["primary"]), 10)
        res = res + padRight(string(sh["leader"]), 10)
        res = res + padRight(string(sh["leaderTerm"]), 6)
        res = res + padRight(string(sh["keyCount"]), 6)
        res = res + repStr + "\n"
        i += 1
    end
    return res
end

func formatClusterSlots() as string
    var shards = ensureShards()
    var slotPerNode = {}
    int i = 0
    while i < DEFAULT_SHARD_COUNT do
        string sid = string(i)
        var sh = ensureShard(sid)
        string prim = string(sh["primary"])
        if not (prim in slotPerNode) then slotPerNode[prim] = 0 end
        slotPerNode[prim] = int(slotPerNode[prim]) + 1
        i += 1
    end
    string res = ""
    res = res + "=== CLUSTER SLOTS (primary distribution) ===\n"
    for nid, c in slotPerNode
        float ratio = float(int(c)) / float(DEFAULT_SHARD_COUNT)
        res = res + padRight(string(nid), 10) + " slots=" + padRight(string(c), 5)
        res = res + " " + progressBar(ratio, 30) + " "
        res = res + string.formatFloat(ratio * 100.0, ".1") + "%\n"
    end
    return res
end

func formatHealth() as string
    var health = clusterHealth()
    string res = ""
    res = res + "=== CLUSTER HEALTH ===\n"
    int i = 0
    while i < health.length do
        var h = health[i]
        res = res + padRight(string(h["id"]), 10)
        res = res + "status=" + padRight(string(h["status"]), 10)
        res = res + "health=" + padRight(string(h["health"]), 10)
        res = res + "hb_age=" + padRight(string(h["heartbeatAgeSec"]) + "s", 8)
        res = res + "hbv=" + string(h["heartbeatVersion"]) + "\n"
        i += 1
    end
    return res
end

func formatMigrations() as string
    var migrations = ensureMigrations()
    string res = ""
    res = res + "=== MIGRATIONS (total " + string(migrations.length) + ") ===\n"
    if migrations.length == 0 then
        res = res + "(none)\n"
        return res
    end
    res = res + padRight("id", 10) + padRight("type", 8) + padRight("node", 10)
    res = res + padRight("ranges", 8) + padRight("total", 8) + padRight("moved", 8)
    res = res + padRight("status", 12) + "\n"
    int i = 0
    while i < migrations.length do
        var m = migrations[i]
        res = res + padRight(string(m["id"]), 10)
        res = res + padRight(string(m["type"]), 8)
        res = res + padRight(string(m["nodeId"]), 10)
        res = res + padRight(string(m["ranges"].length), 8)
        res = res + padRight(string(m["totalKeys"]), 8)
        res = res + padRight(string(m["movedKeys"]), 8)
        res = res + padRight(string(m["status"]), 12)
        res = res + "\n"
        i += 1
    end
    return res
end

func formatRaftState(string sid) as string
    var rs = ensureRaftShard(sid)
    var sh = ensureShard(sid)
    string res = ""
    res = res + "=== RAFT STATE (shard " + sid + ") ===\n"
    res = res + "current_term:     " + string(rs["currentTerm"]) + "\n"
    res = res + "voted_for:        " + string(rs["votedFor"]) + "\n"
    res = res + "leader_id:        " + string(rs["leaderId"]) + "\n"
    res = res + "leader_term:      " + string(rs["leaderTerm"]) + "\n"
    res = res + "status:           " + string(rs["status"]) + "\n"
    res = res + "log_length:       " + string(rs["log"].length) + "\n"
    res = res + "commit_index:     " + string(rs["commitIndex"]) + "\n"
    res = res + "last_applied:     " + string(rs["lastApplied"]) + "\n"
    if rs["snapshot"] == null then
        res = res + "snapshot:         (none)\n"
    else
        res = res + "snapshot:         keys=" + string(rs["snapshot"].length) + "\n"
        res = res + "snapshot_index:   " + string(rs["snapshotIndex"]) + "\n"
        res = res + "snapshot_term:    " + string(rs["snapshotTerm"]) + "\n"
    end
    res = res + "election_attempt: " + string(rs["electionAttempt"]) + "\n"
    res = res + "last_heartbeat:   " + string(rs["lastHeartbeat"]) + "\n"
    res = res + "replicas:         "
    var replicas = sh["replicas"]
    int i = 0
    while i < replicas.length do
        if i > 0 then res = res + ", " end
        res = res + string(replicas[i])
        i += 1
    end
    res = res + "\n"
    res = res + "match_index:      " + json.stringify(rs["matchIndex"]) + "\n"
    res = res + "next_index:       " + json.stringify(rs["nextIndex"]) + "\n"
    res = res + "\n--- last 5 log entries ---\n"
    var log = rs["log"]
    int startL = log.length - 5
    if startL < 0 then startL = 0 end
    int li = startL
    while li < log.length do
        var e = log[li]
        res = res + "  idx=" + padRight(string(e["index"]), 4)
        res = res + "term=" + padRight(string(e["term"]), 4)
        res = res + "op=" + padRight(string(e["op"]), 8)
        res = res + "key=" + string(e["key"]) + "\n"
        li += 1
    end
    return res
end

func formatMigrationProgress() as string
    var migrations = ensureMigrations()
    string res = ""
    res = res + "=== MIGRATION PROGRESS ===\n"
    if migrations.length == 0 then
        res = res + "(no migrations)\n"
        return res
    end
    int i = 0
    while i < migrations.length do
        var m = migrations[i]
        int total = int(m["totalKeys"])
        int moved = int(m["movedKeys"])
        float ratio = 0.0
        if total > 0 then ratio = float(moved) / float(total) end
        if ratio > 1.0 then ratio = 1.0 end
        res = res + string(m["id"]) + " " + string(m["type"]) + " " + string(m["nodeId"]) + "  "
        res = res + progressBar(ratio, 30) + "  "
        res = res + string(moved) + "/" + string(total) + " keys  "
        res = res + "[" + string(m["status"]) + "]\n"
        i += 1
    end
    return res
end

func formatKeyDistribution() as string
    var shards = ensureShards()
    var data = ensureData()
    var perNode = {}
    int i = 0
    while i < DEFAULT_SHARD_COUNT do
        string sid = string(i)
        var sh = ensureShard(sid)
        string prim = string(sh["primary"])
        if not (prim in perNode) then perNode[prim] = 0 end
        if sid in data then
            perNode[prim] = int(perNode[prim]) + data[sid].length
        end
        i += 1
    end
    int total = totalKeyCount()
    string res = ""
    res = res + "=== KEY DISTRIBUTION (by primary) ===\n"
    res = res + "total_keys: " + string(total) + "\n"
    if total == 0 then return res end
    for nid, c in perNode
        float ratio = float(int(c)) / float(total)
        res = res + padRight(string(nid), 10) + " keys=" + padRight(string(c), 7)
        res = res + " " + progressBar(ratio, 30) + " "
        res = res + string.formatFloat(ratio * 100.0, ".1") + "%\n"
    end
    return res
end


// ============================================================================
// SECTION 12 - Persistence
// ============================================================================

func stateFilePath(string scriptPath) as string
    return path.join(path.dir(scriptPath), STATE_FILE_NAME)
end

func loadState(string path_) as bool
    if not file.exists(path_) then
        gState = {}
        return false
    end
    string text = file.readText(path_)
    if isEmpty(text) then
        gState = {}
        return false
    end
    if not json.valid(text) then
        gState = {}
        return false
    end
    var parsed = json.parse(text)
    if parsed == null then
        gState = {}
        return false
    end
    gState = parsed
    ensureStats()
    return true
end

func saveState(string path_) as bool
    gState["updatedAt"] = nowSec()
    string text = json.stringify(gState)
    bool ok = file.writeText(path_, text)
    return ok
end


// ============================================================================
// SECTION 13 - HTTP API (serve mode)
// ============================================================================

func httpHandle(point reqHandle, point respHandle) as bool
    HttpRequest req = HttpRequest(reqHandle)
    HttpResponse resp = HttpResponse(respHandle)
    resp.header("X-Server", "xlang-xdistdb")
    string method = req.method()
    string p = req.path()

    if method == "GET" and p == "/" then
        string html = "<html><head><title>xdistdb</title></head><body>"
        html = html + "<h1>xdistdb - Distributed Key-Value Database</h1>"
        html = html + "<ul>"
        html = html + "<li>GET /key/&lt;k&gt;</li>"
        html = html + "<li>POST /key/&lt;k&gt; body=value</li>"
        html = html + "<li>DELETE /key/&lt;k&gt;</li>"
        html = html + "<li>GET /cluster/info</li>"
        html = html + "<li>GET /cluster/nodes</li>"
        html = html + "<li>GET /cluster/shards</li>"
        html = html + "<li>GET /cluster/health</li>"
        html = html + "<li>POST /cmd body=LINE (Redis-like)</li>"
        html = html + "</ul></body></html>"
        return resp.text(html, "text/html; charset=utf-8")
    end

    if method == "GET" and p == "/cluster/info" then
        return resp.text(formatClusterInfo(), "text/plain; charset=utf-8")
    end
    if method == "GET" and p == "/cluster/nodes" then
        return resp.text(formatClusterNodes(), "text/plain; charset=utf-8")
    end
    if method == "GET" and p == "/cluster/shards" then
        return resp.text(formatClusterShards(), "text/plain; charset=utf-8")
    end
    if method == "GET" and p == "/cluster/health" then
        return resp.text(formatHealth(), "text/plain; charset=utf-8")
    end
    if method == "GET" and p == "/cluster/ring" then
        return resp.text(renderRingViz(), "text/plain; charset=utf-8")
    end
    if method == "GET" and p == "/cluster/migrations" then
        return resp.text(formatMigrationProgress(), "text/plain; charset=utf-8")
    end
    if method == "GET" and p == "/cluster/distribution" then
        return resp.text(formatKeyDistribution(), "text/plain; charset=utf-8")
    end

    if method == "POST" and p == "/cmd" then
        string body = req.body()
        string result = executeProtocolLine(body)
        string res = "{\"ok\":true,\"result\":\"" + jsonEscapeStr(result) + "\"}"
        return resp.jsonText(res)
    end

    if string.startsWith(p, "/key/") then
        string key = string.slice(p, 5, string.len(p) - 5)
        if isEmpty(key) then
            return resp.jsonText("{\"ok\":false,\"error\":\"empty key\"}")
        end
        if method == "GET" then
            var r = routeGet(key)
            string val = string(r["value"])
            string res = "{\"ok\":true,\"key\":\"" + jsonEscapeStr(key) + "\","
            res = res + "\"value\":\"" + jsonEscapeStr(val) + "\","
            res = res + "\"shardId\":\"" + string(r["shardId"]) + "\","
            res = res + "\"leader\":\"" + string(r["leader"]) + "\"}"
            return resp.jsonText(res)
        end
        if method == "POST" then
            string body = req.body()
            var value = parseScalar(body)
            var r = routeSet(key, value)
            string res = "{\"ok\":" + string(bool(r["ok"]))
            if bool(r["ok"]) then
                res = res + ",\"shardId\":\"" + string(r["shardId"]) + "\""
                res = res + ",\"commitIndex\":" + string(r["commitIndex"])
                res = res + ",\"replicas\":" + string(r["replicas"])
            else
                res = res + ",\"error\":\"" + jsonEscapeStr(string(r["error"])) + "\""
            end
            res = res + "}"
            return resp.jsonText(res)
        end
        if method == "DELETE" then
            var r = routeDel(key)
            string res = "{\"ok\":" + string(bool(r["ok"])) + "}"
            return resp.jsonText(res)
        end
    end

    if method == "GET" and p == "/keys" then
        string pat = req.queryValue("pattern")
        if isEmpty(pat) then pat = "*" end
        var sg = scatterGather("keys:" + pat, pat)
        var all = []
        int si = 0
        while si < sg.length do
            var keys = sg[si]["keys"]
            int kj = 0
            while kj < keys.length do
                all.append(keys[kj])
                kj += 1
            end
            si += 1
        end
        return resp.jsonText(json.stringify(all))
    end

    if method == "GET" and p == "/count" then
        string res = "{\"count\":" + string(totalKeyCount()) + "}"
        return resp.jsonText(res)
    end

    if method == "GET" and string.startsWith(p, "/raft/") then
        string sid = string.slice(p, 6, string.len(p) - 6)
        return resp.text(formatRaftState(sid), "text/plain; charset=utf-8")
    end

    return false
end

func(point, point) as bool httpHandler = httpHandle


