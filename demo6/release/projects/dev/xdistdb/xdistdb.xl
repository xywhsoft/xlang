func cmdTx(string txExpr) as int
    var parts = splitAll(txExpr, "|")
    var commands = []
    int i = 0
    while i < parts.length do
        string line = string.trim(string(parts[i]))
        if isEmpty(line) then
            i += 1
            continue
        end
        string cmd
        string rest
        cmd, rest = firstToken(line)
        cmd = string.upper(cmd)
        string key
        string rest2
        key, rest2 = firstToken(rest)
        if isEmpty(key) then
            println("Error: tx command missing key: " + line)
            return 1
        end
        if cmd == "SET" then
            commands.append({"op": "SET", "key": key, "value": parseScalar(rest2), "type": "string"})
        elseif cmd == "DEL" then
            commands.append({"op": "DEL", "key": key, "value": "", "type": "string"})
        elseif cmd == "INCR" then
            commands.append({"op": "INCR", "key": key, "value": 1, "type": "int"})
        else
            println("Error: tx unsupported command: " + cmd)
            return 1
        end
        i += 1
    end
    if commands.length == 0 then
        println("Error: tx has no commands")
        return 1
    end
    println("Starting 2PC transaction with " + string(commands.length) + " commands...")
    int t0 = nowMs()
    var r = crossShardTx(commands)
    int t1 = nowMs()
    if bool(r["ok"]) then
        println("OK 2PC COMMIT in " + formatMs(t1 - t0))
        var prepared = r["prepared"]
        int pi = 0
        while pi < prepared.length do
            println("  shard=" + string(prepared[pi]["shardId"]) + " commit_index=" + string(prepared[pi]["newIdx"]))
            pi += 1
        end
        return 0
    end
    println("FAIL 2PC ABORT in " + formatMs(t1 - t0))
    var prepared = r["prepared"]
    int pi = 0
    while pi < prepared.length do
        if bool(prepared[pi]["ok"]) then
            println("  shard=" + string(prepared[pi]["shardId"]) + " PREPARED then rolled back")
        else
            println("  shard=" + string(prepared[pi]["shardId"]) + " PREPARE FAILED")
        end
        pi += 1
    end
    return 1
end

func cmdExport(string outFile) as int
    gState["updatedAt"] = nowSec()
    string text = json.stringify(gState, pretty = true)
    text = string.replace(text, "\t", "  ")
    bool ok = file.writeText(outFile, text)
    if not ok then
        println("Error: failed to write " + outFile)
        return 1
    end
    println("OK exported state to " + outFile + " (" + formatBytes(string.len(text)) + ")")
    return 0
end

func cmdImport(string inFile) as int
    if not file.exists(inFile) then
        println("Error: file not found: " + inFile)
        return 1
    end
    string text = file.readText(inFile)
    if not json.valid(text) then
        println("Error: invalid JSON: " + inFile)
        return 1
    end
    var parsed = json.parse(text)
    if parsed == null then
        println("Error: empty JSON: " + inFile)
        return 1
    end
    gState = parsed
    ensureStats()
    println("OK imported state from " + inFile)
    println("  nodes: " + string(gState["nodes"].length))
    println("  keys:  " + string(totalKeyCount()))
    return 0
end

func cmdReset() as int
    gState = {}
    println("OK state cleared")
    return 0
end

func cmdBench(int ops) as int
    if ops <= 0 then ops = BENCH_DEFAULT_OPS end
    if not ("nodes" in gState) then
        println("Error: cluster not initialized. Run 'cluster init' first.")
        return 1
    end
    println("=== xdistdb benchmark ===")
    println("operations: " + string(ops))
    println("")

    println("[1/3] WRITE phase (SET key:<i> value:<i>)...")
    int t0 = nowMs()
    int i = 0
    while i < ops do
        string k = "bench:key:" + string(i)
        string v = "value:" + string(i)
        var r = routeSet(k, v)
        if not bool(r["ok"]) then
            println("Error: write failed at i=" + string(i) + ": " + string(r["error"]))
            return 1
        end
        i += 1
    end
    int t1 = nowMs()
    int writeMs = t1 - t0
    float writeQps = 0.0
    if writeMs > 0 then writeQps = float(ops) / float(writeMs) * 1000.0 end
    println("  wrote " + string(ops) + " keys in " + formatMs(writeMs))
    println("  throughput: " + string.formatFloat(writeQps, ".1") + " ops/sec")

    println("[2/3] READ phase (GET key:<i>)...")
    int t2 = nowMs()
    int hits = 0
    int misses = 0
    i = 0
    while i < ops do
        string k = "bench:key:" + string(i)
        var r = routeGet(k)
        if string(r["value"]) != "(nil)" then
            hits += 1
        else
            misses += 1
        end
        i += 1
    end
    int t3 = nowMs()
    int readMs = t3 - t2
    float readQps = 0.0
    if readMs > 0 then readQps = float(ops) / float(readMs) * 1000.0 end
    println("  read " + string(ops) + " keys in " + formatMs(readMs))
    println("  throughput: " + string.formatFloat(readQps, ".1") + " ops/sec")
    println("  hits=" + string(hits) + " misses=" + string(misses))

    println("[3/3] Distribution analysis...")
    print(formatKeyDistribution())
    println("")
    print(formatClusterSlots())

    var shards = ensureShards()
    var data = ensureData()
    var perNode = {}
    int ti = 0
    while ti < DEFAULT_SHARD_COUNT do
        string sid = string(ti)
        var sh = ensureShard(sid)
        string prim = string(sh["primary"])
        if not (prim in perNode) then perNode[prim] = 0 end
        if sid in data then
            perNode[prim] = int(perNode[prim]) + data[sid].length
        end
        ti += 1
    end
    int nodeCount = perNode.length
    if nodeCount > 0 then
        int totalK = 0
        for nid, c in perNode
            totalK += int(c)
        end
        float mean = float(totalK) / float(nodeCount)
        float sumSqDiff = 0.0
        for nid, c in perNode
            float diff = float(int(c)) - mean
            sumSqDiff += diff * diff
        end
        float variance = sumSqDiff / float(nodeCount)
        float stddev = variance
        if stddev > 0.0 then
            float g = stddev / 2.0 + 0.5
            int iter = 0
            while iter < 10 do
                if g <= 0.0 then g = 0.01 end
                g = (g + stddev / g) / 2.0
                iter += 1
            end
            stddev = g
        end
        float cv = 0.0
        if mean > 0.0 then cv = stddev / mean end
        println("")
        println("balance: mean=" + string.formatFloat(mean, ".1") +
                " stddev=" + string.formatFloat(stddev, ".1") +
                " cv=" + string.formatFloat(cv, ".3"))
    end
    return 0
end

func cmdServe(int port) as int
    if not ("nodes" in gState) then
        println("Error: cluster not initialized. Run 'cluster init' first.")
        return 1
    end
    if port <= 0 then port = DEFAULT_HTTP_PORT end
    point server = http.server.create(port, "127.0.0.1", 128, 1048576, 1048576, 100, 65536, 2)
    if server == null then
        println("FATAL: http.server.create returned null")
        return 1
    end
    http.server.getRequest(server, "/", httpHandler)
    http.server.postRequest(server, "/", httpHandler)
    http.server.getRequest(server, "/cmd", httpHandler)
    http.server.postRequest(server, "/cmd", httpHandler)
    http.server.getRequest(server, "/cluster/info", httpHandler)
    http.server.getRequest(server, "/cluster/nodes", httpHandler)
    http.server.getRequest(server, "/cluster/shards", httpHandler)
    http.server.getRequest(server, "/cluster/health", httpHandler)
    http.server.getRequest(server, "/cluster/ring", httpHandler)
    http.server.getRequest(server, "/cluster/migrations", httpHandler)
    http.server.getRequest(server, "/cluster/distribution", httpHandler)
    http.server.getRequest(server, "/keys", httpHandler)
    http.server.getRequest(server, "/count", httpHandler)
    http.server.postRequest(server, "/key", httpHandler)
    http.server.getRequest(server, "/key", httpHandler)
    http.server.getRequest(server, "/raft", httpHandler)
    if not http.server.start(server) then
        println("FATAL: http.server.start failed (port " + string(port) + " busy?)")
        http.server.destroy(server)
        return 1
    end
    int actualPort = http.server.port(server)
    println("xdistdb HTTP API serving on http://127.0.0.1:" + string(actualPort))
    println("endpoints:")
    println("  GET  /                       welcome page")
    println("  GET  /key/<key>              get value")
    println("  POST /key/<key>  body=value  set value")
    println("  DELETE /key/<key>            delete value")
    println("  GET  /cluster/info           cluster info")
    println("  GET  /cluster/nodes          node list")
    println("  GET  /cluster/shards         shard list")
    println("  GET  /cluster/health         health check")
    println("  GET  /cluster/ring           hash ring visualization")
    println("  GET  /cluster/distribution   key distribution")
    println("  GET  /cluster/migrations     migration progress")
    println("  GET  /keys?pattern=*         list keys")
    println("  GET  /count                  total key count")
    println("  GET  /raft/<shardId>         raft state of shard")
    println("  POST /cmd  body=<line>       Redis-like command")
    println("press Ctrl+C to stop")
    while true do
        time.sleep(1000)
    end
    return 0
end


// ============================================================================
// SECTION 15 - Test suite
// ============================================================================

func check(bool ok, string label)
    gLog.lock()
    if ok then
        gPass += 1
        println("  [PASS] " + label)
    else
        gFail += 1
        println("  [FAIL] " + label)
    end
    gLog.unlock()
end

func checkEq(string actual, string expected, string label)
    check(actual == expected, label + " (got '" + actual + "' expected '" + expected + "')")
end

func checkContains(string haystack, string needle, string label)
    check(string.contains(haystack, needle), label + " (missing '" + needle + "')")
end

func section(string title)
    println("")
    println("--- " + title + " ---")
end

func collectSlotPerNode() as var
    var shards = ensureShards()
    var slotPerNode = {}
    int i = 0
    while i < DEFAULT_SHARD_COUNT do
        string sid = string(i)
        var sh = ensureShard(sid)
        string prim = string(sh["primary"])
        if not (prim in slotPerNode) then slotPerNode[prim] = 0 end
        slotPerNode[prim] = int(slotPerNode[prim]) + 1
        i += 1
    end
    return slotPerNode
end

func collectKeyPerNode() as var
    var shards = ensureShards()
    var data = ensureData()
    var perNode = {}
    int i = 0
    while i < DEFAULT_SHARD_COUNT do
        string sid = string(i)
        var sh = ensureShard(sid)
        string prim = string(sh["primary"])
        if not (prim in perNode) then perNode[prim] = 0 end
        if sid in data then
            perNode[prim] = int(perNode[prim]) + data[sid].length
        end
        i += 1
    end
    return perNode
end

func test01ClusterInit() as int
    section("[test 01] cluster init")
    var r = clusterInit(5)
    check(bool(r["ok"]), "clusterInit returns ok")
    check(int(r["nodes"]) == 5, "5 nodes created")
    check(int(r["shards"]) == DEFAULT_SHARD_COUNT, "64 shards created")
    var nodes = ensureNodes()
    check(nodes.length == 5, "nodes count == 5")
    check("node-a" in nodes, "node-a exists")
    check("node-b" in nodes, "node-b exists")
    check("node-c" in nodes, "node-c exists")
    check("node-d" in nodes, "node-d exists")
    check("node-e" in nodes, "node-e exists")
    var ring = ensureRing()
    check(ring.length == 5 * VNODES_PER_NODE, "ring has 750 vnodes (got " + string(ring.length) + ")")
    var shards = ensureShards()
    int noPrimary = 0
    int noLeader = 0
    int i = 0
    while i < DEFAULT_SHARD_COUNT do
        string sid = string(i)
        if isEmpty(string(shards[sid]["primary"])) then noPrimary += 1 end
        if isEmpty(string(shards[sid]["leader"])) then noLeader += 1 end
        i += 1
    end
    check(noPrimary == 0, "all 64 shards have primary assigned")
    check(noLeader == 0, "all 64 shards have leader elected")
    var raft = ensureRaft()
    check(raft.length == DEFAULT_SHARD_COUNT, "all 64 shards have raft state")
    var slotPerNode = collectSlotPerNode()
    check(slotPerNode.length == 5, "slots distributed across all 5 nodes")
    return 0
end

func test02HashRingAndRouting() as int
    section("[test 02] hash ring + key routing")
    string k1 = "user:1001"
    string sid1a = shardOf(k1)
    string sid1b = shardOf(k1)
    check(sid1a == sid1b, "same key -> same shard (deterministic)")
    var seen = {}
    int i = 0
    while i < 100 do
        string k = "k:" + string(i)
        string sid = shardOf(k)
        if not (sid in seen) then seen[sid] = 0 end
        seen[sid] = int(seen[sid]) + 1
        i += 1
    end
    check(seen.length > 1, "100 keys spread across >1 shard (got " + string(seen.length) + ")")
    var ring = ensureRing()
    int firstH = int(ring[0]["hash"])
    string owner = ringLookup(firstH)
    check(owner == string(ring[0]["nodeId"]), "ringLookup returns first vnode's owner for first hash")
    string wrapOwner = ringLookup(int(ring[ring.length - 1]["hash"]) + 1)
    check(not isEmpty(wrapOwner), "ringLookup wraps around for hash > max")
    var three = ringLookupN(hashKey("test-multi-lookup"), 3)
    check(three.length == 3, "ringLookupN returns 3 distinct nodes")
    check(string(three[0]) != string(three[1]), "first two replicas differ")
    check(string(three[1]) != string(three[2]), "second and third replicas differ")
    return 0
end

func test03KeyDistribution() as int
    section("[test 03] key distribution balance")
    int i = 0
    int t0 = nowMs()
    while i < 1000 do
        string k = "dist:" + string(i)
        var r = routeSet(k, "v" + string(i))
        if not bool(r["ok"]) then
            check(false, "write dist:" + string(i) + " ok")
            return 1
        end
        i += 1
    end
    int t1 = nowMs()
    int total = totalKeyCount()
    check(total >= 1000, "after 1000 writes totalKeyCount >= 1000 (got " + string(total) + ")")
    var perNode = collectKeyPerNode()
    check(perNode.length >= 4, "keys spread across >=4 of 5 nodes (got " + string(perNode.length) + ")")
    int sumK = 0
    for nid, c in perNode
        sumK += int(c)
    end
    float mean = float(sumK) / float(perNode.length)
    float sumSqDiff = 0.0
    for nid, c in perNode
        float diff = float(int(c)) - mean
        sumSqDiff += diff * diff
    end
    float variance = sumSqDiff / float(perNode.length)
    float stddev = variance
    if stddev > 0.0 then
        float g = stddev / 2.0 + 0.5
        int iter = 0
        while iter < 10 do
            if g <= 0.0 then g = 0.01 end
            g = (g + stddev / g) / 2.0
            iter += 1
        end
        stddev = g
    end
    float cv = 0.0
    if mean > 0.0 then cv = stddev / mean end
    check(cv < 0.5, "balance CV < 0.5 (got " + string.formatFloat(cv, ".3") + " mean=" + string.formatFloat(mean, ".1") + " stddev=" + string.formatFloat(stddev, ".1") + ")")
    var slotPerNode = collectSlotPerNode()
    int minSlots = 99999
    int maxSlots = 0
    for nid, c in slotPerNode
        if int(c) < minSlots then minSlots = int(c) end
        if int(c) > maxSlots then maxSlots = int(c) end
    end
    int expectedPerNode = DEFAULT_SHARD_COUNT / 5
    check(minSlots > 0, "min slot count > 0 (got " + string(minSlots) + ")")
    check(maxSlots < expectedPerNode * 2, "max slot count < 2x expected (got " + string(maxSlots) + ")")
    println("  wrote 1000 keys in " + formatMs(t1 - t0))
    return 0
end

func test04DataTypes() as int
    section("[test 04] data type operations")
    var setR = routeSet("t:str", "hello")
    check(bool(setR["ok"]), "SET t=str returns ok")
    checkEq(opGet(shardOf("t:str"), "t:str"), "hello", "GET t=str")
    checkEq(opIncr(shardOf("t:cnt"), "t:cnt", 1), "1", "INCR t:cnt first time")
    checkEq(opIncr(shardOf("t:cnt"), "t:cnt", 1), "2", "INCR t:cnt second time")
    checkEq(opIncr(shardOf("t:cnt"), "t:cnt", 10), "12", "INCR t:cnt by 10")

    string lk = "t:list"
    string lsid = shardOf(lk)
    opRpush(lsid, lk, ["a", "b", "c"])
    checkEq(opLlen(lsid, lk), "3", "RPUSH a b c -> LLEN = 3")
    checkEq(opLrange(lsid, lk, 0, -1), "[\"a\",\"b\",\"c\"]", "LRANGE 0 -1 = [a,b,c]")
    opLpush(lsid, lk, ["z"])
    checkEq(opLrange(lsid, lk, 0, 0), "[\"z\"]", "LPUSH z -> LRANGE 0 0 = [z]")
    checkEq(opLpop(lsid, lk, 1), "z", "LPOP = z")
    checkEq(opRpop(lsid, lk, 1), "c", "RPOP = c")
    checkEq(opLlen(lsid, lk), "2", "LLEN after pops = 2")

    string hk = "t:hash"
    string hsid = shardOf(hk)
    opHset(hsid, hk, "name", "Alice")
    opHset(hsid, hk, "age", "30")
    opHset(hsid, hk, "city", "Shanghai")
    checkEq(opHget(hsid, hk, "name"), "Alice", "HGET name = Alice")
    checkEq(opHget(hsid, hk, "age"), "30", "HGET age = 30")
    checkEq(opHlen(hsid, hk), "3", "HLEN = 3")
    opHdel(hsid, hk, "age")
    checkEq(opHget(hsid, hk, "age"), "(nil)", "HGET age after HDEL = nil")
    checkEq(opHlen(hsid, hk), "2", "HLEN after HDEL = 2")

    string sk = "t:set"
    string ssid = shardOf(sk)
    opSadd(ssid, sk, ["m1", "m2", "m3"])
    checkEq(opScard(ssid, sk), "3", "SADD m1 m2 m3 -> SCARD = 3")
    check(string(opSismember(ssid, sk, "m2")) == "1", "SISMEMBER m2 = 1")
    check(string(opSismember(ssid, sk, "mx")) == "0", "SISMEMBER mx = 0")
    opSrem(ssid, sk, ["m2"])
    checkEq(opScard(ssid, sk), "2", "SCARD after SREM m2 = 2")
    check(string(opSismember(ssid, sk, "m2")) == "0", "SISMEMBER m2 after SREM = 0")

    string zk = "t:zset"
    string zsid = shardOf(zk)
    opZadd(zsid, zk, 3.0, "alpha")
    opZadd(zsid, zk, 1.0, "beta")
    opZadd(zsid, zk, 2.0, "gamma")
    checkEq(opZcard(zsid, zk), "3", "ZADD 3 -> ZCARD = 3")
    checkEq(opZscore(zsid, zk, "beta"), "1.0000", "ZSCORE beta = 1.0000")
    string zr = opZrange(zsid, zk, 0, -1)
    checkContains(zr, "beta", "ZRANGE 0 -1 contains beta (lowest score)")
    checkContains(zr, "gamma", "ZRANGE 0 -1 contains gamma")
    checkContains(zr, "alpha", "ZRANGE 0 -1 contains alpha (highest score)")
    int betaPos = string.indexOf(zr, "beta")
    int gammaPos = string.indexOf(zr, "gamma")
    int alphaPos = string.indexOf(zr, "alpha")
    check(betaPos < gammaPos, "beta appears before gamma")
    check(gammaPos < alphaPos, "gamma appears before alpha")
    opZrem(zsid, zk, "gamma")
    checkEq(opZcard(zsid, zk), "2", "ZCARD after ZREM gamma = 2")

    checkEq(opType(shardOf("t:str"), "t:str"), "string", "TYPE t:str = string")
    checkEq(opType(lsid, lk), "list", "TYPE t:list = list")
    checkEq(opType(hsid, hk), "hash", "TYPE t:hash = hash")
    checkEq(opType(ssid, sk), "set", "TYPE t:set = set")
    checkEq(opType(zsid, zk), "zset", "TYPE t:zset = zset")
    return 0
end

func test05TTL() as int
    section("[test 05] TTL + expiration")
    string sid = shardOf("ttl:key1")
    opSet(sid, "ttl:key1", "v1")
    opExpire(sid, "ttl:key1", 100)
    check(opTtl(sid, "ttl:key1") > 0, "TTL after EXPIRE > 0")
    check(opTtl(sid, "ttl:key1") <= 100, "TTL <= 100")
    opPersist(sid, "ttl:key1")
    checkEq(string(opTtl(sid, "ttl:key1")), "-1", "TTL after PERSIST = -1")
    var expiredEntry = makeEntry("string", "old")
    expiredEntry["ttl"] = nowSec() - 10
    putEntry(sid, "ttl:expired", expiredEntry)
    check(lazyExpire(sid, "ttl:expired"), "lazy expire detects past TTL")
    check(getEntry(sid, "ttl:expired") == null, "lazy expire removes key from shard data")
    string sid2 = shardOf("ttl:sweep")
    int i = 0
    while i < 5 do
        string k = "ttl:sweep:" + string(i)
        var e = makeEntry("string", "v")
        e["ttl"] = nowSec() - 1
        putEntry(sid2, k, e)
        i += 1
    end
    int swept = activeSweepShard(sid2, 100)
    check(swept == 5, "active sweep removes 5 expired keys (got " + string(swept) + ")")
    checkEq(string(opTtl(sid, "no:such:key")), "-2", "TTL for missing key = -2")
    return 0
end

func test06Raft() as int
    section("[test 06] Raft consensus")
    string sid = "0"
    var raft = gState["raft"]
    if not (sid in raft) then
        check(false, "shard 0 has raft state")
        return 1
    end
    var rs = raft[sid]
    check(int(rs["currentTerm"]) == 1, "initial term == 1")
    check(not isEmpty(string(rs["leaderId"])), "initial leader is set")
    int beforeLogLen = rs["log"].length
    var cmd = {"op": "SET", "key": "raft:k1", "value": "v1", "type": "string"}
    int ci = raftAppendAndApply(sid, cmd)
    check(ci > 0, "raftAppendAndApply returns positive index (got " + string(ci) + ")")
    var raft2 = gState["raft"]
    var rs2 = raft2[sid]
    check(rs2["log"].length == beforeLogLen + 1, "log grew by 1 after append")
    check(int(rs2["commitIndex"]) == ci, "commitIndex advanced")
    check(int(rs2["lastApplied"]) == ci, "lastApplied advanced")
    checkEq(opGet(sid, "raft:k1"), "v1", "data visible after apply")
    int i = 0
    while i < RAFT_SNAPSHOT_THRESHOLD + 5 do
        var cmd2 = {"op": "SET", "key": "raft:bulk:" + string(i), "value": string(i), "type": "string"}
        raftAppendAndApply(sid, cmd2)
        i += 1
    end
    var stats = gState["stats"]
    check(int(stats["raftSnapshotsTaken"]) >= 1, "snapshot taken after >50 appends")
    var raft3 = gState["raft"]
    var rs3 = raft3[sid]
    check(rs3["log"].length < RAFT_SNAPSHOT_THRESHOLD, "log truncated below threshold after snapshot (got " + string(rs3["log"].length) + ")")
    checkEq(opGet(sid, "raft:k1"), "v1", "data visible after snapshot")
    checkEq(opGet(sid, "raft:bulk:0"), "0", "bulk data[0] visible after snapshot")
    var addR = raftAddServer(sid, "node-zzz")
    check(bool(addR["ok"]), "raftAddServer adds replica")
    var remR = raftRemoveServer(sid, "node-zzz")
    check(bool(remR["ok"]), "raftRemoveServer removes replica")
    return 0
end

func test07ReplicationAndRead() as int
    section("[test 07] replication + linearizable read")
    string sid = shardOf("rep:k1")
    var cmd = {"op": "SET", "key": "rep:k1", "value": "replicated", "type": "string"}
    int ci = raftAppendAndApply(sid, cmd)
    check(ci > 0, "SET committed")
    var raft = gState["raft"]
    var rs = raft[sid]
    var matchIdx = rs["matchIndex"]
    bool matchAdvanced = false
    for rid, idx in matchIdx
        if int(idx) == ci then matchAdvanced = true end
    end
    check(matchAdvanced, "follower matchIndex reflects latest commit")
    string v = linearizableRead(sid, "rep:k1")
    checkEq(v, "replicated", "linearizableRead returns latest value")
    int replicas = replicateToFollowers(sid)
    check(replicas >= 1, "replicateToFollowers returns >=1 replica (got " + string(replicas) + ")")
    return 0
end

func test08Failover() as int
    section("[test 08] failover (node failure)")
    string targetSid = ""
    string targetLeader = ""
    int i = 0
    while i < DEFAULT_SHARD_COUNT do
        string sid = string(i)
        var rs = ensureRaftShard(sid)
        string leader = string(rs["leaderId"])
        if not isEmpty(leader) then
            targetSid = sid
            targetLeader = leader
            break
        end
        i += 1
    end
    check(not isEmpty(targetSid), "found a shard with leader")
    string testKey = "failover:test:" + targetSid
    var cmd = {"op": "SET", "key": testKey, "value": "before", "type": "string"}
    int writeCi = raftAppendAndApply(targetSid, cmd)
    check(writeCi > 0, "data write committed (ci=" + string(writeCi) + ")")
    checkEq(opGet(targetSid, testKey), "before", "data written before failure")
    var r = clusterFailNode(targetLeader)
    check(bool(r["ok"]), "fail " + targetLeader + " ok")
    var nodes2 = gState["nodes"]
    check(string(nodes2[targetLeader]["status"]) == "down", "node marked down")
    check(r["affectedShards"].length >= 1, "at least 1 shard affected (was leader)")
    check(r["reelected"] >= 1, "at least 1 new leader elected")
    var rs = ensureRaftShard(targetSid)
    string newLeader = string(rs["leaderId"])
    check(newLeader != targetLeader, "new leader differs from failed leader")
    var nodes3 = gState["nodes"]
    check(string(nodes3[newLeader]["status"]) == "online", "new leader is online")
    string v = linearizableRead(targetSid, testKey)
    checkEq(v, "before", "data accessible through new leader after failover")
    var rec = clusterRecoverNode(targetLeader)
    check(bool(rec["ok"]), "recover " + targetLeader + " ok")
    var nodes4 = gState["nodes"]
    check(string(nodes4[targetLeader]["status"]) == "online", "recovered node marked online")
    return 0
end

func test09JoinLeaveMigration() as int
    section("[test 09] node join/leave + migration")
    int nodesBefore = ensureNodes().length
    int keysBefore = totalKeyCount()
    string newId = nextNodeId()
    var r = clusterAddNode(newId, 7099)
    check(bool(r["ok"]), "clusterAddNode " + newId + " ok")
    check(ensureNodes().length == nodesBefore + 1, "node count increased by 1")
    check(r["ranges"].length > 0, "join migration has ranges > 0")
    bool hasOldAndNew = false
    int i = 0
    while i < r["ranges"].length do
        if string(r["ranges"][i]["newOwner"]) == newId then
            hasOldAndNew = true
            break
        end
        i += 1
    end
    check(hasOldAndNew, "join migration ranges reference newOwner=" + newId)
    advanceMigrations()
    var migrations = ensureMigrations()
    bool joinCompleted = false
    int mi = 0
    while mi < migrations.length do
        if string(migrations[mi]["nodeId"]) == newId and string(migrations[mi]["status"]) == "completed" then
            joinCompleted = true
            break
        end
        mi += 1
    end
    check(joinCompleted, "join migration completed")
    int keysAfterAdd = totalKeyCount()
    check(keysAfterAdd == keysBefore, "total keys unchanged after add")
    var rmR = clusterRemoveNode(newId)
    check(bool(rmR["ok"]), "clusterRemoveNode " + newId + " ok")
    check(ensureNodes().length == nodesBefore, "node count back to " + string(nodesBefore))
    check(rmR["ranges"].length > 0, "leave migration has ranges > 0")
    advanceMigrations()
    return 0
end

func test10ScatterGather() as int
    section("[test 10] scatter-gather (KEYS / COUNT)")
    int i = 0
    while i < 20 do
        routeSet("scatter:" + string(i), "v")
        i += 1
    end
    int beforeC = totalKeyCount()
    check(beforeC > 0, "COUNT > 0 after writes (got " + string(beforeC) + ")")
    var sg = scatterGather("keys:scatter:*", "scatter:*")
    int matched = 0
    int si = 0
    while si < sg.length do
        matched += sg[si]["keys"].length
        si += 1
    end
    check(matched == 20, "scatter-gather KEYS scatter:* matches 20 (got " + string(matched) + ")")
    var sgNone = scatterGather("keys:nomatch:*", "nomatch:*")
    int matchedNone = 0
    si = 0
    while si < sgNone.length do
        matchedNone += sgNone[si]["keys"].length
        si += 1
    end
    check(matchedNone == 0, "scatter-gather non-matching pattern returns 0")
    return 0
end

func test11CrossShardTx() as int
    section("[test 11] cross-shard transaction (2PC)")
    var cmds = []
    cmds.append({"op": "SET", "key": "tx:a:1", "value": "va", "type": "string"})
    cmds.append({"op": "SET", "key": "tx:b:2", "value": "vb", "type": "string"})
    cmds.append({"op": "SET", "key": "tx:c:3", "value": "vc", "type": "string"})
    var r = crossShardTx(cmds)
    check(bool(r["ok"]), "2PC commit succeeds")
    check(string(r["phase"]) == "commit", "phase = commit")
    checkEq(opGet(shardOf("tx:a:1"), "tx:a:1"), "va", "tx:a:1 visible after commit")
    checkEq(opGet(shardOf("tx:b:2"), "tx:b:2"), "vb", "tx:b:2 visible after commit")
    checkEq(opGet(shardOf("tx:c:3"), "tx:c:3"), "vc", "tx:c:3 visible after commit")
    var stats = ensureStats()
    check(int(stats["txCommits"]) >= 1, "txCommits stat incremented")
    return 0
end

func test12Protocol() as int
    section("[test 12] client protocol (Redis-like)")
    checkEq(executeProtocolLine("PING"), "PONG", "PING -> PONG")
    checkEq(executeProtocolLine("SET proto:k1 hello"), "OK", "SET proto:k1 -> OK")
    checkEq(executeProtocolLine("GET proto:k1"), "hello", "GET proto:k1 -> hello")
    checkEq(executeProtocolLine("TYPE proto:k1"), "string", "TYPE proto:k1 -> string")
    checkEq(executeProtocolLine("EXISTS proto:k1"), "1", "EXISTS proto:k1 -> 1")
    checkEq(executeProtocolLine("EXISTS proto:nope"), "0", "EXISTS missing -> 0")
    checkEq(executeProtocolLine("INCR proto:cnt"), "1", "INCR proto:cnt -> 1")
    checkEq(executeProtocolLine("INCR proto:cnt"), "2", "INCR proto:cnt -> 2")
    checkEq(executeProtocolLine("RPUSH proto:lst a b c"), "3", "RPUSH -> 3")
    checkEq(executeProtocolLine("LLEN proto:lst"), "3", "LLEN -> 3")
    checkContains(executeProtocolLine("LRANGE proto:lst 0 -1"), "a", "LRANGE contains a")
    checkEq(executeProtocolLine("HSET proto:h f v"), "1", "HSET -> 1")
    checkEq(executeProtocolLine("HGET proto:h f"), "v", "HGET -> v")
    checkEq(executeProtocolLine("SADD proto:s m1 m2"), "2", "SADD -> 2")
    checkEq(executeProtocolLine("SCARD proto:s"), "2", "SCARD -> 2")
    checkEq(executeProtocolLine("ZADD proto:z 1.0 alpha"), "1", "ZADD -> 1")
    checkEq(executeProtocolLine("ZSCORE proto:z alpha"), "1.0000", "ZSCORE -> 1.0000")
    string info = executeProtocolLine("CLUSTER INFO")
    checkContains(info, "nodes_total", "CLUSTER INFO has nodes_total")
    string nodesOut = executeProtocolLine("CLUSTER NODES")
    checkContains(nodesOut, "node-a", "CLUSTER NODES has node-a")
    string delOut = executeProtocolLine("DEL proto:k1")
    check(delOut == "1", "DEL proto:k1 -> 1")
    checkEq(executeProtocolLine("EXISTS proto:k1"), "0", "EXISTS after DEL -> 0")
    return 0
end

func test13ShardSplitMerge() as int
    section("[test 13] shard split / merge")
    string sid = "1"
    var shards = gState["shards"]
    if not (sid in shards) then
        shards[sid] = {"id": sid, "primary": "", "replicas": [], "leader": "",
                       "leaderTerm": 0, "keyCount": 0, "splitCount": 0, "mergeCount": 0}
        gState["shards"] = shards
    end
    var sh = shards[sid]
    sh["keyCount"] = SHARD_SPLIT_THRESHOLD + 1
    shards[sid] = sh
    gState["shards"] = shards
    var spR = shardSplit(sid)
    check(bool(spR["ok"]), "shardSplit triggered above threshold")
    var shards2 = gState["shards"]
    var sh2 = shards2[sid]
    check(int(sh2["splitCount"]) == 1, "splitCount == 1")
    sh2["keyCount"] = 0
    shards2[sid] = sh2
    gState["shards"] = shards2
    var mgR = shardMerge(sid)
    check(bool(mgR["ok"]), "shardMerge triggered below threshold")
    var shards3 = gState["shards"]
    var sh3 = shards3[sid]
    check(int(sh3["mergeCount"]) == 1, "mergeCount == 1")
    sh3["keyCount"] = 5
    shards3[sid] = sh3
    gState["shards"] = shards3
    var spR2 = shardSplit(sid)
    check(not bool(spR2["ok"]), "shardSplit rejects below threshold")
    var shards4 = gState["shards"]
    var sh4 = shards4[sid]
    sh4["keyCount"] = 100
    shards4[sid] = sh4
    gState["shards"] = shards4
    var mgR2 = shardMerge(sid)
    check(not bool(mgR2["ok"]), "shardMerge rejects above threshold")
    return 0
end

func test14EndToEnd() as int
    section("[test 14] end-to-end (5 nodes -> 1000 keys -> fail -> verify -> recover)")
    clusterInit(5)
    int i = 0
    while i < 1000 do
        string k = "e2e:" + string(i)
        string v = "v:" + string(i)
        var r = routeSet(k, v)
        if not bool(r["ok"]) then
            check(false, "e2e write " + k + " ok")
            return 1
        end
        i += 1
    end
    int totalK = totalKeyCount()
    check(totalK == 1000, "1000 keys written (got " + string(totalK) + ")")
    var perNode = collectKeyPerNode()
    check(perNode.length >= 4, "keys spread across >=4 nodes (got " + string(perNode.length) + ")")
    string failTarget = ""
    for nid, c in perNode
        if int(c) > 0 then
            failTarget = string(nid)
            break
        end
    end
    check(not isEmpty(failTarget), "found node with data to fail")
    var beforeSnapshot = {}
    int ki = 0
    while ki < 1000 do
        string k = "e2e:" + string(ki)
        beforeSnapshot[k] = opGet(shardOf(k), k)
        ki += 1
    end
    var fr = clusterFailNode(failTarget)
    check(bool(fr["ok"]), "fail " + failTarget + " ok")
    int accessibleAfterFail = 0
    ki = 0
    while ki < 1000 do
        string k = "e2e:" + string(ki)
        string v = opGet(shardOf(k), k)
        if v == string(beforeSnapshot[k]) then
            accessibleAfterFail += 1
        end
        ki += 1
    end
    check(accessibleAfterFail == 1000, "all 1000 keys still accessible after failure (got " + string(accessibleAfterFail) + ")")
    var rec = clusterRecoverNode(failTarget)
    check(bool(rec["ok"]), "recover " + failTarget + " ok")
    int consistentAfterRecover = 0
    ki = 0
    while ki < 1000 do
        string k = "e2e:" + string(ki)
        string v = opGet(shardOf(k), k)
        if v == string(beforeSnapshot[k]) then
            consistentAfterRecover += 1
        end
        ki += 1
    end
    check(consistentAfterRecover == 1000, "all 1000 keys consistent after recovery (got " + string(consistentAfterRecover) + ")")
    int j = 0
    while j < 100 do
        string k = "e2e:post:" + string(j)
        var r = routeSet(k, "post" + string(j))
        if not bool(r["ok"]) then
            check(false, "post-recovery write ok")
            return 1
        end
        j += 1
    end
    check(totalKeyCount() == 1100, "100 new keys added after recovery (total=1100, got " + string(totalKeyCount()) + ")")
    var stats = ensureStats()
    check(int(stats["leaderChanges"]) >= 1, "leaderChanges >= 1 after failover")
    check(int(stats["totalSets"]) >= 1100, "totalSets >= 1100")
    return 0
end

func test15ExportImport() as int
    section("[test 15] export / import")
    string tmpFile = path.join(path.dir(gStateFile), ".xdistdb_test_export.json")
    if file.exists(tmpFile) then file.delete(tmpFile) end
    routeSet("exp:k1", "v1")
    routeSet("exp:k2", "v2")
    string text = json.stringify(gState, pretty = true)
    text = string.replace(text, "\t", "  ")
    bool ok = file.writeText(tmpFile, text)
    check(ok, "export to file ok")
    gState = {}
    ensureStats()
    if not file.exists(tmpFile) then
        check(false, "imported file exists")
        return 1
    end
    string text2 = file.readText(tmpFile)
    var parsed = json.parse(text2)
    gState = parsed
    ensureStats()
    checkEq(opGet(shardOf("exp:k1"), "exp:k1"), "v1", "exp:k1 readable after import")
    checkEq(opGet(shardOf("exp:k2"), "exp:k2"), "v2", "exp:k2 readable after import")
    if file.exists(tmpFile) then file.delete(tmpFile) end
    return 0
end

// Multi-node failover: fail 2 of 5 nodes, verify data still accessible.
func test16MultiFailover() as int
    section("[test 16] multi-node failover (2 of 5 down)")
    clusterInit(5)
    int i = 0
    while i < 200 do
        routeSet("mf:" + string(i), "v" + string(i))
        i += 1
    end
    int totalBefore = totalKeyCount()
    check(totalBefore == 200, "200 keys written before multi-failure")
    // Snapshot keys
    var snap = {}
    i = 0
    while i < 200 do
        string k = "mf:" + string(i)
        snap[k] = opGet(shardOf(k), k)
        i += 1
    end
    // Fail two distinct nodes
    var nodes = gState["nodes"]
    var nodeIds = []
    for nid, n in nodes
        nodeIds.append(string(nid))
    end
    check(nodeIds.length == 5, "5 nodes exist before failure")
    string fail1 = string(nodeIds[0])
    string fail2 = string(nodeIds[1])
    var r1 = clusterFailNode(fail1)
    var r2 = clusterFailNode(fail2)
    check(bool(r1["ok"]), "fail " + fail1 + " ok")
    check(bool(r2["ok"]), "fail " + fail2 + " ok")
    var nodes2 = gState["nodes"]
    int onlineCount = 0
    for nid, n in nodes2
        if string(n["status"]) == "online" then onlineCount += 1 end
    end
    check(onlineCount == 3, "3 nodes still online after 2 failures")
    // Verify all keys still accessible via remaining replicas
    int accessible = 0
    i = 0
    while i < 200 do
        string k = "mf:" + string(i)
        string v = opGet(shardOf(k), k)
        if v == string(snap[k]) then accessible += 1 end
        i += 1
    end
    check(accessible == 200, "all 200 keys accessible with 2 nodes down (got " + string(accessible) + ")")
    // Recover both
    clusterRecoverNode(fail1)
    clusterRecoverNode(fail2)
    var nodes3 = gState["nodes"]
    onlineCount = 0
    for nid, n in nodes3
        if string(n["status"]) == "online" then onlineCount += 1 end
    end
    check(onlineCount == 5, "all 5 nodes online after recovery")
    return 0
end

// Hash ring determinism: same node set always produces same ring.
func test17RingDeterminism() as int
    section("[test 17] hash ring determinism")
    clusterInit(3)
    var ring1 = gState["ring"]
    string dump1 = json.stringify(ring1)
    // Re-init and compare
    clusterInit(3)
    var ring2 = gState["ring"]
    string dump2 = json.stringify(ring2)
    check(dump1 == dump2, "ring deterministic for same node set")
    check(ring1.length == 3 * VNODES_PER_NODE, "ring size = 3 * vnodes_per_node")
    // Different node count -> different ring
    clusterInit(5)
    var ring3 = gState["ring"]
    string dump3 = json.stringify(ring3)
    check(dump3 != dump1, "ring differs for different node set")
    check(ring3.length == 5 * VNODES_PER_NODE, "ring size = 5 * vnodes_per_node")
    return 0
end

// Load + save state persistence.
func test18Persistence() as int
    section("[test 18] persistence (save -> load)")
    clusterInit(4)
    routeSet("persist:k1", "v1")
    routeSet("persist:k2", "v2")
    routeSet("persist:k3", "v3")
    int before = totalKeyCount()
    check(before == 3, "3 keys written")
    string tmpFile = path.join(path.dir(gStateFile), ".xdistdb_persist_test.json")
    if file.exists(tmpFile) then file.delete(tmpFile) end
    bool saved = saveState(tmpFile)
    check(saved, "saveState ok")
    check(file.exists(tmpFile), "state file created")
    // Wipe in-memory state
    gState = {}
    ensureStats()
    // Load back
    bool loaded = loadState(tmpFile)
    check(loaded, "loadState ok")
    int after = totalKeyCount()
    check(after == before, "key count preserved across save/load (got " + string(after) + " expected " + string(before) + ")")
    checkEq(opGet(shardOf("persist:k1"), "persist:k1"), "v1", "persist:k1 readable after load")
    checkEq(opGet(shardOf("persist:k2"), "persist:k2"), "v2", "persist:k2 readable after load")
    checkEq(opGet(shardOf("persist:k3"), "persist:k3"), "v3", "persist:k3 readable after load")
    if file.exists(tmpFile) then file.delete(tmpFile) end
    return 0
end

// Data type edge cases: empty containers, negative indices, large sets.
func test19EdgeCases() as int
    section("[test 19] data type edge cases")
    // Empty list
    string esid = shardOf("edge:elist")
    opDel(esid, "edge:elist")
    opRpush(esid, "edge:elist", [])
    checkEq(opLlen(esid, "edge:elist"), "0", "empty list LLEN = 0")
    opRpush(esid, "edge:elist", ["a", "b", "c", "d"])
    checkEq(opLrange(esid, "edge:elist", -2, -1), "[\"c\",\"d\"]", "LRANGE -2 -1 = [c,d]")
    checkEq(opLrange(esid, "edge:elist", 0, -1), "[\"a\",\"b\",\"c\",\"d\"]", "LRANGE 0 -1 = all 4")
    // Out-of-range indices
    checkEq(opLrange(esid, "edge:elist", 100, 200), "[]", "LRANGE out-of-range = []")
    // Large set
    string sk = "edge:bigset"
    string sid = shardOf(sk)
    int i = 0
    while i < 50 do
        opSadd(sid, sk, ["m" + string(i)])
        i += 1
    end
    checkEq(opScard(sid, sk), "50", "SCARD after 50 SADD = 50")
    // Wrong-type checks
    checkEq(opLpush(sid, sk, ["x"]), "(error) WRONGTYPE", "LPUSH on set -> WRONGTYPE")
    checkEq(opHget(sid, sk, "f"), "(error) WRONGTYPE", "HGET on set -> WRONGTYPE")
    checkEq(opZscore(sid, sk, "m"), "(error) WRONGTYPE", "ZSCORE on set -> WRONGTYPE")
    // ZSET ordering
    string zk = "edge:zset"
    string zsid = shardOf(zk)
    opZadd(zsid, zk, 5.5, "five")
    opZadd(zsid, zk, 1.1, "one")
    opZadd(zsid, zk, 3.3, "three")
    opZadd(zsid, zk, 2.2, "two")
    string zr = opZrange(zsid, zk, 0, -1)
    int p1 = string.indexOf(zr, "one")
    int p2 = string.indexOf(zr, "two")
    int p3 = string.indexOf(zr, "three")
    int p4 = string.indexOf(zr, "five")
    check(p1 < p2, "zset: one before two")
    check(p2 < p3, "zset: two before three")
    check(p3 < p4, "zset: three before five")
    return 0
end

// Migration range correctness.
func test20MigrationRanges() as int
    section("[test 20] migration range computation")
    clusterInit(4)
    // Add node -> ranges should have newOwner = new node
    string newId = nextNodeId()
    var addR = clusterAddNode(newId, 7777)
    check(bool(addR["ok"]), "add node")
    var ranges = addR["ranges"]
    check(ranges.length == VNODES_PER_NODE, "join ranges = vnodes_per_node (got " + string(ranges.length) + ")")
    bool allNewOwner = true
    int i = 0
    while i < ranges.length do
        if string(ranges[i]["newOwner"]) != newId then
            allNewOwner = false
            break
        end
        i += 1
    end
    check(allNewOwner, "all join ranges have newOwner=new node")
    // Each range has fromHash < toHash
    bool allHashed = true
    i = 0
    while i < ranges.length do
        int from = int(ranges[i]["fromHash"])
        int to = int(ranges[i]["toHash"])
        if from >= to then
            allHashed = false
            break
        end
        i += 1
    end
    check(allHashed, "all ranges have fromHash < toHash")
    // Leave node -> ranges should have oldOwner = leaving node
    var leaveR = clusterRemoveNode(newId)
    check(bool(leaveR["ok"]), "remove node")
    var lranges = leaveR["ranges"]
    check(lranges.length == VNODES_PER_NODE, "leave ranges = vnodes_per_node (got " + string(lranges.length) + ")")
    bool allOldOwner = true
    i = 0
    while i < lranges.length do
        if string(lranges[i]["oldOwner"]) != newId then
            allOldOwner = false
            break
        end
        i += 1
    end
    check(allOldOwner, "all leave ranges have oldOwner=leaving node")
    return 0
end

// Migration progress reporting.
func test21MigrationProgress() as int
    section("[test 21] migration progress reporting")
    clusterInit(3)
    // Initial state: no migrations
    string mp = formatMigrationProgress()
    checkContains(mp, "no migrations", "initially no migrations")
    // Add a node -> creates pending migration
    string nid = nextNodeId()
    clusterAddNode(nid, 7800)
    string mp2 = formatMigrationProgress()
    checkContains(mp2, nid, "migration report mentions new node")
    checkContains(mp2, "join", "migration report mentions type=join")
    // Advance migrations
    advanceMigrations()
    string mp3 = formatMigrationProgress()
    checkContains(mp3, "completed", "migration report shows completed status")
    var stats = gState["stats"]
    check(int(stats["migrationsCompleted"]) >= 1, "migrationsCompleted stat incremented")
    return 0
end

// Coordinator routing metadata.
func test22Routing() as int
    section("[test 22] coordinator routing metadata")
    clusterInit(5)
    // Each key has a valid shard + leader
    int i = 0
    while i < 20 do
        string k = "route:" + string(i)
        var info = routeKey(k)
        check(not isEmpty(string(info["shardId"])), "key " + k + " has shardId")
        check(not isEmpty(string(info["leader"])), "key " + k + " has leader")
        check(not isEmpty(string(info["primary"])), "key " + k + " has primary")
        i += 1
    end
    // Set + verify routing info in result
    var r = routeSet("route:test", "value")
    check(bool(r["ok"]), "routeSet returns ok")
    check(not isEmpty(string(r["shardId"])), "routeSet result has shardId")
    check(int(r["commitIndex"]) > 0, "routeSet result has positive commitIndex")
    var g = routeGet("route:test")
    check(bool(g["ok"]), "routeGet returns ok")
    checkEq(string(g["value"]), "value", "routeGet returns correct value")
    // INCR routing
    var ir = routeIncr("route:counter", 5)
    check(bool(ir["ok"]), "routeIncr returns ok")
    checkEq(string(ir["value"]), "5", "routeIncr value = 5")
    return 0
end

// Workload statistics tracking through normal operations.
func test23WorkloadStats() as int
    section("[test 23] workload statistics tracking")
    clusterInit(5)
    var stats0 = gState["stats"]
    int setBefore = int(stats0["totalSets"])
    int getBefore = int(stats0["totalGets"])
    int missBefore = int(stats0["totalMisses"])
    // 10 SETs + 5 GETs (3 hits + 2 misses)
    int i = 0
    while i < 10 do
        routeSet("stat:k" + string(i), "v")
        i += 1
    end
    routeGet("stat:k1")
    routeGet("stat:k2")
    routeGet("stat:k3")
    routeGet("stat:missing1")
    routeGet("stat:missing2")
    var stats1 = gState["stats"]
    check(int(stats1["totalSets"]) >= setBefore + 10, "totalSets incremented by 10")
    check(int(stats1["totalGets"]) >= getBefore + 5, "totalGets incremented by 5")
    check(int(stats1["totalMisses"]) >= missBefore + 2, "totalMisses incremented by 2")
    // Delete tracking
    int delBefore = int(stats1["totalDels"])
    routeDel("stat:k1")
    var stats2 = gState["stats"]
    check(int(stats2["totalDels"]) >= delBefore + 1, "totalDels incremented after DEL")
    // Raft log stats
    check(int(stats2["raftLogAppended"]) > 0, "raftLogAppended > 0")
    check(int(stats2["raftLogCommitted"]) > 0, "raftLogCommitted > 0")
    // Counter via INCR follows correct sequence
    routeSet("stat:counter", "100")
    int c1 = int(string(routeIncr("stat:counter", 1)["value"]))
    int c2 = int(string(routeIncr("stat:counter", 1)["value"]))
    int c10 = int(string(routeIncr("stat:counter", 10)["value"]))
    int cMinus = int(string(routeIncr("stat:counter", -5)["value"]))
    check(c1 == 101, "INCR by 1 from 100 -> 101")
    check(c2 == 102, "INCR by 1 again -> 102")
    check(c10 == 112, "INCR by 10 -> 112")
    check(cMinus == 107, "INCR by -5 -> 107")
    return 0
end

