func cmdList(string subcmd, string key, var args) as int
    string sid = shardOf(key)
    if subcmd == "lpush" then
        var cmd2 = {"op": "LPUSH", "key": key, "value": args, "type": "list"}
        int ci = raftAppendAndApply(sid, cmd2)
        if ci < 0 then
            println("(error) raft commit failed")
            return 1
        end
        println("(integer) " + opLlen(sid, key))
        return 0
    end
    if subcmd == "rpush" then
        var cmd2 = {"op": "RPUSH", "key": key, "value": args, "type": "list"}
        int ci = raftAppendAndApply(sid, cmd2)
        if ci < 0 then
            println("(error) raft commit failed")
            return 1
        end
        println("(integer) " + opLlen(sid, key))
        return 0
    end
    if subcmd == "lpop" then
        int count = 1
        if args.length > 0 then count = int(args[0]) end
        println(opLpop(sid, key, count))
        return 0
    end
    if subcmd == "rpop" then
        int count = 1
        if args.length > 0 then count = int(args[0]) end
        println(opRpop(sid, key, count))
        return 0
    end
    if subcmd == "lrange" then
        int s = 0
        int e = -1
        if args.length >= 1 then s = int(args[0]) end
        if args.length >= 2 then e = int(args[1]) end
        println(opLrange(sid, key, s, e))
        return 0
    end
    if subcmd == "llen" then
        println(opLlen(sid, key))
        return 0
    end
    println("Error: unknown list subcommand: " + subcmd)
    return 1
end

func cmdHash(string subcmd, string key, var args) as int
    string sid = shardOf(key)
    if subcmd == "hset" then
        if args.length < 2 then
            println("Error: HSET requires field and value")
            return 1
        end
        string field = string(args[0])
        string val = string(args[1])
        var cmd2 = {"op": "HSET", "key": key,
                    "value": {"field": field, "val": val}, "type": "hash"}
        int ci = raftAppendAndApply(sid, cmd2)
        if ci < 0 then
            println("(error) raft commit failed")
            return 1
        end
        println("(integer) 1")
        return 0
    end
    if subcmd == "hget" then
        if args.length < 1 then
            println("Error: HGET requires field")
            return 1
        end
        println(opHget(sid, key, string(args[0])))
        return 0
    end
    if subcmd == "hgetall" then
        println(opHgetall(sid, key))
        return 0
    end
    if subcmd == "hdel" then
        if args.length < 1 then
            println("Error: HDEL requires field")
            return 1
        end
        println("(integer) " + string(opHdel(sid, key, string(args[0]))))
        return 0
    end
    if subcmd == "hlen" then
        println(opHlen(sid, key))
        return 0
    end
    println("Error: unknown hash subcommand: " + subcmd)
    return 1
end

func cmdSetOp(string subcmd, string key, var args) as int
    string sid = shardOf(key)
    if subcmd == "sadd" then
        if args.length < 1 then
            println("Error: SADD requires at least one member")
            return 1
        end
        var cmd2 = {"op": "SADD", "key": key, "value": args, "type": "set"}
        int ci = raftAppendAndApply(sid, cmd2)
        if ci < 0 then
            println("(error) raft commit failed")
            return 1
        end
        println("(integer) " + opScard(sid, key))
        return 0
    end
    if subcmd == "srem" then
        int removed = 0
        int i = 0
        while i < args.length do
            removed += opSrem(sid, key, [args[i]])
            i += 1
        end
        println("(integer) " + string(removed))
        return 0
    end
    if subcmd == "smembers" then
        println(opSmembers(sid, key))
        return 0
    end
    if subcmd == "sismember" then
        if args.length < 1 then
            println("Error: SISMEMBER requires member")
            return 1
        end
        println("(integer) " + string(opSismember(sid, key, string(args[0]))))
        return 0
    end
    if subcmd == "scard" then
        println(opScard(sid, key))
        return 0
    end
    println("Error: unknown set subcommand: " + subcmd)
    return 1
end

func cmdZset(string subcmd, string key, var args) as int
    string sid = shardOf(key)
    if subcmd == "zadd" then
        if args.length < 2 then
            println("Error: ZADD requires score and member")
            return 1
        end
        float score = float(string(args[0]))
        string member = string(args[1])
        var cmd2 = {"op": "ZADD", "key": key,
                    "value": {"score": score, "member": member}, "type": "zset"}
        int ci = raftAppendAndApply(sid, cmd2)
        if ci < 0 then
            println("(error) raft commit failed")
            return 1
        end
        println("(integer) 1")
        return 0
    end
    if subcmd == "zrange" then
        int s = 0
        int e = -1
        if args.length >= 1 then s = int(args[0]) end
        if args.length >= 2 then e = int(args[1]) end
        println(opZrange(sid, key, s, e))
        return 0
    end
    if subcmd == "zscore" then
        if args.length < 1 then
            println("Error: ZSCORE requires member")
            return 1
        end
        println(opZscore(sid, key, string(args[0])))
        return 0
    end
    if subcmd == "zcard" then
        println(opZcard(sid, key))
        return 0
    end
    if subcmd == "zrem" then
        if args.length < 1 then
            println("Error: ZREM requires member")
            return 1
        end
        println("(integer) " + string(opZrem(sid, key, string(args[0]))))
        return 0
    end
    println("Error: unknown zset subcommand: " + subcmd)
    return 1
end

func cmdKeys(string pattern) as int
    if isEmpty(pattern) then pattern = "*" end
    var sg = scatterGather("keys:" + pattern, pattern)
    int total = 0
    var all = []
    int si = 0
    while si < sg.length do
        var keys = sg[si]["keys"]
        int kj = 0
        while kj < keys.length do
            all.append(keys[kj])
            total += 1
            kj += 1
        end
        si += 1
    end
    if total == 0 then
        println("(empty)")
        return 0
    end
    int limit = total
    if limit > MAX_KEYS_LOG then limit = MAX_KEYS_LOG end
    int i = 0
    while i < limit do
        println(string(all[i]))
        i += 1
    end
    if total > limit then
        println("... and " + string(total - limit) + " more (total " + string(total) + ")")
    else
        println("(" + string(total) + " keys)")
    end
    return 0
end

