// Hash determinism: same key always routes to same shard.
func test25HashDeterminism() as int
    section("[test 25] hash + routing determinism")
    // Hash function is deterministic
    int h1 = hashKey("user:12345")
    int h2 = hashKey("user:12345")
    check(h1 == h2, "hashKey deterministic for same input")
    // Different inputs -> different hashes (overwhelmingly likely)
    int h3 = hashKey("user:12346")
    check(h3 != h1, "hashKey differs for different input")
    // shardOf deterministic
    string s1 = shardOf("user:12345")
    string s2 = shardOf("user:12345")
    check(s1 == s2, "shardOf deterministic")
    // Range
    int sh = int(s1)
    check(sh >= 0, "shard id >= 0")
    check(sh < DEFAULT_SHARD_COUNT, "shard id < SHARD_COUNT")
    // Hash space coverage: 1000 keys hit many shards
    var shardCount = {}
    int i = 0
    while i < 1000 do
        string s = shardOf("k:" + string(i) + ":" + string(i * 2))
        if not (s in shardCount) then shardCount[s] = 0 end
        shardCount[s] = int(shardCount[s]) + 1
        i += 1
    end
    check(shardCount.length >= DEFAULT_SHARD_COUNT / 2, "1000 keys hit at least half of shards (got " + string(shardCount.length) + ")")
    // No shard gets disproportionate share (> 5% would be odd for 64 shards)
    bool balanced = true
    for sid, c in shardCount
        if int(c) > 100 then
            balanced = false
            break
        end
    end
    check(balanced, "no shard gets > 100 of 1000 keys")
    return 0
end

func runTestSuite() as int
    println("")
    println("================ xdistdb test suite ================")
    gPass = 0
    gFail = 0
    test01ClusterInit()
    test02HashRingAndRouting()
    test03KeyDistribution()
    test04DataTypes()
    test05TTL()
    test06Raft()
    test07ReplicationAndRead()
    test08Failover()
    test09JoinLeaveMigration()
    test10ScatterGather()
    test11CrossShardTx()
    test12Protocol()
    test13ShardSplitMerge()
    test14EndToEnd()
    test15ExportImport()
    test16MultiFailover()
    test17RingDeterminism()
    test18Persistence()
    test19EdgeCases()
    test20MigrationRanges()
    test21MigrationProgress()
    test22Routing()
    test23WorkloadStats()
    test24ClusterStatusFormat()
    test25HashDeterminism()
    println("")
    println("------------------- summary -------------------")
    println("passed: " + string(gPass) + " / " + string(gPass + gFail))
    println("failed: " + string(gFail))
    println("")
    if gFail == 0 then
        println("RESULT: OK - all " + string(gPass) + " assertions passed")
        return 0
    end
    println("RESULT: FAIL - " + string(gFail) + " assertion(s) failed")
    return 1
end


