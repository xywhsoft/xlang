func printHelp()
    println("xdistdb - Distributed Key-Value Database (xlang)")
    println("")
    println("Usage: xdistdb <command> [args]")
    println("")
    println("Cluster commands:")
    println("  cluster init [nodes=N]       initialize cluster (default 5 nodes)")
    println("  cluster add [port=N]         add a node (auto id, triggers migration)")
    println("  cluster remove <nodeId>      remove a node (triggers migration)")
    println("  cluster status               full cluster status")
    println("  cluster nodes                node list")
    println("  cluster shards               shard list (primary / replicas / leader)")
    println("  cluster ring                 consistent hash ring visualization")
    println("  cluster slots                slot distribution per node")
    println("  cluster migrate              advance pending migrations")
    println("  cluster health               health check + heartbeats")
    println("  cluster migrations           migration progress")
    println("  cluster distribution         key distribution per node")
    println("")
    println("Data commands (string):")
    println("  set <key> <value...>         set key=value (auto-typed)")
    println("  get <key>                    get value")
    println("  del <key>                    delete key")
    println("  exists <key>                 key exists?")
    println("  type <key>                   value type")
    println("  incr <key> [delta=1]         integer increment")
    println("  expire <key> <secs>          set TTL")
    println("  ttl <key>                    remaining TTL")
    println("  persist <key>                remove TTL")
    println("")
    println("Data commands (list):")
    println("  lpush <key> v1 v2...         prepend values")
    println("  rpush <key> v1 v2...         append values")
    println("  lpop <key> [count=1]         pop from head")
    println("  rpop <key> [count=1]         pop from tail")
    println("  lrange <key> <start> <stop>  range (negative index supported)")
    println("  llen <key>                   list length")
    println("")
    println("Data commands (hash):")
    println("  hset <key> <field> <value>   set field")
    println("  hget <key> <field>           get field")
    println("  hgetall <key>                all fields")
    println("  hdel <key> <field>           delete field")
    println("  hlen <key>                   field count")
    println("")
    println("Data commands (set):")
    println("  sadd <key> m1 m2...          add members")
    println("  srem <key> m1 m2...          remove members")
    println("  smembers <key>               all members")
    println("  sismember <key> <m>          member exists?")
    println("  scard <key>                  set cardinality")
    println("")
    println("Data commands (zset):")
    println("  zadd <key> <score> <member>  add scored member")
    println("  zrange <key> <s> <e>         range by score (asc)")
    println("  zscore <key> <member>        member score")
    println("  zcard <key>                  zset cardinality")
    println("  zrem <key> <member>          remove member")
    println("")
    println("Cross-shard commands:")
    println("  keys <pattern>               scatter-gather KEYS (glob: * ?)")
    println("  count                        total key count (scatter-gather)")
    println("  tx <c1> | <c2> | ...         cross-shard 2PC (SET/DEL/INCR)")
    println("")
    println("Operations:")
    println("  fail <nodeId>                simulate node failure (triggers failover)")
    println("  recover <nodeId>             recover failed node")
    println("  raft <shardId>               raft state of a shard")
    println("  eval <line>                  execute Redis-like protocol line")
    println("")
    println("Utility:")
    println("  export <file>                export state to pretty JSON")
    println("  import <file>                import state from JSON")
    println("  reset                        clear all state")
    println("  test                         run built-in test suite")
    println("  bench [ops=1000]             write+read+balance benchmark")
    println("  serve [port=18300]           start HTTP API server")
    println("  help                         this help")
    println("")
    println("Data model: string / list / hash / set / zset, all with TTL.")
    println("Replication: Raft per shard (leader + replicas), linearizable reads.")
    println("State file: xdistdb.state.json (script/exe directory).")
end

func main(...) as int
    if arg.length < 2 then
        printHelp()
        return 1
    end

    string scriptPath = string(arg[0])
    gStateFile = stateFilePath(scriptPath)
    string command = string.lower(string(arg[1]))

    if command == "test" then
        return runTestSuite()
    end

    if command == "help" or command == "-h" or command == "--help" then
        printHelp()
        return 0
    end

    if command == "reset" then
        if file.exists(gStateFile) then
            file.delete(gStateFile)
        end
        gState = {}
        println("OK state cleared (and file removed if existed)")
        return 0
    end

    bool skipLoad = false
    if command == "cluster" and arg.length >= 3 then
        string sub = string.lower(string(arg[2]))
        if sub == "init" then skipLoad = true end
    end
    if not skipLoad then
        loadState(gStateFile)
    end

    int rc = 0

    if command == "cluster" then
        if arg.length < 3 then
            println("Error: cluster requires subcommand (init/add/remove/status/...)")
            println("  try: xdistdb cluster status")
            return 1
        end
        string sub = string.lower(string(arg[2]))
        if sub == "init" then
            int n = DEFAULT_NODES
            if arg.length >= 4 then
                string s = string(arg[3])
                if looksLikeInt(s) then n = int(s) end
            end
            rc = cmdClusterInit(n)
        elseif sub == "add" then
            int port = 0
            if arg.length >= 4 then
                string s = string(arg[3])
                if looksLikeInt(s) then port = int(s) end
            end
            rc = cmdClusterAdd(port)
        elseif sub == "remove" then
            if arg.length < 4 then
                println("Error: cluster remove requires <nodeId>")
                return 1
            end
            rc = cmdClusterRemove(string(arg[3]))
        elseif sub == "status" then
            rc = cmdClusterStatus()
        elseif sub == "ring" then
            rc = cmdClusterRing()
        elseif sub == "nodes" then
            rc = cmdClusterNodes()
        elseif sub == "shards" then
            rc = cmdClusterShards()
        elseif sub == "slots" then
            print(formatClusterSlots())
        elseif sub == "migrate" then
            rc = cmdClusterMigrate()
        elseif sub == "health" then
            rc = cmdClusterHealth()
        elseif sub == "migrations" then
            print(formatMigrations())
        elseif sub == "distribution" then
            print(formatKeyDistribution())
        else
            println("Error: unknown cluster subcommand: " + sub)
            return 1
        end
    elseif command == "set" then
        if arg.length < 4 then
            println("Error: set requires <key> and <value>")
            return 1
        end
        string key = string(arg[2])
        string rawVal = ""
        int vi = 3
        while vi < arg.length do
            if isEmpty(rawVal) then
                rawVal = string(arg[vi])
            else
                rawVal = rawVal + " " + string(arg[vi])
            end
            vi += 1
        end
        rc = cmdSet(key, rawVal)
    elseif command == "get" then
        if arg.length < 3 then
            println("Error: get requires <key>")
            return 1
        end
        rc = cmdGet(string(arg[2]))
    elseif command == "del" or command == "delete" then
        if arg.length < 3 then
            println("Error: del requires <key>")
            return 1
        end
        rc = cmdDel(string(arg[2]))
    elseif command == "exists" then
        if arg.length < 3 then
            println("Error: exists requires <key>")
            return 1
        end
        rc = cmdExists(string(arg[2]))
    elseif command == "type" then
        if arg.length < 3 then
            println("Error: type requires <key>")
            return 1
        end
        rc = cmdType(string(arg[2]))
    elseif command == "incr" then
        if arg.length < 3 then
            println("Error: incr requires <key>")
            return 1
        end
        int delta = 1
        if arg.length >= 4 then
            string s = string(arg[3])
            if looksLikeInt(s) then delta = int(s) end
        end
        rc = cmdIncr(string(arg[2]), delta)
    elseif command == "decr" then
        if arg.length < 3 then
            println("Error: decr requires <key>")
            return 1
        end
        rc = cmdIncr(string(arg[2]), -1)
    elseif command == "expire" then
        if arg.length < 4 then
            println("Error: expire requires <key> <seconds>")
            return 1
        end
        rc = cmdExpire(string(arg[2]), int(string(arg[3])))
    elseif command == "ttl" then
        if arg.length < 3 then
            println("Error: ttl requires <key>")
            return 1
        end
        rc = cmdTtl(string(arg[2]))
    elseif command == "persist" then
        if arg.length < 3 then
            println("Error: persist requires <key>")
            return 1
        end
        rc = cmdPersist(string(arg[2]))
    elseif command == "lpush" or command == "rpush" or command == "lpop" or command == "rpop" or command == "lrange" or command == "llen" then
        if arg.length < 3 then
            println("Error: " + command + " requires <key>")
            return 1
        end
        string key = string(arg[2])
        var args = []
        int ai = 3
        while ai < arg.length do
            args.append(string(arg[ai]))
            ai += 1
        end
        rc = cmdList(command, key, args)
    elseif command == "hset" or command == "hget" or command == "hgetall" or command == "hdel" or command == "hlen" then
        if arg.length < 3 then
            println("Error: " + command + " requires <key>")
            return 1
        end
        string key = string(arg[2])
        var args = []
        int ai = 3
        while ai < arg.length do
            args.append(string(arg[ai]))
            ai += 1
        end
        rc = cmdHash(command, key, args)
    elseif command == "sadd" or command == "srem" or command == "smembers" or command == "sismember" or command == "scard" then
        if arg.length < 3 then
            println("Error: " + command + " requires <key>")
            return 1
        end
        string key = string(arg[2])
        var args = []
        int ai = 3
        while ai < arg.length do
            args.append(string(arg[ai]))
            ai += 1
        end
        rc = cmdSetOp(command, key, args)
    elseif command == "zadd" or command == "zrange" or command == "zscore" or command == "zcard" or command == "zrem" then
        if arg.length < 3 then
            println("Error: " + command + " requires <key>")
            return 1
        end
        string key = string(arg[2])
        var args = []
        int ai = 3
        while ai < arg.length do
            args.append(string(arg[ai]))
            ai += 1
        end
        rc = cmdZset(command, key, args)
    elseif command == "keys" then
        string pat = "*"
        if arg.length >= 3 then pat = string(arg[2]) end
        rc = cmdKeys(pat)
    elseif command == "count" then
        rc = cmdCount()
    elseif command == "fail" then
        if arg.length < 3 then
            println("Error: fail requires <nodeId>")
            return 1
        end
        rc = cmdFail(string(arg[2]))
    elseif command == "recover" then
        if arg.length < 3 then
            println("Error: recover requires <nodeId>")
            return 1
        end
        rc = cmdRecover(string(arg[2]))
    elseif command == "raft" then
        if arg.length < 3 then
            println("Error: raft requires <shardId>")
            return 1
        end
        rc = cmdRaft(string(arg[2]))
    elseif command == "eval" then
        if arg.length < 3 then
            println("Error: eval requires <line>")
            return 1
        end
        string line = ""
        int li = 2
        while li < arg.length do
            if isEmpty(line) then
                line = string(arg[li])
            else
                line = line + " " + string(arg[li])
            end
            li += 1
        end
        rc = cmdEval(line)
    elseif command == "tx" then
        if arg.length < 3 then
            println("Error: tx requires <commands separated by |>")
            return 1
        end
        string txExpr = ""
        int ti = 2
        while ti < arg.length do
            if isEmpty(txExpr) then
                txExpr = string(arg[ti])
            else
                txExpr = txExpr + " " + string(arg[ti])
            end
            ti += 1
        end
        rc = cmdTx(txExpr)
    elseif command == "export" then
        if arg.length < 3 then
            println("Error: export requires <file>")
            return 1
        end
        rc = cmdExport(string(arg[2]))
    elseif command == "import" then
        if arg.length < 3 then
            println("Error: import requires <file>")
            return 1
        end
        rc = cmdImport(string(arg[2]))
    elseif command == "bench" then
        int ops = BENCH_DEFAULT_OPS
        if arg.length >= 3 then
            string s = string(arg[2])
            if looksLikeInt(s) then ops = int(s) end
        end
        rc = cmdBench(ops)
    elseif command == "serve" then
        int port = DEFAULT_HTTP_PORT
        if arg.length >= 3 then
            string s = string(arg[2])
            if looksLikeInt(s) then port = int(s) end
        end
        rc = cmdServe(port)
    else
        println("Error: unknown command '" + command + "'")
        println("  try: xdistdb help")
        return 1
    end

    if command != "serve" and command != "test" and command != "help" then
        saveState(gStateFile)
    end

    return rc
end
