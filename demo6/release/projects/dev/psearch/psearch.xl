// psearch.xl - parallel file content searcher
//
// usage:
//   psearch <pattern> <dir1> [dir2] [dir3] ...
//
// searches file CONTENTS across multiple directories in parallel.
// one async task per directory; task.all waits for all of them.
//
// search one directory recursively for files whose content contains pattern.
// prints each matching file path, returns the match count.
async func searchDir(string directory, string pattern) as int
    if not dir.exists(directory) then
        println("[skip] not a dir: ", directory)
        return 0
    end
    int count = 0
    array<string> paths = dir.files(directory, true)
    for path in paths
        try
            string text = file.readText(path)
            if string.contains(text, pattern) then
                println(path)
                count += 1
            end
        catch e
            // 无法读取的文件不应中断其他目录的搜索。
        end
    end
    return count
end

// run all search tasks in parallel via task.all, print summary, return exit code.
async func runAll(array<string> directories, string pattern, float startSec) as int
    array<future<int>> jobs = array[]
    for directory in directories
        jobs.append(searchDir(directory, pattern))
    end
    array<int> counts = await task.all(jobs)
    int total = 0
    int i = 0
    while i < counts.length
        total += int(counts[i])
        i += 1
    end
    float elapsed = time.timer() - startSec
    int elapsedMs = int(elapsed * 1000.0)
    println("------------------------------------------------------------")
    println("pattern: " + pattern)
    println("dirs:    " + string(directories.length))
    println("matches: " + string(total) + " files")
    println("time:    " + string(elapsedMs) + " ms (parallel via task.all)")
    return 0
end

func main(...) as int
    string pattern = ""
    array<string> directories = array[]

    int i = 1
    while i < arg.length
        string a = string(arg[i])
        if a == "-h" or a == "--help" then
            println("usage: psearch <pattern> <dir1> [dir2] [dir3] ...")
            println("  searches file contents across directories in parallel")
            return 0
        else
            if pattern == "" then
                pattern = a
            else
                directories.append(a)
            end
        end
        i += 1
    end

    if pattern == "" then
        println("psearch: missing pattern")
        println("usage: psearch <pattern> <dir1> [dir2] [dir3] ...")
        return 1
    end
    if directories.length == 0 then
        println("psearch: missing directory")
        println("usage: psearch <pattern> <dir1> [dir2] [dir3] ...")
        return 1
    end

    float startSec = time.timer()
    future<int> f = runAll(directories, pattern, startSec)
    bool ok = f.wait()
    if not ok then
        println("psearch: error:", f.error())
        return 1
    end
    return 0
end
