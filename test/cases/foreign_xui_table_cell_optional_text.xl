import xui
extern "fixtureCellDuringCall" @header("test/cases/foreign_xui_table_cell_optional_text.h") @no_raise @c_sync_callback(1,-1,-16) @c_result("status",0) func duringCall(xui.TableCellOutput cell, func() as c_int visitor)

func main(...) as int
    auto cell = xui.createTableCell()
    assert cell.canRetire()
    duringCall(cell, func() as c_int
        assert not cell.canRetire()
        return 0
    end)
    assert cell.canRetire()
    assert xui.cellText(cell) == null and xui.cellTooltip(cell) == null

    cell.setText("Table cell")
    cell.setTooltip("原生提示")
    assert (xui.cellText(cell) ?? "") == "Table cell"
    assert (xui.cellTooltip(cell) ?? "") == "原生提示"
    assert cell.text() == "Table cell" and cell.tooltip() == "原生提示"

    cell.setText("")
    cell.setTooltip("")
    assert xui.cellText(cell) == null and xui.cellTooltip(cell) == null

    auto observer = cell.watch()
    auto owner = observer.lock()
    assert owner != null and observer.isLive()
    cell.close()
    assert observer.isLive()
    if owner != null then
        owner.close()
    end
    assert not observer.isLive() and observer.lock() == null
    observer.close()

    bool expired = false
    try
        xui.cellText(cell)
    catch StateError
        expired = true
    end
    assert expired
    expired = false
    try
        cell.canRetire()
    catch StateError
        expired = true
    end
    assert expired
    println("TABLE_CELL_OPTIONAL_TEXT_OK")
    return 0
end
