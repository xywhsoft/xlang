class FlowNode
    int value = 19
end

FlowNode? sharedFlowNode = FlowNode()

func guardedValue(FlowNode? node) as int
    if node == null
        return -1
    end
    return node.value
end

func guardedSharedValue() as int
    if sharedFlowNode == null
        return -1
    end
    return sharedFlowNode.value
end

func nestedGuardedValue(FlowNode? node, bool reject) as int
    if node == null
        if reject
            return -1
        else
            return -2
        end
    end
    return node.value
end

func main(...) as int
    int? count = 7
    if count != null then
        int next = count + 1
        assert(next == 8)
    end

    string? text = "hello"
    if text != null and text.length == 5 then
        assert(text.length == 5)
    end

    FlowNode? node = FlowNode()
    if node != null then
        assert(node.value == 19)
    end

    array<int>? values = array[23]
    if values != null then
        assert(values[0] == 23)
    end

    if count == null then
        assert(false)
    else
        assert(count == 7)
    end
    assert(guardedValue(FlowNode()) == 19)
    assert(guardedValue(null) == -1)
    assert(guardedSharedValue() == 19)
    assert(nestedGuardedValue(FlowNode(), false) == 19)
    assert(nestedGuardedValue(null, true) == -1)
    return 0
end
