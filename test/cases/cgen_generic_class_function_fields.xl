extern "expect_i64" func expect(int actual, int expected)

func inc(int value) as int
    return value + 1
end

func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

class Mapper<T>
    func(T) as T op
    T value
end

Mapper<int> direct = Mapper::<int>()
direct.op = inc
direct.value = 10

Mapper<int> copied = direct
expect(copied.op(copied.value), 11)

Mapper<int> closureBox = Mapper::<int>()
closureBox.op = makeAdder(5)
closureBox.value = 20

Mapper<int> reassigned = Mapper::<int>()
reassigned.op = inc
reassigned.value = 1
reassigned = closureBox
reassigned = reassigned
expect(reassigned.op(reassigned.value), 25)

array<Mapper<int>> boxes = array[direct]
boxes[0] = closureBox

Mapper<int> fromArray = boxes[0]
expect(fromArray.op(fromArray.value), 25)

int total = 0
for item in boxes
    total = total + item.op(item.value)
end

expect(total, 25)
