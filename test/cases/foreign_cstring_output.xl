extern "ManagedRoot*" class Root @header("test/cases/foreign_cstring_output.h") @lifetime("owned") @policy("managedRootPolicy") @watch("ManagedWatch") @scope("ManagedScope")
 native point handle
 extern "cstr_seed" @no_raise @c_result("status",0) func seed()
 extern "cstr_read" @no_raise @c_output(2,0) @c_output_view(2,"cstring") func read(c_int mode=0) as string
 extern "cstr_optional" @no_raise @c_output(2,0) @c_output_view(2,"cstring") func optional(c_int mode=0) as string?
 extern "cstr_get" @no_raise @c_output(1,0) @c_output_view(1,"cstring") get label() as string
