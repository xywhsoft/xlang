import xui
from xui import Widget, Vec2, Rect, CallbackVec2, CallbackDrawContext
from xui import CallbackCodeDocument, CallbackConstCodeToken, CallbackInt, WidgetCallbackSnapshot

func main(...) as int
    auto proxy = xui.createProxy()
    auto ui = xui.create(proxy, xui.XUI_SYSTEM_FONT_DISABLED)
    auto source = ui.widget()
    auto target = ui.widget()
    assert source.captureContentMeasureCallback() == null, "an empty slot returns null"

    int calls = 0
    source.setContentMeasureCallback(func(Widget widget, Vec2 constraint, CallbackVec2 result) as c_int
        calls += 1
        result.fX = constraint.fX
        result.fY = 24
        return xui.XUI_OK
    end)
    source.setLayoutPrepareCallback(func(Widget widget) as c_int
        return xui.XUI_OK
    end)
    source.setLayoutChildrenCallback(func(Widget widget, Rect bounds) as c_int
        return xui.XUI_OK
    end)
    source.setLayoutCompleteCallback(func(Widget widget, Rect bounds) as c_int
        return xui.XUI_OK
    end)
    source.setImeCandidateRect(func(Widget widget) as Rect
        return Rect()
    end)
    source.setCursorQueryCallback(func(Widget widget, c_int x, c_int y) as c_int
        return 0
    end)
    source.setCacheRenderCallback(func(Widget widget, CallbackDrawContext draw, c_uint state) as c_int
        return xui.XUI_OK
    end)

    array<WidgetCallbackSnapshot> callbacks = [
        source.captureContentMeasureCallback() as WidgetCallbackSnapshot,
        source.captureLayoutPrepareCallback() as WidgetCallbackSnapshot,
        source.captureLayoutChildrenCallback() as WidgetCallbackSnapshot,
        source.captureLayoutCompleteCallback() as WidgetCallbackSnapshot,
        source.captureImeCandidateRectCallback() as WidgetCallbackSnapshot,
        source.captureCursorQueryCallback() as WidgetCallbackSnapshot,
        source.captureCacheRenderCallback() as WidgetCallbackSnapshot
    ]
    source.close()
    for callback in callbacks
        callback.install(target)
        callback.close()
    end
    Vec2 constraint
    constraint.fX = 81
    auto size = target.measureContent(constraint)
    assert calls == 1 and size.fX == 81 and size.fY == 24, "the target owns the original callback"
    bool closed = false
    try
        callbacks[0].install(target)
    catch StateError
        closed = true
    end
    assert closed, "closed snapshots reject installation"

    auto editor = ui.codeEditNative()
    auto second = ui.codeEditNative()
    editor.setTokenStyleResolver(func(CallbackCodeDocument document, CallbackConstCodeToken token, CallbackInt result) as c_int
        return xui.XUI_OK
    end)
    auto resolver = editor.captureTokenStyleResolver() as WidgetCallbackSnapshot
    editor.close()
    bool wrongType = false
    try
        resolver.install(target)
    catch Error failure
        wrongType = failure.code == xui.XUI_ERROR_INVALID_ARGUMENT
    end
    assert wrongType, "the token resolver requires a CodeEdit target"
    resolver.install(second)
    resolver.close()
    assert second.hasTokenStyleResolver(), "the second editor retains the resolver"
    ui.close()
    proxy.close()
    println("XUI_WIDGET_CALLBACK_SNAPSHOT_OK")
    return 0
end
