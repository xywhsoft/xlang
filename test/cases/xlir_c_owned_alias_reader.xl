extern "c_owned_text" @no_raise func nativeText() as point
extern "c_owned_binary" @no_raise func nativeBytes() as point
extern "c_owned_release" @no_raise func nativeFree(point data)
extern "c_owned_text_is_original" @no_raise func original(string text) as bool
extern "c_owned_binary_span_original" @no_raise func originalBytes(cbytes data) as bool
func make() as cstring
    return cstring.take(nativeText(),nativeFree)
end
func makeBytes() as cbytes
    return cbytes.take(nativeBytes(),4,nativeFree)
end
typedef Blob = bytes
typedef Text = string
typedef MaybeBlob = Blob?
func reader(Blob value) as bool
    return originalBytes(value)
end
func optionalReader(MaybeBlob value) as bool
    return value!=null and originalBytes(value)
end
func optionalText(Text? value) as bool
    return value!=null and original(value)
end
func forward(Text? text,MaybeBlob value) as (Text?,MaybeBlob)
    return text,value
end
func check()
    auto data=makeBytes()
    assert reader(data)
    auto text=make()
    assert optionalReader(data) and optionalText(text)
    auto first,second=forward(text,data)
    assert first!=null and second!=null and original(first) and originalBytes(second)
end
check()
