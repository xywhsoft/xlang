// A real pending await is a cooperative cancellation point. A blocking sleep
// is not: a producer already running synchronous work may finish normally.
extern "race_pending" func pending() as future<int>
extern "race_complete_source" func completeSource(int index) as bool
async func delayed(future<int> source, int value) as int
    return (await source) + value
end

future<int> nativeFirst = pending()
future<int> nativeSecond = pending()
future<int> first = delayed(nativeFirst, 187)
future<int> second = delayed(nativeSecond, 188)
future<int> group = task.race([first, second])
assert task.cancel(first), "first cancellation must be accepted"
// Cancellation is cooperative: readiness lets the suspended producer observe
// its token. Do not require cancel() to manufacture a producer terminal state.
assert completeSource(0), "first native source publication must succeed"

int groupState = 0
try
    int value = await group
    groupState = value
catch e
    println("race group error: ", e.message)
    if e.message == "future cancel requested." then
        groupState = 42
    end
end
println("race group state: ", groupState)
assert groupState == 42, "race must propagate source cancellation"
// Race must have requested the loser's cancellation before publishing group.
// Only now make the loser ready; its producer must observe that prior request.
assert completeSource(1), "late loser source publication must succeed"

int secondState = 0
try
    secondState = await second
catch e
    if e.message == "future cancel requested." then
        secondState = 42
    end
end
assert secondState == 42, "race must cancel its pending loser"

int lateState = 0
try
    lateState = await second
catch e
    if e.message == "future cancel requested." then
        lateState = 42
    end
end
assert lateState == 42, "late completion must not replace loser cancellation"
assert not task.cancel(first), "source cancellation must remain terminal"
println("task race source cancellation: passed")
