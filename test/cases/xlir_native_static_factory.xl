// Static externs have no implicit receiver. Registered native results take
// their field/destructor ABI from the declared class, including free funcs.
class ByteUtility
    native point handle
    static extern "xl6TextByteLengthV1" func lengthOf(string text, int size) as int
end
extern "xl6BufferFromHexV1" func decodeHex(string text, int flags, int size) as Buffer
extern "xl6BufferFromBase64V1" func decodeBase64(string text, int flags, string alphabet, int size, int alphabetSize) as Buffer
assert ByteUtility.lengthOf("a\0你", -1) == 5
assert ByteUtility.lengthOf("a\0你", 2) == 2
Buffer decoded = decodeHex("0041ff", 0, -1)
assert decoded.toBytes() == b"\0A\xff"
assert decodeBase64("AEH/", 0, "", -1, -1).toBytes() == decoded.toBytes()
assert Buffer.fromHex("41").hex() == "41"
println("Static/free native factory ownership ok")
