import xui
from xui import CallbackDrawContext, CallbackWidget, Context, Font, ListView, Proxy, Rect, Surface, Widget

extern "fixtureRenderProxy" @header("test/cases/foreign_xui_render_backend.h") @no_raise @c_result("owned_view") @factory(0,0,dropProxy) func cpuProxy() as Proxy
extern "fixtureRenderSurface" @no_raise @c_result("owned_view") @factory(1,0,dropSurface) func cpuSurface(Proxy proxy) as Surface
extern "fixtureRenderFont" @no_raise @c_result("owned_view") @factory(1,0,dropFont) func cpuFont(Proxy proxy) as Font
extern "fixtureRenderBalanced" @no_raise func balanced() as c_int
extern "fixtureRenderBudget" @no_raise func budget(c_int allowance)
extern "fixtureRenderSawText" @no_raise @c_cstr(0) func sawText(string text) as c_int
extern "fixtureRenderResetText" @no_raise func resetText()
extern "xuiProxyReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropProxy(Proxy value)
extern "xuiSurfaceReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropSurface(Surface value)
extern "xuiFontReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropFont(Font value)

func checkEnabled(ListView list)
    list.setItems(["native label","custom label"])
    array<c_int> flags = [0,0]
    list.setEnabledItems(flags,1)
    assert list.isItemEnabled(0) == 0 and list.isItemEnabled(1) != 0, "the omitted suffix is enabled"
    bool rejected = false
    try
        list.setEnabledItems(flags,-2)
    catch Error
        rejected = true
    end
    assert rejected and list.isItemEnabled(0) == 0
    list.setEnabledItems(flags,0)
    assert list.isItemEnabled(0) != 0 and list.isItemEnabled(1) != 0
end

func checkPainter(Proxy proxy,Context ui,ListView list,Surface target,Rect bounds)
    CallbackDrawContext? saved = null
    int paints = 0
    list.setItemRenderer(func(CallbackWidget sender,c_int index,CallbackDrawContext draw,Rect area,c_int state) as c_int
        assert index >= 0 and index < 2 and area.fW > 0
        paints += 1
        if index == 0 then return 0 end
        saved = draw
        proxy.fillRect(draw,area,c_uint(0x276BAEFF))
        return 1
    end)
    xui.ListViewItemRenderProc replacement = func(CallbackWidget sender,c_int index,CallbackDrawContext draw,Rect area,c_int state) as c_int
        throw RuntimeError "failed registration changed the painter"
    end
    bool failed = false
    budget(0)
    try
        list.setItemRenderer(replacement)
    catch Error
        failed = true
    finally
        budget(-1)
    end
    assert failed
    ui.render(target)
    assert paints == 2 and sawText("native label") != 0 and sawText("custom label") == 0
    bool expired = false
    try
        proxy.fillRect(saved as CallbackDrawContext,bounds,0)
    catch StateError
        expired = true
    end
    assert expired

    list.setItemRenderer(func(CallbackWidget sender,c_int index,CallbackDrawContext draw,Rect area,c_int state) as c_int
        throw RuntimeError "ListView painter failed"
    end)
    bool caught = false
    try
        ui.render(target)
    catch RuntimeError failure
        caught = failure.message == "ListView painter failed"
    end
    assert caught
    list.setItemRenderer(null)
    resetText()
    ui.render(target)
    assert sawText("custom label") != 0, "clearing the painter restores the default appearance"
end

func checkActivate(Context ui,ListView list)
    assert list.setSelected(1) == 0 and ui.setFocusWidget(list) == 0
    int calls = 0
    list.setActivate(func(Widget sender,c_int item,c_int button)
        assert item == 1 and button == xui.XUI_POINTER_BUTTON_LEFT
        calls += 1
        sender.close()
    end)
    assert ui.inputKeyDown(xui.XUI_KEY_ENTER,0) == 0
    assert ui.dispatchPendingEvents() == 0 and calls == 1
    bool closed = false
    try
        list.getItemCount()
    catch StateError
        closed = true
    end
    assert closed
end

func main(...) as int
    auto proxy = cpuProxy()
    auto ui = xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
    auto list = ui.listViewNative()
    auto font = cpuFont(proxy)
    ui.setDefaultFont(font)
    Rect bounds
    bounds.fW = 320
    bounds.fH = 180
    ui.setViewportSize(320,180)
    assert list.setRect(bounds) == 0 and ui.setRootWidget(list) == 0
    checkEnabled(list)
    assert ui.layout() == 0
    auto target = cpuSurface(proxy)
    checkPainter(proxy,ui,list,target,bounds)
    checkActivate(ui,list)
    ui.close()
    target.close()
    font.close()
    proxy.close()
    assert balanced() != 0
    println("XUI_LIST_CALLBACKS_OK")
    return 0
end
