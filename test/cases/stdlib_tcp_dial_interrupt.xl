auto engine = NetEngine(NetEngineOptions().withWorkers(1).withBackend(NetBackend.select))
engine.start()
auto listener = TcpListener(engine, TcpListenOptions(NetAddress.loopback(4, 0)))
auto addresses = NetAddressList([listener.localAddress()])
auto options = TcpDialOptions().withTimeoutMillis(5000)
auto active = CancellationSource()
uint64 due = time.clock() + uint64(10000000)
auto accepted = listener.acceptAsync()
TcpStream client = await tcp.dialAsyncCancel(engine, addresses, active.token)
TcpStream server = await accepted
assert client.state == TcpStreamState.open
assert server.state == TcpStreamState.open
client.abort()
server.abort()
accepted = listener.acceptAsync()
client = await TcpStream.dialAsyncCancel(engine, addresses, options, active.token)
server = await accepted
assert client.state == TcpStreamState.open
client.abort()
server.abort()
accepted = listener.acceptAsync()
client = await TcpStream.dialAsyncUntil(engine, addresses, due)
server = await accepted
assert client.state == TcpStreamState.open
client.abort()
server.abort()
accepted = listener.acceptAsync()
client = await tcp.dialAsyncUntil(engine, addresses, options, due)
server = await accepted
assert client.state == TcpStreamState.open
client.abort()
server.abort()
accepted = listener.acceptAsync()
client = await tcp.dialAsyncUntilCancel(engine, addresses, due, active.token)
server = await accepted
assert client.state == TcpStreamState.open
client.abort()
server.abort()
accepted = listener.acceptAsync()
client = await TcpStream.dialAsyncUntilCancel(engine, addresses, options, due, active.token)
server = await accepted
assert client.state == TcpStreamState.open
client.abort()
server.abort()
auto stopped = CancellationSource()
assert stopped.cancel()
auto resolver = NetResolver()
int cancelled = 0
try
    auto pending = tcp.dialAsyncCancel(engine, resolver, "127.0.0.1", 1234, stopped.token)
    client = await pending
catch CancelledError
    cancelled = cancelled + 1
end
try
    auto pending = TcpStream.dialAsyncCancel(engine, resolver, "127.0.0.1", 1234, options, stopped.token)
    client = await pending
catch CancelledError
    cancelled = cancelled + 1
end
try
    auto pending = tcp.dialAsyncUntilCancel(engine, resolver, "127.0.0.1", 1234, due, stopped.token)
    client = await pending
catch CancelledError
    cancelled = cancelled + 1
end
try
    auto pending = TcpStream.dialAsyncUntilCancel(engine, resolver, "127.0.0.1", 1234, options, due, stopped.token)
    client = await pending
catch CancelledError
    cancelled = cancelled + 1
end
try
    auto pending = tcp.dialAsyncCancel(engine, addresses, stopped.token)
    client = await pending
catch CancelledError
    cancelled = cancelled + 1
end
try
    auto pending = TcpStream.dialAsyncUntilCancel(engine, addresses, options, due, stopped.token)
    client = await pending
catch CancelledError
    cancelled = cancelled + 1
end
assert cancelled == 6
int expired = 0
try
    auto pending = tcp.dialAsyncUntil(engine, resolver, "127.0.0.1", 1234, uint64(0))
    client = await pending
catch TimeoutError
    expired = expired + 1
end
try
    auto pending = TcpStream.dialAsyncUntil(engine, resolver, "127.0.0.1", 1234, options, uint64(0))
    client = await pending
catch TimeoutError
    expired = expired + 1
end
try
    auto pending = tcp.dialAsyncUntil(engine, addresses, uint64(0))
    client = await pending
catch TimeoutError
    expired = expired + 1
end
assert expired == 3
int invalid = 0
try
    auto pending = tcp.dialAsyncUntilCancel(engine, resolver, "a\0b", 1234, options, due, stopped.token)
catch ValueError
    invalid = invalid + 1
end
try
    auto pending = TcpStream.dialAsyncCancel(engine, resolver, "a\0b", 1234, stopped.token)
catch ValueError
    invalid = invalid + 1
end
assert invalid == 2
assert resolver.snapshot().submitted == 0
assert resolver.snapshot().queriesStarted == 0
resolver.close()
assert resolver.wait(5000)
listener.close()
engine.close()
assert engine.wait(5000)
println("public Dial deadlines/cancellation: six direct overloads, no-work host stops, same class; no DNS")
