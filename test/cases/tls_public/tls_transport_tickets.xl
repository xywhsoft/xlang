import concurrent
func makeClient() as TlsClientContext
 auto store=TrustStore()
 assert store.add(Certificate.fromDer(b"\x30\x82\x01\x8c\x30\x82\x01\x33\xa0\x03\x02\x01\x02\x02\x01\x01\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x30\x1c\x31\x1a\x30\x18\x06\x03\x55\x04\x03\x0c\x11\x6f\x66\x66\x6c\x69\x6e\x65\x20\x70\x32\x35\x36\x20\x72\x6f\x6f\x74\x30\x1e\x17\x0d\x32\x30\x30\x31\x30\x31\x30\x30\x30\x30\x30\x30\x5a\x17\x0d\x34\x30\x30\x31\x30\x31\x30\x30\x30\x30\x30\x30\x5a\x30\x1c\x31\x1a\x30\x18\x06\x03\x55\x04\x03\x0c\x11\x6f\x66\x66\x6c\x69\x6e\x65\x20\x70\x32\x35\x36\x20\x72\x6f\x6f\x74\x30\x59\x30\x13\x06\x07\x2a\x86\x48\xce\x3d\x02\x01\x06\x08\x2a\x86\x48\xce\x3d\x03\x01\x07\x03\x42\x00\x04\x60\xfe\xd4\xba\x25\x5a\x9d\x31\xc9\x61\xeb\x74\xc6\x35\x6d\x68\xc0\x49\xb8\x92\x3b\x61\xfa\x6c\xe6\x69\x62\x2e\x60\xf2\x9f\xb6\x79\x03\xfe\x10\x08\xb8\xbc\x99\xa4\x1a\xe9\xe9\x56\x28\xbc\x64\xf2\xf1\xb2\x0c\x2d\x7e\x9f\x51\x77\xa3\xc2\x94\xd4\x46\x22\x99\xa3\x66\x30\x64\x30\x12\x06\x03\x55\x1d\x13\x01\x01\xff\x04\x08\x30\x06\x01\x01\xff\x02\x01\x02\x30\x1d\x06\x03\x55\x1d\x0e\x04\x16\x04\x14\x1a\x95\x69\x57\x9b\xce\x32\x9a\x94\x2d\x07\x69\xc9\xc0\xb5\x64\x31\x56\x37\x10\x30\x1f\x06\x03\x55\x1d\x23\x04\x18\x30\x16\x80\x14\x1a\x95\x69\x57\x9b\xce\x32\x9a\x94\x2d\x07\x69\xc9\xc0\xb5\x64\x31\x56\x37\x10\x30\x0e\x06\x03\x55\x1d\x0f\x01\x01\xff\x04\x04\x03\x02\x01\x86\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x03\x47\x00\x30\x44\x02\x20\x51\x0c\x6b\xfa\x4a\x5a\x52\xa7\x47\x57\x25\xc3\x88\x1f\x31\x5e\x6d\xac\x3f\x80\x4a\xad\x05\x35\xd4\xe6\x73\x4b\xeb\x84\x1e\x26\x02\x20\x67\x8d\x92\x12\xd6\x2e\x5c\xa4\x9f\xcf\xea\x1c\x8f\x6a\xf1\xec\xe6\x76\xbf\x5c\x42\x87\x13\x0b\x5d\x1e\xdf\x52\xf4\x78\xcf\x67"))
 auto verifier=TlsVerifier(store.snapshot(),TlsVerificationPolicy().withTime(time.fromUnixMs(1893456000000)))
 return TlsClientContext(verifier)
end
func makeServer() as TlsServerContext
 array<Certificate> chain=[Certificate.fromDer(b"\x30\x82\x01\xba\x30\x82\x01\x5f\xa0\x03\x02\x01\x02\x02\x01\x03\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x30\x24\x31\x22\x30\x20\x06\x03\x55\x04\x03\x0c\x19\x6f\x66\x66\x6c\x69\x6e\x65\x20\x70\x32\x35\x36\x20\x69\x6e\x74\x65\x72\x6d\x65\x64\x69\x61\x74\x65\x30\x1e\x17\x0d\x32\x30\x30\x31\x30\x31\x30\x30\x30\x30\x30\x30\x5a\x17\x0d\x34\x30\x30\x31\x30\x31\x30\x30\x30\x30\x30\x30\x5a\x30\x19\x31\x17\x30\x15\x06\x03\x55\x04\x03\x0c\x0e\x6f\x66\x66\x6c\x69\x6e\x65\x20\x74\x61\x72\x67\x65\x74\x30\x59\x30\x13\x06\x07\x2a\x86\x48\xce\x3d\x02\x01\x06\x08\x2a\x86\x48\xce\x3d\x03\x01\x07\x03\x42\x00\x04\x60\xfe\xd4\xba\x25\x5a\x9d\x31\xc9\x61\xeb\x74\xc6\x35\x6d\x68\xc0\x49\xb8\x92\x3b\x61\xfa\x6c\xe6\x69\x62\x2e\x60\xf2\x9f\xb6\x79\x03\xfe\x10\x08\xb8\xbc\x99\xa4\x1a\xe9\xe9\x56\x28\xbc\x64\xf2\xf1\xb2\x0c\x2d\x7e\x9f\x51\x77\xa3\xc2\x94\xd4\x46\x22\x99\xa3\x81\x8c\x30\x81\x89\x30\x0c\x06\x03\x55\x1d\x13\x01\x01\xff\x04\x02\x30\x00\x30\x1d\x06\x03\x55\x1d\x0e\x04\x16\x04\x14\x1a\x95\x69\x57\x9b\xce\x32\x9a\x94\x2d\x07\x69\xc9\xc0\xb5\x64\x31\x56\x37\x10\x30\x1f\x06\x03\x55\x1d\x23\x04\x18\x30\x16\x80\x14\x1a\x95\x69\x57\x9b\xce\x32\x9a\x94\x2d\x07\x69\xc9\xc0\xb5\x64\x31\x56\x37\x10\x30\x0e\x06\x03\x55\x1d\x0f\x01\x01\xff\x04\x04\x03\x02\x07\x80\x30\x14\x06\x03\x55\x1d\x11\x04\x0d\x30\x0b\x82\x09\x6c\x6f\x63\x61\x6c\x68\x6f\x73\x74\x30\x13\x06\x03\x55\x1d\x25\x04\x0c\x30\x0a\x06\x08\x2b\x06\x01\x05\x05\x07\x03\x01\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x03\x49\x00\x30\x46\x02\x21\x00\x84\xdd\x76\x2e\x02\xe5\x83\x3c\xa0\x8c\xbf\x6f\x4d\x13\x1f\x91\x20\x10\x07\x8b\x1b\x9a\xc1\x75\x33\x62\x88\xab\x18\x79\x7b\xc8\x02\x21\x00\xed\xed\x2f\x0b\x4b\x85\xe2\x47\x42\xcb\x77\x04\xa4\x5f\x36\xad\x3b\x23\x65\xad\x15\xad\xd4\x5a\xdb\x87\xce\x5e\xba\x3b\xc2\x9f"),Certificate.fromDer(b"\x30\x82\x01\x95\x30\x82\x01\x3b\xa0\x03\x02\x01\x02\x02\x01\x02\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x30\x1c\x31\x1a\x30\x18\x06\x