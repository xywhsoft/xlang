// Ordinary immutable configuration changes, not a policy-bypass/security test.
class ResumeRebindState
    int calls = 0
    TlsResumeRequest? saved = null
end

func transferRebind(TlsSession source, TlsSession destination)
    while source.pendingCipher > 0
        assert destination.feed(source.takeCipher(317)) == TlsResult.ok
    end
end

func runRebindPair(TlsClientContext context, TlsServerContext serverContext, bool resumed)
    auto client = TlsSession(context, "localhost")
    auto server = TlsSession(serverContext)
    int rounds = 0
    while not client.ready or not server.ready
        auto left = client.drive()
        assert left == TlsResult.ok or left == TlsResult.wouldBlock
        transferRebind(client, server)
        auto right = server.drive()
        assert right == TlsResult.ok or right == TlsResult.wouldBlock
        transferRebind(server, client)
        rounds += 1
        assert rounds < 256
    end
    assert client.resumed == resumed and server.resumed == resumed
    assert client.protocol == b"h2" and server.protocol == b"h2"
    if not resumed then assert client.peerCertificateCount == 2 end
    auto sent, size = client.write(b"a\0b")
    assert sent == TlsResult.ok and size == uint64(3)
    transferRebind(client, server)
    auto progress = server.drive()
    assert progress == TlsResult.ok or progress == TlsResult.wouldBlock
    auto received, data = server.read()
    assert received == TlsResult.ok and data == b"a\0b"
    client.dispose()
    server.dispose()
end

auto credential = TlsResume.fromParts(TlsVersion.v13, TlsCipherSuite.aes128GcmSha256,
    b"rebind\0ticket", b"01234567890123456789012345678901", time.now(), 300,
    uint64(1), "localhost", b"h2")
auto state = ResumeRebindState()
auto originalServer = makeServer().withProtocols([b"h2"], true)
auto resumeIdentity = originalServer.identity
credential = credential.withPeerCertificates([resumeIdentity.at(0), resumeIdentity.at(1)])
auto server = originalServer.withResumeLookup(func(TlsResumeRequest request) as TlsResume?
    state.calls += 1
    state.saved = request
    assert request.ticket == b"rebind\0ticket" and request.serverName == b"localhost"
    assert request.protocolCount == 1 and request.protocolAt(0) == b"h2"
    return credential
end)
auto original = makeClient().withProtocols([b"h2"]).withTicketCapacity(1).withRequiredResume(credential)
auto preserved = original.withParameters(original.parameters).withProtocols([b"h2"]).withTicketCapacity(2)
assert original.resumeRequired and preserved.resumeRequired and preserved.hasResume
assert original.ticketCapacity == 1 and preserved.ticketCapacity == 2
runRebindPair(preserved, server, true)
assert state.calls == 1

// Even the same verifier is an explicit trust rebind and clears credentials.
auto rebound = preserved.withVerifier(preserved.verifier)
assert not rebound.hasResume and not rebound.resumeRequired and rebound.resume == null
assert rebound.ticketCapacity == 2 and rebound.protocolCount == 1
runRebindPair(rebound, server, false)
assert state.calls == 1

// A newly constructed verifier follows the same rule; old snapshots stay intact.
auto replaced = preserved.withVerifier(makeClient().verifier)
runRebindPair(replaced, server, false)
assert not replaced.hasResume and not replaced.resumeRequired and state.calls == 1
assert preserved.hasResume and preserved.resumeRequired
runRebindPair(preserved, server, true)
assert state.calls == 2

auto cleared = original.withoutResume()
assert not cleared.hasResume and not cleared.resumeRequired and cleared.ticketCapacity == 1
runRebindPair(cleared, server, false)
assert state.calls == 2
assert (state.saved as TlsResumeRequest).ticket == b"rebind\0ticket"
println("TLS trust rebind: two real resumed and three full verified sessions; old immutable snapshots and owned lookup requests survive")
