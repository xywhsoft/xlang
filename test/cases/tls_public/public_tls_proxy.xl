async func connectOwnedProxy(int mode, NetEngine engine, NetResolver resolver, NetProxy proxy, TlsDialOptions options, int port, CancellationToken parent) as TlsStream
    uint64 due = time.clock() + uint64(300000000)
    if mode == 0 then return await TlsStream.dialProxyAsync(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), 9) end
    if mode == 1 then return await TlsStream.dialProxyAsyncCancel(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), 9, parent) end
    if mode == 2 then return await TlsStream.dialProxyAsyncUntil(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), 9, due) end
    if mode == 3 then return await TlsStream.dialProxyAsyncUntilCancel(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), 9, due, parent) end
    if mode == 4 then return await TlsStream.dialProxyAsyncTimeout(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), 9, 10000) end
    if mode == 5 then return await TlsStream.dialProxyAsyncTimeoutCancel(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), 9, parent, 10000) end
    if mode == 6 then return TlsStream.dialProxy(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), 9, 10000) end
    if mode == 7 then return TlsStream.dialProxyCancel(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), 9, parent, 10000) end
    if mode == 8 then return TlsStream.dialProxyUntil(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), 9, due) end
    if mode == 9 then return TlsStream.dialProxyUntilCancel(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), 9, due, parent) end
    if mode == 10 then return await TlsStream.dialProxyAsync(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), options, 9) end
    if mode == 11 then return await TlsStream.dialProxyAsyncCancel(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), options, 9, parent) end
    if mode == 12 then return await TlsStream.dialProxyAsyncUntil(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), options, 9, due) end
    if mode == 13 then return await TlsStream.dialProxyAsyncUntilCancel(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), options, 9, due, parent) end
    if mode == 14 then return await TlsStream.dialProxyAsyncTimeout(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), options, 9, 10000) end
    if mode == 15 then return await TlsStream.dialProxyAsyncTimeoutCancel(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), options, 9, parent, 10000) end
    if mode == 16 then return TlsStream.dialProxy(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), options, 9, 10000) end
    if mode == 17 then return TlsStream.dialProxyCancel(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), options, 9, parent, 10000) end
    if mode == 18 then return TlsStream.dialProxyUntil(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), options, 9, due) end
    if mode == 19 then return TlsStream.dialProxyUntilCancel(engine, resolver, proxy, "localhost\0ignored", port, clientContext(), options, 9, due, parent) end
    throw RangeError "unknown owned proxy overload"
end

// Every actual connection uses endpoints constructed by this program.
async func proxyCopy(TcpStream input, TcpStream output) as bool
    while true
        bytes chunk = await input.recvAsync(16384)
        if chunk.length == 0 then return true end
        assert output.send(chunk) == NetStatus.ok
    end
end

async func serveOwnedProxy(NetEngine engine, TcpListener listener, NetAddress upstream) as bool
    auto incoming = await listener.acceptAsync()
    auto authority = "localhost:" + string(upstream.port)
    bytes expected = Buffer("CONNECT " + authority + " HTTP/1.1\r\nHost: " + authority + "\r\n\r\n").toBytes()
    bytes request = b""
    while request.length < expected.length
        bytes part = await incoming.recvAsync(expected.length - request.length)
        assert part.length > 0
        request = request + part
    end
    assert request == expected
    auto outgoing = await tcp.connectAsync(engine, upstream)
    assert incoming.send(b"HTTP/1.1 200 Connection Established\r\n\r\n") == NetStatus.ok
    auto forward = proxyCopy(incoming, outgoing)
    auto reverse = proxyCopy(outgoing, incoming)
    assert await forward and await reverse
    incoming.close()
    outgoing.close()
    return true
end

async func tlsProxyRead(TlsStream stream, int size) as bytes
    bytes result = b""
    while result.length < size
        bytes part = await stream.recvAsyncTimeout(size - result.length, 10000)
        assert part.length > 0
        result = result + part
    end
    return result
end

async func exerciseOwnedProxy(NetEngine engine, NetResolver resolver)
    auto server = TlsServer(engine, TcpListenOptions(NetAddress.loopback()), serverContext())
    auto proxyListener = TcpListener(engine, TcpListenOptions(NetAddress.loopback()))
    auto proxy = NetProxy(NetProxyType.httpConnect, "127.0.0.1", proxyListener.localAddress().port)
    auto options = TlsDialOptions().withServerNameFromHost(false).withServerName("localhost").withVerifyName("localhost").withTimeoutMillis(10000)
    auto cancellation = CancellationSource()
    int mode = 0
    while mode < 20
        auto accepted = server.acceptAsyncTimeout(10000)
        auto relay = serveOwnedProxy(engine, proxyListener, server.local())
        auto client = await connectOwnedProxy(mode, engine, resolver, proxy, options, server.local().port, cancellation.token)
        auto peer = await accepted
        assert (await client.infoAsync()).ready and (await peer.infoAsync()).ready
        assert await client.sendAsync(b"a\0b") == 3
        assert await tlsProxyRead(peer, 3) == b"a\0b"
        assert await peer.sendAsync(b"x\0y") == 3
        assert await tlsProxyRead(client, 3) == b"x\0y"
        client.close()
        peer.close()
        assert relay.waitTimeout(10000)
        assert await relay
        mode += 1
    end
    proxyListener.close()
    server.close()
end

auto engine = NetEngine(NetEngineOptions().withWorkers(2).withBackend(NetBackend.select))
auto resolver = NetResolver()
engine.start()
await exerciseOwnedProxy(engine, resolver)
resolver.close()
assert resolver.wait(10000)
engine.close()
assert engine.wait(10000)
println("TLS owned proxy: twenty sync/async/deadline/cancel overloads, own CONNECT and TLS endpoints, duplex NUL and checked retirement")
