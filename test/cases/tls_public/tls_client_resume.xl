 auto identity=TlsIdentity.fromP256(chain,P256Key(b"\xc9\xaf\xa9\xd8\x45\xba\x75\x16\x6b\x5c\x21\x57\x67\xb1\xd6\x93\x4e\x50\xc3\xdb\x36\xe8\x9b\x12\x7b\x8a\x62\x2b\x12\x0f\x67\x21"))
 return TlsServerContext(identity)
end

class ResumeLookupState
 TlsServerContext? context=null
 TlsResumeRequest? saved=null
 int calls=0
end
func makeLookup(int mode,ResumeLookupState state) as TlsServerContext
 auto original=makeServer()
 auto issued=time.now()
 auto callback=func(TlsResumeRequest request) as TlsResume?
  state.calls+=1
  state.saved=request
  assert request.serverName == b"localhost" and request.protocolCount == 2
  assert request.protocolAt(0) == b"h2" and request.protocolAt(1) == b"x\0\xff"
  assert request.ticket == b"ticket\0\xff" and request.age <= uint64(4294967295)
  auto detached=request.ticket
  detached[0]=65
  assert request.ticket == b"ticket\0\xff"
  if mode == 1
   return null
  end
  if mode == 2
   throw RangeError("ordinary resume lookup failure")
  end
  return TlsResume.fromParts(TlsVersion.v13,TlsCipherSuite.aes128GcmSha256,
   b"ticket\0\xff",b"01234567890123456789012345678901",issued,120,
   uint64(1),"localhost",b"h2")
 end
 auto context=original.withResumeLookup(callback)
 assert context.hasResumeLookup and context.resumeAgeToleranceMillis == uint64(10000)
 assert not original.hasResumeLookup and not context.withoutResumeLookup().hasResumeLookup
 auto selector=func(TlsServerRequest request) as TlsServerChoice?
  return TlsServerChoice(original.identity)
 end
 context=context.withParameters(original.parameters).withIdentity(original.identity).withProtocols([b"h2",b"x\0\xff"],true).withSelector(selector)
 assert context.hasResumeLookup and context.hasSelector and context.requiresProtocol
 assert context.resumeAgeToleranceMillis == uint64(10000)
 auto strict=original.withResumeLookup(callback,uint64(0))
 assert strict.resumeAgeToleranceMillis == uint64(0)
 int caught=0
 try
  auto invalid=original.withResumeLookup(callback,uint64(4294967296))
 catch RangeError expected
  caught+=1
 end
 assert caught == 1
 state.context=context
 return context
end
export func tls_resume_lookup_context(int mode) as TlsServerContext
 return makeLookup(mode,ResumeLookupState())
end
export func tls_resume_lookup_client() as TlsClientContext
 return makeClient().withProtocols([b"h2",b"x\0\xff"])
end


func resumeClient() as TlsClientContext
 auto credential=TlsResume.fromParts(TlsVersion.v13,TlsCipherSuite.aes128GcmSha256,
  b"ticket\0\xff",b"01234567890123456789012345678901",time.now(),120,
  uint64(1),"localhost",b"h2")
 auto identity=makeServer().identity
 credential=credential.withPeerCertificates([identity.at(0),identity.at(1)])
 return makeClient().withProtocols([b"h2",b"x\0\xff"]).withResume(credential)
end
func transfer(TlsSession source,TlsSession target)
 while source.pendingCipher > 0
  assert target.feed(source.takeCipher(317)) == TlsResult.ok
 end
end
func handshake(TlsSession client,TlsSession server,bool resumed)
 assert not client.resumed and not server.resumed
 int rounds=0
 while not client.ready or not server.ready
  auto a=client.drive()
  assert a == TlsResult.ok or a == TlsResult.wouldBlock
  transfer(client,server)
  auto b=server.drive()
  assert b == TlsResult.ok or b == TlsResult.wouldBlock
  transfer(server,client)
  rounds+=1
  assert rounds < 256
 end
 assert client.resumed == resumed and server.resumed == resumed
 client.dispose()
 server.dispose()
end

auto plain=makeClient()
assert not plain.hasResume and plain.resume == null
auto bound=resumeClient()
assert bound.hasResume
auto credential=bound.resume as TlsResume
assert credential.ticket == b"ticket\0\xff"
auto secret=credential.exportSecret()
secret[0]=65
assert (bound.resume as TlsResume).exportSecret() == b"01234567890123456789012345678901"
auto copied=bound.withParameters(TlsParameters()).withProtocols([b"h2",b"x\0\xff"])
assert copied.hasResume and (copied.resume as TlsResume).ticket == b"ticket\0\xff"
auto cleared=copied.withoutResume()
assert not cleared.hasResume and cleared.resume == null and copied.hasResume
auto newTrust=copied.withVerifier(copied.verifier)
assert not newTrust.hasResume and newTrust.resume == null
handshake(TlsSession(copied,"localhost"),TlsSession(tls_resume_lookup_context(0)),true)
handshake(TlsSession(copied,"localhost"),TlsSession(tls_resume_lookup_context(1)),false)
handshake(TlsSession(cleared,"localhost"),TlsSession(makeServer().withProtocols([b"h2",b"x\0\xff"],true)),false)
println("TLS client resume: independent immutable credential, clone/clear/trust rebind, hit/miss/full verified handshakes: ok")
