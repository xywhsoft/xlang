array<uint64> sizes = [uint64(0), uint64(125), uint64(126), uint64(65535), uint64(65536)]
int index = 0
while index < sizes.length
    auto size = sizes[index]
    auto frame = WsFrame.make(WsOpcode.binary, size)
    auto wire = frame.toBytes()
    auto parsed = WsFrame.parse(wire)
    if parsed == null then throw ValueError "incomplete ordinary frame header" end
    assert parsed.payloadSize == size and parsed.opcode == WsOpcode.binary
    assert parsed.headerSize == wire.length
    index = index + 1
end
assert WsClose.make().toBytes().length == 0
auto empty = WsClose.parse(b"")
assert empty.code == 0 and empty.reason == ""
println("stdlib websocket core ok")
