// Policy metadata only; no certificate parsing, network traffic or security tests.
time at=time(1893456000000000)
auto policy=X509PathPolicy(at,X509PathFlags.requireKeyUsage | X509PathFlags.requirePurpose,
    X509KeyUsageFlags.digitalSignature,"1.3.6.1.5.5.7.3.1",12,4096)
assert policy.at == at
assert policy.flags == (X509PathFlags.requireKeyUsage | X509PathFlags.requirePurpose)
assert policy.keyUsage == X509KeyUsageFlags.digitalSignature
assert policy.purpose == "1.3.6.1.5.5.7.3.1"
assert policy.maxCertificates == 12 and policy.maxBytes == 4096
assert policy.maxSearchSteps == 100000
auto plain=X509PathPolicy(at)
assert plain.purpose == "" and plain.flags == X509PathFlags.none
println("X509 immutable path policy values: ok")
