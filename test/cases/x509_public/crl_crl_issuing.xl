// Offline valid public fixtures; ordinary ownership/API checks, no network traffic.
auto point=X509IssuingDistributionPoint.fromDer(b"\x30\x30\xa0\x24\xa0\x22\x86\x20\x68\x74\x74\x70\x73\x3a\x2f\x2f\x63\x72\x6c\x2e\x65\x78\x61\x6d\x70\x6c\x65\x2e\x69\x6e\x76\x61\x6c\x69\x64\x2f\x66\x75\x6c\x6c\x81\x01\xff\x83\x02\x06\x40\x84\x01\xff")
assert point.toDer() == b"\x30\x30\xa0\x24\xa0\x22\x86\x20\x68\x74\x74\x70\x73\x3a\x2f\x2f\x63\x72\x6c\x2e\x65\x78\x61\x6d\x70\x6c\x65\x2e\x69\x6e\x76\x61\x6c\x69\x64\x2f\x66\x75\x6c\x6c\x81\x01\xff\x83\x02\x06\x40\x84\x01\xff"
assert point.hasDistributionPoint and point.nameKind == X509DistributionNameKind.fullName
assert point.nameDer == b"\xa0\x22\x86\x20\x68\x74\x74\x70\x73\x3a\x2f\x2f\x63\x72\x6c\x2e\x65\x78\x61\x6d\x70\x6c\x65\x2e\x69\x6e\x76\x61\x6c\x69\x64\x2f\x66\x75\x6c\x6c"
assert point.onlyUserCertificates and not point.onlyCaCertificates and not point.onlyAttributeCertificates
assert point.indirect and point.hasReasons and point.reasons == X509ReasonFlags.keyCompromise
auto names=point.fullNames()
assert names != null
if names != null
 assert names.toDer() == b"\x30\x22\x86\x20\x68\x74\x74\x70\x73\x3a\x2f\x2f\x63\x72\x6c\x2e\x65\x78\x61\x6d\x70\x6c\x65\x2e\x69\x6e\x76\x61\x6c\x69\x64\x2f\x66\x75\x6c\x6c"
end
auto relative=X509IssuingDistributionPoint.fromDer(b"\x30\x1c\xa0\x17\xa1\x15\x30\x13\x06\x03\x55\x04\x03\x0c\x0c\x72\x65\x6c\x61\x74\x69\x76\x65\x20\x43\x52\x4c\x82\x01\xff")
assert relative.nameKind == X509DistributionNameKind.relativeName and relative.onlyCaCertificates and not relative.indirect
assert relative.relativeNameDer() == b"\x31\x15\x30\x13\x06\x03\x55\x04\x03\x0c\x0c\x72\x65\x6c\x61\x74\x69\x76\x65\x20\x43\x52\x4c"
assert relative.fullNames() == null and not relative.hasReasons
auto indirect=X509IssuingDistributionPoint.fromDer(b"\x30\x03\x84\x01\xff")
assert indirect.indirect and not indirect.hasDistributionPoint and indirect.nameDer == b"" and indirect.fullNames() == null
assert indirect.reasons == X509ReasonFlags.none
auto attribute=X509IssuingDistributionPoint.fromDer(b"\x30\x03\x85\x01\xff")
assert attribute.onlyAttributeCertificates
