string path = "build/test/fs-metadata-times.bin"
assert file.writeBytes(path, b"a\0b")
int accessed = int(time.fromUnixMs(1700000000000))
int modified = int(time.fromUnixMs(1700000001000))
assert file.setTimes(path, accessed, modified)
assert time.year(file.accessTime(path)) == 2023
assert time.year(file.changeTime(path)) == 2023
auto snapshot = file.stat(path)
assert snapshot.accessed == accessed and snapshot.modified == modified
assert file.delete(path)
for operation in range(3)
    bool refused = false
    try
        if operation == 0 then
            auto result = file.accessTime(path)
        elseif operation == 1 then
            auto result = file.changeTime(path)
        else
            auto result = file.accessTime("a\0b")
        end
    catch e
        refused = true
    end
    assert refused, "failed metadata queries must not return the Unix epoch"
end
println("filesystem time metadata ok")
