string binaryPath = "build/test/stdlib_file_bytes_only.bin"

bytes bytes = b"\0A"
assert file.writeBytes(binaryPath, bytes)

bytes suffix = b"B"
assert file.appendBytes(binaryPath, suffix)

bytes result = file.readBytes(binaryPath)
assert result.length == 3
assert result[0] == 0
assert result[1] == 65
assert result[2] == 66

println("file byte bridge only ok")
assert file.delete(binaryPath)
