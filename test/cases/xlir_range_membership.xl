extern "expect_i64" func expect(int actual, int expected)

expect(3 in range(5), 1)
expect(5 in range(5), 0)
expect(5 in range(1, 10), 1)
expect(10 in range(1, 10), 0)
expect(5 in range(1, 10, 2), 1)
expect(4 in range(1, 10, 2), 0)
expect(5 in range(10, 0, -1), 1)
expect(0 in range(10, 0, -1), 0)
expect(-3 in range(-5, 6, 2), 1)
expect(-2 in range(-5, 6, 2), 0)
int zeroStep = 0
expect(1 in range(1, 5, zeroStep), 0)
