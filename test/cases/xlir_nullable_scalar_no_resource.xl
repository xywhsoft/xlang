func unchanged(int? value) as int?
    return value
end
func main(...) as int
    int? value = null
    assert(unchanged(value) == null)
    value = 73
    int? copied = unchanged(value)
    assert(copied != null and copied == 73)
    assert(copied == value and not (copied != value))
    int? absentA = null
    int? absentB = null
    assert(absentA == absentB and absentA != copied)
    return 0
end
