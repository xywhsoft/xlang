bytes key = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f"
assert key.length == 16
assert siphash.hash64(b"", key) == uint64(0x726fdb47dd0e0e31)
assert siphash.hash64(b"\x00", key) == uint64(0x74f839c593dc67fd)
assert siphash.hash64(b"\x00\x01\x02\x03\x04\x05\x06\x07", key) == uint64(0x93f5f5799a932462)
assert siphash.hash64(b"\x00\x01\x02\x03\x04\x05\x06\x07\x08", key) == uint64(0x9e0082df0ba9e4b0)
assert siphash.hash64(b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f", key) == uint64(0x3f2acc7f57c29bdb)
assert siphash.hash64("", key) == uint64(0x726fdb47dd0e0e31)

string text = "A\0你"
bytes binary = b"A\x00你"
Buffer buffer = Buffer()
assert buffer.appendByte(65)
assert buffer.appendByte(0)
assert buffer.appendByte(228)
assert buffer.appendByte(189)
assert buffer.appendByte(160)
assert siphash.hash64(text, key) == siphash.hash64(binary, key)
assert siphash.hash64Buffer(buffer, key) == siphash.hash64(text, key)
assert siphash.hash64(binary, key, 2) == siphash.hash64("A\0", key)
assert siphash.hash64Buffer(buffer, key, 100) == siphash.hash64(text, key)
assert siphash.hash64(text, key, 0) == siphash.hash64("", key)

bool badKey = false
try
    siphash.hash64("data", b"short")
catch e
    badKey = e.kind == "ValueError"
end
assert badKey
bool badSize = false
try
    siphash.hash64("data", key, -2)
catch e
    badSize = e.kind == "RangeError"
end
assert badSize

auto hasher = siphash.hasher(key)
assert hasher.inputBytes() == uint64(0)
hasher.update("A\0")
hasher.update(b"你")
assert hasher.inputBytes() == uint64(5)
assert hasher.digest() == siphash.hash64(text, key)

auto blockSplit = siphash.hasher(key)
blockSplit.update(b"\x00\x01\x02\x03\x04\x05\x06\x07")
blockSplit.update(b"\x08")
assert blockSplit.digest() == uint64(0x9e0082df0ba9e4b0)
assert hasher.digest() == siphash.hash64(text, key)
auto branch = hasher.clone()
branch.update(b"!")
assert branch.digest() == siphash.hash64(b"A\x00你!", key)
assert hasher.digest() == siphash.hash64(text, key)
hasher.reset()
assert hasher.inputBytes() == uint64(0)
hasher.updateBuffer(buffer)
assert hasher.digest() == siphash.hash64(text, key)

bool badUpdate = false
try
    hasher.update("x", -2)
catch e
    badUpdate = e.kind == "RangeError"
end
assert badUpdate
assert hasher.digest() == siphash.hash64(text, key)

bool rejectedNullHandle = false
try
    auto invalid = SipHasher64(point(null))
    invalid.digest()
catch e
    rejectedNullHandle = e.kind == "RuntimeError"
end
assert rejectedNullHandle
