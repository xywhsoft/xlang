import xui
from xui import CallbackWidget,CallbackInt

extern "fixtureDiagnosticBudget" @header("test/cases/foreign_xui_codeedit_diagnostics_heap.h") @no_raise func budget(c_int allowance)
extern "fixtureCodeEditCommandKey" @header("test/cases/foreign_xui_codeedit_command_dispatch.h") @no_raise @c_result("status",0) func keyDown(xui.Context context,xui.CodeEdit editor,c_int key,c_uint modifiers)

class CommandFlags
 bool enabled=false
 bool reenter=false
 bool fail=false
end

func exercise(xui.Context context,xui.CodeEdit editor)
 c_int custom=xui.XUI_CODE_COMMAND_USER_BASE
 c_uint modifiers=c_uint(xui.XUI_MOD_CTRL)
 auto document=editor.document()
 auto keys=editor.commandMap()
 keys.bind(xui.XUI_KEY_F2,modifiers,custom)
 assert keys.find(xui.XUI_KEY_F2,modifiers)==custom
 auto provided,allowed=editor.queryCommandEnabled(custom)
 assert not provided and not allowed and not editor.executeCommand(custom)

 int handledCount=0
 auto flags=CommandFlags()
 bool blocked=false
 CallbackInt? saved=null
 editor.setCommandProvider(func(CallbackWidget widget,c_int command,CallbackInt handled) as c_int
  if command!=custom then return xui.XUI_ERROR_UNSUPPORTED end
  if flags.fail then throw RuntimeError "command provider failure" end
  document.insert(document.getLength(),"x")
  handled.value=1
  saved=handled
  handledCount+=1
  return xui.XUI_OK
 end)
 editor.setCommandEnabledProvider(func(CallbackWidget widget,c_int command,CallbackInt enabled) as c_int
  if command!=custom then return xui.XUI_ERROR_UNSUPPORTED end
  if flags.reenter then
   try
    editor.executeCommand(custom)
   catch Error failure
    blocked=failure.code==xui.XUI_ERROR_BUSY
   end
  end
  if flags.enabled then enabled.value=1 else enabled.value=0 end
  return xui.XUI_OK
 end)
 provided,allowed=editor.queryCommandEnabled(custom)
 assert provided and not allowed and not editor.executeCommand(custom)
 keyDown(context,editor,xui.XUI_KEY_F2,modifiers)
 context.dispatchCommand(editor,custom,"custom")
 assert context.dispatchPendingEvents()==xui.XUI_OK
 assert handledCount==0 and document.getText()==""

 flags.enabled=true
 flags.reenter=true
 provided,allowed=editor.queryCommandEnabled(custom)
 assert provided and allowed and blocked
 flags.reenter=false
 keyDown(context,editor,xui.XUI_KEY_F2,modifiers)
 assert editor.executeCommand(custom)
 context.dispatchCommand(editor,custom,"custom")
 assert context.dispatchPendingEvents()==xui.XUI_OK
 assert handledCount==3 and document.getText()=="xxx"
 assert editor.executeCommand(xui.XUI_CODE_COMMAND_SELECT_ALL)
 auto start,finish=editor.selection().getRange()
 assert start==0 and finish==3

 bool expired=false
 try
  (saved as CallbackInt).value=5
 catch StateError
  expired=true
 end
 assert expired

 bool failed=false
 budget(0)
 try
  keys.loadDefaults()
 catch Error
  failed=true
 finally
  budget(-1)
 end
 assert failed and keys.find(xui.XUI_KEY_F2,modifiers)==custom

 flags.fail=true
 bool primary=false
 try
  keyDown(context,editor,xui.XUI_KEY_F2,modifiers)
 catch RuntimeError failure
  primary=failure.message=="command provider failure"
 end
 assert primary and handledCount==3
 flags.fail=false
 keys.close()
 keyDown(context,editor,xui.XUI_KEY_F2,modifiers)
 assert handledCount==4
 auto fresh=editor.commandMap()
 assert fresh.find(xui.XUI_KEY_F2,modifiers)==custom
 editor.setCommandEnabledProvider(null)
 editor.setCommandProvider(null)
 assert not editor.executeCommand(custom)
 editor.close()
 expired=false
 try
  fresh.getCount()
 catch StateError
  expired=true
 end
 assert expired
end

func main(...) as int
 auto proxy=xui.createProxy()
 auto context=xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
 auto editor=context.codeEditNative()
 assert context.setRootWidget(editor)==xui.XUI_OK
 try
  exercise(context,editor)
 finally
  context.close()
  proxy.close()
 end
 println("XUI_CODEEDIT_COMMAND_PROVIDER_OK")
 return 0
end
