// Keep both extern declarations exactly compatible with their native C ABI.
extern "xrtMathMax" func nativeMax(float left, float right) as float
extern "xrtMemDebugEnable" func unusedMemoryDebug(bool enable) as bool

assert nativeMax(-1, 0) == 0
assert nativeMax(1, -1) == 1
assert nativeMax(2, 2) == 2
assert nativeMax(-4, 4) == 4
string unrelated = "xrtMemDebugEnable xrtMathMaxAlmost"
assert unrelated == "xrtMemDebugEnable xrtMathMaxAlmost"
