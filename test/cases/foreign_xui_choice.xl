extern "xuiDestroy" @no_raise func rollback(Context context)
extern "xuiWidgetDestroy" @no_raise func rollbackWidget(Widget widget)
extern "xuiCreate" @no_raise @c_result("owned_view") @factory(0,0,rollback) func create() as Context
extern "declarative_xui_start" @no_raise func start()
extern "declarative_xui_counters_begin" @no_raise func countersBegin()
extern "declarative_xui_counters_end" @no_raise func countersEnd()
extern "declarative_xui_choice_fire" @no_raise @c_result("status",0) func fireChoice(Widget widget,c_int kind,c_int serial)
func main(...) as int
    start()
    Context context=create()
    array<Widget> controls=[context.button(), context.checkBox(), context.checkCard(), context.radio(), context.toggle(), context.slider(), context.rangeSlider(), context.scrollBar()]
    int calls=0
    controls[0].onButton(func(Widget sender)
        calls+=1
    end)
    controls[1].onCheckBox(func(Widget sender,c_int value)
        assert value==0 or value==1
        calls+=1
    end)
    controls[2].onCheckCard(func(Widget sender,c_int value)
        assert value==0 or value==1
        calls+=1
    end)
    controls[3].onRadio(func(Widget sender,c_int value)
        assert value==0 or value==1
        calls+=1
    end)
    controls[4].onToggle(func(Widget sender,c_int value)
        assert value==0 or value==1
        calls+=1
    end)
    controls[5].onSlider(func(Widget sender,c_float value)
        assert value==0.25 or value==0.75
        calls+=1
    end)
    controls[6].onRangeSlider(func(Widget sender,c_float start,c_float finish)
        assert (start==0.25 or start==0.75) and finish>=start
        calls+=1
    end)
    controls[7].onScrollBar(func(Widget sender,c_float value)
        assert value==0.25 or value==0.75
        calls+=1
    end)
    int kind=0
    while kind<8
        fireChoice(controls[kind],c_int(kind),0)
        kind+=1
    end
    assert calls==8
    // Isolate native callbacks from the existing container projection cost:
    // indexed native-value reads currently create a temporary xvalue shell.
    Widget button=controls[0]
    Widget checkBox=controls[1]
    Widget checkCard=controls[2]
    Widget radio=controls[3]
    Widget toggle=controls[4]
    Widget slider=controls[5]
    Widget rangeSlider=controls[6]
    Widget scrollBar=controls[7]
    countersBegin()
    int serial=1
    while serial<=200
        fireChoice(button,0,c_int(serial))
        fireChoice(checkBox,1,c_int(serial))
        fireChoice(checkCard,2,c_int(serial))
        fireChoice(radio,3,c_int(serial))
        fireChoice(toggle,4,c_int(serial))
        fireChoice(slider,5,c_int(serial))
        fireChoice(rangeSlider,6,c_int(serial))
        fireChoice(scrollBar,7,c_int(serial))
        serial+=1
    end
    countersEnd()
    assert calls==1608
    controls[0].onButton(null)
    controls[1].onCheckBox(null)
    controls[2].onCheckCard(null)
    controls[3].onRadio(null)
    controls[4].onToggle(null)
    controls[5].onSlider(null)
    controls[6].onRangeSlider(null)
    controls[7].onScrollBar(null)
    context.close()
    return 0
end
