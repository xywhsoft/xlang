extern "expect_i64" func expect(int actual, int expected)

func add(int left, int right) as int
    return left + right
end

func pick(int value) as int
    return value + 1
end

func pick(string value) as string
    return value
end

func addDefault(int left, int right = 1) as int
    return left + right
end

func total(int base, ...) as int
    return base + arg.length
end

func totalDefault(int base = 5, ...) as int
    return base + arg.length
end

func optionCount(string path, ***) as int
    return arg.length
end

func makePicker(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

func(int, int) as int typed = add
func erased = add
func(int) as int picked = pick
func(int, ...) as int variadic = total
func(int) as int oneDefault = addDefault
func(int, int) as int twoDefault = addDefault
func erasedDefault = addDefault
func(...) as int variadicDefault = totalDefault
func(string, ***) as int options = optionCount

func(int) as int borrowedMixedPicker = makePicker(100)
bool chooseMixedPicker = false
func(int) as int mixedPicker = chooseMixedPicker ? borrowedMixedPicker : makePicker(200)

int typedValue = typed(20, 22)
var erasedValue = erased(10, 5)
int pickedValue = picked(41)
int variadicValue = variadic(10, 1, 2, 3)
int oneDefaultValue = oneDefault(10)
int twoDefaultValue = twoDefault(10, 5)
var erasedDefaultValue = erasedDefault(10)
int variadicDefaultValue = variadicDefault("a", "b")
int optionValue = options("demo.txt", mode = "fast", retry = 3)
int mixedPickerOwnedValue = mixedPicker(1)
int borrowedMixedPickerStillWorks = borrowedMixedPicker(2)

chooseMixedPicker = true
mixedPicker = chooseMixedPicker ? borrowedMixedPicker : makePicker(300)
int mixedPickerBorrowedValue = mixedPicker(3)
int borrowedMixedPickerStillWorksAgain = borrowedMixedPicker(4)

expect(typedValue, 42)
expect(int(erasedValue), 15)
expect(pickedValue, 42)
expect(variadicValue, 13)
expect(oneDefaultValue, 11)
expect(twoDefaultValue, 15)
expect(int(erasedDefaultValue), 11)
expect(variadicDefaultValue, 7)
expect(optionValue, 2)
expect(mixedPickerOwnedValue, 201)
expect(borrowedMixedPickerStillWorks, 102)
expect(mixedPickerBorrowedValue, 103)
expect(borrowedMixedPickerStillWorksAgain, 104)
