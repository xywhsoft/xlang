extern "c_owned_text" @no_raise func nativeText() as point
extern "c_owned_binary" @no_raise func nativeBytes() as point
extern "c_owned_release" @no_raise func nativeFree(point data)
extern "c_owned_released" @no_raise func released() as int

func copyText() as string
    cstring value = cstring.take(nativeText(), nativeFree)
    string copied = value
    auto inferred = value
    var boxed = value
    assert inferred == "hello" and string(boxed) == "hello"
    assert copied == "hello"
    assert released() == 0
    return copied
end

func testOwned() as int
    string text = copyText()
    assert text == "hello"
    assert released() == 1
    cbytes binary = cbytes.take(nativeBytes(), 4, nativeFree)
    bytes data = binary
    assert data.length == 4
    assert data[0] == 0 and data[1] == 255 and data[3] == 42
    auto inferred = binary
    assert inferred.length == 4
    var dynamic = binary
    assert released() == 1
    return 42
end

assert testOwned() == 42
assert released() == 2
