extern "span_variants_sum" @header("test/cases/foreign_span_variants.h") @no_raise @c_span(0,"const float*","int") func sum(bytes data) as c_int
extern "span_variants_sum" @header("test/cases/foreign_span_variants.h") @no_raise @c_span(0,"const float*","int") func sum(Buffer data) as c_int
