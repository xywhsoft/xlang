protocol SumReader
 func sum(bytes data) as c_int
 func sum(Buffer data) as c_int
 func packed(bytes data) as c_int
 func packed(Buffer data) as c_int
end
func main(...) as int
 Reader reader=create()
 bytes data=b"\0\0\x80\x3f\0\0\0\x40"
 Buffer buffer=Buffer(data)
 assert reader.sum()==c_int(0) and reader.packed()==c_int(0)
 assert reader.sum(data)==c_int(3) and reader.sum(buffer)==c_int(3)
 assert reader.packed(data)==c_int(3) and reader.packed(buffer)==c_int(3)
 func(bytes) as c_int byteSum=reader.sum
 func(Buffer) as c_int bufferSum=reader.sum
 func(bytes) as c_int bytePacked=reader.packed
 func(Buffer) as c_int bufferPacked=reader.packed
 assert byteSum(data)==c_int(3) and bufferSum(buffer)==c_int(3)
 assert bytePacked(data)==c_int(3) and bufferPacked(buffer)==c_int(3)
 SumReader protocolReader=reader
 assert protocolReader.sum(data)==c_int(3) and protocolReader.sum(buffer)==c_int(3)
 assert protocolReader.packed(data)==c_int(3) and protocolReader.packed(buffer)==c_int(3)
 assert sum(data)==c_int(3) and sum(buffer)==c_int(3)
 failAfter(c_int(0))
 try
  assert reader.sum(data)==c_int(3) and reader.sum(buffer)==c_int(3)
  assert reader.packed(data)==c_int(3) and reader.packed(buffer)==c_int(3)
  resetFailure()
 catch error
  resetFailure()
  throw "readonly source projection unexpectedly allocated"
 end
 int before=calls()
 bool caught=false
 try
  reader.sum(b"a")
 catch error
  caught=true
 end
 assert caught and calls()==before
 reader.close()
 assert live()==c_int(0)
 return 0
end
