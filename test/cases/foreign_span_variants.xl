 native point handle
 extern "sum" @c_field_call @no_raise @c_span(0,"const float*","int") func sum(bytes data=b"") as c_int
 extern "sum" @c_field_call @no_raise @c_span(0,"const float*","int") func sum(Buffer data) as c_int
