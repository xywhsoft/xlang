class UpcastBase
    virtual func value() as int
        return 1
    end
end

class UpcastDerived extends UpcastBase
    int extra = 2

    override func value() as int
        return self.extra
    end
end

class UpcastHolder
    UpcastBase item
    array<UpcastBase> items = array[]
end

func takeBase(UpcastBase value) as int
    return value.value()
end

func main(...) as int
    UpcastDerived derived = UpcastDerived()

    UpcastBase direct = derived
    assert direct.value() == 2
    assert direct is UpcastDerived
    assert takeBase(derived) == 2

    array<UpcastBase> values = array[]
    values.append(derived)
    assert values[0].value() == 2
    assert values[0] is UpcastDerived

    UpcastHolder holder = UpcastHolder()
    holder.item = derived
    assert holder.item.value() == 2
    assert holder.item is UpcastDerived

    // var 动态字段桥接必须保留兼容的 class 句柄，不能把对象误当持久化数据重建。
    var boxedHolder = holder
    var dynamicItems = []
    dynamicItems.append(derived)
    boxedHolder["items"] = dynamicItems
    assert holder.items.length == 1
    assert holder.items[0].value() == 2
    assert holder.items[0] is UpcastDerived
    return 0
end
