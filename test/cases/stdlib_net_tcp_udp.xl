// All endpoints are literal loopback and belong to this program.
func readExact(TcpStream stream, int size) as bytes
    bytes result = b""
    while result.length < size
        auto chunk = stream.recv(size - result.length, 5000)
        assert chunk.length > 0
        result = result + chunk
    end
    return result
end

auto engine = NetEngine(NetEngineOptions().withWorkers(1).withBackend(NetBackend.select))
engine.start()
auto listener = tcp.listen(engine, TcpListenOptions(NetAddress.loopback()))
auto accepted = listener.acceptAsync()
auto client = tcp.connect(engine, listener.localAddress())
auto peer = await accepted
assert client.wait(TcpWait.open, 5000) == NetStatus.ok
future<bytes> received = peer.recvAsync(4)
assert client.send("ping") == NetStatus.ok
bytes request = await received
while request.length < 4
    request = request + await peer.recvAsync(4 - request.length)
end
assert request == b"ping" and client.wait(TcpWait.drain, 5000) == NetStatus.ok
assert peer.send("pong") == NetStatus.ok and readExact(client, 4) == b"pong"
auto binary = Buffer(b"\x00\x01\x80\xFF")
assert client.send(binary) == NetStatus.ok and readExact(peer, 4) == b"\x00\x01\x80\xFF"
assert client.send("a\0b") == NetStatus.ok and readExact(peer, 3) == b"a\0b"
client.close()
peer.close()
listener.close()
println("tcp=ok")

auto asyncListener = TcpListener(engine, TcpListenOptions(NetAddress.loopback()))
auto asyncAccepted = asyncListener.acceptAsync()
auto asyncConnected = tcp.connectAsync(engine, asyncListener.localAddress())
auto asyncClient = await asyncConnected
auto asyncPeer = await asyncAccepted
auto asyncReceived = asyncPeer.recvAsync(6)
assert asyncClient.send("as\0ync") == NetStatus.ok
assert await asyncClient.waitAsync(TcpWait.drain)
bytes asyncRequest = await asyncReceived
while asyncRequest.length < 6
    asyncRequest = asyncRequest + await asyncPeer.recvAsync(6 - asyncRequest.length)
end
assert asyncRequest == b"as\0ync"
asyncClient.close()
asyncPeer.close()
asyncListener.close()
println("tcp_async=ok")

auto left = udp.bind(engine, NetAddress.loopback())
auto right = udp.bind(engine, NetAddress.loopback())
assert left.wait(UdpWait.open, 5000) == NetStatus.ok and right.wait(UdpWait.open, 5000) == NetStatus.ok
assert left.sendTo(right.localAddress(), "hello") == NetStatus.ok
assert right.recv(5000).bytes() == b"hello"
assert right.sendTo(left.localAddress(), "reply") == NetStatus.ok
assert left.recv(5000).bytes() == b"reply"
assert left.sendTo(right.localAddress(), binary) == NetStatus.ok
assert right.recv(5000).bytes() == b"\x00\x01\x80\xFF"
assert left.sendTo(right.localAddress(), "a\0b") == NetStatus.ok
assert right.recv(5000).bytes() == b"a\0b"
println("udp=ok")

auto packetFuture = right.recvAsync()
assert left.sendTo(right.localAddress(), "async-udp") == NetStatus.ok
auto packet = await packetFuture
assert packet.bytes() == b"async-udp"
left.close()
right.close()
engine.close()
assert engine.wait(5000)
assert packet.bytes() == b"async-udp"
println("udp_async=ok")
