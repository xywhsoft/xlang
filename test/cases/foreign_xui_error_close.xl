import xui
from xui import CallbackConstErrorInfo,CallbackContext,CallbackWidget
extern "fixtureInputProxy" @header("test/cases/foreign_xui_input_extended.h") @no_raise @c_result("owned_view") @factory(0,0,dropProxy) func cpuProxy() as xui.Proxy
extern "xuiProxyReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropProxy(xui.Proxy value)
extern "fixtureLayoutFont" @no_raise @c_result("owned_view") @factory(1,0,dropFont) func cpuFont(xui.Proxy proxy) as xui.Font
extern "xuiFontReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropFont(xui.Font value)
extern "fixtureInputCleanupCheck" @no_raise func checkCleanup()
extern "fixtureInputBudget" @no_raise func budget(c_int count)
extern "fixtureInputHeapBegin" @no_raise func heapBegin()
extern "fixtureInputHeapReport" @no_raise func heapReport(c_int kind)
extern "fixtureOwnedNativeInstall" @header("test/cases/foreign_xui_input_owned.h") @no_raise @c_result("status",0) func nativeInstall(xui.Context ui,xui.Widget target)
extern "fixtureOwnedNativeHot" @no_raise func nativeHot(xui.Context ui)
extern "fixtureOwnedNativeCount" @no_raise func nativeCount() as c_int
func main(...) as int
 auto proxy=cpuProxy()
 auto ui=xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
 auto font=cpuFont(proxy)
 ui.setDefaultFont(font)
 auto root=ui.widget()
 auto input=ui.inputNative()
 assert ui.setRootWidget(root)==0 and root.addChild(input)==0 and ui.setFocusWidget(input)==0
 int errors=0
 int commands=0
 root.setEventHandler(xui.XUI_EVENT_COMMAND,func(xui.Widget sender,xui.CallbackConstEvent event) as c_int
  commands+=1
  return c_int(0)
 end)
 ui.setErrorCallback(func(xui.CallbackContext current,xui.CallbackConstErrorInfo info)
  errors+=1
  current.requestClose()
 end)
 ui.inputImeCompositionEx("a\0b",0)
 ui.dispatchCommand(root,1,"must-not-run")
 assert ui.dispatchPendingEvents()==0 and errors==1 and commands==0
 ui.close()
 font.close()
 proxy.close()
 checkCleanup()
 println("InputOwners close: callback Context requestClose stops following queued command")
 return 0
end
