// File send keeps an independent native cursor and accepts exact byte ranges.
auto engine = NetEngine(NetEngineOptions().withWorkers(1))
engine.start()
auto listener = TcpListener(engine, TcpListenOptions(NetAddress.loopback(4, 0)))
auto sender = TcpStream(engine, listener.localAddress())
auto receiver = listener.accept(5000)
assert sender.wait(TcpWait.open, 5000) == NetStatus.ok
auto input = File("", "xlang-net-send-file-", ".bin")
assert input.write(b"prefix:a\0b:suffix") == 17
uint64 position = input.pos
assert sender.sendFile(input, uint64(7), 3) == NetStatus.ok
assert input.pos == position
assert input.close()
bytes result = b""
while result.length < 3
    bytes part = receiver.recv(3 - result.length, 5000)
    assert part.length > 0
    result = result + part
end
assert result == b"a\0b"
sender.abort()
receiver.abort()
listener.close()
engine.close()
assert engine.wait(5000)
println("stdlib net send file ok")
