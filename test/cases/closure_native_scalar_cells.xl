func main(...) as int
 c_char a=c_char(1)
 c_schar b=c_schar(2)
 c_uchar c=c_uchar(3)
 c_short d=c_short(4)
 c_ushort e=c_ushort(5)
 c_int f=c_int(6)
 c_uint g=c_uint(7)
 c_long h=c_long(8)
 c_ulong i=c_ulong(9)
 c_longlong j=c_longlong(10)
 c_ulonglong k=c_ulonglong(11)
 c_size l=c_size(12)
 c_ssize m=c_ssize(13)
 c_ptrdiff n=c_ptrdiff(14)
 c_intptr o=c_intptr(15)
 c_uintptr p=c_uintptr(16)
 c_wchar q=c_wchar(17)
 c_bool flag=c_bool(false)
 c_float x=c_float(1.25)
 c_double y=c_double(2.5)
 float32 z=float32(3.5)
 auto change=func()
  a+=c_char(1)
  b+=c_schar(1)
  c+=c_uchar(1)
  d+=c_short(1)
  e+=c_ushort(1)
  f+=c_int(1)
  g+=c_uint(1)
  h+=c_long(1)
  i+=c_ulong(1)
  j+=c_longlong(1)
  k+=c_ulonglong(1)
  l+=c_size(1)
  m+=c_ssize(1)
  n+=c_ptrdiff(1)
  o+=c_intptr(1)
  p+=c_uintptr(1)
  q+=c_wchar(1)
  flag=c_bool(true)
  x+=c_float(0.5)
  y+=c_double(0.25)
  z+=float32(0.25)
 end
 change()
 change()
 assert a==c_char(3) and b==c_schar(4) and c==c_uchar(5)
 assert d==c_short(6) and e==c_ushort(7) and f==c_int(8)
 assert g==c_uint(9) and h==c_long(10) and i==c_ulong(11)
 assert j==c_longlong(12) and k==c_ulonglong(13) and l==c_size(14)
 assert m==c_ssize(15) and n==c_ptrdiff(16) and o==c_intptr(17)
 assert p==c_uintptr(18) and q==c_wchar(19) and flag==c_bool(true)
 assert x==c_float(2.25) and y==c_double(3.0) and z==float32(4.0)
 c_schar edge=c_schar(127)
 auto overflow=func()
  edge+=c_schar(1)
 end
 bool rejected=false
 try
  overflow()
 catch error
  rejected=true
 end
 assert rejected and edge==c_schar(127), "failed checked update preserves the cell"
 println("NATIVE_SCALAR_CELLS_OK")
 return 0
end
