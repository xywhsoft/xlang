func oneTake()
 auto data=produceText()
 assert identity(data)==c_int(1)
end
func main(...) as int
 auto data=produceText()
 assert identity(data)==c_int(1) and data=="A\0你Z"
 auto copy=data
 copy[0]='B'
 assert data=="A\0你Z" and copy=="B\0你Z"
 assert produceBytes()==b"A\0\xe4\xbd\xa0Z"
 assert projectText("A\0你Z")=="A\0你Z"
 assert projectText(b"A\0Z",99)=="A\0Z"
 assert projectText(Buffer(b"A\0Z"),2)=="A\0"
 assert emptyCString(produceText(c_int(1)))==c_int(1)
 assert produceText(c_int(7))==""
 string kept="keep"
 for mode in [2,3,4,5,6,8]
  beginCounter()
  bool caught=false
  try
   kept=produceText(c_int(mode))
  catch error
   caught=true
   if mode==4 then
    assert error.code==-17
   end
  end
  assert caught and kept=="keep"
  endCounter()
 end
 // Adoption itself allocates nothing after the producer returns.
 auto noExtraAllocation=produceText(c_int(9))
 resetFailure()
 assert noExtraAllocation=="A\0你Z"
 oneTake()
 nativeReference()
 beginCounter()
 for i in range(100)
  oneTake()
 end
 languageReference()
 return 0
end
