func makeNamedForCapture() as func() as int
    array<int> values = [42]
    func() as int selected = func() as int => -1
    for item in values
        selected = func() as int
            return item
        end
    end
    return selected
end

func() as int selected = makeNamedForCapture()
assert selected() == 42, "closure captures a typed array iterator value"
println("hir_closure_for_named_typed_array ok")
