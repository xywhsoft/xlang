func makeAdder(int base) as func(int) as int
    return func(int value) as int
        return base + value
    end
end

func bad(func(int) as int fn) as generator<int>
    yield fn(1)
end

func main(...) as int
    int total = 0
    for value in bad(makeAdder(40))
        total += value
    end
    assert total == 41
    println("ok")
    return 0
end
