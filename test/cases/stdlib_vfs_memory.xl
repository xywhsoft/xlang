auto fs = vfs.create()
auto resources = vfs.memory()
assert resources.put("raw.bin", b"a\0b")
assert resources.put("text.bin", "a\0b", 20)
assert resources.put("prefix.bin", b"abcdef", 3)
assert resources.put("empty.bin", b"")
assert resources.put("你.bin", b"utf8 path")
assert resources.put("Case.TXT", b"case")
assert resources.seal()
auto mount = fs.mount("/app", resources)
assert not (mount.id == 0)
assert not (fs.readBytes("/app/raw.bin") != b"a\0b")
assert not (fs.readBytes("/app/text.bin") != b"a\0b")
assert not (fs.readBytes("/app/prefix.bin") != b"abc")
assert not (fs.readBytes("/app/empty.bin").length != 0)
assert fs.readBytes("/app/你.bin") == b"utf8 path"
auto caseMount = fs.mount("/case", resources, 0, 1)
assert fs.readBytes("/case/cASE.txT") == b"case"
assert mount.unmount()
assert mount.unmount()
println("vfs memory ok")
