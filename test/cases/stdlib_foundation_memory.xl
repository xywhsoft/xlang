import memory

bool previous = memory.statsEnabled()
memory.enableStats(true)
assert memory.statsEnabled()
memory.resetStats()
MemoryStats first = memory.stats()
assert first.enabled
assert first.classCount == uint64(64)
assert first.classStep == uint64(16)
assert first.classCutoff == uint64(1024)
auto buffer = Buffer(128)
buffer.append("a\0你")
MemoryStats second = memory.stats()
assert second.mallocCalls >= first.mallocCalls
assert second.mallocBytes >= first.mallocBytes
uint64 calls = second.classCalls(0)
uint64 bytes = second.classBytes(0)
assert calls == second.classCalls(0) and bytes == second.classBytes(0)
assert second.backingAllocCalls == second.backingAllocCalls
int rejected = 0
try
    second.classCalls(-1)
catch RangeError e
    rejected += 1
end
try
    second.classBytes(64)
catch RangeError e
    rejected += 1
end
assert rejected == 2
memory.enableStats(false)
assert not memory.statsEnabled()
assert first.enabled
memory.enableStats(previous)

MemoryDebugSnapshot debug = memory.debugSnapshot()
assert debug.enabled == memory.debugEnabled()
assert debug.invalidFreeCount == uint64(0)
assert debug.doubleFreeCount == uint64(0)
assert debug.overflowCount == uint64(0)
assert debug.underflowCount == uint64(0)
assert debug.useAfterFreeCount == uint64(0)
assert debug.liveCount == debug.liveCount
auto jsonReport = memory.reportJson()
assert jsonReport.length > 0
assert json.parse(jsonReport) != null
assert memory.reportText().length > 0
rejected = 0
try
    memory.reportText(-1)
catch RangeError e
    rejected += 1
end
try
    memory.reportJson(0)
catch e
    rejected += 1
end
assert rejected == 2
