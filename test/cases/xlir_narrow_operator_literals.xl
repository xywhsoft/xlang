// Offline regression: contextual constants, not implicit variable narrowing.
func flip(uint8 value) as uint8
    return value ^ 1
end

bytes data = b"\xff\x00\x80"
assert (data[0] ^ 1) == 254
assert (1 ^ data[0]) == 254
data[0] = data[0] ^ 1
assert data[0] == 254
assert flip(data[0]) == 255

uint8 u8 = 128
uint16 u16 = 32768
uint32 u32 = 2147483648
int8 i8 = -100
int16 i16 = -30000
int32 i32 = -2000000000

assert (u8 | 1) == 129
assert (u8 & 255) == 128
assert (u8 ^ 255) == 127
assert (u8 >> 7) == 1
assert (u16 | 1) == 32769
assert (u16 & 65535) == 32768
assert (u16 ^ 65535) == 32767
assert (u32 | 1) == 2147483649
assert (u32 & 4294967295) == 2147483648
assert (u32 ^ 4294967295) == 2147483647
assert (i8 | 1) == -99
assert (i8 & 127) == 28
assert (i8 ^ -1) == 99
assert (i16 | 1) == -29999
assert (i16 ^ -1) == 29999
assert (i32 | 1) == -1999999999
assert (i32 ^ -1) == 1999999999

println("narrow operator literals ok")
