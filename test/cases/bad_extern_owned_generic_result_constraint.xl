extern "c_owned_text" @no_raise func rawText() as point
extern "c_owned_release" @no_raise func release(point data)
class Base
end
class Reader
    func Read<T>(T value) as cstring
        return cstring.take(rawText(),release)
    end
    func Factory<T is Base>(T witness) as func(T) as cstring
        return self.Read
    end
end
Reader reader=Reader()
func(c_int) as func(c_int) as string invalid=reader.Factory
