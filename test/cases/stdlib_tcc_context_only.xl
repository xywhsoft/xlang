import tcc

println("before tcc context")
TccContext ctx = tcc.Context()
string source = "#include <stddef.h>\n#include <stdbool.h>\ntypedef struct xstrview { const char* Data; size_t Size; } xstrview;\nbool xrtHttpResponseContentAllowed(xstrview Method, unsigned short Status);\nbool xrtWsKeyValid(xstrview Key);\nint main(void){ xstrview method = { \"GET\", 3u }; xstrview key = { \"dGhlIHNhbXBsZSBub25jZQ==\", 24u }; return (xrtHttpResponseContentAllowed(method, 200u) && xrtWsKeyValid(key)) ? 0 : 1; }\n"
assert ctx.compileString(source) == 0, "current XRT protocol symbols should compile"
assert ctx.run() == 0, "current XRT protocol symbols should relocate and run"
println("after tcc context")
