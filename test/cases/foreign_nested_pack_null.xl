protocol Evaluator
 func evaluate(c_int factor,Root? source,string text) as c_int
end
func main(...) as int
 Root root=create()
 assert root.call(c_int(7),root,"a\0b")==c_int(32)
 assert root.evaluate(c_int(7),root,"a\0b")==c_int(32)
 func(c_int,Root?,string) as c_int bound=root.evaluate
 assert bound(c_int(7),root,"a\0b")==c_int(32)
 Evaluator evaluator=root
 assert evaluator.evaluate(c_int(7),root,"a\0b")==c_int(32)
 assert freeValue(c_int(7),root,"a\0b")==c_int(21)
 assert freeValue(c_int(7),null,"a\0b")==c_int(10)
 assert onlyNull()==c_int(17)
 assert trailing(c_int(19))==c_int(19)
 assert calls()==c_int(8)
 failAfter(c_int(0))
 try
  assert onlyNull()==c_int(17)
  assert trailing(c_int(21))==c_int(21)
 finally
  resetFailure()
 end
 assert calls()==c_int(10)
 auto first,second=multiNull()
 assert first==c_int(23) and second==c_int(29)
 assert spanNull(b"a\0b")==c_int(31)
 assert calls()==c_int(12)
 root.close()
 auto rejected=false
 try
  freeValue(c_int(7),root,"a\0b")
 catch error
  rejected=true
 end
 assert rejected and calls()==c_int(12)
 return 0
end
