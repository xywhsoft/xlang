extern "expect_i64" func expect(int actual, int expected)

func add = func(int left, int right) as int => left + right
func anonCounter = func(int base, ...) as int => base + arg.length

func count(int base, ...) as int
    return base + arg.length
end

func counter = count

var value = add(20, 22)
auto inferred = add(10, 5)
var counted = counter(10, 1, 2, 3)
var anonCounted = anonCounter(7, "a", "b")

expect(int(value), 42)
expect(int(inferred), 15)
expect(int(counted), 13)
expect(int(anonCounted), 9)
