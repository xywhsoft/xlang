extern "CallbackFactoryNode*" class Node @header("test/cases/foreign_callback_factory.h") @lifetime("owned") @policy("callbackFactoryPolicy")
 native point handle
 extern "value" @c_field get value() as c_int
 extern "xl6ForeignViewCloseV1" @no_raise @c_control(0) @c_result("bool_status") func close()
end
extern "callback_factory_drop" @header("test/cases/foreign_callback_factory.h") @no_raise @c_result("status",0) func rollback(Node value)
extern "CallbackFactoryNode*" class CallbackNode @header("test/cases/foreign_callback_factory.h") @lifetime("callback")
 native point handle
 extern "value" @c_field get value() as c_int
 extern "mode" @c_field get mode() as c_int
 extern "refs" @c_field get refs() as c_int
 extern "callback_factory_share" @no_raise @c_result("owned_view") @factory(1,0,rollback) func share() as Node
end
typedef Visit=func(CallbackNode) as c_int
extern "callback_factory_set" @header("test/cases/foreign_callback_factory.h") @no_raise @c_owned_callback(0,-1,"CallbackFactoryOwner",-16) @c_result("status",0) func install(Visit? callback)
extern "callback_factory_dispatch" @header("test/cases/foreign_callback_factory.h") @no_raise @c_result("status",0) func dispatch(c_int mode)
extern "callback_factory_live" @header("test/cases/foreign_callback_factory.h") @no_raise func live() as c_int
extern "callback_factory_calls" @header("test/cases/foreign_callback_factory.h") @no_raise func calls() as c_int
extern "callback_factory_fail_after" @header("test/cases/foreign_callback_factory.h") @no_raise func failAfter(c_int count)
extern "callback_factory_reset" @header("test/cases/foreign_callback_factory.h") @no_raise func resetFailure() as c_int
protocol Sharer
 func share() as Node
end
Node? retained=null
CallbackNode? expired=null
func main(...) as int
 install(func(CallbackNode source) as c_int
  expired=source
  if source.mode==c_int(0) then
   retained=source.share()
   func() as Node bound=source.share
   auto second=bound()
   Sharer producer=source
   auto third=producer.share()
   assert source.refs==c_int(4), "three independent owning results"
   second.close()
   third.close()
   // No-scope leaf destruction waits for the physical callback return tail.
   assert source.refs==c_int(4), "closed owners remain pinned through callback tail"
   bool closed=false
   try
    auto unused=second.value
   catch error
    closed=true
   end
   assert closed, "logical close invalidates the closed result"
  else
   bool rejected=false
   auto before=calls()
   if source.mode==c_int(3) then failAfter(c_int(0)) end
   try
    auto unused=source.share()
   catch error
    rejected=true
    if source.mode==c_int(1) then assert error.code==-7, "partial producer native status" end
    if source.mode==c_int(2) then assert error.code==-9, "empty producer native status" end
   finally
    if source.mode==c_int(3) then assert resetFailure()==c_int(1), "reservation attempted allocation" end
   end
   assert rejected and source.value==c_int(42), "source epoch survives failed factory"
   if source.mode==c_int(1) then
    assert source.refs==c_int(2), "partial owner queued until callback tail"
   else
    assert source.refs==c_int(1), "failure without transferred owner"
   end
   if source.mode==c_int(3) then assert calls()==before, "reservation failure skips native producer" end
  end
  return c_int(0)
 end)
 dispatch(c_int(0))
 assert (retained as Node).value==c_int(42) and live()==c_int(1), "owned result survives native source release"
 auto before=calls()
 bool rejected=false
 try
  auto unused=(expired as CallbackNode).share()
 catch error
  rejected=true
 end
 assert rejected and calls()==before, "expired epoch skips native producer"
 rejected=false
 try
  auto unused=(expired as CallbackNode).value
 catch error
  rejected=true
 end
 assert rejected, "expired epoch cannot read native fields"
 dispatch(c_int(1))
 assert live()==c_int(1), "partial failed owner released after callback tail"
 dispatch(c_int(2))
 assert live()==c_int(1), "empty failed source released after callback tail"
 dispatch(c_int(3))
 assert live()==c_int(1), "failed results leave only saved owner"
 install(null)
 (retained as Node).close()
 retained=null
 expired=null
 assert live()==c_int(0), "all owners consumed"
 return 0
end
