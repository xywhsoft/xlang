import xui
from xui import CallbackCodeDocument,CallbackCodeFoldOutput,CodeFoldRange

extern "fixtureDiagnosticBudget" @header("test/cases/foreign_xui_codeedit_diagnostics_heap.h") @no_raise func budget(c_int allowance)

func makeRange(c_int start,c_int endLine) as CodeFoldRange
 auto value=CodeFoldRange()
 value.iStartLine=start
 value.iEndLine=endLine
 return value
end

func checkIndependent(xui.CodeDocument document)
 auto folds=xui.createCodeFoldState()
 CallbackCodeDocument? oldDocument=null
 CallbackCodeFoldOutput? oldOutput=null
 int calls=0
 xui.CodeFoldProvider provider=func(CallbackCodeDocument doc,CallbackCodeFoldOutput output) as c_int
  assert doc.getLineCount()==4 and doc.getLength()==7
  auto start,endOffset=doc.getLineRange(2)
  assert start==4 and endOffset>=5 and doc.getByte(start)==99
  assert output.capacity()==c_int(calls)
  if calls!=0 then
   bool expired=false
   try
    auto size=(oldOutput as CallbackCodeFoldOutput).capacity()
   catch StateError
    expired=true
   end
   assert expired
  end
  oldDocument=doc
  oldOutput=output
  output.append(makeRange(0,2))
  if calls!=0 then
   output.append(makeRange(1,3))
  end
  bool busy=false
  try
   folds.foldAll()
  catch Error
   busy=true
  end
  assert busy
  calls+=1
  return xui.XUI_OK
 end
 try
  folds.buildFromProvider(document,provider)
  assert calls==3 and folds.getCount()==2
  assert folds.getRange(0).iStartLine==0 and folds.getRange(1).iEndLine==3
  bool expired=false
  try
   auto lines=(oldDocument as CallbackCodeDocument).getLineCount()
  catch StateError
   expired=true
  end
  assert expired

  xui.CodeFoldProvider whole=func(CallbackCodeDocument doc,CallbackCodeFoldOutput output) as c_int
   output.append(makeRange(0,doc.getLineCount()-1))
   return xui.XUI_OK
  end
  int rejected=0
  try
   folds.buildFromProvider(document,func(CallbackCodeDocument doc,CallbackCodeFoldOutput output) as c_int
    output.append(makeRange(2,2))
    return xui.XUI_OK
   end)
  catch Error
   rejected+=1
  end
  try
   folds.buildFromProvider(document,func(CallbackCodeDocument doc,CallbackCodeFoldOutput output) as c_int
    document.insert(0,"new\n")
    return xui.XUI_OK
   end)
  catch Error
   rejected+=1
  end
  budget(0)
  try
   folds.buildFromProvider(document,whole)
  catch Error
   rejected+=1
  finally
   budget(-1)
  end
  assert rejected==3 and folds.getCount()==2
  folds.buildFromProvider(document,whole)
  assert folds.getCount()==1 and folds.getRange(0).iEndLine==4
 finally
  folds.close()
 end
end

func checkEditor()
 auto proxy=xui.createProxy()
 auto context=xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
 auto editor=context.codeEditNative()
 auto other=context.codeEditNative()
 assert context.setRootWidget(editor)==xui.XUI_OK
 auto document=editor.document()
 auto folds=editor.foldState()
 auto independent=xui.createCodeFoldState()
 xui.CodeFoldProvider provider=func(CallbackCodeDocument doc,CallbackCodeFoldOutput output) as c_int
  output.append(makeRange(0,doc.getLineCount()-1))
  return xui.XUI_OK
 end
 try
  document.setText("chapter\nfirst\nsecond")
  independent.buildFromProvider(document,provider)
  assert independent.getRange(0).iEndLine==2
  folds.buildFromProvider(document,provider)
  folds.foldAll()
  assert folds.visibleLineCount(3)==1
  folds.buildFromProvider(document,provider)
  assert folds.visibleLineCount(3)==1
  bool mismatch=false
  try
   folds.buildFromProvider(other.document(),provider)
  catch Error
   mismatch=true
  end
  assert mismatch and folds.getCount()==1
 finally
  independent.close()
  other.close()
  context.close()
  proxy.close()
 end
end

func main(...) as int
 auto document=xui.createCodeDocument()
 try
  document.setText("a\nb\nc\nd")
  checkIndependent(document)
  checkEditor()
 finally
  document.close()
 end
 println("XUI_CODE_FOLD_PROVIDER_OK")
 return 0
end
