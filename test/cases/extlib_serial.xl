import serial
from serial import Serial



func retainedRead() as Buffer
    Serial port = serial.openLoopback()
    assert port.write("owned") == 5
    return port.readBytes()
end



func retainedName() as string
    Serial port = serial.openLoopback()
    return port.port
end



func main(...) as int
    // 回环不访问真实设备，测试无需管理员权限或串口硬件。
    auto sp = serial.openLoopback(115200)
    assert sp.valid, "valid"
    assert sp.isOpen, "is open"
    assert sp.baudrate == 115200, "baudrate"
    assert sp.port == "LOOPBACK", "port name"
    sp.setTimeouts(0, 60000)
    bool invalidTimeout = false
    try
        sp.setTimeouts(-1, 1000)
    catch ValueError error
        invalidTimeout = true
    end
    assert invalidTimeout, "negative timeout"
    invalidTimeout = false
    try
        sp.setTimeouts(50, 60001)
    catch ValueError error
        invalidTimeout = true
    end
    assert invalidTimeout, "timeout limit"
    sp.setTimeouts(50, 1000)

    // 文本写入和读取。
    auto n = sp.write("Hello Serial")
    assert n == 12, "wrote 12 bytes"
    assert sp.available == 12, "available 12"

    auto data = sp.read(1024)
    assert data == "Hello Serial", "read back: " + data
    assert sp.available == 0, "available 0 after read"

    sp.write("ABC")
    assert sp.available == 3, "available 3"

    // flush 明确表示丢弃队列，不是等待发送完成。
    sp.flush()
    assert sp.available == 0, "available 0 after flush"

    // UTF-8 长度按字节传递，不能截断中文内容。
    assert sp.write("你好") == 6, "UTF-8 bytes"
    assert sp.available == 6
    assert sp.read(6) == "你好"

    // 文本读取不能把半个 UTF-8 字符作为 string 返回；二进制入口保留原始字节。
    assert sp.write("你") == 3
    bool splitText = false
    try
        sp.read(1)
    catch error
        splitText = error.kind == "ValueError"
    end
    assert splitText, "partial UTF-8 text is rejected"
    Buffer tail = sp.readBytes(2)
    assert tail.len() == 2 and tail.byteAt(0) == 189 and tail.byteAt(1) == 160
    assert sp.write("你") == 3
    Buffer whole = sp.readBytes(3)
    assert whole.text() == "你"

    // 二进制读写保留嵌入零字节；结果不借用串口的暂存区。
    Buffer bytes = Buffer()
    assert bytes.appendByte(0) and bytes.appendByte(255) and bytes.appendByte(65)
    assert sp.writeBytes(bytes) == 3
    Buffer saved = sp.readBytes(3)
    assert saved.len() == 3 and saved.byteAt(0) == 0 and saved.byteAt(1) == 255
    assert sp.write("new") == 3
    assert sp.read() == "new"
    assert saved.byteAt(2) == 65
    Buffer retained = retainedRead()
    assert retained.text() == "owned", "read result outlives port"
    string name = retainedName()
    assert sp.writeBytes(Buffer()) == 0
    assert name == "LOOPBACK", "borrowed C port name is copied before native destroy"

    // 回环队列有界，必须报告真实短写，不能丢数据后谎报成功。
    Buffer large = Buffer()
    for i in range(5000)
        assert large.appendByte(i % 256)
    end
    assert sp.writeBytes(large) == 4096
    assert sp.write("full") == 0
    assert sp.readBytes(0).len() == 0 and sp.available == 4096
    Buffer full = sp.readBytes(9223372036854775807)
    assert full.len() == 4096 and full.byteAt(4095) == 255
    assert sp.available == 0 and sp.readBytes().len() == 0

    bool invalidRead = false
    try
        sp.readBytes(-1)
    catch error
        invalidRead = error.kind == "ValueError"
    end
    assert invalidRead, "negative read length"

    bool invalidOpen = false
    try
        serial.openLoopback(0)
    catch error
        invalidOpen = error.kind == "ValueError"
    end
    assert invalidOpen, "invalid baudrate"

    bool missingPort = false
    try
        serial.open("XLANG_SERIAL_NO_SUCH_DEVICE_91D783AB")
    catch IOError error
        // 设备路径由 XRT 文件层打开；语言层应按 IOError 父类捕获，
        // 同时保留更精确的 FileError 结构化诊断。
        missingPort = error.kind == "FileError" and error.domain == "xrt.file" and error.operation == "open"
    end
    assert missingPort, "native device failure is catchable"

    // 独立句柄互不影响，公开类型可直接导入并用于声明。
    Serial another = serial.openLoopback()
    Serial alias = another
    assert alias.write("alias") == 5 and another.read() == "alias"
    assert sp.write("first") == 5 and another.write("second") == 6
    assert sp.read(2) == "fi" and sp.available == 3
    assert another.read() == "second" and sp.read() == "rst"
    for i in range(200)
        Serial temporary = serial.openLoopback()
        assert temporary.write("ok") == 2 and temporary.read() == "ok"
    end

    println("serial xlang boundaries: PASS")
    return 0
end
