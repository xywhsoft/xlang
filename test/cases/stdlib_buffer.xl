extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

Buffer buf = Buffer()

expect(buf.len(), 0)
expect(buf.length, 0)
expect(buf.capacity(), 0)
expect(buf.append("abc"), 1)
expect(buf.appendByte(100), 1)

bool appendNegativeCaught = false
try
    buf.appendByte(-1)
catch e
    if e.kind == "ValueError" then
        appendNegativeCaught = true
    end
end
expect(appendNegativeCaught, 1)

bool appendOverflowCaught = false
try
    buf.appendByte(256)
catch e
    if e.kind == "ValueError" then
        appendOverflowCaught = true
    end
end
expect(appendOverflowCaught, 1)

expect(buf.len(), 4)
expect(buf.length, 4)
expect(buf.byteAt(0), 97)
expect(buf.byteAt(3), 100)

bool readNegativeCaught = false
try
    buf.byteAt(-1)
catch e
    if e.kind == "RangeError" then
        readNegativeCaught = true
    end
end
expect(readNegativeCaught, 1)

bool readOverflowCaught = false
try
    buf.byteAt(4)
catch e
    if e.kind == "RangeError" then
        readOverflowCaught = true
    end
end
expect(readOverflowCaught, 1)

expect(buf[1], 98)
buf[1] = 66
expect(buf[1], 66)
expect(buf.setByte(2, 67), 1)

bool writeNegativeCaught = false
try
    buf.setByte(-1, 1)
catch e
    if e.kind == "RangeError" then
        writeNegativeCaught = true
    end
end
expect(writeNegativeCaught, 1)

bool writeOverflowCaught = false
try
    buf.setByte(99, 1)
catch e
    if e.kind == "RangeError" then
        writeOverflowCaught = true
    end
end
expect(writeOverflowCaught, 1)

bool writeBadByteCaught = false
try
    buf.setByte(0, 256)
catch e
    if e.kind == "ValueError" then
        writeBadByteCaught = true
    end
end
expect(writeBadByteCaught, 1)

expectStr(buf.text(), "aBCd")

int sum = 0
for item in buf
    sum += item
end
expect(sum, 97 + 66 + 67 + 100)

expect(buf.reserve(128), 1)
expect(buf.capacity() >= 128, 1)
expect(buf.clear(), 1)
expect(buf.len(), 0)
expectStr(buf.text(), "")

Buffer stepped = Buffer(64)
expect(stepped.append(b"hello", 2), 1)
expectStr(stepped.text(), "he")
expect(stepped.append(b"ignored", 0), 1)
expect(stepped.len(), 2)

Buffer copied = Buffer()
expect(copied.append(stepped), 1)
expect(copied.len(), 2)
expectStr(copied.text(), "he")

Buffer inserted = Buffer()
expect(inserted.append("ad"), 1)
expect(inserted.insert(1, "bc"), 1)
expectStr(inserted.text(), "abcd")
expect(inserted.insert(0, stepped), 1)
expectStr(inserted.text(), "heabcd")
expect(inserted.insert(inserted.len(), "!"), 1)
expectStr(inserted.text(), "heabcd!")

bool insertNegativeCaught = false
try
    inserted.insert(-1, "x")
catch e
    if e.kind == "RangeError" then
        insertNegativeCaught = true
    end
end
expect(insertNegativeCaught, 1)

bool insertOverflowCaught = false
try
    inserted.insert(inserted.len() + 1, "x")
catch e
    if e.kind == "RangeError" then
        insertOverflowCaught = true
    end
end
expect(insertOverflowCaught, 1)

Buffer sizedSource = Buffer()
sizedSource.appendByte(65)
sizedSource.appendByte(0)
sizedSource.appendByte(66)
Buffer sizedAppend = Buffer()
expect(sizedAppend.append(sizedSource, 0), 1)
expect(sizedAppend.len(), 0)
expect(sizedAppend.append(sizedSource, 2), 1)
expect(sizedAppend.len(), 2)
expect(sizedAppend.byteAt(1), 0)
expect(sizedAppend.append(sizedSource, 100), 1)
expect(sizedAppend.len(), 5)
Buffer sizedInsert = Buffer()
expect(sizedInsert.insert(0, sizedSource, 2), 1)
expect(sizedInsert.len(), 2)
expect(sizedInsert.byteAt(1), 0)
expect(sizedInsert.insert(2, sizedSource, 100), 1)
expect(sizedInsert.len(), 5)
bool sizedNegativeCaught = false
try
    sizedAppend.append(sizedSource, -2)
catch e
    if e.kind == "RangeError" then
        sizedNegativeCaught = true
    end
end
expect(sizedNegativeCaught, 1)
