import concurrent

class PoolResult
    int value = 73
end
func nextValue() as int
    return 91
end
func originalError() as error
    try
        throw ValueError("owned error result")
    catch ValueError value
        return value
    end
end

auto pool = TaskPool(2, 64)
auto logical = pool.submit(func() as bool
    return true
end)
auto narrow = pool.submit(func() as uint8
    return 255
end)
auto nativeInt = pool.submit(func() as c_int
    return c_int(37)
end)
auto real32 = pool.submit(func() as float32
    return float32(1.5)
end)
auto real64 = pool.submit(func() as float
    return 2.5
end)
auto scalar = pool.submit(func() as char
    return '你'
end)
auto clock = pool.submit(func() as time
    return #12:34:56#
end)
auto binary = pool.submit(func() as bytes
    return b"a\x00\xffb"
end)
auto object = pool.submit(func() as PoolResult
    return PoolResult()
end)
auto arrayResult = pool.submit(func() as array<int>
    return [31, 32]
end)
auto errorResult = pool.submit(func() as error
    return originalError()
end)
auto closureResult = pool.submit(func() as func() as int
    return nextValue
end)
auto ready = Promise::<int>()
assert ready.tryResolve(87)
auto nested = pool.submit(func() as future<int>
    return ready.future
end)
auto nullable = pool.submit(func() as int?
    return null
end)
auto map = SlotMap::<int>()
auto key = map.insert(44)
auto nativeKey = pool.submit(func() as SlotMapKey
    return key
end)
pool.close()
assert pool.wait(10000)
assert await logical
assert (await narrow) == 255
assert (await nativeInt) == c_int(37)
assert (await real32) == float32(1.5)
assert (await real64) == 2.5
assert (await scalar) == '你'
assert (await clock) == #12:34:56#
assert (await binary) == b"a\x00\xffb"
auto observedObject = await object
assert observedObject.value == 73
auto observedArray = await arrayResult
assert observedArray.length == 2 and observedArray[1] == 32
auto observedError = await errorResult
assert observedError.message == "owned error result"
auto observedClosure = await closureResult
assert observedClosure() == 91
auto nestedFuture = await nested
assert (await nestedFuture) == 87
assert (await nullable) == null
auto observedKey = await nativeKey
assert observedKey == key
assert pool.snapshot().failed == 0
println("TaskPool owned result profiles: scalar/C/nullable/bytes/class/array/error/closure/Future/native key ok")
