import concurrent

func worker(Once once, AtomicInt64 count, Event ready, Event release) as func() as int
    return func() as int
        once.run(func()
            count.fetchAdd(1)
        end)
        ready.set()
        if not release.wait(10000)
            return 1
        end
        return 0
    end
end

auto once = Once()
auto count = AtomicInt64()
auto firstReady = Event()
auto secondReady = Event()
auto release = Event(true)
auto first = thread(worker(once, count, firstReady, release))
auto second = thread(worker(once, count, secondReady, release))
bool ready = firstReady.wait(10000) and secondReady.wait(10000)
// Always release before assertions so a failed assertion cannot strand workers.
release.set()
bool joined = first.waitTimeout(30000) and second.waitTimeout(30000)
assert ready and joined
assert first.exitCode() == 0 and second.exitCode() == 0
assert count.load() == 1, "two threads share one initializer"
println("once and event thread sharing ok")
