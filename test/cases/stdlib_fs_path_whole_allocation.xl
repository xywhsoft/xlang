extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()
string filePath = "build/test/fs-path-whole-oom.txt"
assert file.writeText(filePath, "a\0你", 2, 0, true)
int failures = 0
int successes = 0
for operation in range(6)
    for point in range(48)
        bool caught = false
        assert failAfter(uint64(point))
        try
            if operation == 0 then
                auto parts = path.parse("/tmp/你.txt", 1)
                string name = parts.name
            elseif operation == 1 then
                auto iterator = path.components("/a/b", 1)
                for item in iterator
                    if item != null then
                        string name = item.text
                    end
                end
            elseif operation == 2 then
                path.build(["/a", "你", "..", "b"], 1)
            elseif operation == 3 then
                file.readBytes(filePath)
            elseif operation == 4 then
                file.readText(filePath)
            else
                file.writeTextAtomic(filePath, "a\0你", 2, 0, true)
            end
        catch MemoryError
            caught = true
        end
        bool triggered = failTriggered()
        failClear()
        assert caught == triggered
        if caught then failures += 1 else successes += 1 end
    end
end
assert failures > 0 and successes > 0
assert file.readText(filePath) == "a\0你"
assert file.delete(filePath)
