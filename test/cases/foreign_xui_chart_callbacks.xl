import xui
from xui import CallbackChartHit, CallbackWidget, Chart, Context, Font, Proxy, Rect, Surface

extern "fixtureRenderProxy" @header("test/cases/foreign_xui_render_backend.h") @no_raise @c_result("owned_view") @factory(0,0,dropProxy) func cpuProxy() as Proxy
extern "fixtureRenderSurface" @no_raise @c_result("owned_view") @factory(1,0,dropSurface) func cpuSurface(Proxy proxy) as Surface
extern "fixtureRenderFont" @no_raise @c_result("owned_view") @factory(1,0,dropFont) func cpuFont(Proxy proxy) as Font
extern "fixtureRenderBalanced" @no_raise func balanced() as c_int
extern "fixtureRenderBudget" @no_raise func budget(c_int allowance)
extern "fixtureRenderSawText" @no_raise @c_cstr(0) func sawText(string text) as c_int
extern "fixtureRenderResetText" @no_raise func resetText()
extern "xuiProxyReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropProxy(Proxy value)
extern "xuiSurfaceReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropSurface(Surface value)
extern "xuiFontReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropFont(Font value)

func checkTooltip(Chart chart,Context ui,Surface target)
    int calls = 0
    CallbackWidget? saved = null
    string prefix = string.repeat("a",126)
    chart.setTooltipProvider(func(CallbackWidget sender,c_int series,c_int item) as string
        assert series == 0 and item == 0, "tooltip indices"
        saved = sender
        calls += 1
        return prefix + "尾"
    end)
    xui.ChartTooltipProc candidate = func(CallbackWidget sender,c_int series,c_int item) as string
        return "incorrect replacement"
    end
    bool rejected = false
    budget(0)
    try
        chart.setTooltipProvider(candidate)
    catch Error
        rejected = true
    finally
        budget(-1)
    end
    assert rejected, "replacement allocation must fail"
    ui.render(target)
    assert calls > 0, "tooltip dispatched"
    assert sawText(prefix) != 0 and sawText("incorrect replacement") == 0, "owned tooltip UTF-8 clipping"
    bool expired = false
    try
        (saved as CallbackWidget).rect()
    catch StateError
        expired = true
    end
    assert expired, "tooltip sender expires"

    chart.setTooltipProvider(func(CallbackWidget sender,c_int series,c_int item) as string
        chart.setTooltipProvider(null)
        return "stale tooltip"
    end)
    resetText()
    ui.render(target)
    assert sawText("stale tooltip") == 0, "self-cleared tooltip cannot paint"
    ui.render(target)
    assert sawText("Samples 2.00") != 0, "default tooltip resumes"

    chart.setTooltipProvider(func(CallbackWidget sender,c_int series,c_int item) as string
        throw RuntimeError "chart tooltip failure"
    end)
    bool raised = false
    try
        ui.render(target)
    catch RuntimeError error
        raised = error.message == "chart tooltip failure"
    end
    assert raised, "tooltip error reaches the render boundary"
    chart.setTooltipProvider(null)
end

func showContextMenu(Context ui)
    assert ui.inputKeyDown(xui.XUI_KEY_CONTEXT_MENU,0) == 0, "queue menu key down"
    assert ui.dispatchPendingEvents() == 0, "dispatch menu key down"
    assert ui.inputKeyUp(xui.XUI_KEY_CONTEXT_MENU,0) == 0, "queue menu key up"
    assert ui.dispatchPendingEvents() == 0, "dispatch menu key up"
end

func checkContextMenu(Chart chart,Context ui)
    int calls = 0
    CallbackChartHit? saved = null
    c_int hitWidth = 0
    chart.setContextMenu(func(CallbackWidget sender,CallbackChartHit hit,c_float x,c_float y) as c_int
        assert hit.part == xui.XUI_CHART_HIT_SERIES and hit.series == 0 and hit.item == 0, "keyboard menu hit"
        auto hitRect = hit.rect
        hitWidth = hitRect.fW
        saved = hit
        calls += 1
        chart.setContextMenu(null)
        return 1
    end)
    showContextMenu(ui)
    showContextMenu(ui)
    assert calls == 1 and hitWidth > 0, "menu dispatch and self-removal"
    bool expired = false
    try
        auto item = (saved as CallbackChartHit).item
    catch StateError
        expired = true
    end
    assert expired, "menu hit expires"

    chart.setContextMenu(func(CallbackWidget sender,CallbackChartHit hit,c_float x,c_float y) as c_int
        throw RuntimeError "chart menu failure"
    end)
    bool raised = false
    try
        showContextMenu(ui)
    catch RuntimeError error
        raised = error.message == "chart menu failure"
    end
    assert raised, "context callback error reaches event dispatch"
    assert ui.inputKeyUp(xui.XUI_KEY_CONTEXT_MENU,0) == 0 and ui.dispatchPendingEvents() == 0, "reset key after failed event"

    chart.setContextMenu(func(CallbackWidget sender,CallbackChartHit hit,c_float x,c_float y) as c_int
        chart.close()
        return 1
    end)
    showContextMenu(ui)
    bool closed = false
    try
        chart.getSeriesCount()
    catch StateError
        closed = true
    end
    assert closed, "closed chart fails checked access"
end

func main(...) as int
    auto proxy = cpuProxy()
    auto target = cpuSurface(proxy)
    auto font = cpuFont(proxy)
    auto ui = xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
    ui.setDefaultFont(font)
    ui.setViewportSize(400,260)
    auto chart = ui.chartNative()
    Rect bounds
    bounds.fW = 400
    bounds.fH = 260
    assert chart.setRect(bounds) == 0 and ui.setRootWidget(chart) == 0, "chart bounds and root"
    chart.setFont(font)
    chart.setLegendVisible(0)
    chart.setTooltipVisible(1)
    c_int series = chart.addSeries(xui.XUI_CHART_SERIES_LINE,"Samples")
    chart.setSeriesData(series,[0,1,2],[2,5,3])
    chart.setViewRange(-1,3,0,8)
    assert ui.layout() == 0 and ui.setFocusWidget(chart) == 0, "chart layout and focus"
    auto pixel = chart.dataToPixel(0,2)
    assert ui.inputPointerMove(c_int(pixel.fX),c_int(pixel.fY),0) == 0 and ui.dispatchPendingEvents() == 0, "hover first point"
    checkTooltip(chart,ui,target)
    checkContextMenu(chart,ui)
    ui.close()
    font.close()
    target.close()
    proxy.close()
    assert balanced() != 0, "owned test resources retire"
    println("XUI_CHART_CALLBACKS_OK")
    return 0
end
