int methodCleanup = 0
func coreMethods(array<int> values) as int
    try
        assert values.capacity() >= 2
        assert values.reserve(16)
        assert values.swap(0, 1)
        assert values.reverse()
        assert values.insert(1, 9)
        assert values.indexOf(9) == 1
        assert values.removeValue(9)
        assert not values.removeValue(99)
        assert values.indexOf(99) == -1
        assert values.trim()
        return values[0] + values[1]
    finally
        methodCleanup += 1
    end
end
func textMethods(array<string> values) as int
    assert values.indexOf("a\0你") == 0
    assert values.indexOf("a") == -1
    assert values.insert(1, "b\0c")
    assert values.indexOf("b\0c") == 1
    assert values.removeValue("b\0c")
    assert values.reverse()
    assert values.swap(0, 1)
    assert values[0] == "a\0你"
    return 5
end
func clearMethods(array<int> values) as int
    assert values.clear()
    assert values.length == 0
    assert values.trim()
    return values.capacity()
end
array<int> numbers = array[1, 2]
assert coreMethods(numbers) == 3
assert methodCleanup == 1
assert numbers[0] == 1 and numbers[1] == 2
array<string> texts = array["a\0你", "z"]
assert textMethods(texts) == 5
int caught = 0
try
    numbers.reserve(-1)
catch RangeError failure
    caught += 1
end
try
    numbers.insert(-1, 3)
catch RangeError failure
    caught += 1
end
try
    numbers.swap(0, 9)
catch RangeError failure
    caught += 1
end
assert caught == 3
assert numbers[0] == 1 and numbers.length == 2
assert clearMethods(numbers) == 0
println("Array resident methods ok")
