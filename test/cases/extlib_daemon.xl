import daemon

func holdInScope(string pidPath)
    auto local = daemon.create("scoped")
    assert local.writePidFile(pidPath)
    assert file.exists(pidPath)
end

func main(...) as int
    auto d = daemon.create("测试服务")
    assert d.valid
    assert d.name == "测试服务"
    assert d.pid > 0
    assert daemon.isAlive(d.pid)
    assert not d.stopRequested
    assert not d.holdsPidFile

    string pidPath = path.join(path.temp(), "xl-daemon-测试-" + string(d.pid) + ".pid")
    assert d.writePidFile(pidPath)
    assert d.holdsPidFile
    assert daemon.readPidFile(pidPath) == d.pid
    assert d.writePidFile(pidPath)

    d.requestStop()
    assert d.stopRequested
    assert d.releasePidFile()
    assert not d.holdsPidFile
    assert not file.exists(pidPath)
    assert daemon.readPidFile(pidPath) == -1
    holdInScope(pidPath)
    assert not file.exists(pidPath)
    return 0
end
