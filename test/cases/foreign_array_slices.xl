func oneBudget(array<string> values,array<uint64> tags,c_int allowance) as int
 int success=0
 int before=calls()
 budget(allowance)
 try
  textSlices(values,tags)
  success=1
 catch error
  endBudget()
  assert calls()==before
  success=0
 finally
  endBudget()
 end
 return success
end

func main(...) as int
 string first="a\0b"
 string second="你好"
 string last=""
 array<string> texts=[first,second,last]
 array<uint64> tags=[uint64(18446744073709551615),uint64(2),uint64(3)]
 rememberStorage(texts,c_int(0))
 textSlices(texts,tags)
 packed(c_int(7),texts,tags)
 textSlices(texts,tags,0)
 textSlices(texts,tags,99)
 array<uint64> shortTags=[uint64(18446744073709551615)]
 int before=calls()
 bool rejected=false
 try
  textSlices(texts,shortTags)
 catch error
  rejected=true
 end
 assert rejected and calls()==before
 textSlices(texts,shortTags,99)
 before=calls()
 rejected=false
 try
  textSlices(texts,tags,-2)
 catch error
  rejected=true
 end
 assert rejected and calls()==before
 auto callback=func() as c_int
  bool blocked=false
  try
   texts[0]="changed"
  catch error
   blocked=true
  end
  assert blocked
  assert texts[0]==first
  return c_int(0)
 end
 reenter(texts,tags,-1,callback)
 auto failedCallback=func() as c_int
  throw "array slice callback failure"
  return c_int(0)
 end
 rejected=false
 try
  reenter(texts,tags,-1,failedCallback)
 catch error
  rejected=true
 end
 assert rejected
 texts[0]=first
 rememberStorage(texts,c_int(0))
 failNative(c_int(1))
 rejected=false
 try
  textSlices(texts,tags)
 catch error
  rejected=true
 finally
  endBudget()
 end
 assert rejected
 assert oneBudget(texts,tags,c_int(-1))==1
 oneBudget(texts,tags,c_int(0))
 int failures=0
 int successes=0
 for allowance in range(32)
  beginHeap()
  int success=oneBudget(texts,tags,c_int(allowance))
  balanced()
  successes+=success
  failures+=1-success
 end
 assert failures>0 and successes>0
 beginHeap()
 for iteration in range(1000)
  textSlices(texts,tags)
 end
 reportHeap(c_int(0))
 balanced()
 nativeHot()
 bytes binary=b"\0\xffz"
 bytes other=b"\x80"
 bytes empty=b""
 array<bytes> data=[binary,other,empty]
 rememberStorage(data,c_int(1))
 byteSlices(data,tags)
 println("Array slices: exact bytes/length/sizeof, original pointers, uint64 count, scoped pins, checked errors and OOM passed")
 return 0
end
