func oneBudget(array<string> names,array<c_int> values,c_int allowance) as bool
 int before=calls()
 bool success=false
 budget(allowance)
 try
  assert consume(c_int(7),names,values,-1,names,values,-1)==c_int(49)
  success=true
 catch error
  budget(c_int(-1))
  assert calls()==before
 finally
  budget(c_int(-1))
 end
 return success
end
func oneViewBudget(array<Owned?> objects,array<bytes> data,func() as c_int callback,c_int allowance) as bool
 int before=calls()
 bool success=false
 budget(allowance)
 try
  assert views(objects,data,-1,callback)==c_int(382)
  success=true
 catch error
  budget(c_int(-1))
  assert calls()==before
 finally
  budget(c_int(-1))
 end
 return success
end
func main(...) as int
 array<string> names=["a","xyz"]
 array<c_int> values=[c_int(8),c_int(9)]
 assert consume(c_int(7),names,values,-1,names,values,-1)==c_int(49)
 assert consume(c_int(7),names,values,0,names,values,0)==c_int(7)
 assert nested(c_int(3),names,values)==c_int(24)
 assert nested(c_int(3),names,values,99)==c_int(24)
 assert nested(c_int(3),names,values,1)==c_int(12)
 assert mixed(c_int(5),names,values,-1,[c_int(2),c_int(3)])==c_int(31)
 func(c_int,array<string>,array<c_int>,int,array<string>,array<c_int>,int) as c_int stored=consume
 assert stored(c_int(7),names,values,-1,names,values,-1)==c_int(49)
 func erased=stored
 assert erased(c_int(7),names,values,-1,names,values,-1)==c_int(49)
 Receiver root=receiver()
 assert root.inspect(names,values,-1)==c_int(121)
 assert root.fieldInspect(names,values,-1)==c_int(121)
 func(array<string>,array<c_int>,int) as c_int bound=root.inspect
 assert bound(names,values,-1)==c_int(121)
 func(array<string>,array<c_int>,int) as c_int fieldBound=root.fieldInspect
 assert fieldBound(names,values,-1)==c_int(121)
 auto callback=func() as c_int
  bool blocked=false
  try
   names[0]="mutated"
  catch error
   blocked=true
  end
  assert blocked
  blocked=false
  try
   values.clear()
  catch error
   blocked=true
  end
  assert blocked
  return c_int(0)
 end
 assert reenter(names,values,-1,callback)==c_int(21)
 int before=calls()
 bool rejected=false
 try
  nested(c_int(3),names,values,-2)
 catch error
  rejected=true
 end
 assert rejected and calls()==before
 array<c_int> shortValues=[c_int(8)]
 rejected=false
 try
  nested(c_int(3),names,shortValues)
 catch error
  rejected=true
 end
 assert rejected and calls()==before
 assert nested(c_int(3),names,shortValues,99)==c_int(12)
 names[0]="a\0b"
 before=calls()
 rejected=false
 try
  consume(c_int(7),names,values,-1,names,values,-1)
 catch error
  rejected=true
 end
 assert rejected and calls()==before
 names[0]="a"
 before=calls()
 rejected=false
 try
  checkedConsume(c_int(-1),names,values,-1,names,values,-1)
 catch error
  rejected=true
 end
 assert rejected and calls()==before+1
 names[0]="after error"
 names[0]="a"
 assert checkedConsume(c_int(7),names,values,-1,names,values,-1)==c_int(49)
 budget(c_int(-1))
 oneBudget(names,values,c_int(-1))
 int successAt=-1
 int attempt=0
 while attempt<32
  mark()
  bool success=oneBudget(names,values,c_int(attempt))
  assert balanced()==c_int(1)
  if success then
   successAt=attempt
   break
  end
  attempt+=1
 end
 assert successAt>=2
 int repeat=0
 while repeat<3
  attempt=0
  while attempt<=successAt
   mark()
   bool success=oneBudget(names,values,c_int(attempt))
   assert success==(attempt==successAt) and balanced()==c_int(1)
   attempt+=1
  end
  repeat+=1
 end
 mark()
 int round=0
 while round<1000
  assert consume(c_int(7),names,values,-1,names,values,-1)==c_int(49)
  round+=1
 end
 reportHeap(c_int(0))
 nativeHot()
 Owned first=createOwned(c_int(10))
 Owned last=createOwned(c_int(20))
 array<Owned?> objects=[first,null,last]
 array<bytes> data=[b"\0\xffz",b"",b""]
 remember(c_int(0),data[0])
 remember(c_int(1),data[1])
 remember(c_int(2),data[2])
 auto noChange=func() as c_int
  return c_int(0)
 end
 assert views(objects,data,-1,noChange)==c_int(407)
 // Null remains distinct from a live native object; byte NUL/0xff are exact.
 data[0]=b"\0\xffa"
 remember(c_int(0),data[0])
 assert views(objects,data,-1,noChange)==c_int(382)
 oneViewBudget(objects,data,noChange,c_int(-1))
 int viewSuccess=-1
 attempt=0
 while attempt<64
  mark()
  bool success=oneViewBudget(objects,data,noChange,c_int(attempt))
  assert balanced()==c_int(1) and live()==c_int(2)
  if success then
   viewSuccess=attempt
   break
  end
  attempt+=1
 end
 assert viewSuccess>=2
 repeat=0
 while repeat<3
  attempt=0
  while attempt<=viewSuccess
   mark()
   bool success=oneViewBudget(objects,data,noChange,c_int(attempt))
   assert success==(attempt==viewSuccess) and balanced()==c_int(1) and live()==c_int(2)
   attempt+=1
  end
  repeat+=1
 end
 auto releaseWhileActive=func() as c_int
  first.close()
  last.close()
  bool blocked=false
  try
   data.clear()
  catch error
   blocked=true
  end
  assert blocked
  return c_int(0)
 end
 assert views(objects,data,-1,releaseWhileActive)==c_int(382)
 assert live()==c_int(0)
 before=calls()
 rejected=false
 try
  views(objects,data,-1,noChange)
 catch error
  rejected=true
 end
 assert rejected and calls()==before
 println("DESCRIPTOR_ARRAYS_OK ",successAt," ",viewSuccess)
 return 0
end
