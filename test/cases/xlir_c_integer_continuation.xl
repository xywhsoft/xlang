// Native arithmetic uses the same checked outcome in all execution machines.
async func readyNative(c_int value) as c_int
 return value
end
async func addNative(c_int value) as c_int
 c_int resumed=await readyNative(value)
 return resumed+c_int(1)
end
async func divideNative(c_int value,c_int divisor) as c_int
 c_int resumed=await readyNative(value)
 return resumed/divisor
end
func nativeSequence(c_int value) as generator<int>
 yield int(value)
 yield int(value+c_int(1))
end

assert await addNative(c_int(41))==c_int(42)
assert await divideNative(c_int(42),c_int(2))==c_int(21)
int errors=0
try
 auto rejected=await addNative(c_int(2147483647))
catch error
 errors+=1
end
try
 auto rejected=await divideNative(c_int(1),c_int(0))
catch error
 errors+=1
end
int count=0
for value in nativeSequence(c_int(7))
 assert value==c_int(7+count)
 count+=1
end
assert count==2
count=0
try
 for value in nativeSequence(c_int(2147483647))
  assert value==c_int(2147483647)
  count+=1
 end
catch OverflowError error
 errors+=1
end
assert errors==3 and count==1
println("Checked native integer async and generator outcomes passed")
export "native_continuation_count" func completionCount() as int
 return count
end
func main(...) as int
 return 0
end
