extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

time dateValue = time.fromDate(2026, 6, 18)
time clockValue = time.fromTime(12, 30, 59)
time dateTime = time.fromDateTime(2026, 6, 18, 12, 30, 59)
time defaultTime = time.fromDateTime(2026, 6, 18)
time currentDateTime = time.now()
time currentDate = time.today()
uint64 currentClock = time.clock()
time parsed = time.parse("2026-06-18 12:30:59")
time parsedPattern = time.parsePattern("2026/06/18 12:30:59", "%Y/%m/%d %T")
auto tryParsedOk, tryParsed = time.tryParse("2026-06-18 12:30:59")
auto tryZeroOk, tryZero = time.tryParse("00:00:00")
auto tryBadOk, _ = time.tryParse("bad")
auto tryPatternOk, tryPattern = time.tryParsePattern("2026/06/18 12:30:59", "%Y/%m/%d %T")
auto tryPatternBadOk, _ = time.tryParsePattern("bad", "%Y/%m/%d")
string formattedPattern = time.formatPattern(dateTime, "%Y/%m/%d %T")
time compactPattern = time.parsePattern("2026/6/8 3:4:5", "%Y/%-m/%-d %-H:%-M:%-S")
time twelveHourPattern = time.parsePattern(
    "Monday, June 8, 2026 3:04 pm",
    "%A, %B %-d, %Y %-I:%M %P")
string compactFormatted = time.formatPattern(
    #2026-06-08 03:04:05#,
    "%Y/%-m/%-d %-H:%-M:%-S")
string namedFormatted = time.formatPattern(
    #2026-06-08 15:04:05#,
    "%A, %B %-d, %Y %-I:%M %P %q")

expect(dateValue == #2026-06-18#, 1)
expect(clockValue == #12:30:59#, 1)
expect(dateTime == #2026-06-18 12:30:59#, 1)
expect(defaultTime == #2026-06-18#, 1)
expect(time.year(currentDateTime) >= 1970, 1)
expect(time.year(currentDate) >= 1970, 1)
expect(time.monotonic() >= currentClock, 1)
expect(parsed == dateTime, 1)
expect(parsedPattern == dateTime, 1)
expect(tryParsedOk, 1)
expect(tryParsed == dateTime, 1)
expect(tryZeroOk, 1)
expect(tryZero == #00:00:00#, 1)
expect(tryBadOk, 0)
expect(tryPatternOk, 1)
expect(tryPattern == dateTime, 1)
expect(tryPatternBadOk, 0)
expectStr(formattedPattern, "2026/06/18 12:30:59")
expect(compactPattern == #2026-06-08 03:04:05#, 1)
expect(twelveHourPattern == #2026-06-08 15:04:00#, 1)
expectStr(compactFormatted, "2026/6/8 3:4:5")
expectStr(namedFormatted, "Monday, June 8, 2026 3:04 pm 2")

expect(time.year(dateTime), 2026)
expect(time.month(dateTime), 6)
expect(time.day(dateTime), 18)
expect(time.hour(dateTime), 12)
expect(time.minute(dateTime), 30)
expect(time.second(dateTime), 59)
expect(time.weekday(dateTime) >= 0, 1)
expect(time.weekday(time.fromDate(2026, 7, 8)), 3)
expect(time.weekday(time.fromDate(2026, 7, 5)), 0)
expect(time.weekday(time.fromDate(2026, 1, 1)), 4)
expect(time.dayOfYear(dateTime), 169)
expect(time.quarter(dateTime), 2)

expect(time.datePart(dateTime) == #2026-06-18#, 1)
expect(time.timePart(dateTime) == int(#12:30:59#), 1)

time nextDay = time.addDays(dateTime, 1)
time nextMonth = time.addMonths(dateTime, 1)
time nextYear = time.addYears(dateTime, 1)
time nextHour = time.addHours(dateTime, 1)
time nextMinute = time.addMinutes(dateTime, 1)
time nextSecond = time.addSeconds(dateTime, 1)
time nextWeek = time.addWeeks(dateTime, 1)
time nextQuarter = time.addQuarters(dateTime, 1)

expect(time.day(nextDay), 19)
expect(time.month(nextMonth), 7)
expect(time.year(nextYear), 2027)
expect(time.hour(nextHour), 13)
expect(time.minute(nextMinute), 31)
expect(time.second(nextSecond), 0)
expect(time.day(nextWeek), 25)
expect(time.month(nextQuarter), 9)

expect(time.isSameDay(dateTime, nextHour), 1)
expect(time.isSameMonth(dateTime, nextDay), 1)
expect(time.isSameYear(dateTime, nextMonth), 1)
expect(time.inRange(dateTime, #2026-06-18#, #2026-06-19#), 1)
expect(time.diffYears(dateTime, nextYear), 1)
expect(time.diffMonths(dateTime, nextYear), 12)
expect(time.diffDays(dateTime, nextDay), 1)
expect(time.diffHours(dateTime, nextHour), 1)
expect(time.diffMinutes(dateTime, nextMinute), 1)
expect(time.diffSeconds(dateTime, nextSecond), 1)
expect(time.diffWeeks(dateTime, nextWeek), 1)
expect(time.diffQuarters(dateTime, nextYear), 4)
