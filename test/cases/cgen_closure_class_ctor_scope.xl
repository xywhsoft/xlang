class Box
    int value = 0

    create(int value)
        self.value = value
    end
end

func makeReader() as func(int) as int
    return func(int input) as int
        Box box = Box(input)
        return box.value
    end
end

func(int) as int reader = makeReader()
assert reader(42) == 42
println("closure class ctor scope ok")
