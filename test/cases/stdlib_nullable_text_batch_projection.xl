func main(...) as int
    string? empty = ""
    string? text = "a\0b"
    SpscQueue<string?> queue = SpscQueue::<string?>(4)
    array<string?> inputs = array<string?>[null, empty, text]
    auto pushStatus, pushed = queue.pushBatch(inputs)
    assert(pushStatus == queueStatus.ok and pushed == 3)
    auto firstStatus, first = queue.popBatch(2)
    assert(firstStatus == queueStatus.ok and first.length == 2 and first[0] == null and first[1] == empty)
    assert(first[1] != null)
    auto secondStatus, output = queue.popBatch(4)
    assert(secondStatus == queueStatus.ok)
    assert(output.length == 1 and output[0] == text)
    auto zeroStatus, zero = queue.popBatch(0)
    assert(zeroStatus == queueStatus.ok and zero.length == 0)
    assert(first.length == 2 and output.length == 1 and output[0] == text)
    return 0
end
