class GraphCloneRestoreChild
    derive value
    derive clone
    dict<string> words = {"a\0你": "v\0b", "": ""}
    dict<string> alias = {}
    dict<string> hidden @persist(skip) = {"secret\0": "saved\0你"}
end
GraphCloneRestoreChild shared = GraphCloneRestoreChild()
shared.alias = shared.words
class GraphCloneRestoreEnvelope
    derive value
    GraphCloneRestoreChild child = shared
end
GraphCloneRestoreEnvelope restored = json.parse::<GraphCloneRestoreEnvelope>("{\"child\":{\"words\":{\"a\\u0000你\":\"restored\"}}}")
assert(restored.child.words["a\0你"] == "restored")
assert(restored.child.alias["a\0你"] == "v\0b")
restored.child.hidden["secret\0"] = "restored hidden"
assert(shared.hidden["secret\0"] == "saved\0你" and shared.words["a\0你"] == "v\0b")
GraphCloneRestoreEnvelope restoredXlon = xlon.parse::<GraphCloneRestoreEnvelope>("{\"child\":{\"words\":{\"a\\u0000你\":\"xlon restored\"}}}")
assert(restoredXlon.child.words["a\0你"] == "xlon restored")
assert(shared.words["a\0你"] == "v\0b")
