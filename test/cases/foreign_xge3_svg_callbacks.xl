// Failed providers preserve the original language error and cannot populate a cache.
import xge
from xge import ResourcePath,ResourceOutput
class Provider
 bool fail=true
 int calls=0
 ResourceOutput? saved=null
end

func checkPackedSvg()
 string source="<svg width='7' height='9'><rect id='tile' width='7' height='9'/></svg>"
 int reads=0
 auto cache=xge.createSvgCache()
 xge.addXPackProvider("svg-assets",func(ResourcePath path,ResourceOutput output) as c_int
  assert path.text=="svg-assets/drawing.svg"
  reads+=1
  output.set(source)
  return c_int(0)
 end)
 try
  auto resource=xge.loadResource("res:///drawing.svg")
  bytes encoded=resource.bytes
  resource.close()
  auto document=cache.load("res:///drawing.svg")
  auto shared=document.share()
  auto paint=shared.getPaintByName("tile")
  document.close()
  cache.close()
  xge.resourceProviderClear()
  try
   assert reads==2 and shared.refCountGet()==1
   assert paint.getName()=="tile" and paint.getDocument().refCountGet()==1
   auto independent=xge.createSvg()
   try
    independent.loadMemory(encoded)
    auto width,height=independent.getSize()
    assert width==c_float(7) and height==c_float(9)
   finally
    independent.close()
   end
   shared.clear()
   bool expired=false
   try
    paint.getId()
   catch StateError
    expired=true
   end
   assert expired
  finally
   shared.close()
  end
 finally
  cache.close()
  xge.resourceProviderClear()
 end
end

func main(...) as int
 auto provider=Provider()
 xge.addResourceProvider("svgcallback",func(ResourcePath path,ResourceOutput output) as c_int
  provider.calls+=1
  provider.saved=output
  output.set("<svg width='7' height='9'><rect width='7' height='9'/></svg>")
  if provider.fail then throw RuntimeError "SVG provider failed" end
  return c_int(0)
 end)
 auto drawing=xge.createSvg()
 auto cache=xge.createSvgCache()
 try
  bool rejected=false
  try
   drawing.load("svgcallback://drawing")
  catch error
   rejected=error.message=="SVG provider failed"
  end
  assert rejected and provider.calls==1
  rejected=false
  try
   auto unused=cache.load("svgcallback://cached")
  catch error
   rejected=error.message=="SVG provider failed"
  end
  assert rejected and provider.calls==2
  rejected=false
  try
   auto expired=provider.saved as ResourceOutput
   expired.set("late write")
  catch StateError
   rejected=true
  end
  assert rejected
  provider.saved=null
  provider.fail=false
  auto retry=cache.load("svgcallback://cached")
  assert provider.calls==3
  auto width,height=retry.getSize()
  assert width==c_float(7) and height==c_float(9)
  auto hit=cache.load("svgcallback://cached")
  assert provider.calls==3
  retry.close()
  cache.close()
  auto retainedWidth,retainedHeight=hit.getSize()
  assert retainedWidth==width and retainedHeight==height
  hit.close()
  drawing.load("svgcallback://drawing")
  assert provider.calls==4
 finally
  provider.saved=null
  cache.close()
  drawing.close()
  xge.resourceProviderClear()
 end
 checkPackedSvg()
 assert xge.graphicsResourceCount()==uint64(0)
 println("SVG provider errors, expired outputs and failed-cache retry passed")
 return 0
end
