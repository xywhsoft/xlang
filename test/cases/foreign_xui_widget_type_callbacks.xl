import xui
from xui import CallbackWidget,CallbackWidgetTypeData,CallbackWidgetCreateData,CallbackVec2,CallbackDrawContext,WidgetType,Vec2,Rect

extern "fixtureRenderProxy" @header("test/cases/foreign_xui_render_backend.h") @no_raise @c_result("owned_view") @factory(0,0,dropProxy) func cpuProxy() as xui.Proxy
extern "fixtureRenderSurface" @no_raise @c_result("owned_view") @factory(1,0,dropSurface) func cpuSurface(xui.Proxy proxy) as xui.Surface
extern "xuiProxyReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropProxy(xui.Proxy value)
extern "xuiSurfaceReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropSurface(xui.Surface value)
extern "fixtureRenderBudget" @no_raise func budget(c_int allowance)
extern "fixtureRenderBalanced" @no_raise func balanced() as c_int

func main(...) as int
    auto proxy=cpuProxy()
    auto ui=xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
    auto target=cpuSurface(proxy)
    auto plain=ui.registerWidgetTypeWithCallbacks("test.withoutCallbacks")
    assert ui.findWidgetType("test.withoutCallbacks")!=null
    plain.unregister()
    assert ui.findWidgetType("test.withoutCallbacks")==null
    c_int initialized=0
    c_int destroyed=0
    c_int measured=0
    c_int prepared=0
    c_int arranged=0
    c_int completed=0
    c_int rendered=0
    c_int updated=0
    c_int queried=0
    CallbackWidget? saved=null
    auto init=func(CallbackWidget w,CallbackWidgetTypeData? data,CallbackWidgetCreateData? input) as c_int
        assert data==null and input==null
        initialized+=1
        saved=w
        return 0
    end
    auto destroy=func(CallbackWidget w,CallbackWidgetTypeData? data)
        assert data==null
        destroyed+=1
    end
    auto measure=func(CallbackWidget w,Vec2 constraint,CallbackVec2 output) as c_int
        measured+=1
        output.fX=24
        output.fY=32
        return 0
    end
    auto prepare=func(CallbackWidget w) as c_int
        prepared+=1
        return 0
    end
    auto arrange=func(CallbackWidget w,Rect content) as c_int
        arranged+=1
        return 0
    end
    auto complete=func(CallbackWidget w,Rect content) as c_int
        completed+=1
        return 0
    end
    auto render=func(CallbackWidget w,CallbackDrawContext draw,c_uint state) as c_int
        rendered+=1
        return 0
    end
    auto update=func(CallbackWidget w,c_float delta) as c_int
        updated+=1
        return 0
    end
    auto cursor=func(CallbackWidget w,c_int x,c_int y) as c_int
        queried+=1
        return xui.XUI_CURSOR_HAND
    end

    // Failures while creating the group or publishing the view leave no type.
    bool admitted=false
    for allowance in range(0,64)
        WidgetType? temporary=null
        budget(c_int(allowance))
        try
            temporary=ui.registerWidgetTypeWithCallbacks("test.temporary",null,0,init)
        catch error
        end
        budget(-1)
        if temporary!=null then
            (temporary as WidgetType).unregister()
            admitted=true
            break
        end
        assert ui.findWidgetType("test.temporary")==null
    end
    assert admitted

    auto kind=ui.registerWidgetTypeWithCallbacks("test.callback",null,0,init,destroy,measure,prepare,arrange,complete,render,update,cursor)
    auto derived=ui.registerWidgetType("test.derived",kind)
    auto widget=ui.createWidget(derived)
    assert initialized==1 and saved!=null
    bool expired=false
    try
        (saved as CallbackWidget).rect()
    catch error
        expired=true
    end
    assert expired
    auto constraint=Vec2()
    constraint.fX=100
    constraint.fY=100
    auto size=widget.measureContent(constraint)
    assert size.fX==24 and size.fY==32 and measured>0
    widget.setLayoutType(xui.XUI_LAYOUT_OVERLAY)
    assert widget.addChild(ui.widget())==0
    assert ui.setRootWidget(widget)==0
    ui.setViewportSize(64,64)
    assert ui.layout()==0
    assert ui.update(0.25)==0 and updated>0
    assert ui.queryCursor(8,8)==xui.XUI_CURSOR_HAND and queried>0
    ui.render(target)
    assert prepared>0 and arranged>0 and completed>0 and rendered>0
    widget.close()
    assert destroyed==1
    derived.unregister()
    kind.unregister()

    auto brokenInit=func(CallbackWidget w,CallbackWidgetTypeData? data,CallbackWidgetCreateData? input) as c_int
        throw "initialization failed"
    end
    auto badType=ui.registerWidgetTypeWithCallbacks("test.badInit",initialize=brokenInit)
    bool rejected=false
    try
        ui.createWidget(badType)
    catch error
        rejected=true
    end
    assert rejected
    badType.unregister()

    auto brokenDestroy=func(CallbackWidget w,CallbackWidgetTypeData? data)
        throw "destruction failed"
    end
    auto retiring=ui.registerWidgetTypeWithCallbacks("test.badDestroy",destroy=brokenDestroy)
    auto retiringWidget=ui.createWidget(retiring)
    rejected=false
    try
        retiringWidget.close()
    catch error
        rejected=true
    end
    assert rejected
    retiring.unregister()

    ui.close()
    target.close()
    proxy.close()
    assert balanced()==1
    println("XUI_WIDGET_TYPE_CALLBACKS_OK")
    return 0
end
