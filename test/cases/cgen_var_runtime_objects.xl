extern "expect_i64" func expect(int actual, int expected)

class Pair
    int left = 1
    int right = 2
end

class Native
    native point handle
end

func add(int left, int right) as int
    return left + right
end

func pair(int seed) as (int, int)
    return seed, seed + 1
end

func five(int seed) as (int, int, int, int, int)
    return seed, seed + 1, seed + 2, seed + 3, seed + 4
end

func pairDefault(int seed, int step = 2) as (int, int)
    return seed, seed + step
end

func optionCount(string path, ***) as int
    return arg.length
end

func totalDefault(int base = 5, ...) as int
    return base + arg.length
end

func(int, int) as int fn = add
type fnType = type(fn)
type bareFuncType = func
var boxedFn = xcall(fn)
var value = boxedFn(20, 22)

func(int) as (int, int) pairFn = pair
type pairFnType = type(pairFn)
var boxedPairFn = xcall(pairFn)
var firstPairValue = boxedPairFn(31)

func(int) as (int, int, int, int, int) fiveFn = five
var boxedFiveFn = xcall(fiveFn)
var firstFiveValue = boxedFiveFn(50)

func(int) as (int, int) defaultPairFn = pairDefault
var boxedDefaultPairFn = xcall(defaultPairFn)
var firstDefaultPairValue = boxedDefaultPairFn(40)

func(string, ***) as int optionsFn = optionCount
var boxedOptions = xcall(optionsFn)
var optionValue = boxedOptions("demo.txt", mode = "fast", retry = 3)
var optionNamedValue = boxedOptions(path = "demo.txt", mode = "slow")

func(...) as int variadicDefaultFn = totalDefault
var boxedVariadicDefault = xcall(variadicDefaultFn)
var variadicDefaultValue = boxedVariadicDefault(1, 2, 3)

expect(type(boxedFn) == fnType, 1)
expect(type(boxedFn) == func, 0)
expect(bareFuncType == func, 1)
expect(type(value) == int, 1)
expect(int(value), 42)
expect(type(boxedPairFn) == pairFnType, 1)
expect(int(firstPairValue), 31)
expect(int(firstFiveValue), 50)
expect(int(firstDefaultPairValue), 40)
expect(int(optionValue), 2)
expect(int(optionNamedValue), 1)
expect(int(variadicDefaultValue), 8)

var boxedPair = Pair()
expect(type(boxedPair) == Pair, 1)

point handle
var boxedNative = Native(handle)
expect(type(boxedNative) == Native, 1)
