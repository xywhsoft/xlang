import xui
from xui import Icon as IconModel
from xui import IconCategory as IconCategoryModel
extern "fixtureIconProxy" @header("test/cases/foreign_xui_icon_models.h") @no_raise @c_result("owned_view") @factory(0,0,dropProxy) func cpuProxy() as xui.Proxy
extern "xuiProxyReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropProxy(xui.Proxy value)
extern "fixtureIconBudget" @no_raise func budget(c_int allowance)
extern "fixtureRenderBalanced" @no_raise func backendBalanced() as c_int
extern "fixtureIconHeapBegin" @no_raise func heapBegin()
extern "fixtureIconHeapUnchanged" @no_raise func heapUnchanged() as c_int
extern "fixtureIconLiveHeapUnchanged" @no_raise func liveHeapUnchanged() as c_int
extern "fixtureIconDashes" @no_raise @c_span(0,"void*","size_t") func fillDashes(Buffer output)
extern "fixtureIconDrawStyled" @no_raise func drawStyled(xui.Context context,xui.Surface surface,IconModel icon)
extern "fixtureIconReferenceHot" @no_raise func nativeReferenceHot(xui.IconReference reference,IconModel icon)

func verifyReferences(xui.Context context,xui.Proxy proxy,IconCategoryModel category,xui.Rect box)
    auto dashes=Buffer()
    assert dashes.resize(8)
    fillDashes(dashes)
    auto icon=category.addStyledSvgPath("styled","M0 0 L16 0 L8 16 Z",box,dashes,
        fillColor=0x10A030FF,strokeColor=0x4040FFFF,strokeWidth=1.5,dashOffset=0.5,
        displayName="描边",tags="",flags=37)
    assert icon.displayName=="描边" and (icon.tags ?? "missing")=="" and icon.flags==37
    for i in range(8)
        dashes[i]=uint8(0)
    end
    assert dashes.resize(0)
    auto target=proxy.createSurfaceRGBA(16,16,flags=c_uint(xui.XUI_SURFACE_USAGE_TARGET))
    drawStyled(context,target,icon)
    target.close()
    assert icon.referenceCount==1 and category.referenceCount==1
    auto reference=icon.retain()
    assert reference.isLive() and icon.referenceCount==2
    assert icon.unregister() and category.find("styled")==null
    assert reference.isLive() and icon.name=="styled" and icon.referenceCount==1
    reference.close()
    bool expired=false
    try
        auto value=icon.referenceCount
    catch StateError
        expired=true
    end
    assert expired

    icon=category.addSvgPath("loan","M0 0 H16 V16 H0 Z",box)
    reference=icon.retain()
    budget(0)
    heapBegin()
    for i in range(1000)
        assert reference.isLive() and icon.referenceCount==2
    end
    assert heapUnchanged()==1,"language reference queries allocate nothing"
    heapBegin()
    nativeReferenceHot(reference,icon)
    assert heapUnchanged()==1,"C reference queries allocate nothing"
    budget(-1)
    reference.close()
    assert icon.referenceCount==1

    int failures=0
    int successes=0
    for allowance in range(12)
        heapBegin()
        budget(c_int(allowance))
        try
            auto candidate=icon.retain()
            candidate.close()
            successes+=1
        catch Error
            failures+=1
        finally
            budget(-1)
        end
        assert icon.referenceCount==1 and liveHeapUnchanged()==1,"reference admission rollback"
    end
    assert failures>0 and successes>0
    assert icon.unregister()
    auto source=proxy.createSurfaceRGBA(16,16)
    auto surfaceIcon=category.addSurfaceWithMetadata("surface",source,box,displayName="Surface",flags=12)
    source.close()
    assert surfaceIcon.displayName=="Surface" and surfaceIcon.flags==12
    assert surfaceIcon.intrinsicSize().fX==16
    assert surfaceIcon.unregister()

    auto custom=category.addCustomWithMetadata("custom",
        func(xui.CallbackIcon sender,xui.CallbackPainter painter,xui.Rect rectangle,xui.CallbackIconDrawDesc? style) as c_int
            return 0
        end,
        destroy=func(xui.CallbackIcon sender)
            assert sender.displayName=="Custom"
            assert false,"retained icon cleanup failure"
        end,
        displayName="Custom")
    auto customReference=custom.retain()
    assert custom.unregister()
    bool reported=false
    try
        customReference.close()
    catch AssertionError
        reported=true
    end
    assert reported,"last icon reference reports its consuming callback failure"
    auto categoryReference=category.retain()
    assert category.referenceCount==2
    assert category.unregister() and xui.findIconCategory(context,"output")==null
    assert categoryReference.isLive() and category.name=="output" and category.referenceCount==1
    categoryReference.close()
    expired=false
    try
        auto value=category.referenceCount
    catch StateError
        expired=true
    end
    assert expired
end

func main(...) as int
    auto proxy=cpuProxy()
    auto context=xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
    auto description=xui.iconCategoryDescDefault()
    auto category=xui.createIconCategory(context,"tools",description)
    assert category.name=="tools"
    assert category.count==0
    auto box=xui.Rect()
    box.fW=16
    box.fH=16
    auto icon=category.addSvgPath("triangle","M0 0 L16 0 L8 16 Z",box)
    assert icon.name=="triangle"
    assert icon.displayName=="triangle"
    assert icon.tags==null
    budget(0)
    heapBegin()
    icon.setMetadata()
    assert heapUnchanged()==1
    budget(-1)
    icon.setMetadata("三角形","绘图 三角形")
    assert icon.name=="triangle" and icon.displayName=="三角形" and (icon.tags as string)=="绘图 三角形"
    string label=icon.displayName
    auto generation=icon.generation
    string? newLabel="Updated"
    string? newTags="New tags"
    c_int metadataAllowance=0
    while metadataAllowance<2
        bool rejected=false
        budget(metadataAllowance)
        try
            icon.setMetadata(newLabel,newTags)
        catch error
            rejected=true
        end
        budget(-1)
        assert rejected and icon.generation==generation
        assert icon.displayName=="三角形" and (icon.tags as string)=="绘图 三角形"
        metadataAllowance+=1
    end
    icon.setMetadata("","")
    assert icon.displayName=="" and (icon.tags as string)==""
    bool embeddedNul=false
    try
        icon.setMetadata("new\0label")
    catch error
        embeddedNul=true
    end
    assert embeddedNul and icon.displayName==""
    icon.setMetadata()
    assert icon.displayName=="triangle" and icon.tags==null and label=="三角形"
    auto alias=category.addAlias("copy",icon)
    assert category.count==2
    assert (category.find("triangle") as IconModel).id==icon.id
    assert (category.findById(alias.id) as IconModel).name=="copy"
    assert category.find("missing")==null
    assert category.iconAt(-1)==null
    assert (category.iconAt(0) as IconModel).id==icon.id
    assert category.iconAt(2)==null
    auto byName=category.addAlias("remove-name",icon)
    auto namedId=byName.id
    category.remove("remove-name")
    assert category.findById(namedId)==null
    auto byId=category.addAlias("remove-id",icon)
    auto removedId=byId.id
    category.removeById(removedId)
    assert category.findById(removedId)==null and category.count==2
    bool removed=false
    try
        auto retired=byId.id
    catch error
        removed=true
    end
    assert removed
    assert category.description().fWidth==description.fWidth
    assert (xui.findIconCategory(context,"tools") as IconCategoryModel).name=="tools"
    assert (xui.iconCategoryAt(context,0) as IconCategoryModel).name=="tools"
    budget(0)
    heapBegin()
    c_int iteration=0
    while iteration<1000
        auto size=icon.intrinsicSize()
        assert size.fX==16 and size.fY==16
        icon.prepare()
        category.preload()
        iteration+=1
    end
    assert heapUnchanged()==1
    budget(-1)
    println("Icon model queries: 3000 zero-heap calls passed")
    bool invalid=false
    try
        icon.prepare(-1,0)
    catch error
        invalid=true
    end
    assert invalid and icon.intrinsicSize().fX==16
    string savedName=icon.name
    assert icon.unregister()
    assert category.find("triangle")==null
    assert icon.name=="triangle", "the native alias retains its unregistered target"
    assert alias.unregister()
    bool expired=false
    try
        auto gone=icon.id
    catch error
        expired=true
    end
    assert expired
    assert savedName=="triangle", "copied metadata outlives the native object"
    icon=category.addSvgPath("replacement","M0 0 L16 0 L8 16 Z",box)
    auto picker=xui.createIconPicker(context)
    picker.setCategory(category)
    picker.setSelectedId(icon.id)
    assert picker.selectedId()==icon.id
    assert (picker.selectedIcon() as IconModel).name=="replacement"
    auto other=xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
    auto otherCategory=xui.createIconCategory(other,"other",description)
    bool rejected=false
    try
        picker.setCategory(otherCategory)
    catch error
        rejected=true
    end
    assert rejected and (picker.category() as IconCategoryModel).name=="tools"
    rejected=false
    try
        auto invalid=otherCategory.addAlias("cross-context",icon)
    catch error
        rejected=true
    end
    assert rejected and otherCategory.count==0
    other.close()
    assert category.unregister()
    assert (picker.category() as IconCategoryModel).name=="tools"
    picker.setCategory()
    expired=false
    try
        auto gone=category.name
    catch error
        expired=true
    end
    assert expired
    c_int allowance=0
    int failures=0
    int successes=0
    while allowance<48
        IconCategoryModel? result=null
        rejected=false
        budget(allowance)
        try
            result=xui.createIconCategory(context,"allocation",description)
        catch error
            rejected=true
        end
        budget(-1)
        if rejected then
            failures+=1
            assert result==null
            assert xui.findIconCategory(context,"allocation")==null
        else
            successes+=1
            assert (result as IconCategoryModel).unregister()
        end
        assert context.iconCategoryGetCount()==0
        allowance+=1
    end
    assert failures>0 and successes>0
    category=xui.createIconCategory(context,"output",description)
    allowance=0
    failures=0
    successes=0
    while allowance<48
        IconModel? result=null
        rejected=false
        budget(allowance)
        try
            result=category.addSvgPathWithMetadata("allocation","M0 0 L16 0 L8 16 Z",box,displayName="分配",tags="图标",flags=9)
        catch error
            rejected=true
        end
        budget(-1)
        if rejected then
            failures+=1
            assert result==null
            assert category.find("allocation")==null
        else
            successes+=1
            assert (result as IconModel).displayName=="分配" and (result as IconModel).flags==9
            assert (result as IconModel).unregister()
        end
        assert category.count==0
        allowance+=1
    end
    assert failures>0 and successes>0
    verifyReferences(context,proxy,category,box)
    category=xui.createIconCategory(context,"closing",description)
    icon=category.addSvgPath("last","M0 0 L16 0 L8 16 Z",box)
    auto finalIconReference=icon.retain()
    auto finalCategoryReference=category.retain()
    context.close()
    assert not finalIconReference.isLive() and not finalCategoryReference.isLive()
    finalIconReference.close()
    finalCategoryReference.close()
    expired=false
    try
        auto gone=icon.name
    catch error
        expired=true
    end
    assert expired
    proxy.close()
    assert backendBalanced()==1
    println("Icon models: registry views, picker ownership, expiry and 96 OOM budgets passed")
    println("Icon references: expiry, style, paired C/xlang zero-heap queries and OOM passed")
    return 0
end
