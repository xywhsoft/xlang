extern "close_catch_raise" func catchRaise(int mode)
extern "close_catch_mark" func catchMark(int id)

func catchDispatch0(int mode) as generator<int>
    try
        try
            yield 1
        finally
            catchMark(10)
            catchRaise(mode)
            catchMark(11)
        end
    catch RuntimeError failure
        catchMark(20)
        yield 2
        catchMark(21)
    end
    catchMark(90)
    yield 9
end
export "close_catch_consume_0" func consumeCatch0(int mode, int limit) as int
    int count = 0
    for value in catchDispatch0(mode)
        count += 1
        if count == limit then
            break
        end
    end
    return count
end

