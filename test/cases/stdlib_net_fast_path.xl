// Ordinary owned loopback: typed vectors, UDP batch and async owned results.
async func exerciseFastPath() as int
    auto engine = NetEngine(NetEngineOptions().withWorkers(1).withBackend(NetBackend.select))
    engine.start()
    auto listener = TcpListener(engine, TcpListenOptions(NetAddress.loopback(4, 0)))
    auto accepting = listener.acceptAsync()
    auto client = await tcp.connectAsync(engine, listener.localAddress())
    auto server = await accepting
    array<string> parts = ["a\0", "你", "z"]
    auto receiving = server.recvOwnedAsync(6)
    assert client.sendVector(parts) == NetStatus.ok
    auto first = await receiving
    bytes message = first.toBytes()
    while message.length < 6
        auto rest = await server.recvOwnedAsync(6 - message.length)
        assert rest.length > 0
        message = message + rest.toBytes()
    end
    assert message == b"a\0\xe4\xbd\xa0z"

    auto receiver = udp.bind(engine, NetAddress.loopback())
    assert await receiver.waitAsync(UdpWait.open)
    auto sender = udp.connect(engine, receiver.localAddress())
    assert await sender.waitAsync(UdpWait.open)
    auto pending = receiver.recvAsync()
    assert sender.sendVector(parts, 5) == NetStatus.ok
    auto packet = await pending
    assert packet.bytes() == b"a\0\xe4\xbd\xa0"
    auto batchFuture = receiver.recvBatchAsync(8)
    assert sender.send(b"") == NetStatus.ok
    auto batch = await batchFuture
    assert batch.count == 1
    auto empty = batch.take(0)
    assert empty != null and (empty as UdpPacket).length == 0
    assert batch.take(0) == null
    sender.close()
    receiver.close()
    client.close()
    server.close()
    listener.close()
    engine.close()
    assert engine.wait(5000)
    assert first.length > 0 and packet.length == 5
    return 0
end
assert await exerciseFastPath() == 0
println("stdlib net fast path ok")
