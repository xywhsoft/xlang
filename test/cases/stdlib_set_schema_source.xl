class NestedSetItem
    int code = 7
end
func main(...) as int
    array<set<int>> numbers = []
    array<set<NestedSetItem?>> objects = []
    array<set<set<bytes>>> nested = []
    auto stack = Stack::<set<string>>()
    auto tree = OrderedMap::<string, set<bytes>>()
    assert(numbers.length == 0)
    assert(objects.length == 0)
    assert(nested.length == 0)
    assert(stack.count() == 0)
    assert(tree.count() == 0)
    var erased = objects
    assert(erased.length == 0)
    return 0
end
