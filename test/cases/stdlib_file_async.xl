func makeVirtualAsyncFile() as AsyncFile
    auto fs = vfs.create()
    auto memory = vfs.memory()
    memory.put("data.bin", b"v\0f")
    memory.seal()
    auto mount = fs.mount("/app", memory)
    auto source = fs.open("/app/data.bin")
    auto alias = source
    auto result = file.takeAsync(source)
    assert source.closed and alias.closed
    return result
end

// Exercise native filesystem contracts, not DrvFS's missing no-replace rename.
string parent = "build/test"
if path.sep() == "/" then parent = "" end
string root = dir.temp(parent, "fs-async-", "")
assert await dir.createAllAsync(root + "/tree/nested")
assert await dir.emptyAsync(root + "/tree/nested")
string p = root + "/data.bin"
bytes original = b"a\0b\xff"
auto written = file.writeBytesAsync(p, original, 99)
original[0] = uint8(122)
assert await written
assert not (await file.readBytesAsync(p) != b"a\0b\xff")
assert await file.appendBytesAsync(p, b"tail", 2)
assert not (await file.readBytesAsync(p) != b"a\0b\xffta")
assert await file.writeBytesAtomicAsync(p, b"atomic\0")
assert not (await file.readBytesAsync(p) != b"atomic\0")
bool limited = false
try
    auto value = await file.readBytesAsync(p, 2)
catch e
    limited = true
end
assert limited
auto f = file.openAsync(p, 3)
assert f.flags == 3 and not f.closed
assert await f.writeAt(uint64(1), b"XYZ", 2) == uint64(2)
assert not (await f.readAt(uint64(0), 99) != b"aXYmic\0")
assert await f.flush()
assert await f.size() == uint64(7)
assert await f.resize(uint64(3)) == uint64(3)
auto accepted = f.readAt(uint64(0), 10)
auto closing = f.close()
assert f.closed
assert not (await accepted != b"aXY")
assert await closing
assert await f.close()
bool closed = false
try
    f.readAt(uint64(0), 1)
catch e
    closed = true
end
assert closed
auto native = file.open(p, 3)
auto asyncNative = file.takeAsync(native)
assert native.closed
assert not (await asyncNative.readAt(uint64(0), 10) != b"aXY")
assert await asyncNative.close()
auto temporary = file.temp(root)
bool refused = false
try
    auto adopted = file.takeAsync(temporary)
catch e
    refused = true
end
assert refused and not temporary.closed
assert temporary.close()
string t = root + "/tree/nested/text.txt"
assert await file.writeTextAsync(t, "你\0好", 2, 0, true)
assert await file.readTextAsync(t) == "你\0好"
assert await file.writeTextAtomicAsync(t, "hi\0", 1)
assert await file.appendTextAsync(t, "世界", 1)
assert await file.readTextAsync(t, 1) == "hi\0世界"
bool mismatch = false
try
    assert await file.writeTextAsync(t, "bom", 2, 0, true)
    auto text = await file.readTextAsync(t, 1)
catch e
    mismatch = true
end
assert mismatch
assert await file.copyAsync(p, root + "/copy.bin")
assert await file.moveAsync(root + "/copy.bin", root + "/move.bin")
assert await file.deleteAsync(root + "/move.bin")
bool missing = false
try
    auto value = await file.readBytesAsync(root + "/absent.bin")
catch e
    missing = e.message.length > 0
end
assert missing
assert await dir.createAsync(root + "/empty")
assert await dir.removeAsync(root + "/empty")
auto copy = await file.copyTreeAsync(root + "/tree", root + "/copytree")
assert copy.files == uint64(1) and copy.directories == uint64(2)
auto snapshot = await dir.statsAsync(root + "/copytree")
assert snapshot.bytes == uint64(8)
assert await dir.sizeAsync(root + "/copytree") == snapshot.bytes
assert await dir.moveAsync(root + "/copytree", root + "/movedtree")
auto removed = await file.removeTreeAsync(root + "/movedtree")
assert removed.files == uint64(1) and not dir.exists(root + "/movedtree")
assert snapshot.files == uint64(1), "statistics must own their snapshot"
auto dirCopy = await dir.copyAsync(root + "/tree", root + "/dircopy")
assert dirCopy.files == uint64(1)
auto cleaned = await dir.cleanAsync(root + "/dircopy")
assert cleaned.files == uint64(1) and dir.exists(root + "/dircopy")
assert await dir.ensureEmptyAsync(root + "/dircopy")
auto deleted = await dir.deleteAsync(root)
assert deleted.files >= uint64(2)
assert not dir.exists(root)
// Worker-based offset IO is backend-neutral, not native OS async binding.
// Destroy the Vfs/provider variables before awaiting the adopted File's work.
auto virtualFile = makeVirtualAsyncFile()
assert await virtualFile.readAt(uint64(0), 99) == b"v\0f"
assert await virtualFile.size() == uint64(3)
bool readOnly = false
try
    auto mutation = await virtualFile.writeAt(uint64(0), b"x")
catch e
    readOnly = true
end
assert readOnly
assert await virtualFile.close()
println("filesystem async ok")
