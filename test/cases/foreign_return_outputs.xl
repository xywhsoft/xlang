extern "returnOutputQuery" @header("test/cases/foreign_return_outputs.h") @no_raise @c_outputs(-1,1,2) @c_result("integer_min",0) func query(c_int mode) as (c_int,c_double,c_int)
extern "returnOutputCount" @header("test/cases/foreign_return_outputs.h") @no_raise func calls() as c_uint
extern "ReturnOutputReceiver*" class Receiver @header("test/cases/foreign_return_outputs.h") @lifetime("owned") @policy("returnOutputReceiverPolicy")
 native point handle
 extern "returnOutputReceiverQuery" @no_raise @c_outputs(-1,2,3) @c_result("integer_min",0) func read(c_int mode) as (c_int,c_double,c_int)
 extern "query" @c_field_call @no_raise @c_outputs(-1,2,3) @c_result("integer_min",0) func viaField(c_int mode) as (c_int,c_double,c_int)
 extern "xl6ForeignViewCloseV1" @no_raise @c_control(0) @c_result("bool_status") func close()
end
protocol QueryProtocol
 func read(c_int mode) as (c_int,c_double,c_int)
end
extern "returnOutputReceiverCreate" @header("test/cases/foreign_return_outputs.h") @no_raise @c_result("owned_view") @factory(0,0,dropReceiver) func receiver() as Receiver
