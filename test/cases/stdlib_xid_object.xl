Xid original = id.make()
assert not original.isZero()

string encoded = original.toString()
assert string.byteLen(encoded) == 32

Xid decoded = id.parse(encoded)
assert original.compare(decoded) == 0
assert original == decoded
assert decoded.toString() == encoded

assert id.tryParse("not-an-xid") == null
assert id.fromBytes(original.toBytes()) == original

println("stdlib xid object ok")
