import aho_corasick
from aho_corasick import Match, Automaton, Scanner

func main(...) as int
    // ─── Basic construction and search ───
    Automaton ac = aho_corasick.create(["he", "she", "his", "hers"])
    assert ac.valid, "automaton should be valid"
    assert ac.built, "auto-build on create with patterns"
    assert ac.patternCount == 4, "pattern count"
    assert ac.pattern(0) == "he", "pattern lookup"

    array<Match> results = ac.search("ushers")
    assert results.length == 3, "ushers should have 3 matches"

    // verify match contents (sorted by start)
    assert results[0].pattern == "she", "first match is she"
    assert results[0].start == 1, "she starts at 1"
    assert results[0].endPos == 4, "she ends at 4"
    assert results[0].length == 3, "she length is 3"

    assert results[1].pattern == "he", "second match is he"
    assert results[1].start == 2, "he starts at 2"
    assert results[1].endPos == 4, "he ends at 4"

    assert results[2].pattern == "hers", "third match is hers"
    assert results[2].start == 2, "hers starts at 2"
    assert results[2].endPos == 6, "hers ends at 6"
    assert results[2].length == 4, "hers length is 4"

    // ─── contains (optimized early-exit) ───
    assert ac.contains("ushers"), "contains should find match"
    assert not ac.contains("xyz"), "contains should return false for no match"
    assert not ac.contains(""), "contains empty text"

    // ─── count (optimized no-alloc) ───
    assert ac.count("ushers") == 3, "count ushers"
    assert ac.count("abc") == 0, "count no match"
    assert ac.count("") == 0, "count empty"

    // ─── searchFirst ───
    Match first = ac.searchFirst("ushers") as Match
    assert first.pattern == "she", "searchFirst pattern"

    Match? none = ac.searchFirst("xyz")
    assert none == null, "searchFirst no match returns null"

    // ─── replace (merged intervals) ───
    string replaced = ac.replace("ushers", "*")
    assert replaced == "u*", "replace merged overlapping: got " + replaced

    string replaced2 = ac.replace("he said she hers", "[x]")
    assert replaced2 == "[x] said [x] [x]", "replace multiple: got " + replaced2

    // ─── mask ───
    string masked = ac.mask("ushers", "#")
    assert masked == "u#####", "mask ushers: got " + masked

    // ─── highlight ───
    string hl = ac.highlight("ushers", "<b>", "</b>")
    assert hl == "u<b>shers</b>", "highlight merges overlapping ranges: got " + hl

    // ─── replaceWith callback ───
    string cb = ac.replaceWith("ushers", func(Match m) as string
        return "[" + m.pattern + "]"
    end)
    assert cb == "u[she]rs", "replaceWith keeps the first non-overlapping match: got " + cb

    // 回调替换使用 UTF-8 字节区间，中文前缀和尾部不能发生错位。
    Automaton unicodeAc = aho_corasick.create(["你好", "好世"])
    string unicodeResult = unicodeAc.replaceWith("甲你好世界", func(Match m) as string
        return "[" + m.pattern + "]"
    end)
    assert unicodeResult == "甲[你好]世界", "replaceWith keeps UTF-8 boundaries: got " + unicodeResult

    // 同一起点有多个匹配时固定选择最长项，与注册顺序无关。
    Automaton longestAc = aho_corasick.create(["a", "ab"])
    string longestResult = longestAc.replaceWith("ab!", func(Match m) as string
        return "[" + m.pattern + "]"
    end)
    assert longestResult == "[ab]!", "replaceWith uses leftmost-longest matching"

    // ─── Case insensitive ───
    Automaton ci = aho_corasick.create(["Hello", "WORLD"], ignoreCase = true)
    assert ci.contains("hello world"), "case insensitive contains"
    assert ci.contains("HELLO WORLD"), "case insensitive upper"
    assert ci.count("Hello hello HELLO") == 3, "case insensitive count"

    // ─── Manual build workflow ───
    Automaton manual = aho_corasick.create()
    assert not manual.built, "manual not built initially"
    manual.addPattern("foo")
    manual.addPattern("bar")
    manual.addPattern("baz")
    assert manual.patternCount == 3, "manual pattern count"
    manual.build()
    assert manual.built, "manual built after build()"
    assert manual.contains("foobar"), "manual contains"
    assert manual.count("foobarbaz") == 3, "manual count"

    // ─── addPatterns batch ───
    Automaton batch = aho_corasick.create()
    batch.addPatterns(["alpha", "beta", "gamma"])
    batch.build()
    assert batch.count("alphabetagamma") == 3, "batch count"

    // ─── Error handling ───
    bool caught = false
    try
        Automaton errAc = aho_corasick.create(["x"])
        errAc.addPattern("y")
    catch RuntimeError e
        caught = true
    end
    assert caught, "add after build must throw"

    // ─── Empty patterns ───
    Automaton empty = aho_corasick.create()
    empty.build()
    assert empty.count("anything") == 0, "empty automaton matches nothing"
    assert not empty.contains("anything"), "empty automaton contains nothing"

    // 空模式和大小写等价的重复模式必须明确失败。
    bool emptyPatternCaught = false
    try
        Automaton invalidPattern = aho_corasick.create()
        invalidPattern.addPattern("")
    catch ValueError e
        emptyPatternCaught = true
    end
    assert emptyPatternCaught, "empty pattern must throw"

    bool distinctCaseAccepted = true
    try
        Automaton duplicate = aho_corasick.create()
        duplicate.addPattern("Hello")
        duplicate.addPattern("hello")
    catch RuntimeError e
        distinctCaseAccepted = false
    end
    assert distinctCaseAccepted, "case-sensitive patterns are distinct"

    bool duplicateCaught = false
    try
        Automaton duplicateCase = aho_corasick.create([], ignoreCase = true)
        duplicateCase.addPattern("Hello")
        duplicateCase.addPattern("hello")
    catch ValueError e
        duplicateCaught = true
    end
    assert duplicateCaught, "case-equivalent duplicate must throw"

    bool unbuiltCaught = false
    try
        Automaton unbuilt = aho_corasick.create()
        unbuilt.contains("x")
    catch RuntimeError e
        unbuiltCaught = true
    end
    assert unbuiltCaught, "search before build must throw"

    // ─── scan: streaming callback, full scan ───
    array<int> total = [0]
    bool completed = ac.scan("ushers", func(Match m) as bool
        total[0] += 1
        return true
    end)
    assert completed, "scan should complete"
    assert total[0] == 3, "scan visits all 3 matches"

    // ─── scan: early stop ───
    array<int> visited = [0]
    bool stopped = ac.scan("ushers", func(Match m) as bool
        visited[0] += 1
        return false
    end)
    assert not stopped, "scan should report stopped"
    assert visited[0] == 1, "scan stops after first match"

    // ─── scan: conditional stop ───
    array<string> foundPattern = [""]
    ac.scan("ushers", func(Match m) as bool
        if m.pattern == "hers" then
            foundPattern[0] = m.pattern
            return false
        end
        return true
    end)
    assert foundPattern[0] == "hers", "scan conditional stop finds hers"

    // ─── Unicode mask counts scalars instead of UTF-8 bytes ───
    string unicodeMask = unicodeAc.mask("甲你好世界", "*")
    assert unicodeMask == "甲***界", "Unicode mask must count scalars: got " + unicodeMask

    // ─── Incremental Scanner: chunk boundary, pause and resume ───
    Scanner stream = ac.scanner()
    array<string> streamed = []
    bool chunkDone = stream.feed("us", func(Match m) as bool
        streamed.push(m.pattern)
        return true
    end)
    assert chunkDone and streamed.length == 0, "first stream chunk"
    chunkDone = stream.feed("hers", func(Match m) as bool
        streamed.push(m.pattern)
        return true
    end)
    assert chunkDone and streamed.length == 3, "second stream chunk"
    assert streamed[0] == "she" and streamed[1] == "he" and streamed[2] == "hers", "stream match order"
    assert stream.offset == 6 and stream.matchCount == 3, "stream counters"

    stream.reset()
    array<int> paused = [0]
    bool streamDone = stream.feed("ushers", func(Match m) as bool
        paused[0] += 1
        return false
    end)
    assert not streamDone and stream.pending and paused[0] == 1, "stream pause"

    bool pendingCaught = false
    try
        stream.feed("next", func(Match m) as bool
            return true
        end)
    catch RuntimeError e
        pendingCaught = true
    end
    assert pendingCaught, "feeding while pending must throw"

    streamDone = stream.resume(func(Match m) as bool
        paused[0] += 1
        return true
    end)
    assert streamDone and not stream.pending and paused[0] == 3, "stream resume"

    // ─── Explicit resource limits ───
    bool patternLimitCaught = false
    try
        Automaton limitedPattern = aho_corasick.create([],
            maxPatternBytes = 2)
        limitedPattern.addPattern("abc")
    catch RangeError e
        patternLimitCaught = true
    end
    assert patternLimitCaught, "pattern limit must throw"

    bool inputLimitCaught = false
    try
        Automaton limitedInput = aho_corasick.create(["a"],
            maxInputBytes = 2)
        limitedInput.count("abc")
    catch RangeError e
        inputLimitCaught = true
    end
    assert inputLimitCaught, "input limit must throw"

    println("aho_corasick: all tests passed")
    return 0
end
