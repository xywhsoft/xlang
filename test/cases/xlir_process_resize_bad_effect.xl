class WrongProcess
    private native point handle
    extern "xl6ProcessSpawnV1" create(ProcessCommand command)
    extern "xl6ProcessDestroyV1" destroy()
    extern "xl6ProcessResizeV1" @pure @no_raise @nonblocking func resize(int columns, int rows) as bool
end
assert WrongProcess(process.cmd("not-launched", [])).resize(80, 24)
