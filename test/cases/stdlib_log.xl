auto logger = log.create("legacy-fixture-migrated", LogLevel.trace)
auto options = LogFileOptions()
options.level = LogLevel.trace
options.mode = LogFileMode.truncate
auto text = LogTextOptions()
text.style = LogTextStyle.message
text.flags = log.textNewline
auto sink = log.textFileSink("build/test/stdlib-log-migrated.txt", options, text)
logger.addSink(sink)
log.setDefault(logger)
assert log.debug("default-debug") == LogResult.written
assert logger.warn("object-warn") == LogResult.written
log.flush()
assert file.readBytes("build/test/stdlib-log-migrated.txt") == b"default-debug\nobject-warn\n"
logger.setLevel(LogLevel.off)
assert log.fatal("silent") == LogResult.skipped
log.shutdown()
assert log.default() == null
assert sink.closeFile()
logger.clearSinks()
