// Nullable native slots retain presence, exact C width, signedness and bits.
extern "owned_task_char_min" @no_raise func charMin() as c_char
extern "owned_task_long_min" @no_raise func longMin() as c_long
extern "owned_task_ulong_max" @no_raise func ulongMax() as c_ulong
extern "owned_task_size_max" @no_raise func sizeMax() as c_size
extern "owned_task_ssize_min" @no_raise func ssizeMin() as c_ssize
extern "owned_task_ptrdiff_min" @no_raise func ptrdiffMin() as c_ptrdiff
extern "owned_task_intptr_min" @no_raise func intptrMin() as c_intptr
extern "owned_task_uintptr_max" @no_raise func uintptrMax() as c_uintptr
extern "owned_task_wchar_max" @no_raise func wcharMax() as c_wchar
func echo0(c_char? value) as c_char?
    return value
end
c_char input0=charMin()
c_char? present0=input0
c_char? absent0=null
auto first0=task.spawn(echo0,present0)
auto missing0=task.spawn(echo0,absent0)
auto literal0=await task.all([missing0,first0])
assert literal0.length==2 and literal0[0]==null and literal0[1]==present0
array<future<c_char?>> jobs0=[first0,missing0]
auto array0=await task.all(jobs0)
assert array0[0]==present0 and array0[1]==null
// A non-null argument is lifted before entering the exact nullable frame.
assert await task.spawn(echo0,input0)!=null
