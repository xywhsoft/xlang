// Nullable floating slots preserve NaN payloads and negative zero too.
extern "owned_task_float" @no_raise func floatValue(c_int kind) as c_float
extern "owned_task_double" @no_raise func doubleValue(c_int kind) as c_double
extern "owned_task_float_check" @no_raise func checkFloat(c_float value,c_int kind) as bool
extern "owned_task_double_check" @no_raise func checkDouble(c_double value,c_int kind) as bool
for kind in range(3)
    c_int mode=c_int(kind)
    auto floats=await task.all([task.spawn(echo17,floatValue(mode))])
    c_float? f=floats[0]
    if f!=null
        assert checkFloat(f,mode)
    else
        assert false
    end
    auto doubles=await task.all([task.spawn(echo18,doubleValue(mode))])
    c_double? d=doubles[0]
    if d!=null
        assert checkDouble(d,mode)
    else
        assert false
    end
end
