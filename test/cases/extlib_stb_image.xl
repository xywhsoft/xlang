import stb_image

func main(...) as int
    string imagePath = "release/examples/extlibs/assets/tiny.png"
    assert stb_image.available()
    assert not stb_image.isHdr(imagePath)

    stb_image.StbImage image = stb_image.load(imagePath, 4)
    assert image.valid()
    assert image.width() == 16 and image.height() == 16
    assert image.channels() == 4 and image.data() != null
    assert image.pixels().len() == 1024

    stb_image.StbImage floatImage = stb_image.loadf(imagePath, 4)
    assert floatImage.valid() and floatImage.isFloat()
    assert floatImage.byteSize() == 4096
    return 0
end
