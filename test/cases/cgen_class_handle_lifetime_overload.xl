class RefLifetimeBase
    int value

    create(int value)
        self.value = value
    end

    virtual func kind() as int
        return 1
    end

    func __add__(int delta) as int
        return self.value + delta
    end

    destroy()
        recordDestroy(self.value)
    end
end

class RefLifetimeDerived extends RefLifetimeBase
    create(int value)
        base(value)
    end

    override func kind() as int
        return 2
    end
end

extern "record_destroy" func recordDestroy(int value)
extern "expect_i64" func expect(int actual, int expected)
extern "destroy_count" func destroyCount() as int
extern "destroy_value" func destroyValue() as int

func selectKind(RefLifetimeBase value) as int
    return 10 + value.kind()
end

func selectKind(RefLifetimeDerived value) as int
    return 20 + value.kind()
end

func exerciseRefs()
    RefLifetimeDerived derived = RefLifetimeDerived(37)
    RefLifetimeBase base = derived
    RefLifetimeBase alias = base
    array<RefLifetimeBase> values = array[]
    values.append(base)

    assert selectKind(derived) == 22
    assert selectKind(base) == 12
    assert alias + 5 == 42
    assert values[0].kind() == 2

    RefLifetimeDerived downcast = alias as RefLifetimeDerived
    assert downcast.value == 37
    expect(destroyCount(), 0)
end

exerciseRefs()
expect(destroyCount(), 1)
expect(destroyValue(), 37)
