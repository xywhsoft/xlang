extern "binding_span_outputs" @no_raise @c_span(0,"const uint8_t*","size_t","test/cases/foreign_xge3_binding_outputs.h") @c_outputs(2,3) @c_status(0) func span(bytes data) as (c_size,c_uint)
func main(...) as int
 start()
 Context context=create()
 Widget widget=context.widget()
 widget.setSizeMode(c_int(0),c_int(1))
 auto width,height=widget.sizeMode()
 assert width==c_int(0) and height==c_int(1)
 widget.setGrid(c_int(4),c_float(25),c_float(17))
 auto columns,itemWidth,itemHeight=widget.grid()
 assert columns==c_int(4) and itemWidth==25.0 and itemHeight==17.0
 widget.setLayer(c_int(3),c_int(9))
 auto layer,zIndex=widget.layer()
 assert layer==c_int(3) and zIndex==c_int(9)
 auto x,y=mouse()
 assert x==0.0 and y==0.0
 auto mode,step,maxUpdates=sceneStrategy()
 assert mode==c_int(0) and step==0.0 and maxUpdates==c_int(0)
 auto size,first=span(b"a\0b")
 assert size==c_size(3) and first==c_uint(97)
 bool failed=false
 try
  auto badSize,badFirst=span(b"\xff")
 catch error
  failed=true
 end
 assert failed
 context.close()
 bool expired=false
 try
  auto badWidth,badHeight=widget.sizeMode()
 catch error
  expired=true
 end
 assert expired
 return 0
end
