import fix

func main(...) as int
    var fields = [
        fix.field(35, "D"),
        fix.field(49, "SENDER"),
        fix.field(56, "TARGET"),
        fix.field(11, "order-1"),
        fix.field(54, "1"),
        fix.field(38, "100")
    ]
    string message = fix.build("FIX.4.4", fields)
    assert fix.validate(message), "built message validates"
    assert string.contains(message, "8=FIX.4.4\x01"), "begin string"
    assert string.contains(message, "9="), "body length"
    assert string.contains(message, "10="), "checksum"

    var parsed = fix.parse(message)
    assert parsed["valid"] == true, "parsed validation"
    assert parsed["fields"][2]["tag"] == 35, "field order"
    assert parsed["fields"][2]["value"] == "D", "field value"

    bool caught = false
    try
        string corrupted = string.replace(message, "10=", "10=999")
        fix.parse(corrupted)
    catch ValueError e
        caught = true
    end
    assert caught, "invalid checksum must throw"
    return 0
end
