async func addAsync(int a, int b) as int
    return a + b
end

async func stream(int start) as generator<int>
    int first = await addAsync(start, 1)
    yield first
    yield await addAsync(first, 2)
end

func streamAlt(int start) as async generator<int>
    int first = await addAsync(start, 3)
    yield first
    yield await addAsync(first, 4)
end

func broken() as async generator<int>
    yield await addAsync(0, 1)
    throw "async generator boom"
    yield 2
end

func brokenEarly() as async generator<int>
    int guard = await addAsync(1, 1)
    if guard == 2 then
        throw "async generator boom before yield"
    end
    yield guard
end

func emptyStream() as async generator<int>
    int guard = await addAsync(1, 1)
    if guard == 0 then
        yield guard
    end
end

func indexedStream() as async generator<int>
    yield await addAsync(0, 10)
    yield await addAsync(0, 20)
    yield await addAsync(0, 30)
    yield await addAsync(0, 40)
end

func returnEarlyStream() as async generator<int>
    yield await addAsync(0, 5)
    return
    yield await addAsync(0, 50)
end

func returnBeforeYieldStream() as async generator<int>
    return
    yield await addAsync(0, 60)
end

func plainStream() as generator<int>
    yield 7
    yield 8
end

int total = 0
for await value in stream(10)
    total = total + value
end

assert total == 24, "async generator total failed"

int alt = 0
for await value in streamAlt(20)
    alt = alt + value
end

assert alt == 50, "async generator type-marker total failed"

generator<int> savedStream = stream(30)
int savedTotal = 0
for await value in savedStream
    savedTotal = savedTotal + value
end

assert savedTotal == 64, "saved async generator value failed"

generator<int> savedBroken = broken()
int savedErrorState = 0
try
    for await value in savedBroken
        savedErrorState = savedErrorState + value
    end
    savedErrorState = 100
catch e
    if e.message == "async generator boom" then
        savedErrorState = savedErrorState + 10
    end
end

assert savedErrorState == 11, "saved async generator error propagation failed"

generator<int> savedBrokenEarly = brokenEarly()
int savedEarlyErrorState = 0
try
    for await value in savedBrokenEarly
        savedEarlyErrorState = savedEarlyErrorState + value
    end
    savedEarlyErrorState = 100
catch e
    if e.message == "async generator boom before yield" then
        savedEarlyErrorState = 42
    end
end

assert savedEarlyErrorState == 42, "saved async generator early error propagation failed"

generator<int> savedEmpty = emptyStream()
int savedEmptyCount = 0
for await value in savedEmpty
    savedEmptyCount = savedEmptyCount + 1
end

assert savedEmptyCount == 0, "saved empty async generator should not yield values"

generator<int> savedIndexed = indexedStream()
int savedBreakSeen = 0
int savedBreakWeighted = 0
for await savedIndex, savedValue in savedIndexed
    savedBreakSeen = savedBreakSeen + 1
    savedBreakWeighted = savedBreakWeighted + savedIndex * 100 + savedValue
    if savedIndex == 1 then
        break
    end
end

assert savedBreakSeen == 2, "saved async generator break seen failed"
assert savedBreakWeighted == 130, "saved async generator break index/value failed"

int savedBreakAgainState = 0
try
    for await savedBreakAgainValue in savedIndexed
        savedBreakAgainState = savedBreakAgainState + savedBreakAgainValue
    end
    savedBreakAgainState = 100
catch e
    if e.message == "iterate null generator" then
        savedBreakAgainState = 42
    end
end

assert savedBreakAgainState == 42, "saved async generator should reject second pass after break"

generator<int> savedIndexedContinue = indexedStream()
int savedContinueSeen = 0
int savedContinueWeighted = 0
for await savedContinueIndex, savedContinueValue in savedIndexedContinue
    savedContinueSeen = savedContinueSeen + 1
    if savedContinueIndex == 1 then
        continue
    end
    savedContinueWeighted = savedContinueWeighted + savedContinueIndex * 100 + savedContinueValue
    if savedContinueIndex == 2 then
        break
    end
end

assert savedContinueSeen == 3, "saved async generator continue seen failed"
assert savedContinueWeighted == 240, "saved async generator continue index/value failed"

int savedContinueAgainState = 0
try
    for await savedContinueAgainValue in savedIndexedContinue
        savedContinueAgainState = savedContinueAgainState + savedContinueAgainValue
    end
    savedContinueAgainState = 100
catch e
    if e.message == "iterate null generator" then
        savedContinueAgainState = 42
    end
end

assert savedContinueAgainState == 42, "saved async generator should reject second pass after continue/break"

generator<int> savedReturnEarly = returnEarlyStream()
int savedReturnEarlyCount = 0
int savedReturnEarlyTotal = 0
for await value in savedReturnEarly
    savedReturnEarlyCount = savedReturnEarlyCount + 1
    savedReturnEarlyTotal = savedReturnEarlyTotal + value
end

assert savedReturnEarlyCount == 1, "saved async generator return should stop after first yield"
assert savedReturnEarlyTotal == 5, "saved async generator return should keep yielded value"

int savedReturnEarlyAgainState = 0
try
    for await returnEarlyAgainValue in savedReturnEarly
        savedReturnEarlyAgainState = savedReturnEarlyAgainState + returnEarlyAgainValue
    end
    savedReturnEarlyAgainState = 100
catch e
    if e.message == "iterate null generator" then
        savedReturnEarlyAgainState = 42
    end
end

assert savedReturnEarlyAgainState == 42, "saved async generator return should close generator"

generator<int> savedReturnBeforeYield = returnBeforeYieldStream()
int savedReturnBeforeYieldCount = 0
int savedReturnBeforeYieldTotal = 0
for await value in savedReturnBeforeYield
    savedReturnBeforeYieldCount = savedReturnBeforeYieldCount + 1
    savedReturnBeforeYieldTotal = savedReturnBeforeYieldTotal + value
end

assert savedReturnBeforeYieldCount == 0, "saved async generator pre-yield return should yield no values"
assert savedReturnBeforeYieldTotal == 0, "saved async generator pre-yield return should keep total zero"

int savedReturnBeforeYieldAgainState = 0
try
    for await returnBeforeYieldAgainValue in savedReturnBeforeYield
        savedReturnBeforeYieldAgainState = savedReturnBeforeYieldAgainState + returnBeforeYieldAgainValue
    end
    savedReturnBeforeYieldAgainState = 100
catch e
    if e.message == "iterate null generator" then
        savedReturnBeforeYieldAgainState = 42
    end
end

assert savedReturnBeforeYieldAgainState == 42, "saved async generator pre-yield return should close generator"

int plainAwaitTotal = 0
for await value in plainStream()
    plainAwaitTotal = plainAwaitTotal + value
end

assert plainAwaitTotal == 15, "for await should consume ordinary generator"

generator<int> savedPlainAwait = plainStream()
int savedPlainAwaitWeighted = 0
for await plainIndex, plainValue in savedPlainAwait
    savedPlainAwaitWeighted = savedPlainAwaitWeighted + plainIndex * 100 + plainValue
end

assert savedPlainAwaitWeighted == 115, "for await should consume saved ordinary generator with index"

int savedPlainAwaitAgainState = 0
try
    for await plainAgainValue in savedPlainAwait
        savedPlainAwaitAgainState = savedPlainAwaitAgainState + plainAgainValue
    end
    savedPlainAwaitAgainState = 100
catch e
    if e.message == "iterate null generator" then
        savedPlainAwaitAgainState = 42
    end
end

assert savedPlainAwaitAgainState == 42, "for await ordinary generator should reject second pass"

generator<int> savedPlainAwaitBreak = plainStream()
int savedPlainAwaitBreakTotal = 0
for await plainBreakIndex, plainBreakValue in savedPlainAwaitBreak
    if plainBreakIndex == 0 then
        continue
    end
    savedPlainAwaitBreakTotal = savedPlainAwaitBreakTotal + plainBreakIndex * 100 + plainBreakValue
    break
end

assert savedPlainAwaitBreakTotal == 108, "for await ordinary generator continue/break failed"

int savedPlainAwaitBreakAgainState = 0
try
    for await plainBreakAgainValue in savedPlainAwaitBreak
        savedPlainAwaitBreakAgainState = savedPlainAwaitBreakAgainState + plainBreakAgainValue
    end
    savedPlainAwaitBreakAgainState = 100
catch e
    if e.message == "iterate null generator" then
        savedPlainAwaitBreakAgainState = 42
    end
end

assert savedPlainAwaitBreakAgainState == 42, "for await ordinary generator break should close generator"

generator<int> consumedAsync = stream(40)
int consumedAsyncFirstTotal = 0
for await value in consumedAsync
    consumedAsyncFirstTotal = consumedAsyncFirstTotal + value
end

assert consumedAsyncFirstTotal == 84, "consumed async generator first pass failed"

int consumedAsyncAgainState = 0
try
    for await value in consumedAsync
        consumedAsyncAgainState = consumedAsyncAgainState + value
    end
    consumedAsyncAgainState = 100
catch e
    if e.message == "iterate null generator" then
        consumedAsyncAgainState = 42
    end
end

assert consumedAsyncAgainState == 42, "consumed async generator should reject second pass"

generator<int> missingAsync
int missingAsyncState = 0
try
    for await value in missingAsync
        missingAsyncState = missingAsyncState + value
    end
    missingAsyncState = 100
catch e
    if e.message == "iterate null generator" then
        missingAsyncState = 42
    end
end

assert missingAsyncState == 42, "null async generator should reject iteration"

int errorState = 0
try
    for await value in broken()
        errorState = errorState + value
    end
    errorState = 100
catch e
    if e.message == "async generator boom" then
        errorState = errorState + 10
    end
end

assert errorState == 11, "async generator error propagation failed"

int earlyErrorState = 0
try
    for await value in brokenEarly()
        earlyErrorState = earlyErrorState + value
    end
    earlyErrorState = 100
catch e
    if e.message == "async generator boom before yield" then
        earlyErrorState = 42
    end
end

assert earlyErrorState == 42, "async generator early error propagation failed"

int emptyCount = 0
for await value in emptyStream()
    emptyCount = emptyCount + 1
end

assert emptyCount == 0, "empty async generator should not yield values"

int returnEarlyCount = 0
int returnEarlyTotal = 0
for await value in returnEarlyStream()
    returnEarlyCount = returnEarlyCount + 1
    returnEarlyTotal = returnEarlyTotal + value
end

assert returnEarlyCount == 1, "async generator return should stop after first yield"
assert returnEarlyTotal == 5, "async generator return should keep yielded value"

int returnBeforeYieldCount = 0
int returnBeforeYieldTotal = 0
for await value in returnBeforeYieldStream()
    returnBeforeYieldCount = returnBeforeYieldCount + 1
    returnBeforeYieldTotal = returnBeforeYieldTotal + value
end

assert returnBeforeYieldCount == 0, "async generator pre-yield return should yield no values"
assert returnBeforeYieldTotal == 0, "async generator pre-yield return should keep total zero"

int indexedSeen = 0
int indexedWeighted = 0
for await asyncIndex, asyncValue in indexedStream()
    indexedSeen = indexedSeen + 1
    if asyncIndex == 1 then
        continue
    end
    indexedWeighted = indexedWeighted + asyncIndex * 100 + asyncValue
    if asyncIndex == 2 then
        break
    end
end

assert indexedSeen == 3, "async generator two-target seen failed"
assert indexedWeighted == 240, "async generator two-target index/value failed"
