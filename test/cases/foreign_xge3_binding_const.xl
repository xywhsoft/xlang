func main(...) as int
 Root root=create()
 Child child=root.child(c_int(7))
 assert child.read()==c_int(17) and readChild(child)==c_int(17)
 func() as c_int bound=child.read
 assert bound()==c_int(17)
 Reader reader=child
 assert reader.read()==c_int(17)
 func(Child) as c_int callback=readChild
 assert callback(child)==c_int(17)
 RawChild raw=rawOpen()
 assert raw.read()==c_int(19) and readRaw(raw)==c_int(19)
 func() as c_int rawBound=raw.read
 assert rawBound()==c_int(19)
 root.close()
 bool expired=false
 try
  auto invalid=child.read()
 catch error
  expired=true
 end
 assert expired
 return 0
