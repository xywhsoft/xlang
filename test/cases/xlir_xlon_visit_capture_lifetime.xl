extern "xlir_json_observe_lifetime" func observeLifetime(var target) as var
extern "xlir_json_lifetime_expired" func expired(var witness) as c_bool

func capturedVisitor(var state) as func(var) as bool
    return func(var event) as bool
        return bool(state["continue"])
    end
end

func temporaryVisitorScope() as var
    var state = {"continue": true}
    var witness = observeLifetime(state)
    assert xlon.visit("null", capturedVisitor(state)) == xlon.visitComplete
    return witness
end

for i in range(30)
    // Legacy is not the oracle for temporary callback capture reclamation.
    assert expired(temporaryVisitorScope())
end

// A borrowed extern argument from an owned dynamic field read must release
// its temporary anchor. Legacy retains the owned field result an extra time.
array<var> payloadWitnesses = []
func(var) as bool byteVisitor = func(var event) as bool
    assert event["type"] == "bytes"
    assert event["value"] != null
    payloadWitnesses.append(observeLifetime(event["value"]))
    return true
end
for i in range(30)
    assert xlon.visit(`bytes("AP9B")`, byteVisitor) == xlon.visitComplete
    assert expired(payloadWitnesses[i])
end
