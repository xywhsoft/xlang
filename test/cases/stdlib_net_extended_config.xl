// Configuration and numeric address operations only; no external connection.
auto address = NetAddress("127.0.0.1", 8080)
assert address.text() == "127.0.0.1" and address.port == 8080 and address.family == 4
auto resolved = net.resolve("127.0.0.1", 80)
assert resolved.text() == "127.0.0.1" and resolved.port == 80

auto proxy = net.proxy(NetProxyType.socks5, "127.0.0.1", 1080, "user", "pass")
auto http = net.proxy(NetProxyType.httpConnect, "127.0.0.1", 8080)
assert proxy.type == NetProxyType.socks5 and http.type == NetProxyType.httpConnect
assert proxy.port == 1080 and proxy.host() == "127.0.0.1" and proxy.username() == b"user"
auto original = TcpStreamOptions()
auto stream = original.withConnectTimeoutMillis(100).withWriteWatermarks(4096, 1024, 8192).withReadBuffer(1024, 8192)
assert stream.connectTimeoutMillis == 100 and stream.writeHighWater == 4096 and stream.writeLowWater == 1024
assert stream.readLimit == 8192 and original.readLimit != stream.readLimit
auto dial = TcpDialOptions().withStreamOptions(stream)
assert dial.streamOptions().connectTimeoutMillis == 100
auto proxyDial = TcpProxyDialOptions().withTransportOptions(dial)
assert proxyDial.transportOptions().streamOptions().readLimit == 8192
auto listen = TcpListenOptions(NetAddress.loopback()).withBacklog(16).withStreamOptions(stream)
assert listen.backlog == 16 and listen.streamOptions().writeHighWater == 4096
auto udpConfig = udp.config().withReceive(8192, 2, 8).withReceiveQueue(64, 65536, UdpOverflow.error)
assert udpConfig.receiveBatch == 8 and udpConfig.receiveQueueLimit == 64
auto engine = NetEngine(NetEngineOptions().withWorkers(1).withBackend(NetBackend.select))
engine.start()
assert engine.workerCount == 1 and engine.backend() == NetBackend.select
engine.close()
assert engine.wait(5000)
println("stdlib net extended config ok")
