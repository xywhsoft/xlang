import xui

extern "fixtureDiagnosticBudget" @header("test/cases/foreign_xui_codeedit_diagnostics_heap.h") @no_raise func budget(c_int allowance)

func exercise(xui.Context ui,xui.CodeEdit editor)
 assert editor.setText("header\nbody\nend\ntail")==xui.XUI_OK
 editor.setWordWrap(1)
 assert ui.layout()==xui.XUI_OK
 auto original=editor.getOffsetRect(16)
 auto folds=editor.foldState()
 auto alias=editor.foldState()
 auto block=xui.CodeFoldRange()
 block.iStartLine=0
 block.iEndLine=2
 array<xui.CodeFoldRange> ranges=[block]

 folds.setRanges(ranges)
 assert folds.getCount()==1 and alias.getRange(0).iEndLine==2
 folds.toggleLine(0)
 assert alias.isLineVisible(0)==1 and alias.isLineVisible(1)==0
 assert alias.visibleLineCount(4)==2 and alias.visibleRowToLine(4,1)==3
 assert alias.lineToVisibleRow(3)==1 and editor.getOffsetRect(16).fY<original.fY

 bool failed=false
 budget(0)
 try
  folds.setRanges(ranges)
 catch Error
  failed=true
 finally
  budget(-1)
 end
 assert failed and folds.getCount()==1 and folds.isLineVisible(2)==0
 folds.unfoldAll()
 assert editor.getOffsetRect(16).fY==original.fY
 folds.foldAll()
 assert folds.visibleLineCount(4)==2

 auto doc=editor.document()
 doc.insert(7,"inner\n")
 assert folds.getRange(0).iEndLine==3 and folds.visibleLineCount(5)==2
 doc.insert(0,"!")
 assert folds.getCount()==0

 folds.setRanges(ranges)
 folds.close()
 bool expired=false
 try
  alias.getCount()
 catch StateError
  expired=true
 end
 assert expired
 auto current=editor.foldState()
 assert current.getCount()==1
 auto worker=thread(func() as int
  try
   current.getCount()
   return 1
  catch Error
   return 0
  end
 end)
 assert worker.waitTimeout(30000) and worker.exitCode()==0
 current.clear()
 assert current.getCount()==0
 editor.close()
 expired=false
 try
  current.getCount()
 catch StateError
  expired=true
 end
 assert expired
end

func main(...) as int
 auto fontPath=env.get("XUI_EXAMPLE_FONT")
 assert fontPath!=null
 auto proxy=xui.createProxy()
 auto ui=xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
 auto font=proxy.loadFont(fontPath as string,c_float(16),c_uint(xui.XUI_FONT_FORMAT_TTF))
 ui.setDefaultFont(font)
 auto editor=ui.codeEditNative()
 assert ui.setRootWidget(editor)==xui.XUI_OK
 ui.setViewportSize(320,160)
 try
  exercise(ui,editor)
 finally
  ui.close()
  font.close()
  proxy.close()
 end
 println("XUI_CODEEDIT_FOLD_VIEW_OK")
 return 0
end
