extern "PrefixRegionRoot*" class Painter @header("test/cases/foreign_span_region_prefix.h") @lifetime("owned") @policy("prefixRegionPolicy")
 native point handle
 extern "render" @c_field_call @no_raise @c_span(0,"const uint8_t*","int",1) @c_region(5,"write","3","4","6",1) @c_result("status",0) func render(bytes data,int size,c_int width,c_int height,Buffer output,c_int stride)
end
