func containsBytes(bytes data, bytes needle) as bool
    if needle.length > data.length then return false end
    int start = 0
    while start <= data.length - needle.length
        int offset = 0
        while offset < needle.length and data[start + offset] == needle[offset]
            offset += 1
        end
        if offset == needle.length then return true end
        start += 1
    end
    return false
end
func requireTerminalBytes(bytes data, bytes needle, string label)
    bool found = containsBytes(data, needle)
    if not found
        println(label)
        println(data)
    end
    assert found
end
string child = env.get("XL6_PROCESS_CHILD") ?? ""
assert child != ""
// Do not call terminalSupported first: it must not accidentally provide
// the missing native terminal root for the configuration/start path.
// The child waits for actual native size observation, not for a fixed delay.
// Windows resize-control and input are independent channels; resize success
// is not an acknowledgement from the child's next input/read operation.
auto command = process.cmd(child, ["terminal", "96", "32"])
command.terminal()
command.terminalSize(80, 24)
auto handle = command.start()
int rejected = 0
try
    handle.resize(32768, 24)
catch e
    rejected += 1
end
try
    auto invalid = handle.stderrReader()
catch e
    rejected += 1
end
assert rejected == 2
auto input = handle.stdinWriter()
auto output = handle.stdoutReader()
// start() and resize() do not acknowledge that the application is ready.
// The initial dimensions belong in terminalSize; dynamic resize follows this
// private application's explicit readiness protocol (including on Windows 10).
bytes received = b""
while not containsBytes(received, b"terminal-ready")
    bytes chunk = output.read(512)
    assert chunk.length > 0
    received = received + chunk
    assert received.length <= 16384
end
assert handle.resize(96, 32)
input.writeAll(b"hello\r\n")
input.flush()
// Terminal output is a byte stream, including platform terminal processing.
received = received + output.readAll(16384)
requireTerminalBytes(received, b"tty:1:1:1", "terminal: missing tty report")
requireTerminalBytes(received, b"terminal-stderr", "terminal: missing stderr report")
// ConPTY may split visible text with VT cursor/erase/redraw sequences. The
// native child checks its actual dimensions and complete input line, returning
// a nonzero exit code on either mismatch. Do not treat VT as plain pipe text.
auto status = handle.wait(5000)
assert status != null
if status != null then assert status.code == 0 end
input.close()
output.close()
