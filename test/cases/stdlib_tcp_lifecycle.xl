func receiveExact(TcpStream stream, int size) as bytes
    bytes result = b""
    while result.length < size
        bytes chunk = stream.recv(size - result.length, 5000)
        assert chunk.length > 0
        result = result + chunk
    end
    return result
end

func acceptedFirstSend()
    auto engine = NetEngine(NetEngineOptions().withWorkers(1).withBackend(NetBackend.select))
    engine.start()
    auto listener = TcpListener(engine, TcpListenOptions(NetAddress.loopback()).withBacklog(4))
    auto client = TcpStream(engine, listener.localAddress())
    auto peer = listener.accept(5000)
    assert client.wait(TcpWait.open, 5000) == NetStatus.ok
    assert peer.send("220 first\r\n") == NetStatus.ok
    assert peer.wait(TcpWait.drain, 5000) == NetStatus.ok
    assert receiveExact(client, 11) == b"220 first\r\n"
    peer.close()
    client.close()
    listener.close()
    engine.close()
    assert engine.wait(5000)
    println("tcp_accepted_first_send=ok")
    println("tcp_listener_close=ok")
end

func closedSender(NetEngine engine, TcpListener listener, string payload) as TcpStream
    auto client = TcpStream(engine, listener.localAddress())
    auto peer = listener.accept(5000)
    assert client.wait(TcpWait.open, 5000) == NetStatus.ok
    assert client.send(payload) == NetStatus.ok
    client.close()
    // The sender's final language reference is destroyed on this return.
    return peer
end

func gracefulCloseKeepsPendingData(bool destroySender)
    auto engine = NetEngine(NetEngineOptions().withWorkers(1).withBackend(NetBackend.select))
    engine.start()
    auto listener = TcpListener(engine, TcpListenOptions(NetAddress.loopback()).withBacklog(4))
    string payload = string.repeat("scope-close-\0", 4096)
    if destroySender then
        auto peer = closedSender(engine, listener, payload)
        assert receiveExact(peer, payload.length) == encoding.encodeUtf8(payload)
        peer.close()
    else
        auto client = TcpStream(engine, listener.localAddress())
        auto peer = listener.accept(5000)
        assert client.wait(TcpWait.open, 5000) == NetStatus.ok
        assert client.send(payload) == NetStatus.ok
        client.close()
        assert receiveExact(peer, payload.length) == encoding.encodeUtf8(payload)
        peer.close()
    end
    listener.close()
    engine.close()
    assert engine.wait(5000)
    if destroySender then
        println("tcp_close_before_destroy=ok")
    else
        println("tcp_graceful_close=ok")
    end
end

acceptedFirstSend()
gracefulCloseKeepsPendingData(false)
gracefulCloseKeepsPendingData(true)
