import snappy



func main(...) as int
    Buffer source = Buffer()
    source.append("abc")
    source.appendByte(0)
    source.appendByte(255)
    Buffer packed = snappy.compress(source)
    Buffer plain = snappy.decompress(packed)
    if not (plain == source) then
        return 1
    end

    auto encoder = snappy.compressor()
    encoder.update("left")
    encoder.update("right")
    encoder.finish()
    Buffer incremental = encoder.drain()
    auto decoder = snappy.decompressor()
    decoder.update(incremental)
    decoder.finish()
    if decoder.drain().text() != "leftright" then
        return 2
    end
    if decoder.members != 1 then
        return 6
    end

    // 流式分块收集 + 字节计数器（进度回显基础）。
    auto enc2 = snappy.compressor()
    Buffer collected = Buffer()
    enc2.update("aaaa")
    collected.append(enc2.drain())
    enc2.update("bbbb")
    collected.append(enc2.drain())
    enc2.finish()
    collected.append(enc2.drain())
    if enc2.inputBytes != 8 then
        return 7
    end
    auto dec2 = snappy.decompressor()
    dec2.update(collected)
    dec2.finish()
    if dec2.drain().text() != "aaaabbbb" then
        return 8
    end
    if not dec2.finished then
        return 9
    end

    // 高冗余输入应被有效压缩（copy 匹配生效，输出小于原始）。
    Buffer redundant = Buffer()
    int i = 0
    while i < 256
        redundant.append("snappy-snappy-")
        i = i + 1
    end
    Buffer redundantPacked = snappy.compress(redundant)
    if redundantPacked.len() >= redundant.len() then
        return 10
    end
    if not (snappy.decompress(redundantPacked) == redundant) then
        return 11
    end

    // 串联多成员流：两个独立成员拼接后一次解出。
    auto frameA = snappy.compressor()
    frameA.update("AAA")
    frameA.finish()
    auto frameB = snappy.compressor()
    frameB.update("BBB")
    frameB.finish()
    Buffer joined = Buffer()
    joined.append(frameA.drain())
    joined.append(frameB.drain())
    auto multi = snappy.decompressor()
    multi.update(joined)
    multi.finish()
    if multi.drain().text() != "AAABBB" then
        return 12
    end
    if multi.members != 2 then
        return 13
    end

    bool rejected = false
    incremental[10] = 2
    try
        snappy.decompress(incremental)
    catch IOError e
        rejected = true
    end
    if not rejected then
        return 3
    end

    dir.createAll("build/test/snappy-baseline")
    string sourcePath = "build/test/snappy-baseline/source.bin"
    string packedPath = "build/test/snappy-baseline/stream.sz"
    string plainPath = "build/test/snappy-baseline/plain.bin"
    file.writeBytes(sourcePath, source.toBytes())
    snappy.compressFile(sourcePath, packedPath)
    snappy.decompressFile(packedPath, plainPath)
    if file.readBytes(plainPath) != source.toBytes() then
        return 4
    end
    bool overwriteRejected = false
    try
        snappy.compressFile(sourcePath, packedPath, overwrite = false)
    catch ValueError e
        overwriteRejected = true
    end
    if not overwriteRejected then
        return 5
    end
    file.delete(sourcePath)
    file.delete(packedPath)
    file.delete(plainPath)
    return 0
end
