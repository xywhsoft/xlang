// Public fixed RFC 7748 section 6.1/6.2 vectors; no network traffic.
auto inputX25519 = b"\x77\x07\x6d\x0a\x73\x18\xa5\x7d\x3c\x16\xc1\x72\x51\xb2\x66\x45\xdf\x4c\x2f\x87\xeb\xc0\x99\x2a\xb1\x77\xfb\xa5\x1d\xb9\x2c\x2a"
auto keyX25519 = X25519Key(inputX25519)
assert keyX25519.publicKey == b"\x85\x20\xf0\x09\x89\x30\xa7\x54\x74\x8b\x7d\xdc\xb4\x3e\xf7\x5a\x0d\xbf\x3a\x0d\x26\x38\x1a\xf4\xeb\xa4\xa9\x8e\xaa\x9b\x4e\x6a"
assert keyX25519.exportPrivate() == inputX25519
assert keyX25519.sharedSecret(b"\xde\x9e\xdb\x7d\x7b\x7d\xc1\xb4\xd3\x5b\x61\xc2\xec\xe4\x35\x37\x3f\x83\x43\xc8\x5b\x78\x67\x4d\xad\xfc\x7e\x14\x6f\x88\x2b\x4f") == b"\x4a\x5d\x9d\x5b\xa4\xce\x2d\xe1\x72\x8e\x3b\xf4\x80\x35\x0f\x25\xe0\x7e\x21\xc9\x47\xd1\x9e\x33\x76\xf0\x9b\x3c\x1e\x16\x17\x42"
assert cryptoAdvanced.x25519(inputX25519, b"\xde\x9e\xdb\x7d\x7b\x7d\xc1\xb4\xd3\x5b\x61\xc2\xec\xe4\x35\x37\x3f\x83\x43\xc8\x5b\x78\x67\x4d\xad\xfc\x7e\x14\x6f\x88\x2b\x4f") == b"\x4a\x5d\x9d\x5b\xa4\xce\x2d\xe1\x72\x8e\x3b\xf4\x80\x35\x0f\x25\xe0\x7e\x21\xc9\x47\xd1\x9e\x33\x76\xf0\x9b\x3c\x1e\x16\x17\x42"
inputX25519[0] = uint8(0)
assert keyX25519.exportPrivate() == b"\x77\x07\x6d\x0a\x73\x18\xa5\x7d\x3c\x16\xc1\x72\x51\xb2\x66\x45\xdf\x4c\x2f\x87\xeb\xc0\x99\x2a\xb1\x77\xfb\xa5\x1d\xb9\x2c\x2a"
auto publicX25519 = keyX25519.publicKey
publicX25519[0] = uint8(0)
assert keyX25519.publicKey == b"\x85\x20\xf0\x09\x89\x30\xa7\x54\x74\x8b\x7d\xdc\xb4\x3e\xf7\x5a\x0d\xbf\x3a\x0d\x26\x38\x1a\xf4\xeb\xa4\xa9\x8e\xaa\x9b\x4e\x6a"
auto generatedX25519 = crypto.x25519KeyPair()
auto restoredX25519 = X25519Key(generatedX25519.exportPrivate())
assert restoredX25519.publicKey == generatedX25519.publicKey
assert generatedX25519.sharedSecret(keyX25519.publicKey) == keyX25519.sharedSecret(generatedX25519.publicKey)
array<X25519Key> ownersX25519 = [keyX25519, generatedX25519, restoredX25519]
assert ownersX25519[0].publicKey == keyX25519.publicKey
int rejectedX25519 = 0
try
    X25519Key(b"short")
catch e
    rejectedX25519 += 1
end
try
    keyX25519.sharedSecret(b"short")
catch e
    rejectedX25519 += 1
end
try
    cryptoAdvanced.x25519(b"short", keyX25519.publicKey)
catch e
    rejectedX25519 += 1
end
assert rejectedX25519 == 3

auto inputX448 = b"\x9a\x8f\x49\x25\xd1\x51\x9f\x57\x75\xcf\x46\xb0\x4b\x58\x00\xd4\xee\x9e\xe8\xba\xe8\xbc\x55\x65\xd4\x98\xc2\x8d\xd9\xc9\xba\xf5\x74\xa9\x41\x97\x44\x89\x73\x91\x00\x63\x82\xa6\xf1\x27\xab\x1d\x9a\xc2\xd8\xc0\xa5\x98\x72\x6b"
auto keyX448 = X448Key(inputX448)
assert keyX448.publicKey == b"\x9b\x08\xf7\xcc\x31\xb7\xe3\xe6\x7d\x22\xd5\xae\xa1\x21\x07\x4a\x27\x3b\xd2\xb8\x3d\xe0\x9c\x63\xfa\xa7\x3d\x2c\x22\xc5\xd9\xbb\xc8\x36\x64\x72\x41\xd9\x53\xd4\x0c\x5b\x12\xda\x88\x12\x0d\x53\x17\x7f\x80\xe5\x32\xc4\x1f\xa0"
