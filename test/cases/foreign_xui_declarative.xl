    c_int fY
    c_int fW
    c_int fH
end
typedef Action = func(Widget)
typedef Ime = func(Widget) as Rect
typedef Cursor = func(Widget,c_int,c_int) as c_int
typedef Measure = func(Widget,Vec2,VecOut) as c_int
typedef Prepare = func(Widget) as c_int
typedef Layout = func(Widget,Rect) as c_int
typedef EventHandler = func(Widget,Event) as c_int
extern "xui_context_t*" class Context @header("test/cases/foreign_xui_declarative.h") @lifetime("owned") @policy("declarativeXuiContextPolicy") @scope("xui_call_scope_t") @watch("xui_lifetime_link_t")
    native point handle
    extern "xuiWidgetCreate" @no_raise @c_result("owner_view",0) @factory(1,0,rollbackWidget) func widget() as Widget
    extern "xuiSetRootWidget" @no_raise @c_result("status",0) func setRoot(Widget widget)
    extern "xuiSetFocusWidget" @no_raise @c_result("status",0) func focus(Widget widget)
    extern "xuiSetViewportSize" @no_raise @c_result("status",0) func viewport(c_int width,c_int height)
    extern "xuiInputKeyDown" @no_raise @c_result("status",0) func key(c_int code,c_uint modifiers)
    extern "xuiQueryCursor" @no_raise func cursor(c_int x,c_int y) as c_int
    extern "xuiLayout" @no_raise @c_result("status",0) func layout()
    extern "xuiGetImeCandidateRect" @no_raise func imeRect() as Rect
    extern "xl6ForeignViewCloseV1" @no_raise @c_control(0) @c_result("bool_status") func close()
end
extern "xui_widget_t*" class Widget @header("test/cases/foreign_xui_declarative.h") @lifetime("owner") @owner(Context) @policy("declarativeXuiWidgetPolicy") @watch("xui_lifetime_link_t")
    native point handle
    extern "xuiWidgetGetContext" @no_raise @c_result("owner_view",0) get context() as Context
    extern "xuiWidgetSetFocusable" @no_raise @c_result("status",0) func focusable(c_int yes)
    extern "xuiWidgetAddChild" @no_raise @c_result("status",0) func add(Widget child)
    extern "xuiLayoutArrangeChild" @no_raise @c_result("status",0) func arrange(Widget child,Rect rect)
    extern "xuiWidgetSetImeMode" @no_raise @c_result("status",0) func imeMode(c_int mode)
    extern "xuiWidgetSetDefaultActionOwned" @no_raise @c_owned_callback(0,0,"xui_callback_owner_t",0) @c_result("status",0) func onDefault(Action? callback)
    extern "xuiWidgetSetCancelActionOwned" @no_raise @c_owned_callback(0,0,"xui_callback_owner_t",0) @c_result("status",0) func onCancel(Action? callback)
    extern "xuiWidgetSetCursorQueryCallbackOwned" @no_raise @c_owned_callback(0,0,"xui_callback_owner_t",-1) @c_result("status",0) func onCursor(Cursor? callback)
    extern "xuiWidgetSetImeCandidateRectOwned" @no_raise @c_owned_callback(0,0,"xui_callback_owner_t",0) @c_result("status",0) func onIme(Ime? callback)
    extern "xuiWidgetSetContentMeasureCallbackOwned" @no_raise @c_owned_callback(0,0,"xui_callback_owner_t",-1) @c_result("status",0) func onMeasure(Measure? callback)
    extern "xuiWidgetSetLayoutPrepareCallbackOwned" @no_raise @c_owned_callback(0,0,"xui_callback_owner_t",-1) @c_result("status",0) func onPrepare(Prepare? callback)
    extern "xuiWidgetSetLayoutChildrenCallbackOwned" @no_raise @c_owned_callback(0,0,"xui_callback_owner_t",-1) @c_result("status",0) func onChildren(Layout? callback)
