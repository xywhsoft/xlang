    native point handle
    extern "fX" @c_field get x() as c_float
    extern "fX" @c_field let x(c_float value)
    extern "fY" @c_field get y() as c_float
    extern "fY" @c_field let y(c_float value)
end
extern "const xui_event_t*" class Event @header("test/cases/foreign_xui_declarative.h") @lifetime("callback") @owner(Context)
    native point handle
    extern "iType" @c_field get type() as c_int
end
extern "xuiDestroy" @no_raise func rollback(Context context)
extern "xuiWidgetDestroy" @no_raise func rollbackWidget(Widget widget)
extern "xuiCreate" @no_raise @c_result("owned_view") @factory(0,0,rollback) func create() as Context
extern "declarative_xui_start" @no_raise func start()
extern "declarative_xui_counters_begin" @no_raise func countersBegin()
extern "declarative_xui_counters_end" @no_raise func countersEnd()
func main(...) as int
    start()
    Context context=create()
    Widget widget=context.widget()
    context.setRoot(widget)
    context.viewport(100,100)
    widget.focusable(1)
    context.focus(widget)
    int actions=0
    widget.onDefault(func(Widget sender)
        actions+=1
    end)
    context.key(0x102,0)
    assert actions==1
    widget.onDefault(null)
    context.key(0x102,0)
    assert actions==1
    widget.onCancel(func(Widget sender)
        actions+=1
    end)
    context.key(0x103,0)
    assert actions==2
    widget.onCancel(null)
    widget.onIme(func(Widget sender) as Rect
        Rect result=Rect()
        result.fX=1
        result.fY=2
        result.fW=3
        result.fH=4
        return result
    end)
    widget.imeMode(1)
    assert context.imeRect().fH==4
    widget.onIme(null)
    VecOut? saved=null
    widget.onMeasure(func(Widget sender,Vec2 constraint,VecOut output) as c_int
        output.x=12.0
        output.y=13.0
        saved=output
        return c_int(0)
    end)
    Vec2 size=widget.measure(Vec2())
    assert size.fX==12.0 and size.fY==13.0
    bool expired=false
    try
        auto invalid=(saved as VecOut).x
    catch error
        expired=true
    end
    assert expired
    Widget child=context.widget()
    widget.add(child)
    int prepares=0
    int children=0
    int completes=0
    widget.onPrepare(func(Widget sender) as c_int
        prepares+=1
        return c_int(0)
    end)
    widget.onChildren(func(Widget sender,Rect rect) as c_int
        children+=1
        sender.arrange(child,rect)
        return c_int(0)
    end)
    widget.onComplete(func(Widget sender,Rect rect) as c_int
        completes+=1
        return c_int(0)
    end)
    context.layout()
    assert prepares>0 and children>0 and completes>0
    widget.onPrepare(null)
    widget.onChildren(null)
    widget.onComplete(null)
    int cursors=0
    widget.onCursor(func(Widget sender,c_int x,c_int y) as c_int
        cursors+=1
        return c_int(1)
    end)
    assert context.cursor(12,13)==1 and cursors==1
    widget.onCursor(null)
    widget.onMeasure(func(Widget sender,Vec2 constraint,VecOut output) as c_int
        output.x=12.0
        output.y=13.0
        return c_int(0)
    end)
    auto warm=widget.measure(Vec2())
    countersBegin()
    int i=0
    while i<200
        Vec2 next=widget.measure(Vec2())
        assert next.fX==12.0 and next.fY==13.0
        i+=1
    end
    countersEnd()
    widget.onMeasure(null)
    Event? savedEvent=null
    widget.onEvent(func(Widget sender,Event event) as c_int
        auto code=event.type
        savedEvent=event
        return c_int(0)
    end)
    context.key(65,0)
    assert savedEvent!=null
    expired=false
    try
        auto invalid=(savedEvent as Event).type
    catch error
        expired=true
    end
    assert expired
    widget.onEvent(null)
    widget.onDefault(func(Widget sender)
        sender.context.close()
    end)
    context.key(0x102,0)
    expired=false
    try
        widget.focusable(1)
    catch error
        expired=true
    end
    assert expired
    return 0
end
