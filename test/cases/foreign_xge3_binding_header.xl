extern "qualification_header_read" @header("test/cases/foreign_xge3_binding_header.h") @pure @no_raise @nonblocking func read() as c_int
extern "qualification_header_add" @header("test/cases/foreign_xge3_binding_header.h") @pure @no_raise @nonblocking func add(c_int left,c_int right) as c_int
export "qualification_header_forward" func forward() as c_int
 return read()
end
