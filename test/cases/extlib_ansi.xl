import ansi



func main(...) as int
    // 样式包装：开头转义 + 文本 + 重置
    assert ansi.bold("hi") == "\x1b[1mhi\x1b[0m", "bold wraps"
    assert ansi.dim("hi") == "\x1b[2mhi\x1b[0m", "dim"
    assert ansi.italic("hi") == "\x1b[3mhi\x1b[0m", "italic"
    assert ansi.underline("hi") == "\x1b[4mhi\x1b[0m", "underline"
    assert ansi.inverse("hi") == "\x1b[7mhi\x1b[0m", "inverse"
    assert ansi.strike("hi") == "\x1b[9mhi\x1b[0m", "strike"
    assert ansi.reset() == "\x1b[0m", "reset"

    // 基本颜色
    assert ansi.fg("hi", 31) == "\x1b[31mhi\x1b[0m", "fg basic red"
    assert ansi.fg("hi", 91) == "\x1b[91mhi\x1b[0m", "fg bright"
    assert ansi.bg("hi", 44) == "\x1b[44mhi\x1b[0m", "bg blue"

    // 256 色与真彩色
    assert ansi.fg256("hi", 208) == "\x1b[38;5;208mhi\x1b[0m", "fg 256"
    assert ansi.bg256("hi", 17) == "\x1b[48;5;17mhi\x1b[0m", "bg 256"
    assert ansi.fgTrue("hi", 255, 128, 0) == "\x1b[38;2;255;128;0mhi\x1b[0m", "fg truecolor"
    assert ansi.bgTrue("hi", 0, 0, 0) == "\x1b[48;2;0;0;0mhi\x1b[0m", "bg truecolor"

    // 光标控制
    assert ansi.up(2) == "\x1b[2A", "cursor up"
    assert ansi.down(3) == "\x1b[3B", "cursor down"
    assert ansi.right(1) == "\x1b[1C", "cursor right"
    assert ansi.left(4) == "\x1b[4D", "cursor left"
    assert ansi.column(10) == "\x1b[10G", "goto column"

    // 屏幕控制
    assert ansi.clearScreen() == "\x1b[2J", "clear screen"
    assert ansi.clearLine() == "\x1b[2K", "clear line"
    assert ansi.hideCursor() == "\x1b[?25l", "hide cursor"
    assert ansi.showCursor() == "\x1b[?25h", "show cursor"

    // 标题
    assert ansi.title("demo") == "\x1b]0;demo\x07", "window title"

    // strip 去掉转义
    assert ansi.strip(ansi.bold("hello")) == "hello", "strip bold"
    assert ansi.strip(ansi.fg256("a b", 200)) == "a b", "strip 256"
    assert ansi.strip("plain") == "plain", "strip plain"
    assert ansi.strip(ansi.title("x") + "text") == "text", "strip osc"

    // 显示宽度
    assert ansi.displayWidth("hello") == 5, "ascii width"
    assert ansi.displayWidth(ansi.bold("hello")) == 5, "escaped width skips codes"
    assert ansi.displayWidth("中文") == 4, "cjk width 2 each"
    assert ansi.displayWidth(ansi.fgTrue("中文", 1, 2, 3)) == 4, "cjk width with escapes"
    assert ansi.displayWidth("") == 0, "empty width"

    return 0
end
