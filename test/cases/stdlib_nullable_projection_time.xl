func main(...) as int
    time? first = time(-1)
    time? second = time(9223372036854775807)
    OrderedMap<int, time?> tree = OrderedMap::<int, time?>()
    assert(tree.set(1, null) and tree.set(2, first) and tree.set(3, second))
    array<time?> values = tree.values()
    assert(values.length == 3 and values[0] == null and values[1] == first and values[2] == second)
    SpscQueue<time?> queue = SpscQueue::<time?>(4)
    auto pushStatus, pushed = queue.pushBatch(values)
    assert(pushStatus == queueStatus.ok and pushed == 3)
    auto popStatus, output = queue.popBatch(4)
    assert(popStatus == queueStatus.ok and output.length == 3)
    assert(output.length == 3 and output[0] == null and output[1] == first and output[2] == second)
    time? absentA = null
    time? absentB = null
    assert(absentA == absentB and absentA != first and first != second and first == first)
    int count = 0
    for item in output
        if item != null
            count += 1
        end
    end
    assert(count == 2)
    return 0
end
