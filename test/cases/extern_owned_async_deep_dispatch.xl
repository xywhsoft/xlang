// Check base-typed and derived-typed bindings beyond the old 32-step limit.
Level0 receiver=Level33()
func() as future<Result> callback=receiver.Factory
Result value=await callback()
println(dispatched)
assert dispatched==33 and value()=="hello"
receiver=Level40()
callback=receiver.Factory
value=await callback()
assert dispatched==40 and value()=="hello"
Level40 deepest=Level40()
func() as future<Result> direct=deepest.Factory
value=await direct()
assert dispatched==40 and value()=="hello"

assert balanced()
