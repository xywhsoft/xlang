// A header split across read-ahead and TCP; saved events own their sender.
class SavedEvent
    WsEvent? value = null
end
async func verify()
    auto engine = NetEngine(NetEngineOptions().withWorkers(1).withBackend(NetBackend.select))
    engine.start()
    auto listener = TcpListener(engine, TcpListenOptions(NetAddress.loopback(4, 0)))
    auto tcp = TcpStream(engine, listener.localAddress())
    auto peer = listener.accept(5000)
    assert tcp.wait(TcpWait.open, 5000) == NetStatus.ok
    auto pending = WsUpgrade.client("local.test")
    auto request = Http1Head.request(Http1.requestHead("GET", "/ws", pending.headers()))
    if request == null then throw ValueError "incomplete request" end
    auto serverUpgrade = WsUpgrade.server(request)
    auto response = Http1Head.response(Http1.responseHead(101, "Switching Protocols", serverUpgrade.headers()))
    if response == null then throw ValueError "incomplete response" end
    auto clientUpgrade = pending.checkResponse(response)
    auto prefix = NetBuffer()
    prefix.append(b"\x82")
    auto tail = Buffer(b"\x83\x12\x34\x56\x78")
    auto payload = Buffer(b"a\0b")
    WsFrame.applyMask(payload, 305419896)
    tail.append(payload.toBytes())
    assert tcp.send(tail) == NetStatus.ok
    auto options = WsStreamOptions()
    auto server = await WsStream.attachAsync(peer, prefix, serverUpgrade, options, func(WsEvent event) as bool
        if event.kind == WsEventKind.messageData then
            assert event.stream.sendBinary(event.data) == NetStatus.ok
        end
        return true
    end)
    assert prefix.length == 0
    auto stored = SavedEvent()
    auto count = AtomicInt32(0)
    auto client = await WsStream.attachAsync(tcp, NetBuffer(), clientUpgrade, options, func(WsEvent event) as bool
        if event.kind == WsEventKind.messageData then
            stored.value = event
            count.fetchAdd(1)
        end
        return true
    end)
    int spins = 0
    while count.load() == 0 and spins < 5000
        time.sleep(1)
        spins = spins + 1
    end
    assert count.load() == 1
    assert (await client.closeAsync()) == NetStatus.ok
    assert (await server.waitClosedAsync(5000)) == NetStatus.ok
    assert (await client.waitClosedAsync(5000)) == NetStatus.ok
    auto snapshot = stored.value
    if snapshot == null then throw ValueError "missing saved event" end
    assert snapshot.data == b"a\0b"
    assert snapshot.stream.state == WsStreamState.closed
    listener.close()
    engine.close()
    assert engine.wait(5000)
    println("websocket-upgrade-loopback-ok")
end
await verify()
