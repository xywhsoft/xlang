import money

func main(...) as int
    int maximum = 9223372036854775807
    int minimum = -9223372036854775807 - 1

    // 整数边界：不能回绕或产生无诊断的错误金额。
    assert money.add(maximum, 0) == maximum
    assert money.sub(minimum, 0) == minimum
    assert money.mul(minimum, 1) == minimum
    int caught = 0
    try
        money.add(maximum, 1)
    catch e
        caught += 1
    end
    try
        money.sub(minimum, 1)
    catch e
        caught += 1
    end
    try
        money.mul(minimum, -1)
    catch e
        caught += 1
    end
    assert caught == 3

    // 精确有理数计算按绝对值四舍五入，且可处理乘积大于 int64 的中间值。
    assert money.scale(1, 1, 2) == 1
    assert money.scale(-1, 1, 2) == -1
    assert money.scale(100, -1, 8) == -13
    assert money.scale(100, 1, -8) == -13
    assert money.scale(minimum, 1, minimum) == 1
    assert money.scale(minimum, minimum, minimum) == minimum
    assert money.scale(maximum, maximum, maximum) == maximum
    assert money.scale(minimum, 1, 1) == minimum
    caught = 0
    try
        money.scale(1, 1, 0)
    catch e
        caught += 1
    end
    try
        money.scale(maximum, 2, 1)
    catch e
        caught += 1
    end
    assert caught == 2

    // rate(1.0) 必须保持大整数原值，不能因舍入偏移误报溢出。
    assert money.rate(maximum, 1.0) == maximum
    assert money.rate(minimum, 1.0) == minimum
    assert money.rate(maximum, 0.0) == 0

    // 均分负数时，前几份减少一单位；总和始终等于原金额。
    var negative = money.split(-101, 3)
    assert negative[0] == -34 and negative[1] == -34 and negative[2] == -33
    assert int(negative[0]) + int(negative[1]) + int(negative[2]) == -101
    var small = money.split(-2, 4)
    assert small[0] == -1 and small[1] == -1 and small[2] == 0 and small[3] == 0

    // 极值在不同份数下仍守恒；前部只承担一单位的余数差。
    for count in range(1, 17)
        var high = money.split(maximum, count)
        var low = money.split(minimum, count)
        int highSum = 0
        int lowSum = 0
        for index in range(count)
            highSum += int(high[index])
            lowSum += int(low[index])
        end
        assert highSum == maximum and lowSum == minimum
        assert int(high[0]) - int(high[count - 1]) <= 1
        assert int(low[count - 1]) - int(low[0]) <= 1
    end

    assert money.format(minimum, "USD") == "$-92,233,720,368,547,758.08"
    assert money.format(123, "xyz") == "XYZ 1.23"
    assert money.symbol("rub") == "₽"
    assert money.format(123, "RUB") == "₽1.23"
    caught = 0
    try
        money.format(123, "LONG")
    catch e
        caught += 1
    end
    try
        money.exponent("U\u0000D")
    catch e
        caught += 1
    end
    try
        money.symbol("X!")
    catch e
        caught += 1
    end
    assert caught == 3
    println("money boundaries: PASS")
    return 0
end
