extern "borrowedRecordBudget" @header("test/cases/foreign_borrowed_value_record.h") @no_raise func budget(c_int allowance)
extern "borrowedRecordMark" @header("test/cases/foreign_borrowed_value_record.h") @no_raise func mark()
extern "borrowedRecordBalanced" @header("test/cases/foreign_borrowed_value_record.h") @no_raise func balanced() as c_int
extern "borrowedRecordRead" @header("test/cases/foreign_borrowed_value_record.h") @no_raise @c_output_record(1,"BorrowedValueRecord","borrowed") @c_output_size(1,"iSize") @c_status(0) @c_output_field(0,"name","cstring") @c_output_field(1,"data","borrowed_value") @c_output_field(2,"tail","cstring") @c_data_snapshot_result(1) func read(c_int mode=0) as (string?,var,string?)
extern "borrowedRecordRead" @header("test/cases/foreign_borrowed_value_record.h") @no_raise @c_output_record(1,"BorrowedValueRecord","borrowed") @c_output_size(1,"iSize") @c_status(0) @c_output_field(0,"name","cstring") @c_output_field(1,"data","borrowed_value") @c_output_field(2,"tail","cstring") func readShared(c_int mode=0) as (string?,var,string?)
extern "borrowedRecordReadPair" @header("test/cases/foreign_borrowed_value_record.h") @no_raise @c_output_record(0,"BorrowedValuePair","borrowed") @c_status(0) @c_output_field(0,"first","borrowed_value") @c_output_field(1,"second","borrowed_value") @c_data_snapshot_result(0) @c_data_snapshot_result(1) func readPair() as (var,var)
