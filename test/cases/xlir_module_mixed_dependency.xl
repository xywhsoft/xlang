extern "dependency_peer" func dependencyPeer(int id) as future<int>
extern "dependency_caught" func dependencyCaught(int id)
extern "dependency_finally" func dependencyFinally(int id)
extern "dependency_after" func dependencyAfter(int id)
extern "dependency_boot" func dependencyBoot() as future<int>
extern "dependency_callback" func dependencyCallback(int id, int stage)
extern "module_executor_dropped" func moduleDropped()
string moduleText = "mixed " + "alive"
class ModuleMarker
    destroy()
        assert moduleText == "mixed alive", "Globals retired before mixed graph finalization"
        moduleDropped()
    end
end
ModuleMarker marker = ModuleMarker()
func leaf() as int
    assert moduleText == "mixed alive", "Globals retired before accepted task"
    return 19
end
func identity(int value) as int
    return value
end
func preserve(error failure) as int
    throw failure.message
    return 0
end
async func moduleCycle(int id, future<int> boot, future<int> cleanup, bool waitCleanup) as int
    try
        int accepted = await task.spawn(leaf)
        assert accepted == 19, "Accepted task lost its result"
        int ignored = await boot
        future<int> peer = dependencyPeer(id).then(identity).catch(preserve)
        future<int> first = peer.finally(func()
            assert moduleText == "mixed alive", "Globals retired before first Future callback"
            dependencyCallback(id, 0)
        end)
        future<int> second = first.finally(func()
            assert moduleText == "mixed alive", "Globals retired before second Future callback"
            dependencyCallback(id, 1)
        end)
        int number = await second
        dependencyAfter(id)
        return number
    catch CancelledError failure
        assert moduleText == "mixed alive", "Globals retired before async catch"
        dependencyCaught(id)
        throw
    finally
        if waitCleanup
            int ignored = await cleanup
        end
        assert moduleText == "mixed alive", "Globals retired before async finally"
        dependencyFinally(id)
    end
end
export "module_executor_keep" func keep()
    auto output = moduleCycle(0, dependencyBoot(), dependencyBoot(), false)
end
