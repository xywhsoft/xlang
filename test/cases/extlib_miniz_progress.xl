import miniz

class MinizProgressState
    int calls = 0
    int lastInput = 0
    int lastTotal = 0
end

func exercise(string workDir)
    string sourcePath = path.join(workDir, "source.txt")
    string packedPath = path.join(workDir, "packed.zz")
    string plainPath = path.join(workDir, "plain.txt")
    string cancelledPath = path.join(workDir, "cancelled.zz")
    string text = ""
    int i = 0
    while i < 6000
        text += "xlang-progress-" + string(i) + "\n"
        i += 1
    end
    file.writeText(sourcePath, text)

    MinizProgressState packedState = MinizProgressState()
    miniz.compressFile(sourcePath, packedPath, onProgress = func(int inputBytes,
        int totalBytes, int outputBytes) as bool
        packedState.calls += 1
        packedState.lastInput = inputBytes
        packedState.lastTotal = totalBytes
        return outputBytes >= 0
    end)
    assert packedState.calls > 0
    assert packedState.lastInput == string.byteLen(text)
    assert packedState.lastTotal == packedState.lastInput

    MinizProgressState plainState = MinizProgressState()
    miniz.decompressFile(packedPath, plainPath, onProgress = func(int inputBytes,
        int totalBytes, int outputBytes) as bool
        plainState.calls += 1
        plainState.lastInput = inputBytes
        plainState.lastTotal = totalBytes
        return outputBytes >= 0
    end)
    assert plainState.calls > 0
    assert plainState.lastInput == plainState.lastTotal
    assert file.readText(plainPath) == text

    // 零结尾 C 路径不能忽略 NUL 后缀。
    string nulPacked = path.join(workDir, "nul_packed.zz")
    string nulPlain = path.join(workDir, "nul_plain.txt")
    if file.exists(nulPacked) then file.delete(nulPacked) end
    if file.exists(nulPlain) then file.delete(nulPlain) end
    bool badPath = false
    try
        miniz.compressFile(sourcePath + "\0hidden", nulPacked)
    catch ValueError e
        badPath = true
    end
    assert badPath and not file.exists(nulPacked)
    badPath = false
    try
        miniz.decompressFile(packedPath, nulPlain + "\0hidden")
    catch ValueError e
        badPath = true
    end
    assert badPath and not file.exists(nulPlain)

    bool cancelled = false
    try
        miniz.compressFile(sourcePath, cancelledPath, onProgress = func(int inputBytes,
            int totalBytes, int outputBytes) as bool
            return false
        end)
    catch CancelledError e
        cancelled = true
    end
    assert cancelled
    assert not file.exists(cancelledPath)

end

func main(...) as int
    string workDir = dir.temp(path.temp(), "xlang_miniz_progress_", "")
    try
        exercise(workDir)
    finally
        string sourcePath = path.join(workDir, "source.txt")
        string packedPath = path.join(workDir, "packed.zz")
        string plainPath = path.join(workDir, "plain.txt")
        string cancelledPath = path.join(workDir, "cancelled.zz")
        string nulPacked = path.join(workDir, "nul_packed.zz")
        string nulPlain = path.join(workDir, "nul_plain.txt")
        if file.exists(sourcePath) then assert file.delete(sourcePath) end
        if file.exists(packedPath) then assert file.delete(packedPath) end
        if file.exists(plainPath) then assert file.delete(plainPath) end
        if file.exists(cancelledPath) then assert file.delete(cancelledPath) end
        if file.exists(nulPacked) then assert file.delete(nulPacked) end
        if file.exists(nulPlain) then assert file.delete(nulPlain) end
        assert dir.delete(workDir)
    end
    return 0
end
