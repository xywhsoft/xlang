class Profile
    derive value

    int id = 0
    string displayName @json("display_name") @xlon("displayNameX") = ""
    private string secret @persist(name="secret_name", include) = ""
    string password @persist(skip) = ""
    string note @json(omit=empty) @xlon(omit=null) = ""

    func setSecret(string value)
        self.secret = value
    end

    func secretValue() as string
        return self.secret
    end
end

extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectText(string actual, string expected)

Profile p = Profile()
p.id = 42
p.displayName = "Alice"
p.setSecret("open")
p.password = "hidden"
p.note = ""

string jsonText = json.stringify(p)
expect(string.contains(jsonText, "display_name"), 1)
expect(string.contains(jsonText, "displayNameX"), 0)
expect(string.contains(jsonText, "secret_name"), 1)
expect(string.contains(jsonText, "password"), 0)
expect(string.contains(jsonText, "note"), 0)

Profile fromJson = json.parse::<Profile>(jsonText)
expect(fromJson.id, 42)
expectText(fromJson.displayName, "Alice")
expectText(fromJson.secretValue(), "open")

string xlonText = xlon.stringify(p)
expect(string.contains(xlonText, "displayNameX"), 1)
expect(string.contains(xlonText, "display_name"), 0)
expect(string.contains(xlonText, "secret_name"), 1)
expect(string.contains(xlonText, "password"), 0)
expect(string.contains(xlonText, "note"), 1)

Profile fromXlon = xlon.parse::<Profile>(xlonText)
expect(fromXlon.id, 42)
expectText(fromXlon.displayName, "Alice")
expectText(fromXlon.secretValue(), "open")
