extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

string missingFile = "build/test/stdlib_missing_file.txt"
string missingCopy = "build/test/stdlib_missing_copy.txt"
string missingMove = "build/test/stdlib_missing_move.txt"
string missingDir = "build/test/stdlib_missing_dir"
string missingDirCopy = "build/test/stdlib_missing_dir_copy"
string missingDirMove = "build/test/stdlib_missing_dir_move"
string badJson = "build/test/stdlib_bad.json"
string badXlon = "build/test/stdlib_bad.xlon"

file.delete(missingFile)
file.delete(missingCopy)
file.delete(missingMove)
dir.delete(missingDir)
dir.delete(missingDirCopy)
dir.delete(missingDirMove)
file.delete(badJson)
file.delete(badXlon)

expect(file.exists(missingFile), 0)
bool missingReadCaught = false
try
    string missingText = file.readText(missingFile)
catch e
    if e.kind == "FileError" and string.contains(e.message, "does not exist") then
        missingReadCaught = true
    end
end
expect(missingReadCaught, 1)
expect(file.copy(missingFile, missingCopy), 0)
expect(file.move(missingFile, missingMove), 0)
expect(file.delete(missingFile), 0)

expect(dir.exists(missingDir), 0)
expect(dir.copy(missingDir, missingDirCopy), 0)
expect(dir.move(missingDir, missingDirMove), 0)
expect(dir.delete(missingDir), 0)

array missingList = dir.list(missingDir)
array missingFiles = dir.files(missingDir)
array missingDirs = dir.dirs(missingDir)
expect(missingList.length, 0)
expect(missingFiles.length, 0)
expect(missingDirs.length, 0)

var invalidJson = json.parse("{")
expect(type(invalidJson) == null, 1)
expect(json.write("build/test/stdlib_missing_dir/out.json", {"a": 1}), 0)
expect(file.writeText(badJson, "{"), 1)
var invalidJsonFile = json.read(badJson)
expect(type(invalidJsonFile) == null, 1)
expect(file.delete(badJson), 1)

var invalidXlon = xlon.parse("{")
expect(type(invalidXlon) == null, 1)
expect(xlon.write("build/test/stdlib_missing_dir/out.xlon", {"a": 1}), 0)
expect(file.writeText(badXlon, "{"), 1)
var invalidXlonFile = xlon.read(badXlon)
expect(type(invalidXlonFile) == null, 1)
expect(file.delete(badXlon), 1)


expect(process.success("cmd /c exit /b 5"), 0)
expect(process.exitCode("cmd /c exit /b 5"), 5)
expectStr(process.exec("cmd /c exit /b 5"), "")
