// Real local host backend. Its OS-only fixture has no XRT/compiler dependency.
import xge
extern "xge_test_host_probe_info" struct ProbeInfo @header("test/cases/foreign_xge3_host_probe.h")
 c_uint platformInit
 c_uint graphicsInit
 c_uint platformUnit
 c_uint graphicsUnit
 c_uint begins
 c_uint ends
 c_uint polls
 c_uint presents
 c_uint releases
 c_uint makeCurrent
 c_uint lookups
 bool contextLive
 bool platformLive
end
extern "xgeTestHostConfigure" @header("test/cases/foreign_xge3_host_probe.h") @no_raise @c_result("status",0) func configure(c_int backend,bool deferRelease)
extern "xgeTestHostPlatformInit" @header("test/cases/foreign_xge3_host_probe.h") @no_raise func platformInit() as c_int
extern "xgeTestHostGraphicsInit" @header("test/cases/foreign_xge3_host_probe.h") @no_raise func graphicsInit() as c_int
extern "xgeTestHostPlatformUnit" @header("test/cases/foreign_xge3_host_probe.h") @no_raise func platformUnit()
extern "xgeTestHostGraphicsUnit" @header("test/cases/foreign_xge3_host_probe.h") @no_raise func graphicsUnit()
extern "xgeTestHostMakeCurrent" @header("test/cases/foreign_xge3_host_probe.h") @no_raise func makeCurrent() as c_int
extern "xgeTestHostIsCurrent" @header("test/cases/foreign_xge3_host_probe.h") @no_raise func isCurrent() as c_int
extern "xgeTestHostRelease" @header("test/cases/foreign_xge3_host_probe.h") @no_raise func release() as xge.HostReleaseResult
extern "xgeTestHostBegin" @header("test/cases/foreign_xge3_host_probe.h") @no_raise func beginFrame() as c_int
extern "xgeTestHostEnd" @header("test/cases/foreign_xge3_host_probe.h") @no_raise func endFrame() as c_int
extern "xgeTestHostPoll" @header("test/cases/foreign_xge3_host_probe.h") @no_raise func poll() as c_int
extern "xgeTestHostPresent" @header("test/cases/foreign_xge3_host_probe.h") @no_raise func present()
extern "xgeTestHostInfo" @header("test/cases/foreign_xge3_host_probe.h") @no_raise @c_output(0,0) func probeInfo() as ProbeInfo
extern "xgeTestHostGetProc" @header("test/cases/foreign_xge3_host_probe.h") @no_raise func getProc(xge.CallbackProcName name) as point
extern "xgeTestHostTargetFramebuffer" @header("test/cases/foreign_xge3_host_probe.h") @no_raise @c_const(0) func targetFramebuffer(xge.RenderTarget target) as c_uint

class ResolverCapture
 xge.CallbackProcName? name=null
end

// A callback error and an OS obligation are separate facts. Check both: a
// consumed end/present must not be replayed, and an unconsumed release must
// remain retryable. Each iteration creates and destroys a real local context.
func checkCallbackErrors(c_int backend)
 for mode in range(7)
  configure(backend,false)
  xge.init(4,4,"Explicit host callback errors",0,xge.XGE_RUN_MANUAL)
  bool fail=true
  // Read-only scalar captures are snapshots; share a mutable gate explicitly.
  auto releaseAllowed=[mode!=5]
  int releaseEntries=0
  auto platform=xge.createPlatformBackend(xge.XGE_PLATFORM_BACKEND_CUSTOM,"local OS",platformInit,func()
   platformUnit()
   if mode==6 and fail then
    fail=false
    throw ValueError "host platform unit"
   end
  end,func() as c_int
   auto result=poll()
   if mode==0 and fail then
    fail=false
    throw ValueError "host poll"
   end
   return result
  end,func()
   present()
   if mode==3 and fail then
    fail=false
    throw ValueError "host present"
   end
  end)
  auto graphics=xge.createGraphicsBackend(backend,"local GL",graphicsInit,func()
   graphicsUnit()
   if mode==4 and fail then
    fail=false
    throw ValueError "host graphics unit"
   end
  end,func() as c_int
   if mode==1 and fail then
    fail=false
    throw ValueError "host begin"
   end
   return beginFrame()
  end,func() as c_int
   auto result=endFrame()
   if mode==2 and fail then
    fail=false
    throw ValueError "host end"
   end
   return result
  end)
  auto host=xge.createHostSession(4,4,1,0,platform,graphics,makeCurrent,isCurrent,func() as xge.HostReleaseResult
   releaseEntries+=1
   if mode==5 and fail then
    fail=false
    throw ValueError "host release"
   end
   if not releaseAllowed[0] then return xge.HostReleaseResult() end
   return release()
  end)
  platform.close()
  graphics.close()
  bool caught=false
  try
   if mode==0 then
    host.poll()
   elseif mode==1 then
    host.beginFrame()
   elseif mode==2 then
    host.beginFrame()
    host.endFrame()
   elseif mode==3 then
    host.beginFrame()
    host.endFrame()
    host.present()
   else
    host.close()
   end
  catch ValueError failure
   caught=true
  end
  assert caught and not fail
  if mode<4 then
   auto info=host.info()
   assert not info.frameOpen and not info.presentPending
   assert host.poll()==c_int(9)
   host.beginFrame()
   host.endFrame()
   host.present()
  elseif mode==5 then
   assert probeInfo().contextLive
   releaseAllowed[0]=true
  end
  host.close()
  auto state=probeInfo()
  assert not state.contextLive and not state.platformLive
  assert state.platformUnit==c_uint(1) and state.graphicsUnit==c_uint(1)
  assert state.releases==c_uint(1)
  assert releaseEntries==1 or (mode==5 and releaseEntries>=2)
  if mode<4 then
   c_uint frames=c_uint(1)
   if mode==2 or mode==3 then frames=c_uint(2) end
   assert state.begins==frames and state.ends==frames
   assert state.polls==c_uint(1) or (mode==0 and state.polls==c_uint(2))
   assert state.presents==c_uint(1) or (mode==3 and state.presents==c_uint(2))
  else
   assert state.begins==c_uint(0) and state.ends==c_uint(0)
   assert state.polls==c_uint(0) and state.presents==c_uint(0)
  end
  xge.unit()
  assert xge.graphicsResourceCount()==uint64(0)
 end
end

// A failing resolver must unwind the partially initialized real context and
// preserve the language exception. A missing symbol is a checked native error.
func checkResolverErrors(c_int backend)
 for mode in range(2)
  configure(backend,false)
  xge.init(4,4,"Explicit host resolver errors",0,xge.XGE_RUN_MANUAL)
  auto platform=xge.createPlatformBackend(xge.XGE_PLATFORM_BACKEND_CUSTOM,"local OS",platformInit,platformUnit,poll,present)
  auto graphics=xge.createGraphicsBackend(backend,"local GL",graphicsInit,graphicsUnit,beginFrame,endFrame)
  auto calls=[0]
  bool caught=false
  try
   auto host=xge.createHostSession(4,4,1,0,platform,graphics,makeCurrent,isCurrent,release,func(xge.CallbackProcName name) as point
    calls[0]+=1
    assert name.length()>c_size(0)
    if mode==0 then throw ValueError "host resolver" end
    return null
   end)
   host.close()
  catch ValueError failure
   assert mode==0
   caught=true
  catch failure
   assert mode==1
   caught=true
  end
  assert caught and calls[0]>0
  platform.close()
  graphics.close()
  auto state=probeInfo()
  assert not state.contextLive and not state.platformLive
  assert state.platformInit==c_uint(1) and state.graphicsInit==c_uint(1)
  assert state.platformUnit==c_uint(1) and state.graphicsUnit==c_uint(1)
  assert state.releases==c_uint(1)
  xge.unit()
  assert xge.graphicsResourceCount()==uint64(0)
 end
end

func main(...) as int
 c_int backend=xge.XGE_GPU_BACKEND_OPENGL33
 bool deferredRelease=false
 bool customResolver=false
 configure(backend,deferredRelease)
 xge.init(4,4,"Explicit host integration",0,xge.XGE_RUN_MANUAL)
 c_int platformUnits=c_int(0)
 c_int graphicsUnits=c_int(0)
 c_int releaseCalls=c_int(0)
 auto capture=ResolverCapture()
 xge.GlProcResolver? resolver=null
 if customResolver then
  resolver=func(xge.CallbackProcName name) as point
   assert name.length()>c_size(0) and name.compare("")>c_int(0)
   capture.name=name
   return getProc(name)
  end
 end
 auto platform=xge.createPlatformBackend(xge.XGE_PLATFORM_BACKEND_CUSTOM,"local OS",platformInit,func()
  platformUnits+=c_int(1)
  platformUnit()
 end,poll,present)
 auto graphics=xge.createGraphicsBackend(backend,"local GL",graphicsInit,func()
  graphicsUnits+=c_int(1)
  graphicsUnit()
 end,beginFrame,endFrame)
 auto host=xge.createHostSession(4,4,1,0,platform,graphics,makeCurrent,isCurrent,func() as xge.HostReleaseResult
  releaseCalls+=c_int(1)
  return release()
 end,resolver)
 auto shared=host.share()
 if customResolver then
  assert capture.name!=null and probeInfo().lookups>c_uint(0)
  bool expired=false
  auto saved=capture.name
  if saved!=null then
   try
    saved.length()
   catch error
    expired=true
   end
  end
  assert expired
  capture.name=null
 else
  assert probeInfo().lookups==c_uint(0)
 end
 host.close()
 // The session owns independent native references to both descriptor groups.
 platform.close()
 graphics.close()
 assert shared.isCurrent() and shared.poll()==c_int(9)
 auto hostTarget=xge.createRenderTarget(4,4)
 auto framebuffer=targetFramebuffer(hostTarget)
 assert framebuffer!=c_uint(0)
 shared.resize(4,4,2,framebuffer)
 shared.beginFrame()
 bool busy=false
 try
  shared.close()
 catch error
  busy=true
 end
 assert busy and shared.info().frameOpen
 assert xge.getWidth()==c_int(4) and xge.getHeight()==c_int(4)
 auto target=xge.createRenderTarget(2,2)
 auto pass=xge.createPass(target,c_uint(xge.XGE_PASS_CLEAR_COLOR),xge.colorRGBA(10,20,30,255))
 pass.begin()
 auto rect=xge.Rect()
 rect.fW=c_float(2)
 rect.fH=c_float(2)
 xge.shapeRectFill(rect,xge.colorRGBA(80,90,100,255))
 auto window=xge.createWindowTarget()
 assert window.width==c_int(4) and window.height==c_int(4)
 auto windowPass=xge.createPass(window,c_uint(xge.XGE_PASS_CLEAR_COLOR),xge.colorRGBA(0,255,0,255))
 windowPass.begin()
 windowPass.finish()
 assert pass.isCurrent() and xge.getWidth()==c_int(2)
 pass.finish()
 shared.endFrame()
 shared.present()
 auto pixels=Buffer()
 assert pixels.resize(16)
 target.readPixels(pixels)
 assert pixels.hex()=="505a64ff505a64ff505a64ff505a64ff"
 auto windowPixels=Buffer()
 assert windowPixels.resize(64)
 window.readPixels(windowPixels)
 assert windowPixels.hex()==string.repeat("00ff00ff",16)
 windowPass.close()
 window.close()
 pass.close()
 target.close()
 shared.resize(4,4,2,0)
 shared.beginFrame()
 shared.endFrame()
 shared.discardFrame()
 hostTarget.close()
 try
  shared.close()
 catch error
  assert deferredRelease
 end
 shared.close()
 auto state=probeInfo()
 assert !state.contextLive and !state.platformLive
 assert state.platformInit==c_uint(1) and state.graphicsInit==c_uint(1)
 assert state.platformUnit==c_uint(1) and state.graphicsUnit==c_uint(1)
 assert platformUnits==c_int(1) and graphicsUnits==c_int(1)
 assert state.begins==c_uint(2) and state.ends==c_uint(2)
 assert state.polls==c_uint(1) and state.presents==c_uint(1)
 if deferredRelease then
  assert releaseCalls==c_int(2) and state.releases==c_uint(2)
 else
  assert releaseCalls==c_int(1) and state.releases==c_uint(1)
 end
 xge.unit()
 assert xge.graphicsResourceCount()==uint64(0)
 checkCallbackErrors(backend)
 if customResolver then checkResolverErrors(backend) end
 println("PUBLIC_HOST_SESSION_REAL_GL_OK")
 return 0
end
