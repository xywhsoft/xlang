var data = {
    "title": "xlang",
    "show": true,
    "users": [
        {"name": "Ada"},
        {"name": "Lin"}
    ]
}

Template compiled = template.compile("<h1>{$title}</h1>{#if:show}Y{#else}N{#end}:{#foreach:users}{$name};{#end}")
assert compiled.render(data) == "<h1>xlang</h1>Y:Ada;Lin;"
assert compiled.nodeCount > 0
assert compiled.source == "<h1>{$title}</h1>{#if:show}Y{#else}N{#end}:{#foreach:users}{$name};{#end}"
assert compiled.node(0).type > 0

assert template.render("Hello {$title}", data) == "Hello xlang"
auto delimiters = TemplateCompileOptions()
delimiters.open = "{{"
delimiters.close = "}}"
assert template.compile("{{$title}}", delimiters).render(data) == "xlang"
delimiters.open = "<"
delimiters.close = ">"
assert template.compile("<$title>", delimiters).render(data) == "xlang"

dir.createAll("build/test/stdlib_template")
file.writeText("build/test/stdlib_template/page.xte", "File {$title}")
assert template.renderFile("build/test/stdlib_template/page.xte", data) == "File xlang"
Template fromFile = template.compileFile("build/test/stdlib_template/page.xte")
assert fromFile.render(data) == "File xlang"
file.delete("build/test/stdlib_template/page.xte")
dir.delete("build/test/stdlib_template")
