class GraphRecipeUnused
    derive value
    int unused = 4
end
func unusedRestoreGraph() as GraphRecipeUnused
    return json.parse::<GraphRecipeUnused>("{}")
end
GraphRecipeWide value = GraphRecipeWide()
GraphRecipeWide fromJson = json.parse::<GraphRecipeWide>(json.stringify(value))
GraphRecipeWide fromXlon = xlon.parse::<GraphRecipeWide>(xlon.stringify(value))
assert fromJson.left.value == 11 and fromJson.right.value == 22
assert fromXlon.left.value == 11 and fromXlon.right.value == 22
GraphRecipeWide defaults = json.parse::<GraphRecipeWide>("{\"left\":{},\"right\":{},\"optional\":{}}")
assert defaults.left.value == 11 and defaults.right.value == 22
GraphRecipeLeaf optional = defaults.optional ?? GraphRecipeLeaf(0)
assert optional.value == 7
assert defaults.f69 == 69
