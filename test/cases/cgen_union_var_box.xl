extern "expect_i64" func expect(int actual, int expected)

union Payload
    int i
    c_double d
end

Payload p
p.i = 42

var boxed = p
expect(type(boxed) == Payload, 1)

array<Payload> payloads = array[p]
array<Payload> copied = payloads
var boxedPayloads = copied

Payload same
same.i = 42

Payload other
other.i = 43

set<Payload> payloadSet = set{p, same, other, same}

expect(type(boxedPayloads) == type(copied), 1)
expect(copied.length, 1)
expect(copied[0].i, 42)

int payloadCount = 0
for item in payloadSet
    payloadCount = payloadCount + 1
    expect(type(item) == Payload, 1)
end
expect(payloadCount, 2)
