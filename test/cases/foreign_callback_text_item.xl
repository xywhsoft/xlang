from xui import CallbackProxy,CallbackProxyTextItem,CallbackVec2Output,Proxy,Vec2,XUI_PROXY_VERSION

extern "const xl_test_inline_text_t*" class InlineText @header("test/cases/foreign_callback_text_item.h") @lifetime("callback")
 native point handle
 extern "data" @c_field @c_length("size","int","minus_one_terminated") @c_result("text_view") get text() as string
end

typedef Measure=func(CallbackProxy,CallbackProxyTextItem,CallbackVec2Output) as c_int
typedef ReadInline=func(InlineText) as c_int

extern "xuiProxyReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func releaseProbe(Proxy value)
extern "xuiProxyCreateOwned" @header("xge3_runtime.h") @no_raise @c_result("owned_view") @factory(2,0,releaseProbe) @c_pack(0,"xui_proxy_t",0,2) @c_pack_size(0,"iSize","uint32_t") @c_pack_field(0,"iVersion",0,"value") @c_pack_callback_group(0,"pUser",1) @c_pack_field(0,"textMeasure",1,"owned_callback") @c_owned_callback(1,-1,"xui_callback_owner_t",-16,"receiver") func makeProxy(c_uint version,Measure callback) as Proxy
extern "xl_test_callback_text_item" @header("test/cases/foreign_callback_text_item.h") @no_raise @c_result("status",0) func measure(Proxy proxy,c_int mode)
extern "xl_test_inline_text" @header("test/cases/foreign_callback_text_item.h") @no_raise @c_result("status",0) @c_sync_callback(0,-1,-16) func readInline(ReadInline read,c_int mode)

class Seen
 CallbackProxyTextItem? saved=null
 string text=""
 string? context=null
 string? language=null
end

func main(...) as int
 auto seen=Seen()
 auto proxy=makeProxy(c_uint(XUI_PROXY_VERSION),func(CallbackProxy backend,CallbackProxyTextItem item,CallbackVec2Output output) as c_int
  assert backend.version==c_uint(XUI_PROXY_VERSION)
  assert item.flags==c_uint(7) and item.script==c_uint(0x4c61746e)
  assert item.drawOffsetX==c_float(0.25)
  seen.saved=item
  seen.text=item.text
  seen.context=item.context
  seen.language=item.language
  auto result=Vec2()
  result.fX=c_float(3.5)
  result.fY=c_float(2)
  output.value=result
  return c_int(0)
 end)
 measure(proxy,c_int(0))
 assert seen.text=="a\0b" and seen.context==null and seen.language==null
 measure(proxy,c_int(1))
 assert seen.text=="a" and (seen.context as string)=="ab" and (seen.language as string)=="en"
 measure(proxy,c_int(4))
 assert seen.text=="a\0b" and (seen.context as string)==""
 bool expired=false
 try
  assert (seen.saved as CallbackProxyTextItem).text==""
 catch error
  expired=true
 end
 assert expired

 for mode in [2,3,5]
  bool rejected=false
  try
   measure(proxy,c_int(mode))
  catch error
   rejected=true
  end
  assert rejected
 end
 readInline(func(InlineText record) as c_int
  assert record.text=="abc"
  return c_int(0)
 end,c_int(0))
 readInline(func(InlineText record) as c_int
  assert record.text=="abcd"
  return c_int(0)
 end,c_int(2))
 for mode in [1,3]
  bool rejected=false
  try
   readInline(func(InlineText record) as c_int
    assert record.text==""
    return c_int(0)
   end,c_int(mode))
  catch error
   rejected=true
  end
  assert rejected
 end
 proxy.close()
 println("XUI_CALLBACK_TEXT_ITEM_OK")
 return 0
end
