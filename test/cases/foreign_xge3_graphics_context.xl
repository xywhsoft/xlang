// Matched optional EGL SDK: actual owning renderer and deferred child lifetime.
import xge
func main(...) as int
 if xge.eglCapsGet().bCompiled==c_int(0) then
  int refused=0
  try
   auto unused=xge.createEglContext(4,4)
  catch Error error
   refused+=1
  end
  assert refused==1
  return 0
 end
 xge.init(4,4,"Owning EGL context",0,xge.XGE_RUN_MANUAL)
 auto context=xge.createEglContext(4,4,true)
 auto state=context.info()
 assert state.width==c_int(4) and state.height==c_int(4)
 assert state.current and state.graphicsReady and state.surfaceless
 auto shared=context.share()
 context.close()
 shared.makeCurrent()
 auto target=xge.createRenderTarget(2,2)
 auto pass=xge.createPass(target,c_uint(xge.XGE_PASS_CLEAR_COLOR),xge.colorRGBA(10,20,30,255))
 pass.begin()
 pass.finish()
 auto pixels=Buffer()
 assert pixels.resize(16)
 target.readPixels(pixels)
 assert pixels.hex()=="0a141eff0a141eff0a141eff0a141eff"
 pass.close()
 shared.close()
 // Closing the context view retains its physical context for this child.
 target.readPixels(pixels)
 assert pixels.hex()=="0a141eff0a141eff0a141eff0a141eff"
 int busy=0
 try
  xge.unit()
 catch Error error
  busy+=1
 end
 assert busy==1
 target.close()
 // A safe boundary drains the now unblocked native context retirement.
 xge.unit()
 assert xge.graphicsResourceCount()==uint64(0)
 return 0
end
