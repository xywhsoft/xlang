// Retain every public overload in a nonexecuted function. Traffic uses only
// the separate ordinary loopback cases. Error-queue receive is NOT exercised.
func surface(NetEngine engine, NetAddress local, NetAddress peer, UdpConfig config, CancellationToken cancel, Buffer buffer, bytes data, NetBytes refs, UdpPacket packet, NetDatagramControl control)
    auto a = UdpSocket(engine, local, config, uint64(18446744073709551615))
    auto b = udp.open(engine, local, peer, config)
    auto c = udp.connect(engine, peer, config)
    auto d = udp.bind(engine, local)
    auto e = UdpSocket.connect(engine, peer)
    a.send("text")
    a.send(data)
    a.send(buffer)
    a.sendTo(peer, "text")
    a.sendTo(peer, data)
    a.sendTo(peer, buffer)
    a.sendMessage(peer, control, "text")
    a.sendMessage(peer, control, data)
    a.sendMessage(peer, control, buffer)
    a.sendMessage(control, "text")
    a.sendMessage(control, data)
    a.sendMessage(control, buffer)
    a.sendRef(refs)
    a.sendRef(packet)
    a.sendRefTo(peer, refs)
    a.sendRefTo(peer, packet)
    a.sendRefMessage(peer, control, refs)
    a.sendRefMessage(peer, control, packet)
    a.sendRefMessage(control, refs)
    a.sendRefMessage(control, packet)
    a.sendMove(buffer)
    a.sendMoveTo(peer, buffer)
    a.sendMoveMessage(peer, control, buffer)
    a.sendMoveMessage(control, buffer)
    a.wait(UdpWait.open)
    a.waitCancel(cancel, UdpWait.open)
    a.waitUntil(uint64(0), UdpWait.open)
    a.waitUntilCancel(uint64(0), cancel, UdpWait.open)
    a.waitWritable(0)
    a.waitWritableCancel(cancel, 0)
    a.waitWritableUntil(uint64(0), 0)
    a.waitWritableUntilCancel(uint64(0), cancel, 0)
    a.recv()
    a.recvCancel(cancel)
    a.recvUntil(uint64(0))
    a.recvUntilCancel(uint64(0), cancel)
    a.recvError()
    a.recvErrorCancel(cancel)
    a.recvErrorUntil(uint64(0))
    a.recvErrorUntilCancel(uint64(0), cancel)
    a.recvBatch()
    a.recvBatchCancel(cancel)
    a.recvBatchUntil(uint64(0))
    a.recvBatchUntilCancel(uint64(0), cancel)
    a.tryRecv()
    a.tryRecvError()
    a.localAddress()
    a.peerAddress()
    auto flags = a.sendControlAvailable
    auto connected = a.connected
    auto state = a.state
    auto stats = a.snapshot()
    a.close()
    a.abort()
end
println("UDP surface declarations: ok")
