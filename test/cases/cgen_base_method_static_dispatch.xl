// base.method() 绕过虚派发，调用当前类的直接父类实现。

class RootSpeaker
    virtual func speak() as string
        return "root"
    end
end

class ParentSpeaker extends RootSpeaker
    override func speak() as string
        return "parent"
    end

    func parentLength() as int
        return string.len(base.speak())
    end
end

class ChildSpeaker extends ParentSpeaker
    override func speak() as string
        return "child"
    end

    func parentSpeak() as string
        return base.speak()
    end
end

ChildSpeaker child = ChildSpeaker()
assert child.speak() == "child", "normal call must use virtual dispatch"
assert child.parentSpeak() == "parent", "base call must use direct parent implementation"
assert child.parentLength() == 4, "base call return type must survive lowered XLIR"

println("base static dispatch ok")
