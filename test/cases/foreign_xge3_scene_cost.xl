// Count cold creation separately from language/runtime warm-up and printing.
import xge
extern "xrtMemDebugEnabled" @header("xrt_decl.h") @no_raise func debugEnabled() as bool
extern "fixtureSceneHeap" @header("test/cases/foreign_xge3_scene.h") @no_raise @c_outputs(0,1) func sceneHeap() as (c_size,c_size)
func measureCreation() as (c_size,c_size)
 auto count0,bytes0=sceneHeap()
 auto scene=xge.createScene()
 auto count1,bytes1=sceneHeap()
 scene.close()
 return count1-count0,bytes1-bytes0
end
func main(...) as int
 assert debugEnabled()
 measureCreation()
 auto count0,bytes0=sceneHeap()
 auto allocations,requested=measureCreation()
 auto count1,bytes1=sceneHeap()
 assert allocations>c_size(0) and requested>c_size(0)
 assert count1==count0 and bytes1==bytes0
 println("Scene cold live allocations: ",allocations)
 println("Scene cold requested heap bytes: ",requested)
 return 0
end
