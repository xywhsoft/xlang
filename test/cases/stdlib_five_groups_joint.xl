// One normal cross-group flow: fixed key/material, owned task result,
// native Channel readiness, verified self-owned loopback TLS, checked close.
// It is not a cryptographic or network-security test campaign.
async func joint(NetBackend backend)
    assert net.backendCompiled(backend)
    auto counter = AtomicInt64()
    channel<bytes> pipe = channel::<bytes>(1)
    auto receiving = ChannelCase.receive(pipe)
    auto pending = ChannelSelection.selectAsync([receiving])
    auto key = P256Key(b"\xc9\xaf\xa9\xd8\x45\xba\x75\x16\x6b\x5c\x21\x57\x67\xb1\xd6\x93\x4e\x50\xc3\xdb\x36\xe8\x9b\x12\x7b\x8a\x62\x2b\x12\x0f\x67\x21")
    auto pool = TaskPool(2, 8)
    pool.start()
    bytes payload = b"joint\0bytes"
    auto job = pool.submit(func() as bytes
        bytes digest = crypto.sha256(payload)
        bytes signature = key.signHash(digest)
        assert crypto.ecdsaP256VerifyHash(key.publicKey, digest, signature)
        assert pipe.send(digest)
        counter.fetchAdd(1)
        return digest
    end)
    auto selected = await pending
    assert selected.status == channelStatus.ok and selected.index == 0
    bytes message = selected.value(receiving, pipe)
    assert message == await job
    assert counter.load() == 1
    pipe.close()
    pool.close()
    assert pool.wait(10000)

    auto engine = NetEngine(NetEngineOptions().withWorkers(2).withBackend(backend))
    engine.start()
    assert engine.backend() == backend
    auto server = TlsServer(engine, TcpListenOptions(NetAddress.loopback(4, 0)), makeServer())
    auto accepted = server.acceptAsyncTimeout(10000)
    auto client = TlsStream(engine, server.local(), makeClient(), "localhost")
    assert await client.waitAsyncTimeout(0, 10000)
    auto peer = await accepted
    assert (await client.infoAsync()).ready and (await peer.infoAsync()).ready
    assert await client.sendAsync(message) == message.length
    bytes received = await peer.recvAsyncTimeout(message.length, 10000)
    assert received == message
    bytes response = crypto.sha256(received)
    assert await peer.sendAsync(response) == response.length
    assert await client.recvAsyncTimeout(response.length, 10000) == crypto.sha256(message)
    client.close()
    peer.close()
    server.close()
    engine.close()
    assert engine.wait(10000)
end

println("five-groups-joint: select")
await joint(NetBackend.select)
if net.backendCompiled(NetBackend.iocp) then
    println("five-groups-joint: iocp")
    await joint(NetBackend.iocp)
else
    println("five-groups-joint: epoll")
    await joint(NetBackend.epoll)
end
println("five-groups-joint=ok")
