import bz2

func main(...) as int
    assert bz2.decompressText(bz2.compress("你好，bz2")) == "你好，bz2"
    assert bz2.decompressText(bz2.compress(""), smallMemory = true) == ""
    Buffer source = Buffer()
    source.append("abc")
    source.appendByte(0)
    source.appendByte(255)
    Buffer packed = bz2.compress(source, level = bz2.BZ2_MIN_LEVEL)
    assert packed[0] == 66 and packed[1] == 90 and packed[2] == 104 and packed[3] == 49
    assert bz2.decompress(packed, smallMemory = true) == source

    // drain 移交独立 Buffer；finish 封存流，但不替调用者取走最后一段。
    bz2.Bz2Compressor encoder = bz2.compressor(workFactor = bz2.BZ2_MIN_WORK_FACTOR)
    assert encoder.valid and not encoder.finished
    encoder.update("左")
    Buffer incremental = encoder.drain()
    encoder.update("右")
    encoder.update(source)
    assert encoder.finish() and encoder.finish() and encoder.finished
    incremental.append(encoder.drain())
    assert encoder.drain().len() == 0
    assert encoder.inputBytes == 6 + source.len()
    assert encoder.outputBytes == incremental.len()
    bz2.Bz2Decompressor decoder = bz2.decompressor(smallMemory = true)
    assert decoder.valid and not decoder.finished
    decoder.update(incremental)
    Buffer plain = decoder.drain()
    assert decoder.finished and decoder.members == 1
    assert decoder.finish() and decoder.finish()
    assert decoder.drain().len() == 0
    Buffer expected = Buffer()
    expected.append("左右")
    expected.append(source)
    assert plain == expected
    assert decoder.inputBytes == incremental.len() and decoder.outputBytes == expected.len()

    bool rejected = false
    try
        encoder.update("late")
    catch RuntimeError e
        rejected = true
    end
    assert rejected
    rejected = false
    try
        decoder.update(packed)
    catch RuntimeError e
        rejected = true
    end
    assert rejected

    Buffer joined = bz2.compress("one")
    joined.append(bz2.compress(""))
    joined.append(bz2.compress("two"))
    bz2.Bz2Decompressor members = bz2.decompressor()
    members.update(joined)
    assert members.members == 3 and members.finished
    assert members.finish() and members.drain().text() == "onetwo"
    assert bz2.decompressText(joined) == "onetwo"
    bz2.Bz2Compressor tuned = bz2.compressor(bz2.BZ2_MAX_LEVEL, bz2.BZ2_MAX_WORK_FACTOR)
    tuned.update("tune")
    tuned.finish()
    assert bz2.decompressText(tuned.drain()) == "tune"

    // 格式/截断沿 XRT 映射成 IOError；限额和参数错误保持各自类型。
    incremental[10] = incremental[10] ^ 1
    rejected = false
    try
        bz2.decompress(incremental)
    catch IOError e
        rejected = true
    end
    assert rejected
    rejected = false
    try
        bz2.decompress(Buffer())
    catch IOError e
        rejected = true
    end
    assert rejected
    rejected = false
    try
        bz2.decompress(packed, maxOutput = 1)
    catch RangeError e
        rejected = true
    end
    assert rejected
    rejected = false
    try
        bz2.compress("你", maxInput = 2)
    catch RangeError e
        rejected = true
    end
    assert rejected
    rejected = false
    try
        bz2.decompress(packed, maxRatio = 4294967296)
    catch ValueError e
        rejected = true
    end
    assert rejected
    rejected = false
    try
        bz2.compressor(level = 10)
    catch ValueError e
        rejected = true
    end
    assert rejected
    rejected = false
    try
        bz2.compressor(workFactor = 251)
    catch ValueError e
        rejected = true
    end
    assert rejected
    rejected = false
    try
        bz2.decompressor(maxInput = 0)
    catch ValueError e
        rejected = true
    end
    assert rejected
    return 0
end
