import xui
from xui import CallbackConstErrorInfo,CallbackWidget
extern "fixtureXuiErrorMutable" @header("test/cases/foreign_xui_error_report.h") @no_raise @c_result("status",0) func mutableEvent(xui.Context ui,c_int mode)
extern "fixtureXuiErrorAmbient" @no_raise @c_result("status",0) func ambientEvent(xui.Context ui)
extern "fixtureXuiErrorBudget" @no_raise func budget(c_int n)
extern "fixtureXuiErrorHeapBegin" @no_raise func beginHeap()
extern "fixtureXuiErrorHeapReport" @no_raise func reportHeap(c_int native)
extern "fixtureXuiErrorNativeHot" @no_raise func nativeHot(xui.Context ui)
func main(...) as int
 auto proxy=xui.createProxy()
 auto ui=xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
 CallbackConstErrorInfo? saved=null
 CallbackWidget? savedWidget=null
 string? operation=null
 string? message=null
 int calls=0
 int stage=0
 int recoverable=0
 int x=0
 int y=0
 ui.setErrorCallback(func(xui.CallbackContext current,xui.CallbackConstErrorInfo info)
  assert info.code==xui.XUI_ERROR_INVALID_ARGUMENT
  assert current.getLanguage()==ui.getLanguage()
  operation=info.operation
  message=info.message
  stage=int(info.stage)
  recoverable=int(info.recoverable)
  auto rectangle=info.rectangle
  x=int(rectangle.fX)
  y=int(rectangle.fY)
  saved=info
  savedWidget=info.widget
  if savedWidget!=null then
   auto bounds=(savedWidget as CallbackWidget).rect()
   assert bounds.fX==12 and bounds.fY==34 and bounds.fW==56 and bounds.fH==78
  end
  calls+=1
 end)
 mutableEvent(ui,0)
 assert calls==1 and (operation as string)=="stack operation" and (message as string)=="mutable UTF-8 你"
 assert savedWidget==null and x==0 and y==0
 bool rejected=false
 try
  auto expired=saved as CallbackConstErrorInfo
  message=expired.message
 catch StateError
  rejected=true
 end
 assert rejected and (message as string)=="mutable UTF-8 你"
 mutableEvent(ui,1)
 assert operation==null and message==null
 mutableEvent(ui,2)
 assert operation!=null and message!=null and (operation as string)=="" and (message as string)==""
 mutableEvent(ui,3)
 assert (operation as string)=="prefix" and (message as string)=="prefix"
 ui.reportError(xui.XUI_ERROR_INVALID_ARGUMENT,xui.XUI_ERROR_STAGE_USER,operation="public",message="copied")
 assert calls==5 and (operation as string)=="public" and (message as string)=="copied"
 ui.reportError(xui.XUI_ERROR_INVALID_ARGUMENT,xui.XUI_ERROR_STAGE_USER,operation="",message="")
 assert operation!=null and message!=null and (operation as string)=="" and (message as string)==""
 auto widget=ui.widget()
 auto rectangle=xui.Rect()
 rectangle.fX=12
 rectangle.fY=34
 rectangle.fW=56
 rectangle.fH=78
 assert widget.setRect(rectangle)==0
 rectangle.fX=2
 rectangle.fY=3
 ui.reportError(xui.XUI_ERROR_INVALID_ARGUMENT,1234,7,widget,rectangle,"full","payload")
 assert calls==7 and stage==1234 and recoverable==7 and x==2 and y==3 and savedWidget!=null
 rejected=false
 try
  auto invalid=(savedWidget as CallbackWidget).rect()
 catch StateError
  rejected=true
 end
 assert rejected and widget.getRect().fX==12
 ui.reportError(xui.XUI_ERROR_INVALID_ARGUMENT,xui.XUI_ERROR_STAGE_USER)
 assert calls==8 and operation==null and message==null and savedWidget==null and x==0 and y==0
 rejected=false
 try
  ui.reportError(0,xui.XUI_ERROR_STAGE_USER)
 catch Error
  rejected=true
 end
 assert rejected and calls==8
 rejected=false
 try
  ui.reportError(xui.XUI_ERROR_INVALID_ARGUMENT,xui.XUI_ERROR_STAGE_USER,operation="bad\0tail")
 catch Error
  rejected=true
 end
 assert rejected and calls==8
 // Preserve the producer's business diagnostic while observing copied text.
 rejected=false
 try
  ambientEvent(ui)
 catch Error failure
  rejected=failure.message=="ambient business error"
 end
 assert rejected
 assert calls==9 and (operation as string)=="ambient" and (message as string)=="observed"
 for field in range(2)
  message="kept"
  ui.setErrorCallback(func(xui.CallbackContext current,xui.CallbackConstErrorInfo info)
   budget(0)
   try
    if field==0 then message=info.operation end
    if field==1 then message=info.message end
   finally
    budget(-1)
   end
  end)
  rejected=false
  try
   mutableEvent(ui,0)
  catch Error
   rejected=true
  end
  assert rejected and (message as string)=="kept"
 end
 ui.setErrorCallback(func(xui.CallbackContext current,xui.CallbackConstErrorInfo info)
  budget(0)
  try
   message=info.message
  finally
   budget(-1)
  end
 end)
 mutableEvent(ui,1)
 assert message==null
 ui.setErrorCallback(func(xui.CallbackContext current,xui.CallbackConstErrorInfo info)
  ui.setErrorCallback(null)
  message=info.message
 end)
 mutableEvent(ui,0)
 assert (message as string)=="mutable UTF-8 你"
 int recursiveCalls=0
 ui.setErrorCallback(func(xui.CallbackContext current,xui.CallbackConstErrorInfo info)
  recursiveCalls+=1
  ui.reportError(xui.XUI_ERROR_INVALID_ARGUMENT,xui.XUI_ERROR_STAGE_USER)
 end)
 ui.reportError(xui.XUI_ERROR_INVALID_ARGUMENT,xui.XUI_ERROR_STAGE_USER)
 assert recursiveCalls==1
 ui.setErrorCallback(func(xui.CallbackContext current,xui.CallbackConstErrorInfo info)
  throw "XUI error observer failure"
 end)
 rejected=false
 try
  ui.reportError(xui.XUI_ERROR_INVALID_ARGUMENT,xui.XUI_ERROR_STAGE_USER)
 catch Error failure
  rejected=failure.message=="XUI error observer failure"
 end
 assert rejected
 ui.setErrorCallback(func(xui.CallbackContext current,xui.CallbackConstErrorInfo info)
  auto a=info.operation
  auto b=info.message
  assert a!=null and b!=null
 end)
 string a="bench"
 string b="text"
 ui.reportError(xui.XUI_ERROR_INVALID_ARGUMENT,xui.XUI_ERROR_STAGE_USER,1,a,b)
 beginHeap()
 for i in range(1000)
  ui.reportError(xui.XUI_ERROR_INVALID_ARGUMENT,xui.XUI_ERROR_STAGE_USER,1,a,b)
 end
 reportHeap(0)
 ui.setErrorCallback(null)
 nativeHot(ui)
 auto worker=thread(func() as int
  try
   ui.reportError(xui.XUI_ERROR_INVALID_ARGUMENT,xui.XUI_ERROR_STAGE_USER)
  catch StateError
   return 1
  end
  return 0
 end)
 assert worker.waitTimeout(30000) and worker.exitCode()==1
 ui.close()
 proxy.close()
 println("XuiError: packed payload, snapshots, NULL/empty/NUL, widget/view expiry, ambient error, OOM, recursion, observer failure and copies passed")
 return 0
end
