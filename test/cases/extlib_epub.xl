import epub



func checkEpub(string path)
    var meta = {"title": "xlang 扩展库手册", "author": "xLeaves",
        "language": "zh", "identifier": "urn:xlang:test:extlib-epub",
        "modified": "2026-08-01T00:00:00Z"}
    var chapters = [
        {"title": "第一章 概述", "text": "# 概述\n\nxlang 是一门静态类型的系统语言。\n支持 C 混编与 <QR> 码生成。\n\n## 特性列表\n\n语义清晰，产物轻量。"},
        {"title": "第二章 安装", "text": "# 安装\n\n从官网下载发布包。\n\n解压后即可运行 xl.exe。"}
    ]
    int size = epub.build(path, meta, chapters)
    assert size > 1000, "epub is non-trivial"

    // 首条目是未压缩 mimetype
    string mime = epub.readEntry(path, "mimetype")
    assert mime == "application/epub+zip", "mimetype first entry"

    // container.xml 指向 opf
    string container = epub.readEntry(path, "META-INF/container.xml")
    assert container.contains("OEBPS/content.opf"), "container points to opf"

    // opf 元数据（含转义与中文）
    string opf = epub.readEntry(path, "OEBPS/content.opf")
    assert opf.contains("xlang 扩展库手册"), "opf title"
    assert opf.contains("xLeaves"), "opf author"
    assert opf.contains("<dc:language>zh</dc:language>"), "opf language"
    assert opf.contains("idref=\"ch2\""), "opf spine has both chapters"

    // 目录文档
    string nav = epub.readEntry(path, "OEBPS/nav.xhtml")
    assert nav.contains("第一章 概述"), "nav chapter 1"
    assert nav.contains("ch2.xhtml"), "nav links chapter 2"

    // 章节内容：标题降级与转义
    string ch1 = epub.readEntry(path, "OEBPS/ch1.xhtml")
    assert ch1.contains("<h1>概述</h1>"), "h1 from hash"
    assert ch1.contains("<h2>特性列表</h2>"), "h2 from double hash"
    assert ch1.contains("&lt;QR&gt;"), "angle brackets escaped"
    assert ch1.contains("<p>xlang 是一门静态类型的系统语言。 支持 C 混编"), "paragraph join"

    // 缺失条目返回空串
    assert epub.readEntry(path, "no/such.entry") == "", "missing entry empty"
end

func main(...) as int
    string workDir = path.join(path.temp(), "xlang_epub_case_" + crypto.randomString(20))
    dir.createAll(workDir)
    try
        checkEpub(path.join(workDir, "book.epub"))
    finally
        assert dir.delete(workDir), "temporary EPUB test directory must be removed"
    end
    return 0
end
