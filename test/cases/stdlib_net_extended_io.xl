// Normal transfers only: explicit engine, bytes and owned Buffer/NetBuffer.
func readExact(TcpStream stream, int size) as bytes
    bytes result = b""
    while result.length < size
        auto chunk = stream.recv(size - result.length, 5000)
        assert chunk.length > 0
        result = result + chunk
    end
    return result
end
auto engine = NetEngine(NetEngineOptions().withWorkers(1).withBackend(NetBackend.select))
engine.start()
auto streamOptions = TcpStreamOptions().withWriteWatermarks(65536, 32768, 1048576).withReadBuffer(4096, 1048576)
auto listener = TcpListener(engine, TcpListenOptions(NetAddress.loopback()).withBacklog(32).withStreamOptions(streamOptions))
auto accepted = listener.acceptAsync()
auto client = TcpStream(engine, listener.localAddress(), streamOptions)
auto peer = await accepted
assert client.wait(TcpWait.open, 5000) == NetStatus.ok
auto available = peer.waitAvailableAsync(4)
assert client.send("wait") == NetStatus.ok and await available
assert readExact(peer, 4) == b"wait"
assert client.send("sync") == NetStatus.ok
assert peer.wait(TcpWait.readable, 5000) == NetStatus.ok and readExact(peer, 4) == b"sync"
assert client.wait(TcpWait.writable, 5000) == NetStatus.ok
peer.pauseRead()
auto first = Buffer(b"vector-")
auto second = Buffer(b"send")
array<Buffer> parts = [first, second]
assert client.sendVector(parts) == NetStatus.ok
peer.resumeRead()
assert readExact(peer, 11) == b"vector-send"
auto moved = NetBuffer()
moved.append("move")
assert client.sendMove(moved) == NetStatus.ok and moved.length == 0
assert client.wait(TcpWait.drain, 5000) == NetStatus.ok
assert readExact(peer, 4) == b"move"

assert client.send("peek-consume") == NetStatus.ok
auto input = NetBuffer()
while input.length < 12
    assert await peer.recvIntoAsync(input, 12 - input.length) > 0
end
assert input.peek(0, 4) == b"peek" and input.peek() == b"peek-consume"
assert input.consume(4) == 4 and input.read() == b"-consume"
assert client.wait(TcpWait.close, 1) == NetStatus.timeout
client.close()
peer.close()
listener.close()

auto config = UdpConfig().withReceive(8192, 2, 4).withReceiveQueue(64, 65536, UdpOverflow.error)
auto left = udp.bind(engine, NetAddress.loopback(), config)
auto right = udp.bind(engine, NetAddress.loopback(), config)
assert left.wait(UdpWait.open, 5000) == NetStatus.ok and right.wait(UdpWait.open, 5000) == NetStatus.ok
assert left.sendTo(right.localAddress(), "configured") == NetStatus.ok
assert right.recv(5000).bytes() == b"configured"
left.close()
right.close()

auto immediate = engine.submit(func() as int
    return 1
end)
auto delayed = engine.submitAfter(10, func() as int
    return 2
end)
assert await immediate == 1 and await delayed == 2
engine.close()
assert engine.wait(5000)
println("stdlib net extended io ok")
