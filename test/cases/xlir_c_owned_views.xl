extern "c_owned_text" @no_raise func nativeText() as point
extern "c_owned_release" @no_raise func nativeFree(point data)
extern "c_owned_text_is_original" @no_raise func original(string text) as bool
extern "c_owned_released" @no_raise func released() as int
extern "c_owned_debug" @no_raise func debug() as bool
extern "c_owned_allocations" @no_raise func allocations() as int

func inspect(string text, string needle) as bool
    return original(text) and text.contains(needle)
end

func checkViews()
    bool checked = debug()
    cstring text = cstring.take(nativeText(), nativeFree)
    string needle = "ell"
    int before = allocations()
    assert original(text)
    assert text.contains(needle)
    assert inspect(text, needle)
    if checked then assert allocations() == before end
    assert released() == 0
    assert original(cstring.take(nativeText(), nativeFree))
    assert released() == 1
end

checkViews()
assert released() == 2

extern "c_owned_binary" @no_raise func nativeBytes() as point
extern "c_owned_text_span_original" @no_raise func originalSpan(cstring text) as bool
extern "c_owned_binary_span_original" @no_raise func originalBytes(cbytes data) as bool
extern "c_owned_binary_span_valid" @no_raise func validBytes(cbytes data) as bool
extern "c_owned_debug_enabled" @no_raise func debugEnabled() as bool
func nativeViews()
    cstring text = cstring.take(nativeText(), nativeFree)
    cbytes data = cbytes.take(nativeBytes(), 4, nativeFree)
    bytes ordinary = b"\x00\xff\x11*"
    int before = allocations()
    assert originalSpan(text)
    assert originalBytes(data)
    assert validBytes(ordinary)
    if debugEnabled() then assert allocations() == before end
    assert validBytes(b"\x00\xff\x11*")
end
nativeViews()
assert released() == 4
