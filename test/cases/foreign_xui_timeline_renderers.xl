import xui
from xui import CallbackTimelineLayer,CallbackTimelineFrame,CallbackTimelineSpan,CallbackDrawContext

extern "fixtureRenderProxy" @header("test/cases/foreign_xui_render_backend.h") @no_raise @c_result("owned_view") @factory(0,0,dropProxy) func cpuProxy() as xui.Proxy
extern "xuiProxyReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropProxy(xui.Proxy value)
extern "fixtureRenderBalanced" @no_raise func balanced() as c_int
extern "fixtureRenderBudget" @no_raise func budget(c_int allowance)
extern "fixtureTimelineHeapBegin" @no_raise func heapBegin()
extern "fixtureTimelineHeapUnchanged" @no_raise func heapUnchanged() as c_int
extern "fixtureTimelineReadFrame" @header("test/cases/foreign_xui_timeline_renderers.h") @no_raise func nativeReadFrame(xui.CallbackTimelineFrame frame,c_int layer)

func rectangle(c_int x,c_int y,c_int width,c_int height) as xui.Rect
    xui.Rect value
    value.fX=x
    value.fY=y
    value.fW=width
    value.fH=height
    return value
end

func main(...) as int
    auto proxy=cpuProxy()
    auto font=proxy.loadFontMemory(b"cpu",16)
    auto target=proxy.createSurfaceRGBA(640,480,flags=c_uint(xui.XUI_SURFACE_USAGE_TARGET))
    auto context=xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
    context.setDefaultFont(font)
    auto root=context.widget()
    context.setViewportSize(640,480)
    assert root.setRect(rectangle(0,0,640,480))==0 and context.setRootWidget(root)==0
    auto view=context.timeLineViewNative()
    assert view.setRect(rectangle(0,0,610,220))==0 and root.addChild(view)==0
    assert view.setFrameCount(48)==0
    auto layer=view.addLayer("Animation")
    view.setFrame(layer,4,xui.XUI_TIMELINE_FRAME_KEY)
    auto spanId=view.addSpan(layer,8,14,xui.XUI_TIMELINE_SPAN_CUSTOM,"Move")
    view.setSpanCustomType(spanId,"camera")
    assert context.layout()==0

    auto before=view.scrollSnapshot()
    assert before.fContentWidth>before.tViewportRect.fW and before.fScrollX==0
    view.setOffset(12,0)
    assert view.scrollSnapshot().fScrollX==12 and before.fScrollX==0
    view.setOffset(0,0)

    int layers=0
    int rulers=0
    int frames=0
    int spans=0
    xui.CallbackTimelineLayer? savedLayer=null
    xui.CallbackTimelineFrame? savedFrame=null
    xui.CallbackTimelineSpan? savedSpan=null
    xui.CallbackDrawContext? savedDraw=null
    string savedName=""
    view.setRenderers(
        layer=func(xui.CallbackWidget sender,c_int index,xui.CallbackTimelineLayer info,xui.CallbackDrawContext draw,xui.Rect bounds,c_int state) as c_int
            layers+=1
            savedLayer=info
            savedName=info.name()
            assert index==layer and savedName=="Animation" and bounds.fH>0
            return 0
        end,
        ruler=func(xui.CallbackWidget sender,c_int frame,xui.CallbackDrawContext draw,xui.Rect bounds,c_int state) as c_int
            rulers+=1
            assert frame>=0 and bounds.fW>0
            return 0
        end,
        frame=func(xui.CallbackWidget sender,c_int index,c_int frame,xui.CallbackTimelineFrame? info,xui.CallbackDrawContext draw,xui.Rect bounds,c_int state) as c_int
            frames+=1
            savedFrame=info
            assert info!=null
            auto key=info as CallbackTimelineFrame
            heapBegin()
            for i in range(1000)
                assert key.layer==index and key.frame==4 and key.kind==xui.XUI_TIMELINE_FRAME_KEY
            end
            assert heapUnchanged()==1
            heapBegin()
            nativeReadFrame(key,index)
            assert heapUnchanged()==1
            return 0
        end,
        span=func(xui.CallbackWidget sender,c_int index,c_int id,xui.CallbackTimelineSpan info,xui.CallbackDrawContext draw,xui.Rect bounds,c_int state) as c_int
            spans+=1
            savedSpan=info
            savedDraw=draw
            assert index==layer and id==spanId and info.id==id and info.startFrame==8 and info.endFrame==14
            assert info.label()=="Move" and info.customType()=="camera"
            proxy.fillRect(draw,bounds,0x3B82F6FF)
            return 1
        end)
    context.render(target)
    assert layers==1 and rulers>0 and frames==1 and spans==1
    int expired=0
    try
        auto value=(savedLayer as CallbackTimelineLayer).id
    catch StateError
        expired+=1
    end
    try
        auto value=(savedFrame as CallbackTimelineFrame).kind
    catch StateError
        expired+=1
    end
    try
        auto value=(savedSpan as CallbackTimelineSpan).label()
    catch StateError
        expired+=1
    end
    try
        proxy.fillRect(savedDraw as CallbackDrawContext,rectangle(0,0,1,1),0xFFFFFFFF)
    catch StateError
        expired+=1
    end
    assert expired==4 and savedName=="Animation"

    int replacements=0
    view.setRenderers(layer=func(xui.CallbackWidget sender,c_int index,xui.CallbackTimelineLayer info,xui.CallbackDrawContext draw,xui.Rect bounds,c_int state) as c_int
        replacements+=1
        view.setRenderers()
        view.setLayerName(index,"Updated")
        assert info.name()=="Animation"
        return 1
    end)
    context.render(target)
    assert replacements==1 and (view.getLayerName(layer) ?? "")=="Updated"
    context.render(target)
    assert replacements==1

    view.setRenderers(span=func(xui.CallbackWidget sender,c_int index,c_int id,xui.CallbackTimelineSpan info,xui.CallbackDrawContext draw,xui.Rect bounds,c_int state) as c_int
        throw "timeline paint failed"
    end)
    bool reported=false
    try
        context.render(target)
    catch Error failure
        reported=failure.message=="timeline paint failed"
    end
    assert reported
    view.setRenderers()
    context.render(target)

    int stableCalls=0
    xui.TimelineLayerRenderProc stable=func(xui.CallbackWidget sender,c_int index,xui.CallbackTimelineLayer info,xui.CallbackDrawContext draw,xui.Rect bounds,c_int state) as c_int
        stableCalls+=1
        return 0
    end
    xui.TimelineSpanRenderProc extra=func(xui.CallbackWidget sender,c_int index,c_int id,xui.CallbackTimelineSpan info,xui.CallbackDrawContext draw,xui.Rect bounds,c_int state) as c_int
        return 0
    end
    view.setRenderers(layer=stable)
    int failures=0
    for allowance in range(20)
        bool rejected=false
        budget(c_int(allowance))
        try
            view.setRenderers(span=extra)
        catch Error
            rejected=true
        finally
            budget(-1)
        end
        if rejected then
            failures+=1
            assert view.setCurrentFrame(c_int(allowance+1))==0
            int previous=stableCalls
            context.render(target)
            assert stableCalls==previous+1,"failed registration changed the old renderer"
        else
            view.setRenderers(layer=stable)
        end
    end
    assert failures>0 and failures<20
    view.setRenderers()
    view.close()
    assert before.fContentWidth>0
    context.close()
    target.close()
    font.close()
    proxy.close()
    assert balanced()==1
    println("TIMELINE_RENDERERS_OK four renderers, expiry, replacement, checked failure and OOM")
    println("TIMELINE_FRAME_FIELDS_OK paired C/xlang reads with zero heap operations")
    return 0
end
