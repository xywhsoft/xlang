func outer() as int
    channel<int> ch = channel::<int>(1)
    int result = 0

    auto recv = func() as int
        auto status, value = ch.recv()
        if status == channelStatus.ok and value != null then
            result = value
        end
        return result
    end

    assert ch.send(41)
    assert recv() == 41
    ch.close()
    return result
end
assert outer() == 41
