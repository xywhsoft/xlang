func multi_catch_finally_break() as int
    int value = 0
    while value < 1
        try
            throw RangeError "break through multi handler finally"
        catch TypeError ignored
            value = 100
            break
        catch ValueError e
            assert e.kind == "RangeError"
            value = 1
            break
        finally
            value = value + 10
        end
    end
    return value
end

assert multi_catch_finally_break() == 11
