extern "CheckedNativeFields" struct NativeFields @header("test/cases/xlir_c_integer_arithmetic.h")
 c_int value
 c_int samples[2]
end
int getters=0
int setters=0
int keys=0
int rhsCalls=0
class CheckedProperty
 c_int stored=c_int(127)
 get value() as c_int
  getters+=1
  return self.stored
 end
 let value(c_int value)
  setters+=1
  self.stored=value
 end
end
func keyOnce() as int
 keys+=1
 return 0
end
func rhsOnce() as c_int
 rhsCalls+=1
 return c_int(1)
end
func failRhs() as c_int
 throw "RHS failure"
end
c_int oomTarget=c_int(7)
export "checked_native_oom_read" func readOomTarget() as c_int
 return oomTarget
end
export "checked_native_oom_add" func addOomTarget(c_int delta)
 oomTarget+=delta
end
export "checked_native_add" func exportedAdd(c_int a,c_int b) as c_int
 return a+b
end
func main(...) as int
 check_char()
 check_schar()
 check_uchar()
 check_short()
 check_ushort()
 check_int()
 check_uint()
 check_long()
 check_ulong()
 check_longlong()
 check_ulonglong()
 check_size()
 check_ssize()
 check_ptrdiff()
 check_intptr()
 check_uintptr()
 check_wchar()
 auto object=CheckedProperty()
 object.stored=nativeMax_int()
 bool caught=false
 try
  object.value+=rhsOnce()
 catch OverflowError error
  caught=true
 end
 assert caught and getters==1 and setters==0 and rhsCalls==1 and object.stored==nativeMax_int()
 auto fields=NativeFields()
 fields.value=nativeMax_int()
 fields.samples[0]=nativeMax_int()
 caught=false
 try
  fields.samples[keyOnce()]+=rhsOnce()
 catch OverflowError error
  caught=true
 end
 assert caught and keys==1 and rhsCalls==2 and fields.samples[0]==nativeMax_int()
 caught=false
 try
  fields.value+=c_int(1)
 catch OverflowError error
  caught=true
 end
 assert caught and fields.value==nativeMax_int()
 c_uchar small=c_uchar(1)
 caught=false
 try
  small+=300
 catch RangeError error
  caught=true
 end
 assert caught and small==c_uchar(1)
 caught=false
 try
  small=small<<uint64(4294967296)
 catch RangeError error
  caught=true
 end
 assert caught and small==c_uchar(1)
 caught=false
 try
  object.value+=failRhs()
 catch error
  caught=true
 end
 assert caught and getters==2 and setters==0 and object.stored==nativeMax_int()
 var dynamicTooWide=uint64(18446744073709551615)
 caught=false
 try
  auto rejected=c_int(dynamicTooWide)
 catch RangeError error
  caught=true
 end
 assert caught
 println("Checked C integer arithmetic: 17 domains, operators, widths and atomic destinations passed")
 return 0
end
