// All native integer domains use their actual target C width and signedness.
// Bounds originate in an independent native provider, not language conversion.
extern "fixtureCIntegerMax_char" @header("test/cases/xlir_c_integer_arithmetic.h") @no_raise func nativeMax_char() as c_char
extern "fixtureCIntegerMin_char" @header("test/cases/xlir_c_integer_arithmetic.h") @no_raise func nativeMin_char() as c_char
extern "fixtureCIntegerWidth_char" @header("test/cases/xlir_c_integer_arithmetic.h") @no_raise func nativeWidth_char() as int
extern "fixtureCIntegerSigned_char" @header("test/cases/xlir_c_integer_arithmetic.h") @no_raise func nativeSigned_char() as bool
func check_char()
 c_char one=c_char(1)
 c_char two=c_char(2)
 c_char zero=c_char(0)
 c_char high=nativeMax_char()
 c_char low=nativeMin_char()
 assert one+two==c_char(3) and two-one==one and two*two==c_char(4)
 assert two/one==two and two%two==zero and (two<<one)==c_char(4) and (two>>one)==one
 c_char current=c_char(8)
 current+=c_char(2)
 current-=c_char(3)
 current*=c_char(4)
 current/=c_char(2)
 current%=c_char(5)
 current=current<<one
 current=current>>one
 assert current==c_char(4)
 int caught=0
 try
  auto rejected=high+one
 catch OverflowError error
  caught+=1
 end
 try
  auto rejected=low-one
 catch OverflowError error
  caught+=1
 end
 try
  auto rejected=high*two
 catch OverflowError error
  caught+=1
 end
 try
  auto rejected=one/zero
 catch ZeroDivisionError error
  caught+=1
 end
 try
  auto rejected=one%zero
 catch ZeroDivisionError error
  caught+=1
 end
 try
  auto rejected=one<<nativeWidth_char()
 catch RangeError error
  caught+=1
 end
 try
  auto rejected=one>>uint64(4294967296)
 catch RangeError error
  caught+=1
 end
 try
  auto rejected=one<<int(-1)
 catch RangeError error
  caught+=1
 end
 try
  current=high
  current+=one
 catch OverflowError error
  caught+=1
 end
 try
  current=high
  current*=two
 catch OverflowError error
  caught+=1
 end
 assert caught==10 and current==high
 if nativeSigned_char()
  try
   auto rejected=-low
  catch OverflowError error
   caught+=1
  end
  try
   auto rejected=low/c_char(-1)
  catch OverflowError error
   caught+=1
  end
  assert caught==12
 else
  try
   auto rejected=-one
  catch OverflowError error
   caught+=1
  end
  assert caught==11
 end
 assert -zero==zero
end

