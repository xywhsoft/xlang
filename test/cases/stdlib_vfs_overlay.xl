auto fs = vfs.create()
auto base = vfs.memory()
auto overlay = vfs.memory()
base.put("settings", b"base")
base.put("fallback", b"fallback")
overlay.put("settings", b"overlay")
base.seal()
overlay.seal()
auto lower = fs.mount("/app", base, 0)
auto higher = fs.mount("/app", overlay, 10)
assert not (fs.readBytes("/app/settings") != b"overlay")
assert not (fs.readBytes("/app/fallback") != b"fallback")
higher.unmount()
assert not (fs.readBytes("/app/settings") != b"base")
println("vfs overlay ok")
