class StackItem
    int value
end

func main(...) as int
    Stack<string> text = Stack::<string>()
    assert(text.reserve(8))
    string original = "a\0你"
    assert(text.push(original))
    original = "changed"
    string result = text.peek()
    assert(result == "a\0你")
    Stack<string> copy = text.clone()
    assert(copy.equals(text))
    result = text.pop()
    assert(result == "a\0你")
    assert(text.count() == 0 and copy.count() == 1)
    auto hasText, absent = text.tryPop()
    assert(not hasText and absent == null and result == "a\0你")
    int refused = 0
    try
        text.peekAt(-1)
    catch RangeError failure
        refused += 1
    end
    assert(refused == 1)
    auto hasDepth, missing = text.tryPeekAt(10)
    assert(not hasDepth and missing == null)
    result = copy.pop()
    assert(result == "a\0你")
    assert(copy.trim())
    assert(copy.capacity() == 0)
    Stack<StackItem> items = Stack::<StackItem>()
    StackItem item = StackItem()
    item.value = 7
    assert(items.push(item))
    Stack<StackItem> references = items.clone()
    StackItem observed = items.peek()
    observed.value = 31
    assert(item.value == 31)
    observed = references.pop()
    assert(observed.value == 31)
    items.clear()
    assert(items.count() == 0)
    Stack<float> positive = Stack::<float>()
    Stack<float> negative = Stack::<float>()
    assert(positive.push(0.0))
    assert(negative.push(-0.0))
    assert(positive.equals(negative))
    return 0
end
