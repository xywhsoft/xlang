assert ascii.isAlpha('A')
assert ascii.isAlpha('z')
assert not ascii.isAlpha('你')
assert ascii.isDigit('9')
assert not ascii.isDigit('A')
assert ascii.isAlphaNumeric('0')
assert ascii.isAlphaNumeric('q')
assert ascii.isHexDigit('F')
assert ascii.isHexDigit('a')
assert not ascii.isHexDigit('G')
assert ascii.isWhitespace(' ')
assert ascii.isWhitespace('\n')
assert not ascii.isWhitespace('A')
assert ascii.isBlank('\t')
assert not ascii.isBlank('\n')
assert ascii.isControl(0)
assert ascii.isControl(127)
assert not ascii.isControl(' ')
assert ascii.isPrintable(' ')
assert ascii.isPrintable('~')
assert not ascii.isPrintable('你')
assert ascii.isGraphical('!')
assert not ascii.isGraphical(' ')
assert ascii.isPunctuation('!')
assert ascii.isPunctuation('_')
assert not ascii.isPunctuation('A')
assert ascii.isLower('a')
assert ascii.isUpper('Z')
assert ascii.toLower('A') == 'a'
assert ascii.toLower('你') == '你'
assert ascii.toUpper('z') == 'Z'
assert ascii.toUpper('你') == '你'
