protocol Reader
 func read(c_int mode,c_int failAfter) as (string,bytes,c_int)
end
func main(...) as int
 auto text,number,data,size=pair()
 assert text=="A\0你" and number==c_int(17) and data==b"\xff\0\x81B" and size==c_size(4)
 assert voidText()=="A\0你"
 assert singleBytes()==b"\xff\0\x81B"
 auto spanText,spanBytes=fromSpan(b"A\0\xe4\xbd\xa0")
 assert spanText=="A\0你" and spanBytes==b"A\0\xe4\xbd\xa0"
 auto missingText,missingBytes=optional(c_int(0))
 assert missingText==null and missingBytes==null
 auto emptyText,emptyBytes=optional(c_int(1))
 assert emptyText!=null and emptyBytes!=null and emptyText=="" and emptyBytes==b""
 for mode in [0,2,3,4,5]
  beginCounter()
  bool caught=false
  try
   auto badText,badBytes=required(c_int(mode))
  catch error
   caught=true
  end
  assert caught
  endCounter()
 end
 Root root=create()
 auto before=ends()
 auto ownedText,ownedBytes,count=root.read()
 assert ends()==before+c_int(1) and ownedText=="A\0你" and ownedBytes==b"\xff\0\x81B" and count==c_int(23)
 func(c_int,c_int) as (string,bytes,c_int) bound=root.read
 auto boundText,boundBytes,boundCount=bound(c_int(0),c_int(-1))
 assert boundText=="A\0你" and boundBytes==data and boundCount==c_int(23)
 Reader reader=root
 auto protocolText,protocolBytes,protocolCount=reader.read(c_int(0),c_int(-1))
 assert protocolText=="A\0你" and protocolBytes==data and protocolCount==c_int(23)
 string keptText="keep"
 bytes keptBytes=b"keep"
 c_int keptCount=77
 bool caught=false
 try
  keptText,keptBytes,keptCount=root.read(c_int(1),c_int(-1))
 catch error
  caught=true
  assert error.code==-7
 end
 assert caught and keptText=="keep" and keptBytes==b"keep" and keptCount==c_int(77)
 for failAfter in [0,1]
  beginCounter()
  caught=false
  try
   keptText,keptBytes,keptCount=root.read(c_int(0),c_int(failAfter))
  catch error
   caught=true
  finally
   resetFailure()
  end
  assert caught and keptText=="keep" and keptBytes==b"keep" and keptCount==c_int(77)
  endCounter()
 end
 root.close()
 return 0
end
