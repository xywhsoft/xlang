 native point handle
 extern "binding_output_view_method" @no_raise @c_output_view(3,"text") @c_output_view(4,"bytes") @c_outputs(3,4,5) @c_status(0) func read(c_int mode=0,c_int failAfter=-1) as (string,bytes,c_int)
 extern "xl6ForeignViewCloseV1" @no_raise @c_control(0) @c_result("bool_status") func close()
end
