extern "declarative_xge_heap_end" @no_raise func heapEnd()
extern "declarative_xge_fail_after" @no_raise func failAfter(c_int count)
extern "declarative_xge_reset_failure" @no_raise func resetFailure()
protocol Sizable
 func sized(c_float size) as Font
end
func resources(string path,bytes data)
 Texture texture=createTexture(2,2)
 assert texture.width==2 and texture.height==2
 texture.close()
 bool expired=false
 try
  auto invalid=texture.width
 catch error
  expired=true
 end
 assert expired
 Font font=loadFont(path,c_float(16))
 Font other=font.sized(c_float(24))
 func(c_float) as Font factory=font.sized
 Font bound=factory(c_float(20))
 Sizable sizable=font
 Font throughProtocol=sizable.sized(c_float(18))
 var dynamicFont=font
 Font throughDynamic=dynamicFont.sized(c_float(22)) as Font
 Font memory=loadFontMemory(data,c_float(17))
 assert font.size==16.0 and other.size==24.0 and bound.size==20.0 and throughProtocol.size==18.0 and throughDynamic.size==22.0 and memory.size==17.0
 font.setFallback(other)
 Font savedFallback=font.fallback as Font
 other.close()
 // Font's native reference keeps the adopted fallback RECORD alive.
 font.setFallback(null)
 assert savedFallback.size==24.0
 savedFallback.close()
 font.close()
 bound.close()
 throughProtocol.close()
 throughDynamic.close()
 memory.close()
end
func failures()
 bool invalid=false
 try
  Texture bad=createTexture(-1,2)
 catch error
  invalid=true
 end
 assert invalid
 invalid=false
 try
  Texture bad=loadTexture(b"invalid\0image")
 catch error
  invalid=true
 end
 assert invalid
 int budget=0
 int accepted=0
 int rejected=0
 while budget<32
  failAfter(c_int(budget))
  try
   Texture texture=createTexture(2,2)
   assert texture.width==2
   accepted+=1
  catch error
   rejected+=1
  finally
   resetFailure()
  end
  budget+=1
 end
 assert accepted>0 and rejected>0
end
func main(...) as int
 start()
 string path=fontPath()
 bytes data=fontBytes()
 heapBegin()
 resources(path,data)
 failures()
 heapEnd()
 return 0
end
