import xui
from xui import Widget
extern "fixtureRenderProxy" @header("test/cases/foreign_xui_constructor_retirement.h") @no_raise @c_result("owned_view") @factory(0,0,dropProxy) func cpuProxy() as xui.Proxy
extern "xuiProxyReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropProxy(xui.Proxy value)
extern "fixtureRenderFont" @no_raise @c_result("owned_view") @factory(1,0,dropFont) func cpuFont(xui.Proxy proxy) as xui.Font
extern "xuiFontReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropFont(xui.Font value)
extern "fixtureRenderBalanced" @no_raise func balanced() as c_int
extern "fixtureRenderBudget" @no_raise func budget(c_int n)
extern "fixtureRetireSelect" @no_raise func selectCase(c_int kind,c_int allowance)
extern "fixtureRetireBoundBegin" @no_raise func boundBegin()
extern "fixtureRetireBoundEnd" @no_raise func boundEnd() as c_int
extern "fixtureRetireHeapBegin" @no_raise func heapBegin()
extern "fixtureRetireHeapEqual" @no_raise func heapEqual()
extern "fixtureRetireMenuCheck" @no_raise func menuCheck(xui.Menu menu,c_int added)
func create(xui.Context ui,int kind) as xui.Widget
 if kind==0 then return ui.hyperlinkNative() end
 if kind==1 then return ui.inputNative() end
 if kind==2 then return ui.tagInputNative() end
 if kind==3 then return ui.numericInputNative() end
 if kind==4 then return ui.textEditNative() end
 if kind==5 then return ui.inventoryGridNative() end
 if kind==6 then return ui.terminalNative() end
 if kind==7 then return ui.tableGridNative() end
 if kind==8 then return ui.propertyGridNative() end
 if kind==9 then return ui.comboBoxNative() end
 return ui.codeEditNative()
end
func exercise(int kind,int allowance) as int
 selectCase(c_int(kind),c_int(allowance))
 auto proxy=cpuProxy()
 auto ui=xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
 auto font=cpuFont(proxy)
 ui.setDefaultFont(font)
 auto root=ui.widget()
 assert ui.setRootWidget(root)==0
 auto first=create(ui,kind)
 assert root.addChild(first)==0
 int result=0
 if allowance<0 then
  boundBegin()
  auto warm=create(ui,kind)
  result=int(boundEnd())
  warm.close()
 else
  auto previous=first
  budget(c_int(allowance))
  try
   previous=create(ui,kind)
  catch Error
   result=1
  finally
   budget(-1)
  end
  if result==1 then
   assert previous==first
  else
   previous.close()
  end
  assert root.getChildCount()==1
 end
 ui.close()
 font.close()
 proxy.close()
 return result
end
func exerciseMenu(int allowance) as int
 selectCase(11,c_int(allowance))
 auto proxy=cpuProxy()
 auto ui=xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
 auto font=cpuFont(proxy)
 ui.setDefaultFont(font)
 auto menu=ui.menuNative()
 menu.addItem("kept","Ctrl+K",value=1)
 string text="new"
 string shortcut="Ctrl+N"
 int result=0
 if allowance<0 then
  boundBegin()
  menu.addItem(text,shortcut,value=7)
  result=int(boundEnd())
 else
  budget(c_int(allowance))
  try
   menu.addItem(text,shortcut,value=7)
  catch Error
   result=1
  finally
   budget(-1)
  end
  menuCheck(menu,c_int(1-result))
  assert text=="new" and shortcut=="Ctrl+N"
 end
 ui.close()
 font.close()
 proxy.close()
 return result
end
func main(...) as int
 for kind in range(12)
  int count=0
  if kind==11 then
   count=exerciseMenu(-1)
   assert exerciseMenu(0)==1
  else
   count=exercise(kind,-1)
   assert exercise(kind,0)==1
  end
  assert balanced()==1
  int failures=0
  int successes=0
  for allowance in range(count)
   heapBegin()
   int result=0
   if kind==11 then
    result=exerciseMenu(allowance)
   else
    result=exercise(kind,allowance)
   end
   assert balanced()==1
   heapEqual()
   if result==1 then
    failures+=1
   else
    successes+=1
   end
  end
  assert failures>0 and successes>0
  println("Language constructor "+string(kind)+" prefixes="+string(count))
 end
 println("ConstructorRetirement: eleven factories, menu copies, old values and exact resource retirement passed")
 return 0
end
