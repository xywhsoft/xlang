import xge
extern "fixtureFontLoadPath" @header("test/cases/foreign_xge3_font_load.h") func fixturePath() as string
extern "fixtureFontLoadHeap" @header("test/cases/foreign_xge3_font_load.h") @no_raise @c_outputs(0,1) func heap() as (c_size,c_size)
extern "xrtMemDebugFailAfter" @header("xrt_decl.h") @no_raise func failAfter(uint64 budget) as bool
extern "xrtMemDebugFailClear" @header("xrt_decl.h") @no_raise func failClear()
extern "xrtMemDebugEnabled" @header("xrt_decl.h") @no_raise func debugEnabled() as bool
func loadAndClose(string path)
 auto request=xge.createFontLoad()
 try
  request.start(path,c_float(20))
  request.throwIfFailed()
  auto font=request.take()
  font.close()
 finally
  request.close()
 end
end
func main(...) as int
 assert debugEnabled()
 xge.init(4,4,"Font loading OOM",0,xge.XGE_RUN_MANUAL)
 string path=fixturePath()
 try
  loadAndClose(path)
  assert failAfter(uint64(0))
  try
   loadAndClose(path)
  catch Error error
  end
  failClear()
  int failed=0
  int passed=0
  for budget in range(80)
   auto count0,bytes0=heap()
   assert failAfter(uint64(budget))
   try
    loadAndClose(path)
    passed+=1
   catch Error error
    failed+=1
   end
   failClear()
   auto count1,bytes1=heap()
   assert count0==count1 and bytes0==bytes1
   assert xge.graphicsResourceCount()==uint64(0)
  end
  assert failed>0 and passed>0
  println("FontLoad language budgets: ",failed," checked failures, ",passed," successes; owners and heap balanced")
 finally
  failClear()
  xge.unit()
 end
 return 0
end
