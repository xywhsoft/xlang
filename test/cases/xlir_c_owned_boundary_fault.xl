typedef OptionalBoundaryReader = (func() as string)?
extern "c_owned_text" @no_raise func nativeText() as point
extern "c_owned_binary" @no_raise func nativeBytes() as point
extern "c_owned_release" @no_raise func nativeFree(point data)
extern "owned_observe_array_pack" @no_raise func observeArray(array data)
extern "owned_observe_dict_pack" @no_raise func observeDict(dict data)
func text() as cstring
    return cstring.take(nativeText(),nativeFree)
end
func data() as cbytes
    return cbytes.take(nativeBytes(),4,nativeFree)
end
func pair() as (cstring,cbytes,int)
    return text(),data(),7
end
func optional(bool present) as cstring?
    return present ? text() : null
end
func arrayText(...) as cstring
    observeArray(arg)
    return text()
end
func dictBytes(int first,***) as cbytes
    observeDict(arg)
    assert first==7
    return data()
end
func arrayPair(...) as (cstring,cbytes,int)
    observeArray(arg)
    return pair()
end
func dictOptional(bool present,***) as cstring?
    observeDict(arg)
    return optional(present)
end
func defaultCallback(int base) as func(int,***) as cbytes
    return func(int first=base,***) as cbytes => first==base ? data() : b"wrong"
end
func factory() as func() as cstring
    return text
end
func nullableFactory(bool present) as (func() as cstring)?
    if not present then return null end
    auto value=text()
    return func() as cstring => value
end
func nullableDefault(bool present,int base) as (func(int,***) as cbytes)?
    if not present then return null end
    auto value=data()
    return func(int first=base,***) as cbytes => first==base ? value : b"wrong"
end
func pairFactory() as func() as (cstring,cbytes,int)
    return pair
end
func nullablePairFactory(bool present) as (func() as (cstring,cbytes,int))?
    if present then return pair end
    return null
end
func nestedPairFactory() as func() as func() as (cstring,cbytes,int)
    return pairFactory
end
func arrayAdapter() as func(...) as string
    auto raw=arrayText
    return raw
end
func dictAdapter() as func(int,***) as bytes
    auto raw=dictBytes
    return raw
end
func(...) as string identityArray=arrayAdapter()
func(int,***) as bytes identityDict=dictAdapter()
class Base
    virtual func get() as string
        return "base"
    end
end
class Derived extends Base
    override func get() as cstring
        return text()
    end
end
export "owned_boundary_exercise" func exercise(int mode) as bool
    if mode==0
        func() as string callback=text
        return callback()=="hello"
    elseif mode==1
        auto producer=text
        func() as string callback=producer
        producer=func() as cstring => "replacement"
        return callback()=="hello"
    elseif mode==2
        var callback=xcall(pair)
        auto first,second,number=callback()
        return first=="hello" and second==b"\0\xff\x11*" and number==7
    elseif mode==3
        var callback=xcall(optional)
        return callback(false)==null and callback(true)=="hello"
    elseif mode==4
        Base object=Derived()
        return object.get()=="hello"
    elseif mode==5
        auto raw=arrayText
        func(...) as string callback=raw
        return callback(1,"tail",true)=="hello"
    elseif mode==6
        auto raw=dictBytes
        var callback=xcall(raw)
        return callback(7,answer=42,label="tail")==b"\0\xff\x11*"
    elseif mode==7
        auto raw=arrayPair
        var callback=xcall(raw)
        auto first,second,number=callback(1,"tail")
        return first=="hello" and second==b"\0\xff\x11*" and number==7
    elseif mode==8
        auto raw=dictOptional
        var callback=xcall(raw)
        return callback(false,answer=42)==null and callback(true,label="tail")=="hello"
    elseif mode==9
        auto raw=defaultCallback(19)
        var callback=xcall(raw)
        return callback()==b"\0\xff\x11*" and callback(first=19,label="tail")==b"\0\xff\x11*"
    elseif mode==10
        auto raw=factory
        var callback=xcall(raw)
        return callback()()=="hello"
    elseif mode==11
        auto value=cstring.take(nativeText(),5,nativeFree)
        var copied=value
        return copied=="hello"
    elseif mode==12
        auto source=nullableFactory(true)
        (func() as string)? callback=source
        source=null
        (func() as string)? absent=nullableFactory(false)
        if callback!=null then return callback()=="hello" and absent==null end
        return false
    elseif mode==13
        auto raw=nullableFactory
        func(bool) as OptionalBoundaryReader callback=raw
        auto present=callback(true)
        if present!=null then return present()=="hello" and callback(false)==null end
        return false
    elseif mode==14
        auto raw=nullableFactory
        var callback=xcall(raw)
        return callback(true)()=="hello" and callback(false)==null
    elseif mode==15
        auto source=nullableDefault(true,19)
        (func(int,***) as bytes)? callback=source
        source=null
        if callback!=null then
            var dynamic=xcall(callback)
            return dynamic()==b"\0\xff\x11*" and dynamic(first=19,answer=42)==b"\0\xff\x11*"
        end
        return false
    elseif mode==16
        auto raw=pairFactory
        func() as func() as (string,cbytes,int) callback=raw
        auto first,second,number=callback()()
        return first=="hello" and second==b"\0\xff\x11*" and number==7
    elseif mode==17
        func() as func() as (cstring,bytes,int) callback=pairFactory
        auto first,second,number=callback()()
        return first=="hello" and second==b"\0\xff\x11*" and number==7
    elseif mode==18
        auto raw=nullablePairFactory(true)
        (func() as (string,cbytes,int))? callback=raw
        raw=null
        if callback!=null then
            auto first,second,number=callback()
            return first=="hello" and second==b"\0\xff\x11*" and number==7
        end
        return false
    else
        auto raw=nestedPairFactory
        func() as func() as func() as (cstring,bytes,int) callback=raw
        auto first,second,number=callback()()()
        return first=="hello" and second==b"\0\xff\x11*" and number==7
    end
end
