// Ordinary communication only, own IPv4/IPv6 loopback ephemeral endpoints.
func exercise(int family)
    auto receiver = NetSocket(NetSocketKind.datagram, family)
    auto sender = NetSocket(NetSocketKind.datagram, family)
    receiver.bind(NetAddress.loopback(family))
    sender.bind(NetAddress.loopback(family))
    auto available = receiver.metadataAvailable()
    // Exercise actual supported metadata without assuming identical platforms.
    auto enabled = available & (NetDatagramMetadata.destination | NetDatagramMetadata.interfaceIndex | NetDatagramMetadata.hopLimit)
    receiver.enableMetadata(enabled)
    assert receiver.metadataEnabled() == enabled
    auto controls = sender.controlAvailable()
    assert int(sender.datagramCapabilities()) >= 0
    sender.setMulticastLoop(true)
    sender.setMulticastHopLimit(1)
    sender.setMulticastInterface()
    auto information = NetDatagramInfo()
    auto output = Buffer(b"prefix")
    auto noPacket, emptyCount = receiver.receiveFromInto(output,information,16)
    assert noPacket == NetStatus.again and emptyCount == 0 and not information.hasPacket
    auto control = NetDatagramControl()
    if (controls & NetDatagramControlFlags.hopLimit) != NetDatagramControlFlags.none
        control = control.withHopLimit(37)
    end
    auto sent, count = sender.sendMessage("a\0你",receiver.localAddress(),control,99)
    assert sent == NetStatus.ok and count == 5
    int rounds = 0
    while true
        auto status, size = receiver.receiveFromInto(output,information,16)
        if status == NetStatus.ok
            assert size == 5 and output.length == 11 and output[7] == 0
            break
        end
        assert status == NetStatus.again
        rounds += 1
        assert rounds < 100000
    end
    assert information.hasPacket and information.remote.equals(sender.localAddress())
    if (information.metadata & NetDatagramMetadata.destination) != NetDatagramMetadata.none
        assert information.destination.sameIP(receiver.localAddress()) and information.destination.port == 0
    end
    if (information.metadata & NetDatagramMetadata.interfaceIndex) != NetDatagramMetadata.none
        assert information.interfaceIndex > 0
    end
    if (information.metadata & NetDatagramMetadata.hopLimit) != NetDatagramMetadata.none and int(control.flags) != 0
        assert information.hopLimit == 37
    end
    auto again, zero = receiver.receiveFromInto(output,information,16)
    assert again == NetStatus.again and zero == 0 and information.hasPacket
    assert information.remote.equals(sender.localAddress()) and output.length == 11
    auto status, size = sender.sendMessage(b"abc",receiver.localAddress(),NetDatagramControl(),99)
    assert status == NetStatus.ok and size == 3
    rounds = 0
    while true
        auto result, size = receiver.receiveFromInto(output,information,1)
        if result == NetStatus.truncated
            assert size == 1 and output.length == 12
            break
        end
        assert result == NetStatus.again
        rounds += 1
        assert rounds < 100000
    end
    auto source = Buffer()
    auto result, length = sender.sendMessage(source,receiver.localAddress(),NetDatagramControl())
    assert result == NetStatus.ok and length == 0
    rounds = 0
    while true
        auto status, size = receiver.receiveFromInto(output,information,0)
        if status == NetStatus.ok
            assert size == 0 and output.length == 12 and information.hasPacket
            break
        end
        assert status == NetStatus.again
        rounds += 1
        assert rounds < 100000
    end
    information.clear()
    assert not information.hasPacket and information.metadata == NetDatagramMetadata.none
    sender.close()
    receiver.close()
end
exercise(4)
exercise(6)
println("Datagram own IPv4/IPv6 metadata, source, control, NUL, truncation and empty packet: ok")
