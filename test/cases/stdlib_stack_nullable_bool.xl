func main(...) as int
    Stack<bool?> values = Stack::<bool?>()
    assert(values.push(null) and values.push(false))
    auto found, item = values.tryPop()
    assert(found and item != null and item == false)
    auto hasNull, none = values.tryPop()
    assert(hasNull and none == null)
    auto absent, empty = values.tryPop()
    assert(not absent and empty == null)
    return 0
end
