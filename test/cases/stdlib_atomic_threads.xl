import concurrent

func add(AtomicInt64 value) as func() as int
    return func() as int
        int i = 0
        while i < 1000
            value.fetchAdd(1, concurrent.relaxed)
            i += 1
        end
        return 0
    end
end

auto counter = AtomicInt64()
auto first = thread(add(counter))
auto second = thread(add(counter))
assert first.waitTimeout(30000) and second.waitTimeout(30000)
assert first.exitCode() == 0 and second.exitCode() == 0
assert counter.load() == 2000
println("atomic thread sharing ok")
