int eventCount = 0
bool nested = false
bool closeRejected = false
string lastMessage = ""
auto logger = log.create("object-test", LogLevel.trace)
LogSink? installed = null
auto sink = log.customSink(func(LogRecord record) as LogResult
    eventCount += 1
    lastMessage = record.message
    assert record.level == LogLevel.info
    assert record.logger == "object-test"
    if installed != null then
        try
            installed.closeCustom()
        catch RuntimeError e
            closeRejected = true
        end
    end
    if not nested then
        nested = true
        assert logger.info("nested") == LogResult.written
    end
    return LogResult.written
end, "capture", LogLevel.info)
installed = sink
logger.addSink(sink)
assert sink.name == "capture"
sink.setLevel(LogLevel.debug)
assert sink.getLevel() == LogLevel.debug
assert logger.info("outer") == LogResult.written
assert eventCount == 2
assert lastMessage == "nested"
assert closeRejected
assert logger.removeSink(sink)
assert not logger.removeSink(sink)
assert logger.info("after-remove") == LogResult.skipped
assert eventCount == 2
// Explicit close breaks the callback -> sink/Logger capture cycle.
assert sink.closeCustom()
installed = null
