import xui
from xui import CallbackWidget, CallbackInventorySlot

func checkInventory(xui.Context ui) as NativeSequence<c_int>
    auto grid = ui.inventoryGridNative()
    grid.setSlotCount(4)
    auto item = xui.InventorySlotSettings()
    item.iItemId = 11
    item.iCount = 3
    item.iMaxCount = 20
    item.iItemType = 4
    grid.setSlotContent(0, item, "Red potion", "1")
    item.iItemId = 12
    item.iCount = 7
    grid.setSlotContent(1, item, "Blue potion", "2")
    item.iItemId = 13
    grid.setSlotContent(2, item, "Green POTION", "3")
    string prefix = string.repeat("a", 62)
    string key = string.repeat("b", 14)
    grid.setSlotContent(3, item, prefix + "尾", key + "尾")
    auto details, title, hotkey = grid.getSlotContent(3)
    assert details.iItemId == 13 and details.iItemType == 4 and details.iMaxCount == 20, "slot settings round trip"
    assert title == prefix and hotkey == key, "UTF-8 boundary"
    grid.clearSlot(3)
    assert title == prefix and hotkey == key, "read result owns its text"

    auto ranked = grid.querySlots(
        c_uint(xui.XUI_INVENTORY_QUERY_EXCLUDE_EMPTY | xui.XUI_INVENTORY_QUERY_CASE_INSENSITIVE |
               xui.XUI_INVENTORY_QUERY_SORT_DESCENDING), 0, 0,
        xui.XUI_INVENTORY_SORT_COUNT, "potion")
    auto positions = ranked.indices()
    assert positions.length == 3 and positions[0] == 2 and positions[1] == 1 and positions[2] == 0, "descending query and tie break"
    ranked.close()
    auto missing = grid.querySlots(textContains = "unmatched")
    assert missing.indices().length == 0, "empty query"
    missing.close()

    array<c_int> input = [2, 0, 1, 3]
    auto sorted = grid.sortSlots(input, 3, xui.XUI_INVENTORY_SORT_SLOT_INDEX)
    auto order = sorted.indices()
    assert order.length == 3 and order[0] == 0 and order[1] == 1 and order[2] == 2, "sort input prefix"
    assert input[0] == 2 and input[1] == 0
    sorted.close()

    CallbackInventorySlot? saved = null
    int calls = 0
    auto selection = grid.querySlots(
        flags = c_uint(xui.XUI_INVENTORY_QUERY_EXCLUDE_EMPTY),
        sortMode = xui.XUI_INVENTORY_SORT_CUSTOM,
        filter = func(CallbackWidget sender, c_int index, CallbackInventorySlot slot) as c_int
            calls += 1
            if index == 0 then
                saved = slot
                grid.clearSlot(1)
            end
            if index == 1 then
                assert slot.text() == "Blue potion" and slot.hotkey() == "2" and slot.itemId == 12, "callback sees pre-mutation slot"
            end
            return 1
        end,
        compare = func(CallbackWidget sender, c_int left, CallbackInventorySlot a, c_int right, CallbackInventorySlot b) as c_int
            return b.itemId - a.itemId
        end)
    auto selected = selection.indices()
    assert calls == 3 and selected.length == 3 and selected[0] == 2 and selected[1] == 1 and selected[2] == 0, "callbacks share the same snapshot"
    selection.close()
    bool expired = false
    try
        string gone = (saved as CallbackInventorySlot).text()
    catch StateError
        expired = true
    end
    assert expired, "callback slot cannot outlive the callback"

    bool raised = false
    try
        grid.sortSlots(input, 3, xui.XUI_INVENTORY_SORT_CUSTOM,
            compare = func(CallbackWidget sender, c_int left, CallbackInventorySlot a, c_int right, CallbackInventorySlot b) as c_int
                throw RuntimeError "inventory compare failure"
            end)
    catch RuntimeError error
        raised = error.message == "inventory compare failure"
    end
    assert raised and input[0] == 2 and positions[0] == 2, "callback error is checked"
    grid.close()
    assert positions[1] == 1 and selected[0] == 2, "sequences outlive grid and result handles"
    return positions
end

auto proxy = xui.createProxy()
auto ui = xui.create(proxy, xui.XUI_SYSTEM_FONT_DISABLED)
auto retained = checkInventory(ui)
ui.close()
proxy.close()
assert retained.length == 3 and retained[2] == 0
println("XUI_INVENTORY_SLOT_QUERY_OK")
