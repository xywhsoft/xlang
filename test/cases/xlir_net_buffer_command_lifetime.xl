// Receive into an explicitly owned chain; never peek a Worker-only TCP view.
auto engine = NetEngine(NetEngineOptions().withWorkers(1).withBackend(NetBackend.select))
engine.start()
auto listener = TcpListener(engine, TcpListenOptions(NetAddress.loopback()))
auto accepted = listener.acceptAsync()
auto client = TcpStream(engine, listener.localAddress())
auto peer = await accepted
assert client.wait(TcpWait.open, 5000) == NetStatus.ok
assert client.send("peek-\0consume") == NetStatus.ok
auto input = NetBuffer()
while input.length < 13
    assert await peer.recvIntoAsync(input, 13 - input.length) > 0
end
assert input.peek(0, 4) == b"peek"
assert input.peek() == b"peek-\0consume"
bool rejected = false
try
    input.peek(14)
catch RangeError
    rejected = true
end
assert rejected and input.length == 13
client.close()
peer.close()
listener.close()
engine.close()
assert engine.wait(5000)
// Input and returned values outlive the transport and its worker.
bytes held = input.peek()
assert input.consume(5) == 5
assert input.read() == b"\0consume" and input.length == 0
assert held == b"peek-\0consume"
println("xlir net buffer command lifetime ok")
