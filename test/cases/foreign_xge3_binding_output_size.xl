func main(...) as int
 auto info=sized(c_int(17))
 assert info.byteSize>c_uint(0) and info.value==c_int(17)
 assert sizedVoid().value==c_int(9)
 func(c_int) as Info freeValue=sized
 assert freeValue(c_int(18)).value==c_int(18)
 Root root=create()
 assert root.read(c_int(19)).value==c_int(19)
 func(c_int) as Info bound=root.read
 assert bound(c_int(20)).value==c_int(20)
 Reader reader=root
 assert reader.read(c_int(21)).value==c_int(21)
 auto count,first,last=multi(b"a\0b")
 assert count==c_uint(3) and first.value==c_int(97) and last.value==c_int(98)
 auto native=buildInfo()
 assert native.size>c_uint(0) and native.api_major==c_uint(3) and native.abi_fingerprint!=uint64(0)
 root.close()
 return 0
end
