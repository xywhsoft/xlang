extern "expect_i64" func expect(int actual, int expected)

string text = "alphabet"
auto values = [1, 2, 3]
auto sparse = [0: "a", 2: "b"]
auto unique = {1, 2, 3}
auto table = {"a": 1, "b": 2}

func makeDynArray() as var
    return [4, 5, 6]
end

func makeDynTable() as var
    return {"b": 2}
end

func literalArrayInExpr() as bool
    return 2 in [1, 2, 3]
end

func dynArrayInExpr() as bool
    return 5 in makeDynArray()
end

func literalDictInExpr() as bool
    return "a" in {"a": 1}
end

func dynDictInExpr() as bool
    return "b" in makeDynTable()
end

expect("pha" in text, 1)
expect("xyz" in text, 0)

expect(2 in values, 1)
expect(9 in values, 0)
expect(2 in [1, 2, 3], 1)
expect(5 in makeDynArray(), 1)

expect("b" in sparse, 1)
expect("x" in sparse, 0)

expect(3 in unique, 1)
expect(9 in unique, 0)

expect("a" in table, 1)
expect("z" in table, 0)
expect("a" in {"a": 1}, 1)

var dynArray = values
var dynText = text
var dynTable = table

expect(1 in dynArray, 1)
expect(8 in dynArray, 0)
expect("bet" in dynText, 1)
expect("nope" in dynText, 0)
expect("b" in dynTable, 1)
expect("b" in makeDynTable(), 1)

expect(literalArrayInExpr(), 1)
expect(dynArrayInExpr(), 1)
expect(literalDictInExpr(), 1)
expect(dynDictInExpr(), 1)
