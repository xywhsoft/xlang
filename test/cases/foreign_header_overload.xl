extern "foreign_header_overload" @header("test/cases/foreign_header_overload.h") @no_raise func read(c_double value) as c_double
extern "foreign_header_ordinal" @header("test/cases/foreign_header_overload.h") @no_raise func ordinal(c_int value) as c_int
extern "foreign_header_nothrow" @header("test/cases/foreign_header_overload.h") @no_raise func next(c_int value) as c_int
assert read(c_double(1.5))==c_double(1.5)
assert ordinal(c_int(-1))==c_int(-1)
assert next(c_int(3))==c_int(4)
