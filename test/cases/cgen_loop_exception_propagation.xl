func loopThrow() as int
    int state = 0

    try
        for i in range(0, 3)
            state = state + 1
            if i == 1 then
                throw "loop boom"
            end
        end
        state = 1000
    catch e
        if e.message == "loop boom" then
            state = state + 10
        end
    finally
        state = state + 100
    end

    return state
end

func whileThrow() as int
    int state = 0

    try
        while state < 3
            string marker = "managed"
            array<int> values = array[1, 2, 3]
            state += 1
            if state == 2 and marker == "managed" and values[0] == 1 then
                throw "while boom"
            end
        end
        state = 2000
    catch e
        if e.message == "while boom" then
            state += 20
        end
    finally
        state += 200
    end

    return state
end

func main(...) as int
    if loopThrow() != 112 then
        return 1
    end
    if whileThrow() != 222 then
        return 2
    end
    return 0
end
