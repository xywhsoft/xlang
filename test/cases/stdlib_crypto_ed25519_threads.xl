func reader(Ed25519Key key) as func() as int
    return func() as int
        if key.sign(b"") == b"\xe5\x56\x43\x00\xc3\x60\xac\x72\x90\x86\xe2\xcc\x80\x6e\x82\x8a\x84\x87\x7f\x1e\xb8\xe5\xd9\x74\xd8\x73\xe0\x65\x22\x49\x01\x55\x5f\xb8\x82\x15\x90\xa3\x3b\xac\xc6\x1e\x39\x70\x1c\xf9\xb4\x6b\xd2\x5b\xf5\xf0\x59\x5b\xbe\x24\x65\x51\x41\x43\x8e\x7a\x10\x0b" then return 0 end
        return 1
    end
end
auto key = Ed25519Key(b"\x9d\x61\xb1\x9d\xef\xfd\x5a\x60\xba\x84\x4a\xf4\x92\xec\x2c\xc4\x44\x49\xc5\x69\x7b\x32\x69\x19\x70\x3b\xac\x03\x1c\xae\x7f\x60")
auto a = thread(reader(key))
auto b = thread(reader(key))
assert a.waitTimeout(30000)
assert b.waitTimeout(30000)
assert a.exitCode() == 0
assert b.exitCode() == 0
