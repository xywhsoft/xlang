func catchThrow() as int
    int state = 0
    int messageOk = 0
    int kindOk = 0
    int lineOk = 0

    try
        state = 1
        throw "boom"
        state = 100
    catch e
        state = state + 1
        if e.message == "boom" then
            messageOk = 1
        end
        if e.kind == "Error" then
            kindOk = 1
        end
        if e.line > 0 then
            lineOk = 1
        end
    finally
        state = state + 10
    end

    return state + messageOk + kindOk + lineOk
end

func catchAssert() as int
    int state = 0
    int messageOk = 0
    int kindOk = 0

    try
        assert false, "bad state"
        state = 100
    catch e
        state = 1
        if e.message == "bad state" then
            messageOk = 1
        end
        if e.kind == "AssertionError" then
            kindOk = 1
        end
    end

    return state + messageOk + kindOk
end

func rethrowKeepsOriginal() as int
    int state = 0

    try
        try
            throw "inner"
        catch e
            state = state + 1
            throw
        end
    catch outer
        if outer.message == "inner" then
            state = state + 10
        end
    end

    return state
end

func finallyWithoutCatchNormal() as int
    int state = 0

    try
        state = 1
    finally
        state = state + 10
    end

    return state
end

func finallyWithoutCatchThrows() as int
    int state = 0

    try
        try
            state = 1
            throw "through finally"
        finally
            state = state + 10
        end
    catch e
        if e.message == "through finally" then
            state = state + 100
        end
    end

    return state
end

func assertTrueDoesNothing() as int
    int state = 1
    assert state == 1
    state = state + 1
    return state
end

func main(...) as int
    if catchThrow() != 15 then
        return 1
    end
    if catchAssert() != 3 then
        return 2
    end
    if rethrowKeepsOriginal() != 11 then
        return 3
    end
    if finallyWithoutCatchNormal() != 11 then
        return 4
    end
    if finallyWithoutCatchThrows() != 111 then
        return 5
    end
    if assertTrueDoesNothing() != 2 then
        return 6
    end
    return 0
end
