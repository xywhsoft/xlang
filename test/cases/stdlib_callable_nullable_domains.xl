enum Small as int8
    zero = 0
    high = 127
end
func integers(int8? a, int16? b, int32? c, int64? d, uint8? e, uint16? f, uint32? g, uint64? h) as (int8?, int16?, int32?, int64?, uint8?, uint16?, uint32?, uint64?)
    return a, b, c, d, e, f, g, h
end
var ints = xcall(integers)
func(int8?, int16?, int32?, int64?, uint8?, uint16?, uint32?, uint64?) as (int8?, int16?, int32?, int64?, uint8?, uint16?, uint32?, uint64?) typedInts = ints
auto a, b, c, d, e, f, g, h = typedInts(null, null, null, null, null, null, null, null)
assert a == null and b == null and c == null and d == null and e == null and f == null and g == null and h == null
a, b, c, d, e, f, g, h = typedInts(int8(-128), int16(-32768), int32(-2147483648), -9223372036854775808, uint8(255), uint16(65535), uint32(4294967295), uint64(18446744073709551615))
assert (a ?? int8(0)) == int8(-128) and (b ?? int16(0)) == int16(-32768) and (c ?? int32(0)) == int32(-2147483648) and (d ?? 0) == -9223372036854775808
assert (e ?? uint8(0)) == uint8(255) and (f ?? uint16(0)) == uint16(65535) and (g ?? uint32(0)) == uint32(4294967295) and (h ?? uint64(0)) == uint64(18446744073709551615)
func scalars(float32? a, float64? b, time? c, Small? d) as (float32?, float64?, time?, Small?)
    return a, b, c, d
end
var scalarCall = xcall(scalars)
func(float32?, float64?, time?, Small?) as (float32?, float64?, time?, Small?) typedScalars = scalarCall
auto real32, real64, stamp, nominal = typedScalars(null, null, null, null)
assert real32 == null and real64 == null and stamp == null and nominal == null
real32, real64, stamp, nominal = typedScalars(float32(0), 0.0, #2026-01-01#, Small.zero)
assert (real32 ?? float32(1)) == float32(0) and (real64 ?? 1.0) == 0.0 and (stamp ?? #2025-01-01#) == #2026-01-01# and (nominal ?? Small.high) == Small.zero
