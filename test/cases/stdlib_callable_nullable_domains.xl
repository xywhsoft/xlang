assert (nf ?? c_int(1)) == c_int(0) and (ng ?? c_uint(1)) == c_uint(0) and (nh ?? c_long(1)) == c_long(0) and (ni ?? c_ulong(1)) == c_ulong(0) and (nj ?? c_longlong(1)) == c_longlong(0)
assert (nk ?? c_ulonglong(1)) == c_ulonglong(0) and (nl ?? c_size(1)) == c_size(0) and (nm ?? c_ptrdiff(1)) == c_ptrdiff(0) and (nn ?? c_wchar(1)) == c_wchar(0)
