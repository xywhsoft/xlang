import xui
from xui import CallbackVec2
extern "fixtureLayoutProxy" @header("test/cases/foreign_xui_widget_queries.h") @no_raise @c_result("owned_view") @factory(0,0,dropProxy) func cpuProxy() as xui.Proxy
extern "xuiProxyReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropProxy(xui.Proxy value)
extern "fixtureLayoutFont" @no_raise @c_result("owned_view") @factory(1,0,dropFont) func cpuFont(xui.Proxy proxy) as xui.Font
extern "xuiFontReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropFont(xui.Font value)
extern "fixtureQueryBudget" @no_raise func budget(c_int n)
extern "fixtureQueryCleanup" @no_raise func cleanup()
extern "fixtureQueryHeapBegin" @no_raise func heapBegin()
extern "fixtureQueryHeapReport" @no_raise func heapReport(c_int kind)
extern "fixtureQueryNativeHot" @no_raise func nativeHot(xui.Widget widget,xui.Terminal terminal)
extern "fixtureQueryWarm" @no_raise func warm(xui.Widget widget)
func main(...) as int
 auto proxy=cpuProxy()
 auto ui=xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
 auto font=cpuFont(proxy)
 ui.setDefaultFont(font)
 auto widget=ui.widget()
 widget.setSizeMode(xui.XUI_SIZE_CONTENT,xui.XUI_SIZE_CONTENT)
 auto constraint=xui.Vec2()
 constraint.fX=500
 constraint.fY=300
 xui.CallbackVec2? saved=null
 widget.setContentMeasureCallback(func(xui.Widget sender,xui.Vec2 bounds,xui.CallbackVec2 output) as c_int
  assert bounds.fX>=0 and bounds.fY>=0
  saved=output
  output.fX=37
  output.fY=19
  return c_int(0)
 end)
 auto content=widget.measureContent(constraint)
 assert content.fX==37 and content.fY==19
 auto measured=widget.measure(constraint)
 assert measured.fX==37 and measured.fY==19
 bool rejected=false
 try
  auto expired=(saved as CallbackVec2).fX
 catch StateError
  rejected=true
 end
 assert rejected
 auto terminal=ui.terminalNative()
 terminal.resize(20,4)
 assert terminal.writeText("A\u0301 中\nB") == 0 and terminal.flush()==0
 auto cell=terminal.getCell(0,0)
 assert cell.iSize==96 and cell.iCodepoint==65 and cell.iWidth==1
 assert cell.iCombiningCount==1 and cell.arrCombining[0]==0x301
 for i in range(1,16)
  assert cell.arrCombining[i]==0
 end
 auto wide=terminal.getCell(2,0)
 assert wide.iCodepoint==0x4e2d and wide.iWidth==2
 auto follower=terminal.getCell(3,0)
 assert follower.iWidth==0
 cell.arrCombining[0]=c_uint(0x302)
 assert terminal.getCell(0,0).arrCombining[0]==0x301
 rejected=false
 try
  cell=terminal.getCell(-1,0)
 catch Error
  rejected=true
 end
 assert rejected and cell.arrCombining[0]==0x302
 constraint.fX=-1
 rejected=false
 try
  content=widget.measureContent(constraint)
 catch Error
  rejected=true
 end
 assert rejected and content.fX==37 and content.fY==19
 rejected=false
 try
  measured=widget.measure(constraint)
 catch Error
  rejected=true
 end
 assert rejected and measured.fX==37 and measured.fY==19
 constraint.fX=500
 widget.setContentMeasureCallback(func(xui.Widget sender,xui.Vec2 bounds,xui.CallbackVec2 output) as c_int
  output.fX=123
  throw "measure callback failure"
 end)
 rejected=false
 try
  content=widget.measureContent(constraint)
 catch Error
  rejected=true
 end
 assert rejected and content.fX==37
 rejected=false
 try
  measured=widget.measure(constraint)
 catch Error
  rejected=true
 end
 assert rejected and measured.fX==37 and measured.fY==19
 widget.setContentMeasureCallback(null)
 // Prepared plain Widget queries have no user callback or font allocation.
 warm(widget)
 heapBegin()
 budget(0)
 try
  for i in range(1000)
   auto current=widget.measureContent(constraint)
   auto size=widget.measure(constraint)
   auto snapshot=terminal.getCell(0,0)
   assert current.fX==0 and size.fX>=0 and snapshot.iCodepoint==65
  end
 finally
  budget(-1)
 end
 heapReport(0)
 heapBegin()
 budget(0)
 try
  nativeHot(widget,terminal)
 finally
  budget(-1)
 end
 heapReport(1)
 auto worker=thread(func() as int
  try
   auto invalid=terminal.getCell(0,0)
  catch StateError
   return 1
  end
  return 0
 end)
 assert worker.waitTimeout(30000) and worker.exitCode()==1
 auto closing=ui.widget()
 closing.setContentMeasureCallback(func(xui.Widget sender,xui.Vec2 bounds,xui.CallbackVec2 output) as c_int
  sender.close()
  output.fX=99
  return c_int(0)
 end)
 rejected=false
 try
  content=closing.measureContent(constraint)
 catch Error
  rejected=true
 end
 assert rejected and content.fX==37
 func(c_int,c_int) as xui.TerminalCell read=terminal.getCell
 ui.close()
 rejected=false
 try
  cell=read(0,0)
 catch StateError
  rejected=true
 end
 assert rejected and cell.arrCombining[0]==0x302
 rejected=false
 try
  content=widget.measure(constraint)
 catch StateError
  rejected=true
 end
 assert rejected
 font.close()
 proxy.close()
 cleanup()
 println("WidgetQueries: measurement, callback expiry/errors, complete cell arrays, rollback, thread and close passed")
 return 0
end
