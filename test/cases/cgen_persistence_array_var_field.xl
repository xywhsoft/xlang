class DynamicBag
    derive value

    array<var> values = []
end

extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectText(string actual, string expected)

DynamicBag source = DynamicBag()
source.values.append(7)
source.values.append("two")
source.values.append(true)

string jsonText = json.stringify(source)
DynamicBag fromJson = json.parse::<DynamicBag>(jsonText)
expect(fromJson.values.length, 3)
expect(int(fromJson.values[0]), 7)
expectText(string(fromJson.values[1]), "two")
assert bool(fromJson.values[2]), "JSON array<var> bool item should survive"

string xlonText = xlon.stringify(source)
DynamicBag fromXlon = xlon.parse::<DynamicBag>(xlonText)
expect(fromXlon.values.length, 3)
expect(int(fromXlon.values[0]), 7)
expectText(string(fromXlon.values[1]), "two")
assert bool(fromXlon.values[2]), "XLON array<var> bool item should survive"
