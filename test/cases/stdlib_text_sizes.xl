assert string.lower("A\0B", 2) == "a\0"
assert string.lower("A\0B", 20) == "a\0b"
assert string.upper("a\0b", 0) == ""
assert string.slice("a\0你b", 1, -1, 2) == "\0"
assert string.trim("..A\0B..", ".x", -1, 1) == "A\0B"
assert string.filter("你a\0你", "你a", -1, 3) == "a\0"
assert string.replace("a\0bTAIL", "bZ", "你TAIL", 3, 1, 3) == "a\0你"
assert string.insert("a\0bTAIL", 2, "你TAIL", 3, 3) == "a\0你b"
assert string.repeat("a\0b", 2, 2) == "a\0a\0"
assert string.reverse("a\0b", 2) == "\0a"
int caught = 0
try
    string.lower("你A", 1)
catch e
    caught += 1
end
try
    string.lower("abc", -2)
catch e
    caught += 1
end
try
    string.repeat("abc", -1)
catch e
    caught += 1
end
try
    string.repeat("ab", 9223372036854775807)
catch e
    caught += 1
end
try
    string.slice("ab", 0, -2)
catch e
    caught += 1
end
try
    string.replace("abc", "你", "a", -1, 1)
catch e
    caught += 1
end
assert caught == 6
assert string.lower("A\0B") == "a\0b"
