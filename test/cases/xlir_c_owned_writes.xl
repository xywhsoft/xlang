extern "c_owned_text" @no_raise func nativeText() as point
extern "c_owned_binary" @no_raise func nativeBytes() as point
extern "c_owned_release" @no_raise func nativeFree(point data)
extern "c_owned_text_is_original" @no_raise func original(string text) as bool
extern "c_owned_released" @no_raise func released() as int
extern "c_owned_debug" @no_raise func debug() as bool
extern "c_owned_fail_next" @no_raise func failNext()
extern "c_owned_fail_clear" @no_raise func clearFailure()
func writes()
    string a = cstring.take(nativeText(),nativeFree)
    auto b = a
    a[0] = 'H'
    assert a == "Hello" and original(b) and released() == 0
    b = "done"
    assert released() == 1
    try
        a[100] = 'X'
        assert false
    catch ignored
        assert a == "Hello"
    end
    bytes c = cbytes.take(nativeBytes(),4,nativeFree)
    auto d = c
    c[1] = 7
    assert c[1] == 7 and d[1] == 255 and released() == 1
    d = b"done"
    assert released() == 2
end
writes()
assert released() == 2
