export "loop_cleanup_primary" func probe_primary() as int
    LoopGuard outer = LoopGuard(1)
    try
        LoopGuard middle = LoopGuard(2)
        for item in LoopSequence(3, 4)
            assert item.id == 4
            LoopGuard local = LoopGuard(5)
            primary()
            break
        end
    catch error
        assert outer.id == 1
        checked(error.code, 0)
    end
    return outer.id
end

export "loop_cleanup_inner_handler" func probe_inner_handler() as int
    LoopGuard outer = LoopGuard(1)
    try
        LoopGuard middle = LoopGuard(2)
        for item in LoopSequence(3, 4)
            assert item.id == 4
            try
                LoopGuard local = LoopGuard(5)
            catch error
                assert item.id == 4 and middle.id == 2 and outer.id == 1
                checked(error.code, 1)
            end
            break
        end
    catch error
        assert outer.id == 1
        checked(error.code, 0)
    end
    return outer.id
end

