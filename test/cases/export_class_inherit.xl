class Entity
    int id
end

class NamedPoint extends Entity
    int x
    int y
end

export "xl6_named_point_make" func makeNamedPoint(int id, int x, int y) as NamedPoint
    NamedPoint point = NamedPoint()
    point.id = id
    point.x = x
    point.y = y
    return point
end

export "xl6_named_point_score" func score(NamedPoint point) as int
    return point.id + point.x + point.y
end
