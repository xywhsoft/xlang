export typedef Action = func(c_int)
export typedef Reader = func(c_int) as c_int
func main(...) as int
 int result=0
 Action sink=func(c_int value)
  result+=int(value)
 end
 sink(c_int(3))
 Reader read=func(c_int value) as c_int
  return value+c_int(2)
 end
 assert result==3 and read(c_int(4))==c_int(6)
 return 0
end
