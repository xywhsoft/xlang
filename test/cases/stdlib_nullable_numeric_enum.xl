// Numeric enums preserve nominal identity across nullable Value boundaries.

enum S8 as int8
    low = -128
    high = 127
end

func boxS8(S8? value) as var
    return value
end

func checkS8()
    S8? present = S8.high
    var boxed = present
    S8? restored = boxed as S8?
    assert restored != null
    assert int(restored as S8) == int(S8.high)
    S8? low = boxS8(S8.low) as S8?
    assert low != null
    assert int(low as S8) == int(S8.low)
    S8? absent = null
    var erasedAbsent = absent
    assert erasedAbsent == null
    assert (boxS8(absent) as S8?) == null
    var unbound = int(S8.high)
    assert (unbound as S8?) == null
    int selected = match low as S8
    case low then 1
    case high then 2
    end
    assert selected == 1
end

