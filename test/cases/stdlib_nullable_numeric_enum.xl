enum Status as int32
    ok = 200
    missing = 404
end

enum OtherStatus as int32
    ok = 200
end

class EnumEnvelope
    Status? value = null

    create(Status? item)
        self.value = item
    end
end

func checkTransport()
    Status? present = Status.ok
    Status? absent = null
    var peer = OtherStatus.ok
    assert (peer as Status?) == null
    var plain = 200
    assert (plain as Status?) == null
    var copied = present
    var again = copied
    assert (again as Status?) == present
    Status strict = again as Status
    assert strict == Status.ok
    int caught = 0
    try
        Status wrong = peer as Status
    catch TypeError error
        caught += 1
    end
    assert caught == 1

    EnumEnvelope item = EnumEnvelope(present)
    var boxedField = item.value
    assert (boxedField as Status?) == present
    item.value = absent
    var emptyField = item.value
    assert emptyField == null

    array<Status?> values = array[present, absent, Status.missing]
    assert values[0] == present
    assert values[1] == null
    int total = 0
    int missing = 0
    for value in values
        var erased = value
        Status? roundtrip = erased as Status?
        assert roundtrip == value
        if roundtrip == null
            missing += 1
        else
            total += int(roundtrip as Status)
        end
    end
    assert total == 604
    assert missing == 1
    list<Status?> sparse = list[0: present, 3: absent]
    assert sparse[0] == present
    assert sparse[3] == null

    Stack<Status?> stack = Stack::<Status?>()
    stack.push(present)
    stack.push(absent)
    var emptyPop = stack.pop()
    assert emptyPop == null
    var presentPop = stack.pop()
    assert (presentPop as Status?) == present

    auto closure = func() as var
        return present
    end
    assert (closure() as Status?) == present
    present = null
    // Read-only captures own a value snapshot, not a reference to this slot.
    assert (closure() as Status) == Status.ok
end

func main(...) as int
    checkS8()
    checkU8()
    checkS16()
    checkU16()
    checkS32()
    checkU32()
    checkS64()
    checkU64()
    checkTransport()
    return 0
end
