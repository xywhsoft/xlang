func checkNativeOrder<K>(OrderedMap<K, int> values, K low, K high) as bool
    assert(values.set(high, 9) and values.set(low, 3))
    auto first, firstValue = values.first()
    auto last, lastValue = values.last()
    assert(first == low and firstValue == 3 and last == high and lastValue == 9)
    auto found, optionalKey, optionalValue = values.tryFirst()
    assert(found and optionalKey != null and optionalKey == low and (optionalValue ?? 0) == 3)
    auto lower, lowerValue = values.lowerBound(low)
    auto upper, upperValue = values.upperBound(low)
    assert(lower == low and lowerValue == 3 and upper == high and upperValue == 9)
    auto keys = values.keys()
    assert(keys.length == 2 and keys[0] == low and keys[1] == high)
    auto copy = values.clone()
    assert(copy.equals(values) and copy.get(low) == 3)
    assert(copy.take(low) == 3 and not copy.contains(low) and values.contains(low))
    return true
end
func main(...) as int
    assert(checkNativeOrder(OrderedMap::<c_char, int>(), c_char(3), c_char(7)))
    assert(checkNativeOrder(OrderedMap::<c_schar, int>(), c_schar(-3), c_schar(7)))
    assert(checkNativeOrder(OrderedMap::<c_uchar, int>(), c_uchar(3), c_uchar(255)))
    assert(checkNativeOrder(OrderedMap::<c_short, int>(), c_short(-32768), c_short(32767)))
    assert(checkNativeOrder(OrderedMap::<c_ushort, int>(), c_ushort(3), c_ushort(65535)))
    assert(checkNativeOrder(OrderedMap::<c_int, int>(), c_int(-2147483648), c_int(2147483647)))
    assert(checkNativeOrder(OrderedMap::<c_uint, int>(), c_uint(3), c_uint(4294967295)))
    assert(checkNativeOrder(OrderedMap::<c_long, int>(), c_long(-3), c_long(7)))
    assert(checkNativeOrder(OrderedMap::<c_ulong, int>(), c_ulong(3), c_ulong(7)))
    assert(checkNativeOrder(OrderedMap::<c_longlong, int>(), c_longlong(-3), c_longlong(7)))
    assert(checkNativeOrder(OrderedMap::<c_ulonglong, int>(), c_ulonglong(3), c_ulonglong(7)))
    assert(checkNativeOrder(OrderedMap::<c_size, int>(), c_size(3), c_size(7)))
    assert(checkNativeOrder(OrderedMap::<c_ssize, int>(), c_ssize(-3), c_ssize(7)))
    assert(checkNativeOrder(OrderedMap::<c_ptrdiff, int>(), c_ptrdiff(-3), c_ptrdiff(7)))
    assert(checkNativeOrder(OrderedMap::<c_intptr, int>(), c_intptr(-3), c_intptr(7)))
    assert(checkNativeOrder(OrderedMap::<c_uintptr, int>(), c_uintptr(3), c_uintptr(7)))
    assert(checkNativeOrder(OrderedMap::<c_bool, int>(), c_bool(false), c_bool(true)))
    assert(checkNativeOrder(OrderedMap::<c_float, int>(), c_float(-1.5), c_float(2.25)))
    assert(checkNativeOrder(OrderedMap::<c_double, int>(), c_double(-1.5), c_double(2.25)))
    assert(checkNativeOrder(OrderedMap::<c_wchar, int>(), c_wchar(3), c_wchar(7)))
    return 0
end
