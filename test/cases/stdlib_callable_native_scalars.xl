    return value
end
func(c_long) as c_long nativeSlotLong = nativeLong
var erasedLong = xcall(nativeSlotLong)
func(c_long) as c_long restoredLong = erasedLong

func nativeULong(c_ulong value) as c_ulong
    return value
end
func(c_ulong) as c_ulong nativeSlotULong = nativeULong
var erasedULong = xcall(nativeSlotULong)
func(c_ulong) as c_ulong restoredULong = erasedULong

func nativeLongLong(c_longlong value) as c_longlong
    return value
end
func(c_longlong) as c_longlong nativeSlotLongLong = nativeLongLong
var erasedLongLong = xcall(nativeSlotLongLong)
func(c_longlong) as c_longlong restoredLongLong = erasedLongLong

func nativeULongLong(c_ulonglong value) as c_ulonglong
    return value
end
func(c_ulonglong) as c_ulonglong nativeSlotULongLong = nativeULongLong
var erasedULongLong = xcall(nativeSlotULongLong)
func(c_ulonglong) as c_ulonglong restoredULongLong = erasedULongLong

func nativeSize(c_size value) as c_size
    return value
end
func(c_size) as c_size nativeSlotSize = nativeSize
var erasedSize = xcall(nativeSlotSize)
func(c_size) as c_size restoredSize = erasedSize

func nativeSSize(c_ssize value) as c_ssize
    return value
end
func(c_ssize) as c_ssize nativeSlotSSize = nativeSSize
var erasedSSize = xcall(nativeSlotSSize)
func(c_ssize) as c_ssize restoredSSize = erasedSSize

func nativePtrDiff(c_ptrdiff value) as c_ptrdiff
    return value
end
func(c_ptrdiff) as c_ptrdiff nativeSlotPtrDiff = nativePtrDiff
var erasedPtrDiff = xcall(nativeSlotPtrDiff)
func(c_ptrdiff) as c_ptrdiff restoredPtrDiff = erasedPtrDiff

func nativeIntPtr(c_intptr value) as c_intptr
    return value
end
func(c_intptr) as c_intptr nativeSlotIntPtr = nativeIntPtr
var erasedIntPtr = xcall(nativeSlotIntPtr)
func(c_intptr) as c_intptr restoredIntPtr = erasedIntPtr

func nativeUIntPtr(c_uintptr value) as c_uintptr
    return value
end
func(c_uintptr) as c_uintptr nativeSlotUIntPtr = nativeUIntPtr
var erasedUIntPtr = xcall(nativeSlotUIntPtr)
func(c_uintptr) as c_uintptr restoredUIntPtr = erasedUIntPtr

func nativeBool(c_bool value) as c_bool
    return value
end
func(c_bool) as c_bool nativeSlotBool = nativeBool
var erasedBool = xcall(nativeSlotBool)
func(c_bool) as c_bool restoredBool = erasedBool

func nativeFloat(c_float value) as c_float
    return value
end
func(c_float) as c_float nativeSlotFloat = nativeFloat
var erasedFloat = xcall(nativeSlotFloat)
func(c_float) as c_float restoredFloat = erasedFloat

