func nativeType(type value) as type
    return value
end
func(type) as type nativeSlotType = nativeType
var erasedType = xcall(nativeSlotType)
func(type) as type restoredType = erasedType

func nativeMixed(c_ulong number, type code) as (c_ulong, type, string)
    return number, code, "a\0你"
end
func(c_ulong, type) as (c_ulong, type, string) nativeSlotMIXED = nativeMixed
var erasedMixed = xcall(nativeSlotMIXED)
func(c_ulong, type) as (c_ulong, type, string) restoredMixed = erasedMixed

func checkNativeChar()
    assert(restoredChar(c_char(7)) == c_char(7))
    array<func(c_char) as c_char> slotsChar = [restoredChar]
    assert(slotsChar[0](c_char(7)) == c_char(7))
end

func checkNativeSChar()
    assert(restoredSChar(c_schar(-7)) == c_schar(-7))
    array<func(c_schar) as c_schar> slotsSChar = [restoredSChar]
    assert(slotsSChar[0](c_schar(-7)) == c_schar(-7))
end

func checkNativeUChar()
    assert(restoredUChar(c_uchar(250)) == c_uchar(250))
    array<func(c_uchar) as c_uchar> slotsUChar = [restoredUChar]
    assert(slotsUChar[0](c_uchar(250)) == c_uchar(250))
end

func checkNativeShort()
    assert(restoredShort(c_short(-32767)) == c_short(-32767))
    array<func(c_short) as c_short> slotsShort = [restoredShort]
    assert(slotsShort[0](c_short(-32767)) == c_short(-32767))
end

func checkNativeUShort()
    assert(restoredUShort(c_ushort(65535)) == c_ushort(65535))
    array<func(c_ushort) as c_ushort> slotsUShort = [restoredUShort]
    assert(slotsUShort[0](c_ushort(65535)) == c_ushort(65535))
end

func checkNativeInt()
    assert(restoredInt(c_int(-2147483647)) == c_int(-2147483647))
    array<func(c_int) as c_int> slotsInt = [restoredInt]
    assert(slotsInt[0](c_int(-2147483647)) == c_int(-2147483647))
end

func checkNativeUInt()
    assert(restoredUInt(c_uint(4294967295)) == c_uint(4294967295))
    array<func(c_uint) as c_uint> slotsUInt = [restoredUInt]
    assert(slotsUInt[0](c_uint(4294967295)) == c_uint(4294967295))
end

func checkNativeLong()
    assert(restoredLong(c_long(-7)) == c_long(-7))
    array<func(c_long) as c_long> slotsLong = [restoredLong]
    assert(slotsLong[0](c_long(-7)) == c_long(-7))
end

func checkNativeULong()
    assert(restoredULong(c_ulong(4294967295)) == c_ulong(4294967295))
    array<func(c_ulong) as c_ulong> slotsULong = [restoredULong]
    assert(slotsULong[0](c_ulong(4294967295)) == c_ulong(4294967295))
end

func checkNativeLongLong()
    assert(restoredLongLong(c_longlong(-9223372036854775807)) == c_longlong(-9223372036854775807))
    array<func(c_longlong) as c_longlong> slotsLongLong = [restoredLongLong]
    assert(slotsLongLong[0](c_longlong(-9223372036854775807)) == c_longlong(-9223372036854775807))
end

func checkNativeULongLong()
    assert(restoredULongLong(c_ulonglong(uint64(18446744073709551615))) == c_ulonglong(uint64(18446744073709551615)))
    array<func(c_ulonglong) as c_ulonglong> slotsULongLong = [restoredULongLong]
    assert(slotsULongLong[0](c_ulonglong(uint64(18446744073709551615))) == c_ulonglong(uint64(18446744073709551615)))
end

func checkNativeSize()
    assert(restoredSize(c_size(7)) == c_size(7))
    array<func(c_size) as c_size> slotsSize = [restoredSize]
    assert(slotsSize[0](c_size(7)) == c_size(7))
end

func checkNativeSSize()
    assert(restoredSSize(c_ssize(-7)) == c_ssize(-7))
    array<func(c_ssize) as c_ssize> slotsSSize = [restoredSSize]
    assert(slotsSSize[0](c_ssize(-7)) == c_ssize(-7))
end

func checkNativePtrDiff()
    assert(restoredPtrDiff(c_ptrdiff(-7)) == c_ptrdiff(-7))
    array<func(c_ptrdiff) as c_ptrdiff> slotsPtrDiff = [restoredPtrDiff]
    assert(slotsPtrDiff[0](c_ptrdiff(-7)) == c_ptrdiff(-7))
end

func checkNativeIntPtr()
    assert(restoredIntPtr(c_intptr(-7)) == c_intptr(-7))
    array<func(c_intptr) as c_intptr> slotsIntPtr = [restoredIntPtr]
    assert(slotsIntPtr[0](c_intptr(-7)) == c_intptr(-7))
end

func checkNativeUIntPtr()
    assert(restoredUIntPtr(c_uintptr(7)) == c_uintptr(7))
    array<func(c_uintptr) as c_uintptr> slotsUIntPtr = [restoredUIntPtr]
    assert(slotsUIntPtr[0](c_uintptr(7)) == c_uintptr(7))
end

func checkNativeBool()
    assert(restoredBool(c_bool(true)) == c_bool(true))
    array<func(c_bool) as c_bool> slotsBool = [restoredBool]
    assert(slotsBool[0](c_bool(true)) == c_bool(true))
end

func checkNativeFloat()
    assert(restoredFloat(c_float(1.5)) == c_float(1.5))
    array<func(c_float) as c_float> slotsFloat = [restoredFloat]
    assert(slotsFloat[0](c_float(1.5)) == c_float(1.5))
end

func checkNativeDouble()
    assert(restoredDouble(c_double(1.5)) == c_double(1.5))
    array<func(c_double) as c_double> slotsDouble = [restoredDouble]
    assert(slotsDouble[0](c_double(1.5)) == c_double(1.5))
end

func checkNativeWChar()
    assert(restoredWChar(c_wchar(65)) == c_wchar(65))
    array<func(c_wchar) as c_wchar> slotsWChar = [restoredWChar]
    assert(slotsWChar[0](c_wchar(65)) == c_wchar(65))
end

func checkNativeType()
    assert(restoredType(int) == int)
    array<func(type) as type> slotsType = [restoredType]
    assert(slotsType[0](int) == int)
end

func main(...) as int
    checkNativeChar()
    checkNativeSChar()
    checkNativeUChar()
    checkNativeShort()
    checkNativeUShort()
    checkNativeInt()
    checkNativeUInt()
    checkNativeLong()
    checkNativeULong()
    checkNativeLongLong()
    checkNativeULongLong()
    checkNativeSize()
    checkNativeSSize()
    checkNativePtrDiff()
    checkNativeIntPtr()
    checkNativeUIntPtr()
    checkNativeBool()
    checkNativeFloat()
    checkNativeDouble()
    checkNativeWChar()
    checkNativeType()
    auto number, code, text = restoredMixed(c_ulong(7), string)
    assert(number == c_ulong(7) and code == string and text == "a\0你")
    return 0
end
