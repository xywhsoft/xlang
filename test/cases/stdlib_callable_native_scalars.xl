// Closed native C profiles and type: forward erasure, reverse restoration and Array expression calls.
func nativeChar(c_char value) as c_char
    return value
end
func(c_char) as c_char nativeSlotChar = nativeChar
var erasedChar = xcall(nativeSlotChar)
func(c_char) as c_char restoredChar = erasedChar

func nativeSChar(c_schar value) as c_schar
    return value
end
func(c_schar) as c_schar nativeSlotSChar = nativeSChar
var erasedSChar = xcall(nativeSlotSChar)
func(c_schar) as c_schar restoredSChar = erasedSChar

func nativeUChar(c_uchar value) as c_uchar
    return value
end
func(c_uchar) as c_uchar nativeSlotUChar = nativeUChar
var erasedUChar = xcall(nativeSlotUChar)
func(c_uchar) as c_uchar restoredUChar = erasedUChar

func nativeShort(c_short value) as c_short
    return value
end
func(c_short) as c_short nativeSlotShort = nativeShort
var erasedShort = xcall(nativeSlotShort)
func(c_short) as c_short restoredShort = erasedShort

func nativeUShort(c_ushort value) as c_ushort
    return value
end
func(c_ushort) as c_ushort nativeSlotUShort = nativeUShort
var erasedUShort = xcall(nativeSlotUShort)
func(c_ushort) as c_ushort restoredUShort = erasedUShort

func nativeInt(c_int value) as c_int
    return value
end
func(c_int) as c_int nativeSlotInt = nativeInt
var erasedInt = xcall(nativeSlotInt)
func(c_int) as c_int restoredInt = erasedInt

func nativeUInt(c_uint value) as c_uint
    return value
end
func(c_uint) as c_uint nativeSlotUInt = nativeUInt
var erasedUInt = xcall(nativeSlotUInt)
func(c_uint) as c_uint restoredUInt = erasedUInt

