async func checkpoint() as int
    return 7
end
async func asyncProperties() as array<string>
    try
        throw ValueError "detail"
    catch ValueError error
        assert await checkpoint() == 7
        return [error.message, error.kind, error.file, error.domain, error.operation, error.data]
    end
    return []
end
func generatorProperties() as generator<string>
    try
        throw ValueError "detail"
    catch ValueError error
        yield error.message
        yield error.kind
        yield error.file
        yield error.domain
        yield error.operation
        yield error.data
    end
end
array<string> expected = ["detail", "ValueError", "", "xlang", "throw", "ValueError"]
auto actual = await asyncProperties()
assert actual.length == 6
for index in range(0, 6)
    assert actual[index] == expected[index]
end
int count = 0
for value in generatorProperties()
    assert value == expected[count]
    count += 1
end
assert count == 6
assert Pattern("/{message}").test("/" + actual[0])
