extern "c_owned_text" @no_raise func rawText() as point
extern "c_owned_release" @no_raise func release(point data)
class Reader
    func Read<T>(T value,string label) as cstring
        return cstring.take(rawText(),release)
    end
    func Factory<T>(T witness) as func(T,string) as cstring
        return self.Read
    end
end
Reader reader=Reader()
func(c_int) as func(c_int,bytes) as string invalid=reader.Factory
