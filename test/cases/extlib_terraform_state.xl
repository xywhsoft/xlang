import terraform_state

func main(...) as int
    string text = """
{
  "version": 4,
  "serial": 17,
  "lineage": "demo-lineage",
  "outputs": { "endpoint": { "value": "https://example.test", "type": "string" } },
  "resources": [
    { "type": "aws_instance", "name": "web", "instances": [ { "attributes": { "id": "i-123", "port": 443 } } ] },
    { "module": "module.edge", "mode": "data", "type": "aws_ami", "name": "latest", "instances": [ { "attributes": { "id": "ami-456" } } ] }
  ]
}
"""
    var state = terraform_state.parse(text)
    var addresses = terraform_state.addresses(state)

    assert terraform_state.valid(text), "valid state"
    assert not terraform_state.valid("[]"), "root must be object"
    assert terraform_state.version(state) == 4, "version"
    assert terraform_state.serial(state) == 17, "serial"
    assert terraform_state.lineage(state) == "demo-lineage", "lineage"
    assert addresses.length == 2, "address count"
    assert addresses[0] == "aws_instance.web", "managed address"
    assert addresses[1] == "module.edge.data.aws_ami.latest", "data address"
    assert terraform_state.find(state, "missing.resource") == null, "missing resource"
    assert terraform_state.find(state, "aws_instance.web")["type"] == "aws_instance", "resource lookup"
    assert terraform_state.instances(state, "aws_instance.web")[0]["attributes"]["id"] == "i-123", "instances"
    assert terraform_state.attributes(state, "aws_instance.web")["port"] == 443, "attributes"
    assert terraform_state.output(state, "endpoint")["value"] == "https://example.test", "output"
    assert terraform_state.output(state, "missing") == null, "missing output"
    return 0
end
