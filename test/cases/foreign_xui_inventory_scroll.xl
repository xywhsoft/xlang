import xui
from xui import CallbackDrawContext, CallbackInventorySlot, CallbackWidget, Font, Proxy, Rect, Surface

extern "fixtureRenderProxy" @header("test/cases/foreign_xui_render_backend.h") @no_raise @c_result("owned_view") @factory(0,0,dropProxy) func cpuProxy() as Proxy
extern "fixtureRenderSurface" @no_raise @c_result("owned_view") @factory(1,0,dropSurface) func cpuSurface(Proxy proxy) as Surface
extern "fixtureRenderFont" @no_raise @c_result("owned_view") @factory(1,0,dropFont) func cpuFont(Proxy proxy) as Font
extern "fixtureRenderBalanced" @no_raise func balanced() as c_int
extern "xuiProxyReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropProxy(Proxy value)
extern "xuiSurfaceReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropSurface(Surface value)
extern "xuiFontReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropFont(Font value)

func main(...) as int
    auto proxy = cpuProxy()
    auto target = cpuSurface(proxy)
    auto font = cpuFont(proxy)
    auto ui = xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
    ui.setDefaultFont(font)
    ui.setViewportSize(80,50)
    auto grid = ui.inventoryGridNative()
    auto bounds = Rect()
    bounds.fW = 80
    bounds.fH = 50
    assert grid.setRect(bounds) == 0 and ui.setRootWidget(grid) == 0
    auto layout = grid.getLayout()
    layout.iColumns = 4
    grid.setLayout(layout)
    grid.setMetrics(20,4,0,1,1)
    assert grid.setSlotCount(40) == 0 and ui.layout() == 0

    auto first = grid.scrollSnapshot()
    auto viewport = xui.scrollModelGetViewport(first)
    auto maxX, maxY = xui.scrollModelGetMaxOffset(first)
    assert viewport.fW == 80 and viewport.fH == 50 and maxX > 0 and maxY > 100, "arranged snapshot"

    int paints = 0
    grid.setSlotRenderer(func(CallbackWidget sender,c_int index,CallbackInventorySlot slot,CallbackDrawContext draw,Rect area,c_uint state) as c_int
        paints += 1
        return 0
    end)
    ui.render(target)
    int oldPaints = paints
    int oldChanges = grid.getChangeCount()
    grid.setScrollOffset(-5,64)
    ui.render(target)
    assert paints > oldPaints and grid.getChangeCount() == oldChanges + 1, "scroll invalidates the paint cache"
    auto current = grid.scrollSnapshot()
    assert current.fScrollX == 0 and current.fScrollY == 64 and first.fScrollY == 0
    auto visible = grid.getVisibleRange()
    auto drawn = grid.getLastPaintRange()
    assert drawn.iFirstSlot > 0 and drawn.iFirstSlot == visible.iFirstSlot and drawn.iLastSlot == visible.iLastSlot
    auto slotRect = grid.getSlotRect(12)
    auto world = grid.getWorldRect()
    auto hit = grid.hitTest(c_float(world.fX + slotRect.fX + 1),c_float(world.fY + slotRect.fY + 1))
    assert hit.iSlot == 12, "hit testing uses the new scroll offset"

    oldPaints = paints
    grid.setScrollOffset(0,64)
    ui.render(target)
    assert paints == oldPaints, "same offset keeps the cache"
    grid.scrollBy(10000,10000)
    current = grid.scrollSnapshot()
    assert current.fScrollX == maxX and current.fScrollY == maxY, "relative scroll clamps to extents"

    grid.setScrollOffset(0,0)
    auto region = Rect()
    region.fY = 120
    region.fW = 8
    region.fH = 12
    grid.ensureContentRectVisible(region)
    current = grid.scrollSnapshot()
    assert current.fScrollY == 82, "reveal content coordinates"
    bool rejected = false
    region.fH = -1
    try
        grid.ensureContentRectVisible(region)
    catch Error
        rejected = true
    end
    assert rejected and grid.scrollSnapshot().fScrollY == 82, "invalid rectangle does not change scroll"

    grid.setScrollOffset(0,0)
    assert ui.inputPointerWheel(6,6,0,-1,0) == 0 and ui.dispatchPendingEvents() == 0
    assert grid.scrollSnapshot().fScrollY > 0, "wheel updates the same scrolling model"
    grid.ensureSlotVisible(39)
    assert grid.getVisibleRange().iLastSlot == 39
    grid.close()
    ui.close()
    assert xui.scrollModelGetViewport(first).fH == 50 and first.fScrollY == 0, "snapshot survives close"
    font.close()
    target.close()
    proxy.close()
    assert balanced() != 0
    println("XUI_INVENTORY_SCROLL_OK")
    return 0
end
