channel<int> ch = channel::<int>(4)

bool sent = ch.send(42)
auto received, value = ch.recv()

assert sent, "channel send failed"
assert received == channelStatus.ok, "channel recv failed"
assert value != null and value == 42, "channel value mismatch"
assert ch.count() == 0, "channel count mismatch"

ch.close()
bool closed = ch.isClosed()
auto empty, absent = ch.tryRecv()

assert closed, "channel close failed"
assert empty == channelStatus.closed and absent == null, "closed channel should not receive"

auto autoCh = channel::<int>(1)
auto autoSent = autoCh.send(7)
auto autoReceived, autoValue = autoCh.recv()

assert autoSent, "auto channel send failed"
assert autoReceived == channelStatus.ok, "auto channel recv failed"
assert autoValue != null and autoValue == 7, "auto channel value mismatch"

autoCh.close()

channel<bool> boolCh = channel::<bool>(2)
assert boolCh.send(true), "bool channel send failed"
auto boolStatus, boolValue = boolCh.recv()
assert boolStatus == channelStatus.ok, "bool channel recv failed"
assert boolValue != null and boolValue == true, "bool channel value mismatch"
auto boolEmptyStatus, boolEmpty = boolCh.tryRecv()
assert boolEmptyStatus == channelStatus.empty and boolEmpty == null, "empty bool channel should not receive"

channel<var> varCh = channel::<var>(2)
assert varCh.send(123), "var channel int send failed"
assert varCh.send("abc"), "var channel string send failed"

auto varStatus, varValue = varCh.recv()
assert varStatus == channelStatus.ok, "var channel int recv failed"
assert int(varValue) == 123, "var channel int value mismatch"
auto varStringStatus, varString = varCh.recv()
assert varStringStatus == channelStatus.ok, "var channel string recv failed"
assert string(varString) == "abc", "var channel string value mismatch"
auto varEmptyStatus, varEmpty = varCh.tryRecv()
assert varEmptyStatus == channelStatus.empty and varEmpty == null, "empty var channel should not receive"
varCh.close()
assert varCh.isClosed(), "var channel close failed"

channel<float> floatCh = channel::<float>(1)
assert floatCh.send(1.5), "float channel send failed"
auto floatStatus, floatValue = floatCh.recv()
assert floatStatus == channelStatus.ok, "float channel recv failed"
assert floatValue != null and floatValue == 1.5, "float channel value mismatch"

channel<time> timeCh = channel::<time>(1)
assert timeCh.send(#12:34:56#), "time channel send failed"
auto timeStatus, timeValue = timeCh.recv()
assert timeStatus == channelStatus.ok, "time channel recv failed"
assert timeValue != null and timeValue == #12:34:56#, "time channel value mismatch"

channel<int> closedCh = channel::<int>(1)
closedCh.close()
assert not closedCh.send(1), "closed channel send should fail"

channel<int> defaultCh = channel::<int>()
assert not defaultCh.isClosed(), "default channel should start open"
assert defaultCh.send(1), "default channel first send failed"
assert defaultCh.send(2), "default channel second send failed"
assert defaultCh.count() == 2, "default channel count after send failed"

auto defaultFirstStatus, defaultFirst = defaultCh.tryRecv()
assert defaultFirstStatus == channelStatus.ok, "default channel tryRecv should drain first value"
assert defaultFirst != null and defaultFirst == 1, "default channel first value mismatch"
assert defaultCh.count() == 1, "default channel count after tryRecv failed"

defaultCh.close()
assert defaultCh.isClosed(), "default channel should report closed"

auto defaultSecondStatus, defaultSecond = defaultCh.recv()
assert defaultSecondStatus == channelStatus.ok, "closed channel should drain buffered value"
assert defaultSecond != null and defaultSecond == 2, "closed channel buffered value mismatch"
auto drainedStatus, drained = defaultCh.tryRecv()
assert drainedStatus == channelStatus.closed and drained == null, "closed drained channel should not receive"
assert not defaultCh.send(3), "closed default channel send should fail"

defaultCh.close()
assert defaultCh.isClosed(), "channel close should be idempotent"

channel<int> fullCh = channel::<int>(1)
assert fullCh.send(10), "full channel first send failed"
assert fullCh.count() == 1, "capacity-one channel must contain exactly one value"
assert not fullCh.trySend(11), "full capacity-one channel trySend should fail"

auto fullStatus, fullValue = fullCh.recv()
assert fullStatus == channelStatus.ok, "full channel receive failed"
assert fullValue != null and fullValue == 10, "full channel value mismatch"

channel<int> crossThreadCh = channel::<int>(4)
auto channelProducer = func() as int
    if not crossThreadCh.send(314) then
        return 10
    end
    if not crossThreadCh.send(159) then
        return 11
    end
    crossThreadCh.close()
    return 17
end

thread producerThread = thread(channelProducer)
assert producerThread.waitTimeout(2000), "channel producer thread wait failed"
assert producerThread.exitCode() == 17, "channel producer thread exit failed"
assert crossThreadCh.isClosed(), "cross-thread channel close should be visible"

auto crossFirstStatus, crossFirst = crossThreadCh.recv()
assert crossFirstStatus == channelStatus.ok, "cross-thread channel first recv failed"
assert crossFirst != null and crossFirst == 314, "cross-thread channel first value mismatch"
auto crossSecondStatus, crossSecond = crossThreadCh.recv()
assert crossSecondStatus == channelStatus.ok, "cross-thread channel second recv failed"
assert crossSecond != null and crossSecond == 159, "cross-thread channel second value mismatch"
auto crossClosedStatus, crossClosed = crossThreadCh.tryRecv()
assert crossClosedStatus == channelStatus.closed and crossClosed == null, "cross-thread closed drained channel should not receive"
assert not crossThreadCh.send(265), "cross-thread closed channel send should fail"

channel<int> delayedRecvCh = channel::<int>(1)
auto delayedRecvProducer = func() as int
    time.sleep(30)
    if not delayedRecvCh.send(271) then
        return 10
    end
    return 19
end

thread delayedRecvThread = thread(delayedRecvProducer)
auto delayedRecvStatus, delayedRecvValue = delayedRecvCh.recv()
assert delayedRecvStatus == channelStatus.ok, "blocking recv should wake after producer send"
assert delayedRecvValue != null and delayedRecvValue == 271, "blocking recv producer value mismatch"
assert delayedRecvThread.waitTimeout(2000), "blocking recv producer thread wait failed"
assert delayedRecvThread.exitCode() == 19, "blocking recv producer thread exit failed"
delayedRecvCh.close()
assert delayedRecvCh.isClosed(), "blocking recv channel close failed"

channel<int> delayedConsumerCh = channel::<int>(1)
auto delayedConsumer = func() as int
    auto status, got = delayedConsumerCh.recv()
    if status != channelStatus.ok or got == null then
        return 10
    end
    return got
end

thread delayedConsumerThread = thread(delayedConsumer)
time.sleep(30)
assert delayedConsumerCh.send(2718), "blocking consumer send should wake receiver thread"
assert delayedConsumerThread.waitTimeout(2000), "blocking consumer thread wait failed"
assert delayedConsumerThread.exitCode() == 2718, "blocking consumer thread exit failed"
delayedConsumerCh.close()
assert delayedConsumerCh.isClosed(), "blocking consumer channel close failed"

channel<int> nonblockingTryThreadCh = channel::<int>(1)
auto nonblockingTryConsumer = func() as int
    auto status, got = nonblockingTryThreadCh.tryRecv()
    if status == channelStatus.ok and got != null then
        return got
    end
    return 31
end

thread nonblockingTryThread = thread(nonblockingTryConsumer)
assert nonblockingTryThread.waitTimeout(2000), "nonblocking tryRecv thread wait failed"
assert nonblockingTryThread.exitCode() == 31, "empty tryRecv in thread should return empty status"
assert nonblockingTryThreadCh.send(42), "nonblocking tryRecv should leave channel usable"
auto laterStatus, nonblockingTryLater = nonblockingTryThreadCh.recv()
assert laterStatus == channelStatus.ok, "nonblocking tryRecv later recv failed"
assert nonblockingTryLater != null and nonblockingTryLater == 42, "nonblocking tryRecv later value mismatch"
nonblockingTryThreadCh.close()
assert nonblockingTryThreadCh.isClosed(), "nonblocking tryRecv channel close failed"

channel<int> timeoutCh = channel::<int>(1)
auto timeoutStatus, timeoutValue = timeoutCh.recvTimeout(10)
assert timeoutStatus == channelStatus.timeout and timeoutValue == null, "empty recvTimeout should return timeout without a value"
assert timeoutCh.send(808), "recvTimeout send setup failed"
auto timedSuccessStatus, timedSuccess = timeoutCh.recvTimeout(100)
assert timedSuccessStatus == channelStatus.ok, "recvTimeout should receive buffered value"
assert timedSuccess != null and timedSuccess == 808, "recvTimeout value mismatch"
timeoutCh.close()
auto timeoutClosedStatus, timeoutClosed = timeoutCh.recvTimeout(0)
assert timeoutClosedStatus == channelStatus.closed and timeoutClosed == null, "closed recvTimeout should return closed"

channel<int> closeWakeCh = channel::<int>(1)
auto closeWakeConsumer = func() as int
    auto status, got = closeWakeCh.recv()
    if status == channelStatus.ok and got != null then
        return got
    end
    assert status == channelStatus.closed and got == null
    return -1
end

thread closeWakeThread = thread(closeWakeConsumer)
time.sleep(30)
closeWakeCh.close()
assert closeWakeThread.waitTimeout(2000), "blocking recv should wake after channel close"
assert closeWakeThread.exitCode() == -1, "blocking recv after close should return closed"
