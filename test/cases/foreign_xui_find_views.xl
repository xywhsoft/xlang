import xui
from xui import CodeEdit,Window,CodeFindScope

extern "fixtureRenderProxy" @header("test/cases/foreign_xui_render_backend.h") @no_raise @c_result("owned_view") @factory(0,0,dropProxy) func cpuProxy() as xui.Proxy
extern "fixtureRenderFont" @header("test/cases/foreign_xui_render_backend.h") @no_raise @c_result("owned_view") @factory(1,0,dropFont) func cpuFont(xui.Proxy proxy) as xui.Font
extern "xuiProxyReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropProxy(xui.Proxy value)
extern "xuiFontReleaseChecked" @header("xge3_runtime.h") @no_raise @c_result("status",0) func dropFont(xui.Font value)
extern "fixtureRenderBudget" @header("test/cases/foreign_xui_render_backend.h") @no_raise func budget(c_int allowance)
extern "fixtureRenderBalanced" @header("test/cases/foreign_xui_render_backend.h") @no_raise func balanced() as c_int
extern "findViewsHeapBegin" @header("test/cases/foreign_xui_find_views.h") @no_raise func heapBegin()
extern "findViewsHeapEnd" @header("test/cases/foreign_xui_find_views.h") @no_raise func heapEnd(c_int expected)
extern "findViewsNativeScopeHot" @header("test/cases/foreign_xui_find_views.h") @no_raise func nativeScopeHot(xui.CodeFindScope scope,xui.Context context,xui.CodeEdit editor)
extern "findViewsSetRawScope" @header("test/cases/foreign_xui_find_views.h") @no_raise func setRawScope(xui.CodeEdit editor,c_int attached) as c_int
extern "findViewsNativeHot" @header("test/cases/foreign_xui_find_views.h") @no_raise func nativeHot(xui.CodeFindScope scope,xui.Context context,xui.CodeEdit editor,xui.Window window)

func expired(xui.Widget widget) as bool
    try
        widget.getVisible()
        return false
    catch Error
        return true
    end
end

func attachFindScope(xui.Context context,xui.CodeEdit editor) as CodeFindScope
    auto scope = xui.createCodeFindScope()
    editor.setFindScope(scope)
    auto alias = context.getCodeFindScope(editor) as CodeFindScope
    assert alias == scope
    return alias
end

func checkAssociation(xui.Context context,xui.Context other)
    auto editor = context.codeEditNative()
    assert context.getCodeFindScope(editor) == null
    auto original = attachFindScope(context,editor)
    auto target = xui.createCodeFindScope()
    try
        assert original.editorCount() == 1
        assert (context.getCodeFindScope(editor) as CodeFindScope) == original
        bool rejected = false
        try
            other.getCodeFindScope(editor)
        catch Error
            rejected = true
        end
        assert rejected

        rejected = false
        budget(0)
        try
            editor.setFindScope(target)
        catch Error
            rejected = true
        finally
            budget(-1)
        end
        assert rejected and original.editorCount() == 1 and target.editorCount() == 0
        editor.setFindScope(target)
        assert original.editorCount() == 0 and target.editorCount() == 1

        auto alias = context.getCodeFindScope(editor) as CodeFindScope
        heapBegin()
        budget(0)
        try
            for i in range(1000)
                assert (context.getCodeFindScope(editor) as CodeFindScope) == alias
            end
        finally
            budget(-1)
        end
        heapEnd(0)
        nativeScopeHot(target,context,editor)

        editor.setFindScope(null)
        assert target.editorCount() == 0 and context.getCodeFindScope(editor) == null
        editor.setFindScope(target)
        alias.close()
        assert context.getCodeFindScope(editor) == null
        rejected = false
        try
            target.editorCount()
        catch Error
            rejected = true
        end
        assert rejected

        assert setRawScope(editor,1) == xui.XUI_OK
        rejected = false
        try
            context.getCodeFindScope(editor)
        catch Error
            rejected = true
        finally
            assert setRawScope(editor,0) == xui.XUI_OK
        end
        assert rejected and context.getCodeFindScope(editor) == null
    finally
        target.close()
        original.close()
        editor.close()
    end
end

func checkLookups(xui.Context context,xui.Context other)
    auto root = context.widget()
    auto first = context.codeEditNative()
    auto second = context.codeEditNative()
    assert context.setRootWidget(root) == xui.XUI_OK
    assert root.addChild(first) == xui.XUI_OK and root.addChild(second) == xui.XUI_OK
    context.setViewportSize(800,600)
    first.setText("alpha first")
    second.setText("alpha second")
    auto scope = xui.createCodeFindScope()
    try
        scope.addEditorNamed(first,"first.xl")
        scope.addEditorNamed(second,"second.xl")
        assert scope.getEditor(context,-1) == null and scope.getEditor(context,2) == null
        assert scope.getActiveEditor(context) == null and scope.getFindWindow(context) == null
        assert scope.getResultEditor(context,0) == null

        auto kept = scope.getEditor(context,0)
        assert kept != null and (kept as CodeEdit) == first
        bool rejected = false
        try
            kept = scope.getEditor(other,0)
        catch error
            rejected = true
            assert error.code == xui.XUI_ERROR_INVALID_ARGUMENT
        end
        assert rejected and (kept as CodeEdit) == first
        assert first.openFind() == xui.XUI_OK
        assert scope.findAll("alpha") == 2
        assert (scope.getActiveEditor(context) as CodeEdit) == first
        assert (scope.getResultEditor(context,1) as CodeEdit) == second

        for mode in range(3)
            rejected = false
            try
                if mode == 0 then
                    scope.getActiveEditor(other)
                elseif mode == 1 then
                    scope.getResultEditor(other,0)
                else
                    scope.getFindWindow(other)
                end
            catch error
                rejected = true
                assert error.code == xui.XUI_ERROR_INVALID_ARGUMENT
            end
            assert rejected
        end

        xui.Window? window = null
        rejected = false
        budget(0)
        try
            window = scope.getFindWindow(context)
        catch Error
            rejected = true
        finally
            budget(-1)
        end
        assert rejected and window == null
        window = scope.getFindWindow(context)
        auto sharedWindow = window as Window
        assert sharedWindow.isOpen() == 1

        heapBegin()
        budget(0)
        try
            for i in range(1000)
                assert (scope.getEditor(context,0) as CodeEdit) == first
                assert (scope.getActiveEditor(context) as CodeEdit) == first
                assert (scope.getResultEditor(context,0) as CodeEdit) == first
                assert (scope.getFindWindow(context) as Window) == sharedWindow
            end
        finally
            budget(-1)
        end
        heapEnd(0)
        nativeHot(scope,context,first,sharedWindow)

        auto alias = scope.getResultEditor(context,1) as CodeEdit
        second.close()
        assert expired(alias) and scope.editorCount() == 1 and scope.getResultEditor(context,1) == null
        scope.close()
        assert expired(sharedWindow) and !expired(first)
        auto text = (kept as CodeEdit).getText() ?? ""
        assert text == "alpha first"
    finally
        scope.close()
    end
end

func checkContextFirst(xui.Context context,xui.Context other)
    auto target = context.codeEditNative()
    auto scope = xui.createCodeFindScope()
    try
        scope.addEditor(target)
        auto observed = scope.getEditor(context,0) as CodeEdit
        context.close()
        assert expired(observed) and scope.editorCount() == 0
        assert scope.getEditor(other,0) == null and scope.getFindWindow(other) == null
    finally
        scope.close()
    end
end

func main(...) as int
    auto proxy = cpuProxy()
    auto font = cpuFont(proxy)
    auto ui = xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
    auto other = xui.create(proxy,xui.XUI_SYSTEM_FONT_DISABLED)
    try
        ui.setDefaultFont(font)
        checkAssociation(ui,other)
        checkLookups(ui,other)
        checkContextFirst(ui,other)
    finally
        other.close()
        ui.close()
        font.close()
        proxy.close()
    end
    assert balanced() == 1
    println("XUI_FIND_VIEWS_OK")
    return 0
end
