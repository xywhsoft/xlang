import xui
from xui import ByteSlice, CallbackClipboardItems, CallbackClipboardTransfer, CallbackProxy, Context, CString

class ClipboardRoute
    Context? destination = null
end

// These contexts only publish clipboard items. Required rendering hooks
// report unsupported if reached, and the system font stays disabled.
func clipboardProxy(xui.ProxyCaps caps,xui.ProxySetClipboardItemsWithTransferProc publish) as xui.Proxy
    return xui.createCustomProxy(func(CallbackProxy backend,xui.CallbackProxyCapsOutput output) as c_int
        output.value = caps
        return c_int(0)
    end,
    clipboardSetText=func(CallbackProxy backend,CString text) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    clipboardGetText=func(CallbackProxy backend,xui.CallbackWritableBytes output) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    imeGetEnabled=func(CallbackProxy backend) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    imeSetEnabled=func(CallbackProxy backend,c_int dimension) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    imeSetCandidateRect=func(CallbackProxy backend,xui.Rect rectangle) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceCreate=func(CallbackProxy backend,xui.CallbackSurfaceOutput output,
        xui.CallbackSurfaceDesc description) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceCreateRGBA=func(CallbackProxy backend,xui.CallbackSurfaceOutput output,c_int dimension,
        c_int dimension2,xui.CallbackReadableRegion? pixels,c_uint flags) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    zstdDecompress=func(CallbackProxy backend,xui.CallbackWritableBytes output,ByteSlice input,
        xui.CallbackIntOutput outputSize) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceLoadFile=func(CallbackProxy backend,xui.CallbackSurfaceOutput output,CString text,
        c_uint flags) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceLoadMemory=func(CallbackProxy backend,xui.CallbackSurfaceOutput output,ByteSlice input,
        c_uint flags) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceUpdateRGBA=func(CallbackProxy backend,xui.CallbackSurface surface,xui.RectI rectangle,
        xui.CallbackReadableRegion pixels) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceReadRGBA=func(CallbackProxy backend,xui.CallbackSurface surface,
        xui.CallbackWritableRegion pixels) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceGetDesc=func(CallbackProxy backend,xui.CallbackSurface surface,
        xui.CallbackSurfaceDescOutput description) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceDraw=func(CallbackProxy backend,xui.CallbackSurface surface,xui.Rect rectangle,xui.Rect rectangle2,
        c_uint flags,c_uint flags2) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceClear=func(CallbackProxy backend,xui.CallbackSurface? target,c_uint flags) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceClearRect=func(CallbackProxy backend,xui.CallbackSurface? target,xui.Rect rectangle,
        c_uint flags) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceDrawTo=func(CallbackProxy backend,xui.CallbackSurface? target,xui.CallbackSurface surface,
        xui.Rect rectangle,xui.Rect rectangle2,c_uint flags,c_uint flags2) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceDrawQuad=func(CallbackProxy backend,xui.CallbackSurface surface,xui.CallbackSurfaceVertices vertices,
        c_uint flags) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceDrawQuadTo=func(CallbackProxy backend,xui.CallbackSurface? target,xui.CallbackSurface surface,
        xui.CallbackSurfaceVertices vertices,c_uint flags) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceGetSampler=func(CallbackProxy backend,xui.CallbackSurface surface,
        xui.CallbackSurfaceSamplerOutput sampler) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceSetSampler=func(CallbackProxy backend,xui.CallbackSurface surface,
        xui.CallbackSurfaceSampler sampler) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceGetGeneration=func(CallbackProxy backend,xui.CallbackSurface surface,
        xui.CallbackUIntOutput output) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    surfaceDestroy=func(CallbackProxy backend,xui.CallbackSurface surface)
        return
    end,
    shapePoint=func(CallbackProxy backend,xui.CallbackSurface? target,c_float value,c_float value2,
        c_float value3,c_uint flags) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    shapeLine=func(CallbackProxy backend,xui.CallbackSurface? target,c_float value,c_float value2,c_float value3,
        c_float value4,c_float value5,c_uint flags) as c_int
        return xui.XUI_ERROR_UNSUPPORTED
    end,
    shapeTriangleFill=func(CallbackProxy backend,xui.CallbackSurface? target,xui.Vec2 point,xui.Vec2 point2,
        xui.Vec2 point3,c_uint flags) as c_int
