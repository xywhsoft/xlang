// Exact nullable native C/type carriers; no dynamic Value boxing is involved.
// Each profile has its own lexical lifetime, avoiding a quadratic cleanup fixture.
func profile0() as bool
    Stack<c_char?> values = Stack::<c_char?>()
    assert(values.push(null) and values.push(c_char(7)))
    Stack<c_char?> copied = values.clone()
    assert(copied.equals(values))
    auto found, item = values.tryPop()
    assert(found and item != null and item == c_char(7))
    assert(values.pop() == null)
    auto absent, empty = values.tryPop()
    assert(not absent and empty == null)
    assert(copied.pop() != null and copied.pop() == null)
    return true
end

