end
func main(...) as int
 Root root=create()
 Pod config=Pod()
 config.value=c_int(7)
 assert root.pod(config,c_int(11),"end")==c_int(23)
 assert root.clearPod(c_int(11),"end")==c_int(16)
 assert root.apply(c_int(7),root,"packed",c_int(11),"end")==c_int(28)
 assert root.clear(c_int(11),"end")==c_int(16)
 func(c_int,string) as c_int bound=root.clear
 assert bound(c_int(11),"end")==c_int(16)
 Clearer clearer=root
 assert clearer.clear(c_int(11),"end")==c_int(16)
 assert root.applyBoth(c_int(7),root,"packed",c_int(9),root,"packed",c_int(11),"end")==c_int(42)
 assert root.clearFirst(c_int(9),root,"packed",c_int(11),"end")==c_int(30)
 assert freePod(config,c_int(11),"end")==c_int(18)
 assert freeClear(c_int(11),"end")==c_int(11)
 Root configured=createConfigured(c_int(3),root,"packed")
 Root defaults=createDefault()
 assert configured.clearPod(c_int(0),"end")==c_int(8)
 assert defaults.clearPod(c_int(0),"end")==c_int(5)
 configured.close()
 defaults.close()
 assert calls()==c_int(14)
 root.close()
 return 0
end
