import statistics



func main(...) as int
    // 基础聚合
    var v = [2, 4, 4, 4, 5, 5, 7, 9]
    assert statistics.count(v) == 8, "count"
    assert statistics.sum(v) == 40, "sum"
    assert statistics.mean(v) == 5, "mean"
    assert statistics.median(v) == 4.5, "median even"
    assert statistics.median([1, 2, 100]) == 2, "median odd"
    assert statistics.mode(v) == 4, "mode"
    assert statistics.min(v) == 2, "min"
    assert statistics.max(v) == 9, "max"
    assert statistics.range(v) == 7, "range"

    // 方差与标准差（教科书样本：总体方差=32/8=4）
    assert statistics.variance([1, 3]) == 1, "population variance"
    assert statistics.variance(v) == 4, "population variance textbook"
    assert statistics.varianceSample(v) == 32.0 / 7.0, "sample variance"
    assert statistics.stdev(v) == 2, "population stdev"
    var lone = [5]

    // 单元素总体方差为 0
    assert statistics.variance(lone) == 0, "single value variance"

    // 百分位数：线性插值
    var s = [1, 2, 3, 4]
    assert statistics.percentile(s, 0) == 1, "p0"
    assert statistics.percentile(s, 50) == 2.5, "p50"
    assert statistics.percentile(s, 100) == 4, "p100"
    assert statistics.percentile(s, 25) == 1.75, "p25 interpolation"
    assert statistics.percentile(s, 75) == 3.25, "p75 interpolation"

    // 四分位数与 IQR
    auto q1, q2, q3 = statistics.quartiles(s)
    assert q1 == 1.75, "q1"
    assert q2 == 2.5, "q2"
    assert q3 == 3.25, "q3"
    assert statistics.iqr(s) == 1.5, "iqr"

    // 平均绝对偏差
    assert statistics.mad([1, 3]) == 1, "mad"

    // 几何与调和平均
    assert statistics.geomean([2, 8]) == 4, "geomean"
    assert statistics.harmmean([1, 2, 4]) > 1.7 and statistics.harmmean([1, 2, 4]) < 1.8, "harmmean"

    // 协方差与相关
    var x = [1, 2, 3, 4, 5]
    var y = [2, 4, 6, 8, 10]
    assert statistics.covariance(x, y) == 4, "covariance"
    assert statistics.covarianceSample(x, y) == 5, "sample covariance"
    assert statistics.correlation(x, y) > 0.999, "perfect correlation"
    var y2 = [10, 8, 6, 4, 2]
    assert statistics.correlation(x, y2) < -0.999, "inverse correlation"

    // 最小二乘
    auto slope, intercept = statistics.linearFit(x, y)
    assert slope == 2, "fit slope"
    assert intercept == 0, "fit intercept"
    auto s2, i2 = statistics.linearFit([0, 1, 2], [1, 3, 5])
    assert s2 == 2 and i2 == 1, "fit with intercept"

    // 直方图
    var h = statistics.histogram([1, 1.9, 2, 3.9, 4], 4)
    assert int(h[0]) == 1, "histogram bin0"
    assert int(h[1]) == 2, "histogram bin1"
    assert int(h[2]) == 0, "histogram bin2"
    assert int(h[3]) == 2, "histogram bin3"

    // 错误路径
    int failures = 0
    try
        statistics.mean([])
    catch e
        failures = failures + 1
    end
    try
        statistics.mean([1, "x", 3])
    catch e
        failures = failures + 1
    end
    try
        statistics.geomean([1, -2])
    catch e
        failures = failures + 1
    end
    try
        statistics.correlation([1, 1, 1], [1, 2, 3])
    catch e
        failures = failures + 1
    end
    try
        statistics.covariance([1, 2], [1, 2, 3])
    catch e
        failures = failures + 1
    end
    assert failures == 5, "all error paths raise"

    return 0
end
