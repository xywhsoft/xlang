int methodCleanup = 0

func coreMethods(array<int> values) as int
    try
        assert(values.length == 2)
        int first = values.take(0)
        int last = values.pop()
        assert(first == 1 and last == 2 and values.length == 0)
        assert(values.push(first) and values.push(last))
        return first + last
    finally
        methodCleanup += 1
    end
end

func textMethods(array<string> values) as int
    string first = values.take(0)
    string last = values.pop()
    assert(first == "a\0你" and last == "z" and values.length == 0)
    assert(values.push(first) and values.push(last))
    return string.byteLen(first)
end

func clearMethods(array<int> values) as int
    assert(values.take(0) == 1 and values.pop() == 2)
    try
        int unused = values.pop()
        return 1
    catch RangeError failure
        assert(values.length == 0)
    end
    return 0
end

func main(...) as int
    array<int> values = [1, 2]
    var alias = values
    assert(coreMethods(values) == 3 and methodCleanup == 1 and alias.length == 2)
    array<string> texts = ["a\0你", "z"]
    assert(textMethods(texts) == 5)
    assert(clearMethods(values) == 0 and alias.length == 0)
    try
        string unused = texts.take(-1)
        return 1
    catch RangeError failure
        assert(texts.length == 2 and texts[0] == "a\0你")
    end
    list<string> entries = [7: "a\0你"]
    assert(string(entries.take(7)) == "a\0你" and entries.length == 0)
    assert(entries.take(7) == null)
    dict<string> fields = {"a\0b": "exact", "a": "prefix"}
    assert(string(fields.take("a\0b")) == "exact" and fields.length == 1)
    assert(fields.take("missing") == null and fields["a"] == "prefix")
    return 0
end
