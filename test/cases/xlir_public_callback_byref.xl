extern "xlir_public_apply" func apply(c_callback func(c_int) as c_int callback, c_int value) as c_int
extern "xlir_public_increment" func increment(int value) as int
extern "xlir_public_double" func doubleValue(int value) as int

func twice(c_int value) as c_int
    return value * 2
end

assert apply(twice, 21) == 42
int value = 40
int doubled = 0
value = increment(value)
doubled = doubleValue(value)
assert value == 41
assert doubled == 82
