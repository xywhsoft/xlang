// Checker runs this process under America/New_York; it never alters OS timezone.
auto fold = DateTime(2024, 11, 3, 1, 30, 0, 123)
assert time.fromLocal(fold, TimeFold.earlier) == time.fromUnixMs(1730611800123)
assert time.fromLocal(fold, TimeFold.later) == time.fromUnixMs(1730615400123)
auto first = time.local(time.fromUnixMs(1730611800123))
auto second = time.local(time.fromUnixMs(1730615400123))
assert first.offset == -14400 and second.offset == -18000
assert first.isDST == 1 and second.isDST == 0
assert first.hour == 1 and second.hour == 1 and first.toTime() != second.toTime()
int caught = 0
try
    time.fromLocal(fold)
catch ValueError e
    caught += 1
end
try
    time.fromLocal(DateTime(2024, 3, 10, 2, 30))
catch ValueError e
    caught += 1
end
assert caught == 2
