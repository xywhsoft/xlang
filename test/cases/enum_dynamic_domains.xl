// Offline dynamic nominal operator contracts; no network.
enum S8 as int8
 none = 0
 one = 1
 two = 2
 three = 3
end

func boxedS8(S8 value) as var
 return value
end

func checkS8()
 var a = S8.one
 var b = S8.two
 var joined = a | b
 var intersected = joined & a
 var difference = joined ^ a
 var inverted = ~a
 assert (joined as S8) == S8.three
 assert (intersected as S8) == S8.one
 assert (difference as S8) == S8.two
 assert type(joined) == type(S8.one)
 assert int8(inverted as S8) == -2
 var twice = ~inverted
 assert (twice as S8) == S8.one
 a = a | b
 assert (a as S8) == S8.three
 a = a & b
 assert (a as S8) == S8.two
 a = a ^ b
 assert (a as S8) == S8.none
 S8? maybe = S8.one
 var nullableBox = maybe
 assert ((~nullableBox) as S8) == (inverted as S8)
 array<S8> values = [S8.one, S8.two]
 for value in values
  var item = value
  var zero = item ^ item
  assert (zero as S8) == S8.none
 end
 func(S8) as var typed = boxedS8
 var erased = xcall(typed)
 var called = erased(S8.one)
 assert ((~called) as S8) == (inverted as S8)
end
checkS8()

