var first = U8.one
var other = S8.one
var ordinary = 1
int caught = 0
try
 var invalid = first | other
catch TypeError error
 caught += 1
end
try
 var invalid = first & ordinary
catch TypeError error
 caught += 1
end
try
 var invalid = first + first
catch TypeError error
 caught += 1
end
try
 var invalid = first << first
catch TypeError error
 caught += 1
end
try
 var invalid = -first
catch TypeError error
 caught += 1
end
assert caught == 5

class Holder
 U8 value = U8.one
end
auto holder = Holder()
var field = holder.value
assert uint8((~field) as U8) == 254

func sequence() as generator<var>
 yield U8.one
 yield U8.two
end
for value in sequence()
 var zero = value ^ value
 assert (zero as U8) == U8.none
end
async func produce() as var
 return U8.one
end
async func inspect() as int
 var value = await produce()
 assert uint8((~value) as U8) == 254
 return 0
end
assert await inspect() == 0
println("dynamic enum domains: all widths, nullable, array, callable, fields, generator, async and rejection ok")
