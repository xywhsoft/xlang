// RFC6979 A.2.5/A.2.6 public fixed vectors, native low-S output.
auto p256 = P256Key(b"\xc9\xaf\xa9\xd8\x45\xba\x75\x16\x6b\x5c\x21\x57\x67\xb1\xd6\x93\x4e\x50\xc3\xdb\x36\xe8\x9b\x12\x7b\x8a\x62\x2b\x12\x0f\x67\x21")
assert p256.publicKey == b"\x04\x60\xfe\xd4\xba\x25\x5a\x9d\x31\xc9\x61\xeb\x74\xc6\x35\x6d\x68\xc0\x49\xb8\x92\x3b\x61\xfa\x6c\xe6\x69\x62\x2e\x60\xf2\x9f\xb6\x79\x03\xfe\x10\x08\xb8\xbc\x99\xa4\x1a\xe9\xe9\x56\x28\xbc\x64\xf2\xf1\xb2\x0c\x2d\x7e\x9f\x51\x77\xa3\xc2\x94\xd4\x46\x22\x99"
assert p256.exportPrivate() == b"\xc9\xaf\xa9\xd8\x45\xba\x75\x16\x6b\x5c\x21\x57\x67\xb1\xd6\x93\x4e\x50\xc3\xdb\x36\xe8\x9b\x12\x7b\x8a\x62\x2b\x12\x0f\x67\x21"
assert crypto.p256PublicKey(b"\xc9\xaf\xa9\xd8\x45\xba\x75\x16\x6b\x5c\x21\x57\x67\xb1\xd6\x93\x4e\x50\xc3\xdb\x36\xe8\x9b\x12\x7b\x8a\x62\x2b\x12\x0f\x67\x21") == p256.publicKey
bytes p256_sha256 = p256.signHash(crypto.sha256("sample"),SignatureHash.sha256)
assert p256_sha256 == b"\xef\xd4\x8b\x2a\xac\xb6\xa8\xfd\x11\x40\xdd\x9c\xd4\x5e\x81\xd6\x9d\x2c\x87\x7b\x56\xaa\xf9\x91\xc3\x4d\x0e\xa8\x4e\xaf\x37\x16\x08\x34\xe3\x6a\xd2\x9a\x83\xbf\x2b\xc9\x38\x5e\x49\x1d\x60\x99\xc8\xfd\xf9\xd1\xed\x67\xaa\x7e\xa5\xf5\x1f\x93\x78\x28\x57\xa9"
assert crypto.ecdsaP256VerifyHash(p256.publicKey,crypto.sha256("sample"),p256_sha256)
bytes p256_sha256_der = p256.signHashDer(crypto.sha256("sample"),SignatureHash.sha256)
assert crypto.ecdsaP256FromDer(p256_sha256_der) == p256_sha256
assert crypto.ecdsaP256ToDer(p256_sha256) == p256_sha256_der
assert crypto.ecdsaP256VerifyHashDer(p256.publicKey,crypto.sha256("sample"),p256_sha256_der)
bytes p256_sha384 = p256.signHash(crypto.sha384("sample"),SignatureHash.sha384)
assert p256_sha384 == b"\x0e\xaf\xea\x03\x9b\x20\xe9\xb4\x23\x09\xfb\x1d\x89\xe2\x13\x05\x7c\xbf\x97\x3d\xc0\xcf\xc8\xf1\x29\xed\xdd\xc8\x00\xef\x77\x19\x48\x61\xf0\x49\x1e\x69\x98\xb9\x45\x51\x93\xe3\x4e\x7b\x0d\x28\x4d\xdd\x71\x49\xa7\x4b\x95\xb9\x26\x1f\x13\xab\xde\x94\x09\x54"
assert crypto.ecdsaP256VerifyHash(p256.publicKey,crypto.sha384("sample"),p256_sha384)
bytes p256_sha384_der = p256.signHashDer(crypto.sha384("sample"),SignatureHash.sha384)
assert crypto.ecdsaP256FromDer(p256_sha384_der) == p256_sha384
assert crypto.ecdsaP256ToDer(p256_sha384) == p256_sha384_der
assert crypto.ecdsaP256VerifyHashDer(p256.publicKey,crypto.sha384("sample"),p256_sha384_der)
bytes p256_sha512 = p256.signHash(crypto.sha512("sample"),SignatureHash.sha512)
assert p256_sha512 == b"\x84\x96\xa6\x0b\x5e\x9b\x47\xc8\x25\x48\x88\x27\xe0\x49\x5b\x0e\x3f\xa1\x09\xec\x45\x68\xfd\x3f\x8d\x10\x97\x67\x8e\xb9\x7f\x00\x23\x62\xab\x1a\xdb\xe2\xb8\xad\xf9\xcb\x9e\xda\xb7\x40\xea\x60\x49\xc0\x28\x11\x4f\x24\x60\xf9\x65\x54\xf6\x1f\xae\x33\x02\xfe"
assert crypto.ecdsaP256VerifyHash(p256.publicKey,crypto.sha512("sample"),p256_sha512)
bytes p256_sha512_der = p256.signHashDer(crypto.sha512("sample"),SignatureHash.sha512)
assert crypto.ecdsaP256FromDer(p256_sha512_der) == p256_sha512
assert crypto.ecdsaP256ToDer(p256_sha512) == p256_sha512_der
assert crypto.ecdsaP256VerifyHashDer(p256.publicKey,crypto.sha512("sample"),p256_sha512_der)
assert p256.signHash(crypto.sha256("sample")) == p256_sha256
assert p256.signHashDer(crypto.sha256("sample")) == p256_sha256_der
assert not crypto.ecdsaP256VerifyHash(p256.publicKey,crypto.sha256("different ordinary message"),p256_sha256)
assert not crypto.ecdsaP256VerifyHashDer(p256.publicKey,crypto.sha256("different ordinary message"),p256_sha256_der)
auto p256generated = crypto.p256KeyPair()
auto p256restored = P256Key(p256generated.exportPrivate())
assert p256generated.publicKey == p256restored.publicKey
assert p256.sharedSecret(p256generated.publicKey) == p256generated.sharedSecret(p256.publicKey)
assert cryptoAdvanced.p256Valid(p256.publicKey)
assert cryptoAdvanced.p256Multiply(b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01",p256.publicKey) == p256.publicKey
assert cryptoAdvanced.p256Add(p256.publicKey,p256.publicKey) == cryptoAdvanced.p256Multiply(b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02",p256.publicKey)
bytes p256copy = p256.exportPrivate()
p256copy[0] = 0
assert p256.exportPrivate() == b"\xc9\xaf\xa9\xd8\x45\xba\x75\x16\x6b\x5c\x21\x57\x67\xb1\xd6\x93\x4e\x50\xc3\xdb\x36\xe8\x9b\x12\x7b\x8a\x62\x2b\x12\x0f\x67\x21"
array<P256Key> p256owners = [p256,p256generated,p256restored]
assert p256owners[0].publicKey == p256.publicKey
auto p384 = P384Key(b"\x6b\x9d\x3d\xad\x2e\x1b\x8c\x1c\x05\xb1\x98\x75\xb6\x65\x9f\x4d\xe2\x3c\x3b\x66\x7b\xf2\x97\xba\x9a\xa4\x77\x40\x78\x71\x37\xd8\x96\xd5\x72\x4e\x4c\x70\xa8\x25\xf8\x72\xc9\xea\x60\xd2\xed\xf5")
assert p384.publicKey == b"\x04\xec\x3a\x4e\x41\x5b\x4e\x19\xa4\x56\x86\x18\x02\x9f\x42\x7f\xa5\xda\x9a\x8b\xc4\xae\x92\xe0\x2e\x06\xaa\xe5\x28\x6b\x30\x0c\x64\xde\xf8\xf0\xea\x90\x55\x86\x60\x64\xa2\x54\x51\x54\x80\xbc\x13\x80\x15\xd9\xb7\x2d\x7d\x57\x24\x4e\xa8\xef\x9a\xc0\xc6\x21\x89\x67\x08\xa5\x93\x67\xf9\xdf\xb9\xf5\x4c\xa8\x4b\x3f\x1c\x9d\xb1\x28\x8b\x23\x1c\x3a\xe0\xd4\xfe\x73\x44\xfd\x25\x33\x26\x47\x20"
assert p384.exportPrivate() == b"\x6b\x9d\x3d\xad\x2e\x1b\x8c\x1c\x05\xb1\x98\x75\xb6\x65\x9f\x4d\xe2\x3c\x3b\x66\x7b\xf2\x97\xba\x9a\xa4\x77\x40\x78\x71\x37\xd8\x96\xd5\x72\x4e\x4c\x70\xa8\x25\xf8\x72\xc9\xea\x60\xd2\xed\xf5"
assert crypto.p384PublicKey(b"\x6b\x9d\x3d\xad\x2e\x1b\x8c\x1c\x05\xb1\x98\x75\xb6\x65\x9f\x4d\xe2\x3c\x3b\x66\x7b\xf2\x97\xba\x9a\xa4\x77\x40\x78\x71\x37\xd8\x96\xd5\x72\x4e\x4c\x70\xa8\x25\xf8\x72\xc9\xea\x60\xd2\xed\xf5") == p384.publicKey
bytes p384_sha256 = p384.signHash(crypto.sha256("sample"),SignatureHash.sha256)
assert p384_sha256 == b"\x21\xb1\x3d\x1e\x01\x3c\x7f\xa1\x39\x2d\x03\xc5\xf9\x9a\xf8\xb3\x0c\x57\x0c\x6f\x98\xd4\xea\x8e\x35\x4b\x63\xa2\x1d\x3d\xaa\x33\xbd\xe1\xe8\x88\xe6\x33\x55\xd9\x2f\xa2\xb3\xc3\x6d\x8f\xb2\xcd\x0c\x55\xbb\xc0\x4e\xf8\x8b\xa4\x0b\x42\x88\x34\xc7\x6e\x98\xb9\xcd\xf9\x75\xef\x35\x98\x1c\x2b\x69\xb1\x27\x12\x4c\x65\x2e\xf3\x68\x3d\xa9\xc5\x7b\x95\xe3\x4c\x2c\x20\x93\x02\x27\xcb\x1e\xc3"
assert crypto.ecdsaP384VerifyHash(p384.publicKey,crypto.sha256("sample"),p384_sha256)
bytes p384_sha256_der = p384.signHashDer(crypto.sha256("sample"),SignatureHash.sha256)
assert crypto.ecdsaP384FromDer(p384_sha256_der) == p384_sha256
assert crypto.ecdsaP384ToDer(p384_sha256) == p384_sha256_der
assert crypto.ecdsaP384VerifyHashDer(p384.publicKey,crypto.sha256("sample"),p384_sha256_der)
bytes p384_sha384 = p384.signHash(crypto.sha384("sample"),SignatureHash.sha384)
assert p384_sha384 == b"\x94\xed\xbb\x92\xa5\xec\xb8\xaa\xd4\x73\x6e\x56\xc6\x91\x91\x6b\x3f\x88\x14\x06\x66\xce\x9f\xa7\x3d\x64\xc4\xea\x95\xad\x13\x3c\x81\xa6\x48\x15\x2e\x44\xac\xf9\x6e\x36\xdd\x1e\x80\xfa\xbe\x46\x66\x10\xb5\x14\xea\x0e\x87\x31\x5e\x01\xbf\x24\xd9\xfc\xec\x70\xec\xf1\x8b\xf5\xe6\x9d\xba\xd9\xa7\x27\xea\x30\x23\x93\x84\x8f\xb4\xf0\x4c\x6c\xd0\x42\x3f\xdc\x71\x69\x52\x50\x94\x62\x9e\xab"
assert crypto.ecdsaP384VerifyHash(p384.publicKey,crypto.sha384("sample"),p384_sha384)
bytes p384_sha384_der = p384.signHashDer(crypto.sha384("sample"),SignatureHash.sha384)
assert crypto.ecdsaP384FromDer(p384_sha384_der) == p384_sha384
assert crypto.ecdsaP384ToDer(p384_sha384) == p384_sha384_der
assert crypto.ecdsaP384VerifyHashDer(p384.publicKey,crypto.sha384("sample"),p384_sha384_der)
bytes p384_sha512 = p384.signHash(crypto.sha512("sample"),SignatureHash.sha512)
assert p384_sha512 == b"\xed\x09\x59\xd5\x88\x0a\xb2\xd8\x69\xae\x7f\x6c\x29\x15\xc6\xd6\x0f\x96\x50\x7f\x9c\xb3\xe0\x47\xc0\x04\x68\x61\xda\x4a\x79\x9c\xfe\x30\xf3\x5c\xc9\x00\x05\x6d\x7c\x99\xcd\x78\x82\x43\x37\x09\x51\x2c\x8c\xce\xee\x38\x90\xa8\x40\x58\xce\x1e\x22\xdb\xc2\x19\x8f\x42\x32\x3c\xe8\xac\xa9\x13\x53\x29\xf0\x3c\x06\x8e\x51\x12\xdc\x7c\xc3\xef\x34\x46\xde\xfc\xeb\x01\xa4\x5c\x26\x67\xfd\xd5"
assert crypto.ecdsaP384VerifyHash(p384.publicKey,crypto.sha512("sample"),p384_sha512)
bytes p384_sha512_der = p384.signHashDer(crypto.sha512("sample"),SignatureHash.sha512)
assert crypto.ecdsaP384FromDer(p384_sha512_der) == p384_sha512
assert crypto.ecdsaP384ToDer(p384_sha512) == p384_sha512_der
assert crypto.ecdsaP384VerifyHashDer(p384.publicKey,crypto.sha512("sample"),p384_sha512_der)
assert p384.signHash(crypto.sha384("sample")) == p384_sha384
assert p384.signHashDer(crypto.sha384("sample")) == p384_sha384_der
assert not crypto.ecdsaP384VerifyHash(p384.publicKey,crypto.sha384("different ordinary message"),p384_sha384)
assert not crypto.ecdsaP384VerifyHashDer(p384.publicKey,crypto.sha384("different ordinary message"),p384_sha384_der)
auto p384generated = crypto.p384KeyPair()
auto p384restored = P384Key(p384generated.exportPrivate())
assert p384generated.publicKey == p384restored.publicKey
assert p384.sharedSecret(p384generated.publicKey) == p384generated.sharedSecret(p384.publicKey)
assert cryptoAdvanced.p384Valid(p384.publicKey)
assert cryptoAdvanced.p384Multiply(b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01",p384.publicKey) == p384.publicKey
assert cryptoAdvanced.p384Add(p384.publicKey,p384.publicKey) == cryptoAdvanced.p384Multiply(b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02",p384.publicKey)
bytes p384copy = p384.exportPrivate()
p384copy[0] = 0
assert p384.exportPrivate() == b"\x6b\x9d\x3d\xad\x2e\x1b\x8c\x1c\x05\xb1\x98\x75\xb6\x65\x9f\x4d\xe2\x3c\x3b\x66\x7b\xf2\x97\xba\x9a\xa4\x77\x40\x78\x71\x37\xd8\x96\xd5\x72\x4e\x4c\x70\xa8\x25\xf8\x72\xc9\xea\x60\xd2\xed\xf5"
array<P384Key> p384owners = [p384,p384generated,p384restored]
assert p384owners[0].publicKey == p384.publicKey
int rejected = 0
try
    P256Key(b"short")
catch e
    rejected += 1
end
try
    P384Key(b"short")
catch e
    rejected += 1
end
try
    p256.signHash(b"short")
catch e
    rejected += 1
end
try
    p384.signHash(b"short")
catch e
    rejected += 1
end
try
    p256.sharedSecret(b"short")
catch e
    rejected += 1
end
try
    crypto.ecdsaP384VerifyHash(p384.publicKey,b"",p384_sha384)
catch e
    rejected += 1
end
assert rejected == 6
println("managed P256/P384 ECDH, RFC6979 and raw/DER signatures: ok")
