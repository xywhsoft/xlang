extern "SpanRoot*" class Root @header("test/cases/foreign_callback_span.h") @lifetime("owned") @policy("spanRootPolicy") @scope("SpanCall")
 native point handle
 extern "xl6ForeignViewCloseV1" @no_raise @c_control(0) @c_result("bool_status") func close()
end
extern "const xbytesview*" class Slice @header("test/cases/foreign_callback_span.h") @lifetime("callback") @owner(Root)
 native point handle
 extern "Size" @c_field get size() as c_size
end
typedef TextHandler = func(Slice,c_int) as string
typedef OptionalTextHandler = func(Slice,c_int) as string?
extern "span_create" @no_raise @c_result("owned_view") @factory(0,0,rollback) func create() as Root
extern "span_destroy" @no_raise func rollback(Root root)
extern "span_set_text" @no_raise @c_owned_callback(1,0,"SpanOwner",0,"owned_text") @c_callback_span(1,0,"const unsigned char*","size_t") func on(Root root,TextHandler? callback)
extern "span_set_optional_text" @no_raise @c_owned_callback(1,0,"SpanOwner",0,"last","owned_text") @c_callback_span(1,0,"const unsigned char*","size_t") func onOptional(Root root,OptionalTextHandler? callback)
extern "span_fire_text" @no_raise func fire(Root root,c_int mode) as c_int
extern "span_fail_end_once" @no_raise func failEnd()
extern "span_text_fail_after" @no_raise func failAfter(c_int count)
extern "span_text_reset" @no_raise func resetFailure()
extern "span_text_heap_begin" @no_raise func heapBegin()
extern "span_text_heap_end" @no_raise func heapEnd()
extern "span_text_counts_begin" @no_raise func countsBegin()
extern "span_text_counts_end" @no_raise func countsEnd(c_int count)
extern "span_live" @no_raise func live() as c_int
func cases()
 Root root=create()
 on(root,func(Slice input,c_int mode) as string
  assert input.size==3
  if mode==1
   return ""
  elseif mode==3
   return "你"
  elseif mode==4
   failEnd()
  elseif mode==5
   throw "text callback failure"
  elseif mode==7
   failAfter(0)
  end
  return "a\0b"
 end)
 assert fire(root,0)==3 and fire(root,1)==0 and fire(root,3)==3
 int mode=4
 while mode<6
  bool rejected=false
  try
   auto result=fire(root,c_int(mode))
  catch error
   rejected=true
  end
  assert rejected
  mode+=1
 end
 bool allocationFailed=false
 try
  auto result=fire(root,7)
 catch error
  allocationFailed=true
 finally
  resetFailure()
 end
 assert allocationFailed
 onOptional(root,func(Slice input,c_int mode) as string?
  assert input.size==3
  if mode==2
   return null
  elseif mode==1
   return ""
  end
  return "a\0b"
 end)
 assert fire(root,2)==0 and fire(root,1)==0 and fire(root,0)==3
 onOptional(root,null)
 root.close()
end
func warm()
 Root root=create()
 on(root,func(Slice input,c_int mode) as string
  assert input.size==3 and mode==0
  return "a\0b"
 end)
 assert fire(root,0)==3
 countsBegin()
 int count=0
 while count<100
  assert fire(root,0)==3
  count+=1
 end
 countsEnd(100)
 string retained="a\0b"
 on(root,func(Slice input,c_int mode) as string
  assert input.size==3 and mode==0
  return retained
 end)
 assert fire(root,0)==3
 countsBegin()
 count=0
 while count<100
  assert fire(root,0)==3
  count+=1
 end
 countsEnd(100)
 assert retained=="a\0b"
 on(root,null)
 root.close()
end
func closing()
 Root root=create()
 on(root,func(Slice input,c_int mode) as string
  assert input.size==3 and mode==0
  root.close()
  return "a\0b"
 end)
 assert fire(root,0)==3
end
func main(...) as int
 cases()
 warm()
 closing()
 heapBegin()
 cases()
 warm()
 closing()
 heapEnd()
 assert live()==0
 return 0
end
