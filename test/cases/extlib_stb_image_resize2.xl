import stb_image
import stb_image_resize2

func main(...) as int
    stb_image.StbImage source = stb_image.load("release/examples/extlibs/assets/tiny.png", 4)
    Buffer output = stb_image_resize2.resize(source.pixels(),
        source.width(), source.height(), source.channels(), 3, 5)
    assert stb_image_resize2.available()
    assert output.len() == 3 * 5 * 4
    return 0
end
