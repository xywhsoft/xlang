// Compile every async overload; never run this function or an OS error queue.
export "udp_async_surface" func surface(UdpSocket socket, CancellationToken cancel)
    auto zero = uint64(0)
    socket.recvAsync()
    socket.recvAsyncCancel(cancel)
    socket.recvAsyncUntil(zero)
    socket.recvAsyncUntilCancel(zero, cancel)
    socket.recvAsyncTimeout(0)
    socket.recvAsyncTimeoutCancel(cancel, 0)
    socket.recvErrorAsync()
    socket.recvErrorAsyncCancel(cancel)
    socket.recvErrorAsyncUntil(zero)
    socket.recvErrorAsyncUntilCancel(zero, cancel)
    socket.recvErrorAsyncTimeout(0)
    socket.recvErrorAsyncTimeoutCancel(cancel, 0)
    socket.recvBatchAsync(4)
    socket.recvBatchAsyncCancel(cancel, 4)
    socket.recvBatchAsyncUntil(zero, 4)
    socket.recvBatchAsyncUntilCancel(zero, cancel, 4)
    socket.recvBatchAsyncTimeout(4, 0)
    socket.recvBatchAsyncTimeoutCancel(cancel, 4, 0)
    socket.waitAsync(UdpWait.open)
    socket.waitAsyncCancel(cancel, UdpWait.open)
    socket.waitAsyncUntil(zero, UdpWait.open)
    socket.waitAsyncUntilCancel(zero, cancel, UdpWait.open)
    socket.waitAsyncTimeout(UdpWait.open, 0)
    socket.waitAsyncTimeoutCancel(cancel, UdpWait.open, 0)
    socket.waitWritableAsync(0)
    socket.waitWritableAsyncCancel(cancel, 0)
    socket.waitWritableAsyncUntil(zero, 0)
    socket.waitWritableAsyncUntilCancel(zero, cancel, 0)
    socket.waitWritableAsyncTimeout(0, 0)
    socket.waitWritableAsyncTimeoutCancel(cancel, 0, 0)
end
println("UDP async surface: ok")
