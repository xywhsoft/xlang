class ParamModeBox
    int value

    create(int value)
        self.value = value
    end

end

func mutate(ParamModeBox box)
    box.value = 20
end

func mutateCopy(ParamModeBox box)
    box.value = 30
end

func rebindLocal(ParamModeBox box)
    box = ParamModeBox(35)
end

func replace(ParamModeBox box) as ParamModeBox
    ParamModeBox next = ParamModeBox(40)
    return next
end

func writeValue() as int
    return 50
end

ParamModeBox box = ParamModeBox(10)
mutate(box)
assert box.value == 20

mutateCopy(box)
assert box.value == 30

rebindLocal(box)
assert box.value == 30

box = replace(box)
assert box.value == 40

int value = writeValue()
assert value == 50
