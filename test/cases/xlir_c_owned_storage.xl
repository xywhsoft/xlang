extern "c_owned_text" @no_raise func nativeText() as point
extern "c_owned_number" @no_raise func nativeNumber() as point
extern "c_owned_binary" @no_raise func nativeBytes() as point
extern "c_owned_release" @no_raise func nativeFree(point data)

func check()
    cstring text = cstring.take(nativeText(), nativeFree)
    cbytes data = cbytes.take(nativeBytes(), 4, nativeFree)
    cstring number = cstring.take(nativeNumber(), nativeFree)
    assert int(number) == 42 and float64(number) == 42.0
    array<string> texts = [text]
    array<bytes> binaries = [data]
    texts.push(text)
    binaries.push(data)
    assert texts[0] == "hello" and texts[1] == "hello"
    assert binaries[0][1] == 255 and binaries[1][3] == 42
end
check()
