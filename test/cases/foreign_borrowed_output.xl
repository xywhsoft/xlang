extern "borrowed_fail_after" @header("test/cases/foreign_borrowed_output.h") @no_raise func failAfter(c_int count)
extern "managed_reset_failure" @header("test/cases/foreign_borrowed_output.h") @no_raise func resetFailure()
protocol Query
 func query(c_int mode) as Child
end
func check(Child child)
 assert child.value==c_int(17)
end
func allocationFailures()
 int accepted=0
 int rejected=0
 for budget in range(64)
  auto root=create()
  root.seed()
  auto before=destroys()
  failAfter(c_int(budget))
  try
   auto view=root.query()
   resetFailure()
   check(view)
   accepted+=1
  catch error
   rejected+=1
  finally
   resetFailure()
  end
  // Failed language admission must never destroy a borrowed native child.
  assert destroys()==before and roots()==c_int(1) and children()==c_int(1)
  check(root.query())
  root.close()
  assert roots()==c_int(0) and children()==c_int(0)
 end
 assert accepted>0 and rejected>0
end
func keptChild() as Child
 auto root=create()
 root.seed()
 return root.query()
end
func retainedOwner()
 auto child=keptChild()
 check(child)
 assert roots()==c_int(1) and children()==c_int(1)
 auto root=child.owner()
 root.close()
 assert roots()==c_int(0) and children()==c_int(0)
 bool failed=false
 try
  check(child)
 catch error
  failed=true
 end
 assert failed
end
func main(...) as int
 allocationFailures()
 retainedOwner()
 auto root=create()
 root.seed()
 auto kept=root.query()
 check(kept)
 assert kept.owner()==root
 check(root.first)
 check(root.readVoid())
 check(root.fromBytes(b"a\0b"))
 assert root.optional(2)==null
 auto watchBefore=watches()
 auto destroyBefore=destroys()
 bool failed=false
 try
  kept=root.query(1)
 catch error
  failed=true
  assert error.code==-17 and error.operation=="borrowed_status"
 end
 assert failed and watches()==watchBefore and destroys()==destroyBefore
 check(kept)
 failed=false
 try
  kept=root.query(2)
 catch error
  failed=true
 end
 assert failed and destroys()==destroyBefore
 check(kept)
 func(c_int) as Child bound=root.query
 func(c_int,Root) as Child freeValue=freeQuery
 Query through=root
 auto source=reader()
 func(Root) as Child fieldBound=source.read
 check(bound(0))
 check(freeValue(0,root))
 check(through.query(0))
 check(fieldBound(root))
 auto before=calls()
 countersBegin()
 for i in range(200)
  check(root.query())
  check(bound(0))
  check(through.query(0))
  check(freeValue(0,root))
  check(fieldBound(root))
 end
 countersEnd()
 assert calls()==before+c_uint(1000) and destroys()==destroyBefore
 failed=false
 try
  auto invalid=root.construct(1)
 catch error
  failed=true
 end
 assert failed and children()==c_int(1) and destroys()==destroyBefore+c_uint(1)
 failed=false
 try
  kept=root.query(3)
 catch error
  failed=true
  assert error.code==-17
 end
 assert failed and roots()==c_int(0) and children()==c_int(0)
 root.close()
 println("Borrowed owner outputs: direct, nullable, void, getter, span, bound/free/field/protocol; no native transfer or hot allocations")
 return 0
end
export func borrowedOutputSelfTest() as int
 assert main()==0
 return 73
end
