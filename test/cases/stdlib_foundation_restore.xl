class FoundationRestoreChild
    derive value
    derive clone
    dict<string> words = {"a\0你": "original\0"}
    dict<string> alias = {}
end
FoundationRestoreChild foundationSharedChild = FoundationRestoreChild()
foundationSharedChild.alias = foundationSharedChild.words
class FoundationRestoreRoot
    derive value
    FoundationRestoreChild child = foundationSharedChild
    array<int8> narrow = []
    array<uint32> unsigned = []
    dict<float32> reals = {}
    dict<char> letters = {}
    dict<bool> switches = {}
    dict<var> erased = {}
end
func main(...)
    auto result = json.parse::<FoundationRestoreRoot>("{\"child\":{\"words\":{\"a\\u0000你\":\"restored\\u0000\"}},\"narrow\":[-128,127],\"unsigned\":[0,4294967295],\"reals\":{\"value\":1.5},\"letters\":{\"han\":20320},\"switches\":{\"yes\":true},\"erased\":{\"s\":\"a\\u0000你\",\"n\":42}}")
    assert result.child.words["a\0你"] == "restored\0"
    assert result.child.alias["a\0你"] == "original\0"
    assert foundationSharedChild.words["a\0你"] == "original\0"
    assert result.narrow[0] == int8(-128) and result.narrow[1] == int8(127)
    assert result.unsigned[1] == uint32(4294967295)
    assert result.reals["value"] == float32(1.5)
    assert result.letters["han"] == '你' and result.switches["yes"]
    assert (result.erased["s"] as string) == "a\0你"
    assert int(result.erased["n"]) == 42
end
