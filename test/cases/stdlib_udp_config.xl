auto original = UdpConfig()
assert(original.receiveSize == 2048)
assert(original.receiveConcurrency == 1)
assert(original.receiveBatch == 16)
assert(original.overflow == UdpOverflow.dropNewest)
assert(original.truncation == UdpTruncation.deliver)
assert(original.receiveMetadata == NetDatagramMetadata.none)
auto config = original.withReceive(4096, 2, 32).withReceiveQueue(128, 65536, UdpOverflow.dropOldest)
config = config.withReceiveMetadata(NetDatagramMetadata.destination | NetDatagramMetadata.interfaceIndex)
config = config.withTruncation(UdpTruncation.drop).withSendQueue(4096, 1024, 8192, 32).withSendConcurrency(2)
config = config.withSocketBuffers(65536, 8192).withTraffic(64, 32).withPathMtuMode(NetPathMtuMode.discover)
config = config.withBinding(false, false, false, true).withBroadcast(true)
config = config.withErrorQueue(true, 512, 16, 32768, UdpOverflow.dropOldest)
assert(original.receiveSize == 2048)
assert(config.receiveSize == 4096 and config.receiveConcurrency == 2 and config.receiveBatch == 32)
assert(config.receiveQueueLimit == 128 and config.receiveQueueByteLimit == 65536)
assert(config.overflow == UdpOverflow.dropOldest and config.truncation == UdpTruncation.drop)
assert(config.receiveMetadata == (NetDatagramMetadata.destination | NetDatagramMetadata.interfaceIndex))
assert(config.sendHighWater == 4096 and config.sendLowWater == 1024 and config.sendLimit == 8192)
assert(config.sendPacketLimit == 32 and config.sendConcurrency == 2)
assert(config.receiveBuffer == 65536 and config.sendBuffer == 8192)
assert(config.hopLimit == 64 and config.trafficClass == 32 and config.pathMtuMode == NetPathMtuMode.discover)
assert(not config.reuseAddress and not config.reusePort and not config.exclusiveAddress)
assert(config.broadcast and config.ipv6Only and config.receiveErrors)
assert(config.errorSize == 512 and config.errorQueueLimit == 16 and config.errorQueueByteLimit == 32768)
assert(config.errorOverflow == UdpOverflow.dropOldest)
auto viaNamespace = udp.config()
assert(viaNamespace.receiveSize == original.receiveSize)
println("UDP configuration public values OK")
