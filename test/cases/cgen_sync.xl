mutex m = mutex()
bool locked = m.lock()
bool unlocked = m.unlock()
bool tryLocked = m.tryLock()
bool tryUnlocked = m.unlock()

assert locked, "mutex lock failed"
assert unlocked, "mutex unlock failed"
assert tryLocked, "mutex tryLock failed"
assert tryUnlocked, "mutex try unlock failed"

sem gate = sem(0, 2)
bool posted = gate.post()
bool waited = gate.waitTimeout(10)
bool empty = gate.tryWait()
bool postedMany = gate.postMultiple(2)
bool waited1 = gate.waitTimeout(10)
bool waited2 = gate.waitTimeout(10)

assert posted, "sem post failed"
assert waited, "sem waitTimeout failed"
assert not empty, "sem should be empty"
assert postedMany, "sem postMultiple failed"
assert waited1, "sem wait 1 failed"
assert waited2, "sem wait 2 failed"

sem capped = sem(1, 2)
bool cappedOverflow = capped.postMultiple(2)
bool cappedOriginal = capped.waitTimeout(10)
bool cappedPartial = capped.tryWait()

assert not cappedOverflow, "sem postMultiple overflow should fail"
assert cappedOriginal, "sem postMultiple overflow should keep original count"
assert not cappedPartial, "sem postMultiple overflow should not partially post"

sem full = sem(1, 1)
bool fullPost = full.post()
bool fullWaited = full.waitTimeout(10)
bool refillPost = full.post()
bool refillWaited = full.waitTimeout(10)

assert not fullPost, "sem post on full semaphore should fail"
assert fullWaited, "sem full original wait failed"
assert refillPost, "sem post after drain failed"
assert refillWaited, "sem refill wait failed"

sem semWakeGate = sem(0, 1)
auto semWakeWorker = func() as int
    if not semWakeGate.waitTimeout(2000) then
        return 10
    end
    return 23
end

thread semWakeThread = thread(semWakeWorker)
assert not semWakeThread.waitTimeout(1), "sem worker should wait before post"
assert semWakeGate.post(), "sem cross-thread post failed"
assert semWakeThread.waitTimeout(2000), "sem cross-thread wait thread failed"
assert semWakeThread.exitCode() == 23, "sem cross-thread worker exit failed"

cond c = cond()
bool signaled = c.signal()
bool broadcasted = c.broadcast()

assert signaled, "cond signal failed"
assert broadcasted, "cond broadcast failed"

mutex condMutex = mutex()
assert condMutex.lock(), "cond waitTimeout mutex lock failed"
bool condTimed = c.waitTimeout(condMutex, 1)
assert not condTimed, "cond waitTimeout should return false on timeout"
assert condMutex.unlock(), "cond waitTimeout mutex unlock failed"

cond wakeCond = cond()
mutex wakeMutex = mutex()
sem wakeReady = sem(0, 1)
auto wakeWorker = func() as int
    if not wakeReady.waitTimeout(2000) then
        return 10
    end
    time.sleep(20)
    if not wakeMutex.lock() then
        return 11
    end
    if not wakeCond.signal() then
        wakeMutex.unlock()
        return 12
    end
    if not wakeMutex.unlock() then
        return 13
    end
    return 17
end

thread wakeThread = thread(wakeWorker)
assert wakeMutex.lock(), "cond cross-thread mutex lock failed"
assert wakeReady.post(), "cond cross-thread ready post failed"
bool wakeSignaled = wakeCond.waitTimeout(wakeMutex, 2000)
assert wakeSignaled, "cond cross-thread waitTimeout should be signaled"
assert wakeMutex.unlock(), "cond cross-thread mutex unlock failed"
assert wakeThread.wait(), "cond cross-thread worker wait failed"
assert wakeThread.exitCode() == 17, "cond cross-thread worker exit failed"

rwlock rw = rwlock()
bool readLocked = rw.readLock()
bool readUnlocked = rw.readUnlock()
bool tryReadLocked = rw.tryReadLock()
bool tryReadUnlocked = rw.readUnlock()
bool writeLocked = rw.writeLock()
bool downgraded = rw.downgrade()
bool readUnlocked2 = rw.readUnlock()
bool tryWriteLocked = rw.tryWriteLock()
bool writeUnlocked = rw.writeUnlock()

assert readLocked, "rwlock readLock failed"
assert readUnlocked, "rwlock readUnlock failed"
assert tryReadLocked, "rwlock tryReadLock failed"
assert tryReadUnlocked, "rwlock tryReadUnlock failed"
assert writeLocked, "rwlock writeLock failed"
assert downgraded, "rwlock downgrade failed"
assert readUnlocked2, "rwlock downgraded readUnlock failed"
assert tryWriteLocked, "rwlock tryWriteLock failed"
assert writeUnlocked, "rwlock writeUnlock failed"

rwlock upgradeRw = rwlock()
bool invalidUpgrade = upgradeRw.upgrade()
assert not invalidUpgrade, "rwlock upgrade without read lock should fail"
assert upgradeRw.readLock(), "rwlock upgrade readLock failed"
bool upgraded = upgradeRw.upgrade()
assert upgraded, "rwlock upgrade failed"
assert upgradeRw.writeUnlock(), "rwlock upgraded writeUnlock failed"

rwlock capturedRw = rwlock()
auto capturedRwWorker = func() as int
    if not capturedRw.writeLock() then
        return 10
    end
    if not capturedRw.downgrade() then
        capturedRw.writeUnlock()
        return 11
    end
    if not capturedRw.readUnlock() then
        return 12
    end
    return 29
end

thread capturedRwThread = thread(capturedRwWorker)
assert capturedRwThread.waitTimeout(2000), "captured rwlock worker wait failed"
assert capturedRwThread.exitCode() == 29, "captured rwlock worker exit failed"
assert capturedRw.tryWriteLock(), "captured rwlock should be unlocked after worker"
assert capturedRw.writeUnlock(), "captured rwlock final writeUnlock failed"

auto am = mutex()
auto autoLocked = am.lock()
auto autoUnlocked = am.unlock()

assert autoLocked, "auto mutex lock failed"
assert autoUnlocked, "auto mutex unlock failed"

func probeLocalDefaultSync() as int
    mutex localMutex
    if not localMutex.lock() then return 10 end
    if not localMutex.unlock() then return 11 end

    rwlock localRw
    if not localRw.writeLock() then return 12 end
    if not localRw.writeUnlock() then return 13 end

    sem localSem
    if localSem.tryWait() then return 14 end
    if not localSem.post() then return 15 end
    if not localSem.waitTimeout(10) then return 16 end

    cond localCond
    if not localCond.signal() then return 17 end
    return 0
end

assert probeLocalDefaultSync() == 0, "local default sync handles failed"

mutex defaultMutex
assert defaultMutex.lock(), "default mutex lock failed"
assert defaultMutex.unlock(), "default mutex unlock failed"
assert defaultMutex.tryLock(), "default mutex tryLock failed"
assert defaultMutex.unlock(), "default mutex tryUnlock failed"

sem defaultSem
assert not defaultSem.tryWait(), "default sem should start empty"
assert defaultSem.post(), "default sem post failed"
assert defaultSem.waitTimeout(10), "default sem wait failed"

cond defaultCond
assert defaultCond.signal(), "default cond signal failed"
assert defaultCond.broadcast(), "default cond broadcast failed"

rwlock defaultRw
assert defaultRw.readLock(), "default rwlock readLock failed"
assert defaultRw.readUnlock(), "default rwlock readUnlock failed"
assert defaultRw.writeLock(), "default rwlock writeLock failed"
assert defaultRw.writeUnlock(), "default rwlock writeUnlock failed"
