import xui
from xui import ListSelectionBuffer

extern "fixtureRenderBudget" @header("test/cases/foreign_xui_render_backend.h") @no_raise func budget(c_int count)

func main(...) as int
    auto proxy = xui.createProxy()
    auto ui = xui.create(proxy, xui.XUI_SYSTEM_FONT_DISABLED)
    auto buffer = xui.createListSelectionBuffer(4)
    ListSelectionBuffer? retained = null
    try
        auto list = ui.listViewNative()
        auto other = ui.listViewNative()
        list.setItems(["One", "Two", "Three"])
        list.setSelectionMode(xui.XUI_SELECTION_MULTI)
        list.setItemSelected(1, 1)
        list.setSelectionBuffer(buffer)
        list.setSelectionBuffer(buffer)
        assert buffer.capacity() == 4 and buffer.get(1) == 1 and buffer.get(3) == 0

        bool failed = false
        try
            other.setSelectionBuffer(buffer)
        catch Error
            failed = true
        end
        assert failed and other.selectionBuffer() == null

        auto shared = list.selectionBuffer() as ListSelectionBuffer
        retained = shared
        buffer.close()
        list.setItemSelected(2, 1)
        assert shared.get(2) == 1
        auto worker = thread(func() as int
            try
                auto value = shared.get(2)
            catch Error
                return 1
            end
            return 0
        end)
        assert worker.waitTimeout(30000) and worker.exitCode() == 1

        failed = false
        try
            auto outside = shared.get(4)
        catch Error
            failed = true
        end
        assert failed
        failed = false
        try
            list.setItems(["One", "Two", "Three", "Four", "Five"])
        catch Error
            failed = true
        end
        assert failed and list.getItemCount() == 3 and shared.get(2) == 1
        list.setItems(["One", "Two"])
        assert shared.get(2) == 0
        list.setItems(["One", "Two", "Three", "Four"])
        assert shared.get(2) == 0 and shared.get(1) == 1

        failed = false
        budget(0)
        try
            list.setSelectionBuffer(null)
        catch Error
            failed = true
        finally
            budget(-1)
        end
        assert failed and list.selectionBuffer() != null and shared.get(1) == 1
        list.setSelectionBuffer(null)
        assert list.selectionBuffer() == null and list.isItemSelected(1) == 1
        list.setItemSelected(1, 0)
        assert shared.get(1) == 1
        list.setItemSelected(0, 1)
        list.setSelectionBuffer(shared)
        assert shared.get(0) == 1 and shared.get(1) == 0
    finally
        ui.close()
        proxy.close()
    end
    auto detached = retained as ListSelectionBuffer
    assert detached.get(0) == 1 and detached.get(1) == 0
    detached.close()
    println("XUI_LIST_SELECTION_BUFFER_OK")
    return 0
end
