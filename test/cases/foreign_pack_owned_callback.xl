typedef ValueCallback=func(c_int) as c_int
typedef NoticeCallback=func(c_int)
extern "gp_install" @header("test/cases/foreign_pack_owned_callback.h") @no_raise @c_result("status",0) @c_pack(0,"GpDesc",0,3) @c_pack_callback_group(0,"user",1) @c_pack_field(0,"value",0,"owned_callback") @c_pack_field(0,"notice",1,"owned_callback") @c_pack_field(0,"seed",2,"value") @c_owned_callback(0,-1,"GpOwner",-111) @c_owned_callback(1,-1,"GpOwner",0,"first") func install(ValueCallback? value,NoticeCallback? notice,c_int seed)
extern "GpRoot*" class Root @header("test/cases/foreign_pack_owned_callback.h") @lifetime("owned") @policy("gpPolicy")
 native point handle
 extern "install" @c_field_call @no_raise @c_result("status",0) @c_pack(1,"GpDesc",0,3) @c_pack_callback_group(1,"user",2) @c_pack_field(1,"value",0,"owned_callback") @c_pack_field(1,"notice",1,"owned_callback") @c_pack_field(1,"seed",2,"value") @c_owned_callback(0,-1,"GpOwner",-111) @c_owned_callback(1,-1,"GpOwner",0,"first") func install(ValueCallback? value,NoticeCallback? notice,c_int seed)
 extern "xl6ForeignViewCloseV1" @no_raise @c_control(0) @c_result("bool_status") func close()
end
protocol Installer
 func install(ValueCallback? value,NoticeCallback? notice,c_int seed)
end
extern "gp_root" @header("test/cases/foreign_pack_owned_callback.h") @no_raise @c_result("owned_view") @factory(0,0,dropRoot) func root() as Root
extern "gp_root_drop" @header("test/cases/foreign_pack_owned_callback.h") @no_raise func dropRoot(Root value)
extern "gp_two" @header("test/cases/foreign_pack_owned_callback.h") @no_raise @c_result("integer_min",0) @c_pack(0,"GpDesc",0,3) @c_pack_callback_group(0,"user",1) @c_pack_field(0,"value",0,"owned_callback") @c_pack_field(0,"notice",1,"owned_callback") @c_pack_field(0,"seed",2,"value") @c_owned_callback(0,-1,"GpOwner",-111) @c_owned_callback(1,-1,"GpOwner",0,"first") @c_pack(2,"GpDesc",3,3) @c_pack_callback_group(2,"user",3) @c_pack_field(2,"value",3,"owned_callback") @c_pack_field(2,"notice",4,"owned_callback") @c_pack_field(2,"seed",5,"value") @c_owned_callback(3,-1,"GpOwner",-111) @c_owned_callback(4,-1,"GpOwner",0,"first") func two(ValueCallback? a,NoticeCallback? an,c_int seedA,ValueCallback? b,NoticeCallback? bn,c_int seedB) as c_int
extern "gp_nested" @header("test/cases/foreign_pack_owned_callback.h") @no_raise @c_result("status",0) @c_pack(0,"GpNested",0,3) @c_pack_record(0,"inner","GpDesc") @c_pack_callback_group(0,"inner.user",1) @c_pack_field(0,"inner.value",0,"owned_callback") @c_pack_field(0,"inner.notice",1,"owned_callback") @c_pack_field(0,"inner.seed",2,"value") @c_owned_callback(0,-1,"GpOwner",-111) @c_owned_callback(1,-1,"GpOwner",0,"first") func nested(ValueCallback? value,NoticeCallback? notice,c_int seed)
extern "gp_reject" @header("test/cases/foreign_pack_owned_callback.h") @no_raise @c_result("owned_view") @factory(1,0,dropRoot) @c_pack(0,"GpDesc",0,3) @c_pack_callback_group(0,"user",2) @c_pack_field(0,"value",0,"owned_callback") @c_pack_field(0,"notice",1,"owned_callback") @c_pack_field(0,"seed",2,"value") @c_owned_callback(0,-1,"GpOwner",-111) @c_owned_callback(1,-1,"GpOwner",0,"first") func rejectFactory(ValueCallback? value,NoticeCallback? notice,c_int seed) as Root
extern "gp_failure_roots" @header("test/cases/foreign_pack_owned_callback.h") @no_raise func failureRoots() as c_int
extern "gp_dispatch" @header("test/cases/foreign_pack_owned_callback.h") @no_raise @c_result("integer_min",0) func dispatch(c_int value) as c_int
extern "gp_clear" @header("test/cases/foreign_pack_owned_callback.h") @no_raise @c_result("status",0) func clear()
extern "gp_installs" @header("test/cases/foreign_pack_owned_callback.h") @no_raise func installs() as c_int
extern "gp_active" @header("test/cases/foreign_pack_owned_callback.h") @no_raise func active() as c_int
extern "gp_fail_after" @header("test/cases/foreign_pack_owned_callback.h") @no_raise func failAfter(c_int n)
extern "gp_fail_reset" @header("test/cases/foreign_pack_owned_callback.h") @no_raise func failReset() as c_int
extern "gp_heap" @header("test/cases/foreign_pack_owned_callback.h") @no_raise @c_outputs(0,1,2,3,4) func heap() as (c_size,c_size,uint64,uint64,uint64)
extern "xrtMemDebugEnabled" @header("xrt_decl.h") @no_raise func debugEnabled() as bool
func plus(c_int value) as c_int
 return value+c_int(5)
end
func notice(c_int value)
 assert value>=c_int(0)
end
func oomSweep()
 ValueCallback value=plus
 NoticeCallback observe=notice
 int failures=0
 for step in range(24)
  auto before=installs()
  bool rejected=false
  failAfter(c_int(step))
  try
   install(value,observe,c_int(1))
  catch error
   rejected=true
  end
  auto triggered=failReset()
  if rejected then
   failures+=1
   assert active()==c_int(0) and installs()==before
  else
   assert active()==c_int(1) and dispatch(c_int(2))==c_int(8)
   clear()
  end
 end
 assert failures>0 and failures<24
 install(value,observe,c_int(1))
 assert dispatch(c_int(2))==c_int(8)
 auto live,bytes,allocs,frees,reallocs=heap()
 int turn=0
 while turn<1000
  assert dispatch(c_int(2))==c_int(8)
  turn+=1
 end
 auto live2,bytes2,allocs2,frees2,reallocs2=heap()
 assert allocs==allocs2 and frees==frees2 and reallocs==reallocs2
 clear()
 println("PACK_GROUP_OOM_OK hotAlloc=0")
end
func main(...) as int
 clear()
 c_int observed=c_int(0)
 install(plus,func(c_int value)
  observed+=value
 end,c_int(7))
 assert dispatch(c_int(3))==c_int(15) and observed==c_int(3)
 clear()
 install(null,null,c_int(9))
 assert active()==c_int(1) and dispatch(c_int(4))==c_int(9)
 clear()
 assert two(plus,null,c_int(1),plus,null,c_int(2))==c_int(18)
 nested(plus,null,c_int(3))
 assert dispatch(c_int(4))==c_int(12)
 clear()
 bool factoryRejected=false
 try
  auto unused=rejectFactory(plus,null,c_int(0))
 catch error
  factoryRejected=true
 end
 assert factoryRejected and failureRoots()==c_int(0)
 auto handle=root()
 handle.install(plus,null,c_int(2))
 assert dispatch(c_int(1))==c_int(8)
 clear()
 func(ValueCallback?,NoticeCallback?,c_int) bound=handle.install
 bound(plus,null,c_int(3))
 assert dispatch(c_int(2))==c_int(10)
 clear()
 Installer virtual=handle
 virtual.install(plus,null,c_int(4))
 assert dispatch(c_int(3))==c_int(12)
 clear()
 install(func(c_int value) as c_int
  clear()
  return value+c_int(8)
 end,func(c_int value)
  observed+=value
 end,c_int(1))
 assert dispatch(c_int(5))==c_int(14) and active()==c_int(0)
 assert observed==c_int(8), "the snapshot survives clearing from the first callback"
 install(func(c_int value) as c_int
  assert false, "group callback error"
  return value
 end,null,c_int(0))
 bool rejected=false
 try
  auto unused=dispatch(c_int(1))
 catch error
  rejected=true
 end
 assert rejected
 clear()
 install(plus,func(c_int value)
  assert false, "void group callback error"
 end,c_int(0))
 rejected=false
 try
  auto unused=dispatch(c_int(1))
 catch error
  rejected=true
 end
 assert rejected
 clear()
 handle.close()
 if debugEnabled() then
  oomSweep()
  auto beforeLive,beforeBytes,beforeAlloc,beforeFree,beforeRealloc=heap()
  oomSweep()
  auto afterLive,afterBytes,afterAlloc,afterFree,afterRealloc=heap()
  assert beforeLive==afterLive and beforeBytes==afterBytes, "repeat OOM sweep retains no allocations"
 end
 println("PACK_OWNED_CALLBACK_OK")
 return 0
end
