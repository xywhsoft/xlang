import procps



func main(...) as int
    // Current process
    auto mypid = procps.pid()
    assert mypid > 0, "pid > 0"

    // Parent process
    auto ppid = procps.ppid()
    assert ppid >= 0, "ppid >= 0"

    // Self exists
    assert procps.exists(mypid), "self exists"

    // Fake PID doesn't exist
    assert not procps.exists(999999), "fake pid not exists"

    // Process name
    auto nm = procps.name(mypid)
    assert string.len(nm) > 0, "name non-empty"

    // Process count
    auto cnt = procps.count()
    assert cnt >= 1, "at least 1 process"

    // 快照以整数数组返回，并包含当前进程。
    array<int> ids = procps.pids()
    bool found = false
    for processId in ids
        if processId == mypid then found = true end
    end
    assert found, "self in pid snapshot"

    return 0
end
