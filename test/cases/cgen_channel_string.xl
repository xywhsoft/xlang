channel<string> textCh = channel::<string>(4)

string source = "hello"
assert textCh.send(source), "string channel send failed"
source = "changed"

auto receivedStatus, received = textCh.recv()
assert receivedStatus == channelStatus.ok, "string channel recv failed"
assert received != null and received == "hello", "string channel must copy the sent value"

assert textCh.trySend("你好"), "UTF-8 string channel send failed"
auto unicodeStatus, unicodeText = textCh.tryRecv()
assert unicodeStatus == channelStatus.ok, "UTF-8 string channel recv failed"
assert unicodeText != null and unicodeText == "你好", "UTF-8 string channel value mismatch"

assert textCh.send("a\0b"), "embedded-NUL string channel send failed"
auto binaryStatus, binaryText = textCh.recv()
assert binaryStatus == channelStatus.ok and binaryText != null, "embedded-NUL string channel recv failed"
if binaryText != null then
    assert string.byteLen(binaryText) == 3, "channel must preserve full byte length"
    assert string.byteAt(binaryText, 2) == 98, "channel must preserve bytes after NUL"
end

assert textCh.send("before close"), "buffered string send failed"
textCh.close()
auto bufferedStatus, buffered = textCh.recv()
assert bufferedStatus == channelStatus.ok, "closed string channel must drain buffered value"
assert buffered != null and buffered == "before close", "closed string channel buffered value mismatch"
auto drainedStatus, drained = textCh.tryRecv()
assert drainedStatus == channelStatus.closed and drained == null, "drained string channel should be closed"
assert not textCh.send("after close"), "closed string channel send should fail"

// 留下一条未消费消息，验证作用域清理会释放消息 box。
channel<string> pendingCh = channel::<string>(2)
assert pendingCh.send("pending"), "pending string send failed"

channel<string> timeoutTextCh = channel::<string>(1)
auto timeoutStatus, timeoutText = timeoutTextCh.recvTimeout(1)
assert timeoutStatus == channelStatus.timeout and timeoutText == null, "empty string recvTimeout should return timeout and no value"
assert timeoutTextCh.send("waited"), "string recvTimeout send setup failed"
auto timedStatus, timedText = timeoutTextCh.recvTimeout(100)
assert timedStatus == channelStatus.ok, "string recvTimeout should receive"
assert timedText != null and timedText == "waited", "string recvTimeout value mismatch"
timeoutTextCh.close()
auto closedStatus, closedText = timeoutTextCh.recvTimeout(0)
assert closedStatus == channelStatus.closed and closedText == null, "closed string recvTimeout should return closed and no value"

println("channel string ok")
