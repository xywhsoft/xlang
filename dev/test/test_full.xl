// xlang DEMO 测试脚本 - 完整功能演示
// 这个脚本演示了 xlang 支持的所有基本功能

// ========== 1. 变量和数据类型 ==========
print("===== 1. 变量和数据类型 =====")

var a = 10
var b = 3.14
var c = "Hello"
var d = true
var e = null

print("整数:", a)
print("浮点数:", b)
print("字符串:", c)
print("布尔值:", d)
print("空值:", e)

// ========== 2. 算术运算 ==========
print("")
print("===== 2. 算术运算 =====")

print("10 + 3 =", 10 + 3)
print("10 - 3 =", 10 - 3)
print("10 * 3 =", 10 * 3)
print("10 / 3 =", 10 / 3)
print("10 % 3 =", 10 % 3)
print("2 ** 10 =", 2 ** 10)

// ========== 3. 比较和逻辑运算 ==========
print("")
print("===== 3. 比较和逻辑运算 =====")

print("10 > 5:", 10 > 5)
print("10 < 5:", 10 < 5)
print("10 == 10:", 10 == 10)
print("10 != 5:", 10 != 5)
print("true and false:", true and false)
print("true or false:", true or false)
print("not true:", not true)

// ========== 4. 字符串操作 ==========
print("")
print("===== 4. 字符串操作 =====")

var s1 = "Hello"
var s2 = "World"
print("字符串连接:", s1 + " " + s2 + "!")
print("字符串长度:", len(s1))

// ========== 5. 条件语句 ==========
print("")
print("===== 5. 条件语句 =====")

var x = 15
if x > 10
    print("x 大于 10")
elseif x > 5
    print("x 大于 5 但不大于 10")
else
    print("x 不大于 5")
end

// 单行 if
if x > 0 then print("x 是正数")

// ========== 6. 循环语句 ==========
print("")
print("===== 6. 循环语句 =====")

// for 循环
print("for 循环 (1 到 5):")
for i = 1 to 5
    print("  i =", i)
end

// for 循环带 step
print("for 循环带 step (10 到 2, step -2):")
for i = 10 to 2 step -2
    print("  i =", i)
end

// while 循环
print("while 循环:")
var n = 1
while n <= 3
    print("  n =", n)
    n = n + 1
end

// break 和 continue
print("break 和 continue 测试:")
for i = 1 to 10
    if i == 3
        continue
    end
    if i == 6
        break
    end
    print("  i =", i)
end

// ========== 7. 函数 ==========
print("")
print("===== 7. 函数 ==========")

// 定义函数
function greet(name)
    print("Hello,", name + "!")
end

function add(a, b)
    return a + b
end

function factorial(n)
    if n <= 1
        return 1
    end
    return n * factorial(n - 1)
end

// 调用函数
greet("xlang")
print("add(3, 5) =", add(3, 5))
print("factorial(5) =", factorial(5))

// ========== 8. 数组 ==========
print("")
print("===== 8. 数组 ==========")

var arr = [1, 2, 3, 4, 5]
print("数组:", arr)
print("数组长度:", len(arr))
print("arr[0] =", arr[0])
print("arr[2] =", arr[2])

// 修改数组元素
arr[0] = 100
print("修改后 arr[0] =", arr[0])

// ========== 9. 表 (Table) ==========
print("")
print("===== 9. 表 (Table) ==========")

var tbl = {name = "xlang", version = 1, demo = true}
print("表:", tbl)
print("tbl.name =", tbl.name)
print("tbl.version =", tbl.version)

// 修改表成员
tbl.author = "xLeaves"
print("添加 tbl.author =", tbl.author)

// ========== 10. 类型转换 ==========
print("")
print("===== 10. 类型转换 =====")

print("str(123) =", str(123))
print("int(\"456\") =", int("456"))
print("float(\"3.14\") =", float("3.14"))
print("type(123) =", type(123))
print("type(\"hello\") =", type("hello"))
print("type([1,2,3]) =", type([1,2,3]))

// ========== 完成 ==========
print("")
print("===== 测试完成 =====")
print("xlang DEMO 运行成功！")
