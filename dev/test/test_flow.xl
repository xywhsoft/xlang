// Test control flow and functions
print("=== If-else test ===")
var x = 10
if x > 5
    print("x > 5")
end

print("=== For loop test ===")
for i = 1 to 3
    print(i)
end

print("=== While loop test ===")
var n = 1
while n <= 3
    print(n)
    n = n + 1
end

print("=== Function test ===")
function add(a, b)
    return a + b
end

print(add(3, 5))

print("=== Array test ===")
var arr = [10, 20, 30]
print(arr[0])
print(arr[1])
print(len(arr))

print("=== Done ===")
