// xlang DEMO - Basic Test
print("=== xlang Demo ===")

// 1. Print and arithmetic
print("1. Arithmetic:")
print(1 + 2)
print(10 - 3)
print(4 * 5)
print(15 / 3)

// 2. Variables
print("2. Variables:")
var x = 10
var y = 20
print(x)
print(y)
print(x + y)

// 3. Strings
print("3. Strings:")
print("Hello" + " " + "World")

// 4. Boolean
print("4. Boolean:")
print(true)
print(false)
print(1 < 2)
print(3 > 5)

print("=== Done ===")