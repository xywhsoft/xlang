// 测试字面量功能

println("=== 整数字面量 ===")
// 十进制
var dec = 255
println("十进制 255 = " + string(dec))

// 十六进制 (0x)
var hex1 = 0xFF
println("十六进制 0xFF = " + string(hex1))

// 十六进制 (&H)
var hex2 = &HFF
println("十六进制 &HFF = " + string(hex2))

// 二进制 (0b)
var bin1 = 0b11111111
println("二进制 0b11111111 = " + string(bin1))

// 二进制 (&B)
var bin2 = &B11111111
println("二进制 &B11111111 = " + string(bin2))

// 八进制 (&O)
var oct1 = &O377
println("八进制 &O377 = " + string(oct1))

var oct2 = &o17
println("八进制 &o17 = " + string(oct2))

println("")
println("=== 浮点数字面量 ===")
var f1 = 3.14159
println("浮点数 3.14159 = " + string(f1))

var f2 = 1.5e10
println("科学计数法 1.5e10 = " + string(f2))

println("")
println("=== 字符串字面量 ===")
// 双引号字符串（支持转义）
var s1 = "Hello\tWorld\n"
println("双引号字符串: " + s1)

// 单引号字符串（不支持转义）
var s2 = 'Hello\tWorld'
println("单引号字符串: " + s2)

// 多行字符串
var s3 = """这是
多行
字符串"""
println("多行字符串: " + s3)

println("")
println("=== 模板字符串 ===")
var name = "张三"
var age = 25
var msg = `姓名: {$name}, 年龄: {$age}`
println(msg)

var greeting = `Hello {$name}!`
println(greeting)

// 纯文本模板（无变量）
var plain = `这是纯文本模板`
println(plain)

println("")
println("=== 时间字面量 ===")
var t1 = #2024-01-15
println("日期: " + string(t1))

var t2 = #2024-01-15T10:30:00
println("日期时间: " + string(t2))

println("")
println("=== 集合字面量 ===")
// 数组
var arr = [1, 2, 3, 4, 5]
println("数组长度: " + string(len(arr)))

// 字典
var tbl = {name: "Tom", age: 30}
println("字典[name]: " + tbl["name"])

// 列表
var lst = [0: "零", 1: "一", 2: "二"]
println("列表[1]: " + lst[1])

println("")
println("=== 布尔和 null ===")
var b1 = true
var b2 = false
var n = null
println("true = " + string(b1))
println("false = " + string(b2))
println("null = " + string(n))

println("")
println("=== 测试完成 ===")
