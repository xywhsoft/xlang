// 迭代器测试

println("=== Iterator Test ===")

class Range
	var start = 0
	var stop = 0
	var current = 0
	
	create(start, stop)
		self.start = start
		self.stop = stop
	end
	
	meta iter()
		self.current = self.start
		return self
	end
	
	meta next()
		if self.current >= self.stop then
			return null
		end
		var val = self.current
		self.current = self.current + 1
		return val
	end
end

print("Range(1, 5): ")
for v in new Range(1, 5)
	print(string(v) + " ")
end
println("")

println("=== Done ===")
