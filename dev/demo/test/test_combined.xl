// 组合测试 - 多个类

println("=== Combined Test ===")

class Vec2
	var x = 0
	var y = 0
	
	create(x, y)
		self.x = x
		self.y = y
	end
	
	meta add(other)
		return new Vec2(self.x + other.x, self.y + other.y)
	end
	
	meta to(t)
		if t == "string" then
			return "Vec2(" + string(self.x) + ", " + string(self.y) + ")"
		end
		return null
	end
end

class Range
	var start = 0
	var stop = 0
	var current = 0
	
	create(start, stop)
		self.start = start
		self.stop = stop
	end
	
	meta iter()
		self.current = self.start
		return self
	end
	
	meta next()
		if self.current >= self.stop then
			return null
		end
		var val = self.current
		self.current = self.current + 1
		return val
	end
end

println("--- Vec2 ---")
var v1 = new Vec2(1, 2)
var v2 = new Vec2(3, 4)
var v3 = v1 + v2
println("v1 + v2 = " + string(v3))

println("--- Range ---")
for v in new Range(1, 4)
	print(string(v) + " ")
end
println("")

println("=== Done ===")
