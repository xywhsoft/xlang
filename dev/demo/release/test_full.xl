// xlang 第三版 Demo 综合测试

// 测试函数定义和调用
function factorial(n)
	if n <= 1 then
		return 1
	end
	return n * factorial(n - 1)
end

function fibonacci(n)
	if n <= 1 then
		return n
	end
	return fibonacci(n - 1) + fibonacci(n - 2)
end

// 测试变量和基本运算
var a = 5
var b = 3
var sum = a + b
var diff = a - b
var prod = a * b

println(sum)
println(diff)
println(prod)

// 测试条件语句
if a > b then
	println(a)
else
	println(b)
end

// 测试循环
var total = 0
for i in range(1, 5)
	total = total + i
end
println(total)

// 测试函数调用
var fact5 = factorial(5)
println(fact5)

var fib10 = fibonacci(10)
println(fib10)

// 测试数组
var arr = [10, 20, 30]
println(arr)

// 完成
println("All tests passed!")
