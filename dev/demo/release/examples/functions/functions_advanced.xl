// functions_advanced.xl
// 演示函数的高级特性

// 1. 变量作用域
print("1. 变量作用域")

var iGlobal = 100  // 全局变量

func testScope() {
    var iLocal = 200  // 局部变量
    print("函数内访问全局变量 iGlobal:", iGlobal)
    print("函数内访问局部变量 iLocal:", iLocal)
    
    // 内部函数访问外部函数变量
    func innerTest() {
        var iInner = 300  // 内部函数局部变量
        print("内部函数访问外部函数变量 iLocal:", iLocal)
        print("内部函数访问全局变量 iGlobal:", iGlobal)
        print("内部函数访问内部变量 iInner:", iInner)
    }
    
    innerTest()
}

testScope()
// print(iLocal)  // 错误：iLocal 是局部变量，函数外部无法访问
print("函数外访问全局变量 iGlobal:", iGlobal)
print("")

// 2. 闭包
print("2. 闭包")

func createCounter() {
    var iCount = 0
    
    return func() {
        iCount++
        return iCount
    }
}

var procCounter1 = createCounter()
var procCounter2 = createCounter()

print("计数器1第一次调用:", procCounter1())
print("计数器1第二次调用:", procCounter1())
print("计数器1第三次调用:", procCounter1())
print("")

print("计数器2第一次调用:", procCounter2())
print("计数器2第二次调用:", procCounter2())
print("")

// 3. 闭包修改外部变量
print("3. 闭包修改外部变量")

func createAccumulator(initial = 0) {
    var iTotal = initial
    
    return func(addend) {
        iTotal += addend
        return iTotal
    }
}

var procAccumulator = createAccumulator(10)
print("累加器初始值 10")
print("累加 5:", procAccumulator(5))
print("累加 3:", procAccumulator(3))
print("累加 7:", procAccumulator(7))
print("")

// 4. 立即执行函数表达式 (IIFE)
print("4. 立即执行函数表达式 (IIFE)")

var iResult = (func(x, y) {
    return x * y
})(5, 6)

print("IIFE 结果:", iResult)
print("")

// 5. 函数重载（通过参数类型判断）
print("5. 函数重载（通过参数类型判断）")

func processValue(value) {
    switch type(value) {
        case "number":
            return value * 2
        case "string":
            return value + value
        case "array":
            return len(value)
        case "bool":
            return !value
        default:
            return "未知类型"
    }
}

print("processValue(5):", processValue(5))
print("processValue(\"xlang\"):", processValue("xlang"))
print("processValue([1, 2, 3]):", processValue([1, 2, 3]))
print("processValue(true):", processValue(true))
print("")

// 6. 高阶函数
print("6. 高阶函数")

// 高阶函数：接收一个函数并返回一个新函数
func createMultiplier(factor) {
    return func(x) {
        return x * factor
    }
}

var procDouble = createMultiplier(2)
var procTriple = createMultiplier(3)

print("procDouble(5):", procDouble(5))
print("procTriple(5):", procTriple(5))
print("")

// 7. map 高阶函数实现
print("7. map 高阶函数实现")

func mapArray(arr, transform) {
    var arrResult = []
    for var item in arr {
        push(arrResult, transform(item))
    }
    return arrResult
}

var arrNumbers = [1, 2, 3, 4, 5]
var arrDoubled = mapArray(arrNumbers, func(x) { return x * 2 })
var arrSquared = mapArray(arrNumbers, func(x) { return x * x })

print("原数组:", arrNumbers)
print("翻倍后:", arrDoubled)
print("平方后:", arrSquared)
print("")

// 8. filter 高阶函数实现
print("8. filter 高阶函数实现")

func filterArray(arr, predicate) {
    var arrResult = []
    for var item in arr {
        if predicate(item) {
            push(arrResult, item)
        }
    }
    return arrResult
}

var arrFiltered = filterArray(arrNumbers, func(x) { return x % 2 == 0 })
var arrGreaterThan3 = filterArray(arrNumbers, func(x) { return x > 3 })

print("原数组:", arrNumbers)
print("偶数:", arrFiltered)
print("大于3的数:", arrGreaterThan3)
print("")

// 9. reduce 高阶函数实现
print("9. reduce 高阶函数实现")

func reduceArray(arr, reducer, initialValue) {
    var iResult = initialValue
    for var item in arr {
        iResult = reducer(iResult, item)
    }
    return iResult
}

var iSum = reduceArray(arrNumbers, func(acc, curr) { return acc + curr }, 0)
var iProduct = reduceArray(arrNumbers, func(acc, curr) { return acc * curr }, 1)

print("原数组:", arrNumbers)
print("总和:", iSum)
print("乘积:", iProduct)

// 10. 函数柯里化
print("\n10. 函数柯里化")

func curryAdd(a) {
    return func(b) {
        return func(c) {
            return a + b + c
        }
    }
}

print("curryAdd(1)(2)(3):", curryAdd(1)(2)(3))

var add5 = curryAdd(5)
var add5and3 = add5(3)
print("add5and3(4):", add5and3(4))