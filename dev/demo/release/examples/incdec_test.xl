// 使用支持的语法测试自增自减

// 前缀自增
var a = 5
print("前缀 ++a:")
print(a)
var r1 = ++a
print(a)
print(r1)

// 后缀自增
var b = 5
print("后缀 b++:")
print(b)
var r2 = b++
print(b)
print(r2)

// 前缀自减
var c = 10
print("前缀 --c:")
print(c)
var r3 = --c
print(c)
print(r3)

// 后缀自减
var d = 10
print("后缀 d--:")
print(d)
var r4 = d--
print(d)
print(r4)

// while 循环中使用
print("while 循环:")
var i = 0
while i < 5 do
	print(i)
	i++
end
