// ============================================================
// 测试 019: 表达式优先级
// 测试运算符优先级
// ============================================================

println("测试 019: 表达式优先级")

// 乘法优先于加法
println(2 + 3 * 4)

// 括号改变优先级
println((2 + 3) * 4)

// 除法与乘法同级
println(12 / 3 * 2)

// 复杂表达式
println(1 + 2 * 3 - 4 / 2)

// 嵌套括号
println(((1 + 2) * 3) - 4)

// 负数与乘法
println(-2 * 3)
println(2 * -3)

// 比较与算术
var result = 2 + 3 > 4
println(result)

// 逻辑与比较
var a = 10
var b = 20
var c = 30
println((a < b) and (b < c))
println((a > b) or (b < c))

// 复合条件
println((1 + 1 == 2) and (2 * 2 == 4))

// 完成
println("测试 019 通过")
