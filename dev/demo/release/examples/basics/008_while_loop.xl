// while loop test
println("Test 008: while loop")

// basic while loop
var i = 1
while i <= 5 do
	println(i)
	i = i + 1
end

// accumulate
var sum = 0
var n = 1
while n <= 10 do
	sum = sum + n
	n = n + 1
end
println(sum)

// condition false, not execute
var x = 10
while x < 5 do
	println("should not print")
	x = x + 1
end
println("skipped")

// nested while
var a = 1
while a <= 3 do
	var b = 1
	while b <= 3 do
		print(a * b)
		print(" ")
		b = b + 1
	end
	println("")
	a = a + 1
end

// complex condition
var count = 0
var limit = 5
while (count < limit) and (count >= 0) do
	count = count + 1
end
println(count)

// done
println("Test 008 passed")
