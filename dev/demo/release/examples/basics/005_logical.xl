// ============================================================
// 测试 005: 逻辑运算符
// 测试 and or not 逻辑运算
// ============================================================

println("测试 005: 逻辑运算符")

var t = true
var f = false

// and 运算
println(t and t)
println(t and f)
println(f and t)
println(f and f)

// or 运算
println(t or t)
println(t or f)
println(f or t)
println(f or f)

// not 运算
println(not t)
println(not f)

// 组合运算
println((t and f) or t)
println(t and (f or t))
println(not (t and f))
println(not t or not f)

// 与比较结合
var a = 10
var b = 20
println((a > 5) and (b > 10))
println((a > 15) or (b > 15))
println(not (a > 15))

// 短路求值测试
var x = 5
println((x > 0) or (x / 0 > 0))
println((x < 0) and (x / 0 > 0))

// 完成
println("测试 005 通过")
