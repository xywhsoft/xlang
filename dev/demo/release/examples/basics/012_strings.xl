// ============================================================
// 测试 012: 字符串操作
// 测试字符串字面量和连接
// ============================================================

println("测试 012: 字符串操作")

// 基本字符串
var s1 = "hello"
var s2 = "world"
println(s1)
println(s2)

// 空字符串
var empty = ""
println(empty)
println(len(empty))

// 字符串长度
println(len(s1))
println(len("abcdef"))

// 包含空格
var s3 = "hello world"
println(s3)
println(len(s3))

// 包含中文
var s4 = "你好世界"
println(s4)

// 转义字符
var s5 = "line1\nline2"
println(s5)

var s6 = "tab\there"
println(s6)

// 引号
var s7 = "say \"hello\""
println(s7)

// 完成
println("测试 012 通过")
