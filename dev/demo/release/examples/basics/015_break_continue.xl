// ============================================================
// 测试 015: break 和 continue
// 测试循环控制语句
// ============================================================

println("测试 015: break 和 continue")

// for 循环中的 break
println("break test:")
for i in range(1, 10)
	if i > 5 then
		break
	end
	println(i)
end

// for 循环中的 continue
println("continue test:")
for i in range(1, 10)
	if i % 2 == 0 then
		continue
	end
	println(i)
end

// while 循环中的 break
println("while break:")
var j = 0
while j < 100 do
	j = j + 1
	if j > 3 then
		break
	end
	println(j)
end

// while 循环中的 continue
println("while continue:")
var k = 0
while k < 10 do
	k = k + 1
	if k % 2 == 0 then
		continue
	end
	println(k)
end

// break n 测试（跳出多层循环）
println("break 2 test:")
var outer = 0
while outer < 3 do
	outer = outer + 1
	var inner = 0
	while inner < 3 do
		inner = inner + 1
		if inner == 2 then
			break 2
		end
		println(outer)
		println(inner)
	end
end
println("after break 2")

// 完成
println("测试 015 通过")
