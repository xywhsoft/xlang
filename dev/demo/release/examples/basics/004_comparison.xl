// ============================================================
// 测试 004: 比较运算符
// 测试 > < >= <= == != 比较运算
// ============================================================

println("测试 004: 比较运算符")

var a = 10
var b = 20
var c = 10

// 大于
println(a > b)
println(b > a)

// 小于
println(a < b)
println(b < a)

// 大于等于
println(a >= b)
println(a >= c)
println(b >= a)

// 小于等于
println(a <= b)
println(a <= c)
println(b <= a)

// 等于
println(a == c)
println(a == b)

// 不等于
println(a != b)
println(a != c)

// 字符串比较
var s1 = "abc"
var s2 = "abc"
var s3 = "def"
println(s1 == s2)
println(s1 == s3)
println(s1 != s3)

// 边界：与零比较
println(a > 0)
println(0 < a)
println(0 == 0)

// 完成
println("测试 004 通过")
