// ============================================================
// 测试 013: 类型函数
// 测试类型转换和 type() 函数
// ============================================================

println("测试 013: 类型函数")

// type() 获取类型
var i = 42
println(type(i))

var f = 3.14
println(type(f))

var s = "hello"
println(type(s))

var b = true
println(type(b))

var arr = [1, 2, 3]
println(type(arr))

// 字面量类型
println(type(123))
println(type(3.14))
println(type("test"))
println(type(true))
println(type(false))

// 完成
println("测试 013 通过")
