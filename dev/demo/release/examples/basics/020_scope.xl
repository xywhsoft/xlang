// ============================================================
// 测试 020: 函数作用域
// 测试函数内变量作用域
// ============================================================

println("测试 020: 函数作用域")

// 局部变量
function localTest()
	var localVar = 200
	println(localVar)
end

localTest()

// 参数作用域
function paramTest(param)
	println(param)
	param = param + 1
	println(param)
end

var original = 50
paramTest(original)
println(original)

// 同名局部变量
function shadowTest()
	var shadowVar = 2
	println(shadowVar)
end

shadowTest()

// 多函数调用
function funcA()
	return 10
end

function funcB()
	return funcA() + 20
end

function funcC()
	return funcB() + 30
end

println(funcC())

// 嵌套函数调用
function outer(x)
	return inner(x + 1)
end

function inner(y)
	return y * 2
end

println(outer(5))

// 完成
println("测试 020 通过")
