// list_types.xl
// 演示列表类型操作
// 注意: 列表是键值对结构，使用 [key: value] 语法

println("=== 列表类型测试 ===")

// 1. 使用数组模拟列表行为
println("")
println("1. 数组作为有序集合")
var items = ["first", "second", "third"]
println("items[0] = " + items[0])
println("items[1] = " + items[1])
println("items[2] = " + items[2])
println("长度: " + len(items))

// 2. 数组遍历
println("")
println("2. 数组遍历")
for v in items
	println("值: " + v)
end

// 3. 数组索引访问
println("")
println("3. 数组索引访问")
var nums = [10, 20, 30, 40, 50]
println("正向索引:")
println("nums[0] = " + nums[0])
println("nums[2] = " + nums[2])
println("负向索引:")
println("nums[-1] = " + nums[-1])
println("nums[-2] = " + nums[-2])

// 4. 混合值类型数组
println("")
println("4. 混合值类型数组")
var mixed = [100, "text", true, 3.14]
println("元素0: " + mixed[0] + " (类型: " + type(mixed[0]) + ")")
println("元素1: " + mixed[1] + " (类型: " + type(mixed[1]) + ")")
println("元素2: " + mixed[2] + " (类型: " + type(mixed[2]) + ")")
println("元素3: " + mixed[3] + " (类型: " + type(mixed[3]) + ")")

// 5. 数组在条件中使用
println("")
println("5. 数组在条件中使用")
var flags = [true, false, true, true, false]
var trueCount = 0
for v in flags
	if v
		trueCount++
	end
end
println("true 的数量: " + trueCount)

// 6. 嵌套数组
println("")
println("6. 嵌套数组")
var matrix = [
	["a", "b"],
	["c", "d"]
]
println("matrix[0][0] = " + matrix[0][0])
println("matrix[0][1] = " + matrix[0][1])
println("matrix[1][0] = " + matrix[1][0])
println("matrix[1][1] = " + matrix[1][1])

// 7. 数组切片
println("")
println("7. 数组切片")
var data = [0, 1, 2, 3, 4, 5]
var slice = data[1 to 4]
println("data[1 to 4]:")
for v in slice
	print(v + " ")
end
println("")

// 8. 数组合并
println("")
println("8. 数组合并")
var a = [1, 2]
var b = [3, 4]
var c = a + b
println("[1,2] + [3,4]:")
for v in c
	print(v + " ")
end
println("")

// 9. 数组类型检查
println("")
println("9. 数组类型检查")
var arr = [1, 2, 3]
println("type(arr) = " + type(arr))
println("len(arr) = " + len(arr))

// 10. 空数组
println("")
println("10. 空数组")
var empty = []
println("空数组长度: " + len(empty))
println("空数组类型: " + type(empty))

println("")
println("=== 列表类型测试完成 ===")
