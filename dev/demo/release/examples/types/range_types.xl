// range 类型测试

// 测试 1: range(end) - 从 0 到 end-1
println("测试 range(5):")
for i in range(5)
	print(i)
	print(" ")
end
println("")

// 测试 2: range(start, end) - 从 start 到 end-1
println("测试 range(2, 8):")
for i in range(2, 8)
	print(i)
	print(" ")
end
println("")

// 测试 3: range(start, end, step) - 带步长
println("测试 range(0, 10, 2):")
for i in range(0, 10, 2)
	print(i)
	print(" ")
end
println("")

// 测试 4: 负步长
println("测试 range(10, 0, -1):")
for i in range(10, 0, -1)
	print(i)
	print(" ")
end
println("")

// 测试 5: range 作为变量
println("测试 range 赋值给变量:")
var arr = range(1, 6)
println(len(arr))
for v in arr
	print(v)
	print(" ")
end
println("")

// 测试 6: 嵌套 range
println("测试嵌套 range (乘法表 1-3):")
for i in range(1, 4)
	for j in range(1, 4)
		print(i * j)
		print(" ")
	end
	println("")
end

println("range 测试完成!")
