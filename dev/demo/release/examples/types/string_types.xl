// ============================================================
// xlang 示例：字符串类型
// 演示字符串的各种表示方式和基本操作
// ============================================================

// ---------- 字符串字面量 ----------

// 双引号字符串（支持转义）
var sDoubleQuote = "Hello, \"xlang\"!"
print("双引号字符串:", sDoubleQuote)

// 单引号字符串（不支持转义）
var sSingleQuote = 'Hello, "xlang"!'
print("单引号字符串:", sSingleQuote)

// 双引号多行字符串（支持转义）
var sMultiDouble = """Line 1\nLine 2\nLine 3"""
print("\n双引号多行字符串:")
print(sMultiDouble)

// 单引号多行字符串（不支持转义）
var sMultiSingle = '''Line 1\nLine 2\nLine 3'''
print("\n单引号多行字符串:")
print(sMultiSingle)

// ---------- 转义字符 ----------

var sEscapes = "\\反斜杠\n换行\t制表符\r回车\b退格\'单引号\"双引号\0空字符\a响铃"
print("\n转义字符示例:")
print(sEscapes)

// Unicode 转义
var sUnicode = "\u4e2d\u6587"  // 中文
var sHex = "\x48\x65\x6c\x6c\x6f"  // Hello
print("\nUnicode 转义:", sUnicode)
print("十六进制转义:", sHex)

// ---------- 字符串操作 ----------

// 字符串连接
var sStr1 = "Hello"
var sStr2 = "xlang"
var sConcatenated = sStr1 + ", " + sStr2 + "!"
print("\n字符串连接:", sConcatenated)

// 字符串重复
var sRepeated = "Ha" * 3
print("字符串重复:", sRepeated)

// 字符串长度
var sLength = "Hello, xlang!"
print("字符串长度:", sLength, "长度=", len(sLength))

// 字符串索引
var sIndexed = "xlang"
print("\n字符串索引:")
print(sIndexed, "[0] =", sIndexed[0])
print(sIndexed, "[1] =", sIndexed[1])
print(sIndexed, "[-1] =", sIndexed[-1])  // 从后往前索引

// 字符串切片
var sSliced = "Hello, xlang!"
print("\n字符串切片:")
print(sSliced, "[0:5] =", sSliced[0 to 5])  // 切片语法
print(sSliced, "[7:] =", sSliced[7 to])     // 从索引7到结尾
print(sSliced, "[:5] =", sSliced[ to 5])     // 从开头到索引5
print(sSliced, "[-5:] =", sSliced[-5 to])    // 从倒数第5个到结尾

// ---------- 模板字符串 ----------

// 基本模板字符串
var sName = "张三"
var iAge = 25
var sTemplate = `姓名: {$sName}, 年龄: {$iAge}`
print("\n模板字符串:", sTemplate)

// 带表达式的模板字符串
var iNum1 = 10
var iNum2 = 20
var sExprTemplate = `{$iNum1} + {$iNum2} = {$iNum1 + iNum2}`
print("带表达式的模板字符串:", sExprTemplate)

// 多行模板字符串
var sMultiTemplate = ```
姓名: {$sName}
年龄: {$iAge}
职业: 程序员
技能: xlang, C, JavaScript
```
print("\n多行模板字符串:")
print(sMultiTemplate)

// ---------- 字符串比较 ----------

var sCompare1 = "abc"
var sCompare2 = "def"
var sCompare3 = "abc"

print("\n字符串比较:")
print(sCompare1, "==", sCompare3, "=", sCompare1 == sCompare3)
print(sCompare1, "!=", sCompare2, "=", sCompare1 != sCompare2)
print(sCompare1, "<", sCompare2, "=", sCompare1 < sCompare2)
print(sCompare2, ">", sCompare1, "=", sCompare2 > sCompare1)

// ---------- 字符串搜索和替换 ----------

var sSearch = "Hello, xlang! Hello, world!"
print("\n字符串搜索和替换:")
print("原始字符串:", sSearch)

// 查找子字符串
var iIndex = indexOf(sSearch, "xlang")
print("xlang 的索引:", iIndex)

// 替换子字符串
var sReplaced = replace(sSearch, "Hello", "Hi")
print("替换后:", sReplaced)

// 分割字符串
var sSplit = "apple,banana,orange"
var arrSplit = split(sSplit, ",")
print("\n字符串分割:")
print("原始字符串:", sSplit)
print("分割结果:", arrSplit)

// ---------- 大小写转换 ----------

var sCase = "Hello, Xlang!"
print("\n大小写转换:")
print("原始字符串:", sCase)
print("转为大写:", upper(sCase))
print("转为小写:", lower(sCase))
