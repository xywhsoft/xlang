// for_loops.xl
// 演示 for 循环语法

println("=== for 循环测试 ===")

// 1. for-in 范围循环
println("")
println("1. for-in 范围循环 (1 到 5)")
for i in range(1, 6)
	println("i = " + i)
end

// 2. 遍历数组
println("")
println("2. 遍历数组")
var arr = [10, 20, 30, 40, 50]
for v in arr
	println("元素: " + v)
end

// 3. 遍历字符串
println("")
println("3. 遍历字符串")
var str = "xlang"
for c in str
	println("字符: " + c)
end

// 4. 带步长的范围循环
println("")
println("4. 带步长的范围循环 (0 到 10，步长 2)")
for i in range(0, 11, 2)
	println("i = " + i)
end

// 5. 递减循环
println("")
println("5. 递减循环 (5 到 1)")
for i in range(5, 0, -1)
	println("i = " + i)
end

// 6. 嵌套 for 循环
println("")
println("6. 嵌套 for 循环 (乘法表)")
for i in range(1, 4)
	for j in range(1, 4)
		print(i + "*" + j + "=" + (i * j) + " ")
	end
	println("")
end

// 7. 使用 break 退出循环
println("")
println("7. 使用 break 退出循环")
for i in range(1, 10)
	println("i = " + i)
	if i >= 3
		println("break!")
		break
	end
end

// 8. 使用 continue 跳过迭代
println("")
println("8. 使用 continue 跳过 3 的倍数")
for i in range(1, 10)
	if i % 3 == 0
		continue
	end
	println("i = " + i)
end

// 9. 计算数组元素之和
println("")
println("9. 计算数组元素之和")
var numbers = [1, 2, 3, 4, 5]
var sum = 0
for n in numbers
	sum = sum + n
end
println("数组元素之和: " + sum)

// 10. 遍历字典 (键值对)
println("")
println("10. 遍历字典")
var info = {name: "xlang", version: 3, lang: "programming"}
for k, v in info
	println(k + " = " + v)
end

// 11. 查找数组中的元素
println("")
println("11. 查找数组中的元素")
var items = ["apple", "banana", "cherry", "date"]
var target = "cherry"
var found = false
for item in items
	if item == target
		found = true
		println("找到: " + target)
		break
	end
end
if not found
	println("未找到: " + target)
end

// 12. 生成序列
println("")
println("12. 生成平方数序列")
var squares = []
for i in range(1, 6)
	squares = squares + [i * i]
end
println("平方数: ")
for s in squares
	print(s + " ")
end
println("")

println("")
println("=== for 循环测试完成 ===")
