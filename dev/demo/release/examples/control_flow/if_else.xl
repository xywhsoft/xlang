// if_else.xl
// 演示 if-else 条件语句

println("=== if-else 条件语句测试 ===")

// 1. 基本 if 语句
println("")
println("1. 基本 if 语句")
var a = 10
if a > 5
	println("a 大于 5")
end

// 2. if-else 语句
println("")
println("2. if-else 语句")
var b = 3
if b > 5
	println("b 大于 5")
else
	println("b 不大于 5")
end

// 3. if-elseif-else 语句
println("")
println("3. if-elseif-else 语句")
var score = 85
if score >= 90
	println("优秀")
elseif score >= 80
	println("良好")
elseif score >= 60
	println("及格")
else
	println("不及格")
end

// 4. 嵌套 if 语句
println("")
println("4. 嵌套 if 语句")
var x = 10
var y = 20
if x > 5
	println("x 大于 5")
	if y > 15
		println("且 y 大于 15")
	end
end

// 5. 使用逻辑运算符
println("")
println("5. 使用逻辑运算符")
var age = 25
var hasLicense = true
if (age >= 18) and hasLicense
	println("可以开车")
else
	println("不能开车")
end

// 6. 比较字符串
println("")
println("6. 比较字符串")
var name = "xlang"
if name == "xlang"
	println("这是 xlang 语言")
end

// 7. 检查空值
println("")
println("7. 检查空值")
var value = null
if value == null
	println("value 是空值")
end

// 8. 布尔值条件
println("")
println("8. 布尔值条件")
var flag = true
if flag
	println("flag 为真")
end

if not flag
	println("这行不会打印")
else
	println("flag 不为假")
end

// 9. 数值比较
println("")
println("9. 数值比较")
var num1 = 10
var num2 = 10
if num1 == num2
	println("num1 等于 num2")
end
if num1 >= num2
	println("num1 大于等于 num2")
end
if num1 <= num2
	println("num1 小于等于 num2")
end

// 10. 复杂条件组合
println("")
println("10. 复杂条件组合")
var temp = 25
var humidity = 60
if ((temp >= 20) and (temp <= 30)) and ((humidity >= 40) and (humidity <= 70))
	println("天气舒适")
else
	println("天气不舒适")
end

println("")
println("=== if-else 测试完成 ===")
