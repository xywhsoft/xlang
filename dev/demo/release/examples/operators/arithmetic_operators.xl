// arithmetic_operators.xl
// 演示算术运算符

println("=== 算术运算符测试 ===")

// 1. 基本算术运算
println("")
println("1. 基本算术运算")
var a = 10
var b = 3
println("a = " + a + ", b = " + b)
println("a + b = " + (a + b))
println("a - b = " + (a - b))
println("a * b = " + (a * b))
println("a / b = " + (a / b))
println("a % b = " + (a % b))

// 2. 乘方运算
println("")
println("2. 乘方运算")
println("2 ** 3 = " + (2 ** 3))
println("2 ** 10 = " + (2 ** 10))
println("10 ** 0 = " + (10 ** 0))
println("5 ** 1 = " + (5 ** 1))
println("2 ** -1 = " + (2 ** -1))

// 3. 浮点数运算
println("")
println("3. 浮点数运算")
var x = 10.5
var y = 3.2
println("x = " + x + ", y = " + y)
println("x + y = " + (x + y))
println("x - y = " + (x - y))
println("x * y = " + (x * y))
println("x / y = " + (x / y))

// 4. 混合类型运算
println("")
println("4. 混合类型运算")
var intVal = 10
var floatVal = 3.5
println("int + float = " + (intVal + floatVal))
println("int * float = " + (intVal * floatVal))

// 5. 负数运算
println("")
println("5. 负数运算")
var neg = -5
println("-5 + 3 = " + (neg + 3))
println("-5 * -3 = " + (neg * -3))
println("-5 / 2 = " + (neg / 2))

// 6. 复合赋值运算符
println("")
println("6. 复合赋值运算符")
var c = 10
println("初始值 c = " + c)
c += 5
println("c += 5 -> c = " + c)
c -= 3
println("c -= 3 -> c = " + c)
c *= 2
println("c *= 2 -> c = " + c)
c /= 4
println("c /= 4 -> c = " + c)
c %= 3
println("c %= 3 -> c = " + c)

// 7. 乘方赋值运算符
println("")
println("7. 乘方赋值运算符")
var d = 2
println("初始值 d = " + d)
d **= 3
println("d **= 3 -> d = " + d)

// 8. 自增自减运算符
println("")
println("8. 自增自减运算符")
var e = 5
println("初始值 e = " + e)
println("++e = " + (++e))
println("e 现在 = " + e)
println("e++ = " + (e++))
println("e 现在 = " + e)
println("--e = " + (--e))
println("e 现在 = " + e)
println("e-- = " + (e--))
println("e 现在 = " + e)

// 9. 运算优先级
println("")
println("9. 运算优先级")
println("2 + 3 * 4 = " + (2 + 3 * 4))
println("(2 + 3) * 4 = " + ((2 + 3) * 4))
println("2 ** 3 ** 2 = " + (2 ** 3 ** 2))
println("10 - 5 - 2 = " + (10 - 5 - 2))

// 10. 除零行为
println("")
println("10. 除零测试")
var zero = 0
println("10 / 0.0 = " + (10 / 0.0))

println("")
println("=== 算术运算符测试完成 ===")
