// 测试字符串和数组重复运算

// ============================================
// 1. 字符串重复
// ============================================
print("=== 字符串重复 ===")

var s1 = "ab" * 3
print("'ab' * 3 =")
print(s1)

var s2 = "Hello " * 2
print("'Hello ' * 2 =")
print(s2)

var s3 = "x" * 5
print("'x' * 5 =")
print(s3)

// ============================================
// 2. 数组重复
// ============================================
print("=== 数组重复 ===")

var arr1 = [1, 2] * 3
print("[1, 2] * 3 =")
print(arr1[0])
print(arr1[1])
print(arr1[2])
print(arr1[3])
print(arr1[4])
print(arr1[5])

var arr2 = [10, 20, 30] * 2
print("[10, 20, 30] * 2 =")
print(arr2[0])
print(arr2[1])
print(arr2[2])
print(arr2[3])
print(arr2[4])
print(arr2[5])

// ============================================
// 3. 边界测试
// ============================================
print("=== 边界测试 ===")

var s4 = "test" * 0
print("'test' * 0 = (empty)")
print(s4)

var s5 = "test" * 1
print("'test' * 1 =")
print(s5)

print("=== 测试完成 ===")
