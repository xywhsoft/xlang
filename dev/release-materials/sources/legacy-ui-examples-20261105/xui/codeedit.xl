// codeedit.xl — 代码编辑器：CodeEdit 控件（初始代码文本）
import xui

xui.XuiApp g_app

func onFrame()
    g_app.frame(0xE5232823)
end

func main(...) as int
    g_app = xui.XuiApp(800, 500, "CodeEdit Demo")
    point ctx = g_app.context()
    point font = g_app.font()
    xui.Widget root = xui.Widget(g_app.rootHandle())

    xui.Label title = xui.Label(ctx, "CodeEdit Demo", font)
    root.addChild(title)

    xui.CodeEdit edit = xui.CodeEdit(ctx, font)
    edit.setFlex(1.0, 1.0)

    xui.xuiCodeEditSetText(edit.handle, "func main(...) as int\n    println(\"hello xui\")\n    return 0\nend")

    root.addChild(edit)

    g_app.run(onFrame)
    return 0
end
