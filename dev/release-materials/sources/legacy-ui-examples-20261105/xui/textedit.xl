// textedit.xl — 文本编辑：TextEdit 控件（多行）
import xui

xui.XuiApp g_app

func onFrame()
    g_app.frame(0xE5232823)
end

func main(...) as int
    g_app = xui.XuiApp(800, 500, "TextEdit Demo")
    point ctx = g_app.context()
    point font = g_app.font()
    xui.Widget root = xui.Widget(g_app.rootHandle())

    xui.Label title = xui.Label(ctx, "TextEdit Demo", font)
    root.addChild(title)

    xui.TextEdit edit = xui.TextEdit(ctx, "First line\nSecond line\nThird line", font)
    edit.setFlex(1.0, 1.0)
    root.addChild(edit)

    g_app.run(onFrame)
    return 0
end
