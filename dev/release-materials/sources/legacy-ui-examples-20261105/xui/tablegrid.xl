// tablegrid.xl — 表格网格：TableGrid 控件
import xui

xui.XuiApp g_app

func onFrame()
    g_app.frame(0xE5232823)
end

func main(...) as int
    g_app = xui.XuiApp(800, 500, "TableGrid Demo")
    point ctx = g_app.context()
    point font = g_app.font()
    xui.Widget root = xui.Widget(g_app.rootHandle())

    xui.Label title = xui.Label(ctx, "TableGrid Demo", font)
    root.addChild(title)

    xui.TableGrid grid = xui.TableGrid(ctx)
    grid.setFlex(1.0, 1.0)
    root.addChild(grid)

    xui.Label hint = xui.Label(ctx, "Grid fills the remaining space", font)
    root.addChild(hint)

    g_app.run(onFrame)
    return 0
end
