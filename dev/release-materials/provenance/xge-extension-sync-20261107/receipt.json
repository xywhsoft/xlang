  "scope": "Refresh existing Windows dynamic/static and Linux dynamic XGE/XUI packages. No IDE/compiler binaries or unrelated xge resource WIP overwritten.",
  "newManagedMethods": [
    "xuiCodeEditSetBracketMatching",
    "xuiCodeEditGetBracketMatching",
    "xuiTabsSetScrollButtonsVisible",
    "xuiTabsGetScrollButtonsVisible",
    "xuiTabsSetTabListButtonVisible",
    "xuiTabsGetTabListButtonVisible",
    "xuiTabsGetScrollBackwardRect",
    "xuiTabsGetScrollForwardRect",
    "xuiDockPanelSetTabScrollButtonsVisible",
    "xuiDockPanelGetTabScrollButtonsVisible",
    "xuiDockPanelGetPaneTabScrollRects"
  ],
  "newConstants": [
    "XUI_CODE_EDIT_DISABLE_BRACKET_MATCH",
    "XUI_DOCK_PANEL_HIT_PANE_SCROLL_BACKWARD",
    "XUI_DOCK_PANEL_HIT_PANE_SCROLL_FORWARD"
  ],
  "nativeBehaviorUpdates": [
    "bracket matching and overflow navigation",
    "desktop control focus/chrome",
    "scoped render-pass ordering/state",
    "transactional copied table-column text",
    "owned Proxy identity factories"
  ],
  "implementation": "Direct native declarations; no per-method wrappers. Existing checked output and resource lifetime rules apply. A shared host XRT or the sole program XRT supplies all runtime services.",
