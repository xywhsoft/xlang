  "causalChain": [
    "xuiWindowGetType re-registers 23 existing properties on the already-registered branch.",
    "Each xuiStyleRegisterProperty commits a generation even when the definition is unchanged.",
    "Outside a style transaction each commit synchronously calls xuiStyleRefresh over the root and overlay trees.",
    "xuiWidgetResolveStyle rebuilds, copies, compares and replaces resolved style arrays.",
    "About creation causes 23 commits. First MsgBox creation adds 12 MsgBox-specific properties, totaling 35.",
    "IDE About and message construction do not open a style transaction. The file dialog does."
  ],
  "candidateAudit": {
    "existingTypeRegistrationCallSites": 41,
    "sitesWithPropertyExistenceGuard": 39,
    "unguardedSites": [
      "xuiWindowGetType",
      "xuiIconPickerGetType"
    ],
    "note": "Window measured directly. IconPicker is a source-audit finding, not a measured IDE trigger."
  },
