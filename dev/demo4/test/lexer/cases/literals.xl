// xlang v4 - 字面量测试

// 整数（十进制）
123
456
1_000_000
999_999_999

// 整数（十六进制）
0xFF
0x1234
0xABCD_EF00
&hFF
&HABCD

// 整数（八进制）
&o777
&O123

// 整数（二进制）
0b1010
0b1111_0000
&b1010
&B1111

// 浮点数
3.14
-2.5
1.0e10
2.5E-3
123.456e+2

// 字符串
"hello"
"hello world"
"hello\nworld"
"tab\there"
"quote\"test"

// 原始字符串
'raw string'
'no\nescape'
'c:\path\to\file'

// 多行字符串
"""
这是一个
多行字符串
"""

// 多行原始字符串
'''
这是原始
多行字符串
'''

// 时间字面量
#2000-01-01#
#12:00:00#
#2000-01-01 12:00:00#
