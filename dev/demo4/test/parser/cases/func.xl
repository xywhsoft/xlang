// xlang v4 语法分析测试 - 函数
// 测试函数声明的解析

// 简单函数
func greet()
	println("Hello!")
end

// 带参数
func add(int a, int b) as int
	return a + b
end

// 无类型参数
func hello(name)
	println("Hello, " + name)
end

// 混合参数
func calc(int a, b, float c) as float
	return float(a) + float(b) + c
end

// 默认参数
func greet2(string name, string msg = "Hello")
	println(msg + ", " + name)
end

// 可变参数
func sum(...)
	int total = 0
	for v in arg
		total += v
	end
	return total
end

// 字典可变参数
func config(***)
	for k, v in arg
		println(k + " = " + string(v))
	end
end

// 有返回类型
func factorial(int n) as int
	if n <= 1 then return 1
	return n * factorial(n - 1)
end

// 完整程序
func main()
	int a = add(3, 5)
	println("add(3, 5) = " + string(a))
	
	greet()
	greet2("Tom")
	greet2("Jerry", "Hi")
	
	int s = sum(1, 2, 3, 4, 5)
	println("sum = " + string(s))
	
	// 类型转换
	float f = float(a)
	string str = string(a)
	
	// 容器操作
	array arr = [10, 20, 30]
	dict person = {name: "Tom", age: 25}
	
	for i, v in arr
		println(string(i) + ": " + string(v))
	end
	
	for k, v in person
		println(k + " = " + string(v))
	end
end
