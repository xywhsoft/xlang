// xlang v4 语法分析测试 - 语句
// 测试各种语句的解析

// 变量声明
int a = 1
string s = "hello"
float f = 3.14
bool b = true
var v = 123
auto x = [1, 2, 3]

// 常量声明
const PI = 3.14159
const int MAX = 100

// if 语句
if a > 0
	print("positive")
end

// if-else
if a > 0
	print("positive")
else
	print("non-positive")
end

// if-elseif-else
if a > 0
	print("positive")
elseif a < 0
	print("negative")
else
	print("zero")
end

// 单行 if
if a > 0 then print(a)

// for-in 遍历
for item in arr
	print(item)
end

// for-in 键值遍历
for i, v in arr
	print(i, v)
end

// for 范围循环
for i = 1 to 10
	print(i)
end

// for 范围循环（带步长）
for i = 0 to 100 step 5
	print(i)
end

// while 循环
while x > 0 do
	x -= 1
end

// do-while 循环
do
	x += 1
while x < 10 end

// break 和 continue
for i in range(1, 100)
	if i > 10 then break
	if i % 2 == 0 then continue
	print(i)
end

// break n
for i in range(1, 10)
	for j in range(1, 10)
		break 2
	end
end

// return
func test() as int
	return 42
end

// 数组字面量
var arr2 = [1, 2, 3, 4, 5]

// 字典字面量
var dict1 = {name: "Tom", age: 25}

// 集合字面量
var set1 = {1, 2, 3}

// 嵌套字面量
var data = {
	name: "Tom",
	scores: [90, 85, 92]
}
