HttpHeaders headers = HttpHeaders()
assert(headers.append("Set-Cookie", "a=1"))
assert(headers.append("set-cookie", "b=2"))
assert(headers.count == 2)
assert(headers.countName("SET-COOKIE") == 2)
assert(headers.getNth("set-cookie", 1) == "b=2")
assert(headers.nameAt(0) == "Set-Cookie")
assert(headers.clone().count == 2)

SearchParams params = SearchParams("a=1&a=2&flag")
assert(params.count == 3)
assert(params.get("a") == "1")
assert(params.getNth("a", 1) == "2")
assert(params.hasValueAt(2) == false)
assert(params.append("space", "a b"))
assert(params.build() == "a=1&a=2&flag&space=a+b")

HttpContext root = HttpContext()
HttpContext child = root.withTimeout(10000)
assert(child.done == false)
assert(child.cancel())
assert(child.cancelled)

Buffer payload = Buffer()
assert(payload.append("payload"))
HttpBody body = HttpBody(payload.data(), c_size(payload.len()))
assert(body.contentLength == 7)
assert(body.replayable)

FormData form = FormData()
assert(form.append("field", "value"))
assert(form.append("file", payload, "a.txt", "text/plain"))
assert(form.append("body", body))
assert(form.count == 3)
assert(form.nameAt(1) == "file")
assert(form.fileNameAt(1) == "a.txt")
FormDataEncoded encoded = form.build()
assert(encoded.contentType() != "")
assert(encoded.body().contentLength > 0)

CookieJar jar = CookieJar()
assert(jar.setCookie("https://example.com/a", "sid=abc; Path=/; Secure; HttpOnly") == 1)
assert(jar.header("https://example.com/b") == "sid=abc")
assert(jar.header("http://example.com/b") == "")

HttpClientRequest request = HttpClientRequest("https://example.com/")
assert(request.body(body, "text/plain"))
assert(request.context(root))
assert(request.formData(form))

println("stdlib http semantics ok")
