// xhttp 语言扩展接入后恢复到扩展库测试套件。
extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

string full = "https://user@example.com:8443/a/b?x=1#frag"

assert url.valid(full), "full URL should be valid"
assert url.isAbsolute(full), "full URL should be absolute"
assert url.isSecure(full), "https URL should be secure"

expectStr(url.scheme(full), "https")
expectStr(url.authority(full), "user@example.com:8443")
expectStr(url.userInfo(full), "user")
expectStr(url.host(full), "example.com")
expect(url.port(full), 8443)
expectStr(url.path(full), "/a/b")
expectStr(url.query(full), "x=1")
expectStr(url.fragment(full), "frag")
expectStr(url.target(full), "/a/b?x=1")

string target = "/docs/index.html?lang=zh#top"
assert url.valid(target), "target URL should be valid"
assert !url.isAbsolute(target), "target URL should not be absolute"
expectStr(url.path(target), "/docs/index.html")
expectStr(url.query(target), "lang=zh")
expectStr(url.fragment(target), "top")

expect(url.port("https://example.com/path"), 443)
expect(url.port("http://example.com/path"), 80)
expectStr(url.host("https://example.com/path"), "example.com")
expectStr(url.normalizePath("/a/./b/../c"), "/a/c")
expectStr(url.resolve("https://example.com/a/b/c?x=1", "../d?y=2"), "https://example.com/a/d?y=2")

assert !url.valid("http://"), "broken URL should be invalid"
expectStr(url.host("http://"), "")
