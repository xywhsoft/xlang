// httpproxy - HTTP 正向代理（CONNECT 隧道 + 请求转发 + 缓存）
//
// 用法：
//   httpproxy serve <port>     常驻正向代理，监听 port（默认 18080）
//   httpproxy test             self-test：启动 origin + proxy，自测转发/缓存/CONNECT
//   httpproxy -h|--help        帮助
//
// 架构与 xlang 约束（见 projects/dev/README.md）：
//   * 用 http.server 接收代理请求（method/target/headers/body 全量解析）。
//   * HTTP 转发：解析 absolute-form 目标（url.*），用 tcp.connect 连到 origin，
//     手工拼回 relative-form 请求行 + 转发头（剔除 hop-by-hop）+ 重算 Content-Length，
//     recv 响应后解析状态行/头/体，经 HttpResponse 回写。这是完全可用路径。
//   * CONNECT 隧道：解析 host:port，用 tcp.connect 建立到目标的 TCP 连接，回
//     200 Connection Established。由于 http.server 拥有客户端 socket 且不暴露 raw
//     handoff，无法在 200 之后做 client<->target 的逐字节双向中继；此处实现解析 +
//     建链 + 应答（这是 http.server 接收路径下能做的全部）。
//   * 简单缓存：仅 GET + 200，dict<url,...> + TTL（unix 秒），命中加 X-Cache: HIT。
//   * native-backed class（HttpRequest/HttpResponse/TcpStream/Buffer）不能跨函数返回，
//     所以所有句柄操作内联在 handler 或 proxyRoundTrip 内；helper 只回 string/int。

const int DEFAULT_PORT = 18080
const int CONNECT_TIMEOUT = 8000
const int SEND_DRAIN = 5000
const int RECV_TIMEOUT = 5000
const int RECV_CHUNK = 65536
const int RECV_MAX_LOOPS = 64
const int CACHE_TTL = 60

point ZERO

// ---------- 缓存（并行 var dict；写入 data[k]=v 与 .contains/.length 均已验证）----------
// 注：var dict 读取需显式 int()/string() 转换（见 containers.xl）。
var g_cacheBody = {}
var g_cacheTime = {}
var g_cacheStatus = {}
var g_cacheCT = {}

// ---------- 统计 ----------
int g_requests = 0
int g_cacheHits = 0
int g_forwards = 0
int g_connects = 0
int g_errors = 0
int g_cached = 0

// self-test 计数
int g_passed = 0
int g_failed = 0

// ============================================================
// 纯字符串 helper（不触碰 native-backed class）
// ============================================================

// 完整 URL 依赖接入 xhttp 语言扩展后恢复。
func isAllDigits(string s) as bool
    if s == "" then
        return false
    end
    int i = 0
    while i < string.len(s)
        int b = string.byteAt(s, i)
        if b < 48 or b > 57 then
            return false
        end
        i += 1
    end
    return true
end

// 拆 "host:port" / "host" -> (host, port)。端口非数字时回落 defaultPort。
func splitHostPort(string hostport, int defaultPort) as (string, int)
    int ci = string.lastIndexOf(hostport, ":")
    if ci > 0 then
        string maybePort = string.mid(hostport, ci + 1)
        if isAllDigits(maybePort) then
            return string.left(hostport, ci), int(maybePort)
        end
    end
    return hostport, defaultPort
end

// 请求转发方向需要剔除的头（hop-by-hop + Host/Content-Length 由代理重发）。
func isHopHeader(string name) as bool
    string n = string.lower(name)
    if n == "connection" then return true end
    if n == "keep-alive" then return true end
    if n == "proxy-authenticate" then return true end
    if n == "proxy-authorization" then return true end
    if n == "proxy-connection" then return true end
    if n == "te" then return true end
    if n == "trailers" then return true end
    if n == "transfer-encoding" then return true end
    if n == "upgrade" then return true end
    if n == "host" then return true end
    if n == "content-length" then return true end
    return false
end

// 响应回写方向需要剔除的头（Content-Length/Type/Transfer-Encoding 由 resp.text 管理）。
func isResponseStripHeader(string name) as bool
    string n = string.lower(name)
    if n == "content-length" then return true end
    if n == "content-type" then return true end
    if n == "transfer-encoding" then return true end
    if n == "connection" then return true end
    if n == "keep-alive" then return true end
    if n == "proxy-connection" then return true end
    return false
end

// 在响应头块里按名取值（大小写不敏感；返回值保留原大小写）。
func headerValueCI(string headerBlock, string name) as string
    string low = string.lower(headerBlock)
    string needle = string.lower(name) + ":"
    int idx = string.indexOf(low, needle)
    if idx < 0 then
        return ""
    end
    int valStart = idx + string.len(needle)
    string tail = string.mid(headerBlock, valStart)
    string lowTail = string.mid(low, valStart)
    int nl = string.indexOf(lowTail, "\r\n")
    if nl < 0 then
        nl = string.len(lowTail)
    end
    return string.trim(string.mid(tail, 0, nl))
end

// 从一坨响应文本里解析状态码（HTTP/1.1 200 OK -> 200）。非法返回 0。
func extractStatus(string resp) as int
    int nl = string.indexOf(resp, "\r\n")
    if nl < 0 then
        nl = string.len(resp)
    end
    string statusLine = string.left(resp, nl)
    int sp1 = string.indexOf(statusLine, " ")
    if sp1 < 0 then
        return 0
    end
    string rest = string.mid(statusLine, sp1 + 1)
    int sp2 = string.indexOf(rest, " ")
    string codeStr
    if sp2 < 0 then
        codeStr = string.trim(rest)
    else
        codeStr = string.left(rest, sp2)
    end
    codeStr = string.trim(codeStr)
    if codeStr == "" or not isAllDigits(codeStr) then
        return 0
    end
    return int(codeStr)
end

func extractHeader(string resp, string name) as string
    int he = string.indexOf(resp, "\r\n\r\n")
    if he < 0 then
        return ""
    end
    return headerValueCI(string.left(resp, he), name)
end

func extractBody(string resp) as string
    int he = string.indexOf(resp, "\r\n\r\n")
    if he < 0 then
        return ""
    end
    return string.mid(resp, he + 4)
end

// 响应是否已收全：有头结束符；若有 Content-Length 则体字节够；否则视为完整。
func responseComplete(string acc) as bool
    int he = string.indexOf(acc, "\r\n\r\n")
    if he < 0 then
        return false
    end
    string headerBlock = string.left(acc, he)
    string clStr = headerValueCI(headerBlock, "content-length")
    if clStr == "" or not isAllDigits(clStr) then
        return true
    end
    int cl = int(clStr)
    int bodyStart = he + 4
    int bodyHave = string.len(acc) - bodyStart
    if bodyHave >= cl then
        return true
    end
    return false
end

func access(string method, string target, int code, string route)
    int now = time.toUnix(time.nowUTC())
    println("[access] " + now.toString() + " " + method + " " + target + " -> " + code.toString() + " (" + route + ")")
end

func check(bool cond, string name, string detail)
    if cond then
        g_passed += 1
        println("[ PASS ] " + name)
    else
        g_failed += 1
        println("[ FAIL ] " + name + "  " + detail)
    end
end

// ============================================================
// 代理主 handler（HttpRequest/HttpResponse/TcpStream/Buffer 全部内联）
// ============================================================

func proxyRoute(point reqHandle, point respHandle) as bool
    HttpRequest req = HttpRequest(reqHandle)
    HttpResponse resp = HttpResponse(respHandle)

    string method = req.method()
    string target = req.target()
    if target == "" then
        target = req.path()
    end

    resp.header("Via", "1.1 xlang-httpproxy")
    resp.header("X-Proxy", "xlang-httpproxy")

    // ---------------- CONNECT 隧道 ----------------
    if method == "CONNECT" then
        g_requests += 1
        g_connects += 1
        auto host, port = splitHostPort(target, 443)
        access(method, target, 0, "CONNECT")
		TcpStream target = tcp.connect(host, port, CONNECT_TIMEOUT)
		if target.handle == null then
			g_errors += 1
			resp.status(502)
			return resp.text("Bad Gateway: cannot reach " + host + ":" + port.toString(), "text/plain; charset=utf-8")
		end
		// 隧道建立。http.server 持有客户端 socket 且无 raw handoff API，
		// 故 200 之后的 client<->target 逐字节中继无法在此实现；关闭目标侧并应答。
		target.close()
        resp.status(200, "Connection Established")
        return true
    end

    g_requests += 1

    // ---------------- 解析 absolute-form 目标 ----------------
    if not url.isAbsolute(target) then
        g_errors += 1
        access(method, target, 400, "ERR")
        resp.status(400)
        return resp.text("Bad Request: forward proxy requires absolute-form target (got '" + target + "')", "text/plain; charset=utf-8")
    end
    string scheme = string.lower(url.scheme(target))
    if scheme != "http" then
        g_errors += 1
        access(method, target, 501, "ERR")
        resp.status(501)
        return resp.text("Not Implemented: only http forwarding supported (scheme='" + scheme + "'; use CONNECT for https)", "text/plain; charset=utf-8")
    end
    string ohost = url.host(target)
    int oport = url.port(target)
    if oport <= 0 then
        oport = 80
    end
    string relPath = url.target(target)
    if relPath == "" then
        relPath = "/"
    end

    // ---------------- 缓存查询（仅 GET）----------------
    if method == "GET" and g_cacheBody.contains(target) then
        int cachedAt = int(g_cacheTime[target])
        int now = time.toUnix(time.nowUTC())
        if now - cachedAt < CACHE_TTL then
            int ccode = int(g_cacheStatus[target])
            string cbody = string(g_cacheBody[target])
            string cct = string(g_cacheCT[target])
            resp.status(ccode)
            resp.header("X-Cache", "HIT")
            g_cacheHits += 1
            access(method, target, ccode, "HIT")
            return resp.text(cbody, cct)
        end
    end

    // ---------------- tcp.connect 转发 ----------------
	TcpStream ts = tcp.connect(ohost, oport, CONNECT_TIMEOUT)
	if ts.handle == null then
		g_errors += 1
		access(method, target, 502, "ERR")
		resp.status(502)
		return resp.text("Bad Gateway: cannot connect to " + ohost + ":" + oport.toString(), "text/plain; charset=utf-8")
	end

    // 构造 relative-form 请求
    string fwd = method + " " + relPath + " HTTP/1.1\r\n"
    fwd = fwd + "Host: " + ohost
    if oport != 80 then
        fwd = fwd + ":" + oport.toString()
    end
    fwd = fwd + "\r\n"

    int hc = req.headerCount()
    int hi = 0
    while hi < hc
        string hn = req.headerName(hi)
        string hv = req.headerValue(hi)
        if not isHopHeader(hn) then
            fwd = fwd + hn + ": " + hv + "\r\n"
        end
        hi += 1
    end

    string body = req.body()
    if body != "" then
        Buffer bbuf = Buffer()
        bbuf.append(body)
        fwd = fwd + "Content-Length: " + bbuf.len().toString() + "\r\n"
    end
    fwd = fwd + "Connection: close\r\n\r\n"
    if body != "" then
        fwd = fwd + body
    end

    ts.send(fwd)
    ts.drain(SEND_DRAIN)

    // recv 响应（文本累积；ASCII / UTF-8 文本响应；二进制保真非本简易代理目标）
    string acc = ""
    int retries = 0
    while retries < RECV_MAX_LOOPS
        string chunk = ts.recv(RECV_TIMEOUT, RECV_CHUNK)
        if chunk == "" then
            break
        end
        acc = acc + chunk
        if responseComplete(acc) then
            break
        end
        retries += 1
    end
    ts.close()

    if acc == "" then
        g_errors += 1
        access(method, target, 502, "ERR")
        resp.status(502)
        return resp.text("Bad Gateway: empty response from " + ohost, "text/plain; charset=utf-8")
    end

    int he = string.indexOf(acc, "\r\n\r\n")
    if he < 0 then
        g_errors += 1
        access(method, target, 502, "ERR")
        resp.status(502)
        return resp.text("Bad Gateway: malformed response from " + ohost, "text/plain; charset=utf-8")
    end
    string headerBlock = string.left(acc, he)
    string bodyText = string.mid(acc, he + 4)

    int code = extractStatus(acc)
    if code == 0 then
        code = 200
    end
    resp.status(code)

    // 拷贝响应头（保留原大小写；剔除 hop-by-hop / CL / CT / TE）
    int scan = string.indexOf(headerBlock, "\r\n")
    int pos = scan + 2
    while pos < string.len(headerBlock)
        int lineEnd = string.indexOf(string.mid(headerBlock, pos), "\r\n")
        if lineEnd < 0 then
            lineEnd = string.len(headerBlock)
        else
            lineEnd = pos + lineEnd
        end
        string line = string.mid(headerBlock, pos, lineEnd - pos)
        int colon = string.indexOf(line, ":")
        if colon > 0 then
            string hname = string.trim(string.left(line, colon))
            string hval = string.trim(string.mid(line, colon + 1))
            if not isResponseStripHeader(hname) then
                resp.header(hname, hval)
            end
        end
        if lineEnd >= string.len(headerBlock) then
            break
        end
        pos = lineEnd + 2
    end

    string ct = headerValueCI(headerBlock, "content-type")
    if ct == "" then
        ct = "application/octet-stream"
    end

    // 写缓存（GET + 200）
    if method == "GET" and code == 200 then
        g_cacheBody[target] = bodyText
        g_cacheTime[target] = time.toUnix(time.nowUTC())
        g_cacheStatus[target] = code
        g_cacheCT[target] = ct
        g_cached += 1
    end

    g_forwards += 1
    resp.header("X-Cache", "MISS")
    access(method, target, code, "FORWARD")
    return resp.text(bodyText, ct)
end

func(point, point) as bool proxyHandler = proxyRoute

// http.server 不把 CONNECT 方法派发给 anyRequest 路由（authority-form 目标无路径，
// 框架直接 404）。这里在 error 回调里接住 CONNECT，完成隧道握手应答。
func proxyError(int status, string message, point reqHandle, point respHandle) as bool
    HttpRequest req = HttpRequest(reqHandle)
    HttpResponse resp = HttpResponse(respHandle)
    string method = req.method()
    if method == "CONNECT" then
        string target = req.target()
        if target == "" then
            target = req.path()
        end
        g_requests += 1
        g_connects += 1
        auto host, port = splitHostPort(target, 443)
        access(method, target, 0, "CONNECT")
		TcpStream targetStream = tcp.connect(host, port, CONNECT_TIMEOUT)
		if targetStream.handle == null then
			g_errors += 1
			resp.header("Via", "1.1 xlang-httpproxy")
			resp.header("X-Proxy", "xlang-httpproxy")
			resp.status(502)
			return resp.text("Bad Gateway: cannot reach " + host + ":" + port.toString(), "text/plain; charset=utf-8")
		end
		targetStream.close()
        resp.header("Via", "1.1 xlang-httpproxy")
        resp.header("X-Proxy", "xlang-httpproxy")
        resp.status(200, "Connection Established")
        return true
    end
    resp.status(status)
    return resp.text("Not Found", "text/plain; charset=utf-8")
end

func(int, string, point, point) as bool proxyErrorHandler = proxyError

func buildProxyServer(int port) as point
    // workerCount=1：保证缓存 dict / 统计 int 在 handler 串行访问，无需锁。
    point server = http.server.create(port, "127.0.0.1", 128, 16777216, 16777216, 200, 131072, 1)
    http.server.anyRequest(server, "/*", proxyHandler)
    http.server.error(server, proxyErrorHandler)
    return server
end

// ============================================================
// self-test 用的 origin 后端
// ============================================================

func originRoute(point reqHandle, point respHandle) as bool
    HttpRequest r = HttpRequest(reqHandle)
    HttpResponse w = HttpResponse(respHandle)
    if r.method() == "GET" and r.path() == "/hello" then
        w.header("X-Origin", "httpproxy-test")
        return w.text("hello via origin", "text/plain; charset=utf-8")
    end
    if r.method() == "GET" and r.path() == "/json" then
        return w.jsonText("{\"src\":\"origin\",\"n\":42}")
    end
    if r.method() == "POST" and r.path() == "/echo" then
        return w.text("echo:" + r.body(), "text/plain; charset=utf-8")
    end
    w.status(404)
    return w.text("origin-not-found", "text/plain; charset=utf-8")
end

func(point, point) as bool originHandler = originRoute

func buildOriginServer() as point
    point server = http.server.create(0, "127.0.0.1", 128, 1048576, 1048576, 100, 65536, 2)
    http.server.anyRequest(server, "/*", originHandler)
    return server
end

// 发一坨原始请求到 host:port，recv 完整响应后关闭连接返回文本。
// TcpStream 在函数内创建并销毁，不跨函数返回（native-backed class 约束）。
func proxyRoundTrip(string host, int port, string reqBlob) as string
	TcpStream s = tcp.connect(host, port, CONNECT_TIMEOUT)
	if s.handle == null then
		return ""
	end
    s.send(reqBlob)
    s.drain(SEND_DRAIN)
    string acc = ""
    int retries = 0
    while retries < RECV_MAX_LOOPS
        string chunk = s.recv(RECV_TIMEOUT, RECV_CHUNK)
        if chunk == "" then
            break
        end
        acc = acc + chunk
        if responseComplete(acc) then
            break
        end
        retries += 1
    end
    s.close()
    return acc
end

// ============================================================
// self-test
// ============================================================

func runSelfTest() as int
    println("")
    println("================ httpproxy self-test ================")

    point origin = buildOriginServer()
    if origin == null then
        println("FATAL: origin server create failed")
        return 1
    end
    if not http.server.start(origin) then
        println("FATAL: origin server start failed")
        http.server.destroy(origin)
        return 1
    end
    int oport = http.server.port(origin)

    point proxy = buildProxyServer(0)
    if proxy == null then
        println("FATAL: proxy server create failed")
        http.server.stop(origin)
        http.server.destroy(origin)
        return 1
    end
    if not http.server.start(proxy) then
        println("FATAL: proxy server start failed")
        http.server.destroy(proxy)
        http.server.stop(origin)
        http.server.destroy(origin)
        return 1
    end
    int pport = http.server.port(proxy)

    time.sleep(150)

    string base = "http://127.0.0.1:" + oport.toString()
    println("origin on 127.0.0.1:" + oport.toString() + ", proxy on 127.0.0.1:" + pport.toString())
    println("------------------------------------------------------------")

    // 1. GET /hello（MISS + 转发 + 头透传）
    if true then
        string r = "GET " + base + "/hello HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"
        string resp = proxyRoundTrip("127.0.0.1", pport, r)
        check(extractStatus(resp) == 200, "1. GET /hello status 200", "resp=" + resp)
        check(extractHeader(resp, "X-Cache") == "MISS", "1. X-Cache MISS", "resp=" + resp)
        check(extractBody(resp) == "hello via origin", "1. body hello via origin", "body=" + extractBody(resp))
        check(extractHeader(resp, "X-Origin") == "httpproxy-test", "1. X-Origin header forwarded", "resp=" + resp)
    end

    // 2. GET /hello 再来一次（HIT）
    if true then
        string r = "GET " + base + "/hello HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"
        string resp = proxyRoundTrip("127.0.0.1", pport, r)
        check(extractStatus(resp) == 200, "2. GET /hello cached status 200", "resp=" + resp)
        check(extractHeader(resp, "X-Cache") == "HIT", "2. X-Cache HIT", "resp=" + resp)
        check(extractBody(resp) == "hello via origin", "2. cached body hello via origin", "body=" + extractBody(resp))
    end

    // 3. GET /json
    if true then
        string r = "GET " + base + "/json HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"
        string resp = proxyRoundTrip("127.0.0.1", pport, r)
        check(extractStatus(resp) == 200, "3. GET /json status 200", "resp=" + resp)
        check(string.contains(extractBody(resp), "origin"), "3. body has origin", "body=" + extractBody(resp))
        check(string.contains(extractBody(resp), "42"), "3. body has 42", "body=" + extractBody(resp))
    end

    // 4. POST /echo（带 body 转发，不缓存）
    if true then
        string payload = "ping"
        string r = "POST " + base + "/echo HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: text/plain\r\nContent-Length: 4\r\nConnection: close\r\n\r\n" + payload
        string resp = proxyRoundTrip("127.0.0.1", pport, r)
        check(extractStatus(resp) == 200, "4. POST /echo status 200", "resp=" + resp)
        check(extractBody(resp) == "echo:ping", "4. body echo:ping", "body=" + extractBody(resp))
        check(extractHeader(resp, "X-Cache") == "MISS", "4. POST not cached (MISS)", "resp=" + resp)
    end

    // 5. CONNECT 隧道（建立到 origin 的 TCP，回 200）
    if true then
        string r = "CONNECT 127.0.0.1:" + oport.toString() + " HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n"
        string resp = proxyRoundTrip("127.0.0.1", pport, r)
        check(extractStatus(resp) == 200, "5. CONNECT status 200", "resp=" + resp)
    end

    // 6. GET /missing（origin 404 透传）
    if true then
        string r = "GET " + base + "/missing HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"
        string resp = proxyRoundTrip("127.0.0.1", pport, r)
        check(extractStatus(resp) == 404, "6. GET /missing status 404", "resp=" + resp)
    end

    // 7. 非 absolute-form 目标（直接当普通 server 访问）-> 400
    if true then
        string r = "GET /foo HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"
        string resp = proxyRoundTrip("127.0.0.1", pport, r)
        check(extractStatus(resp) == 400, "7. non-absolute target -> 400", "resp=" + resp)
    end

    println("------------------------------------------------------------")
    println("passed: " + g_passed.toString() + " / " + (g_passed + g_failed).toString() + "    failed: " + g_failed.toString())
    println("stats: requests=" + g_requests.toString() + " forwards=" + g_forwards.toString() + " cacheHits=" + g_cacheHits.toString() + " connects=" + g_connects.toString() + " errors=" + g_errors.toString() + " cached=" + g_cached.toString())

    http.server.drain(proxy, 2000)
    http.server.stop(proxy)
    http.server.destroy(proxy)
    http.server.drain(origin, 2000)
    http.server.stop(origin)
    http.server.destroy(origin)

    if g_failed > 0 then
        return 1
    end
    return 0
end

func printUsage()
    println("httpproxy - HTTP forward proxy (CONNECT tunnel + forward + cache)")
    println("Usage:")
    println("  httpproxy serve <port>     run forward proxy on <port> (default " + DEFAULT_PORT.toString() + ")")
    println("  httpproxy test             self-test (origin + proxy, forward/cache/CONNECT)")
    println("  httpproxy -h|--help        show this help")
    println("Configure your HTTP client to use 127.0.0.1:<port> as its proxy.")
    println("  http://  targets  -> forwarded via tcp.connect")
    println("  https:// targets  -> CONNECT tunnel (handshake only under http.server)")
    println("GET + 200 responses cached for " + CACHE_TTL.toString() + "s.")
end

// ============================================================
// main
// ============================================================

func main(...) as int
    println("xlang httpproxy - HTTP forward proxy")
    println("")

    string mode = ""
    int port = DEFAULT_PORT

    if arg.length < 2 then
        printUsage()
        return 1
    end

    string a1 = string(arg[1])
    if a1 == "-h" or a1 == "--help" then
        printUsage()
        return 0
    elseif a1 == "test" then
        mode = "test"
    elseif a1 == "serve" then
        mode = "serve"
        if arg.length >= 3 then
            int p = int(string(arg[2]))
            if p > 0 then
                port = p
            end
        end
    else
        println("Error: unknown command '" + a1 + "'")
        printUsage()
        return 1
    end

    if mode == "test" then
        return runSelfTest()
    end

    point server = buildProxyServer(port)
    if server == null then
        println("FATAL: http.server.create returned null")
        return 1
    end
    if not http.server.start(server) then
        println("FATAL: http.server.start failed (port " + port.toString() + " busy?)")
        http.server.destroy(server)
        return 1
    end

    int bound = http.server.port(server)
    println("httpproxy listening on 127.0.0.1:" + bound.toString())
    println("set this as your HTTP proxy. cache TTL = " + CACHE_TTL.toString() + "s. Ctrl+C to stop.")
    println("")
    while true
        time.sleep(5000)
        println("[stats] requests=" + g_requests.toString() + " forwards=" + g_forwards.toString() + " cacheHits=" + g_cacheHits.toString() + " connects=" + g_connects.toString() + " errors=" + g_errors.toString() + " cached=" + g_cached.toString())
    end
end
