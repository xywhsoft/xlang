// ─── LLM 全局函数 ───

// LLM 问答
export func LLMAsk(string prompt, string image_path, string provider) as OpResult
    LLMClient client = CreateLLM(provider, "")
    array<string> images = []
    if image_path != "" then
        images.push(image_path)
    end
    return client.Ask(prompt, images, false)
end

// LLM JSON 问答
export func LLMAskJson(string prompt, string image_path, string provider) as OpResult
    LLMClient client = CreateLLM(provider, "")
    array<string> images = []
    if image_path != "" then
        images.push(image_path)
    end
    return client.Ask(prompt, images, true)
end

// LLM 图像对比
export func LLMCompare(string image_a, string image_b, string instruction, string provider) as OpResult
    string extra = "无额外规则。"
    if instruction != "" then
        extra = "补充规则：" + instruction
    end
    string prompt = "你是自动化测试的 UI 画面对比器。按顺序收到两张图片：第一张为当前画面，第二张为预期画面。\n"
    prompt = prompt + "请判断两者是否满足同一预期页面状态；忽略未被规则要求关注的动态时间、网络状态或光标。\n"
    prompt = prompt + "只能返回 JSON 对象，格式为：\n"
    prompt = prompt + "{\"matched\":true,\"confidence\":0.0,\"differences\":[\"差异说明\"],\"reason\":\"简短依据\"}\n"
    prompt = prompt + "confidence 必须在 0 到 1 之间。\n" + extra

    LLMClient client = CreateLLM(provider, "")
    array<string> images = [image_a, image_b]
    return client.Ask(prompt, images, true)
end

// LLM 视觉定位
export func LLMFind(string image_path, string target, float min_confidence, string provider) as OpResult
    string prompt = "你是 UI 自动化的视觉定位器。请在唯一一张屏幕截图中寻找：" + target + "\n"
    prompt = prompt + "不能找到时返回 found=false。找到时只返回 JSON：\n"
    prompt = prompt + "{\"found\":true,\"confidence\":0.0,\"bbox\":{\"x\":0.0,\"y\":0.0,\"w\":0.0,\"h\":0.0},\"reason\":\"简短依据\"}\n"
    prompt = prompt + "bbox 的 x、y、w、h 必须为相对于整张截图的 0 到 1 归一化值；x,y 是左上角，w,h 是宽高。\n"
    prompt = prompt + "不要执行任何点击，不要返回 Markdown 或额外文本。"

    LLMClient client = CreateLLM(provider, "")
    array<string> images = [image_path]
    return client.Ask(prompt, images, true)
end

// LLM 图找图
export func LLMFindImage(string image_path, string template_path, string description, string provider) as OpResult
    string extra = "无补充描述。"
    if description != "" then
        extra = "补充描述：" + description
    end
    string prompt = "你是 UI 自动化的参考图定位器。按顺序收到两张图片：第一张是参考图，第二张是当前屏幕截图。\n"
    prompt = prompt + "请在第二张截图寻找与第一张相同或视觉等价的目标。\n" + extra + "\n"
    prompt = prompt + "找不到时返回 found=false；找到时只返回 JSON：\n"
    prompt = prompt + "{\"found\":true,\"confidence\":0.0,\"bbox\":{\"x\":0.0,\"y\":0.0,\"w\":0.0,\"h\":0.0},\"reason\":\"简短依据\"}\n"
    prompt = prompt + "bbox 必须是第二张截图的 0 到 1 归一化坐标，x,y 为左上角，w,h 为宽高。不要输出 Markdown 或额外文本。"

    LLMClient client = CreateLLM(provider, "")
    array<string> images = [template_path, image_path]
    return client.Ask(prompt, images, true)
end

// ─── 模块初始化 ───
// Windows 上自动创建桌面设备

func _initialize_default_device()
    // 仅在 Windows 上自动初始化
    string os_name = os.platform()
    if os_name != "windows" then
        return
    end
    // 尝试创建桌面设备，失败时静默忽略
    DesktopDevice dev = UseDesktop("primary")
    _active_device = dev
end

// 模块加载时执行初始化
_initialize_default_device()
