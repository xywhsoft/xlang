// ─── 图像对比 ───

// pHash 对比
export func Compare(string template, float threshold) as OpResult
    AutomationDevice dev = GetActiveDevice()
    return dev.Compare(template, threshold)
end

// pHash 对比（自定义 hash_size）
export func CompareEx(string template, float threshold, int hash_size) as OpResult
    string screenshot = GetActiveDevice()._TrySnapshot("pHash 场景对比")
    if screenshot == "" then
        return _result_fail("截图失败")
    end
    string tpl = ResolveImagePath(template)
    float sim = VisionCompareEx(screenshot, tpl, hash_size)
    file.delete(screenshot)
    bool matched = sim >= threshold
    OpResult r = OpResult(matched, "similarity=" + string(sim), "")
    return r
end

