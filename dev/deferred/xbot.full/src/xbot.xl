// xbot/xbot.xl - 主入口：全局常量 + 便捷函数 + 活动设备管理
// 对应 xbot.py L6003-7432：全局默认设备、便捷操作函数、LLM 全局函数

// ─── 设备后端常量 ───
const string ANDROID_ADB = "adb"
const string ANDROID_CLOUD_HS = "cloud_hs"

// ─── 全局活动设备 ───
AutomationDevice? _active_device = null

// ─── 活动设备管理 ───

// 设置活动设备
export func SetActiveDevice(AutomationDevice device)
    _active_device = device
end

// 获取活动设备
export func GetActiveDevice() as AutomationDevice
    if _active_device == null then
        throw RuntimeError "尚未创建活动设备，请先调用 UseDesktop、UseWindow 或 UseAndroid"
    end
    return _active_device as AutomationDevice
end

// 替换默认设备（释放旧设备）
func _replace_default_device(AutomationDevice device) as AutomationDevice
    AutomationDevice? previous = _active_device
    _active_device = device
    if previous != null and previous != device then
        previous.Close()
    end
    return device
end

// ─── 设备工厂 ───

// 创建桌面设备并设为活动设备
export func UseDesktopDevice(string monitor) as DesktopDevice
    DesktopDevice dev = UseDesktop(monitor)
    _replace_default_device(dev)
    return dev
end

// 创建窗口设备并设为活动设备
export func UseWindowDevice(string title, string class_name, string process) as WindowDevice
    WindowDevice dev = UseWindow(title, class_name, process)
    _replace_default_device(dev)
    return dev
end

// 创建 Android 设备并设为活动设备
export func UseAndroidDevice(string serial, string adb_path) as AndroidAdbDevice
    AndroidAdbDevice dev = UseAndroid(serial, adb_path)
    _replace_default_device(dev)
    return dev
end

// 创建火山云手机设备并设为活动设备
export func UseCloudHSDevice(string pod_id, string config_path, float timeout_sec, float poll_sec, bool auto_power_on) as VolcCloudPhoneDevice
    VolcCloudPhoneDevice dev = ConnectCloudHS(pod_id, config_path, timeout_sec, poll_sec, auto_power_on)
    return dev
end

// 通用设备工厂
export func UseDevice(string backend, string identifier) as AutomationDevice
    string normalized = string.lower(string.trim(backend))
    if normalized == ANDROID_ADB then
        return UseAndroidDevice(identifier, "")
    elseif normalized == ANDROID_CLOUD_HS then
        return UseCloudHSDevice(identifier, "config.ini", 180.0, 3.0, true)
    end
    throw RuntimeError "未知设备后端: " + backend
end

// 配置云手机解析器（设置 config.ini 路径）
var _cloud_hs_config_path = "config.ini"
export func ConfigureCloudHSResolver(string config_path)
    _cloud_hs_config_path = config_path
end

// ─── 全局便捷操作函数（委托到活动设备）───

// 点击
export func Click(var value, float y_val) as OpResult
    AutomationDevice dev = GetActiveDevice()
    return dev.Click(value, y_val, ANCHOR_CENTER, null, 1, 0.1)
end

// 点击别名
export func Tap(var value, float y_val) as OpResult
    return Click(value, y_val)
end

// 双击
export func DoubleClick(var value, float y_val) as OpResult
    AutomationDevice dev = GetActiveDevice()
    return dev.Click(value, y_val, ANCHOR_CENTER, null, 2, 0.1)
end

// 滑动
export func Swipe(var start, var end_pt, float duration) as OpResult
    AutomationDevice dev = GetActiveDevice()
    return dev.Swipe(start, end_pt, duration)
end

// 按键
