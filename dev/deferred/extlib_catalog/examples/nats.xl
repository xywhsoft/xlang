import nats

func main(...) as int
    // NATS messaging protocol helpers

    // Protocol operations
    println("Op 2 = " + nats.opName(2))
    println("Op 6 = " + nats.opName(6))

    // Subject matching
    println("foo.* vs foo.bar = " + string(nats.subjectMatch("foo.*", "foo.bar")))
    println("foo.> vs foo.a.b = " + string(nats.subjectMatch("foo.>", "foo.a.b")))

    // JetStream
    println("Storage 0 = " + nats.storageType(0))
    println("AckPolicy 2 = " + nats.ackPolicy(2))

    println("nats example: PASS")
    return 0
end
