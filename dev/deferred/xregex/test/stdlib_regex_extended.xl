// xregex 扩展包完成前保留的高级回归资产。
extern "expect_i64" func expect(int actual, int expected)
extern "expect_str" func expectStr(string actual, string expected)

expect(regex.valid("[a-z]+"), 1)
expect(regex.valid("["), 0)
expect(regex.error("[") != "", 1)
expect(regex.errorPos("[") >= 0, 1)
expect(regex.errorBytePos("[") >= 0, 1)
expect(regex.error("[a-z]+") == "", 1)
expect(regex.errorPos("[a-z]+"), -1)
expect(regex.errorBytePos("[a-z]+"), -1)

RegexBuilder builder = regex.builder("(?<word>[a-z]+)-([0-9]+)?")
builder.addFlags(regex.multiline)
Regex compiled = builder.build()
expect(compiled.valid, 1)
expect(compiled.captureCount, 3)
expectStr(compiled.captureName(1), "word")

RegexMatch found = compiled.find("你abc-42好")
expect(found.ok, 1)
expect(found.captureCount, 3)
expectStr(string(found.group(0)), "abc-42")
expectStr(string(found.group(1)), "abc")
expectStr(string(found.group("word")), "abc")
expectStr(string(found.group(2)), "42")
expect(found.groupIndex("word"), 1)
expect(found.groupIndex("missing"), -1)
expectStr(found.groupName(1), "word")
expect(found.groupStart(1), 1)
expect(found.groupEnd(1), 4)
expect(found.groupByteStart(1), 3)
expect(found.groupByteEnd(1), 6)
expect(found.groupStart(2), 5)
expect(found.groupEnd(2), 7)
expect(found.groupByteStart(2), 7)
expect(found.groupByteEnd(2), 9)

array groups = found.groups()
dict named = found.namedGroups()
expect(groups.length, 3)
expectStr(string(groups[1]), "abc")
expectStr(string(named["word"]), "abc")

RegexMatch optional = compiled.find("abc-")
expect(optional.ok, 1)
expect(optional.groupMatched(2), 0)
expect(type(optional.group(2)) == null, 1)
expect(optional.groupStart(2), -1)
expect(optional.groupByteStart(2), -1)

Regex cloned = compiled.clone()
expect(cloned.valid, 1)
expectStr(string(cloned.find("copy-7").group("word")), "copy")

RegexSet set = regex.set(["(?<word>[a-z]+)-([0-9]+)", "ready"], regex.ignoreCase)
expect(set.patternCount, 2)
RegexMatch setMatch = set.find(0, "你ABC-42好")
expect(setMatch.ok, 1)
expectStr(string(setMatch.group("word")), "ABC")
expect(set.find(-1, "ABC-42").ok, 0)
expect(set.find(2, "ABC-42").ok, 0)

RegexSet setClone = set.clone()
expect(setClone.patternCount, 2)
expect(setClone.first("READY"), 1)
