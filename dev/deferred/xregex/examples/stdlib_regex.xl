// xregex 扩展包完成前保留的 XLang 示例。
func require(string name, bool ok)
    assert ok, name + " failed"
    println(name + "=ok")
end

string text = "item-2026-ready"
int flags = regex.ignoreCase + regex.multiline + regex.dotAll + regex.ungreedy

require("basic",
    flags >= 15 and
    regex.isMatch(text, "^item-[0-9]+-[a-z]+$") and
    regex.isMatch("ITEM-2026-READY", "^item-[0-9]+-[a-z]+$", regex.ignoreCase) and
    regex.fullMatch(text, "^item-[0-9]+-[a-z]+$") and
    regex.find(text, "[0-9]+") == 5 and
    regex.find(text, "missing") == -1 and
    regex.isMatch("aa", "a+", regex.ungreedy) and
    regex.fullMatch("a\nb", "a.b", regex.dotAll))

Regex compiled = regex.compile("[0-9]+")
RegexMatch found = compiled.find(text)
require("match",
    found.ok and
    found.byteStart == 5 and
    found.byteEnd == 9 and
    found.start == 5 and
    found.end == 9 and
    string(found.text) == "2026")

RegexMatch shifted = regex.findMatch("a1 b2", "[0-9]+", 0, 2)
RegexMatch missing = compiled.find("missing")
var missingText = missing.text
require("lazy",
    shifted.ok and
    shifted.start == 4 and
    string(shifted.text) == "2" and
    not missing.ok and
    missing.start == -1 and
    missing.end == -1 and
    type(missingText) == null)

RegexSet regexSet = regex.set(["[0-9]+", "ready"], regex.ignoreCase)
array indexes = regexSet.matches("READY 2026")
require("set",
    regexSet.isMatch("READY") and
    regexSet.first("READY") == 1 and
    regexSet.first("code 2026") == 0 and
    indexes.length == 2 and
    (int(indexes[0]) == 0 or int(indexes[1]) == 0) and
    (int(indexes[0]) == 1 or int(indexes[1]) == 1))

RegexBuilder builder = regex.builder("(?<word>[a-z]+)-([0-9]+)?")
builder.addFlags(regex.multiline)
Regex namedRegex = builder.build()
RegexMatch namedMatch = namedRegex.find("你abc-42好")
array groups = namedMatch.groups()
dict namedGroups = namedMatch.namedGroups()
require("capture",
    namedRegex.captureCount == 3 and
    namedRegex.captureName(1) == "word" and
    namedMatch.captureCount == 3 and
    string(namedMatch.group("word")) == "abc" and
    namedMatch.groupStart(1) == 1 and
    namedMatch.groupByteStart(1) == 3 and
    groups.length == 3 and
    string(namedGroups["word"]) == "abc")

RegexMatch optional = namedRegex.find("abc-")
Regex cloned = namedRegex.clone()
RegexSet clonedSet = regexSet.clone()
require("diagnostic",
    regex.valid("[a-z]+") and
    not regex.valid("[") and
    regex.error("[") != "" and
    regex.errorPos("[") >= 0 and
    regex.errorBytePos("[") >= 0 and
    not optional.groupMatched(2) and
    type(optional.group(2)) == null and
    string(cloned.find("copy-7").group("word")) == "copy" and
    clonedSet.patternCount == 2)
