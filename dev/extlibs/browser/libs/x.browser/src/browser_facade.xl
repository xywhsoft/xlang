class FrameLocatorPlan extends object
	var frame_selector as string
	var locator_selector as string
	var timeout_ms as int
	var resolved as int
	var bound as int
	var failed as int

	create(string frame_selector, string locator_selector, int timeout_ms)
		self.frame_selector = frame_selector
		self.locator_selector = locator_selector
		self.timeout_ms = timeout_ms
		self.resolved = 0
		self.bound = 0
		self.failed = 0
	end

	func frame_selector_value() as string
		return self.frame_selector
	end

	func locator_selector_value() as string
		return self.locator_selector
	end

	func timeout_value() as int
		return self.timeout_ms
	end

	func resolved_value() as int
		return self.resolved
	end

	func bound_value() as int
		return self.bound
	end

	func failed_value() as int
		return self.failed
	end

	func mark_resolved() as void
		self.resolved = 1
		self.failed = 0
	end

	func mark_bound() as void
		self.bound = 1
	end

	func mark_failed() as void
		self.failed = 1
		self.resolved = 0
		self.bound = 0
	end

	func ready() as bool
		return self.frame_selector != "" and self.locator_selector != "" and self.resolved == 1 and self.bound == 1 and self.failed == 0
	end
end

class Page extends object
	var handle as point
	var session_id as string
	var target_id as string
	var default_timeout as int

	create(point handle, string session_id, string target_id)
		self.handle = handle
		self.session_id = session_id
		self.target_id = target_id
		self.default_timeout = 30000
	end

	func cdp() as point
		return self.handle
	end

	func session() as string
		return self.session_id
	end

	func target() as string
		return self.target_id
	end

	func set_default_timeout(int ms) as void
		self.default_timeout = ms
	end

	func default_timeout_ms() as int
		return self.default_timeout
	end

	func timeout_or_default(int timeout_ms) as int
		if timeout_ms > 0 then
			return timeout_ms
		end
		return self.default_timeout
	end

	func goto(string url, int timeout_ms) as string
		return x.cdp.page_goto(self.handle, self.session_id, url, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func goto_ex(string url, NavigationOptions options) as string
		string result = x.cdp.page_goto(self.handle, self.session_id, url, resolve_timeout(options.timeout_value(), self.default_timeout))
		if result != "" and options.wait_until_value() != "" and options.wait_until_value() != "none" then
			x.cdp.page_wait_load_state(self.handle, self.session_id, options.wait_until_value(), resolve_timeout(options.timeout_value(), self.default_timeout))
		end
		return result
	end

	func reload(int ignore_cache, int timeout_ms) as bool
		return x.cdp.page_reload(self.handle, self.session_id, ignore_cache, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func reload_ex(int ignore_cache, NavigationOptions options) as bool
		bool ok = x.cdp.page_reload(self.handle, self.session_id, ignore_cache, resolve_timeout(options.timeout_value(), self.default_timeout))
		if ok and options.wait_until_value() != "" and options.wait_until_value() != "none" then
			return x.cdp.page_wait_load_state(self.handle, self.session_id, options.wait_until_value(), resolve_timeout(options.timeout_value(), self.default_timeout))
		end
		return ok
	end

	func wait_load_state(string wait_until, int timeout_ms) as bool
		return x.cdp.page_wait_load_state(self.handle, self.session_id, wait_until, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func close(int timeout_ms) as bool
		if self.target_id == "" then
			return false
		end
		return x.cdp.close_target(self.handle, self.target_id, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func title(int timeout_ms) as string
		return x.cdp.page_title(self.handle, self.session_id, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func url(int timeout_ms) as string
		return x.cdp.page_url(self.handle, self.session_id, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func content(int timeout_ms) as string
		return x.cdp.page_content(self.handle, self.session_id, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func evaluate(string expression, int timeout_ms) as string
		return x.cdp.runtime_evaluate(self.handle, self.session_id, expression, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func evaluate_result(string expression, int timeout_ms) as EvaluateResult
		string raw = x.cdp.runtime_evaluate(self.handle, self.session_id, expression, resolve_timeout(timeout_ms, self.default_timeout))
		return EvaluateResult(raw, "", "")
	end

	func add_init_script(string source, int timeout_ms) as string
		return x.cdp.page_add_init_script(self.handle, self.session_id, source, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func remove_init_script(string identifier, int timeout_ms) as bool
		return x.cdp.page_remove_init_script(self.handle, self.session_id, identifier, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func screenshot(string path, int timeout_ms) as bool
		return x.cdp.page_screenshot(self.handle, self.session_id, path, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func screenshot_ex(ScreenshotOptions options, int timeout_ms) as bool
		return x.cdp.page_screenshot(self.handle, self.session_id, options.path_value(), resolve_timeout(timeout_ms, self.default_timeout))
	end

