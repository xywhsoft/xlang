		int effective_timeout = resolve_timeout(timeout_ms, self.default_timeout)
		string local_json = x.cdp.storage_get_local_storage(self.handle, self.session_id, effective_timeout)
		string session_json = x.cdp.storage_get_session_storage(self.handle, self.session_id, effective_timeout)
		return StorageState("", local_json, session_json)
