			self.option_count = self.option_count + 1
		end
		if options.root_selector_value() != "" then
			self.option_count = self.option_count + 1
		end
		self.interesting_only = options.interesting_only_value()
		self.root_selector = options.root_selector_value()
		self.root_filter_enabled = 0
		if self.root_selector != "" then
			self.root_filter_enabled = 1
		end
		self.snapshot_requested = 0
		self.applied = 0
		self.failed = 0
	end

	func option_count_value() as int
		return self.option_count
	end

	func interesting_only_value() as int
		return self.interesting_only
	end

	func root_selector_value() as string
		return self.root_selector
	end

	func root_filter_enabled_value() as int
		return self.root_filter_enabled
	end

	func snapshot_requested_value() as int
		return self.snapshot_requested
	end

	func applied_value() as int
		return self.applied
	end

	func failed_value() as int
		return self.failed
	end

	func request_snapshot() as void
		self.snapshot_requested = 1
	end

	func mark_applied() as void
		self.applied = 1
		self.failed = 0
	end

	func mark_failed() as void
		self.failed = 1
		self.applied = 0
	end

	func ready() as bool
		return self.option_count > 0 and self.snapshot_requested != 0 and self.failed == 0
	end

	func complete() as bool
		return self.applied != 0 and self.failed == 0
	end
end

