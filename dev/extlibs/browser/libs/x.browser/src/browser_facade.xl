		return x.cdp.locator_count(self.handle, self.session_id, selector, resolve_timeout(timeout_ms, self.default_timeout)) == 1
	end

	func locator_strict_result(string selector, int timeout_ms) as StrictResult
		int count_value = x.cdp.locator_count(self.handle, self.session_id, selector, resolve_timeout(timeout_ms, self.default_timeout))
		return StrictResult(selector, count_value)
	end

