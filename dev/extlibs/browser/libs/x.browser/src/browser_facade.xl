class NavigationNetworkIdlePlan extends object
	var url as string
	var timeout_ms as int
	var idle_window_ms as int
	var inflight_count as int
	var quiet_started as int
	var idle_reached as int
	var timed_out as int

	create(string url, int timeout_ms, int idle_window_ms)
		self.url = url
		self.timeout_ms = timeout_ms
		self.idle_window_ms = idle_window_ms
		self.inflight_count = 0
		self.quiet_started = 0
		self.idle_reached = 0
		self.timed_out = 0
	end

	func url_value() as string
		return self.url
	end

	func timeout_value() as int
		return self.timeout_ms
	end

	func idle_window_value() as int
		return self.idle_window_ms
	end

	func inflight_count_value() as int
		return self.inflight_count
	end

	func quiet_started_value() as int
		return self.quiet_started
	end

	func idle_reached_value() as int
		return self.idle_reached
	end

	func timed_out_value() as int
		return self.timed_out
	end

	func request_started() as void
		self.inflight_count = self.inflight_count + 1
		self.quiet_started = 0
		self.idle_reached = 0
	end

	func request_finished() as void
		if self.inflight_count > 0 then
			self.inflight_count = self.inflight_count - 1
		end
		if self.inflight_count == 0 then
			self.quiet_started = 1
		end
	end

	func mark_idle_reached() as void
		self.idle_reached = 1
		self.timed_out = 0
	end

	func mark_timeout() as void
		self.timed_out = 1
		self.idle_reached = 0
	end

	func ready() as bool
		return self.url != "" and self.timeout_ms >= 0 and self.idle_window_ms >= 0 and self.timed_out == 0
	end

	func complete() as bool
		return self.inflight_count == 0 and self.quiet_started != 0 and self.idle_reached != 0 and self.timed_out == 0
	end
end

class ChromeProcess extends object
	var handle as point

	create(point handle)
		self.handle = handle
	end

	func process() as point
		return self.handle
	end

	func is_running() as bool
		return x.cdp.process_is_running(self.handle)
	end

	func kill_tree() as bool
		return x.cdp.process_kill_tree(self.handle)
	end

	func dispose() as bool
		if self.handle == null then
			return false
		end
		bool ok = x.cdp.process_dispose(self.handle)
		self.handle = null
		return ok
	end
end

