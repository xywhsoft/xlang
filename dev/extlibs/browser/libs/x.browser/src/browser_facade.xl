class LaunchPreparePlan extends object
	var executable_path as string
	var user_data_dir as string
	var port as int
	var use_auto_port as int
	var needs_user_data_dir as int
	var prepared as int

	create(LaunchOptions options, LaunchPolicy policy)
		self.executable_path = options.executable_path_value()
		self.user_data_dir = options.user_data_dir_value()
		self.port = options.port_value()
		self.use_auto_port = 0
		if policy.uses_auto_port() and self.port <= 0 then
			self.use_auto_port = 1
		end
		self.needs_user_data_dir = 0
		if policy.requires_isolated_profile() and self.user_data_dir == "" then
			self.needs_user_data_dir = 1
		end
		self.prepared = 0
	end

	func executable_path_value() as string
		return self.executable_path
	end

	func user_data_dir_value() as string
		return self.user_data_dir
	end

	func port_value() as int
		return self.port
	end

	func use_auto_port_value() as int
		return self.use_auto_port
	end

	func needs_user_data_dir_value() as int
		return self.needs_user_data_dir
	end

	func prepared_value() as int
		return self.prepared
	end

	func mark_prepared() as void
		self.prepared = 1
	end

	func ready_to_launch() as bool
		return self.executable_path != "" and self.needs_user_data_dir == 0 and self.prepared != 0
	end
end

class LaunchCleanupPlan extends object
	var user_data_dir as string
	var keep_user_data_dir as int
	var browser_closed as int
	var process_disposed as int
	var cleanup_requested as int

	create(string user_data_dir, int keep_user_data_dir)
		self.user_data_dir = user_data_dir
		self.keep_user_data_dir = keep_user_data_dir
		self.browser_closed = 0
		self.process_disposed = 0
		self.cleanup_requested = 0
	end

	func user_data_dir_value() as string
		return self.user_data_dir
	end

	func keep_user_data_dir_value() as int
		return self.keep_user_data_dir
	end

	func mark_browser_closed() as void
		self.browser_closed = 1
	end

	func mark_process_disposed() as void
		self.process_disposed = 1
	end

	func request_cleanup() as void
		self.cleanup_requested = 1
	end

	func browser_closed_value() as int
		return self.browser_closed
	end

	func process_disposed_value() as int
		return self.process_disposed
	end

	func cleanup_requested_value() as int
		return self.cleanup_requested
	end

	func should_cleanup_user_data_dir() as bool
		return self.user_data_dir != "" and self.keep_user_data_dir == 0 and self.cleanup_requested == 1
	end
end

class UserDataDirLifecyclePlan extends object
	var base_dir as string
	var user_data_dir as string
	var keep_user_data_dir as int
	var created as int
	var release_requested as int
	var cleanup_requested as int

	create(string base_dir, string user_data_dir, int keep_user_data_dir)
		self.base_dir = base_dir
		self.user_data_dir = user_data_dir
		self.keep_user_data_dir = keep_user_data_dir
		self.created = 0
		if user_data_dir != "" then
			self.created = 1
		end
		self.release_requested = 0
		self.cleanup_requested = 0
	end

	func base_dir_value() as string
		return self.base_dir
	end

	func user_data_dir_value() as string
		return self.user_data_dir
	end

	func keep_user_data_dir_value() as int
		return self.keep_user_data_dir
	end

	func created_value() as int
		return self.created
	end

	func release_requested_value() as int
		return self.release_requested
	end

	func cleanup_requested_value() as int
		return self.cleanup_requested
	end

	func mark_created(string user_data_dir) as void
		self.user_data_dir = user_data_dir
		if user_data_dir != "" then
			self.created = 1
		end
	end

	func request_release() as void
		self.release_requested = 1
	end

	func request_cleanup() as void
		self.cleanup_requested = 1
	end

	func ready() as bool
		return self.created != 0 and self.user_data_dir != ""
	end

	func should_cleanup() as bool
		return self.user_data_dir != "" and self.keep_user_data_dir == 0 and self.release_requested != 0 and self.cleanup_requested != 0
	end
end

class LaunchResult extends object
	var process_handle as point
	var browser_handle as point
	var user_data_dir as string
	var port_text as string
	var error_message as string
	var keep_user_data_dir as int

	create(point process_handle, point browser_handle, string user_data_dir, string port_text, string error_message, int keep_flag)
		self.process_handle = process_handle
		self.browser_handle = browser_handle
		self.user_data_dir = user_data_dir
		self.port_text = port_text
		self.error_message = error_message
		self.keep_user_data_dir = keep_flag
	end

	func process() as point
		return self.process_handle
	end

	func browser() as point
		return self.browser_handle
	end

	func process_object() as ChromeProcess
		return ChromeProcess(self.process_handle)
	end

	func user_data_dir_value() as string
		return self.user_data_dir
	end

	func port_text_value() as string
		return self.port_text
	end

	func error_value() as string
		return self.error_message
	end

	func keep_user_data_dir_value() as int
		return self.keep_user_data_dir
	end

	func set_keep_user_data_dir(int value) as void
		self.keep_user_data_dir = value
	end

	func is_running() as bool
		return x.cdp.process_is_running(self.process_handle)
	end

	func cleanup_plan() as LaunchCleanupPlan
		return LaunchCleanupPlan(self.user_data_dir, self.keep_user_data_dir)
	end
end

class LaunchConnectPlan extends object
	var user_data_dir as string
	var port_text as string
	var timeout_ms as int
	var connect_requested as int
	var connected as int
	var failed as int
	var cleanup_on_failure as int

	create(LaunchResult result, int timeout_ms)
		self.user_data_dir = result.user_data_dir_value()
		self.port_text = result.port_text_value()
		self.timeout_ms = timeout_ms
		self.connect_requested = 0
		self.connected = 0
		self.failed = 0
		self.cleanup_on_failure = 0
		if result.keep_user_data_dir_value() == 0 then
			self.cleanup_on_failure = 1
		end
	end

	func user_data_dir_value() as string
		return self.user_data_dir
	end

	func port_text_value() as string
		return self.port_text
	end

	func timeout_value() as int
		return self.timeout_ms
	end

	func connect_requested_value() as int
		return self.connect_requested
	end

	func connected_value() as int
		return self.connected
	end

	func failed_value() as int
		return self.failed
	end

	func cleanup_on_failure_value() as int
		return self.cleanup_on_failure
	end

	func request_connect() as void
		self.connect_requested = 1
	end

	func mark_connected() as void
		self.connected = 1
		self.failed = 0
	end

	func mark_failed() as void
		self.failed = 1
		self.connected = 0
	end

	func ready() as bool
		return self.user_data_dir != "" and self.connect_requested != 0 and self.failed == 0
	end

	func complete() as bool
		return self.connected != 0 and self.failed == 0
	end
end

