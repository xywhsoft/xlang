		self.parsed = 1
		self.failed = 0
	end

	func mark_failed() as void
		self.failed = 1
		self.parsed = 0
	end

	func type_matches() as bool
		return self.expected_type == "" or self.actual_type == self.expected_type
	end

	func ready() as bool
		return self.raw_json != "" and self.value_text != "" and self.failed == 0
	end

	func complete() as bool
		return self.parsed != 0 and self.failed == 0 and self.value_text != ""
	end
end

