	var error_event_json as string
	var network_count as int
	var console_count as int
	var error_count as int

	create()
		self.network_event_json = ""
		self.console_event_json = ""
		self.error_event_json = ""
		self.network_count = 0
		self.console_count = 0
		self.error_count = 0
	end

	func record_network(string event_json) as void
		self.network_event_json = event_json
		self.network_count = self.network_count + 1
	end

	func record_console(string event_json) as void
		self.console_event_json = event_json
		self.console_count = self.console_count + 1
	end

	func record_error(string event_json) as void
		self.error_event_json = event_json
		self.error_count = self.error_count + 1
	end

	func last_network() as string
		return self.network_event_json
	end

	func last_console() as string
		return self.console_event_json
	end

	func last_error() as string
		return self.error_event_json
	end

	func network_count_value() as int
		return self.network_count
	end

	func console_count_value() as int
		return self.console_count
	end

	func error_count_value() as int
		return self.error_count
	end

	func total_count() as int
		return self.network_count + self.console_count + self.error_count
	end

	func clear() as void
		self.network_event_json = ""
		self.console_event_json = ""
		self.error_event_json = ""
		self.network_count = 0
		self.console_count = 0
		self.error_count = 0
	end
end

class PageEventWindow extends object
	var capacity as int
	var event_count as int
	var dropped_count as int
	var network_count as int
	var console_count as int
	var error_count as int
	var last_kind as string
	var last_event_json as string

	create(int capacity)
		self.capacity = capacity
		self.event_count = 0
		self.dropped_count = 0
		self.network_count = 0
		self.console_count = 0
		self.error_count = 0
		self.last_kind = ""
		self.last_event_json = ""
	end

	func record(string kind, string event_json) as void
		self.event_count = self.event_count + 1
		if self.capacity > 0 and self.event_count > self.capacity then
			self.dropped_count = self.dropped_count + 1
		end
		self.last_kind = kind
		self.last_event_json = event_json
		if kind == "network" then
			self.network_count = self.network_count + 1
		end
		if kind == "console" then
			self.console_count = self.console_count + 1
		end
		if kind == "error" then
			self.error_count = self.error_count + 1
		end
	end

	func record_network(string event_json) as void
		self.event_count = self.event_count + 1
		if self.capacity > 0 and self.event_count > self.capacity then
			self.dropped_count = self.dropped_count + 1
		end
		self.last_kind = "network"
		self.last_event_json = event_json
		self.network_count = self.network_count + 1
	end

	func record_console(string event_json) as void
		self.event_count = self.event_count + 1
		if self.capacity > 0 and self.event_count > self.capacity then
			self.dropped_count = self.dropped_count + 1
		end
		self.last_kind = "console"
		self.last_event_json = event_json
		self.console_count = self.console_count + 1
	end

	func record_error(string event_json) as void
		self.event_count = self.event_count + 1
		if self.capacity > 0 and self.event_count > self.capacity then
			self.dropped_count = self.dropped_count + 1
		end
		self.last_kind = "error"
		self.last_event_json = event_json
		self.error_count = self.error_count + 1
	end

	func capacity_value() as int
		return self.capacity
	end

	func count() as int
		return self.event_count
	end

	func dropped_value() as int
		return self.dropped_count
	end

	func network_count_value() as int
		return self.network_count
	end

	func console_count_value() as int
		return self.console_count
	end

	func error_count_value() as int
		return self.error_count
	end

	func last_kind_value() as string
		return self.last_kind
	end

	func last_event() as string
		return self.last_event_json
	end

	func clear() as void
		self.event_count = 0
		self.dropped_count = 0
		self.network_count = 0
		self.console_count = 0
		self.error_count = 0
		self.last_kind = ""
		self.last_event_json = ""
	end
end

class EventDispatchPlan extends object
	var session_id as string
	var capacity as int
	var queued_count as int
	var dispatched_count as int
	var dropped_count as int
	var canceled as int
	var last_event_json as string

	create(string session_id, int capacity)
		self.session_id = session_id
		self.capacity = capacity
		self.queued_count = 0
		self.dispatched_count = 0
		self.dropped_count = 0
		self.canceled = 0
		self.last_event_json = ""
	end

	func session_value() as string
		return self.session_id
	end

	func capacity_value() as int
		return self.capacity
	end

	func queued_value() as int
		return self.queued_count
	end

	func dispatched_value() as int
		return self.dispatched_count
	end

	func dropped_value() as int
		return self.dropped_count
	end

	func canceled_value() as int
		return self.canceled
	end

	func last_event() as string
		return self.last_event_json
	end

	func enqueue(string event_json) as void
		if self.canceled != 0 then
			self.dropped_count = self.dropped_count + 1
		else
			self.queued_count = self.queued_count + 1
			if self.capacity > 0 and self.queued_count > self.capacity then
				self.dropped_count = self.dropped_count + 1
			end
			self.last_event_json = event_json
		end
	end

	func dispatch_one() as void
		if self.queued_count > 0 then
			self.queued_count = self.queued_count - 1
			self.dispatched_count = self.dispatched_count + 1
		end
	end

	func cancel() as void
		self.canceled = 1
	end

	func drained() as bool
		return self.queued_count == 0
	end
end

class CallbackRegistryPlan extends object
	var event_kind_count as int
	var handler_count as int
	var enabled as int
	var dispatching as int
	var canceled as int

	create()
		self.event_kind_count = 0
		self.handler_count = 0
		self.enabled = 0
		self.dispatching = 0
		self.canceled = 0
	end

	func event_kind_count_value() as int
		return self.event_kind_count
	end

	func handler_count_value() as int
		return self.handler_count
	end

	func enabled_value() as int
		return self.enabled
	end

	func dispatching_value() as int
		return self.dispatching
	end

	func canceled_value() as int
		return self.canceled
	end

	func register_event_kind() as void
		self.event_kind_count = self.event_kind_count + 1
	end

	func register_handler() as void
		self.handler_count = self.handler_count + 1
	end

	func enable() as void
		self.enabled = 1
		self.canceled = 0
	end

	func begin_dispatch() as void
		if self.enabled != 0 and self.handler_count > 0 then
			self.dispatching = 1
		end
	end

	func cancel() as void
		self.canceled = 1
		self.dispatching = 0
	end

	func ready() as bool
		return self.enabled != 0 and self.event_kind_count > 0 and self.handler_count > 0 and self.canceled == 0
	end

	func active() as bool
		return self.dispatching != 0 and self.canceled == 0
	end
end

