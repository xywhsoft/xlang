func launch_with_options(LaunchOptions options) as LaunchResult
	point process = x.cdp.launch_chrome(options.executable_path, options.user_data_dir, options.port, options.headless)
	int keep_flag = options.keep_user_data_dir
	if process == null then
		auto failed = LaunchResult(null, null, options.user_data_dir, "", x.cdp.last_error(), 0)
		failed.set_keep_user_data_dir(keep_flag)
		return failed
	end
	auto result = LaunchResult(process, null, options.user_data_dir, "", "", 0)
	result.set_keep_user_data_dir(keep_flag)
	return result
end

