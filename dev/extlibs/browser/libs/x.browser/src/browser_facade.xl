		return self.quality
	end

	func every_nth_frame_value() as int
		return self.every_nth_frame
	end

	func start_requested_value() as int
		return self.start_requested
	end

	func stop_requested_value() as int
		return self.stop_requested
	end

	func frame_count_value() as int
		return self.frame_count
	end

	func failed_value() as int
		return self.failed
	end

	func request_start() as void
		self.start_requested = 1
		self.stop_requested = 0
	end

	func record_frame() as void
		self.frame_count = self.frame_count + 1
	end

	func request_stop() as void
		self.stop_requested = 1
	end

	func mark_failed() as void
		self.failed = 1
	end

	func ready() as bool
		return self.format != "" and self.every_nth_frame > 0 and self.failed == 0
	end

	func active() as bool
		return self.start_requested != 0 and self.stop_requested == 0 and self.failed == 0
	end

	func complete() as bool
		return self.start_requested != 0 and self.stop_requested != 0 and self.failed == 0
	end
end

