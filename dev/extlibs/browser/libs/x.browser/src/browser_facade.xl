class NetworkWaitPlan extends object
	var wait_for as string
	var pattern_kind as string
	var pattern_text as string
	var timeout_ms as int
	var matched_event_json as string
	var matched_count as int
	var timed_out as int
	var cancelled as int

	create(string wait_for, string pattern_kind, string pattern_text, int timeout_ms)
		self.wait_for = wait_for
		self.pattern_kind = pattern_kind
		self.pattern_text = pattern_text
		self.timeout_ms = timeout_ms
		self.matched_event_json = ""
		self.matched_count = 0
		self.timed_out = 0
		self.cancelled = 0
	end

	func wait_for_value() as string
		return self.wait_for
	end

	func kind_value() as string
		return self.pattern_kind
	end

	func pattern_value() as string
		return self.pattern_text
	end

	func timeout_value() as int
		return self.timeout_ms
	end

	func matched_event() as string
		return self.matched_event_json
	end

	func matched_count_value() as int
		return self.matched_count
	end

	func timed_out_value() as int
		return self.timed_out
	end

	func cancelled_value() as int
		return self.cancelled
	end

	func record_match(string event_json) as void
		self.matched_event_json = event_json
		self.matched_count = self.matched_count + 1
		self.timed_out = 0
	end

	func mark_timeout() as void
		self.timed_out = 1
	end

	func cancel() as void
		self.cancelled = 1
	end

	func ready() as bool
		return self.cancelled == 0 and self.wait_for != "" and self.pattern_text != "" and self.timeout_ms >= 0
	end

	func matched() as bool
		return self.matched_count > 0 and self.matched_event_json != ""
	end
end

