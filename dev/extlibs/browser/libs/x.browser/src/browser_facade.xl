class RouteRegistry extends object
	var route_count as int
	var enabled as int
	var last_pattern as string
	var last_action_json as string

	create()
		self.route_count = 0
		self.enabled = 0
		self.last_pattern = ""
		self.last_action_json = ""
	end

	func register(string pattern, string action_json) as void
		self.route_count = self.route_count + 1
		self.last_pattern = pattern
		self.last_action_json = action_json
		self.enabled = 1
	end

	func register_plan(RoutePlan plan) as void
		self.route_count = self.route_count + 1
		self.last_pattern = plan.pattern_value()
		self.last_action_json = plan.action_value()
		self.enabled = 1
	end

	func unroute(string pattern) as void
		if self.last_pattern == pattern then
			self.last_pattern = ""
			self.last_action_json = ""
		end
		if self.route_count > 0 then
			self.route_count = self.route_count - 1
		end
		if self.route_count == 0 then
			self.enabled = 0
		end
	end

	func clear() as void
		self.route_count = 0
		self.enabled = 0
		self.last_pattern = ""
		self.last_action_json = ""
	end

	func count() as int
		return self.route_count
	end

	func enabled_value() as int
		return self.enabled
	end

	func last_pattern_value() as string
		return self.last_pattern
	end

	func last_action_value() as string
		return self.last_action_json
	end
end

class RouteHandlerRegistryPlan extends object
	var handler_count as int
	var active_count as int
	var highest_priority as int
	var last_pattern as string
	var last_action_json as string
	var cancelled as int

	create()
		self.handler_count = 0
		self.active_count = 0
		self.highest_priority = 0
		self.last_pattern = ""
		self.last_action_json = ""
		self.cancelled = 0
	end

	func handler_count_value() as int
		return self.handler_count
	end

	func active_count_value() as int
		return self.active_count
	end

	func highest_priority_value() as int
		return self.highest_priority
	end

	func last_pattern_value() as string
		return self.last_pattern
	end

	func last_action_value() as string
		return self.last_action_json
	end

	func cancelled_value() as int
		return self.cancelled
	end

	func register(RouteMatchPlan plan) as void
		self.handler_count = self.handler_count + 1
		if plan.enabled_value() != 0 then
			self.active_count = self.active_count + 1
		end
		if self.handler_count == 1 or plan.priority_value() > self.highest_priority then
			self.highest_priority = plan.priority_value()
		end
		self.last_pattern = plan.pattern_value()
		self.last_action_json = plan.action_value()
		self.cancelled = 0
	end

	func disable_one() as void
		if self.active_count > 0 then
			self.active_count = self.active_count - 1
		end
	end

	func cancel() as void
		self.cancelled = 1
		self.active_count = 0
	end

	func ready() as bool
		return self.cancelled == 0 and self.active_count > 0 and self.last_pattern != "" and self.last_action_json != ""
	end
end

