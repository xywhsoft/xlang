import x.cdp

func resolve_timeout(int timeout_ms, int default_timeout) as int
	if timeout_ms > 0 then
		return timeout_ms
	end
	return default_timeout
end

class ActionOptions extends object
	var timeout_ms as int
	var force as int

	create(int timeout_ms, int force)
		self.timeout_ms = timeout_ms
		self.force = force
	end

	func timeout_value() as int
		return self.timeout_ms
	end

	func force_value() as int
		return self.force
	end
end

class KeyboardActionPlan extends object
	var key as string
	var input_text as string
	var repeat_count as int
	var delay_ms as int

	create(string key, string input_text, int repeat_count, int delay_ms)
		self.key = key
		self.input_text = input_text
		self.repeat_count = repeat_count
		self.delay_ms = delay_ms
	end

	func key_value() as string
		return self.key
	end

	func text_value() as string
		return self.input_text
	end

	func repeat_count_value() as int
		return self.repeat_count
	end

	func delay_value() as int
		return self.delay_ms
	end
end

class MouseActionPlan extends object
	var x as int
	var y as int
	var button as string
	var click_count as int
	var delta_x as int
	var delta_y as int

	create(int x, int y, string button, int click_count, int delta_x, int delta_y)
