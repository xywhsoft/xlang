		self.path = options.path_value()
		self.option_count = 0
		if options.format_value() != "" then
			self.option_count = self.option_count + 1
		end
		if options.full_page_value() != 0 then
			self.option_count = self.option_count + 1
		end
		self.clip_enabled = 0
		if options.has_clip() then
			self.clip_enabled = 1
			self.option_count = self.option_count + 1
		end
		self.full_page = options.full_page_value()
		self.applied = 0
		self.failed = 0
	end

	func path_value() as string
		return self.path
	end

	func option_count_value() as int
		return self.option_count
	end

	func clip_enabled_value() as int
		return self.clip_enabled
	end

	func full_page_value() as int
		return self.full_page
	end

	func applied_value() as int
		return self.applied
	end

	func failed_value() as int
		return self.failed
	end

	func mark_applied() as void
		self.applied = 1
		self.failed = 0
	end

	func mark_failed() as void
		self.failed = 1
		self.applied = 0
	end

	func ready() as bool
		return self.path != "" and self.option_count > 0 and self.failed == 0
	end

	func complete() as bool
		return self.applied != 0 and self.failed == 0
	end
end

