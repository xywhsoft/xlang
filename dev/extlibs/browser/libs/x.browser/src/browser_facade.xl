func wrap_context(point handle, string context_id) as BrowserContext
	return BrowserContext(handle, context_id, 30000)
end

func wrap_context_options(point handle, string context_id, ContextOptions options) as BrowserContext
	auto context = BrowserContext(handle, context_id, 30000)
	if options.viewport_width > 0 and options.viewport_height > 0 then
		context.set_viewport(options.viewport_width, options.viewport_height, options.viewport_scale, options.viewport_mobile)
	end
	if options.user_agent != "" then
		context.set_user_agent(options.user_agent)
	end
	if options.locale != "" then
		context.set_locale(options.locale)
	end
	if options.timezone_id != "" then
		context.set_timezone(options.timezone_id)
	end
	if options.geolocation_enabled != 0 then
		context.set_geolocation(options.geolocation_latitude_e7, options.geolocation_longitude_e7, options.geolocation_accuracy)
	end
	if options.offline_enabled != 0 then
		context.set_offline(options.offline)
	end
	if options.cache_disabled_enabled != 0 then
		context.set_cache_disabled(options.cache_disabled)
	end
	if options.permissions_json != "" then
		context.set_permissions(options.permissions_json, options.permissions_origin)
	end
	return context
end

