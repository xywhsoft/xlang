		return self.parsed
	end

	func applied_value() as int
		return self.applied
	end

	func failed_value() as int
		return self.failed
	end

	func mark_parsed() as void
		self.parsed = 1
		self.failed = 0
	end

	func mark_applied() as void
		self.applied = 1
	end

	func mark_failed() as void
		self.failed = 1
		self.applied = 0
	end

