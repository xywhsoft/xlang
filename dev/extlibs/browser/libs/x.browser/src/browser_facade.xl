class ContextPageCreatePlan extends object
	var context_id as string
	var target_id as string
	var session_id as string
	var default_count as int
	var page_created as int
	var defaults_requested as int
	var defaults_applied as int
	var failed as int

	create(string context_id, string target_id, string session_id, ContextApplyPlan defaults_plan)
		self.context_id = context_id
		self.target_id = target_id
		self.session_id = session_id
		self.default_count = defaults_plan.total_enabled()
		self.page_created = 0
		if target_id != "" and session_id != "" then
			self.page_created = 1
		end
		self.defaults_requested = 0
		self.defaults_applied = 0
		self.failed = 0
	end

	func context_id_value() as string
		return self.context_id
	end

	func target_id_value() as string
		return self.target_id
	end

	func session_value() as string
		return self.session_id
	end

	func default_count_value() as int
		return self.default_count
	end

	func page_created_value() as int
		return self.page_created
	end

	func defaults_requested_value() as int
		return self.defaults_requested
	end

	func defaults_applied_value() as int
		return self.defaults_applied
	end

	func failed_value() as int
		return self.failed
	end

	func request_defaults() as void
		self.defaults_requested = 1
	end

	func mark_defaults_applied() as void
		self.defaults_applied = 1
		self.failed = 0
	end

	func mark_failed() as void
		self.failed = 1
		self.defaults_applied = 0
	end

	func ready() as bool
		return self.context_id != "" and self.page_created != 0 and self.failed == 0
	end

	func ready_for_defaults() as bool
		return self.context_id != "" and self.page_created != 0 and self.default_count > 0 and self.defaults_requested != 0 and self.failed == 0
	end

	func complete() as bool
		return self.context_id != "" and self.page_created != 0 and self.failed == 0 and (self.default_count == 0 or self.defaults_applied != 0)
	end
end

class ContextOptions extends object
	var viewport_width as int
	var viewport_height as int
	var viewport_scale as int
	var viewport_mobile as int
	var user_agent as string
	var locale as string
	var timezone_id as string
	var geolocation_latitude_e7 as int
	var geolocation_longitude_e7 as int
	var geolocation_accuracy as int
	var geolocation_enabled as int
	var offline as int
	var offline_enabled as int
	var cache_disabled as int
	var cache_disabled_enabled as int
	var permissions_json as string
	var permissions_origin as string

	create()
		self.viewport_width = 0
		self.viewport_height = 0
		self.viewport_scale = 1
		self.viewport_mobile = 0
		self.user_agent = ""
		self.locale = ""
		self.timezone_id = ""
		self.geolocation_latitude_e7 = 0
		self.geolocation_longitude_e7 = 0
		self.geolocation_accuracy = 0
		self.geolocation_enabled = 0
		self.offline = 0
		self.offline_enabled = 0
		self.cache_disabled = 0
		self.cache_disabled_enabled = 0
		self.permissions_json = ""
		self.permissions_origin = ""
	end

	func set_viewport(int width, int height, int device_scale_factor, int mobile) as void
		self.viewport_width = width
		self.viewport_height = height
		self.viewport_scale = device_scale_factor
		self.viewport_mobile = mobile
	end

	func set_user_agent(string value) as void
		self.user_agent = value
	end

	func set_locale(string value) as void
		self.locale = value
	end

	func set_timezone(string value) as void
		self.timezone_id = value
	end

	func set_geolocation(int latitude_e7, int longitude_e7, int accuracy) as void
		self.geolocation_latitude_e7 = latitude_e7
		self.geolocation_longitude_e7 = longitude_e7
		self.geolocation_accuracy = accuracy
		self.geolocation_enabled = 1
	end

	func set_offline(int value) as void
		self.offline = value
		self.offline_enabled = 1
	end

	func set_cache_disabled(int value) as void
		self.cache_disabled = value
		self.cache_disabled_enabled = 1
	end

	func set_permissions(string permissions_json, string origin) as void
		self.permissions_json = permissions_json
		self.permissions_origin = origin
	end

	func viewport_width_value() as int
		return self.viewport_width
	end

	func viewport_height_value() as int
		return self.viewport_height
	end

	func user_agent_value() as string
		return self.user_agent
	end

	func locale_value() as string
		return self.locale
	end

	func timezone_value() as string
		return self.timezone_id
	end

	func permissions_value() as string
		return self.permissions_json
	end

	func permissions_origin_value() as string
		return self.permissions_origin
	end

	func apply_plan(string storage_state_json) as ContextApplyPlan
		int viewport_count = 0
		if self.viewport_width > 0 and self.viewport_height > 0 then
			viewport_count = 1
		end
		int user_agent_count = 0
		if self.user_agent != "" then
			user_agent_count = 1
		end
		int locale_count = 0
		if self.locale != "" then
			locale_count = 1
		end
		int timezone_count = 0
		if self.timezone_id != "" then
			timezone_count = 1
		end
		int geolocation_count = 0
		if self.geolocation_enabled != 0 then
			geolocation_count = 1
		end
		int offline_count = 0
		if self.offline_enabled != 0 then
			offline_count = 1
		end
		int cache_count = 0
		if self.cache_disabled_enabled != 0 then
			cache_count = 1
		end
		int permissions_count = 0
		if self.permissions_json != "" then
			permissions_count = 1
		end
		int storage_count = 0
		if storage_state_json != "" then
			storage_count = 1
		end
		return ContextApplyPlan(viewport_count, user_agent_count, locale_count, timezone_count, geolocation_count, offline_count, cache_count, permissions_count, storage_count)
	end
end

class ContextOptionsParsePlan extends object
