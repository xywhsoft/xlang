		self.request_id = request_id
		self.request_event_json = ""
		self.response_event_json = ""
		self.body_json = ""
		self.paired = 0
		self.body_received = 0
		self.failed = 0
	end

	func request_id_value() as string
		return self.request_id
	end

	func request_raw() as string
		return self.request_event_json
	end

	func response_raw() as string
