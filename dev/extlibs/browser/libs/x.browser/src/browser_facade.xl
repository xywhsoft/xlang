class BrowserSession extends object
	var handle as point
	var context_count as int
	var page_count as int
	var target_count as int
	var closed as int

	create(point handle)
		self.handle = handle
		self.context_count = 0
		self.page_count = 0
		self.target_count = 0
		self.closed = 0
	end

	func cdp() as point
		return self.handle
	end

	func context_count_value() as int
		return self.context_count
	end

	func page_count_value() as int
		return self.page_count
	end

	func target_count_value() as int
		return self.target_count
	end

	func closed_value() as int
		return self.closed
	end

	func remember_context(BrowserContext context) as void
		self.context_count = self.context_count + 1
	end

	func remember_page(Page page) as void
		self.page_count = self.page_count + 1
	end

	func remember_target(Target target) as void
		self.target_count = self.target_count + 1
	end

	func close_plan() as ResourceClosePlan
		return ResourceClosePlan(self.context_count, self.page_count, self.target_count)
	end

	func close() as bool
		self.closed = 1
		if self.handle == null then
			return false
		end
		bool closed_ok = x.cdp.close(self.handle)
		x.cdp.dispose(self.handle)
		self.handle = null
		return closed_ok
	end
end

