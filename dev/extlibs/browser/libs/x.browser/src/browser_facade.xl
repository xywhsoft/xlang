class StorageStateBuilder extends object
	var cookies_json as string
	var origin_count as int
	var last_origin as string
	var last_local_storage_json as string
	var last_session_storage_json as string

	create()
		self.cookies_json = ""
		self.origin_count = 0
		self.last_origin = ""
		self.last_local_storage_json = ""
		self.last_session_storage_json = ""
	end

	func set_cookies(string cookies_json) as void
		self.cookies_json = cookies_json
	end

	func add_origin(string origin, string local_storage_json, string session_storage_json) as void
		self.origin_count = self.origin_count + 1
		self.last_origin = origin
		self.last_local_storage_json = local_storage_json
		self.last_session_storage_json = session_storage_json
	end

	func add_origin_state(StorageOriginState origin_state) as void
		self.origin_count = self.origin_count + 1
		self.last_origin = origin_state.origin_value()
		self.last_local_storage_json = origin_state.local_storage_value()
		self.last_session_storage_json = origin_state.session_storage_value()
	end

	func cookies_value() as string
		return self.cookies_json
	end

	func origin_count_value() as int
		return self.origin_count
	end

	func last_origin_value() as string
		return self.last_origin
	end

	func last_local_storage_value() as string
		return self.last_local_storage_json
	end

	func last_session_storage_value() as string
		return self.last_session_storage_json
	end

	func to_storage_state() as StorageState
		return StorageState(self.cookies_json, self.last_local_storage_json, self.last_session_storage_json)
	end
end

