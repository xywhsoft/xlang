class Target extends object
	var handle as point
	var target_id as string
	var default_timeout as int

	create(point handle, string target_id, int default_timeout)
		self.handle = handle
		self.target_id = target_id
		self.default_timeout = default_timeout
	end

	func cdp() as point
		return self.handle
	end

	func id() as string
		return self.target_id
	end

	func set_default_timeout(int ms) as void
		self.default_timeout = ms
	end

	func default_timeout_ms() as int
		return self.default_timeout
	end

	func attach(int flatten, int timeout_ms) as string
		return x.cdp.attach_target(self.handle, self.target_id, flatten, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func attach_page(int timeout_ms) as Page
		string session_id = x.cdp.attach_target(self.handle, self.target_id, 1, resolve_timeout(timeout_ms, self.default_timeout))
		if session_id == "" then
			return Page(self.handle, "", "")
		end
		return Page(self.handle, session_id, self.target_id)
	end

	func close(int timeout_ms) as bool
		if self.target_id == "" then
			return false
		end
		return x.cdp.close_target(self.handle, self.target_id, resolve_timeout(timeout_ms, self.default_timeout))
	end
end

class BrowserContext extends object
	var handle as point
	var context_id as string
	var default_timeout as int
	var viewport_width as int
	var viewport_height as int
	var viewport_scale as int
	var viewport_mobile as int
	var user_agent as string
	var locale as string
	var timezone_id as string
	var geolocation_latitude_e7 as int
	var geolocation_longitude_e7 as int
	var geolocation_accuracy as int
	var geolocation_enabled as int
	var offline as int
	var offline_enabled as int
	var cache_disabled as int
	var cache_disabled_enabled as int
	var permissions_json as string
	var permissions_origin as string

	create(point handle, string context_id, int default_timeout)
		self.handle = handle
		self.context_id = context_id
		self.default_timeout = default_timeout
		self.viewport_width = 0
		self.viewport_height = 0
		self.viewport_scale = 1
		self.viewport_mobile = 0
		self.user_agent = ""
		self.locale = ""
		self.timezone_id = ""
		self.geolocation_latitude_e7 = 0
		self.geolocation_longitude_e7 = 0
		self.geolocation_accuracy = 0
		self.geolocation_enabled = 0
		self.offline = 0
		self.offline_enabled = 0
		self.cache_disabled = 0
		self.cache_disabled_enabled = 0
		self.permissions_json = ""
		self.permissions_origin = ""
	end

	func cdp() as point
		return self.handle
	end

	func id() as string
		return self.context_id
	end

	func set_default_timeout(int ms) as void
		self.default_timeout = ms
	end

	func default_timeout_ms() as int
		return self.default_timeout
	end

	func timeout_or_default(int timeout_ms) as int
		if timeout_ms > 0 then
			return timeout_ms
		end
		return self.default_timeout
	end

	func set_viewport(int width, int height, int device_scale_factor, int mobile) as void
		self.viewport_width = width
		self.viewport_height = height
		self.viewport_scale = device_scale_factor
		self.viewport_mobile = mobile
	end

	func viewport_width_value() as int
		return self.viewport_width
	end

	func viewport_height_value() as int
		return self.viewport_height
	end

	func set_user_agent(string value) as void
		self.user_agent = value
	end

	func user_agent_value() as string
		return self.user_agent
	end

	func set_locale(string value) as void
		self.locale = value
	end

	func locale_value() as string
		return self.locale
	end

	func set_timezone(string value) as void
		self.timezone_id = value
	end

	func timezone_value() as string
		return self.timezone_id
	end

	func set_geolocation(int latitude_e7, int longitude_e7, int accuracy) as void
		self.geolocation_latitude_e7 = latitude_e7
		self.geolocation_longitude_e7 = longitude_e7
		self.geolocation_accuracy = accuracy
		self.geolocation_enabled = 1
	end

	func set_offline(int value) as void
		self.offline = value
		self.offline_enabled = 1
	end

	func set_cache_disabled(int value) as void
		self.cache_disabled = value
		self.cache_disabled_enabled = 1
	end

	func set_permissions(string permissions_json, string origin) as void
		self.permissions_json = permissions_json
		self.permissions_origin = origin
	end

	func permissions_value() as string
		return self.permissions_json
	end

	func permissions_origin_value() as string
		return self.permissions_origin
	end

	func apply_permissions(int timeout_ms) as bool
		if self.permissions_json == "" then
			return false
		end
		return x.cdp.browser_grant_permissions(self.handle, self.context_id, self.permissions_json, self.permissions_origin, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func apply_defaults(string session_id, int timeout_ms) as bool
		if session_id == "" then
			return false
		end
		int effective_timeout = resolve_timeout(timeout_ms, self.default_timeout)
		bool ok = true
		if self.viewport_width > 0 and self.viewport_height > 0 then
			ok = x.cdp.page_set_viewport(self.handle, session_id, self.viewport_width, self.viewport_height, self.viewport_scale, self.viewport_mobile, effective_timeout) and ok
		end
		if self.user_agent != "" then
			ok = x.cdp.page_set_user_agent(self.handle, session_id, self.user_agent, effective_timeout) and ok
		end
		if self.locale != "" then
			ok = x.cdp.page_set_locale(self.handle, session_id, self.locale, effective_timeout) and ok
		end
		if self.timezone_id != "" then
			ok = x.cdp.page_set_timezone(self.handle, session_id, self.timezone_id, effective_timeout) and ok
		end
		if self.geolocation_enabled != 0 then
			ok = x.cdp.page_set_geolocation(self.handle, session_id, self.geolocation_latitude_e7, self.geolocation_longitude_e7, self.geolocation_accuracy, effective_timeout) and ok
		end
		if self.offline_enabled != 0 then
			ok = x.cdp.page_set_offline(self.handle, session_id, self.offline, effective_timeout) and ok
		end
		if self.cache_disabled_enabled != 0 then
			ok = x.cdp.network_set_cache_disabled(self.handle, session_id, self.cache_disabled, effective_timeout) and ok
		end
		return ok
	end

	func close(int timeout_ms) as bool
		return x.cdp.dispose_context(self.handle, self.context_id, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func new_page(string url, int timeout_ms) as string
		return x.cdp.create_target_context(self.handle, self.context_id, url, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func new_page_object(string url, int timeout_ms) as Page
		int effective_timeout = resolve_timeout(timeout_ms, self.default_timeout)
		string target_id = x.cdp.create_target_context(self.handle, self.context_id, url, effective_timeout)
		if target_id == "" then
			return Page(self.handle, "", "")
		end
		string session_id = x.cdp.attach_target(self.handle, target_id, 1, effective_timeout)
		if session_id != "" then
			if self.viewport_width > 0 and self.viewport_height > 0 then
				x.cdp.page_set_viewport(self.handle, session_id, self.viewport_width, self.viewport_height, self.viewport_scale, self.viewport_mobile, effective_timeout)
			end
			if self.user_agent != "" then
				x.cdp.page_set_user_agent(self.handle, session_id, self.user_agent, effective_timeout)
			end
			if self.locale != "" then
				x.cdp.page_set_locale(self.handle, session_id, self.locale, effective_timeout)
			end
			if self.timezone_id != "" then
				x.cdp.page_set_timezone(self.handle, session_id, self.timezone_id, effective_timeout)
			end
			if self.geolocation_enabled != 0 then
				x.cdp.page_set_geolocation(self.handle, session_id, self.geolocation_latitude_e7, self.geolocation_longitude_e7, self.geolocation_accuracy, effective_timeout)
			end
			if self.offline_enabled != 0 then
				x.cdp.page_set_offline(self.handle, session_id, self.offline, effective_timeout)
			end
			if self.cache_disabled_enabled != 0 then
				x.cdp.network_set_cache_disabled(self.handle, session_id, self.cache_disabled, effective_timeout)
			end
			if self.permissions_json != "" then
				x.cdp.browser_grant_permissions(self.handle, self.context_id, self.permissions_json, self.permissions_origin, effective_timeout)
			end
		end
		return Page(self.handle, session_id, target_id)
	end

	func cookies(int timeout_ms) as string
		return x.cdp.storage_get_cookies(self.handle, self.context_id, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func storage_state(int timeout_ms) as StorageState
		return StorageState(x.cdp.storage_get_cookies(self.handle, self.context_id, resolve_timeout(timeout_ms, self.default_timeout)), "", "")
	end

	func set_cookies(string cookies_json, int timeout_ms) as bool
		return x.cdp.storage_set_cookies(self.handle, self.context_id, cookies_json, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func clear_cookies(int timeout_ms) as bool
		return x.cdp.storage_clear_cookies(self.handle, self.context_id, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func grant_permissions(string permissions_json, string origin, int timeout_ms) as bool
		return x.cdp.browser_grant_permissions(self.handle, self.context_id, permissions_json, origin, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func clear_permissions(int timeout_ms) as bool
		return x.cdp.browser_clear_permissions(self.handle, self.context_id, resolve_timeout(timeout_ms, self.default_timeout))
	end
end

class Browser extends object
	var handle as point
	var default_timeout as int

	create(point handle)
		self.handle = handle
		self.default_timeout = 30000
	end

	func cdp() as point
		return self.handle
	end

	func is_open() as bool
		return x.cdp.is_open(self.handle)
	end

	func set_default_timeout(int ms) as void
		self.default_timeout = ms
	end

	func default_timeout_ms() as int
		return self.default_timeout
	end

	func timeout_or_default(int timeout_ms) as int
		if timeout_ms > 0 then
			return timeout_ms
		end
		return self.default_timeout
	end

	func close() as bool
		if self.handle == null then
			return false
		end
		bool closed = x.cdp.close(self.handle)
		x.cdp.dispose(self.handle)
		self.handle = null
		return closed
	end

	func new_page(string url, int timeout_ms) as string
		return x.cdp.create_target(self.handle, url, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func new_target(string url, int timeout_ms) as Target
		string target_id = x.cdp.create_target(self.handle, url, resolve_timeout(timeout_ms, self.default_timeout))
		return Target(self.handle, target_id, self.default_timeout)
	end

	func new_context_object(int timeout_ms) as BrowserContext
		int effective_timeout = resolve_timeout(timeout_ms, self.default_timeout)
		string context_id = x.cdp.create_context(self.handle, effective_timeout)
		return BrowserContext(self.handle, context_id, self.default_timeout)
	end

	func new_page_object(string url, int timeout_ms) as Page
		int effective_timeout = resolve_timeout(timeout_ms, self.default_timeout)
		string target_id = x.cdp.create_target(self.handle, url, effective_timeout)
		if target_id == "" then
			return Page(self.handle, "", "")
		end
		string session_id = x.cdp.attach_target(self.handle, target_id, 1, effective_timeout)
		return Page(self.handle, session_id, target_id)
	end

	func wait_download_object(int timeout_ms) as Download
		int effective_timeout = resolve_timeout(timeout_ms, self.default_timeout)
		string event_json = x.cdp.wait_download(self.handle, effective_timeout)
		return Download(self.handle, event_json, self.default_timeout)
	end
end

