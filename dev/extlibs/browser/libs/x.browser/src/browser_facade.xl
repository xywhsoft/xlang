func connect(string cdp_url, int timeout_ms) as point
	if cdp_url.starts_with("http://") or cdp_url.starts_with("https://") then
		return x.cdp.connect_http(cdp_url, timeout_ms)
	end
	return x.cdp.connect(cdp_url, timeout_ms)
end

