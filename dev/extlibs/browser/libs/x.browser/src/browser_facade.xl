		return self.failed
	end

	func set_request_event(string event_json) as void
		self.request_event_json = event_json
	end

	func set_response_event(string event_json) as void
		self.response_event_json = event_json
	end

	func set_body(string body_json) as void
		self.body_json = body_json
		self.body_received = 1
	end

	func mark_paired() as void
		self.paired = 1
		self.failed = 0
	end

	func mark_failed() as void
		self.failed = 1
		self.paired = 0
	end

	func ready() as bool
		return self.request_id != "" and self.request_event_json != "" and self.response_event_json != "" and self.failed == 0
	end

	func complete() as bool
