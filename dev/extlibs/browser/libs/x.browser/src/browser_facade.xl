func new_page_object(point browser, string url, int timeout_ms) as Page
	string target_id = x.cdp.create_target(browser, url, timeout_ms)
	if target_id == "" then
		return Page(browser, "", "")
	end
	string session_id = x.cdp.attach_target(browser, target_id, 1, timeout_ms)
	return Page(browser, session_id, target_id)
end

