class ContextApplyPlan extends object
	var viewport_count as int
	var user_agent_count as int
	var locale_count as int
	var timezone_count as int
	var geolocation_count as int
	var offline_count as int
	var cache_count as int
	var permissions_count as int
	var storage_state_count as int

	create(int viewport_count, int user_agent_count, int locale_count, int timezone_count, int geolocation_count, int offline_count, int cache_count, int permissions_count, int storage_state_count)
		self.viewport_count = viewport_count
		self.user_agent_count = user_agent_count
		self.locale_count = locale_count
		self.timezone_count = timezone_count
		self.geolocation_count = geolocation_count
		self.offline_count = offline_count
		self.cache_count = cache_count
		self.permissions_count = permissions_count
		self.storage_state_count = storage_state_count
	end

	func viewport_value() as int
		return self.viewport_count
	end

	func user_agent_value() as int
		return self.user_agent_count
	end

	func locale_value() as int
		return self.locale_count
	end

	func timezone_value() as int
		return self.timezone_count
	end

	func geolocation_value() as int
		return self.geolocation_count
	end

	func offline_value() as int
		return self.offline_count
	end

	func cache_value() as int
		return self.cache_count
	end

	func permissions_value() as int
		return self.permissions_count
	end

	func storage_state_value() as int
		return self.storage_state_count
	end

	func total_enabled() as int
		return self.viewport_count + self.user_agent_count + self.locale_count + self.timezone_count + self.geolocation_count + self.offline_count + self.cache_count + self.permissions_count + self.storage_state_count
	end
end

class ContextDefaultApplyPlan extends object
	var session_id as string
	var default_count as int
	var timeout_ms as int
	var applied_count as int
	var completed as int
	var failed as int

	create(string session_id, int default_count, int timeout_ms)
		self.session_id = session_id
		self.default_count = default_count
		self.timeout_ms = timeout_ms
		self.applied_count = 0
		self.completed = 0
		self.failed = 0
	end

	func session_value() as string
		return self.session_id
	end

	func default_count_value() as int
		return self.default_count
	end

	func timeout_value() as int
		return self.timeout_ms
	end

	func applied_count_value() as int
		return self.applied_count
	end

	func completed_value() as int
		return self.completed
	end

	func failed_value() as int
		return self.failed
	end

	func record_applied() as void
		self.applied_count = self.applied_count + 1
	end

	func mark_completed() as void
		self.completed = 1
		self.failed = 0
	end

	func mark_failed() as void
		self.failed = 1
		self.completed = 0
	end

	func ready() as bool
		return self.session_id != "" and self.default_count > 0 and self.timeout_ms >= 0 and self.failed == 0
	end

	func complete() as bool
		return self.completed == 1 and self.applied_count >= self.default_count and self.failed == 0
	end
end

class ContextLifecyclePlan extends object
