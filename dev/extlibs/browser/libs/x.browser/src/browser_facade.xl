class ResourceCascadeClosePlan extends object
	var context_count as int
	var page_count as int
	var target_count as int
	var closed_pages as int
	var closed_contexts as int
	var closed_targets as int
	var browser_closed as int
	var failed as int

	create(ResourceClosePlan plan)
		self.context_count = plan.context_count_value()
		self.page_count = plan.page_count_value()
		self.target_count = plan.target_count_value()
		self.closed_pages = 0
		self.closed_contexts = 0
		self.closed_targets = 0
		self.browser_closed = 0
		self.failed = 0
	end

	func context_count_value() as int
		return self.context_count
	end

	func page_count_value() as int
		return self.page_count
	end

	func target_count_value() as int
		return self.target_count
	end

	func closed_pages_value() as int
		return self.closed_pages
	end

	func closed_contexts_value() as int
		return self.closed_contexts
	end

	func closed_targets_value() as int
		return self.closed_targets
	end

	func browser_closed_value() as int
		return self.browser_closed
	end

	func failed_value() as int
		return self.failed
	end

	func mark_pages_closed() as void
		self.closed_pages = self.page_count
	end

	func mark_contexts_closed() as void
		self.closed_contexts = self.context_count
	end

	func mark_targets_closed() as void
		self.closed_targets = self.target_count
	end

	func mark_browser_closed() as void
		self.browser_closed = 1
	end

	func mark_failed() as void
		self.failed = 1
	end

	func ready() as bool
		return self.failed == 0 and (self.context_count > 0 or self.page_count > 0 or self.target_count > 0)
	end

	func complete() as bool
		return self.failed == 0 and self.closed_pages >= self.page_count and self.closed_contexts >= self.context_count and self.closed_targets >= self.target_count and self.browser_closed != 0
	end
end

