	func x_value() as int
		return self.x
	end

	func y_value() as int
		return self.y
	end

	func button_value() as string
		return self.button
	end

	func click_count_value() as int
		return self.click_count
	end

	func delta_x_value() as int
		return self.delta_x
	end

	func delta_y_value() as int
		return self.delta_y
	end
end

class FileUploadPlan extends object
	var selector as string
	var files_json as string
	var file_count as int

	create(string selector, string files_json, int file_count)
		self.selector = selector
		self.files_json = files_json
		self.file_count = file_count
	end

	func selector_value() as string
		return self.selector
	end

	func files_value() as string
		return self.files_json
	end

	func file_count_value() as int
		return self.file_count
	end

	func has_files() as bool
		return self.file_count > 0
	end
end

class DragPlan extends object
	var source_selector as string
	var target_selector as string
	var start_x as int
	var start_y as int
	var end_x as int
	var end_y as int

	create(string source_selector, string target_selector, int start_x, int start_y, int end_x, int end_y)
		self.source_selector = source_selector
		self.target_selector = target_selector
		self.start_x = start_x
		self.start_y = start_y
		self.end_x = end_x
		self.end_y = end_y
	end

	func source_value() as string
		return self.source_selector
	end

	func target_value() as string
		return self.target_selector
	end

	func start_x_value() as int
		return self.start_x
	end

	func start_y_value() as int
		return self.start_y
	end

	func end_x_value() as int
		return self.end_x
	end

	func end_y_value() as int
		return self.end_y
	end
end

class Selector extends object
	var kind as string
	var value_text as string

	create(string kind, string value_text)
		self.kind = kind
		self.value_text = value_text
	end

	func kind_value() as string
		return self.kind
	end

	func value() as string
		return self.value_text
	end

	func is_css() as bool
		return self.kind == "css"
	end

	func query() as string
		if self.kind == "css" then
			return self.value_text
		end
		return self.kind + "=" + self.value_text
	end
end

class SelectorParsePlan extends object
	var kind as string
	var value_text as string
	var normalized_query as string
	var parsed as int
	var unsupported as int

	create(string kind, string value_text, string normalized_query)
		self.kind = kind
		self.value_text = value_text
		self.normalized_query = normalized_query
		self.parsed = 0
		self.unsupported = 0
	end

	func kind_value() as string
		return self.kind
	end

	func value() as string
		return self.value_text
	end

	func query() as string
		return self.normalized_query
	end

	func parsed_value() as int
		return self.parsed
	end

	func unsupported_value() as int
		return self.unsupported
	end

	func is_supported() as bool
		if self.kind == "css" then
			return true
		end
		if self.kind == "text" then
			return true
		end
		if self.kind == "testid" then
			return true
		end
		if self.kind == "xpath" then
			return true
		end
		return false
	end

	func mark_parsed() as void
		self.parsed = 1
		self.unsupported = 0
	end

	func mark_unsupported() as void
		self.unsupported = 1
		self.parsed = 0
	end

	func ready() as bool
		return self.parsed == 1 and self.unsupported == 0
	end
end

class SelectorGroup extends object
	var selector_count as int
	var last_query_text as string
	var strict as int

	create(int strict)
		self.selector_count = 0
		self.last_query_text = ""
		self.strict = strict
	end

	func add(Selector selector) as void
		self.selector_count = self.selector_count + 1
		self.last_query_text = selector.query()
	end

	func add_query(string query_text) as void
		self.selector_count = self.selector_count + 1
		self.last_query_text = query_text
	end

	func count() as int
		return self.selector_count
	end

	func last_query() as string
		return self.last_query_text
	end

	func strict_value() as int
		return self.strict
	end

	func clear() as void
		self.selector_count = 0
		self.last_query_text = ""
	end
end

class StrictResult extends object
	var selector_text as string
	var count_value as int
	var message as string

	create(string selector_text, int count_value)
		self.selector_text = selector_text
		self.count_value = count_value
		if count_value == 1 then
			self.message = ""
		else
			self.message = "strict mode violation"
		end
	end

	func selector_value() as string
		return self.selector_text
	end

	func count() as int
		return self.count_value
	end

	func ok() as bool
		return self.count_value == 1
	end

	func message_value() as string
		return self.message
	end
end

class ActionabilityState extends object
	var selector_text as string
	var raw_json as string
	var visible_value as int
	var enabled_value as int
	var editable_value as int
	var receives_events_value as int
	var stable_value as int

	create(string selector_text, string raw_json, int visible_value, int enabled_value, int editable_value, int receives_events_value, int stable_value)
		self.selector_text = selector_text
		self.raw_json = raw_json
		self.visible_value = visible_value
		self.enabled_value = enabled_value
		self.editable_value = editable_value
		self.receives_events_value = receives_events_value
		self.stable_value = stable_value
	end

	func selector_value() as string
		return self.selector_text
	end

	func raw() as string
		return self.raw_json
	end

	func visible() as int
		return self.visible_value
	end

	func enabled() as int
		return self.enabled_value
	end

	func editable() as int
		return self.editable_value
	end

	func receives_events() as int
		return self.receives_events_value
	end

	func stable() as int
		return self.stable_value
	end

	func ready() as bool
		return self.visible_value == 1 and self.enabled_value == 1 and self.receives_events_value == 1 and self.stable_value == 1
	end
end

class ActionabilityPolicy extends object
	var require_visible as int
	var require_enabled as int
	var require_editable as int
	var require_receives_events as int
	var require_stable as int

	create(int require_visible, int require_enabled, int require_editable, int require_receives_events, int require_stable)
		self.require_visible = require_visible
		self.require_enabled = require_enabled
		self.require_editable = require_editable
		self.require_receives_events = require_receives_events
		self.require_stable = require_stable
	end

	func require_visible_value() as int
		return self.require_visible
	end

	func require_enabled_value() as int
		return self.require_enabled
	end

	func require_editable_value() as int
		return self.require_editable
	end

	func require_receives_events_value() as int
		return self.require_receives_events
	end

	func require_stable_value() as int
		return self.require_stable
	end

	func satisfied(ActionabilityState state) as bool
		if self.require_visible == 1 and state.visible() != 1 then
			return false
		end
		if self.require_enabled == 1 and state.enabled() != 1 then
			return false
		end
		if self.require_editable == 1 and state.editable() != 1 then
			return false
		end
		if self.require_receives_events == 1 and state.receives_events() != 1 then
			return false
		end
		if self.require_stable == 1 and state.stable() != 1 then
			return false
		end
		return true
	end
end

class ActionabilityCheckPlan extends object
	var selector_text as string
	var action_name as string
	var timeout_ms as int
	var force as int
	var checks_requested as int
	var satisfied as int
	var failed as int

	create(string selector_text, string action_name, int timeout_ms, int force)
		self.selector_text = selector_text
		self.action_name = action_name
		self.timeout_ms = timeout_ms
		self.force = force
		self.checks_requested = 0
		self.satisfied = 0
		self.failed = 0
	end

	func selector_value() as string
		return self.selector_text
	end

	func action_value() as string
		return self.action_name
	end

	func timeout_value() as int
		return self.timeout_ms
	end

	func force_value() as int
		return self.force
	end

	func checks_requested_value() as int
		return self.checks_requested
	end

	func satisfied_value() as int
		return self.satisfied
	end

	func failed_value() as int
		return self.failed
	end

	func request_checks() as void
		self.checks_requested = 1
	end

	func mark_satisfied() as void
		self.satisfied = 1
		self.failed = 0
	end

	func mark_failed() as void
		self.failed = 1
		self.satisfied = 0
	end

	func should_check() as bool
		return self.force == 0 and self.checks_requested != 0
	end

	func ready() as bool
		return self.checks_requested != 0 and self.satisfied == 1 and self.failed == 0
	end
end

class Locator extends object
	var handle as point
	var session_id as string
	var selector as string
	var default_timeout as int

	create(point handle, string session_id, string selector, int default_timeout)
		self.handle = handle
		self.session_id = session_id
		self.selector = selector
		self.default_timeout = default_timeout
	end

	func set_default_timeout(int ms) as void
		self.default_timeout = ms
	end

	func default_timeout_ms() as int
		return self.default_timeout
	end

	func selector_value() as string
		return self.selector
	end

	func timeout_or_default(int timeout_ms) as int
		if timeout_ms > 0 then
			return timeout_ms
		end
		return self.default_timeout
	end

	func click(int timeout_ms) as bool
		return x.cdp.locator_click(self.handle, self.session_id, self.selector, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func click_ex(ActionOptions options) as bool
		return x.cdp.locator_click(self.handle, self.session_id, self.selector, resolve_timeout(options.timeout_value(), self.default_timeout))
	end

	func fill(string value, int timeout_ms) as bool
		return x.cdp.locator_fill(self.handle, self.session_id, self.selector, value, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func fill_ex(string value, ActionOptions options) as bool
		return x.cdp.locator_fill(self.handle, self.session_id, self.selector, value, resolve_timeout(options.timeout_value(), self.default_timeout))
	end

	func hover(int timeout_ms) as bool
		return x.cdp.locator_hover(self.handle, self.session_id, self.selector, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func hover_ex(ActionOptions options) as bool
		return x.cdp.locator_hover(self.handle, self.session_id, self.selector, resolve_timeout(options.timeout_value(), self.default_timeout))
	end

	func check(int checked, int timeout_ms) as bool
		return x.cdp.locator_check(self.handle, self.session_id, self.selector, checked, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func check_ex(int checked, ActionOptions options) as bool
		return x.cdp.locator_check(self.handle, self.session_id, self.selector, checked, resolve_timeout(options.timeout_value(), self.default_timeout))
	end

	func select(string value_text, int timeout_ms) as bool
		return x.cdp.locator_select(self.handle, self.session_id, self.selector, value_text, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func select_ex(string value_text, ActionOptions options) as bool
		return x.cdp.locator_select(self.handle, self.session_id, self.selector, value_text, resolve_timeout(options.timeout_value(), self.default_timeout))
	end

	func press(string key, int timeout_ms) as bool
		return x.cdp.locator_press(self.handle, self.session_id, self.selector, key, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func type(string text, int timeout_ms) as bool
		return x.cdp.locator_type(self.handle, self.session_id, self.selector, text, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func text(int timeout_ms) as string
		return x.cdp.locator_text(self.handle, self.session_id, self.selector, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func count(int timeout_ms) as int
		return x.cdp.locator_count(self.handle, self.session_id, self.selector, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func state(int timeout_ms) as string
		return x.cdp.locator_state(self.handle, self.session_id, self.selector, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func actionability(int timeout_ms) as ActionabilityState
		string raw = x.cdp.locator_state(self.handle, self.session_id, self.selector, resolve_timeout(timeout_ms, self.default_timeout))
		return ActionabilityState(self.selector, raw, 0, 0, 0, 0, 0)
	end

	func strict(int timeout_ms) as bool
		return x.cdp.locator_count(self.handle, self.session_id, self.selector, resolve_timeout(timeout_ms, self.default_timeout)) == 1
	end

	func strict_result(int timeout_ms) as StrictResult
		int count_value = x.cdp.locator_count(self.handle, self.session_id, self.selector, resolve_timeout(timeout_ms, self.default_timeout))
		return StrictResult(self.selector, count_value)
	end
end

class Dialog extends object
	var handle as point
	var session_id as string
	var event_json as string
	var dialog_type as string
	var message as string
	var default_value as string
	var default_timeout as int

	create(point handle, string session_id, string event_json, int default_timeout)
		self.handle = handle
		self.session_id = session_id
		self.event_json = event_json
		self.dialog_type = ""
		self.message = ""
		self.default_value = ""
		self.default_timeout = default_timeout
	end

	func raw() as string
		return self.event_json
	end

	func set_info(string dialog_type, string message, string default_value) as void
		self.dialog_type = dialog_type
		self.message = message
		self.default_value = default_value
	end

	func type_value() as string
		return self.dialog_type
	end

	func message_value() as string
		return self.message
	end

	func default_value_text() as string
		return self.default_value
	end

	func set_default_timeout(int ms) as void
		self.default_timeout = ms
	end

	func default_timeout_ms() as int
		return self.default_timeout
	end

	func accept(int timeout_ms) as bool
		return x.cdp.dialog_accept(self.handle, self.session_id, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func dismiss(int timeout_ms) as bool
		return x.cdp.dialog_dismiss(self.handle, self.session_id, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func accept_with_text(string prompt_text, int timeout_ms) as bool
		return x.cdp.dialog_accept_text(self.handle, self.session_id, prompt_text, resolve_timeout(timeout_ms, self.default_timeout))
	end
end

class DialogInfo extends object
	var dialog_type as string
	var message as string
	var default_value as string
	var accepted as int
	var dismissed as int

	create(string dialog_type, string message, string default_value)
		self.dialog_type = dialog_type
		self.message = message
		self.default_value = default_value
		self.accepted = 0
		self.dismissed = 0
	end

	func type_value() as string
		return self.dialog_type
	end

	func message_value() as string
		return self.message
	end

	func default_value_text() as string
		return self.default_value
	end

	func mark_accepted() as void
		self.accepted = 1
		self.dismissed = 0
	end

	func mark_dismissed() as void
		self.dismissed = 1
		self.accepted = 0
	end

	func accepted_value() as int
		return self.accepted
	end

	func dismissed_value() as int
		return self.dismissed
	end
end

class DialogActionPlan extends object
	var action_name as string
	var prompt_text as string
	var timeout_ms as int
	var handled as int

	create(string action_name, string prompt_text, int timeout_ms)
		self.action_name = action_name
		self.prompt_text = prompt_text
		self.timeout_ms = timeout_ms
		self.handled = 0
	end

	func action_value() as string
		return self.action_name
	end

	func prompt_text_value() as string
		return self.prompt_text
	end

	func timeout_value() as int
		return self.timeout_ms
	end

	func handled_value() as int
		return self.handled
	end

	func mark_handled() as void
		self.handled = 1
	end

	func is_accept() as bool
		return self.action_name == "accept"
	end

	func is_dismiss() as bool
		return self.action_name == "dismiss"
	end

	func needs_prompt_text() as bool
		return self.action_name == "accept" and self.prompt_text != ""
	end
end

class Download extends object
	var handle as point
	var event_json as string
	var suggested_filename as string
	var download_path as string
	var save_as_path as string
	var state as string
	var default_timeout as int

	create(point handle, string event_json, int default_timeout)
		self.handle = handle
		self.event_json = event_json
		self.suggested_filename = ""
		self.download_path = ""
		self.save_as_path = ""
		self.state = ""
		self.default_timeout = default_timeout
	end

	func raw() as string
		return self.event_json
	end

	func set_info(string suggested_filename, string download_path, string save_as_path, string state) as void
		self.suggested_filename = suggested_filename
		self.download_path = download_path
		self.save_as_path = save_as_path
		self.state = state
	end

	func suggested_filename_value() as string
		return self.suggested_filename
	end

	func path_value() as string
		return self.download_path
	end

	func save_as_path_value() as string
		return self.save_as_path
	end

	func state_value() as string
		return self.state
	end

	func set_default_timeout(int ms) as void
		self.default_timeout = ms
	end

	func default_timeout_ms() as int
		return self.default_timeout
	end

	func progress(int timeout_ms) as string
		return x.cdp.wait_download_progress(self.handle, resolve_timeout(timeout_ms, self.default_timeout))
	end
end

class DownloadInfo extends object
	var suggested_filename as string
	var download_path as string
	var save_as_path as string
	var state as string
	var received_bytes as int
	var total_bytes as int

	create(string suggested_filename, string download_path, string save_as_path, string state, int received_bytes, int total_bytes)
		self.suggested_filename = suggested_filename
		self.download_path = download_path
		self.save_as_path = save_as_path
		self.state = state
		self.received_bytes = received_bytes
		self.total_bytes = total_bytes
	end

	func suggested_filename_value() as string
		return self.suggested_filename
	end

	func path_value() as string
		return self.download_path
	end

	func save_as_path_value() as string
		return self.save_as_path
	end

	func state_value() as string
		return self.state
	end

	func received_bytes_value() as int
		return self.received_bytes
	end

	func total_bytes_value() as int
		return self.total_bytes
	end

	func completed() as bool
		return self.state == "completed"
	end
end

class DownloadSavePlan extends object
	var suggested_filename as string
	var save_as_path as string
	var received_bytes as int
	var total_bytes as int
	var completed as int
	var failed as int

	create(string suggested_filename, string save_as_path, int total_bytes)
		self.suggested_filename = suggested_filename
		self.save_as_path = save_as_path
		self.received_bytes = 0
		self.total_bytes = total_bytes
		self.completed = 0
		self.failed = 0
	end

	func suggested_filename_value() as string
		return self.suggested_filename
	end

	func save_as_path_value() as string
		return self.save_as_path
	end

	func received_bytes_value() as int
		return self.received_bytes
	end

	func total_bytes_value() as int
		return self.total_bytes
	end

	func completed_value() as int
		return self.completed
	end

	func failed_value() as int
		return self.failed
	end

	func record_progress(int received_bytes, int total_bytes) as void
		self.received_bytes = received_bytes
		self.total_bytes = total_bytes
	end

	func mark_completed() as void
		self.completed = 1
		self.failed = 0
	end

	func mark_failed() as void
		self.failed = 1
		self.completed = 0
	end

	func ready_to_save() as bool
		return self.save_as_path != "" and self.failed == 0
	end

	func progress_complete() as bool
		return self.total_bytes > 0 and self.received_bytes >= self.total_bytes
	end
end

class Route extends object
	var handle as point
	var session_id as string
	var request_id as string
	var event_json as string
	var default_timeout as int

	create(point handle, string session_id, string request_id, string event_json, int default_timeout)
		self.handle = handle
		self.session_id = session_id
		self.request_id = request_id
		self.event_json = event_json
		self.default_timeout = default_timeout
	end

	func id() as string
		return self.request_id
	end

	func raw() as string
		return self.event_json
	end

	func set_default_timeout(int ms) as void
		self.default_timeout = ms
	end

	func default_timeout_ms() as int
		return self.default_timeout
	end

	func apply(string action_json, int timeout_ms) as bool
		return x.cdp.route_apply(self.handle, self.session_id, self.request_id, action_json, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func abort(string error_reason, int timeout_ms) as bool
		return x.cdp.fetch_abort(self.handle, self.session_id, self.request_id, error_reason, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func continue_request(int timeout_ms) as bool
		return x.cdp.fetch_continue(self.handle, self.session_id, self.request_id, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func fulfill_text(int status_code, string content_type, string body, int timeout_ms) as bool
		return x.cdp.fetch_fulfill_text(self.handle, self.session_id, self.request_id, status_code, content_type, body, resolve_timeout(timeout_ms, self.default_timeout))
	end
end

class RoutePlan extends object
	var url_pattern as string
	var action_json as string
	var default_timeout as int

	create(string url_pattern, string action_json, int default_timeout)
		self.url_pattern = url_pattern
		self.action_json = action_json
		self.default_timeout = default_timeout
	end

	func pattern_value() as string
		return self.url_pattern
	end

	func action_value() as string
		return self.action_json
	end

	func set_default_timeout(int ms) as void
		self.default_timeout = ms
	end

	func default_timeout_ms() as int
		return self.default_timeout
	end

	func enable(point handle, string session_id, int timeout_ms) as bool
		return x.cdp.fetch_enable(handle, session_id, self.url_pattern, resolve_timeout(timeout_ms, self.default_timeout))
	end

	func apply(Route route, int timeout_ms) as bool
		return route.apply(self.action_json, resolve_timeout(timeout_ms, self.default_timeout))
	end
end

class RouteMatchPlan extends object
	var pattern_kind as string
	var pattern_text as string
	var action_json as string
	var priority as int
	var enabled as int

	create(string pattern_kind, string pattern_text, string action_json, int priority)
		self.pattern_kind = pattern_kind
		self.pattern_text = pattern_text
		self.action_json = action_json
		self.priority = priority
		self.enabled = 1
	end

	func kind_value() as string
		return self.pattern_kind
	end

	func pattern_value() as string
		return self.pattern_text
	end

	func action_value() as string
		return self.action_json
	end

	func priority_value() as int
		return self.priority
	end

	func enabled_value() as int
		return self.enabled
	end

	func disable() as void
		self.enabled = 0
	end

	func enable() as void
		self.enabled = 1
	end

	func is_glob() as bool
		return self.pattern_kind == "glob"
	end

	func is_regex() as bool
		return self.pattern_kind == "regex"
	end

	func is_active() as bool
		return self.enabled != 0 and self.pattern_text != ""
	end
end

class RouteDispatchPlan extends object
	var pending_request_id as string
	var pending_action_json as string
	var pending_count as int
	var handled_count as int
	var cancelled as int

	create()
		self.pending_request_id = ""
		self.pending_action_json = ""
		self.pending_count = 0
		self.handled_count = 0
		self.cancelled = 0
	end

	func request_id_value() as string
		return self.pending_request_id
	end

	func action_value() as string
		return self.pending_action_json
	end

	func pending_count_value() as int
		return self.pending_count
	end

	func handled_count_value() as int
		return self.handled_count
	end

	func cancelled_value() as int
		return self.cancelled
	end

	func enqueue(string request_id, string action_json) as void
		self.pending_request_id = request_id
		self.pending_action_json = action_json
		self.pending_count = self.pending_count + 1
		self.cancelled = 0
	end

	func mark_handled() as void
		if self.pending_count > 0 then
			self.pending_count = self.pending_count - 1
			self.handled_count = self.handled_count + 1
		end
		if self.pending_count == 0 then
			self.pending_request_id = ""
			self.pending_action_json = ""
		end
	end

	func cancel() as void
		self.cancelled = 1
		self.pending_count = 0
		self.pending_request_id = ""
		self.pending_action_json = ""
	end

	func ready_to_dispatch() as bool
		return self.cancelled == 0 and self.pending_count > 0 and self.pending_request_id != "" and self.pending_action_json != ""
	end
end

class RouteAction extends object
	var action_json as string
