import x.cdp

class TraceArchive extends object
	var trace_dir as string
	var manifest_path as string
	var zip_path as string
	var viewer_path as string

	create(string trace_dir, string manifest_path, string zip_path)
		self.trace_dir = trace_dir
		self.manifest_path = manifest_path
		self.zip_path = zip_path
		self.viewer_path = ""
	end

	func dir() as string
		return self.trace_dir
	end

	func manifest() as string
		return self.manifest_path
	end

	func zip() as string
		return self.zip_path
	end

	func ready() as bool
		return self.trace_dir != "" and self.manifest_path != "" and self.zip_path != ""
	end

	func set_viewer(string viewer_path) as void
		self.viewer_path = viewer_path
	end

	func viewer() as string
		return self.viewer_path
	end
end

class TraceViewerPlan extends object
	var trace_dir as string
	var manifest_path as string
	var viewer_path as string
	var include_network as int
	var include_console as int
	var include_errors as int

	create(string trace_dir, string manifest_path, string viewer_path, int include_network, int include_console, int include_errors)
		self.trace_dir = trace_dir
		self.manifest_path = manifest_path
		self.viewer_path = viewer_path
		self.include_network = include_network
		self.include_console = include_console
		self.include_errors = include_errors
	end

	func dir() as string
		return self.trace_dir
	end

	func manifest() as string
		return self.manifest_path
	end

	func viewer() as string
		return self.viewer_path
	end

	func include_network_value() as int
		return self.include_network
	end

	func include_console_value() as int
		return self.include_console
	end

	func include_errors_value() as int
		return self.include_errors
	end
end

class TraceZipPlan extends object
	var trace_dir as string
	var manifest_path as string
	var zip_path as string
	var viewer_path as string
	var entry_count as int
	var packed as int

	create(string trace_dir, string manifest_path, string zip_path, string viewer_path)
		self.trace_dir = trace_dir
		self.manifest_path = manifest_path
		self.zip_path = zip_path
		self.viewer_path = viewer_path
		self.entry_count = 0
		self.packed = 0
	end

	func dir() as string
		return self.trace_dir
	end

	func manifest() as string
		return self.manifest_path
	end

	func zip() as string
		return self.zip_path
	end

	func viewer() as string
		return self.viewer_path
	end

	func entry_count_value() as int
		return self.entry_count
	end

	func packed_value() as int
		return self.packed
	end

	func remember_entry() as void
		self.entry_count = self.entry_count + 1
	end

	func mark_packed() as void
		self.packed = 1
	end

	func ready() as bool
		return self.trace_dir != "" and self.manifest_path != "" and self.zip_path != ""
	end
end

class TraceActionWindow extends object
	var capacity as int
	var action_count as int
	var dropped_count as int
	var last_action_json as string
	var previous_action_json as string

	create(int capacity)
		self.capacity = capacity
		self.action_count = 0
		self.dropped_count = 0
		self.last_action_json = ""
		self.previous_action_json = ""
	end

	func capacity_value() as int
		return self.capacity
	end

	func count() as int
		return self.action_count
	end

	func dropped() as int
		return self.dropped_count
	end

	func last_action() as string
		return self.last_action_json
	end

	func previous_action() as string
		return self.previous_action_json
	end

	func record(string action_json) as void
		if self.capacity > 0 and self.action_count >= self.capacity then
			self.dropped_count = self.dropped_count + 1
		else
			self.action_count = self.action_count + 1
		end
		self.previous_action_json = self.last_action_json
		self.last_action_json = action_json
	end

	func clear() as void
		self.action_count = 0
		self.dropped_count = 0
		self.last_action_json = ""
		self.previous_action_json = ""
	end
end

class TraceEventPlan extends object
	var trace_dir as string
	var network_count as int
	var console_count as int
	var error_count as int
	var last_kind as string
	var last_event_json as string

	create(string trace_dir)
		self.trace_dir = trace_dir
		self.network_count = 0
		self.console_count = 0
		self.error_count = 0
		self.last_kind = ""
		self.last_event_json = ""
	end

	func dir() as string
		return self.trace_dir
	end

	func network_count_value() as int
		return self.network_count
	end

	func console_count_value() as int
		return self.console_count
	end

	func error_count_value() as int
		return self.error_count
	end

	func total_count() as int
		return self.network_count + self.console_count + self.error_count
	end

	func last_kind_value() as string
		return self.last_kind
	end

	func last_event() as string
		return self.last_event_json
	end

	func record_network(string event_json) as void
		self.network_count = self.network_count + 1
		self.last_kind = "network"
		self.last_event_json = event_json
	end

	func record_console(string event_json) as void
		self.console_count = self.console_count + 1
		self.last_kind = "console"
		self.last_event_json = event_json
	end

	func record_error(string event_json) as void
		self.error_count = self.error_count + 1
		self.last_kind = "error"
		self.last_event_json = event_json
	end

	func ready() as bool
		return self.trace_dir != ""
	end
end

class FailureArtifactPlan extends object
	var trace_dir as string
	var action_path as string
	var screenshot_path as string
	var snapshot_path as string
	var manifest_path as string
	var action_json as string
	var manifest_json as string
	var recorded as int

	create(string trace_dir, string action_json, string manifest_json)
		self.trace_dir = trace_dir
		self.action_path = trace_dir + "/trace.jsonl"
		self.screenshot_path = trace_dir + "/failure.png"
		self.snapshot_path = trace_dir + "/failure.html"
		self.manifest_path = trace_dir + "/manifest.json"
		self.action_json = action_json
		self.manifest_json = manifest_json
		self.recorded = 0
	end

	func dir() as string
		return self.trace_dir
	end

	func action_file() as string
		return self.action_path
	end

	func screenshot() as string
		return self.screenshot_path
	end

	func snapshot() as string
		return self.snapshot_path
	end

	func manifest() as string
		return self.manifest_path
	end

	func action() as string
		return self.action_json
	end

	func manifest_json_value() as string
		return self.manifest_json
	end

	func mark_recorded() as void
		self.recorded = 1
	end

	func recorded_value() as int
		return self.recorded
	end

	func ready() as bool
		return self.trace_dir != "" and self.action_path != "" and self.screenshot_path != "" and self.snapshot_path != "" and self.manifest_path != ""
	end
end

class DomSnapshotPlan extends object
	var trace_dir as string
	var snapshot_path as string
	var html_bytes as int
	var recorded as int

	create(string trace_dir, string snapshot_name)
		self.trace_dir = trace_dir
		self.snapshot_path = trace_dir + "/" + snapshot_name
		self.html_bytes = 0
		self.recorded = 0
	end

	func dir() as string
		return self.trace_dir
	end

	func snapshot() as string
		return self.snapshot_path
	end

	func html_bytes_value() as int
		return self.html_bytes
	end

	func recorded_value() as int
		return self.recorded
	end

	func record_html(int html_bytes) as void
		self.html_bytes = html_bytes
		self.recorded = 1
	end

	func ready() as bool
		return self.trace_dir != "" and self.snapshot_path != ""
	end
end

class TraceSession extends object
	var handle as point
	var session_id as string
	var trace_dir as string
	var default_timeout as int
	var last_action_json as string
	var action_count as int

	create(point handle, string session_id, string trace_dir, int default_timeout)
		self.handle = handle
		self.session_id = session_id
		self.trace_dir = trace_dir
		self.default_timeout = default_timeout
		self.last_action_json = ""
		self.action_count = 0
	end

	func dir() as string
		return self.trace_dir
	end

	func trace_path() as string
		return self.trace_dir + "/trace.jsonl"
	end

	func network_path() as string
		return self.trace_dir + "/network.jsonl"
	end

	func console_path() as string
		return self.trace_dir + "/console.jsonl"
	end

	func errors_path() as string
		return self.trace_dir + "/errors.jsonl"
	end

	func manifest_path() as string
		return self.trace_dir + "/manifest.json"
	end

	func failure_screenshot_path() as string
		return self.trace_dir + "/failure.png"
	end

	func failure_snapshot_path() as string
		return self.trace_dir + "/failure.html"
	end

	func set_default_timeout(int ms) as void
		self.default_timeout = ms
	end

	func default_timeout_ms() as int
		return self.default_timeout
	end

	func last_action() as string
		return self.last_action_json
	end

	func action_count_value() as int
		return self.action_count
	end

	func remember_action(string action_json) as void
		self.last_action_json = action_json
		self.action_count = self.action_count + 1
	end

	func write_action(string action_json) as bool
		self.last_action_json = action_json
		self.action_count = self.action_count + 1
		return x.cdp.trace_write_action(self.handle, self.trace_dir + "/trace.jsonl", action_json)
	end

	func write_network(string event_json) as bool
		return x.cdp.trace_write_event(self.handle, self.trace_dir + "/network.jsonl", event_json)
	end

	func write_console(string event_json) as bool
		return x.cdp.trace_write_event(self.handle, self.trace_dir + "/console.jsonl", event_json)
	end

	func write_error(string event_json) as bool
		return x.cdp.trace_write_event(self.handle, self.trace_dir + "/errors.jsonl", event_json)
	end

	func default_manifest() as string
		return x.cdp.trace_default_manifest(self.handle, self.trace_dir)
	end

	func write_manifest(string manifest_json) as bool
		return x.cdp.trace_write_manifest(self.handle, self.trace_dir + "/manifest.json", manifest_json)
	end

	func record_failure(string action_json, string manifest_json, int timeout_ms) as bool
		int effective_timeout = timeout_ms
		if effective_timeout <= 0 then
			effective_timeout = self.default_timeout
		end
		return x.cdp.trace_record_failure(self.handle, self.session_id, self.trace_dir + "/trace.jsonl", action_json, self.trace_dir + "/failure.png", self.trace_dir + "/failure.html", self.trace_dir + "/manifest.json", manifest_json, effective_timeout)
	end

	func archive(string zip_path) as TraceArchive
		return TraceArchive(self.trace_dir, self.trace_dir + "/manifest.json", zip_path)
	end
end

func create_session(point browser, string session_id, string trace_dir) as TraceSession
	return TraceSession(browser, session_id, trace_dir, 30000)
end

func write_action(point browser, string path, string action_json) as bool
	return x.cdp.trace_write_action(browser, path, action_json)
end

func write_event(point browser, string path, string event_json) as bool
	return x.cdp.trace_write_event(browser, path, event_json)
end

func write_manifest(point browser, string path, string manifest_json) as bool
	return x.cdp.trace_write_manifest(browser, path, manifest_json)
end

func default_manifest(point browser, string trace_dir) as string
	return x.cdp.trace_default_manifest(browser, trace_dir)
end

func record_failure(point browser, string session_id, string action_path, string action_json, string screenshot_path, string snapshot_path, string manifest_path, string manifest_json, int timeout_ms) as bool
	return x.cdp.trace_record_failure(browser, session_id, action_path, action_json, screenshot_path, snapshot_path, manifest_path, manifest_json, timeout_ms)
end

func archive(string trace_dir, string zip_path) as TraceArchive
	return TraceArchive(trace_dir, trace_dir + "/manifest.json", zip_path)
end

func viewer_plan(string trace_dir, string viewer_path, int include_network, int include_console, int include_errors) as TraceViewerPlan
	return TraceViewerPlan(trace_dir, trace_dir + "/manifest.json", viewer_path, include_network, include_console, include_errors)
end

func zip_plan(string trace_dir, string zip_path, string viewer_path) as TraceZipPlan
	return TraceZipPlan(trace_dir, trace_dir + "/manifest.json", zip_path, viewer_path)
end

func action_window(int capacity) as TraceActionWindow
	return TraceActionWindow(capacity)
end

func event_plan(string trace_dir) as TraceEventPlan
	return TraceEventPlan(trace_dir)
end

func failure_artifact_plan(string trace_dir, string action_json, string manifest_json) as FailureArtifactPlan
	return FailureArtifactPlan(trace_dir, action_json, manifest_json)
end

func dom_snapshot_plan(string trace_dir, string snapshot_name) as DomSnapshotPlan
	return DomSnapshotPlan(trace_dir, snapshot_name)
end

export write_action
export create_session
export write_event
export write_manifest
export default_manifest
export record_failure
export archive
export viewer_plan
export zip_plan
export action_window
export event_plan
export failure_artifact_plan
export dom_snapshot_plan
