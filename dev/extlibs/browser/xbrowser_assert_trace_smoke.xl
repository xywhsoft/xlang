		return 47
	end
	if fail_result.message_value() != "expected visible" then
		return 48
	end
	if fail_result.expected_value() != "visible" then
		return 49
	end
	if fail_result.actual_value() != "hidden" then
		return 50
	end
	if fail_result.trace_dir_value() != "dev/extlibs/browser/trace" then
		return 51
	end
	auto assert_error = expect.error_info("visible", "#app", "visible", "hidden", "dev/extlibs/browser/trace", 5000)
	if assert_error.kind_value() != "visible" then
		return 62
	end
	if assert_error.selector_value() != "#app" then
		return 63
	end
	if assert_error.expected_value() != "visible" then
		return 64
	end
	if assert_error.actual_value() != "hidden" then
		return 65
	end
	if not assert_error.has_trace() then
