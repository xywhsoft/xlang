	end
	if assert_trace_plan.artifact_recorded_value() != 0 then
		return 111
	end
	assert_trace_plan.mark_artifact_recorded()
	if assert_trace_plan.artifact_recorded_value() != 1 then
		return 112
	end
	if expect.title(null, "missing", "Title", 50) then
		return 3
	end
	if expect.url(null, "missing", "about:blank", 50) then
		return 4
	end
	if expect.visible(null, "missing", "#app", 50) then
		return 5
	end
	if expect.text(null, "missing", "#app", "text", 50) then
		return 6
	end
	if expect.count(null, "missing", "#app", 1, 50) then
		return 7
	end
	if expect.trace_failure(null, "missing", "dev/extlibs/browser/trace", "{}", "{}", 50) then
		return 29
	end
	if expect.title_trace(null, "missing", "Title", "dev/extlibs/browser/trace", "{}", "{}", 50) then
		return 30
	end
	if expect.url_trace(null, "missing", "about:blank", "dev/extlibs/browser/trace", "{}", "{}", 50) then
		return 31
	end
	if expect.visible_trace(null, "missing", "#app", "dev/extlibs/browser/trace", "{}", "{}", 50) then
		return 32
	end
	if expect.text_trace(null, "missing", "#app", "text", "dev/extlibs/browser/trace", "{}", "{}", 50) then
		return 33
	end
	if expect.count_trace(null, "missing", "#app", 1, "dev/extlibs/browser/trace", "{}", "{}", 50) then
		return 34
	end
	if trace.write_action(null, "dev/extlibs/browser/should_not_exist.jsonl", "{}") then
		return 8
	end
	if trace.write_event(null, "dev/extlibs/browser/should_not_exist.jsonl", "{}") then
		return 9
	end
	if trace.write_manifest(null, "dev/extlibs/browser/should_not_exist.json", "{}") then
		return 10
	end
	if trace.default_manifest(null, "dev/extlibs/browser/trace") != "" then
