		return 19
	end
	if session.failure_snapshot_path() != "dev/extlibs/browser/trace/failure.html" then
		return 20
	end
	session.set_default_timeout(1234)
	if session.default_timeout_ms() != 1234 then
		return 21
	end
	if session.last_action() != "" then
		return 35
	end
	if session.action_count_value() != 0 then
		return 36
	end
	session.remember_action("{\"name\":\"manual\"}")
	if session.last_action() != "{\"name\":\"manual\"}" then
		return 37
	end
	if session.action_count_value() != 1 then
		return 38
	end
	if session.write_action("{}") then
		return 22
	end
	if session.last_action() != "{}" then
		return 39
	end
	if session.action_count_value() != 2 then
		return 40
	end
	if session.write_network("{}") then
		return 23
	end
	if session.write_console("{}") then
		return 24
	end
	if session.write_error("{}") then
		return 25
	end
	if session.default_manifest() != "" then
