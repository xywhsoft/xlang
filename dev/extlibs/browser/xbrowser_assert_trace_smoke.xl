	auto archive = session.archive("dev/extlibs/browser/trace.zip")
	if archive.dir() != "dev/extlibs/browser/trace" then
		return 41
	end
	if archive.manifest() != "dev/extlibs/browser/trace/manifest.json" then
		return 42
	end
	if archive.zip() != "dev/extlibs/browser/trace.zip" then
		return 43
	end
	if not archive.ready() then
		return 44
	end
	archive.set_viewer("dev/extlibs/browser/trace/viewer.html")
	if archive.viewer() != "dev/extlibs/browser/trace/viewer.html" then
		return 68
	end
	auto archive2 = trace.archive("dev/extlibs/browser/trace", "dev/extlibs/browser/trace.zip")
	if archive2.manifest() != "dev/extlibs/browser/trace/manifest.json" then
		return 45
	end
	auto viewer_plan = trace.viewer_plan("dev/extlibs/browser/trace", "dev/extlibs/browser/trace/viewer.html", 1, 1, 1)
	if viewer_plan.dir() != "dev/extlibs/browser/trace" then
		return 69
	end
	if viewer_plan.manifest() != "dev/extlibs/browser/trace/manifest.json" then
		return 70
	end
	if viewer_plan.viewer() != "dev/extlibs/browser/trace/viewer.html" then
		return 71
	end
	if viewer_plan.include_errors_value() != 1 then
		return 72
	end
	auto zip_plan = trace.zip_plan("dev/extlibs/browser/trace", "dev/extlibs/browser/trace.zip", "dev/extlibs/browser/trace/viewer.html")
	if zip_plan.dir() != "dev/extlibs/browser/trace" then
		return 91
	end
	if zip_plan.manifest() != "dev/extlibs/browser/trace/manifest.json" then
		return 92
	end
	if zip_plan.zip() != "dev/extlibs/browser/trace.zip" then
		return 93
	end
	if zip_plan.viewer() != "dev/extlibs/browser/trace/viewer.html" then
		return 94
	end
	if not zip_plan.ready() then
		return 95
	end
	if zip_plan.entry_count_value() != 0 then
		return 96
	end
	zip_plan.remember_entry()
	if zip_plan.entry_count_value() != 1 then
		return 97
	end
	zip_plan.mark_packed()
	if zip_plan.packed_value() != 1 then
		return 98
	end
	auto window = trace.action_window(2)
	if window.capacity_value() != 2 then
		return 52
	end
	if window.count() != 0 then
		return 53
	end
	window.record("{\"name\":\"one\"}")
	window.record("{\"name\":\"two\"}")
	if window.count() != 2 then
		return 54
	end
	if window.last_action() != "{\"name\":\"two\"}" then
		return 55
	end
	if window.previous_action() != "{\"name\":\"one\"}" then
