import x.browser.assert as expect
import x.browser.trace as trace

func main() as int
	if expect.ok(null, 1) then
		return 1
	end
	if expect.ok(null, 0) then
		return 2
	end
	auto pass_result = expect.result(1, "", "1", "1", "")
