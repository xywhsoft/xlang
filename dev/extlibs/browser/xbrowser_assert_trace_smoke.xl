	if trace.record_failure(null, "missing", "dev/extlibs/browser/should_not_exist.jsonl", "{}", "dev/extlibs/browser/should_not_exist.png", "dev/extlibs/browser/should_not_exist.html", "dev/extlibs/browser/should_not_exist_manifest.json", "{}", 50) then
		return 12
	end
	auto session = trace.create_session(null, "missing", "dev/extlibs/browser/trace")
	if session.dir() != "dev/extlibs/browser/trace" then
		return 13
	end
	if session.trace_path() != "dev/extlibs/browser/trace/trace.jsonl" then
		return 14
	end
	if session.network_path() != "dev/extlibs/browser/trace/network.jsonl" then
		return 15
	end
	if session.console_path() != "dev/extlibs/browser/trace/console.jsonl" then
		return 16
	end
	if session.errors_path() != "dev/extlibs/browser/trace/errors.jsonl" then
		return 17
