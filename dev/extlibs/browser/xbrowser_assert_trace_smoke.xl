	end
	if retry_plan.interval_value() != 100 then
		return 84
	end
	if retry_plan.attempt_count_value() != 0 then
		return 85
	end
	if not retry_plan.should_retry() then
		return 86
	end
	retry_plan.record_attempt("not visible")
	if retry_plan.attempt_count_value() != 1 then
		return 87
	end
	if retry_plan.last_message_value() != "not visible" then
		return 88
	end
	retry_plan.mark_completed()
	if retry_plan.completed_value() != 1 then
		return 89
	end
	if retry_plan.should_retry() then
		return 90
	end
	auto assert_trace_plan = expect.trace_plan("visible", "#app", "visible", "hidden", "dev/extlibs/browser/trace")
	if assert_trace_plan.kind_value() != "visible" then
		return 105
	end
	if assert_trace_plan.selector_value() != "#app" then
		return 106
	end
	if assert_trace_plan.expected_value() != "visible" then
		return 107
	end
	if assert_trace_plan.actual_value() != "hidden" then
		return 108
	end
	if assert_trace_plan.trace_dir_value() != "dev/extlibs/browser/trace" then
