		return 57
	end
	if window.dropped() != 1 then
		return 58
	end
	if window.last_action() != "{\"name\":\"three\"}" then
		return 59
	end
	window.clear()
	if window.count() != 0 then
		return 60
	end
	if window.last_action() != "" then
