	end
	if not trace_events.ready() then
		return 114
	end
	trace_events.record_network("{\"method\":\"Network.requestWillBeSent\"}")
	trace_events.record_console("{\"method\":\"Runtime.consoleAPICalled\"}")
	trace_events.record_error("{\"method\":\"Runtime.exceptionThrown\"}")
