// ============================================================
// xlang 示例：算术运算符
// 演示基本的算术运算
// ============================================================

int a = 10
int b = 3

// ---------- 基本算术运算 ----------
print(`{$a} + {$b} = {$a + b}`)			// 加法: 13
print(`{$a} - {$b} = {$a - b}`)			// 减法: 7
print(`{$a} * {$b} = {$a * b}`)			// 乘法: 30
print(`{$a} / {$b} = {$a / b}`)			// 除法: 3（整数除法）
print(`{$a} % {$b} = {$a % b}`)			// 取模: 1

// ---------- 乘方运算 ----------
print(`{$a} ** 2 = {$a ** 2}`)			// 乘方: 100
print(`2 ** 10 = {$2 ** 10}`)			// 乘方: 1024

// ---------- 浮点除法 ----------
float fA = 10.0
float fB = 3.0
print(`{$fA} / {$fB} = {$fA / fB}`)		// 浮点除法: 3.333...

// ---------- 负号 ----------
int iNeg = -a
print(`-{$a} = {$iNeg}`)				// 负号: -10

// ---------- 复合赋值运算符 ----------
int x = 10
x += 5									// x = x + 5
print(`x += 5: {$x}`)					// 15
x -= 3									// x = x - 3
print(`x -= 3: {$x}`)					// 12
x *= 2									// x = x * 2
print(`x *= 2: {$x}`)					// 24
x /= 4									// x = x / 4
print(`x /= 4: {$x}`)					// 6
x %= 4									// x = x % 4
print(`x %= 4: {$x}`)					// 2
x **= 3									// x = x ** 3
print(`x **= 3: {$x}`)					// 8

// ---------- 自增自减 ----------
int y = 5
print(`y = {$y}`)						// 5
print(`++y = {$++y}`)					// 6（前置自增）
print(`y++ = {$y++}`)					// 6（后置自增，返回旧值）
print(`y = {$y}`)						// 7
print(`--y = {$--y}`)					// 6（前置自减）
print(`y-- = {$y--}`)					// 6（后置自减，返回旧值）
print(`y = {$y}`)						// 5
