// ============================================================
// xlang 示例：位运算符
// 演示二进制位操作
// ============================================================

int a = 0b11001100				// 204
int b = 0b10101010				// 170

// ---------- 位与 (&) ----------
int iAnd = a & b				// 0b10001000 = 136
print(`{$a} & {$b} = {$iAnd}`)

// ---------- 位或 (|) ----------
int iOr = a | b					// 0b11101110 = 238
print(`{$a} | {$b} = {$iOr}`)

// ---------- 位异或 (^) ----------
int iXor = a ^ b				// 0b01100110 = 102
print(`{$a} ^ {$b} = {$iXor}`)

// ---------- 位非 (!) ----------
// 注意：xlang 使用 ! 作为位非，而非 ~
uint8 c = 0b11110000			// 240
uint8 iNot = !c					// 0b00001111 = 15
print(`!{$c} = {$iNot}`)

// ---------- 左移 (<<) ----------
int d = 1
print(`{$d} << 1 = {$d << 1}`)	// 2
print(`{$d} << 4 = {$d << 4}`)	// 16
print(`{$d} << 8 = {$d << 8}`)	// 256

// ---------- 右移 (>>) ----------
int e = 256
print(`{$e} >> 1 = {$e >> 1}`)	// 128
print(`{$e} >> 4 = {$e >> 4}`)	// 16
print(`{$e} >> 8 = {$e >> 8}`)	// 1

// ---------- 复合位赋值运算符 ----------
int x = 0xFF
x &= 0x0F						// x = x & 0x0F
print(`x &= 0x0F: {$x}`)		// 15

x |= 0xF0						// x = x | 0xF0
print(`x |= 0xF0: {$x}`)		// 255

x ^= 0x55						// x = x ^ 0x55
print(`x ^= 0x55: {$x}`)		// 170

x <<= 2							// x = x << 2
print(`x <<= 2: {$x}`)			// 680

x >>= 4							// x = x >> 4
print(`x >>= 4: {$x}`)			// 42

// ---------- 位操作应用示例 ----------
// 设置标志位
int iFlags = 0
const int FLAG_READ = 0b0001
const int FLAG_WRITE = 0b0010
const int FLAG_EXEC = 0b0100

iFlags |= FLAG_READ				// 设置读取标志
iFlags |= FLAG_WRITE			// 设置写入标志
print(`Flags: {$iFlags}`)		// 3

// 检查标志位
if (iFlags & FLAG_READ) != 0
	print("具有读取权限")
end

// 清除标志位
iFlags &= !FLAG_WRITE			// 清除写入标志
print(`清除写入后 Flags: {$iFlags}`)
