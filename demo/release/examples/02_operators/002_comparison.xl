// ============================================================
// xlang 示例：比较运算符
// 演示各种比较操作
// ============================================================

int a = 10
int b = 20
int c = 10

// ---------- 相等性比较 ----------
print(`{$a} == {$c}: {$a == c}`)		// true
print(`{$a} == {$b}: {$a == b}`)		// false
print(`{$a} != {$b}: {$a != b}`)		// true
print(`{$a} != {$c}: {$a != c}`)		// false

// ---------- 大小比较 ----------
print(`{$a} < {$b}: {$a < b}`)			// true
print(`{$a} > {$b}: {$a > b}`)			// false
print(`{$a} <= {$c}: {$a <= c}`)		// true
print(`{$a} >= {$c}: {$a >= c}`)		// true

// ---------- 约等于运算符 (~=) ----------
// 用于浮点数容差比较
float f1 = 0.1 + 0.2
float f2 = 0.3
print(`0.1 + 0.2 == 0.3: {$f1 == f2}`)		// 可能为 false（精度问题）
print(`0.1 + 0.2 ~= 0.3: {$f1 ~= f2}`)		// true（约等于）

// 字符串模糊匹配
string s1 = "Hello World"
string s2 = "hello world"
print(`大小写敏感: {$s1 == s2}`)				// false
print(`大小写不敏感: {$s1 ~= s2}`)			// true

// 时间容差比较
time t1 = time("2024-01-01 12:00:00")
time t2 = time("2024-01-01 12:00:01")
print(`时间相差1秒: {$t1 ~= t2}`)			// true（在容差范围内）

// ---------- 链式比较 ----------
int x = 5
print(`1 < {$x} < 10: {$1 < x < 10}`)		// true（链式比较）
print(`0 <= {$x} <= 5: {$0 <= x <= 5}`)		// true
