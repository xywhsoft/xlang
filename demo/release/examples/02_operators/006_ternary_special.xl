// ============================================================
// xlang 示例：三目运算符和特殊运算符
// 演示条件表达式和类型判断
// ============================================================

// ---------- 三目运算符 (?:) ----------
int iScore = 85
string sGrade = iScore >= 60 ? "及格" : "不及格"
print(`分数 {$iScore}: {$sGrade}`)

// 嵌套三目运算符
string sLevel = iScore >= 90 ? "优秀" : 
				iScore >= 80 ? "良好" :
				iScore >= 60 ? "及格" : "不及格"
print(`等级: {$sLevel}`)

// 三目运算符返回值
int iMax = 10 > 20 ? 10 : 20
print(`较大值: {$iMax}`)

// ---------- is 运算符（类型判断）----------
var vValue = 42
print(`vValue is int: {$vValue is int}`)			// true
print(`vValue is string: {$vValue is string}`)		// false

vValue = "hello"
print(`vValue is string: {$vValue is string}`)		// true

// 类实例判断
class Animal
end

class Dog extends Animal
end

var pDog = new Dog()
print(`pDog is Dog: {$pDog is Dog}`)				// true
print(`pDog is Animal: {$pDog is Animal}`)			// true（继承关系）

// ---------- in 运算符（包含判断）----------
// 数组包含（判断值）
var arrNumbers = new array(1, 2, 3, 4, 5)
print(`3 in arrNumbers: {$3 in arrNumbers}`)		// true
print(`6 in arrNumbers: {$6 in arrNumbers}`)		// false

// 列表包含（判断值）
var lstData = [0:"a", 1:"b", 2:"c"]
print(`"b" in lstData: {$"b" in lstData}`)		// true
print(`"x" in lstData: {$"x" in lstData}`)		// false

// 字典键包含
var tblPerson = { name: "张三", age: 25 }
print(`"name" in tblPerson: {$"name" in tblPerson}`)	// true
print(`"email" in tblPerson: {$"email" in tblPerson}`)	// false

// 字符串包含
var sText = "Hello World"
print(`"World" in sText: {$"World" in sText}`)		// true
print(`"xyz" in sText: {$"xyz" in sText}`)			// false

// 集合包含
var setItems = new set(1, 2, 3)
print(`2 in setItems: {$2 in setItems}`)			// true

// ---------- 运算符组合 ----------
int iAge = 25
var arrSpecialAges = new array(18, 25, 30)
string sStatus = (iAge >= 18) and (iAge in arrSpecialAges) ? "特殊年龄" : "普通年龄"
print(`年龄 {$iAge} 状态: {$sStatus}`)
