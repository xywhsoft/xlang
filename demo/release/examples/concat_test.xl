// 字符串拼接和数组合并测试

// ===============================
// 字符串拼接
// ===============================
print("=== 字符串拼接 ===")
var s1 = "Hello"
var s2 = " World"
var s3 = s1 + s2
print(s3)

// 字符串 + 各种类型
print("count = " + 42)
print("pi = " + 3.14)
print("flag = " + true)

// 多次拼接
var name = "xlang"
var version = 3
var msg = name + " v" + version + " is running"
print(msg)

// ===============================
// 数组合并
// ===============================
print("")
print("=== 数组合并 ===")
var arr1 = [1, 2, 3]
var arr2 = [4, 5, 6]
var arr3 = arr1 + arr2
print("arr1 + arr2 length: " + len(arr3))
for v in arr3
	print(v)
end

// 空数组合并
print("")
print("=== 空数组合并 ===")
var empty = []
var result = empty + [1, 2]
print("[] + [1,2] length: " + len(result))

result = [3, 4] + empty
print("[3,4] + [] length: " + len(result))

result = [] + []
print("[] + [] length: " + len(result))
