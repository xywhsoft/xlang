// nullish_operators.xl
// 空值合并运算符 ?? 和空值赋值运算符 ?= 测试

// ============================================
// 1. 空值合并运算符 ??
// ============================================
print("=== 空值合并运算符 ?? ===")

// null 值使用默认值
var a = null
var b = a ?? "默认值"
print("a = null; b = a ?? '默认值'; b =")
print(b)

// 非 null 值保持原值
var c = "有值"
var d = c ?? "默认值"
print("c = '有值'; d = c ?? '默认值'; d =")
print(d)

// 数字测试
var e = null
var f = e ?? 100
print("e = null; f = e ?? 100; f =")
print(f)

var g = 50
var h = g ?? 100
print("g = 50; h = g ?? 100; h =")
print(h)

// ============================================
// 2. 空值赋值运算符 ?=
// ============================================
print("=== 空值赋值运算符 ?= ===")

// null 变量被赋值
var x = null
x ?= "新值"
print("x = null; x ?= '新值'; x =")
print(x)

// 非 null 变量保持不变
var y = "原值"
y ?= "新值"
print("y = '原值'; y ?= '新值'; y =")
print(y)

// 数字测试
var m = null
m ?= 999
print("m = null; m ?= 999; m =")
print(m)

var n = 123
n ?= 999
print("n = 123; n ?= 999; n =")
print(n)

// ============================================
// 3. 链式空值合并
// ============================================
print("=== 链式空值合并 ===")

var p = null
var q = null
var r = p ?? q ?? "最终默认"
print("p = null; q = null; r = p ?? q ?? '最终默认'; r =")
print(r)

var s = null
var t = "中间值"
var u = s ?? t ?? "最终默认"
print("s = null; t = '中间值'; u = s ?? t ?? '最终默认'; u =")
print(u)

print("=== 空值运算符测试完成 ===")
