// logical_operators.xl
// 演示逻辑运算符

println("=== 逻辑运算符测试 ===")

// 1. 基本逻辑运算
println("")
println("1. 基本逻辑运算")
var t = true
var f = false
println("true and true: " + (t and t))
println("true and false: " + (t and f))
println("false and true: " + (f and t))
println("false and false: " + (f and f))

// 2. 逻辑或运算
println("")
println("2. 逻辑或运算")
println("true or true: " + (t or t))
println("true or false: " + (t or f))
println("false or true: " + (f or t))
println("false or false: " + (f or f))

// 3. 逻辑非运算
println("")
println("3. 逻辑非运算")
println("not true: " + (not t))
println("not false: " + (not f))
println("!true: " + (!t))
println("!false: " + (!f))

// 4. 复合逻辑表达式
println("")
println("4. 复合逻辑表达式")
var a = true
var b = false
var c = true
println("a and b or c: " + (a and b or c))
println("(a and b) or c: " + ((a and b) or c))
println("a and (b or c): " + (a and (b or c)))
println("not a or b: " + (not a or b))
println("not (a or b): " + (not (a or b)))

// 5. 与数值比较组合
println("")
println("5. 与数值比较组合")
var x = 10
var y = 20
var z = 15
println("(x < y) and (y > z): " + ((x < y) and (y > z)))
println("(x > y) or (z < y): " + ((x > y) or (z < y)))
println("not (x > y): " + (not (x > y)))

// 6. 条件判断中使用
println("")
println("6. 条件判断中使用")
var age = 25
var hasLicense = true
if age >= 18 and hasLicense
	println("可以开车")
else
	println("不能开车")
end

var isWeekend = false
var isHoliday = true
if isWeekend or isHoliday
	println("今天可以休息")
else
	println("今天要工作")
end

// 7. 多重条件
println("")
println("7. 多重条件")
var score = 85
var attendance = 90
if (score >= 60) and (attendance >= 80)
	println("课程通过")
else
	println("课程未通过")
end

// 8. 短路求值验证
println("")
println("8. 短路求值")
var val = 0
// and 短路: 第一个为 false 时不会计算第二个
if false and (val > 0)
	println("不会执行")
end
println("and 短路测试通过")

// or 短路: 第一个为 true 时不会计算第二个
if true or (val > 0)
	println("or 短路测试通过")
end

// 9. 逻辑运算与循环
println("")
println("9. 逻辑运算与循环")
var i = 0
while (i < 10) and (i != 5) do
	print(i + " ")
	i++
end
println("")

// 10. 嵌套逻辑条件
println("")
println("10. 嵌套逻辑条件")
var temp = 25
var humidity = 60
var isRaining = false
if ((temp >= 20) and (temp <= 30)) and ((humidity >= 40) and (humidity <= 70)) and (not isRaining)
	println("天气适合户外活动")
else
	println("天气不适合户外活动")
end

println("")
println("=== 逻辑运算符测试完成 ===")
