// comparison_operators.xl
// 演示比较运算符

println("=== 比较运算符测试 ===")

// 1. 基本比较运算
println("")
println("1. 基本比较运算")
var a = 10
var b = 20
println("a = " + a + ", b = " + b)
println("a == b: " + (a == b))
println("a != b: " + (a != b))
println("a < b: " + (a < b))
println("a > b: " + (a > b))
println("a <= b: " + (a <= b))
println("a >= b: " + (a >= b))

// 2. 相等比较
println("")
println("2. 相等比较")
var x = 10
var y = 10
println("x = " + x + ", y = " + y)
println("x == y: " + (x == y))
println("x != y: " + (x != y))

// 3. 浮点数比较
println("")
println("3. 浮点数比较")
var f1 = 3.14
var f2 = 3.15
println("f1 = " + f1 + ", f2 = " + f2)
println("f1 == f2: " + (f1 == f2))
println("f1 < f2: " + (f1 < f2))
println("f1 > f2: " + (f1 > f2))

// 4. 字符串比较
println("")
println("4. 字符串比较")
var s1 = "apple"
var s2 = "banana"
var s3 = "apple"
println("s1 = '" + s1 + "', s2 = '" + s2 + "', s3 = '" + s3 + "'")
println("s1 == s3: " + (s1 == s3))
println("s1 != s2: " + (s1 != s2))

// 5. 布尔值比较
println("")
println("5. 布尔值比较")
var t = true
var f = false
println("true == true: " + (t == t))
println("true == false: " + (t == f))
println("false == false: " + (f == f))

// 6. 空值比较
println("")
println("6. 空值比较")
var n1 = null
var n2 = null
var v = 10
println("null == null: " + (n1 == n2))
println("null != 10: " + (n1 != v))

// 7. 整数和浮点数比较
println("")
println("7. 整数和浮点数比较")
var intVal = 10
var floatVal = 10.0
println("10 == 10.0: " + (intVal == floatVal))

// 8. 边界值比较
println("")
println("8. 边界值比较")
println("0 < 1: " + (0 < 1))
println("0 > -1: " + (0 > -1))
println("-1 < 0: " + (-1 < 0))
println("1 >= 1: " + (1 >= 1))
println("1 <= 1: " + (1 <= 1))

// 9. 链式比较条件
println("")
println("9. 链式比较条件")
var num = 50
if (num >= 0) and (num <= 100)
	println(num + " 在 0-100 范围内")
end
if (num > 25) and (num < 75)
	println(num + " 在 25-75 范围内")
end

// 10. 复杂表达式比较
println("")
println("10. 复杂表达式比较")
var p = 5
var q = 3
println("(p + q) == 8: " + ((p + q) == 8))
println("(p * q) > 10: " + ((p * q) > 10))
println("(p - q) < 5: " + ((p - q) < 5))

println("")
println("=== 比较运算符测试完成 ===")
