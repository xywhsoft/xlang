// power_operators.xl
// 乘方运算符 ** 和 **= 测试

// ============================================
// 1. 基本乘方运算
// ============================================
print("=== 基本乘方运算 ===")

var a = 2 ** 3
print("2 ** 3 =")
print(a)

var b = 3 ** 4
print("3 ** 4 =")
print(b)

var c = 10 ** 0
print("10 ** 0 =")
print(c)

var d = 5 ** 1
print("5 ** 1 =")
print(d)

// ============================================
// 2. 负指数（浮点结果）
// ============================================
print("=== 负指数 ===")

var e = 2 ** -1
print("2 ** -1 =")
print(e)

var f = 4 ** -2
print("4 ** -2 =")
print(f)

// ============================================
// 3. 浮点数乘方
// ============================================
print("=== 浮点数乘方 ===")

var g = 2.5 ** 2
print("2.5 ** 2 =")
print(g)

var h = 9.0 ** 0.5
print("9.0 ** 0.5 =")
print(h)

// ============================================
// 4. 乘方赋值运算符 **=
// ============================================
print("=== 乘方赋值运算符 **= ===")

var x = 2
x **= 3
print("x = 2; x **= 3; x =")
print(x)

var y = 3
y **= 2
print("y = 3; y **= 2; y =")
print(y)

// ============================================
// 5. 右结合性测试
// ============================================
print("=== 右结合性测试 ===")

var r = 2 ** 3 ** 2
print("2 ** 3 ** 2 = 2 ** (3 ** 2) = 2 ** 9 =")
print(r)

print("=== 乘方运算符测试完成 ===")
