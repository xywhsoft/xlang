// while_loops.xl
// 演示 while 循环语法

println("=== while 循环测试 ===")

// 1. 基本 while 循环
println("")
println("1. 基本 while 循环")
var i = 1
while i <= 5
	println("i = " + i)
	i = i + 1
end

// 2. 使用自增运算符
println("")
println("2. 使用自增运算符")
var count = 0
while count < 5
	println("count = " + count)
	count++
end

// 3. 递减循环
println("")
println("3. 递减循环")
var n = 5
while n > 0
	println("n = " + n)
	n--
end

// 4. 累加求和
println("")
println("4. 累加求和 (1 到 10)")
var sum = 0
var num = 1
while num <= 10
	sum = sum + num
	num++
end
println("sum = " + sum)

// 5. 使用 break 退出循环
println("")
println("5. 使用 break 退出循环")
var j = 0
while true
	println("j = " + j)
	j++
	if j >= 3
		println("遇到 break，退出循环")
		break
	end
end

// 6. 使用 continue 跳过迭代
println("")
println("6. 使用 continue 跳过偶数")
var k = 0
while k < 10
	k++
	if k % 2 == 0
		continue
	end
	println("奇数: " + k)
end

// 7. 嵌套 while 循环
println("")
println("7. 嵌套 while 循环 (乘法表 1-3)")
var row = 1
while row <= 3
	var col = 1
	while col <= 3
		print(row + "*" + col + "=" + (row * col) + " ")
		col++
	end
	println("")
	row++
end

// 8. 计算阶乘
println("")
println("8. 计算阶乘 (5!)")
var factorial = 1
var f = 5
while f > 0
	factorial = factorial * f
	f--
end
println("5! = " + factorial)

// 9. 查找条件
println("")
println("9. 查找第一个大于 100 的平方数")
var x = 1
while x * x <= 100
	x++
end
println("找到: " + x + " (平方为 " + (x * x) + ")")

// 10. 字符串处理
println("")
println("10. 逐字符处理字符串")
var str = "xlang"
var idx = 0
while idx < len(str)
	println("字符[" + idx + "] = " + str[idx])
	idx++
end

println("")
println("=== while 循环测试完成 ===")
