// ============================================================
// xlang 示例：if-else 条件语句
// 演示各种条件语句的使用
// ============================================================

var iA = 10
var iB = 20
var sName = "张三"
var bFlag = true

print("if-else 条件语句示例:")
print("iA =", iA, "iB =", iB)
print("sName =", sName, "bFlag =", bFlag)

// ---------- 基本 if 语句 ----------

print("\n基本 if 语句:")
if iA < iB {
    print("iA 小于 iB")
}

// ---------- if-else 语句 ----------

print("\nif-else 语句:")
if iA > iB {
    print("iA 大于 iB")
} else {
    print("iA 不大于 iB")
}

// ---------- if-elseif-else 语句 ----------

print("\nif-elseif-else 语句:")
var iScore = 85
if iScore >= 90 {
    print("优秀")
} elseif iScore >= 80 {
    print("良好")
} elseif iScore >= 70 {
    print("中等")
} elseif iScore >= 60 {
    print("及格")
} else {
    print("不及格")
}

// ---------- 单行 if-then 语句 ----------

print("\n单行 if-then 语句:")
if bFlag then print("这是单行 if-then 语句")

// ---------- 嵌套 if 语句 ----------

print("\n嵌套 if 语句:")
var iX = 5
var iY = 10
var iZ = 15

if iX < iY {
    print("iX < iY")
    if iY < iZ {
        print("iY < iZ")
        print("iX < iY < iZ")
    } else {
        print("iY >= iZ")
    }
} else {
    print("iX >= iY")
}

// ---------- 使用逻辑运算符的 if 语句 ----------

print("\n使用逻辑运算符的 if 语句:")
if (iA > 0) and (iB > 0) {
    print("iA 和 iB 都是正数")
}

if (sName == "张三") or (sName == "李四") {
    print("sName 是张三或李四")
}

if not bFlag {
    print("bFlag 是 false")
} else {
    print("bFlag 是 true")
}

// ---------- 使用 in 运算符的 if 语句 ----------

print("\n使用 in 运算符的 if 语句:")
var arrNumbers = [10, 20, 30, 40, 50]
if iA in arrNumbers {
    print("iA 在数组中")
}

var dictInfo = {name: "张三", age: 25, city: "北京"}
if "name" in dictInfo {
    print("dictInfo 包含 name 键")
}

// ---------- 使用 range 的 if 语句 ----------

print("\n使用 range 的 if 语句:")
var iAge = 25
if iAge in range(18, 30) {
    print("iAge 在 18 到 30 之间")
}

// ---------- 使用 is 运算符的 if 语句 ----------

print("\n使用 is 运算符的 if 语句:")
var vValue = 100
if vValue is int {
    print("vValue 是整数类型")
}

var vString = "hello"
if vString is string {
    print("vString 是字符串类型")
}

// ---------- 复杂条件表达式 ----------

print("\n复杂条件表达式:")
var bComplex = (iA > 0) and ((iB < 100) or (sName == "张三"))
if bComplex {
    print("复杂条件表达式为 true")
}

// ---------- 条件表达式中的赋值 ----------

print("\n条件表达式中的赋值:")
var iTemp
if (iTemp = iA + iB) > 25 {
    print("iA + iB =", iTemp, "> 25")
}
