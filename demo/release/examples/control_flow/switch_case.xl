// switch_case.xl
// 演示 switch-case 语句语法

// 1. 基本 switch-case 语句
print("1. 基本 switch-case 语句")
var iChoice = 2

switch iChoice {
    case 1: 
        print("选择了 1")
        break
    case 2: 
        print("选择了 2")
        break
    case 3: 
        print("选择了 3")
        break
    default: 
        print("无效选择")
}
print("")

// 2. 省略 break 语句（贯穿执行）
print("2. 省略 break 语句（贯穿执行）")
var iLevel = 2

switch iLevel {
    case 1: 
        print("等级 1")
    case 2: 
        print("等级 2")
    case 3: 
        print("等级 3")
        break
    default: 
        print("其他等级")
}
print("")

// 3. 多个 case 共用一个代码块
print("3. 多个 case 共用一个代码块")
var iDay = 3

switch iDay {
    case 1: 
    case 2: 
    case 3: 
    case 4: 
    case 5: 
        print("工作日")
        break
    case 6: 
    case 7: 
        print("周末")
        break
    default: 
        print("无效的星期")
}
print("")

// 4. switch 语句使用字符串
print("4. switch 语句使用字符串")
var sFruit = "banana"

switch sFruit {
    case "apple": 
        print("苹果")
        break
    case "banana": 
        print("香蕉")
        break
    case "cherry": 
        print("樱桃")
        break
    default: 
        print("未知水果")
}
print("")

// 5. switch 语句使用字符
print("5. switch 语句使用字符")
var cOperation = '+'
var iNum1 = 10
var iNum2 = 5
var iResult = 0

switch cOperation {
    case '+': 
        iResult = iNum1 + iNum2
        print(iNum1, "+ ", iNum2, " = ", iResult)
        break
    case '-': 
        iResult = iNum1 - iNum2
        print(iNum1, "- ", iNum2, " = ", iResult)
        break
    case '*': 
        iResult = iNum1 * iNum2
        print(iNum1, "* ", iNum2, " = ", iResult)
        break
    case '/': 
        iResult = iNum1 / iNum2
        print(iNum1, "/ ", iNum2, " = ", iResult)
        break
    default: 
        print("不支持的操作符")
}
print("")

// 6. switch 语句使用布尔值
print("6. switch 语句使用布尔值")
var bStatus = true

switch bStatus {
    case true: 
        print("状态为真")
        break
    case false: 
        print("状态为假")
        break
    default: 
        print("未知状态")
}
print("")

// 7. switch 语句在循环中使用
print("7. switch 语句在循环中使用")
for var i = 1; i <= 5; i++ {
    switch i % 2 {
        case 0: 
            print(i, "是偶数")
            break
        case 1: 
            print(i, "是奇数")
            break
    }
}
print("")

// 8. switch 语句使用表达式
print("8. switch 语句使用表达式")
var iScore = 85
var sGrade = ""

switch iScore {
    case iScore >= 90: 
        sGrade = "优秀"
        break
    case iScore >= 80: 
        sGrade = "良好"
        break
    case iScore >= 70: 
        sGrade = "中等"
        break
    case iScore >= 60: 
        sGrade = "及格"
        break
    default: 
        sGrade = "不及格"
}
print("分数:", iScore, ", 等级:", sGrade)