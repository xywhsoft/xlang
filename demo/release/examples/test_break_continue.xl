println("=== break n / continue n 测试 ===")

// 测试 break 2
println("测试 break 2:")
var i = 0
while i < 5
	var j = 0
	while j < 5
		if j == 2 then break 2
		print("i=")
		print(i)
		print(", j=")
		println(j)
		j = j + 1
	end
	i = i + 1
end
println("break 2 后继续")

// 测试 continue 2
println("\n测试 continue 2:")
for x in range(3)
	for y in range(3)
		if y == 1 then continue 2
		print("x=")
		print(x)
		print(", y=")
		println(y)
	end
	print("内层循环结束 x=")
	println(x)
end

// 测试普通 break
println("\n测试普通 break:")
for n in range(5)
	if n == 3 then break
	println(n)
end

// 测试普通 continue
println("\n测试普通 continue:")
for m in range(5)
	if m == 2 then continue
	println(m)
end

println("\n=== 测试完成 ===")
