// ============================================================
// xlang 示例：循环控制
// 演示 break、continue 和标签
// ============================================================

// ---------- break 跳出循环 ----------
print("break 示例:")
for i = 1 to 10
	if i == 5
		print("  到达 5，跳出循环")
		break
	end
	print(`  i = {$i}`)
end

// ---------- continue 跳过本次迭代 ----------
print("continue 示例（跳过偶数）:")
for i = 1 to 10
	if i % 2 == 0
		continue
	end
	print(`  i = {$i}`)
end

// ---------- 嵌套循环中的 break ----------
print("嵌套循环 break（只跳出内层）:")
for i = 1 to 3
	print(`外层 i = {$i}`)
	for j = 1 to 3
		if j == 2
			break
		end
		print(`  内层 j = {$j}`)
	end
end

// ---------- 带标签的 break ----------
print("带标签的 break（跳出外层循环）:")
outer: for i = 1 to 3
	for j = 1 to 3
		print(`  i={$i}, j={$j}`)
		if (i == 2) and (j == 2)
			print("  找到目标，跳出所有循环")
			break outer
		end
	end
end

// ---------- 带标签的 continue ----------
print("带标签的 continue:")
outer: for i = 1 to 3
	for j = 1 to 3
		if j == 2
			continue outer
		end
		print(`  i={$i}, j={$j}`)
	end
end

// ---------- while 中使用 break/continue ----------
print("while 中的 break/continue:")
int n = 0
while true
	n++
	if n % 2 == 0
		continue
	end
	if n > 10
		break
	end
	print(`  n = {$n}`)
end

// ---------- 实际应用：搜索 ----------
var lstData = [
	{ id: 1, name: "张三" },
	{ id: 2, name: "李四" },
	{ id: 3, name: "王五" }
]

int iSearchId = 2
var vFound = null

for item in lstData
	if item["id"] == iSearchId
		vFound = item
		break
	end
end

if vFound != null
	print(`找到: {$vFound["name"]}`)
else
	print("未找到")
end
