// ============================================================
// xlang 示例：if 条件语句
// 演示各种条件分支结构
// ============================================================

int iScore = 75

// ---------- 单行 if 语句（使用 then）----------
if iScore >= 60 then print("及格！")
if iScore >= 90 then print("优秀！")
if iScore < 60 then print("不及格")		// 不执行，因为条件不满足

// ---------- 简单 if ----------
if iScore >= 60
	print("及格")
end

// ---------- if-else ----------
if iScore >= 90
	print("优秀")
else
	print("继续努力")
end

// ---------- if-elseif-else ----------
if iScore >= 90
	print("等级: A")
elseif iScore >= 80
	print("等级: B")
elseif iScore >= 70
	print("等级: C")
elseif iScore >= 60
	print("等级: D")
else
	print("等级: F")
end

// ---------- 嵌套 if ----------
bool bIsMember = true
int iAge = 25

if bIsMember
	if iAge >= 18
		print("成年会员")
	else
		print("未成年会员")
	end
else
	if iAge >= 18
		print("成年非会员")
	else
		print("未成年非会员")
	end
end

// ---------- 条件表达式（复杂条件）----------
int iMonth = 8
int iDay = 15

if ( (iMonth >= 6) and (iMonth <= 8) )
	print("夏季")
end

if ( (iMonth == 12) or ((iMonth >= 1) and (iMonth <= 2)) )
	print("冬季")
end

// ---------- 使用 not ----------
bool bIsEmpty = false
if not bIsEmpty
	print("列表不为空")
end

// ---------- null 检查 ----------
var vData = null
if vData == null
	print("数据为空")
end

vData = "有数据"
if vData != null
	print(`数据: {$vData}`)
end
