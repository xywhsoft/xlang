// ============================================================
// xlang 示例：集合
// 演示集合（自动去重排序）的创建和操作
// ============================================================

// ---------- 创建集合 ----------
var setEmpty = new set()
var setNumbers = new set(3, 1, 4, 1, 5, 9, 2, 6)	// 自动去重
var setStrings = new set("apple", "banana", "apple")

print(`集合: {$setNumbers}`)						// 已排序去重
print(`字符串集合: {$setStrings}`)

// ---------- 集合特性：自动去重 ----------
var setDemo = new set(1, 1, 2, 2, 3, 3)
print(`去重后: {$setDemo}`)							// {1, 2, 3}

// ---------- 添加元素 ----------
var s = new set(1, 2, 3)
s.add(4)
print(`add(4): {$s}`)

s.add(2)											// 已存在，不会重复添加
print(`add(2): {$s}`)

// ---------- 删除元素 ----------
s.remove(2)
print(`remove(2): {$s}`)

// 安全删除（不存在不报错）
s.discard(100)
print(`discard(100): {$s}`)

// ---------- 检查元素 ----------
print(`contains(3): {$s.contains(3)}`)				// true
print(`3 in s: {$3 in s}`)							// true
print(`contains(100): {$s.contains(100)}`)			// false

// ---------- 集合大小 ----------
print(`大小: {$s.size()}`)
print(`是否为空: {$setEmpty.isEmpty()}`)

// ---------- 遍历集合 ----------
print("遍历集合:")
for item in setNumbers
	print(`  {$item}`)
end

// ---------- 集合运算 ----------
var setA = new set(1, 2, 3, 4, 5)
var setB = new set(4, 5, 6, 7, 8)

// 并集
var setUnion = setA.union(setB)
print(`并集: {$setUnion}`)							// {1,2,3,4,5,6,7,8}

// 交集
var setIntersect = setA.intersection(setB)
print(`交集: {$setIntersect}`)						// {4,5}

// 差集
var setDiff = setA.difference(setB)
print(`差集 A-B: {$setDiff}`)						// {1,2,3}

// 对称差集
var setSymDiff = setA.symmetricDifference(setB)
print(`对称差集: {$setSymDiff}`)					// {1,2,3,6,7,8}

// ---------- 集合关系 ----------
var setSuper = new set(1, 2, 3, 4, 5)
var setSub = new set(2, 3, 4)

print(`isSubset: {$setSub.isSubset(setSuper)}`)		// true
print(`isSuperset: {$setSuper.isSuperset(setSub)}`)	// true
print(`isDisjoint: {$setA.isDisjoint(new set(10, 20))}`)	// true

// ---------- 集合复制 ----------
var setCopy = setA.copy()
setCopy.add(100)
print(`原集合: {$setA}`)
print(`复制集合: {$setCopy}`)

// ---------- 集合转换 ----------
// 转为列表
var lstFromSet = setNumbers.toList()
print(`toList: {$lstFromSet}`)

// 从列表创建
var lstData = [3, 1, 4, 1, 5, 9, 2, 6]
var setFromList = new set(lstData)
print(`from list: {$setFromList}`)

// ---------- 集合清空 ----------
var setClear = new set(1, 2, 3)
setClear.clear()
print(`clear 后: {$setClear}`)

// ---------- 实际应用：去重 ----------
var lstDuplicates = [1, 2, 2, 3, 3, 3, 4, 4, 4, 4]
var lstUnique = new set(lstDuplicates).toList()
print(`去重后: {$lstUnique}`)

// ---------- 实际应用：查找共同好友 ----------
var setFriendsA = new set("Alice", "Bob", "Charlie", "David")
var setFriendsB = new set("Bob", "Charlie", "Eve", "Frank")
var setCommon = setFriendsA.intersection(setFriendsB)
print(`共同好友: {$setCommon}`)
