// ============================================================
// 测试 008: while 循环
// 测试 while-do 循环
// ============================================================

println("测试 008: while 循环")

// 基本 while 循环
var i = 1
while i <= 5
	println(i)
	i = i + 1
end

// 累加
var sum = 0
var n = 1
while n <= 10
	sum = sum + n
	n = n + 1
end
println(sum)

// 条件为 false 时不执行
var x = 10
while x < 5
	println("should not print")
	x = x + 1
end
println("skipped")

// 嵌套 while
var a = 1
while a <= 3
	var b = 1
	while b <= 3
		print(a * b)
		print(" ")
		b = b + 1
	end
	println("")
	a = a + 1
end

// 复杂条件
var count = 0
var limit = 5
while (count < limit) and (count >= 0)
	count = count + 1
end
println(count)

// 完成
println("测试 008 通过")
