// ============================================================
// 测试 014: 赋值运算符
// 测试 += -= *= /= %= 复合赋值
// ============================================================

println("测试 014: 赋值运算符")

// 加法赋值
var a = 10
a += 5
println(a)

// 减法赋值
var b = 20
b -= 8
println(b)

// 乘法赋值
var c = 5
c *= 4
println(c)

// 除法赋值
var d = 100
d /= 4
println(d)

// 取模赋值
var e = 17
e %= 5
println(e)

// 链式复合赋值
var x = 10
x += 5
x *= 2
x -= 10
println(x)

// 边界：赋值给自己
var y = 100
y = y + y
println(y)

// 完成
println("测试 014 通过")
