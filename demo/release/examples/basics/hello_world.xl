// ============================================================
// xlang 示例：Hello World
// 最简单的程序示例，演示基本输出语句
// ============================================================

// 输出文本到控制台
print("Hello, World!")

// 使用变量
var sMessage = "Welcome to xlang!"
print(sMessage)

// 多行输出
print("Hello, ")
print("xlang!")
