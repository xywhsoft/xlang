// ============================================================
// 测试 006: if-then-else 条件语句
// 测试基本条件分支
// ============================================================

println("测试 006: if-then-else 条件语句")

var a = 10
var b = 20

// 基本 if-end
if a < b
	println("a < b")
end

// if-else-end
if a > b
	println("a > b")
else
	println("a <= b")
end

// 嵌套 if
if a > 0
	if b > 0 then
		println("both positive")
	end
end

// 多个条件
var score = 85
if score >= 90 then
	println("excellent")
elseif score >= 80 then
	println("good")
elseif score >= 60 then
	println("pass")
else
	println("fail")
end

// 边界测试：相等
var c = 10
if a == c then
	println("a equals c")
end

// 边界测试：布尔值
var flag = true
if flag then
	println("flag is true")
end

if not flag then
	println("flag is false")
else
	println("flag is not false")
end

// 完成
println("测试 006 通过")
