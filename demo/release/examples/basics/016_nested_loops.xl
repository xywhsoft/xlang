// ============================================================
// 测试 016: 嵌套循环
// 测试多层嵌套循环
// ============================================================

println("测试 016: 嵌套循环")

// 双层 for 循环
println("2x3 matrix:")
for i in range(1, 2)
	for j in range(1, 3)
		print(i)
		print("x")
		print(j)
		print(" ")
	end
	println("")
end

// 三层 for 循环
println("3D:")
var count = 0
for i in range(1, 2)
	for j in range(1, 2)
		for k in range(1, 2)
			count = count + 1
		end
	end
end
println(count)

// 嵌套 while
println("nested while:")
var a = 1
while a <= 3 do
	var b = 1
	while b <= 3 do
		print(a * b)
		print(" ")
		b = b + 1
	end
	println("")
	a = a + 1
end

// 混合嵌套
println("mixed:")
for i in range(1, 3)
	var j = 1
	while j <= i do
		print("*")
		j = j + 1
	end
	println("")
end

// 完成
println("测试 016 通过")
