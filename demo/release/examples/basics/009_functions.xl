// ============================================================
// 测试 009: 函数定义和调用
// 测试 function 关键字定义函数
// ============================================================

println("测试 009: 函数定义和调用")

// 无参数函数
function sayHello()
	println("Hello!")
end

sayHello()

// 带参数函数
function greet(name)
	println("Hello, " + name + "!")
end

greet("xlang")

// 带返回值函数
function add(a, b)
	return a + b
end

var result = add(3, 5)
println(result)

// 多参数
function sum3(a, b, c)
	return a + b + c
end

println(sum3(1, 2, 3))

// 函数内局部变量
function localTest()
	var x = 100
	var y = 200
	return x + y
end

println(localTest())

// 函数调用作为参数
println(add(add(1, 2), add(3, 4)))

// 完成
println("测试 009 通过")
