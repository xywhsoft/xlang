// ============================================================
// xlang 示例：注释语法
// 演示单行注释和多行注释的使用
// ============================================================

// 这是单行注释
print("Hello, Comments!")  // 行尾注释

/* 这是
   多行
   注释 */

/* 多行注释可以嵌套 /* 内层注释 */ 嵌套结束 */

// ---------- 注释的使用场景 ----------

// 1. 说明变量用途
var iCount = 0  // 计数变量，初始化为 0

// 2. 说明函数功能
/*
   计算两个数的和
   参数：a - 第一个数
         b - 第二个数
   返回值：两数之和
*/
function add(int a, int b) as int {
    return a + b
}

// 3. 临时注释掉代码
// var sDebug = "调试信息"  // 暂时不需要的调试变量
// print(sDebug)

// 4. 标记代码段
/* ---------- 主程序开始 ---------- */

// 5. 说明复杂逻辑
function complexLogic(int x) as bool {
    // 如果 x 大于 0 且是偶数，返回 true
    // 否则返回 false
    return (x > 0) and (x % 2 == 0)
}

// 6. 文档注释（用于自动生成文档）
/**
 * 这是一个文档注释
 * 用于描述函数、类或模块
 * @param x 输入参数
 * @return 布尔值结果
 */
function documentedFunc(int x) as bool {
    return x > 0
}

// ---------- 运行示例 ----------
print("加法结果:", add(5, 3))
print("复杂逻辑结果(4):", complexLogic(4))
print("复杂逻辑结果(-2):", complexLogic(-2))
print("文档函数结果(10):", documentedFunc(10))
