// ============================================================
// xlang 示例：type() 函数
// 演示 type() 函数的使用，用于获取值的类型信息
// ============================================================

// ---------- 基本类型的 type() 结果 ----------

// 动态类型
var vDynamic = 42
print("动态类型初始值:", vDynamic, "类型:", type(vDynamic))

vDynamic = "string"
print("动态类型改为字符串:", vDynamic, "类型:", type(vDynamic))

vDynamic = true
print("动态类型改为布尔值:", vDynamic, "类型:", type(vDynamic))

// 整数类型
var iInt = 100
print("整数类型:", iInt, "类型:", type(iInt))

// 浮点数类型
var fFloat = 3.14
print("浮点数类型:", fFloat, "类型:", type(fFloat))

// 字符串类型
var sString = "test"
print("字符串类型:", sString, "类型:", type(sString))

// 布尔类型
bool bBool = false
print("布尔类型:", bBool, "类型:", type(bBool))

// 空值
var vNull = null
print("空值:", vNull, "类型:", type(vNull))

// ---------- 容器类型的 type() 结果 ----------

// 数组
var arrArray = [1, 2, 3]
print("数组:", arrArray, "类型:", type(arrArray))

// 列表
var lstList = [0:10, 1:20]
print("列表:", lstList, "类型:", type(lstList))

// 集合
var setSet = {1, 2, 3}
print("集合:", setSet, "类型:", type(setSet))

// 字典
var dictDict = {name: "test", value: 100}
print("字典:", dictDict, "类型:", type(dictDict))

// ---------- 函数类型的 type() 结果 ----------

function testFunc() {
    return 42
}

var fFunc = testFunc
print("函数变量:", fFunc, "类型:", type(fFunc))

// ---------- 对象类型的 type() 结果 ----------

class TestClass {
    create() {
        // 构造函数
    }
}

var objObject = new TestClass()
print("对象:", objObject, "类型:", type(objObject))

// ---------- type() 函数的实际应用 ----------

// 根据类型执行不同操作
function processValue(var value) {
    var tType = type(value)
    
    if tType == "int" {
        print("处理整数:", value, "平方:", value * value)
    } elseif tType == "string" {
        print("处理字符串:", value, "长度:", len(value))
    } elseif tType == "bool" {
        print("处理布尔值:", value, "反转:", !value)
    } else {
        print("处理其他类型:", value, "类型:", tType)
    }
}

// 测试不同类型
processValue(42)
processValue("hello")
processValue(true)
processValue([1, 2, 3])
processValue(null)
