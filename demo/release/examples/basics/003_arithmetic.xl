// ============================================================
// 测试 003: 算术运算符
// 测试 + - * / % 基本算术运算
// ============================================================

println("测试 003: 算术运算符")

var a = 10
var b = 3

// 加法
var sum = a + b
println(sum)

// 减法
var diff = a - b
println(diff)

// 乘法
var prod = a * b
println(prod)

// 除法
var quot = a / b
println(quot)

// 取模
var remainder = a % b
println(remainder)

// 负数
var negative = -a
println(negative)

// 复合运算
var complex = (a + b) * 2 - 1
println(complex)

// 浮点运算
var f1 = 10.5
var f2 = 3.2
println(f1 + f2)
println(f1 - f2)
println(f1 * f2)
println(f1 / f2)

// 整数与浮点混合
println(a + f2)

// 边界：零
var zero = 0
println(a + zero)
println(a * zero)

// 完成
println("测试 003 通过")
