// ============================================================
// 测试 018: 边界值测试 - 空值和特殊情况
// 测试空值和特殊边界条件
// ============================================================

println("测试 018: 空值和特殊情况")

// 单次循环
println("single iteration for:")
for i = 1 to 1
	println(i)
end

// 空循环 (start > end)
println("empty for loop:")
for i = 10 to 5
	println("should not print")
end
println("done")

// while 条件立即为 false
println("immediate false while:")
var x = 10
while x < 5
	println("should not print")
end
println("ok")

// 空函数
function emptyFunc()
end

emptyFunc()
println("empty function called")

// 只返回的函数
function returnOnly()
	return 42
end

println(returnOnly())

// 深度嵌套
if true then
	if true then
		if true then
			if true then
				println("deep nesting ok")
			end
		end
	end
end

// 完成
println("测试 018 通过")
