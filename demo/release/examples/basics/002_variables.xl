// ============================================================
// 测试 002: 变量声明
// 测试 var 变量声明和赋值
// ============================================================

println("测试 002: 变量声明")

// 基本变量声明和赋值
var a = 10
var b = 20
println(a)
println(b)

// 变量重新赋值
a = 100
println(a)

// 字符串变量
var s = "hello"
println(s)

// 浮点数变量
var f = 3.14
println(f)

// 多个变量
var x = 1
var y = 2
var z = 3
println(x)
println(y)
println(z)

// 中文标识符
var 变量 = 999
println(变量)

// 完成
println("测试 002 通过")
