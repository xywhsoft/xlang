// ============================================================
// xlang 示例：is 运算符
// 演示 is 运算符的使用，用于检查值的类型
// ============================================================

// ---------- 基本类型的 is 运算符 ----------

// 整数类型
var iInt = 100
print("整数类型检查:")
print(iInt, "is int:", iInt is int)
print(iInt, "is float:", iInt is float)
print(iInt, "is string:", iInt is string)
print(iInt, "is bool:", iInt is bool)

// 浮点数类型
var fFloat = 3.14
print("\n浮点数类型检查:")
print(fFloat, "is float:", fFloat is float)
print(fFloat, "is int:", fFloat is int)
print(fFloat, "is string:", fFloat is string)

// 字符串类型
var sString = "test"
print("\n字符串类型检查:")
print(sString, "is string:", sString is string)
print(sString, "is int:", sString is int)
print(sString, "is array:", sString is array)

// 布尔类型
var bBool = true
print("\n布尔类型检查:")
print(bBool, "is bool:", bBool is bool)
print(bBool, "is int:", bBool is int)
print(bBool, "is null:", bBool is null)

// 空值
var vNull = null
print("\n空值类型检查:")
print(vNull, "is null:", vNull is null)
print(vNull, "is int:", vNull is int)
print(vNull, "is string:", vNull is string)

// ---------- 容器类型的 is 运算符 ----------

// 数组
var arrArray = [1, 2, 3]
print("\n数组类型检查:")
print(arrArray, "is array:", arrArray is array)
print(arrArray, "is list:", arrArray is list)
print(arrArray, "is set:", arrArray is set)

// 列表
var lstList = [0:10, 1:20]
print("\n列表类型检查:")
print(lstList, "is list:", lstList is list)
print(lstList, "is array:", lstList is array)

// 集合
var setSet = {1, 2, 3}
print("\n集合类型检查:")
print(setSet, "is set:", setSet is set)
print(setSet, "is array:", setSet is array)

// 字典
var dictDict = {name: "test", value: 100}
print("\n字典类型检查:")
print(dictDict, "is dict:", dictDict is dict)
print(dictDict, "is list:", dictDict is list)

// ---------- 函数和对象的 is 运算符 ----------

function testFunc() {
    return 42
}

print("\n函数类型检查:")
print(testFunc, "is function:", testFunc is function)

class TestClass {
    create() {
        // 构造函数
    }
}

var objObject = new TestClass()
print("\n对象类型检查:")
print(objObject, "is TestClass:", objObject is TestClass)
print(objObject, "is object:", objObject is object)

// ---------- is 运算符与 type() 函数的比较 ----------

var iNum = 42
print("\nis 运算符与 type() 函数比较:")
print(iNum, "is int:", iNum is int)
print(iNum, "type() == \"int\":", type(iNum) == "int")

// ---------- is 运算符的实际应用 ----------

// 在条件语句中使用
function processData(var data) {
    if data is null {
        print("数据为空")
    } elseif data is int {
        print("处理整数:", data, "平方:", data * data)
    } elseif data is string {
        print("处理字符串:", data, "长度:", len(data))
    } elseif data is array {
        print("处理数组:", data, "元素个数:", len(data))
    } else {
        print("处理其他类型:", data)
    }
}

print("\nis 运算符实际应用:")
processData(null)
processData(10)
processData("hello")
processData([1, 2, 3, 4, 5])
processData(true)
