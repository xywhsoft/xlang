// ============================================================
// xlang 示例：数值类型
// 演示各种数值类型的声明和使用
// ============================================================

// ---------- 整数类型 ----------

// 有符号整数
int8 i8Value = 127
int16 i16Value = 32767
int32 i32Value = 2147483647
int64 i64Value = 9223372036854775807
int iDefaultInt = 100                  // int 默认为 int64

print("有符号整数类型:")
print("  int8: 最小值 =", int8(-128), "最大值 =", i8Value)
print("  int16: 最小值 =", int16(-32768), "最大值 =", i16Value)
print("  int32: 最小值 =", int32(-2147483648), "最大值 =", i32Value)
print("  int64: 最小值 =", int64(-9223372036854775808), "最大值 =", i64Value)
print("  int: 默认为 int64，值 =", iDefaultInt)

// 无符号整数
uint8 u8Value = 255
uint16 u16Value = 65535
uint32 u32Value = 4294967295
uint64 u64Value = 18446744073709551615

print("\n无符号整数类型:")
print("  uint8: 最小值 =", uint8(0), "最大值 =", u8Value)
print("  uint16: 最小值 =", uint16(0), "最大值 =", u16Value)
print("  uint32: 最小值 =", uint32(0), "最大值 =", u32Value)
print("  uint64: 最小值 =", uint64(0), "最大值 =", u64Value)

// ---------- 浮点数类型 ----------

float32 f32Value = 3.14159
float64 f64Value = 3.141592653589793
float fDefaultFloat = 2.718281828459045  // float 默认为 float64

print("\n浮点数类型:")
print("  float32: ", f32Value)
print("  float64: ", f64Value)
print("  float: 默认为 float64，值 =", fDefaultFloat)

// ---------- 数值字面量 ----------

// 十进制整数
var iDecimal = 123
print("\n十进制整数: ", iDecimal)

// 八进制整数
var iOctal1 = &O123  // &O 前缀
var iOctal2 = &o123  // &o 前缀
print("八进制整数: &O123 =", iOctal1, "&o123 =", iOctal2)

// 十六进制整数
var iHex1 = 0x123    // 0x 前缀
var iHex2 = &H123    // &H 前缀
var iHex3 = &h123    // &h 前缀
print("十六进制整数: 0x123 =", iHex1, "&H123 =", iHex2, "&h123 =", iHex3)

// 二进制整数
var iBin1 = 0b1010   // 0b 前缀
var iBin2 = &B1010   // &B 前缀
var iBin3 = &b1010   // &b 前缀
print("二进制整数: 0b1010 =", iBin1, "&B1010 =", iBin2, "&b1010 =", iBin3)

// 科学计数法
var fSci1 = 1.23e10
var fSci2 = 1.23e-10
print("科学计数法: 1.23e10 =", fSci1, "1.23e-10 =", fSci2)

// 下划线分隔的数字（增强可读性）
var iBigNum = 1_000_000
var fBigFloat = 1_234.567_890
print("下划线分隔数字: 1_000_000 =", iBigNum, "1_234.567_890 =", fBigFloat)

// ---------- 数值运算 ----------

// 整数运算
var iSum = i32Value + 100
var iDiff = i32Value - 100
var iProd = i32Value * 2
var iQuot = i32Value / 2
var iRem = i32Value % 3

print("\n整数运算:")
print("  ", i32Value, "+", 100, "=", iSum)
print("  ", i32Value, "-", 100, "=", iDiff)
print("  ", i32Value, "*", 2, "=", iProd)
print("  ", i32Value, "/", 2, "=", iQuot)
print("  ", i32Value, "%", 3, "=", iRem)

// 浮点数运算
var fSum = f64Value + 0.1
var fDiff = f64Value - 0.1
var fProd = f64Value * 2.0
var fQuot = f64Value / 2.0

print("\n浮点数运算:")
print("  ", f64Value, "+", 0.1, "=", fSum)
print("  ", f64Value, "-", 0.1, "=", fDiff)
print("  ", f64Value, "*", 2.0, "=", fProd)
print("  ", f64Value, "/", 2.0, "=", fQuot)

// ---------- 类型溢出处理 ----------

// 演示整数溢出
var i8Overflow = int8(127)
print("\n整数溢出演示:")
print("  int8(127) + 1 =", int8(i8Overflow + 1))  // 溢出，结果为 -128

var u8Overflow = uint8(255)
print("  uint8(255) + 1 =", uint8(u8Overflow + 1))  // 溢出，结果为 0
