// dict_types.xl
// 演示字典类型操作

println("=== 字典类型测试 ===")

// 1. 字典创建
println("")
println("1. 字典创建")
var person = {name: "Tom", age: 25, city: "Beijing"}
println("person 创建成功")

// 2. 字典访问
println("")
println("2. 字典访问")
println("name: " + person.name)
println("age: " + person.age)
println("city: " + person.city)

// 3. 空字典
println("")
println("3. 空字典")
var empty = {}
println("空字典创建成功")

// 4. 字符串键字典
println("")
println("4. 字符串键字典")
var info = {"first-name": "John", "last-name": "Doe"}
println("字符串键字典创建成功")

// 5. 字典遍历
println("")
println("5. 字典遍历")
var data = {x: 10, y: 20, z: 30}
for k, v in data
	println(k + " = " + v)
end

// 6. in 运算符
println("")
println("6. in 运算符检查键")
var config = {host: "localhost", port: 8080}
println("'host' in config: " + ("host" in config))
println("'timeout' in config: " + ("timeout" in config))

// 7. 嵌套字典
println("")
println("7. 嵌套字典")
var nested = {
	user: {name: "Alice", role: "admin"},
	settings: {theme: "dark", lang: "zh"}
}
println("user.name: " + nested.user.name)
println("settings.theme: " + nested.settings.theme)

// 8. 混合类型值
println("")
println("8. 混合类型值")
var mixed = {
	count: 100,
	rate: 3.14,
	active: true,
	label: "test"
}
println("count 类型: " + type(mixed.count))
println("rate 类型: " + type(mixed.rate))
println("active 类型: " + type(mixed.active))
println("label 类型: " + type(mixed.label))

// 9. 字典在条件中使用
println("")
println("9. 字典在条件中使用")
var user = {name: "Bob", verified: true}
if user.verified
	println(user.name + " 已验证")
else
	println(user.name + " 未验证")
end

// 10. 字典键值统计
println("")
println("10. 字典遍历统计")
var scores = {math: 90, english: 85, physics: 92}
var total = 0
var count = 0
for k, v in scores
	total = total + v
	count++
end
println("科目数: " + count)
println("总分: " + total)

println("")
println("=== 字典类型测试完成 ===")
