// bool_types.xl
// 演示布尔类型操作

println("=== 布尔类型测试 ===")

// 1. 布尔字面量
println("")
println("1. 布尔字面量")
var t = true
var f = false
println("true = " + t)
println("false = " + f)

// 2. 布尔类型检查
println("")
println("2. 布尔类型检查")
println("type(true) = " + type(t))
println("type(false) = " + type(f))

// 3. 逻辑运算
println("")
println("3. 逻辑运算")
println("true and true = " + (true and true))
println("true and false = " + (true and false))
println("true or false = " + (true or false))
println("not true = " + (not true))
println("not false = " + (not false))

// 4. 比较运算结果
println("")
println("4. 比较运算结果")
var a = 10
var b = 20
println("10 < 20 = " + (a < b))
println("10 > 20 = " + (a > b))
println("10 == 10 = " + (a == a))
println("10 != 20 = " + (a != b))

// 5. 布尔值在条件中使用
println("")
println("5. 布尔值在条件中使用")
var flag = true
if flag
	println("flag 为真")
end
if not flag
	println("不会打印")
else
	println("flag 不为假")
end

// 6. 布尔表达式
println("")
println("6. 布尔表达式")
var x = 5
var y = 10
var result = (x < y) and (y < 20)
println("(5 < 10) and (10 < 20) = " + result)
result = (x > y) or (y > 0)
println("(5 > 10) or (10 > 0) = " + result)

// 7. 复合条件
println("")
println("7. 复合条件")
var age = 25
var hasJob = true
var hasLicense = true
if (age >= 18) and hasJob and hasLicense
	println("符合所有条件")
end

// 8. 布尔值与循环
println("")
println("8. 布尔值与循环")
var continue_loop = true
var count = 0
while continue_loop do
	count++
	print(count + " ")
	if count >= 5
		continue_loop = false
	end
end
println("")

// 9. 布尔值存储在数组中
println("")
println("9. 布尔值存储在数组中")
var flags = [true, false, true, true, false]
var trueCount = 0
for flag in flags
	if flag
		trueCount++
	end
end
println("true 的数量: " + trueCount)

// 10. 布尔值比较
println("")
println("10. 布尔值比较")
println("true == true: " + (true == true))
println("false == false: " + (false == false))
println("true == false: " + (true == false))
println("true != false: " + (true != false))

println("")
println("=== 布尔类型测试完成 ===")
