// ============================================================
// xlang 示例：Lambda 表达式和闭包
// 演示匿名函数和闭包特性
// ============================================================

// ---------- Lambda 表达式（箭头函数）----------
var procDouble = (x) => x * 2
print(`double(5) = {$procDouble(5)}`)

// 多参数 lambda
var procAdd = (a, b) => a + b
print(`add(3, 4) = {$procAdd(3, 4)}`)

// 无参数 lambda
var procGetTime = () => time.now()
print(`当前时间: {$procGetTime()}`)

// ---------- 完整形式的匿名函数 ----------
var procGreet = function(string sName)
	return `Hello, {$sName}!`
end

print(procGreet("World"))

// ---------- 作为参数传递 ----------
function applyTwice(var procFunc, int iValue)
	return procFunc(procFunc(iValue))
end

print(`applyTwice(double, 3) = {$applyTwice(procDouble, 3)}`)

// ---------- 高阶函数 ----------
var lstNumbers = [1, 2, 3, 4, 5]

// map
var lstDoubled = lstNumbers.map((x) => x * 2)
print(`doubled: {$lstDoubled}`)

// filter
var lstEvens = lstNumbers.filter((x) => x % 2 == 0)
print(`evens: {$lstEvens}`)

// reduce
var iSum = lstNumbers.reduce((acc, x) => acc + x, 0)
print(`sum: {$iSum}`)

// ---------- 闭包 ----------
function makeCounter()
	int iCount = 0
	return function()
		iCount++
		return iCount
	end
end

var procCounter1 = makeCounter()
var procCounter2 = makeCounter()

print(`counter1: {$procCounter1()}`)	// 1
print(`counter1: {$procCounter1()}`)	// 2
print(`counter2: {$procCounter2()}`)	// 1（独立的计数器）
print(`counter1: {$procCounter1()}`)	// 3

// ---------- 闭包捕获变量 ----------
function makeMultiplier(int iFactor)
	return (x) => x * iFactor
end

var procTriple = makeMultiplier(3)
var procQuadruple = makeMultiplier(4)

print(`triple(5) = {$procTriple(5)}`)		// 15
print(`quadruple(5) = {$procQuadruple(5)}`)	// 20

// ---------- 立即执行函数 (IIFE) ----------
var vResult = (function()
	int a = 10
	int b = 20
	return a + b
end)()

print(`IIFE result: {$vResult}`)

// ---------- 函数柯里化 ----------
function curry(var procFunc)
	return function(a)
		return function(b)
			return procFunc(a, b)
		end
	end
end

var procCurriedAdd = curry(procAdd)
var procAdd5 = procCurriedAdd(5)
print(`add5(10) = {$procAdd5(10)}`)		// 15
