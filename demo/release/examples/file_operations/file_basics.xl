// 6. 检查文件是否存在
print("6. 检查文件是否存在")

try {
    if exists("test.txt") {
        print("test.txt 文件存在")
    } else {
        print("test.txt 文件不存在")
    }
    
    if exists("nonexistent.txt") {
        print("nonexistent.txt 文件存在")
    } else {
        print("nonexistent.txt 文件不存在")
    }
} catch e {
    print("检查文件存在失败:", e)
}
print("")

// 7. 获取文件信息
print("7. 获取文件信息")

try {
    if exists("test.txt") {
        print("文件大小:", size("test.txt"), "字节")
        print("创建时间:", create_time("test.txt"))
        print("修改时间:", modify_time("test.txt"))
        print("访问时间:", access_time("test.txt"))
    }
} catch e {
    print("获取文件信息失败:", e)
}
print("")

// 8. 删除文件
print("8. 删除文件")

try {
    if exists("test.txt") {
        remove("test.txt")
        print("test.txt 文件删除成功")
    } else {
        print("test.txt 文件不存在，无法删除")
    }
} catch e {
    print("删除文件失败:", e)
}

// 验证文件是否已删除
try {
    if exists("test.txt") {
        print("test.txt 文件仍然存在")
    } else {
        print("test.txt 文件已被删除")
    }
} catch e {
    print("检查文件存在失败:", e)
}
print("")

// 9. 重命名文件
print("9. 重命名文件")

// 先创建一个测试文件
try {
    var hFile = open("old_name.txt", "w")
    write(hFile, "这是一个测试文件。\n")
    close(hFile)
    print("创建测试文件成功")
    
    // 重命名文件
    rename("old_name.txt", "new_name.txt")
    print("文件重命名成功")
    
    // 验证重命名
    if exists("new_name.txt") {
        print("new_name.txt 文件存在")
    } else {
        print("new_name.txt 文件不存在")
    }
    
    if exists("old_name.txt") {
        print("old_name.txt 文件仍然存在")
    } else {
        print("old_name.txt 文件已不存在")
    }
    
    // 清理
    remove("new_name.txt")
} catch e {
    print("文件重命名失败:", e)
}
print("")

