// ============================================================
// xlang 示例：异步编程
// 演示 async/await 和协程
// ============================================================

// ---------- async 函数定义 ----------
async function fetchData(string sUrl)
	print(`开始获取: {$sUrl}`)
	var response = await http.get(sUrl)
	var data = await response.json()
	print(`获取完成: {$sUrl}`)
	return data
end

// ---------- await 等待结果 ----------
async function main()
	var data = await fetchData("https://api.example.com/users")
	print(`数据: {$data}`)
end

// ---------- 并行执行 (parallel) ----------
async function fetchMultiple()
	// 同时发起多个请求
	var results = await parallel(
		fetchData("https://api.example.com/users"),
		fetchData("https://api.example.com/posts"),
		fetchData("https://api.example.com/comments")
	)
	
	print(`用户: {$results[0]}`)
	print(`文章: {$results[1]}`)
	print(`评论: {$results[2]}`)
end

// ---------- 竞争执行 (race) ----------
async function fetchFirst()
	// 返回第一个完成的结果
	var first = await race(
		fetchData("https://api1.example.com/data"),
		fetchData("https://api2.example.com/data")
	)
	print(`最快结果: {$first}`)
end

// ---------- 超时处理 ----------
async function fetchWithTimeout(string sUrl, int iMs)
	try
		var result = await race(
			fetchData(sUrl),
			timeout(iMs)
		)
		return result
	catch TimeoutError e
		print(`请求超时: {$sUrl}`)
		return null
	end
end

// ---------- 异步循环 ----------
async function processItems(var lstItems)
	for item in lstItems
		var result = await processItem(item)
		print(`处理完成: {$item} -> {$result}`)
	end
end

// ---------- 异步错误处理 ----------
async function safeRequest(string sUrl)
	try
		var data = await fetchData(sUrl)
		return { success: true, data: data }
	catch NetworkError e
		return { success: false, error: e.message }
	end
end

// ---------- Awaitable 对象 ----------
async function deferredExecution()
	// 创建任务但不立即等待
	var task1 = fetchData("url1")		// 返回 Awaitable
	var task2 = fetchData("url2")
	
	// 执行其他操作...
	print("执行其他操作")
	
	// 稍后等待结果
	var result1 = await task1
	var result2 = await task2
end

// ---------- 协程（生成器）----------
function range(int iStart, int iEnd)
	for i = iStart to iEnd
		yield i
	end
end

print("range(1, 5):")
for n in range(1, 5)
	print(`  {$n}`)
end

// ---------- 无限生成器 ----------
function infiniteCounter()
	int i = 0
	while true
		yield i
		i++
	end
end

var counter = infiniteCounter()
print(`第一个: {$resume(counter)}`)
print(`第二个: {$resume(counter)}`)
print(`第三个: {$resume(counter)}`)

// ---------- 手动控制协程 ----------
var co = coroutine(function()
	print("协程开始")
	yield "step1"
	print("继续执行")
	yield "step2"
	print("即将结束")
	return "done"
end)

print(`状态: {$co.status}`)			// created
var r1 = resume(co)
print(`结果1: {$r1}`)					// step1
print(`状态: {$co.status}`)			// suspended
var r2 = resume(co)
print(`结果2: {$r2}`)					// step2
var r3 = resume(co)
print(`结果3: {$r3}`)					// done
print(`状态: {$co.status}`)			// dead

// ---------- 协程间通信 ----------
function producer(var chOutput)
	for i = 1 to 5
		print(`生产: {$i}`)
		yield i
	end
end

function consumer(var coProducer)
	while coProducer.status != "dead"
		var value = resume(coProducer)
		if value != null
			print(`消费: {$value}`)
		end
	end
end

var prod = coroutine(producer)
consumer(prod)
