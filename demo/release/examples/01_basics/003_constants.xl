// ============================================================
// xlang 示例：常量声明
// 演示常量的定义和使用
// ============================================================

// ---------- 常量声明 ----------
const float PI = 3.14159265358979
const int MAX_SIZE = 1024
const string APP_NAME = "MyApplication"
const bool DEBUG_MODE = true

// ---------- 使用常量 ----------
float fRadius = 5.0
float fArea = PI * fRadius * fRadius
print(`圆的面积: {$fArea}`)

// ---------- 常量不可修改 ----------
// PI = 3.14						// 错误：常量不能被修改

// ---------- 编译时常量表达式 ----------
const int BUFFER_SIZE = MAX_SIZE * 2
const string VERSION = "1.0.0"
const string FULL_NAME = APP_NAME + " v" + VERSION

print(`应用名称: {$FULL_NAME}`)
print(`缓冲区大小: {$BUFFER_SIZE}`)
