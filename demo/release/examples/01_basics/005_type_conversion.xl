// ============================================================
// xlang 示例：类型转换
// 演示显式类型转换函数的使用
// ============================================================

// ---------- 数值类型转换 ----------
var vValue = "123"
int iFromString = int(vValue)			// 字符串转整数
float fFromString = float("3.14")		// 字符串转浮点数

int iNumber = 42
string sFromInt = string(iNumber)		// 整数转字符串

float fNumber = 3.7
int iTruncated = int(fNumber)			// 浮点转整数（截断）: 3

// ---------- 布尔转换 ----------
bool bFromInt = bool(1)					// 非零为 true
bool bFromZero = bool(0)				// 零为 false
bool bFromString = bool("hello")		// 非空字符串为 true
bool bFromEmpty = bool("")				// 空字符串为 false

// ---------- 整数位宽转换 ----------
int64 i64Big = 9223372036854775807
int32 i32Casted = int32(i64Big)			// 可能溢出，需要注意

uint8 u8Byte = 255
int16 i16Extended = int16(u8Byte)		// 扩展位宽

// ---------- 浮点精度转换 ----------
float64 f64Precise = 3.141592653589793
float32 f32Reduced = float32(f64Precise)	// 精度降低

// ---------- 输出结果 ----------
print(`字符串 "123" 转整数: {$iFromString}`)
print(`浮点数 3.7 转整数: {$iTruncated}`)
print(`整数 1 转布尔: {$bFromInt}`)
print(`空字符串转布尔: {$bFromEmpty}`)
