// ============================================================
// xlang 示例：变量声明与数据类型
// 演示各种变量声明方式和基本数据类型
// ============================================================

// ---------- 动态类型变量 (var) ----------
var vAnything = 42
vAnything = "now I'm a string"
vAnything = true
print(vAnything)

// ---------- 整数类型 ----------
int8 i8Value = 127
int16 i16Value = 32767
int32 i32Value = 2147483647
int64 i64Value = 9223372036854775807
int iDefault = 100						// int 默认为 int32

// ---------- 无符号整数 ----------
uint8 u8Value = 255
uint16 u16Value = 65535
uint32 u32Value = 4294967295
uint64 u64Value = 18446744073709551615

// ---------- 浮点类型 ----------
float32 f32Value = 3.14159
float64 f64Value = 3.141592653589793
float fDefault = 2.718					// float 默认为 float64

// ---------- 布尔类型 ----------
bool bFlag = true
bool bEnabled = false

// ---------- 字符串类型 ----------
string sName = "张三"
string sPath = 'C:\Windows\System32'	// 单引号不转义

// ---------- 空值 ----------
var vEmpty = null
if vEmpty == null
	print("变量为空")
end

// ---------- 类型查询 ----------
print(typeof(i32Value))					// 输出: int32
print(typeof(sName))					// 输出: string
print(typeof(bFlag))					// 输出: bool
