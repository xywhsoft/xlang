// ============================================================
// xlang 示例：数字字面量
// 演示各种进制的数字表示方法
// ============================================================

// ---------- 十进制整数 ----------
int iDecimal = 255
int iNegative = -100
int iLarge = 1_000_000					// 下划线分隔，增强可读性

// ---------- 十六进制整数 ----------
int iHex1 = 0xFF						// 0x 前缀
int iHex2 = 0x1A2B3C4D
int iHex3 = &HFF						// &H 前缀（VB风格）

// ---------- 八进制整数 ----------
int iOctal1 = &O377						// &O 前缀
int iOctal2 = &O755
// 注意：不支持 C 语言的 0 前缀表示法，避免歧义

// ---------- 二进制整数 ----------
int iBinary1 = 0b11111111				// 0b 前缀
int iBinary2 = 0b1010_1010				// 带下划线分隔
int iBinary3 = &B11111111				// &B 前缀

// ---------- 浮点数 ----------
float fNormal = 3.14159
float fScientific1 = 1.23e10			// 科学计数法
float fScientific2 = 1.23E-5			// 负指数
float fNoLeading = .5					// 0.5
float fNoTrailing = 5.					// 5.0

// ---------- 输出验证 ----------
print(`十进制 255 = 十六进制 {$iHex1}`)
print(`二进制 0b11111111 = {$iBinary1}`)
print(`科学计数法 1.23e10 = {$fScientific1}`)
