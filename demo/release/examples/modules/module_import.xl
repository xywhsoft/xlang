/*
// 在模块中，__name__ 属性是模块的名称
// 在主程序中，__name__ 属性是 "__main__"

if __name__ is "__main__":
    print("这是主程序")
else:
    print("这是被导入的模块")
*/

// 7. 循环导入
print("7. 循环导入")

/*
// 循环导入是指两个或多个模块相互导入
// module_a.xl
import module_b
func func_a() {
    print("func_a in module_a")
    module_b.func_b()
}

// module_b.xl
import module_a
func func_b() {
    print("func_b in module_b")
    module_a.func_a()
}

// 主程序
simport module_a
module_a.func_a()
*/

print("注意: 循环导入可能导致问题，应尽量避免")
print("")

