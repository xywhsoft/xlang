// array_list_boundary.xl
// 数组和列表边界测试

// 1. 数组边界测试
print("1. 数组边界测试")

// 空数组
var arrEmpty = []
print("空数组长度:", len(arrEmpty))
print("空数组类型:", type(arrEmpty))
print("空数组 == []:", arrEmpty == [])

// 单元素数组
var arrSingle = [1]
print("单元素数组长度:", len(arrSingle))
print("单元素数组[0]:", arrSingle[0])

// 多元素数组
var arrMulti = [1, 2, 3, 4, 5]
print("多元素数组长度:", len(arrMulti))
print("多元素数组[0]:", arrMulti[0])
print("多元素数组[-1]:", arrMulti[-1])  // 最后一个元素

// 数组索引边界测试
print("数组索引边界测试:")
print("arrMulti[4]:", arrMulti[4])  // 最后一个元素
// print("arrMulti[5]:", arrMulti[5])  // 超出边界，应该抛出异常
// print("arrMulti[-6]:", arrMulti[-6])  // 负索引超出边界，应该抛出异常

print("")

// 2. 数组操作边界测试
print("2. 数组操作边界测试")

// 向空数组添加元素
var arrTest = []
print("向空数组添加元素前长度:", len(arrTest))
push(arrTest, 1)
push(arrTest, 2)
push(arrTest, 3)
print("向空数组添加元素后长度:", len(arrTest))
print("数组内容:", arrTest)

// 从数组中移除元素
print("从数组中移除元素:")
print("移除索引0前:", arrTest)
pop(arrTest, 0)
print("移除索引0后:", arrTest)

// 移除最后一个元素
print("移除最后一个元素前:", arrTest)
pop(arrTest)
print("移除最后一个元素后:", arrTest)

// 从空数组中移除元素
print("从空数组中移除元素:")
var arrEmpty2 = []
// pop(arrEmpty2)  // 应该抛出异常

// 数组切片边界测试
print("数组切片边界测试:")
var arrSlice = [1, 2, 3, 4, 5]
print("arrSlice[0:2]:", arrSlice[0:2])  // 正常切片
print("arrSlice[0:10]:", arrSlice[0:10])  // 结束索引超出边界
print("arrSlice[-10:10]:", arrSlice[-10:10])  // 开始和结束索引都超出边界
print("arrSlice[2:0]:", arrSlice[2:0])  // 开始索引大于结束索引，返回空数组
print("arrSlice[:]:", arrSlice[:])  // 完整切片

print("")

// 3. 列表边界测试
print("3. 列表边界测试")

// 空列表
var lstEmpty = list()
print("空列表长度:", len(lstEmpty))
print("空列表类型:", type(lstEmpty))
print("空列表 == list():", lstEmpty == list())

// 单元素列表
var lstSingle = list("a")
print("单元素列表长度:", len(lstSingle))
print("单元素列表[0]:", lstSingle[0])

// 多元素列表
var lstMulti = list(1, 2, 3, 4, 5)
print("多元素列表长度:", len(lstMulti))
print("多元素列表[0]:", lstMulti[0])
print("多元素列表[-1]:", lstMulti[-1])  // 最后一个元素

// 列表索引边界测试
print("列表索引边界测试:")
print("lstMulti[4]:", lstMulti[4])  // 最后一个元素
// print("lstMulti[5]:", lstMulti[5])  // 超出边界，应该抛出异常
// print("lstMulti[-6]:", lstMulti[-6])  // 负索引超出边界，应该抛出异常

print("")

// 4. 列表操作边界测试
print("4. 列表操作边界测试")

// 向空列表添加元素
var lstTest = list()
print("向空列表添加元素前长度:", len(lstTest))
push(lstTest, "a")
push(lstTest, "b")
push(lstTest, "c")
print("向空列表添加元素后长度:", len(lstTest))
print("列表内容:", lstTest)

// 从列表中移除元素
print("从列表中移除元素:")
print("移除索引0前:", lstTest)
pop(lstTest, 0)
print("移除索引0后:", lstTest)

// 移除最后一个元素
print("移除最后一个元素前:", lstTest)
pop(lstTest)
print("移除最后一个元素后:", lstTest)

// 从空列表中移除元素
print("从空列表中移除元素:")
var lstEmpty2 = list()
// pop(lstEmpty2)  // 应该抛出异常

// 列表切片边界测试
print("列表切片边界测试:")
var lstSlice = list(1, 2, 3, 4, 5)
print("lstSlice[0:2]:", lstSlice[0:2])  // 正常切片
print("lstSlice[0:10]:", lstSlice[0:10])  // 结束索引超出边界
print("lstSlice[-10:10]:", lstSlice[-10:10])  // 开始和结束索引都超出边界
print("lstSlice[2:0]:", lstSlice[2:0])  // 开始索引大于结束索引，返回空列表
print("lstSlice[:]:", lstSlice[:])  // 完整切片

print("")

// 5. 数组和列表的混合操作
print("5. 数组和列表的混合操作")

var arrMixed = [1, 2, 3]
var lstMixed = list(4, 5, 6)

// 数组和列表的转换
print("数组转列表:", list(arrMixed))
print("列表转数组:", array(lstMixed))

// 数组和列表的拼接
print("数组 + 列表:", arrMixed + lstMixed)
print("列表 + 数组:", lstMixed + arrMixed)

// 数组和列表的比较
print("数组 == 列表:", arrMixed == list(1, 2, 3))
print("数组类型 == 列表类型:", type(arrMixed) == type(lstMixed))

print("")

// 6. 数组和列表的遍历边界测试
print("6. 数组和列表的遍历边界测试")

// 遍历空数组
var arrEmpty3 = []
print("遍历空数组:")
for var item in arrEmpty3 {
    print("数组元素:", item)
}

// 遍历单元素数组
var arrSingle3 = ["test"]
print("遍历单元素数组:")
for var item in arrSingle3 {
    print("数组元素:", item)
}

// 遍历空列表
var lstEmpty3 = list()
print("遍历空列表:")
for var item in lstEmpty3 {
    print("列表元素:", item)
}

// 遍历单元素列表
var lstSingle3 = list(123)
print("遍历单元素列表:")
for var item in lstSingle3 {
    print("列表元素:", item)
}

print("")

// 7. 数组和列表的修改边界测试
print("7. 数组和列表的修改边界测试")

// 修改数组元素
var arrModify = [1, 2, 3]
print("修改数组元素前:", arrModify)
arrModify[0] = 100
arrModify[-1] = 300
print("修改数组元素后:", arrModify)

// 修改列表元素
var lstModify = list(1, 2, 3)
print("修改列表元素前:", lstModify)
lstModify[0] = "a"
lstModify[-1] = "c"
print("修改列表元素后:", lstModify)

// 修改超出边界的元素
// arrModify[5] = 500  // 超出边界，应该抛出异常
// lstModify[5] = "e"  // 超出边界，应该抛出异常

print("")

// 8. 数组和列表的内置函数边界测试
print("8. 数组和列表的内置函数边界测试")

// 空数组的内置函数
var arrEmpty4 = []
print("空数组的内置函数:")
print("max(arrEmpty4):", max(arrEmpty4) if len(arrEmpty4) > 0 else "空数组无法计算最大值")
print("min(arrEmpty4):", min(arrEmpty4) if len(arrEmpty4) > 0 else "空数组无法计算最小值")
print("sum(arrEmpty4):", sum(arrEmpty4))  // 空数组求和返回0

// 空列表的内置函数
var lstEmpty4 = list()
print("空列表的内置函数:")
print("max(lstEmpty4):", max(lstEmpty4) if len(lstEmpty4) > 0 else "空列表无法计算最大值")
print("min(lstEmpty4):", min(lstEmpty4) if len(lstEmpty4) > 0 else "空列表无法计算最小值")
print("sum(lstEmpty4):", sum(lstEmpty4))  // 空列表求和返回0

// 单元素数组的内置函数
var arrSingle4 = [5]
print("单元素数组的内置函数:")
print("max(arrSingle4):", max(arrSingle4))
print("min(arrSingle4):", min(arrSingle4))
print("sum(arrSingle4):", sum(arrSingle4))

// 单元素列表的内置函数
var lstSingle4 = list(10)
print("单元素列表的内置函数:")
print("max(lstSingle4):", max(lstSingle4))
print("min(lstSingle4):", min(lstSingle4))
print("sum(lstSingle4):", sum(lstSingle4))

print("")

// 9. 数组和列表的嵌套边界测试
print("9. 数组和列表的嵌套边界测试")

// 空嵌套数组
var arrNestedEmpty = [[]]
print("空嵌套数组:", arrNestedEmpty)
print("空嵌套数组长度:", len(arrNestedEmpty))
print("空嵌套数组[0]长度:", len(arrNestedEmpty[0]))

// 单元素嵌套数组
var arrNestedSingle = [[1]]
print("单元素嵌套数组:", arrNestedSingle)
print("单元素嵌套数组[0][0]:", arrNestedSingle[0][0])

// 多元素嵌套数组
var arrNestedMulti = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
print("多元素嵌套数组:", arrNestedMulti)
print("多元素嵌套数组[1][2]:", arrNestedMulti[1][2])

// 空嵌套列表
var lstNestedEmpty = list(list())
print("空嵌套列表:", lstNestedEmpty)
print("空嵌套列表长度:", len(lstNestedEmpty))
print("空嵌套列表[0]长度:", len(lstNestedEmpty[0]))

// 单元素嵌套列表
var lstNestedSingle = list(list("a"))
print("单元素嵌套列表:", lstNestedSingle)
print("单元素嵌套列表[0][0]:", lstNestedSingle[0][0])

// 多元素嵌套列表
var lstNestedMulti = list(list(1, 2), list(3, 4), list(5, 6))
print("多元素嵌套列表:", lstNestedMulti)
print("多元素嵌套列表[1][1]:", lstNestedMulti[1][1])