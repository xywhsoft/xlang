// dict_boundary.xl
// 字典边界测试

// 1. 字典基本边界测试
print("1. 字典基本边界测试")

// 空字典
var tblEmpty = {}
print("空字典长度:", len(tblEmpty))
print("空字典类型:", type(tblEmpty))
print("空字典 == {}:", tblEmpty == {})

// 单键值对字典
var tblSingle = {"key": "value"}
print("单键值对字典长度:", len(tblSingle))
print("单键值对字典['key']:", tblSingle["key"])

// 多键值对字典
var tblMulti = {"name": "xlang", "version": "3.0", "type": "programming language"}
print("多键值对字典长度:", len(tblMulti))
print("多键值对字典['name']:", tblMulti["name"])
print("多键值对字典['version']:", tblMulti["version"])

print("")

// 2. 字典键访问边界测试
print("2. 字典键访问边界测试")

// 访问不存在的键
print("访问不存在的键 tblMulti['nonexistent']:", tblMulti["nonexistent"] is null)  // 应该返回 null

// 使用 in 操作符检查键是否存在
print("'name' in tblMulti:", "name" in tblMulti)
print("'nonexistent' in tblMulti:", "nonexistent" in tblMulti)

// 使用不同类型的键
var tblMixedKeys = {
    1: "number key",
    "string key": "string value",
    true: "bool key",
    3.14: "float key"
}
print("不同类型的键的字典:", tblMixedKeys)
print("访问数字键 1:", tblMixedKeys[1])
print("访问字符串键 'string key':", tblMixedKeys["string key"])
print("访问布尔键 true:", tblMixedKeys[true])
print("访问浮点数键 3.14:", tblMixedKeys[3.14])

print("")

// 3. 字典操作边界测试
print("3. 字典操作边界测试")

// 向字典添加键值对
var tblTest = {}
print("向空字典添加键值对前长度:", len(tblTest))
tblTest["key1"] = "value1"
tblTest["key2"] = "value2"
tblTest["key3"] = "value3"
print("向空字典添加键值对后长度:", len(tblTest))
print("字典内容:", tblTest)

// 修改字典中的值
print("修改字典中的值:")
print("修改前 tblTest['key1']:", tblTest["key1"])
tblTest["key1"] = "new value1"
print("修改后 tblTest['key1']:", tblTest["key1"])

// 删除字典中的键值对
print("删除字典中的键值对:")
print("删除前字典内容:", tblTest)
delete tblTest["key2"]
print("删除后字典内容:", tblTest)

// 删除不存在的键
print("删除不存在的键:")
delete tblTest["nonexistent"]  // 应该不会抛出异常
print("删除不存在的键后字典内容:", tblTest)

// 清空字典
print("清空字典:")
tblTest = {}
print("清空后字典长度:", len(tblTest))
print("清空后字典内容:", tblTest)

print("")

// 4. 字典遍历边界测试
print("4. 字典遍历边界测试")

// 遍历空字典
var tblEmpty2 = {}
print("遍历空字典:")
for var key, value in tblEmpty2 {
    print("字典键:", key, ", 值:", value)
}

// 遍历单键值对字典
var tblSingle2 = {"key": "value"}
print("遍历单键值对字典:")
for var key, value in tblSingle2 {
    print("字典键:", key, ", 值:", value)
}

// 遍历多键值对字典
var tblMulti2 = {"a": 1, "b": 2, "c": 3}
print("遍历多键值对字典:")
for var key, value in tblMulti2 {
    print("字典键:", key, ", 值:", value)
}

print("")

// 5. 字典内置函数边界测试
print("5. 字典内置函数边界测试")

// keys() 函数
var tblKeysTest = {"name": "xlang", "version": "3.0"}
print("keys() 函数返回值:", keys(tblKeysTest))
print("keys() 函数返回类型:", type(keys(tblKeysTest)))

// values() 函数
print("values() 函数返回值:", values(tblKeysTest))
print("values() 函数返回类型:", type(values(tblKeysTest)))

// items() 函数
print("items() 函数返回值:", items(tblKeysTest))
print("items() 函数返回类型:", type(items(tblKeysTest)))

// 空字典的内置函数
var tblEmpty3 = {}
print("空字典的 keys() 函数:", keys(tblEmpty3))
print("空字典的 values() 函数:", values(tblEmpty3))
print("空字典的 items() 函数:", items(tblEmpty3))

print("")

// 6. 字典比较边界测试
print("6. 字典比较边界测试")

var tblA = {"a": 1, "b": 2, "c": 3}
var tblB = {"a": 1, "b": 2, "c": 3}
var tblC = {"c": 3, "b": 2, "a": 1}  // 键顺序不同，但键值对相同
var tblD = {"a": 1, "b": 2, "d": 4}  // 键不同
var tblE = {"a": 1, "b": 2}  // 长度不同

print("tblA == tblB:", tblA == tblB)  // 应该是 true
print("tblA == tblC:", tblA == tblC)  // 应该是 true，因为字典键值对相同，顺序不影响
print("tblA == tblD:", tblA == tblD)  // 应该是 false
print("tblA == tblE:", tblA == tblE)  // 应该是 false
print("tblA == {}", tblA == {})  // 应该是 false
print("{} == {}", {} == {})  // 应该是 true

print("")

// 7. 字典嵌套边界测试
print("7. 字典嵌套边界测试")

// 空嵌套字典
var tblNestedEmpty = {"nested": {}}
print("空嵌套字典:", tblNestedEmpty)
print("空嵌套字典['nested']长度:", len(tblNestedEmpty["nested"]))

// 单键值对嵌套字典
var tblNestedSingle = {"nested": {"key": "value"}}
print("单键值对嵌套字典:", tblNestedSingle)
print("单键值对嵌套字典['nested']['key']:", tblNestedSingle["nested"]["key"])

// 多级嵌套字典
var tblNestedMulti = {
    "level1": {
        "level2": {
            "level3": "deep value"
        }
    }
}
print("多级嵌套字典:", tblNestedMulti)
print("多级嵌套字典['level1']['level2']['level3']:", tblNestedMulti["level1"]["level2"]["level3"])

// 访问嵌套字典中不存在的键
print("访问嵌套字典中不存在的键:")
print("tblNestedMulti['level1']['nonexistent']:", tblNestedMulti["level1"]["nonexistent"] is null)
// print("tblNestedMulti['nonexistent']['level2']:", tblNestedMulti["nonexistent"]["level2"])  // 应该抛出异常，因为外层键不存在

print("")

// 8. 字典的内存和性能边界测试
print("8. 字典的内存和性能边界测试")

// 大字典
var tblLarge = {}
print("创建大字典前:")
for var i = 0; i < 100; i++ {
    var sKey = "key" + str(i)
    tblLarge[sKey] = "value" + str(i)
}
print("创建大字典后，长度:", len(tblLarge))
print("大字典['key99']:", tblLarge["key99"])

// 频繁修改字典
var tblFreq = {}
print("频繁修改字典前:")
for var i = 0; i < 50; i++ {
    var sKey = "key" + str(i)
    tblFreq[sKey] = i
    // 立即修改
    tblFreq[sKey] = i * 2
}
print("频繁修改字典后，长度:", len(tblFreq))
print("频繁修改字典['key49']:", tblFreq["key49"])

print("")

// 9. 字典的特殊键测试
print("9. 字典的特殊键测试")

// 使用空字符串作为键
var tblEmptyKey = {"": "empty string key"}
print("使用空字符串作为键:", tblEmptyKey)
print("访问空字符串键:", tblEmptyKey[""])

// 使用数字 0 作为键
var tblZeroKey = {0: "zero key"}
print("使用数字 0 作为键:", tblZeroKey)
print("访问数字 0 键:", tblZeroKey[0])
print("访问字符串 \"0\" 键:", tblZeroKey["0"] is null)  // 应该返回 null，因为键类型不同

// 使用 null 作为键
var tblNullKey = {null: "null key"}
print("使用 null 作为键:", tblNullKey)
print("访问 null 键:", tblNullKey[null])

// 使用数组作为键（如果xlang支持的话）
// var tblArrayKey = {[1, 2, 3]: "array key"}
// print("使用数组作为键:", tblArrayKey)
// print("访问数组键:", tblArrayKey[[1, 2, 3]])

// 使用对象作为键（如果xlang支持的话）
// var pObj = {"name": "test"}
// var tblObjKey = {pObj: "object key"}
// print("使用对象作为键:", tblObjKey)
// print("访问对象键:", tblObjKey[pObj])

print("")

// 10. 字典的类型转换边界测试
print("10. 字典的类型转换边界测试")

// 字典转字符串
var tblToString = {"name": "xlang", "version": "3.0"}
print("字典转字符串:", str(tblToString))
print("字典转字符串类型:", type(str(tblToString)))

// 空字典转字符串
print("空字典转字符串:", str({}))

// 单键值对字典转字符串
print("单键值对字典转字符串:", str({"key": "value"}))