// number_boundary.xl
// 演示数字类型的边界值测试

println("=== 数字边界值测试 ===")

// 1. 整数基本测试
println("")
println("1. 整数基本测试")
var zero = 0
var one = 1
var negOne = -1
println("0 = " + zero)
println("1 = " + one)
println("-1 = " + negOne)

// 2. 大整数
println("")
println("2. 大整数")
var bigInt = 1000000000
println("十亿 = " + bigInt)
var veryBig = 9223372036854775807
println("最大 i64 = " + veryBig)

// 3. 负整数
println("")
println("3. 负整数")
var negBig = -1000000000
println("-十亿 = " + negBig)

// 4. 浮点数基本测试
println("")
println("4. 浮点数基本测试")
var fZero = 0.0
var fOne = 1.0
var fNegOne = -1.0
println("0.0 = " + fZero)
println("1.0 = " + fOne)
println("-1.0 = " + fNegOne)

// 5. 小数精度
println("")
println("5. 小数精度")
var pi = 3.14159265358979
println("pi = " + pi)
var small = 0.0000001
println("0.0000001 = " + small)

// 6. 科学计数法
println("")
println("6. 大浮点数")
var bigFloat = 1.5e10
println("1.5e10 = " + bigFloat)
var smallFloat = 1.5e-10
println("1.5e-10 = " + smallFloat)

// 7. 整数运算边界
println("")
println("7. 整数运算")
var a = 1000000
var b = 1000000
println("1000000 * 1000000 = " + (a * b))
println("1000000 + 1000000 = " + (a + b))

// 8. 浮点数运算
println("")
println("8. 浮点数运算")
var x = 0.1
var y = 0.2
println("0.1 + 0.2 = " + (x + y))
var z = 0.3
println("(0.1 + 0.2) == 0.3: " + ((x + y) == z))

// 9. 除法测试
println("")
println("9. 除法测试")
println("10 / 3 = " + (10 / 3))
println("10 / 4 = " + (10 / 4))
println("-10 / 3 = " + (-10 / 3))

// 10. 取模测试
println("")
println("10. 取模测试")
println("10 % 3 = " + (10 % 3))
println("-10 % 3 = " + (-10 % 3))
println("10 % -3 = " + (10 % -3))

// 11. 乘方边界
println("")
println("11. 乘方边界")
println("2 ** 10 = " + (2 ** 10))
println("2 ** 20 = " + (2 ** 20))
println("2 ** 30 = " + (2 ** 30))
println("10 ** 0 = " + (10 ** 0))
println("0 ** 10 = " + (0 ** 10))

// 12. 零值运算
println("")
println("12. 零值运算")
println("0 + 0 = " + (0 + 0))
println("0 * 100 = " + (0 * 100))
println("0 / 100 = " + (0 / 100))

// 13. 类型转换
println("")
println("13. 类型转换")
var intVal = 42
var floatVal = 3.14
println("int + float = " + (intVal + floatVal))
println("int * float = " + (intVal * floatVal))

// 14. 比较边界
println("")
println("14. 比较边界")
println("0 == 0: " + (0 == 0))
println("0 < 1: " + (0 < 1))
println("-1 < 0: " + (-1 < 0))
println("0 >= 0: " + (0 >= 0))
println("0 <= 0: " + (0 <= 0))

// 15. 自增自减边界
println("")
println("15. 自增自减边界")
var n = 0
println("n = 0, ++n = " + (++n))
println("n 现在 = " + n)
n = 0
println("n = 0, n++ = " + (n++))
println("n 现在 = " + n)

println("")
println("=== 数字边界值测试完成 ===")
