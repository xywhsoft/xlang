// number_boundary.xl
// 数值类型边界测试

// 1. 整数边界测试
print("1. 整数边界测试")

// 正整数
var iPositive = 123
print("正整数:", iPositive)
print("正整数类型:", type(iPositive))

// 负整数
var iNegative = -123
print("负整数:", iNegative)
print("负整数类型:", type(iNegative))

// 零
var iZero = 0
print("零:", iZero)
print("零类型:", type(iZero))

// 大整数
var iLarge = 999999999999999
print("大整数:", iLarge)
print("大整数类型:", type(iLarge))

print("")

// 2. 浮点数边界测试
print("2. 浮点数边界测试")

// 正浮点数
var fPositive = 3.14159
print("正浮点数:", fPositive)
print("正浮点数类型:", type(fPositive))

// 负浮点数
var fNegative = -3.14159
print("负浮点数:", fNegative)
print("负浮点数类型:", type(fNegative))

// 零浮点数
var fZero = 0.0
print("零浮点数:", fZero)
print("零浮点数类型:", type(fZero))

// 非常小的浮点数
var fSmall = 0.0000000001
print("非常小的浮点数:", fSmall)

// 非常大的浮点数
var fLarge = 1000000000.0
print("非常大的浮点数:", fLarge)

// 科学计数法
var fSci = 1.23e6
print("科学计数法:", fSci)
print("科学计数法类型:", type(fSci))

print("")

// 3. 整数运算边界测试
print("3. 整数运算边界测试")

// 整数加法
print("1000000000 + 1:", 1000000000 + 1)
print("-1000000000 - 1:", -1000000000 - 1)

// 整数乘法
print("1000000 * 1000000:", 1000000 * 1000000)
print("-1000000 * 1000000:", -1000000 * 1000000)

// 整数除法
print("5 / 2:", 5 / 2)  // 整数除法可能返回浮点数
print("5 // 2:", 5 // 2)  // 整除
print("5 % 2:", 5 % 2)  // 取模
print("0 / 1:", 0 / 1)  // 零除以非零数
// print("1 / 0:", 1 / 0)  // 除以零，应该抛出异常

print("")

// 4. 浮点数运算边界测试
print("4. 浮点数运算边界测试")

// 浮点数加法
print("0.1 + 0.2:", 0.1 + 0.2)  // 浮点数精度问题
print("1.0e10 + 1.0:", 1.0e10 + 1.0)

// 浮点数乘法
print("0.1 * 0.2:", 0.1 * 0.2)  // 浮点数精度问题
print("1.0e10 * 1.0e10:", 1.0e10 * 1.0e10)

// 浮点数除法
print("1.0 / 0.0:", 1.0 / 0.0)  // 正无穷
print("-1.0 / 0.0:", -1.0 / 0.0)  // 负无穷
print("0.0 / 0.0:", 0.0 / 0.0)  // NaN

// 浮点数比较
print("0.1 + 0.2 == 0.3:", 0.1 + 0.2 == 0.3)  // 应该是 false，因为浮点数精度问题
print("abs((0.1 + 0.2) - 0.3) < 1e-10:", abs((0.1 + 0.2) - 0.3) < 1e-10)  // 正确的比较方式

print("")

// 5. 类型转换边界测试
print("5. 类型转换边界测试")

// 整数转浮点数
print("int(123) -> float:", float(123))
print("int(-123) -> float:", float(-123))
print("int(0) -> float:", float(0))

// 浮点数转整数
print("float(3.14) -> int:", int(3.14))  // 截断小数部分
print("float(3.99) -> int:", int(3.99))  // 截断小数部分
print("float(-3.14) -> int:", int(-3.14))  // 截断小数部分
print("float(1.0e10) -> int:", int(1.0e10))  // 大浮点数转整数

// 字符串转数字
print("str(\"123\") -> int:", int("123"))
print("str(\"-123\") -> int:", int("-123"))
print("str(\"3.14\") -> float:", float("3.14"))
print("str(\"1.23e6\") -> float:", float("1.23e6"))

// 无效的字符串转数字
// print("str(\"abc\") -> int:", int("abc"))  // 应该抛出异常
// print("str(\"123abc\") -> int:", int("123abc"))  // 应该抛出异常

print("")

// 6. 数值比较边界测试
print("6. 数值比较边界测试")

// 整数比较
print("123 > 45:", 123 > 45)
print("123 < 45:", 123 < 45)
print("123 == 123:", 123 == 123)
print("123 == 123.0:", 123 == 123.0)  // 整数与浮点数比较

// 浮点数比较
print("3.14 > 2.71:", 3.14 > 2.71)
print("3.14 < 2.71:", 3.14 < 2.71)
print("3.14 == 3.14:", 3.14 == 3.14)

// NaN 比较
var fNaN = 0.0 / 0.0
print("NaN == NaN:", fNaN == fNaN)  // NaN 不等于任何值，包括它自己
print("isnan(NaN):", isnan(fNaN))  // 正确的 NaN 检查方式

print("")

// 7. 位运算边界测试
print("7. 位运算边界测试")

// 正数位运算
print("123 & 45:", 123 & 45)  // 与运算
print("123 | 45:", 123 | 45)  // 或运算
print("123 ^ 45:", 123 ^ 45)  // 异或运算
print("~123:", ~123)  // 取反运算
print("123 << 1:", 123 << 1)  // 左移运算
print("123 >> 1:", 123 >> 1)  // 右移运算

// 负数位运算
print("-123 & 45:", -123 & 45)  // 与运算
print("-123 | 45:", -123 | 45)  // 或运算
print("-123 ^ 45:", -123 ^ 45)  // 异或运算
print("~-123:", ~-123)  // 取反运算
print("-123 << 1:", -123 << 1)  // 左移运算
print("-123 >> 1:", -123 >> 1)  // 右移运算

// 零的位运算
print("0 & 123:", 0 & 123)  // 与运算
print("0 | 123:", 0 | 123)  // 或运算
print("0 ^ 123:", 0 ^ 123)  // 异或运算
print("~0:", ~0)  // 取反运算
print("0 << 1:", 0 << 1)  // 左移运算
print("0 >> 1:", 0 >> 1)  // 右移运算

print("")

// 8. 数值函数边界测试
print("8. 数值函数边界测试")

// 绝对值
print("abs(123):", abs(123))
print("abs(-123):", abs(-123))
print("abs(0):", abs(0))
print("abs(3.14):", abs(3.14))
print("abs(-3.14):", abs(-3.14))

// 最大值
print("max(1, 2, 3):", max(1, 2, 3))
print("max(-1, -2, -3):", max(-1, -2, -3))
print("max(1, 2.5, 3):", max(1, 2.5, 3))

// 最小值
print("min(1, 2, 3):", min(1, 2, 3))
print("min(-1, -2, -3):", min(-1, -2, -3))
print("min(1, 2.5, 3):", min(1, 2.5, 3))

// 四舍五入
print("round(3.14):", round(3.14))
print("round(3.5):", round(3.5))
print("round(-3.14):", round(-3.14))
print("round(-3.5):", round(-3.5))
print("round(3.14159, 2):", round(3.14159, 2))  // 保留两位小数

// 幂运算
print("pow(2, 3):", pow(2, 3))
print("pow(2, -3):", pow(2, -3))
print("pow(0, 0):", pow(0, 0))  // 零的零次方
print("pow(10, 100):", pow(10, 100))  // 大数幂运算

print("")

// 9. 类型判断边界测试
print("9. 类型判断边界测试")

print("is 123 int:", 123 is int)
print("is -123 int:", -123 is int)
print("is 0 int:", 0 is int)
print("is 3.14 int:", 3.14 is int)
print("is 3.14 float:", 3.14 is float)
print("is 123.0 float:", 123.0 is float)
print("is 0.0 float:", 0.0 is float)
print("is \"123\" int:", "123" is int)