// ============================================================
// xlang 示例：字符串基础
// 演示各种字符串字面量表示方法
// ============================================================

// ---------- 双引号字符串（支持转义）----------
string s1 = "Hello, World!"
string s2 = "第一行\n第二行"				// 换行
string s3 = "制表符:\t分隔"				// 制表符
string s4 = "引号: \"这是引号\""			// 转义双引号
string s5 = "反斜杠: C:\\Windows"			// 反斜杠

print(s1)
print(s2)
print(s3)
print(s4)
print(s5)

// ---------- 单引号字符串（原始字符串，不转义）----------
string sPath = 'C:\Windows\System32'		// 反斜杠不需要转义
string sRegex = '^\d+\.\d+$'				// 正则表达式
string sQuote = 'He said ''Hello'''		// 两个单引号表示一个单引号

print(`路径: {$sPath}`)
print(`正则: {$sRegex}`)
print(`引用: {$sQuote}`)

// ---------- 三双引号字符串（多行，支持转义）----------
string sMultiline = """
这是一个多行字符串
可以直接换行
支持转义符: \t 制表符
"""

print("多行字符串:")
print(sMultiline)

// ---------- 三单引号字符串（多行，不转义）----------
string sRawMultiline = '''
正则表达式示例:
^[a-zA-Z0-9]+$
\d{3}-\d{4}
\w+@\w+\.\w+
反斜杠保持原样: C:\Users\Name
'''

print("原始多行字符串:")
print(sRawMultiline)

// ---------- 转义符列表 ----------
print("转义符演示:")
print("换行符 \\n: A\nB")
print("回车符 \\r: 用于行首覆盖")
print("制表符 \\t: A\tB\tC")
print("反斜杠 \\\\: \\")
print("双引号 \\\": \"")
print("空字符 \\0: A\0B（B不会显示）")
print("十六进制 \\x41: \x41")			// A
print("Unicode \\u{4e2d}: \u{4e2d}")	// 中

// ---------- 特殊字符 ----------
string sUnicode = "中文测试 αβγ ✓✗"
string sEmoji = "表情符号: 😀🎉🚀"
print(sUnicode)
print(sEmoji)
