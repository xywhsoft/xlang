// ============================================================
// xlang 示例：模板字符串
// 演示字符串插值和模板功能
// ============================================================

string sName = "张三"
int iAge = 25
float fScore = 95.5

// ---------- 基本插值 ----------
print(`Hello, {$sName}!`)
print(`{$sName} 今年 {$iAge} 岁`)
print(`分数: {$fScore}`)

// ---------- 表达式插值 ----------
int a = 10
int b = 20
print(`{$a} + {$b} = {$a + b}`)
print(`{$a} * {$b} = {$a * b}`)
print(`{$a} 的平方是 {$a ** 2}`)

// ---------- 调用函数 ----------
function getGreeting(string sName)
	return `Hello, {$sName}!`
end

print(getGreeting("李四"))

// ---------- 嵌套属性访问 ----------
var tblPerson = {
	name: "王五",
	age: 30,
	address: {
		city: "北京",
		district: "海淀"
	}
}

print(`{$tblPerson["name"]} 住在 {$tblPerson["address"]["city"]}`)

// ---------- 多行模板字符串 ----------
string sEmail = `
Dear {$sName},

感谢您的注册！

您的账户信息如下：
- 用户名: {$sName}
- 年龄: {$iAge}
- 注册时间: {$time.now()}

祝好！
`

print(sEmail)

// ---------- HTML 模板 ----------
var lstItems = ["苹果", "香蕉", "橙子"]
string sListItems = ""
for item in lstItems
	sListItems += `<li>{$item}</li>\n`
end

string sHtml = `
<html>
<body>
	<h1>水果列表</h1>
	<ul>
{$sListItems}	</ul>
</body>
</html>
`

print(sHtml)

// ---------- JSON 模板 ----------
string sJson = `{
	"name": "{$sName}",
	"age": {$iAge},
	"score": {$fScore}
}`

print("JSON:")
print(sJson)

// ---------- SQL 模板（注意：实际使用应该用参数化查询）----------
string sTable = "users"
int iLimit = 10
string sSql = `SELECT * FROM {$sTable} WHERE age > {$iAge} LIMIT {$iLimit}`
print(`SQL: {$sSql}`)

// ---------- 模板字符串不转义 ----------
string sRawTemplate = `路径: C:\Users\{$sName}\Documents`
print(sRawTemplate)		// 反斜杠保持原样
