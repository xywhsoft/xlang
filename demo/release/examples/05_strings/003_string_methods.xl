// ============================================================
// xlang 示例：字符串操作
// 演示常用的字符串方法
// ============================================================

string sText = "  Hello, World!  "

// ---------- 长度和空检查 ----------
print(`长度: {$sText.length()}`)
print(`是否为空: {$sText.isEmpty()}`)
print(`是否为空或空白: {$sText.isBlank()}`)

// ---------- 大小写转换 ----------
print(`大写: {$sText.upper()}`)
print(`小写: {$sText.lower()}`)
print(`首字母大写: {$"hello world".capitalize()}`)
print(`标题格式: {$"hello world".title()}`)		// Hello World

// ---------- 去除空白 ----------
print(`trim: [{$sText.trim()}]`)
print(`trimLeft: [{$sText.trimLeft()}]`)
print(`trimRight: [{$sText.trimRight()}]`)

// ---------- 查找和位置 ----------
string sSearch = "Hello, World"
print(`indexOf('o'): {$sSearch.indexOf("o")}`)			// 4
print(`lastIndexOf('o'): {$sSearch.lastIndexOf("o")}`)	// 8
print(`contains('World'): {$sSearch.contains("World")}`)	// true
print(`startsWith('Hello'): {$sSearch.startsWith("Hello")}`)
print(`endsWith('World'): {$sSearch.endsWith("World")}`)

// ---------- 截取子串 ----------
print(`substring(0, 5): {$sSearch.substring(0, 5)}`)	// Hello
print(`substring(7): {$sSearch.substring(7)}`)			// World
print(`left(5): {$sSearch.left(5)}`)					// Hello
print(`right(5): {$sSearch.right(5)}`)					// World

// ---------- 替换 ----------
print(`replace: {$sSearch.replace("World", "xlang")}`)
print(`replaceAll: {$"a-b-c".replaceAll("-", "_")}`)

// ---------- 分割和连接 ----------
string sCsv = "apple,banana,orange"
var lstParts = sCsv.split(",")
print(`split: {$lstParts}`)

var lstWords = ["Hello", "World"]
print(`join: {$lstWords.join(" ")}`)
print(`join: {$lstWords.join("-")}`)

// ---------- 填充和对齐 ----------
string sNum = "42"
print(`padLeft: [{$sNum.padLeft(5, '0')}]`)		// [00042]
print(`padRight: [{$sNum.padRight(5, '-')}]`)	// [42---]
print(`center: [{$sNum.center(6)}]`)			// [  42  ]

// ---------- 重复 ----------
print(`repeat: {$"ab".repeat(3)}`)				// ababab

// ---------- 反转 ----------
print(`reverse: {$"Hello".reverse()}`)			// olleH

// ---------- 字符操作 ----------
string sChar = "Hello"
print(`charAt(0): {$sChar.charAt(0)}`)			// H
print(`charCodeAt(0): {$sChar.charCodeAt(0)}`)	// 72

// ---------- 字符串比较 ----------
print(`compare: {$"abc".compare("abd")}`)		// -1
print(`compareIgnoreCase: {$"ABC".compareIgnoreCase("abc")}`)	// 0

// ---------- 格式化 ----------
print(`format: {$string.format("{0} + {1} = {2}", 1, 2, 3)}`)
