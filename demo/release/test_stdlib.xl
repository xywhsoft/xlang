// 测试内置函数库

println("========== 字符串函数测试 ==========")
var s = "  Hello World  "
println("trim: [" + trim(s) + "]")
println("ltrim: [" + ltrim(s) + "]")
println("rtrim: [" + rtrim(s) + "]")
println("upper: " + upper("hello"))
println("lower: " + lower("HELLO"))
println("replace: " + replace("hello world", "world", "xlang"))
var arr = split("a,b,c,d", ",")
println("split: " + len(arr) + " items")
println("join: " + join(arr, "-"))
println("find: " + find("hello world", "world"))
println("contains: " + contains("hello world", "world"))
println("substr: " + substr("hello world", 0, 5))
println("startswith: " + startswith("hello", "hel"))
println("endswith: " + endswith("hello", "llo"))
println("repeat: " + repeat("ab", 3))
println("reverse: " + reverse("hello"))

println("\n========== 数学函数测试 ==========")
println("rand: " + rand())
println("random: " + random())
println("randrange(1,10): " + randrange(1, 10))
println("pow(2,10): " + pow(2, 10))
println("sqrt(16): " + sqrt(16))
println("log(2.718): " + log(2.718))
println("sin(0): " + sin(0))
println("cos(0): " + cos(0))

println("\n========== 时间函数测试 ==========")
var t = now()
println("now: " + t)
println("year: " + year(t))
println("month: " + month(t))
println("day: " + day(t))
println("hour: " + hour(t))
println("minute: " + minute(t))
println("second: " + second(t))
println("weekday: " + weekday(t))
println("strftime: " + strftime(t, "yyyy-mm-dd hh:nn:ss"))
println("timestamp: " + timestamp(t))
println("timer: " + timer())

println("\n========== 文件函数测试 ==========")
println("exists(.): " + exists("."))
println("isdir(.): " + isdir("."))
println("isfile(test_stdlib.xl): " + isfile("test_stdlib.xl"))

println("\n========== JSON函数测试 ==========")
var obj = {"name": "xlang", "version": 1.0}
var jsonStr = json_stringify(obj)
println("json_stringify: " + jsonStr)
var parsed = json_parse("{\"a\":1,\"b\":2}")
println("json_parse: " + parsed["a"])

println("\n========== 编码函数测试 ==========")
var encoded = base64_encode("Hello World")
println("base64_encode: " + encoded)
println("base64_decode: " + base64_decode(encoded))
println("hex_encode: " + hex_encode("ABC"))
println("hex_decode: " + hex_decode("414243"))

println("\n========== 所有测试完成 ==========")
