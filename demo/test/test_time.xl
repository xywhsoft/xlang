// 测试 time 时间类型

println("=== Testing time ===")

// 获取当前时间
var t = now()
println("Current time: " + t.format("yyyy-mm-dd hh:mm:ss"))
println("Year: " + string(t.year()))
println("Month: " + string(t.month()))
println("Day: " + string(t.day()))
println("Hour: " + string(t.hour()))
println("Minute: " + string(t.minute()))
println("Second: " + string(t.second()))
println("Weekday: " + string(t.weekday()))
println("Timestamp: " + string(t.timestamp()))

// 创建指定时间
var t2 = datetime(2024, 6, 15, 10, 30, 45)
println("")
println("Created time: " + t2.format("yyyy-mm-dd hh:mm:ss"))
println("Year: " + string(t2.year()))
println("Month: " + string(t2.month()))
println("Day: " + string(t2.day()))

// 创建只有日期的时间
var t3 = datetime(2025, 1, 1)
println("")
println("Date only: " + t3.format("yyyy-mm-dd"))

println("")
println("=== All time tests passed ===")
