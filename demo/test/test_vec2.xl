// 测试多个运算符重载

println("=== Vec2 Test ===")

class Vec2
	var x = 0
	var y = 0
	
	create(x, y)
		self.x = x
		self.y = y
	end
	
	meta add(other)
		return new Vec2(self.x + other.x, self.y + other.y)
	end
	
	meta sub(other)
		return new Vec2(self.x - other.x, self.y - other.y)
	end
end

var v1 = new Vec2(3, 4)
var v2 = new Vec2(1, 2)
var v3 = v1 + v2
println("v1 + v2 = (" + string(v3.x) + ", " + string(v3.y) + ")")

var v4 = v1 - v2
println("v1 - v2 = (" + string(v4.x) + ", " + string(v4.y) + ")")

println("=== Done ===")
