// 测试索引操作

println("=== Index Test ===")

class MyArray
	var data = [10, 20, 30, 40, 50]
	
	meta index(key)
		println("  [index] key=" + string(key))
		return self.data[key]
	end
	
	meta newindex(key, val)
		println("  [newindex] key=" + string(key) + " val=" + string(val))
		self.data[key] = val
	end
end

var arr = new MyArray()
println("arr[2] = " + string(arr[2]))
arr[2] = 999
println("arr[2] = " + string(arr[2]))

println("=== Done ===")
