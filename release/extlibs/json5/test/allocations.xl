import json5

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

int failures = 0
int successes = 0

array<string> inputs = ["{answer:42}", "{answer:0x8000000000000401}", "{answer:9223372036854775808}", "{answer:1.234567890123456789012345678901}"]
for source in inputs
    for operation in range(4)
        for allocation in range(24)
            bool memoryCaught = false
            bool wrongCaught = false
            assert failAfter(uint64(allocation))
            try
                if operation == 0 then
                    json5.parse(source)
                elseif operation == 1 then
                    json5.valid(source)
                elseif operation == 2 then
                    json5.getValue(source, "answer")
                else
                    json5.get(source, "answer")
                end
            catch MemoryError error
                memoryCaught = true
            catch RuntimeError error
                wrongCaught = true
            catch ValueError error
                wrongCaught = true
            end
            bool triggered = failTriggered()
            failClear()
            assert not wrongCaught and memoryCaught == triggered
            if triggered then failures += 1 else successes += 1 end
        end
    end
    var recovery = json5.parse(source)
    assert json5.valid(source)
    assert json5.getValue(source, "answer") == recovery["answer"]
    assert string.byteLen(json5.get(source, "answer")) > 0
end
assert failures > 0 and successes > 0

var document = json5.parse("{answer:42}")
assert document["answer"] == 42
assert json5.valid("{answer:42}")
assert json5.getValue("{answer:42}", "answer") == 42
assert json5.get("{answer:42}", "answer") == "42"
println("json5 allocation: PASS")
