import trie

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

int createFailures = 0
int createSuccesses = 0
// 从首个分配点扫到成功路径，不依赖运行时固定的分配次数。
for allocation in range(128)
    bool caught = false
    assert failAfter(uint64(allocation))
    try
        trie.Trie candidate = trie.create()
        assert candidate.valid
    catch MemoryError error
        caught = true
    end
    bool triggered = failTriggered()
    failClear()
    assert caught == triggered, "create error does not match injection"
    if caught then createFailures += 1 else createSuccesses += 1 end
    if createFailures > 0 and createSuccesses > 0 then break end
end
assert createFailures > 0 and createSuccesses > 0, "create scan lacks failure or success"

int insertFailures = 0
int insertSuccesses = 0
// 插入也逐点扫描；找到故障和恢复后立即停止。
for allocation in range(128)
    trie.Trie words = trie.create()
    words.insert("old")
    bool caught = false
    assert failAfter(uint64(allocation))
    try
        words.insert("new")
    catch MemoryError error
        caught = true
    end
    bool triggered = failTriggered()
    failClear()
    assert caught == triggered, "insert error does not match injection"
    assert words.contains("old"), "insert failure lost old key"
    assert words.contains("new") == not caught, "insert result differs from error"
    if caught then
        assert words.count == 1, "failed insert changed count"
    else
        assert words.count == 2, "successful insert did not change count"
    end
    if caught then insertFailures += 1 else insertSuccesses += 1 end
    if insertFailures > 0 and insertSuccesses > 0 then break end
end
assert insertFailures > 0 and insertSuccesses > 0, "insert scan lacks failure or success"
println("trie allocations: PASS")
