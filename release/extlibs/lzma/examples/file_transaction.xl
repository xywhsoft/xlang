import lzma

// 取消或回调抛错不改写旧目标；修正条件后可立即重试。
func main(...) as int
    string work = dir.temp(prefix = "xlang-xz-transaction-")
    string source = path.join(work, "输入.txt")
    string packed = path.join(work, "output.xz")
    string restored = path.join(work, "restored.txt")
    try
        assert file.writeText(source, "hello XZ")
        assert file.writeText(packed, "keep")
        bool cancelled = false
        try
            lzma.compressFile(source, packed, onProgress = func(int inputBytes,
                int totalBytes, int outputBytes) as bool
                return false
            end)
        catch CancelledError e
            cancelled = true
        end
        assert cancelled and file.readText(packed) == "keep"

        bool rejected = false
        try
            lzma.compressFile(source, packed, onProgress = func(int inputBytes,
                int totalBytes, int outputBytes) as bool
                throw ValueError "stop requested"
            end)
        catch ValueError e
            rejected = true
        end
        assert rejected and file.readText(packed) == "keep"

        lzma.compressFile(source, packed)
        lzma.decompressFile(packed, restored)
        assert file.readText(restored) == "hello XZ"
        println("cancelled: true")
        println("callback error: true")
        println("restored: hello XZ")
    finally
        if file.exists(source) then assert file.delete(source) end
        if file.exists(packed) then assert file.delete(packed) end
        if file.exists(restored) then assert file.delete(restored) end
        assert dir.delete(work)
    end
    return 0
end
