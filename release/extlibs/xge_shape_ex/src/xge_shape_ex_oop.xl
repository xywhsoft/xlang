// xge_shape_ex_oop.xl - ShapeEx / Svg OOP 封装
// 手工维护，提供矢量形状与 SVG 的 native-backed class
// 依赖 xge_shape_ex.xl / xge_svg.xl 的自动生成函数转接层

// OOP bridge extern 声明（来自 xge_native.c）
extern "__xl6_xgeShapeExCreate" func __xgeShapeExCreateOwned() as point
extern "__xl6_xgeSvgCreate" func __xgeSvgCreateOwned() as point
extern "__xl6_xgeSvgLoadFile" func __xgeSvgLoadOwned(string sURI) as point
extern "__xl6_xgeSvgDraw" func __xgeSvgDrawRect(point pSvg, c_float fX, c_float fY, c_float fW, c_float fH, c_float fTolerance) as c_int

// ========================================
// ShapeEx — 增强矢量形状（路径 + 填充/描边 + 渐变/特效）
// ========================================
export class ShapeEx
    native point handle

    extern "__xl6_xgeShapeExCreate" create()
    extern "__xl6_xgeShapeExDestroyOwned" destroy()

    // --- 路径构建 ---
    func moveTo(float x, float y) as int
        return int(xgeShapeExMoveTo(self.handle, c_float(x), c_float(y)))
    end

    func lineTo(float x, float y) as int
        return int(xgeShapeExLineTo(self.handle, c_float(x), c_float(y)))
    end

    func closePath() as int
        return int(xgeShapeExClose(self.handle))
    end

    func appendRect(float x, float y, float w, float h, float rx, float ry, int clockwise) as int
        return int(xgeShapeExAppendRect(self.handle, c_float(x), c_float(y), c_float(w), c_float(h), c_float(rx), c_float(ry), c_int(clockwise)))
    end

    func appendCircle(float cx, float cy, float rx, float ry, int clockwise) as int
        return int(xgeShapeExAppendCircle(self.handle, c_float(cx), c_float(cy), c_float(rx), c_float(ry), c_int(clockwise)))
    end

    // --- 填充 ---
    func fillColor(uint32 color) as int
        return int(xgeShapeExFillColor(self.handle, c_uint(color)))
    end

    func fillRule(int rule) as int
        return int(xgeShapeExFillRule(self.handle, c_int(rule)))
    end

    // --- 描边 ---
    func strokeColor(uint32 color) as int
        return int(xgeShapeExStrokeColor(self.handle, c_uint(color)))
    end

    func strokeWidth(float width) as int
        return int(xgeShapeExStrokeWidth(self.handle, c_float(width)))
    end

    func strokeCap(int cap) as int
        return int(xgeShapeExStrokeCap(self.handle, c_int(cap)))
    end

    func strokeJoin(int join) as int
        return int(xgeShapeExStrokeJoin(self.handle, c_int(join)))
    end

    func strokeMiterLimit(float limit) as int
        return int(xgeShapeExStrokeMiterLimit(self.handle, c_float(limit)))
    end

    // --- 绘制 ---
    func draw(float tolerance) as int
        return int(xgeShapeExDraw(self.handle, c_float(tolerance)))
    end
end

// ========================================
// Svg — SVG 文档（加载 + 绘制）
// ========================================
export class Svg
    native point handle

    // 构造重载：空文档 / 从 URI 加载
    extern "__xl6_xgeSvgCreate" create()
    extern "__xl6_xgeSvgLoadFile" create(string uri)
    extern "__xl6_xgeSvgDestroyOwned" destroy()

    // --- 加载 ---
    func load(string uri) as int
        return int(xgeSvgLoad(self.handle, uri))
    end

    // --- 绘制（目标矩形，非像素对齐） ---
    func draw(float x, float y, float w, float h, float tolerance) as int
        return int(__xgeSvgDrawRect(self.handle, c_float(x), c_float(y), c_float(w), c_float(h), c_float(tolerance)))
    end
end
