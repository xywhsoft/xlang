// Offline typed ingress and closure ownership; no handshake or verification.
import xmail
extern "xl6ForeignNetEngineOwnerV1" @nonblocking func engineOwner(NetEngine engine) as var
extern "xl6ForeignTlsClientOwnerV1" @nonblocking func contextOwner(TlsClientContext context) as var
extern "mail_context_probe" func probe(var engine, var context) as bool
func ownedContext() as var
    auto captures = [17]
    auto callback = func(TlsVerifiedPeer peer) as bool
        return captures[0] == 17
    end
    auto trust = TrustStore()
    assert trust.add(Certificate.fromDer(b"\x30\x82\x02\x12\x30\x82\x01\x7b\xa0\x03\x02\x01\x02\x02\x01\x01\x30\x0d\x06\x09\x2a\x86\x48\x86\xf7\x0d\x01\x01\x0b\x05\x00\x30\x1b\x31\x19\x30\x17\x06\x03\x55\x04\x03\x0c\x10\x6f\x66\x66\x6c\x69\x6e\x65\x20\x72\x73\x61\x20\x72\x6f\x6f\x74\x30\x1e\x17\x0d\x32\x30\x30\x31\x30\x31\x30\x30\x30\x30\x30\x30\x5a\x17\x0d\x34\x30\x30\x31\x30\x31\x30\x30\x30\x30\x30\x30\x5a\x30\x1b\x31\x19\x30\x17\x06\x03\x55\x04\x03\x0c\x10\x6f\x66\x66\x6c\x69\x6e\x65\x20\x72\x73\x61\x20\x72\x6f\x6f\x74\x30\x81\x9f\x30\x0d\x06\x09\x2a\x86\x48\x86\xf7\x0d\x01\x01\x01\x05\x00\x03\x81\x8d\x00\x30\x81\x89\x02\x81\x81\x00\xa8\x5c\x1f\x27\x9c\xc3\xb3\x27\x43\x76\x5c\x4e\xb7\x63\x72\x45\x80\x8d\xde\xa6\x90\x24\x91\x36\x19\xcb\xc7\x15\xe5\xf5\xd8\x62\x08\x36\x23\x6b\x50\xaf\x06\xeb\xea\xa4\xce\xb7\xf3\xc3\x12\x83\x62\x06\x42\x22\x90\xb1\xaf\x89\x26\xd2\x75\xc3\x4f\xb6\xb0\xc7\xbf\xce\xcc\x7e\xa2\x30\x11\x3a\xbc\x03\x90\xb1\x62\xfc\x80\x88\x31\x3b\x74\x97\x7c\x07\xd2\xfb\x11\xe1\x11\x49\x38\x13\xdb\x89\xc3\x22\x36\xed\x32\x29\x51\x29\xc4\x23\xdf\x60\x31\xe0\x6b\x5f\x02\x90\x7c\x14\x03\x8f\xc9\xc7\xc1\xb5\xcd\x69\xe1\xaa\x46\xd9\x02\x03\x01\x00\x01\xa3\x66\x30\x64\x30\x12\x06\x03\x55\x1d\x13\x01\x01\xff\x04\x08\x30\x06\x01\x01\xff\x02\x01\x02\x30\x1d\x06\x03\x55\x1d\x0e\x04\x16\x04\x14\x47\x02\x4a\x36\xf8\x3a\x39\x21\x1b\x5e\xf6\xcb\x33\x21\x18\x1c\x9b\x80\x69\x1c\x30\x1f\x06\x03\x55\x1d\x23\x04\x18\x30\x16\x80\x14\x47\x02\x4a\x36\xf8\x3a\x39\x21\x1b\x5e\xf6\xcb\x33\x21\x18\x1c\x9b\x80\x69\x1c\x30\x0e\x06\x03\x55\x1d\x0f\x01\x01\xff\x04\x04\x03\x02\x01\x86\x30\x0d\x06\x09\x2a\x86\x48\x86\xf7\x0d\x01\x01\x0b\x05\x00\x03\x81\x81\x00\x58\x5d\xd8\xa6\x57\x21\xab\x7e\xa7\x38\xe6\x8b\x34\x50\xf5\x96\xa1\xb9\x55\x5e\x19\x48\xe8\x4e\x58\x6c\xff\xab\x86\xd1\xd0\x2c\x17\x79\xe5\x63\x4c\x80\x48\x9d\xa4\xa5\x33\xe3\xec\x45\xc4\xbd\xd5\x75\x7f\xa8\xfc\x18\xaa\xfb\x0d\xe4\x91\x2a\x46\x14\xef\x8f\x7b\x71\xef\x43\xbc\xe8\x0b\x42\x16\xc0\x5a\xa8\xf5\x89\x36\xb5\x12\xda\x33\x56\x14\x79\x66\xa2\x60\x9b\xb8\x09\x88\xee\x5b\xca\x48\x5f\x6b\x46\x4a\x93\xa0\x57\x8d\x10\x7e\x1b\x86\x0a\x10\xa1\x5e\x1d\xee\xa4\x6b\x42\x97\xc4\xc3\xf5\xca\x52\xab\xbc\x05\x24"))
    auto verifier = TlsVerifier(trust.snapshot(), TlsVerificationPolicy(), callback)
    auto context = TlsClientContext(verifier).withProtocols([b"xlang"])
    return contextOwner(context)
end
auto engine = NetEngine(NetEngineOptions().withWorkers(1).withBackend(NetBackend.select))
engine.start()
assert(probe(engineOwner(engine), ownedContext()))
engine.close()
assert(engine.wait(5000))
print("mail typed context projection: PASS")
