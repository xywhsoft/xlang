import stb_image_write

func main(...) as int
    Buffer pixels = Buffer()
    string chunk = string.repeat("\0", 1048576)
    int index = 0
    while index < 64
        assert pixels.append(chunk)
        index += 1
    end

    // 复用同一份 64 MiB 源：既覆盖远超限，也覆盖只超出数行的边界。
    for height in [8192, 5462]
        bool limited = false
        try
            stb_image_write.encodeBmp(pixels, 8192, height, 1)
        catch RangeError error
            limited = true
        end
        assert limited, "gray BMP output limit"
        assert stb_image_write.encodeBmp(Buffer.fromHex("ff"), 1, 1, 1).len() == 58
    end
    return 0
end
