import stb_image_write

func main(...) as int
    // IEEE float32字节构造只用于固定x64夹具；生产像素通常来自stb_image.loadf。
    for bits in ["000080bf", "0000c07f", "0000807f", "000080ff", "0100807f"]
        Buffer pixels = Buffer.fromHex(bits + "0000803f0000803f")
        bool rejected = false
        try
            stb_image_write.encodeHdr(pixels, 1, 1, 3)
        catch ValueError error
            rejected = true
        end
        assert rejected
    end
    for bits in ["0000007f", "ffff7f7f"]
        bool rejected = false
        try
            stb_image_write.encodeHdr(Buffer.fromHex(bits), 1, 1, 1)
        catch RangeError error
            rejected = true
        end
        assert rejected
    end
    // alpha不进入RGBE：双通道和RGBA都允许忽略该位置的NaN。
    assert stb_image_write.encodeHdr(Buffer.fromHex("0000803f0000c07f"), 1, 1, 2).len() > 0
    assert stb_image_write.encodeHdr(Buffer.fromHex("0000803f0000803f0000803f0000c07f"), 1, 1, 4).len() > 0
    assert stb_image_write.encodeHdr(Buffer.fromHex("ffffff7e"), 1, 1, 1).len() > 0
    assert stb_image_write.encodeHdr(Buffer.fromHex("00000080"), 1, 1, 1).len() > 0

    string work = dir.temp("", "stbiw-hdr-values-", "")
    try
        string target = path.join(work, "HDR_边界.hdr")
        file.writeText(target, "keep")
        bool rejected = false
        try
            stb_image_write.writeHdr(target, Buffer.fromHex("000080bf0000803f0000803f"), 1, 1, 3)
        catch ValueError error
            rejected = true
        end
        assert rejected and file.readText(target) == "keep"
    finally
        assert dir.delete(work)
    end
    println("stb write HDR values: PASS")
    return 0
end
