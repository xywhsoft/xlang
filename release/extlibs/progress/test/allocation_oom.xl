import progress

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailClear" func failClear()

func main(...) as int
    assert failAfter(uint64(0))
    bool createFailed = false
    try
        progress.create(10)
    catch MemoryError error
        createFailed = true
    finally
        failClear()
    end
    assert createFailed, "allocation failure must not become a value error"

    auto bar = progress.create(10)
    bar.setPrefix("before")
    bar.advance(3)
    assert failAfter(uint64(0))
    bool prefixFailed = false
    try
        bar.setPrefix("after")
    catch MemoryError error
        prefixFailed = true
    finally
        failClear()
    end
    assert prefixFailed, "prefix allocation failure must remain a memory error"
    assert bar.current == 3 and bar.render().contains("before")
    bar.setPrefix("after")
    assert bar.render().contains("after")

    assert failAfter(uint64(0))
    bool renderFailed = false
    try
        bar.render()
    catch MemoryError error
        renderFailed = true
    finally
        failClear()
    end
    assert renderFailed, "render allocation failure must remain a memory error"
    assert bar.current == 3 and bar.render().contains("after")
    return 0
end
