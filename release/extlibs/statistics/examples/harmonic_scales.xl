import statistics

func main(...) as int
    // 大倒数正负抵消后，仍要保留 1/1 + 1/2；无需创建中间倒数数组。
    var values = [1e-300, -1e-300, 1.0, 2.0]
    assert math.abs(statistics.harmmean(values) - 8.0 / 3.0) < 1e-12
    println("signed mean: 8/3")
    assert math.abs(statistics.harmmean([1e-300, -1e-300, 1e-100, -1e-100, 1.0, 2.0]) - 4.0) < 1e-12
    println("several scales: 4")
    assert math.abs(statistics.harmmean([1e-300, -1e-300, -1.0, -2.0]) + 8.0 / 3.0) < 1e-12
    println("negative tail: -8/3")
    assert math.abs(statistics.harmmean([1.0, 2.0, 4.0]) - 12.0 / 7.0) < 1e-12
    println("same-sign mean: 12/7")
    assert values[0] == 1e-300 and values[1] == -1e-300
    int rejected = 0
    try
        statistics.harmmean([1.0, -1.0])
    catch ValueError error
        rejected += 1
    end
    assert rejected == 1
    println("undefined: rejected")
    return 0
end
