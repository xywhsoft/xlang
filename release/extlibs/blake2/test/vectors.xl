import blake2

func main(...) as int
    // 独立 hashlib 向量：默认长度的空输入，以及可变长度的 keyed 输入。
    assert blake2.blake2bHashHex("") == "786a02f742015903c6c6fd852552d272912f4740e15847618a86e217f71f5419d25e1031afee585313896444934eb04b903a685b1448b755d56f701afe9be2ce"
    assert blake2.blake2sHashHex("") == "69217a3079908094e11121d042354a7c1f55b6482ca1a51e1b250dfd1ed0eef9"

    Buffer data = Buffer()
    data.appendByte(7)
    Buffer key = Buffer()
    key.appendByte(0)
    assert blake2.blake2bKeyedHex(data, key, 16) == "9354c4d7fa24188befd032575fa808d7"
    assert blake2.blake2sKeyedHex(data, key, 16) == "fecc44928321705ddf5aa29e667c0e36"
    blake2.Blake2bKeyedHasher directB = blake2.Blake2bKeyedHasher(c_size(16), key.toBytes(), c_ulonglong(1024))
    blake2.Blake2sKeyedHasher directS = blake2.Blake2sKeyedHasher(c_size(16), key.toBytes(), c_ulonglong(1024))
    directB.update(data)
    directS.update(data)
    assert directB.digestHex() == "9354c4d7fa24188befd032575fa808d7"
    assert directS.digestHex() == "fecc44928321705ddf5aa29e667c0e36"
    return 0
end
