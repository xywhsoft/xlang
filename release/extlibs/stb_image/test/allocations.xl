import stb_image

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

func main(...) as int
    string path = "release/examples/extlibs/assets/tiny.png"
    Buffer source = Buffer(file.readBytes(path))

    // 文件/内存与整数/浮点像素分别扫描；成功调用允许内部故障已被恢复。
    for mode in range(4)
        int failures = 0
        int successes = 0
        for allocation in range(128)
            bool caught = false
            assert failAfter(uint64(allocation))
            try
                if mode == 0 then
                    stb_image.StbImage image = stb_image.load(path, 4)
                    assert image.width() == 16 and image.byteSize() == 1024
                elseif mode == 1 then
                    stb_image.StbImage image = stb_image.loadBytes(source, 4)
                    assert image.height() == 16 and image.byteSize() == 1024
                elseif mode == 2 then
                    stb_image.StbImage image = stb_image.loadf(path, 4)
                    assert image.isFloat() and image.byteSize() == 4096
                else
                    stb_image.StbImage image = stb_image.loadfBytes(source, 4)
                    assert image.isFloat() and image.byteSize() == 4096
                end
            catch MemoryError error
                caught = true
            end
            bool triggered = failTriggered()
            failClear()
            assert not caught or triggered, "allocation failure must be MemoryError"
            if caught then failures += 1 else successes += 1 end
            assert stb_image.loadBytes(source, 4).byteSize() == 1024
        end
        assert failures > 0 and successes > 0
    end
    println("stb_image allocations: PASS")
    return 0
end
