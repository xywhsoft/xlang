import fix

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

var fields = [fix.field(35, "D")]
string frame = fix.build("FIX.4.4", fields)

func probe(int which, string frame, var fields) as bool
    if which == 0 then
        fix.field(58, "value")
    elseif which == 1 then
        fix.build("FIX.4.4", fields)
    elseif which == 2 then
        fix.parse(frame)
    else
        fix.validate(frame)
    end
    return true
end

for which in range(4)
    int failures = 0
    int successes = 0
    for allocation in range(64)
        bool caught = false
        assert failAfter(uint64(allocation))
        try
            assert probe(which, frame, fields)
        catch MemoryError error
            caught = true
        end
        bool triggered = failTriggered()
        failClear()
        assert caught == triggered, "FIX allocation error must be classified as MemoryError"
        if caught then failures += 1 else successes += 1 end
        assert fix.validate(frame), "FIX call must recover after allocation failure"
    end
    assert failures > 0 and successes > 0
end
