import pinyin

func main(...) as int
    assert pinyin.convert("hello中国123") == "hello zhong guo 123"
    assert pinyin.initials("hello中国123") == "hellozg123"
    assert pinyin.convert("龘中") == "龘 zhong"
    assert pinyin.initials("龘中") == "龘z"
    assert pinyin.convert("😀") == "😀"
    assert pinyin.convert("") == ""
    assert pinyin.initials("") == ""
    // 固定词表只改正错误读音；合法的既有多音字选择保持不变。
    assert pinyin.convert("伉佛女地") == "kang fo nv di"
    assert pinyin.initials("伉佛女地") == "kfnd"

    string longText = ""
    for i in range(5000)
        longText += "中"
    end
    assert string.byteLen(pinyin.initials(longText)) == 5000

    bool rejected = false
    try
        pinyin.convert("a\x00b")
    catch ValueError e
        rejected = true
    end
    assert rejected
    return 0
end
