import ical

func main(...) as int
    int rejected = 0
    try
        ical.parse("BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:bad\u001B\nEND:VCALENDAR\n")
    catch e
        rejected += 1
    end
    try
        ical.build({"events": [{"uid": "one@demo", "dtstamp": "20260801T000000Z",
            "dtstart": "20260810T090000Z", "summary": "bad\u001B"}]})
    catch e
        rejected += 1
    end
    assert rejected == 2
    println("ical control characters: PASS")
    return 0
end
