import lru

func main(...) as int
    auto cache = lru.create(2)
    cache.put("a", "value")
    assert cache.get("a", "fallback") == "value"
    assert cache.contains("a") and cache.remove("a")
    assert cache.capacity == 2 and cache.count == 0
    assert cache.hits == 1 and cache.misses == 0
    cache.clear()
    assert cache.hits == 0 and cache.misses == 0
    auto lfu = lru.createLFU(1)
    lfu.put("", "")
    assert lfu.get("", "fallback") == ""
    return 0
end
