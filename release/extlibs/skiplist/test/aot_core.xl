import skiplist

func main(...) as int
    skiplist.SkipList table = skiplist.create()
    table.set("a", "first")
    table.set("b", "second")
    assert table.count == 2
    assert table.contains("a")
    assert table.remove("a")
    assert not table.contains("a")
    assert table.count == 1
    return 0
end
