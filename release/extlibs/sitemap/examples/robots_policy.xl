import sitemap

func main(...) as int
    // CR 也是合法行尾；注释不结束组，专属组优先于通配组。
    string text = ("User-agent: DemoBot\r# group policy\rDisallow: /draft\r" +
        "Allow: /draft/public\rSitemap: https://example.test/site.xml\r" +
        "User-agent: *\rDisallow: /private")
    var robots = sitemap.robotsParse(text)
    bool draft = sitemap.robotsAllows(robots, "DemoBot", "/draft/new")
    bool published = sitemap.robotsAllows(robots, "DemoBot", "/draft/public/intro")
    bool fallback = sitemap.robotsAllows(robots, "Other", "/private/data")
    bool specific = sitemap.robotsAllows(robots, "DemoBot", "/private/data")
    assert not draft and published and not fallback and specific
    assert robots["sitemaps"][0] == "https://example.test/site.xml"
    println("draft:", draft)
    println("published:", published)
    println("fallback:", fallback)
    println("specific:", specific)
    return 0
end
