import srt

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

string source = "1\n00:00:01,000 --> 00:00:02,000\nHello\n"
string web = "WEBVTT\n\nfirst\n00:01.000 --> 00:02.000\nHello\n"
var cues = srt.parse(source)
var webCues = srt.parseVtt(web)
int failures = 0
int successes = 0

for operation in range(4)
    for allocation in range(32)
        bool memoryCaught = false
        bool wrongCaught = false
        assert failAfter(uint64(allocation))
        try
            if operation == 0 then
                srt.parse(source)
            elseif operation == 1 then
                srt.parseVtt(web)
            elseif operation == 2 then
                srt.build(cues)
            else
                srt.buildVtt(webCues)
            end
        catch MemoryError error
            memoryCaught = true
        catch RuntimeError error
            wrongCaught = true
        catch ValueError error
            wrongCaught = true
        end
        bool triggered = failTriggered()
        failClear()
        if wrongCaught or memoryCaught != triggered then
            println("operation=", operation, " allocation=", allocation,
                " triggered=", triggered, " memory=", memoryCaught,
                " wrong=", wrongCaught)
        end
        assert not wrongCaught and memoryCaught == triggered, "allocation error kind"
        if triggered then failures += 1 else successes += 1 end
    end
end

assert failures > 0 and successes > 0
assert srt.build(srt.parse(source)) == source + "\n", "SRT recovery"
assert srt.parseVtt(srt.buildVtt(srt.parseVtt(web)))[0]["id"] == "first", "VTT recovery"
println("srt allocation: PASS")
