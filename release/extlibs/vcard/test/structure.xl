import vcard

func main(...) as int
    string nested = "BEGIN:VCARD\nVERSION:3.0\nFN:A\nBEGIN:VCARD\nEND:VCARD\n"
    string stray = "BEGIN:VCARD\nVERSION:3.0\nFN:A\nEND:VFOO\nEND:VCARD\n"
    string lateVersion = "BEGIN:VCARD\nFN:A\nVERSION:4.0\nEND:VCARD\n"
    string blankBeforeVersion = "BEGIN:VCARD\n\nVERSION:4.0\nFN:A\nEND:VCARD\n"
    string versionParamThree = "BEGIN:VCARD\nVERSION;X=1:3.0\nFN:A\nEND:VCARD\n"
    string groupedVersionFour = "BEGIN:VCARD\nitem1.VERSION:4.0\nFN:A\nEND:VCARD\n"
    string groupedVersionThree = "BEGIN:VCARD\nitem1.VERSION:3.0\nFN:A\nEND:VCARD\n"
    string groupedBegin = "BEGIN:VCARD\nVERSION:4.0\nFN:A\nitem1.BEGIN:VFOO\nEND:VCARD\n"
    string groupedEnd = "BEGIN:VCARD\nVERSION:4.0\nFN:A\nitem1.END:VFOO\nEND:VCARD\n"
    string emptyGroup = "BEGIN:VCARD\nVERSION:4.0\nFN:A\nitem1..EMAIL:a@example.com\nEND:VCARD\n"
    string spacedGroup = "BEGIN:VCARD\nVERSION:4.0\nFN:A\nitem one.EMAIL:a@example.com\nEND:VCARD\n"
    string badUnknown = "BEGIN:VCARD\nVERSION:4.0\nFN:A\nX_BAD:opaque\nEND:VCARD\n"
    string badParamName = "BEGIN:VCARD\nVERSION:4.0\nFN;X_BAD=1:A\nEND:VCARD\n"
    string missingParamEqual = "BEGIN:VCARD\nVERSION:4.0\nFN;TYPE:A\nEND:VCARD\n"
    string badParamTail = "BEGIN:VCARD\nVERSION:4.0\nFN;TYPE=\"home\"tail:A\nEND:VCARD\n"
    int rejected = 0
    try
        vcard.parse(nested)
    catch e
        rejected += 1
    end
    try
        vcard.parse(stray)
    catch e
        rejected += 1
    end
    try
        vcard.parse(lateVersion)
    catch e
        rejected += 1
    end
    try
        vcard.parse(blankBeforeVersion)
    catch e
        rejected += 1
    end
    try
        vcard.parse(versionParamThree)
    catch e
        rejected += 1
    end
    try
        vcard.parse(groupedVersionFour)
    catch e
        rejected += 1
    end
    try
        vcard.parse(groupedVersionThree)
    catch e
        rejected += 1
    end
    try
        vcard.parse(groupedBegin)
    catch e
        rejected += 1
    end
    try
        vcard.parse(groupedEnd)
    catch e
        rejected += 1
    end
    try
        vcard.parse(emptyGroup)
    catch e
        rejected += 1
    end
    try
        vcard.parse(spacedGroup)
    catch e
        rejected += 1
    end
    try
        vcard.parse(badUnknown)
    catch e
        rejected += 1
    end
    try
        vcard.parse(badParamName)
    catch e
        rejected += 1
    end
    try
        vcard.parse(missingParamEqual)
    catch e
        rejected += 1
    end
    try
        vcard.parse(badParamTail)
    catch e
        rejected += 1
    end
    assert rejected == 15, "invalid vCard structure, names and parameters must be rejected"
    var oldCard = vcard.parse("BEGIN:VCARD\nFN:A\nVERSION:3.0\nEND:VCARD\n")
    assert oldCard["version"] == "3.0", "vCard 3.0 may place VERSION after FN"
    var newCard = vcard.parse("BEGIN:VCARD\nVERSION;VALUE=text:4.0\nFN:A\nEND:VCARD\n")
    assert newCard["version"] == "4.0", "vCard 4.0 permits VERSION parameters"
    var groupedCard = vcard.parse("BEGIN:VCARD\nVERSION:4.0\nFN:A\nitem1.EMAIL:a@example.com\nEND:VCARD\n")
    assert groupedCard["email"] == "a@example.com", "grouped values remain readable"
    var extension = vcard.parse("BEGIN:VCARD\nVERSION:4.0\nFN:A\nX-OTHER:opaque\nEND:VCARD\n")
    assert extension["fn"] == "A", "valid unknown fields remain ignorable"
    var parameterized = vcard.parse("BEGIN:VCARD\nVERSION:4.0\nFN;TYPE=\"home,work;primary:ok\";X-ALT=a,b:A\nEND:VCARD\n")
    assert parameterized["fn"] == "A", "valid extension parameters remain readable"
    println("vcard structure: PASS")
    return 0
end
