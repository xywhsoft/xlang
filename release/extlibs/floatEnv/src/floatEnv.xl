// This module changes only the calling OS thread's floating-point environment.
// A snapshot may be restored only on that same thread; do not carry it across await.
export enum RoundingMode as int32
    nearest = 0
    downward = 1
    upward = 2
    towardZero = 3
end

export enum ExceptionFlag as int32
    invalid = 1
    divideByZero = 2
    overflow = 4
    underflow = 8
    inexact = 16
end

extern "xfenv_get_round" func __getRoundNative() as c_int
extern "xfenv_set_round" func __setRoundNative(c_int mode) as c_int
extern "xfenv_get_flags" func __getFlagsNative() as c_int
extern "xfenv_clear_flags" func __clearFlagsNative(c_int flags) as c_int
extern "xfenv_raise_flags" func __raiseFlagsNative(c_int flags) as c_int
extern "xfenv_snapshot_hold" func __holdSnapshot(point handle) as c_int

extern "xfenv_capture" func __captureSnapshot() as point
extern "xfenv_snapshot_destroy" @no_raise func __destroySnapshot(point raw)
extern "xfenv_snapshot_restore" func __restoreSnapshot(point raw) as c_int
extern "xl6ForeignResourceCreateV1" func __ownSnapshot(point raw, var releaser) as var
extern "xl6ForeignResourcePointerV1" func __snapshotPointer(var owner) as point

func __releaseSnapshot(point raw)
    __destroySnapshot(raw)
end

export class Snapshot
    // fenv_t plus creating thread ID has no owning language or native edges.
    // The existing audited leaf-resource protocol retains its real code owner.
    private var owner
    create()
        point raw = __captureSnapshot()
        if raw == null then throw MemoryError "floating-point environment capture failed" end
        bool adopted = false
        try
            self.owner = __ownSnapshot(raw, xcall(__releaseSnapshot))
            adopted = true
        finally
            if !adopted then __destroySnapshot(raw) end
        end
    end
    private func restoreNative() as c_int
        return __restoreSnapshot(__snapshotPointer(self.owner))
    end
    private func holdNative() as c_int
        return __holdSnapshot(__snapshotPointer(self.owner))
    end
    func restore()
        c_int status = self.restoreNative()
        if status == -1 then
            throw RuntimeError "floating-point environment snapshot belongs to another thread"
        end
        if status != 1 then
            throw RuntimeError "floating-point environment restore failed"
        end
    end
    static func hold() as Snapshot
        Snapshot saved = Snapshot()
        // All language/native allocations precede the thread-state change.
        if saved.holdNative() != 1 then
            throw RuntimeError "floating-point environment hold failed"
        end
        return saved
    end
end

export func getRounding() as RoundingMode
    c_int mode = __getRoundNative()
    if mode == 0 then return RoundingMode.nearest end
    if mode == 1 then return RoundingMode.downward end
    if mode == 2 then return RoundingMode.upward end
    if mode == 3 then return RoundingMode.towardZero end
    throw RuntimeError "floating-point rounding mode is unsupported"
end

export func setRounding(RoundingMode mode)
    if __setRoundNative(c_int(int(mode))) == 0 then
        throw RuntimeError "floating-point rounding mode change failed"
    end
end

export func getFlags() as int
    c_int flags = __getFlagsNative()
    if flags < 0 then
        throw RuntimeError "floating-point exception flag query failed"
    end
    return int(flags)
end

export func clearFlags(int flags = 31)
    if flags < 0 or flags > 31 then
        throw RangeError "floating-point exception mask is invalid"
    end
    if __clearFlagsNative(c_int(flags)) == 0 then
        throw RuntimeError "floating-point exception flag clear failed"
    end
end

export func raiseFlags(int flags)
    if flags < 0 or flags > 31 then
        throw RangeError "floating-point exception mask is invalid"
    end
    if __raiseFlagsNative(c_int(flags)) == 0 then
        throw RuntimeError "floating-point exception flag raise failed"
    end
end

export func capture() as Snapshot
    return Snapshot()
end

// Save and clear the calling thread only after the owner is fully constructed.
export func hold() as Snapshot
    return Snapshot.hold()
end
