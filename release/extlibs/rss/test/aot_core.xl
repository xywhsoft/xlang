import rss

func main(...) as int
    assert rss.detect("<rss version='2.0'><channel/></rss>") == "rss"
    assert rss.detect("<rss><channel/></rss>") == ""
    assert rss.detect("<rss version='0.91'><channel/></rss>") == ""
    assert rss.detect("<feed xmlns='http://www.w3.org/2005/Atom'/>") == "atom"
    assert rss.detect("<html/>") == ""
    assert rss.detect("<rss><channel>") == ""
    string xml = rss.buildRSS({"title": "News", "link": "https://example.test", "description": "Updates"}, [])
    assert rss.detect(xml) == "rss"
    assert rss.parseRSS(xml) != null
    return 0
end
