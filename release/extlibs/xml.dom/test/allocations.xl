import xml.dom

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

func main(...) as int
    string source = "<root xmlns:p=\"urn:test\" id=\"7\">head<p:item name=\"one\">text</p:item><!--note--></root>"
    int failures = 0
    int successes = 0
    for allocation in range(512)
        bool memoryCaught = false
        bool wrongCaught = false
        bool parsed = false
        assert failAfter(uint64(allocation))
        try
            auto document = xml.dom.parse(source)
            parsed = document.documentElement.name == "root"
        catch MemoryError error
            memoryCaught = true
        catch XmlError error
            wrongCaught = true
        catch ValueError error
            wrongCaught = true
        end
        bool triggered = failTriggered()
        failClear()
        if wrongCaught or (memoryCaught and not triggered) or (not memoryCaught and not parsed) then
            println("xml.dom allocation mismatch at ", allocation,
                ": triggered=", triggered, ", memory=", memoryCaught,
                ", other=", wrongCaught, ", parsed=", parsed)
        end
        assert not wrongCaught and (memoryCaught or parsed)
        if triggered then failures += 1 else successes += 1 end
        if successes > 0 then break end
    end
    assert failures > 0 and successes > 0
    assert xml.dom.parse(source).documentElement.name == "root"

    auto document = xml.dom.parse(source)
    string directory = dir.temp("", "xlang-xml-dom-allocation-", "")
    string outputPath = path.join(directory, "output.xml")
    int saveFailures = 0
    int saveSuccesses = 0
    try
        for allocation in range(64)
            bool memoryCaught = false
            bool wrongCaught = false
            assert failAfter(uint64(allocation))
            try
                document.save(outputPath)
            catch MemoryError error
                memoryCaught = true
            catch XmlError error
                wrongCaught = true
            catch ValueError error
                wrongCaught = true
            catch IOError error
                wrongCaught = true
            end
            bool triggered = failTriggered()
            failClear()
            if wrongCaught or memoryCaught != triggered then
                println("xml.dom save allocation mismatch at ", allocation,
                    ": triggered=", triggered, ", memory=", memoryCaught,
                    ", other=", wrongCaught)
            end
            assert not wrongCaught and memoryCaught == triggered
            if triggered then saveFailures += 1 else saveSuccesses += 1 end
            if saveSuccesses > 0 then break end
        end
        assert saveFailures > 0 and saveSuccesses > 0
        document.save(outputPath)
        assert xml.dom.load(outputPath).documentElement.name == "root"
    finally
        failClear()
        assert dir.delete(directory)
    end
    println("xml.dom allocation: PASS")
    return 0
end
