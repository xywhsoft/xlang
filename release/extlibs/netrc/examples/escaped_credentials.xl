import netrc

func main(...) as int
    // 演示值均为测试数据：只输出验证结果，不记录或落盘完整凭据。
    string source = r"""machine "api host"
 login "build bot"
 account "team\"A"
 password "folder\\test # 你好"
macdef "deploy job"
 echo ok

"""
    auto config = netrc.parse(source)
    string wire = config.stringify()
    auto restored = netrc.parse(wire)
    assert restored.authenticators("api host")["login"] == "build bot"
    assert restored.authenticators("api host")["account"] == "team\"A"
    assert restored.authenticators("api host")["password"] == r"folder\test # 你好"
    assert restored.macros["deploy job"][0] == " echo ok"
    println("quoted host: true")
    println("quoted account: true")
    println("password roundtrip: true")
    println("quoted macro: true")

    // 限额按实际编码字节计数：包含引号、转义反斜杠和换行。
    bool rejected = false
    try
        config.stringify(maxOutput = string.byteLen(wire) - 1)
    catch ConfigError error
        rejected = netrc.errorCode() == 4
    end
    assert rejected and config.stringify() == wire
    println("output limit: true")
    return 0
end
