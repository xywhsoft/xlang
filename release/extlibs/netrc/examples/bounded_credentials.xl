import netrc

func main(...) as int
    // 只使用固定测试凭据；密码只核对，不输出，也不落盘。
    string source = ("machine api.example login build password sample\n" +
        "default login guest\nmacdef ping\n echo alive\n\n")
    netrc.Netrc config = netrc.parse(source, maxInput = 512, maxItem = 16,
        maxEntries = 4, maxNodes = 7)
    println("hosts:", config.hostNames().length)
    println("macros:", config.macroNames().length)
    println("selected login:", config.authenticators("api.example")["login"])
    println("fallback login:", config.authenticators("unknown.example")["login"])

    string wire = config.stringify(maxOutput = 512, maxItem = 16,
        maxEntries = 4, maxNodes = 7)
    netrc.Netrc restored = netrc.parse(wire, maxInput = 512, maxItem = 16,
        maxEntries = 4, maxNodes = 7)
    assert restored.authenticators("api.example")["password"] == "sample"
    assert restored.macros["ping"][0] == " echo alive"
    println("bounded roundtrip: true")

    // 超预算只报告 LIMIT，不把正常拒绝误当内存不足。
    bool rejected = false
    try
        netrc.parse("macdef m\n12345678\n\n", maxItem = 7)
    catch ConfigError error
        rejected = netrc.errorCode() == 4
    end
    assert rejected
    println("macro limit: true")
    assert config.stringify(maxNodes = 7) == wire
    println("source unchanged: true")
    return 0
end
