import xml.etree

func main(...) as int
    string input = "<root id='one'><item>你好</item><item>world</item>" + "</root>"
    auto root = xml.etree.parse(input)
    input = ""
    assert root.name == "root"
    assert root.get("id") == "one"
    assert root.get("missing", "fallback") == "fallback"
    assert root.childCount == 2

    auto first = root.child(0)
    assert first.name == "item"
    assert first.text == "你好"
    assert root.find("item").text == "你好"
    auto items = root.findAll("item")
    assert items.length == 2
    first.set("escaped", "&<>\"")
    var attributes = first.attributes()
    assert attributes["escaped"] == "&<>\""
    string encoded = root.stringify()
    assert string.contains(encoded, "escaped=\"&amp;&lt;&gt;&quot;\"")

    auto mixed = xml.etree.parse("<root>head<child>one</child>tail</root>")
    string mixedPretty = mixed.stringify(true)
    assert string.contains(mixedPretty, "<root>head<child>one</child>tail</root>")

    bool rejected = false
    try
        xml.etree.create("1root")
    catch XmlError error
        rejected = true
    end
    assert rejected, "XML names cannot begin with a digit"
    rejected = false
    try
        root.stringify(maxOutput=1)
    catch ValueError error
        rejected = true
    end
    assert rejected, "output limit must be enforced before subtraction"

    rejected = false
    try
        xml.etree.parse("<root>")
    catch ValueError error
        rejected = true
    end
    assert rejected
    assert xml.etree.errorLine() > 0

    rejected = false
    try
        xml.etree.parse("<!DOCTYPE root [<!ENTITY value 'secret'>]><root>&value;</root>")
    catch ValueError error
        rejected = true
    end
    assert rejected

    rejected = false
    try
        xml.etree.parse("<!DOCTYPE root SYSTEM 'file:///xlang-extlib-no-such-entity'><root/>")
    catch ValueError error
        rejected = true
    end
    assert rejected, "external DTD rejected"

    rejected = false
    try
        xml.etree.parse("<!DOCTYPE root [<!ENTITY x SYSTEM 'file:///xlang-extlib-no-such-entity'>]><root>&x;</root>")
    catch ValueError error
        rejected = true
    end
    assert rejected, "external entity rejected"

    rejected = false
    try
        xml.etree.parse("<a><b><c/></b></a>", maxDepth=2)
    catch ValueError error
        rejected = true
    end
    assert rejected
    rejected = false
    try
        xml.etree.parse("<root/>", maxInput=-1)
    catch ValueError error
        rejected = true
    end
    assert rejected, "negative input limit must not become unlimited"

    rejected = false
    try
        xml.etree.parse("<root/>", maxInput=4)
    catch ValueError error
        rejected = true
    end
    assert rejected, "known-size input limit must reject before native parsing"

    rejected = false
    try
        xml.etree.parse("<root/>\0<hidden/>")
    catch ValueError error
        rejected = true
    end
    assert rejected, "XML ElementTree input must not stop at an embedded NUL"

    rejected = false
    try
        xml.etree.parse("<root/>", maxDepth=4294967424)
    catch ValueError error
        rejected = true
    end
    assert rejected, "depth must not wrap to 128"

    rejected = false
    try
        root.stringify(true, 4294967298)
    catch ValueError error
        rejected = true
    end
    assert rejected, "indent must not wrap to 2"

    rejected = false
    try
        xml.etree.create("item\0ignored")
    catch ValueError error
        rejected = true
    end
    assert rejected, "element name must not be truncated"
    rejected = false
    try
        root.get("id\0ignored")
    catch ValueError error
        rejected = true
    end
    assert rejected, "attribute lookup must not use a prefix name"
    rejected = false
    try
        root.find("item\0ignored")
    catch ValueError error
        rejected = true
    end
    assert rejected, "path lookup must not use a prefix"
    rejected = false
    try
        root.set("id", "changed\0ignored")
    catch ValueError error
        rejected = true
    end
    assert rejected, "attribute value must not be truncated"
    assert root.get("id") == "one"

    string workDir = dir.temp(path.temp(), "xlang_xml_etree_", "")
    try
        string fixture = path.join(workDir, "ffi.xml")
        assert file.writeText(fixture, "<root/>")
        rejected = false
        try
            xml.etree.load(fixture + "\0ignored")
        catch ValueError error
            rejected = true
        end
        assert rejected, "load must not use a truncated path"
        rejected = false
        try
            root.save(fixture + "\0ignored")
        catch ValueError error
            rejected = true
        end
        assert rejected, "save must not overwrite a truncated path"
        assert file.readText(fixture) == "<root/>"

        first.text = "bad \uFFFF"
        rejected = false
        try
            root.stringify()
        catch ValueError error
            rejected = true
        end
        assert rejected, "UTF-8 scalar U+FFFF is not an XML 1.0 character"
        rejected = false
        try
            root.save(fixture)
        catch ValueError error
            rejected = true
        end
        assert rejected
        assert file.readText(fixture) == "<root/>"
    finally
        dir.delete(workDir)
    end
    println("xml.etree boundaries: ok")
    return 0
end
