import snappy

class SnappyProgress
    int calls = 0
end

func main(...) as int
    string workDir = path.join(path.temp(), "xlang_snappy_file_" + crypto.randomString(20))
    dir.createAll(workDir)
    string source = path.join(workDir, "source.txt")
    string packed = path.join(workDir, "source.sz")
    string restored = path.join(workDir, "restored.txt")
    string cancelledPath = path.join(workDir, "cancelled.sz")
    string content = "你好 snappy\n" + string.repeat("framed-file-boundary\n", 4096)
    try
        assert file.writeText(source, content)
        SnappyProgress progress = SnappyProgress()
        snappy.compressFile(source, packed, onProgress = func(int inputBytes,
            int totalBytes, int outputBytes) as bool
            progress.calls += 1
            return inputBytes <= totalBytes and outputBytes >= 0
        end)
        assert progress.calls > 0
        snappy.decompressFile(packed, restored)
        assert file.readText(restored) == content

        bool rejected = false
        try
            snappy.compressFile(source, packed, overwrite = false)
        catch ValueError e
            rejected = true
        end
        assert rejected and file.readText(restored) == content

        bool cancelled = false
        try
            snappy.compressFile(source, cancelledPath, onProgress = func(int inputBytes,
                int totalBytes, int outputBytes) as bool
                return false
            end)
        catch CancelledError e
            cancelled = true
        end
        assert cancelled and not file.exists(cancelledPath)

        bool limited = false
        try
            snappy.decompressFile(packed, restored, maxOutput = 8)
        catch RangeError e
            limited = true
        end
        assert limited and file.readText(restored) == content
    finally
        if file.exists(source) then assert file.delete(source) end
        if file.exists(packed) then assert file.delete(packed) end
        if file.exists(restored) then assert file.delete(restored) end
        if file.exists(cancelledPath) then assert file.delete(cancelledPath) end
        assert dir.delete(workDir), "temporary snappy directory must be removed"
    end
    println("snappy file operations: PASS")
    return 0
end
