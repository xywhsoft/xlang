import watch

func main(...) as int
    string watched = "extlibs/watch/src/watch.xl"
    auto watcher = watch.create()
    int index = watcher.add(watched)
    assert watcher.poll() == "", "no change before first poll"
    assert watcher.count == 1 and watch.exists(watched)
    println("count:", watcher.count)
    println("exists:", watch.exists(watched))
    assert watcher.path(index) == watched
    println("path matches:", true)
    assert watcher.remove(index)
    assert watcher.count == 0
    println("after remove:", watcher.count)
    int reused = watcher.add(watched)
    assert reused == index and watcher.count == 1
    println("slot reused:", true)

    string root = dir.temp("", "xlang-watch-example-", "")
    try
        string target = path.join(root, "event.txt")
        auto events = watch.create()
        assert events.add(target) == 0 and events.poll() == ""
        assert file.writeText(target, "a")
        assert events.poll() == "CREATED:" + target
        println("created:", true)
        assert file.writeText(target, "longer")
        assert events.poll() == "MODIFIED:" + target
        println("modified:", true)
        assert file.delete(target)
        assert events.poll() == "DELETED:" + target
        println("deleted:", true)
    finally
        assert dir.delete(root), "watch example temporary directory must be removed"
    end
    return 0
end
