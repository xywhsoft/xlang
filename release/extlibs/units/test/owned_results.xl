import units

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

func main(...) as int
    array<string> expected = ["1.50 KiB", "1.54 kB", "25m 36s", "25:36", "1.5K"]
    float input = 1536.0
    for operation in range(5)
        for budget in range(2)
            string result = ""
            bool memoryCaught = false
            bool triggered = false
            // 与 C 回归相同：原生格式化只分配最终文本，不应再复制返回值。
            assert failAfter(uint64(budget))
            try
                if operation == 0 then
                    result = units.bytes(input)
                elseif operation == 1 then
                    result = units.bytesDecimal(input)
                elseif operation == 2 then
                    result = units.duration(input)
                elseif operation == 3 then
                    result = units.durationShort(input)
                else
                    result = units.count(input)
                end
            catch MemoryError error
                memoryCaught = true
            finally
                triggered = failTriggered()
                failClear()
            end
            if budget == 0 then
                assert triggered and memoryCaught
            else
                assert not triggered and not memoryCaught, "units copied text after the native result was adopted"
                assert result == expected[operation]
            end
        end
    end
    println("units owned result budgets: PASS")
    return 0
end
