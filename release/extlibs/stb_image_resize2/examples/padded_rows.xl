import stb_image_resize2

func main(...) as int
    // 两行灰度图：每行 ff 00，第一行后有一个 a5 padding，末行无 padding。
    Buffer pixels = Buffer.fromHex("ff00a5ff00")
    Buffer srgb = stb_image_resize2.resize(pixels, 2, 2, 1, 1, 1, 3)
    Buffer linear = stb_image_resize2.resizeLinear(pixels, 2, 2, 1, 1, 1, 3)
    assert srgb == Buffer.fromHex("bc") and linear == Buffer.fromHex("80")
    bool rejected = false
    try
        stb_image_resize2.resize(Buffer.fromHex("ff00a5ff"), 2, 2, 1, 1, 1, 3)
    catch ValueError error
        rejected = true
    end
    assert rejected and pixels == Buffer.fromHex("ff00a5ff00")
    assert stb_image_resize2.resize(pixels, 2, 2, 1, 1, 1, 3) == srgb
    println("source bytes: 5")
    println("sRGB midpoint: 188")
    println("linear midpoint: 128")
    println("short stride rejected")
    println("source unchanged: true")
    println("stb resize padded rows: OK")
    return 0
end
