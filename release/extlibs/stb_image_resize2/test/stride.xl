import stb_image_resize2

func main(...) as int
    array<int> widths = [1, 2, 3, 7, 17]
    array<int> heights = [1, 3, 2, 5, 9]
    for shape in range(5)
        for channels in range(1, 5)
            int width = widths[shape]
            int height = heights[shape]
            Buffer packed = Buffer()
            Buffer padded = Buffer()
            for y in range(height)
                for x in range(width * channels)
                    int value = (x * 31 + y * 19) % 256
                    packed.appendByte(value)
                    padded.appendByte(value)
                end
                // 最后一行不添加 padding，长度恰好满足借用像素区域。
                if y + 1 < height then
                    for pad in range(7)
                        padded.appendByte(165)
                    end
                end
            end
            bytes beforePacked = packed.toBytes()
            bytes beforePadded = padded.toBytes()
            Buffer srgb = stb_image_resize2.resize(packed, width, height, channels, width + 2, height + 1)
            Buffer paddedSrgb = stb_image_resize2.resize(padded, width, height, channels,
                width + 2, height + 1, width * channels + 7)
            Buffer linear = stb_image_resize2.resizeLinear(packed, width, height, channels, width + 2, height + 1)
            Buffer paddedLinear = stb_image_resize2.resizeLinear(padded, width, height, channels,
                width + 2, height + 1, width * channels + 7)
            assert srgb == paddedSrgb and linear == paddedLinear
            assert packed.toBytes() == beforePacked and padded.toBytes() == beforePadded
        end
    end
    Buffer source = Buffer.fromHex("ff00a5ff00")
    bool rejected = false
    try
        stb_image_resize2.resize(Buffer.fromHex("ff00a5ff"), 2, 2, 1, 1, 1, 3)
    catch ValueError error
        rejected = true
    end
    assert rejected
    assert stb_image_resize2.resize(source, 2, 2, 1, 1, 1, 3) == Buffer.fromHex("bc")
    assert stb_image_resize2.resizeLinear(source, 2, 2, 1, 1, 1, 3) == Buffer.fromHex("80")
    println("stb resize language stride: 40 layouts PASS")
    return 0
end
