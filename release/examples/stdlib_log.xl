string baseDir = path.join(path.temp(), "xl6_stdlib_log_example")
dir.createAll(baseDir)
auto logger = log.create("example", LogLevel.trace)
assert log.levelName(LogLevel.warn) == "WARN"
logger.setLevel(LogLevel.off)
assert logger.getLevel() == LogLevel.off
assert logger.fatal("filtered; fatal does not terminate") == LogResult.skipped
logger.setLevel(LogLevel.trace)
println("level=ok")

auto options = LogFileOptions()
options.mode = LogFileMode.truncate
auto textOptions = LogTextOptions()
textOptions.style = LogTextStyle.message
textOptions.flags = log.textNewline
string logPath = path.join(baseDir, "stdlib_log.log")
auto fileSink = log.textFileSink(logPath, options, textOptions)
logger.addSink(fileSink)
logger.info("hello-log")
logger.warn("warn-log")
logger.flush()
assert file.readBytes(logPath) == b"hello-log\nwarn-log\n"
assert fileSink.closeFile()
logger.clearSinks()
println("file=ok")

string rollingPath = path.join(baseDir, "rolling.log")
options.maxBytes = uint64(96)
options.backupCount = 2
auto rollingSink = log.textFileSink(rollingPath, options, textOptions)
logger.addSink(rollingSink)
for i in range(0, 8)
    logger.info("rolling-line-content")
end
logger.flush()
assert file.exists(rollingPath)
assert file.exists(rollingPath + ".1")
assert rollingSink.closeFile()
logger.clearSinks()
println("rolling=ok")

int customCount = 0
string customLast = ""
auto capture = log.customSink(func(LogRecord record) as LogResult
    customCount += 1
    customLast = record.message
    return LogResult.written
end, "capture", LogLevel.info)
logger.addSink(capture)
assert capture.name == "capture"
logger.info("captured")
assert customCount == 1
assert customLast == "captured"
assert logger.removeSink(capture)
assert capture.closeCustom()
logger.info("ignored")
assert customCount == 1
println("custom=ok")
