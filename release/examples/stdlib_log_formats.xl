// Structured formatting, synchronous Writers, and native worker queues.
auto record = log.record(LogLevel.info, "a\0你")
record.field("count", 7)
record.source("demo.xl", 1, "main")
auto text = LogTextOptions()
text.style = LogTextStyle.message
text.flags = log.textNewline
auto json = LogJsonOptions()
json.flags = log.jsonTime + log.jsonLevel + log.jsonLogger + log.jsonMessage + log.jsonSource + log.jsonThread + log.jsonFields + log.jsonNewline
auto buffer = Buffer()
assert log.textToBuffer(record, buffer, text) == string.byteLen(log.text(record, text))
buffer.clear()
assert log.jsonToBuffer(record, buffer, json) == string.byteLen(log.json(record, json))
auto writer = io.bufferWriter()
log.textToWriter(record, writer, text)
log.jsonToWriter(record, writer, json)
auto logger = log.create("formats", LogLevel.trace)
auto textSink = log.textWriterSink(writer, text)
auto jsonSink = log.jsonWriterSink(writer, json)
logger.addSink(textSink)
logger.addSink(jsonSink)
log.setDefault(logger)
assert log.writeRecord(record) == LogResult.written
assert log.printf(LogLevel.info, "%jd", 42) == LogResult.written
log.shutdown()
assert textSink.closeCustom()
assert jsonSink.closeCustom()
logger.clearSinks()
writer.close()

string baseDir = path.join(path.temp(), "xl6_log_formats_example")
dir.createAll(baseDir)
auto files = LogFileOptions()
files.mode = LogFileMode.truncate
auto target = log.textFileSink(path.join(baseDir, "messages.txt"), files, text)
auto asyncOptions = LogAsyncOptions()
asyncOptions.full = LogQueueFull.block
auto asyncSink = log.asyncSink(target, asyncOptions)
logger.addSink(asyncSink)
logger.info("async")
logger.flush()
assert asyncSink.stopAsync()
logger.clearSinks()
auto ring = log.ringSink(target)
logger.addSink(ring)
logger.info("ring")
logger.flush()
assert ring.stopRing()
logger.clearSinks()
assert target.closeFile()
auto jsonFile = log.jsonFileSink(path.join(baseDir, "messages.jsonl"), files, json)
logger.addSink(jsonFile)
logger.writeRecord(record)
logger.flush()
assert jsonFile.closeFile()
logger.clearSinks()
