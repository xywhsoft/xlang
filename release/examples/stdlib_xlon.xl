dir.createAll("examples_out")

bool validOk = xlon.valid(`{"name":"xlang","level":6,"enabled":true}`)
bool validBad = xlon.valid(`{"keep":1,"skip":ptr("123"),"after":2}`)
XlonOptions decodeOptions = xlon.options(ignoreUnsupportedDecode = true)
bool validIgnored = xlon.valid(`{"keep":1,"skip":ptr("123"),"after":2}`, decodeOptions)

var config = xlon.parse(`{"name":"xlang","level":6,"enabled":true}`)

string compact = xlon.stringify(config)
XlonOptions prettyOptions = xlon.options(pretty = true)
string pretty = xlon.stringify(config, prettyOptions)

var copy = xlon.parse(compact)
string jsonText = json.stringify(copy)

XlonWriter writer = xlon.writer()
writer.beginDict()
writer.writeString("name", "xlang")
writer.beginList("items")
writer.writeString(2, "two")
writer.endList()
writer.beginSet("tags")
writer.writeInt(1)
writer.writeInt(2)
writer.endSet()
writer.writeTime("created", #2026-06-18 00:00:00#)
writer.endDict()
string writerText = writer.finish()
var writerCopy = xlon.parse(writerText)

XlonWriter optionWriter = xlon.writer(prettyOptions)
optionWriter.beginDict()
optionWriter.writeInt("level", 6)
optionWriter.writeTime("created", #2026-06-18 00:00:00#)
optionWriter.endDict()
string optionWriterText = optionWriter.finish()

xlon.write("examples_out/stdlib_xlon_example.xlon", config, prettyOptions)
var fileCopy = xlon.read("examples_out/stdlib_xlon_example.xlon", prettyOptions)
string fileText = xlon.stringify(fileCopy)
file.delete("examples_out/stdlib_xlon_example.xlon")

int visitCount = 0
int listIndex = -1

func onXlonEvent(var event) as bool
    visitCount += 1
    if string(event["type"]) == "string" and string(event["value"]) == "two" then
        listIndex = int(event["index"])
    end
    return true
end

func stopXlonEvent(var event) as bool
    return int(event["depth"]) < 1
end

string visitSource = `{"items":intmap{2:"two"},"tags":set[1,2],"when":time("2026-06-18T00:00:00Z")}`
int visitResult = xlon.visit(visitSource, onXlonEvent)
int stopResult = xlon.visit(visitSource, stopXlonEvent)
int invalidResult = xlon.visit("{bad}", onXlonEvent)

auto compactText = compact.toString()
auto prettyText = pretty.toString()
auto jsonTextCopy = jsonText.toString()
auto fileTextCopy = fileText.toString()

assert(validOk)
assert(not validBad)
assert(validIgnored)
assert(string.contains(compact, "xlang"))
assert(string.contains(pretty, "\n"))
assert(string.contains(jsonText, `"level"`))
assert(string.contains(writerText, "intmap{"))
assert(string.contains(writerText, "time("))
assert(string.contains(optionWriterText, "\n"))
assert(string.contains(optionWriterText, "time("))
assert(string.contains(xlon.stringify(writerCopy), `"name"`))
assert(string.contains(fileText, "enabled"))
assert(visitCount >= 9)
assert(listIndex == 2)
assert(visitResult == xlon.visitComplete)
assert(stopResult == xlon.visitStopped)
assert(invalidResult == xlon.visitInvalid)
println("xlon=ok")
