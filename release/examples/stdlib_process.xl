// Requires a shell and the host's sort command (Windows and POSIX).
assert process.stdin == 0 and process.stdout == 1 and process.stderr == 2
assert process.stdioInherit == 0 and process.stdioPipe == 1 and process.stdioNull == 2
assert process.stateRunning == 0 and process.stateExited == 1
assert string.trim(process.exec("echo hello-process")) == "hello-process"
assert process.success("exit 0") and not process.success("exit 5")
assert process.exitCode("exit 5") == 5

auto configured = process.shell("echo configured")
configured.env("XL6_PROCESS_EXAMPLE", "value")
auto result = process.run(configured, ProcessRunOptions(5000, 1024, 1024))
assert result.success and result.exitCode == 0 and not result.timedOut
assert string.trim(result.stdoutText()) == "configured" and result.stderr.length == 0
auto status = result.status
assert status.kind == 1 and status.code == 0
assert process.runFile("sort", [], 5000).success
auto directLive = process.startFile("sort")
assert directLive.closeStdin()
auto directStatus = directLive.wait(5000)
assert directStatus != null
if directStatus != null then
    assert directStatus.code == 0
end

auto pipe = process.pipeline([process.shell("echo alpha"), process.cmd("sort")], b"", 5000)
auto stage = pipe.stage(1)
assert pipe.success and pipe.count == 2 and pipe.completedCount == 2
assert pipe.failedIndex == -1 and string.trim(pipe.stdoutText()) == "alpha"
assert stage.success and stage.status.code == 0 and stage.stderr.length == 0
auto failed = process.pipeline([process.shell("exit 5"), process.shell("echo still-runs")], b"", 5000)
assert not failed.success and failed.failedIndex == 0 and failed.exitCode == 0
assert failed.count == 2 and failed.completedCount == 2 and failed.stage(0).exitCode == 5

auto live = process.start(process.cmd("sort"))
auto input = live.stdinWriter()
auto output = live.stdoutReader()
auto errors = live.stderrReader()
input.writeAll("live-process\n")
input.close()
assert string.trim(encoding.decode(output.readAll())) == "live-process"
assert errors.readAll().length == 0
auto ended = live.wait(5000)
assert ended != null
if ended != null then assert ended.code == 0 end
assert not live.running
output.close()
errors.close()
println("process run/pipeline/live=ok")
