string filePath = "examples_out/example_stdlib_json.json"

int visitCount = 0
string visitedName = ""

func visitJson(var event) as bool
    visitCount += 1
    if string(event["type"]) == "string" and string(event["key"]) == "name" then
        visitedName = string(event["value"])
    end
    return true
end

dir.createAll("examples_out")

bool validOk = json.valid(`{"name":"xlang","stage":6}`)
bool validBad = json.valid(`{"name":`)

var values = json.parse("[1,2,3]")
string compact = json.stringify(values)
string pretty = json.stringify(values, pretty = true)

var object = json.parse(`{"name":"xlang","stage":6}`)
string objectText = json.stringify(object)

bool written = json.write(filePath, object, pretty = true)
var loaded = json.read(filePath)
string loadedText = json.stringify(loaded)
bool deleted = file.delete(filePath)

int visitStatus = json.visit(`{"name":"xlang","items":[1,true,null]}`, visitJson)
JsonWriter writer = json.writer()
assert(writer.beginObject())
assert(writer.writeString("name", "xlang"))
assert(writer.beginArray("items"))
assert(writer.writeInt(1))
assert(writer.writeBool(true))
assert(writer.writeNull())
assert(writer.endArray())
assert(writer.endObject())
string streamed = writer.finish()

JsonWriter prettyWriter = json.writer(true)
assert(prettyWriter.beginObject())
assert(prettyWriter.writeString("name", "xlang"))
assert(prettyWriter.beginArray("items"))
assert(prettyWriter.writeInt(1))
assert(prettyWriter.writeInt(2))
assert(prettyWriter.endArray())
assert(prettyWriter.endObject())
string streamedPretty = prettyWriter.finish()

auto compactText = compact.toString()
auto prettyText = pretty.toString()
auto objectJsonText = objectText.toString()
auto writtenText = written.toString()
auto loadedJsonText = loadedText.toString()
auto deletedText = deleted.toString()

assert(validOk)
assert(not validBad)
assert(compact == "[1,2,3]")
assert(string.contains(pretty, "\n"))
assert(string.contains(objectText, `"xlang"`))
assert(written)
assert(string.contains(loadedText, `"stage"`))
assert(deleted)
assert(visitStatus == json.visitComplete)
assert(json.visitStopped == 1)
assert(json.visitInvalid == -1)
assert(visitCount == 8)
assert(visitedName == "xlang")
assert(streamed == `{"name":"xlang","items":[1,true,null]}`)
assert(string.contains(streamedPretty, "\n"))
assert(string.contains(streamedPretty, `"items"`))
println("json=ok")
