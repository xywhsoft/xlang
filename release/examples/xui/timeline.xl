// timeline.xl — 时间线：TimeLineView 控件
import xui

xui.XuiApp g_app

func onFrame()
    g_app.frame(0xE5232823)
end

func main(...) as int
    g_app = xui.XuiApp(800, 500, "TimeLineView Demo")
    point ctx = g_app.context()
    point font = g_app.font()
    xui.Widget root = xui.Widget(g_app.rootHandle())

    xui.Label title = xui.Label(ctx, "TimeLineView Demo", font)
    root.addChild(title)

    xui.TimeLineView timeline = xui.TimeLineView(ctx)
    timeline.setFlex(1.0, 1.0)
    root.addChild(timeline)

    xui.Label hint = xui.Label(ctx, "Vertical timeline area", font)
    root.addChild(hint)

    g_app.run(onFrame)
    return 0
end
