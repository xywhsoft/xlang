// page.xl — 分页：Page 控件
import xui

xui.XuiApp g_app

func onFrame()
    g_app.frame(0xE5232823)
end

func main(...) as int
    g_app = xui.XuiApp(800, 500, "Page Demo")
    point ctx = g_app.context()
    point font = g_app.font()
    xui.Widget root = xui.Widget(g_app.rootHandle())

    xui.Label title = xui.Label(ctx, "Page Demo", font)
    root.addChild(title)

    xui.Page page = xui.Page(ctx)
    page.setPreferredSize(500.0, 40.0)
    root.addChild(page)

    xui.Label hint = xui.Label(ctx, "Pagination bar (page 1 of N)", font)
    root.addChild(hint)

    g_app.run(onFrame)
    return 0
end
