import sha3

class Progress
    int calls = 0
end

// 文件示例使用独占临时目录；与 examples/files.c 输出一致。
func main(...) as int
    string root = dir.temp("", "xlang-sha3-example-", "")
    try
        string source = path.join(root, "中文.txt")
        assert file.writeText(source, "abc"), "SHA3 example input write failed"
        Progress state = Progress()
        string digest = sha3.hashFileHex(source,
            onProgress = func(int current, int total, int output) as bool
                assert current == 3 and total == 3 and output == 0
                state.calls += 1
                return true
            end)
        println("file=" + digest)
        println("callbacks=" + string(state.calls))
        println("bytes=" + string(sha3.hashFileBytes(source).len()))

        // 返回 false 取消，抛出异常保留类别与说明，不交付部分摘要。
        bool cancelled = false
        try
            sha3.hashFileHex(source,
                onProgress = func(int current, int total, int output) as bool
                    return false
                end)
        catch CancelledError e
            cancelled = true
        end
        println("cancelled=" + string(cancelled))
        bool callbackError = false
        try
            sha3.hashFileHex(source,
                onProgress = func(int current, int total, int output) as bool
                    throw ValueError "callback marker"
                end)
        catch ValueError e
            callbackError = e.message == "callback marker"
        end
        println("callback-error=" + string(callbackError))
        bool exceeded = false
        try
            sha3.hashFileHex(source, maxInput = 2)
        catch RangeError e
            exceeded = true
        end
        println("budget=" + string(exceeded))
    finally
        assert dir.delete(root), "SHA3 example temporary directory must be removed"
    end
    return 0
end
