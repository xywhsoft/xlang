import progress

func main(...) as int
    auto bar = progress.create(10)
    bar.setPrefix("Processing")
    bar.setWidth(30)

    int i = 0
    while i < 10
        bar.advance()
        println(bar.render())
        i = i + 1
    end

    println("done:", bar.done)
    bar.set(3)
    println("reset current:", bar.current, "total:", bar.total, "percent:", bar.percent)
    bar.advance(100)
    println("saturated current:", bar.current, "done:", bar.done)
    println("progress example: PASS")
    return 0
end
