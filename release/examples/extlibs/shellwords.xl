import shellwords

func main(...) as int
    var words = shellwords.split("tool 'two words' \"你好\"")
    assert words.length == 3
    println("shellwords: " + string(words.length) + " " +
        string(words[1]) + " " + string(words[2]))
    println("quote: " + shellwords.quote("A=B"))
    println("join: " + shellwords.join(words))
    println("windows: " + shellwords.quoteWindows("a b\\"))
    return 0
end
