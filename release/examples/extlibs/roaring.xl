import roaring



func main(...) as int
    auto rb = roaring.create()
    rb.add(10)
    rb.add(20)
    rb.add(30)
    rb.add(1000000)

    println("count:", rb.count)
    println("contains 20:", rb.contains(20))
    println("contains 25:", rb.contains(25))
    println("min:", rb.min)
    println("max:", rb.max)

    rb.remove(20)
    println("after remove 20, count:", rb.count)
    var ordered = rb.toArray()
    println("ordered:", ordered[0], ordered[1], ordered[2])

    auto other = roaring.create()
    other.add(30)
    other.add(40)
    auto merged = rb.unionWith(other)
    auto common = rb.intersectWith(other)
    auto remaining = rb.differenceWith(other)
    println("union count:", merged.count)
    println("intersection count:", common.count)
    println("difference count:", remaining.count)

    println("roaring example: PASS")
    return 0
end
