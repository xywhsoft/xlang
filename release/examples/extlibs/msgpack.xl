import msgpack

func main(...) as int
    var message = {
        "service": "xlang",
        "version": 6,
        "tags": ["binary", "compact"],
        "enabled": true
    }
    Buffer packed = msgpack.encode(message)
    println("MessagePack hex: ", msgpack.toHex(packed))

    var restored = msgpack.decode(packed)
    assert restored["service"] == "xlang"
    assert restored["version"] == 6
    assert restored["tags"][1] == "compact"
    assert restored["enabled"] == true
    println("service: ", restored["service"])
    println("second tag: ", restored["tags"][1])

    Buffer raw = Buffer()
    raw.appendByte(0xca)
    raw.appendByte(0xfe)
    Buffer binary = msgpack.encodeBytes(raw)
    assert msgpack.toHex(binary) == "c402cafe"
    assert msgpack.toHex(msgpack.decodeBytes(binary)) == "cafe"
    println("binary MessagePack: ", msgpack.toHex(binary))
    println("binary payload: ", msgpack.toHex(msgpack.decodeBytes(binary)))
    println("msgpack example: PASS")
    return 0
end
