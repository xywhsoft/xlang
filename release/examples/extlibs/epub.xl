import epub

func runExample(string outputPath)
    var meta = {"title": "xlang 电子书", "language": "zh-CN",
        "identifier": "urn:xlang:example:epub",
        "modified": "2026-08-01T00:00:00Z"}
    var chapters = [
        {"title": "第一章", "text": "# 开始\n\n你好，xlang。"},
        {"title": "第二章", "text": "# 下一步\n\n使用 C 与 xlang。"}
    ]
    assert epub.build(outputPath, meta, chapters) > 0
    string nav = epub.readEntry(outputPath, "OEBPS/nav.xhtml")
    assert nav.contains("第一章") and nav.contains("第二章")
    println("chapters: 2")
    println("title: xlang 电子书")
    println("epub example: PASS")
end

func main(...) as int
    if arg.length > 1 then
        runExample(string(arg[1]))
        return 0
    end
    string workDir = path.join(path.temp(), "xlang_epub_example_" + crypto.randomString(20))
    dir.createAll(workDir)
    try
        runExample(path.join(workDir, "book.epub"))
    finally
        assert dir.delete(workDir), "temporary EPUB example directory must be removed"
    end
    return 0
end
