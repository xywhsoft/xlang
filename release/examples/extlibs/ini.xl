import ini

func main(...) as int
    auto config = ini.parse("[server]\nhost = localhost\nport = 8080\nurl = http://${host}:${port}/api\n", interpolation=true)
    assert config.get("server", "url") == "http://localhost:8080/api"
    config.set("server", "port", "9090")
    assert config.getInt("server", "port") == 9090
    assert config.get("server", "url") == "http://localhost:9090/api"
    println(config.get("server", "host") + ":" + config.get("server", "port"))
    println(config.get("server", "url"))

    // 新建配置并存入独占目录，读回后确认文件路径工作流。
    string root = dir.temp("", "xlang-ini-example-", "")
    try
        string configPath = path.join(root, "config.ini")
        auto created = ini.create()
        created.set("server", "host", "from-file")
        created.save(configPath)
        auto loaded = ini.load(configPath)
        assert loaded.get("server", "host") == "from-file"
        println("loaded=", loaded.get("server", "host"))
    finally
        assert dir.delete(root), "INI example temporary directory must be removed"
    end
    println("ini example: PASS")
    return 0
end
