import fix

func main(...) as int
    var order = [
        fix.field(35, "D"),
        fix.field(49, "BUY_SIDE"),
        fix.field(56, "SELL_SIDE"),
        fix.field(11, "client-order-42"),
        fix.field(55, "XLANG"),
        fix.field(54, "1"),
        fix.field(38, "100"),
        fix.field(40, "2"),
        fix.field(44, "12.50")
    ]
    string message = fix.build("FIX.4.4", order)
    println("FIX message:", string.replace(message, "\x01", "|"))
    println("valid:", fix.validate(message))
    var parsed = fix.parse(message)
    println("message type:", parsed["fields"][2]["value"])
    println("first application tag:", parsed["fields"][2]["tag"])
    println("fix example: PASS")
    return 0
end
