import imagehash

func main(...) as int
    string path = "release/examples/extlibs/assets/tiny.png"
    string a = imagehash.ahash(path)
    string d = imagehash.dhash(path)
    string p = imagehash.phash(path)
    string otherP = imagehash.phash("release/examples/games/assets/player.png")
    println("aHash:", a)
    println("dHash:", d)
    println("pHash:", p)
    println("pHash(other):", otherP)
    println("distance(p,pOther):", imagehash.hamming(p, otherP))
    return 0
end
