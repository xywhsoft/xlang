import stb_image

func main(...) as int
    string imagePath = path.join(path.appDir(), "examples/extlibs/assets/tiny.png")
    if arg.length > 1 then imagePath = string(arg[1]) end
    assert stb_image.available()
    assert stb_image.version() == "stb_image 2.30"
    assert not stb_image.isHdr(imagePath)

    stb_image.StbImage image = stb_image.load(imagePath, 4)
    assert image.valid()
    assert image.channels() == 4
    assert not image.isFloat()
    Buffer pixels = image.pixels()
    assert pixels.len() == int(image.byteSize())

    Buffer encoded = Buffer(file.readBytes(imagePath))
    stb_image.StbImage fromMemory = stb_image.loadBytes(encoded, 4)
    assert fromMemory.width() == image.width()
    assert fromMemory.height() == image.height()
    stb_image.StbImage floats = stb_image.loadfBytes(encoded, 4)
    assert floats.isFloat()

    println("image: ", image.width(), "x", image.height())
    println("channels: ", image.channels())
    println("pixel bytes: ", pixels.len())
    println("stb_image C/XL example: PASS")
    return 0
end
