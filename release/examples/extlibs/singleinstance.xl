import singleinstance



func main(...) as int
    if not singleinstance.acquire("my_app") then
        println("Another instance is already running!")
        return 1
    end

    try
        println("Acquired single instance lock")
        println("isAcquired:", singleinstance.isAcquired())
    finally
        singleinstance.release()
        println("Released lock")
    end

    println("singleinstance example: PASS")
    return 0
end
