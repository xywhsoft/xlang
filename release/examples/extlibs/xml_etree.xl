import xml.etree



func main(...) as int
    auto catalog = xml.etree.create("catalog")
    auto first = catalog.append("book")
    first.set("id", "xlang")
    first.text = "XLang 编译器"
    auto second = catalog.append("book")
    second.set("id", "xrt")
    second.text = "XRT 运行库"
    print(catalog.stringify(true, 2, true))
    println("xml.etree C/XL example: PASS")
    return 0
end
