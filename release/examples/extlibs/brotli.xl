import brotli

class FileProgress
    int calls = 0
    int inputBytes = 0
    int totalBytes = 0
end



func main(...) as int
    // ─── 1. 一次性压缩 / 解压（Buffer 二进制安全）───
    Buffer source = Buffer()
    source.append("xlang brotli ")
    source.appendByte(0)
    source.appendByte(255)

    Buffer packed = brotli.compress(source)
    Buffer plain = brotli.decompress(packed)
    assert plain == source, "brotli Buffer round trip failed"
    println("一次性: ", source.len(), " 字节 -> ", packed.len(), " 字节")

    // 字符串按 UTF-8 字节压缩，二进制内容应使用 Buffer。
    Buffer textPacked = brotli.compress("你好，Brotli")
    assert brotli.decompressText(textPacked) == "你好，Brotli"
    println("引擎版本: ", brotli.version())

    // ─── 2. 增量流式压缩：update -> drain -> finish ───
    // drain() 随时取走已产出的压缩字节，适合边喂数据边落盘/发送。
    auto encoder = brotli.compressor()
    Buffer streamPacked = Buffer()
    encoder.update("hello ")
    streamPacked.append(encoder.drain())
    encoder.update("stream")
    streamPacked.append(encoder.drain())
    encoder.finish()                 // 封存标准 Brotli 流
    streamPacked.append(encoder.drain())
    println("流式压缩: 喂入 ", encoder.inputBytes, " 字节, 产出 ",
        encoder.outputBytes, " 字节")

    // ─── 3. 增量流式解压 + 进度回显 + 多成员统计 ───
    auto decoder = brotli.decompressor()
    Buffer restored = Buffer()
    decoder.update(streamPacked)
    restored.append(decoder.drain()) // 取走已解压数据
    println("解压进度: 已喂入 ", decoder.inputBytes, " / 已产出 ",
        decoder.outputBytes, " 字节, 完成=", decoder.finished)
    decoder.finish()                 // 校验流完整性
    restored.append(decoder.drain())
    assert restored.text() == "hello stream", "brotli incremental round trip failed"

    // 完整前一流不能掩盖后一流的截断。
    Buffer chainedTruncated = Buffer()
    chainedTruncated.append(packed)
    for i in range(0, streamPacked.len() - 1)
        chainedTruncated.appendByte(streamPacked[i])
    end
    bool truncatedRejected = false
    try
        brotli.decompress(chainedTruncated)
    catch IOError e
        truncatedRejected = true
    end
    assert truncatedRejected, "truncated final brotli member must be rejected"
    println("成员数: ", decoder.members) // 1；>1 表示串联多成员流

    // ─── 4. 质量 / 窗口 / 模式调优（quality 0..11，window 10..24，mode 通用/文本/字体）───
    auto tuned = brotli.compressor(brotli.BROTLI_MAX_QUALITY)
    tuned.update("tune me")
    tuned.finish()
    assert brotli.decompress(tuned.drain()).text() == "tune me"
    println("最高质量 Q11 流式往返: OK")

    Buffer textMode = brotli.compress("utf8 text tuned by brotli text mode",
        brotli.BROTLI_DEFAULT_QUALITY, brotli.BROTLI_DEFAULT_WINDOW, brotli.BROTLI_MODE_TEXT)
    assert brotli.decompressText(textMode) == "utf8 text tuned by brotli text mode"
    println("文本模式压缩往返: OK")

    // ─── 5. 截断检测；Brotli 没有内容校验和，不能检测每一种翻位 ───
    bool rejected = false
    try
        brotli.decompress(Buffer())
    catch IOError e
        rejected = true
    end
    assert rejected, "empty encoded input must be rejected"
    println("空输入拒绝: OK")

    // ─── 6. 文件便捷接口（XRT reader/writer，临时文件+原子重命名）───
    string root = dir.temp("", "xlang-brotli-example-", "")
    string sourcePath = path.join(root, "source.bin")
    string packedPath = path.join(root, "packed.br")
    string plainPath = path.join(root, "plain.bin")
    FileProgress progress = FileProgress()
    try
        assert file.writeBytes(sourcePath, source.toBytes())
        brotli.compressFile(sourcePath, packedPath,
            onProgress = func(int inputBytes, int totalBytes, int outputBytes) as bool
                progress.calls += 1
                progress.inputBytes = inputBytes
                progress.totalBytes = totalBytes
                return true
            end)
        assert progress.calls > 0
        assert progress.inputBytes == source.len()
        assert progress.totalBytes == source.len()
        brotli.decompressFile(packedPath, plainPath)
        assert file.readBytes(plainPath) == source.toBytes()
    finally
        assert dir.delete(root), "Brotli example temporary directory must be removed"
    end

    println("brotli example: PASS")
    return 0
end
