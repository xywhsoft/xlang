import fuzzy



func main(...) as int
    println("levenshtein(kitten, sitting):", fuzzy.levenshtein("kitten", "sitting"))
    println("ratio(hello, hallo):", fuzzy.ratio("hello", "hallo"))
    println("score(fb, foobar):", fuzzy.score("fb", "foobar"))
    println("isMatch(xyz, foobar):", fuzzy.isMatch("xyz", "foobar"))

    string candidates = "src/main.c\nsrc/utils.c\nlib/parser.c\nlib/lexer.c"
    println("best(pc, ...):", fuzzy.best("pc", candidates))
    println("best(abc, ...):", fuzzy.best("abc", "a_b_c\nabc"))

    println("fuzzy example: PASS")
    return 0
end
