import tar



func main(...) as int
    auto writer = tar.create()
    writer.mkdir("docs")
    writer.add("docs/hello.txt", "hello TAR")
    Buffer binary = Buffer()
    binary.appendByte(0)
    binary.appendByte(255)
    writer.add("data.bin", binary)

    Buffer packed = writer.finish()
    auto reader = tar.open(packed)
    int count = 0
    while reader.next()
        auto info = reader.info()
        if info.isFile then
            Buffer data = reader.read()
            if info.name == "docs/hello.txt" then
                assert data.text() == "hello TAR", "TAR text mismatch"
            end
        else
            reader.skip()
        end
        count += 1
    end
    assert count == 3, "TAR entry count mismatch"

    string output = dir.temp("", "xlang-tar-example-", "")
    try
        reader = tar.open(packed)
        reader.extractSelected(output, ["docs/hello.txt"])
        assert file.readText(path.join(output, "docs/hello.txt")) == "hello TAR", "TAR selected extraction mismatch"
        assert not file.exists(path.join(output, "data.bin")), "TAR selected extraction wrote an unselected entry"
    finally
        assert dir.delete(output), "TAR example temporary directory must be removed"
    end
    println("tar example: PASS")
    return 0
end
