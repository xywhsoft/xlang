import money



func main(...) as int
    // 订单结算：精确累加（浮点场景经典坑）
    int subtotal = 0
    var items = [
        {"name": "keyboard", "cents": 7999},
        {"name": "mouse", "cents": 3499},
        {"name": "cable", "cents": 1200},
        {"name": "shipping", "cents": 1500}
    ]
    for item in items
        subtotal = money.add(subtotal, int(item["cents"]))
    end
    println("subtotal:", money.format(subtotal, "USD"))

    // 精确比例：9/10 折扣、107/100 税费，不经过二进制浮点数
    int discounted = money.scale(subtotal, 9, 10)
    int taxed = money.scale(discounted, 107, 100)
    println("after 10% off:", money.format(discounted, "USD"))
    println("after 7% tax:", money.format(taxed, "USD"))

    // 减去退货、计算多件商品；浮点比例只用于估算
    println("after refund:", money.format(money.sub(subtotal, 1200), "USD"))
    println("three small items:", money.format(money.mul(125, 3), "USD"))
    println("floating estimate (cents):", money.rate(125, 0.5))
    println("JPY decimal places:", money.exponent("JPY"))

    // 三人分摊
    var parts = money.split(taxed, 3)
    for i in range(0, parts.length)
        println("friend", i + 1, "pays", money.format(int(parts[i]), "USD"))
    end

    // 多币种展示
    array<string> currencies = ["USD", "EUR", "CNY", "JPY", "GBP", "RUB"]
    for c in currencies
        println(c, money.symbol(c), money.format(123456, c))
    end

    println("money example: PASS")
    return 0
end
