import ical

func main(...) as int
    var event = {
        "uid": "standup@team",
        "dtstamp": "20260801T000000Z",
        "dtstart": "20260817T013000Z",
        "summary": "团队例会",
        "rrule": "FREQ=WEEKLY;BYDAY=MO,WE"
    }
    string text = ical.build({"events": [event]})
    if arg.length > 1 then
        assert file.writeText(string(arg[1]), text)
    end
    var back = ical.parse(text)
    println("events:", back["events"].length)
    println("summary:", back["events"][0]["summary"])
    println("rrule:", back["events"][0]["rrule"])
    println("ical example: PASS")
    return 0
end
