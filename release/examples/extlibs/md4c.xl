import md4c

assert md4c.available(), "md4c available failed"

string markdown = "# Title\n\nHello **xlang**"
string markdownPath = "extlibs/md4c/test/fixture.md"
if not path.exists(markdownPath) then
    markdownPath = "release/extlibs/md4c/test/fixture.md"
end

c_int commonmark = md4c.commonmark_flags()
c_int github = md4c.github_flags()
c_int xhtml = md4c.xhtml_flag()
c_int skipBom = md4c.skip_utf8_bom_flag()
c_int verbatim = md4c.verbatim_entities_flag()
c_int noHtml = md4c.no_html_flag()

assert md4c.version() == "md4c 0.5.2", "md4c version mismatch"
string html = md4c.html(markdown)
assert string.contains(html, "<h1>Title</h1>"), "md4c html h1 missing"
assert string.contains(html, "<strong>xlang</strong>"), "md4c html strong missing"
string htmlFlags = md4c.html_flags(markdown, github, xhtml + verbatim)
string safeHtml = md4c.html_flags("before <script>alert(1)</script> after", github + noHtml, c_int(0))
assert not string.contains(safeHtml, "<script>"), "md4c no-html flag failed"
assert string.contains(htmlFlags, "<h1>Title</h1>"), "md4c html_flags h1 missing"
string fileHtml = md4c.file_html(markdownPath, commonmark, skipBom)
assert string.contains(fileHtml, "<strong>xlang</strong>"), "md4c file_html strong missing"
assert md4c.last_error() == "", "md4c should clear last_error after success"

println("md4c extlib ok")
