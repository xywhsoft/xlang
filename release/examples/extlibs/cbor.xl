// CBOR 范例：字典、数组和 Buffer 二进制内容均直接进入编解码器。
import cbor

func main(...) as int
    var profile = {
        "name": "xlang",
        "version": 6,
        "tags": ["codec", "binary", "xrt"],
        "enabled": true
    }
    Buffer packed = cbor.encode(profile)
    println("CBOR hex: ", cbor.toHex(packed))

    var restored = cbor.decode(packed)
    println("name: ", restored["name"])
    println("second tag: ", restored["tags"][1])

    Buffer payload = Buffer()
    payload.appendByte(0xde)
    payload.appendByte(0xad)
    payload.appendByte(0xbe)
    payload.appendByte(0xef)
    Buffer binary = cbor.encodeBytes(payload)
    println("binary CBOR: ", cbor.toHex(binary))
    println("binary payload: ", cbor.toHex(cbor.decodeBytes(binary)))
    println("cbor example: PASS")
    return 0
end
