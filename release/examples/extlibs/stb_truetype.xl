import stb_truetype

func main(...) as int
    // 测试字体随范例提供；正式程序应把自己的字体作为资源提供。
    string fontPath = path.join(path.appDir(),
        "extlibs/stb_truetype/test/assets/DejaVuSans-test.ttf")
    if arg.length > 1 then fontPath = string(arg[1]) end
    stb_truetype.Font font = stb_truetype.load(fontPath)
    stb_truetype.Bitmap glyph = font.bitmap(65, 24.0)
    assert font.glyphIndex(65) > 0
    assert font.advance(65) > 0
    assert glyph.width() > 0 and glyph.height() > 0
    assert glyph.pixels().len() == glyph.byteSize()
    println("glyph A bytes: ", glyph.byteSize())
    println("stb_truetype C/XL example: PASS")
    return 0
end
