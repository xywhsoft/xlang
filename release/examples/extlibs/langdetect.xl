import langdetect



func main(...) as int
    auto en = "the cat is on the table and it is not bad"
    println("detect('the cat is on the table and it is not bad') = ",
        langdetect.detect(en))
    println("  code/script/confidence = ",
        langdetect.code(en), " / ",
        langdetect.script(en), " / ",
        langdetect.confidence(en))
    println("detect(' le chat est dans la maison avec une fille ') = ",
        langdetect.detect(" le chat est dans la maison avec une fille "))
    println("detect(' der Hund und die Katze sind nicht das Haus ') = ",
        langdetect.detect(" der Hund und die Katze sind nicht das Haus "))

    auto zh = "\xe4\xbb\x8a\xe5\xa4\xa9\xe5\xa4\xa9\xe6\xb0\x94\xe5\xbe\x88\xe5\xa5\xbd"
    println("detect(Chinese text) = ", langdetect.detect(zh))
    auto supplementaryHan = "\xf0\xa0\x80\x80\xf0\xa0\x80\x80" // U+20000 x 2
    println("detect(Supplementary Han text) = ", langdetect.detect(supplementaryHan))

    auto ja = "\xe3\x81\x93\xe3\x82\x93\xe3\x81\xab\xe3\x81\xa1\xe3\x81\xaf"
    println("detect(Japanese text) = ", langdetect.detect(ja))

    auto ko = "\xec\x95\x88\xeb\x85\x95\xed\x95\x98\xec\x84\xb8\xec\x9a\x94"
    println("detect(Korean text) = ", langdetect.detect(ko))
    assert langdetect.isEnglish(en) and langdetect.isChinese(zh)
    assert langdetect.isJapanese(ja) and langdetect.isKorean(ko)
    println("predicates = ", langdetect.isEnglish(en), " / ",
        langdetect.isChinese(zh), " / ", langdetect.isJapanese(ja), " / ",
        langdetect.isKorean(ko))

    assert langdetect.isValidUtf8(zh) and langdetect.lastError() == ""
    println("utf8/error-clear = ", langdetect.isValidUtf8(zh), " / ",
        langdetect.lastError() == "")

    println("detect('12345 !!!') = ", langdetect.detect("12345 !!!"))

    println("langdetect example: PASS")
    return 0
end
