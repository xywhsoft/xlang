import mysql

func main(...) as int
    // 本包提供协议和文本辅助，不会连接数据库或执行 SQL。
    println(mysql.cmdName(31))
    println(mysql.colType(0xfd))
    println(mysql.capName(0x200000))
    println(mysql.statusStr(0x4103))
    println(mysql.escape("it's"))

    // IPv6 使用原始主机名，DSN 格式器自动加上方括号。
    string dsn = mysql.formatDsn("::1", 3306, "app", "dev")
    println(dsn)
    println(mysql.dsnPart(dsn, "host"))
    println(mysql.dsnPart(dsn, "db"))
    println(mysql.errorClass(1045))
    println(mysql.errorClass(2003))
    return 0
end
