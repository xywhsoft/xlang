import op

func main(...) as int
    string screen = op.getScreenSize()
    assert string.contains(screen, "x"), "screen size unavailable"
    auto context = op.create()
    assert context.isBind() == 0, "new context should be unbound"
    println("screen: " + screen)
    println("bound: " + string(context.isBind()))
    return 0
end
