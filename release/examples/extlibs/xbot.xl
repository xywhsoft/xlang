from xbot import XBOT_VERSION, Size, Pixel, Ratio, OpResult

assert string.startsWith(XBOT_VERSION, "0.1."), "xbot version failed"

Size screen = Size(1920, 1080)
assert screen.width == 1920 and screen.height == 1080, "xbot Size failed"

Pixel pixel = Pixel(12.5, 24.5)
assert pixel.x == 12.5 and pixel.y == 24.5, "xbot Pixel failed"

Ratio center = Ratio(0.5, 0.5)
assert center.x == 0.5 and center.y == 0.5, "xbot Ratio failed"

OpResult result = OpResult(true, "ready", "")
assert result.ok() and result.fail() == false, "xbot OpResult failed"

println("xbot extlib ok")
