float radius = 3.0
float area = math.pow(radius, 2.0) * math.pi
float diagonal = math.sqrt(2.0)

assert(area ~= 28.274333882308138)
assert(diagonal ~= 1.414213562373095)
assert(math.abs(-3.5) ~= 3.5)
assert(math.abs(-7) == 7)
println("basic=ok")

assert(math.sin(0.0) ~= 0.0)
assert(math.cos(0.0) ~= 1.0)
assert(math.tan(0.0) ~= 0.0)
assert(math.asin(0.0) ~= 0.0)
assert(math.acos(1.0) ~= 0.0)
assert(math.atan(0.0) ~= 0.0)
assert(math.atan2(0.0, 1.0) ~= 0.0)
println("trig=ok")

assert(math.exp(0.0) ~= 1.0)
assert(math.log(1.0) ~= 0.0)
assert(math.log10(100.0) ~= 2.0)
assert(math.log2(8.0) ~= 3.0)
assert(math.exp2(4.0) ~= 16.0)
assert(math.log1p(1.0) ~= math.log(2.0))
assert(math.expm1(1.0) ~= (math.e - 1.0))
println("exp_log=ok")

assert(math.floor(1.9) ~= 1.0)
assert(math.ceil(1.1) ~= 2.0)
assert(math.round(1.6) ~= 2.0)
assert(math.trunc(-1.9) ~= -1.0)
assert(math.fract(-1.25) ~= 0.75)
assert(math.mod(5.5, 2.0) ~= 1.5)
println("rounding=ok")

assert(math.pi ~= 3.141592653589793)
assert(math.tau ~= (math.pi * 2.0))
assert(math.e ~= 2.718281828459045)
assert(math.isNaN(math.nan))
assert(math.isInf(math.inf))
assert(math.isFinite(math.pi))
assert(not math.isFinite(math.inf))
println("constants=ok")

assert(math.min(-2.0, 5.0) ~= -2.0)
assert(math.max(-2.0, 5.0) ~= 5.0)
assert(math.clamp(12.0, 0.0, 10.0) ~= 10.0)
assert(math.clamp(-2.0, 0.0, 10.0) ~= 0.0)
assert(math.sign(-3.0) == -1)
assert(math.sign(0.0) == 0)
assert(math.sign(3.0) == 1)
println("range=ok")

assert(math.rad(180.0) ~= math.pi)
assert(math.deg(math.pi) ~= 180.0)
assert(math.cbrt(27.0) ~= 3.0)
assert(math.cbrt(-8.0) ~= -2.0)
assert(math.hypot(3.0, 4.0) ~= 5.0)
println("advanced=ok")
