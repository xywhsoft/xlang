string filePath = "examples_out/example_file_async.txt"
string copyPath = "examples_out/example_file_async.copy.txt"
string movePath = "examples_out/example_file_async.move.txt"
string binaryPath = "examples_out/example_file_async.bin"
string handlePath = "examples_out/example_file_async.handle.bin"
string dirRoot = "examples_out/example_dir_async"

dir.createAll("examples_out")
for oldPath in [filePath, copyPath, movePath, binaryPath, handlePath]
    if file.exists(oldPath) then file.delete(oldPath) end
end
if dir.exists(dirRoot) then dir.delete(dirRoot) end

if await file.writeTextAsync(filePath, "hello") and await file.readTextAsync(filePath) == "hello" then
    println("write_read=ok")
else
    println("write_read=fail")
end

if await file.appendTextAsync(filePath, " async") and await file.copyAsync(filePath, copyPath) and await file.readTextAsync(copyPath) == "hello async" then
    println("append_copy=ok")
else
    println("append_copy=fail")
end

if await file.moveAsync(copyPath, movePath) and not file.exists(copyPath) and await file.deleteAsync(filePath) and await file.deleteAsync(movePath) then
    println("move_delete=ok")
else
    println("move_delete=fail")
end

// Binary values remain bytes throughout the asynchronous API.
bytes data = b"\x00\x7f\xff"
assert await file.writeBytesAsync(binaryPath, data)
assert await file.readBytesAsync(binaryPath) == data

// openAsync 适合需要偏移 readAt/writeAt、刷新和截断的文件。
AsyncFile asyncFile = file.openAsync(
    handlePath,
    file.asyncRead + file.asyncWrite + file.asyncCreate + file.asyncTruncate,
    438,
    file.shareRead + file.shareWrite + file.shareDelete
)
assert await asyncFile.writeAt(uint64(0), data) == uint64(data.length)
assert await asyncFile.flush()
bytes handleRead = await asyncFile.readAt(uint64(0), data.length)
assert handleRead == data
assert await asyncFile.resize(uint64(2)) == uint64(2)
assert await asyncFile.size() == uint64(2)
assert await asyncFile.close()

// 目录操作同样返回 future，可直接与 await 组合。
assert await dir.createAsync(dirRoot)
assert await dir.createAllAsync(dirRoot + "/source/nested")
assert file.writeText(dirRoot + "/source/nested/value.txt", "dir async")
auto copied = await dir.copyAsync(dirRoot + "/source", dirRoot + "/copy")
assert copied.items > uint64(0)
assert await dir.moveAsync(dirRoot + "/copy", dirRoot + "/moved")
auto removed = await dir.deleteAsync(dirRoot + "/moved")
assert removed.items > uint64(0)
removed = await dir.deleteAsync(dirRoot + "/source")
assert removed.items > uint64(0)
assert await dir.removeAsync(dirRoot)

file.delete(binaryPath)
file.delete(handlePath)
