// ch25 — 三角形：填充、描边、锯齿装饰
import xge

func draw_scene()
    // 大三角形（填充 + 描边）
    xge.Shape.triangleFill(400, 80, 250, 380, 550, 380,
        xge.Color.rgba(79, 216, 194, 255))
    xge.Shape.triangleStroke(400, 80, 250, 380, 550, 380,
        3.0, xge.Color.rgba(255, 180, 84, 255))

    // 箭头指示器
    xge.Shape.triangleFill(650, 200, 610, 180, 610, 220,
        xge.Color.rgba(255, 107, 94, 255))

    // 锯齿装饰
    int i = 0
    while i < 20
        float x0 = float(i * 40)
        uint32 col
        if i % 2 != 0 then
            col = xge.Color.rgba(79, 216, 194, 96)
        else
            col = xge.Color.rgba(255, 180, 84, 96)
        end
        xge.Shape.triangleFill(x0, 520, x0 + 40.0, 520, x0 + 20.0, 490, col)
        i = i + 1
    end
end

func on_frame()
    xge.XgeApp.beginFrame(xge.Color.rgba(13, 17, 22, 255))
    draw_scene()
    xge.XgeApp.endFrame()
end

func main(...) as int
    int ret = xge.XgeApp.init(840, 640, "ch25")
    if ret != 0 then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.XgeApp.run(on_frame)
    return 0
end
