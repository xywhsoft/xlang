// ch21 — 点与线段
import xge

func draw_scene()
    float cx = 400.0
    float cy = 350.0
    float r = 130.0

    // 一排渐变大小的点
    int i = 0
    while i < 20
        float x = 100.0 + float(i) * 30.0
        float size = 2.0 + float(i) * 0.5
        xge.Shape.point(x, 120, size, xge.Color.rgba(255, 180, 84, 255))
        i = i + 1
    end

    // 坐标轴
    xge.Shape.line(400, 180, 400, 550, 1.0, xge.Color.rgba(109, 179, 242, 150))
    xge.Shape.line(100, 350, 700, 350, 1.0, xge.Color.rgba(109, 179, 242, 150))

    // 星形连线
    i = 0
    while i < 5
        float a0 = float(i) * 4.0 * math.pi / 5.0 - math.pi / 2.0
        float a1 = float(i + 1) * 4.0 * math.pi / 5.0 - math.pi / 2.0
        xge.Shape.line(
            cx + r * math.cos(a0), cy + r * math.sin(a0),
            cx + r * math.cos(a1), cy + r * math.sin(a1),
            2.0, xge.Color.rgba(255, 180, 84, 255))
        i = i + 1
    end

    // 对角线
    xge.Shape.line(100, 100, 700, 500, 3.0, xge.Color.rgba(255, 107, 94, 100))
end

func on_frame()
    xge.XgeApp.beginFrame(xge.Color.rgba(13, 17, 22, 255))
    draw_scene()
    xge.XgeApp.endFrame()
end

func main(...) as int
    int ret = xge.XgeApp.init(840, 640, "ch21")
    if ret != 0 then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.XgeApp.run(on_frame)
    return 0
end
