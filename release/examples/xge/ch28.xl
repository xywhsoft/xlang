// ch28 — 胶囊形：按钮 + 进度条
import xge

func draw_scene()
    // 水平胶囊按钮
    xge.Shape.capsuleFill(300, 100, 200, 50, xge.Color.rgba(79, 216, 194, 255))

    // 描边胶囊
    xge.Shape.capsuleStroke(300, 180, 200, 50, 2.0, xge.Color.rgba(255, 180, 84, 255))

    // 进度条
    xge.Shape.capsuleFill(100, 300, 600, 24, xge.Color.rgba(51, 51, 51, 255))
    xge.Shape.capsuleFill(100, 300, 390, 24, xge.Color.rgba(79, 216, 194, 255))

    // 垂直胶囊
    xge.Shape.capsuleFill(150, 380, 40, 160, xge.Color.rgba(255, 107, 94, 255))

    // 正方形 → 圆形
    xge.Shape.capsuleFill(250, 400, 80, 80, xge.Color.rgba(109, 179, 242, 255))
end

func on_frame()
    xge.XgeApp.beginFrame(xge.Color.rgba(13, 17, 22, 255))
    draw_scene()
    xge.XgeApp.endFrame()
end

func main(...) as int
    int ret = xge.XgeApp.init(840, 640, "ch28")
    if ret != 0 then
        println("xgeInit failed: " + string(ret))
        return 1
    end
    xge.XgeApp.run(on_frame)
    return 0
end
