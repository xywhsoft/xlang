// 拖动滑块，调整 0 到 100 之间的数值。
import xui
from "./_window.xl" import Window

Window.show("Slider / drag the knob", func(xui.Context ui, xui.Widget root)
 auto slider = ui.slider()
 Window.place(root, slider, 24, 24, 640, 44)
 slider.setRange(0, 100)
 slider.setValue(35)
 auto value = ui.labelNative()
 value.setText("当前值：35")
 Window.place(root, value, 24, 100, 640, 32)
 slider.setChange(func(xui.Widget sender, c_float selected)
  value.setText("当前值："+string(float(selected)))
 end)
end)
