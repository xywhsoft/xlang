// 二维码内容就是 setValue 传入的字符串。
import xui
from "./_window.xl" import Window

Window.show("QR code / UTF-8 content", func(xui.Context ui, xui.Widget root)
 auto qrCode = ui.qrCodeNative()
 Window.place(root, qrCode, 24, 24, 640, 280)
 qrCode.setValue("xlang XUI 3")
 qrCode.setColors(c_uint(0x000000FF), c_uint(0xFFFFFFFF))
end)
