// 把一张橙色原生 Surface 放大显示为图片。
import xui
from "./_window.xl" import Window

Window.showWithProxy("Image / generated RGBA resource", func(xui.Context ui, xui.Widget root, xui.Proxy proxy)
 auto surface = proxy.createSurfaceRGBA(96, 96, flags = c_uint(xui.XUI_SURFACE_USAGE_TARGET))
 try
  proxy.clearSurface(surface, c_uint(0xE8A040FF))
  auto image = ui.imageNative()
  image.setSurface(surface)
  image.setMode(xui.XUI_IMAGE_FIT)
  image.setSource(Window.rect(0, 0, 96, 96))
  Window.place(root, image, 24, 24, 288, 288)
 finally
  // The Image slot retains its real native Surface owner.
  surface.close()
 end
end)
