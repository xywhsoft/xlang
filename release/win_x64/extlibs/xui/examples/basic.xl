// 按钮修改下方文字；复选框和开关可直接点击。
import xui
from "./_window.xl" import Window

Window.show("Basic controls / interactive state", func(xui.Context ui, xui.Widget root)
 auto button = ui.buttonNative()
 button.setText("Click to change the label")
 Window.place(root, button, 24, 64, 300, 44)
 auto status = ui.labelNative()
 status.setText("Waiting for a click")
 Window.place(root, status, 24, 124, 480, 32)
 button.setClick(func(xui.Widget source)
  status.setText("The typed callback ran")
 end)
 auto check = ui.checkBoxNative()
 check.setText("Enable feature")
 Window.place(root, check, 24, 180, 300, 44)
 auto toggle = ui.toggleNative()
 toggle.setText("Live preview")
 Window.place(root, toggle, 24, 240, 300, 44)
end)
