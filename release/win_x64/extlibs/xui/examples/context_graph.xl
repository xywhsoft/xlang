// Inspect a widget tree without creating a native window.
import xui

auto proxy = xui.createProxy()
try
 auto ui = xui.create(proxy)
 try
  auto root = ui.widget()
  ui.setRootWidget(root)
  auto button = ui.buttonNative()
  button.setText("A child in the tree")
  root.addChild(button)
  println(root.getChildCount())
  println(button.getText())
 finally
  ui.close()
 end
finally
 proxy.close()
end
