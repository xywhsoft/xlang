// 切换 Overview 和 Settings，查看各页文字。
import xui
from "./_window.xl" import Window

Window.show("Tabs / Context-owned pages", func(xui.Context ui, xui.Widget root)
 auto tabs = ui.tabsNative()
 Window.place(root, tabs, 24, 24, 640, 260)
 tabs.setItems(["Overview", "Settings"])
 for i in range(0, 2)
  auto page = ui.widget()
  page.setRect(Window.rect(0, 0, 600, 240))
  page.setSizeMode(xui.XUI_SIZE_FILL, xui.XUI_SIZE_FILL)
  auto label = ui.labelNative()
  label.setText("Page "+string(i+1))
  Window.place(page, label, 20, 24, 400, 28)
  tabs.addPageChild(c_int(i), page)
 end
 tabs.setSelected(0)
end)
