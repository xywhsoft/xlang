// Radio / exclusive choice. Run from release/<platform>; Escape or close exits.
import xui
import "./_support.xl" as demo

export class RadioExample
 static func build(xui.Context context,xui.Widget root,xui.Proxy proxy)
  demo.Gallery.label(context,root,"Radio / exclusive choice",24,16)
  auto control=context.radioNative()
  demo.Gallery.place(root,control,24,64,640,44)
  control.setText("First option")
  assert control.setChecked(c_int(1))==0
  auto second=context.radioNative()
  second.setText("Second option")
  demo.Gallery.place(root,second,24,124,300,44)
  assert control.getChecked()!=0
 end
end

func main(...) as int
 return demo.Gallery.run("Radio / exclusive choice",RadioExample.build)
end
