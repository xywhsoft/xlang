// RadioGroup 管理互斥关系；两个 Radio 负责显示各自的文字和圆点。
import xui
from "./_window.xl" import Window

Window.show("Radio / exclusive choice", func(xui.Context ui, xui.Widget root)
 auto group = ui.radioGroup()
 Window.place(root, group, 24, 24, 640, 160)
 group.setOrientation(xui.XUI_RADIO_GROUP_VERTICAL)
 auto radio = ui.radioNative()
 radio.setText("First option")
 group.addRadio(radio)
 auto second = ui.radioNative()
 second.setText("Second option")
 group.addRadio(second)
 group.setSelectedIndex(0)
end)
