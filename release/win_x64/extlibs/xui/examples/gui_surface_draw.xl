// Draw to a Surface once, then display it through a normal Image widget.
import xui
from "./_window.xl" import Window

Window.showWithProxy("Surface drawing", func(xui.Context ui, xui.Widget root, xui.Proxy proxy)
 auto surface = proxy.createSurfaceRGBA(256, 160, flags = c_uint(xui.XUI_SURFACE_USAGE_TARGET))
 try
  auto draw = proxy.beginDraw(surface)
  try
   proxy.clearRect(draw, Window.rect(0, 0, 256, 160), 0x221914FF)
   proxy.fillRect(draw, Window.rect(20, 20, 100, 60), 0xD28C32FF)
   proxy.fillCircle(draw, 184, 80, 40, 0x46B4F0FF)
   draw.finish()
  finally
   draw.close()
  end
  auto image = ui.imageNative()
  image.setSurface(surface)
  image.setMode(xui.XUI_IMAGE_FIT)
  image.setSource(Window.rect(0, 0, 256, 160))
  Window.place(root, image, 24, 24, 512, 320)
 finally
  surface.close()
 end
end)
