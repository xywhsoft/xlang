// 用左右箭头切换三张页面。
import xui
from "./_window.xl" import Window

Window.show("Carousel / page navigation", func(xui.Context ui, xui.Widget root)
 auto carousel = ui.carouselNative()
 Window.place(root, carousel, 24, 24, 640, 260)
 carousel.setPageCount(3)
 for i in range(0, 3)
  auto page = ui.widget()
  page.setRect(Window.rect(0, 0, 600, 240))
  page.setSizeMode(xui.XUI_SIZE_FILL, xui.XUI_SIZE_FILL)
  auto label = ui.labelNative()
  label.setText("Slide "+string(i+1))
  Window.place(page, label, 40, 80, 400, 28)
  carousel.addPageChild(c_int(i), page)
 end
 carousel.setCurrent(0, 0)
end)
