// 分隔线上下各放一行文字。
import xui
from "./_window.xl" import Window

Window.show("Separator / horizontal rule", func(xui.Context ui, xui.Widget root)
 auto separator = ui.separator()
 Window.place(root, separator, 24, 64, 640, 3)
 separator.setColor(c_uint(0xB08040FF))
 auto label = ui.labelNative()
 label.setText("Above the separator")
 Window.place(root, label, 24, 24, 600, 28)
 auto label2 = ui.labelNative()
 label2.setText("Below the separator")
 Window.place(root, label2, 24, 100, 600, 28)
end)
