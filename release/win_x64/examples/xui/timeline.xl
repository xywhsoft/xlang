// Animation 图层中有一个从第 5 帧到第 25 帧的片段。
import xui
from "./_window.xl" import Window

Window.show("Timeline / layers and spans", func(xui.Context ui, xui.Widget root)
 auto timeline = ui.timeLineViewNative()
 Window.place(root, timeline, 24, 24, 640, 300)
 timeline.setFrameCount(100)
 c_int layer = timeline.addLayer("Animation")
 timeline.addSpan(layer, 5, 25, 0, "Move")
 timeline.setCurrentFrame(10)
end)
