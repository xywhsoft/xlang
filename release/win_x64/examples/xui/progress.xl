// 点击按钮增加进度；超过 100% 后从 0 开始。
import xui
from "./_window.xl" import Window

Window.show("Progress / change the value", func(xui.Context ui, xui.Widget root)
 auto progress = ui.progressNative()
 Window.place(root, progress, 24, 24, 640, 44)
 progress.setRange(0, 100)
 progress.setValue(65)
 progress.setTextTemplate("{value}%")
 auto advance = ui.buttonNative()
 advance.setText("增加 10%")
 Window.place(root, advance, 24, 100, 220, 44)
 advance.setClick(func(xui.Widget sender)
  auto value = progress.getValue()+10
  if value>100 then value = 0 end
  progress.setValue(value)
 end)
end)
