// 带标题的面板中放置一个按钮。
import xui
from "./_window.xl" import Window

Window.show("Panel / child ownership", func(xui.Context ui, xui.Widget root)
 auto panel = ui.panelNative()
 Window.place(root, panel, 24, 24, 640, 260)
 panel.setTitle("Panel with child controls")
 auto child = ui.buttonNative()
 child.setText("Owned by this Context")
 Window.place(panel, child, 20, 48, 260, 44)
end)
