// 折线的四个点来自下方两个数据数组。
import xui
from "./_window.xl" import Window

Window.show("Chart / typed data columns", func(xui.Context ui, xui.Widget root)
 auto chart = ui.chartNative()
 chart.setFont(ui.getDefaultFont())
 Window.place(root, chart, 24, 24, 640, 340)
 chart.setTitle("Measured values")
 c_int line = chart.addSeries(xui.XUI_CHART_SERIES_LINE, "Samples")
 chart.setSeriesData(line, [0, 1, 2, 3], [2, 5, 3, 7])
 chart.setLegendVisible(1)
end)
