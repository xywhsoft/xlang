// 滚动查看超出窗口的十二行文字。
import xui
from xui import Widget
from "./_window.xl" import Window

Window.show("Scroll view / content larger than viewport", func(xui.Context ui, xui.Widget root)
 auto scrollView = ui.scrollView()
 Window.place(root, scrollView, 24, 24, 640, 320)
 scrollView.setContentSize(1200, 1000)
 auto content = scrollView.getContentWidget()
 for i in range(0, 12)
  auto label = ui.labelNative()
  label.setText("Scrollable row "+string(i+1))
  Window.place(content as Widget, label, 20, i*70+20, 1000, 28)
 end
end)
