class Gauge
    int value

    create(int initial)
        self.value = initial
    end

    export "gauge_add" func add(int delta) as int
        self.value = self.value + delta
        return self.value
    end

    export "gauge_pair" func pair() as (int, int)
        return self.value, self.value * 2
    end

    func localValue() as int
        return self.add(1)
    end
end

export "gauge_new" func gaugeNew(int initial) as Gauge
    return Gauge(initial)
end

export "gauge_local_value" func gaugeLocalValue(Gauge gauge) as int
    return gauge.localValue()
end

Gauge gauge = Gauge(40)
assert gaugeLocalValue(gauge) == 41, "class_c_export local value failed"
auto current, doubled = gauge.pair()
// localValue() called add(1), so the exported pair observes the new value.
assert current == 41 and doubled == 82, "class_c_export pair failed"
println("class_c_export ok")
