// 拖动中间的分隔条，改变左右区域的宽度。
import xui
from "./_window.xl" import Window

Window.show("Split layout / draggable divider", func(xui.Context ui, xui.Widget root)
 auto split = ui.splitLayout()
 Window.place(root, split, 24, 24, 640, 320)
 auto left = ui.widget()
 auto right = ui.widget()
 left.setSizeMode(xui.XUI_SIZE_FILL, xui.XUI_SIZE_FILL)
 right.setSizeMode(xui.XUI_SIZE_FILL, xui.XUI_SIZE_FILL)
 auto label = ui.labelNative()
 label.setText("Left pane")
 Window.place(left, label, 16, 24, 280, 28)
 auto label2 = ui.labelNative()
 label2.setText("Right pane")
 Window.place(right, label2, 16, 24, 280, 28)
 split.addPaneChild(0, left)
 split.addPaneChild(1, right)
end)
