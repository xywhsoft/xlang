// 显示两行 ANSI 文本，不启动命令行子进程。
import xui
from "./_window.xl" import Window

Window.show("Terminal / ANSI text without a child process", func(xui.Context ui, xui.Widget root)
 auto terminal = ui.terminalNative()
 Window.place(root, terminal, 24, 24, 640, 320)
 terminal.writeText("xlang XUI terminal\r\n\u001b[32mANSI green\u001b[0m\r\nNo shell is started.\r\n")
 terminal.flush()
end)
