// Toolbar / commands and tooltips. Run from release/<platform>; Escape or close exits.
import xui
import "./_support.xl" as demo

export class ToolbarExample
 static func build(xui.Context context,xui.Widget root,xui.Proxy proxy)
  demo.Gallery.label(context,root,"Toolbar / commands and tooltips",24,16)
  auto control=context.toolbarNative()
  demo.Gallery.place(root,control,24,64,640,48)
  assert control.addItem("New",c_int(0),c_int(1))>=0
  assert control.addItem("Build",c_int(0),c_int(2))>=0
  assert control.addSeparator()>=0
  assert control.addItem("Run",c_int(0),c_int(3))>=0
  control.setItemTooltip(c_int(1),"Build the current project")
  assert control.getItemCount()==c_int(4)
 end
end

func main(...) as int
 return demo.Gallery.run("Toolbar / commands and tooltips",ToolbarExample.build)
end
