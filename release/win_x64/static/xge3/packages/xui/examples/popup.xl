// 点击按钮打开弹层；点击外部关闭。
import xui
from xui import Widget
from "./_window.xl" import Window

Window.show("Popup / explicit open and close", func(xui.Context ui, xui.Widget root)
 auto popup = ui.popupNative()
 Window.place(root, popup, 24, 24, 640, 1)
 popup.setContentSize(320, 160)
 auto content = popup.getContentWidget()
 auto label = ui.labelNative()
 label.setText("Click outside or press Escape to close")
 Window.place(content as Widget, label, 12, 20, 300, 28)
 auto owner = ui.buttonNative()
 owner.setText("Open popup")
 Window.place(root, owner, 24, 64, 240, 44)
 owner.setClick(func(xui.Widget source)
  popup.setOwner(source)
  popup.setOpen(1)
 end)
end)
