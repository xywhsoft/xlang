// View and Editor can share one Document without rendering it.
import xui
from xui import Document

auto proxy = xui.createProxy()
try
 auto ui = xui.create(proxy)
 try
  auto document = xui.createDocument()
  try
   auto view = xui.createDocumentView(ui, document)
   auto editor = xui.createDocumentEditor(ui, document)
   editor.setReadOnly(1)
   println(editor.readOnly())
   auto sameDocument = view.document() as Document
   println(sameDocument.identity() == document.identity())
   sameDocument.close()
  finally
   document.close()
  end
 finally
  ui.close()
 end
finally
 proxy.close()
end
