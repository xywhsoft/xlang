// 左侧文字和右侧进度条分别对应两个添加调用。
import xui
from "./_window.xl" import Window

Window.show("Status bar / text and progress", func(xui.Context ui, xui.Widget root)
 auto statusbar = ui.statusBarNative()
 Window.place(root, statusbar, 24, 24, 640, 40)
 statusbar.addText(0, "Ready", 220, 0, 1)
 statusbar.addProgress(0, 0, 100, 65, 180)
end)
