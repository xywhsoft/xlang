// 拖动子窗口标题，或调整其边缘；窗口内有一个按钮。
import xui
from "./_window.xl" import Window

Window.show("Window / move and resize", func(xui.Context ui, xui.Widget root)
 auto window = ui.windowNative()
 // Window opens on the Context floating layer, outside the ordinary page tree.
 window.setRect(Window.rect(24, 64, 640, 260))
 window.setTitle("Movable child window")
 window.setDragAnywhere(1)
 auto button = ui.buttonNative()
 button.setText("A normal child")
 Window.place(window, button, 30, 64, 220, 44)
end)
