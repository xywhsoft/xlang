// 输入数字，或用增减按钮调整数值。
import xui
from "./_window.xl" import Window

Window.show("Numeric input / limits and step", func(xui.Context ui, xui.Widget root)
 auto numberInput = ui.numericInputNative()
 Window.place(root, numberInput, 24, 24, 640, 44)
 numberInput.setRange(-100, 100)
 numberInput.setValue(12.5)
end)
