// Pointer-free exact Document UI C records. Owning descriptors and callback outputs are excluded.
export extern "xui_doc_rect_t" struct DocumentRect @header("xge3_runtime.h")
 c_double x
 c_double y
 c_double width
 c_double height
end

export extern "xui_doc_renderer_stats_t" struct DocumentRendererStats @header("xge3_runtime.h")
 c_uint iSize
 uint64 iBlocks
 uint64 iMeasuredBlocks
 uint64 iShapedBytes
 uint64 iFragments
 uint64 iLayoutPasses
 uint64 iSourceBlocks
 c_int bLiveSourceFallback
 uint64 iSourceBytesScanned
 uint64 iSourceIncrementalUpdates
 uint64 iSourceReusedBlocks
 uint64 iSourceRowsCreated
 uint64 iLayoutCacheBytes
 uint64 iLayoutCacheBudgetBytes
 uint64 iLayoutCacheEvictions
 uint64 iDrawFragmentsExamined
 uint64 iHitFragmentsExamined
 uint64 iCaretFragmentsExamined
 uint64 iTextRunBytes
end

export extern "xui_doc_image_load_limits_t" struct DocumentImageLoadLimits @header("xge3_runtime.h")
 c_uint iSize
 uint64 iMaxEncodedBytes
 uint64 iMaxPixels
end

export extern "xui_doc_image_async_stats_t" struct DocumentImageAsyncStats @header("xge3_runtime.h")
 c_uint iSize
 c_uint iRunning
 c_uint iQueued
 c_uint iOutstanding
 uint64 iCopiedBytes
end

export extern "xui_doc_cell_hit_t" struct DocumentCellHit @header("xge3_runtime.h")
 c_uint iSize
 uint64 iTableId
 uint64 iCellId
 c_uint iRow
 c_uint iColumn
 c_uint iRowSpan
 c_uint iColumnSpan
 DocumentRect tBounds
end

export extern "xui_doc_table_selection_t" struct DocumentTableSelection @header("xge3_runtime.h")
 c_uint iSize
 uint64 iTableId
 c_uint iRow
 c_uint iColumn
 c_uint iRows
 c_uint iColumns
end

export extern "xui_doc_web_provider_stats_t" struct DocumentWebProviderStats @header("xge3_runtime.h")
 c_uint iSize
 c_uint iQueued
 c_uint iReady
 c_uint iFailed
 c_uint iDrawn
 uint64 iDrawCalls
 uint64 iCacheBytes
 uint64 iPaletteGeneration
 c_uint bWorkerFailed
 c_char sWorkerError[128]
 c_uint bRestartPending
 c_uint bRecovering
 c_uint iRestartAttempts
end

export extern "xui_doc_command_state_t" struct DocumentCommandState @header("xge3_runtime.h")
 c_uint iSize
 c_int bEnabled
 c_int bActive
 c_int bMixed
 c_int iDisabledReason
end

export extern "xui_doc_paragraph_spacing_state_t" struct DocumentParagraphSpacingState @header("xge3_runtime.h")
 c_uint iSize
 c_int bEnabled
 c_int bMixed
 c_int bUseDefault
 c_float fValue
 c_int iDisabledReason
end

export extern "xui_doc_editor_text_style_state_t" struct DocumentEditorTextStyleState @header("xge3_runtime.h")
 c_uint iSize
 c_int bEnabled
 c_int iDisabledReason
 DocumentTextStyleQuery tQuery
end

export extern "xui_doc_editor_pending_work_t" struct DocumentEditorPendingWork @header("xge3_runtime.h")
 c_uint iSize
 c_int bHasInput
 uint64 iQueuedEvents
 c_int iResult
end

