func main(...) as int
    int offset = 0
    if arg.length > 0 then
        string firstArg = string(arg[0])
        if string.endsWith(firstArg, ".xl") or string.endsWith(firstArg, ".exe") then
            offset = 1
        end
    end

    string serviceName = ""
    string outPath = ""
    if offset + 1 < arg.length then
        serviceName = string(arg[offset + 1])
    end
    if arg.length > offset then
        string lastArg = string(arg[arg.length - 1])
        if string.endsWith(lastArg, ".out") then
            outPath = lastArg
        end
    end

    dir.createAll("projects/xs/run")
    file.writeText("projects/xs/run/custom.out", "custom:" + serviceName)
    if outPath != "" then
        file.writeText(outPath, "custom:" + serviceName)
    else
        println("custom:" + serviceName)
    end
    return 0
end
