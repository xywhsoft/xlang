import "./socket_service.xl"

func require(bool condition, string message)
    assert condition, message
end

func tcpStressWorker(int port, int workerId, int rounds) as bool
    int round = 0
    while round < rounds
        string payload = workerId.toString() + ":" + round.toString()
        TcpStream stream = tcp.connect("127.0.0.1", port, 3000)
        if stream.handle == null then return false end
        if not stream.send(payload) or not stream.drain(3000) then return false end
        if stream.recv(3000) != "c:" + payload then return false end
        stream.close()
        round += 1
    end
    return true
end

string root = path.abs("projects/xs")
string includeDir = path.join(root, "include")

auto tcpService = socket_service.open(
    "tcp",
    "tcp-test",
    "127.0.0.1",
    0,
    32,
    2,
    32,
    65536,
    "raw",
    "",
    65536,
    3000,
    3000,
    path.join(root, "tests/handlers/abi_c.c"),
    root,
    includeDir,
    2,
    32,
    1000,
    3000)

require(tcpService.ready(), "TCP service must be ready: " + tcpService.lastError)
require(tcpService.start(), "TCP service must start: " + tcpService.lastError)
require(tcpService.port() > 0, "TCP service must publish its bound port")

TcpStream client = tcp.connect("127.0.0.1", tcpService.port(), 3000)
require(client.handle != null, "TCP client must connect")
require(client.send("hello"), "TCP request send must succeed")
require(client.drain(3000), "TCP request drain must succeed")
string tcpReply = client.recv(3000)
require(tcpReply == "c:hello", "TCP response must come from the C handler")
client.close()
time.sleep(100)

require(tcpService.accepted() == 1, "TCP accepted metric must be exact")
require(tcpService.received() == 5, "TCP received byte metric must be exact")
require(tcpService.sent() == 7, "TCP sent byte metric must be exact")
require(tcpService.reload(), "TCP handler reload must succeed: " + tcpService.lastError)
int occupiedPort = tcpService.port()
auto competingService = socket_service.open(
    "tcp", "tcp-competing", "127.0.0.1", occupiedPort,
    17, 1, 5, 65536,
    "raw", "", 65536,
    3000, 3000,
    path.join(root, "tests/handlers/abi_c.c"),
    root, includeDir, 1, 8, 1000, 3000)
require(competingService.ready(), "competing service must prepare without binding")
require(not competingService.start(), "duplicate active TCP bind must fail at start")
require(tcpService.stop(), "TCP service must stop")
require(not tcpService.started(), "TCP service must report stopped state")
require(competingService.start(), "released TCP port must be reusable: " + competingService.lastError)
require(competingService.stop(), "competing TCP service must stop")
require(tcpService.start(), "stopped TCP service must support a clean restart: " + tcpService.lastError)
TcpStream restartedClient = tcp.connect("127.0.0.1", tcpService.port(), 3000)
require(restartedClient.send("again") and restartedClient.drain(3000), "restarted TCP service must receive")
require(restartedClient.recv(3000) == "c:again", "restarted TCP service must answer")
restartedClient.close()
require(tcpService.stop(), "restarted TCP service must stop")

auto udpService = socket_service.open(
    "udp",
    "udp-test",
    "127.0.0.1",
    0,
    32,
    2,
    32,
    65536,
    "raw",
    "",
    65536,
    3000,
    3000,
    path.join(root, "tests/handlers/abi_xlang.xl"),
    root,
    includeDir,
    2,
    32,
    1000,
    3000)

require(udpService.ready(), "UDP service must be ready: " + udpService.lastError)
require(udpService.start(), "UDP service must start: " + udpService.lastError)
require(udpService.port() > 0, "UDP service must publish its bound port")

UdpSocket udpClient = udp.bind(0, "127.0.0.1")
require(udpClient.send("127.0.0.1", uint16(udpService.port()), "world"), "UDP request send must succeed")
UdpPacket reply = udpClient.recv(3000)
require(reply.handle != null, "UDP response packet must arrive")
require(reply.text() == "xl:world", "UDP response must come from the xlang handler")
time.sleep(100)

require(udpService.received() == 5, "UDP received byte metric must be exact")
require(udpService.sent() == 8, "UDP sent byte metric must be exact")
require(udpService.reload(), "UDP handler reload must succeed: " + udpService.lastError)
require(udpService.stop(), "UDP service must stop")
require(not udpService.started(), "UDP service must report stopped state")

auto stressService = socket_service.open(
    "tcp",
    "tcp-stress",
    "127.0.0.1",
    0,
    128,
    8,
    128,
    65536,
    "raw",
    "",
    65536,
    3000,
    3000,
    path.join(root, "tests/handlers/abi_c.c"),
    root,
    includeDir,
    4,
    128,
    1000,
    3000)
require(stressService.ready(), "stress service must be ready: " + stressService.lastError)
require(stressService.start(), "stress service must start: " + stressService.lastError)

array<future<bool>> jobs = []
func(int, int, int) as bool stressWorker = tcpStressWorker
int worker = 0
while worker < 12
    jobs.append(task.spawn(stressWorker, stressService.port(), worker, 25))
    worker += 1
end
time.sleep(20)
require(stressService.reload(), "reload during concurrent TCP traffic must succeed")
array<bool> results = await task.all(jobs)
for _, completed in results
    require(completed, "every TCP stress worker must complete")
end
require(stressService.accepted() == 300, "stress service must accept every connection")
require(stressService.errors() == 0, "stress service must not report handler or network errors")
require(stressService.stop(), "stress service must stop after concurrent traffic")

println("xs2 socket service test ok")
