// raftsim - Raft consensus algorithm simulator (5-node cluster)
//
// Usage:
//   raftsim test    Full simulation: initial election -> log replication
//                  -> network partition -> recovery -> re-election.
//
// Models a 5-node Raft cluster implementing (per the Raft paper, Figure 2):
//   - Leader election via RequestVote / RequestVoteResponse.
//   - Log replication via AppendEntries / AppendEntriesResponse.
//   - Heartbeats (AppendEntries with entriesLen=0) keeping followers pinned.
//   - Randomized election timeouts (Follower -> Candidate -> Leader).
//   - Network partition through a link matrix + recovery.
//
// Each node runs in its own thread, draining an inbox channel and running a
// periodic loop (heartbeat pacing for leaders, election-timeout check for
// followers/candidates).
//
// xlang concurrency model used here:
//   - channel<string> carries compact, owned RPC envelopes. Receivers decode
//     each envelope into a local Rpc object, so message state is never shared.
//   - channel / thread are non-copyable; cannot live in typed arrays.
//     Node inboxes are pre-declared globals; node bodies are spawned
//     fire-and-forget via thread(closure) capturing the node id by value
//     (the proven prodcon/actorsys pattern).
//   - channel.send is non-blocking try-enqueue; blocking recvInto after
//     close hangs forever. Nodes poll with tryRecvInto and never close.
//   - Global containers accessed by worker threads are initialized at
//     module scope (array[]) and only mutated in place via push()/index
//     assignment, never re-bound.
//   - time.timer() returns float seconds (wall clock) usable under
//     `xl run`; used for election deadlines and heartbeat pacing.
//     time.sleep(ms) sleeps in milliseconds.
//   - Coarse global mutex g_lock guards all shared state. The one hard
//     rule: NEVER hold g_lock while doing channel.send (could deadlock if
//     a receiver also needs the lock). Every handler releases the lock
//     before composing a response RPC.

// ============================== constants ==================================

int NODES = 5
int MAJORITY = 3
int MAX_LOG = 64

int ST_FOLLOWER = 0
int ST_CANDIDATE = 1
int ST_LEADER = 2

int RPC_VOTE = 1          // RequestVote
int RPC_VOTE_RESP = 2     // RequestVoteResponse
int RPC_APPEND = 3        // AppendEntries (heartbeat if entriesLen=0)
int RPC_APPEND_RESP = 4   // AppendEntriesResponse

float HEARTBEAT_INTERVAL = 0.06   // 60ms leader heartbeat cadence
int ELECTION_MIN_MS = 200         // 200ms min randomized election timeout
int ELECTION_MAX_MS = 450         // 450ms max randomized election timeout

int LINK_ON = 1
int LINK_OFF = 0

// ============================== node state ================================
// Per-node state in parallel global arrays, indexed by node id 0..4.
// Mutated only by that node's own thread (plus the coarse lock for the
// cross-thread test snapshots).

mutex g_lock = mutex()

array<int> g_state = array[]
array<int> g_term = array[]
array<int> g_votedFor = array[]
array<int> g_leaderId = array[]
array<int> g_logLen = array[]
array<int> g_commitIndex = array[]
array<float> g_lastBeat = array[]       // leader: last heartbeat batch (sec)
array<float> g_lastContact = array[]    // follower: last valid AppendEntries (sec)
array<float> g_electDeadline = array[]  // follower/candidate: election timeout (sec)
array<int> g_voteCount = array[]

// Log: g_logTerm[node*MAX_LOG + pos] = term of entry at 1-based position pos.
array<int> g_logTerm = array[]

// Leader bookkeeping, indexed by [leader*NODES + follower]. A node row is
// re-initialized when that node becomes leader.
array<int> g_nextIndex = array[]
array<int> g_matchIndex = array[]

// ============================== link matrix ===============================
// g_link[a*NODES + b] = LINK_ON if a can deliver to b.
array<int> g_link = array[]

int g_running = 1

// ============================== rpc envelope ==============================

class Rpc
    int kind = 0
    int src = 0
    int dst = 0
    int term = 0
    int prevIdx = 0
    int prevTerm = 0
    int entriesLen = 0
    int entryTerm = 0
    int leaderCommit = 0
    int candidateId = -1
    int voteGranted = 0
    int success = 0
    int matchIdx = 0
end

// channel 是 native-backed 资源，因此每个节点使用一个明确的全局 inbox。
channel<string> g_inbox0 = channel::<string>(128)
channel<string> g_inbox1 = channel::<string>(128)
channel<string> g_inbox2 = channel::<string>(128)
channel<string> g_inbox3 = channel::<string>(128)
channel<string> g_inbox4 = channel::<string>(128)

// ============================== client submit =============================
// Main thread submits a value by targeting a specific leader; that leader
// appends to its own log on its next heartbeat cycle.
int g_submitPending = 0
int g_submitTarget = -1
int g_submitDone = 0

// ============================== bookkeeping ===============================
int g_pass = 0
int g_fail = 0

// ============================== init ======================================

func regNode(int id)
    g_state.push(ST_FOLLOWER)
    g_term.push(0)
    g_votedFor.push(-1)
    g_leaderId.push(-1)
    g_logLen.push(0)
    g_commitIndex.push(0)
    g_lastBeat.push(0.0)
    g_lastContact.push(0.0)
    g_electDeadline.push(0.0)
    g_voteCount.push(0)
    int j = 0
    while j < MAX_LOG
        g_logTerm.push(0)
        j = j + 1
    end
end

func setupCluster()
    int i = 0
    while i < NODES
        regNode(i)
        i = i + 1
    end
    int a = 0
    while a < NODES
        int b = 0
        while b < NODES
            g_link.push(LINK_ON)
            b = b + 1
        end
        a = a + 1
    end
    int n = NODES * NODES
    int k = 0
    while k < n
        g_nextIndex.push(1)
        g_matchIndex.push(0)
        k = k + 1
    end
end

func randomizeDeadline(int id, float now)
    int ms = random.range(ELECTION_MIN_MS, ELECTION_MAX_MS)
    g_electDeadline[id] = now + float(ms) / 1000.0
end

// Step down to follower because a higher term was observed. CALLER HOLDS
// g_lock. Critically resets the election deadline: a node that was a leader
// has a stale deadline (leaders never refresh it), so without a reset it
// would immediately time out and start a spurious election that cascades
// (bumping the term cluster-wide and dethroning legitimate leaders).
func stepDown(int id, int newTerm)
    g_term[id] = newTerm
    g_state[id] = ST_FOLLOWER
    g_votedFor[id] = -1
    g_leaderId[id] = -1
    float now = time.timer()
    randomizeDeadline(id, now)
end

// ============================== inbox dispatch ============================

func encodeRpc(Rpc r) as string
    return f"{r.kind},{r.src},{r.dst},{r.term},{r.prevIdx},{r.prevTerm},{r.entriesLen},{r.entryTerm},{r.leaderCommit},{r.candidateId},{r.voteGranted},{r.success},{r.matchIdx}"
end

func decodeRpc(string wire) as Rpc
    array<string> fields = string.split(wire, ",")
    if fields.length != 13 then
        throw "invalid Raft RPC envelope"
    end
    Rpc r = Rpc()
    r.kind = int(fields[0])
    r.src = int(fields[1])
    r.dst = int(fields[2])
    r.term = int(fields[3])
    r.prevIdx = int(fields[4])
    r.prevTerm = int(fields[5])
    r.entriesLen = int(fields[6])
    r.entryTerm = int(fields[7])
    r.leaderCommit = int(fields[8])
    r.candidateId = int(fields[9])
    r.voteGranted = int(fields[10])
    r.success = int(fields[11])
    r.matchIdx = int(fields[12])
    return r
end

func inboxSend(int dst, Rpc rpc) as bool
    string wire = encodeRpc(rpc)
    if dst == 0 then return g_inbox0.send(wire) end
    if dst == 1 then return g_inbox1.send(wire) end
    if dst == 2 then return g_inbox2.send(wire) end
    if dst == 3 then return g_inbox3.send(wire) end
    if dst == 4 then return g_inbox4.send(wire) end
    return false
end

func inboxTryRecv(int dst) as (bool, string)
    string wire = ""
    bool ok = false
    if dst == 0 then
        ok = g_inbox0.tryRecvInto(wire)
    elseif dst == 1 then
        ok = g_inbox1.tryRecvInto(wire)
    elseif dst == 2 then
        ok = g_inbox2.tryRecvInto(wire)
    elseif dst == 3 then
        ok = g_inbox3.tryRecvInto(wire)
    elseif dst == 4 then
        ok = g_inbox4.tryRecvInto(wire)
    end
    return ok, wire
end

func canSend(int src, int dst) as bool
    if src == dst then return false end
    if g_link[src*NODES + dst] == LINK_OFF then return false end
    return true
end

func sendVoteReq(int src, int dst, int term, int candId, int lastLogIdx, int lastLogTerm)
    if not canSend(src, dst) then return end
    Rpc rpc = Rpc()
    rpc.kind = RPC_VOTE
    rpc.src = src
    rpc.dst = dst
    rpc.term = term
    rpc.candidateId = candId
    rpc.prevIdx = lastLogIdx
    rpc.prevTerm = lastLogTerm
    inboxSend(dst, rpc)
end

func sendVoteResp(int src, int dst, int term, int granted)
    if not canSend(src, dst) then return end
    Rpc rpc = Rpc()
    rpc.kind = RPC_VOTE_RESP
    rpc.src = src
    rpc.dst = dst
    rpc.term = term
    rpc.voteGranted = granted
    inboxSend(dst, rpc)
end

func sendAppendReq(int src, int dst, int term, int prevIdx, int prevTerm, int entriesLen, int entryTerm, int leaderCommit)
    if not canSend(src, dst) then return end
    Rpc rpc = Rpc()
    rpc.kind = RPC_APPEND
    rpc.src = src
    rpc.dst = dst
    rpc.term = term
    rpc.prevIdx = prevIdx
    rpc.prevTerm = prevTerm
    rpc.entriesLen = entriesLen
    rpc.entryTerm = entryTerm
    rpc.leaderCommit = leaderCommit
    inboxSend(dst, rpc)
end

func sendAppendResp(int src, int dst, int term, int success, int matchIdx)
    if not canSend(src, dst) then return end
    Rpc rpc = Rpc()
    rpc.kind = RPC_APPEND_RESP
    rpc.src = src
    rpc.dst = dst
    rpc.term = term
    rpc.success = success
    rpc.matchIdx = matchIdx
    inboxSend(dst, rpc)
end

// ============================== rpc dispatch ==============================

func processRpc(int id, Rpc rpc)
    if rpc.kind == RPC_VOTE then
        handleVoteReq(id, rpc)
    elseif rpc.kind == RPC_VOTE_RESP then
        handleVoteResp(id, rpc)
    elseif rpc.kind == RPC_APPEND then
        handleAppendReq(id, rpc)
    elseif rpc.kind == RPC_APPEND_RESP then
        handleAppendResp(id, rpc)
    end
end

// ---- RequestVote (receiver = id) -----------------------------------------
// Figure 2: Rules for Servers -> RequestVote RPC handler.
func handleVoteReq(int id, Rpc rpc)
    g_lock.lock()
    int reqTerm = rpc.term
    int candId = rpc.candidateId
    int lastLogIdx = rpc.prevIdx
    int lastLogTerm = rpc.prevTerm
    int myTerm = g_term[id]
    int grant = 0
    int respTerm = myTerm
    if reqTerm < myTerm then
        // Reply false: requester is stale.
        grant = 0
        respTerm = myTerm
    else
        if reqTerm > myTerm then
            // Step down to the newer term (refreshes election deadline).
            stepDown(id, reqTerm)
            myTerm = reqTerm
        end
        // Candidate log up-to-date? (lastLogTerm > mine, or tie & idx >= mine)
        int myLastIdx = g_logLen[id]
        int myLastTerm = 0
        if myLastIdx > 0 then myLastTerm = g_logTerm[id*MAX_LOG + myLastIdx] end
        bool upToDate = false
        if lastLogTerm > myLastTerm then
            upToDate = true
        elseif lastLogTerm == myLastTerm then
            if lastLogIdx >= myLastIdx then upToDate = true end
        end
        bool canVote = false
        if g_votedFor[id] == -1 then canVote = true end
        if g_votedFor[id] == candId then canVote = true end
        if canVote then
            if upToDate then
                g_votedFor[id] = candId
                grant = 1
                float now = time.timer()
                g_lastContact[id] = now
                randomizeDeadline(id, now)
            end
        end
        respTerm = myTerm
    end
    int dst = rpc.src
    g_lock.unlock()
    sendVoteResp(id, dst, respTerm, grant)
end

// ---- RequestVoteResponse (receiver = candidate id) -----------------------
// Figure 2: Rules for Servers -> Candidates.
func handleVoteResp(int id, Rpc rpc)
    g_lock.lock()
    int respTerm = rpc.term
    int grant = rpc.voteGranted
    int myTerm = g_term[id]
    if respTerm > myTerm then
        // Discovered higher term -> step down (refreshes election deadline).
        stepDown(id, respTerm)
        g_lock.unlock()
        return
    end
    if g_state[id] != ST_CANDIDATE then
        g_lock.unlock()
        return
    end
    if respTerm != myTerm then
        // Stale response from a different (older) term.
        g_lock.unlock()
        return
    end
    if grant == 1 then
        g_voteCount[id] = g_voteCount[id] + 1
        if g_voteCount[id] >= MAJORITY then
            becomeLeader(id)
        end
    end
    g_lock.unlock()
end

// Become leader. CALLER HOLDS g_lock.
func becomeLeader(int id)
    g_state[id] = ST_LEADER
    g_leaderId[id] = id
    int ll = g_logLen[id]
    int f = 0
    while f < NODES
        g_nextIndex[id*NODES + f] = ll + 1
        if f == id then
            g_matchIndex[id*NODES + f] = ll
        else
            g_matchIndex[id*NODES + f] = 0
        end
        f = f + 1
    end
    // Force an immediate heartbeat on the next loop tick.
    g_lastBeat[id] = 0.0
end

// ---- AppendEntries (receiver = id) ---------------------------------------
// Figure 2: AppendEntries RPC handler (handles heartbeats too).
func handleAppendReq(int id, Rpc rpc)
    g_lock.lock()
    int reqTerm = rpc.term
    int leaderId = rpc.src
    int prevIdx = rpc.prevIdx
    int prevTerm = rpc.prevTerm
    int entriesLen = rpc.entriesLen
    int entryTerm = rpc.entryTerm
    int leaderCommit = rpc.leaderCommit
    int myTerm = g_term[id]
    int success = 0
    int respMatchIdx = g_logLen[id]
    if reqTerm < myTerm then
        // Stale leader: reply false with our (higher) term.
        success = 0
        respMatchIdx = g_logLen[id]
    else
        if reqTerm > myTerm then
            stepDown(id, reqTerm)
            myTerm = reqTerm
        end
        // Recognize the leader and reset election timer.
        g_state[id] = ST_FOLLOWER
        g_leaderId[id] = leaderId
        float now = time.timer()
        g_lastContact[id] = now
        randomizeDeadline(id, now)
        // Log consistency check at prevIdx.
        bool consistent = true
        if prevIdx > 0 then
            if prevIdx > g_logLen[id] then
                consistent = false
            else
                if g_logTerm[id*MAX_LOG + prevIdx] != prevTerm then
                    consistent = false
                end
            end
        end
        if not consistent then
            success = 0
            respMatchIdx = g_logLen[id]
        else
            // Append the new entry (single-entry-per-message model).
            if entriesLen > 0 then
                int pos = prevIdx + 1
                if pos > g_logLen[id] then
                    // Extending the log.
                    g_logTerm[id*MAX_LOG + pos] = entryTerm
                    g_logLen[id] = pos
                else
                    // Position already present.
                    if g_logTerm[id*MAX_LOG + pos] == entryTerm then
                        // Identical entry already there: keep log as-is.
                    else
                        // Conflict: overwrite and truncate from here.
                        g_logTerm[id*MAX_LOG + pos] = entryTerm
                        g_logLen[id] = pos
                    end
                end
            end
            // Advance commitIndex from leaderCommit.
            if leaderCommit > g_commitIndex[id] then
                if leaderCommit <= g_logLen[id] then
                    g_commitIndex[id] = leaderCommit
                else
                    g_commitIndex[id] = g_logLen[id]
                end
            end
            success = 1
            respMatchIdx = g_logLen[id]
        end
    end
    int respTerm = myTerm
    int dst = leaderId
    g_lock.unlock()
    sendAppendResp(id, dst, respTerm, success, respMatchIdx)
end

// ---- AppendEntriesResponse (receiver = leader id) ------------------------
// Figure 2: Rules for Servers -> Leaders.
func handleAppendResp(int id, Rpc rpc)
    g_lock.lock()
    int respTerm = rpc.term
    int success = rpc.success
    int matchIdx = rpc.matchIdx
    int fromNode = rpc.src
    int myTerm = g_term[id]
    if respTerm > myTerm then
        stepDown(id, respTerm)
        g_lock.unlock()
        return
    end
    if g_state[id] != ST_LEADER then
        g_lock.unlock()
        return
    end
    if respTerm != myTerm then
        g_lock.unlock()
        return
    end
    if success == 1 then
        g_matchIndex[id*NODES + fromNode] = matchIdx
        g_nextIndex[id*NODES + fromNode] = matchIdx + 1
        advanceCommit(id)
    else
        // Decrement nextIndex; the next heartbeat retries with an earlier entry.
        int ni = g_nextIndex[id*NODES + fromNode]
        if ni > 1 then ni = ni - 1 end
        g_nextIndex[id*NODES + fromNode] = ni
    end
    g_lock.unlock()
end

// Advance commitIndex to the largest N replicated on a majority and whose
// term == currentTerm. CALLER HOLDS g_lock.
func advanceCommit(int leader)
    int ll = g_logLen[leader]
    int cur = g_commitIndex[leader]
    int lt = g_term[leader]
    int N = ll
    while N > cur
        // Only entries from the current term are committed by counting
        // matches (Raft Figure 2 / Section 5.4.2 leader-commit rule).
        if g_logTerm[leader*MAX_LOG + N] != lt then
            N = N - 1
        else
            int cnt = 0
            int f = 0
            while f < NODES
                if g_matchIndex[leader*NODES + f] >= N then cnt = cnt + 1 end
                f = f + 1
            end
            if cnt >= MAJORITY then
                g_commitIndex[leader] = N
                return
            end
            N = N - 1
        end
    end
end

// ============================== leader heartbeat ==========================

// Leader broadcasts AppendEntries to every reachable follower. Picks up a
// pending client submit (if targeted at this leader) first.
func leaderHeartbeat(int leader)
    g_lock.lock()
    int lt = g_term[leader]
    int ll = g_logLen[leader]
    int ci = g_commitIndex[leader]
    if g_submitPending == 1 then
        if g_submitTarget == leader then
            ll = ll + 1
            g_logLen[leader] = ll
            g_logTerm[leader*MAX_LOG + ll] = lt
            g_matchIndex[leader*NODES + leader] = ll
            g_submitPending = 0
            g_submitDone = 1
        end
    end
    // Snapshot per-follower nextIndex under lock (handleAppendResp writes them).
    int ni0 = g_nextIndex[leader*NODES + 0]
    int ni1 = g_nextIndex[leader*NODES + 1]
    int ni2 = g_nextIndex[leader*NODES + 2]
    int ni3 = g_nextIndex[leader*NODES + 3]
    int ni4 = g_nextIndex[leader*NODES + 4]
    g_lock.unlock()
    int f = 0
    while f < NODES
        if f != leader then
            if g_link[leader*NODES + f] == LINK_ON then
                int ni = ni0
                if f == 1 then ni = ni1 end
                if f == 2 then ni = ni2 end
                if f == 3 then ni = ni3 end
                if f == 4 then ni = ni4 end
                int prevIdx = ni - 1
                int prevTerm = 0
                if prevIdx > 0 then prevTerm = g_logTerm[leader*MAX_LOG + prevIdx] end
                int entriesLen = 0
                int entryTerm = 0
                if ni <= ll then
                    entriesLen = 1
                    entryTerm = g_logTerm[leader*MAX_LOG + ni]
                end
                sendAppendReq(leader, f, lt, prevIdx, prevTerm, entriesLen, entryTerm, ci)
            end
        end
        f = f + 1
    end
end

// ============================== election trigger ==========================

// Candidate transitions: increment term, vote self, broadcast RequestVote.
func startElection(int id)
    g_lock.lock()
    g_state[id] = ST_CANDIDATE
    g_term[id] = g_term[id] + 1
    int myTerm = g_term[id]
    g_votedFor[id] = id
    g_voteCount[id] = 1
    g_leaderId[id] = -1
    int lastLogIdx = g_logLen[id]
    int lastLogTerm = 0
    if lastLogIdx > 0 then lastLogTerm = g_logTerm[id*MAX_LOG + lastLogIdx] end
    float now = time.timer()
    randomizeDeadline(id, now)
    if g_voteCount[id] >= MAJORITY then
        becomeLeader(id)
        g_lock.unlock()
        return
    end
    g_lock.unlock()
    int f = 0
    while f < NODES
        if f != id then
            sendVoteReq(id, f, myTerm, id, lastLogIdx, lastLogTerm)
        end
        f = f + 1
    end
end

// ============================== node body =================================

func nodeLoop(int id) as int
    g_lock.lock()
    float now = time.timer()
    g_lastContact[id] = now
    randomizeDeadline(id, now)
    g_lock.unlock()
    while g_running == 1
        // 1. Drain inbox (non-blocking poll).
        bool draining = true
        while draining
            bool ok = false
            string wire = ""
            ok, wire = inboxTryRecv(id)
            if ok then
                processRpc(id, decodeRpc(wire))
            else
                draining = false
            end
        end
        // 2. Periodic state machine work.
        float tnow = time.timer()
        g_lock.lock()
        int st = g_state[id]
        bool needBeat = false
        bool needElection = false
        if st == ST_LEADER then
            if tnow - g_lastBeat[id] >= HEARTBEAT_INTERVAL then
                needBeat = true
                g_lastBeat[id] = tnow
            end
        else
            if tnow >= g_electDeadline[id] then
                needElection = true
            end
        end
        g_lock.unlock()
        if needBeat then
            leaderHeartbeat(id)
        end
        if needElection then
            startElection(id)
        end
        time.sleep(2)
    end
    return 0
end

func makeNodeBody(int id) as func() as int
    return func() as int
        return nodeLoop(id)
    end
end

func spawnAll()
    int i = 0
    while i < NODES
        thread(makeNodeBody(i))
        i = i + 1
    end
end

// ============================== partition control =========================

func setLink(int a, int b, int on)
    g_lock.lock()
    g_link[a*NODES + b] = on
    g_link[b*NODES + a] = on
    g_lock.unlock()
end

func partitionNode(int n)
    int f = 0
    while f < NODES
        if f != n then
            setLink(n, f, LINK_OFF)
        end
        f = f + 1
    end
    println("  [partition] isolated node", n)
end

func healAll()
    g_lock.lock()
    int a = 0
    while a < NODES
        int b = 0
        while b < NODES
            g_link[a*NODES + b] = LINK_ON
            b = b + 1
        end
        a = a + 1
    end
    g_lock.unlock()
    println("  [heal] all links restored")
end

// ============================== test helpers ==============================

// Current leader with the highest term (or -1).
func findLeader() as int
    g_lock.lock()
    int best = -1
    int bestTerm = -1
    int i = 0
    while i < NODES
        if g_state[i] == ST_LEADER then
            if g_term[i] > bestTerm then
                bestTerm = g_term[i]
                best = i
            end
        end
        i = i + 1
    end
    g_lock.unlock()
    return best
end

// Leader with highest term among nodes excluding `excluded` (or -1).
func leaderAmongExcept(int excluded) as int
    g_lock.lock()
    int best = -1
    int bestTerm = -1
    int i = 0
    while i < NODES
        if i != excluded then
            if g_state[i] == ST_LEADER then
                if g_term[i] > bestTerm then
                    bestTerm = g_term[i]
                    best = i
                end
            end
        end
        i = i + 1
    end
    g_lock.unlock()
    return best
end

func countLeaders() as int
    g_lock.lock()
    int count = 0
    int i = 0
    while i < NODES
        if g_state[i] == ST_LEADER then count = count + 1 end
        i = i + 1
    end
    g_lock.unlock()
    return count
end

func nodeState(int id) as int
    g_lock.lock()
    int st = g_state[id]
    g_lock.unlock()
    return st
end

func nodeLogLen(int id) as int
    g_lock.lock()
    int v = g_logLen[id]
    g_lock.unlock()
    return v
end

func countWithLogLen(int targetLen) as int
    g_lock.lock()
    int cnt = 0
    int i = 0
    while i < NODES
        if g_logLen[i] >= targetLen then cnt = cnt + 1 end
        i = i + 1
    end
    g_lock.unlock()
    return cnt
end

// Count nodes (excluding `excluded`) whose logLen >= targetLen.
func countWithLogLenExcept(int targetLen, int excluded) as int
    g_lock.lock()
    int cnt = 0
    int i = 0
    while i < NODES
        if i != excluded then
            if g_logLen[i] >= targetLen then cnt = cnt + 1 end
        end
        i = i + 1
    end
    g_lock.unlock()
    return cnt
end

// Verify all nodes agree on log terms for positions 1..len.
func verifyLogTerms(int len) as bool
    g_lock.lock()
    int i = 1
    while i < NODES
        int p = 1
        while p <= len
            if g_logTerm[i*MAX_LOG + p] != g_logTerm[0*MAX_LOG + p] then
                g_lock.unlock()
                return false
            end
            p = p + 1
        end
        i = i + 1
    end
    g_lock.unlock()
    return true
end

func leaderCommitIndex(int leader) as int
    g_lock.lock()
    int v = g_commitIndex[leader]
    g_lock.unlock()
    return v
end

// Wait for a single stable leader (no competing candidate storms).
func waitForLeader(int timeoutMs) as int
    int waited = 0
    while waited < timeoutMs
        int leader = findLeader()
        if leader >= 0 then
            time.sleep(150)
            int leader2 = findLeader()
            if leader2 == leader then return leader end
        end
        time.sleep(20)
        waited = waited + 170
    end
    return -1
end

// Submit a value to a specific leader; wait until the leader appends it.
func submitValue(int targetLeader, int timeoutMs) as bool
    g_lock.lock()
    g_submitDone = 0
    g_submitTarget = targetLeader
    g_submitPending = 1
    g_lock.unlock()
    int waited = 0
    while waited < timeoutMs
        g_lock.lock()
        int done = g_submitDone
        g_lock.unlock()
        if done == 1 then return true end
        time.sleep(5)
        waited = waited + 5
    end
    return false
end

func check(string name, bool ok)
    if ok then
        println("  [PASS] " + name)
        g_pass = g_pass + 1
    else
        println("  [FAIL] " + name)
        g_fail = g_fail + 1
    end
end

func stateName(int st) as string
    if st == ST_FOLLOWER then return "Follower" end
    if st == ST_CANDIDATE then return "Candidate" end
    if st == ST_LEADER then return "Leader" end
    return "?"
end

func printState(string label)
    g_lock.lock()
    println("  [" + label + "]")
    int i = 0
    while i < NODES
        println("    node", i,
                " term=" + string(g_term[i]),
                " state=" + stateName(g_state[i]),
                " logLen=" + string(g_logLen[i]),
                " commit=" + string(g_commitIndex[i]),
                " votedFor=" + string(g_votedFor[i]),
                " leader=" + string(g_leaderId[i]))
        i = i + 1
    end
    g_lock.unlock()
end

// ============================== tests =====================================

func runTests() as int
    println("==== raftsim test start ====")
    println("cluster:", NODES, "nodes | majority:", MAJORITY,
            "| election timeout", string(ELECTION_MIN_MS) + "-" + string(ELECTION_MAX_MS) + "ms",
            "| heartbeat", string(int(HEARTBEAT_INTERVAL * 1000.0)) + "ms")
    println("------------------------------------------------")

    // ---- TEST 1: initial leader election --------------------------------
    println("[test 1] initial leader election")
    int leader1 = waitForLeader(3000)
    check("exactly one leader elected", leader1 >= 0)
    if leader1 >= 0 then
        check("no competing leaders (single leader)", countLeaders() == 1)
        check("leader term advanced (> 0)", true)
        println("  -> leader =", leader1)
        printState("after initial election")
    end

    // ---- TEST 2: log replication - submit 3 entries ---------------------
    println("[test 2] log replication: submit 3 entries to leader")
    int target1 = leader1
    if target1 < 0 then target1 = findLeader() end
    bool s1 = submitValue(target1, 1500)
    check("entry 1 accepted by leader", s1)
    bool s2 = submitValue(target1, 1500)
    check("entry 2 accepted by leader", s2)
    bool s3 = submitValue(target1, 1500)
    check("entry 3 accepted by leader", s3)
    // Give the leader time to replicate via heartbeats.
    time.sleep(500)
    int repl3 = countWithLogLen(3)
    check("log replicated to majority (>= 3 nodes)", repl3 >= MAJORITY)
    check("log replicated to ALL 5 nodes", repl3 == NODES)
    check("leader commitIndex reached 3", leaderCommitIndex(target1) >= 3)
    printState("after replication of 3 entries")

    // ---- TEST 3: network partition - isolate the current leader ---------
    println("[test 3] network partition: isolate current leader")
    int leaderBefore = findLeader()
    check("leader exists before partition", leaderBefore >= 0)
    if leaderBefore >= 0 then
        partitionNode(leaderBefore)
    end

    // ---- TEST 4: majority side elects a new leader ----------------------
    println("[test 4] majority partition elects a NEW leader")
    int newLeader = -1
    int w4 = 0
    while w4 < 4000
        newLeader = leaderAmongExcept(leaderBefore)
        if newLeader >= 0 then break end
        time.sleep(50)
        w4 = w4 + 50
    end
    check("new leader elected in the majority partition", newLeader >= 0)
    bool diffLeader = false
    if newLeader >= 0 then
        if newLeader != leaderBefore then diffLeader = true end
    end
    check("new leader differs from the isolated old leader", diffLeader)
    if newLeader >= 0 then
        println("  -> new leader =", newLeader, "(old isolated leader =", leaderBefore, ")")
    end

    // ---- TEST 5: replication continues on the majority side -------------
    println("[test 5] log replication under partition (majority side)")
    bool sp = false
    if newLeader >= 0 then
        sp = submitValue(newLeader, 2000)
    end
    check("entry 4 accepted by the new leader", sp)
    time.sleep(700)
    int replMajority = countWithLogLenExcept(4, leaderBefore)
    check("majority side replicated entry 4 (>= 3 nodes)", replMajority >= MAJORITY)
    int isolatedLen = 0
    if leaderBefore >= 0 then isolatedLen = nodeLogLen(leaderBefore) end
    check("isolated old leader did NOT receive entry 4", isolatedLen < 4)
    printState("under partition")

    // ---- TEST 6: heal partition; old leader must step down --------------
    println("[test 6] heal partition + stale leader steps down")
    healAll()
    // Old leader's stale-term AppendEntries get rejected by the newer-term
    // followers; it observes the higher term and reverts to follower.
    bool steppedDown = false
    int w6 = 0
    while w6 < 3000
        if leaderBefore >= 0 then
            if nodeState(leaderBefore) != ST_LEADER then
                steppedDown = true
                break
            end
        end
        time.sleep(50)
        w6 = w6 + 50
    end
    check("isolated old leader stepped down to follower", steppedDown)
    int leaderAfter = findLeader()
    check("a leader still exists after heal", leaderAfter >= 0)
    bool singleLeaderAfter = countLeaders() == 1
    check("back to a single leader (no split brain)", singleLeaderAfter)

    // ---- TEST 7: full consistency restored ------------------------------
    println("[test 7] full replication restored after heal")
    int targetFinal = findLeader()
    bool sh = false
    if targetFinal >= 0 then
        sh = submitValue(targetFinal, 2000)
    end
    check("entry 5 accepted after heal", sh)
    time.sleep(800)
    int replFinal = countWithLogLen(5)
    check("ALL 5 nodes replicated entry 5", replFinal == NODES)
    bool termsMatch = verifyLogTerms(5)
    check("all nodes have identical log terms (Raft consistency)", termsMatch)
    printState("final state")

    println("------------------------------------------------")
    println("==== raftsim summary ====")
    println("passed:", g_pass, " failed:", g_fail)
    if g_fail == 0 then
        println("RESULT: OK - Raft consensus simulation completed successfully")
        return 0
    end
    println("RESULT: FAIL -", g_fail, "check(s) failed")
    return 1
end

// ============================== shutdown ==================================

func shutdown()
    g_lock.lock()
    g_running = 0
    g_lock.unlock()
    // Let node threads observe g_running==0 and exit their loops.
    time.sleep(400)
end

// ============================== usage / main ==============================

func printUsage()
    println("raftsim - Raft consensus algorithm simulator (5-node cluster)")
    println("Usage:")
    println("  raftsim test    Run the full Raft simulation")
    println("    phases: initial election -> log replication -> partition")
    println("            -> re-election -> recovery -> consistency check")
    println("Features:")
    println("  - Leader election (RequestVote), randomized election timeouts")
    println("  - Log replication (AppendEntries) + heartbeats")
    println("  - Network partition (link matrix) + recovery + stale-leader step-down")
end

// ============================== module-level setup =======================
// Populate all global state arrays before main spawns any thread. Arrays are
// only mutated in place afterwards (never re-bound) - see.

setupCluster()

// ============================== entry point ===============================

func main(...) as int
    if arg.length < 2 then
        printUsage()
        return 1
    end

    string cmd = string(arg[1])
    if cmd != "test" then
        println("Error: unknown command '" + cmd + "'")
        printUsage()
        return 1
    end

    spawnAll()
    // Give threads a moment to initialize their election deadlines.
    time.sleep(50)
    int rc = runTests()
    shutdown()
    return rc
end
