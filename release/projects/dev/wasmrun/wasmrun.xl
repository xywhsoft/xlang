    if not parseBuiltModule(m, "T6") then
        return false
    end
    bool ok = check("sumTo(10) == 55", invokeExport1("sumTo", 10) == 55)
    ok = check("sumTo(100) == 5050", invokeExport1("sumTo", 100) == 5050) and ok
    ok = check("sumTo(0) == 0", invokeExport1("sumTo", 0) == 0) and ok
    ok = check("sumTo(1) == 1", invokeExport1("sumTo", 1) == 1) and ok
    return ok
end

func testIfElse() as bool
