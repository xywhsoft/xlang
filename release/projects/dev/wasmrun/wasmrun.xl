func testBitOps() as bool
    println("[T11] i32.and / or / xor / shl / shr_s")
    var types = [[[VT_I32, VT_I32], [VT_I32]]]
    var funcTypes = [0, 0, 0, 0, 0]
    var exports = [["andAB", 0, 0], ["orAB", 0, 1], ["xorAB", 0, 2], ["shlA", 0, 3], ["shrA", 0, 4]]
    var codes = []
    var iAnd = []
    emitLocalGet(iAnd, 0)
    emitLocalGet(iAnd, 1)
    emitOp(iAnd, 0x71)
    emitEnd(iAnd)
    var iOr = []
    emitLocalGet(iOr, 0)
    emitLocalGet(iOr, 1)
    emitOp(iOr, 0x72)
    emitEnd(iOr)
    var iXor = []
    emitLocalGet(iXor, 0)
    emitLocalGet(iXor, 1)
    emitOp(iXor, 0x73)
    emitEnd(iXor)
    var iShl = []
    emitLocalGet(iShl, 0)
    emitConst(iShl, 4)
    emitOp(iShl, 0x74)
    emitEnd(iShl)
    var iShr = []
    emitLocalGet(iShr, 0)
    emitConst(iShr, 2)
    emitOp(iShr, 0x75)
    emitEnd(iShr)
    codes.push([[], iAnd])
    codes.push([[], iOr])
    codes.push([[], iXor])
    codes.push([[], iShl])
    codes.push([[], iShr])
    var m = buildModule(types, funcTypes, exports, [], codes)
    if not parseBuiltModule(m, "T11") then
        return false
    end
    bool ok = check("0xF0 & 0x3C == 0x30", invokeExport2("andAB", 0xF0, 0x3C) == 0x30)
    ok = check("0xF0 | 0x0F == 0xFF", invokeExport2("orAB", 0xF0, 0x0F) == 0xFF) and ok
    ok = check("0xFF ^ 0x0F == 0xF0", invokeExport2("xorAB", 0xFF, 0x0F) == 0xF0) and ok
    ok = check("1 << 4 == 16", invokeExport2("shlA", 1, 0) == 16) and ok
    ok = check("64 >> 2 == 16", invokeExport2("shrA", 64, 0) == 16) and ok
    ok = check("-16 >> 2 == -4 (arithmetic)", invokeExport2("shrA", -16, 0) == -4) and ok
    return ok
end

func testDivRem() as bool
    println("[T12] i32.div_s / i32.rem_s")
    var types = [[[VT_I32, VT_I32], [VT_I32]]]
    var funcTypes = [0, 0]
    var exports = [["div_s", 0, 0], ["rem_s", 0, 1]]
    var iDiv = []
    emitLocalGet(iDiv, 0)
    emitLocalGet(iDiv, 1)
    emitOp(iDiv, 0x6d)
    emitEnd(iDiv)
    var iRem = []
    emitLocalGet(iRem, 0)
    emitLocalGet(iRem, 1)
    emitOp(iRem, 0x6f)
    emitEnd(iRem)
    var codes = [[[], iDiv], [[], iRem]]
    var m = buildModule(types, funcTypes, exports, [], codes)
    if not parseBuiltModule(m, "T12") then
        return false
    end
    bool ok = check("20 / 6 == 3", invokeExport2("div_s", 20, 6) == 3)
    ok = check("20 % 6 == 2", invokeExport2("rem_s", 20, 6) == 2) and ok
    ok = check("-20 / 6 == -3 (trunc toward 0)", invokeExport2("div_s", -20, 6) == -3) and ok
    ok = check("-20 % 6 == -2", invokeExport2("rem_s", -20, 6) == -2) and ok
    ok = check("20 / -6 == -3", invokeExport2("div_s", 20, -6) == -3) and ok
    return ok
end

