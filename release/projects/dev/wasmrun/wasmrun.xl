func testCall() as bool
    println("[T5] call")
    var types = [[[VT_I32, VT_I32], [VT_I32]], [[], [VT_I32]]]
    var funcTypes = [0, 1]
    var exports = [["main", 0, 1], ["add", 0, 0]]
    var addBody = []
    emitLocalGet(addBody, 0)
    emitLocalGet(addBody, 1)
    emitOp(addBody, 0x6a)
    emitEnd(addBody)
    var mainBody = []
    emitConst(mainBody, 15)
    emitConst(mainBody, 27)
    emitCall(mainBody, 0)
    emitEnd(mainBody)
    var codes = [[[], addBody], [[], mainBody]]
    var m = buildModule(types, funcTypes, exports, [], codes)
    if not parseBuiltModule(m, "T5") then
        return false
    end
    bool ok = check("add(15,27) == 42", invokeExport2("add", 15, 27) == 42)
    ok = check("main() == 42 (calls add)", invokeExport0("main") == 42) and ok
    return ok
end

func testLoop() as bool
    println("[T6] block / loop / br / br_if (iterative sum)")
    var types = [[[VT_I32], [VT_I32]]]
    var funcTypes = [0]
    var exports = [["sumTo", 0, 0]]
    var b = []
    emitBlock(b, 0x40)
    emitLoop(b, 0x40)
    emitLocalGet(b, 1)
    emitConst(b, 1)
    emitOp(b, 0x6a)
    emitLocalTee(b, 1)
    emitLocalGet(b, 0)
    emitOp(b, 0x4a)
    emitBrIf(b, 1)
    emitLocalGet(b, 2)
    emitLocalGet(b, 1)
    emitOp(b, 0x6a)
    emitLocalSet(b, 2)
    emitBr(b, 0)
    emitEnd(b)
    emitEnd(b)
    emitLocalGet(b, 2)
    emitEnd(b)
    var localTypes = [VT_I32, VT_I32]
