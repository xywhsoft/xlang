func testTrap() as bool
    println("[T14] trap on div_s by zero")
    var types = [[[VT_I32, VT_I32], [VT_I32]]]
    var funcTypes = [0]
    var exports = [["div_s", 0, 0]]
    var b = []
    emitLocalGet(b, 0)
    emitLocalGet(b, 1)
    emitOp(b, 0x6d)
    emitEnd(b)
    var codes = [[[], b]]
    var m = buildModule(types, funcTypes, exports, [], codes)
    if not parseBuiltModule(m, "T14") then
        return false
    end
    bool trapped = false
    try
        invokeExport2("div_s", 1, 0)
    catch e
        trapped = true
    end
    return check("div by zero traps", trapped)
end

func testFactorial() as bool
    println("[T15] factorial (loop + mul)")
    var types = [[[VT_I32], [VT_I32]]]
    var funcTypes = [0]
    var exports = [["fact", 0, 0]]
    var b = []
    emitConst(b, 1)
    emitLocalSet(b, 1)
    emitConst(b, 1)
    emitLocalSet(b, 2)
    emitBlock(b, 0x40)
    emitLoop(b, 0x40)
    emitLocalGet(b, 2)
    emitConst(b, 1)
    emitOp(b, 0x6a)
    emitLocalTee(b, 2)
    emitLocalGet(b, 0)
    emitOp(b, 0x4a)
    emitBrIf(b, 1)
    emitLocalGet(b, 1)
    emitLocalGet(b, 2)
    emitOp(b, 0x6c)
    emitLocalSet(b, 1)
    emitBr(b, 0)
    emitEnd(b)
    emitEnd(b)
    emitLocalGet(b, 1)
    emitEnd(b)
    var localTypes = [VT_I32, VT_I32]
    var codes = [[localTypes, b]]
    var m = buildModule(types, funcTypes, exports, [], codes)
    if not parseBuiltModule(m, "T15") then
        return false
    end
    bool ok = check("fact(1) == 1", invokeExport1("fact", 1) == 1)
    ok = check("fact(5) == 120", invokeExport1("fact", 5) == 120) and ok
    ok = check("fact(7) == 5040", invokeExport1("fact", 7) == 5040) and ok
    ok = check("fact(10) == 3628800", invokeExport1("fact", 10) == 3628800) and ok
    return ok
end

func testNestedIf() as bool
    println("[T16] nested if / sign classifier")
    var types = [[[VT_I32], [VT_I32]]]
    var funcTypes = [0]
    var exports = [["sign", 0, 0]]
    var b = []
    emitLocalGet(b, 0)
    emitConst(b, 0)
    emitOp(b, 0x48)         // lt_s
    emitIf(b, VT_I32)
    emitConst(b, -1)
    emitElse(b)
    emitLocalGet(b, 0)
    emitConst(b, 0)
    emitOp(b, 0x4a)         // gt_s
    emitIf(b, VT_I32)
    emitConst(b, 1)
    emitElse(b)
    emitConst(b, 0)
    emitEnd(b)
    emitEnd(b)
    emitEnd(b)
    var codes = [[[], b]]
    var m = buildModule(types, funcTypes, exports, [], codes)
    if not parseBuiltModule(m, "T16") then
        return false
    end
    bool ok = check("sign(-7) == -1", invokeExport1("sign", -7) == -1)
    ok = check("sign(0) == 0", invokeExport1("sign", 0) == 0) and ok
    ok = check("sign(42) == 1", invokeExport1("sign", 42) == 1) and ok
    return ok
end

func testDisasm() as bool
    println("[T17] disasm module state")
    var types = [[[], [VT_I32]]]
    var funcTypes = [0]
    var exports = [["main", 0, 0]]
    var instrs = []
    emitConst(instrs, 10)
    emitConst(instrs, 20)
    emitOp(instrs, 0x6a)
    emitConst(instrs, 3)
    emitOp(instrs, 0x6c)
    emitEnd(instrs)
    var codes = [[[], instrs]]
    var m = buildModule(types, funcTypes, exports, [], codes)
    if not parseBuiltModule(m, "T17") then
        return false
    end
    bool ok = check("module valid for disasm", gMod.valid)
    ok = check("1 function parsed", gMod.funcTypeIdx.length == 1) and ok
    ok = check("1 export parsed", gMod.exportNames.length == 1) and ok
    ok = check("export name is 'main'", gMod.exportNames[0] == "main") and ok
    return ok
end

func runAllTests() as int
    println("=== wasmrun built-in tests ===")
    bool allOk = true
    allOk = testConst()      and allOk
    allOk = testArith()      and allOk
    allOk = testCompare()    and allOk
    allOk = testLocals()     and allOk
    allOk = testLocalTee()   and allOk
    allOk = testCall()       and allOk
    allOk = testLoop()       and allOk
    allOk = testIfElse()     and allOk
    allOk = testRecurse()    and allOk
    allOk = testStackOps()   and allOk
    allOk = testGlobals()    and allOk
    allOk = testBitOps()     and allOk
    allOk = testDivRem()     and allOk
    allOk = testEqz()        and allOk
    allOk = testTrap()       and allOk
    allOk = testFactorial()  and allOk
    allOk = testNestedIf()   and allOk
    allOk = testDisasm()     and allOk
    println("===")
    if allOk then
        println("ALL TESTS PASSED")
        return 0
    end
    println("SOME TESTS FAILED")
    return 1
end


// ============================== CLI ==============================

func printUsage()
    println("wasmrun - WebAssembly i32 subset interpreter")
    println("")
    println("usage:")
    println("  wasmrun run <file.wasm>              execute _start or main export")
    println("  wasmrun disasm <file.wasm>           disassemble code section")
    println("  wasmrun test                         run built-in test suite")
    println("  wasmrun -h | --help                  this help")
end

func cmdRun(string path) as int
    if not file.exists(path) then
        println("wasmrun: file not found: " + path)
        return 1
    end
    Buffer buf = file.readBytes(path)
    if buf.len() == 0 then
        println("wasmrun: empty file: " + path)
        return 1
    end
    array<int> bs = bufferToBytes(buf)
    resetModule()
    if not parseModule(bs) then
        println("wasmrun: parse error: " + gMod.error)
        return 1
    end
    int fidx = findExportAny("_start")
    if fidx < 0 then
        fidx = findExportAny("main")
    end
    if fidx < 0 then
        println("wasmrun: no _start or main export found")
        println("available exports:")
        int i = 0
        while i < gMod.exportNames.length
            println("  " + gMod.exportNames[i])
            i += 1
        end
        return 1
    end
    int rv = 0
    try
        array<int> args = array[]
        rv = invoke(fidx, args)
    catch e
        println("wasmrun: trap: " + e.message)
        return 1
    end
    println("wasmrun: " + path + " returned " + string(rv))
    return rv
end

func cmdDisasm(string path) as int
    if not file.exists(path) then
        println("wasmrun: file not found: " + path)
        return 1
    end
    Buffer buf = file.readBytes(path)
    if buf.len() == 0 then
        println("wasmrun: empty file: " + path)
        return 1
    end
    array<int> bs = bufferToBytes(buf)
    resetModule()
    if not parseModule(bs) then
        println("wasmrun: parse error: " + gMod.error)
        return 1
    end
    println("; " + path + " (" + string(bs.length) + " bytes)")
    return disasmModule()
end

func main(...) as int
    if arg.length < 2 then
        printUsage()
        return 1
    end

    string cmd = string(arg[1])

    if cmd == "-h" or cmd == "--help" or cmd == "help" then
        printUsage()
        return 0
    end

    if cmd == "test" then
        return runAllTests()
    end

    if cmd == "run" then
        if arg.length < 3 then
            println("wasmrun: 'run' needs <file.wasm>")
            return 1
        end
        return cmdRun(string(arg[2]))
    end

    if cmd == "disasm" then
        if arg.length < 3 then
            println("wasmrun: 'disasm' needs <file.wasm>")
            return 1
        end
        return cmdDisasm(string(arg[2]))
    end

    println("wasmrun: unknown command: " + cmd)
    printUsage()
    return 1
end
