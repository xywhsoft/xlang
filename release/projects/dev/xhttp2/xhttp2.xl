// xhttp2.xl - HTTP/2 binary protocol engine (frame codec + HPACK + streams + flow control)
//
// usage:
//   xhttp2 encode-headers <json>      HPACK-encode a JSON header set -> hex string
//   xhttp2 decode-frames <bin>        decode all HTTP/2 frames in a binary file
//   xhttp2 test                       built-in self-test suite
//   xhttp2 -h | --help                show this help
//
// <json> example:
//   {":method":"GET",":scheme":"https",":path":"/",":authority":"example.com","user-agent":"xlang/1.0"}
//
// ---------------------------------------------------------------------------
// Implements HTTP/2 binary protocol subset (RFC 9113 / RFC 7541):
//
//   1. Frame codec (9-byte header: 24-bit length + 8-bit type + 8-bit flags
//      + 1-bit reserved + 31-bit stream ID).
//      Frame types: DATA / HEADERS / PRIORITY / RST_STREAM / SETTINGS /
//      PUSH_PROMISE / PING / GOAWAY / WINDOW_UPDATE / CONTINUATION.
//
//   2. Stream state machine: idle -> open -> half-closed(local|remote) -> closed.
//      Tracks END_STREAM transitions, RST_STREAM, and WINDOW_UPDATE.
//
//   3. HPACK header compression (RFC 7541):
//      - Static table (61 entries, Appendix A)
//      - Dynamic table (LRU eviction, configurable max size)
//      - Integer encoding (Section 5.1, prefix-bit variable length)
//      - String literal encoding (no Huffman; H=0 literal mode)
//      - Indexed / literal-without-indexing / literal-with-incremental-indexing /
//        never-indexed representations (Sections 6.1 - 6.2.3)
//
//   4. Flow control: per-stream and per-connection WINDOW_UPDATE accounting.
//      DATA frames consume credit; WINDOW_UPDATE replenishes.
//
//   5. Server push simulation: PUSH_PROMISE frame construction + push-stream
//      lifecycle (even-numbered stream IDs).
//
//   6. Multiplexing: multiple streams interleaved on one connection; a
//      Connection class manages stream lifecycle and frame dispatch.
//
// ---------------------------------------------------------------------------
// Implementation / API coverage (see dev/README.md constraints):
//   * file.readBytes(path) -> Buffer            binary frame file read
//   * Buffer: len() / byteAt(i) / appendByte(v) / append(str) / text() / data()
//   * Bitwise: & | ^ << >> with 0xFF / 0x7F / 0xFFFF masking (frame header packing)
//   * codec.hexEncodeBytes / hexDecodeBytes     hex <-> binary
//   * json.parse / json.stringify               header set JSON I/O
//   * string.bytes / int.format                 byte extraction / hex formatting
//   * class (Frame / Header / HpackEncoder / HpackDecoder / Stream / Connection)
//   * Multi-return values + destructuring (auto a, b = f())
//   * Native-backed-class rule: Buffer always passed as borrowed param, never
//     returned from user functions; all binary output is via append-to-out.
// ---------------------------------------------------------------------------

// ============================== Frame types ==============================

const int FT_DATA          = 0x0   // 0x00
const int FT_HEADERS       = 0x1   // 0x01
const int FT_PRIORITY      = 0x2   // 0x02
const int FT_RST_STREAM    = 0x3   // 0x03
const int FT_SETTINGS      = 0x4   // 0x04
const int FT_PUSH_PROMISE  = 0x5   // 0x05
const int FT_PING          = 0x6   // 0x06
const int FT_GOAWAY        = 0x7   // 0x07
const int FT_WINDOW_UPDATE = 0x8   // 0x08
const int FT_CONTINUATION  = 0x9   // 0x09

// ============================== Frame flags ==============================

const int FH_END_STREAM  = 0x01   // DATA, HEADERS
const int FH_ACK         = 0x01   // SETTINGS, PING
const int FH_END_HEADERS = 0x04   // HEADERS, PUSH_PROMISE, CONTINUATION
const int FH_PADDED      = 0x08   // DATA, HEADERS
const int FH_PRIORITY    = 0x20   // HEADERS

// ============================== Error codes ==============================

const int ERR_NO_ERROR              = 0x0
const int ERR_PROTOCOL_ERROR         = 0x1
const int ERR_INTERNAL_ERROR         = 0x2
const int ERR_FLOW_CONTROL_ERROR     = 0x3
const int ERR_SETTINGS_TIMEOUT       = 0x4
const int ERR_STREAM_CLOSED          = 0x5
const int ERR_FRAME_SIZE_ERROR       = 0x6
const int ERR_REFUSED_STREAM         = 0x7
const int ERR_CANCEL                 = 0x8
const int ERR_COMPRESSION_ERROR      = 0x9
const int ERR_CONNECT_ERROR          = 0xA
const int ERR_ENHANCE_YOUR_CALM      = 0xB
const int ERR_INADEQUATE_SECURITY    = 0xC
const int ERR_HTTP_1_1_REQUIRED      = 0xD

// ============================== Settings IDs ==============================

const int SET_HEADER_TABLE_SIZE      = 0x1
const int SET_ENABLE_PUSH            = 0x2
const int SET_MAX_CONCURRENT_STREAMS = 0x3
const int SET_INITIAL_WINDOW_SIZE    = 0x4
const int SET_MAX_FRAME_SIZE         = 0x5
const int SET_MAX_HEADER_LIST_SIZE   = 0x6

// ============================== Stream states ==============================

const int ST_IDLE               = 0
const int ST_RESERVED_LOCAL     = 1
const int ST_RESERVED_REMOTE    = 2
const int ST_OPEN               = 3
const int ST_HALF_CLOSED_LOCAL  = 4
const int ST_HALF_CLOSED_REMOTE = 5
const int ST_CLOSED             = 6

// ============================== Defaults ==============================

const int DEFAULT_WINDOW          = 65535
const int DEFAULT_MAX_FRAME       = 16384
const int MAX_FRAME_LIMIT         = 16777215
const int DEFAULT_HEADER_TABLE    = 4096
const int FRAME_HEADER_LEN        = 9
const int PREFACE_LEN             = 24

const string H2_CLIENT_PREFACE = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

const int STATIC_TABLE_SIZE = 62   // index 0 unused + 61 entries


// ============================== Byte read helpers ==============================
// All multi-byte fields in HTTP/2 are big-endian (network byte order).

func rdU16BE(Buffer buf, int off) as int
    return ((buf.byteAt(off) & 0xFF) << 8) | (buf.byteAt(off + 1) & 0xFF)
end

func rdU24BE(Buffer buf, int off) as int
    return (((buf.byteAt(off) & 0xFF) << 16)
         | ((buf.byteAt(off + 1) & 0xFF) << 8)
         | (buf.byteAt(off + 2) & 0xFF))
end

func rdU31BE(Buffer buf, int off) as int
    // 31-bit: top bit of first byte is reserved (R), mask it off
    return (((buf.byteAt(off) & 0x7F) << 24)
         | ((buf.byteAt(off + 1) & 0xFF) << 16)
         | ((buf.byteAt(off + 2) & 0xFF) << 8)
         | (buf.byteAt(off + 3) & 0xFF))
end

func rdU32BE(Buffer buf, int off) as int
    return (((buf.byteAt(off) & 0xFF) << 24)
         | ((buf.byteAt(off + 1) & 0xFF) << 16)
         | ((buf.byteAt(off + 2) & 0xFF) << 8)
         | (buf.byteAt(off + 3) & 0xFF))
end

func rdU64BE(Buffer buf, int off) as int64
    int64 v = 0
    int i = 0
    while i < 8
        v = (v << 8) | int64(buf.byteAt(off + i) & 0xFF)
        i += 1
    end
    return v
end

// ============================== Byte write helpers ==============================
// Append big-endian integers into a Buffer (borrowed out param, native-backed rule).

func putBe16(Buffer outputValue, int v)
    outputValue.appendByte((v >> 8) & 0xFF)
    outputValue.appendByte(v & 0xFF)
end

func putBe24(Buffer outputValue, int v)
    outputValue.appendByte((v >> 16) & 0xFF)
    outputValue.appendByte((v >> 8) & 0xFF)
    outputValue.appendByte(v & 0xFF)
end

func putBe31(Buffer outputValue, int v)
    // 31-bit value: high bit of first byte is reserved (always 0)
    outputValue.appendByte((v >> 24) & 0x7F)
    outputValue.appendByte((v >> 16) & 0xFF)
    outputValue.appendByte((v >> 8) & 0xFF)
    outputValue.appendByte(v & 0xFF)
end

func putBe32(Buffer outputValue, int v)
    outputValue.appendByte((v >> 24) & 0xFF)
    outputValue.appendByte((v >> 16) & 0xFF)
    outputValue.appendByte((v >> 8) & 0xFF)
    outputValue.appendByte(v & 0xFF)
end

func putBe64(Buffer outputValue, int64 v)
    int i = 7
    while i >= 0
        outputValue.appendByte(int((v >> (i * 8)) & 0xFF))
        i -= 1
    end
end

func putText(Buffer outputValue, string s)
    array bs = string.bytes(s)
    int i = 0
    while i < bs.length
        outputValue.appendByte(int(bs[i]) & 0xFF)
        i += 1
    end
end

func putBuffer(Buffer src, Buffer dst, int len)
    int i = 0
    while i < len
        dst.appendByte(src.byteAt(i))
        i += 1
    end
end


// ============================== Hex / formatting helpers ==============================

func hexByte(int b) as string
    return int.format(b & 0xFF, "x2")
end

func bufHex(Buffer buf) as string
    return codec.hexEncodeBytes(buf.data(), c_size(buf.len()))
end

func bytesToStr(Buffer buf, int off, int len) as string
    if len <= 0 then
        return ""
    end
    Buffer t = Buffer()
    int i = 0
    while i < len
        if off + i >= buf.len() then
            break
        end
        t.appendByte(buf.byteAt(off + i))
        i += 1
    end
    return t.text()
end

func hexPreview(Buffer buf, int off, int len, int maxBytes) as string
    int n = len
    if n > maxBytes then
        n = maxBytes
    end
    string s = ""
    int i = 0
    while i < n
        if i > 0 then
            s = s + " "
        end
        s = s + hexByte(buf.byteAt(off + i))
        i += 1
    end
    if len > maxBytes then
        s = s + " ... (" + string(len) + " bytes total)"
    end
    return s
end

func frameTypeName(int t) as string
    if t == FT_DATA          then return "DATA" end
    if t == FT_HEADERS       then return "HEADERS" end
    if t == FT_PRIORITY      then return "PRIORITY" end
    if t == FT_RST_STREAM    then return "RST_STREAM" end
    if t == FT_SETTINGS      then return "SETTINGS" end
    if t == FT_PUSH_PROMISE  then return "PUSH_PROMISE" end
    if t == FT_PING          then return "PING" end
    if t == FT_GOAWAY        then return "GOAWAY" end
    if t == FT_WINDOW_UPDATE then return "WINDOW_UPDATE" end
    if t == FT_CONTINUATION  then return "CONTINUATION" end
    return "UNKNOWN(" + string(t) + ")"
end

func flagString(int frameType, int flags) as string
    string s = ""
    if frameType == FT_DATA or frameType == FT_HEADERS then
        if (flags & FH_END_STREAM) != 0 then s = s + "END_STREAM," end
    end
    if frameType == FT_HEADERS or frameType == FT_PUSH_PROMISE or frameType == FT_CONTINUATION then
        if (flags & FH_END_HEADERS) != 0 then s = s + "END_HEADERS," end
    end
    if frameType == FT_SETTINGS or frameType == FT_PING then
        if (flags & FH_ACK) != 0 then s = s + "ACK," end
    end
    if frameType == FT_DATA or frameType == FT_HEADERS then
        if (flags & FH_PADDED) != 0 then s = s + "PADDED," end
    end
    if frameType == FT_HEADERS then
        if (flags & FH_PRIORITY) != 0 then s = s + "PRIORITY," end
    end
    if string.len(s) > 0 then
        s = string.slice(s, 0, string.len(s) - 1)
    else
        s = "none"
    end
    return s
end

func settingName(int id) as string
    if id == SET_HEADER_TABLE_SIZE      then return "HEADER_TABLE_SIZE" end
    if id == SET_ENABLE_PUSH            then return "ENABLE_PUSH" end
    if id == SET_MAX_CONCURRENT_STREAMS then return "MAX_CONCURRENT_STREAMS" end
    if id == SET_INITIAL_WINDOW_SIZE    then return "INITIAL_WINDOW_SIZE" end
    if id == SET_MAX_FRAME_SIZE         then return "MAX_FRAME_SIZE" end
    if id == SET_MAX_HEADER_LIST_SIZE   then return "MAX_HEADER_LIST_SIZE" end
    return "UNKNOWN(" + string(id) + ")"
end

func errorName(int code) as string
    if code == ERR_NO_ERROR            then return "NO_ERROR" end
    if code == ERR_PROTOCOL_ERROR      then return "PROTOCOL_ERROR" end
    if code == ERR_INTERNAL_ERROR      then return "INTERNAL_ERROR" end
    if code == ERR_FLOW_CONTROL_ERROR  then return "FLOW_CONTROL_ERROR" end
    if code == ERR_SETTINGS_TIMEOUT    then return "SETTINGS_TIMEOUT" end
    if code == ERR_STREAM_CLOSED       then return "STREAM_CLOSED" end
    if code == ERR_FRAME_SIZE_ERROR    then return "FRAME_SIZE_ERROR" end
    if code == ERR_REFUSED_STREAM      then return "REFUSED_STREAM" end
    if code == ERR_CANCEL              then return "CANCEL" end
    if code == ERR_COMPRESSION_ERROR   then return "COMPRESSION_ERROR" end
    if code == ERR_CONNECT_ERROR       then return "CONNECT_ERROR" end
    if code == ERR_ENHANCE_YOUR_CALM   then return "ENHANCE_YOUR_CALM" end
    if code == ERR_INADEQUATE_SECURITY then return "INADEQUATE_SECURITY" end
    if code == ERR_HTTP_1_1_REQUIRED   then return "HTTP_1_1_REQUIRED" end
    return "UNKNOWN(" + string(code) + ")"
end

func stateName(int st) as string
    if st == ST_IDLE               then return "idle" end
    if st == ST_RESERVED_LOCAL     then return "reserved(local)" end
    if st == ST_RESERVED_REMOTE    then return "reserved(remote)" end
    if st == ST_OPEN               then return "open" end
    if st == ST_HALF_CLOSED_LOCAL  then return "half-closed(local)" end
    if st == ST_HALF_CLOSED_REMOTE then return "half-closed(remote)" end
    if st == ST_CLOSED             then return "closed" end
    return "unknown"
end


// ============================== Frame class ==============================

class Frame
    int length = 0
    int frameType = 0
    int flags = 0
    int streamId = 0
    int payloadOffset = 0
    bool valid = true
    string error = ""

    // parse a frame header from buf at offset; returns next offset or -1
    func parse(Buffer buf, int offset) as int
        int total = buf.len()
        if offset + FRAME_HEADER_LEN > total then
            self.valid = false
            self.error = "incomplete frame header (need " + string(FRAME_HEADER_LEN) + " bytes at offset " + string(offset) + ")"
            return -1
        end
        self.length = rdU24BE(buf, offset)
        self.frameType = buf.byteAt(offset + 3) & 0xFF
        self.flags = buf.byteAt(offset + 4) & 0xFF
        self.streamId = rdU31BE(buf, offset + 5)
        self.payloadOffset = offset + FRAME_HEADER_LEN
        self.valid = true
        self.error = ""
        if self.payloadOffset + self.length > total then
            self.valid = false
            self.error = "incomplete payload (declared " + string(self.length) + " bytes, only " + string(total - self.payloadOffset) + " available)"
            return -1
        end
        return self.payloadOffset + self.length
    end
end


// ============================== Frame header encode ==============================
// Write the 9-byte frame header into borrowed Buffer `out`.

func appendFrameHeader(Buffer outputValue, int length, int ftype, int flags, int streamId)
    putBe24(outputValue, length)
    outputValue.appendByte(ftype & 0xFF)
    outputValue.appendByte(flags & 0xFF)
    putBe31(outputValue, streamId)
end

// Write a complete frame: header + payload bytes from borrowed `payload` Buffer.

func appendFrame(Buffer outputValue, int ftype, int flags, int streamId, Buffer payload)
    int n = payload.len()
    appendFrameHeader(outputValue, n, ftype, flags, streamId)
    int i = 0
    while i < n
        outputValue.appendByte(payload.byteAt(i))
        i += 1
    end
end

// Write a DATA frame (type=0x00).

func appendDataFrame(Buffer outputValue, int streamId, int flags, Buffer data)
    appendFrame(outputValue, FT_DATA, flags, streamId, data)
end

// Write a SETTINGS frame (type=0x04) from a flat [id0,val0, id1,val1, ...] array.

func appendSettingsFrame(Buffer outputValue, int flags, array<int> settings)
    int nPairs = settings.length / 2
    int payloadLen = nPairs * 6
    appendFrameHeader(outputValue, payloadLen, FT_SETTINGS, flags, 0)
    int i = 0
    while i < nPairs
        int sid = settings[i * 2]
        int sval = settings[i * 2 + 1]
        putBe16(outputValue, sid)
        putBe32(outputValue, sval)
        i += 1
    end
end

// Write a SETTINGS ACK frame (empty payload, ACK flag).

func appendSettingsAck(Buffer outputValue)
    appendFrameHeader(outputValue, 0, FT_SETTINGS, FH_ACK, 0)
end

// Write a PING frame (type=0x06) with 8 bytes of opaque data.

func appendPingFrame(Buffer outputValue, int flags, int64 opaqueData)
    appendFrameHeader(outputValue, 8, FT_PING, flags, 0)
    putBe64(outputValue, opaqueData)
end

// Write a PING ACK frame.

func appendPingAck(Buffer outputValue, int64 opaqueData)
    appendPingFrame(outputValue, FH_ACK, opaqueData)
end

// Write a GOAWAY frame (type=0x07).

func appendGoawayFrame(Buffer outputValue, int lastStreamId, int errorCode, string debugData)
    int debugLen = string.len(debugData)
    appendFrameHeader(outputValue, 8 + debugLen, FT_GOAWAY, 0, 0)
    putBe31(outputValue, lastStreamId)
    putBe32(outputValue, errorCode)
    if debugLen > 0 then
        putText(outputValue, debugData)
    end
end

// Write a WINDOW_UPDATE frame (type=0x08).

func appendWindowUpdateFrame(Buffer outputValue, int streamId, int increment)
    appendFrameHeader(outputValue, 4, FT_WINDOW_UPDATE, 0, streamId)
    putBe31(outputValue, increment)
end

// Write a RST_STREAM frame (type=0x03).

func appendRstStreamFrame(Buffer outputValue, int streamId, int errorCode)
    appendFrameHeader(outputValue, 4, FT_RST_STREAM, 0, streamId)
    putBe32(outputValue, errorCode)
end

// Write a PRIORITY frame (type=0x02): 5 bytes payload.
//   1-bit exclusive + 31-bit dependency + 8-bit weight

func appendPriorityFrame(Buffer outputValue, int streamId, bool exclusive, int dependency, int weight)
    appendFrameHeader(outputValue, 5, FT_PRIORITY, 0, streamId)
    int depWord = dependency & 0x7FFFFFFF
    if exclusive then
        depWord = depWord | 0x80000000
    end
    putBe32(outputValue, depWord)
    outputValue.appendByte(weight & 0xFF)
end


// ============================== Frame header decode ==============================
// ============================== Frame pretty-print ==============================
// Decode and print a single frame including type-specific payload fields.

func printFrame(Buffer buf, Frame f, int frameOffset)
    println("  [" + string(frameOffset) + "] " + frameTypeName(f.frameType)
         + "  len=" + string(f.length)
         + "  flags=0x" + int.format(f.flags, "x2")
         + " (" + flagString(f.frameType, f.flags) + ")"
         + "  stream=" + string(f.streamId))

    if f.frameType == FT_SETTINGS then
        if (f.flags & FH_ACK) == 0 and f.length >= 6 then
            int off = f.payloadOffset
            int count = f.length / 6
            int i = 0
            while i < count
                int sid = rdU16BE(buf, off + i * 6)
                int sval = rdU32BE(buf, off + i * 6 + 2)
                println("        setting: " + settingName(sid) + " (" + string(sid) + ") = " + string(sval))
                i += 1
            end
        elseif (f.flags & FH_ACK) != 0 then
            println("        (SETTINGS ACK)")
        end
    elseif f.frameType == FT_WINDOW_UPDATE and f.length >= 4 then
        int inc = rdU31BE(buf, f.payloadOffset)
        println("        window size increment: " + string(inc))
    elseif f.frameType == FT_PING and f.length >= 8 then
        int64 data = rdU64BE(buf, f.payloadOffset)
        string ackStr = ""
        if (f.flags & FH_ACK) != 0 then
            ackStr = " (ACK)"
        end
        println("        opaque data: 0x" + int.format(int((data >> 32) & 0xFFFFFFFF), "x8")
            + int.format(int(data & 0xFFFFFFFF), "x8") + ackStr)
    elseif f.frameType == FT_GOAWAY and f.length >= 8 then
        int lastSid = rdU31BE(buf, f.payloadOffset)
        int ec = rdU32BE(buf, f.payloadOffset + 4)
        int dbgLen = f.length - 8
        string dbg = bytesToStr(buf, f.payloadOffset + 8, dbgLen)
        println("        last-stream-id: " + string(lastSid)
             + "  error: " + errorName(ec) + " (" + string(ec) + ")")
        if dbgLen > 0 then
            println("        debug: " + dbg)
        end
    elseif f.frameType == FT_RST_STREAM and f.length >= 4 then
        int ec = rdU32BE(buf, f.payloadOffset)
        println("        error code: " + errorName(ec) + " (" + string(ec) + ")")
    elseif f.frameType == FT_PRIORITY and f.length >= 5 then
        int depWord = rdU32BE(buf, f.payloadOffset)
        bool excl = (depWord & 0x80000000) != 0
        int dep = depWord & 0x7FFFFFFF
        int weight = buf.byteAt(f.payloadOffset + 4) & 0xFF
        println("        exclusive: " + string(excl)
             + "  dependency: " + string(dep)
             + "  weight: " + string(weight))
    elseif f.frameType == FT_PUSH_PROMISE and f.length >= 4 then
        int promised = rdU31BE(buf, f.payloadOffset)
        println("        promised stream: " + string(promised))
    end

    if f.length > 0 then
        string prev = hexPreview(buf, f.payloadOffset, f.length, 24)
        println("        payload: " + prev)
    end
end


// ============================== HPACK static table ==============================
// RFC 7541 Appendix A: 61 entries. Index 0 is unused (HPACK indices are 1-based).
// gStaticNames[0] and gStaticValues[0] are placeholders.

array<string> gStaticNames = array[
