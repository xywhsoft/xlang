    "",                    // 47 max-forwards
    "",                    // 48 proxy-authenticate
    "",                    // 49 proxy-authorization
    "",                    // 50 range
    "",                    // 51 referer
    "",                    // 52 refresh
    "",                    // 53 retry-after
    "",                    // 54 server
    "",                    // 55 set-cookie
    "",                    // 56 strict-transport-security
    "",                    // 57 transfer-encoding
    "",                    // 58 user-agent
    "",                    // 59 vary
    "",                    // 60 via
    ""                     // 61 www-authenticate
]

func staticCount() as int
    return gStaticNames.length
end

func findStaticExact(string name, string value) as int
    int i = 1
    int n = gStaticNames.length
    while i < n
        if gStaticNames[i] == name and gStaticValues[i] == value then
            return i
        end
        i += 1
    end
    return 0
end

func findStaticName(string name) as int
    int i = 1
    int n = gStaticNames.length
    while i < n
        if gStaticNames[i] == name then
            return i
        end
        i += 1
    end
    return 0
end


// ============================== HPACK integer codec ==============================
// RFC 7541 Section 5.1: encode an integer within an n-bit prefix.
// `prefixFlags` holds the bits ABOVE the prefix (e.g. 0x80 for indexed, 0x40
// for literal-with-indexing, 0x00 for literal-without-indexing).

func hpackEncInt(Buffer outputValue, int value, int prefixBits, int prefixFlags)
    int maxVal = (1 << prefixBits) - 1
    if value < maxVal then
        outputValue.appendByte((prefixFlags | value) & 0xFF)
    else
        outputValue.appendByte((prefixFlags | maxVal) & 0xFF)
        value = value - maxVal
        while value >= 128
            outputValue.appendByte(((value & 0x7F) | 0x80) & 0xFF)
            value = value >> 7
        end
        outputValue.appendByte(value & 0xFF)
    end
end

// Decode an HPACK integer from Buffer at `offset` using an n-bit prefix.
// Returns (value, nextOffset).

func hpackDecInt(Buffer buf, int offset, int prefixBits) as (int, int)
    int mask = (1 << prefixBits) - 1
    int I = buf.byteAt(offset) & mask
    int pos = offset + 1
    if I < mask then
        return I, pos
    end
    int m = 0
    int n = buf.len()
    while pos < n
        int b = buf.byteAt(pos)
        pos += 1
        I = I + ((b & 0x7F) << m)
        m += 7
        if (b & 0x80) == 0 then
            return I, pos
        end
        if m >= 28 then
            return I, pos
        end
    end
    return I, pos
end


// ============================== HPACK string codec ==============================
// RFC 7541 Section 5.2: 1-bit Huffman flag + 7-bit length prefix + octets.
// We use literal mode (H=0, no Huffman). The decoder handles H=1 gracefully
// by returning the raw bytes (not Huffman-decoded), which is valid for our
// own roundtrip since the encoder always uses H=0.

func hpackEncStr(Buffer outputValue, string s)
    array bs = string.bytes(s)
    int n = bs.length
    hpackEncInt(outputValue, n, 7, 0x00)
    int i = 0
    while i < n
        outputValue.appendByte(int(bs[i]) & 0xFF)
        i += 1
    end
end

func hpackDecStr(Buffer buf, int offset) as (string, int)
    auto len, pos = hpackDecInt(buf, offset, 7)
    bool huffman = (buf.byteAt(offset) & 0x80) != 0
    Buffer sb = Buffer()
    int i = 0
    while i < len
        if pos + i >= buf.len() then
            break
        end
        sb.appendByte(buf.byteAt(pos + i))
        i += 1
    end
    string result = sb.text()
    if huffman then
        result = result + " [huffman-not-decoded]"
    end
    return result, pos + len
end


// ============================== Header class ==============================

class Header
    derive value
    string name = ""
    string value = ""

    create(string n, string v)
        self.name = n
        self.value = v
    end

    func display() as string
        return self.name + ": " + self.value
    end
end


// ============================== HpackEncoder ==============================
// Encodes header lists into an HPACK byte block. Uses indexed representation
// for exact static/dynamic table matches, literal-without-indexing otherwise.
// Set useIndexing=true to use literal-with-incremental-indexing (populates
// the dynamic table for subsequent matches).

class HpackEncoder
    array<Header> dynamicTable = array[]
    int maxSize = DEFAULT_HEADER_TABLE
    int curSize = 0
    bool useIndexing = false

    func entrySize(string name, string value) as int
        return string.len(name) + string.len(value) + 32
    end

    func findDynamicExact(string name, string value) as int
        int i = 0
        int n = dynamicTable.length
        while i < n
            if dynamicTable[i].name == name and dynamicTable[i].value == value then
                return STATIC_TABLE_SIZE + i
            end
            i += 1
        end
        return 0
    end

    func findDynamicName(string name) as int
        int i = 0
        int n = dynamicTable.length
        while i < n
            if dynamicTable[i].name == name then
                return STATIC_TABLE_SIZE + i
            end
            i += 1
        end
        return 0
    end

    func addToDynamic(string name, string value)
        int entrySz = self.entrySize(name, value)
        while curSize + entrySz > maxSize and dynamicTable.length > 0
            Header old = dynamicTable[dynamicTable.length - 1]
            self.curSize -= self.entrySize(old.name, old.value)
            dynamicTable.remove(dynamicTable.length - 1)
        end
        if entrySz > maxSize then
            dynamicTable.clear()
            self.curSize = 0
            return
        end
        Header h = Header(name, value)
        dynamicTable.insert(0, h)
        self.curSize += entrySz
    end

    func encodeOne(Buffer outputValue, string name, string value)
        int idx = findStaticExact(name, value)
        if idx > 0 then
            hpackEncInt(outputValue, idx, 7, 0x80)
            return
        end
        idx = self.findDynamicExact(name, value)
        if idx > 0 then
            hpackEncInt(outputValue, idx, 7, 0x80)
            return
        end
        int nameIdx = findStaticName(name)
        if nameIdx == 0 then
            nameIdx = self.findDynamicName(name)
        end
        if useIndexing then
            if nameIdx > 0 then
                hpackEncInt(outputValue, nameIdx, 6, 0x40)
            else
                hpackEncInt(outputValue, 0, 6, 0x40)
                hpackEncStr(outputValue, name)
            end
            hpackEncStr(outputValue, value)
            self.addToDynamic(name, value)
        else
            if nameIdx > 0 then
                hpackEncInt(outputValue, nameIdx, 4, 0x00)
            else
                hpackEncInt(outputValue, 0, 4, 0x00)
                hpackEncStr(outputValue, name)
            end
            hpackEncStr(outputValue, value)
        end
    end
end

// Encode a JSON header dict into an HPACK block appended to `out`.
// `headers` is a var dict from json.parse: {"name":"value", ...}.

func encodeHeadersBlock(HpackEncoder enc, Buffer outputValue, var headers)
    for k, v in headers
        enc.encodeOne(outputValue, string(k), string(v))
    end
end


// ============================== HpackDecoder ==============================
// Decodes an HPACK byte block into an array<Header>. Handles all four
// representations (indexed, literal-with-incremental, literal-without,
// never-indexed) and maintains a dynamic table.

class HpackDecoder
    array<Header> dynamicTable = array[]
    int maxSize = DEFAULT_HEADER_TABLE
    int curSize = 0
    bool hasError = false
    string errorMsg = ""

    func entrySize(string name, string value) as int
        return string.len(name) + string.len(value) + 32
    end

    func getIndexed(int idx) as Header
        if idx > 0 and idx < gStaticNames.length then
            return Header(gStaticNames[idx], gStaticValues[idx])
        end
        if idx >= gStaticNames.length then
            int di = idx - gStaticNames.length
            if di >= 0 and di < dynamicTable.length then
                Header h = dynamicTable[di]
                return Header(h.name, h.value)
            end
        end
        self.hasError = true
        self.errorMsg = "invalid header table index " + string(idx)
        return Header("", "")
    end

    func addToDynamic(string name, string value)
        int entrySz = self.entrySize(name, value)
        while curSize + entrySz > maxSize and dynamicTable.length > 0
            Header old = dynamicTable[dynamicTable.length - 1]
            self.curSize -= self.entrySize(old.name, old.value)
            dynamicTable.remove(dynamicTable.length - 1)
        end
        if entrySz > maxSize then
            dynamicTable.clear()
            self.curSize = 0
            return
        end
        Header h = Header(name, value)
        dynamicTable.insert(0, h)
        self.curSize += entrySz
    end

    // Decode a header block from Buffer at [start, start+len).
    func decodeBlock(Buffer buf, int start, int len) as array<Header>
        array<Header> result = array[]
        self.hasError = false
        self.errorMsg = ""
        int pos = start
        int blockEnd = start + len
        while pos < blockEnd
            int b = buf.byteAt(pos)
            if (b & 0x80) != 0 then
                // Indexed Header Field Representation (Section 6.1)
                auto idx, next = hpackDecInt(buf, pos, 7)
                pos = next
                if idx == 0 then
                    self.hasError = true
                    self.errorMsg = "indexed: index 0 is invalid"
                    break
                end
                Header h = self.getIndexed(idx)
                if hasError then break end
                result.append(Header(h.name, h.value))
            elseif (b & 0xC0) == 0x40 then
                // Literal with Incremental Indexing (Section 6.2.1)
                auto idx, next = hpackDecInt(buf, pos, 6)
                pos = next
                string name = ""
                if idx > 0 then
                    Header hn = self.getIndexed(idx)
                    if hasError then break end
                    name = hn.name
                else
                    auto s, sp = hpackDecStr(buf, pos)
                    name = s
                    pos = sp
                end
                auto val, vp = hpackDecStr(buf, pos)
                pos = vp
                self.addToDynamic(name, val)
                result.append(Header(name, val))
            elseif (b & 0xF0) == 0x00 then
                // Literal without Indexing (Section 6.2.2)
                auto idx, next = hpackDecInt(buf, pos, 4)
                pos = next
                string name = ""
                if idx > 0 then
                    Header hn = self.getIndexed(idx)
                    if hasError then break end
                    name = hn.name
                else
                    auto s, sp = hpackDecStr(buf, pos)
                    name = s
                    pos = sp
                end
                auto val, vp = hpackDecStr(buf, pos)
                pos = vp
                result.append(Header(name, val))
            elseif (b & 0xF0) == 0x10 then
                // Literal Never Indexed (Section 6.2.3)
                auto idx, next = hpackDecInt(buf, pos, 4)
                pos = next
                string name = ""
                if idx > 0 then
                    Header hn = self.getIndexed(idx)
                    if hasError then break end
                    name = hn.name
                else
                    auto s, sp = hpackDecStr(buf, pos)
                    name = s
                    pos = sp
                end
                auto val, vp = hpackDecStr(buf, pos)
                pos = vp
                result.append(Header(name, val))
            else
                self.hasError = true
                self.errorMsg = "unknown HPACK representation byte 0x" + int.format(b, "x2")
                break
            end
        end
        return result
    end
end

// Convenience: build an HPACK HEADERS frame from a JSON header dict.
// Appends the complete frame (header + HPACK payload) to `out`.

func appendHeadersFrame(Buffer outputValue, int streamId, int flags, var headers)
    Buffer hp = Buffer()
    HpackEncoder enc = HpackEncoder()
    encodeHeadersBlock(enc, hp, headers)
    int payloadLen = hp.len()
    appendFrameHeader(outputValue, payloadLen, FT_HEADERS, flags, streamId)
    int i = 0
    while i < payloadLen
        outputValue.appendByte(hp.byteAt(i))
        i += 1
    end
end


// ============================== Stream state machine ==============================
// Tracks per-stream lifecycle: idle -> open -> half-closed -> closed.
// Also holds per-stream flow-control windows.

class Stream
    derive value
    int id = 0
    int state = ST_IDLE
    int sendWindow = DEFAULT_WINDOW
    int recvWindow = DEFAULT_WINDOW
    bool localClosed = false
    bool remoteClosed = false
    bool rstSent = false
    bool rstReceived = false
    string dataBuffer = ""
    array<Header> headerList = array[]

    create(int sid)
        self.id = sid
    end

    func updateState()
        if rstSent or rstReceived then
            self.state = ST_CLOSED
            return
        end
        if state == ST_IDLE then
            self.state = ST_OPEN
        end
        if localClosed and remoteClosed then
            self.state = ST_CLOSED
        elseif localClosed and state == ST_OPEN then
            self.state = ST_HALF_CLOSED_LOCAL
        elseif remoteClosed and state == ST_OPEN then
            self.state = ST_HALF_CLOSED_REMOTE
        elseif localClosed and state == ST_HALF_CLOSED_REMOTE then
            self.state = ST_CLOSED
        elseif remoteClosed and state == ST_HALF_CLOSED_LOCAL then
            self.state = ST_CLOSED
        end
    end

    func onSendHeaders(bool endStream) as bool
        if state == ST_CLOSED or state == ST_HALF_CLOSED_LOCAL then
            return false
        end
        if state == ST_IDLE then
            self.state = ST_OPEN
        end
        if endStream then
            self.localClosed = true
            self.updateState()
        end
        return true
    end

    func onRecvHeaders(bool endStream) as bool
        if state == ST_CLOSED then
            return false
        end
        if state == ST_IDLE then
            self.state = ST_OPEN
        end
        if endStream then
            self.remoteClosed = true
            self.updateState()
        end
        return true
    end

    func onSendData(int len, bool endStream) as bool
        if state == ST_CLOSED or state == ST_HALF_CLOSED_LOCAL then
            return false
        end
        if sendWindow < len then
            return false
        end
        self.sendWindow -= len
        if endStream then
            self.localClosed = true
            self.updateState()
        end
        return true
    end

    func onRecvData(int len, bool endStream) as bool
        if state == ST_CLOSED then
            return false
        end
        self.recvWindow -= len
        if endStream then
            self.remoteClosed = true
            self.updateState()
        end
        return true
    end

    func onRstStream()
        self.rstSent = true
        self.state = ST_CLOSED
    end

    func onRstReceived()
        self.rstReceived = true
        self.state = ST_CLOSED
    end

    func onSendWindowUpdate(int inc)
        self.recvWindow += inc
    end

    func onRecvWindowUpdate(int inc)
        self.sendWindow += inc
    end

    func isOpen() as bool
        return state == ST_OPEN or state == ST_HALF_CLOSED_LOCAL or state == ST_HALF_CLOSED_REMOTE
    end

    func isClosed() as bool
        return state == ST_CLOSED
    end

    func stateStr() as string
        return stateName(state)
    end
end


// ============================== Connection (multiplexing) ==============================
// Manages multiple streams on a single HTTP/2 connection. Handles stream
// creation, interleave dispatch, and connection-level flow control.

class Connection
    array<Stream> streams = array[]
    int nextClientStreamId = 1    // client-initiated: odd
    int nextPushStreamId = 2      // server-push: even
    int connSendWindow = DEFAULT_WINDOW
    int connRecvWindow = DEFAULT_WINDOW
    int maxFrameSize = DEFAULT_MAX_FRAME
    int maxConcurrentStreams = 100
    int headerTableSize = DEFAULT_HEADER_TABLE
    bool enablePush = true
    bool isServer = false

    func newStream() as Stream
        Stream s = Stream(nextClientStreamId)
        self.nextClientStreamId += 2
        streams.append(s)
        return s
    end

    func newPushStream() as Stream
        Stream s = Stream(nextPushStreamId)
        self.nextPushStreamId += 2
        streams.append(s)
        return s
    end

    func findStreamIndex(int id) as int
        int i = 0
        int n = streams.length
        while i < n
            if streams[i].id == id then
                return i
            end
            i += 1
        end
        return -1
    end

    func getStream(int id) as Stream
        int idx = self.findStreamIndex(id)
        if idx >= 0 then
            return streams[idx]
        end
        Stream dummy = Stream(0)
        dummy.state = ST_CLOSED
        return dummy
    end

    func streamCount() as int
        return streams.length
    end

    // set a stream's state by id (value-semantics write-back helper)
    func setStreamState(int id, int st) as bool
        int idx = self.findStreamIndex(id)
        if idx < 0 then
            return false
        end
        self.streams[idx].state = st
        return true
    end

    func activeStreamCount() as int
        int count = 0
        int i = 0
        while i < streams.length
            Stream si = streams[i]
            if not si.isClosed() then
                count += 1
            end
            i += 1
        end
        return count
    end

    func canSendData(int streamId, int len) as bool
        int idx = self.findStreamIndex(streamId)
        if idx < 0 then
            return false
        end
        Stream s = streams[idx]
        if s.sendWindow < len then
            return false
        end
        if connSendWindow < len then
            return false
        end
        return true
    end

    func consumeSendCredit(int streamId, int len) as bool
        int idx = self.findStreamIndex(streamId)
        if idx < 0 then
            return false
        end
        if self.streams[idx].sendWindow < len or self.connSendWindow < len then
            return false
        end
        self.streams[idx].sendWindow -= len
        self.connSendWindow -= len
        return true
    end

    func replenishSendCredit(int streamId, int inc) as bool
        int idx = self.findStreamIndex(streamId)
        if idx < 0 then
            return false
        end
        Stream s = self.streams[idx]
        s.onRecvWindowUpdate(inc)
        self.streams[idx] = s
        return true
    end

    func replenishConnSendCredit(int inc)
        self.connSendWindow += inc
    end

    func consumeConnRecvCredit(int len) as bool
        if connRecvWindow < len then
            return false
        end
        self.connRecvWindow -= len
        return true
    end

    func applySettings(int initialWindowSize, int maxFrame, int maxStreams, int hdrTable, bool push)
        // Adjust per-stream send windows by the delta in INITIAL_WINDOW_SIZE
        int delta = initialWindowSize - DEFAULT_WINDOW
        int i = 0
        while i < streams.length
            self.streams[i].sendWindow += delta
            i += 1
        end
        self.maxFrameSize = maxFrame
        self.maxConcurrentStreams = maxStreams
        self.headerTableSize = hdrTable
        self.enablePush = push
    end
end


// ============================== Server push simulation ==============================
// Simulates a server push: sends PUSH_PROMISE on the parent stream, then
// sends a pushed response on the promised (even-numbered) stream.
// All frames are appended to `out`.

func simulateServerPush(Buffer outputValue, Connection conn, int parentStreamId,
                        int promisedStreamId, var requestHeaders,
                        var pushPromiseHeaders, var pushResponseHeaders,
                        string pushResponseData) as (int, Connection)
    // 1. Verify the parent stream exists and is open
    int pidx = conn.findStreamIndex(parentStreamId)
    if pidx < 0 then
        return ERR_STREAM_CLOSED, conn
    end
    Stream parent = conn.streams[pidx]
    if not parent.isOpen() then
        return ERR_STREAM_CLOSED, conn
    end
    if not conn.enablePush then
        return ERR_REFUSED_STREAM, conn
    end

    // 2. Send PUSH_PROMISE on the parent stream
    //    Payload: 31-bit promised stream ID + HPACK header block fragment
    Buffer hp = Buffer()
    HpackEncoder enc = HpackEncoder()
    encodeHeadersBlock(enc, hp, pushPromiseHeaders)
    int hpLen = hp.len()
    appendFrameHeader(outputValue, 4 + hpLen, FT_PUSH_PROMISE, FH_END_HEADERS, parentStreamId)
    putBe31(outputValue, promisedStreamId)
    int i = 0
    while i < hpLen
        outputValue.appendByte(hp.byteAt(i))
        i += 1
    end

    // 3. Create and open the push stream (reserved -> half-closed-remote)
    Stream pushStream = conn.newPushStream()
    int pushIdx = conn.streamCount() - 1
    pushStream.state = ST_HALF_CLOSED_REMOTE
    pushStream.remoteClosed = true

    // 4. Send pushed response HEADERS on the push stream
    appendHeadersFrame(outputValue, promisedStreamId, FH_END_HEADERS, pushResponseHeaders)
    pushStream.onSendHeaders(false)

    // 5. Send pushed response DATA on the push stream
    Buffer dataPayload = Buffer()
    dataPayload.append(pushResponseData)
    int dataLen = dataPayload.len()
    if dataLen > 0 then
        pushStream.onSendData(dataLen, true)
        conn.consumeSendCredit(promisedStreamId, dataLen)
        appendDataFrame(outputValue, promisedStreamId, FH_END_STREAM, dataPayload)
    else
        // No data: just send END_STREAM via empty HEADERS or a zero-length DATA
        Buffer empty = Buffer()
        appendDataFrame(outputValue, promisedStreamId, FH_END_STREAM, empty)
    end

    // write back the mutated push stream (value semantics)
    conn.streams[pushIdx] = pushStream

    return ERR_NO_ERROR, conn
end


// ============================== Connection preface ==============================
// The HTTP/2 connection preface is 24 bytes of magic ASCII. When decoding
// frames from a raw binary file, skip it if present.

func skipPreface(Buffer buf) as int
    if buf.len() < PREFACE_LEN then
        return 0
    end
    string head = bytesToStr(buf, 0, PREFACE_LEN)
    if head == H2_CLIENT_PREFACE then
        return PREFACE_LEN
    end
    return 0
end

// Write the client connection preface + initial SETTINGS frame into `out`.

func appendConnectionPreface(Buffer outputValue)
    putText(outputValue, H2_CLIENT_PREFACE)
    // Initial SETTINGS: HEADER_TABLE_SIZE=4096, ENABLE_PUSH=0, INITIAL_WINDOW_SIZE=65535
    array<int> settings = array[
        SET_HEADER_TABLE_SIZE, DEFAULT_HEADER_TABLE,
        SET_ENABLE_PUSH, 0,
        SET_INITIAL_WINDOW_SIZE, DEFAULT_WINDOW
    ]
    appendSettingsFrame(outputValue, 0, settings)
end


// ============================== Multiplexing ==============================
// Interleave frames from multiple streams into a single output Buffer.
// `streamFrames` is an array of pre-built frame Buffers, one per stream,
// already containing HEADERS + DATA for that stream. They are interleaved
// round-robin (one frame at a time per stream) to demonstrate multiplexing.

func interleaveFrames(Buffer outputValue, array<Frame> frames)
    // Simple round-robin: just append all frames in order. Real HTTP/2
    // interleaves at the frame level, so the caller decides ordering.
    int i = 0
    while i < frames.length
        Frame f = frames[i]
        appendFrameHeader(outputValue, f.length, f.frameType, f.flags, f.streamId)
        // Caller must have already written payload to out separately.
        i += 1
    end
end

// Build interleaved DATA frames for multiple streams.
// `streamIds` and `dataChunks` are parallel arrays: for each pair, a DATA
// frame is appended to `out`, interleaved one chunk at a time.

func buildInterleavedData(Buffer outputValue, array<int> streamIds, array<string> dataChunks, bool endStream)
    int n = streamIds.length
    int i = 0
    while i < n
        Buffer payload = Buffer()
        payload.append(dataChunks[i])
        int flags = 0
        if endStream then
            flags = FH_END_STREAM
        end
        appendDataFrame(outputValue, streamIds[i], flags, payload)
        i += 1
    end
end


// ============================== Test framework ==============================

int g_pass = 0
int g_fail = 0

func check(string label, bool cond) as bool
    if cond then
        g_pass += 1
        return true
    end
    g_fail += 1
    println("  FAIL " + label)
    return false
end

func section(string title)
    println("")
    println("=== " + title + " ===")
end


// ============================== Tests: HPACK integers ==============================

func testHpackIntegers() as int
    section("HPACK integer encoding (RFC 7541 C.1)")

    // C.1.1: value 10, 5-bit prefix -> single byte 0x0a
    Buffer a = Buffer()
    hpackEncInt(a, 10, 5, 0x00)
    check("C.1.1: encInt(10, 5-bit) = 0a", a.len() == 1 and a.byteAt(0) == 0x0a)
    auto dec, p = hpackDecInt(a, 0, 5)
    check("C.1.1: decInt back to 10", dec == 10 and p == 1)

    // C.1.2: value 1337, 5-bit prefix -> 1f 9a 0a
    Buffer b = Buffer()
    hpackEncInt(b, 1337, 5, 0x00)
    bool ok = b.len() == 3
    ok = ok and b.byteAt(0) == 0x1F
    ok = ok and b.byteAt(1) == 0x9A
    ok = ok and b.byteAt(2) == 0x0A
    check("C.1.2: encInt(1337, 5-bit) = 1f 9a 0a", ok)
    auto dec2, p2 = hpackDecInt(b, 0, 5)
    check("C.1.2: decInt back to 1337", dec2 == 1337 and p2 == 3)

    // C.1.3: value 42, 8-bit prefix -> single byte 0x2a
    Buffer c = Buffer()
    hpackEncInt(c, 42, 8, 0x00)
    check("C.1.3: encInt(42, 8-bit) = 2a", c.len() == 1 and c.byteAt(0) == 0x2A)
    auto dec3, p3 = hpackDecInt(c, 0, 8)
    check("C.1.3: decInt back to 42", dec3 == 42 and p3 == 1)

    // Edge: value 0
    Buffer z = Buffer()
    hpackEncInt(z, 0, 5, 0x00)
    check("encInt(0, 5-bit) = 00", z.len() == 1 and z.byteAt(0) == 0x00)

    // Edge: value at prefix boundary (31 for 5-bit) uses continuation per RFC 7541
    Buffer e1 = Buffer()
    hpackEncInt(e1, 31, 5, 0x00)
    check("encInt(31, 5-bit) = 1f 00", e1.len() == 2 and e1.byteAt(0) == 0x1F and e1.byteAt(1) == 0x00)

    // Edge: value 32 (just over boundary)
    Buffer e2 = Buffer()
    hpackEncInt(e2, 32, 5, 0x00)
    check("encInt(32, 5-bit) = 1f 01", e2.len() == 2 and e2.byteAt(0) == 0x1F and e2.byteAt(1) == 0x01)

    // Large value: 100000 with 8-bit prefix
    Buffer big = Buffer()
    hpackEncInt(big, 100000, 8, 0x00)
    auto decBig, pBig = hpackDecInt(big, 0, 8)
    check("encInt/decInt(100000, 8-bit) roundtrip", decBig == 100000)

    // Prefix flags preserved (e.g. 0x80 for indexed)
    Buffer pf = Buffer()
    hpackEncInt(pf, 2, 7, 0x80)
    check("encInt(2, 7-bit, 0x80) = 82", pf.len() == 1 and pf.byteAt(0) == 0x82)

    return 0
end


// ============================== Tests: HPACK strings ==============================

func testHpackStrings() as int
    section("HPACK string encoding")

    Buffer a = Buffer()
    hpackEncStr(a, "GET")
    // Expected: 03 47 45 54 (length=3, H=0, then ASCII)
    bool ok = a.len() == 4
    ok = ok and a.byteAt(0) == 0x03
    ok = ok and a.byteAt(1) == 0x47
    ok = ok and a.byteAt(2) == 0x45
    ok = ok and a.byteAt(3) == 0x54
    check("encStr(\"GET\") = 03 47 45 54", ok)

    auto s, p = hpackDecStr(a, 0)
    check("decStr back to \"GET\"", s == "GET" and p == 4)

    // Longer string
    Buffer b = Buffer()
    string longStr = "www.example.com"
    hpackEncStr(b, longStr)
    auto s2, p2 = hpackDecStr(b, 0)
    check("roundtrip \"www.example.com\"", s2 == longStr and p2 == b.len())

    // Empty string
    Buffer c = Buffer()
    hpackEncStr(c, "")
    check("encStr(\"\") = 00", c.len() == 1 and c.byteAt(0) == 0x00)
    auto s3, p3 = hpackDecStr(c, 0)
    check("decStr(\"\") back to empty", s3 == "" and p3 == 1)

    return 0
end


// ============================== Tests: HPACK header blocks ==============================

func testHpackHeaders() as int
    section("HPACK header block encode/decode")

    // Simple request headers (RFC 7541 C.3 style)
    HpackEncoder enc = HpackEncoder()
    Buffer blk = Buffer()
    enc.encodeOne(blk, ":method", "GET")
    enc.encodeOne(blk, ":scheme", "https")
    enc.encodeOne(blk, ":path", "/")
    enc.encodeOne(blk, ":authority", "example.com")
    enc.encodeOne(blk, "user-agent", "xlang-xhttp2/1.0")
    enc.encodeOne(blk, "accept", "text/html")

    check("encoded block non-empty", blk.len() > 0)

    HpackDecoder dec = HpackDecoder()
    array<Header> hdrs = dec.decodeBlock(blk, 0, blk.len())
    check("decoded 6 headers", hdrs.length == 6)
    check("no decode error", not dec.hasError)

    if hdrs.length >= 6 then
        check("h0 :method == GET", hdrs[0].name == ":method" and hdrs[0].value == "GET")
        check("h1 :scheme == https", hdrs[1].name == ":scheme" and hdrs[1].value == "https")
        check("h2 :path == /", hdrs[2].name == ":path" and hdrs[2].value == "/")
        check("h3 :authority == example.com", hdrs[3].name == ":authority" and hdrs[3].value == "example.com")
        check("h4 user-agent", hdrs[4].name == "user-agent" and hdrs[4].value == "xlang-xhttp2/1.0")
        check("h5 accept", hdrs[5].name == "accept" and hdrs[5].value == "text/html")
    end

    // Verify indexed representation was used for :method GET (index 2 = 0x82)
    check(":method GET uses indexed (0x82)", blk.byteAt(0) == 0x82)
    // :scheme https uses indexed (index 7 = 0x87)
    check(":scheme https uses indexed (0x87)", blk.byteAt(1) == 0x87)
    // :path / uses indexed (index 4 = 0x84)
    check(":path / uses indexed (0x84)", blk.byteAt(2) == 0x84)

    return 0
end


// ============================== Tests: HPACK dynamic table ==============================

func testHpackDynamicTable() as int
    section("HPACK dynamic table with incremental indexing")

    HpackEncoder enc = HpackEncoder()
    enc.useIndexing = true
    enc.maxSize = 200   // small table to test eviction

    Buffer blk1 = Buffer()
    enc.encodeOne(blk1, "x-custom-header-1", "value-1")
    enc.encodeOne(blk1, "x-custom-header-2", "value-2")
    enc.encodeOne(blk1, "x-custom-header-3", "value-3")

    // After encoding 3 custom headers, dynamic table should have entries
    check("dynamic table has 3 entries", enc.dynamicTable.length == 3)

    // Second block: x-custom-header-1 should now be found via dynamic table
    Buffer blk2 = Buffer()
    enc.encodeOne(blk2, "x-custom-header-1", "value-1")
    // First byte should be indexed representation for dynamic table entry
    int firstByte = blk2.byteAt(0)
    check("second encode of same header is indexed", (firstByte & 0x80) != 0)
    check("indexed index >= 62 (dynamic)", (firstByte & 0x7F) >= 62)

    // Decode both blocks with matching dynamic table state
    HpackDecoder dec = HpackDecoder()
    dec.maxSize = 200
    array<Header> h1 = dec.decodeBlock(blk1, 0, blk1.len())
    array<Header> h2 = dec.decodeBlock(blk2, 0, blk2.len())
    check("decode block1: 3 headers", h1.length == 3)
    check("decode block2: 1 header", h2.length == 1)
    if h2.length >= 1 then
        check("decode block2 matches original",
            h2[0].name == "x-custom-header-1" and h2[0].value == "value-1")
    end

    // Test eviction: add a very large header to force eviction
    enc.addToDynamic("x-huge", "0123456789ABCDEF")
    // The table should have evicted older entries to fit
    check("eviction: table size <= maxSize", enc.curSize <= enc.maxSize)

    return 0
end


// ============================== Tests: static table ==============================

func testStaticTable() as int
    section("HPACK static table lookup")

    check("static table has 62 entries (index 0 + 61)", gStaticNames.length == STATIC_TABLE_SIZE)
    check("index 2 name = :method", gStaticNames[2] == ":method")
    check("index 2 value = GET", gStaticValues[2] == "GET")
    check("index 8 name = :status", gStaticNames[8] == ":status")
    check("index 8 value = 200", gStaticValues[8] == "200")
    check("index 61 = www-authenticate", gStaticNames[61] == "www-authenticate")

    check("findStaticExact(:method, GET) = 2", findStaticExact(":method", "GET") == 2)
    check("findStaticExact(:method, POST) = 3", findStaticExact(":method", "POST") == 3)
    check("findStaticExact(:status, 404) = 13", findStaticExact(":status", "404") == 13)
    check("findStaticExact(:authority, '') = 1", findStaticExact(":authority", "") == 1)
    check("findStaticExact(unknown, x) = 0", findStaticExact("x-unknown", "x") == 0)
    check("findStaticName(:method) = 2", findStaticName(":method") == 2)
    check("findStaticName(content-type) = 31", findStaticName("content-type") == 31)
    check("findStaticName(x-unknown) = 0", findStaticName("x-unknown") == 0)

    return 0
end


// ============================== Tests: frame encode/decode ==============================

func testFrameCodec() as int
    section("Frame encode/decode roundtrip")

    // --- DATA frame ---
    Buffer outputValue = Buffer()
    Buffer payload = Buffer()
    payload.append("Hello, HTTP/2!")
    appendDataFrame(outputValue, 1, FH_END_STREAM, payload)
    check("DATA frame total len = 9 + 14 = 23", outputValue.len() == 23)

    Frame f = Frame()
    int next = f.parse(outputValue, 0)
    bool dataOk = f.valid and f.frameType == FT_DATA and f.flags == FH_END_STREAM
    dataOk = dataOk and f.streamId == 1 and f.length == 14 and next == 23
    check("DATA frame parsed correctly", dataOk)
    check("DATA payload offset = 9", f.payloadOffset == 9)
    check("DATA payload text", bytesToStr(outputValue, f.payloadOffset, f.length) == "Hello, HTTP/2!")

    // --- HEADERS frame with HPACK ---
    Buffer out2 = Buffer()
    var hdrs = json.parse('{"method":"GET","path":"/","host":"example.com"}')
    // Use non-pseudo names to avoid : prefix issues in test JSON
    appendHeadersFrame(out2, 3, FH_END_HEADERS + FH_END_STREAM, hdrs)
    Frame f2 = Frame()
    int next2 = f2.parse(out2, 0)
    bool hdrOk = f2.valid and f2.frameType == FT_HEADERS and f2.streamId == 3
    hdrOk = hdrOk and (f2.flags & FH_END_HEADERS) != 0 and (f2.flags & FH_END_STREAM) != 0
    check("HEADERS frame parsed correctly", hdrOk)

    // Decode the HPACK block from the HEADERS payload
    HpackDecoder dec = HpackDecoder()
    array<Header> dh = dec.decodeBlock(out2, f2.payloadOffset, f2.length)
    check("HEADERS payload decodes to 3 headers", dh.length == 3)
    check("no HPACK decode error", not dec.hasError)

    // --- SETTINGS frame ---
    Buffer out3 = Buffer()
    array<int> settings = array[
        SET_HEADER_TABLE_SIZE, 4096,
        SET_ENABLE_PUSH, 1,
        SET_MAX_CONCURRENT_STREAMS, 128,
        SET_INITIAL_WINDOW_SIZE, 65535,
        SET_MAX_FRAME_SIZE, 16384
    ]
    appendSettingsFrame(out3, 0, settings)
    Frame f3 = Frame()
    int next3 = f3.parse(out3, 0)
    bool setOk = f3.valid and f3.frameType == FT_SETTINGS and f3.streamId == 0
    setOk = setOk and f3.length == 30 and next3 == 39
    check("SETTINGS frame parsed correctly", setOk)
    // Verify first setting pair
    int sid0 = rdU16BE(out3, f3.payloadOffset)
    int sval0 = rdU32BE(out3, f3.payloadOffset + 2)
    check("SETTINGS pair 0: HEADER_TABLE_SIZE = 4096", sid0 == SET_HEADER_TABLE_SIZE and sval0 == 4096)

    // --- SETTINGS ACK ---
    Buffer out3b = Buffer()
    appendSettingsAck(out3b)
    Frame f3b = Frame()
    f3b.parse(out3b, 0)
    check("SETTINGS ACK: flags=ACK, len=0", (f3b.flags & FH_ACK) != 0 and f3b.length == 0)

    // --- PING frame ---
    Buffer out4 = Buffer()
    appendPingFrame(out4, 0, int64(0x0102030405060708))
    Frame f4 = Frame()
    f4.parse(out4, 0)
    bool pingOk = f4.valid and f4.frameType == FT_PING and f4.length == 8 and f4.streamId == 0
    int64 pingData = rdU64BE(out4, f4.payloadOffset)
    pingOk = pingOk and pingData == int64(0x0102030405060708)
    check("PING frame parsed correctly", pingOk)

    // --- PING ACK ---
    Buffer out4b = Buffer()
    appendPingAck(out4b, int64(0xDEADBEEFCAFEBABE))
    Frame f4b = Frame()
    f4b.parse(out4b, 0)
    check("PING ACK: flags=ACK", (f4b.flags & FH_ACK) != 0)

    // --- GOAWAY frame ---
    Buffer out5 = Buffer()
    appendGoawayFrame(out5, 7, ERR_NO_ERROR, "graceful shutdown")
    Frame f5 = Frame()
    f5.parse(out5, 0)
    bool goawayOk = f5.valid and f5.frameType == FT_GOAWAY and f5.streamId == 0
    int lastSid = rdU31BE(out5, f5.payloadOffset)
    int ec = rdU32BE(out5, f5.payloadOffset + 4)
    string dbg = bytesToStr(out5, f5.payloadOffset + 8, f5.length - 8)
    goawayOk = goawayOk and lastSid == 7 and ec == ERR_NO_ERROR and dbg == "graceful shutdown"
    check("GOAWAY frame parsed correctly", goawayOk)

    // --- WINDOW_UPDATE frame ---
    Buffer out6 = Buffer()
    appendWindowUpdateFrame(out6, 0, 32768)
    Frame f6 = Frame()
    f6.parse(out6, 0)
    int inc = rdU31BE(out6, f6.payloadOffset)
    bool wuOk = f6.valid and f6.frameType == FT_WINDOW_UPDATE and f6.length == 4
    wuOk = wuOk and f6.streamId == 0 and inc == 32768
    check("WINDOW_UPDATE frame parsed correctly", wuOk)

    // --- RST_STREAM frame ---
    Buffer out7 = Buffer()
    appendRstStreamFrame(out7, 5, ERR_CANCEL)
    Frame f7 = Frame()
    f7.parse(out7, 0)
    int ec7 = rdU32BE(out7, f7.payloadOffset)
    bool rstOk = f7.valid and f7.frameType == FT_RST_STREAM and f7.streamId == 5
    rstOk = rstOk and ec7 == ERR_CANCEL
    check("RST_STREAM frame parsed correctly", rstOk)

    // --- Multiple frames in sequence ---
    Buffer seq = Buffer()
    appendDataFrame(seq, 1, 0, Buffer())
    appendSettingsFrame(seq, 0, array[SET_MAX_FRAME_SIZE, 65536])
    appendPingFrame(seq, 0, int64(1))
    int off = 0
    int frameCount = 0
    Frame sf = Frame()
    while off < seq.len()
        int r = sf.parse(seq, off)
        if r < 0 then
            break
        end
        frameCount += 1
        off = r
    end
    check("3 sequential frames parsed", frameCount == 3)

    // --- Incomplete frame rejection ---
    Buffer incBuf = Buffer()
    incBuf.appendByte(0x00)
    incBuf.appendByte(0x00)
    incBuf.appendByte(0x10)    // declares 16 bytes payload
    incBuf.appendByte(FT_DATA)
    incBuf.appendByte(0x00)
    incBuf.appendByte(0x00)
    incBuf.appendByte(0x00)
    incBuf.appendByte(0x00)
    incBuf.appendByte(0x01)
    incBuf.appendByte(0xAA)    // only 1 byte of payload, not 16
    Frame fi = Frame()
    int ri = fi.parse(incBuf, 0)
    check("incomplete payload -> -1", ri == -1 and not fi.valid)

    return 0
end


// ============================== Tests: frame header bit packing ==============================

func testFrameHeaderBits() as int
    section("Frame header bit packing (24-bit length, 31-bit stream ID)")

    Buffer outputValue = Buffer()
    // Large length: 0x123456 (1193046), type=DATA, flags=0xFF, stream=0x7FFFFFFF
    appendFrameHeader(outputValue, 0x123456, FT_DATA, 0xFF, 0x7FFFFFFF)
    check("header is 9 bytes", outputValue.len() == 9)

    // Verify each field
    int len = rdU24BE(outputValue, 0)
    int typ = outputValue.byteAt(3) & 0xFF
    int flg = outputValue.byteAt(4) & 0xFF
    int sid = rdU31BE(outputValue, 5)
    check("length field = 0x123456", len == 0x123456)
    check("type field = DATA(0)", typ == FT_DATA)
    check("flags field = 0xFF", flg == 0xFF)
    check("stream ID = 0x7FFFFFFF (31-bit max)", sid == 0x7FFFFFFF)

    // Verify reserved bit (bit 0 of byte 5) is always 0
    int rawByte5 = outputValue.byteAt(5) & 0xFF
    check("reserved bit is 0", (rawByte5 & 0x80) == 0)

    // Roundtrip: encode then parse
    Frame f = Frame()
    f.parse(outputValue, 0)
    check("roundtrip length", f.length == 0x123456)
    check("roundtrip type", f.frameType == FT_DATA)
    check("roundtrip flags", f.flags == 0xFF)
    check("roundtrip streamId", f.streamId == 0x7FFFFFFF)

    return 0
end


// ============================== Tests: stream state machine ==============================

func testStreamStateMachine() as int
    section("Stream state machine transitions")

    Stream s = Stream(1)
    check("initial state = idle", s.state == ST_IDLE)

    // idle -> open (recv HEADERS)
    s.onRecvHeaders(false)
    check("idle -> open (recv HEADERS)", s.state == ST_OPEN)

    // open -> half-closed-remote (recv END_STREAM)
    Stream s2 = Stream(3)
    s2.onRecvHeaders(false)
    s2.onRecvData(100, true)
    check("open -> half-closed(remote) (recv ES)", s2.state == ST_HALF_CLOSED_REMOTE)

    // half-closed-remote -> closed (send END_STREAM)
    s2.onSendHeaders(true)
    check("half-closed(remote) -> closed (send ES)", s2.state == ST_CLOSED)

    // open -> half-closed-local (send END_STREAM)
    Stream s3 = Stream(5)
    s3.onSendHeaders(false)
    s3.onSendData(50, true)
    check("open -> half-closed(local) (send ES)", s3.state == ST_HALF_CLOSED_LOCAL)

    // half-closed-local -> closed (recv END_STREAM)
    s3.onRecvData(0, true)
    check("half-closed(local) -> closed (recv ES)", s3.state == ST_CLOSED)

    // RST_STREAM from any state -> closed
    Stream s4 = Stream(7)
    s4.onSendHeaders(false)
    s4.onRstStream()
    check("RST_STREAM -> closed", s4.state == ST_CLOSED)
    check("isClosed() after RST", s4.isClosed())

    // Cannot send DATA on closed stream
    Stream s5 = Stream(9)
    s5.onSendHeaders(false)
    s5.onRstStream()
    bool canSend = s5.onSendData(10, false)
    check("DATA on closed stream rejected", not canSend)

    // Cannot send DATA on half-closed-local
    Stream s6 = Stream(11)
    s6.onSendHeaders(false)
    s6.onSendData(10, true)    // local half-closed
    bool canSend2 = s6.onSendData(10, false)
    check("DATA on half-closed(local) rejected", not canSend2)

    return 0
end


// ============================== Tests: flow control ==============================

func testFlowControl() as int
    section("Flow control (per-stream + per-connection)")

    Connection conn = Connection()
    check("conn initial send window = 65535", conn.connSendWindow == DEFAULT_WINDOW)
    check("conn initial recv window = 65535", conn.connRecvWindow == DEFAULT_WINDOW)

    Stream s = conn.newStream()
    check("stream 1 created", s.id == 1)
    check("stream initial send window = 65535", s.sendWindow == DEFAULT_WINDOW)

    // Consume credit by sending DATA
    conn.consumeSendCredit(1, 1000)
    s = conn.getStream(1)
    check("stream send window after 1000 bytes", s.sendWindow == 64535)
    check("conn send window after 1000 bytes", conn.connSendWindow == 64535)

    // Check credit availability
    check("can send 64535 more", conn.canSendData(1, 64535))
    check("cannot send 64536", not conn.canSendData(1, 64536))

    // Replenish via WINDOW_UPDATE
    conn.replenishSendCredit(1, 500)
    s = conn.getStream(1)
    check("stream send window +500", s.sendWindow == 65035)

    conn.replenishConnSendCredit(2000)
    check("conn send window +2000", conn.connSendWindow == 66535)

    // Exhaust stream window
    conn.consumeSendCredit(1, 65035)
    s = conn.getStream(1)
    check("stream window exhausted", s.sendWindow == 0)
    check("cannot send when stream window = 0", not conn.canSendData(1, 1))

    // But connection-level WINDOW_UPDATE doesn't help the stream
    conn.replenishConnSendCredit(10000)
    s = conn.getStream(1)
    check("conn window replenished but stream still 0", s.sendWindow == 0 and conn.connSendWindow > 0)

    return 0
end


// ============================== Tests: multiplexing ==============================

func testMultiplexing() as int
    section("Multiplexing: interleaved streams on one connection")

    Connection conn = Connection()
    Stream s1 = conn.newStream()   // id=1
    Stream s3 = conn.newStream()   // id=3
    Stream s5 = conn.newStream()   // id=5

    check("3 streams created", conn.streamCount() == 3)
    check("stream IDs: 1, 3, 5", s1.id == 1 and s3.id == 3 and s5.id == 5)

    // Build interleaved frame sequence:
    //   stream1 HEADERS
    //   stream3 HEADERS
    //   stream5 HEADERS
    //   stream1 DATA (chunk 1)
    //   stream3 DATA (chunk 1)
    //   stream5 DATA (chunk 1)
    //   stream1 DATA (chunk 2, END_STREAM)
    //   stream3 DATA (chunk 2, END_STREAM)
    //   stream5 DATA (chunk 2, END_STREAM)
    Buffer wire = Buffer()

    // HEADERS for each stream (using literal HPACK)
    var h1 = json.parse('{"x-stream":"1"}')
    var h3 = json.parse('{"x-stream":"3"}')
    var h5 = json.parse('{"x-stream":"5"}')
    appendHeadersFrame(wire, 1, FH_END_HEADERS, h1)
    appendHeadersFrame(wire, 3, FH_END_HEADERS, h3)
    appendHeadersFrame(wire, 5, FH_END_HEADERS, h5)

    // DATA chunk 1 for each stream
    Buffer d1a = Buffer()
    d1a.append("stream1-chunk1")
    appendDataFrame(wire, 1, 0, d1a)
    Buffer d3a = Buffer()
    d3a.append("stream3-chunk1")
    appendDataFrame(wire, 3, 0, d3a)
    Buffer d5a = Buffer()
    d5a.append("stream5-chunk1")
    appendDataFrame(wire, 5, 0, d5a)

    // DATA chunk 2 (END_STREAM) for each stream
    Buffer d1b = Buffer()
    d1b.append("stream1-chunk2")
    appendDataFrame(wire, 1, FH_END_STREAM, d1b)
    Buffer d3b = Buffer()
    d3b.append("stream3-chunk2")
    appendDataFrame(wire, 3, FH_END_STREAM, d3b)
    Buffer d5b = Buffer()
    d5b.append("stream5-chunk2")
    appendDataFrame(wire, 5, FH_END_STREAM, d5b)

    check("wire buffer has 9 frames worth of data", wire.len() > 0)

    // Now decode the interleaved wire format and reassemble per-stream data
    string s1Data = ""
    string s3Data = ""
    string s5Data = ""
    int off = 0
    int totalFrames = 0
    int headersFrames = 0
    int dataFrames = 0
    Frame pf = Frame()
    while off < wire.len()
        int r = pf.parse(wire, off)
        if r < 0 then
            break
        end
        totalFrames += 1
        if pf.frameType == FT_HEADERS then
            headersFrames += 1
        elseif pf.frameType == FT_DATA then
            dataFrames += 1
            string chunk = bytesToStr(wire, pf.payloadOffset, pf.length)
            if pf.streamId == 1 then
                s1Data = s1Data + chunk
            elseif pf.streamId == 3 then
                s3Data = s3Data + chunk
            elseif pf.streamId == 5 then
                s5Data = s5Data + chunk
            end
        end
        off = r
    end

    check("decoded 9 frames total", totalFrames == 9)
    check("3 HEADERS + 6 DATA", headersFrames == 3 and dataFrames == 6)
    check("stream1 reassembled", s1Data == "stream1-chunk1stream1-chunk2")
    check("stream3 reassembled", s3Data == "stream3-chunk1stream3-chunk2")
    check("stream5 reassembled", s5Data == "stream5-chunk1stream5-chunk2")

    return 0
end


// ============================== Tests: server push ==============================

func testServerPush() as int
    section("Server push simulation")

    Connection conn = Connection()
    conn.isServer = true

    // Client initiates stream 1 with a request
    Stream reqStream = conn.newStream()    // id=1
    conn.setStreamState(1, ST_OPEN)

    // Server decides to push on stream 2
    var promiseHeaders = json.parse('{"x-push-promised":"true"}')
    var pushRespHeaders = json.parse('{"x-status":"200"}')
    var reqHeaders = json.parse('{"x-request":"GET-push"}')

    Buffer wire = Buffer()
    int err
    err, conn = simulateServerPush(wire, conn, 1, 2,
                                 reqHeaders, promiseHeaders, pushRespHeaders,
                                 "pushed-response-body-data")

    check("push returned NO_ERROR", err == ERR_NO_ERROR)
    check("wire has frames", wire.len() > 0)

    // Decode the wire: expect PUSH_PROMISE + HEADERS + DATA
    int off = 0
    int ppCount = 0
    int hdrCount = 0
    int dataCount = 0
    int promisedId = 0
    Frame pf = Frame()
    while off < wire.len()
        int r = pf.parse(wire, off)
        if r < 0 then
            break
        end
        if pf.frameType == FT_PUSH_PROMISE then
            ppCount += 1
            promisedId = rdU31BE(wire, pf.payloadOffset)
        elseif pf.frameType == FT_HEADERS then
            hdrCount += 1
        elseif pf.frameType == FT_DATA then
            dataCount += 1
        end
        off = r
    end

    check("1 PUSH_PROMISE frame", ppCount == 1)
    check("promised stream ID = 2", promisedId == 2)
    check("1 HEADERS frame (push response)", hdrCount == 1)
    check("1 DATA frame (push body)", dataCount == 1)

    // Verify push was on the parent stream's ID in the PUSH_PROMISE
    off = 0
    bool parentOk = false
    while off < wire.len()
        int r = pf.parse(wire, off)
        if r < 0 then break end
        if pf.frameType == FT_PUSH_PROMISE then
            parentOk = pf.streamId == 1
            break
        end
        off = r
    end
    check("PUSH_PROMISE on parent stream 1", parentOk)

    // Push stream is now half-closed-local (we sent END_STREAM)
    Stream pushStream = conn.getStream(2)
    check("push stream exists", pushStream.id == 2)
    check("push stream is closed (sent ES)", pushStream.isClosed())

    return 0
end


// ============================== Tests: connection preface ==============================

func testConnectionPreface() as int
    section("HTTP/2 connection preface")

    Buffer outputValue = Buffer()
    appendConnectionPreface(outputValue)

    // First 24 bytes should be the magic preface string
    string preface = bytesToStr(outputValue, 0, PREFACE_LEN)
    check("preface magic correct", preface == H2_CLIENT_PREFACE)

    // After preface, there should be a SETTINGS frame
    Frame f = Frame()
    int r = f.parse(outputValue, PREFACE_LEN)
    bool ok = r > 0 and f.frameType == FT_SETTINGS and f.streamId == 0
    check("SETTINGS frame follows preface", ok)

    // Verify settings payload has pairs
    int nPairs = f.length / 6
    check("SETTINGS has 3 pairs", nPairs == 3)

    // skipPreface detection
    int skip = skipPreface(outputValue)
    check("skipPreface returns 24", skip == PREFACE_LEN)

    // Buffer without preface
    Buffer nopref = Buffer()
    nopref.append("GET / HTTP/1.1\r\n")
    int skip2 = skipPreface(nopref)
    check("skipPreface returns 0 for non-preface", skip2 == 0)

    return 0
end


// ============================== Tests: encode-headers roundtrip ==============================

func testEncodeHeadersRoundtrip() as int
    section("encode-headers full roundtrip")

    // Simulate: encode-headers JSON -> hex -> hexDecode -> HPACK decode -> verify
    HpackEncoder enc = HpackEncoder()
    Buffer blk = Buffer()
    var hdrs = json.parse('{"method":"POST","path":"/api/data","host":"api.example.com","content-type":"application/json","content-length":"42"}')
    encodeHeadersBlock(enc, blk, hdrs)

    string hex = bufHex(blk)
    check("hex output non-empty", string.len(hex) > 0)

    Buffer decoded = codec.hexDecodeBytes(hex)
    check("hex decode matches original length", decoded.len() == blk.len())

    HpackDecoder dec = HpackDecoder()
    array<Header> result = dec.decodeBlock(decoded, 0, decoded.len())
    check("decoded 5 headers", result.length == 5)
    check("no decode error", not dec.hasError)

    // Verify each header
    bool allMatch = result.length == 5
    int i = 0
    while i < result.length
        Header h = result[i]
        string expected = json.stringify(hdrs[h.name])
        // json.stringify wraps value in quotes, so strip them
        if string.len(expected) >= 2 then
            expected = string.slice(expected, 1, string.len(expected) - 2)
        end
        if h.value != expected then
            allMatch = false
        end
        i += 1
    end
    check("all header values match", allMatch)

    return 0
end


// ============================== Tests: HPACK known vector ==============================

func testHpackKnownVector() as int
    section("HPACK known vector (RFC 7541 C.3.1 simplified)")

    // C.3.1 First request (without Huffman, using indexed where possible):
    //   :method GET
    //   :scheme http
    //   :path /
    //   :authority www.example.com
    //
    // With indexed representation for first three and literal for :authority:
    //   82    (indexed: :method GET = 2)
    //   86    (indexed: :scheme http = 6)
    //   84    (indexed: :path / = 4)
    //   41 0f www.example.com  (literal w/ indexing, name idx=1, value=15 bytes)
    //
    // Our encoder defaults to literal-without-indexing (no 0x40 prefix), so
    // the :authority line starts with 01 (name idx=1) instead of 41. The key
    // test is that the first three bytes are the correct indexed codes.

    HpackEncoder enc = HpackEncoder()
    Buffer blk = Buffer()
    enc.encodeOne(blk, ":method", "GET")
    enc.encodeOne(blk, ":scheme", "http")
    enc.encodeOne(blk, ":path", "/")
    enc.encodeOne(blk, ":authority", "www.example.com")

    check("byte 0 = 0x82 (:method GET indexed)", blk.byteAt(0) == 0x82)
    check("byte 1 = 0x86 (:scheme http indexed)", blk.byteAt(1) == 0x86)
    check("byte 2 = 0x84 (:path / indexed)", blk.byteAt(2) == 0x84)
    // byte 3 should be 0x01 (literal w/o indexing, name idx=1 = :authority)
    check("byte 3 = 0x01 (:authority literal)", blk.byteAt(3) == 0x01)
    // byte 4 should be 0x0f (string length=15, "www.example.com")
    check("byte 4 = 0x0f (value length 15)", blk.byteAt(4) == 0x0F)

    // Full roundtrip
    HpackDecoder dec = HpackDecoder()
    array<Header> hdrs = dec.decodeBlock(blk, 0, blk.len())
    check("decoded 4 headers", hdrs.length == 4)
    check("no decode error", not dec.hasError)
    if hdrs.length == 4 then
        check("h0 = :method GET", hdrs[0].name == ":method" and hdrs[0].value == "GET")
        check("h1 = :scheme http", hdrs[1].name == ":scheme" and hdrs[1].value == "http")
        check("h2 = :path /", hdrs[2].name == ":path" and hdrs[2].value == "/")
        check("h3 = :authority www.example.com", hdrs[3].name == ":authority" and hdrs[3].value == "www.example.com")
    end

    return 0
end


// ============================== Tests: error codes ==============================

func testErrorCodes() as int
    section("Error code names")

    check("NO_ERROR name", errorName(ERR_NO_ERROR) == "NO_ERROR")
    check("PROTOCOL_ERROR name", errorName(ERR_PROTOCOL_ERROR) == "PROTOCOL_ERROR")
    check("FLOW_CONTROL_ERROR name", errorName(ERR_FLOW_CONTROL_ERROR) == "FLOW_CONTROL_ERROR")
    check("COMPRESSION_ERROR name", errorName(ERR_COMPRESSION_ERROR) == "COMPRESSION_ERROR")
    check("ENHANCE_YOUR_CALM name", errorName(ERR_ENHANCE_YOUR_CALM) == "ENHANCE_YOUR_CALM")
    check("unknown error name", string.contains(errorName(99), "UNKNOWN"))

    return 0
end


// ============================== Tests: PRIORITY frame ==============================

func testPriorityFrame() as int
    section("PRIORITY frame encode/decode")

    Buffer outputValue = Buffer()
    // exclusive=true, dependency=5, weight=201
    appendPriorityFrame(outputValue, 3, true, 5, 201)
    Frame f = Frame()
    f.parse(outputValue, 0)

    bool ok = f.valid and f.frameType == FT_PRIORITY and f.length == 5
    ok = ok and f.streamId == 3
    int depWord = rdU32BE(outputValue, f.payloadOffset)
    bool excl = (depWord & 0x80000000) != 0
    int dep = depWord & 0x7FFFFFFF
    int weight = outputValue.byteAt(f.payloadOffset + 4) & 0xFF
    ok = ok and excl and dep == 5 and weight == 201
    check("PRIORITY frame parsed (excl, dep=5, weight=201)", ok)

    // Non-exclusive
    Buffer out2 = Buffer()
    appendPriorityFrame(out2, 7, false, 0, 256)
    Frame f2 = Frame()
    f2.parse(out2, 0)
    int depWord2 = rdU32BE(out2, f2.payloadOffset)
    bool excl2 = (depWord2 & 0x80000000) != 0
    check("PRIORITY non-exclusive bit is 0", not excl2)

    return 0
end


// ============================== Tests: frame type names ==============================

func testFrameTypeNames() as int
    section("Frame type and flag names")

    check("DATA name", frameTypeName(FT_DATA) == "DATA")
    check("HEADERS name", frameTypeName(FT_HEADERS) == "HEADERS")
    check("PRIORITY name", frameTypeName(FT_PRIORITY) == "PRIORITY")
    check("RST_STREAM name", frameTypeName(FT_RST_STREAM) == "RST_STREAM")
    check("SETTINGS name", frameTypeName(FT_SETTINGS) == "SETTINGS")
    check("PUSH_PROMISE name", frameTypeName(FT_PUSH_PROMISE) == "PUSH_PROMISE")
    check("PING name", frameTypeName(FT_PING) == "PING")
    check("GOAWAY name", frameTypeName(FT_GOAWAY) == "GOAWAY")
    check("WINDOW_UPDATE name", frameTypeName(FT_WINDOW_UPDATE) == "WINDOW_UPDATE")
    check("CONTINUATION name", frameTypeName(FT_CONTINUATION) == "CONTINUATION")

    // Flag strings
    string dataFlags = flagString(FT_DATA, FH_END_STREAM + FH_PADDED)
    check("DATA flags: END_STREAM+PADDED", string.contains(dataFlags, "END_STREAM") and string.contains(dataFlags, "PADDED"))

    string hdrFlags = flagString(FT_HEADERS, FH_END_STREAM + FH_END_HEADERS + FH_PRIORITY)
    check("HEADERS flags: ES+EH+PRI", string.contains(hdrFlags, "END_STREAM") and string.contains(hdrFlags, "END_HEADERS") and string.contains(hdrFlags, "PRIORITY"))

    string ackFlags = flagString(FT_PING, FH_ACK)
    check("PING ACK", string.contains(ackFlags, "ACK"))

    string noneFlags = flagString(FT_DATA, 0)
    check("no flags -> 'none'", noneFlags == "none")

    return 0
end


// ============================== Run all tests ==============================

func runTests() as int
    println("========================================")
    println("xhttp2 self-test suite")
    println("========================================")

    testHpackIntegers()
    testHpackStrings()
    testStaticTable()
    testHpackHeaders()
    testHpackDynamicTable()
    testHpackKnownVector()
    testFrameHeaderBits()
    testFrameCodec()
    testPriorityFrame()
    testFrameTypeNames()
    testStreamStateMachine()
    testFlowControl()
    testMultiplexing()
    testServerPush()
    testConnectionPreface()
    testEncodeHeadersRoundtrip()
    testErrorCodes()

    println("")
    println("========================================")
    println("PASSED " + string(g_pass) + " / FAILED " + string(g_fail))
    println("========================================")
    if g_fail > 0 then
        return 1
    end
    return 0
end


// ============================== CLI: encode-headers ==============================

func cmdEncodeHeaders(string jsonStr) as int
    if not json.valid(jsonStr) then
        println("xhttp2: invalid JSON header set")
        println("  expected: {\"name\":\"value\", ...}")
        return 1
    end
    var headers = json.parse(jsonStr)
    Buffer outputValue = Buffer()
    HpackEncoder enc = HpackEncoder()
    encodeHeadersBlock(enc, outputValue, headers)
    println(codec.hexEncodeBytes(outputValue.data(), c_size(outputValue.len())))
    return 0
end


// ============================== CLI: decode-frames ==============================

func cmdDecodeFrames(string path) as int
    if not file.exists(path) then
        println("xhttp2: file not found: " + path)
        return 1
    end
    Buffer buf = file.readBytes(path)
    if buf.len() == 0 then
        println("xhttp2: empty file: " + path)
        return 1
    end

    // Skip HTTP/2 connection preface if present
    int start = skipPreface(buf)
    if start > 0 then
        println("; connection preface detected (24 bytes skipped)")
        println("; " + bytesToStr(buf, 0, PREFACE_LEN))
    end

    int off = start
    int frameNum = 0
    Frame f = Frame()
    println("; decoding " + string(buf.len()) + " bytes from " + path)
    while off < buf.len()
        int r = f.parse(buf, off)
        if r < 0 then
            println("; parse error at offset " + string(off) + ": " + f.error)
            break
        end
        print("Frame " + string(frameNum) + ": ")
        println(frameTypeName(f.frameType)
             + "  len=" + string(f.length)
             + "  stream=" + string(f.streamId)
             + "  flags=0x" + int.format(f.flags, "x2"))
        println("  " + flagString(f.frameType, f.flags))

        // Type-specific payload decoding
        if f.frameType == FT_SETTINGS and f.length >= 6 then
            int i = 0
            int count = f.length / 6
            while i < count
                int sid = rdU16BE(buf, f.payloadOffset + i * 6)
                int sval = rdU32BE(buf, f.payloadOffset + i * 6 + 2)
                println("    " + settingName(sid) + " = " + string(sval))
                i += 1
            end
        elseif f.frameType == FT_WINDOW_UPDATE and f.length >= 4 then
            int inc = rdU31BE(buf, f.payloadOffset)
            println("    increment = " + string(inc))
        elseif f.frameType == FT_PING and f.length >= 8 then
            int64 data = rdU64BE(buf, f.payloadOffset)
            println("    opaque = 0x" + int.format(int((data >> 32) & 0xFFFFFFFF), "x8")
                + int.format(int(data & 0xFFFFFFFF), "x8"))
        elseif f.frameType == FT_GOAWAY and f.length >= 8 then
            int lastSid = rdU31BE(buf, f.payloadOffset)
            int ec = rdU32BE(buf, f.payloadOffset + 4)
            println("    last_stream = " + string(lastSid) + "  error = " + errorName(ec))
        elseif f.frameType == FT_RST_STREAM and f.length >= 4 then
            int ec = rdU32BE(buf, f.payloadOffset)
            println("    error = " + errorName(ec))
        elseif f.frameType == FT_HEADERS and f.length > 0 then
            HpackDecoder dec = HpackDecoder()
            array<Header> hdrs = dec.decodeBlock(buf, f.payloadOffset, f.length)
            if dec.hasError then
                println("    HPACK error: " + dec.errorMsg)
            else
                int i = 0
                while i < hdrs.length
                    println("    " + hdrs[i].name + ": " + hdrs[i].value)
                    i += 1
                end
            end
        elseif f.frameType == FT_DATA and f.length > 0 then
            string preview = hexPreview(buf, f.payloadOffset, f.length, 16)
            println("    data: " + preview)
        elseif f.frameType == FT_PUSH_PROMISE and f.length >= 4 then
            int promised = rdU31BE(buf, f.payloadOffset)
            println("    promised_stream = " + string(promised))
        end

        if f.length > 0 and f.frameType != FT_HEADERS and f.frameType != FT_DATA then
            println("    payload: " + hexPreview(buf, f.payloadOffset, f.length, 16))
        end

        frameNum += 1
        off = r
    end

    println("; decoded " + string(frameNum) + " frames")
    return 0
end


// ============================== Usage ==============================

func printUsage()
    println("xhttp2 - HTTP/2 binary protocol engine")
    println("")
    println("usage:")
    println("  xhttp2 encode-headers <json>    HPACK-encode a JSON header set -> hex string")
    println("  xhttp2 decode-frames <bin>      decode all HTTP/2 frames in a binary file")
    println("  xhttp2 test                     built-in self-test suite")
    println("  xhttp2 -h | --help              show this help")
    println("")
    println("<json> example:")
    println('  {":method":"GET",":scheme":"https",":path":"/",":authority":"example.com"}')
    println("")
    println("implements: frame codec, HPACK, stream state machine, flow control,")
    println("            server push, multiplexing (RFC 9113 / RFC 7541)")
end


// ============================== Main entry ==============================

func main(...) as int
    if arg.length < 2 then
        printUsage()
        return 1
    end

    string cmd = string(arg[1])

    if cmd == "-h" or cmd == "--help" or cmd == "help" then
        printUsage()
        return 0
    end

    if cmd == "test" then
        return runTests()
    end

    if cmd == "encode-headers" then
        if arg.length < 3 then
            println("xhttp2: 'encode-headers' needs <json>")
            println('  example: xhttp2 encode-headers {"method":"GET","path":"/"}')
            return 1
        end
        return cmdEncodeHeaders(string(arg[2]))
    end

    if cmd == "decode-frames" then
        if arg.length < 3 then
            println("xhttp2: 'decode-frames' needs <bin>")
            return 1
        end
        return cmdDecodeFrames(string(arg[2]))
    end

    println("xhttp2: unknown command: " + cmd)
    printUsage()
    return 1
end
