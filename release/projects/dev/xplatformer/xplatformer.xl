// xplatformer.xl - 终端平台跳跃游戏（ASCII 平台跳跃）
//
// 一个用 xlang 实现的极简平台跳跃游戏，采用「全局函数 + 全局数组」的过程式
// 架构（不使用 class 层次），所有游戏状态都放在文件作用域的全局数组/变量里，
// 行为拆成一组全局函数。覆盖：
//   * 物理引擎：重力 / 跳跃 / 摩擦 / AABB 瓦片碰撞（轴分离响应）/ 单向平台
//   * 关卡：字符串地图描述（# 墙  . 空  ^ 尖刺  $ 金币  G 出口  = 单向平台
//           P 玩家出生点  M 敌人出生点），自动密封边界
//   * 敌人：巡逻 / 追击 AI（有限状态机 + 发现/脱战距离 + 撞墙翻转 + 追击跳跃）
//   * 游戏循环：stepFrame(action) 推进一帧（update + ASCII render）
//   * 自动演示：内置启发式 AI 跑关（朝出口走，遇墙/坑/尖刺/敌人则跳）
//   * 测试：物理 / 碰撞 / AI / 收集 / 伤害 / 渲染 / 全场景跑帧等 22 项
//
// 用法：
//   xplatformer                        打印用法
//   xplatformer demo [frames=200]      运行内置关卡（自动玩家跑关）
//   xplatformer test                   运行正确性测试
//   xplatformer -h | --help            本帮助
//
// 验证：
//   cd /d D:\GIT\x-lang\release
//   xl run projects\dev\xplatformer\xplatformer.xl test
//   xl run projects\dev\xplatformer\xplatformer.xl demo 200
//   xl build projects\dev\xplatformer\xplatformer.xl -o projects\dev\xplatformer\xplatformer.exe
//
// 字符图例：
//   @  玩家        M  敌人        #  墙        ^  尖刺
//   $  金币        G  出口        =  单向平台  .  空地
//
// xlang 约定适配：
//   * 全局数组在声明处 array[] 初始化，用 push 填充；用 clear() 重置。
//   * 无 stdin，输入用「动作码」驱动（脚本化输入 + 内置自动玩家）。
//   * 无 `for i in 0..n` 区间语法，统一用 while 索引循环。
//   * 多返回值：`return a, b` / `x, y = f()`，用于物理碰撞回写新状态。
//   * float 变量取负用 `0.0 - v`，负数字面量可直接写。

// ===========================================================================
// 1. 常量
// ===========================================================================

// ---- 瓦片类型 ----
int T_EMPTY    = 0       // 空地
int T_WALL     = 1       // 实心墙（四面阻挡）
int T_SPIKE    = 2       // 尖刺（不阻挡，但伤害玩家）
int T_COIN     = 3       // 金币（可收集，+分）
int T_EXIT     = 4       // 出口（触碰即胜利）
int T_PLATFORM = 5       // 单向平台（仅从上方阻挡）

// ---- AI 状态 ----
int ST_PATROL = 1        // 巡逻：在锚点附近来回走
int ST_CHASE  = 2        // 追击：朝玩家移动

// ---- 动作码（脚本化输入）----
int ACT_NONE       = 0
int ACT_LEFT       = 1
int ACT_RIGHT      = 2
int ACT_JUMP       = 3
int ACT_JUMP_LEFT  = 4
int ACT_JUMP_RIGHT = 5

// ---- 物理常量 ----
float GRAVITY        = 0.030    // 每帧重力加速度（向下为正）
float MAX_FALL       = 0.55     // 终端下落速度
float MOVE_SPEED     = 0.22     // 玩家水平最大速度（直接设速）
float FRICTION_GROUND = 0.78    // 地面摩擦（每帧速度乘数）
float FRICTION_AIR   = 0.96     // 空中摩擦
float JUMP_VELOCITY  = -0.45    // 跳跃初速（向上为负）
float ENEMY_SPEED    = 0.10     // 敌人水平速度
int   COYOTE_FRAMES  = 6        // 离地后仍可起跳的宽限帧数
int   INVULN_FRAMES  = 45       // 受伤后无敌帧数
float KNOCKBACK_VY   = -0.22    // 受伤击退的竖直速度
int   COIN_SCORE     = 10       // 每枚金币得分
int   PLAYER_HP      = 5        // 玩家初始血量

// ---- 敌人 AI 参数 ----
float AI_DETECT      = 6.0      // 发现玩家距离（进入追击）
float AI_LEASH       = 11.0     // 脱战距离（回到巡逻）
int   AI_PATROL_RANGE = 3       // 巡逻半径（瓦片）

// ---- 视口 ----
int g_viewW = 62                // 渲染窗口宽（字符）
int g_viewH = 14                // 渲染窗口高（字符）
int RENDER_EVERY = 4            // demo 中每 N 帧渲染一次

// ===========================================================================
// 2. 全局状态（关卡 + 玩家 + 敌人 + 游戏状态 + 渲染缓冲）
// ===========================================================================

// ---- 关卡瓦片地图 ----
int g_mapW = 0
int g_mapH = 0
array<int> g_tiles = array[]    // g_tiles[row * g_mapW + col]
int g_exitCol = 0               // 出口所在瓦片列
int g_exitRow = 0               // 出口所在瓦片行

// ---- 玩家（单实体，用一组全局变量）----
float g_px = 0.0                // 左上角 X（瓦片坐标）
float g_py = 0.0                // 左上角 Y
float g_pvx = 0.0               // 水平速度
float g_pvy = 0.0               // 竖直速度
float g_pw = 0.8                // 碰撞盒宽
float g_ph = 0.95               // 碰撞盒高
int g_php = 0                   // 当前血量
int g_phpMax = 0                // 最大血量
bool g_pOnGround = false        // 是否触地
bool g_pFacingLeft = false      // 是否朝左
int g_pInvuln = 0               // 无敌帧剩余
int g_pCoyote = 0               // 土狼时间剩余
bool g_pAlive = true            // 是否存活

// ---- 敌人（并行数组，下标 = 敌人槽位）----
array<bool>  g_eAlive    = array[]
array<float> g_eX        = array[]
array<float> g_eY        = array[]
array<float> g_eVX       = array[]
array<float> g_eVY       = array[]
array<int>   g_eState    = array[]
array<float> g_eAnchorX  = array[]
array<int>   g_eDir      = array[]      // 1 = 朝右, -1 = 朝左
array<bool>  g_eOnGround = array[]
array<float> g_eW        = array[]
array<float> g_eH        = array[]

// ---- 游戏状态 ----
int g_score = 0
int g_coinsTotal = 0            // 关卡金币总数
int g_coinsCollected = 0        // 已收集金币数
int g_frame = 0                 // 当前帧号
bool g_gameOver = false
bool g_victory = false
string g_statusMsg = ""

// ---- 渲染缓冲 + 摄像机 ----
array<string> g_screen = array[]   // 长度 = g_viewW * g_viewH
int g_camCol = 0
int g_camRow = 0

// ===========================================================================
// 3. 内置关卡（字符串地图）
//    '#' 墙  '.' 空  '^' 尖刺  '$' 金币  'G' 出口  '=' 单向平台
//    'P' 玩家出生  'M' 敌人出生
//    行宽可不一致，loadLevel 以最长行为准并向右补空，边界自动密封成墙。
// ===========================================================================

array<string> DEMO_LEVEL = array[
    "                                                              ",
    "                                                              ",
    "   $$$$                               $$$$                    ",
    "   ====                               ====                    ",
    "                                                              ",
    "              ======                       ======             ",
    "                                                              ",
    "       $$$                                       $$$          ",
    "       ===                                       ===          ",
    "                                                              ",
    "                                                              ",
    " P  $$    M   $$  ^^^^  $$   M   $$  ^^^^  $$   M  $$      G  ",
    "                                                              "
]

// 一个更紧凑的测试用小关卡（用于全场景跑帧测试）
array<string> MINI_LEVEL = array[
    "                ",
    "                ",
    "  P   $    M  G ",
    "                ",
    "################"
]

// ===========================================================================
// 4. 通用工具函数
// ===========================================================================

// 构造长度为 n、初值 v 的 int 数组。
func makeInt(int n, int v) as array<int>
    if n <= 0 then
        return array[]
    end
    array<int> a = array[v]
    int i = 1
    while i < n
        a.push(v)
        i += 1
    end
    return a
end

// 构造长度为 n、初值 v 的 float 数组。
func makeFloat(int n, float v) as array<float>
    if n <= 0 then
        return array[]
    end
    array<float> a = array[v]
    int i = 1
    while i < n
        a.push(v)
        i += 1
    end
    return a
end

// 构造长度为 n、初值 v 的 bool 数组。
func makeBool(int n, bool v) as array<bool>
    if n <= 0 then
        return array[]
    end
    array<bool> a = array[v]
    int i = 1
    while i < n
        a.push(v)
        i += 1
    end
    return a
end

// 构造长度为 n、初值 v 的 string 数组。
func makeStr(int n, string v) as array<string>
    if n <= 0 then
        return array[]
    end
    array<string> a = array[v]
    int i = 1
    while i < n
        a.push(v)
        i += 1
    end
    return a
end

// int 裁剪到 [lo, hi]。
func clampI(int v, int lo, int hi) as int
    if v < lo then
        return lo
    end
    if v > hi then
        return hi
    end
    return v
end

// float 裁剪到 [lo, hi]。
func clampF(float v, float lo, float hi) as float
    return math.clamp(v, lo, hi)
end

// 向下取整为 int。
func floorI(float x) as int
    return int(math.floor(x))
end

// float 绝对值。
func absF(float v) as float
    return math.abs(v)
end

// int 绝对值。
func absI(int v) as int
    if v < 0 then
        return 0 - v
    end
    return v
end

// 两个 float 近似相等（容差 eps）。
func approxF(float a, float b, float eps) as bool
    return absF(a - b) < eps
end

// ===========================================================================
// 5. 关卡管理：重置 / 加载 / 瓦片访问
// ===========================================================================

// 把整个游戏状态清零（测试间隔离 / 加载新关卡前调用）。
func resetGame()
    g_mapW = 0
    g_mapH = 0
    g_tiles.clear()
    g_exitCol = 0
    g_exitRow = 0

    g_eAlive.clear()
    g_eX.clear()
    g_eY.clear()
    g_eVX.clear()
    g_eVY.clear()
    g_eState.clear()
    g_eAnchorX.clear()
    g_eDir.clear()
    g_eOnGround.clear()
    g_eW.clear()
    g_eH.clear()

    g_px = 0.0
    g_py = 0.0
    g_pvx = 0.0
    g_pvy = 0.0
    g_pw = 0.8
    g_ph = 0.95
    g_php = PLAYER_HP
    g_phpMax = PLAYER_HP
    g_pOnGround = false
    g_pFacingLeft = false
    g_pInvuln = 0
    g_pCoyote = 0
    g_pAlive = true

    g_score = 0
    g_coinsTotal = 0
    g_coinsCollected = 0
    g_frame = 0
    g_gameOver = false
    g_victory = false
    g_statusMsg = ""

    g_camCol = 0
    g_camRow = 0
    g_screen = makeStr(g_viewW * g_viewH, " ")
end

// 在尾部追加一个敌人槽位，返回其下标。
func addEnemy(float x, float y) as int
    int idx = g_eAlive.length
    g_eAlive.push(true)
    g_eX.push(x)
    g_eY.push(y)
    g_eVX.push(0.0)
    g_eVY.push(0.0)
    g_eState.push(ST_PATROL)
    g_eAnchorX.push(x)
    g_eDir.push(1)
    g_eOnGround.push(false)
    g_eW.push(0.85)
    g_eH.push(0.85)
    return idx
end

// 取瓦片（越界：左右下视为墙，上视为空）。
func tileAt(int col, int row) as int
    if col < 0 or col >= g_mapW then
        return T_WALL
    end
    if row < 0 then
        return T_EMPTY
    end
    if row >= g_mapH then
        return T_WALL
    end
    return g_tiles[row * g_mapW + col]
end

// 写瓦片（越界忽略）。
func setTile(int col, int row, int t)
    if col >= 0 and col < g_mapW and row >= 0 and row < g_mapH then
        g_tiles[row * g_mapW + col] = t
    end
end

// 是否在水平方向阻挡（只有墙）。
func isSolidX(int col, int row) as bool
    return tileAt(col, row) == T_WALL
end

// 从字符串地图构建关卡：解析字符 -> 瓦片/实体，再密封边界。
// 返回 true 表示成功。
func loadLevel(array<string> rows) as bool
    resetGame()
    int h = rows.length
    if h <= 0 then
        return false
    end
    int w = 0
    int i = 0
    while i < h
        int L = string.len(rows[i])
        if L > w then
            w = L
        end
        i += 1
    end
    if w <= 0 then
        return false
    end
    g_mapW = w
    g_mapH = h
    g_tiles = makeInt(w * h, T_EMPTY)

    int totalCoins = 0

    // 第一遍：按字符填充瓦片 / 生成实体
    int r = 0
    while r < h
        string row = rows[r]
        int len = string.len(row)
        int c = 0
        while c < w
            string ch = " "
            if c < len then
                ch = string.charAt(row, c)
            end
            int t = T_EMPTY
            if ch == "#" then
                t = T_WALL
            elseif ch == "^" then
                t = T_SPIKE
            elseif ch == "$" then
                t = T_COIN
                totalCoins += 1
            elseif ch == "G" then
                t = T_EXIT
                g_exitCol = c
                g_exitRow = r
            elseif ch == "=" then
                t = T_PLATFORM
            elseif ch == "P" then
                g_px = float(c)
                g_py = float(r)
                t = T_EMPTY
            elseif ch == "M" then
                addEnemy(float(c), float(r))
                t = T_EMPTY
            end
            g_tiles[r * w + c] = t
            c += 1
        end
        r += 1
    end

    // 第二遍：密封边界为墙（保留已存在的出口瓦片）
    int c2 = 0
    while c2 < w
        int topIdx = 0 * w + c2
        int botIdx = (h - 1) * w + c2
        if g_tiles[topIdx] != T_EXIT then
            g_tiles[topIdx] = T_WALL
        end
        if g_tiles[botIdx] != T_EXIT then
            g_tiles[botIdx] = T_WALL
        end
        c2 += 1
    end
    int r2 = 0
    while r2 < h
        int leftIdx = r2 * w + 0
        int rightIdx = r2 * w + (w - 1)
        if g_tiles[leftIdx] != T_EXIT then
            g_tiles[leftIdx] = T_WALL
        end
        if g_tiles[rightIdx] != T_EXIT then
            g_tiles[rightIdx] = T_WALL
        end
        r2 += 1
    end

    g_coinsTotal = totalCoins
    g_screen = makeStr(g_viewW * g_viewH, " ")
    return true
end

// ===========================================================================
// 6. AABB 碰撞工具
// ===========================================================================

// 两个轴对齐包围盒是否重叠（坐标 + 宽高）。
func aabbRaw(float ax, float ay, float aw, float ah,
             float bx, float by, float bw, float bh) as bool
    if ax + aw <= bx then
        return false
    end
    if bx + bw <= ax then
        return false
    end
    if ay + ah <= by then
        return false
    end
    if by + bh <= ay then
        return false
    end
    return true
end

// 某个 AABB 是否与任意指定类型的瓦片重叠。
func overlapsTileType(float x, float y, float w, float h, int tileType) as bool
    int colL = floorI(x)
    int colR = floorI(x + w - 0.0001)
    int rowT = floorI(y)
    int rowB = floorI(y + h - 0.0001)
    int r = rowT
    while r <= rowB
        int c = colL
        while c <= colR
            if tileAt(c, r) == tileType then
                if aabbRaw(x, y, w, h, float(c), float(r), 1.0, 1.0) then
                    return true
                end
            end
            c += 1
        end
        r += 1
    end
    return false
end

// ===========================================================================
// 7. 物理引擎：重力 / 跳跃 / AABB 瓦片碰撞（轴分离）
//    physicsMove 接收当前位置与速度，返回碰撞后的新位置/速度/是否触地。
//    玩家与敌人都复用同一个核心函数（多返回值回写）。
// ===========================================================================

// 单步轴分离碰撞移动。返回 (newX, newY, newVx, newVy, onGround)。
// 调用前应已把重力/摩擦/水平输入累加到 vx/vy 中。
func physicsMove(float x, float y, float vx, float vy, float w, float h) as (float, float, float, float, bool)
    bool onGround = false

    // ---- X 轴 ----
    if vx != 0.0 then
        x = x + vx
        int colL = floorI(x)
        int colR = floorI(x + w - 0.0001)
        int rowT = floorI(y)
        int rowB = floorI(y + h - 0.0001)
        if vx > 0.0 then
            // 向右：探测右侧列
            int probe = colR
            int r = rowT
            bool blocked = false
            while r <= rowB
                if isSolidX(probe, r) then
                    blocked = true
                end
                r += 1
            end
            if blocked then
                x = float(probe) - w
                vx = 0.0
            end
        else
            // 向左：探测左侧列
            int probe = colL
            int r = rowT
            bool blocked = false
            while r <= rowB
                if isSolidX(probe, r) then
                    blocked = true
                end
                r += 1
            end
            if blocked then
                x = float(probe + 1)
                vx = 0.0
            end
        end
    end

    // ---- Y 轴 ----
    if vy != 0.0 then
        float oldY = y
        y = y + vy
        int colL = floorI(x)
        int colR = floorI(x + w - 0.0001)
        if vy > 0.0 then
            // 下落：探测底部行
            int probe = floorI(y + h - 0.0001)
            int c = colL
            while c <= colR
                int t = tileAt(c, probe)
                bool hit = false
                if t == T_WALL then
                    hit = true
                end
                if t == T_PLATFORM then
                    // 单向平台：仅当上一帧脚在平台上方时阻挡
                    float oldFeet = oldY + h
                    if float(probe) + 0.0001 >= oldFeet then
                        hit = true
                    end
                end
                if hit then
                    y = float(probe) - h
                    vy = 0.0
                    onGround = true
                end
                c += 1
            end
        else
            // 上升：探测顶部行（只被实心墙挡）
            int probe = floorI(y)
            int c = colL
            while c <= colR
                int t = tileAt(c, probe)
                if t == T_WALL then
                    y = float(probe + 1)
                    vy = 0.0
                end
                c += 1
            end
        end
    end

    // ---- 地图边界夹紧 ----
    if x < 0.0 then
        x = 0.0
        vx = 0.0
    end
    if x + w > float(g_mapW) then
        x = float(g_mapW) - w
        vx = 0.0
    end
    if y + h > float(g_mapH) then
        y = float(g_mapH) - h
        vy = 0.0
        onGround = true
    end
    if y < 0.0 then
        y = 0.0
        vy = 0.0
    end

    return x, y, vx, vy, onGround
end

// ===========================================================================
// 8. 玩家更新（输入 -> 速度 -> 物理）
// ===========================================================================

// 把一个动作码应用到玩家：设置水平速度、处理跳跃，再做物理积分。
func updatePlayer(int action)
    // 重力
    g_pvy = g_pvy + GRAVITY
    if g_pvy > MAX_FALL then
        g_pvy = MAX_FALL
    end

    // 解析动作
    bool wantLeft  = (action == ACT_LEFT or action == ACT_JUMP_LEFT)
    bool wantRight = (action == ACT_RIGHT or action == ACT_JUMP_RIGHT)
    bool wantJump  = (action == ACT_JUMP or action == ACT_JUMP_LEFT or action == ACT_JUMP_RIGHT)

    // 水平：直接设速（比加速度更可控，便于 demo）
    if wantLeft then
        g_pvx = 0.0 - MOVE_SPEED
        g_pFacingLeft = true
    elseif wantRight then
        g_pvx = MOVE_SPEED
        g_pFacingLeft = false
    else
        // 摩擦减速
        if g_pOnGround then
            g_pvx = g_pvx * FRICTION_GROUND
        else
            g_pvx = g_pvx * FRICTION_AIR
        end
        if absF(g_pvx) < 0.001 then
            g_pvx = 0.0
        end
    end

    // 跳跃：在地面或土狼时间内可起跳
    if wantJump and (g_pOnGround or g_pCoyote > 0) then
        g_pvy = JUMP_VELOCITY
        g_pOnGround = false
        g_pCoyote = 0
    end

    // 物理积分
    float nx = 0.0
    float ny = 0.0
    float nvx = 0.0
    float nvy = 0.0
    bool og = false
    nx, ny, nvx, nvy, og = physicsMove(g_px, g_py, g_pvx, g_pvy, g_pw, g_ph)

    // 土狼时间维护：刚离开地面给宽限帧
    if g_pOnGround and not og then
        g_pCoyote = COYOTE_FRAMES
    elseif og then
        g_pCoyote = 0
    else
        if g_pCoyote > 0 then
            g_pCoyote = g_pCoyote - 1
        end
    end

    g_px = nx
    g_py = ny
    g_pvx = nvx
    g_pvy = nvy
    g_pOnGround = og
end

// ===========================================================================
// 9. 敌人 AI（巡逻 / 追击）+ 物理
// ===========================================================================

func updateEnemies()
    int n = g_eAlive.length
    int i = 0
    while i < n
        if g_eAlive[i] then
            updateOneEnemy(i)
        end
        i += 1
    end
end

// 单个敌人的状态推进 + 物理。
func updateOneEnemy(int i)
    // 重力
    g_eVY[i] = g_eVY[i] + GRAVITY
    if g_eVY[i] > MAX_FALL then
        g_eVY[i] = MAX_FALL
    end

    // 到玩家的距离
    float dx = g_px - g_eX[i]
    float dy = g_py - g_eY[i]
    float dist = math.sqrt(dx * dx + dy * dy)

    // ---- 状态切换 ----
    int state = g_eState[i]
    if state == ST_PATROL then
        if dist < AI_DETECT then
            state = ST_CHASE
        end
    elseif state == ST_CHASE then
        if dist > AI_LEASH then
            state = ST_PATROL
            g_eAnchorX[i] = g_eX[i]
        end
    end
    g_eState[i] = state

    // ---- 水平速度决策 ----
    float dvx = 0.0
    if state == ST_PATROL then
        // 在锚点附近来回走
        float rel = g_eX[i] - g_eAnchorX[i]
        if rel > float(AI_PATROL_RANGE) then
            g_eDir[i] = -1
        elseif rel < 0.0 - float(AI_PATROL_RANGE) then
            g_eDir[i] = 1
        end
        if g_eDir[i] >= 0 then
            dvx = ENEMY_SPEED
        else
            dvx = 0.0 - ENEMY_SPEED
        end
    else
        // 追击：朝玩家方向
        if dx < 0.0 then
            g_eDir[i] = -1
            dvx = 0.0 - ENEMY_SPEED
        else
            g_eDir[i] = 1
            dvx = ENEMY_SPEED
        end
    end
    g_eVX[i] = dvx

    // 追击时若前方有墙且在地面，尝试跳跃翻越
    if state == ST_CHASE and g_eOnGround[i] then
        int dirSign = 1
        if g_eDir[i] < 0 then
            dirSign = -1
        end
        int ahead = floorI(g_eX[i]) + dirSign
        int myrow = floorI(g_eY[i])
        if isSolidX(ahead, myrow) then
            g_eVY[i] = JUMP_VELOCITY
        end
    end

    // 物理积分
    float nx = 0.0
    float ny = 0.0
    float nvx = 0.0
    float nvy = 0.0
    bool og = false
    nx, ny, nvx, nvy, og = physicsMove(g_eX[i], g_eY[i], g_eVX[i], g_eVY[i], g_eW[i], g_eH[i])

    // 撞墙（水平被清零）则翻转方向，下帧朝回走
    if nvx == 0.0 and absF(g_eVX[i]) > 0.001 then
        g_eDir[i] = 0 - g_eDir[i]
    end

    g_eX[i] = nx
    g_eY[i] = ny
    g_eVX[i] = nvx
    g_eVY[i] = nvy
    g_eOnGround[i] = og
end

// ===========================================================================
// 10. 交互系统：无敌帧 / 尖刺 / 金币 / 出口 / 敌人接触 / 死亡
// ===========================================================================

// 对玩家造成伤害（考虑无敌帧），并施加小击退。
func damagePlayer(int amount)
    if g_pInvuln > 0 then
        return
    end
    g_php = g_php - amount
    if g_php < 0 then
        g_php = 0
    end
    g_pInvuln = INVULN_FRAMES
    g_pvy = KNOCKBACK_VY
    g_statusMsg = "ouch! -" + string(amount)
end

// 收集玩家当前覆盖的所有金币瓦片。
func collectCoinTile()
    int colL = floorI(g_px)
    int colR = floorI(g_px + g_pw - 0.0001)
    int rowT = floorI(g_py)
    int rowB = floorI(g_py + g_ph - 0.0001)
    int r = rowT
    while r <= rowB
        int c = colL
        while c <= colR
            if tileAt(c, r) == T_COIN then
                if aabbRaw(g_px, g_py, g_pw, g_ph, float(c), float(r), 1.0, 1.0) then
                    setTile(c, r, T_EMPTY)
                    g_score += COIN_SCORE
                    g_coinsCollected += 1
                    g_statusMsg = "coin +" + string(COIN_SCORE)
                end
            end
            c += 1
        end
        r += 1
    end
end

// 处理玩家与场景/敌人的一帧交互。
func handleInteractions()
    // 无敌帧倒数
    if g_pInvuln > 0 then
        g_pInvuln = g_pInvuln - 1
    end

    // 尖刺伤害
    if overlapsTileType(g_px, g_py, g_pw, g_ph, T_SPIKE) then
        damagePlayer(1)
    end

    // 金币收集
    collectCoinTile()

    // 出口 -> 胜利
    if overlapsTileType(g_px, g_py, g_pw, g_ph, T_EXIT) then
        if not g_victory then
            g_victory = true
            g_statusMsg = "reached exit!"
        end
    end

    // 与敌人接触 -> 伤害
    int n = g_eAlive.length
    int i = 0
    while i < n
        if g_eAlive[i] then
            if aabbRaw(g_px, g_py, g_pw, g_ph,
                       g_eX[i], g_eY[i], g_eW[i], g_eH[i]) then
                damagePlayer(1)
            end
        end
        i += 1
    end

    // 玩家死亡
    if g_php <= 0 and not g_gameOver then
        g_gameOver = true
        g_statusMsg = "player defeated"
        g_pAlive = false
    end
end

// ===========================================================================
// 11. 渲染：摄像机 + ASCII 屏幕缓冲
// ===========================================================================

// 瓦片 -> 字符。
func tileChar(int t) as string
    if t == T_WALL then
        return "#"
    end
    if t == T_SPIKE then
        return "^"
    end
    if t == T_COIN then
        return "$"
    end
    if t == T_EXIT then
        return "G"
    end
    if t == T_PLATFORM then
        return "="
    end
    return " "
end

// 把摄像机对齐玩家（平滑跟随，夹紧到地图内）。
func centerCamera()
    int wantCol = floorI(g_px) - g_viewW / 2
    int wantRow = floorI(g_py) - g_viewH / 2
    if g_mapW > g_viewW then
        g_camCol = clampI(wantCol, 0, g_mapW - g_viewW)
    else
        g_camCol = 0
    end
    if g_mapH > g_viewH then
        g_camRow = clampI(wantRow, 0, g_mapH - g_viewH)
    else
        g_camRow = 0
    end
end

// 清空屏幕缓冲。
func clearScreen()
    int n = g_screen.length
    int i = 0
    while i < n
        g_screen[i] = " "
        i += 1
    end
end

// 向视口写入一个字符（越界忽略）。
func putCell(int col, int row, string ch)
    if col < 0 or col >= g_viewW then
        return
    end
    if row < 0 or row >= g_viewH then
        return
    end
    g_screen[row * g_viewW + col] = ch
end

// 把瓦片和实体画到屏幕缓冲。
func renderScene()
    clearScreen()

    // 1) 瓦片
    int r = 0
    while r < g_viewH
        int c = 0
        while c < g_viewW
            int wc = g_camCol + c
            int wr = g_camRow + r
            int t = tileAt(wc, wr)
            if t != T_EMPTY then
                putCell(c, r, tileChar(t))
            end
            c += 1
        end
        r += 1
    end

    // 2) 敌人
    int i = 0
    while i < g_eAlive.length
        if g_eAlive[i] then
            int col = floorI(g_eX[i]) - g_camCol
            int row = floorI(g_eY[i]) - g_camRow
            putCell(col, row, "M")
        end
        i += 1
    end

    // 3) 玩家（受伤时闪烁）
    if g_pAlive then
        int pcol = floorI(g_px) - g_camCol
        int prow = floorI(g_py) - g_camRow
        string pch = "@"
        if g_pInvuln > 0 then
            if (g_pInvuln / 4) % 2 == 0 then
                pch = "@"
            else
                pch = "x"
            end
        end
        putCell(pcol, prow, pch)
    end
end

// 把屏幕缓冲拼成单个多行字符串（带边框和 HUD）。
func renderToString() as string
    string border = "+" + string.repeat("-", g_viewW) + "+"
    string outputValue = border + "\n"
    int r = 0
    while r < g_viewH
        string line = "|"
        int c = 0
        while c < g_viewW
            line = line + g_screen[r * g_viewW + c]
            c += 1
        end
        line = line + "|"
        outputValue = outputValue + line + "\n"
        r += 1
    end
    outputValue = outputValue + border + "\n"

    // HUD
    string hpBar = ""
    int k = 0
    while k < g_php
        hpBar = hpBar + "*"
        k += 1
    end
    string hud = ("frame " + string(g_frame) +
                 "  hp[" + hpBar + "]" +
                 "  score " + string(g_score) +
                 "  coins " + string(g_coinsCollected) + "/" + string(g_coinsTotal))
    if g_gameOver then
        hud = hud + "  [GAME OVER]"
    end
    if g_victory then
        hud = hud + "  [VICTORY]"
    end
    if string.len(g_statusMsg) > 0 then
        hud = hud + "  | " + g_statusMsg
    end
    outputValue = outputValue + hud + "\n"
    return outputValue
end

// ===========================================================================
// 12. 游戏循环：单帧推进
// ===========================================================================

// 推进一帧：应用动作 -> 玩家物理 -> 敌人 AI -> 交互 -> 摄像机。
// 游戏已结束/胜利时直接返回（保持终帧状态）。
func stepFrame(int action)
    if g_gameOver or g_victory then
        return
    end
    updatePlayer(action)
    updateEnemies()
    handleInteractions()
    centerCamera()
    g_frame += 1
end

// ===========================================================================
// 13. 自动玩家（启发式 AI 跑关）
//    朝出口方向走；前方有墙/坑/尖刺/敌人则在地面时跳跃。
// ===========================================================================

func decideAction() as int
    if g_gameOver or g_victory then
        return ACT_NONE
    end

    // 朝出口的基础方向
    int baseDir = ACT_RIGHT
    int dirSign = 1
    if float(g_exitCol) < g_px - 0.5 then
        baseDir = ACT_LEFT
        dirSign = -1
    end

    int myRow = floorI(g_py)
    int aheadCol = floorI(g_px) + dirSign
    int aheadCol2 = aheadCol + dirSign
    int belowCol = floorI(g_px + 0.4) + dirSign

    // 前方检测
    bool wallAhead = isSolidX(aheadCol, myRow) or isSolidX(aheadCol, myRow - 1)
    bool spikeAhead = (tileAt(aheadCol, myRow) == T_SPIKE) or (tileAt(aheadCol2, myRow) == T_SPIKE)
    bool pitAhead = not isSolidX(belowCol, myRow + 1)

    // 前方是否有敌人
    bool enemyAhead = false
    int i = 0
    while i < g_eAlive.length
        if g_eAlive[i] then
            float dx = g_eX[i] - g_px
            float dy = g_eY[i] - g_py
            if dirSign > 0 and dx > 0.0 and dx < 2.4 and absF(dy) < 1.4 then
                enemyAhead = true
            end
            if dirSign < 0 and dx < 0.0 and dx > -2.4 and absF(dy) < 1.4 then
                enemyAhead = true
            end
        end
        i += 1
    end

    // 在地面时判断是否需要跳跃
    if g_pOnGround then
        if wallAhead or spikeAhead or pitAhead or enemyAhead then
            if dirSign > 0 then
                return ACT_JUMP_RIGHT
            else
                return ACT_JUMP_LEFT
            end
        end
    end

    return baseDir
end

// ===========================================================================
// 14. Demo 主循环（自动玩家跑关）
// ===========================================================================

func runDemo(int frames) as int
    if frames <= 0 then
        frames = 200
    end

    loadLevel(DEMO_LEVEL)
    centerCamera()
    g_statusMsg = "demo start"

    println("================================================================")
    println(" xplatformer - ASCII Platformer Demo")
    println(" @ = player   M = enemy   # = wall   ^ = spike   $ = coin   G = exit")
    println(" map " + string(g_mapW) + "x" + string(g_mapH) +
            "   enemies " + string(g_eAlive.length) +
            "   coins " + string(g_coinsTotal) +
            "   running " + string(frames) + " frames (auto-player)")
    println("================================================================")

    int still = 0
    float lastX = g_px
    float lastY = g_py

    while g_frame < frames
        int act = decideAction()
        stepFrame(act)

        // 渲染节奏
        if g_frame % RENDER_EVERY == 0 then
            renderScene()
            print(renderToString())
        end

        // 卡死检测
        if absF(g_px - lastX) < 0.01 and absF(g_py - lastY) < 0.01 then
            still += 1
        else
            still = 0
        end
        lastX = g_px
        lastY = g_py

        if g_victory then
            println("[demo] victory at frame " + string(g_frame))
            break
        end
        if g_gameOver then
            println("[demo] game over at frame " + string(g_frame))
            break
        end

        // 卡死保护：自动跳一下
        if still > 20 then
            stepFrame(ACT_JUMP)
            still = 0
        end
    end

    println("----------------------------------------------------------------")
    string result = "TIMEOUT"
    if g_victory then
        result = "VICTORY"
    elseif g_gameOver then
        result = "GAMEOVER"
    end
    println(" demo finished: frame=" + string(g_frame) +
            "  score=" + string(g_score) +
            "  coins=" + string(g_coinsCollected) + "/" + string(g_coinsTotal) +
            "  hp=" + string(g_php) +
            "  result=" + result)
    return 0
end

// ===========================================================================
// 15. 测试套件
// ===========================================================================

int g_pass = 0
int g_fail = 0

// 断言辅助：打印 [PASS]/[FAIL] 并累计计数。
func check(string name, bool ok) as bool
    if ok then
        g_pass += 1
        println("  [PASS] " + name)
    else
        g_fail += 1
        println("  [FAIL] " + name)
    end
    return ok
end

// 让玩家在当前关卡中自由下落直到站定（用于物理测试）。
func settlePlayer(int maxFrames)
    int guard = 0
    while guard < maxFrames
        updatePlayer(ACT_NONE)
        if g_pOnGround and absF(g_pvy) < 0.001 then
            return
        end
        guard += 1
    end
end

// T1: loadLevel 正确解析维度与瓦片
func testLoadLevel() as bool
    println("[T1] loadLevel parses dimensions and tiles")
    array<string> rows = array[
        "###",
        "#.#",
        "#$#",
        "###"
    ]
    bool loaded = loadLevel(rows)
    bool ok = check("loadLevel returns true", loaded)
    ok = check("mapW == 3", g_mapW == 3) and ok
    ok = check("mapH == 4", g_mapH == 4) and ok
    ok = check("center tile is empty", tileAt(1, 1) == T_EMPTY) and ok
    ok = check("coin tile parsed", tileAt(1, 2) == T_COIN) and ok
    ok = check("coinsTotal == 1", g_coinsTotal == 1) and ok
    // 边界被密封为墙
    ok = check("corner sealed as wall", tileAt(0, 0) == T_WALL) and ok
    return ok
end

// T2: tileAt 越界处理
func testTileBounds() as bool
    println("[T2] tileAt bounds handling")
    loadLevel(array["   ", "   ", "   "])
    bool ok = check("left of map is wall", tileAt(-1, 1) == T_WALL)
    ok = check("right of map is wall", tileAt(3, 1) == T_WALL) and ok
    ok = check("above map is empty", tileAt(1, -1) == T_EMPTY) and ok
    ok = check("below map is wall", tileAt(1, 3) == T_WALL) and ok
    return ok
end

// T3: isSolidX 仅墙阻挡
func testIsSolid() as bool
    println("[T3] isSolidX only wall blocks horizontally")
    loadLevel(array["     ", "     ", "     ", "     ", "     "])
    setTile(1, 1, T_WALL)
    setTile(2, 1, T_SPIKE)
    bool ok = check("wall is solid", isSolidX(1, 1))
    ok = check("spike not solid", not isSolidX(2, 1)) and ok
    ok = check("empty not solid", not isSolidX(3, 3)) and ok
    return ok
end

// T4: AABB 重叠检测
func testAABB() as bool
    println("[T4] AABB overlap detection")
    bool ok = check("overlap true", aabbRaw(0.0, 0.0, 1.0, 1.0, 0.5, 0.5, 1.0, 1.0))
    ok = check("overlap false", not aabbRaw(0.0, 0.0, 1.0, 1.0, 5.0, 5.0, 1.0, 1.0)) and ok
    ok = check("edge-touch not overlapping", not aabbRaw(0.0, 0.0, 1.0, 1.0, 1.0, 0.0, 1.0, 1.0)) and ok
    return ok
end

// T5: 物理重力使下落速度增加并被钳制（用 30 行地图保证落地前测到终端速度）
func testPhysicsGravity() as bool
    println("[T5] physics gravity accelerates and clamps")
    loadLevel(array[
        "                              ", "                              ",
        "                              ", "                              ",
        "                              ", "                              ",
        "                              ", "                              ",
        "                              ", "                              ",
        "                              ", "                              ",
        "                              ", "                              ",
        "                              ", "                              ",
        "                              ", "                              ",
        "                              ", "                              ",
        "                              ", "                              ",
        "                              ", "                              ",
        "                              ", "                              ",
        "                              ", "                              ",
        "                              ", "                              ",
        "                              ", "                              "
    ])
    g_px = 1.0
    g_py = 0.0
    g_pvx = 0.0
    g_pvy = 0.0
    g_pw = 1.0
    g_ph = 1.0
    updatePlayer(ACT_NONE)
    bool ok = check("vy increased by gravity", approxF(g_pvy, GRAVITY, 0.0001))
    // 再跑 40 帧：应到达终端速度 MAX_FALL 且仍在空中（未触地）
    int k = 0
    while k < 40
        updatePlayer(ACT_NONE)
        k += 1
    end
    ok = check("vy clamped to MAX_FALL", approxF(g_pvy, MAX_FALL, 0.001)) and ok
    ok = check("still airborne", not g_pOnGround) and ok
    ok = check("posY descended", g_py > 0.0) and ok
    return ok
end

// T6: 玩家落到地面后 onGround=true 且竖直速度归零
func testPhysicsLanding() as bool
    println("[T6] player lands on solid ground")
    // 8 行高，最后一行（行 7）会被密封为墙地板
    loadLevel(array["        ", "        ", "        ", "        ",
                    "        ", "        ", "        ", "        "])
    g_px = 3.0
    g_py = 0.0
    g_pvx = 0.0
    g_pvy = 0.0
    g_pw = 1.0
    g_ph = 1.0
    settlePlayer(200)
    // 地板在行 7，玩家高 1.0 -> y = 7 - 1 = 6
    bool ok = check("landed on floor (posY ~ 6.0)", approxF(g_py, 6.0, 0.001))
    ok = check("onGround set", g_pOnGround) and ok
    ok = check("vy ~ 0", absF(g_pvy) < 0.001) and ok
    return ok
end

// T7: 水平撞墙被阻挡
func testPhysicsWallBlock() as bool
    println("[T7] horizontal movement blocked by wall")
    loadLevel(array["        ", "        ", "        ", "        ",
                    "        ", "        ", "        ", "        "])
    setTile(6, 6, T_WALL)       // 在站立行右侧立一堵墙
    g_px = 3.0
    g_py = 6.0
    g_pvx = 0.0
    g_pvy = 0.0
    g_pw = 1.0
    g_ph = 1.0
    settlePlayer(100)           // 先站定
    // 持续向右走
    int k = 0
    while k < 20
        updatePlayer(ACT_RIGHT)
        k += 1
    end
    bool ok = check("stopped before wall (posX <= 5)", g_px <= 5.0 + 0.001)
    ok = check("vx zeroed", absF(g_pvx) < 0.001) and ok
    return ok
end

// T8: 单向平台仅从上方阻挡
func testOneWayPlatform() as bool
    println("[T8] one-way platform blocks only from above")
    loadLevel(array["      ", "      ", "      ", "      ", "      ", "      "])
    setTile(2, 4, T_PLATFORM)
    g_px = 2.0
    g_py = 0.0
    g_pvx = 0.0
    g_pvy = 0.0
    g_pw = 1.0
    g_ph = 1.0
    settlePlayer(200)
    // 平台在行 4，玩家高 1.0 -> 应停在 y = 3
    bool ok = check("landed on platform (posY ~ 3.0)", approxF(g_py, 3.0, 0.001))
    ok = check("onGround set", g_pOnGround) and ok
    return ok
end

// T9: 玩家在地面起跳 -> vy 为负
func testPlayerJump() as bool
    println("[T9] player jumps when on ground")
    // 用高地图保证起跳后不撞顶
    loadLevel(array["          ", "          ", "          ", "          ",
                    "          ", "          ", "          ", "          ",
                    "          ", "          "])
    g_px = 3.0
    g_py = 0.0
    g_pvx = 0.0
    g_pvy = 0.0
    g_pw = 1.0
    g_ph = 1.0
    settlePlayer(200)
    bool ok = check("on ground before jump", g_pOnGround)
    updatePlayer(ACT_JUMP)
    ok = check("vy == JUMP_VELOCITY after jump", approxF(g_pvy, JUMP_VELOCITY, 0.0001)) and ok
    ok = check("airborne after jump", not g_pOnGround) and ok
    return ok
end

// T10: 空中无法再次起跳
func testPlayerNoDoubleJump() as bool
    println("[T10] no double jump while airborne")
    loadLevel(array["          ", "          ", "          ", "          ",
                    "          ", "          ", "          ", "          ",
                    "          ", "          "])
    g_px = 3.0
    g_py = 0.0
    g_pvx = 0.0
    g_pvy = 0.0
    g_pw = 1.0
    g_ph = 1.0
    settlePlayer(200)
    updatePlayer(ACT_JUMP)              // 第一次起跳
    bool ok = check("airborne after first jump", not g_pOnGround)
    float vyAfterFirst = g_pvy
    updatePlayer(ACT_JUMP)              // 空中再按跳
    // 不应重新获得 JUMP_VELOCITY，而应继续受重力影响（vy 变大/更接近 0）
    ok = check("second jump does not reset vy", not approxF(g_pvy, JUMP_VELOCITY, 0.0001)) and ok
    ok = check("vy changed (gravity applied)", g_pvy != vyAfterFirst) and ok
    return ok
end

// T11: 左右动作设置水平速度
func testPlayerMoveAction() as bool
    println("[T11] move actions set horizontal velocity")
    loadLevel(array["          ", "          ", "          ", "          ",
                    "          ", "          ", "          ", "          "])
    g_px = 3.0
    g_py = 6.0
    g_pvx = 0.0
    g_pvy = 0.0
    g_pw = 1.0
    g_ph = 1.0
    settlePlayer(100)
    updatePlayer(ACT_RIGHT)
    bool ok = check("ACT_RIGHT sets +vx", approxF(g_pvx, MOVE_SPEED, 0.0001))
    updatePlayer(ACT_LEFT)
    ok = check("ACT_LEFT sets -vx", approxF(g_pvx, 0.0 - MOVE_SPEED, 0.0001)) and ok
    return ok
end

// T12: 金币收集加分并清空瓦片
func testCoinPickup() as bool
    println("[T12] coin pickup increments score and clears tile")
    loadLevel(array["        ", "        ", "        ", "        ", "        ", "        ", "        ", "        "])
    setTile(3, 6, T_COIN)
    g_coinsTotal = 1
    g_px = 3.0
    g_py = 6.0
    g_pvx = 0.0
    g_pvy = 0.0
    g_pw = 1.0
    g_ph = 1.0
    g_pOnGround = true
    collectCoinTile()
    bool ok = check("score == COIN_SCORE", g_score == COIN_SCORE)
    ok = check("coinsCollected == 1", g_coinsCollected == 1) and ok
    ok = check("coin tile cleared", tileAt(3, 6) == T_EMPTY) and ok
    return ok
end

// T13: 尖刺伤害 + 无敌帧防止连扣
func testSpikeDamage() as bool
    println("[T13] spike damages player, iframes prevent repeat")
    loadLevel(array["        ", "        ", "        ", "        ", "        ", "        ", "        ", "        "])
    setTile(3, 6, T_SPIKE)
    g_px = 3.0
    g_py = 6.0
    g_pvx = 0.0
    g_pvy = 0.0
    g_pw = 1.0
    g_ph = 1.0
    g_pOnGround = true
    int hp0 = g_php
    handleInteractions()
    bool ok = check("hp reduced by spike", g_php == hp0 - 1)
    ok = check("iframes > 0", g_pInvuln > 0) and ok
    int hp1 = g_php
    handleInteractions()
    ok = check("no damage during iframes", g_php == hp1) and ok
    return ok
end

// T14: 与敌人接触造成伤害
func testEnemyContactDamage() as bool
    println("[T14] enemy contact damages player")
    loadLevel(array["        ", "        ", "        ", "        "])
    g_px = 3.0
    g_py = 6.0
    g_pvx = 0.0
    g_pvy = 0.0
    g_pw = 1.0
    g_ph = 1.0
    g_pOnGround = true
    addEnemy(3.3, 6.0)
    int hp0 = g_php
    handleInteractions()
    bool ok = check("hp reduced by enemy contact", g_php == hp0 - 1)
    return ok
end

// T15: 触碰出口触发胜利
func testExitVictory() as bool
    println("[T15] exit tile triggers victory")
    loadLevel(array["        ", "        ", "        ", "        ", "        ", "        ", "        ", "        "])
    setTile(3, 6, T_EXIT)
    g_exitCol = 3
    g_exitRow = 6
    g_px = 3.0
    g_py = 6.0
    g_pvx = 0.0
    g_pvy = 0.0
    g_pw = 1.0
    g_ph = 1.0
    g_pOnGround = true
    handleInteractions()
    bool ok = check("victory flag set", g_victory)
    return ok
end

// T16: 敌人巡逻在锚点边界翻转方向
func testEnemyPatrolFlip() as bool
    println("[T16] patrol enemy flips direction at patrol bound")
    // 宽地图 + 长地板，让敌人能自由巡逻
    loadLevel(array["                ", "                ", "                ",
                    "                ", "                ", "                ",
                    "                ", "                "])
    addEnemy(5.0, 6.0)
    int idx = 0
    g_eAnchorX[idx] = 5.0
    g_eDir[idx] = 1
    g_eState[idx] = ST_PATROL
    g_eOnGround[idx] = true
    int initDir = g_eDir[idx]
    // 跑足够多帧，敌人应走到锚点 +PATROL_RANGE 之外并翻转
    int k = 0
    bool flipped = false
    int lastDir = initDir
    while k < 400
        updateOneEnemy(idx)
        if g_eDir[idx] != lastDir then
            flipped = true
        end
        lastDir = g_eDir[idx]
        k += 1
    end
    bool ok = check("enemy moved from spawn", absF(g_eX[idx] - 5.0) > 0.5)
    // 在巡逻过程中方向至少翻转过一次（与初始方向不同 或 曾被墙夹紧）
    ok = check("enemy flipped direction during patrol", flipped) and ok
    return ok
end

// T17: 敌人发现玩家进入追击，远离后回到巡逻
func testEnemyChaseState() as bool
    println("[T17] enemy chase state transitions")
    loadLevel(array["                ", "                ", "                ",
                    "                ", "                ", "                ",
                    "                ", "                "])
    addEnemy(5.0, 6.0)
    int idx = 0
    g_eState[idx] = ST_PATROL
    // 玩家靠近 -> 进入追击
    g_px = 7.0
    g_py = 6.0
    g_pw = 1.0
    g_ph = 1.0
    updateOneEnemy(idx)
    bool ok = check("PATROL -> CHASE when player near", g_eState[idx] == ST_CHASE)
    // 玩家走远 -> 回到巡逻
    g_px = 50.0
    int k = 0
    while k < 2
        updateOneEnemy(idx)
        k += 1
    end
    ok = check("CHASE -> PATROL when player far", g_eState[idx] == ST_PATROL) and ok
    return ok
end

// T18: 渲染把玩家字符写入屏幕缓冲
func testRenderPlayer() as bool
    println("[T18] renderScene writes player char to screen")
    loadLevel(array["          ", "          ", "          ", "          ",
                    "          ", "          ", "          ", "          "])
    g_px = 2.0
    g_py = 4.0
    g_pw = 1.0
    g_ph = 1.0
    g_pAlive = true
    g_pInvuln = 0
    centerCamera()
    renderScene()
    int col = floorI(g_px) - g_camCol
    int row = floorI(g_py) - g_camRow
    int idx = row * g_viewW + col
    bool ok = check("player '@' at its cell", g_screen[idx] == "@")
    return ok
end

// T19: 渲染画出墙与出口瓦片
func testRenderTiles() as bool
    println("[T19] renderScene draws wall and exit tiles")
    loadLevel(array["          ", "          ", "          ", "          ",
                    "          ", "          ", "          ", "          "])
    setTile(1, 1, T_WALL)
    setTile(8, 6, T_EXIT)
    centerCamera()
    renderScene()
    int wIdx = 1 * g_viewW + 1
    bool ok = check("wall '#' drawn", g_screen[wIdx] == "#")
    int eCol = 8 - g_camCol
    int eRow = 6 - g_camRow
    if eCol >= 0 and eCol < g_viewW and eRow >= 0 and eRow < g_viewH then
        int eIdx = eRow * g_viewW + eCol
        ok = check("exit 'G' drawn", g_screen[eIdx] == "G") and ok
    else
        ok = check("exit within viewport", false) and ok
    end
    return ok
end

// T20: stepFrame 推进帧号并更新摄像机
func testStepFrame() as bool
    println("[T20] stepFrame advances frame and camera")
    loadLevel(MINI_LEVEL)
    int f0 = g_frame
    stepFrame(ACT_NONE)
    bool ok = check("frame incremented", g_frame == f0 + 1)
    ok = check("camera within map bounds", g_camCol >= 0 and g_camRow >= 0) and ok
    return ok
end

// T21: resetGame 清空所有状态
func testResetGame() as bool
    println("[T21] resetGame clears all state")
    loadLevel(DEMO_LEVEL)
    resetGame()
    bool ok = check("map cleared", g_mapW == 0 and g_mapH == 0)
    ok = check("tiles empty", g_tiles.length == 0) and ok
    ok = check("enemies empty", g_eAlive.length == 0) and ok
    ok = check("score zero", g_score == 0) and ok
    ok = check("frame zero", g_frame == 0) and ok
    ok = check("hp reset to PLAYER_HP", g_php == PLAYER_HP) and ok
    return ok
end

// T22: decideAction 朝出口方向返回合理动作
func testDecideAction() as bool
    println("[T22] decideAction returns sensible action toward exit")
    loadLevel(array["                ", "                ", "                ",
                    "                ", "                ", "                ",
                    "                ", "                "])
    g_px = 2.0
    g_py = 6.0
    g_pw = 1.0
    g_ph = 1.0
    g_pOnGround = true
    g_exitCol = 14
    g_exitRow = 6
    int act = decideAction()
    // 出口在右，无障碍时应返回 ACT_RIGHT
    bool ok = check("returns ACT_RIGHT toward right exit", act == ACT_RIGHT)
    // 出口在左时应返回 ACT_LEFT
    g_exitCol = 0
    g_px = 8.0
    act = decideAction()
    ok = check("returns ACT_LEFT toward left exit", act == ACT_LEFT) and ok
    return ok
end

// T23: 完整小关卡跑多帧不崩溃，玩家能向出口移动
func testFullRun() as bool
    println("[T23] full mini-level runs 60 frames without crash")
    loadLevel(MINI_LEVEL)
    bool crashed = false
    string errMsg = ""
    try
        int f = 0
        while f < 60
            int act = decideAction()
            stepFrame(act)
            if g_victory or g_gameOver then
                break
            end
            f += 1
        end
    catch e
        crashed = true
        errMsg = e.message
    end
    bool ok = check("60 frames without exception", not crashed)
    if crashed then
        println("       exception: " + errMsg)
    end
    return ok
end

// 运行全部测试。
func runAllTests() as int
    g_pass = 0
    g_fail = 0
    println("================================================================")
    println(" xplatformer - Correctness Tests")
    println("================================================================")
    testLoadLevel()
    testTileBounds()
    testIsSolid()
    testAABB()
    testPhysicsGravity()
    testPhysicsLanding()
    testPhysicsWallBlock()
    testOneWayPlatform()
    testPlayerJump()
    testPlayerNoDoubleJump()
    testPlayerMoveAction()
    testCoinPickup()
    testSpikeDamage()
    testEnemyContactDamage()
    testExitVictory()
    testEnemyPatrolFlip()
    testEnemyChaseState()
    testRenderPlayer()
    testRenderTiles()
    testStepFrame()
    testResetGame()
    testDecideAction()
    testFullRun()
    println("----------------------------------------------------------------")
    println(" total " + string(g_pass + g_fail) +
            "   pass " + string(g_pass) +
            "   fail " + string(g_fail))
    if g_fail == 0 then
        println(" ALL TESTS PASSED")
        return 0
    end
    return 1
end

// ===========================================================================
// 16. 用法 & 主入口
// ===========================================================================

func printUsage()
    println("xplatformer - ASCII platformer game")
    println("Usage:")
    println("  xplatformer                       print this help")
    println("  xplatformer demo [frames=200]     run built-in level (auto-player)")
    println("  xplatformer test                  run correctness tests")
    println("  xplatformer -h | --help           print this help")
    println("")
    println("Tiles:")
    println("  @ player   M enemy   # wall   ^ spike   $ coin   G exit   = platform")
    println("")
    println("Physics: gravity / jump / AABB tile collision / one-way platforms")
    println("Enemies: patrol + chase state machine")
    println("Loop:    stepFrame(action) = update + ASCII render")
end

// 判断字符串是否为整数。
func looksInt(string s) as bool
    if string.len(s) == 0 then
        return false
    end
    int i = 0
    while i < string.len(s)
        string ch = string.charAt(s, i)
        if i == 0 and (ch == "-" or ch == "+") then
            i += 1
            continue
        end
        if ch < "0" or ch > "9" then
            return false
        end
        i += 1
    end
    return true
end

func main(...) as int
    if arg.length < 2 then
        printUsage()
        return 1
    end

    string cmd = string(arg[1])

    if cmd == "-h" or cmd == "--help" or cmd == "help" then
        printUsage()
        return 0
    end

    try
        if cmd == "demo" then
            int frames = 200
            if arg.length >= 3 then
                string f = string(arg[2])
                if not looksInt(f) then
                    println("xplatformer: invalid frames: " + f)
                    return 1
                end
                frames = int(f)
                if frames < 0 then
                    frames = 200
                end
            end
            return runDemo(frames)
        elseif cmd == "test" then
            return runAllTests()
        else
            println("xplatformer: unknown command: " + cmd)
            printUsage()
            return 1
        end
    catch e
        println("xplatformer: error: " + e.message)
        return 1
    end
    return 0
end
