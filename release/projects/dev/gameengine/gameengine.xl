// T17: World 瓦片越界处理
func testWorldBounds() as bool
    println("[T17] World tile bounds handling")
    resetRegistry()
    World w = World(5, 5)
    bool ok = check("left of map is wall", w.tileAt(-1, 2) == T_WALL)
    ok = check("right of map is wall", w.tileAt(5, 2) == T_WALL) and ok
    ok = check("above map is empty", w.tileAt(2, -1) == T_EMPTY) and ok
    ok = check("below map is wall", w.tileAt(2, 5) == T_WALL) and ok
    ok = check("isSolidX wall col", w.isSolidX(-1, 2)) and ok
    ok = check("isSolidX empty col", not w.isSolidX(2, 2)) and ok
    return ok
end

// T18: 单向平台（仅从上方阻挡）
func testOneWayPlatform() as bool
    println("[T18] One-way platform blocks only from above")
    resetRegistry()
    int e = createNamed("faller")
    setPosition(e, 2.0, 6.0)
    setVelocity(e, 0.0, 0.0)
    setCollider(e, 1.0, 1.0)
    addComponent(e, C_GRAVITY)
    World w = World(6, 10)
    w.setTile(2, 8, T_PLATFORM)
    PhysicsSystem ps = PhysicsSystem()
    int guard = 0
    while guard < 50
        ps.update(w)
        guard += 1
    end
    bool ok = check("landed on platform (posY ~ 7.0)", absF(g_posY[e] - 7.0) < 0.001)
    ok = check("onGround set on platform", g_onGround[e]) and ok
    return ok
end

// T19: System 多态容器（vtable 派发）
func testSystemPolymorphism() as bool
    println("[T19] System virtual dispatch via array<System>")
    resetRegistry()
    World w = World(10, 10)
    MovementSystem ms = MovementSystem()
    AISystem ai = AISystem()
    CombatSystem combat = CombatSystem()
    RenderSystem render = RenderSystem()
    w.addSystem(ms)
    w.addSystem(ai)
    w.addSystem(combat)
    w.addSystem(render)
    bool ok = check("4 systems registered", w.systems.length == 4)
    // runSystems 直接通过基类引用调用 virtual update。
    runWorldSystems(w)
    ok = check("runSystems executed without crash", true) and ok
    // describe 返回各 System 名字
    System s = w.systems[0]
    ok = check("first system name is Movement", s.name == "Movement") and ok
    return ok
end

// T20: 完整 mini-scene 跑多帧
func testFullSceneRun() as bool
    println("[T20] Full mini-scene runs 30 frames without crash")
    resetRegistry()
    array<string> mini = array[
        "##########",
        "#        #",
        "# P  o  E#",
        "#        #",
        "##########"
    ]
    World w = buildLevel(mini, 10, 5)
    setupSystems(w)
    bool crashed = false
    string errMsg = ""
    try
        int f = 0
        while f < 30
            applyInput(w, IN_RIGHT)
            runWorldSystems(w)
            f += 1
        end
    catch e
        crashed = true
        errMsg = e.message
    end
    bool ok = check("30 frames without exception", not crashed)
    if crashed then
        println("       exception: " + errMsg)
    end
    // 玩家应该向右移动了一些
    if w.player >= 0 then
        ok = check("player moved right", g_posX[w.player] > 1.5) and ok
    end
    return ok
end

// 运行全部测试。
func runAllTests() as int
    g_pass = 0
    g_fail = 0
    println("================================================================")
    println(" 2D ECS Game Engine - System Tests")
    println("================================================================")
    testEntityLifecycle()
    testComponentMask()
    testComponentSetters()
    testMovementSystem()
    testMovementSkipsPhysics()
    testPhysicsGravity()
    testPhysicsLanding()
    testPhysicsWallBlock()
    testAABBOverlap()
    testAIStateMachine()
    testCombatDamage()
    testCoinPickup()
    testSpikeDamage()
    testExitVictory()
    testRenderSystem()
    testRenderTiles()
    testWorldBounds()
    testOneWayPlatform()
    testSystemPolymorphism()
    testFullSceneRun()
    println("----------------------------------------------------------------")
    println(" total " + string(g_pass + g_fail) +
            "   pass " + string(g_pass) +
            "   fail " + string(g_fail))
    if g_fail == 0 then
        println(" ALL TESTS PASSED")
        return 0
    end
    return 1
end

// ===========================================================================
// 19. 用法 & 主入口
// ===========================================================================

func printUsage()
    println("gameengine - 2D ECS game engine (Entity-Component-System)")
    println("Usage:")
    println("  gameengine                       print this help")
    println("  gameengine demo [frames=120]     run built-in platformer (auto-player)")
    println("  gameengine test                  run system correctness tests")
    println("  gameengine -h | --help           print this help")
    println("")
    println("Architecture:")
    println("  Entity    = int ID (handle)")
    println("  Component = data in parallel global arrays (SoA)")
    println("  System    = behaviour, virtual update(World)")
    println("    MovementSystem  - kinematic integration (no collision)")
    println("    PhysicsSystem   - gravity + AABB tile collision")
    println("    AISystem        - state machine (patrol/chase/flee)")
    println("    CombatSystem    - damage / coin pickup / exit")
    println("    RenderSystem    - tile + sprite -> screen buffer")
end

func looksInt(string s) as bool
    if string.len(s) == 0 then
        return false
    end
    int i = 0
    while i < string.len(s)
        string ch = string.charAt(s, i)
        if i == 0 and (ch == "-" or ch == "+") then
            i += 1
            continue
        end
        if ch < "0" or ch > "9" then
            return false
        end
        i += 1
    end
    return true
end

func main(...) as int
    if arg.length < 2 then
        printUsage()
        return 1
    end

    string cmd = string(arg[1])

    if cmd == "-h" or cmd == "--help" or cmd == "help" then
        printUsage()
        return 0
    end

    try
        if cmd == "demo" then
            int frames = 120
            if arg.length >= 3 then
                string f = string(arg[2])
                if not looksInt(f) then
                    println("gameengine: invalid frames: " + f)
                    return 1
                end
                frames = int(f)
                if frames < 0 then
                    frames = 120
                end
            end
            return runDemo(frames)
        elseif cmd == "test" then
            return runAllTests()
        else
            println("gameengine: unknown command: " + cmd)
            printUsage()
            return 1
        end
    catch e
        println("gameengine: error: " + e.message)
        return 1
    end
    return 0
end
