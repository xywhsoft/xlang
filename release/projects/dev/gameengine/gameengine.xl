// gameengine - 2D ECS 游戏引擎（Entity-Component-System）
//
// 一个用 xlang 实现的极简 2D 游戏引擎，采用经典 ECS 架构：
//   * Entity  = int ID（句柄）
//   * Component= 数据，按类型用「并行全局数组」存储（entity ID -> 字段）
//   * System   = 行为，继承 System 基类并 override `update(World)`
//
// 覆盖能力：
//   * 并行全局数组（array<int>/float/string/bool）作为 SoA 组件存储
//   * class 继承 + virtual/override（System 基类派发到 Movement/Physics/
//     AI/Combat/Render 五个子类）
//   * 多态容器 array<System> 直接承载各类系统并通过 vtable 派发
//   * 2D 瓦片地图（array<int> 一维模拟二维）
//   * AABB 碰撞检测、轴分离响应、单向平台、重力
//   * 有限状态机 AI（PATROL / CHASE / FLEE）
//   * 渲染到字符网格 buffer + 拼接输出
//   * 命令行驱动的游戏循环（无 stdin，用脚本化输入 + 内置自动玩家）
//
// 用法：
//   gameengine                              打印用法
//   gameengine demo [frames=120]            运行内置平台跳跃（自动玩家）
//   gameengine test                         系统正确性测试
//   gameengine -h | --help                  本帮助
//
// 验证：
//   cd /d D:\GIT\x-lang\demo6\release
//   xl run projects\dev\gameengine\gameengine.xl test
//   xl run projects\dev\gameengine\gameengine.xl demo 120
//   xl build projects\dev\gameengine\gameengine.xl -o projects\dev\gameengine\gameengine.exe
//
// xlang 约定适配：
//   * 全局并行数组在声明处初始化（array[]），用 push() 填充，不再整体重绑定。
//   * Entity ID 引用全局数组，不用 class 层次存 entity。
//   * virtual 方法用于 System 基类，array<System> 保留派生系统的动态类型。
//   * 无 `for i in 0..n` 区间语法，统一用 while 索引循环。

// ===========================================================================
// 1. 常量
// ===========================================================================

// ---- Component bit flags（每个 entity 用一个 int mask 表示拥有哪些组件）----
int C_NONE     = 0
int C_POSITION = 1        // 位置
int C_VELOCITY = 2        // 速度
int C_SPRITE   = 4        // 外观（字符 + 前/背景色）
int C_COLLIDER = 8        // AABB 碰撞盒
int C_HEALTH   = 16       // 生命值
int C_AI       = 32       // AI 状态机
int C_GRAVITY  = 64       // 受重力影响
int C_PLAYER   = 128      // 标签：玩家
int C_ENEMY    = 256      // 标签：敌人
int C_COIN     = 512      // 标签：收集品
int C_PROJECTILE = 1024   // 标签：抛射物
int C_KINEMATIC = 2048    // 标签：运动学（不受物理碰撞，仅 MovementSystem 推动）

// ---- AI 状态 ----
int AI_IDLE    = 0
int AI_PATROL  = 1
int AI_CHASE   = 2
int AI_FLEE    = 3

// ---- 瓦片类型 ----
int T_EMPTY    = 0
int T_WALL     = 1
int T_PLATFORM = 2        // 单向平台：只从上方阻挡
int T_COIN     = 3        // 装饰用（实际金币由 entity 承载，保留用于布局标记）
int T_SPIKE    = 4        // 静态尖刺（伤害玩家）
int T_EXIT     = 5        // 出口（胜利）
int T_LADDER   = 6        // 梯子（视觉装饰）

// ---- 颜色（ANSI foreground code；0 = 默认）----
int CLR_DEFAULT = 0
int CLR_BLACK   = 30
int CLR_RED     = 31
int CLR_GREEN   = 32
int CLR_YELLOW  = 33
int CLR_BLUE    = 34
int CLR_MAGENTA = 35
int CLR_CYAN    = 36
int CLR_WHITE   = 37

// ---- 输入码（脚本化输入队列里的元素）----
int IN_NONE  = 0
int IN_LEFT  = 1
int IN_RIGHT = 2
int IN_UP    = 3
int IN_DOWN  = 4
int IN_JUMP  = 5
int IN_QUIT  = 6

// ---- 物理 / 平衡常量 ----
float GRAVITY_ACCEL   = 0.030   // 每帧速度增量
float MAX_FALL        = 0.55    // 终端下落速度
float MOVE_ACCEL      = 0.045   // 玩家水平加速度
float MOVE_MAX        = 0.30    // 玩家水平最大速度
float FRICTION_GROUND = 0.70    // 地面摩擦（每帧速度乘数）
float FRICTION_AIR    = 0.95    // 空中摩擦
float JUMP_IMPULSE    = -0.50   // 跳跃初速（向上为负）
float ENEMY_SPEED     = 0.08
float COIN_PICKUP_SCORE = 10.0

// ===========================================================================
// 2. 全局组件存储（并行数组，下标 = entity ID）
//    每种组件的数据拆成基本类型字段，分别存一根数组。
//    g_alive[id] && (g_mask[id] & bit) != 0 表示该 entity 拥有该组件。
// ===========================================================================

array<bool>  g_alive     = array[]
array<int>   g_mask      = array[]
array<string> g_name     = array[]       // 调试用名字

// Position
array<float> g_posX      = array[]
array<float> g_posY      = array[]

// Velocity
array<float> g_velX      = array[]
array<float> g_velY      = array[]

// Sprite
array<string> g_spriteCh = array[]
array<int>   g_spriteFg  = array[]
array<int>   g_spriteBg  = array[]

// Collider (宽高，单位=瓦片)
array<float> g_colW      = array[]
array<float> g_colH      = array[]

// Health
array<int>   g_hp        = array[]
array<int>   g_hpMax     = array[]

// AI
array<int>   g_aiState      = array[]
array<int>   g_aiTarget     = array[]      // 目标 entity ID（-1 = 无）
array<float> g_aiAnchorX    = array[]      // 巡逻锚点
array<float> g_aiAnchorY    = array[]
int          AI_PATROL_RANGE = 3           // 巡逻半径（瓦片）
float        AI_DETECT_RANGE = 6.0         // 发现玩家距离
float        AI_LEASH_RANGE  = 10.0        // 脱战距离
int          AI_FLEE_HP      = 2           // 血量低于此值转入逃跑

// Physics 运行时状态（每帧由 PhysicsSystem 写回）
array<bool>  g_onGround  = array[]
array<bool>  g_facingLeft = array[]        // 朝向（影响 sprite/AI）
array<int>   g_iframes   = array[]         // 无敌帧（受伤后短暂无敌）
array<bool>  g_dead      = array[]         // 标记待清理（金币被拾取、敌人被击败）

int g_entityCount = 0

// ===========================================================================
// 3. 工具函数：数组构造
// ===========================================================================

// 构造长度为 n、初值 v 的 int 数组。
func makeInt(int n, int v) as array<int>
    if n <= 0 then
        return array[]
    end
    array<int> a = array[v]
    int i = 1
    while i < n
        a.push(v)
        i += 1
    end
    return a
end

// 构造长度为 n、初值 v 的 float 数组。
func makeFloat(int n, float v) as array<float>
    if n <= 0 then
        return array[]
    end
    array<float> a = array[v]
    int i = 1
    while i < n
        a.push(v)
        i += 1
    end
    return a
end

// 构造长度为 n、初值 v 的 bool 数组。
func makeBool(int n, bool v) as array<bool>
    if n <= 0 then
        return array[]
    end
    array<bool> a = array[v]
    int i = 1
    while i < n
        a.push(v)
        i += 1
    end
    return a
end

// 构造长度为 n、初值 v 的 string 数组。
func makeStr(int n, string v) as array<string>
    if n <= 0 then
        return array[]
    end
    array<string> a = array[v]
    int i = 1
    while i < n
        a.push(v)
        i += 1
    end
    return a
end

// float 数值裁剪到 [lo, hi]。
func clampF(float v, float lo, float hi) as float
    return math.clamp(v, lo, hi)
end

// int 数值裁剪。
func clampI(int v, int lo, int hi) as int
    if v < lo then
        return lo
    end
    if v > hi then
        return hi
    end
    return v
end

// 向下取整为 int。
func floorI(float x) as int
    return int(math.floor(x))
end

// 绝对值（float）。
func absF(float v) as float
    return math.abs(v)
end

// ===========================================================================
// 4. Entity 管理
// ===========================================================================

// 把所有并行数组对齐到同一个长度（新 slot 用零值填充）。
func extendSlot(string name)
    g_alive.push(true)
    g_mask.push(C_NONE)
    g_name.push(name)

    g_posX.push(0.0)
    g_posY.push(0.0)

    g_velX.push(0.0)
    g_velY.push(0.0)

    g_spriteCh.push("?")
    g_spriteFg.push(CLR_DEFAULT)
    g_spriteBg.push(CLR_DEFAULT)

    g_colW.push(1.0)
    g_colH.push(1.0)

    g_hp.push(1)
    g_hpMax.push(1)

    g_aiState.push(AI_IDLE)
    g_aiTarget.push(-1)
    g_aiAnchorX.push(0.0)
    g_aiAnchorY.push(0.0)

    g_onGround.push(false)
    g_facingLeft.push(false)
    g_iframes.push(0)
    g_dead.push(false)
end

// 创建一个空 entity（无任何组件），返回其 ID。
func createEntity() as int
    int id = g_alive.length
    extendSlot("entity" + string(id))
    g_entityCount += 1
    return id
end

// 创建并命名。
func createNamed(string name) as int
    int id = g_alive.length
    extendSlot(name)
    g_entityCount += 1
    return id
end

// 销毁 entity：标记不存活并清空 mask；不收缩数组（保持索引稳定）。
func destroyEntity(int id)
    if id < 0 or id >= g_alive.length then
        return
    end
    g_alive[id] = false
    g_mask[id] = C_NONE
    g_dead[id] = true
    g_entityCount -= 1
end

// 重置整个注册表（测试间隔离用）。
func resetRegistry()
    g_alive.clear()
    g_mask.clear()
    g_name.clear()
    g_posX.clear()
    g_posY.clear()
    g_velX.clear()
    g_velY.clear()
    g_spriteCh.clear()
    g_spriteFg.clear()
    g_spriteBg.clear()
    g_colW.clear()
    g_colH.clear()
    g_hp.clear()
    g_hpMax.clear()
    g_aiState.clear()
    g_aiTarget.clear()
    g_aiAnchorX.clear()
    g_aiAnchorY.clear()
    g_onGround.clear()
    g_facingLeft.clear()
    g_iframes.clear()
    g_dead.clear()
    g_entityCount = 0
end

// ---- 组件 mask 操作 ----

func addComponent(int id, int bit)
    if id < 0 or id >= g_alive.length then
        return
    end
    g_mask[id] = g_mask[id] | bit
end

func removeComponent(int id, int bit)
    if id < 0 or id >= g_alive.length then
        return
    end
    // bit 互斥标志位，直接减即可清除（前提是该位已置位）
    if (g_mask[id] & bit) != 0 then
        g_mask[id] = g_mask[id] - bit
    end
end

func hasComp(int id, int bit) as bool
    if id < 0 or id >= g_alive.length then
        return false
    end
    return (g_mask[id] & bit) != 0
end

func hasAll(int id, int mask) as bool
    if id < 0 or id >= g_alive.length then
        return false
    end
    return (g_mask[id] & mask) == mask
end

func isAlive(int id) as bool
    if id < 0 or id >= g_alive.length then
        return false
    end
    return g_alive[id]
end

// ===========================================================================
// 5. 组件赋值便捷函数
// ===========================================================================

func setPosition(int id, float x, float y)
    addComponent(id, C_POSITION)
    g_posX[id] = x
    g_posY[id] = y
end

func setVelocity(int id, float vx, float vy)
    addComponent(id, C_VELOCITY)
    g_velX[id] = vx
    g_velY[id] = vy
end

func setSprite(int id, string ch, int fg, int bg)
    addComponent(id, C_SPRITE)
    g_spriteCh[id] = ch
    g_spriteFg[id] = fg
    g_spriteBg[id] = bg
end

func setCollider(int id, float w, float h)
    addComponent(id, C_COLLIDER)
    g_colW[id] = w
    g_colH[id] = h
end

func setHealth(int id, int hp, int hpMax)
    addComponent(id, C_HEALTH)
    g_hp[id] = hp
    g_hpMax[id] = hpMax
end

func setAI(int id, int state, int target)
    addComponent(id, C_AI)
    g_aiState[id] = state
    g_aiTarget[id] = target
    g_aiAnchorX[id] = g_posX[id]
    g_aiAnchorY[id] = g_posY[id]
end

func tagEntity(int id, int tagBit)
    addComponent(id, tagBit)
end

// 给一个 entity 装上「玩家」全套组件。
func makePlayer(int id, float x, float y) as int
    setPosition(id, x, y)
    setVelocity(id, 0.0, 0.0)
    setSprite(id, "@", CLR_CYAN, CLR_DEFAULT)
    setCollider(id, 0.8, 0.9)
    setHealth(id, 3, 3)
    addComponent(id, C_GRAVITY)
    tagEntity(id, C_PLAYER)
    return id
end

// 给一个 entity 装上「敌人」全套组件。
func makeEnemy(int id, float x, float y, int target) as int
    setPosition(id, x, y)
    setVelocity(id, 0.0, 0.0)
    setSprite(id, "M", CLR_RED, CLR_DEFAULT)
    setCollider(id, 0.8, 0.8)
    setHealth(id, 3, 3)
    setAI(id, AI_PATROL, target)
    addComponent(id, C_GRAVITY)
    tagEntity(id, C_ENEMY)
    return id
end

// 给一个 entity 装上「金币」全套组件。
func makeCoin(int id, float x, float y) as int
    setPosition(id, x, y)
    setSprite(id, "o", CLR_YELLOW, CLR_DEFAULT)
    setCollider(id, 0.6, 0.6)
    setHealth(id, 1, 1)
    tagEntity(id, C_COIN)
    return id
end

func runWorldSystems(World w)
    int n = w.systems.length
    int i = 0
    while i < n
        System s = w.systems[i]
        if s.enabled then
            s.update(w)
        end
        i += 1
    end
end

// ===========================================================================
// 6. World（场景 + 瓦片地图 + 渲染 buffer + 系统）
// ===========================================================================

class World
    int mapW = 0
    int mapH = 0
    array<int> tiles = array[]          // tiles[row*mapW + col]
    float gravity = 0.030

    int viewW = 60                      // 视口宽（字符）
    int viewH = 18                      // 视口高（字符）
    array<string> screen = array[]      // length = viewW*viewH
    array<int> screenFg = array[]       // 每个 cell 的前景色
    array<int> screenBg = array[]       // 每个 cell 的背景色

    int camCol = 0                      // 视口左上角所在瓦片列
    int camRow = 0

    int score = 0
    int coinsTotal = 0
    int frame = 0
    bool gameOver = false
    bool victory = false
    string statusMsg = ""

    int player = -1                     // 玩家 entity ID
    int exitCol = 0                     // 出口瓦片坐标
    int exitRow = 0

    array<System> systems = array<System>[] // System 实例列表（多态）

    create(int w, int h)
        self.mapW = w
        self.mapH = h
        self.gravity = GRAVITY_ACCEL
        self.tiles = makeInt(w * h, T_EMPTY)
        self.screen = makeStr(self.viewW * self.viewH, " ")
        self.screenFg = makeInt(self.viewW * self.viewH, CLR_DEFAULT)
        self.screenBg = makeInt(self.viewW * self.viewH, CLR_DEFAULT)
        self.camCol = 0
        self.camRow = 0
    end

    // 取瓦片（越界：左右下视为墙，上视为空）。
    func tileAt(int col, int row) as int
        if col < 0 or col >= self.mapW then
            return T_WALL
        end
        if row < 0 then
            return T_EMPTY
        end
        if row >= self.mapH then
            return T_WALL
        end
        return self.tiles[row * self.mapW + col]
    end

    func setTile(int col, int row, int t)
        if col >= 0 and col < self.mapW and row >= 0 and row < self.mapH then
            self.tiles[row * self.mapW + col] = t
        end
    end

    // 是否实心（水平方向阻挡）。
    func isSolidX(int col, int row) as bool
        int t = self.tileAt(col, row)
        return t == T_WALL
    end

    // 是否从下方挡住（垂直方向阻挡）。platformOnly=true 时只考虑单向平台。
    func isSolidY(int col, int row, bool allowPlatform) as bool
        int t = self.tileAt(col, row)
        if t == T_WALL then
            return true
        end
        if t == T_PLATFORM and not allowPlatform then
            return true
        end
        return false
    end

    func width() as int
        return self.mapW
    end

    func height() as int
        return self.mapH
    end

    // 注册一个 System。
    func addSystem(System s)
        self.systems.append(s)
    end

    // 按注册顺序执行所有 enabled 的 System。
    func runSystems()
    end

    // 把视口对齐玩家（平滑跟随）。
    func centerCameraOnPlayer()
        if self.player < 0 then
            return
        end
        float px = g_posX[self.player]
        float py = g_posY[self.player]
        int wantCol = floorI(px) - self.viewW / 2
        int wantRow = floorI(py) - self.viewH / 2
        if self.mapW > self.viewW then
            self.camCol = clampI(wantCol, 0, self.mapW - self.viewW)
        else
            self.camCol = 0
        end
        if self.mapH > self.viewH then
            self.camRow = clampI(wantRow, 0, self.mapH - self.viewH)
        else
            self.camRow = 0
        end
    end

    // 清空渲染 buffer。
    func clearScreen()
        int n = self.screen.length
        int i = 0
        while i < n
            self.screen[i] = " "
            self.screenFg[i] = CLR_DEFAULT
            self.screenBg[i] = CLR_DEFAULT
            i += 1
        end
    end

    // 写一个 cell。
    func putCell(int col, int row, string ch, int fg, int bg)
        if col < 0 or col >= self.viewW then
            return
        end
        if row < 0 or row >= self.viewH then
            return
        end
        int idx = row * self.viewW + col
        self.screen[idx] = ch
        self.screenFg[idx] = fg
        self.screenBg[idx] = bg
    end
end

// 瓦片 -> 字符。
func tileChar(int t) as string
    if t == T_WALL then
        return "#"
    end
    if t == T_PLATFORM then
        return "-"
    end
    if t == T_COIN then
        return "."
    end
    if t == T_SPIKE then
        return "^"
    end
    if t == T_EXIT then
        return "E"
    end
    if t == T_LADDER then
        return "H"
    end
    return " "
end

// 瓦片 -> 前景色。
func tileFg(int t) as int
    if t == T_WALL then
        return CLR_WHITE
    end
    if t == T_PLATFORM then
        return CLR_WHITE
    end
    if t == T_SPIKE then
        return CLR_RED
    end
    if t == T_EXIT then
        return CLR_GREEN
    end
    if t == T_COIN then
        return CLR_YELLOW
    end
    return CLR_DEFAULT
end

// ===========================================================================
// 7. 碰撞工具（AABB）
// ===========================================================================

// 两个 entity 的 AABB 是否重叠。要求两者都有 POSITION + COLLIDER。
func aabbOverlap(int a, int b) as bool
    if not hasAll(a, C_POSITION | C_COLLIDER) then
        return false
    end
    if not hasAll(b, C_POSITION | C_COLLIDER) then
        return false
    end
    float ax = g_posX[a]
    float ay = g_posY[a]
    float aw = g_colW[a]
    float ah = g_colH[a]
    float bx = g_posX[b]
    float by = g_posY[b]
    float bw = g_colW[b]
    float bh = g_colH[b]
    if ax + aw <= bx then
        return false
    end
    if bx + bw <= ax then
        return false
    end
    if ay + ah <= by then
        return false
    end
    if by + bh <= ay then
        return false
    end
    return true
end

// 通用 AABB 重叠（直接给坐标）。
func aabbOverlapRaw(float ax, float ay, float aw, float ah,
                    float bx, float by, float bw, float bh) as bool
    if ax + aw <= bx then
        return false
    end
    if bx + bw <= ax then
        return false
    end
    if ay + ah <= by then
        return false
    end
    if by + bh <= ay then
        return false
    end
    return true
end

// entity 的 AABB 与某个瓦片 cell（1x1）是否重叠。
func entityOverlapsTile(int id, int col, int row) as bool
    if not hasAll(id, C_POSITION | C_COLLIDER) then
        return false
    end
    float x = g_posX[id]
    float y = g_posY[id]
    float w = g_colW[id]
    float h = g_colH[id]
    return aabbOverlapRaw(x, y, w, h, float(col), float(row), 1.0, 1.0)
end

// entity 是否与任意指定类型瓦片重叠。
func entityOverlapsTileType(int id, World w, int tileType) as bool
    if not hasAll(id, C_POSITION | C_COLLIDER) then
        return false
    end
    float x = g_posX[id]
    float y = g_posY[id]
    float ww = g_colW[id]
    float hh = g_colH[id]
    int colL = floorI(x)
    int colR = floorI(x + ww - 0.0001)
    int rowT = floorI(y)
    int rowB = floorI(y + hh - 0.0001)
    int r = rowT
    while r <= rowB
        int c = colL
        while c <= colR
            if w.tileAt(c, r) == tileType then
                if aabbOverlapRaw(x, y, ww, hh, float(c), float(r), 1.0, 1.0) then
                    return true
                end
            end
            c += 1
        end
        r += 1
    end
    return false
end

// ===========================================================================
// 8. System 基类（virtual update）
// ===========================================================================

class System
    string name = "System"
    bool enabled = true

    virtual func update(World w)
    end

    func describe() as string
        return self.name
    end
end

// ===========================================================================
// 9. MovementSystem —— 简单运动学积分（不做碰撞）
//    只处理「没有 COLLIDER 或带 KINEMATIC 标签」的 entity，
//    避免与 PhysicsSystem 重复积分物理实体。
// ===========================================================================

class MovementSystem extends System
    create()
        self.name = "Movement"
    end

    override func update(World w)
        int n = g_alive.length
        int i = 0
        while i < n
            if not g_alive[i] then
                i += 1
                continue
            end
            bool hasPos = hasComp(i, C_POSITION)
            bool hasVel = hasComp(i, C_VELOCITY)
            if not (hasPos and hasVel) then
                i += 1
                continue
            end
            // 跳过有 COLLIDER 且非 KINEMATIC 的（由 PhysicsSystem 处理）
            if hasComp(i, C_COLLIDER) and not hasComp(i, C_KINEMATIC) then
                i += 1
                continue
            end
            g_posX[i] = g_posX[i] + g_velX[i]
            g_posY[i] = g_posY[i] + g_velY[i]
            i += 1
        end
    end
end

// ===========================================================================
// 10. PhysicsSystem —— 重力 + 瓦片 AABB 碰撞（轴分离）
//     处理拥有 POSITION + VELOCITY + COLLIDER + GRAVITY 的 entity。
// ===========================================================================

class PhysicsSystem extends System
    create()
        self.name = "Physics"
    end

    override func update(World w)
        int n = g_alive.length
        int i = 0
        while i < n
            if not g_alive[i] then
                i += 1
                continue
            end
            if not hasAll(i, C_POSITION | C_VELOCITY | C_COLLIDER) then
                i += 1
                continue
            end
            // 重力
            if hasComp(i, C_GRAVITY) then
                g_velY[i] = g_velY[i] + w.gravity
                if g_velY[i] > MAX_FALL then
                    g_velY[i] = MAX_FALL
                end
            end
            // 摩擦（仅在地面且玩家未主动加速时；这里简化为通用阻尼）
            if g_onGround[i] then
                g_velX[i] = g_velX[i] * FRICTION_GROUND
            else
                g_velX[i] = g_velX[i] * FRICTION_AIR
            end
            // 微小速度归零（避免抖动）
            if absF(g_velX[i]) < 0.001 then
                g_velX[i] = 0.0
            end

            moveAndCollide(w, i)
            i += 1
        end
    end
end

// 单个 entity 的轴分离碰撞移动。
func moveAndCollide(World w, int id)
    float x = g_posX[id]
    float y = g_posY[id]
    float cw = g_colW[id]
    float ch = g_colH[id]
    float vx = g_velX[id]
    float vy = g_velY[id]

    // ---- X 轴 ----
    bool vxNeg = vx < 0.0
    if vx != 0.0 then
        x = x + vx
        int colL = floorI(x)
        int colR = floorI(x + cw - 0.0001)
        int rowT = floorI(y)
        int rowB = floorI(y + ch - 0.0001)
        bool blocked = false
        if vx > 0.0 then
            int probeCol = colR
            int r = rowT
            while r <= rowB
                if w.isSolidX(probeCol, r) then
                    blocked = true
                end
                r += 1
            end
            if blocked then
                x = float(probeCol) - cw
                vx = 0.0
            end
        else
            int probeCol = colL
            int r = rowT
            while r <= rowB
                if w.isSolidX(probeCol, r) then
                    blocked = true
                end
                r += 1
            end
            if blocked then
                x = float(probeCol + 1)
                vx = 0.0
            end
        end
        if blocked then
            // 用碰撞前的方向（vxNeg）而不是已清零的 vx
            g_facingLeft[id] = vxNeg
        end
    end

    // ---- Y 轴 ----
    bool onGround = false
    float oldY = y
    if vy != 0.0 then
        y = y + vy
        int colL = floorI(x)
        int colR = floorI(x + cw - 0.0001)
        if vy > 0.0 then
            int probeRow = floorI(y + ch - 0.0001)
            int c = colL
            while c <= colR
                int t = w.tileAt(c, probeRow)
                bool hit = false
                if t == T_WALL then
                    hit = true
                end
                if t == T_PLATFORM then
                    // 单向平台：仅当上一帧脚在平台上方时阻挡
                    float oldFeet = oldY + ch
                    if float(probeRow) + 0.0001 >= oldFeet then
                        hit = true
                    end
                end
                if hit then
                    y = float(probeRow) - ch
                    vy = 0.0
                    onGround = true
                end
                c += 1
            end
        else
            int probeRow = floorI(y)
            int c = colL
            while c <= colR
                int t = w.tileAt(c, probeRow)
                if t == T_WALL then
                    y = float(probeRow + 1)
                    vy = 0.0
                end
                c += 1
            end
        end
    end

    // 防止穿出地图左右
    if x < 0.0 then
        x = 0.0
        vx = 0.0
    end
    if x + cw > float(w.mapW) then
        x = float(w.mapW) - cw
        vx = 0.0
    end
    // 防止穿出底部
    if y + ch > float(w.mapH) then
        y = float(w.mapH) - ch
        vy = 0.0
        onGround = true
    end
    // 防止穿出顶部
    if y < 0.0 then
        y = 0.0
        vy = 0.0
    end

    g_posX[id] = x
    g_posY[id] = y
    g_velX[id] = vx
    g_velY[id] = vy
    g_onGround[id] = onGround
end

// ===========================================================================
// 11. AISystem —— 有限状态机（PATROL / CHASE / FLEE）
// ===========================================================================

class AISystem extends System
    create()
        self.name = "AI"
    end

    override func update(World w)
        int n = g_alive.length
        int i = 0
        while i < n
            if not g_alive[i] then
                i += 1
                continue
            end
            if not hasComp(i, C_AI) then
                i += 1
                continue
            end
            stepAI(w, i)
            i += 1
        end
    end
end

// 单个 AI entity 的状态推进。
func stepAI(World w, int id)
    int state = g_aiState[id]
    int target = g_aiTarget[id]
    float tx = 0.0
    float ty = 0.0
    bool hasTarget = false
    if target >= 0 and target < g_alive.length and g_alive[target] then
        if hasComp(target, C_POSITION) then
            tx = g_posX[target]
            ty = g_posY[target]
            hasTarget = true
        end
    end
    float ax = g_aiAnchorX[id]
    float ay = g_aiAnchorY[id]
    float x = g_posX[id]
    float y = g_posY[id]

    // 计算到玩家的距离
    float distToTarget = 9999.0
    if hasTarget then
        float ddx = tx - x
        float ddy = ty - y
        distToTarget = math.sqrt(ddx * ddx + ddy * ddy)
    end

    int hp = 1
    int hpMax = 1
    if hasComp(id, C_HEALTH) then
        hp = g_hp[id]
        hpMax = g_hpMax[id]
    end

    // ---- 状态切换 ----
    if state == AI_PATROL then
        if hasTarget and distToTarget < AI_DETECT_RANGE then
            state = AI_CHASE
        end
    elseif state == AI_CHASE then
        if hp <= AI_FLEE_HP then
            state = AI_FLEE
        elseif not hasTarget or distToTarget > AI_LEASH_RANGE then
            state = AI_PATROL
            g_aiAnchorX[id] = x
            g_aiAnchorY[id] = y
        end
    elseif state == AI_FLEE then
        if not hasTarget or distToTarget > AI_LEASH_RANGE then
            state = AI_PATROL
            g_aiAnchorX[id] = x
            g_aiAnchorY[id] = y
        end
    end

    // ---- 状态行为 ----
    float newVx = 0.0
    if state == AI_PATROL then
        // 在锚点附近来回走
        float dx = x - ax
        if dx > float(AI_PATROL_RANGE) then
            g_facingLeft[id] = true
            newVx = 0.0 - ENEMY_SPEED
        elseif dx < 0.0 - float(AI_PATROL_RANGE) then
            g_facingLeft[id] = false
            newVx = ENEMY_SPEED
        else
            // 随机改变方向
            int r = random.range(0, 8)
            if r == 0 then
                newVx = ENEMY_SPEED
                g_facingLeft[id] = false
            elseif r == 1 then
                newVx = 0.0 - ENEMY_SPEED
                g_facingLeft[id] = true
            else
                newVx = 0.0
            end
        end
    elseif state == AI_CHASE then
        if hasTarget then
            if tx < x then
                newVx = 0.0 - ENEMY_SPEED
                g_facingLeft[id] = true
            else
                newVx = ENEMY_SPEED
                g_facingLeft[id] = false
            end
        end
    elseif state == AI_FLEE then
        if hasTarget then
            if tx < x then
                newVx = ENEMY_SPEED
                g_facingLeft[id] = false
            else
                newVx = 0.0 - ENEMY_SPEED
                g_facingLeft[id] = true
            end
        end
    end

    // 只在地面时设水平速度（避免空中变向过于灵活）
    if hasComp(id, C_COLLIDER) then
        if g_onGround[id] or absF(newVx) < 0.001 then
            g_velX[id] = newVx
        end
    else
        g_velX[id] = newVx
    end

    // Chase 时若头顶有障碍且在地面，尝试跳跃
    if state == AI_CHASE and g_onGround[id] then
        // 检测前方/上方是否有墙
        int dirSign = 1
        if newVx < 0.0 then
            dirSign = 0 - 1
        end
        int aheadCol = floorI(x) + dirSign
        int myRow = floorI(y)
        if w.isSolidX(aheadCol, myRow) then
            g_velY[id] = JUMP_IMPULSE
        end
    end

    g_aiState[id] = state
end

// ===========================================================================
// 12. CombatSystem —— 碰撞伤害 / 收集 / 出口判定
// ===========================================================================

class CombatSystem extends System
    create()
        self.name = "Combat"
    end

    override func update(World w)
        int n = g_alive.length
        int i = 0
        while i < n
            if not g_alive[i] then
                i += 1
                continue
            end
            if g_iframes[i] > 0 then
                g_iframes[i] = g_iframes[i] - 1
            end
            i += 1
        end

        // 玩家相关交互
        int p = w.player
        if p >= 0 and g_alive[p] then
            handlePlayerInteractions(w, p)
        end

        // 通用：敌人互相不伤害；玩家抛射物 vs 敌人
        handleProjectiles(w)

        // 清理被标记死亡的 entity
        cleanupDead()
    end
end

// 玩家与场景的交互。
func handlePlayerInteractions(World w, int p)
    // 1) 尖刺瓦片
    if entityOverlapsTileType(p, w, T_SPIKE) then
        damageEntity(p, 1)
    end
    // 2) 出口瓦片
    if entityOverlapsTileType(p, w, T_EXIT) then
        if not w.victory then
            w.victory = true
            w.statusMsg = "reach exit!"
        end
    end
    // 3) 与敌人接触
    int n = g_alive.length
    int i = 0
    while i < n
        if i == p or not g_alive[i] then
            i += 1
            continue
        end
        if hasComp(i, C_ENEMY) then
            if aabbOverlap(p, i) then
                damageEntity(p, 1)
            end
        end
        i += 1
    end
    // 4) 收集金币
    i = 0
    while i < n
        if i == p or not g_alive[i] then
            i += 1
            continue
        end
        if hasComp(i, C_COIN) then
            if aabbOverlap(p, i) then
                w.score += 10
                w.coinsTotal -= 1
                destroyEntity(i)
                w.statusMsg = "coin +10"
            end
        end
        i += 1
    end
    // 5) 玩家死亡
    if hasComp(p, C_HEALTH) and g_hp[p] <= 0 then
        if not w.gameOver then
            w.gameOver = true
            w.statusMsg = "player defeated"
        end
    end
end

// 处理抛射物 vs 敌人。
func handleProjectiles(World w)
    int n = g_alive.length
    int i = 0
    while i < n
        if not g_alive[i] or not hasComp(i, C_PROJECTILE) then
            i += 1
            continue
        end
        int j = 0
        while j < n
            if j == i or not g_alive[j] or not hasComp(j, C_ENEMY) then
                j += 1
                continue
            end
            if aabbOverlap(i, j) then
                damageEntity(j, 1)
                destroyEntity(i)
                j = n
            end
            j += 1
        end
        i += 1
    end
end

// 对一个 entity 造成伤害（考虑无敌帧）。
func damageEntity(int id, int amount)
    if not hasComp(id, C_HEALTH) then
        return
    end
    if g_iframes[id] > 0 then
        return
    end
    g_hp[id] = g_hp[id] - amount
    if g_hp[id] < 0 then
        g_hp[id] = 0
    end
    g_iframes[id] = 30
    // 玩家受伤后击退
    if hasComp(id, C_VELOCITY) then
        g_velY[id] = -0.25
    end
end

// 把所有 g_dead=true 的 entity 真正 destroy。
func cleanupDead()
    int n = g_alive.length
    int i = 0
    while i < n
        if g_alive[i] and g_dead[i] then
            destroyEntity(i)
        end
        i += 1
    end
end

// ===========================================================================
// 13. RenderSystem —— 把瓦片和 entity sprite 画到 screen buffer
// ===========================================================================

class RenderSystem extends System
    create()
        self.name = "Render"
    end

    override func update(World w)
        w.clearScreen()
        // 1) 画瓦片（只画视口范围内的）
        int r = 0
        while r < w.viewH
            int c = 0
            while c < w.viewW
                int worldCol = w.camCol + c
                int worldRow = w.camRow + r
                int t = w.tileAt(worldCol, worldRow)
                if t != T_EMPTY then
                    w.putCell(c, r, tileChar(t), tileFg(t), CLR_DEFAULT)
                end
                c += 1
            end
            r += 1
        end
        // 2) 画 entity sprite
        int n = g_alive.length
        int i = 0
        while i < n
            if not g_alive[i] then
                i += 1
                continue
            end
            if not hasComp(i, C_SPRITE) then
                i += 1
                continue
            end
            float sx = g_posX[i]
            float sy = g_posY[i]
            int col = floorI(sx) - w.camCol
            int row = floorI(sy) - w.camRow
            // 玩家受伤闪烁
            string ch = g_spriteCh[i]
            int fg = g_spriteFg[i]
            if hasComp(i, C_PLAYER) and g_iframes[i] > 0 then
                if (g_iframes[i] / 4) % 2 == 0 then
                    ch = g_spriteCh[i]
                else
                    ch = "x"
                end
            end
            w.putCell(col, row, ch, fg, g_spriteBg[i])
            i += 1
        end
    end
end

// 把 screen buffer 拼成单个多行字符串（带边框和 HUD）。
func renderToString(World w) as string
    string top = "+" + string.repeat("-", w.viewW) + "+"
    string outputValue = top + "\n"
    int r = 0
    while r < w.viewH
        string line = "|"
        int c = 0
        while c < w.viewW
            line = line + w.screen[r * w.viewW + c]
            c += 1
        end
        line = line + "|"
        outputValue = outputValue + line + "\n"
        r += 1
    end
    outputValue = outputValue + top + "\n"
    // HUD
    string hpBar = ""
    if w.player >= 0 and hasComp(w.player, C_HEALTH) then
        int hp = g_hp[w.player]
        int k = 0
        while k < hp
            hpBar = hpBar + "*"
            k += 1
        end
    end
    string hud = "frame " + string(w.frame) + "  hp[" + hpBar + "]  score " + string(w.score)
    if w.coinsTotal > 0 then
        hud = hud + "  coins left " + string(w.coinsTotal)
    end
    if w.gameOver then
        hud = hud + "  [GAME OVER]"
    end
    if w.victory then
        hud = hud + "  [VICTORY]"
    end
    if string.len(w.statusMsg) > 0 then
        hud = hud + "  | " + w.statusMsg
    end
    outputValue = outputValue + hud + "\n"
    return outputValue
end

// ===========================================================================
// 14. 输入处理（脚本化输入 -> 设置玩家速度）
// ===========================================================================

// 把一个输入码应用到玩家 entity（设置水平速度、跳跃初速）。
func applyInput(World w, int input)
    int p = w.player
    if p < 0 or not g_alive[p] then
        return
    end
    if not hasAll(p, C_VELOCITY | C_POSITION) then
        return
    end
    if input == IN_QUIT then
        w.gameOver = true
        w.statusMsg = "quit"
        return
    end
    // 水平移动：直接设速度（比加速度更可控，便于 demo）
    float vx = 0.0
    if input == IN_LEFT then
        vx = 0.0 - MOVE_MAX
        g_facingLeft[p] = true
    elseif input == IN_RIGHT then
        vx = MOVE_MAX
        g_facingLeft[p] = false
    elseif input == IN_UP then
        // 梯子爬升（简化：直接给小向上速度）
        vx = g_velX[p]
    elseif input == IN_DOWN then
        vx = g_velX[p]
    end
    if input == IN_LEFT or input == IN_RIGHT then
        g_velX[p] = vx
    end
    // 跳跃：仅在地面
    if input == IN_JUMP and g_onGround[p] then
        g_velY[p] = JUMP_IMPULSE
        g_onGround[p] = false
    end
    if input == IN_NONE then
        // 不主动维持速度，留给摩擦处理
    end
end

// ===========================================================================
// 15. 场景构建：内置平台跳跃关卡
// ===========================================================================

// 用一组字符串描述瓦片地图，再扫描生成 World。
// 字符含义：
//   '#' 墙   '=' 单向平台   'o' 金币（生成 entity）
//   '^' 尖刺  'E' 出口   'H' 梯子   ' ' 空   'P' 玩家出生   'M' 敌人
//   '.' 装饰点
func buildLevel(array<string> rows, int viewW, int viewH) as World
    int h = rows.length
    int w = 0
    int i = 0
    while i < h
        int L = string.len(rows[i])
        if L > w then
            w = L
        end
        i += 1
    end
    World wld = World(w, h)
    wld.viewW = viewW
    wld.viewH = viewH
    wld.screen = makeStr(viewW * viewH, " ")
    wld.screenFg = makeInt(viewW * viewH, CLR_DEFAULT)
    wld.screenBg = makeInt(viewW * viewH, CLR_DEFAULT)

    int r = 0
    while r < h
        string row = rows[r]
        int c = 0
        int len = string.len(row)
        while c < w
            string ch = " "
            if c < len then
                ch = string.charAt(row, c)
            end
            int tile = T_EMPTY
            if ch == "#" then
                tile = T_WALL
            elseif ch == "=" then
                tile = T_PLATFORM
            elseif ch == "^" then
                tile = T_SPIKE
            elseif ch == "E" then
                tile = T_EXIT
                wld.exitCol = c
                wld.exitRow = r
            elseif ch == "H" then
                tile = T_LADDER
            elseif ch == "." then
                tile = T_COIN
            end
            wld.setTile(c, r, tile)
            c += 1
        end
        r += 1
    end

    // 第二遍：生成 entity（玩家、敌人、金币）
    int player = -1
    r = 0
    while r < h
        string row = rows[r]
        int c = 0
        int len = string.len(row)
        while c < len
            string ch = string.charAt(row, c)
            if ch == "P" then
                int id = createNamed("player")
                makePlayer(id, float(c), float(r))
                player = id
                wld.setTile(c, r, T_EMPTY)
            elseif ch == "M" then
                int id = createNamed("enemy" + string(c) + "_" + string(r))
                makeEnemy(id, float(c), float(r), -1)
                wld.setTile(c, r, T_EMPTY)
            elseif ch == "o" then
                int id = createNamed("coin" + string(c) + "_" + string(r))
                makeCoin(id, float(c) + 0.2, float(r) + 0.2)
                wld.coinsTotal += 1
                wld.setTile(c, r, T_EMPTY)
            end
            c += 1
        end
        r += 1
    end

    wld.player = player
    // 把所有敌人的 target 设为玩家
    int k = 0
    while k < g_alive.length
        if g_alive[k] and hasComp(k, C_ENEMY) then
            g_aiTarget[k] = player
        end
        k += 1
    end
    return wld
end

// 注册标准 System 序列到 World。
func setupSystems(World w)
    PhysicsSystem phys = PhysicsSystem()
    AISystem ai = AISystem()
    CombatSystem combat = CombatSystem()
    RenderSystem render = RenderSystem()
    w.addSystem(phys)
    w.addSystem(ai)
    w.addSystem(combat)
    w.addSystem(render)
end

// ===========================================================================
// 16. 内置自动玩家（用于 demo）
// ===========================================================================

// 简单启发式：玩家向出口方向走，遇到墙/坑/尖刺则跳跃。
func autoDecide(World w) as int
    int p = w.player
    if p < 0 or not g_alive[p] then
        return IN_NONE
    end
    float px = g_posX[p]
    float py = g_posY[p]
    int exitC = w.exitCol
    // 默认朝出口方向走
    int baseDir = IN_RIGHT
    if float(exitC) < px then
        baseDir = IN_LEFT
    end
    int dirSign = 1
    if baseDir == IN_LEFT then
        dirSign = 0 - 1
    end
    int myRow = floorI(py)
    int aheadCol = floorI(px) + dirSign
    int belowCol = floorI(px + 0.4) + dirSign
    int belowRow = myRow + 1

    // 检测前方/下方
    bool wallAhead = w.isSolidX(aheadCol, myRow) or w.isSolidX(aheadCol, myRow - 1)
    bool spikeAhead = w.tileAt(aheadCol, myRow) == T_SPIKE
    bool pitAhead = not w.isSolidY(belowCol, belowRow, true)
    bool enemyAhead = false
    int n = g_alive.length
    int i = 0
    while i < n
        if g_alive[i] and hasComp(i, C_ENEMY) then
            float dx = g_posX[i] - px
            float dy = g_posY[i] - py
            if dirSign > 0 and dx > 0.0 and dx < 2.0 and absF(dy) < 1.5 then
                enemyAhead = true
            end
            if dirSign < 0 and dx < 0.0 and dx > -2.0 and absF(dy) < 1.5 then
                enemyAhead = true
            end
        end
        i += 1
    end

    // 在地面时考虑跳跃
    if g_onGround[p] then
        if wallAhead or pitAhead or spikeAhead then
            return IN_JUMP
        end
        // 跳过敌人前先停下？这里直接跳过去
        if enemyAhead then
            return IN_JUMP
        end
    end
    return baseDir
end

// ===========================================================================
// 17. Demo 主循环
// ===========================================================================

func runDemo(int frames) as int
    if frames <= 0 then
        frames = 120
    end
    resetRegistry()

    // 内置关卡：玩家从左出发，收集金币、跳过尖刺/坑，避开敌人，到达右侧出口
    array<string> level = array[
        "##############################################################################",
        "#                                                                            #",
        "#                                                                            #",
        "#     o         o o o           o                       o o o                #",
        "#    ###       =====             ===                     =====               #",
        "#                                                                            #",
        "#                          o                                                 #",
        "#          P              #####                                              #",
        "#                                                  o o                        #",
        "#                                                 =====        M             #",
        "#                                                                              ",
        "#                ^^^                              ^^^^                 E    #",
        "##############################################################################",
        "##############################################################################"
    ]

    World w = buildLevel(level, 60, 13)
    setupSystems(w)
    w.centerCameraOnPlayer()
    w.statusMsg = "demo start"

    println("================================================================")
    println(" 2D ECS Game Engine - Platformer Demo")
    println(" @ = player   M = enemy   o = coin   ^ = spike   E = exit")
    println(" Running " + string(frames) + " frames (auto-player)")
    println("================================================================")

    int renderEvery = 6
    int lastScore = -1
    int stillFrames = 0
    float lastPX = -1.0
    float lastPY = -1.0

    while w.frame < frames
        int inp = autoDecide(w)
        applyInput(w, inp)
        runWorldSystems(w)
        w.centerCameraOnPlayer()

        // 渲染节奏：开头一帧、之后每 renderEvery 帧渲染一次
        if w.frame % renderEvery == 0 then
            print(renderToString(w))
        end

        // 检测玩家是否卡住（位置长期不变且未胜利）
        if w.player >= 0 then
            float px = g_posX[w.player]
            float py = g_posY[w.player]
            if absF(px - lastPX) < 0.01 and absF(py - lastPY) < 0.01 then
                stillFrames += 1
            else
                stillFrames = 0
            end
            lastPX = px
            lastPY = py
        end

        if w.score != lastScore then
            lastScore = w.score
        end

        w.frame += 1

        if w.gameOver then
            println("[demo] game over at frame " + string(w.frame))
            break
        end
        if w.victory then
            println("[demo] victory at frame " + string(w.frame))
            break
        end
        // 卡死保护
        if stillFrames > 24 then
            // 自动尝试跳一下
            applyInput(w, IN_JUMP)
            runWorldSystems(w)
            w.centerCameraOnPlayer()
            stillFrames = 0
        end
    end

    println("----------------------------------------------------------------")
    string hpStr = "0"
    if w.player >= 0 then
        hpStr = string(g_hp[w.player])
    end
    string result = "TIMEOUT"
    if w.victory then
        result = "VICTORY"
    elseif w.gameOver then
        result = "GAMEOVER"
    end
    println(" demo finished: frame=" + string(w.frame) +
            "  score=" + string(w.score) +
            "  hp=" + hpStr +
            "  result=" + result)
    return 0
end

// ===========================================================================
// 18. 测试套件
// ===========================================================================

int g_pass = 0
int g_fail = 0

func check(string name, bool ok) as bool
    if ok then
        g_pass += 1
        println("  [PASS] " + name)
    else
        g_fail += 1
        println("  [FAIL] " + name)
    end
    return ok
end

// T1: Entity 创建/销毁
func testEntityLifecycle() as bool
    println("[T1] Entity create / destroy")
    resetRegistry()
    int a = createNamed("a")
    int b = createNamed("b")
    int c = createNamed("c")
    bool ok = check("ids are sequential 0/1/2", a == 0 and b == 1 and c == 2)
    ok = check("alive initially true", g_alive[a] and g_alive[b] and g_alive[c]) and ok
    ok = check("entityCount == 3", g_entityCount == 3) and ok
    destroyEntity(b)
    ok = check("destroyed entity not alive", not g_alive[b]) and ok
    ok = check("entityCount decremented", g_entityCount == 2) and ok
    ok = check("mask cleared on destroy", g_mask[b] == C_NONE) and ok
    int d = createNamed("d")
    ok = check("new entity gets next id", d == 3) and ok
    return ok
end

// T2: 组件 mask 操作
func testComponentMask() as bool
    println("[T2] Component mask add/remove/has")
    resetRegistry()
    int e = createNamed("e")
    bool ok = check("no components initially", g_mask[e] == C_NONE)
    addComponent(e, C_POSITION)
    addComponent(e, C_VELOCITY)
    ok = check("has POSITION", hasComp(e, C_POSITION)) and ok
    ok = check("has VELOCITY", hasComp(e, C_VELOCITY)) and ok
    ok = check("not SPRITE", not hasComp(e, C_SPRITE)) and ok
    ok = check("hasAll POSITION|VELOCITY", hasAll(e, C_POSITION | C_VELOCITY)) and ok
    ok = check("not hasAll POSITION|SPRITE", not hasAll(e, C_POSITION | C_SPRITE)) and ok
    removeComponent(e, C_VELOCITY)
    ok = check("after remove VELOCITY, not has", not hasComp(e, C_VELOCITY)) and ok
    ok = check("POSITION untouched after remove VELOCITY", hasComp(e, C_POSITION)) and ok
    return ok
end

// T3: 组件赋值便捷函数
func testComponentSetters() as bool
    println("[T3] Component setters write correct fields")
    resetRegistry()
    int e = createNamed("e")
    setPosition(e, 3.5, 7.25)
    setVelocity(e, -1.0, 2.0)
    setSprite(e, "@", CLR_CYAN, 0)
    setCollider(e, 0.8, 0.9)
    setHealth(e, 5, 8)
    setAI(e, AI_PATROL, 2)
    bool ok = check("posX=3.5", g_posX[e] == 3.5)
    ok = check("posY=7.25", g_posY[e] == 7.25) and ok
    ok = check("velX=-1.0", g_velX[e] == -1.0) and ok
    ok = check("velY=2.0", g_velY[e] == 2.0) and ok
    ok = check("spriteCh='@'", g_spriteCh[e] == "@") and ok
    ok = check("colW=0.8", g_colW[e] == 0.8) and ok
    ok = check("hp=5", g_hp[e] == 5) and ok
    ok = check("aiState=PATROL", g_aiState[e] == AI_PATROL) and ok
    ok = check("aiTarget=2", g_aiTarget[e] == 2) and ok
    ok = check("aiAnchorX=posX", g_aiAnchorX[e] == g_posX[e]) and ok
    return ok
end

// T4: MovementSystem 推动非碰撞 entity
func testMovementSystem() as bool
    println("[T4] MovementSystem integrates kinematic entity")
    resetRegistry()
    int e = createNamed("kinematic")
    setPosition(e, 10.0, 10.0)
    setVelocity(e, 0.5, -0.25)
    // 不带 COLLIDER，MovementSystem 应处理
    World w = World(20, 20)
    MovementSystem ms = MovementSystem()
    ms.update(w)
    bool ok = check("posX advanced by vx", g_posX[e] == 10.5)
    ok = check("posY advanced by vy", g_posY[e] == 9.75) and ok
    // 再走一帧
    ms.update(w)
    ok = check("posX advanced twice", g_posX[e] == 11.0) and ok
    ok = check("posY advanced twice", g_posY[e] == 9.5) and ok
    return ok
end

// T5: MovementSystem 跳过有 COLLIDER 的 entity（让 PhysicsSystem 处理）
func testMovementSkipsPhysics() as bool
    println("[T5] MovementSystem skips entities with COLLIDER")
    resetRegistry()
    int e = createNamed("physics")
    setPosition(e, 10.0, 10.0)
    setVelocity(e, 0.5, 0.0)
    setCollider(e, 1.0, 1.0)
    addComponent(e, C_GRAVITY)
    World w = World(20, 20)
    MovementSystem ms = MovementSystem()
    ms.update(w)
    bool ok = check("posX unchanged (skipped)", g_posX[e] == 10.0)
    ok = check("posY unchanged (skipped)", g_posY[e] == 10.0) and ok
    // KINEMATIC 标签强制由 MovementSystem 处理
    addComponent(e, C_KINEMATIC)
    ms.update(w)
    ok = check("posX advanced when KINEMATIC", g_posX[e] == 10.5) and ok
    return ok
end

// T6: PhysicsSystem 重力
func testPhysicsGravity() as bool
    println("[T6] PhysicsSystem applies gravity")
    resetRegistry()
    int e = createNamed("faller")
    setPosition(e, 5.0, 5.0)
    setVelocity(e, 0.0, 0.0)
    setCollider(e, 1.0, 1.0)
    addComponent(e, C_GRAVITY)
    // 用很高的地图，确保 100 帧内不落地，真正测试 MAX_FALL 钳制
    World w = World(20, 1000)
    PhysicsSystem ps = PhysicsSystem()
    ps.update(w)
    bool ok = check("vy increased by gravity", absF(g_velY[e] - GRAVITY_ACCEL) < 0.001)
    // 多帧后接近 MAX_FALL
    int k = 0
    while k < 100
        ps.update(w)
        k += 1
    end
    ok = check("vy clamped to MAX_FALL", g_velY[e] <= MAX_FALL + 0.0001) and ok
    ok = check("vy reached MAX_FALL (not still accelerating)", absF(g_velY[e] - MAX_FALL) < 0.001) and ok
    ok = check("posY descended over time", g_posY[e] > 5.0) and ok
    return ok
end

// T7: PhysicsSystem 落地（站在墙上）
func testPhysicsLanding() as bool
    println("[T7] PhysicsSystem lands on solid ground")
    resetRegistry()
    int e = createNamed("lander")
    setPosition(e, 5.0, 8.0)
    setVelocity(e, 0.0, 0.0)
    setCollider(e, 1.0, 1.0)
    addComponent(e, C_GRAVITY)
    World w = World(10, 10)
    // 第 9 行整行是墙
    int c = 0
    while c < 10
        w.setTile(c, 9, T_WALL)
        c += 1
    end
    PhysicsSystem ps = PhysicsSystem()
    int guard = 0
    while guard < 60
        ps.update(w)
        guard += 1
    end
    // entity 高 1.0，落在第 9 行上方 -> y = 9 - 1 = 8
    bool ok = check("landed on top of wall (posY ~ 8.0)", absF(g_posY[e] - 8.0) < 0.001)
    ok = check("onGround set", g_onGround[e]) and ok
    ok = check("vy ~ 0 after landing", absF(g_velY[e]) < 0.001) and ok
    return ok
end

// T8: PhysicsSystem 水平撞墙
func testPhysicsWallBlock() as bool
    println("[T8] PhysicsSystem blocks horizontal movement into wall")
    resetRegistry()
    int e = createNamed("walker")
    setPosition(e, 5.0, 8.0)
    setVelocity(e, 0.5, 0.0)
    setCollider(e, 1.0, 1.0)
    World w = World(10, 10)
    int c = 0
    while c < 10
        w.setTile(c, 9, T_WALL)
        c += 1
    end
    // 第 8 行 col 7 是墙
    w.setTile(7, 8, T_WALL)
    PhysicsSystem ps = PhysicsSystem()
    int guard = 0
    while guard < 10
        ps.update(w)
        guard += 1
    end
    bool ok = check("stopped before wall (posX <= 6)", g_posX[e] <= 6.0 + 0.001)
    ok = check("vx zeroed", absF(g_velX[e]) < 0.001) and ok
    return ok
end

// T9: AABB 重叠检测
func testAABBOverlap() as bool
    println("[T9] AABB overlap detection")
    resetRegistry()
    int a = createNamed("a")
    int b = createNamed("b")
    int cc = createNamed("c")
    setPosition(a, 0.0, 0.0)
    setCollider(a, 1.0, 1.0)
    setPosition(b, 0.5, 0.5)
    setCollider(b, 1.0, 1.0)
    setPosition(cc, 5.0, 5.0)
    setCollider(cc, 1.0, 1.0)
    bool ok = check("a overlaps b", aabbOverlap(a, b))
    ok = check("a not overlaps c", not aabbOverlap(a, cc)) and ok
    // 共边不重叠
    setPosition(b, 1.0, 0.0)
    ok = check("edge-touch not overlapping", not aabbOverlap(a, b)) and ok
    // 原始 AABB 工具
    ok = check("raw overlap true", aabbOverlapRaw(0.0, 0.0, 2.0, 2.0, 1.0, 1.0, 2.0, 2.0)) and ok
    ok = check("raw overlap false", not aabbOverlapRaw(0.0, 0.0, 1.0, 1.0, 5.0, 5.0, 1.0, 1.0)) and ok
    return ok
end

// T10: AISystem 状态机
func testAIStateMachine() as bool
    println("[T10] AI state machine transitions")
    resetRegistry()
    int player = createNamed("player")
    makePlayer(player, 0.0, 0.0)
    int enemy = createNamed("enemy")
    makeEnemy(enemy, 5.0, 0.0, -1)
    g_aiTarget[enemy] = player
    g_aiState[enemy] = AI_PATROL
    World w = World(40, 10)
    AISystem ai = AISystem()
    // 玩家在 0，敌人距离 5，在发现范围内
    ai.update(w)
    bool ok = check("PATROL -> CHASE when player nearby", g_aiState[enemy] == AI_CHASE)
    // 玩家走远（>leashRange）
    setPosition(player, 30.0, 0.0)
    int guard = 0
    while guard < 2
        ai.update(w)
        guard += 1
    end
    ok = check("CHASE -> PATROL when player far", g_aiState[enemy] == AI_PATROL) and ok
    // 低血量 -> FLEE
    g_aiState[enemy] = AI_CHASE
    setPosition(player, 5.2, 0.0)
    g_hp[enemy] = 1
    ai.update(w)
    ok = check("CHASE -> FLEE on low hp", g_aiState[enemy] == AI_FLEE) and ok
    return ok
end

// T11: CombatSystem 伤害
func testCombatDamage() as bool
    println("[T11] CombatSystem damage application")
    resetRegistry()
    int player = createNamed("player")
    makePlayer(player, 5.0, 5.0)
    int enemy = createNamed("enemy")
    makeEnemy(enemy, 5.3, 5.0, -1)
    g_aiTarget[enemy] = player
    World w = World(20, 20)
    w.player = player
    CombatSystem combat = CombatSystem()
    combat.update(w)
    bool ok = check("player hp reduced after enemy contact", g_hp[player] < 3)
    ok = check("player has iframes after hit", g_iframes[player] > 0) and ok
    // 再次 update（无敌帧内）不应再扣血
    int hpBefore = g_hp[player]
    combat.update(w)
    ok = check("no damage during iframes", g_hp[player] == hpBefore) and ok
    return ok
end

