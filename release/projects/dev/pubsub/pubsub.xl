// pubsub - Pub/Sub message broker
//
// Usage:
//   pubsub test    Run broker verification (subscribe / publish / consume /
//                  ack / redeliver / consumer-groups / persistence).
//
// Features:
//   - Topic subscription:  subscribe(topic) -> subscriber ID
//   - Message publish:     publish(topic, payload) -> delivered to all subs
//   - Per-subscriber pending queue with ACK confirmation
//   - Unacked messages are redelivered after a timeout
//   - Persistence: topic message log saved to JSON file (pubsub.json)
//   - Consumer groups: round-robin distribution among group members
//
// Concurrency model:
//   - channel<int> carries stable message IDs; the ID indexes the broker's
//     message table and lets ACK/redelivery refer to one canonical record.
//   - One dispatch worker thread routes published messages to subscriber
//     channels, and re-delivers timed-out (unacked) messages.
//   - Each subscriber runs its own worker thread that consumes from its own
//     channel, processes, and ACKs.
//   - Publishers (main + publisher threads) call publish() under a mutex.
//
// Runtime design:
//   - channel<T> & thread are non-copyable; cannot live in typed containers.
//     Subscriber channels are pre-declared globals (one per slot, g_subCh0..7);
//     threads are fire-and-forget spawned via closure factories.
//   - Registry arrays are populated before subscriber workers start and are
//     protected by the broker mutex during concurrent access.
//   - Ack is idempotent: a (slot, msgId) pair is acked at most once even if
//     redelivery races with the subscriber's ack.

// ============================== constants ==================================

int MAX_SUBS = 8

int ST_FREE = 0
int ST_ACTIVE = 1
int ST_STOPPED = 2

int MSG_STOP = -1

// Redelivery threshold in logical ticks (one tick ~= one idle worker loop,
// ~1ms). Subscriber acks in well under this, so mode-0 (immediate ack) never
// triggers spurious redelivery; mode-1 (deferred ack) does.
int REDILIVER_TICKS = 80

// ============================== channels ===================================
// g_dispatch : publishers -> dispatch worker (new message IDs).
// g_subCh{i} : dispatch worker -> subscriber slot i (message IDs to consume).
// Pre-declared globals: channel<T> is non-copyable and cannot be stored in a
// typed container.

channel<int> g_dispatch = channel::<int>(256)
channel<int> g_subCh0 = channel::<int>(64)
channel<int> g_subCh1 = channel::<int>(64)
channel<int> g_subCh2 = channel::<int>(64)
channel<int> g_subCh3 = channel::<int>(64)
channel<int> g_subCh4 = channel::<int>(64)
channel<int> g_subCh5 = channel::<int>(64)
channel<int> g_subCh6 = channel::<int>(64)
channel<int> g_subCh7 = channel::<int>(64)

// ============================== message table ==============================
// Indexed by message id (0-based). Populated under g_lock.

array<string> g_msgTopic = array[]
array<int> g_msgData = array[]
int g_nextMsgId = 0

// ============================== subscriber registry ========================
// Parallel arrays, one element per subscriber slot (MAX_SUBS rows).

array<int> g_subStatus = array[]
array<string> g_subTopic = array[]
array<string> g_subGroup = array[]
array<int> g_subDelivered = array[]
array<int> g_subAcked = array[]
array<int> g_subMode = array[]
array<int> g_lastMsg = array[]
array<int> g_lastCount = array[]

// ============================== pending (unacked) table ====================
// Flat arrays. Each row: (subscriber slot, message id, delivered-at tick).

array<int> g_penSub = array[]
array<int> g_penMsg = array[]
array<int> g_penTime = array[]

// ============================== consumer-group round-robin =================
// map: "group|topic" -> next round-robin index.

array<string> g_gtKey = array[]
array<int> g_gtRr = array[]

// ============================== ack log ====================================
// Append-only record of (slot, msgId) for verification.

array<int> g_ackSub = array[]
array<int> g_ackMsg = array[]

// ============================== sync / runtime =============================

mutex g_lock = mutex()
bool g_dispatchDone = false
int g_activeThreads = 0
int g_tick = 0

int g_pass = 0
int g_fail = 0

// ============================== module-level init ==========================
// Populate subscriber-slot rows before any thread starts (never rebind).

func initSubs()
    int i = 0
    while i < MAX_SUBS
        g_subStatus.push(ST_FREE)
        g_subTopic.push("")
        g_subGroup.push("")
        g_subDelivered.push(0)
        g_subAcked.push(0)
        g_subMode.push(0)
        g_lastMsg.push(-1)
        g_lastCount.push(0)
        i = i + 1
    end
end

initSubs()

// ============================== channel dispatch ===========================
// Channels cannot be indexed, so route by slot via if-chains (actorsys pattern).

func subSend(int slot, int msgId) as bool
    if slot == 0 then return g_subCh0.send(msgId) end
    if slot == 1 then return g_subCh1.send(msgId) end
    if slot == 2 then return g_subCh2.send(msgId) end
    if slot == 3 then return g_subCh3.send(msgId) end
    if slot == 4 then return g_subCh4.send(msgId) end
    if slot == 5 then return g_subCh5.send(msgId) end
    if slot == 6 then return g_subCh6.send(msgId) end
    if slot == 7 then return g_subCh7.send(msgId) end
    return false
end

func subRecv(int slot) as (bool, int)
    int v = 0
    bool ok = false
    if slot == 0 then
        ok = g_subCh0.recvInto(v)
    elseif slot == 1 then
        ok = g_subCh1.recvInto(v)
    elseif slot == 2 then
        ok = g_subCh2.recvInto(v)
    elseif slot == 3 then
        ok = g_subCh3.recvInto(v)
    elseif slot == 4 then
        ok = g_subCh4.recvInto(v)
    elseif slot == 5 then
        ok = g_subCh5.recvInto(v)
    elseif slot == 6 then
        ok = g_subCh6.recvInto(v)
    elseif slot == 7 then
        ok = g_subCh7.recvInto(v)
    end
    return ok, v
end

func subCloseAll()
    g_subCh0.close()
    g_subCh1.close()
    g_subCh2.close()
    g_subCh3.close()
    g_subCh4.close()
    g_subCh5.close()
    g_subCh6.close()
    g_subCh7.close()
end

func tryRecvDispatch() as (bool, int)
    int v = 0
    bool ok = g_dispatch.tryRecvInto(v)
    return ok, v
end

// ============================== core API ===================================

// subscribe(topic, group) -> subscriber ID (slot index) or -1 if no free slot.
// group == "" means a standalone subscriber (receives every message on topic);
// a non-empty group means round-robin distribution among group members.
func subscribe(string topic, string group) as int
    g_lock.lock()
    int slot = -1
    int i = 0
    while i < MAX_SUBS
        if g_subStatus[i] == ST_FREE then
            slot = i
            break
        end
        i = i + 1
    end
    if slot < 0 then
        g_lock.unlock()
        return -1
    end
    g_subStatus[slot] = ST_ACTIVE
    g_subTopic[slot] = topic
    g_subGroup[slot] = group
    g_subDelivered[slot] = 0
    g_subAcked[slot] = 0
    g_subMode[slot] = 0
    g_lastMsg[slot] = -1
    g_lastCount[slot] = 0
    g_lock.unlock()
    return slot
end

// publish(topic, data) -> assigned message id. Thread-safe: multiple publisher
// threads may call concurrently. Enqueues the id onto g_dispatch for the worker.
func publish(string topic, int data) as int
    g_lock.lock()
    int id = g_nextMsgId
    g_msgTopic.push(topic)
    g_msgData.push(data)
    g_nextMsgId = g_nextMsgId + 1
    g_lock.unlock()
    while true
        if g_dispatch.send(id) then
            return id
        end
        if g_dispatch.isClosed() then
            return id
        end
        time.sleep(1)
    end
    return id
end

// ack(slot, msgId): confirm consumption. Idempotent - a (slot, msgId) already
// removed from pending is a no-op, so a racing redelivery cannot double-count.
func ack(int slot, int msgId)
    g_lock.lock()
    int idx = -1
    int i = 0
    while i < g_penSub.length
        if g_penSub[i] == slot and g_penMsg[i] == msgId then
            idx = i
            break
        end
        i = i + 1
    end
    if idx < 0 then
        g_lock.unlock()
        return
    end
    g_penSub.remove(idx)
    g_penMsg.remove(idx)
    g_penTime.remove(idx)
    g_subAcked[slot] = g_subAcked[slot] + 1
    g_ackSub.push(slot)
    g_ackMsg.push(msgId)
    g_lock.unlock()
end

// ============================== dispatch ===================================

// Deliver msgId to one subscriber: enqueue on its channel + record pending.
// Caller holds g_lock. send is non-blocking; on a full channel the pending row
// is still recorded and redelivery will retry.
func deliverTo(int slot, int msgId)
    subSend(slot, msgId)
    g_penSub.push(slot)
    g_penMsg.push(msgId)
    g_penTime.push(g_tick)
end

// Pick the next round-robin member of (group, topic); -1 if none active.
func pickGroupMember(string topic, string group) as int
    string key = group + "|" + topic
    int ki = -1
    int i = 0
    while i < g_gtKey.length
        if g_gtKey[i] == key then
            ki = i
            break
        end
        i = i + 1
    end
    if ki < 0 then
        g_gtKey.push(key)
        g_gtRr.push(0)
        ki = g_gtKey.length - 1
    end
    array<int> members
    int j = 0
    while j < MAX_SUBS
        if g_subStatus[j] == ST_ACTIVE then
            if g_subTopic[j] == topic then
                if g_subGroup[j] == group then
                    members.push(j)
                end
            end
        end
        j = j + 1
    end
    if members.length == 0 then
        return -1
    end
    int rr = g_gtRr[ki]
    int pick = members[rr % members.length]
    g_gtRr[ki] = rr + 1
    return pick
end

// Route a published message: every standalone subscriber of the topic gets a
// copy; each consumer group on the topic gets one copy (round-robin member).
func dispatchMessage(int msgId)
    g_lock.lock()
    string topic = g_msgTopic[msgId]
    int i = 0
    while i < MAX_SUBS
        if g_subStatus[i] == ST_ACTIVE then
            if g_subTopic[i] == topic then
                if g_subGroup[i] == "" then
                    deliverTo(i, msgId)
                end
            end
        end
        i = i + 1
    end
    array<string> groups
    int k = 0
    while k < MAX_SUBS
        if g_subStatus[k] == ST_ACTIVE then
            if g_subTopic[k] == topic then
                if g_subGroup[k] != "" then
                    if not groups.contains(g_subGroup[k]) then
                        groups.push(g_subGroup[k])
                    end
                end
            end
        end
        k = k + 1
    end
    int g = 0
    while g < groups.length
        int target = pickGroupMember(topic, groups[g])
        if target >= 0 then
            deliverTo(target, msgId)
        end
        g = g + 1
    end
    g_lock.unlock()
end

// Scan pending; redeliver entries older than REDILIVER_TICKS; drop entries for
// stopped subscribers. Caller does NOT hold g_lock.
func checkRedelivery()
    g_lock.lock()
    int now = g_tick
    int i = 0
    while i < g_penSub.length
        int s = g_penSub[i]
        int m = g_penMsg[i]
        int t = g_penTime[i]
        if g_subStatus[s] != ST_ACTIVE then
            g_penSub.remove(i)
            g_penMsg.remove(i)
            g_penTime.remove(i)
        elseif now - t > REDILIVER_TICKS then
            if subSend(s, m) then
                g_penTime[i] = now
            end
            i = i + 1
        else
            i = i + 1
        end
    end
    g_lock.unlock()
end

// ============================== worker threads =============================

func makeDispatchWorker() as func() as int
    return func() as int
        g_lock.lock()
        g_activeThreads = g_activeThreads + 1
        g_lock.unlock()
        while true
            bool ok = false
            int msgId = 0
            ok, msgId = tryRecvDispatch()
            if ok then
                if msgId == MSG_STOP then
                    break
                end
                dispatchMessage(msgId)
            else
                if g_dispatch.isClosed() then
                    break
                end
            end
            checkRedelivery()
            g_tick = g_tick + 1
            if not ok then
                time.sleep(1)
            end
        end
        g_lock.lock()
        g_dispatchDone = true
        g_activeThreads = g_activeThreads - 1
        g_lock.unlock()
        return 0
    end
end

// Subscriber worker: consume from own channel, process, ACK.
// mode 0 = immediate ack. mode 1 = ack only on 2nd receipt (redelivery probe).
func makeSubWorker(int slot) as func() as int
    return func() as int
        g_lock.lock()
        g_activeThreads = g_activeThreads + 1
        g_lock.unlock()
        while true
            bool ok = false
            int msgId = 0
            ok, msgId = subRecv(slot)
            if not ok then
                break
            end
            if msgId == MSG_STOP then
                break
            end
            g_lock.lock()
            g_subDelivered[slot] = g_subDelivered[slot] + 1
            if g_lastMsg[slot] == msgId then
                g_lastCount[slot] = g_lastCount[slot] + 1
            else
                g_lastMsg[slot] = msgId
                g_lastCount[slot] = 1
            end
            int mode = g_subMode[slot]
            int cnt = g_lastCount[slot]
            g_lock.unlock()
            if mode == 0 then
                ack(slot, msgId)
            elseif mode == 1 and cnt >= 2 then
                ack(slot, msgId)
            end
        end
        g_lock.lock()
        g_subStatus[slot] = ST_STOPPED
        g_activeThreads = g_activeThreads - 1
        g_lock.unlock()
        return 0
    end
end

// Multi-publisher closure for the reliability stress test.
func makePublisher(string topic, int start, int count) as func() as int
    return func() as int
        g_lock.lock()
        g_activeThreads = g_activeThreads + 1
        g_lock.unlock()
        int i = 0
        while i < count
            publish(topic, start + i)
            i = i + 1
        end
        g_lock.lock()
        g_activeThreads = g_activeThreads - 1
        g_lock.unlock()
        return 0
    end
end

// ============================== persistence ================================

func dataPath(string scriptPath) as string
    return path.join(path.dir(scriptPath), "pubsub.json")
end

// compact JSON -> pretty JSON (2-space indent), text-level (config.xl pattern).
func prettyCompact(string compact) as string
    string outputValue = ""
    int n = string.len(compact)
    int indent = 0
    int i = 0
    string pad = "  "
    while i < n
        string c = string.charAt(compact, i)
        if c == "{" or c == "[" then
            indent = indent + 1
            outputValue = outputValue + c + "\n" + string.repeat(pad, indent)
        elseif c == "}" or c == "]" then
            indent = indent - 1
            outputValue = outputValue + "\n" + string.repeat(pad, indent) + c
        elseif c == "," then
            outputValue = outputValue + c + "\n" + string.repeat(pad, indent)
        elseif c == ":" then
            outputValue = outputValue + ": "
        else
            outputValue = outputValue + c
        end
        i = i + 1
    end
    return outputValue
end

// Save the full message log (topic + payload per message) to JSON.
func saveMessages(string p) as bool
    var arr = []
    int i = 0
    while i < g_msgTopic.length
        var m = {}
        m["id"] = i
        m["topic"] = g_msgTopic[i]
        m["data"] = g_msgData[i]
        arr.push(m)
        i = i + 1
    end
    var doc = {}
    doc["count"] = g_msgTopic.length
    doc["messages"] = arr
    string text = prettyCompact(json.stringify(doc))
    return file.writeText(p, text)
end

// Load+verify: parse the saved file and return (ok, count, firstTopic, lastTopic).
func verifyMessages(string p, int expectCount) as (bool, int, string, string)
    if not file.exists(p) then
        return false, 0, "", ""
    end
    string text = file.readText(p)
    if not json.valid(text) then
        return false, 0, "", ""
    end
    var doc = json.parse(text)
    int c = int(doc["count"])
    var msgs = doc["messages"]
    string firstTopic = ""
    string lastTopic = ""
    int idx = 0
    for m in msgs
        if idx == 0 then
            firstTopic = string(m["topic"])
        end
        lastTopic = string(m["topic"])
        idx = idx + 1
    end
    bool ok = (c == expectCount and idx == expectCount)
    return ok, c, firstTopic, lastTopic
end

// ============================== test helpers ===============================

func check(string name, bool ok)
    if ok then
        println("  [PASS] " + name)
        g_pass = g_pass + 1
    else
        println("  [FAIL] " + name)
        g_fail = g_fail + 1
    end
end

func ackedCount(int slot) as int
    g_lock.lock()
    int v = g_subAcked[slot]
    g_lock.unlock()
    return v
end

func deliveredCount(int slot) as int
    g_lock.lock()
    int v = g_subDelivered[slot]
    g_lock.unlock()
    return v
end

func groupAcked(int a, int b, int c) as int
    g_lock.lock()
    int v = g_subAcked[a] + g_subAcked[b] + g_subAcked[c]
    g_lock.unlock()
    return v
end

func waitForAcked(int slot, int expected, int timeoutMs) as bool
    int waited = 0
    while waited < timeoutMs
        if ackedCount(slot) >= expected then
            return true
        end
        time.sleep(2)
        waited = waited + 2
    end
    return false
end

func waitForDelivered(int slot, int expected, int timeoutMs) as bool
    int waited = 0
    while waited < timeoutMs
        if deliveredCount(slot) >= expected then
            return true
        end
        time.sleep(2)
        waited = waited + 2
    end
    return false
end

func waitForGroupAcked(int a, int b, int c, int expected, int timeoutMs) as bool
    int waited = 0
    while waited < timeoutMs
        if groupAcked(a, b, c) >= expected then
            return true
        end
        time.sleep(2)
        waited = waited + 2
    end
    return false
end

// Count distinct acked message ids across slots a..b (no-duplicate check for
// consumer groups: each published message must be acked by exactly one member).
func distinctAckedInRange(int a, int b) as int
    g_lock.lock()
    array<int> seen
    int i = 0
    while i < g_ackSub.length
        int s = g_ackSub[i]
        if s >= a and s <= b then
            int m = g_ackMsg[i]
            if not seen.contains(m) then
                seen.push(m)
            end
        end
        i = i + 1
    end
    int n = seen.length
    g_lock.unlock()
    return n
end

func waitForDispatchDone(int timeoutMs) as bool
    int waited = 0
    while waited < timeoutMs
        g_lock.lock()
        bool d = g_dispatchDone
        g_lock.unlock()
        if d then
            return true
        end
        time.sleep(2)
        waited = waited + 2
    end
    return false
end

func waitForActive(int target, int timeoutMs) as bool
    int waited = 0
    while waited < timeoutMs
        g_lock.lock()
        int a = g_activeThreads
        g_lock.unlock()
        if a <= target then
            return true
        end
        time.sleep(5)
        waited = waited + 5
    end
    return false
end

func shutdown()
    g_dispatch.close()
    waitForDispatchDone(2000)
    subCloseAll()
    waitForActive(0, 3000)
end

// ============================== tests ======================================

func runTests(string scriptPath) as int
    println("==== pubsub test start ====")
    println("broker: 8 subscriber slots, channel<int> dispatch, 1 worker thread")
    println("------------------------------------------------")

    // ---- register all subscribers up front (8 slots) ----
    // 0,1 : "news"  standalone (immediate ack)
    // 2,3,4: "tasks" group "workers" (round-robin, immediate ack)
    // 5   : "alerts" standalone (mode 1 = ack-on-redelivery)
    // 6,7 : "bulk"  standalone (immediate ack)
    subscribe("news", "")
    subscribe("news", "")
    subscribe("tasks", "workers")
    subscribe("tasks", "workers")
    subscribe("tasks", "workers")
    subscribe("alerts", "")
    subscribe("bulk", "")
    subscribe("bulk", "")
    g_subMode[5] = 1

    // ---- start worker threads ----
    thread(makeDispatchWorker())
    int i = 0
    while i < MAX_SUBS
        thread(makeSubWorker(i))
        i = i + 1
    end

    // TEST 1: standalone subscribe + publish + consume + ack
    println("[test 1] standalone: 10 msgs to 'news', 2 subscribers, immediate ack")
    i = 0
    while i < 10
        publish("news", i + 1)
        i = i + 1
    end
    check("sub#0 acked all 10 news", waitForAcked(0, 10, 3000))
    check("sub#1 acked all 10 news", waitForAcked(1, 10, 3000))
    check("sub#0 delivered == 10 (no redelivery)", deliveredCount(0) == 10)
    check("sub#1 delivered == 10 (no redelivery)", deliveredCount(1) == 10)

    // TEST 2: consumer group round-robin
    println("[test 2] consumer group: 9 msgs to 'tasks', group 'workers' x3")
    i = 0
    while i < 9
        publish("tasks", 100 + i)
        i = i + 1
    end
    check("group acked all 9", waitForGroupAcked(2, 3, 4, 9, 3000))
    check("sub#2 acked == 3 (round-robin)", ackedCount(2) == 3)
    check("sub#3 acked == 3 (round-robin)", ackedCount(3) == 3)
    check("sub#4 acked == 3 (round-robin)", ackedCount(4) == 3)
    check("no duplicate delivery (9 distinct msg ids)", distinctAckedInRange(2, 4) == 9)

    // TEST 3: redelivery of unacked messages
    println("[test 3] redelivery: 1 msg to 'alerts', sub#5 defers ack until 2nd delivery")
    publish("alerts", 999)
    check("sub#5 received redelivery (delivered >= 2)", waitForDelivered(5, 2, 3000))
    check("sub#5 acked == 1 after redelivery", ackedCount(5) == 1)

    // TEST 4: persistence - save message log to JSON, reload, verify
    println("[test 4] persistence: save message log to pubsub.json")
    string storePath = dataPath(scriptPath)
    bool saved = saveMessages(storePath)
    check("message log saved", saved and file.exists(storePath))
    int expectTotal = g_nextMsgId
    bool vOk = false
    int vCount = 0
    string vFirst = ""
    string vLast = ""
    vOk, vCount, vFirst, vLast = verifyMessages(storePath, expectTotal)
    check("reloaded count == published total (" + string(expectTotal) + ")", vOk and vCount == expectTotal)
    check("first message topic == 'news'", vFirst == "news")
    check("last message topic == 'alerts'", vLast == "alerts")

    // TEST 5: reliability - 3 concurrent publishers x 20 msgs, 2 subscribers
    println("[test 5] reliability: 3 publishers x 20 = 60 msgs to 'bulk', 2 subscribers")
    int pubBeforeA = ackedCount(6)
    int pubBeforeB = ackedCount(7)
    thread(makePublisher("bulk", 0, 20))
    thread(makePublisher("bulk", 20, 20))
    thread(makePublisher("bulk", 40, 20))
    check("sub#6 received all 60 (multi-producer)", waitForAcked(6, pubBeforeA + 60, 5000))
    check("sub#7 received all 60 (multi-producer)", waitForAcked(7, pubBeforeB + 60, 5000))
    check("sub#6 delivered == acked (no loss)", deliveredCount(6) == ackedCount(6))
    check("sub#7 delivered == acked (no loss)", deliveredCount(7) == ackedCount(7))

    println("------------------------------------------------")
    println("==== pubsub summary ====")
    println("passed:", g_pass, " failed:", g_fail)
    println("messages published:", g_nextMsgId)
    int s = 0
    while s < MAX_SUBS
        println("  sub#" + string(s) + " [" + g_subTopic[s] +
                "] delivered=" + string(g_subDelivered[s]) +
                " acked=" + string(g_subAcked[s]))
        s = s + 1
    end

    if g_fail == 0 then
        println("RESULT: OK - pubsub broker verification passed")
        return 0
    end
    println("RESULT: FAIL -", g_fail, "check(s) failed")
    return 1
end

// ============================== usage / main ===============================

func printUsage()
    println("pubsub - Pub/Sub message broker")
    println("Usage:")
    println("  pubsub test    Run broker verification")
    println("Features:")
    println("  - Topic subscription + per-subscriber queues")
    println("  - Publish to all subscribers (channel<int> dispatch)")
    println("  - ACK-based consumption; unacked msgs redelivered")
    println("  - Consumer groups with round-robin distribution")
    println("  - Persistence: message log to pubsub.json")
end

func main(...) as int
    if arg.length < 2 then
        printUsage()
        return 1
    end

    string cmd = string(arg[1])
    if cmd != "test" then
        println("Error: unknown command '" + cmd + "'")
        printUsage()
        return 1
    end

    string scriptPath = string(arg[0])
    int rc = runTests(scriptPath)
    shutdown()
    return rc
end
