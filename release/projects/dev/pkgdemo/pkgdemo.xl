// pkgdemo.xl - import / package / 扩展库验证工具
//
// 压测 DEMO6 §16 的 import/package 全部公开能力：
//   1. source import  : import srclib            同目录 .xl 模块
//   2. package import : import mylib             带 xlang.package.json 的 package
//   3. 同名 C companion: srclib.c / mylib.c      与 .xl 同名的 .c 自动参与编译
//   4. 导出符号       : export func / var / const 跨模块访问
//   5. XLANG_PACKAGE_PATH: 环境变量指定搜索路径（见 README）
//
// 运行：
//   cd /d D:\GIT\x-lang\demo6\release
//   xl run   projects\dev\pkgdemo\pkgdemo.xl
//   xl build projects\dev\pkgdemo\pkgdemo.xl -o projects\dev\pkgdemo\pkgdemo.exe

import srclib
import mylib

// ===== 校验助手 =========================================================
func check(string label, int got, int want) as int
    if got == want then
        println("  [ok] " + label)
        return 0
    end
    println("  [FAIL] " + label + " got=" + string(got) + " want=" + string(want))
    return 1
end

func checkStr(string label, string got, string want) as int
    if got == want then
        println("  [ok] " + label)
        return 0
    end
    println("  [FAIL] " + label + " got=" + got + " want=" + want)
    return 1
end

// ===== 1. source import: 同目录 srclib.xl + 同名 srclib.c ================
func testSourceImport() as int
    println("[1] source import (srclib.xl + srclib.c)")
    int fails = 0
    // srclib.inc 走 export "c_sym" func，由 srclib.c 的 native 函数实现
    fails += check("srclib.inc(41)", srclib.inc(41), 42)
    fails += check("srclib.inc(0)", srclib.inc(0), 1)
    // srclib.base 是 export "c_sym" 的常量返回函数
    fails += check("srclib.base()", srclib.base(), 100)
    return fails
end

// ===== 2. package import: mylib/xlang.package.json =======================
func testPackageImport() as int
    println("[2] package import (mylib/xlang.package.json)")
    int fails = 0
    // export func libAdd(int, int) as int
    fails += check("mylib.libAdd(3,4)", mylib.libAdd(3, 4), 7)
    fails += check("mylib.libAdd(100,23)", mylib.libAdd(100, 23), 123)
    // export string libVersion = "1.0.0"  (package 导出变量)
    fails += checkStr("mylib.libVersion", mylib.libVersion, "1.0.0")
    // export const int LIB_MAGIC = 42    (package 导出常量)
    fails += check("mylib.LIB_MAGIC", mylib.LIB_MAGIC, 42)
    return fails
end

// ===== 3. 同名 C companion: mylib.c 自动编译 =============================
func testPackageCCompanion() as int
    println("[3] package same-name C companion (mylib.c)")
    int fails = 0
    // libMagic 内部调用 extern "xl6_pkgdemo_mylib_native_magic"
    // 该 C 函数由与 mylib.xl 同名的 mylib.c 提供
    fails += check("mylib.libMagic(1)", mylib.libMagic(1), 1007)
    fails += check("mylib.libMagic(2)", mylib.libMagic(2), 2007)
    return fails
end

// ===== main =============================================================
func main(...) as int
    println("=== pkgdemo: import/package/extlib verification ===")
    int total = 0
    total += testSourceImport()
    total += testPackageImport()
    total += testPackageCCompanion()
    println("=== pkgdemo done: " + string(total) + " failure(s) ===")
    if total == 0 then
        println("ALL CHECKS PASSED")
    end
    return total
end
