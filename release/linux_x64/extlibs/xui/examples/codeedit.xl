// 编辑 C 代码，将光标移到括号旁查看匹配；拖动右侧 minimap 滚动。
import xui
from "./_window.xl" import Window

Window.show("Code editor / minimap and syntax", func(xui.Context ui, xui.Widget root)
 auto editor = ui.codeEditNative()
 Window.place(root, editor, 24, 24, 640, 360)
 editor.setLanguage("c")
 // A short loop gives the minimap enough lines to scroll.
 string source = "int main(void) {\n    return 0;\n}\n"
 for line in range(1, 41)
  source += "// Example line "+string(line)+"\n"
 end
 editor.setText(source)
 editor.setMinimap(1, 100)
 editor.setTabColumns(4)
 editor.setBracketMatching(1)
end)
