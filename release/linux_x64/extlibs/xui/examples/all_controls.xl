 end
 static func build(xui.Context context,xui.Widget root,xui.Proxy proxy)
  auto selector=context.comboBoxNative()
  demo.Gallery.place(root,selector,24,12,640,40)
  selector.setItems(["accordion","basic","breadcrumb","button","canvas","carousel","chart","checkbox","codeedit","colorpicker","combobox","datepicker","dockpanel","hyperlink","image","input","listview","menu","messagelist","numericinput","page","panel","popup","progress","propertygrid","qrcode","radio","rangeslider","richtext","scrollbar","scrollview","separator","slider","splitlayout","statusbar","stepbar","tablegrid","tableview","tabs","taginput","terminal","textedit","timeline","toggle","toolbar","treeview","window"])
  selector.setSelected(c_int(0))
  xui.Widget? current=null
  xui.Widget? floating=null
  selector.setSelect(func(xui.Widget source,c_int index,c_int value)
   if index<0 or int(index)>=47 then return end
   if floating!=null then
    auto overlay=floating as Widget
    overlay.close()
    floating=null
   end
   if current!=null then
    auto previous=current as Widget
    previous.close()
   end
   auto page=context.widget()
   current=page
   demo.Gallery.place(root,page,0,64,760,480)
   floating=AllControlsExample.populate(index,context,page,proxy)
   context.invalidateAll()
  end)
  auto first=context.widget()
  current=first
  demo.Gallery.place(root,first,0,64,760,480)
  floating=AllControlsExample.populate(c_int(0),context,first,proxy)
  if env.get("XUI_EXAMPLE_CYCLE")!=null then
   // Automated slideshow validates the same constructors and destruction path.
   selector.setSelect(null)
   println("SCENE 0 accordion")
   int tick=0
   int scene=0
   root.setUpdateCallback(func(xui.Widget source,c_float delta) as c_int
    tick+=1
    if tick%3==0 and scene+1<47 then
     scene+=1
     if floating!=null then
      auto overlay=floating as Widget
      overlay.close()
      floating=null
     end
     if current!=null then
      auto previous=current as Widget
      previous.close()
     end
     auto page=context.widget()
     current=page
     demo.Gallery.place(root,page,0,64,760,480)
     floating=AllControlsExample.populate(c_int(scene),context,page,proxy)
     selector.setSelected(c_int(scene))
     println("SCENE "+string(scene))
    end
    return c_int(0)
   end)
  end
 end
end
func main(...) as int
 return demo.Gallery.run("All controls",AllControlsExample.build)
end
