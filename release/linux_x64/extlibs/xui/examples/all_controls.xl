 end
end

export class WindowExample
 static func build(xui.Context context,xui.Widget root,xui.Proxy proxy) as xui.Widget
  demo.Gallery.label(context,root,"Window / move and resize",24,16)
  auto control=context.windowNative()
  // Window opens on the Context floating layer, outside the ordinary page tree.
  assert control.setRect(demo.Gallery.rect(24,64,640,260))==0
  control.setTitle("Movable child window")
  control.setDragAnywhere(c_int(1))
  auto button=context.buttonNative()
  button.setText("A normal child")
  demo.Gallery.place(control,button,30,64,220,44)
  return control
 end
end


