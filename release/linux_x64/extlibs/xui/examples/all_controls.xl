export class RichtextExample
 static func build(xui.Context context,xui.Widget root,xui.Proxy proxy)
  demo.Gallery.label(context,root,"Rich text / current Document View model",24,16)
  auto document=xui.createDocument()
  try
   auto transaction=document.beginTransaction()
   try
    uint64 paragraph=transaction.insertNode(uint64(1),xui.XUI_DOCUMENT_APPEND,c_uint(2))
    transaction.insertNode(paragraph,xui.XUI_DOCUMENT_APPEND,c_uint(4),text="Rich text in the current Document model. Select this UTF-8 text: 你好！")
    auto changes=transaction.commit()
    changes.close()
   finally
    transaction.close()
   end
   auto view=xui.createDocumentView(context,document)
   demo.Gallery.place(root,view,24,64,680,320)
  finally
   // The View retains the Document; no legacy RichText wrapper exists.
   document.close()
  end
 end
end

