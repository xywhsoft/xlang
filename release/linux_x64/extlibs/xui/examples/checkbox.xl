// 点击复选框，在三个选中状态之间切换。
import xui
from "./_window.xl" import Window

Window.show("Checkbox / three-state selection", func(xui.Context ui, xui.Widget root)
 auto checkbox = ui.checkBoxNative()
 Window.place(root, checkbox, 24, 24, 640, 44)
 checkbox.setText("Enable notifications")
 checkbox.setChecked(1)
 checkbox.setAutoThreeState(1)
end)
