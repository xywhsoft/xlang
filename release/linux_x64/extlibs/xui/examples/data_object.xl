// Embedded NUL bytes remain intact; expected output: 3, then 610062.
import xui

auto data = xui.createDataObject()
try
 data.set("application/example", b"a\0b")
 int size = int(data.readInto("application/example"))
 auto output = Buffer()
 output.resize(size)
 data.readInto("application/example", output)
 println(size)
 println(codec.hexEncode(output.toBytes()))
finally
 data.close()
end
