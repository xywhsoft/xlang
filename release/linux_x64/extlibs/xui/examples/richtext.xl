// 显示并选择文档中的文字。
import xui
from "./_window.xl" import Window

Window.show("Rich text / current Document View model", func(xui.Context ui, xui.Widget root)
 auto document = xui.createDocument()
 try
  auto transaction = document.beginTransaction()
  try
   uint64 paragraph = transaction.insertNode(uint64(1), xui.XUI_DOCUMENT_APPEND, c_uint(xui.XUI_DOC_PARAGRAPH))
   transaction.insertNode(paragraph, xui.XUI_DOCUMENT_APPEND, c_uint(xui.XUI_DOC_TEXT), text = "Rich text in the current Document model. Select this UTF-8 text: 你好！")
   auto changes = transaction.commit()
   changes.close()
  finally
   transaction.close()
  end
  auto view = xui.createDocumentView(ui, document)
  Window.place(root, view, 24, 24, 680, 320)
 finally
  // The View retains the Document; no legacy RichText wrapper exists.
  document.close()
 end
end)
