import redis

extern "xrtMemDebugFailAfter" func failAfter(uint64 count) as c_bool
extern "xrtMemDebugFailTriggered" func failTriggered() as c_bool
extern "xrtMemDebugFailClear" func failClear()

var args = ["SET", "key", "value"]
string reply = "*2\r\n:1\r\n$3\r\nfoo\r\n"
Buffer raw = Buffer.fromHex("2a320d0a3a310d0a24330d0a666f6f0d0a")
int failures = 0
int successes = 0

for operation in range(4)
    for allocation in range(32)
        bool memoryCaught = false
        bool wrongCaught = false
        assert failAfter(uint64(allocation))
        try
            if operation == 0 then
                redis.encode(args)
            elseif operation == 1 then
                redis.encodeBytes(args)
            elseif operation == 2 then
                redis.decode(reply)
            else
                redis.decodeBytes(raw)
            end
        catch MemoryError error
            memoryCaught = true
        catch ValueError error
            wrongCaught = true
        catch TypeError error
            wrongCaught = true
        catch RuntimeError error
            wrongCaught = true
        end
        bool triggered = failTriggered()
        failClear()
        assert not wrongCaught and memoryCaught == triggered
        if triggered then failures += 1 else successes += 1 end
    end
end

assert failures > 0 and successes > 0
assert redis.encode(args) == "*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n"
assert redis.encodeBytes(args).hex() == "2a330d0a24330d0a5345540d0a24330d0a6b65790d0a24350d0a76616c75650d0a"
assert redis.decode(reply)["value"]["value"].length == 2
assert redis.decodeBytes(raw)["value"]["value"].length == 2
println("redis allocation: PASS")
