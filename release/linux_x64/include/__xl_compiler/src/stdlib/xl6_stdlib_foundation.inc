    "    extern \"xl6ObjectPoolControlDestroyV1\" @no_raise @nonblocking destroy()\n"
    "    extern \"xl6ObjectPoolControlCheckV1\" @nonblocking func check()\n"
    "    extern \"xl6ObjectPoolControlEnterV1\" @nonblocking func enter()\n"
    "    extern \"xl6ObjectPoolControlLeaveV1\" @no_raise @nonblocking func leave()\n"
    "    extern \"xl6ObjectPoolControlCloseV1\" @nonblocking func close()\n"
    "    extern \"xl6ObjectPoolControlIdleV1\" @nonblocking func idle()\n"
    "    extern \"xl6ObjectPoolControlClosedV1\" @nonblocking get closed() as bool\n"
    "end\n"
    "\n"
    "// Constraints use structural protocols. An empty protocol admits class\n"
    "// references without forcing inheritance from the dynamic-fields `object`.\n"
    "// It is a compile-time constraint; no protocol value/witness is stored.\n"
    "protocol __ObjectPoolMember\n"
    "end\n"
    "\n"
    "class ObjectPool<T is __ObjectPoolMember>\n"
    "    private __ObjectPoolControl __control = __ObjectPoolControl()\n"
    "    private array<T> __owned = []\n"
    "\n"
    "    func make(func() as T factory) as T\n"
    "        self.__control.enter()\n"
    "        try\n"
    "            T result = factory()\n"
    "            // Deliberate static class constraint; scalars/records/Future are\n"
    "            // not pool objects. No dynamic boxing or constructor dispatch.\n"
    "            if not self.__owned.push(result) then throw MemoryError \"object pool root retention failed\" end\n"
    "            return result\n"
    "        finally\n"
    "            self.__control.leave()\n"
    "        end\n"
    "    end\n"
    "\n"
    "    func keep(T item) as T\n"
    "        self.__control.check()\n"
    "        if not self.__owned.push(item) then throw MemoryError \"object pool root retention failed\" end\n"
    "        return item\n"
    "    end\n"
    "\n"
    "    get length() as int\n"
    "        self.__control.idle()\n"
    "        return self.__owned.length\n"
    "    end\n"
    "\n"
    "    get closed() as bool\n"
    "        return self.__control.closed\n"
    "    end\n"
    "\n"
    "    func clear() as int\n"
    "        self.__control.idle()\n"
    "        int count = self.__owned.length\n"
    "        // Detach before invoking arbitrary destructors. Reentrant cleanup\n"
    "        // cannot observe the old entries or accidentally drop them twice.\n"
    "        array<T> retired = self.__owned\n"
    "        self.__owned = []\n"
    "        if not retired.clear() then throw RuntimeError \"object pool root cleanup failed\" end\n"
    "        return count\n"
    "    end\n"
    "\n"
    "    func close()\n"
    "        self.__control.close()\n"
    "        self.clear()\n"
    "    end\n"
    "end\n"
