// 下拉选择 Debug、Release 或 Profile。
import xui
from "./_window.xl" import Window

Window.show("Combo box / popup selection", func(xui.Context ui, xui.Widget root)
 auto options = ui.comboBoxNative()
 Window.place(root, options, 24, 24, 640, 44)
 options.setItems(["Debug", "Release", "Profile"])
 options.setSelected(1)
end)
