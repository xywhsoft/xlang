// 工具栏中依次放置 New、Build、分隔线和 Run。
import xui
from "./_window.xl" import Window

Window.show("Toolbar / commands and tooltips", func(xui.Context ui, xui.Widget root)
 auto toolbar = ui.toolbarNative()
 Window.place(root, toolbar, 24, 24, 640, 48)
 toolbar.addItem("New", 0, 1)
 toolbar.addItem("Build", 0, 2)
 toolbar.addSeparator()
 toolbar.addItem("Run", 0, 3)
 toolbar.setItemTooltip(1, "Build the current project")
end)
