// 拖动两个滑块，选择 20 到 80 的初始范围。
import xui
from "./_window.xl" import Window

Window.show("Range slider / drag both endpoints", func(xui.Context ui, xui.Widget root)
 auto rangeSlider = ui.rangeSlider()
 Window.place(root, rangeSlider, 24, 24, 640, 44)
 rangeSlider.setRange(0, 100)
 rangeSlider.setValues(20, 80)
 auto first, last = rangeSlider.getValues()
end)
