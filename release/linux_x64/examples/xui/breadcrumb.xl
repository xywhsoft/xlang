// 依次显示 Home、Projects 和 xlang 三层路径。
import xui
from "./_window.xl" import Window

Window.show("Breadcrumb / navigation callbacks", func(xui.Context ui, xui.Widget root)
 auto breadcrumb = ui.breadcrumbNative()
 Window.place(root, breadcrumb, 24, 24, 640, 44)
 breadcrumb.addItem("Home", 1, 1)
 breadcrumb.addItem("Projects", 1, 2)
 breadcrumb.addItem("xlang", 0, 3)
end)
