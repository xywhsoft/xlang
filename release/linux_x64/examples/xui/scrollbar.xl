// 拖动滚动条，观察滑块位置变化。
import xui
from "./_window.xl" import Window

Window.show("Scrollbar / page and position", func(xui.Context ui, xui.Widget root)
 auto scrollbar = ui.scrollBar()
 scrollbar.setOrientation(xui.XUI_ORIENTATION_HORIZONTAL)
 scrollbar.setMode(xui.XUI_SCROLLBAR_MODE_FULL)
 Window.place(root, scrollbar, 24, 24, 640, 28)
 scrollbar.setRange(0, 1000, 100)
 scrollbar.setValue(150)
end)
