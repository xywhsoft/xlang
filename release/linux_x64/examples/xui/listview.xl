// List / selection and scrolling. Run from release/<platform>; Escape or close exits.
import xui
import "./_support.xl" as demo

export class ListviewExample
 static func build(xui.Context context,xui.Widget root,xui.Proxy proxy)
  demo.Gallery.label(context,root,"List / selection and scrolling",24,16)
  auto control=context.listViewNative()
  demo.Gallery.place(root,control,24,64,640,260)
  control.setItems(["First item","Second item","Third item","Fourth item","Fifth item"])
  assert control.setSelected(c_int(1))==0
  assert control.getItemCount()==c_int(5)
 end
end

func main(...) as int
 return demo.Gallery.run("List / selection and scrolling",ListviewExample.build)
end
