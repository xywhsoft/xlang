


function main(param)
	var a
	print(type(a))	// null
	a = true
	print(type(a))	// 逻辑 - true
	a = false
	print(type(a))	// 逻辑 - false
	a = 1234
	print(type(a))	// 整数
	a = 3.14
	print(type(a))	// 小数
	a = "新值"
	print(type(a))	// 字符串
	a = [ 1, 2, 3, 4 ]
	print(type(a))	// array
	a = { a = 1, b = 2, c = 3 }
	print(type(a))	// table
end


