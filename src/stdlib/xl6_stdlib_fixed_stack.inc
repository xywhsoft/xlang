/* A fixed-capacity policy over the resident typed Stack owner. Storage,
 * admission, copying and cleanup remain native Stack operations; no raw
 * pointers, parameter write-back or second collection allocator are exposed.
 * As with Stack, concurrent operations require external synchronization. */
const char* xl6StdlibFixedStackSource =
    "class FixedStack<T>\n"
    "    private Stack<T> values\n"
    "    private int limit = 0\n"
    "    create(int capacity)\n"
    "        if capacity < 0 then throw RangeError \"FixedStack capacity must be nonnegative\" end\n"
    "        self.values.reserve(capacity)\n"
    "        self.limit = capacity\n"
    "    end\n"
    "    func count() as int\n"
    "        return self.values.count()\n"
    "    end\n"
    "    func capacity() as int\n"
    "        return self.limit\n"
    "    end\n"
    "    func empty() as bool\n"
    "        return self.values.count() == 0\n"
    "    end\n"
    "    func full() as bool\n"
    "        return self.values.count() == self.limit\n"
    "    end\n"
    "    func push(T value) as bool\n"
    "        if self.full() then return false end\n"
    "        return self.values.push(value)\n"
    "    end\n"
    "    func pop() as T\n"
    "        return self.values.pop()\n"
    "    end\n"
    "    func peek() as T\n"
    "        return self.values.peek()\n"
    "    end\n"
    "    func peekAt(int depth) as T\n"
    "        return self.values.peekAt(depth)\n"
    "    end\n"
    "    func tryPop() as (bool, T?)\n"
    "        return self.values.tryPop()\n"
    "    end\n"
    "    func tryPeek() as (bool, T?)\n"
    "        return self.values.tryPeek()\n"
    "    end\n"
    "    func tryPeekAt(int depth) as (bool, T?)\n"
    "        return self.values.tryPeekAt(depth)\n"
    "    end\n"
    "    func clear()\n"
    "        self.values.clear()\n"
    "    end\n"
    "    func clone() as FixedStack<T>\n"
    "        auto result = FixedStack::<T>(self.limit)\n"
    "        result.values = self.values.clone()\n"
    "        result.values.reserve(self.limit)\n"
    "        return result\n"
    "    end\n"
    "    func __copy__() as FixedStack<T>\n"
    "        return self.clone()\n"
    "    end\n"
    "    func __clone__() as FixedStack<T>\n"
    "        return self.clone()\n"
    "    end\n"
    "    func equals(FixedStack<T> other) as bool\n"
    "        return self.values.equals(other.values)\n"
    "    end\n"
    "end\n";
