static const char xl6StdFsWalkBody[] =
    "func __xl_std_file_walk(string path, func(WalkEntry) as int visitor, int flags = 0, int maxDepth = -1) as WalkStats\n"
    "    return __xl_std_file_walk(path,visitor,func(WalkError ignored) as int\n"
    "        return 0\n"
    "    end,flags,maxDepth)\n"
    "end\n"
    "func __xl_std_file_walk(string path, func(WalkEntry) as int visitor, func(WalkError) as int onError, int flags = 0, int maxDepth = -1) as WalkStats\n"
    "    auto visitAdapter = func(var event) as int\n"
    "        return visitor(WalkEntry(event))\n"
    "    end\n"
    "    auto errorAdapter = func(var event) as int\n"
    "        return onError(WalkError(event))\n"
    "    end\n"
    "    return WalkStats(path,visitAdapter,errorAdapter,flags,maxDepth)\n"
    "end\n";

